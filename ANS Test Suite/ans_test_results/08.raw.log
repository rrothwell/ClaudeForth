  okT{ 127 CHARS BUFFER: TBUF2 -> }T
  ok\ Buffer is aligned   
  okT{ TBUF1 ALIGNED -> TBUF1 }T  Actual:Expected 561 =?= 561 
  ok\ Buffers do not overlap   
  okT{ TBUF2 TBUF1 - ABS 127 CHARS < -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okHEX
  ok\ Buffer can be written to

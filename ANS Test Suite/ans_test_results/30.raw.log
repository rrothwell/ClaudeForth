\ ============================================================
  ok\ ANS test suite - words that had no test in sections 08 to 29:
  ok\   Group 1 (standard words): PICK ROLL 2R@ <> 0<> U> WITHIN
  ok\     AGAIN ERASE PARSE SOURCE-ID REFILL TIB #TIB .R U.R
  ok\   Group 2 (ClaudeForth extensions): 2+ BINARY SNAME
  ok\     VHERE V, VC, VALLOT UNUSED VUNUSED
  ok\ Requires ttester.fs then 00_test_prelude.fs first, in that
  ok\ order. The tests for the standard words follow the forth-
  ok\ standard.org Core and Core-Ext test suites, with the values
  ok\ chosen for 16-bit cells. Base is HEX throughout.
  ok\ ============================================================
  okMARKER M30
  okTEST-BEGIN
  okHEX
  ok\ ============ Group 1: standard words ============
  ok\ F.6.2.2030 PICK
  okT{ 1 2 3 0 PICK -> 1 2 3 3 }T  Actual:Expected 3 =?= 3 3 =?= 3 2 =?= 2 1 =?= 1 
  okT{ 1 2 3 1 PICK -> 1 2 3 2 }T  Actual:Expected 2 =?= 2 3 =?= 3 2 =?= 2 1 =?= 1 
  okT{ 1 2 3 2 PICK -> 1 2 3 1 }T  Actual:Expected 1 =?= 1 3 =?= 3 2 =?= 2 1 =?= 1 
  ok\ F.6.2.2150 ROLL
  okT{ 1 2 3 0 ROLL -> 1 2 3 }T  Actual:Expected 3 =?= 3 2 =?= 2 1 =?= 1 
  okT{ 1 2 3 1 ROLL -> 1 3 2 }T  Actual:Expected 2 =?= 2 3 =?= 3 1 =?= 1 
  okT{ 1 2 3 2 ROLL -> 2 3 1 }T  Actual:Expected 1 =?= 1 3 =?= 3 2 =?= 2 
  okT{ 1 2 3 4 3 ROLL -> 2 3 4 1 }T  Actual:Expected 1 =?= 1 4 =?= 4 3 =?= 3 2 =?= 2 
  ok\ F.6.2.0415 2R@ 
  ok\ Return-stack words can only be used inside definitions.
  ok: g2r1 2>R 2R@ 2R> ;
  okT{ 1 2 g2r1 -> 1 2 1 2 }T  Actual:Expected 2 =?= 2 1 =?= 1 2 =?= 2 1 =?= 1 
  ok: g2r2 2>R 2R@ 2R> 2DROP ;
  okT{ 3 4 g2r2 -> 3 4 }T  Actual:Expected 4 =?= 4 3 =?= 3 
  okT{ : g2r3 2>R 2R@ R> R> ; -> }T
  okT{ 5 6 g2r3 -> 5 6 6 5 }T  Actual:Expected 5 =?= 5 6 =?= 6 6 =?= 6 5 =?= 5 
  ok\ F.6.2.0500 <>
  okT{  0  0 <> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{  1  1 <> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ -1 -1 <> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{  1  0 <> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ -1  0 <> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  0  1 <> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  0 -1 <> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MIN-INT MAX-INT <> -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ F.6.2.0260 0<>
  okT{        0 0<> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        1 0<> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{        2 0<> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{       -1 0<> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MAX-UINT 0<> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  MIN-INT 0<> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  MAX-INT 0<> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  ok\ F.6.2.2350 U>
  okT{        0        1 U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        1        2 U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        0 MID-UINT U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        0 MAX-UINT U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ MID-UINT MAX-UINT U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        0        0 U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        1        1 U> -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{        1        0 U> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{        2        1 U> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MID-UINT        0 U> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MAX-UINT        0 U> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MAX-UINT MID-UINT U> -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MID-UINT+1 MID-UINT U> -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ F.6.2.2440 WITHIN
  ok\ n1 is in the range n2 <= n1 < n3, and the range may wrap.
  okT{ 0 0 0 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ 0 0 1 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ 1 0 1 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ 5 3 8 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ 3 3 8 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ 8 3 8 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ 2 3 8 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ 7 3 8 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ 0 MIN-INT MAX-INT WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MIN-INT MIN-INT MAX-INT WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{ MAX-INT MIN-INT MAX-INT WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  ok\ A range that wraps through zero: -1 up to (not including) 1.
  okT{ -2 -1 1 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{ -1 -1 1 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  0 -1 1 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  1 -1 1 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{  2 -1 1 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  ok\ n2 above n3: the range runs from n2 up through MAX-UINT, then 0 up to n3.
  okT{ -1 3 1 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  0 3 1 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  okT{  1 3 1 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{  2 3 1 WITHIN -> <FALSE> }T  Actual:Expected 0 =?= 0 
  okT{  3 3 1 WITHIN -> <TRUE>  }T  Actual:Expected -1 =?= -1 
  ok\ F.6.2.0700 AGAIN
  okT{ : gi4 BEGIN DUP 1+ DUP 5 > IF EXIT THEN AGAIN ; -> }T
  okT{ 1 gi4 -> 1 2 3 4 5 6 }T  Actual:Expected 6 =?= 6 5 =?= 5 4 =?= 4 3 =?= 3 2 =?= 2 1 =?= 1 
  okT{ 4 gi4 -> 4 5 6 }T  Actual:Expected 6 =?= 6 5 =?= 5 4 =?= 4 
  okT{ 3 gi4 -> 3 4 5 6 }T  Actual:Expected 6 =?= 6 5 =?= 5 4 =?= 4 3 =?= 3 
  ok\ Counting up on the data stack until the loop leaves.
  okT{ : gi5 0 BEGIN 1+ DUP 7 = IF EXIT THEN AGAIN ; -> }T
  okT{ gi5 -> 7 }T  Actual:Expected 7 =?= 7 
  ok\ F.6.2.1350 ERASE
  okCREATE eb 4 ALLOT
  ok: ebfill eb 4 FF FILL ;
  ok: ebsee eb C@ eb 1+ C@ eb 2 + C@ eb 3 + C@ ;
  okT{ ebfill ebsee -> FF FF FF FF }T  Actual:Expected FF =?= FF FF =?= FF FF =?= FF FF =?= FF 
  okT{ ebfill eb 2 ERASE ebsee -> 0 0 FF FF }T  Actual:Expected FF =?= FF FF =?= FF 0 =?= 0 0 =?= 0 
  okT{ ebfill eb 1+ 2 ERASE ebsee -> FF 0 0 FF }T  Actual:Expected FF =?= FF 0 =?= 0 0 =?= 0 FF =?= FF 
  okT{ ebfill eb 4 ERASE ebsee -> 0 0 0 0 }T  Actual:Expected 0 =?= 0 0 =?= 0 0 =?= 0 0 =?= 0 
  ok\ A count of zero changes nothing.
  okT{ ebfill eb 0 ERASE ebsee -> FF FF FF FF }T  Actual:Expected FF =?= FF FF =?= FF FF =?= FF FF =?= FF 
  ok\ F.6.2.2008 PARSE
  ok\ The delimiter is not skipped at the start, so an empty string is
  ok\ possible; the length comes back with the address.
  okT{ CHAR | PARSE 1234| DUP ROT ROT EVALUATE -> 4 1234 }T  Actual:Expected 1234 =?= 1234 4 =?= 4 
  okT{ CHAR ^ PARSE  23 123 ^ DUP ROT ROT EVALUATE -> 8 23 123 }T  Actual:Expected 123 =?= 123 23 =?= 23 8 =?= 8 
  okT{ CHAR | PARSE |  NIP -> 0 }T  Actual:Expected 0 =?= 0 
  okT{ CHAR , PARSE abc, NIP -> 3 }T  Actual:Expected 3 =?= 3 
  okT{ BL PARSE xyz  NIP -> 3 }T  Actual:Expected 3 =?= 3 
  ok\ F.6.2.2218 SOURCE-ID
  ok\ F.6.2.2125 REFILL
  ok\ Both tests run from the terminal, which is source 0; an EVALUATEd
  ok\ string is source -1 and cannot be refilled.
  okT{ SOURCE-ID -> 0 }T  Actual:Expected 0 =?= 0 
  ok: sid1 S" SOURCE-ID" EVALUATE ;
  okT{ sid1 -> -1 }T  Actual:Expected -1 =?= -1 
  ok: rf1 S" REFILL" EVALUATE ;
  okT{ rf1 -> <FALSE> }T  Actual:Expected 0 =?= 0 
  ok\ F.XXXX TIB
  ok\ F.XXXX #TIB
  ok\ Removed from ANS Forth.
  ok\ TIB is the fixed terminal buffer ($0106, TIBBUF), #TIB its character
  ok\ count. 0106 is hex, so the base must be HEX here.
  okT{ TIB 0106 = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ SOURCE DROP TIB = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok: tb1 S" TIB" EVALUATE ;
  okT{ tb1 TIB = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ #TIB @ SOURCE NIP = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ #TIB @ >IN @ U> -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ F.6.2.0210 .R
  ok\ F.6.2.2330 U.R 
  ok\ Visual test.
  ok\ The two lines of each pair must be identical. The values are
  ok\ shown in hex (the base here): 123 is $123 and so on.
  ok: RJOutput
   CR ." You should see lines duplicated:" CR
   S"  123" TYPE CR    123 4 .R CR
   S"   -7B" TYPE CR   -7B 5 .R CR
   S" 0" TYPE CR       0 1 .R CR
   S" -123" TYPE CR    -123 2 .R CR
   S"      FFFF" TYPE CR   MAX-UINT 9 U.R CR
   S" 8000" TYPE CR    MIN-INT 4 U.R CR
   S"    1F" TYPE CR   1F 5 U.R CR
   S" 12345" TYPE CR   12345 3 U.R CR
;
  okT{ RJOutput -> }T

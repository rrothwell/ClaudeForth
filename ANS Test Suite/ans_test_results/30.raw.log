  ok\ ============ Group 2: ClaudeForth extensions ============
  ok\ ClaudeForth 2+
  okT{        0 2+ -> 2 }T  Actual:Expected 2 =?= 2 
  okT{        1 2+ -> 3 }T  Actual:Expected 3 =?= 3 
  okT{       -2 2+ -> 0 }T  Actual:Expected 0 =?= 0 
  okT{       -3 2+ -> -1 }T  Actual:Expected -1 =?= -1 
  okT{  MAX-INT 2+ -> MIN-INT 1+ }T  Actual:Expected -7FFF =?= -7FFF 
  okT{ MAX-UINT 2+ -> 1 }T  Actual:Expected 1 =?= 1 
  ok\ ClaudeForth BINARY
  ok: bn1 BASE @ BINARY BASE @ SWAP BASE ! ;
  okT{ bn1 BASE @ 10 = -> 2 <TRUE> }T  Actual:Expected -1 =?= -1 2 =?= 2 
  ok\ The digits after BINARY are read in base 2 and HEX restores base 16.
  okT{ BINARY 101 HEX -> 5 }T  Actual:Expected 5 =?= 5 
  okT{ BINARY 1111 1111 HEX -> F F }T  Actual:Expected F =?= F F =?= F 
  okT{ BASE @ -> 10 }T  Actual:Expected 10 =?= 10 
  ok\ ClaudeForth SNAME
  okT{ ' DUP SNAME S" DUP" S= -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ ' SWAP SNAME S" SWAP" S= -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ ' SNAME SNAME S" SNAME" S= -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok: SN1 ;
  okT{ ' SN1 SNAME S" SN1" S= -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okCREATE SN2
  okT{ ' SN2 SNAME S" SN2" S= -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ An address that is not an execution token gives a zero length.
  okT{ 1 SNAME NIP -> 0 }T  Actual:Expected 0 =?= 0 
  ok\ ClaudeForth VHERE
  ok\ ClaudeForth V,
  ok\ ClaudeForth VC,
  ok\ VSTART remembers where the variable region stood, so that the
  ok\ tests below can hand back everything they allocate.
  okCREATE VSTART VHERE ,
  okT{ VHERE VSTART @ = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ VHERE 1 V, VHERE SWAP - -> 2 }T  Actual:Expected 2 =?= 2 
  okT{ VHERE 1234 V, @ -> 1234 }T  Actual:Expected 1234 =?= 1234 
  okT{ VHERE 5A VC, VHERE OVER - SWAP C@ -> 1 5A }T  Actual:Expected 5A =?= 5A 1 =?= 1 
  ok\ ClaudeForth VALLOT
  okT{ VHERE 10 VALLOT VHERE SWAP - -> 10 }T  Actual:Expected 10 =?= 10 
  ok\ A negative count gives the space back.
  okT{ VHERE 8 VALLOT -8 VALLOT VHERE = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ Hand back everything allocated above (2 + 2 + 1 + 16 bytes).
  ok: vrestore VHERE VSTART @ - NEGATE VALLOT ;
  okvrestore
  okT{ VHERE VSTART @ = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ ClaudeForth UNUSED
  ok\ UNUSED shrinks by the amount ALLOTted, VUNUSED by the amount VALLOTted.
  okT{ UNUSED 0<> -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ UNUSED 10 ALLOT UNUSED - -10 ALLOT -> 10 }T  Actual:Expected 10 =?= 10 
  ok\ ClaudeForth VUNUSED
  okT{ VUNUSED 0<> -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ VUNUSED 8 VALLOT VUNUSED - -8 VALLOT -> 8 }T  Actual:Expected 8 =?= 8 
  okT{ VHERE VSTART @ = -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ Print this file's TEST SUMMARY and trim any stray stack cells.
  okTEST-END
TEST SUMMARY: 113 run, 0 failed


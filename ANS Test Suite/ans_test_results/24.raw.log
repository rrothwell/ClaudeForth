  okT{ 0 0 GN' -' >NUMBER -> 0 0 GN-STRING }T  Actual:Expected 1 =?= 1 7819 =?= 7819 0 =?= 0 0 =?= 0 
  okT{ 0 0 GN' +' >NUMBER -> 0 0 GN-STRING }T  Actual:Expected 1 =?= 1 7819 =?= 7819 0 =?= 0 0 =?= 0 
  okT{ 0 0 GN' .' >NUMBER -> 0 0 GN-STRING }T  Actual:Expected 1 =?= 1 7819 =?= 7819 0 =?= 0 0 =?= 0 
  ok: >NUMBER-BASED BASE @ >R BASE ! >NUMBER R> BASE ! ;
  okT{ 0 0 GN' 2' 10 >NUMBER-BASED -> 2 0 GN-CONSUMED }T  Actual:Expected 0 =?= 0 781A =?= 781A 0 =?= 0 2 =?= 2 
  okT{ 0 0 GN' 2' 2 >NUMBER-BASED -> 0 0 GN-STRING }T  Actual:Expected 1 =?= 1 7819 =?= 7819 0 =?= 0 0 =?= 0 
  okT{ 0 0 GN' F' 10 >NUMBER-BASED -> F 0 GN-CONSUMED }T  Actual:Expected 0 =?= 0 781A =?= 781A 0 =?= 0 F =?= F 
  okT{ 0 0 GN' G' 10 >NUMBER-BASED -> 0 0 GN-STRING }T  Actual:Expected 1 =?= 1 7819 =?= 7819 0 =?= 0 0 =?= 0 
  okT{ 0 0 GN' G' MAX-BASE >NUMBER-BASED -> 10 0 GN-CONSUMED }T  Actual:Expected 0 =?= 0 781A =?= 781A 0 =?= 0 10 =?= 10 
  okT{ 0 0 GN' Z' MAX-BASE >NUMBER-BASED -> 23 0 GN-CONSUMED }T  Actual:Expected 0 =?= 0 781A =?= 781A 0 =?= 0 23 =?= 23 
  ok: GN1 ( UD BASE -- UD' LEN )
BASE @ >R BASE !
<# #S #> 0 0 2SWAP >NUMBER SWAP DROP
R> BASE ! ;
  okT{ 0 0 2 GN1 -> 0 0 0 }T  Actual:Expected 0 =?= 0 0 =?= 0 0 =?= 0 
  okT{ MAX-UINT 0 2 GN1 -> MAX-UINT 0 0 }T  Actual:Expected 0 =?= 0 0 =?= 0 -1 =?= -1 
  okT{ MAX-UINT DUP 2 GN1 -> MAX-UINT DUP 0 }T  Actual:Expected 0 =?= 0 -1 =?= -1 -1 =?= -1 
  okT{ 0 0 MAX-BASE GN1 -> 0 0 0 }T  Actual:Expected 0 =?= 0 0 =?= 0 0 =?= 0 
  okT{ MAX-UINT 0 MAX-BASE GN1 -> MAX-UINT 0 0 }T  Actual:Expected 0 =?= 0 0 =?= 0 -1 =?= -1 
  okT{ MAX-UINT DUP MAX-BASE GN1 -> MAX-UINT DUP 0 }T  Actual:Expected 0 =?= 0 -1 =?= -1 -1 =?= -1 
  ok\ F.6.1.0770  BL
  okT{ BL -> 20 }T  Actual:Expected 20 =?= 20 
  ok\ F.6.1.1345  ENVIRONMENT?
  ok\ ERRATUM IN THE STANDARD'S OWN TEST: "DUP 0= XOR INVERT" turns ANY
  ok\ single flag into 0 (flag XOR (flag=0) is always -1, and INVERT
  ok\ makes that 0), so the published X:deferred test "-> <TRUE>" can
  ok\ never pass on any system. A contributor note on forth-standard.org's
  ok\ ENVIRONMENT? page says the same, and also that a conforming system
  ok\ may answer false to every query. Replaced it with a valid check:
  ok\ whatever ENVIRONMENT? answers for X:deferred, the result must be
  ok\ exactly one well-formed flag (0 or -1, no extra cells, which the
  ok\ harness depth check enforces). X:notfound below is unchanged.
  okT{ S" X:deferred" ENVIRONMENT? DUP 0= OVER TRUE = OR NIP -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ S" X:notfound" ENVIRONMENT? DUP 0= XOR INVERT -> <FALSE> }T  Actual:Expected 0 =?= 0 
  ok\ F.6.1.1360  EVALUATE
  ok: GE1 S" 123" ; IMMEDIATE
  ok: GE2 S" 123 1+" ; IMMEDIATE
  ok: GE3 S" : GE4 345 ;" ;
  ok: GE5 EVALUATE ; IMMEDIATE
  okT{ GE1 EVALUATE -> 123 }T  Actual:Expected 123 =?= 123 
  okT{ GE2 EVALUATE -> 124 }T  Actual:Expected 124 =?= 124 
  okT{ GE3 EVALUATE -> }T
  okT{ GE4 -> 345 }T  Actual:Expected 345 =?= 345 
  okT{ : GE6 GE1 GE5 ; -> }T
  okT{ GE6 -> 123 }T  Actual:Expected 123 =?= 123 
  okT{ : GE7 GE2 GE5 ; -> }T
  okT{ GE7 -> 124 }T  Actual:Expected 124 =?= 124 
  ok\ F.6.1.2216  SOURCE
  ok: GS1 S" SOURCE" 2DUP EVALUATE >R SWAP >R = R> R> = ;
  okT{ GS1 -> <TRUE> <TRUE> }T  Actual:Expected -1 =?= -1 -1 =?= -1 
  ok: GS4 SOURCE >IN ! DROP ;   
  okT{ GS4 123 456 -> }T

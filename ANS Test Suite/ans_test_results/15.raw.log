\ ============================================================
  ok\ ANS test suite - words implemented in forth6809.asm's
  ok\ section 15 (15_arithmetic)
  ok\ Requires ttester.fs then 00_test_prelude.fs to be loaded
  ok\ first, in that order (the prelude itself uses T{/->/}T, so
  ok\ ttester.fs must come first). Extracted from the ANS Forth
  ok\ Standard, Annex F
  ok\ (https://forth-standard.org/standard/testsuite), which is
  ok\ explicitly redistributable per its own copyright notice.
  ok\ ============================================================
  ok\ ---- section-marker: makes this file independently runnable ----
  ok\ M15 snapshots the dictionary/HERE state right before this
  ok\ file's own definitions begin. Invoking M15 at the end (below)
  ok\ erases everything this file defined - including M15 itself -
  ok\ restoring the system to the state it was in just after
  ok\ ttester.fs + 00_test_prelude.fs were loaded. This lets the
  ok\ automation load/run/reset one section file at a time, in any
  ok\ order, without cross-file dictionary pollution.
  okMARKER M15
  ok\ Reset the pass/fail counters, record the stack depth.
  okTEST-BEGIN
  ok\ F.6.1.0090  *
  okT{ 0 0 * -> 0 }T  Actual:Expected 0 =?= 0 
  okT{ 0 1 * -> 0 }T  Actual:Expected 0 =?= 0 
  okT{ 1 0 * -> 0 }T  Actual:Expected 0 =?= 0 
  okT{ 1 2 * -> 2 }T  Actual:Expected 2 =?= 2 
  okT{ 2 1 * -> 2 }T  Actual:Expected 2 =?= 2 
  okT{ 3 3 * -> 9 }T  Actual:Expected 9 =?= 9 
  okT{ -3 3 * -> -9 }T  Actual:Expected -9 =?= -9 
  okT{ 3 -3 * -> -9 }T  Actual:Expected -9 =?= -9 
  okT{ -3 -3 * -> 9 }T  Actual:Expected 9 =?= 9 
  okT{ MID-UINT+1 1 RSHIFT 2 * -> MID-UINT+1 }T  Actual:Expected -8000 =?= -8000 
  okT{ MID-UINT+1 2 RSHIFT 4 * -> MID-UINT+1 }T  Actual:Expected -8000 =?= -8000 
  okT{ MID-UINT+1 1 RSHIFT MID-UINT+1 OR 2 * -> MID-UINT+1 }T  Actual:Expected -8000 =?= -8000 
  ok\ F.6.1.0100  */
  ok\ F.6.1.0110  */MOD
  ok\ */MOD's helper must be defined
  ok\ before */'s (T*/ is defined in terms of T*/MOD), so */MOD's IFFLOORED/
  ok\ IFSYM lines come first here, matching the authoritative Annex F
  ok\ source order; this was previously reversed, a genuine forward-
  ok\ reference bug (T*/ compiled before T*/MOD existed).
  okIFFLOORED : T*/MOD >R M* R> FM/MOD ;
  okIFSYM : T*/MOD >R M* R> SM/REM ;
  okIFFLOORED : T*/ T*/MOD SWAP DROP ;
  okIFSYM : T*/ T*/MOD SWAP DROP ;
  okT{ 0 2 1 */ -> 0 2 1 T*/ }T  Actual:Expected 0 =?= 0 
  okT{ 1 2 1 */ -> 1 2 1 T*/ }T  Actual:Expected 2 =?= 2 
  okT{ 2 2 1 */ -> 2 2 1 T*/ }T  Actual:Expected 4 =?= 4 
  okT{ -1 2 1 */ -> -1 2 1 T*/ }T  Actual:Expected -2 =?= -2 
  okT{ -2 2 1 */ -> -2 2 1 T*/ }T  Actual:Expected -4 =?= -4 
  okT{ 0 2 -1 */ -> 0 2 -1 T*/ }T  Actual:Expected 0 =?= 0 
  okT{ 1 2 -1 */ -> 1 2 -1 T*/ }T  Actual:Expected -2 =?= -2 
  okT{ 2 2 -1 */ -> 2 2 -1 T*/ }T  Actual:Expected -4 =?= -4 
  okT{ -1 2 -1 */ -> -1 2 -1 T*/ }T  Actual:Expected 2 =?= 2 
  okT{ -2 2 -1 */ -> -2 2 -1 T*/ }T  Actual:Expected 4 =?= 4 
  okT{ 2 2 2 */ -> 2 2 2 T*/ }T  Actual:Expected 2 =?= 2 
  okT{ -1 2 -1 */ -> -1 2 -1 T*/ }T  Actual:Expected 2 =?= 2 
  okT{ -2 2 -2 */ -> -2 2 -2 T*/ }T  Actual:Expected 2 =?= 2 
  okT{ 7 2 3 */ -> 7 2 3 T*/ }T  Actual:Expected 4 =?= 4 
  okT{ 7 2 -3 */ -> 7 2 -3 T*/ }T  Actual:Expected -4 =?= -4 
  okT{ -7 2 3 */ -> -7 2 3 T*/ }T  Actual:Expected -4 =?= -4 
  okT{ -7 2 -3 */ -> -7 2 -3 T*/ }T  Actual:Expected 4 =?= 4 
  okT{ MAX-INT 2 MAX-INT */ -> MAX-INT 2 MAX-INT T*/ }T  Actual:Expected 2 =?= 2 
  okT{ MIN-INT 2 MIN-INT */ -> MIN-INT 2 MIN-INT T*/ }T  Actual:Expected 2 =?= 2 
  okT{ 0 2 1 */MOD -> 0 2 1 T*/MOD }T  Actual:Expected 0 =?= 0 0 =?= 0 
  okT{ 1 2 1 */MOD -> 1 2 1 T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  okT{ 2 2 1 */MOD -> 2 2 1 T*/MOD }T  Actual:Expected 4 =?= 4 0 =?= 0 
  okT{ -1 2 1 */MOD -> -1 2 1 T*/MOD }T  Actual:Expected -2 =?= -2 0 =?= 0 
  okT{ -2 2 1 */MOD -> -2 2 1 T*/MOD }T  Actual:Expected -4 =?= -4 0 =?= 0 
  okT{ 0 2 -1 */MOD -> 0 2 -1 T*/MOD }T  Actual:Expected 0 =?= 0 0 =?= 0 
  okT{ 1 2 -1 */MOD -> 1 2 -1 T*/MOD }T  Actual:Expected -2 =?= -2 0 =?= 0 
  okT{ 2 2 -1 */MOD -> 2 2 -1 T*/MOD }T  Actual:Expected -4 =?= -4 0 =?= 0 
  okT{ -1 2 -1 */MOD -> -1 2 -1 T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  okT{ -2 2 -1 */MOD -> -2 2 -1 T*/MOD }T  Actual:Expected 4 =?= 4 0 =?= 0 
  okT{ 2 2 2 */MOD -> 2 2 2 T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  okT{ -1 2 -1 */MOD -> -1 2 -1 T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  okT{ -2 2 -2 */MOD -> -2 2 -2 T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  okT{ 7 2 3 */MOD -> 7 2 3 T*/MOD }T  Actual:Expected 4 =?= 4 2 =?= 2 
  okT{ 7 2 -3 */MOD -> 7 2 -3 T*/MOD }T  Actual:Expected -4 =?= -4 2 =?= 2 
  okT{ -7 2 3 */MOD -> -7 2 3 T*/MOD }T  Actual:Expected -4 =?= -4 -2 =?= -2 
  okT{ -7 2 -3 */MOD -> -7 2 -3 T*/MOD }T  Actual:Expected 4 =?= 4 -2 =?= -2 
  okT{ MAX-INT 2 MAX-INT */MOD -> MAX-INT 2 MAX-INT T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  okT{ MIN-INT 2 MIN-INT */MOD -> MIN-INT 2 MIN-INT T*/MOD }T  Actual:Expected 2 =?= 2 0 =?= 0 
  ok\ F.6.1.0120  +
  okT{ 0 5 + -> 5 }T  Actual:Expected 5 =?= 5 
  okT{ 5 0 + -> 5 }T  Actual:Expected 5 =?= 5 
  okT{ 0 -5 + -> -5 }T  Actual:Expected -5 =?= -5 
  okT{ -5 0 + -> -5 }T  Actual:Expected -5 =?= -5 

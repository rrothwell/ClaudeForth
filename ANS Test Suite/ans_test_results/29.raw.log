  ok\ F.6.2.2182 SAVE-INPUT 
  ok\ F.6.2.2148 RESTORE-INPUT 
  ok
  ok\ For SAVE-INPUT 3 cells are returned with a count of 3.
  ok\ >R and R> are used inside a definition: 
  ok\ because their interpretation semantics are undefined.
  ok\ At top level they put the value
  ok\ under the interpreter's own return address - bad!.
  ok: SI-SHAPE SAVE-INPUT 3 = >R 2DROP DROP R> ;
  okT{ SI-SHAPE -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok
  ok\ For RESTORE-INPUT a count other than 3 cannot be restored:
  ok\ the cells are dropped
  ok\ and true (failure) is returned.
  okT{ 5 6 2 RESTORE-INPUT -> <TRUE> }T  Actual:Expected -1 =?= -1 
  okT{ 0 RESTORE-INPUT -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok\ A state saved from a different source is refused, 
  ok\ since the EVALUATEd string has another address and length.
  ok: ri1 S" SAVE-INPUT" EVALUATE ;
  okT{ ri1 RESTORE-INPUT -> <TRUE> }T  Actual:Expected -1 =?= -1 
  ok
  ok
  ok\ F.6.2.2266 S\" 
  ok
  ok\ Build a string from a quoted string 
  ok\ containing the escape characters:
  ok\      \a 7  \b 8  \e 1B  \f C  \l A  \m 0D 0A  \n A  \q 22
  ok\     \r D  \t 9  \v B  \z 0  \" 22  \\ 5C  \xhh
  ok
  ok
  ok: SQ1 S\" abc" ;
  okT{ SQ1 NIP -> 3 }T  Actual:Expected 3 =?= 3 
  okT{ SQ1 DROP C@ -> 61 }T  Actual:Expected 61 =?= 61 
  ok: SQ2 S\" a\qb\\c" ;
  okT{ SQ2 NIP -> 5 }T  Actual:Expected 5 =?= 5 
  okT{ SQ2 DROP 1+ C@ -> 22 }T  Actual:Expected 22 =?= 22 
  okT{ SQ2 DROP 3 + C@ -> 5C }T  Actual:Expected 5C =?= 5C 
  ok: SQ3 S\" \a\b\e\f\l\n\r\t\v\z" ;
  okT{ SQ3 NIP -> A }T  Actual:Expected A =?= A 
  okT{ SQ3 DROP C@ -> 7 }T  Actual:Expected 7 =?= 7 
  okT{ SQ3 DROP 2 + C@ -> 1B }T  Actual:Expected 1B =?= 1B 
  okT{ SQ3 DROP 8 + C@ -> B }T  Actual:Expected B =?= B 
  okT{ SQ3 DROP 9 + C@ -> 0 }T  Actual:Expected 0 =?= 0 
  ok: SQ4 S\" \m" ;
  okT{ SQ4 NIP -> 2 }T  Actual:Expected 2 =?= 2 
  okT{ SQ4 DROP C@ -> D }T  Actual:Expected D =?= D 
  okT{ SQ4 DROP 1+ C@ -> A }T  Actual:Expected A =?= A 
  ok\ \" does not end the string
  ok: SQ5 S\" x\"y" ;
  okT{ SQ5 NIP -> 3 }T  Actual:Expected 3 =?= 3 
  okT{ SQ5 DROP 1+ C@ -> 22 }T  Actual:Expected 22 =?= 22 
  ok\ Hex escapes: upper or lower case, two digits
  ok: SQ6 S\" \x41\x7a!" ;
  okT{ SQ6 NIP -> 3 }T  Actual:Expected 3 =?= 3 
  okT{ SQ6 DROP C@ -> 41 }T  Actual:Expected 41 =?= 41 
  okT{ SQ6 DROP 1+ C@ -> 7A }T  Actual:Expected 7A =?= 7A 
  okT{ SQ6 DROP 2 + C@ -> 21 }T  Actual:Expected 21 =?= 21 
  ok\ Interpreted S\" gives the same result
  okT{ S\" a\tb" NIP -> 3 }T  Actual:Expected 3 =?= 3 
  okT{ S\" a\tb" DROP 1+ C@ -> 9 }T  Actual:Expected 9 =?= 9 
  ok\ The text after the closing quote is still interpreted
  okT{ S\" \q" NIP 5 -> 1 5 }T  Actual:Expected 5 =?= 5 1 =?= 1 
  ok
  ok

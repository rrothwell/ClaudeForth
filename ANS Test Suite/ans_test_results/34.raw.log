\ ============================================================
  ok\ ANS test suite - HEADER and SMUDGE
  ok\ These two words are ClaudeForth extensions, not in the standard.
  ok\ They are the building blocks of CODE ... END-CODE, which is
  ok\ defined here as the first user of them.
  ok\ Requires ttester.fs then 00_test_prelude.fs to be loaded first.
  ok\ Written for this project (forth6809_stage_6i and later).
  ok\ ============================================================
  okMARKER M34
  okTEST-BEGIN
  okDECIMAL
  ok\ ---- CODE and END-CODE built from HEADER and SMUDGE
  okVOCABULARY TASM
  ok: CODE ( "name" -- ) -1 HEADER ALSO TASM ;
  ok: END-CODE ( -- ) 57 C, SMUDGE PREVIOUS ;
  okT{ GET-ORDER NIP -> 1 }T  Actual:Expected 1 =?= 1 
  okCODE T1 204 C, 0 C, 1 C, 54 C, 6 C, END-CODE
  okT{ GET-ORDER NIP -> 1 }T  Actual:Expected 1 =?= 1 
  okT{ T1 -> 1 }T  Actual:Expected 1 =?= 1 
  okT{ T1 T1 + -> 2 }T  Actual:Expected 2 =?= 2 
  ok\ ---- the word is hidden until SMUDGE (flag true)
  okCODE T2 57 C,
  okT{ GET-ORDER NIP NIP -> 2 }T  Actual:Expected 2 =?= 2 
  okT{ S" T2" FORTH-WORDLIST SEARCH-WORDLIST -> 0 }T  Actual:Expected 0 =?= 0 
  okSMUDGE PREVIOUS
  okT{ S" T2" FORTH-WORDLIST SEARCH-WORDLIST NIP -> -1 }T  Actual:Expected -1 =?= -1 
  okT{ GET-ORDER NIP -> 1 }T  Actual:Expected 1 =?= 1 
  ok\ ---- flag 0: the word is visible at once
  ok0 HEADER T3 57 C,
  okT{ S" T3" FORTH-WORDLIST SEARCH-WORDLIST NIP -> -1 }T  Actual:Expected -1 =?= -1 
  okT{ ' T3 EXECUTE -> }T
  ok\ ---- the xt is the code address (HERE) at the time of HEADER
  okHERE 0 HEADER T4 CONSTANT T4HERE
  okT{ ' T4 T4HERE = -> -1 }T  Actual:Expected -1 =?= -1 
  ok\ ---- SMUDGE toggles the newest header
  ok: T5 ;
  okT{ SMUDGE S" T5" FORTH-WORDLIST SEARCH-WORDLIST -> 0 }T  Actual:Expected 0 =?= 0 
  okT{ SMUDGE S" T5" FORTH-WORDLIST SEARCH-WORDLIST NIP -> -1 }T  Actual:Expected -1 =?= -1 
  ok\ ---- HEADER links into the current wordlist
  okWORDLIST CONSTANT TW
  okGET-CURRENT TW SET-CURRENT 0 HEADER T6 SET-CURRENT
  okT{ S" T6" TW SEARCH-WORDLIST NIP -> -1 }T  Actual:Expected -1 =?= -1 
  okT{ S" T6" FORTH-WORDLIST SEARCH-WORDLIST -> 0 }T  Actual:Expected 0 =?= 0 
  ok\ ---- an empty name is not accepted by the system: nothing to test
  okHEX
  okTEST-END
TEST SUMMARY: 15 run, 0 failed

  okM34
  ok
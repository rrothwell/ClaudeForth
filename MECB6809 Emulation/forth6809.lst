                      (    forth6809.asm):07421         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (    forth6809.asm):07422         ; clause. Compiles
                      (    forth6809.asm):07423         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (    forth6809.asm):07424         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (    forth6809.asm):07425         ; with selector=2, matching the second clause. Traced by hand:
                      (    forth6809.asm):07426         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (    forth6809.asm):07427         ; runs on a match, consuming the selector; ENDOF compiles an
                      (    forth6809.asm):07428         ; unconditional branch past the remaining clauses AND patches
                      (    forth6809.asm):07429         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (    forth6809.asm):07430         ; patches every pending ENDOF branch to the true end and
                      (    forth6809.asm):07431         ; compiles a final fallback DROP for the no-match case.
                      (    forth6809.asm):07432         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07433         TSTCASE1: LDD  CODEHERE
                      (    forth6809.asm):07434                   STD  TSTCSAV
                      (    forth6809.asm):07435                   LDD  #TSTCBUF
                      (    forth6809.asm):07436                   STD  CODEHERE
                      (    forth6809.asm):07437         
                      (    forth6809.asm):07438                   JSR  CASEW
                      (    forth6809.asm):07439         
                      (    forth6809.asm):07440                   LDD  #1
                      (    forth6809.asm):07441                   PSHU D
                      (    forth6809.asm):07442                   JSR  LITERALW
                      (    forth6809.asm):07443                   JSR  OF
                      (    forth6809.asm):07444                   LDD  #111
                      (    forth6809.asm):07445                   PSHU D
                      (    forth6809.asm):07446                   JSR  LITERALW
                      (    forth6809.asm):07447                   JSR  ENDOF
                      (    forth6809.asm):07448         
                      (    forth6809.asm):07449                   LDD  #2
                      (    forth6809.asm):07450                   PSHU D
                      (    forth6809.asm):07451                   JSR  LITERALW
                      (    forth6809.asm):07452                   JSR  OF
                      (    forth6809.asm):07453                   LDD  #222
                      (    forth6809.asm):07454                   PSHU D
                      (    forth6809.asm):07455                   JSR  LITERALW
                      (    forth6809.asm):07456                   JSR  ENDOF
                      (    forth6809.asm):07457         
                      (    forth6809.asm):07458                   JSR  ENDCASE
                      (    forth6809.asm):07459         
                      (    forth6809.asm):07460                   LDD  #OPRTS
                      (    forth6809.asm):07461                   PSHU D
                      (    forth6809.asm):07462                   JSR  CCOMMA
                      (    forth6809.asm):07463         
                      (    forth6809.asm):07464                   LDD  TSTCSAV
                      (    forth6809.asm):07465                   STD  CODEHERE
                      (    forth6809.asm):07466         
                      (    forth6809.asm):07467                   STU  TSTU0
                      (    forth6809.asm):07468         
                      (    forth6809.asm):07469                   LDD  #TSTGUARD
                      (    forth6809.asm):07470                   PSHU D
                      (    forth6809.asm):07471                   LDD  #2
                      (    forth6809.asm):07472                   PSHU D
                      (    forth6809.asm):07473                   STU  TSTUB4
                      (    forth6809.asm):07474         
                      (    forth6809.asm):07475                   JSR  TSTCBUF
                      (    forth6809.asm):07476         
                      (    forth6809.asm):07477                   STU  TSTUAF
                      (    forth6809.asm):07478         
                      (    forth6809.asm):07479                   PULU D
                      (    forth6809.asm):07480                   CMPD #222
                      (    forth6809.asm):07481                   BNE  C1FAIL
                      (    forth6809.asm):07482                   PULU D
                      (    forth6809.asm):07483                   CMPD #TSTGUARD
                      (    forth6809.asm):07484                   BNE  C1FAIL
                      (    forth6809.asm):07485         
                      (    forth6809.asm):07486                   LDD  TSTUB4
                      (    forth6809.asm):07487                   SUBD TSTUAF
                      (    forth6809.asm):07488                   CMPD #0
                      (    forth6809.asm):07489                   BNE  C1FAIL
                      (    forth6809.asm):07490         
                      (    forth6809.asm):07491                   LDD  #TRUEV
                      (    forth6809.asm):07492                   BRA  C1DONE
C100                  (    forth6809.asm):07493         C1FAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):07494         C1DONE:   LDX  #TSTCASE1NAME
                      (    forth6809.asm):07495                   PSHU X
                      (    forth6809.asm):07496                   PSHU D
                      (    forth6809.asm):07497                   JSR  TSTREPORT
                      (    forth6809.asm):07498         
                      (    forth6809.asm):07499                   LDU  TSTU0
                      (    forth6809.asm):07500                   RTS
                      (    forth6809.asm):07501         
C100                  (    forth6809.asm):07502         TSTCASE1NAME: FCB  9
                      (    forth6809.asm):07503                       FCC  "TSTCASE1"

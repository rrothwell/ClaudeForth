                      (    forth6809.asm):07687                    JSR  CATCH
                      (    forth6809.asm):07688         
                      (    forth6809.asm):07689                    STU  TSTUAF
                      (    forth6809.asm):07690         
                      (    forth6809.asm):07691                    PULU D
                      (    forth6809.asm):07692                    CMPD #-22
                      (    forth6809.asm):07693                    BNE  EOFAIL
                      (    forth6809.asm):07694         
                      (    forth6809.asm):07695                    LDD  TSTUB4
                      (    forth6809.asm):07696                    SUBD TSTUAF
                      (    forth6809.asm):07697                    CMPD #0
                      (    forth6809.asm):07698                    BNE  EOFAIL
                      (    forth6809.asm):07699         
                      (    forth6809.asm):07700                    LDD  #TRUEV
                      (    forth6809.asm):07701                    BRA  EODONE
C100                  (    forth6809.asm):07702         EOFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):07703         EODONE:    LDX  #TSTENDFZNAME
                      (    forth6809.asm):07704                    PSHU X
                      (    forth6809.asm):07705                    PSHU D
                      (    forth6809.asm):07706                    JSR  TSTREPORT
                      (    forth6809.asm):07707         
                      (    forth6809.asm):07708                    LDU  TSTU0
                      (    forth6809.asm):07709                    RTS
                      (    forth6809.asm):07710         
C100                  (    forth6809.asm):07711         TSTENDFZNAME: FCB  9
                      (    forth6809.asm):07712                       FCC  "TSTENDOFZ"
                      (    forth6809.asm):07713         
                      (    forth6809.asm):07714                    ENDC ; <<<<
                      (    forth6809.asm):07715         
                      (    forth6809.asm):07716         ; ------------------------------------------------------------
                      (    forth6809.asm):07717         ; TSTDEFWORDS - defining-words tests (glossary section 3.9, 17
                      (    forth6809.asm):07718         ; words, 12 tests since VALUE/TO and IS/ACTION-OF are each
                      (    forth6809.asm):07719         ; combined into one test). Every defining word parses a name
                      (    forth6809.asm):07720         ; from the input source via WORD (HEADER's own mechanism,
                      (    forth6809.asm):07721         ; shared by :/CREATE) - a complexity nothing in section 3.8 had.
                      (    forth6809.asm):07722         ; Each test redirects CODEHERE, DPHERE, VARHERE, and
                      (    forth6809.asm):07723         ; SRCADDR/SRCLEN/TOIN together (a fake name, "TESTWD", reused
                      (    forth6809.asm):07724         ; safely across every test here since each redirect/restore
                      (    forth6809.asm):07725         ; cycle is fully isolated), calls the real defining word
                      (    forth6809.asm):07726         ; directly, saves the newly-defined word's own CFA (= CODEHERE
                      (    forth6809.asm):07727         ; at the moment the defining word was called), restores
                      (    forth6809.asm):07728         ; everything, then executes that CFA directly to verify runtime
                      (    forth6809.asm):07729         ; behavior.
                      (    forth6809.asm):07730         ;
                      (    forth6809.asm):07731         ; A real, structurally important finding from this section:
                      (    forth6809.asm):07732         ; HEADER writes to the real LATEST variable unconditionally, not
                      (    forth6809.asm):07733         ; a redirectable copy like CODEHERE/DPHERE/VARHERE - every test
                      (    forth6809.asm):07734         ; here explicitly saves and restores it, confirmed necessary by
                      (    forth6809.asm):07735         ; reading HEADER's own code directly, not assumed safe by analogy
                      (    forth6809.asm):07736         ; with the other three pointers.
                      (    forth6809.asm):07737         ;
                      (    forth6809.asm):07738         ; MARKER's own test is the one exception to the general
                      (    forth6809.asm):07739         ; redirect-then-restore-then-execute order: DOMARKER (confirmed
                      (    forth6809.asm):07740         ; by reading it directly) writes to the real DPHERE/CODEHERE/
                      (    forth6809.asm):07741         ; VARHERE/LATEST unconditionally too, so that test executes the
                      (    forth6809.asm):07742         ; marker word while still redirected, only restoring the real
                      (    forth6809.asm):07743         ; environment afterward - getting this order backwards would
                      (    forth6809.asm):07744         ; have corrupted the real dictionary pointers with scratch
                      (    forth6809.asm):07745         ; addresses.
                      (    forth6809.asm):07746         ;
                      (    forth6809.asm):07747         ; Bare CREATE (never followed by DOES>) is deliberately not
                      (    forth6809.asm):07748         ; tested on its own - traced its placeholder "behavior field"
                      (    forth6809.asm):07749         ; (a genuine compiled JSR DOESRT0 instruction) and confirmed
                      (    forth6809.asm):07750         ; DODOES reads that field as raw data, not as code to execute -
                      (    forth6809.asm):07751         ; which only produces a valid jump target for the raw-address
                      (    forth6809.asm):07752         ; form every other defining word uses (VARIABLE, CONSTANT, etc,
                      (    forth6809.asm):07753         ; via CODECOMMA), not CREATE's own placeholder JSR instruction.
                      (    forth6809.asm):07754         ; Bare CREATE's own direct-execution behavior isn't meant to be
                      (    forth6809.asm):07755         ; relied upon before a DOES> patches it.
                      (    forth6809.asm):07756         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07757         TSTDEFWORDS: JSR CRW
                      (    forth6809.asm):07758                    LDX   #TSTDEFMSG
                      (    forth6809.asm):07759                    PSHU  X
                      (    forth6809.asm):07760                    LDD   #8
                      (    forth6809.asm):07761                    PSHU  D
                      (    forth6809.asm):07762                    JSR   TYPE
                      (    forth6809.asm):07763                    JSR   CRW
                      (    forth6809.asm):07764         
                      (    forth6809.asm):07765                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07766         
                      (    forth6809.asm):07767                    JSR   TSTVAR
                      (    forth6809.asm):07768                    JSR   TSTCONST
                      (    forth6809.asm):07769                    JSR   TSTCOLON
                      (    forth6809.asm):07770                    JSR   TSTCRDOES
                      (    forth6809.asm):07771                    JSR   TST2VAR
                      (    forth6809.asm):07772                    JSR   TST2CONST
                      (    forth6809.asm):07773                    JSR   TSTBUFC
                      (    forth6809.asm):07774                    JSR   TSTVALTO
                      (    forth6809.asm):07775                    JSR   TSTDEFER1
                      (    forth6809.asm):07776                    JSR   TSTDEFER2
                      (    forth6809.asm):07777                    JSR   TSTISOF
                      (    forth6809.asm):07778                    JSR   TSTMARKER
                      (    forth6809.asm):07779         
                      (    forth6809.asm):07780                    ENDC ; <<<<
                      (    forth6809.asm):07781         
                      (    forth6809.asm):07782                    RTS
                      (    forth6809.asm):07783         
C100                  (    forth6809.asm):07784         TSTDEFMSG: FCC "DefWords"
                      (    forth6809.asm):07785         
                      (    forth6809.asm):07786                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07787         
                      (    forth6809.asm):07788         ; ------------------------------------------------------------
                      (    forth6809.asm):07789         ; Defining-words test harness (glossary section 3.9). Every
                      (    forth6809.asm):07790         ; defining word parses a name from the input source via WORD -
                      (    forth6809.asm):07791         ; unlike anything in section 3.8's control-flow tests - so each
                      (    forth6809.asm):07792         ; test redirects CODEHERE, DPHERE, VARHERE, and SRCADDR/SRCLEN/
                      (    forth6809.asm):07793         ; TOIN together (a fake name text, "TESTWD", reused safely
                      (    forth6809.asm):07794         ; across every test here since each redirect/restore cycle is
                      (    forth6809.asm):07795         ; fully isolated), calls the real defining word directly, saves
                      (    forth6809.asm):07796         ; the newly-defined word's own CFA (= CODEHERE at the moment the
                      (    forth6809.asm):07797         ; defining word was called), restores everything, then executes
                      (    forth6809.asm):07798         ; that CFA directly to verify runtime behavior. Traced by hand:
                      (    forth6809.asm):07799         ; CREATE/VARIABLE/CONSTANT/etc all use HEADER (shared header-
                      (    forth6809.asm):07800         ; building) then compile a fixed 5-byte trampoline (3-byte
                      (    forth6809.asm):07801         ; "JSR DODOES" + a 2-byte "behavior field") before their own
                      (    forth6809.asm):07802         ; PFA - confirmed the behavior field holds a genuine compiled
                      (    forth6809.asm):07803         ; JSR instruction only for CREATE's own bare placeholder
                      (    forth6809.asm):07804         ; (DOESRT0, later patched by DOES>); every other defining word
                      (    forth6809.asm):07805         ; (VARIABLE, CONSTANT, DEFER, MARKER, VALUE) instead compiles a
                      (    forth6809.asm):07806         ; raw 2-byte address there directly (via CODECOMMA, not CCALL) -
                      (    forth6809.asm):07807         ; DODOES reads this field as data either way, which only works
                      (    forth6809.asm):07808         ; correctly for the raw-address form. This is why bare CREATE,
                      (    forth6809.asm):07809         ; executed before any DOES>, isn't tested here - its own
                      (    forth6809.asm):07810         ; placeholder behavior field isn't meant to be read as data,
                      (    forth6809.asm):07811         ; only ever overwritten by DOES> before first use.
                      (    forth6809.asm):07812         ; ------------------------------------------------------------
                      (    forth6809.asm):07813         
                      (    forth6809.asm):07814         ; ------------------------------------------------------------
                      (    forth6809.asm):07815         ; TSTVAR - unit test for VARIABLE. Compiles "VARIABLE TESTWD"
                      (    forth6809.asm):07816         ; into scratch, then executes the result. Verifies it pushes
                      (    forth6809.asm):07817         ; its own PFA address (TSTVBUF, since VARHERE was redirected
                      (    forth6809.asm):07818         ; there) and that the cell there was correctly initialized to
                      (    forth6809.asm):07819         ; zero - VARIABLE's own documented behavior, not assumed.
                      (    forth6809.asm):07820         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07821         TSTVAR:  LDD   CODEHERE
                      (    forth6809.asm):07822                  STD   TSTCSAV
                      (    forth6809.asm):07823                  LDD   DPHERE
                      (    forth6809.asm):07824                  STD   TSTDSAV
                      (    forth6809.asm):07825                  LDD   VARHERE
                      (    forth6809.asm):07826                  STD   TSTVSAV
                      (    forth6809.asm):07827                  LDD   SRCADDR
                      (    forth6809.asm):07828                  STD   TSTSASAV
                      (    forth6809.asm):07829                  LDD   SRCLEN
                      (    forth6809.asm):07830                  STD   TSTSLSAV
                      (    forth6809.asm):07831                  LDD   TOIN
                      (    forth6809.asm):07832                  STD   TSTTISAV
                      (    forth6809.asm):07833                  LDD   LATEST
                      (    forth6809.asm):07834                  STD   TSTLSAV
                      (    forth6809.asm):07835         
                      (    forth6809.asm):07836                  LDA   #'T'
                      (    forth6809.asm):07837                  STA   TSTNAMEB
                      (    forth6809.asm):07838                  LDA   #'E'
                      (    forth6809.asm):07839                  STA   TSTNAMEB+1
                      (    forth6809.asm):07840                  LDA   #'S'
                      (    forth6809.asm):07841                  STA   TSTNAMEB+2
                      (    forth6809.asm):07842                  LDA   #'T'
                      (    forth6809.asm):07843                  STA   TSTNAMEB+3
                      (    forth6809.asm):07844                  LDA   #'W'
                      (    forth6809.asm):07845                  STA   TSTNAMEB+4
                      (    forth6809.asm):07846                  LDA   #'D'
                      (    forth6809.asm):07847                  STA   TSTNAMEB+5
                      (    forth6809.asm):07848         
                      (    forth6809.asm):07849                  LDD   #TSTCBUF
                      (    forth6809.asm):07850                  STD   CODEHERE
                      (    forth6809.asm):07851                  LDD   #TSTDBUF
                      (    forth6809.asm):07852                  STD   DPHERE
                      (    forth6809.asm):07853                  LDD   #TSTVBUF
                      (    forth6809.asm):07854                  STD   VARHERE
                      (    forth6809.asm):07855                  LDD   #TSTNAMEB
                      (    forth6809.asm):07856                  STD   SRCADDR
                      (    forth6809.asm):07857                  LDD   #6
                      (    forth6809.asm):07858                  STD   SRCLEN
                      (    forth6809.asm):07859                  LDD   #0
                      (    forth6809.asm):07860                  STD   TOIN
                      (    forth6809.asm):07861         
                      (    forth6809.asm):07862                  LDD   CODEHERE
                      (    forth6809.asm):07863                  STD   TSTWCFA
                      (    forth6809.asm):07864         
                      (    forth6809.asm):07865                  JSR   VARIABLE
                      (    forth6809.asm):07866         
                      (    forth6809.asm):07867                  LDD   TSTCSAV
                      (    forth6809.asm):07868                  STD   CODEHERE
                      (    forth6809.asm):07869                  LDD   TSTDSAV
                      (    forth6809.asm):07870                  STD   DPHERE
                      (    forth6809.asm):07871                  LDD   TSTVSAV
                      (    forth6809.asm):07872                  STD   VARHERE
                      (    forth6809.asm):07873                  LDD   TSTSASAV
                      (    forth6809.asm):07874                  STD   SRCADDR
                      (    forth6809.asm):07875                  LDD   TSTSLSAV
                      (    forth6809.asm):07876                  STD   SRCLEN
                      (    forth6809.asm):07877                  LDD   TSTTISAV
                      (    forth6809.asm):07878                  STD   TOIN
                      (    forth6809.asm):07879                  LDD   TSTLSAV
                      (    forth6809.asm):07880                  STD   LATEST
                      (    forth6809.asm):07881         
                      (    forth6809.asm):07882                  STU   TSTU0
                      (    forth6809.asm):07883         
                      (    forth6809.asm):07884                  LDD   #TSTGUARD
                      (    forth6809.asm):07885                  PSHU  D
                      (    forth6809.asm):07886                  STU   TSTUB4
                      (    forth6809.asm):07887         
                      (    forth6809.asm):07888                  LDX   TSTWCFA
                      (    forth6809.asm):07889                  JSR   ,X
                      (    forth6809.asm):07890         
                      (    forth6809.asm):07891                  STU   TSTUAF
                      (    forth6809.asm):07892         
                      (    forth6809.asm):07893                  PULU  D
                      (    forth6809.asm):07894                  CMPD  #TSTVBUF
                      (    forth6809.asm):07895                  BNE   VRFAIL
                      (    forth6809.asm):07896         
                      (    forth6809.asm):07897                  LDX   TSTVBUF
                      (    forth6809.asm):07898                  LDD   ,X
                      (    forth6809.asm):07899                  CMPD  #0
                      (    forth6809.asm):07900                  BNE   VRFAIL
                      (    forth6809.asm):07901         
                      (    forth6809.asm):07902                  PULU  D
                      (    forth6809.asm):07903                  CMPD  #TSTGUARD
                      (    forth6809.asm):07904                  BNE   VRFAIL
                      (    forth6809.asm):07905         
                      (    forth6809.asm):07906                  LDD   TSTUB4
                      (    forth6809.asm):07907                  SUBD  TSTUAF
                      (    forth6809.asm):07908                  CMPD  #2
                      (    forth6809.asm):07909                  BNE   VRFAIL
                      (    forth6809.asm):07910         
                      (    forth6809.asm):07911                  LDD   #TRUEV
                      (    forth6809.asm):07912                  BRA   VRDONE
C100                  (    forth6809.asm):07913         VRFAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):07914         VRDONE:  LDX   #TSTVARNAME
                      (    forth6809.asm):07915                  PSHU  X
                      (    forth6809.asm):07916                  PSHU  D
                      (    forth6809.asm):07917                  JSR   TSTREPORT
                      (    forth6809.asm):07918         
                      (    forth6809.asm):07919                  LDU   TSTU0
                      (    forth6809.asm):07920                  RTS
                      (    forth6809.asm):07921         
C100                  (    forth6809.asm):07922         TSTVARNAME: FCB  6
                      (    forth6809.asm):07923                     FCC  "TSTVAR"
                      (    forth6809.asm):07924         
                      (    forth6809.asm):07925         ; ------------------------------------------------------------
                      (    forth6809.asm):07926         ; TSTCONST - unit test for CONSTANT. Compiles "5 CONSTANT
                      (    forth6809.asm):07927         ; TESTWD" (5 already pushed before CONSTANT runs, matching its
                      (    forth6809.asm):07928         ; own "x name --" signature) into scratch, then executes the
                      (    forth6809.asm):07929         ; result. Verifies it pushes the stored value (5), not its own
                      (    forth6809.asm):07930         ; address - confirmed by tracing CONSTANT's own behavior field:
                      (    forth6809.asm):07931         ; it compiles a raw address to ATSIGN (@) there directly via
                      (    forth6809.asm):07932         ; CODECOMMA, not CREATE's own placeholder mechanism.
                      (    forth6809.asm):07933         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07934         TSTCONST: LDD  CODEHERE
                      (    forth6809.asm):07935                   STD  TSTCSAV
                      (    forth6809.asm):07936                   LDD  DPHERE
                      (    forth6809.asm):07937                   STD  TSTDSAV
                      (    forth6809.asm):07938                   LDD  VARHERE
                      (    forth6809.asm):07939                   STD  TSTVSAV
                      (    forth6809.asm):07940                   LDD  SRCADDR
                      (    forth6809.asm):07941                   STD  TSTSASAV
                      (    forth6809.asm):07942                   LDD  SRCLEN
                      (    forth6809.asm):07943                   STD  TSTSLSAV
                      (    forth6809.asm):07944                   LDD  TOIN
                      (    forth6809.asm):07945                   STD  TSTTISAV
                      (    forth6809.asm):07946                   LDD  LATEST
                      (    forth6809.asm):07947                   STD  TSTLSAV
                      (    forth6809.asm):07948         
                      (    forth6809.asm):07949                   LDA  #'T'
                      (    forth6809.asm):07950                   STA  TSTNAMEB
                      (    forth6809.asm):07951                   LDA  #'E'
                      (    forth6809.asm):07952                   STA  TSTNAMEB+1
                      (    forth6809.asm):07953                   LDA  #'S'
                      (    forth6809.asm):07954                   STA  TSTNAMEB+2
                      (    forth6809.asm):07955                   LDA  #'T'
                      (    forth6809.asm):07956                   STA  TSTNAMEB+3
                      (    forth6809.asm):07957                   LDA  #'W'
                      (    forth6809.asm):07958                   STA  TSTNAMEB+4
                      (    forth6809.asm):07959                   LDA  #'D'
                      (    forth6809.asm):07960                   STA  TSTNAMEB+5
                      (    forth6809.asm):07961         
                      (    forth6809.asm):07962                   LDD  #TSTCBUF
                      (    forth6809.asm):07963                   STD  CODEHERE
                      (    forth6809.asm):07964                   LDD  #TSTDBUF
                      (    forth6809.asm):07965                   STD  DPHERE
                      (    forth6809.asm):07966                   LDD  #TSTVBUF
                      (    forth6809.asm):07967                   STD  VARHERE
                      (    forth6809.asm):07968                   LDD  #TSTNAMEB
                      (    forth6809.asm):07969                   STD  SRCADDR
                      (    forth6809.asm):07970                   LDD  #6
                      (    forth6809.asm):07971                   STD  SRCLEN
                      (    forth6809.asm):07972                   LDD  #0
                      (    forth6809.asm):07973                   STD  TOIN
                      (    forth6809.asm):07974         
                      (    forth6809.asm):07975                   LDD  CODEHERE
                      (    forth6809.asm):07976                   STD  TSTWCFA
                      (    forth6809.asm):07977         
                      (    forth6809.asm):07978                   LDD  #5
                      (    forth6809.asm):07979                   PSHU D
                      (    forth6809.asm):07980                   JSR  CONSTANT
                      (    forth6809.asm):07981         
                      (    forth6809.asm):07982                   LDD  TSTCSAV
                      (    forth6809.asm):07983                   STD  CODEHERE
                      (    forth6809.asm):07984                   LDD  TSTDSAV
                      (    forth6809.asm):07985                   STD  DPHERE
                      (    forth6809.asm):07986                   LDD  TSTVSAV

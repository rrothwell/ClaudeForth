                      (    forth6809.asm):06134         ; ------------------------------------------------------------
                      (    forth6809.asm):06135         ; TSTCTRLFLOW - control-flow tests (glossary section 3.8, 22
                      (    forth6809.asm):06136         ; words - all except UNLOOP, which is a genuine runtime no-op
                      (    forth6809.asm):06137         ; and tested directly like ALIGN's own test, needing none of
                      (    forth6809.asm):06138         ; this section's compile-time harness). Every other test
                      (    forth6809.asm):06139         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):06140         ; real compile-time words directly (JSR IF, JSR THEN, JSR DO,
                      (    forth6809.asm):06141         ; etc - the actual routines the compiler itself calls, not a
                      (    forth6809.asm):06142         ; hand-simulated imitation), restores CODEHERE, then executes
                      (    forth6809.asm):06143         ; the compiled snippet directly. Tests the real interaction
                      (    forth6809.asm):06144         ; between compile-time correctness (right bytes, right patched
                      (    forth6809.asm):06145         ; offsets) and runtime correctness (right control flow) in one
                      (    forth6809.asm):06146         ; coherent check, without needing the outer interpreter, FIND,
                      (    forth6809.asm):06147         ; or a real dictionary entry.
                      (    forth6809.asm):06148         ;
                      (    forth6809.asm):06149         ; Given the planned future application of the ANS test suite for
                      (    forth6809.asm):06150         ; broader standards-compliance coverage, these tests focus on
                      (    forth6809.asm):06151         ; this system's own compile/patch mechanism working correctly -
                      (    forth6809.asm):06152         ; not full end-to-end parsing, which the ANS suite will cover.
                      (    forth6809.asm):06153         ;
                      (    forth6809.asm):06154         ; One case is deliberately NOT tested: DO with limit=index.
                      (    forth6809.asm):06155         ; Traced precisely (simulated the real DOTEST increment-and-
                      (    forth6809.asm):06156         ; compare-equal logic) and confirmed it takes a full 65536-
                      (    forth6809.asm):06157         ; iteration wraparound to naturally reconverge on equality, not
                      (    forth6809.asm):06158         ; one - true to the letter of "runs at least once" but
                      (    forth6809.asm):06159         ; impractical for a boot-time self-check. ?DO's own equivalent
                      (    forth6809.asm):06160         ; case IS tested (TSTQDOLPEQ) - its own skip check happens
                      (    forth6809.asm):06161         ; before the loop is entered at all, confirmed fast and safe by
                      (    forth6809.asm):06162         ; the same kind of trace.
                      (    forth6809.asm):06163         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06164         TSTCTRLFLOW: JSR CRW
                      (    forth6809.asm):06165                    LDX   #TSTCTRLMSG
                      (    forth6809.asm):06166                    PSHU  X
                      (    forth6809.asm):06167                    LDD   #8
                      (    forth6809.asm):06168                    PSHU  D
                      (    forth6809.asm):06169                    JSR   TYPE
                      (    forth6809.asm):06170                    JSR   CRW
                      (    forth6809.asm):06171         
                      (    forth6809.asm):06172                    IFEQ TSTSELECTOR-7  ; >>>>
                      (    forth6809.asm):06173         
                      (    forth6809.asm):06174                    JSR   TSTIFT1
                      (    forth6809.asm):06175                    JSR   TSTIFT2
                      (    forth6809.asm):06176                    JSR   TSTIET1
                      (    forth6809.asm):06177                    JSR   TSTIET2
                      (    forth6809.asm):06178                    JSR   TSTBGU
                      (    forth6809.asm):06179                    JSR   TSTBWR
                      (    forth6809.asm):06180                    JSR   TSTRECUR
                      (    forth6809.asm):06181                    JSR   TSTDOLP
                      (    forth6809.asm):06182                    JSR   TSTQDOLP
                      (    forth6809.asm):06183                    JSR   TSTQDOLPEQ
                      (    forth6809.asm):06184                    JSR   TSTPLOOP
                      (    forth6809.asm):06185                    JSR   TSTJIDX
                      (    forth6809.asm):06186                    JSR   TSTLEAVE
                      (    forth6809.asm):06187                    JSR   TSTEXIT
                      (    forth6809.asm):06188                    JSR   TSTUNLOOP
                      (    forth6809.asm):06189                    JSR   TSTCASE1
                      (    forth6809.asm):06190                    JSR   TSTCASE2
                      (    forth6809.asm):06191                    JSR   TSTTHENZ
                      (    forth6809.asm):06192                    JSR   TSTUNTILZ
                      (    forth6809.asm):06193                    JSR   TSTENDOFZ
                      (    forth6809.asm):06194         
                      (    forth6809.asm):06195                    ENDC ; <<<<
                      (    forth6809.asm):06196         
                      (    forth6809.asm):06197                    RTS
                      (    forth6809.asm):06198         
C100                  (    forth6809.asm):06199         TSTCTRLMSG: FCC "CtrlFlow"
                      (    forth6809.asm):06200         
                      (    forth6809.asm):06201                    IFEQ TSTSELECTOR-7  ; >>>>
                      (    forth6809.asm):06202         
                      (    forth6809.asm):06203         ; ------------------------------------------------------------
                      (    forth6809.asm):06204         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):06205         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):06206         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):06207         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):06208         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):06209         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):06210         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):06211         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):06212         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):06213         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):06214         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):06215         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):06216         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):06217         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):06218         ; ------------------------------------------------------------
                      (    forth6809.asm):06219         
                      (    forth6809.asm):06220         ; ------------------------------------------------------------
                      (    forth6809.asm):06221         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):06222         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):06223         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):06224         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):06225         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):06226         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):06227         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):06228         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06229         TSTIFT1: LDD   CODEHERE
                      (    forth6809.asm):06230                  STD   TSTCSAV
                      (    forth6809.asm):06231                  LDD   #TSTCBUF
                      (    forth6809.asm):06232                  STD   CODEHERE
                      (    forth6809.asm):06233         
                      (    forth6809.asm):06234                  JSR   IF
                      (    forth6809.asm):06235         
                      (    forth6809.asm):06236                  LDD   #111
                      (    forth6809.asm):06237                  PSHU  D
                      (    forth6809.asm):06238                  JSR   LITERALW
                      (    forth6809.asm):06239         
                      (    forth6809.asm):06240                  JSR   THEN
                      (    forth6809.asm):06241         
                      (    forth6809.asm):06242                  LDD   #OPRTS
                      (    forth6809.asm):06243                  PSHU  D
                      (    forth6809.asm):06244                  JSR   CCOMMA
                      (    forth6809.asm):06245         
                      (    forth6809.asm):06246                  LDD   TSTCSAV
                      (    forth6809.asm):06247                  STD   CODEHERE
                      (    forth6809.asm):06248         
                      (    forth6809.asm):06249                  STU   TSTU0
                      (    forth6809.asm):06250         
                      (    forth6809.asm):06251                  LDD   #TSTGUARD
                      (    forth6809.asm):06252                  PSHU  D
                      (    forth6809.asm):06253                  LDD   #TRUEV
                      (    forth6809.asm):06254                  PSHU  D
                      (    forth6809.asm):06255                  STU   TSTUB4
                      (    forth6809.asm):06256         
                      (    forth6809.asm):06257                  JSR   TSTCBUF
                      (    forth6809.asm):06258         
                      (    forth6809.asm):06259                  STU   TSTUAF
                      (    forth6809.asm):06260         
                      (    forth6809.asm):06261                  PULU  D
                      (    forth6809.asm):06262                  CMPD  #111
                      (    forth6809.asm):06263                  BNE   T1FAIL
                      (    forth6809.asm):06264                  PULU  D
                      (    forth6809.asm):06265                  CMPD  #TSTGUARD
                      (    forth6809.asm):06266                  BNE   T1FAIL
                      (    forth6809.asm):06267         
                      (    forth6809.asm):06268                  LDD   TSTUB4
                      (    forth6809.asm):06269                  SUBD  TSTUAF
                      (    forth6809.asm):06270                  CMPD  #0
                      (    forth6809.asm):06271                  BNE   T1FAIL
                      (    forth6809.asm):06272         
                      (    forth6809.asm):06273                  LDD   #TRUEV
                      (    forth6809.asm):06274                  BRA   T1DONE
C100                  (    forth6809.asm):06275         T1FAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):06276         T1DONE:  LDX   #TSTIFT1NAME
                      (    forth6809.asm):06277                  PSHU  X
                      (    forth6809.asm):06278                  PSHU  D
                      (    forth6809.asm):06279                  JSR   TSTREPORT
                      (    forth6809.asm):06280         
                      (    forth6809.asm):06281                  LDU   TSTU0
                      (    forth6809.asm):06282                  RTS
                      (    forth6809.asm):06283         
C100                  (    forth6809.asm):06284         TSTIFT1NAME: FCB  7
                      (    forth6809.asm):06285                      FCC  "TSTIFT1"
                      (    forth6809.asm):06286         
                      (    forth6809.asm):06287         ; ------------------------------------------------------------
                      (    forth6809.asm):06288         ; TSTIFT2 - unit test for IF/THEN, false case. Same compiled
                      (    forth6809.asm):06289         ; snippet as TSTIFT1, run with a false flag instead - the
                      (    forth6809.asm):06290         ; branch IS taken, jumping straight past the LIT+111, so 111
                      (    forth6809.asm):06291         ; should NOT appear; only the guard remains.
                      (    forth6809.asm):06292         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06293         TSTIFT2: LDD   CODEHERE
                      (    forth6809.asm):06294                  STD   TSTCSAV
                      (    forth6809.asm):06295                  LDD   #TSTCBUF
                      (    forth6809.asm):06296                  STD   CODEHERE

                      (    forth6809.asm):03742         ; TSTSTSLZ - unit test for STARSLASH, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):03743         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):03744         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):03745         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):03746         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):03747         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):03748         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):03749         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):03750         ; there are.
                      (    forth6809.asm):03751         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03752         TSTSTSLZ:   STU   TSTU0
                      (    forth6809.asm):03753         
                      (    forth6809.asm):03754                    LDD   #TSTVAL1
                      (    forth6809.asm):03755                    PSHU  D
                      (    forth6809.asm):03756                    LDD   #TSTVAL2
                      (    forth6809.asm):03757                    PSHU  D
                      (    forth6809.asm):03758                    LDD   #$0000
                      (    forth6809.asm):03759                    PSHU  D
                      (    forth6809.asm):03760                    LDX   #STARSLASH
                      (    forth6809.asm):03761                    PSHU  X
                      (    forth6809.asm):03762                    STU   TSTUB4
                      (    forth6809.asm):03763         
                      (    forth6809.asm):03764                    JSR   CATCH
                      (    forth6809.asm):03765         
                      (    forth6809.asm):03766                    STU   TSTUAF
                      (    forth6809.asm):03767         
                      (    forth6809.asm):03768                    PULU  D
                      (    forth6809.asm):03769                    CMPD  #-10
                      (    forth6809.asm):03770                    BNE   TZFAIL
                      (    forth6809.asm):03771         
                      (    forth6809.asm):03772                    LDD   TSTUB4
                      (    forth6809.asm):03773                    SUBD  TSTUAF
                      (    forth6809.asm):03774                    CMPD  #0
                      (    forth6809.asm):03775                    BNE   TZFAIL
                      (    forth6809.asm):03776         
                      (    forth6809.asm):03777                    LDD   #TRUEV
                      (    forth6809.asm):03778                    BRA   TZDONE
C100                  (    forth6809.asm):03779         TZFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):03780         TZDONE:     LDX   #TSTSTSLZNAME
                      (    forth6809.asm):03781                    PSHU  X
                      (    forth6809.asm):03782                    PSHU  D
                      (    forth6809.asm):03783                    JSR   TSTREPORT
                      (    forth6809.asm):03784         
                      (    forth6809.asm):03785                    LDU   TSTU0
                      (    forth6809.asm):03786                    RTS
                      (    forth6809.asm):03787         
C100                  (    forth6809.asm):03788         TSTSTSLZNAME: FCB  8
                      (    forth6809.asm):03789                         FCC  "TSTSTSLZ"

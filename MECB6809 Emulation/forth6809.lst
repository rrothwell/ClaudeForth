                      (    forth6809.asm):04867         ; Arity: 2 cell(s) in, 1 cell(s) out -> depth check
                      (    forth6809.asm):04868         ; -2 (derived, not hand-typed).
                      (    forth6809.asm):04869         ; ------------------------------------------------------------
C100                  (    forth6809.asm):04870         TSTAND:     STU   TSTU0
                      (    forth6809.asm):04871         

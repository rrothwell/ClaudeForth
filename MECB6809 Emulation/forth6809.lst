                      (    forth6809.asm):02106                    BNE   TKFAIL
                      (    forth6809.asm):02107                    PULU  D
                      (    forth6809.asm):02108                    CMPD  #TSTVAL2
                      (    forth6809.asm):02109                    BNE   TKFAIL
                      (    forth6809.asm):02110                    PULU  D
                      (    forth6809.asm):02111                    CMPD  #TSTGUARD
                      (    forth6809.asm):02112                    BNE   TKFAIL
                      (    forth6809.asm):02113         
                      (    forth6809.asm):02114                    LDD   TSTUB4
                      (    forth6809.asm):02115                    SUBD  TSTUAF
                      (    forth6809.asm):02116                    CMPD  #2
                      (    forth6809.asm):02117                    BNE   TKFAIL
                      (    forth6809.asm):02118         

                      (    forth6809.asm):09441         ; ------------------------------------------------------------
                      (    forth6809.asm):09442         ; TSTCOMPWORDS - compiling-words tests (glossary section 3.10,
                      (    forth6809.asm):09443         ; 13 words, 17 tests since several get separate cases: TICK
                      (    forth6809.asm):09444         ; found/not-found, ['] compiling/interpreting state, POSTPONE
                      (    forth6809.asm):09445         ; normal/immediate word, SLITERAL compiling/interpreting state,
                      (    forth6809.asm):09446         ; ABORT" false/true flag). Reuses the scratch infrastructure
                      (    forth6809.asm):09447         ; established for sections 3.8/3.9 throughout.
                      (    forth6809.asm):09448         ;
                      (    forth6809.asm):09449         ; POSTPONE is this section's hardest case: a genuine two-level
                      (    forth6809.asm):09450         ; compile-time mechanism. Traced its own code first - for a
                      (    forth6809.asm):09451         ; normal word, it compiles code that ITSELF compiles a call to
                      (    forth6809.asm):09452         ; that word later, when the current definition eventually runs,
                      (    forth6809.asm):09453         ; not immediately (standard ANS semantics: POSTPONE appends a
                      (    forth6809.asm):09454         ; word's own compilation semantics to the current definition,
                      (    forth6809.asm):09455         ; and for an ordinary word that semantics IS "compile a call to
                      (    forth6809.asm):09456         ; it", so appending it only makes sense if the current
                      (    forth6809.asm):09457         ; definition later performs that compiling action itself,
                      (    forth6809.asm):09458         ; against whatever's being compiled at that later point).
                      (    forth6809.asm):09459         ; Verified via the compiled byte sequence directly rather than
                      (    forth6809.asm):09460         ; fully executing a triple-nested compile chain.
                      (    forth6809.asm):09461         ;
                      (    forth6809.asm):09462         ; ABORT" is safely testable for both its flag cases - confirmed
                      (    forth6809.asm):09463         ; by reading its own runtime code that it uses THROW -2
                      (    forth6809.asm):09464         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09465         ; ABORT itself uses (still deliberately untested, per section
                      (    forth6809.asm):09466         ; 3.1's own reasoning).
                      (    forth6809.asm):09467         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09468         TSTCOMPWORDS: JSR CRW
                      (    forth6809.asm):09469                    LDX   #TSTCWMSG
                      (    forth6809.asm):09470                    PSHU  X
                      (    forth6809.asm):09471                    LDD   #9
                      (    forth6809.asm):09472                    PSHU  D
                      (    forth6809.asm):09473                    JSR   TYPE
                      (    forth6809.asm):09474                    JSR   CRW
                      (    forth6809.asm):09475         
                      (    forth6809.asm):09476                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09477         
                      (    forth6809.asm):09478                    JSR   TSTIMMED
                      (    forth6809.asm):09479                    JSR   TSTSTATE
                      (    forth6809.asm):09480                    JSR   TSTBRACKETS
                      (    forth6809.asm):09481                    JSR   TSTTICK1
                      (    forth6809.asm):09482                    JSR   TSTTICK2
                      (    forth6809.asm):09483                    JSR   TSTCOMPCOMMA
                      (    forth6809.asm):09484                    JSR   TSTLITERAL
                      (    forth6809.asm):09485                    JSR   TSTBRACKTICK1
                      (    forth6809.asm):09486                    JSR   TSTBRACKTICK2
                      (    forth6809.asm):09487                    JSR   TSTPOSTPONE1
                      (    forth6809.asm):09488                    JSR   TSTPOSTPONE2
                      (    forth6809.asm):09489                    JSR   TSTTOBODY
                      (    forth6809.asm):09490                    JSR   TSTEXECUTE
                      (    forth6809.asm):09491                    JSR   TSTSLITERAL1
                      (    forth6809.asm):09492                    JSR   TSTSLITERAL2
                      (    forth6809.asm):09493                    JSR   TSTABORTQ1
                      (    forth6809.asm):09494                    JSR   TSTABORTQ2
                      (    forth6809.asm):09495         
                      (    forth6809.asm):09496                    ENDC ; <<<<
                      (    forth6809.asm):09497         
                      (    forth6809.asm):09498                    RTS
                      (    forth6809.asm):09499         
C100                  (    forth6809.asm):09500         TSTCWMSG: FCC "CompWords"
                      (    forth6809.asm):09501         
                      (    forth6809.asm):09502                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09503         
                      (    forth6809.asm):09504         ; ------------------------------------------------------------
                      (    forth6809.asm):09505         ; Compiling-words test harness (glossary section 3.10). Reuses
                      (    forth6809.asm):09506         ; the scratch infrastructure established for sections 3.8/3.9
                      (    forth6809.asm):09507         ; (TSTCBUF/TSTCBUF2 for CODEHERE redirects, TSTFHDR for a fake
                      (    forth6809.asm):09508         ; dictionary header, TSTNAMEB for a fake source name). POSTPONE
                      (    forth6809.asm):09509         ; is this section's own hardest case: a genuine two-level
                      (    forth6809.asm):09510         ; compile-time mechanism (compiling code that, for a normal
                      (    forth6809.asm):09511         ; word, itself compiles a call to that word later, when the
                      (    forth6809.asm):09512         ; current definition eventually runs - not immediately, unlike
                      (    forth6809.asm):09513         ; every other compile-time word tested so far). ABORT" is safely
                      (    forth6809.asm):09514         ; testable for both its true and false flag cases - traced its
                      (    forth6809.asm):09515         ; own runtime behavior directly and confirmed it uses THROW -2
                      (    forth6809.asm):09516         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09517         ; ABORT itself uses (which remains untested, per section 3.1's
                      (    forth6809.asm):09518         ; own reasoning).
                      (    forth6809.asm):09519         ; ------------------------------------------------------------
                      (    forth6809.asm):09520         
                      (    forth6809.asm):09521         ; ------------------------------------------------------------
                      (    forth6809.asm):09522         ; TSTIMMED - unit test for IMMEDIATE. Builds a fake header (LEN/
                      (    forth6809.asm):09523         ; FL=3, no flags), points LATEST at it, calls IMMEDIATE, and
                      (    forth6809.asm):09524         ; verifies the header's own LEN/FL byte now has bit 7 set -
                      (    forth6809.asm):09525         ; confirmed a memory-only operation with no data-stack effect,
                      (    forth6809.asm):09526         ; so the guard check is the whole verification beyond that.
                      (    forth6809.asm):09527         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09528         TSTIMMED: LDD  LATEST
                      (    forth6809.asm):09529                   STD  TSTLSAV
                      (    forth6809.asm):09530         
                      (    forth6809.asm):09531                   LDA  #3
                      (    forth6809.asm):09532                   STA  TSTFHDR
                      (    forth6809.asm):09533                   LDA  #'F'
                      (    forth6809.asm):09534                   STA  TSTFHDR+1
                      (    forth6809.asm):09535                   LDA  #'O'
                      (    forth6809.asm):09536                   STA  TSTFHDR+2
                      (    forth6809.asm):09537                   LDA  #'O'
                      (    forth6809.asm):09538                   STA  TSTFHDR+3
                      (    forth6809.asm):09539                   LDD  #0
                      (    forth6809.asm):09540                   STD  TSTFHDR+4
                      (    forth6809.asm):09541                   LDD  #DUP
                      (    forth6809.asm):09542                   STD  TSTFHDR+6
                      (    forth6809.asm):09543         
                      (    forth6809.asm):09544                   LDD  #TSTFHDR
                      (    forth6809.asm):09545                   STD  LATEST
                      (    forth6809.asm):09546         
                      (    forth6809.asm):09547                   STU  TSTU0
                      (    forth6809.asm):09548         
                      (    forth6809.asm):09549                   LDD  #TSTGUARD
                      (    forth6809.asm):09550                   PSHU D
                      (    forth6809.asm):09551                   STU  TSTUB4
                      (    forth6809.asm):09552         
                      (    forth6809.asm):09553                   JSR  IMMEDIATE
                      (    forth6809.asm):09554         
                      (    forth6809.asm):09555                   STU  TSTUAF
                      (    forth6809.asm):09556         
                      (    forth6809.asm):09557                   LDA  TSTFHDR
                      (    forth6809.asm):09558                   CMPA #$83
                      (    forth6809.asm):09559                   BNE  IMFAIL
                      (    forth6809.asm):09560         
                      (    forth6809.asm):09561                   PULU D
                      (    forth6809.asm):09562                   CMPD #TSTGUARD
                      (    forth6809.asm):09563                   BNE  IMFAIL
                      (    forth6809.asm):09564         
                      (    forth6809.asm):09565                   LDD  TSTUB4
                      (    forth6809.asm):09566                   SUBD TSTUAF
                      (    forth6809.asm):09567                   CMPD #0
                      (    forth6809.asm):09568                   BNE  IMFAIL
                      (    forth6809.asm):09569         
                      (    forth6809.asm):09570                   LDD  #TRUEV
                      (    forth6809.asm):09571                   BRA  IMDONE
C100                  (    forth6809.asm):09572         IMFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):09573         IMDONE:   LDX  #TSTIMMEDNAME
                      (    forth6809.asm):09574                   PSHU X
                      (    forth6809.asm):09575                   PSHU D
                      (    forth6809.asm):09576                   JSR  TSTREPORT
                      (    forth6809.asm):09577         
                      (    forth6809.asm):09578                   LDD  TSTLSAV
                      (    forth6809.asm):09579                   STD  LATEST
                      (    forth6809.asm):09580         
                      (    forth6809.asm):09581                   LDU  TSTU0
                      (    forth6809.asm):09582                   RTS
                      (    forth6809.asm):09583         
C100                  (    forth6809.asm):09584         TSTIMMEDNAME: FCB  8
                      (    forth6809.asm):09585                       FCC  "TSTIMMED"
                      (    forth6809.asm):09586         
                      (    forth6809.asm):09587         ; ------------------------------------------------------------
                      (    forth6809.asm):09588         ; TSTSTATE - unit test for STATE. Verifies it pushes the address
                      (    forth6809.asm):09589         ; of the real STATE variable (a plain variable, per its own
                      (    forth6809.asm):09590         ; documented "( -- addr )" effect - not its current value).
                      (    forth6809.asm):09591         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09592         TSTSTATE: STU  TSTU0
                      (    forth6809.asm):09593         
                      (    forth6809.asm):09594                   LDD  #TSTGUARD
                      (    forth6809.asm):09595                   PSHU D
                      (    forth6809.asm):09596                   STU  TSTUB4
                      (    forth6809.asm):09597         
                      (    forth6809.asm):09598                   JSR  STATEW
                      (    forth6809.asm):09599         
                      (    forth6809.asm):09600                   STU  TSTUAF
                      (    forth6809.asm):09601         
                      (    forth6809.asm):09602                   PULU D
                      (    forth6809.asm):09603                   CMPD #STATE
                      (    forth6809.asm):09604                   BNE  STFAIL2
                      (    forth6809.asm):09605                   PULU D
                      (    forth6809.asm):09606                   CMPD #TSTGUARD
                      (    forth6809.asm):09607                   BNE  STFAIL2
                      (    forth6809.asm):09608         
                      (    forth6809.asm):09609                   LDD  TSTUB4
                      (    forth6809.asm):09610                   SUBD TSTUAF
                      (    forth6809.asm):09611                   CMPD #2
                      (    forth6809.asm):09612                   BNE  STFAIL2
                      (    forth6809.asm):09613         
                      (    forth6809.asm):09614                   LDD  #TRUEV
                      (    forth6809.asm):09615                   BRA  STDONE2
C100                  (    forth6809.asm):09616         STFAIL2:  LDD  #FALSEV
C100                  (    forth6809.asm):09617         STDONE2:  LDX  #TSTSTATENAME
                      (    forth6809.asm):09618                   PSHU X
                      (    forth6809.asm):09619                   PSHU D
                      (    forth6809.asm):09620                   JSR  TSTREPORT
                      (    forth6809.asm):09621         
                      (    forth6809.asm):09622                   LDU  TSTU0
                      (    forth6809.asm):09623                   RTS
                      (    forth6809.asm):09624         
C100                  (    forth6809.asm):09625         TSTSTATENAME: FCB  8
                      (    forth6809.asm):09626                       FCC  "TSTSTATE"
                      (    forth6809.asm):09627         
                      (    forth6809.asm):09628         ; ------------------------------------------------------------
                      (    forth6809.asm):09629         ; TSTBRACKETS - unit test for [ and ] together. Verifies ]
                      (    forth6809.asm):09630         ; sets STATE to -1 (compiling) and [ sets it back to 0
                      (    forth6809.asm):09631         ; (interpreting) - both memory-only operations, no data-stack
                      (    forth6809.asm):09632         ; effect.
                      (    forth6809.asm):09633         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09634         TSTBRACKETS: LDD  STATE
                      (    forth6809.asm):09635                      STD  TSTSTSAV
                      (    forth6809.asm):09636         
                      (    forth6809.asm):09637                      STU  TSTU0
                      (    forth6809.asm):09638         
                      (    forth6809.asm):09639                      LDD  #TSTGUARD
                      (    forth6809.asm):09640                      PSHU D
                      (    forth6809.asm):09641                      STU  TSTUB4
                      (    forth6809.asm):09642         
                      (    forth6809.asm):09643                      JSR  RBRACKET
                      (    forth6809.asm):09644         
                      (    forth6809.asm):09645                      LDD  STATE
                      (    forth6809.asm):09646                      CMPD #-1
                      (    forth6809.asm):09647                      BNE  BKFAIL
                      (    forth6809.asm):09648         
                      (    forth6809.asm):09649                      JSR  LBRACKET
                      (    forth6809.asm):09650         
                      (    forth6809.asm):09651                      STU  TSTUAF
                      (    forth6809.asm):09652         
                      (    forth6809.asm):09653                      LDD  STATE
                      (    forth6809.asm):09654                      CMPD #0
                      (    forth6809.asm):09655                      BNE  BKFAIL
                      (    forth6809.asm):09656         
                      (    forth6809.asm):09657                      PULU D
                      (    forth6809.asm):09658                      CMPD #TSTGUARD
                      (    forth6809.asm):09659                      BNE  BKFAIL
                      (    forth6809.asm):09660         
                      (    forth6809.asm):09661                      LDD  TSTUB4

F592                  (    forth6809.asm):15708         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):15709                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):15710                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):15711                                   ; characters and (worse) shared identically
                      (    forth6809.asm):15712                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):15713                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):15714                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):15715                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):15716                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):15717                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):15718                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):15719                                   ; testing/design decision: rather than give
                      (    forth6809.asm):15720                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):15721                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):15722                                   ; definition for stable storage instead - but
                      (    forth6809.asm):15723                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):15724                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):15725                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):15726                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):15727                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):15728                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):15729                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):15730                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):15731                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):15732                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):15733                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):15734                   JSR  PADW
F595 3710             (    forth6809.asm):15735                   PULU X

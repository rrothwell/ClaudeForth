                      (    forth6809.asm):07634         ; pattern as TSTTHENZ - wrong value in place of TAGBACK.
                      (    forth6809.asm):07635         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07636         TSTUNTILZ: STU  TSTU0
                      (    forth6809.asm):07637         

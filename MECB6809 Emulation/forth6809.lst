                      (    forth6809.asm):01489                    CMPD  #TSTGUARD
                      (    forth6809.asm):01490                    BNE   DPFAIL
                      (    forth6809.asm):01491         
                      (    forth6809.asm):01492                    LDD   TSTUB4
                      (    forth6809.asm):01493                    SUBD  TSTUAF
                      (    forth6809.asm):01494                    CMPD  #-2
                      (    forth6809.asm):01495                    BNE   DPFAIL
                      (    forth6809.asm):01496         
                      (    forth6809.asm):01497                    LDD   #TRUEV
                      (    forth6809.asm):01498                    BRA   DPDONE
C100                  (    forth6809.asm):01499         DPFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):01500         DPDONE:    LDX   #TSTDROPNAME
                      (    forth6809.asm):01501                    PSHU  X
                      (    forth6809.asm):01502                    PSHU  D

                      (    forth6809.asm):05399         ; TSTCOMPARE - comparison tests (glossary section 3.7). Covers
                      (    forth6809.asm):05400         ; every word in that section. Like several words in the previous
                      (    forth6809.asm):05401         ; group, most of these modify the top of stack in place rather
                      (    forth6809.asm):05402         ; than PULU/PSHU - the tests verify what's observable via the
                      (    forth6809.asm):05403         ; stack either way. Signed vs unsigned comparisons (</U<, >/U>)
                      (    forth6809.asm):05404         ; each tested with a case that would give the opposite answer
                      (    forth6809.asm):05405         ; under the other convention, confirming genuine sign-awareness
                      (    forth6809.asm):05406         ; rather than an accidentally-shared implementation. WITHIN
                      (    forth6809.asm):05407         ; tested against a wraparound range specifically (n2 near $FFFF,
                      (    forth6809.asm):05408         ; n3 wrapped past $0000), both inside and outside cases - the
                      (    forth6809.asm):05409         ; documented special case its own unsigned-offset implementation
                      (    forth6809.asm):05410         ; exists to handle, not just an ordinary non-wrapping range. D</
                      (    forth6809.asm):05411         ; DU< both tested with equal high cells and different low cells -
                      (    forth6809.asm):05412         ; the documented tie-break case a naive high-cell-only comparison
                      (    forth6809.asm):05413         ; would get wrong.
                      (    forth6809.asm):05414         ; ------------------------------------------------------------
C100                  (    forth6809.asm):05415         TSTCOMPARE: JSR   CRW
                      (    forth6809.asm):05416                    LDX   #TSTCOMPMSG
                      (    forth6809.asm):05417                    PSHU  X
                      (    forth6809.asm):05418                    LDD   #7
                      (    forth6809.asm):05419                    PSHU  D
                      (    forth6809.asm):05420                    JSR   TYPE
                      (    forth6809.asm):05421                    JSR   CRW
                      (    forth6809.asm):05422         
                      (    forth6809.asm):05423                    IFEQ TSTSELECTOR-6  ; >>>>
                      (    forth6809.asm):05424         
                      (    forth6809.asm):05425                    JSR   TSTEQ
                      (    forth6809.asm):05426                    JSR   TSTLT
                      (    forth6809.asm):05427                    JSR   TSTGT
                      (    forth6809.asm):05428                    JSR   TSTZEQ
                      (    forth6809.asm):05429                    JSR   TSTZLT
                      (    forth6809.asm):05430                    JSR   TSTULT
                      (    forth6809.asm):05431                    JSR   TSTNE
                      (    forth6809.asm):05432                    JSR   TSTZNE
                      (    forth6809.asm):05433                    JSR   TSTZGT
                      (    forth6809.asm):05434                    JSR   TSTUGT
                      (    forth6809.asm):05435                    JSR   TSTWI1
                      (    forth6809.asm):05436                    JSR   TSTWI2
                      (    forth6809.asm):05437                    JSR   TSTDEQ
                      (    forth6809.asm):05438                    JSR   TSTDLT
                      (    forth6809.asm):05439                    JSR   TSTDULT
                      (    forth6809.asm):05440         
                      (    forth6809.asm):05441                    ENDC ; <<<<
                      (    forth6809.asm):05442         
                      (    forth6809.asm):05443                    RTS
                      (    forth6809.asm):05444         

                      (    forth6809.asm):02133         ; ------------------------------------------------------------
                      (    forth6809.asm):02134         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02135         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02136         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02137         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02138         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02139         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02140         ; one copy pushed).
                      (    forth6809.asm):02141         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02142         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):02143         
                      (    forth6809.asm):02144                    LDD   #TSTGUARD
                      (    forth6809.asm):02145                    PSHU  D
                      (    forth6809.asm):02146                    LDD   #TSTVAL1
                      (    forth6809.asm):02147                    PSHU  D
                      (    forth6809.asm):02148                    LDD   #TSTVAL2
                      (    forth6809.asm):02149                    PSHU  D
                      (    forth6809.asm):02150                    LDD   #TSTVAL3
                      (    forth6809.asm):02151                    PSHU  D
                      (    forth6809.asm):02152                    LDD   #2
                      (    forth6809.asm):02153                    PSHU  D
                      (    forth6809.asm):02154                    STU   TSTUB4
                      (    forth6809.asm):02155         
                      (    forth6809.asm):02156                    JSR   PICK
                      (    forth6809.asm):02157         
                      (    forth6809.asm):02158                    STU   TSTUAF
                      (    forth6809.asm):02159         
                      (    forth6809.asm):02160                    PULU  D
                      (    forth6809.asm):02161                    CMPD  #TSTVAL1
                      (    forth6809.asm):02162                    BNE   PKFAIL
                      (    forth6809.asm):02163                    PULU  D
                      (    forth6809.asm):02164                    CMPD  #TSTVAL3
                      (    forth6809.asm):02165                    BNE   PKFAIL
                      (    forth6809.asm):02166                    PULU  D
                      (    forth6809.asm):02167                    CMPD  #TSTVAL2
                      (    forth6809.asm):02168                    BNE   PKFAIL
                      (    forth6809.asm):02169                    PULU  D
                      (    forth6809.asm):02170                    CMPD  #TSTVAL1
                      (    forth6809.asm):02171                    BNE   PKFAIL
                      (    forth6809.asm):02172                    PULU  D
                      (    forth6809.asm):02173                    CMPD  #TSTGUARD
                      (    forth6809.asm):02174                    BNE   PKFAIL
                      (    forth6809.asm):02175         
                      (    forth6809.asm):02176                    LDD   TSTUB4
                      (    forth6809.asm):02177                    SUBD  TSTUAF
                      (    forth6809.asm):02178                    CMPD  #0
                      (    forth6809.asm):02179                    BNE   PKFAIL
                      (    forth6809.asm):02180         
                      (    forth6809.asm):02181                    LDD   #TRUEV
                      (    forth6809.asm):02182                    BRA   PKDONE
C100                  (    forth6809.asm):02183         PKFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):02184         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):02185                    PSHU  X
                      (    forth6809.asm):02186                    PSHU  D
                      (    forth6809.asm):02187                    JSR   TSTREPORT
                      (    forth6809.asm):02188         
                      (    forth6809.asm):02189                    LDU   TSTU0
                      (    forth6809.asm):02190                    RTS
                      (    forth6809.asm):02191         
C100                  (    forth6809.asm):02192         TSTPICKNAME: FCB  7
                      (    forth6809.asm):02193                      FCC  "TSTPICK"
                      (    forth6809.asm):02194         
                      (    forth6809.asm):02195         ; ------------------------------------------------------------
                      (    forth6809.asm):02196         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):02197         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):02198         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):02199         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):02200         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):02201         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):02202         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):02203         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02205         TSTROLL:   STU   TSTU0
                      (    forth6809.asm):02206         
                      (    forth6809.asm):02207                    LDD   #TSTGUARD
                      (    forth6809.asm):02208                    PSHU  D
                      (    forth6809.asm):02209                    LDD   #TSTVAL1
                      (    forth6809.asm):02210                    PSHU  D
                      (    forth6809.asm):02211                    LDD   #TSTVAL2
                      (    forth6809.asm):02212                    PSHU  D
                      (    forth6809.asm):02213                    LDD   #TSTVAL3
                      (    forth6809.asm):02214                    PSHU  D
                      (    forth6809.asm):02215                    LDD   #2
                      (    forth6809.asm):02216                    PSHU  D
                      (    forth6809.asm):02217                    STU   TSTUB4
                      (    forth6809.asm):02218         
                      (    forth6809.asm):02219                    JSR   ROLL
                      (    forth6809.asm):02220         
                      (    forth6809.asm):02221                    STU   TSTUAF
                      (    forth6809.asm):02222         
                      (    forth6809.asm):02223                    PULU  D
                      (    forth6809.asm):02224                    CMPD  #TSTVAL1
                      (    forth6809.asm):02225                    BNE   RLFAIL
                      (    forth6809.asm):02226                    PULU  D
                      (    forth6809.asm):02227                    CMPD  #TSTVAL3
                      (    forth6809.asm):02228                    BNE   RLFAIL
                      (    forth6809.asm):02229                    PULU  D
                      (    forth6809.asm):02230                    CMPD  #TSTVAL2
                      (    forth6809.asm):02231                    BNE   RLFAIL
                      (    forth6809.asm):02232                    PULU  D
                      (    forth6809.asm):02233                    CMPD  #TSTGUARD
                      (    forth6809.asm):02234                    BNE   RLFAIL
                      (    forth6809.asm):02235         
                      (    forth6809.asm):02236                    LDD   TSTUB4
                      (    forth6809.asm):02237                    SUBD  TSTUAF
                      (    forth6809.asm):02238                    CMPD  #-2
                      (    forth6809.asm):02239                    BNE   RLFAIL
                      (    forth6809.asm):02240         
                      (    forth6809.asm):02241                    LDD   #TRUEV
                      (    forth6809.asm):02242                    BRA   RLDONE
C100                  (    forth6809.asm):02243         RLFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):02244         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):02245                    PSHU  X
                      (    forth6809.asm):02246                    PSHU  D
                      (    forth6809.asm):02247                    JSR   TSTREPORT
                      (    forth6809.asm):02248         
                      (    forth6809.asm):02249                    LDU   TSTU0
                      (    forth6809.asm):02250                    RTS
                      (    forth6809.asm):02251         
C100                  (    forth6809.asm):02252         TSTROLLNAME: FCB  7
                      (    forth6809.asm):02253                      FCC  "TSTROLL"
                      (    forth6809.asm):02254         
                      (    forth6809.asm):02255         ; ------------------------------------------------------------
                      (    forth6809.asm):02256         ; TSTDROT - unit test for 2ROT
                      (    forth6809.asm):02257         ; ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 ). Verifies the
                      (    forth6809.asm):02258         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):02259         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):02260         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02261         TSTDROT:   STU   TSTU0
                      (    forth6809.asm):02262         
                      (    forth6809.asm):02263                    LDD   #TSTGUARD
                      (    forth6809.asm):02264                    PSHU  D
                      (    forth6809.asm):02265                    LDD   #TSTVAL1
                      (    forth6809.asm):02266                    PSHU  D
                      (    forth6809.asm):02267                    LDD   #TSTVAL2
                      (    forth6809.asm):02268                    PSHU  D
                      (    forth6809.asm):02269                    LDD   #TSTVAL3
                      (    forth6809.asm):02270                    PSHU  D
                      (    forth6809.asm):02271                    LDD   #TSTVAL4
                      (    forth6809.asm):02272                    PSHU  D
                      (    forth6809.asm):02273                    LDD   #TSTVAL5
                      (    forth6809.asm):02274                    PSHU  D
                      (    forth6809.asm):02275                    LDD   #TSTVAL6
                      (    forth6809.asm):02276                    PSHU  D
                      (    forth6809.asm):02277                    STU   TSTUB4
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279                    JSR   DROT
                      (    forth6809.asm):02280         
                      (    forth6809.asm):02281                    STU   TSTUAF
                      (    forth6809.asm):02282         
                      (    forth6809.asm):02283                    PULU  D
                      (    forth6809.asm):02284                    CMPD  #TSTVAL2
                      (    forth6809.asm):02285                    BNE   RO2FAIL
                      (    forth6809.asm):02286                    PULU  D
                      (    forth6809.asm):02287                    CMPD  #TSTVAL1
                      (    forth6809.asm):02288                    BNE   RO2FAIL
                      (    forth6809.asm):02289                    PULU  D
                      (    forth6809.asm):02290                    CMPD  #TSTVAL6
                      (    forth6809.asm):02291                    BNE   RO2FAIL
                      (    forth6809.asm):02292                    PULU  D
                      (    forth6809.asm):02293                    CMPD  #TSTVAL5
                      (    forth6809.asm):02294                    BNE   RO2FAIL
                      (    forth6809.asm):02295                    PULU  D
                      (    forth6809.asm):02296                    CMPD  #TSTVAL4
                      (    forth6809.asm):02297                    BNE   RO2FAIL
                      (    forth6809.asm):02298                    PULU  D
                      (    forth6809.asm):02299                    CMPD  #TSTVAL3
                      (    forth6809.asm):02300                    BNE   RO2FAIL
                      (    forth6809.asm):02301                    PULU  D
                      (    forth6809.asm):02302                    CMPD  #TSTGUARD
                      (    forth6809.asm):02303                    BNE   RO2FAIL
                      (    forth6809.asm):02304         
                      (    forth6809.asm):02305                    LDD   TSTUB4
                      (    forth6809.asm):02306                    SUBD  TSTUAF
                      (    forth6809.asm):02307                    CMPD  #0
                      (    forth6809.asm):02308                    BNE   RO2FAIL
                      (    forth6809.asm):02309         
                      (    forth6809.asm):02310                    LDD   #TRUEV
                      (    forth6809.asm):02311                    BRA   RO2DONE
C100                  (    forth6809.asm):02312         RO2FAIL:   LDD   #FALSEV
C100                  (    forth6809.asm):02313         RO2DONE:   LDX   #TSTDROTNAME
                      (    forth6809.asm):02314                    PSHU  X
                      (    forth6809.asm):02315                    PSHU  D
                      (    forth6809.asm):02316                    JSR   TSTREPORT
                      (    forth6809.asm):02317         
                      (    forth6809.asm):02318                    LDU   TSTU0
                      (    forth6809.asm):02319                    RTS
                      (    forth6809.asm):02320         
C100                  (    forth6809.asm):02321         TSTDROTNAME: FCB  7
                      (    forth6809.asm):02322                      FCC  "TSTDROT"
                      (    forth6809.asm):02323         
                      (    forth6809.asm):02324                    ENDC ; <<<<
                      (    forth6809.asm):02325         
                      (    forth6809.asm):02326         ; ------------------------------------------------------------
                      (    forth6809.asm):02327         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02328         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02329         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02330         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02331         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02332         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02333         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02334         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02335         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02336         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02337         ;
                      (    forth6809.asm):02338         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02339         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02340         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02341         ; right value once.
                      (    forth6809.asm):02342         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02343         TSTRETSTACK: JSR CRW
                      (    forth6809.asm):02344                    LDX   #TSTRETMSG
                      (    forth6809.asm):02345                    PSHU  X
                      (    forth6809.asm):02346                    LDD   #8
                      (    forth6809.asm):02347                    PSHU  D
                      (    forth6809.asm):02348                    JSR   TYPE
                      (    forth6809.asm):02349                    JSR   CRW
                      (    forth6809.asm):02350         
                      (    forth6809.asm):02351                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02352         
                      (    forth6809.asm):02353                    JSR   TSTTOR
                      (    forth6809.asm):02354                    JSR   TSTRFETCH
                      (    forth6809.asm):02355                    JSR   TSTTWOTOR
                      (    forth6809.asm):02356                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02357         
                      (    forth6809.asm):02358                    ENDC ; <<<<
                      (    forth6809.asm):02359         
                      (    forth6809.asm):02360                    RTS
                      (    forth6809.asm):02361         
C100                  (    forth6809.asm):02362         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02363         
                      (    forth6809.asm):02364                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02365         
                      (    forth6809.asm):02366         ; ------------------------------------------------------------
                      (    forth6809.asm):02367         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02368         ; every other test group in this file, these words operate
                      (    forth6809.asm):02369         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02370         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02371         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02372         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02373         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02374         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02375         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02376         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02377         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02378         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02379         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02380         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02381         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02382         ; ------------------------------------------------------------
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02386         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02387         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02388         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02389         ; value would never actually have left.
                      (    forth6809.asm):02390         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02391         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02392         
                      (    forth6809.asm):02393                  LDD   #TSTGUARD
                      (    forth6809.asm):02394                  PSHU  D
                      (    forth6809.asm):02395                  LDD   #TSTVAL1
                      (    forth6809.asm):02396                  PSHU  D
                      (    forth6809.asm):02397                  STU   TSTUB4
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399                  JSR   TOR
                      (    forth6809.asm):02400         
                      (    forth6809.asm):02401                  STU   TSTUMID
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403                  LDD   TSTUB4
                      (    forth6809.asm):02404                  SUBD  TSTUMID
                      (    forth6809.asm):02405                  CMPD  #-2
                      (    forth6809.asm):02406                  BNE   TRFAIL
                      (    forth6809.asm):02407         
                      (    forth6809.asm):02408                  JSR   FROMR
                      (    forth6809.asm):02409         
                      (    forth6809.asm):02410                  STU   TSTUAF
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412                  PULU  D
                      (    forth6809.asm):02413                  CMPD  #TSTVAL1
                      (    forth6809.asm):02414                  BNE   TRFAIL
                      (    forth6809.asm):02415                  PULU  D
                      (    forth6809.asm):02416                  CMPD  #TSTGUARD
                      (    forth6809.asm):02417                  BNE   TRFAIL
                      (    forth6809.asm):02418         
                      (    forth6809.asm):02419                  LDD   TSTUB4
                      (    forth6809.asm):02420                  SUBD  TSTUAF
                      (    forth6809.asm):02421                  CMPD  #0
                      (    forth6809.asm):02422                  BNE   TRFAIL
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424                  LDD   #TRUEV
                      (    forth6809.asm):02425                  BRA   TRDONE
C100                  (    forth6809.asm):02426         TRFAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):02427         TRDONE:  LDX   #TSTTORNAME
                      (    forth6809.asm):02428                  PSHU  X
                      (    forth6809.asm):02429                  PSHU  D
                      (    forth6809.asm):02430                  JSR   TSTREPORT
                      (    forth6809.asm):02431         
                      (    forth6809.asm):02432                  LDU   TSTU0
                      (    forth6809.asm):02433                  RTS
                      (    forth6809.asm):02434         
C100                  (    forth6809.asm):02435         TSTTORNAME: FCB  6
                      (    forth6809.asm):02436                     FCC  "TSTTOR"
                      (    forth6809.asm):02437         
                      (    forth6809.asm):02438         ; ------------------------------------------------------------
                      (    forth6809.asm):02439         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02440         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02441         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02442         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02443         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02444         ; not assumed from the name.
                      (    forth6809.asm):02445         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02446         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02447         
                      (    forth6809.asm):02448                    LDD  #TSTGUARD
                      (    forth6809.asm):02449                    PSHU D
                      (    forth6809.asm):02450                    LDD  #TSTVAL1
                      (    forth6809.asm):02451                    PSHU D
                      (    forth6809.asm):02452                    STU  TSTUB4
                      (    forth6809.asm):02453         
                      (    forth6809.asm):02454                    JSR  TOR
                      (    forth6809.asm):02455                    JSR  RFETCH
                      (    forth6809.asm):02456                    JSR  FROMR
                      (    forth6809.asm):02457         
                      (    forth6809.asm):02458                    STU  TSTUAF
                      (    forth6809.asm):02459         
                      (    forth6809.asm):02460                    PULU D
                      (    forth6809.asm):02461                    CMPD #TSTVAL1
                      (    forth6809.asm):02462                    BNE  RFFAIL
                      (    forth6809.asm):02463                    PULU D
                      (    forth6809.asm):02464                    CMPD #TSTVAL1
                      (    forth6809.asm):02465                    BNE  RFFAIL
                      (    forth6809.asm):02466                    PULU D
                      (    forth6809.asm):02467                    CMPD #TSTGUARD
                      (    forth6809.asm):02468                    BNE  RFFAIL
                      (    forth6809.asm):02469         
                      (    forth6809.asm):02470                    LDD  TSTUB4
                      (    forth6809.asm):02471                    SUBD TSTUAF
                      (    forth6809.asm):02472                    CMPD #2
                      (    forth6809.asm):02473                    BNE  RFFAIL
                      (    forth6809.asm):02474         
                      (    forth6809.asm):02475                    LDD  #TRUEV
                      (    forth6809.asm):02476                    BRA  RFDONE
C100                  (    forth6809.asm):02477         RFFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):02478         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02479                    PSHU X
                      (    forth6809.asm):02480                    PSHU D
                      (    forth6809.asm):02481                    JSR  TSTREPORT
                      (    forth6809.asm):02482         
                      (    forth6809.asm):02483                    LDU  TSTU0
                      (    forth6809.asm):02484                    RTS
                      (    forth6809.asm):02485         
C100                  (    forth6809.asm):02486         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02487                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02488         
                      (    forth6809.asm):02489         ; ------------------------------------------------------------
                      (    forth6809.asm):02490         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02491         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02492         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02493         ; verifying the round trip.
                      (    forth6809.asm):02494         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02495         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02496         
                      (    forth6809.asm):02497                    LDD  #TSTGUARD
                      (    forth6809.asm):02498                    PSHU D
                      (    forth6809.asm):02499                    LDD  #TSTVAL1
                      (    forth6809.asm):02500                    PSHU D
                      (    forth6809.asm):02501                    LDD  #TSTVAL2
                      (    forth6809.asm):02502                    PSHU D
                      (    forth6809.asm):02503                    STU  TSTUB4
                      (    forth6809.asm):02504         
                      (    forth6809.asm):02505                    JSR  TWOTOR
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507                    STU  TSTUMID
                      (    forth6809.asm):02508         
                      (    forth6809.asm):02509                    LDD  TSTUB4
                      (    forth6809.asm):02510                    SUBD TSTUMID
                      (    forth6809.asm):02511                    CMPD #-4
                      (    forth6809.asm):02512                    BNE  T2RFAIL
                      (    forth6809.asm):02513         
                      (    forth6809.asm):02514                    JSR  TWOFROMR
                      (    forth6809.asm):02515         
                      (    forth6809.asm):02516                    STU  TSTUAF
                      (    forth6809.asm):02517         
                      (    forth6809.asm):02518                    PULU D
                      (    forth6809.asm):02519                    CMPD #TSTVAL2
                      (    forth6809.asm):02520                    BNE  T2RFAIL
                      (    forth6809.asm):02521                    PULU D
                      (    forth6809.asm):02522                    CMPD #TSTVAL1
                      (    forth6809.asm):02523                    BNE  T2RFAIL
                      (    forth6809.asm):02524                    PULU D
                      (    forth6809.asm):02525                    CMPD #TSTGUARD
                      (    forth6809.asm):02526                    BNE  T2RFAIL
                      (    forth6809.asm):02527         
                      (    forth6809.asm):02528                    LDD  TSTUB4
                      (    forth6809.asm):02529                    SUBD TSTUAF
                      (    forth6809.asm):02530                    CMPD #0
                      (    forth6809.asm):02531                    BNE  T2RFAIL
                      (    forth6809.asm):02532         
                      (    forth6809.asm):02533                    LDD  #TRUEV
                      (    forth6809.asm):02534                    BRA  T2RDONE
C100                  (    forth6809.asm):02535         T2RFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):02536         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02537                    PSHU X
                      (    forth6809.asm):02538                    PSHU D
                      (    forth6809.asm):02539                    JSR  TSTREPORT
                      (    forth6809.asm):02540         
                      (    forth6809.asm):02541                    LDU  TSTU0
                      (    forth6809.asm):02542                    RTS
                      (    forth6809.asm):02543         
C100                  (    forth6809.asm):02544         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02545                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02546         
                      (    forth6809.asm):02547         ; ------------------------------------------------------------
                      (    forth6809.asm):02548         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02549         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02550         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02551         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02552         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02553         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02554         TSTTWORFETCH: STU  TSTU0
                      (    forth6809.asm):02555         
                      (    forth6809.asm):02556                       LDD  #TSTGUARD
                      (    forth6809.asm):02557                       PSHU D
                      (    forth6809.asm):02558                       LDD  #TSTVAL1
                      (    forth6809.asm):02559                       PSHU D
                      (    forth6809.asm):02560                       LDD  #TSTVAL2
                      (    forth6809.asm):02561                       PSHU D
                      (    forth6809.asm):02562                       STU  TSTUB4
                      (    forth6809.asm):02563         
                      (    forth6809.asm):02564                       JSR  TWOTOR
                      (    forth6809.asm):02565                       JSR  TWORFETCH
                      (    forth6809.asm):02566                       JSR  TWOFROMR
                      (    forth6809.asm):02567         
                      (    forth6809.asm):02568                       STU  TSTUAF
                      (    forth6809.asm):02569         
                      (    forth6809.asm):02570                       PULU D
                      (    forth6809.asm):02571                       CMPD #TSTVAL2
                      (    forth6809.asm):02572                       BNE  T2FFAIL
                      (    forth6809.asm):02573                       PULU D
                      (    forth6809.asm):02574                       CMPD #TSTVAL1
                      (    forth6809.asm):02575                       BNE  T2FFAIL
                      (    forth6809.asm):02576                       PULU D
                      (    forth6809.asm):02577                       CMPD #TSTVAL2
                      (    forth6809.asm):02578                       BNE  T2FFAIL
                      (    forth6809.asm):02579                       PULU D
                      (    forth6809.asm):02580                       CMPD #TSTVAL1
                      (    forth6809.asm):02581                       BNE  T2FFAIL
                      (    forth6809.asm):02582                       PULU D
                      (    forth6809.asm):02583                       CMPD #TSTGUARD
                      (    forth6809.asm):02584                       BNE  T2FFAIL
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586                       LDD  TSTUB4
                      (    forth6809.asm):02587                       SUBD TSTUAF
                      (    forth6809.asm):02588                       CMPD #4
                      (    forth6809.asm):02589                       BNE  T2FFAIL
                      (    forth6809.asm):02590         
                      (    forth6809.asm):02591                       LDD  #TRUEV
                      (    forth6809.asm):02592                       BRA  T2FDONE
C100                  (    forth6809.asm):02593         T2FFAIL:       LDD  #FALSEV
C100                  (    forth6809.asm):02594         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02595                       PSHU X
                      (    forth6809.asm):02596                       PSHU D
                      (    forth6809.asm):02597                       JSR  TSTREPORT
                      (    forth6809.asm):02598         
                      (    forth6809.asm):02599                       LDU  TSTU0
                      (    forth6809.asm):02600                       RTS
                      (    forth6809.asm):02601         
C100                  (    forth6809.asm):02602         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02603                           FCC  "TSTTWORFETCH"
                      (    forth6809.asm):02604         
                      (    forth6809.asm):02605                    ENDC ; <<<<
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02609         ; Covers every word in that section, with representative
                      (    forth6809.asm):02610         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02611         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02612         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02613         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02614         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02615         ; cases chosen.
                      (    forth6809.asm):02616         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02617         TSTSARITH: JSR   CRW
                      (    forth6809.asm):02618                    LDX   #TSTSARITHMSG
                      (    forth6809.asm):02619                    PSHU  X
                      (    forth6809.asm):02620                    LDD   #11
                      (    forth6809.asm):02621                    PSHU  D
                      (    forth6809.asm):02622                    JSR   TYPE
                      (    forth6809.asm):02623                    JSR   CRW
                      (    forth6809.asm):02624         
                      (    forth6809.asm):02625                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):02626         
                      (    forth6809.asm):02627                    JSR   TSTPLUS
                      (    forth6809.asm):02628                    JSR   TSTMINUS
                      (    forth6809.asm):02629                    JSR   TSTSTAR1
                      (    forth6809.asm):02630                    JSR   TSTSTAR2
                      (    forth6809.asm):02631                    JSR   TSTSLASH1
                      (    forth6809.asm):02632                    JSR   TSTSLASH2
                      (    forth6809.asm):02633                    JSR   TSTSLASHZ
                      (    forth6809.asm):02634                    JSR   TSTMODW
                      (    forth6809.asm):02635                    JSR   TSTMODZ
                      (    forth6809.asm):02636                    JSR   TSTSLMOD
                      (    forth6809.asm):02637                    JSR   TSTSLMODZ
                      (    forth6809.asm):02638                    JSR   TSTNEGATE
                      (    forth6809.asm):02639                    JSR   TSTABS1
                      (    forth6809.asm):02640                    JSR   TSTABS2
                      (    forth6809.asm):02641                    JSR   TSTMIN1
                      (    forth6809.asm):02642                    JSR   TSTMIN2
                      (    forth6809.asm):02643                    JSR   TSTMAX1
                      (    forth6809.asm):02644                    JSR   TSTMAX2
                      (    forth6809.asm):02645                    JSR   TSTONEP
                      (    forth6809.asm):02646                    JSR   TSTONEM
                      (    forth6809.asm):02647                    JSR   TSTTWOP
                      (    forth6809.asm):02648                    JSR   TSTTWOS
                      (    forth6809.asm):02649                    JSR   TSTTWOD1
                      (    forth6809.asm):02650                    JSR   TSTTWOD2
                      (    forth6809.asm):02651                    JSR   TSTSTSL
                      (    forth6809.asm):02652                    JSR   TSTSTSLZ
                      (    forth6809.asm):02653                    JSR   TSTSTSM
                      (    forth6809.asm):02654                    JSR   TSTSTSMZ
                      (    forth6809.asm):02655         
                      (    forth6809.asm):02656                    ENDC ; <<<<
                      (    forth6809.asm):02657         
                      (    forth6809.asm):02658                    RTS
                      (    forth6809.asm):02659         
C100                  (    forth6809.asm):02660         TSTSARITHMSG: FCC "SArithmetic"
                      (    forth6809.asm):02661         
                      (    forth6809.asm):02662                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):02663         
                      (    forth6809.asm):02664         ; ------------------------------------------------------------
                      (    forth6809.asm):02665         ; TSTPLUS - unit test for PLUS. n1 + n2, mixed signs.
                      (    forth6809.asm):02666         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02667         TSTPLUS:    STU   TSTU0
                      (    forth6809.asm):02668         
                      (    forth6809.asm):02669                    LDD   #TSTGUARD
                      (    forth6809.asm):02670                    PSHU  D
                      (    forth6809.asm):02671                    LDD   #TSTVAL1
                      (    forth6809.asm):02672                    PSHU  D
                      (    forth6809.asm):02673                    LDD   #TSTNEG1
                      (    forth6809.asm):02674                    PSHU  D
                      (    forth6809.asm):02675                    STU   TSTUB4
                      (    forth6809.asm):02676         
                      (    forth6809.asm):02677                    JSR   PLUS
                      (    forth6809.asm):02678         
                      (    forth6809.asm):02679                    STU   TSTUAF
                      (    forth6809.asm):02680         
                      (    forth6809.asm):02681                    PULU  D
                      (    forth6809.asm):02682                    CMPD  #$29A8
                      (    forth6809.asm):02683                    BNE   PLFAIL
                      (    forth6809.asm):02684                    PULU  D
                      (    forth6809.asm):02685                    CMPD  #TSTGUARD
                      (    forth6809.asm):02686                    BNE   PLFAIL
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688                    LDD   TSTUB4
                      (    forth6809.asm):02689                    SUBD  TSTUAF
                      (    forth6809.asm):02690                    CMPD  #-2
                      (    forth6809.asm):02691                    BNE   PLFAIL
                      (    forth6809.asm):02692         
                      (    forth6809.asm):02693                    LDD   #TRUEV
                      (    forth6809.asm):02694                    BRA   PLDONE
C100                  (    forth6809.asm):02695         PLFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02696         PLDONE:     LDX   #TSTPLUSNAME
                      (    forth6809.asm):02697                    PSHU  X
                      (    forth6809.asm):02698                    PSHU  D
                      (    forth6809.asm):02699                    JSR   TSTREPORT
                      (    forth6809.asm):02700         
                      (    forth6809.asm):02701                    LDU   TSTU0
                      (    forth6809.asm):02702                    RTS
                      (    forth6809.asm):02703         
C100                  (    forth6809.asm):02704         TSTPLUSNAME: FCB  7
                      (    forth6809.asm):02705                        FCC  "TSTPLUS"
                      (    forth6809.asm):02706         
                      (    forth6809.asm):02707         ; ------------------------------------------------------------
                      (    forth6809.asm):02708         ; TSTMINUS - unit test for MINUS. n1 - n2 (operand order matters).
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02710         TSTMINUS:   STU   TSTU0
                      (    forth6809.asm):02711         
                      (    forth6809.asm):02712                    LDD   #TSTGUARD
                      (    forth6809.asm):02713                    PSHU  D
                      (    forth6809.asm):02714                    LDD   #TSTVAL1
                      (    forth6809.asm):02715                    PSHU  D
                      (    forth6809.asm):02716                    LDD   #TSTVAL2
                      (    forth6809.asm):02717                    PSHU  D
                      (    forth6809.asm):02718                    STU   TSTUB4
                      (    forth6809.asm):02719         
                      (    forth6809.asm):02720                    JSR   MINUS
                      (    forth6809.asm):02721         
                      (    forth6809.asm):02722                    STU   TSTUAF
                      (    forth6809.asm):02723         
                      (    forth6809.asm):02724                    PULU  D
                      (    forth6809.asm):02725                    CMPD  #$3579
                      (    forth6809.asm):02726                    BNE   MNFAIL
                      (    forth6809.asm):02727                    PULU  D
                      (    forth6809.asm):02728                    CMPD  #TSTGUARD
                      (    forth6809.asm):02729                    BNE   MNFAIL
                      (    forth6809.asm):02730         
                      (    forth6809.asm):02731                    LDD   TSTUB4
                      (    forth6809.asm):02732                    SUBD  TSTUAF
                      (    forth6809.asm):02733                    CMPD  #-2
                      (    forth6809.asm):02734                    BNE   MNFAIL
                      (    forth6809.asm):02735         
                      (    forth6809.asm):02736                    LDD   #TRUEV
                      (    forth6809.asm):02737                    BRA   MNDONE
C100                  (    forth6809.asm):02738         MNFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02739         MNDONE:     LDX   #TSTMINUSNAME
                      (    forth6809.asm):02740                    PSHU  X
                      (    forth6809.asm):02741                    PSHU  D
                      (    forth6809.asm):02742                    JSR   TSTREPORT
                      (    forth6809.asm):02743         
                      (    forth6809.asm):02744                    LDU   TSTU0
                      (    forth6809.asm):02745                    RTS
                      (    forth6809.asm):02746         
C100                  (    forth6809.asm):02747         TSTMINUSNAME: FCB  8
                      (    forth6809.asm):02748                         FCC  "TSTMINUS"
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; TSTSTAR1 - unit test for STAR. normal signed multiply.
                      (    forth6809.asm):02752         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02753         TSTSTAR1:   STU   TSTU0
                      (    forth6809.asm):02754         
                      (    forth6809.asm):02755                    LDD   #TSTGUARD
                      (    forth6809.asm):02756                    PSHU  D
                      (    forth6809.asm):02757                    LDD   #TSTVAL2
                      (    forth6809.asm):02758                    PSHU  D
                      (    forth6809.asm):02759                    LDD   #TSTNEG2
                      (    forth6809.asm):02760                    PSHU  D
                      (    forth6809.asm):02761                    STU   TSTUB4
                      (    forth6809.asm):02762         
                      (    forth6809.asm):02763                    JSR   STAR
                      (    forth6809.asm):02764         
                      (    forth6809.asm):02765                    STU   TSTUAF
                      (    forth6809.asm):02766         
                      (    forth6809.asm):02767                    PULU  D

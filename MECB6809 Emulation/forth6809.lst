                      (    forth6809.asm):07994                   LDD  TSTLSAV
                      (    forth6809.asm):07995                   STD  LATEST
                      (    forth6809.asm):07996         
                      (    forth6809.asm):07997                   STU  TSTU0
                      (    forth6809.asm):07998         
                      (    forth6809.asm):07999                   LDD  #TSTGUARD
                      (    forth6809.asm):08000                   PSHU D
                      (    forth6809.asm):08001                   STU  TSTUB4
                      (    forth6809.asm):08002         
                      (    forth6809.asm):08003                   LDX  TSTWCFA
                      (    forth6809.asm):08004                   JSR  ,X
                      (    forth6809.asm):08005         

C100                  (    forth6809.asm):08031         TSTCONSTNAME: FCB  8
                      (    forth6809.asm):08032                       FCC  "TSTCONST"
                      (    forth6809.asm):08033         
                      (    forth6809.asm):08034         ; ------------------------------------------------------------
                      (    forth6809.asm):08035         ; TSTCOLON - unit test for : and ; together. Compiles
                      (    forth6809.asm):08036         ; ": TESTWD 111 ;" into scratch (COLON parses the name, builds
                      (    forth6809.asm):08037         ; a smudged header, sets CSP to the current U as the control-
                      (    forth6809.asm):08038         ; flow balance baseline, sets STATE compiling; a literal 111 is
                      (    forth6809.asm):08039         ; compiled; SEMI compiles the closing RTS, checks the CSP
                      (    forth6809.asm):08040         ; balance, un-smudges the header, restores STATE) - then
                      (    forth6809.asm):08041         ; executes the result and verifies it pushes 111. Also verifies
                      (    forth6809.asm):08042         ; the header's own SMUDGE bit is correctly clear after SEMI -
                      (    forth6809.asm):08043         ; not just that execution happened to work.
                      (    forth6809.asm):08044         ; ------------------------------------------------------------
C100                  (    forth6809.asm):08045         TSTCOLON: LDD  CODEHERE
                      (    forth6809.asm):08046                   STD  TSTCSAV
                      (    forth6809.asm):08047                   LDD  DPHERE
                      (    forth6809.asm):08048                   STD  TSTDSAV
                      (    forth6809.asm):08049                   LDD  VARHERE
                      (    forth6809.asm):08050                   STD  TSTVSAV
                      (    forth6809.asm):08051                   LDD  SRCADDR
                      (    forth6809.asm):08052                   STD  TSTSASAV
                      (    forth6809.asm):08053                   LDD  SRCLEN
                      (    forth6809.asm):08054                   STD  TSTSLSAV
                      (    forth6809.asm):08055                   LDD  TOIN
                      (    forth6809.asm):08056                   STD  TSTTISAV
                      (    forth6809.asm):08057                   LDD  LATEST
                      (    forth6809.asm):08058                   STD  TSTLSAV
                      (    forth6809.asm):08059                   LDD  CSP
                      (    forth6809.asm):08060                   STD  TSTCSPS
                      (    forth6809.asm):08061                   LDD  STATE
                      (    forth6809.asm):08062                   STD  TSTSTSAV
                      (    forth6809.asm):08063         
                      (    forth6809.asm):08064                   LDA  #'T'
                      (    forth6809.asm):08065                   STA  TSTNAMEB
                      (    forth6809.asm):08066                   LDA  #'E'
                      (    forth6809.asm):08067                   STA  TSTNAMEB+1
                      (    forth6809.asm):08068                   LDA  #'S'

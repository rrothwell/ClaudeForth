                      (    forth6809.asm):06654         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):06655         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):06656         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):06657         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):06658         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):06659         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):06660         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):06661         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):06662         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):06663         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):06664         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):06665         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):06666         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06667         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):06668                   STD  TSTLSAV

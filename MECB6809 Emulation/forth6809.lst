                      (    forth6809.asm):01677                    STU   TSTUB4
                      (    forth6809.asm):01678         
                      (    forth6809.asm):01679                    JSR   QDUP
                      (    forth6809.asm):01680         
                      (    forth6809.asm):01681                    STU   TSTUAF
                      (    forth6809.asm):01682         
                      (    forth6809.asm):01683                    PULU  D
                      (    forth6809.asm):01684                    CMPD  #TSTVAL1
                      (    forth6809.asm):01685                    BNE   QNFAIL
                      (    forth6809.asm):01686                    PULU  D

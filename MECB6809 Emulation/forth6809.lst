                      (    forth6809.asm):01469         ; TSTDROP - unit test for DROP ( x -- ). Verifies both the
                      (    forth6809.asm):01470         ; stack's contents (the guard beneath the dropped value is left
                      (    forth6809.asm):01471         ; undisturbed, and is now the new top) and the data stack
                      (    forth6809.asm):01472         ; pointer's movement (exactly one cell, 2 bytes, freed - DROP's
                      (    forth6809.asm):01473         ; own net effect, not conflated with the two pushes that set the
                      (    forth6809.asm):01474         ; test up).
                      (    forth6809.asm):01475         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01476         TSTDROP:   STU   TSTU0
                      (    forth6809.asm):01477         
                      (    forth6809.asm):01478                    LDD   #TSTGUARD

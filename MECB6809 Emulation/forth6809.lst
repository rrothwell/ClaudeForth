                      (    forth6809.asm):06671         
                      (    forth6809.asm):06672                   LDA  #3
                      (    forth6809.asm):06673                   STA  TSTFHDR
                      (    forth6809.asm):06674                   LDA  #'F'
                      (    forth6809.asm):06675                   STA  TSTFHDR+1
                      (    forth6809.asm):06676                   LDA  #'O'
                      (    forth6809.asm):06677                   STA  TSTFHDR+2
                      (    forth6809.asm):06678                   LDA  #'O'
                      (    forth6809.asm):06679                   STA  TSTFHDR+3
                      (    forth6809.asm):06680                   LDD  #0
                      (    forth6809.asm):06681                   STD  TSTFHDR+4
                      (    forth6809.asm):06682                   LDD  #DUP
                      (    forth6809.asm):06683                   STD  TSTFHDR+6
                      (    forth6809.asm):06684         
                      (    forth6809.asm):06685                   LDD  #TSTFHDR
                      (    forth6809.asm):06686                   STD  LATEST

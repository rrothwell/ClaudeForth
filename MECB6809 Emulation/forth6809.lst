                      (    forth6809.asm):06374         
                      (    forth6809.asm):06375                  LDD   #OPRTS
                      (    forth6809.asm):06376                  PSHU  D
                      (    forth6809.asm):06377                  JSR   CCOMMA
                      (    forth6809.asm):06378         
                      (    forth6809.asm):06379                  LDD   TSTCSAV
                      (    forth6809.asm):06380                  STD   CODEHERE
                      (    forth6809.asm):06381         
                      (    forth6809.asm):06382                  STU   TSTU0
                      (    forth6809.asm):06383         
                      (    forth6809.asm):06384                  LDD   #TSTGUARD
                      (    forth6809.asm):06385                  PSHU  D
                      (    forth6809.asm):06386                  LDD   #TRUEV

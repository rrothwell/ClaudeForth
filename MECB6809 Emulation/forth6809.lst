                      (    forth6809.asm):09117                  LDD   #TSTNAMEB
                      (    forth6809.asm):09118                  STD   SRCADDR
                      (    forth6809.asm):09119                  LDD   #6
                      (    forth6809.asm):09120                  STD   SRCLEN
                      (    forth6809.asm):09121                  LDD   #0
                      (    forth6809.asm):09122                  STD   TOIN
                      (    forth6809.asm):09123         
                      (    forth6809.asm):09124                  LDD   CODEHERE
                      (    forth6809.asm):09125                  STD   TSTWCFA
                      (    forth6809.asm):09126         
                      (    forth6809.asm):09127                  JSR   DEFERW
                      (    forth6809.asm):09128         
                      (    forth6809.asm):09129                  LDD   TSTCSAV
                      (    forth6809.asm):09130                  STD   CODEHERE
                      (    forth6809.asm):09131         
                      (    forth6809.asm):09132                  LDA   #'T'
                      (    forth6809.asm):09133                  STA   TSTNAMEB
                      (    forth6809.asm):09134                  LDA   #'E'
                      (    forth6809.asm):09135                  STA   TSTNAMEB+1
                      (    forth6809.asm):09136                  LDA   #'S'
                      (    forth6809.asm):09137                  STA   TSTNAMEB+2
                      (    forth6809.asm):09138                  LDA   #'T'
                      (    forth6809.asm):09139                  STA   TSTNAMEB+3
                      (    forth6809.asm):09140                  LDA   #'W'
                      (    forth6809.asm):09141                  STA   TSTNAMEB+4
                      (    forth6809.asm):09142                  LDA   #'D'
                      (    forth6809.asm):09143                  STA   TSTNAMEB+5
                      (    forth6809.asm):09144                  LDD   #TSTNAMEB
                      (    forth6809.asm):09145                  STD   SRCADDR
                      (    forth6809.asm):09146                  LDD   #6
                      (    forth6809.asm):09147                  STD   SRCLEN
                      (    forth6809.asm):09148                  LDD   #0
                      (    forth6809.asm):09149                  STD   TOIN
                      (    forth6809.asm):09150                  LDD   #0
                      (    forth6809.asm):09151                  STD   STATE
                      (    forth6809.asm):09152         
                      (    forth6809.asm):09153                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):09154                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):09155                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):09156                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09157                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09158                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09159                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09160                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09161                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09162                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09163                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09164                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09165                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09166                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):09167                  STD   CODEHERE
                      (    forth6809.asm):09168         
                      (    forth6809.asm):09169                  LDD   #DUP
                      (    forth6809.asm):09170                  PSHU  D
                      (    forth6809.asm):09171                  JSR   ISW
                      (    forth6809.asm):09172         
                      (    forth6809.asm):09173                  STU   TSTU0
                      (    forth6809.asm):09174         
                      (    forth6809.asm):09175                  LDD   #TSTGUARD
                      (    forth6809.asm):09176                  PSHU  D
                      (    forth6809.asm):09177                  LDD   #TSTVAL1
                      (    forth6809.asm):09178                  PSHU  D
                      (    forth6809.asm):09179                  STU   TSTUB4
                      (    forth6809.asm):09180         
                      (    forth6809.asm):09181                  LDX   TSTWCFA
                      (    forth6809.asm):09182                  JSR   ,X
                      (    forth6809.asm):09183         
                      (    forth6809.asm):09184                  STU   TSTUAF
                      (    forth6809.asm):09185         
                      (    forth6809.asm):09186                  PULU  D
                      (    forth6809.asm):09187                  CMPD  #TSTVAL1
                      (    forth6809.asm):09188                  LBNE   ISFAIL  ; was BNE - out of short-branch range, since
                      (    forth6809.asm):09189                                 ; ISFAIL sits past this test's entire second
                      (    forth6809.asm):09190                                 ; phase (the ACTION-OF lookup and re-check)
                      (    forth6809.asm):09191                  PULU  D
                      (    forth6809.asm):09192                  CMPD  #TSTVAL1
                      (    forth6809.asm):09193                  BNE   ISFAIL
                      (    forth6809.asm):09194                  PULU  D
                      (    forth6809.asm):09195                  CMPD  #TSTGUARD
                      (    forth6809.asm):09196                  BNE   ISFAIL
                      (    forth6809.asm):09197         
                      (    forth6809.asm):09198                  LDD   TSTUB4
                      (    forth6809.asm):09199                  SUBD  TSTUAF
                      (    forth6809.asm):09200                  CMPD  #2
                      (    forth6809.asm):09201                  BNE   ISFAIL
                      (    forth6809.asm):09202         
                      (    forth6809.asm):09203                  LDA   #'T'
                      (    forth6809.asm):09204                  STA   TSTNAMEB
                      (    forth6809.asm):09205                  LDA   #'E'
                      (    forth6809.asm):09206                  STA   TSTNAMEB+1
                      (    forth6809.asm):09207                  LDA   #'S'
                      (    forth6809.asm):09208                  STA   TSTNAMEB+2
                      (    forth6809.asm):09209                  LDA   #'T'
                      (    forth6809.asm):09210                  STA   TSTNAMEB+3
                      (    forth6809.asm):09211                  LDA   #'W'
                      (    forth6809.asm):09212                  STA   TSTNAMEB+4
                      (    forth6809.asm):09213                  LDA   #'D'
                      (    forth6809.asm):09214                  STA   TSTNAMEB+5
                      (    forth6809.asm):09215                  LDD   #TSTNAMEB
                      (    forth6809.asm):09216                  STD   SRCADDR
                      (    forth6809.asm):09217                  LDD   #6
                      (    forth6809.asm):09218                  STD   SRCLEN
                      (    forth6809.asm):09219                  LDD   #0
                      (    forth6809.asm):09220                  STD   TOIN
                      (    forth6809.asm):09221         
                      (    forth6809.asm):09222                  LDD   #TSTCBUF2  ; BUG FIX: same missing redirect as before
                      (    forth6809.asm):09223                                   ; ISW above - ACTIONOF's own internal WORD
                      (    forth6809.asm):09224                                   ; call needs somewhere safe to write its
                      (    forth6809.asm):09225                                   ; parsed-token output too.
                      (    forth6809.asm):09226                  STD   CODEHERE
                      (    forth6809.asm):09227         
                      (    forth6809.asm):09228                  JSR   ACTIONOF
                      (    forth6809.asm):09229         
                      (    forth6809.asm):09230                  LDD   TSTCSAV
                      (    forth6809.asm):09231                  STD   CODEHERE

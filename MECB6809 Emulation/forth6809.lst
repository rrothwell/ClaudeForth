                      (    forth6809.asm):07368         ; TSTUNLOOP - unit test for UNLOOP. A true no-op (bare RTS) per
                      (    forth6809.asm):07369         ; its own extensively-documented design history in the source -
                      (    forth6809.asm):07370         ; superseded by EXIT's own automatic frame-discarding, kept
                      (    forth6809.asm):07371         ; only for source compatibility. Not compile-time/immediate
                      (    forth6809.asm):07372         ; like the rest of this section - a plain runtime word, tested
                      (    forth6809.asm):07373         ; directly without the compile harness, same pattern as ALIGN's
                      (    forth6809.asm):07374         ; own test in section 3.6: pushes decoy values, calls UNLOOP,
                      (    forth6809.asm):07375         ; confirms the whole stack is genuinely undisturbed.
                      (    forth6809.asm):07376         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07377         TSTUNLOOP: STU  TSTU0
                      (    forth6809.asm):07378         
                      (    forth6809.asm):07379                    LDD  #TSTGUARD
                      (    forth6809.asm):07380                    PSHU D
                      (    forth6809.asm):07381                    LDD  #TSTVAL1
                      (    forth6809.asm):07382                    PSHU D
                      (    forth6809.asm):07383                    LDD  #TSTVAL2
                      (    forth6809.asm):07384                    PSHU D
                      (    forth6809.asm):07385                    STU  TSTUB4
                      (    forth6809.asm):07386         
                      (    forth6809.asm):07387                    JSR  UNLOOP
                      (    forth6809.asm):07388         
                      (    forth6809.asm):07389                    STU  TSTUAF
                      (    forth6809.asm):07390         
                      (    forth6809.asm):07391                    PULU D
                      (    forth6809.asm):07392                    CMPD #TSTVAL2
                      (    forth6809.asm):07393                    BNE  UOFAIL
                      (    forth6809.asm):07394                    PULU D
                      (    forth6809.asm):07395                    CMPD #TSTVAL1
                      (    forth6809.asm):07396                    BNE  UOFAIL
                      (    forth6809.asm):07397                    PULU D
                      (    forth6809.asm):07398                    CMPD #TSTGUARD
                      (    forth6809.asm):07399                    BNE  UOFAIL
                      (    forth6809.asm):07400         
                      (    forth6809.asm):07401                    LDD  TSTUB4
                      (    forth6809.asm):07402                    SUBD TSTUAF
                      (    forth6809.asm):07403                    CMPD #0
                      (    forth6809.asm):07404                    BNE  UOFAIL
                      (    forth6809.asm):07405         
                      (    forth6809.asm):07406                    LDD  #TRUEV
                      (    forth6809.asm):07407                    BRA  UODONE
C100                  (    forth6809.asm):07408         UOFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):07409         UODONE:    LDX  #TSTUNLOOPNAME
                      (    forth6809.asm):07410                    PSHU X
                      (    forth6809.asm):07411                    PSHU D

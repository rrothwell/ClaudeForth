                      (    forth6809.asm):08946         ; TSTDEFER2 - unit test for DEFER together with DEFER!/DEFER@.
                      (    forth6809.asm):08947         ; Compiles "DEFER TESTWD", sets its target to DUP's own xt via
                      (    forth6809.asm):08948         ; DEFER! (an ordinary runtime word - unlike DEFER's own name-
                      (    forth6809.asm):08949         ; parsing, DEFER!/DEFER@ take an xt-defer directly, no WORD/FIND
                      (    forth6809.asm):08950         ; needed), executes TESTWD (should now behave like DUP), then
                      (    forth6809.asm):08951         ; reads the target back via DEFER@ to confirm it matches.
                      (    forth6809.asm):08952         ; ------------------------------------------------------------

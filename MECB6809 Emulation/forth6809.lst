                      (    forth6809.asm):07584         ; TSTTHENZ - unit test for THEN, tag-mismatch case. Pushes a
                      (    forth6809.asm):07585         ; wrong value (0, matching none of TAGFWD/TAGBACK/TAGDO/TAGOF)
                      (    forth6809.asm):07586         ; in place of the expected TAGFWD, then calls THEN via CATCH.
                      (    forth6809.asm):07587         ; CFERR (confirmed by reading it directly) throws -22
                      (    forth6809.asm):07588         ; immediately without ever touching CODEHERE - the error path
                      (    forth6809.asm):07589         ; never reaches any compiling code - so this needs no CODEHERE
                      (    forth6809.asm):07590         ; redirect, unlike every other test in this section. Same
                      (    forth6809.asm):07591         ; CATCH-based pattern as the divide-by-zero tests in earlier
                      (    forth6809.asm):07592         ; sections: verify the thrown code and CATCH's own depth-
                      (    forth6809.asm):07593         ; restoration contract, not the unspecified i*x values.
                      (    forth6809.asm):07594         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07595         TSTTHENZ: STU  TSTU0
                      (    forth6809.asm):07596         
                      (    forth6809.asm):07597                   LDD  #0
                      (    forth6809.asm):07598                   PSHU D
                      (    forth6809.asm):07599                   LDD  #0
                      (    forth6809.asm):07600                   PSHU D
                      (    forth6809.asm):07601                   LDX  #THEN
                      (    forth6809.asm):07602                   PSHU X
                      (    forth6809.asm):07603                   STU  TSTUB4
                      (    forth6809.asm):07604         
                      (    forth6809.asm):07605                   JSR  CATCH
                      (    forth6809.asm):07606         
                      (    forth6809.asm):07607                   STU  TSTUAF
                      (    forth6809.asm):07608         
                      (    forth6809.asm):07609                   PULU D
                      (    forth6809.asm):07610                   CMPD #-22
                      (    forth6809.asm):07611                   BNE  T3FAIL
                      (    forth6809.asm):07612         
                      (    forth6809.asm):07613                   LDD  TSTUB4
                      (    forth6809.asm):07614                   SUBD TSTUAF
                      (    forth6809.asm):07615                   CMPD #0
                      (    forth6809.asm):07616                   BNE  T3FAIL
                      (    forth6809.asm):07617         
                      (    forth6809.asm):07618                   LDD  #TRUEV
                      (    forth6809.asm):07619                   BRA  T3DONE
C100                  (    forth6809.asm):07620         T3FAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):07621         T3DONE:   LDX  #TSTTHENZNAME
                      (    forth6809.asm):07622                   PSHU X
                      (    forth6809.asm):07623                   PSHU D
                      (    forth6809.asm):07624                   JSR  TSTREPORT
                      (    forth6809.asm):07625         
                      (    forth6809.asm):07626                   LDU  TSTU0
                      (    forth6809.asm):07627                   RTS
                      (    forth6809.asm):07628         
C100                  (    forth6809.asm):07629         TSTTHENZNAME: FCB  8
                      (    forth6809.asm):07630                       FCC  "TSTTHENZ"
                      (    forth6809.asm):07631         

                      (    forth6809.asm):02771                    CMPD  #TSTGUARD
                      (    forth6809.asm):02772                    BNE   S1FAIL
                      (    forth6809.asm):02773         
                      (    forth6809.asm):02774                    LDD   TSTUB4
                      (    forth6809.asm):02775                    SUBD  TSTUAF

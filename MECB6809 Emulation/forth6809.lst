                      (    forth6809.asm):09071         ; TSTISOF - unit test for IS and ACTION-OF together. Compiles
                      (    forth6809.asm):09072         ; "DEFER TESTWD", interprets "DUP IS TESTWD" directly (IS parses
                      (    forth6809.asm):09073         ; "TESTWD" via WORD+FIND, needing LATEST still pointed at it -
                      (    forth6809.asm):09074         ; not restored until this whole test finishes), executes TESTWD
                      (    forth6809.asm):09075         ; (should now behave like DUP), then interprets "ACTION-OF
                      (    forth6809.asm):09076         ; TESTWD" to fetch the current target by name and confirms it
                      (    forth6809.asm):09077         ; matches DUP's own xt. Explicitly forces STATE=0 before both IS
                      (    forth6809.asm):09078         ; and ACTION-OF, since both are documented to behave differently
                      (    forth6809.asm):09079         ; by STATE, same reasoning as TSTVALTO's own TO test.
                      (    forth6809.asm):09080         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09081         TSTISOF: LDD   CODEHERE
                      (    forth6809.asm):09082                  STD   TSTCSAV
                      (    forth6809.asm):09083                  LDD   DPHERE
                      (    forth6809.asm):09084                  STD   TSTDSAV
                      (    forth6809.asm):09085                  LDD   VARHERE
                      (    forth6809.asm):09086                  STD   TSTVSAV

                      (    forth6809.asm):06571         ; TSTBWR - unit test for BEGIN/WHILE/REPEAT. Compiles
                      (    forth6809.asm):06572         ; "BEGIN DUP <lit 5> < WHILE 1+ REPEAT" - opposite polarity
                      (    forth6809.asm):06573         ; from TSTBGU's UNTIL (continues on true, exits on false,
                      (    forth6809.asm):06574         ; rather than the reverse) - starting from 0, increments while
                      (    forth6809.asm):06575         ; less than 5. Naturally exercises both of WHILE's outcomes in
                      (    forth6809.asm):06576         ; one test: the continue path 5 times, the exit path once.
                      (    forth6809.asm):06577         ; Verified by hand-trace: WHILE's patched forward offset (10)
                      (    forth6809.asm):06578         ; lands exactly at the final RTS; REPEAT's patched back-edge
                      (    forth6809.asm):06579         ; (-22) lands exactly at BEGIN.
                      (    forth6809.asm):06580         ; ------------------------------------------------------------

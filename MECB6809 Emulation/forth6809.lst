                      (    forth6809.asm):02120                    BRA   TKDONE
C100                  (    forth6809.asm):02121         TKFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):02122         TKDONE:    LDX   #TSTTUCKNAME
                      (    forth6809.asm):02123                    PSHU  X
                      (    forth6809.asm):02124                    PSHU  D
                      (    forth6809.asm):02125                    JSR   TSTREPORT

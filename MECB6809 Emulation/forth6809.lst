                      (    forth6809.asm):04875                    PSHU  D
                      (    forth6809.asm):04876                    LDD   #TSTVAL2
                      (    forth6809.asm):04877                    PSHU  D
                      (    forth6809.asm):04878                    STU   TSTUB4
                      (    forth6809.asm):04879         
                      (    forth6809.asm):04880                    JSR   ANDW
                      (    forth6809.asm):04881         
                      (    forth6809.asm):04882                    STU   TSTUAF

                      (    forth6809.asm):16121         
                      (    forth6809.asm):16122                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):16123                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):16124                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):16125                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):16126                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):16127                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):16128                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):16129                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):16130                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):16131                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):16132                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):16133                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):16134                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):16135                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):16136                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):16137                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):16138                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):16139                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):16140                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):16141         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):16142                    BEQ  UEDONE
F87D A680             (    forth6809.asm):16143                    LDA  ,X+
F87F 8125             (    forth6809.asm):16144                    CMPA #'%'
F881 2604             (    forth6809.asm):16145                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):16146                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):16147                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):16148                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):16149                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):16150                                   ; the same string correctly, since this runs
                      (    forth6809.asm):16151                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):16152         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):16153                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):16154                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):16155                    SUBD #1
F88E DDA9             (    forth6809.asm):16156                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):16157                    BRA  UELOOP
F892 1F20             (    forth6809.asm):16158         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):16159                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):16160                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):16161                                   ; required return values, and separately,
                      (    forth6809.asm):16162                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):16163                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):16164                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):16165                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):16166                                   ; characters. Now computed directly as the
                      (    forth6809.asm):16167                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):16168                                   ; original destination address (UEDST) -
                      (    forth6809.asm):16169                                   ; correct regardless of how many characters
                      (    forth6809.asm):16170                                   ; were doubled, since it's derived from
                      (    forth6809.asm):16171                                   ; where writing actually stopped rather than
                      (    forth6809.asm):16172                                   ; incremented alongside it.

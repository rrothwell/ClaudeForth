                      (    forth6809.asm):01664         ; TSTQDUPNZ - unit test for ?DUP ( n -- n n | 0 ), nonzero case.
                      (    forth6809.asm):01665         ; Verifies the nonzero value is duplicated, the guard beneath is
                      (    forth6809.asm):01666         ; undisturbed, and exactly one cell was added - same as DUP's
                      (    forth6809.asm):01667         ; own behavior for this case. ?DUP needs two tests, one per
                      (    forth6809.asm):01668         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01669         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01670         ; ------------------------------------------------------------

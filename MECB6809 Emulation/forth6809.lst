                      (    forth6809.asm):06298                  JSR   IF
                      (    forth6809.asm):06299         
                      (    forth6809.asm):06300                  LDD   #111
                      (    forth6809.asm):06301                  PSHU  D
                      (    forth6809.asm):06302                  JSR   LITERALW
                      (    forth6809.asm):06303         
                      (    forth6809.asm):06304                  JSR   THEN
                      (    forth6809.asm):06305         
                      (    forth6809.asm):06306                  LDD   #OPRTS
                      (    forth6809.asm):06307                  PSHU  D
                      (    forth6809.asm):06308                  JSR   CCOMMA
                      (    forth6809.asm):06309         
                      (    forth6809.asm):06310                  LDD   TSTCSAV
                      (    forth6809.asm):06311                  STD   CODEHERE
                      (    forth6809.asm):06312         
                      (    forth6809.asm):06313                  STU   TSTU0
                      (    forth6809.asm):06314         
                      (    forth6809.asm):06315                  LDD   #TSTGUARD
                      (    forth6809.asm):06316                  PSHU  D
                      (    forth6809.asm):06317                  LDD   #FALSEV
                      (    forth6809.asm):06318                  PSHU  D
                      (    forth6809.asm):06319                  STU   TSTUB4
                      (    forth6809.asm):06320         
                      (    forth6809.asm):06321                  JSR   TSTCBUF
                      (    forth6809.asm):06322         
                      (    forth6809.asm):06323                  STU   TSTUAF
                      (    forth6809.asm):06324         
                      (    forth6809.asm):06325                  PULU  D
                      (    forth6809.asm):06326                  CMPD  #TSTGUARD
                      (    forth6809.asm):06327                  BNE   T2FAIL
                      (    forth6809.asm):06328         
                      (    forth6809.asm):06329                  LDD   TSTUB4
                      (    forth6809.asm):06330                  SUBD  TSTUAF
                      (    forth6809.asm):06331                  CMPD  #-2
                      (    forth6809.asm):06332                  BNE   T2FAIL
                      (    forth6809.asm):06333         
                      (    forth6809.asm):06334                  LDD   #TRUEV
                      (    forth6809.asm):06335                  BRA   T2DONE
C100                  (    forth6809.asm):06336         T2FAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):06337         T2DONE:  LDX   #TSTIFT2NAME
                      (    forth6809.asm):06338                  PSHU  X
                      (    forth6809.asm):06339                  PSHU  D
                      (    forth6809.asm):06340                  JSR   TSTREPORT
                      (    forth6809.asm):06341         
                      (    forth6809.asm):06342                  LDU   TSTU0
                      (    forth6809.asm):06343                  RTS
                      (    forth6809.asm):06344         
C100                  (    forth6809.asm):06345         TSTIFT2NAME: FCB  7
                      (    forth6809.asm):06346                      FCC  "TSTIFT2"
                      (    forth6809.asm):06347         
                      (    forth6809.asm):06348         ; ------------------------------------------------------------
                      (    forth6809.asm):06349         ; TSTIET1 - unit test for IF/ELSE/THEN, true case. Compiles
                      (    forth6809.asm):06350         ; "IF <lit 111> ELSE <lit 222> THEN" into scratch. True flag
                      (    forth6809.asm):06351         ; should take the IF-body (111) and skip the ELSE-body (222)
                      (    forth6809.asm):06352         ; via ELSE's own unconditional branch. Verified by hand-trace:
                      (    forth6809.asm):06353         ; IF's patched offset (12) lands exactly at the ELSE-body's
                      (    forth6809.asm):06354         ; start; ELSE's own patched offset (7) lands exactly past it.
                      (    forth6809.asm):06355         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06356         TSTIET1: LDD   CODEHERE
                      (    forth6809.asm):06357                  STD   TSTCSAV
                      (    forth6809.asm):06358                  LDD   #TSTCBUF

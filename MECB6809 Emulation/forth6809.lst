                      (    forth6809.asm):09088                  STD   TSTSASAV
                      (    forth6809.asm):09089                  LDD   SRCLEN
                      (    forth6809.asm):09090                  STD   TSTSLSAV
                      (    forth6809.asm):09091                  LDD   TOIN
                      (    forth6809.asm):09092                  STD   TSTTISAV
                      (    forth6809.asm):09093                  LDD   STATE
                      (    forth6809.asm):09094                  STD   TSTSTSAV
                      (    forth6809.asm):09095                  LDD   LATEST
                      (    forth6809.asm):09096                  STD   TSTLSAV
                      (    forth6809.asm):09097         
                      (    forth6809.asm):09098                  LDA   #'T'
                      (    forth6809.asm):09099                  STA   TSTNAMEB
                      (    forth6809.asm):09100                  LDA   #'E'
                      (    forth6809.asm):09101                  STA   TSTNAMEB+1
                      (    forth6809.asm):09102                  LDA   #'S'
                      (    forth6809.asm):09103                  STA   TSTNAMEB+2
                      (    forth6809.asm):09104                  LDA   #'T'
                      (    forth6809.asm):09105                  STA   TSTNAMEB+3
                      (    forth6809.asm):09106                  LDA   #'W'
                      (    forth6809.asm):09107                  STA   TSTNAMEB+4

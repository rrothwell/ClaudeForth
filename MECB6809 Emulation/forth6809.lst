                      (    forth6809.asm):03892         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03893         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03894         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03895         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03896         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03897         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03898         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03899         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03900         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03901         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03902         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03903         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03904         TSTDARITH: JSR   CRW
                      (    forth6809.asm):03905                    LDX   #TSTDARITHMSG
                      (    forth6809.asm):03906                    PSHU  X
                      (    forth6809.asm):03907                    LDD   #11
                      (    forth6809.asm):03908                    PSHU  D
                      (    forth6809.asm):03909                    JSR   TYPE
                      (    forth6809.asm):03910                    JSR   CRW
                      (    forth6809.asm):03911         
                      (    forth6809.asm):03912                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03913         
                      (    forth6809.asm):03914                    JSR   TSTUMST
                      (    forth6809.asm):03915                    JSR   TSTUMSM
                      (    forth6809.asm):03916                    JSR   TSTUMSZ
                      (    forth6809.asm):03917                    JSR   TSTMSTAR
                      (    forth6809.asm):03918                    JSR   TSTFMSM
                      (    forth6809.asm):03919                    JSR   TSTFMSZ
                      (    forth6809.asm):03920                    JSR   TSTSMRM
                      (    forth6809.asm):03921                    JSR   TSTSMRZ
                      (    forth6809.asm):03922                    JSR   TSTDPLUS
                      (    forth6809.asm):03923                    JSR   TSTDMIN2
                      (    forth6809.asm):03924                    JSR   TSTDNEG
                      (    forth6809.asm):03925                    JSR   TSTDABS1
                      (    forth6809.asm):03926                    JSR   TSTDABS2
                      (    forth6809.asm):03927                    JSR   TSTMPLUS
                      (    forth6809.asm):03928                    JSR   TSTSTOD
                      (    forth6809.asm):03929                    JSR   TSTDTOS
                      (    forth6809.asm):03930                    JSR   TSTDMAX
                      (    forth6809.asm):03931                    JSR   TSTDMIN
                      (    forth6809.asm):03932         
                      (    forth6809.asm):03933                    ENDC ; <<<<
                      (    forth6809.asm):03934         
                      (    forth6809.asm):03935                    RTS
                      (    forth6809.asm):03936         
C100                  (    forth6809.asm):03937         TSTDARITHMSG: FCC "DArithmetic"
                      (    forth6809.asm):03938         
                      (    forth6809.asm):03939                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03940         

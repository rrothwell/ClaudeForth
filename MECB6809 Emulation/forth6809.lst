                      (    forth6809.asm):02093                    LDD   #TSTVAL2
                      (    forth6809.asm):02094                    PSHU  D
                      (    forth6809.asm):02095                    STU   TSTUB4
                      (    forth6809.asm):02096         
                      (    forth6809.asm):02097                    JSR   TUCK
                      (    forth6809.asm):02098         

C100                  (    forth6809.asm):08022         CNFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):08023         CNDONE:   LDX  #TSTCONSTNAME
                      (    forth6809.asm):08024                   PSHU X
                      (    forth6809.asm):08025                   PSHU D
                      (    forth6809.asm):08026                   JSR  TSTREPORT

                      (    forth6809.asm):07506         ; TSTCASE2 - unit test for CASE/OF/ENDOF/ENDCASE, no-match
                      (    forth6809.asm):07507         ; case. Same compiled snippet as TSTCASE1, run with a selector
                      (    forth6809.asm):07508         ; (99) matching neither clause - should fall through both OF
                      (    forth6809.asm):07509         ; checks (selector preserved across each non-match, per the
                      (    forth6809.asm):07510         ; documented "( x n -- | x )" effect) and reach ENDCASE's own
                      (    forth6809.asm):07511         ; fallback DROP, consuming the selector with nothing pushed in
                      (    forth6809.asm):07512         ; its place.
                      (    forth6809.asm):07513         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07514         TSTCASE2: LDD  CODEHERE
                      (    forth6809.asm):07515                   STD  TSTCSAV
                      (    forth6809.asm):07516                   LDD  #TSTCBUF
                      (    forth6809.asm):07517                   STD  CODEHERE
                      (    forth6809.asm):07518         
                      (    forth6809.asm):07519                   JSR  CASEW
                      (    forth6809.asm):07520         
                      (    forth6809.asm):07521                   LDD  #1
                      (    forth6809.asm):07522                   PSHU D
                      (    forth6809.asm):07523                   JSR  LITERALW
                      (    forth6809.asm):07524                   JSR  OF
                      (    forth6809.asm):07525                   LDD  #111
                      (    forth6809.asm):07526                   PSHU D
                      (    forth6809.asm):07527                   JSR  LITERALW
                      (    forth6809.asm):07528                   JSR  ENDOF
                      (    forth6809.asm):07529         
                      (    forth6809.asm):07530                   LDD  #2
                      (    forth6809.asm):07531                   PSHU D
                      (    forth6809.asm):07532                   JSR  LITERALW
                      (    forth6809.asm):07533                   JSR  OF
                      (    forth6809.asm):07534                   LDD  #222
                      (    forth6809.asm):07535                   PSHU D
                      (    forth6809.asm):07536                   JSR  LITERALW
                      (    forth6809.asm):07537                   JSR  ENDOF
                      (    forth6809.asm):07538         
                      (    forth6809.asm):07539                   JSR  ENDCASE
                      (    forth6809.asm):07540         
                      (    forth6809.asm):07541                   LDD  #OPRTS
                      (    forth6809.asm):07542                   PSHU D
                      (    forth6809.asm):07543                   JSR  CCOMMA
                      (    forth6809.asm):07544         
                      (    forth6809.asm):07545                   LDD  TSTCSAV
                      (    forth6809.asm):07546                   STD  CODEHERE
                      (    forth6809.asm):07547         
                      (    forth6809.asm):07548                   STU  TSTU0
                      (    forth6809.asm):07549         
                      (    forth6809.asm):07550                   LDD  #TSTGUARD
                      (    forth6809.asm):07551                   PSHU D
                      (    forth6809.asm):07552                   LDD  #99
                      (    forth6809.asm):07553                   PSHU D
                      (    forth6809.asm):07554                   STU  TSTUB4
                      (    forth6809.asm):07555         
                      (    forth6809.asm):07556                   JSR  TSTCBUF
                      (    forth6809.asm):07557         
                      (    forth6809.asm):07558                   STU  TSTUAF
                      (    forth6809.asm):07559         
                      (    forth6809.asm):07560                   PULU D
                      (    forth6809.asm):07561                   CMPD #TSTGUARD
                      (    forth6809.asm):07562                   BNE  C2FAIL
                      (    forth6809.asm):07563         
                      (    forth6809.asm):07564                   LDD  TSTUB4
                      (    forth6809.asm):07565                   SUBD TSTUAF
                      (    forth6809.asm):07566                   CMPD #-2
                      (    forth6809.asm):07567                   BNE  C2FAIL
                      (    forth6809.asm):07568         
                      (    forth6809.asm):07569                   LDD  #TRUEV
                      (    forth6809.asm):07570                   BRA  C2DONE
C100                  (    forth6809.asm):07571         C2FAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):07572         C2DONE:   LDX  #TSTCASE2NAME
                      (    forth6809.asm):07573                   PSHU X
                      (    forth6809.asm):07574                   PSHU D
                      (    forth6809.asm):07575                   JSR  TSTREPORT
                      (    forth6809.asm):07576         
                      (    forth6809.asm):07577                   LDU  TSTU0
                      (    forth6809.asm):07578                   RTS
                      (    forth6809.asm):07579         
C100                  (    forth6809.asm):07580         TSTCASE2NAME: FCB  9
                      (    forth6809.asm):07581                       FCC  "TSTCASE2"

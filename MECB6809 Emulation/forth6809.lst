                      (    forth6809.asm):11997         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):11998         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):11999         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):12000         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):12001         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):12002         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):12003         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):12004         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):12005         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):12006         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):12007         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):12008         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):12009                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):12010                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):12011                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):12012                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):12013                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):12014                  FDB   ABORT
                      (    forth6809.asm):12015         

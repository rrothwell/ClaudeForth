                      (    forth6809.asm):17232         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):17233         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):17234         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):17235         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):17236         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):17237         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):17238         ; ============================================================
                      (    forth6809.asm):17239         ; ------------------------------------------------------------
                      (    forth6809.asm):17240         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):17241         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):17242         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):17243         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):17244         ; - no indirection, no value cell.
                      (    forth6809.asm):17245         ;
                      (    forth6809.asm):17246         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):17247         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):17248         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):17249         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):17250         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):17251         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):17252         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):17253         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):17254         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):17255         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):17256         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):17257         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):17258                    PSHU  D
FF3C 39               (    forth6809.asm):17259                    RTS
                      (    forth6809.asm):17260         
FF3D CC0000           (    forth6809.asm):17261         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):17262                    PSHU  D
FF42 39               (    forth6809.asm):17263                    RTS
                      (    forth6809.asm):17264         
                      (    forth6809.asm):17265         ; ------------------------------------------------------------
                      (    forth6809.asm):17266         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):17267         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):17268         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):17269         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):17270         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):17271         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):17272                    PSHU  D
FF48 39               (    forth6809.asm):17273                    RTS
                      (    forth6809.asm):17274         
FF49 CCFFFF           (    forth6809.asm):17275         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):17276                    PSHU  D
FF4E 39               (    forth6809.asm):17277                    RTS
                      (    forth6809.asm):17278         
FF4F CC0002           (    forth6809.asm):17279         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):17280                    PSHU  D
FF54 39               (    forth6809.asm):17281                    RTS
                      (    forth6809.asm):17282         

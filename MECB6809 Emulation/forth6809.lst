                      (    forth6809.asm):01420         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):01421         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):01422         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):01423         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):01424         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):01425         ; pushes that set the test up).
                      (    forth6809.asm):01426         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01427         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):01428         
                      (    forth6809.asm):01429                    LDD   #TSTGUARD
                      (    forth6809.asm):01430                    PSHU  D
                      (    forth6809.asm):01431                    LDD   #TSTVAL1
                      (    forth6809.asm):01432                    PSHU  D
                      (    forth6809.asm):01433                    STU   TSTUB4
                      (    forth6809.asm):01434         
                      (    forth6809.asm):01435                    JSR   DUP
                      (    forth6809.asm):01436         
                      (    forth6809.asm):01437                    STU   TSTUAF
                      (    forth6809.asm):01438         
                      (    forth6809.asm):01439                    PULU  D
                      (    forth6809.asm):01440                    CMPD  #TSTVAL1
                      (    forth6809.asm):01441                    BNE   TDFAIL
                      (    forth6809.asm):01442                    PULU  D
                      (    forth6809.asm):01443                    CMPD  #TSTVAL1
                      (    forth6809.asm):01444                    BNE   TDFAIL
                      (    forth6809.asm):01445                    PULU  D
                      (    forth6809.asm):01446                    CMPD  #TSTGUARD
                      (    forth6809.asm):01447                    BNE   TDFAIL
                      (    forth6809.asm):01448         
                      (    forth6809.asm):01449                    LDD   TSTUB4
                      (    forth6809.asm):01450                    SUBD  TSTUAF
                      (    forth6809.asm):01451                    CMPD  #2
                      (    forth6809.asm):01452                    BNE   TDFAIL
                      (    forth6809.asm):01453         
                      (    forth6809.asm):01454                    LDD   #TRUEV
                      (    forth6809.asm):01455                    BRA   TDDONE
C100                  (    forth6809.asm):01456         TDFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):01457         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):01458                    PSHU  X
                      (    forth6809.asm):01459                    PSHU  D
                      (    forth6809.asm):01460                    JSR   TSTREPORT
                      (    forth6809.asm):01461         
                      (    forth6809.asm):01462                    LDU   TSTU0
                      (    forth6809.asm):01463                    RTS
                      (    forth6809.asm):01464         
C100                  (    forth6809.asm):01465         TSTDUPNAME: FCB  6
                      (    forth6809.asm):01466                     FCC  "TSTDUP"
                      (    forth6809.asm):01467         

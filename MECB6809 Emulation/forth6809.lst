                      (    forth6809.asm):10418         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (    forth6809.asm):10419         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (    forth6809.asm):10420         ; IS tests, but gets its own dedicated test here too.
                      (    forth6809.asm):10421         ;
                      (    forth6809.asm):10422         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (    forth6809.asm):10423         ; itself (a pure address computation) - wrong, confirmed via
                      (    forth6809.asm):10424         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (    forth6809.asm):10425         ; returning the VALUE stored there, not the address itself. This
                      (    forth6809.asm):10426         ; is genuinely correct behavior for this system's own trampoline
                      (    forth6809.asm):10427         ; design, not a bug in TOBODY - reconciled directly against why
                      (    forth6809.asm):10428         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (    forth6809.asm):10429         ; same TOBODY and passed on real hardware, never surfaced this:
                      (    forth6809.asm):10430         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (    forth6809.asm):10431         ; own compile-time code stores a genuinely meaningful value at
                      (    forth6809.asm):10432         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (    forth6809.asm):10433         ; value) - "the body" for this system's own design IS the value
                      (    forth6809.asm):10434         ; at xt+5, not xt+5's own address. This test never initialized
                      (    forth6809.asm):10435         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (    forth6809.asm):10436         ; whatever garbage happened to already be there - now sets a
                      (    forth6809.asm):10437         ; known value there first and verifies TOBODY returns exactly
                      (    forth6809.asm):10438         ; that.
                      (    forth6809.asm):10439         ; ------------------------------------------------------------
C100                  (    forth6809.asm):10440         TSTTOBODY: LDD  #TSTVAL1
                      (    forth6809.asm):10441                    STD  TSTCBUF+5
                      (    forth6809.asm):10442         
                      (    forth6809.asm):10443                    STU  TSTU0
                      (    forth6809.asm):10444         
                      (    forth6809.asm):10445                    LDD  #TSTGUARD
                      (    forth6809.asm):10446                    PSHU D
                      (    forth6809.asm):10447                    LDD  #TSTCBUF
                      (    forth6809.asm):10448                    PSHU D
                      (    forth6809.asm):10449                    STU  TSTUB4
                      (    forth6809.asm):10450         
                      (    forth6809.asm):10451                    JSR  TOBODY
                      (    forth6809.asm):10452         
                      (    forth6809.asm):10453                    STU  TSTUAF
                      (    forth6809.asm):10454         
                      (    forth6809.asm):10455                    PULU D
                      (    forth6809.asm):10456                    CMPD #TSTVAL1
                      (    forth6809.asm):10457                    BNE  TBFAIL
                      (    forth6809.asm):10458                    PULU D
                      (    forth6809.asm):10459                    CMPD #TSTGUARD
                      (    forth6809.asm):10460                    BNE  TBFAIL
                      (    forth6809.asm):10461         
                      (    forth6809.asm):10462                    LDD  TSTUB4
                      (    forth6809.asm):10463                    SUBD TSTUAF
                      (    forth6809.asm):10464                    CMPD #0
                      (    forth6809.asm):10465                    BNE  TBFAIL
                      (    forth6809.asm):10466         
                      (    forth6809.asm):10467                    LDD  #TRUEV

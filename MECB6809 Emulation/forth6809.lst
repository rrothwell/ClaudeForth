                      (    forth6809.asm):04818         ; TSTLOGIC - logic, shift, and address-arithmetic tests (glossary
                      (    forth6809.asm):04819         ; section 3.6). Covers every word in that section. Several of
                      (    forth6809.asm):04820         ; these (INVERT, CELLS, CELL+, CHARS, CHAR+, ALIGNED) modify the
                      (    forth6809.asm):04821         ; top of stack in place (LDD/op/STD) rather than PULU/PSHU - the
                      (    forth6809.asm):04822         ; tests verify what's observable via the stack either way, not
                      (    forth6809.asm):04823         ; how each implementation gets there. Three words (CHARS, ALIGN,
                      (    forth6809.asm):04824         ; ALIGNED) are documented no-ops on this system; CHARS/ALIGNED
                      (    forth6809.asm):04825         ; still get a normal single-value test (verifying identity),
                      (    forth6809.asm):04826         ; while ALIGN - which takes no stack arguments at all - gets a
                      (    forth6809.asm):04827         ; dedicated test pushing decoy values to confirm the whole stack,
                      (    forth6809.asm):04828         ; not just one value, is genuinely undisturbed. RSHIFT tested
                      (    forth6809.asm):04829         ; against a negative input specifically, since it's documented
                      (    forth6809.asm):04830         ; logical (zero-fill), not arithmetic (sign-preserving) - the
                      (    forth6809.asm):04831         ; case that actually distinguishes the two conventions, same
                      (    forth6809.asm):04832         ; reasoning already applied to 2/ and FM/MOD vs SM/REM earlier.
                      (    forth6809.asm):04833         ; ------------------------------------------------------------
C100                  (    forth6809.asm):04834         TSTLOGIC:  JSR   CRW
                      (    forth6809.asm):04835                    LDX   #TSTLOGICMSG
                      (    forth6809.asm):04836                    PSHU  X
                      (    forth6809.asm):04837                    LDD   #5
                      (    forth6809.asm):04838                    PSHU  D
                      (    forth6809.asm):04839                    JSR   TYPE
                      (    forth6809.asm):04840                    JSR   CRW
                      (    forth6809.asm):04841         
                      (    forth6809.asm):04842                    IFEQ TSTSELECTOR-5  ; >>>>
                      (    forth6809.asm):04843         
                      (    forth6809.asm):04844                    JSR   TSTAND
                      (    forth6809.asm):04845                    JSR   TSTOR
                      (    forth6809.asm):04846                    JSR   TSTXOR
                      (    forth6809.asm):04847                    JSR   TSTINV
                      (    forth6809.asm):04848                    JSR   TSTLSH
                      (    forth6809.asm):04849                    JSR   TSTRSH
                      (    forth6809.asm):04850                    JSR   TSTCELS
                      (    forth6809.asm):04851                    JSR   TSTCELP
                      (    forth6809.asm):04852                    JSR   TSTCHRS
                      (    forth6809.asm):04853                    JSR   TSTCHRP
                      (    forth6809.asm):04854                    JSR   TSTALGD
                      (    forth6809.asm):04855                    JSR   TSTALGN
                      (    forth6809.asm):04856         
                      (    forth6809.asm):04857                    ENDC ; <<<<
                      (    forth6809.asm):04858         
                      (    forth6809.asm):04859                    RTS
                      (    forth6809.asm):04860         
C100                  (    forth6809.asm):04861         TSTLOGICMSG: FCC "Logic"
                      (    forth6809.asm):04862         
                      (    forth6809.asm):04863                    IFEQ TSTSELECTOR-5  ; >>>>
                      (    forth6809.asm):04864         
                      (    forth6809.asm):04865         ; ------------------------------------------------------------

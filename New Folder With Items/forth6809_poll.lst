                      (    forth6809.asm):03817         ; ------------------------------------------------------------
                      (    forth6809.asm):03818         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03819         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03820         ; ------------------------------------------------------------
E0D8 DC47             (    forth6809.asm):03821         GETCURW:    LDD   CURRENT
E0DA 3606             (    forth6809.asm):03822                     PSHU  D
E0DC 39               (    forth6809.asm):03823                     RTS
                      (    forth6809.asm):03824         
                      (    forth6809.asm):03825         ; ------------------------------------------------------------
                      (    forth6809.asm):03826         ; SET-CURRENT  ( wid -- )
                      (    forth6809.asm):03827         ; Make wid the wordlist that receives new definitions. Throws -11 for
                      (    forth6809.asm):03828         ; an invalid wid.
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
E0DD 3710             (    forth6809.asm):03830         SETCURW:    PULU  X
E0DF BDDFF3           (    forth6809.asm):03831                     JSR   WIDCHK
E0E2 9F47             (    forth6809.asm):03832                     STX   CURRENT
E0E4 39               (    forth6809.asm):03833                     RTS
                      (    forth6809.asm):03834         
                      (    forth6809.asm):03835         ; ------------------------------------------------------------
                      (    forth6809.asm):03836         ; DEFINITIONS  ( -- )
                      (    forth6809.asm):03837         ; Make the first wordlist of the search order the one that receives new
                      (    forth6809.asm):03838         ; definitions. Throws -50 when the search order is empty.
                      (    forth6809.asm):03839         ; ------------------------------------------------------------
E0E5                  (    forth6809.asm):03840         DEFINITIONSW:
E0E5 8E004B           (    forth6809.asm):03841                     LDX   #ORDER
E0E8 9C49             (    forth6809.asm):03842                     CMPX  ORDEND
E0EA 2405             (    forth6809.asm):03843                     BHS   DFUNDER
E0EC EC84             (    forth6809.asm):03844                     LDD   ,X
E0EE DD47             (    forth6809.asm):03845                     STD   CURRENT
E0F0 39               (    forth6809.asm):03846                     RTS
E0F1 CCFFCE           (    forth6809.asm):03847         DFUNDER:    LDD   #-50
E0F4 3606             (    forth6809.asm):03848                     PSHU  D
E0F6 7EE402           (    forth6809.asm):03849                     JMP   THROWW
                      (    forth6809.asm):03850         
                      (    forth6809.asm):03851         ; ------------------------------------------------------------
                      (    forth6809.asm):03852         ; ONLY  ( -- )
                      (    forth6809.asm):03853         ; Set the minimum search order: FORTH only (ROOT is still searched).
                      (    forth6809.asm):03854         ; ------------------------------------------------------------
E0F9 CC005B           (    forth6809.asm):03855         ONLYW:      LDD   #WLHEADS
E0FC DD4B             (    forth6809.asm):03856                     STD   ORDER
E0FE CC004D           (    forth6809.asm):03857                     LDD   #ORDER+2
E101 DD49             (    forth6809.asm):03858                     STD   ORDEND
E103 39               (    forth6809.asm):03859                     RTS
                      (    forth6809.asm):03860         
                      (    forth6809.asm):03861         ; ------------------------------------------------------------
                      (    forth6809.asm):03862         ; Replace the first wordlist of the search order with the WID in RegX,
                      (    forth6809.asm):03863         ; or make it the only one if the order is empty.
                      (    forth6809.asm):03864         ; SETTOP
                      (    forth6809.asm):03865         ;    Inputs:
                      (    forth6809.asm):03866         ;        RegX = WID
                      (    forth6809.asm):03867         ;    Outputs:
                      (    forth6809.asm):03868         ;        ORDER(0) = WID; ORDEND at least ORDER+2
                      (    forth6809.asm):03869         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03870         ; ------------------------------------------------------------
E104 9F4B             (    forth6809.asm):03871         SETTOP:     STX   ORDER

                      (    forth6809.asm):03547         ; ROOT, for a name.
                      (    forth6809.asm):03548         ; SRCHORD
                      (    forth6809.asm):03549         ;    Inputs:
                      (    forth6809.asm):03550         ;        RegY = address of the name text
                      (    forth6809.asm):03551         ;        RegB = name length
                      (    forth6809.asm):03552         ;    Outputs:

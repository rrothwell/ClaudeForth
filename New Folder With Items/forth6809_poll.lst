E082 2306             (    forth6809.asm):03767                     BLS   GODONE
E084 EC83             (    forth6809.asm):03768                     LDD   ,--X
E086 3606             (    forth6809.asm):03769                     PSHU  D
E088 20F5             (    forth6809.asm):03770                     BRA   GOLOOP
E08A DC49             (    forth6809.asm):03771         GODONE:     LDD   ORDEND
E08C 83004B           (    forth6809.asm):03772                     SUBD  #ORDER
E08F 44               (    forth6809.asm):03773                     LSRA
E090 56               (    forth6809.asm):03774                     RORB
E091 3606             (    forth6809.asm):03775                     PSHU  D                 ; n
E093 39               (    forth6809.asm):03776                     RTS
                      (    forth6809.asm):03777         
                      (    forth6809.asm):03778         ; ------------------------------------------------------------
                      (    forth6809.asm):03779         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03780         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03781         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03782         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03783         ; ------------------------------------------------------------
E094 3706             (    forth6809.asm):03784         SETORDERW:  PULU  D                 ; n
E096 1083FFFF         (    forth6809.asm):03785                     CMPD  #-1
E09A 275D             (    forth6809.asm):03786                     BEQ   ONLYW             ; the minimum order
E09C 4D               (    forth6809.asm):03787         SO1:        TSTA
E09D 2B31             (    forth6809.asm):03788                     BMI   SOUNDER
E09F 262A             (    forth6809.asm):03789                     BNE   SOOVER
E0A1 C108             (    forth6809.asm):03790                     CMPB  #WLMAX
E0A3 2226             (    forth6809.asm):03791                     BHI   SOOVER
E0A5 3404             (    forth6809.asm):03792                     PSHS  B                 ; 1,S = n
E0A7 3404             (    forth6809.asm):03793                     PSHS  B                 ; 0,S = count down
E0A9 1F32             (    forth6809.asm):03794                     TFR   U,Y
E0AB 6DE4             (    forth6809.asm):03795         SOCHK:      TST   ,S
E0AD 2709             (    forth6809.asm):03796                     BEQ   SOCOPY
E0AF AEA1             (    forth6809.asm):03797                     LDX   ,Y++

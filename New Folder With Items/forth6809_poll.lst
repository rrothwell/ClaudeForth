                      (    forth6809.asm):05118         ; ------------------------------------------------------------
                      (    forth6809.asm):05119         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05120         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05121         ; EXITUNLOOP
                      (    forth6809.asm):05122         ;    Inputs:
                      (    forth6809.asm):05123         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05124         ;        address
                      (    forth6809.asm):05125         ;    Outputs:
                      (    forth6809.asm):05126         ;        returns to the caller of the definition
                      (    forth6809.asm):05127         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05128         ; ------------------------------------------------------------

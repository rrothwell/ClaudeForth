                      (    forth6809.asm):07401         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07402         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07403         ; DOSTR followed by the counted string. When interpreting, copy the

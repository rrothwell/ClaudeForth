                      (    forth6809.asm):05425         ; SLITERAL  ( c-addr u -- )
                      (    forth6809.asm):05426         ; Compile DOSTR followed by a count byte and a copy of the string.
                      (    forth6809.asm):05427         ; THROW -14 if not compiling.
                      (    forth6809.asm):05428         ; ------------------------------------------------------------
E90A DC00             (    forth6809.asm):05429         SLITERALW:  LDD   STATE
E90C 2608             (    forth6809.asm):05430                     BNE   SLSTOK
E90E CCFFF2           (    forth6809.asm):05431                     LDD   #-14
E911 3606             (    forth6809.asm):05432                     PSHU  D
E913 BDE402           (    forth6809.asm):05433                     JSR   THROWW
E916 CCF288           (    forth6809.asm):05434         SLSTOK:     LDD   #DOSTR
E919 7EF2AD           (    forth6809.asm):05435                     JMP   CSTRCOMP          ; compile DOSTR and the counted string
                      (    forth6809.asm):05436         
                      (    forth6809.asm):05437         ; ------------------------------------------------------------
                      (    forth6809.asm):05438         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05439         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05440         ; the string.
                      (    forth6809.asm):05441         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05442         ;    Inputs:
                      (    forth6809.asm):05443         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05444         ;        count byte
                      (    forth6809.asm):05445         ;    Outputs:
                      (    forth6809.asm):05446         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05447         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05448         ; ------------------------------------------------------------
E91C                  (    forth6809.asm):05449         DOABORTQUOTE:
E91C 3510             (    forth6809.asm):05450                     PULS  X
E91E E684             (    forth6809.asm):05451                     LDB   ,X
E920 3001             (    forth6809.asm):05452                     LEAX  1,X               ; X = text, B = length
E922 4F               (    forth6809.asm):05453                     CLRA
E923 3720             (    forth6809.asm):05454                     PULU  Y                 ; flag
E925 108C0000         (    forth6809.asm):05455                     CMPY  #0
E929 2605             (    forth6809.asm):05456                     BNE   AQTHROW
E92B 3085             (    forth6809.asm):05457                     LEAX  B,X
E92D 3410             (    forth6809.asm):05458                     PSHS  X
E92F 39               (    forth6809.asm):05459                     RTS
E930 3610             (    forth6809.asm):05460         AQTHROW:    PSHU  X
E932 3606             (    forth6809.asm):05461                     PSHU  D
E934 BDF411           (    forth6809.asm):05462                     JSR   TYPEW
E937 CCFFFE           (    forth6809.asm):05463                     LDD   #-2               ; -2
E93A 3606             (    forth6809.asm):05464                     PSHU  D
E93C 7EE402           (    forth6809.asm):05465                     JMP   THROWW
                      (    forth6809.asm):05466         
                      (    forth6809.asm):05467         ; ------------------------------------------------------------
                      (    forth6809.asm):05468         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05469         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):05470         ; as a counted string. THROW -14 if not compiling.

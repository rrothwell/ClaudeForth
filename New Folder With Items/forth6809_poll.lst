E93F                  (    forth6809.asm):05472         ABORTQUOTEW:
E93F DC00             (    forth6809.asm):05473                     LDD   STATE
E941 2608             (    forth6809.asm):05474                     BNE   AQSTOK
E943 CCFFF2           (    forth6809.asm):05475                     LDD   #-14
E946 3606             (    forth6809.asm):05476                     PSHU  D

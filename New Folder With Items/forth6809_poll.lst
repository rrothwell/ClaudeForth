E28F 53               (    forth6809.asm):04171                     COMB
E290 C30001           (    forth6809.asm):04172                     ADDD  #1
E293 ED42             (    forth6809.asm):04173                     STD   2,U
E295 2407             (    forth6809.asm):04174                     BCC   NQPOS32
E297 ECC4             (    forth6809.asm):04175                     LDD   ,U
E299 C30001           (    forth6809.asm):04176                     ADDD  #1
E29C EDC4             (    forth6809.asm):04177                     STD   ,U
                      (    forth6809.asm):04178         
E29E                  (    forth6809.asm):04179         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):04180                     ; last character was '.' - determines which return convention
E29E AEE4             (    forth6809.asm):04181                     LDX   ,S
E2A0 E684             (    forth6809.asm):04182                     LDB   ,X
E2A2 5A               (    forth6809.asm):04183                     DECB
E2A3 3001             (    forth6809.asm):04184                     LEAX  1,X
E2A5 A685             (    forth6809.asm):04185                     LDA   B,X
E2A7 3263             (    forth6809.asm):04186                     LEAS  3,S

                      (    forth6809.asm):05352         ; ------------------------------------------------------------
                      (    forth6809.asm):05353         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):05354         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):05355         ; compile its xt as a literal followed by a call to COMPILE, so that
                      (    forth6809.asm):05356         ; it is compiled when the enclosing definition runs. THROW -14 if not
                      (    forth6809.asm):05357         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05358         ; ------------------------------------------------------------
E892 DC00             (    forth6809.asm):05359         POSTPONEW:  LDD   STATE
E894 2608             (    forth6809.asm):05360                     BNE   PPSTOK
E896 CCFFF2           (    forth6809.asm):05361                     LDD   #-14              ; -14
E899 3606             (    forth6809.asm):05362                     PSHU  D
E89B BDE402           (    forth6809.asm):05363                     JSR   THROWW
E89E CC0020           (    forth6809.asm):05364         PPSTOK:     LDD   #32
E8A1 3606             (    forth6809.asm):05365                     PSHU  D
E8A3 BDDEB5           (    forth6809.asm):05366                     JSR   WORDW
E8A6 BDDF9E           (    forth6809.asm):05367                     JSR   FINDW
E8A9 3706             (    forth6809.asm):05368                     PULU  D
E8AB 10830000         (    forth6809.asm):05369                     CMPD  #0
E8AF 260A             (    forth6809.asm):05370                     BNE   PPFOUND
E8B1 3706             (    forth6809.asm):05371                     PULU  D
E8B3 CCFFF3           (    forth6809.asm):05372                     LDD   #-13              ; -13
E8B6 3606             (    forth6809.asm):05373                     PSHU  D
E8B8 BDE402           (    forth6809.asm):05374                     JSR   THROWW
E8BB 10830001         (    forth6809.asm):05375         PPFOUND:    CMPD  #1                ; 1 = immediate
E8BF 270C             (    forth6809.asm):05376                     BEQ   PPIMM
E8C1 BDE84A           (    forth6809.asm):05377                     JSR   LITERALW
E8C4 CCE83A           (    forth6809.asm):05378                     LDD   #COMPILECOMMAW
E8C7 3606             (    forth6809.asm):05379                     PSHU  D
E8C9 BDE83D           (    forth6809.asm):05380                     JSR   CCALL
E8CC 39               (    forth6809.asm):05381                     RTS
E8CD BDE83A           (    forth6809.asm):05382         PPIMM:      JSR   COMPILECOMMAW
E8D0 39               (    forth6809.asm):05383                     RTS

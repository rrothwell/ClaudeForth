E821 BDDEB5           (    forth6809.asm):05269                     JSR   WORDW
E824 BDDF9E           (    forth6809.asm):05270                     JSR   FINDW
E827 3706             (    forth6809.asm):05271                     PULU  D                 ; found flag
E829 10830000         (    forth6809.asm):05272                     CMPD  #0
E82D 260A             (    forth6809.asm):05273                     BNE   TICKOK
E82F 3706             (    forth6809.asm):05274                     PULU  D                 ; drop the name
E831 CCFFF3           (    forth6809.asm):05275                     LDD   #-13              ; -13
E834 3606             (    forth6809.asm):05276                     PSHU  D
E836 BDE402           (    forth6809.asm):05277                     JSR   THROWW
E839 39               (    forth6809.asm):05278         TICKOK:     RTS
                      (    forth6809.asm):05279         
                      (    forth6809.asm):05280         ; ------------------------------------------------------------
                      (    forth6809.asm):05281         ; COMPILE,  ( xt -- )
                      (    forth6809.asm):05282         ; Compile a call to xt (see CCALL).
                      (    forth6809.asm):05283         ; ------------------------------------------------------------
E83A                  (    forth6809.asm):05284         COMPILECOMMAW:
E83A 7EE83D           (    forth6809.asm):05285                     JMP   CCALL
                      (    forth6809.asm):05286         
                      (    forth6809.asm):05287         ; ------------------------------------------------------------
                      (    forth6809.asm):05288         ; Append a JSR to xt at the code pointer CODEHERE.
                      (    forth6809.asm):05289         ; CCALL   ( xt -- )
                      (    forth6809.asm):05290         ;    Inputs:
                      (    forth6809.asm):05291         ;        xt on the data stack
                      (    forth6809.asm):05292         ;    Outputs:
                      (    forth6809.asm):05293         ;        JSR xt appended at CODEHERE; CODEHERE advanced by 3
                      (    forth6809.asm):05294         ;    Registers: RegA, RegB, RegD and RegX changed.
                      (    forth6809.asm):05295         ; ------------------------------------------------------------
E83D 9E08             (    forth6809.asm):05296         CCALL:      LDX   CODEHERE          ; X = code pointer
E83F 86BD             (    forth6809.asm):05297                     LDA   #OPJSR            ; JSR opcode
E841 A780             (    forth6809.asm):05298                     STA   ,X+
E843 3706             (    forth6809.asm):05299                     PULU  D                 ; xt
E845 ED81             (    forth6809.asm):05300                     STD   ,X++              ; See bugfix: CCALL.1
E847 9F08             (    forth6809.asm):05301                     STX   CODEHERE
E849 39               (    forth6809.asm):05302                     RTS
                      (    forth6809.asm):05303         
                      (    forth6809.asm):05304         ; ------------------------------------------------------------
                      (    forth6809.asm):05305         ; LITERAL  ( x -- )
                      (    forth6809.asm):05306         ; Compile LIT followed by x, so that x is pushed when the definition
                      (    forth6809.asm):05307         ; runs.
                      (    forth6809.asm):05308         ; ------------------------------------------------------------
E84A CCDA77           (    forth6809.asm):05309         LITERALW:   LDD   #LIT

                      (    forth6809.asm):07377         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07378         ;    Inputs:
                      (    forth6809.asm):07379         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07380         ;        c-addr u on the data stack
                      (    forth6809.asm):07381         ;    Outputs:
                      (    forth6809.asm):07382         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07383         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07384         ; ------------------------------------------------------------
F2AD 3606             (    forth6809.asm):07385         CSTRCOMP:   PSHU  D

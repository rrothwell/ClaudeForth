                      (    forth6809.asm):05771         
                      (    forth6809.asm):05772         ; ------------------------------------------------------------
                      (    forth6809.asm):05773         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05774         ; Copy the top cell pair of the return stack.

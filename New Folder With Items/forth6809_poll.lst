                      (    forth6809.asm):08796         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08797         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08798         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08799         ; the value and true; otherwise return false. WORDLISTS is 8, the
                      (    forth6809.asm):08800         ; number of wordlists that can exist. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08801         ; division.
                      (    forth6809.asm):08802         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08803         ; ------------------------------------------------------------
FAF5 3706             (    forth6809.asm):08804         ENVQW:      PULU  D                 ; u
FAF7 3406             (    forth6809.asm):08805                     PSHS  D                 ; frame: 2,S = u, 0,S = c-addr (5k)
FAF9 3706             (    forth6809.asm):08806                     PULU  D                 ; c-addr
FAFB 3406             (    forth6809.asm):08807                     PSHS  D
FAFD 8EFB96           (    forth6809.asm):08808                     LDX   #ENVTABLE
FB00 EC84             (    forth6809.asm):08809         ENVLOOP:    LDD   ,X
FB02 10830000         (    forth6809.asm):08810                     CMPD  #0
FB06 272D             (    forth6809.asm):08811                     BEQ   ENV2START         ; end of table: try ENVTABLE2
FB08 3410             (    forth6809.asm):08812                     PSHS  X                 ; See bugfix: ENVQW.2 (frame now +2)
FB0A 3606             (    forth6809.asm):08813                     PSHU  D
FB0C EC02             (    forth6809.asm):08814                     LDD   2,X
FB0E 3606             (    forth6809.asm):08815                     PSHU  D
FB10 EC62             (    forth6809.asm):08816                     LDD   2,S               ; c-addr
FB12 3606             (    forth6809.asm):08817                     PSHU  D
FB14 EC64             (    forth6809.asm):08818                     LDD   4,S               ; u
FB16 3606             (    forth6809.asm):08819                     PSHU  D
FB18 BDF541           (    forth6809.asm):08820                     JSR   COMPAREW
FB1B 3510             (    forth6809.asm):08821                     PULS  X                 ; restore X before using it again
FB1D 3706             (    forth6809.asm):08822                     PULU  D
FB1F 10830000         (    forth6809.asm):08823                     CMPD  #0
FB23 2704             (    forth6809.asm):08824                     BEQ   ENVFOUND
FB25 3006             (    forth6809.asm):08825                     LEAX  6,X
FB27 20D7             (    forth6809.asm):08826                     BRA   ENVLOOP

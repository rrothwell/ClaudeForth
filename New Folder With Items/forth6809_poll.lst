                      (    forth6809.asm):04576         ; ------------------------------------------------------------
                      (    forth6809.asm):04577         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04578         ; location.
                      (    forth6809.asm):04579         ; PATCH   ( target location -- )
                      (    forth6809.asm):04580         ;    Inputs:
                      (    forth6809.asm):04581         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04582         ;    Outputs:
                      (    forth6809.asm):04583         ;        the cell at location holds target - location
                      (    forth6809.asm):04584         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04585         ; ------------------------------------------------------------
E437 3710             (    forth6809.asm):04586         PATCH:      PULU  X                 ; location
E439 3706             (    forth6809.asm):04587                     PULU  D                 ; target
E43B 3410             (    forth6809.asm):04588                     PSHS  X
E43D A3E1             (    forth6809.asm):04589                     SUBD  ,S++              ; target - location
E43F ED84             (    forth6809.asm):04590                     STD   ,X
E441 39               (    forth6809.asm):04591                     RTS
                      (    forth6809.asm):04592         
                      (    forth6809.asm):04593         ; ------------------------------------------------------------
                      (    forth6809.asm):04594         ; IF  ( C: -- orig )
                      (    forth6809.asm):04595         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04596         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04597         ; ------------------------------------------------------------
E442 CCDA80           (    forth6809.asm):04598         IFW:        LDD   #ZBRANCH
E445 3606             (    forth6809.asm):04599                     PSHU  D
E447 BDE83D           (    forth6809.asm):04600                     JSR   CCALL
E44A CC0000           (    forth6809.asm):04601                     LDD   #0
E44D 3606             (    forth6809.asm):04602                     PSHU  D
E44F BDDB1D           (    forth6809.asm):04603                     JSR   CODECOMMA
E452 DC08             (    forth6809.asm):04604                     LDD   CODEHERE
E454 830002           (    forth6809.asm):04605                     SUBD  #2
E457 3606             (    forth6809.asm):04606                     PSHU  D                 ; orig
E459 CC0001           (    forth6809.asm):04607                     LDD   #TAGFWD
E45C 3606             (    forth6809.asm):04608                     PSHU  D
E45E 39               (    forth6809.asm):04609                     RTS
                      (    forth6809.asm):04610         
                      (    forth6809.asm):04611         ; ------------------------------------------------------------
                      (    forth6809.asm):04612         ; THEN  ( C: orig -- )
                      (    forth6809.asm):04613         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04614         ; operand to jump to the current code address.
                      (    forth6809.asm):04615         ; ------------------------------------------------------------
E45F 3706             (    forth6809.asm):04616         THENW:      PULU  D
E461 10830001         (    forth6809.asm):04617                     CMPD  #TAGFWD
E465 2703             (    forth6809.asm):04618                     BEQ   THOK
E467 BDE3CD           (    forth6809.asm):04619                     JSR   CFERR
E46A 3710             (    forth6809.asm):04620         THOK:       PULU  X                 ; orig
E46C DC08             (    forth6809.asm):04621                     LDD   CODEHERE
E46E 3606             (    forth6809.asm):04622                     PSHU  D
E470 3610             (    forth6809.asm):04623                     PSHU  X
E472 BDE437           (    forth6809.asm):04624                     JSR   PATCH
E475 39               (    forth6809.asm):04625                     RTS
                      (    forth6809.asm):04626         
                      (    forth6809.asm):04627         ; ------------------------------------------------------------
                      (    forth6809.asm):04628         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):04629         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):04630         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):04631         ; ------------------------------------------------------------
E476 3706             (    forth6809.asm):04632         ELSEW:      PULU  D
E478 10830001         (    forth6809.asm):04633                     CMPD  #TAGFWD
E47C 2703             (    forth6809.asm):04634                     BEQ   ELOK
E47E BDE3CD           (    forth6809.asm):04635                     JSR   CFERR
E481 3706             (    forth6809.asm):04636         ELOK:       PULU  D                 ; orig1
E483 3406             (    forth6809.asm):04637                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E485 CCDA96           (    forth6809.asm):04638                     LDD   #BRANCH
E488 3606             (    forth6809.asm):04639                     PSHU  D
E48A BDE83D           (    forth6809.asm):04640                     JSR   CCALL
E48D CC0000           (    forth6809.asm):04641                     LDD   #0
E490 3606             (    forth6809.asm):04642                     PSHU  D
E492 BDDB1D           (    forth6809.asm):04643                     JSR   CODECOMMA
E495 DC08             (    forth6809.asm):04644                     LDD   CODEHERE
E497 3606             (    forth6809.asm):04645                     PSHU  D
E499 3506             (    forth6809.asm):04646                     PULS  D                 ; orig1
E49B 3606             (    forth6809.asm):04647                     PSHU  D
E49D BDE437           (    forth6809.asm):04648                     JSR   PATCH
E4A0 DC08             (    forth6809.asm):04649                     LDD   CODEHERE
E4A2 830002           (    forth6809.asm):04650                     SUBD  #2
E4A5 3606             (    forth6809.asm):04651                     PSHU  D                 ; orig2
E4A7 CC0001           (    forth6809.asm):04652                     LDD   #TAGFWD
E4AA 3606             (    forth6809.asm):04653                     PSHU  D
E4AC 39               (    forth6809.asm):04654                     RTS
                      (    forth6809.asm):04655         
                      (    forth6809.asm):04656         ; ------------------------------------------------------------
                      (    forth6809.asm):04657         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):04658         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):04659         ; stack.
                      (    forth6809.asm):04660         ; ------------------------------------------------------------
E4AD DC08             (    forth6809.asm):04661         BEGINW:     LDD   CODEHERE
E4AF 3606             (    forth6809.asm):04662                     PSHU  D                 ; dest
E4B1 CC0002           (    forth6809.asm):04663                     LDD   #TAGBACK
E4B4 3606             (    forth6809.asm):04664                     PSHU  D
E4B6 39               (    forth6809.asm):04665                     RTS
                      (    forth6809.asm):04666         
                      (    forth6809.asm):04667         ; ------------------------------------------------------------
                      (    forth6809.asm):04668         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):04669         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):04670         ; ------------------------------------------------------------
E4B7 3706             (    forth6809.asm):04671         UNTILW:     PULU  D
E4B9 10830002         (    forth6809.asm):04672                     CMPD  #TAGBACK
E4BD 2703             (    forth6809.asm):04673                     BEQ   UNOK
E4BF BDE3CD           (    forth6809.asm):04674                     JSR   CFERR
E4C2 3706             (    forth6809.asm):04675         UNOK:       PULU  D                 ; dest
E4C4 3606             (    forth6809.asm):04676                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E4C6 CCDA80           (    forth6809.asm):04677                     LDD   #ZBRANCH
E4C9 3606             (    forth6809.asm):04678                     PSHU  D
E4CB BDE83D           (    forth6809.asm):04679                     JSR   CCALL
E4CE CC0000           (    forth6809.asm):04680                     LDD   #0
E4D1 3606             (    forth6809.asm):04681                     PSHU  D
E4D3 BDDB1D           (    forth6809.asm):04682                     JSR   CODECOMMA
E4D6 DC08             (    forth6809.asm):04683                     LDD   CODEHERE
E4D8 830002           (    forth6809.asm):04684                     SUBD  #2
E4DB 3606             (    forth6809.asm):04685                     PSHU  D                 ; location; the parked dest is beneath
E4DD BDE437           (    forth6809.asm):04686                     JSR   PATCH
E4E0 39               (    forth6809.asm):04687                     RTS
                      (    forth6809.asm):04688         
                      (    forth6809.asm):04689         ; ------------------------------------------------------------
                      (    forth6809.asm):04690         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):04691         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):04692         ; ------------------------------------------------------------
E4E1 3706             (    forth6809.asm):04693         AGAINW:     PULU  D
E4E3 10830002         (    forth6809.asm):04694                     CMPD  #TAGBACK
E4E7 2703             (    forth6809.asm):04695                     BEQ   AGOK
E4E9 BDE3CD           (    forth6809.asm):04696                     JSR   CFERR
E4EC 3706             (    forth6809.asm):04697         AGOK:       PULU  D                 ; dest
E4EE 3606             (    forth6809.asm):04698                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E4F0 CCDA96           (    forth6809.asm):04699                     LDD   #BRANCH
E4F3 3606             (    forth6809.asm):04700                     PSHU  D
E4F5 BDE83D           (    forth6809.asm):04701                     JSR   CCALL
E4F8 CC0000           (    forth6809.asm):04702                     LDD   #0
E4FB 3606             (    forth6809.asm):04703                     PSHU  D
E4FD BDDB1D           (    forth6809.asm):04704                     JSR   CODECOMMA
E500 DC08             (    forth6809.asm):04705                     LDD   CODEHERE
E502 830002           (    forth6809.asm):04706                     SUBD  #2
E505 3606             (    forth6809.asm):04707                     PSHU  D                 ; location; the parked dest is beneath
E507 BDE437           (    forth6809.asm):04708                     JSR   PATCH
E50A 39               (    forth6809.asm):04709                     RTS
                      (    forth6809.asm):04710         
                      (    forth6809.asm):04711         ; ------------------------------------------------------------
                      (    forth6809.asm):04712         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):04713         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):04714         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):04715         ; ------------------------------------------------------------
E50B CCDA80           (    forth6809.asm):04716         WHILEW:     LDD   #ZBRANCH
E50E 3606             (    forth6809.asm):04717                     PSHU  D
E510 BDE83D           (    forth6809.asm):04718                     JSR   CCALL
E513 CC0000           (    forth6809.asm):04719                     LDD   #0
E516 3606             (    forth6809.asm):04720                     PSHU  D
E518 BDDB1D           (    forth6809.asm):04721                     JSR   CODECOMMA
E51B DC08             (    forth6809.asm):04722                     LDD   CODEHERE
E51D 830002           (    forth6809.asm):04723                     SUBD  #2
E520 3606             (    forth6809.asm):04724                     PSHU  D                 ; orig
E522 CC0001           (    forth6809.asm):04725                     LDD   #TAGFWD
E525 3606             (    forth6809.asm):04726                     PSHU  D
E527 39               (    forth6809.asm):04727                     RTS
                      (    forth6809.asm):04728         
                      (    forth6809.asm):04729         ; ------------------------------------------------------------
                      (    forth6809.asm):04730         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04731         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04732         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04733         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04734         ; ------------------------------------------------------------
E528 3706             (    forth6809.asm):04735         REPEATW:    PULU  D
E52A 10830001         (    forth6809.asm):04736                     CMPD  #TAGFWD
E52E 2703             (    forth6809.asm):04737                     BEQ   RPOK1
E530 BDE3CD           (    forth6809.asm):04738                     JSR   CFERR
E533 3710             (    forth6809.asm):04739         RPOK1:      PULU  X                 ; orig
E535 3410             (    forth6809.asm):04740                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04741         
                      (    forth6809.asm):04742                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04743                     ; See bugfix: REPEATW.1
E537 3040             (    forth6809.asm):04744                     LEAX  0,U               ; scan from top of control stack
E539 9F16             (    forth6809.asm):04745                     STX   MSCR2             ; MSCR2 = base of scan region
E53B 9F1A             (    forth6809.asm):04746                     STX   MSCR4             ; MSCR4 = scan pointer
E53D DC1A             (    forth6809.asm):04747         RPSCAN:     LDD   MSCR4
E53F 109321           (    forth6809.asm):04748                     CMPD  CSP
E542 2603             (    forth6809.asm):04749                     BNE   RPSCANOK
E544 BDE3CD           (    forth6809.asm):04750                     JSR   CFERR             ; no matching BEGIN
E547 9E1A             (    forth6809.asm):04751         RPSCANOK:   LDX   MSCR4
E549 EC84             (    forth6809.asm):04752                     LDD   ,X
E54B 10830002         (    forth6809.asm):04753                     CMPD  #TAGBACK
E54F 2712             (    forth6809.asm):04754                     BEQ   RPFOUND
E551 10830001         (    forth6809.asm):04755                     CMPD  #TAGFWD
E555 2703             (    forth6809.asm):04756                     BEQ   RPSKIP
E557 BDE3CD           (    forth6809.asm):04757                     JSR   CFERR             ; anything else is a genuine mismatch
E55A DC1A             (    forth6809.asm):04758         RPSKIP:     LDD   MSCR4
E55C C30004           (    forth6809.asm):04759                     ADDD  #4
E55F DD1A             (    forth6809.asm):04760                     STD   MSCR4
E561 20DA             (    forth6809.asm):04761                     BRA   RPSCAN
E563 9E1A             (    forth6809.asm):04762         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E565 EC02             (    forth6809.asm):04763                     LDD   2,X               ; dest = BEGIN's address
E567 3406             (    forth6809.asm):04764                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04765         
                      (    forth6809.asm):04766                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04767                     ; bytes, highest word first.
E569 DC1A             (    forth6809.asm):04768                     LDD   MSCR4
E56B 9316             (    forth6809.asm):04769                     SUBD  MSCR2
E56D DD18             (    forth6809.asm):04770                     STD   MSCR3             ; MSCR3 = bytes to shift
E56F 2715             (    forth6809.asm):04771                     BEQ   RPSHIFTDONE
E571 DC18             (    forth6809.asm):04772         RPSHIFT:    LDD   MSCR3
E573 830002           (    forth6809.asm):04773                     SUBD  #2
E576 DD18             (    forth6809.asm):04774                     STD   MSCR3
E578 9E16             (    forth6809.asm):04775                     LDX   MSCR2
E57A 308B             (    forth6809.asm):04776                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E57C EC84             (    forth6809.asm):04777                     LDD   ,X
E57E 3004             (    forth6809.asm):04778                     LEAX  4,X
E580 ED84             (    forth6809.asm):04779                     STD   ,X                ; copy one word 4 bytes higher
E582 DC18             (    forth6809.asm):04780                     LDD   MSCR3
E584 26EB             (    forth6809.asm):04781                     BNE   RPSHIFT
E586                  (    forth6809.asm):04782         RPSHIFTDONE:
E586 9E16             (    forth6809.asm):04783                     LDX   MSCR2
E588 3004             (    forth6809.asm):04784                     LEAX  4,X
E58A 1F13             (    forth6809.asm):04785                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04786         
E58C CCDA96           (    forth6809.asm):04787                     LDD   #BRANCH
E58F 3606             (    forth6809.asm):04788                     PSHU  D
E591 BDE83D           (    forth6809.asm):04789                     JSR   CCALL
E594 CC0000           (    forth6809.asm):04790                     LDD   #0
E597 3606             (    forth6809.asm):04791                     PSHU  D
E599 BDDB1D           (    forth6809.asm):04792                     JSR   CODECOMMA
E59C EC60             (    forth6809.asm):04793                     LDD   0,S               ; target = BEGIN's address
E59E 3606             (    forth6809.asm):04794                     PSHU  D
E5A0 DC08             (    forth6809.asm):04795                     LDD   CODEHERE
E5A2 830002           (    forth6809.asm):04796                     SUBD  #2                ; location = the operand just compiled
E5A5 3606             (    forth6809.asm):04797                     PSHU  D
E5A7 BDE437           (    forth6809.asm):04798                     JSR   PATCH
E5AA DC08             (    forth6809.asm):04799                     LDD   CODEHERE
E5AC 3606             (    forth6809.asm):04800                     PSHU  D
E5AE EC62             (    forth6809.asm):04801                     LDD   2,S               ; orig
E5B0 3606             (    forth6809.asm):04802                     PSHU  D
E5B2 BDE437           (    forth6809.asm):04803                     JSR   PATCH
E5B5 3264             (    forth6809.asm):04804                     LEAS  4,S               ; drop the frame
E5B7 39               (    forth6809.asm):04805                     RTS
                      (    forth6809.asm):04806         
                      (    forth6809.asm):04807         ; ------------------------------------------------------------
                      (    forth6809.asm):04808         ; RECURSE  ( -- )
                      (    forth6809.asm):04809         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):04810         ; the xt held in CURXT.
                      (    forth6809.asm):04811         ; ------------------------------------------------------------
E5B8 DC1F             (    forth6809.asm):04812         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E5BA 3606             (    forth6809.asm):04813                     PSHU  D                 ; See bugfix: RECURSEW.1
E5BC BDE83D           (    forth6809.asm):04814                     JSR   CCALL
E5BF 39               (    forth6809.asm):04815                     RTS
                      (    forth6809.asm):04816         
                      (    forth6809.asm):04817         ; ------------------------------------------------------------
                      (    forth6809.asm):04818         ; DO  ( C: -- dest )
                      (    forth6809.asm):04819         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04820         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04821         ; ------------------------------------------------------------
E5C0 CCE5D2           (    forth6809.asm):04822         DOW:        LDD   #DOSETUP
E5C3 3606             (    forth6809.asm):04823                     PSHU  D
E5C5 BDE83D           (    forth6809.asm):04824                     JSR   CCALL
E5C8 DC08             (    forth6809.asm):04825                     LDD   CODEHERE
E5CA 3606             (    forth6809.asm):04826                     PSHU  D                 ; dest
E5CC CC0003           (    forth6809.asm):04827                     LDD   #TAGDO
E5CF 3606             (    forth6809.asm):04828                     PSHU  D
E5D1 39               (    forth6809.asm):04829                     RTS
                      (    forth6809.asm):04830         
                      (    forth6809.asm):04831         ; ------------------------------------------------------------
                      (    forth6809.asm):04832         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04833         ; return address.
                      (    forth6809.asm):04834         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04835         ;    Inputs:
                      (    forth6809.asm):04836         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04837         ;    Outputs:
                      (    forth6809.asm):04838         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04839         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04840         ; ------------------------------------------------------------
E5D2 3706             (    forth6809.asm):04841         DOSETUP:    PULU  D                 ; index
E5D4 DD14             (    forth6809.asm):04842                     STD   MSCR
E5D6 3706             (    forth6809.asm):04843                     PULU  D                 ; limit
E5D8 DD16             (    forth6809.asm):04844                     STD   MSCR2
E5DA 3510             (    forth6809.asm):04845                     PULS  X
E5DC CC0000           (    forth6809.asm):04846                     LDD   #0
E5DF 3406             (    forth6809.asm):04847                     PSHS  D
E5E1 DC16             (    forth6809.asm):04848                     LDD   MSCR2
E5E3 3406             (    forth6809.asm):04849                     PSHS  D
E5E5 DC14             (    forth6809.asm):04850                     LDD   MSCR
E5E7 3406             (    forth6809.asm):04851                     PSHS  D
E5E9 3410             (    forth6809.asm):04852                     PSHS  X
E5EB 39               (    forth6809.asm):04853                     RTS
                      (    forth6809.asm):04854         
                      (    forth6809.asm):04855         ; ------------------------------------------------------------
                      (    forth6809.asm):04856         ; I  ( -- n )
                      (    forth6809.asm):04857         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04858         ; address).
                      (    forth6809.asm):04859         ; ------------------------------------------------------------
E5EC EC62             (    forth6809.asm):04860         IW:         LDD   2,S               ; n. See bugfix: IW.1
E5EE 3606             (    forth6809.asm):04861                     PSHU  D
E5F0 39               (    forth6809.asm):04862                     RTS
                      (    forth6809.asm):04863         
                      (    forth6809.asm):04864         ; ------------------------------------------------------------
                      (    forth6809.asm):04865         ; J  ( -- n )
                      (    forth6809.asm):04866         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04867         ; address and the inner loop frame).
                      (    forth6809.asm):04868         ; ------------------------------------------------------------
E5F1 EC68             (    forth6809.asm):04869         JW:         LDD   8,S               ; n. See bugfix: JW.1
E5F3 3606             (    forth6809.asm):04870                     PSHU  D
E5F5 39               (    forth6809.asm):04871                     RTS
                      (    forth6809.asm):04872         
                      (    forth6809.asm):04873         ; ------------------------------------------------------------
                      (    forth6809.asm):04874         ; LEAVE  ( -- )
                      (    forth6809.asm):04875         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04876         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04877         ; ------------------------------------------------------------
E5F6 CCFFFF           (    forth6809.asm):04878         LEAVEW:     LDD   #TRUEV            ; true
E5F9 ED66             (    forth6809.asm):04879                     STD   6,S               ; See bugfix: LEAVEW.1
E5FB 39               (    forth6809.asm):04880                     RTS
                      (    forth6809.asm):04881         
                      (    forth6809.asm):04882         ; ------------------------------------------------------------
                      (    forth6809.asm):04883         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04884         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04885         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04886         ; ------------------------------------------------------------
E5FC 3706             (    forth6809.asm):04887         LOOPW:      PULU  D
E5FE 10830003         (    forth6809.asm):04888                     CMPD  #TAGDO
E602 2703             (    forth6809.asm):04889                     BEQ   LOOPOK
E604 BDE3CD           (    forth6809.asm):04890                     JSR   CFERR
E607 3706             (    forth6809.asm):04891         LOOPOK:     PULU  D                 ; dest
E609 3606             (    forth6809.asm):04892                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E60B CCE63B           (    forth6809.asm):04893                     LDD   #DOTEST
E60E 3606             (    forth6809.asm):04894                     PSHU  D
E610 BDE83D           (    forth6809.asm):04895                     JSR   CCALL
E613 CC0000           (    forth6809.asm):04896                     LDD   #0
E616 3606             (    forth6809.asm):04897                     PSHU  D
E618 BDDB1D           (    forth6809.asm):04898                     JSR   CODECOMMA
E61B DC08             (    forth6809.asm):04899                     LDD   CODEHERE
E61D 830002           (    forth6809.asm):04900                     SUBD  #2
E620 3606             (    forth6809.asm):04901                     PSHU  D                 ; location; the parked dest is beneath
E622 BDE437           (    forth6809.asm):04902                     JSR   PATCH
                      (    forth6809.asm):04903         
E625 ECC4             (    forth6809.asm):04904                     LDD   ,U

FB71 3264             (    forth6809.asm):08863                     LEAS  4,S               ; drop frame
FB73 CC0000           (    forth6809.asm):08864                     LDD   #FALSEV
FB76 3606             (    forth6809.asm):08865                     PSHU  D
FB78 39               (    forth6809.asm):08866                     RTS

                      (    forth6809.asm):05745         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05746         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05747         ; return address of this call is on top of S, so it is lifted off and

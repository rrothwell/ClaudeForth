                      (    forth6809.asm):05029         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05030         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05031         ; ------------------------------------------------------------
E6DA CCE700           (    forth6809.asm):05032         QDOW:       LDD   #QDOSETUP

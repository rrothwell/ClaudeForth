DFF8 2509             (    forth6809.asm):03663                     BCS   WIDBAD
DFFA C501             (    forth6809.asm):03664                     BITB  #1
DFFC 2605             (    forth6809.asm):03665                     BNE   WIDBAD
DFFE 9C45             (    forth6809.asm):03666                     CMPX  WLEND
E000 2401             (    forth6809.asm):03667                     BHS   WIDBAD
E002 39               (    forth6809.asm):03668                     RTS
E003 CCFFF5           (    forth6809.asm):03669         WIDBAD:     LDD   #-11
E006 3606             (    forth6809.asm):03670                     PSHU  D
E008 7EE402           (    forth6809.asm):03671                     JMP   THROWW

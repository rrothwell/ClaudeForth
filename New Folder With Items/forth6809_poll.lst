                      (    forth6809.asm):04108         ; ------------------------------------------------------------
                      (    forth6809.asm):04109         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04110         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04111         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04112         ;    Inputs:
                      (    forth6809.asm):04113         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04114         ;    Outputs:
                      (    forth6809.asm):04115         ;        single number: n and -1
                      (    forth6809.asm):04116         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04117         ;        not a number: c-addr and 0
                      (    forth6809.asm):04118         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04119         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04120         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04121         ; NUMBERQ.6.
                      (    forth6809.asm):04122         ; ------------------------------------------------------------
E246 3710             (    forth6809.asm):04123         NUMBERQ:    PULU  X                 ; c-addr
E248 327D             (    forth6809.asm):04124                     LEAS  -3,S
E24A AFE4             (    forth6809.asm):04125                     STX   ,S
E24C E684             (    forth6809.asm):04126                     LDB   ,X
E24E 276D             (    forth6809.asm):04127                     BEQ   NQBAD
E250 3001             (    forth6809.asm):04128                     LEAX  1,X
                      (    forth6809.asm):04129         
                      (    forth6809.asm):04130                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04131                     ; digit count. See shadow: NUMBERQ.1
E252 5A               (    forth6809.asm):04132                     DECB
E253 A685             (    forth6809.asm):04133                     LDA   B,X
E255 5C               (    forth6809.asm):04134                     INCB
E256 812E             (    forth6809.asm):04135                     CMPA  #'.'
E258 2603             (    forth6809.asm):04136                     BNE   NQNOSIGN
E25A 5A               (    forth6809.asm):04137                     DECB
E25B 2760             (    forth6809.asm):04138                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04139         
E25D 6F62             (    forth6809.asm):04140         NQNOSIGN:   CLR   2,S
E25F A684             (    forth6809.asm):04141                     LDA   ,X
E261 812D             (    forth6809.asm):04142                     CMPA  #'-'
E263 2607             (    forth6809.asm):04143                     BNE   NQNOSIGN2
E265 6362             (    forth6809.asm):04144                     COM   2,S
E267 3001             (    forth6809.asm):04145                     LEAX  1,X
E269 5A               (    forth6809.asm):04146                     DECB
E26A 2751             (    forth6809.asm):04147                     BEQ   NQBAD
                      (    forth6809.asm):04148         
E26C 108E0000         (    forth6809.asm):04149         NQNOSIGN2:  LDY   #0
E270 3620             (    forth6809.asm):04150                     PSHU  Y                 ; ud low
E272 3620             (    forth6809.asm):04151                     PSHU  Y                 ; ud high
E274 3610             (    forth6809.asm):04152                     PSHU  X                 ; c-addr
E276 4F               (    forth6809.asm):04153                     CLRA
E277 3606             (    forth6809.asm):04154                     PSHU  D                 ; u
                      (    forth6809.asm):04155         
E279 BDE20D           (    forth6809.asm):04156                     JSR   NUMLOOP
                      (    forth6809.asm):04157         
E27C ECC4             (    forth6809.asm):04158                     LDD   ,U
E27E 263B             (    forth6809.asm):04159                     BNE   NQBADF            ; unconverted characters remain
E280 3344             (    forth6809.asm):04160                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):04161         

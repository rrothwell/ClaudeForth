                      (    forth6809.asm):03578         ; ------------------------------------------------------------
                      (    forth6809.asm):03579         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03580         ; HDRXT
                      (    forth6809.asm):03581         ;    Inputs:
                      (    forth6809.asm):03582         ;        RegX = header
                      (    forth6809.asm):03583         ;    Outputs:
                      (    forth6809.asm):03584         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03585         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03586         ; ------------------------------------------------------------
DF92 A684             (    forth6809.asm):03587         HDRXT:      LDA   ,X
DF94 1F89             (    forth6809.asm):03588                     TFR   A,B
DF96 C41F             (    forth6809.asm):03589                     ANDB  #$1F
DF98 3001             (    forth6809.asm):03590                     LEAX  1,X
DF9A 3A               (    forth6809.asm):03591                     ABX
DF9B AE02             (    forth6809.asm):03592                     LDX   2,X               ; CFA field
DF9D 39               (    forth6809.asm):03593                     RTS
                      (    forth6809.asm):03594         
                      (    forth6809.asm):03595         ; ------------------------------------------------------------
                      (    forth6809.asm):03596         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03597         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03598         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03599         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03600         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03601         ; ------------------------------------------------------------
DF9E 10AEC4           (    forth6809.asm):03602         FINDW:      LDY   ,U                ; counted string
DFA1 E6A0             (    forth6809.asm):03603                     LDB   ,Y+
DFA3 8DBF             (    forth6809.asm):03604                     BSR   SRCHORD
DFA5 8C0000           (    forth6809.asm):03605                     CMPX  #0
DFA8 2712             (    forth6809.asm):03606                     BEQ   NOTFOUND
DFAA 8DE6             (    forth6809.asm):03607                     BSR   HDRXT
DFAC AFC4             (    forth6809.asm):03608                     STX   ,U                ; xt replaces c-addr
DFAE 4D               (    forth6809.asm):03609                     TSTA
DFAF 2A05             (    forth6809.asm):03610                     BPL   FISNORM
DFB1 CC0001           (    forth6809.asm):03611                     LDD   #1
DFB4 2003             (    forth6809.asm):03612                     BRA   FPUSH
DFB6 CCFFFF           (    forth6809.asm):03613         FISNORM:    LDD   #-1
DFB9 3606             (    forth6809.asm):03614         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
DFBB 39               (    forth6809.asm):03615                     RTS
                      (    forth6809.asm):03616         
DFBC CC0000           (    forth6809.asm):03617         NOTFOUND:   LDD   #0
DFBF 3606             (    forth6809.asm):03618                     PSHU  D                 ; 0 = not found, c-addr still beneath
DFC1 39               (    forth6809.asm):03619                     RTS
                      (    forth6809.asm):03620         
                      (    forth6809.asm):03621         ; ------------------------------------------------------------
                      (    forth6809.asm):03622         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03623         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03624         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03625         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03626         ; ------------------------------------------------------------
DFC2 3710             (    forth6809.asm):03627         SEARCHWLW:  PULU  X                 ; wid
DFC4 8D2D             (    forth6809.asm):03628                     BSR   WIDCHK
DFC6 AE84             (    forth6809.asm):03629                     LDX   ,X                ; newest header of the wordlist
DFC8 3706             (    forth6809.asm):03630                     PULU  D                 ; u
DFCA 3720             (    forth6809.asm):03631                     PULU  Y                 ; c-addr
DFCC 4D               (    forth6809.asm):03632                     TSTA
DFCD 261E             (    forth6809.asm):03633                     BNE   SWNOT             ; longer than any name
DFCF C11F             (    forth6809.asm):03634                     CMPB  #31
DFD1 221A             (    forth6809.asm):03635                     BHI   SWNOT
DFD3 BDDF27           (    forth6809.asm):03636                     JSR   FDSEARCH
DFD6 8C0000           (    forth6809.asm):03637                     CMPX  #0
DFD9 2712             (    forth6809.asm):03638                     BEQ   SWNOT
DFDB 8DB5             (    forth6809.asm):03639                     BSR   HDRXT
DFDD 3610             (    forth6809.asm):03640                     PSHU  X                 ; xt
DFDF 4D               (    forth6809.asm):03641                     TSTA
DFE0 2A05             (    forth6809.asm):03642                     BPL   SWNORM
DFE2 CC0001           (    forth6809.asm):03643                     LDD   #1
DFE5 2003             (    forth6809.asm):03644                     BRA   SWPUSH
DFE7 CCFFFF           (    forth6809.asm):03645         SWNORM:     LDD   #-1
DFEA 3606             (    forth6809.asm):03646         SWPUSH:     PSHU  D
DFEC 39               (    forth6809.asm):03647                     RTS
DFED CC0000           (    forth6809.asm):03648         SWNOT:      LDD   #0
DFF0 3606             (    forth6809.asm):03649                     PSHU  D

                      (    forth6809.asm):03732         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03733         ; ============================================================
                      (    forth6809.asm):03734         ; ------------------------------------------------------------
                      (    forth6809.asm):03735         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03736         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03737         ; ------------------------------------------------------------
E059 9E45             (    forth6809.asm):03738         WORDLISTW:  LDX   WLEND
E05B 8C006F           (    forth6809.asm):03739                     CMPX  #WLHEADS+2*WLCELLS
E05E 240F             (    forth6809.asm):03740                     BHS   WLFULL
E060 CC0000           (    forth6809.asm):03741                     LDD   #0
E063 ED84             (    forth6809.asm):03742                     STD   ,X
E065 ED8814           (    forth6809.asm):03743                     STD   WLNOFF,X
E068 3610             (    forth6809.asm):03744                     PSHU  X
E06A 3002             (    forth6809.asm):03745                     LEAX  2,X
E06C 9F45             (    forth6809.asm):03746                     STX   WLEND
E06E 39               (    forth6809.asm):03747                     RTS
E06F CCFFF8           (    forth6809.asm):03748         WLFULL:     LDD   #-8
E072 3606             (    forth6809.asm):03749                     PSHU  D
E074 7EE402           (    forth6809.asm):03750                     JMP   THROWW

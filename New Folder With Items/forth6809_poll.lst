                      (    forth6809.asm):05083         ; UNLOOP  ( -- )
                      (    forth6809.asm):05084         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05085         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05086         ; ------------------------------------------------------------
E72A 3510             (    forth6809.asm):05087         UNLOOPW:    PULS  X

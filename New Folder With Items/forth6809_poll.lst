E223 8141             (    forth6809.asm):04090                     CMPA  #'A'
E225 251E             (    forth6809.asm):04091                     BLO   NLDONE
E227 815A             (    forth6809.asm):04092                     CMPA  #'Z'
E229 221A             (    forth6809.asm):04093                     BHI   NLDONE
E22B 8037             (    forth6809.asm):04094                     SUBA  #'A'-10
E22D 9103             (    forth6809.asm):04095         NLGOT:      CMPA  BASE+1
E22F 2414             (    forth6809.asm):04096                     BHS   NLDONE

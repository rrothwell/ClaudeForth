                      (    forth6809.asm):08300         ; ------------------------------------------------------------
                      (    forth6809.asm):08301         ; <#  ( -- )
                      (    forth6809.asm):08302         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):08303         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):08304         ; ------------------------------------------------------------

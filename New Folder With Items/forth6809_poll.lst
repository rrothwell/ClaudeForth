DC8E DC0A             (    forth6809.asm):03098                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DC90 3606             (    forth6809.asm):03099                     PSHU  D
DC92 BDDB1D           (    forth6809.asm):03100                     JSR   CODECOMMA
DC95 BDDB2F           (    forth6809.asm):03101                     JSR   VCOMMAW           ; x2 at the lower address
DC98 BDDB2F           (    forth6809.asm):03102                     JSR   VCOMMAW           ; then x1
DC9B 39               (    forth6809.asm):03103                     RTS
                      (    forth6809.asm):03104         

                      (    forth6809.asm):09134         ; ------------------------------------------------------------
                      (    forth6809.asm):09135         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09136         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09137         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09138         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09139         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09140         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09141         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09142         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09143         ; available the skip ends.
                      (    forth6809.asm):09144         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09145         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09146         ; ------------------------------------------------------------
FDAD 3706             (    forth6809.asm):09147         BRIFW:      PULU  D
FDAF 10830000         (    forth6809.asm):09148                     CMPD  #0
FDB3 266D             (    forth6809.asm):09149                     BNE   BRTHENW           ; true: nothing to skip
FDB5 CC0001           (    forth6809.asm):09150         BRELSEW:    LDD   #1
FDB8 3406             (    forth6809.asm):09151                     PSHS  D                 ; level
FDBA BDF4B4           (    forth6809.asm):09152         BRNEXT:     JSR   PARSENAMEW
FDBD 3706             (    forth6809.asm):09153                     PULU  D                 ; length
FDBF 3710             (    forth6809.asm):09154                     PULU  X                 ; address
FDC1 10830000         (    forth6809.asm):09155                     CMPD  #0
FDC5 274E             (    forth6809.asm):09156                     BEQ   BRREFILL
FDC7 10830004         (    forth6809.asm):09157                     CMPD  #4
FDCB 2734             (    forth6809.asm):09158                     BEQ   BR4
FDCD 10830006         (    forth6809.asm):09159                     CMPD  #6
FDD1 26E7             (    forth6809.asm):09160                     BNE   BRNEXT
FDD3 C606             (    forth6809.asm):09161                     LDB   #6
FDD5 108EFE31         (    forth6809.asm):09162                     LDY   #BRSELSE
FDD9 3410             (    forth6809.asm):09163                     PSHS  X
FDDB BDFE23           (    forth6809.asm):09164                     JSR   BRCMP
FDDE 3510             (    forth6809.asm):09165                     PULS  X
FDE0 2609             (    forth6809.asm):09166                     BNE   BR6B
FDE2 ECE4             (    forth6809.asm):09167                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FDE4 830001           (    forth6809.asm):09168                     SUBD  #1
FDE7 2737             (    forth6809.asm):09169                     BEQ   BRDONE
FDE9 20CF             (    forth6809.asm):09170                     BRA   BRNEXT
FDEB C606             (    forth6809.asm):09171         BR6B:       LDB   #6
FDED 108EFE37         (    forth6809.asm):09172                     LDY   #BRSTHEN
FDF1 BDFE23           (    forth6809.asm):09173                     JSR   BRCMP
FDF4 26C4             (    forth6809.asm):09174                     BNE   BRNEXT
FDF6 ECE4             (    forth6809.asm):09175                     LDD   ,S                ; [THEN]: one level less
FDF8 830001           (    forth6809.asm):09176                     SUBD  #1
FDFB EDE4             (    forth6809.asm):09177                     STD   ,S
FDFD 2721             (    forth6809.asm):09178                     BEQ   BRDONE
FDFF 20B9             (    forth6809.asm):09179                     BRA   BRNEXT
FE01 C604             (    forth6809.asm):09180         BR4:        LDB   #4
FE03 108EFE2D         (    forth6809.asm):09181                     LDY   #BRSIF
FE07 BDFE23           (    forth6809.asm):09182                     JSR   BRCMP
FE0A 26AE             (    forth6809.asm):09183                     BNE   BRNEXT
FE0C ECE4             (    forth6809.asm):09184                     LDD   ,S                ; [IF]: one level more

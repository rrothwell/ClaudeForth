                      (    forth6809.asm):04978         
                      (    forth6809.asm):04979         ; ------------------------------------------------------------
                      (    forth6809.asm):04980         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04981         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04982         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04983         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04984         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04985         ;    Inputs:
                      (    forth6809.asm):04986         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04987         ;    Outputs:
                      (    forth6809.asm):04988         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04989         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04990         ;        scratch.
                      (    forth6809.asm):04991         ; ------------------------------------------------------------
E69C 3706             (    forth6809.asm):04992         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E69E DD14             (    forth6809.asm):04993                     STD   MSCR              ; MSCR = step
E6A0 EC66             (    forth6809.asm):04994                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E6A2 262D             (    forth6809.asm):04995                     BNE   DPTEXIT           ; set: exit
E6A4 EC62             (    forth6809.asm):04996                     LDD   2,S               ; old index
E6A6 A364             (    forth6809.asm):04997                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E6A8 DD16             (    forth6809.asm):04998                     STD   MSCR2
E6AA EC62             (    forth6809.asm):04999                     LDD   2,S
E6AC D314             (    forth6809.asm):05000                     ADDD  MSCR              ; new_index = old_index + step
E6AE ED62             (    forth6809.asm):05001                     STD   2,S
E6B0 A364             (    forth6809.asm):05002                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E6B2 DD18             (    forth6809.asm):05003                     STD   MSCR3
                      (    forth6809.asm):05004                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05005                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05006                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E6B4 DC14             (    forth6809.asm):05007                     LDD   MSCR              ; reload the step to test its sign
E6B6 2B09             (    forth6809.asm):05008                     BMI   DPNEG
E6B8 DC18             (    forth6809.asm):05009         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E6BA 109316           (    forth6809.asm):05010                     CMPD  MSCR2
E6BD 2512             (    forth6809.asm):05011                     BLO   DPTEXIT
E6BF 2007             (    forth6809.asm):05012                     BRA   DPCONT
E6C1 DC18             (    forth6809.asm):05013         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E6C3 109316           (    forth6809.asm):05014                     CMPD  MSCR2
E6C6 2209             (    forth6809.asm):05015                     BHI   DPTEXIT
E6C8 3510             (    forth6809.asm):05016         DPCONT:     PULS  X                 ; X = branch operand address
E6CA EC84             (    forth6809.asm):05017                     LDD   ,X
E6CC 308B             (    forth6809.asm):05018                     LEAX  D,X
E6CE 3410             (    forth6809.asm):05019                     PSHS  X
E6D0 39               (    forth6809.asm):05020                     RTS
E6D1 3510             (    forth6809.asm):05021         DPTEXIT:    PULS  X
E6D3 3002             (    forth6809.asm):05022                     LEAX  2,X               ; skip the branch operand
E6D5 3266             (    forth6809.asm):05023                     LEAS  6,S               ; discard the loop frame
E6D7 3410             (    forth6809.asm):05024                     PSHS  X
E6D9 39               (    forth6809.asm):05025                     RTS
                      (    forth6809.asm):05026         

                      (    forth6809.asm):03755         ; ------------------------------------------------------------
E077 CC005B           (    forth6809.asm):03756         FORTHWLW:   LDD   #WLHEADS
E07A 3606             (    forth6809.asm):03757                     PSHU  D
E07C 39               (    forth6809.asm):03758                     RTS
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03762         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03763         ; it, as it is always searched last.
                      (    forth6809.asm):03764         ; ------------------------------------------------------------
E07D 9E49             (    forth6809.asm):03765         GETORDERW:  LDX   ORDEND

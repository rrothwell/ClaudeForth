                      (    forth6809.asm):08868         ; ------------------------------------------------------------
                      (    forth6809.asm):08869         ; ENVTABLE2
                      (    forth6809.asm):08870         ; Double-cell ENVIRONMENT? entries: name address, name length, low
                      (    forth6809.asm):08871         ; cell, high cell. A zero ends the table.
                      (    forth6809.asm):08872         ; ------------------------------------------------------------
FB79                  (    forth6809.asm):08873         ENVTABLE2:

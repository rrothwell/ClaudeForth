                      (    forth6809.asm):09209         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):09210         ; ============================================================
                      (    forth6809.asm):09211         ; ------------------------------------------------------------
                      (    forth6809.asm):09212         ; TRUE  ( -- flag )
                      (    forth6809.asm):09213         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09214         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):09215         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):09216         ; ------------------------------------------------------------
FE3D CCFFFF           (    forth6809.asm):09217         TRUEW:      LDD   #$FFFF
FE40 3606             (    forth6809.asm):09218                     PSHU  D
FE42 39               (    forth6809.asm):09219                     RTS
                      (    forth6809.asm):09220         
                      (    forth6809.asm):09221         ; ------------------------------------------------------------
                      (    forth6809.asm):09222         ; FALSE  ( -- flag )
                      (    forth6809.asm):09223         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):09224         ; ------------------------------------------------------------
FE43 CC0000           (    forth6809.asm):09225         FALSEW:     LDD   #$0000
FE46 3606             (    forth6809.asm):09226                     PSHU  D
FE48 39               (    forth6809.asm):09227                     RTS
                      (    forth6809.asm):09228         
                      (    forth6809.asm):09229         ; ------------------------------------------------------------
                      (    forth6809.asm):09230         ; 1  ( -- 1 )
                      (    forth6809.asm):09231         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):09232         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):09233         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):09234         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):09235         ; ------------------------------------------------------------
FE49 CC0001           (    forth6809.asm):09236         POSONEW:    LDD   #1
FE4C 3606             (    forth6809.asm):09237                     PSHU  D
FE4E 39               (    forth6809.asm):09238                     RTS
                      (    forth6809.asm):09239         
                      (    forth6809.asm):09240         ; ------------------------------------------------------------
                      (    forth6809.asm):09241         ; -1  ( -- -1 )
                      (    forth6809.asm):09242         ; Push the constant -1.
                      (    forth6809.asm):09243         ; ------------------------------------------------------------
FE4F CCFFFF           (    forth6809.asm):09244         NEGONEW:    LDD   #-1
FE52 3606             (    forth6809.asm):09245                     PSHU  D
FE54 39               (    forth6809.asm):09246                     RTS
                      (    forth6809.asm):09247         
                      (    forth6809.asm):09248         ; ------------------------------------------------------------
                      (    forth6809.asm):09249         ; 2  ( -- 2 )
                      (    forth6809.asm):09250         ; Push the constant 2.
                      (    forth6809.asm):09251         ; ------------------------------------------------------------
FE55 CC0002           (    forth6809.asm):09252         POSTWOW:    LDD   #2
FE58 3606             (    forth6809.asm):09253                     PSHU  D
FE5A 39               (    forth6809.asm):09254                     RTS
                      (    forth6809.asm):09255         
                      (    forth6809.asm):09256         ; ------------------------------------------------------------
                      (    forth6809.asm):09257         ; -2  ( -- -2 )
                      (    forth6809.asm):09258         ; Push the constant -2.
                      (    forth6809.asm):09259         ; ------------------------------------------------------------
FE5B CCFFFE           (    forth6809.asm):09260         NEGTWOW:    LDD   #-2
FE5E 3606             (    forth6809.asm):09261                     PSHU  D
FE60 39               (    forth6809.asm):09262                     RTS
                      (    forth6809.asm):09263         
                      (    forth6809.asm):09264         ; Verify no collision with init code,
                      (    forth6809.asm):09265         ; value should match ORG INITCODE.
     FE61             (    forth6809.asm):09266         BASECODEEND EQU   *
     250F             (    forth6809.asm):09267         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):09268         

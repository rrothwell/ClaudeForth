                      (    forth6809.asm):07866         ; otherwise return the original string and false.
                      (    forth6809.asm):07867         ; ------------------------------------------------------------
F581 335A             (    forth6809.asm):07868         SEARCHW:    LEAU  -6,U              ; locals: 0,U candidate address, 2,U positions
F583 EC46             (    forth6809.asm):07869                     LDD   6,U               ; left, 4,U end of the needle.  Then u2 at 6,
F585 2606             (    forth6809.asm):07870                     BNE   SRCHNZ            ; c-addr2 at 8, u1 at 10, c-addr1 at 12

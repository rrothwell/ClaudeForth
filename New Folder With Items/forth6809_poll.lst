E6EA DC08             (    forth6809.asm):05038                     LDD   CODEHERE
E6EC 830002           (    forth6809.asm):05039                     SUBD  #2
E6EF 3606             (    forth6809.asm):05040                     PSHU  D                 ; orig
E6F1 CC0007           (    forth6809.asm):05041                     LDD   #TAGQDO           ; See bugfix: QDOW.1
E6F4 3606             (    forth6809.asm):05042                     PSHU  D
E6F6 DC08             (    forth6809.asm):05043                     LDD   CODEHERE
E6F8 3606             (    forth6809.asm):05044                     PSHU  D                 ; dest
E6FA CC0003           (    forth6809.asm):05045                     LDD   #TAGDO
E6FD 3606             (    forth6809.asm):05046                     PSHU  D
E6FF 39               (    forth6809.asm):05047                     RTS
                      (    forth6809.asm):05048         
                      (    forth6809.asm):05049         ; ------------------------------------------------------------
                      (    forth6809.asm):05050         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05051         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05052         ; branch operand.
                      (    forth6809.asm):05053         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05054         ;    Inputs:
                      (    forth6809.asm):05055         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05056         ;    Outputs:
                      (    forth6809.asm):05057         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05058         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05059         ; ------------------------------------------------------------
E700 3706             (    forth6809.asm):05060         QDOSETUP:   PULU  D                 ; index
E702 DD14             (    forth6809.asm):05061                     STD   MSCR

                      (    forth6809.asm):03088         ; ------------------------------------------------------------
DC85 7EF210           (    forth6809.asm):03089         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03090         
                      (    forth6809.asm):03091         ; ------------------------------------------------------------

                      (    forth6809.asm):04210         ; ============================================================
                      (    forth6809.asm):04211         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04212         ; ============================================================
                      (    forth6809.asm):04213                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04214         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04215         
                      (    forth6809.asm):04216         ; ------------------------------------------------------------
                      (    forth6809.asm):04217         ; KEY  ( -- char )
                      (    forth6809.asm):04218         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04219         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04220         ; ------------------------------------------------------------
E2C9                  (    forth6809.asm):04221         KEYW:
                      (    forth6809.asm):04222         
                      (    forth6809.asm):04223                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04224                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04225         
                      (    forth6809.asm):04226                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04227                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04228                                             ; by transmitting all chars.
                      (    forth6809.asm):04229         
E2C9                  (    forth6809.asm):04230         TRY_READ:
                      (    forth6809.asm):04231                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04232                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04233                                             ; while still transmitting!
                      (    forth6809.asm):04234         
                      (    forth6809.asm):04235                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04236                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04237                     PSHU  D                 ; char
                      (    forth6809.asm):04238         
                      (    forth6809.asm):04239                     RTS
                      (    forth6809.asm):04240         
                      (    forth6809.asm):04241         ; ------------------------------------------------------------
                      (    forth6809.asm):04242         ; KEY?  ( -- flag )

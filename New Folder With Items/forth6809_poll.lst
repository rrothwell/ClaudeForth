E882 260A             (    forth6809.asm):05344                     BNE   BTOK
E884 3706             (    forth6809.asm):05345                     PULU  D
E886 CCFFF3           (    forth6809.asm):05346                     LDD   #-13              ; -13
E889 3606             (    forth6809.asm):05347                     PSHU  D
E88B BDE402           (    forth6809.asm):05348                     JSR   THROWW
E88E BDE84A           (    forth6809.asm):05349         BTOK:       JSR   LITERALW

                      (    forth6809.asm):07352         
                      (    forth6809.asm):07353         ; ------------------------------------------------------------
                      (    forth6809.asm):07354         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07355         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07356         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07357         ; PARSEQUOTE
                      (    forth6809.asm):07358         ;    Inputs:
                      (    forth6809.asm):07359         ;        none (parses from >IN)
                      (    forth6809.asm):07360         ;    Outputs:
                      (    forth6809.asm):07361         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07362         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07363         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07364         ; ------------------------------------------------------------
F298 CC0022           (    forth6809.asm):07365         PARSEQUOTE: LDD   #34
F29B 3606             (    forth6809.asm):07366                     PSHU  D
F29D BDF46E           (    forth6809.asm):07367                     JSR   PARSEW

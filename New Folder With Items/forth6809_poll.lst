                      (    forth6809.asm):05539         
                      (    forth6809.asm):05540         ; ------------------------------------------------------------
                      (    forth6809.asm):05541         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05542         ; Exchange the top two cells.

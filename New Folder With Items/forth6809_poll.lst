                      (    forth6809.asm):03889         ; ------------------------------------------------------------
E119 8E005D           (    forth6809.asm):03890         ROOTW:      LDX   #WLHEADS+2
E11C 20E6             (    forth6809.asm):03891                     BRA   SETTOP
                      (    forth6809.asm):03892         
                      (    forth6809.asm):03893         ; ------------------------------------------------------------
                      (    forth6809.asm):03894         ; PREVIOUS  ( -- )
                      (    forth6809.asm):03895         ; Remove the first wordlist from the search order. Throws -50 if the
                      (    forth6809.asm):03896         ; order is empty.
                      (    forth6809.asm):03897         ; ------------------------------------------------------------
E11E 9E49             (    forth6809.asm):03898         PREVIOUSW:  LDX   ORDEND
E120 8C004B           (    forth6809.asm):03899                     CMPX  #ORDER
E123 23CC             (    forth6809.asm):03900                     BLS   DFUNDER
E125 301E             (    forth6809.asm):03901                     LEAX  -2,X

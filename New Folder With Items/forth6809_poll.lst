                      (    forth6809.asm):05757         
                      (    forth6809.asm):05758         ; ------------------------------------------------------------
                      (    forth6809.asm):05759         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05760         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05761         ; return address of this call is on top of S, so it is lifted off and

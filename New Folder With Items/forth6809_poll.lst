                      (    forth6809.asm):04916         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04917         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04918         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04919         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04920         ; DOTEST
                      (    forth6809.asm):04921         ;    Inputs:
                      (    forth6809.asm):04922         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04923         ;        first)
                      (    forth6809.asm):04924         ;    Outputs:
                      (    forth6809.asm):04925         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04926         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04927         ; ------------------------------------------------------------
E63B EC66             (    forth6809.asm):04928         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E63D 2615             (    forth6809.asm):04929                     BNE   DTEXIT            ; set: exit
E63F EC62             (    forth6809.asm):04930                     LDD   2,S               ; index
E641 C30001           (    forth6809.asm):04931                     ADDD  #1
E644 ED62             (    forth6809.asm):04932                     STD   2,S
E646 10A364           (    forth6809.asm):04933                     CMPD  4,S               ; limit
E649 2709             (    forth6809.asm):04934                     BEQ   DTEXIT
E64B 3510             (    forth6809.asm):04935                     PULS  X                 ; X = branch operand address
E64D EC84             (    forth6809.asm):04936                     LDD   ,X
E64F 308B             (    forth6809.asm):04937                     LEAX  D,X
E651 3410             (    forth6809.asm):04938                     PSHS  X                 ; return to loop start
E653 39               (    forth6809.asm):04939                     RTS
E654 3510             (    forth6809.asm):04940         DTEXIT:     PULS  X
E656 3002             (    forth6809.asm):04941                     LEAX  2,X               ; skip the branch operand
E658 3266             (    forth6809.asm):04942                     LEAS  6,S               ; discard the loop frame
E65A 3410             (    forth6809.asm):04943                     PSHS  X
E65C 39               (    forth6809.asm):04944                     RTS

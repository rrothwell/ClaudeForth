FB2B EC04             (    forth6809.asm):08828                     LDD   4,X
FB2D 3606             (    forth6809.asm):08829                     PSHU  D
FB2F CCFFFF           (    forth6809.asm):08830                     LDD   #TRUEV
FB32 3606             (    forth6809.asm):08831                     PSHU  D
FB34 39               (    forth6809.asm):08832                     RTS
                      (    forth6809.asm):08833         
FB35 8EFB79           (    forth6809.asm):08834         ENV2START:  LDX   #ENVTABLE2        ; double-cell table
FB38 EC84             (    forth6809.asm):08835         ENV2LOOP:   LDD   ,X
FB3A 10830000         (    forth6809.asm):08836                     CMPD  #0
FB3E 2731             (    forth6809.asm):08837                     BEQ   ENVNOTFOUND
FB40 3410             (    forth6809.asm):08838                     PSHS  X                 ; See bugfix: ENVQW.2
FB42 3606             (    forth6809.asm):08839                     PSHU  D
FB44 EC02             (    forth6809.asm):08840                     LDD   2,X
FB46 3606             (    forth6809.asm):08841                     PSHU  D
FB48 EC62             (    forth6809.asm):08842                     LDD   2,S               ; c-addr
FB4A 3606             (    forth6809.asm):08843                     PSHU  D
FB4C EC64             (    forth6809.asm):08844                     LDD   4,S               ; u
FB4E 3606             (    forth6809.asm):08845                     PSHU  D
FB50 BDF541           (    forth6809.asm):08846                     JSR   COMPAREW
FB53 3510             (    forth6809.asm):08847                     PULS  X
FB55 3706             (    forth6809.asm):08848                     PULU  D
FB57 10830000         (    forth6809.asm):08849                     CMPD  #0
FB5B 2704             (    forth6809.asm):08850                     BEQ   ENV2FOUND
FB5D 3008             (    forth6809.asm):08851                     LEAX  8,X               ; 8-byte entries
FB5F 20D7             (    forth6809.asm):08852                     BRA   ENV2LOOP
FB61 3264             (    forth6809.asm):08853         ENV2FOUND:  LEAS  4,S               ; drop frame
FB63 EC04             (    forth6809.asm):08854                     LDD   4,X               ; low cell, pushed first
FB65 3606             (    forth6809.asm):08855                     PSHU  D
FB67 EC06             (    forth6809.asm):08856                     LDD   6,X               ; high cell - pushed second/top
FB69 3606             (    forth6809.asm):08857                     PSHU  D
FB6B CCFFFF           (    forth6809.asm):08858                     LDD   #TRUEV
FB6E 3606             (    forth6809.asm):08859                     PSHU  D
FB70 39               (    forth6809.asm):08860                     RTS
                      (    forth6809.asm):08861         

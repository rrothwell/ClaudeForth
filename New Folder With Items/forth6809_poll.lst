                      (    forth6809.asm):04279         ; ------------------------------------------------------------
                      (    forth6809.asm):04280         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04281         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04282         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04283         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04284         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04285         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04286         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04287         ; follow.
                      (    forth6809.asm):04288         ; ------------------------------------------------------------
E2C9                  (    forth6809.asm):04289         KEYW:
E2C9 B6C008           (    forth6809.asm):04290                     LDA   ACIASR
E2CC 8501             (    forth6809.asm):04291                     BITA  #SR_RDRF
E2CE 2705             (    forth6809.asm):04292                     BEQ   KWAIT
E2D0 7C017F           (    forth6809.asm):04293                     INC   POLLREADYCNT      ; character was already queued when we

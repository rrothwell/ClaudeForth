                      (    forth6809.asm):05525         ; ------------------------------------------------------------
                      (    forth6809.asm):05526         ; DUP  ( x -- x x )
                      (    forth6809.asm):05527         ; Duplicate the top cell.
                      (    forth6809.asm):05528         ; ------------------------------------------------------------

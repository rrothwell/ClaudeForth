                      (    forth6809.asm):05316         ; 2LITERAL  ( x1 x2 -- )  IMMEDIATE
                      (    forth6809.asm):05317         ; Compile two LITs so that x1 x2 are pushed when the definition runs.
                      (    forth6809.asm):05318         ; ------------------------------------------------------------
E856                  (    forth6809.asm):05319         TWOLITERALW:
E856 3706             (    forth6809.asm):05320                     PULU  D                 ; x2
E858 3406             (    forth6809.asm):05321                     PSHS  D
E85A BDE84A           (    forth6809.asm):05322                     JSR   LITERALW          ; x1 first, so it lands below x2
E85D 3506             (    forth6809.asm):05323                     PULS  D
E85F 3606             (    forth6809.asm):05324                     PSHU  D
E861 BDE84A           (    forth6809.asm):05325                     JSR   LITERALW

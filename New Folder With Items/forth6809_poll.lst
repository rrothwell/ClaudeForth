E0B4 6AE4             (    forth6809.asm):03799                     DEC   ,S
E0B6 20F3             (    forth6809.asm):03800                     BRA   SOCHK
E0B8 3506             (    forth6809.asm):03801         SOCOPY:     PULS  A,B               ; B = n
E0BA 8E004B           (    forth6809.asm):03802                     LDX   #ORDER
E0BD 5D               (    forth6809.asm):03803         SOCP2:      TSTB
E0BE 2708             (    forth6809.asm):03804                     BEQ   SOCPEND
E0C0 3720             (    forth6809.asm):03805                     PULU  Y
E0C2 10AF81           (    forth6809.asm):03806                     STY   ,X++
E0C5 5A               (    forth6809.asm):03807                     DECB
E0C6 20F5             (    forth6809.asm):03808                     BRA   SOCP2
E0C8 9F49             (    forth6809.asm):03809         SOCPEND:    STX   ORDEND

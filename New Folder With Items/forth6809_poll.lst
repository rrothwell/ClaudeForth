                      (    forth6809.asm):05262         ; ------------------------------------------------------------
                      (    forth6809.asm):05263         ; '  ( "name" -- xt )
                      (    forth6809.asm):05264         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):05265         ; the name is not found.
                      (    forth6809.asm):05266         ; ------------------------------------------------------------

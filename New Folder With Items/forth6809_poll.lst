                      (    forth6809.asm):07862         ; ------------------------------------------------------------
                      (    forth6809.asm):07863         ; SEARCH  ( c-addr1 u1 c-addr2 u2 -- c-addr3 u3 flag )
                      (    forth6809.asm):07864         ; Search the string c-addr1 u1 for the string c-addr2 u2. If found,

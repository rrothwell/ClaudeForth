                      (    forth6809.asm):04065         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04066         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04067         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04068         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04069         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04070         ; NUMLOOP
                      (    forth6809.asm):04071         ;    Inputs:
                      (    forth6809.asm):04072         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04073         ;    Outputs:
                      (    forth6809.asm):04074         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04075         ;        the count remaining
                      (    forth6809.asm):04076         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04077         ; ------------------------------------------------------------
E20D                  (    forth6809.asm):04078         TONUMBERW:
E20D ECC4             (    forth6809.asm):04079         NUMLOOP:    LDD   ,U

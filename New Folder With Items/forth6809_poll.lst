                      (    forth6809.asm):03673         ; ------------------------------------------------------------
                      (    forth6809.asm):03674         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03675         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03676         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03677         ; WLINIT
                      (    forth6809.asm):03678         ;    Inputs:
                      (    forth6809.asm):03679         ;        none
                      (    forth6809.asm):03680         ;    Outputs:
                      (    forth6809.asm):03681         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03682         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03683         ; ------------------------------------------------------------
E00B CCD94C           (    forth6809.asm):03684         WLINIT:     LDD   #BASELATEST
E00E DD5B             (    forth6809.asm):03685                     STD   WLHEADS
E010 CCD064           (    forth6809.asm):03686                     LDD   #BASEROOTLATEST
E013 DD5D             (    forth6809.asm):03687                     STD   WLHEADS+2
E015 CCD064           (    forth6809.asm):03688                     LDD   #H_FORTH
E018 DD6F             (    forth6809.asm):03689                     STD   WLNAMES
E01A CCD05B           (    forth6809.asm):03690                     LDD   #H_ROOT
E01D DD71             (    forth6809.asm):03691                     STD   WLNAMES+2
E01F CC005F           (    forth6809.asm):03692                     LDD   #WLHEADS+4
E022 DD45             (    forth6809.asm):03693                     STD   WLEND
E024 CC005B           (    forth6809.asm):03694                     LDD   #WLHEADS
E027 DD47             (    forth6809.asm):03695                     STD   CURRENT
E029 7EE0F9           (    forth6809.asm):03696                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03697         
                      (    forth6809.asm):03698         ; ------------------------------------------------------------
                      (    forth6809.asm):03699         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03700         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03701         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03702         ; PRUNE
                      (    forth6809.asm):03703         ;    Inputs:
                      (    forth6809.asm):03704         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03705         ;    Outputs:
                      (    forth6809.asm):03706         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03707         ;        into ROM
                      (    forth6809.asm):03708         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
E02C 3406             (    forth6809.asm):03710         PRUNE:      PSHS  D                 ; 0,S = mark
E02E 8E005B           (    forth6809.asm):03711                     LDX   #WLHEADS
E031 9C45             (    forth6809.asm):03712         PRLOOP:     CMPX  WLEND
E033 2421             (    forth6809.asm):03713                     BHS   PRNDONE
E035 10AE84           (    forth6809.asm):03714                     LDY   ,X                ; newest header of this wordlist
E038 108CC000         (    forth6809.asm):03715         PRWALK:     CMPY  #ROMSTRT
E03C 2413             (    forth6809.asm):03716                     BHS   PRSTORE           ; ROM header: keep
E03E 10ACE4           (    forth6809.asm):03717                     CMPY  ,S
E041 250E             (    forth6809.asm):03718                     BLO   PRSTORE           ; below the mark (or empty): keep
E043 E6A4             (    forth6809.asm):03719                     LDB   ,Y
E045 C41F             (    forth6809.asm):03720                     ANDB  #$1F
E047 4F               (    forth6809.asm):03721                     CLRA
E048 3121             (    forth6809.asm):03722                     LEAY  1,Y
E04A 31AB             (    forth6809.asm):03723                     LEAY  D,Y
E04C 10AEA4           (    forth6809.asm):03724                     LDY   ,Y                ; follow the LINK
E04F 20E7             (    forth6809.asm):03725                     BRA   PRWALK
E051 10AF81           (    forth6809.asm):03726         PRSTORE:    STY   ,X++
E054 20DB             (    forth6809.asm):03727                     BRA   PRLOOP
E056 3262             (    forth6809.asm):03728         PRNDONE:     LEAS  2,S
E058 39               (    forth6809.asm):03729                     RTS

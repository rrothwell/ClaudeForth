                      (    forth6809.asm):05719         
                      (    forth6809.asm):05720         ; ------------------------------------------------------------
                      (    forth6809.asm):05721         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05722         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05723         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05724         ; the transfer.

                      (    forth6809.asm):03501         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03502         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03503         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03504         ; FDSEARCH
                      (    forth6809.asm):03505         ;    Inputs:
                      (    forth6809.asm):03506         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03507         ;        RegY = address of the name text
                      (    forth6809.asm):03508         ;        RegB = name length
                      (    forth6809.asm):03509         ;    Outputs:
                      (    forth6809.asm):03510         ;        RegX = the matching header, or 0 if there is none

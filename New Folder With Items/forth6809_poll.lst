                      (    forth6809.asm):07431         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07432         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07433         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07434         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07435         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07436         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07437         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07438         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07439         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07440         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07441         ; ------------------------------------------------------------
F2EC BDDB57           (    forth6809.asm):07442         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F2EF ECC4             (    forth6809.asm):07443                     LDD   ,U
F2F1 3406             (    forth6809.asm):07444                     PSHS  D                 ; output pointer
F2F3 3406             (    forth6809.asm):07445                     PSHS  D                 ; output start
F2F5 DC39             (    forth6809.asm):07446                     LDD   SRCADDR
F2F7 D33B             (    forth6809.asm):07447                     ADDD  SRCLEN
F2F9 3406             (    forth6809.asm):07448                     PSHS  D                 ; input end
F2FB DC39             (    forth6809.asm):07449                     LDD   SRCADDR
F2FD D310             (    forth6809.asm):07450                     ADDD  TOIN
F2FF 1F02             (    forth6809.asm):07451                     TFR   D,Y               ; input pointer

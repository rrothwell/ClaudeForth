F541 AE46             (    forth6809.asm):07832         COMPAREW:   LDX   6,U                ; Parameters stay on the data stack: u2 at 0,
F543 10AE42           (    forth6809.asm):07833                     LDY   2,U               ; c-addr2 at 2, u1 at 4, c-addr1 at 6
F546 EC44             (    forth6809.asm):07834                     LDD   4,U

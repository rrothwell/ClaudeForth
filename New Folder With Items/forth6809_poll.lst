                      (    forth6809.asm):05247         ; [  ( -- )
                      (    forth6809.asm):05248         ; Enter interpretation state: STATE = 0.
                      (    forth6809.asm):05249         ; ------------------------------------------------------------
E810 CC0000           (    forth6809.asm):05250         LBRACKETW:  LDD   #0

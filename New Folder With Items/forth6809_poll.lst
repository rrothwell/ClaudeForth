E3EE 1F40             (    forth6809.asm):04521                     TFR   S,D
E3F0 DD0C             (    forth6809.asm):04522                     STD   HANDLER
                      (    forth6809.asm):04523         
E3F2 AD84             (    forth6809.asm):04524                     JSR   ,X
                      (    forth6809.asm):04525         
E3F4 3268             (    forth6809.asm):04526                     LEAS  8,S               ; drop saved input source
E3F6 3262             (    forth6809.asm):04527                     LEAS  2,S               ; saved U
E3F8 3506             (    forth6809.asm):04528                     PULS  D
E3FA DD0C             (    forth6809.asm):04529                     STD   HANDLER
E3FC CC0000           (    forth6809.asm):04530                     LDD   #0
E3FF 3606             (    forth6809.asm):04531                     PSHU  D                 ; 0 = no exception
E401 39               (    forth6809.asm):04532                     RTS
                      (    forth6809.asm):04533         
                      (    forth6809.asm):04534         ; ------------------------------------------------------------
                      (    forth6809.asm):04535         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04536         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04537         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04538         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04539         ; ------------------------------------------------------------

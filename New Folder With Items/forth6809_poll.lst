                      (    forth6809.asm):01912         ; SERBUFCLR
                      (    forth6809.asm):01913         ;    Inputs:
                      (    forth6809.asm):01914         ;        none
                      (    forth6809.asm):01915         ;    Outputs:
                      (    forth6809.asm):01916         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01917         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01918         ;    Registers: only CC changed.
                      (    forth6809.asm):01919         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01920         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01921         ; ------------------------------------------------------------
                      (    forth6809.asm):01922         
D952 7F0176           (    forth6809.asm):01923         SERBUFCLR:  CLR   INHEAD
D955 7F0177           (    forth6809.asm):01924                     CLR   INTAIL
D958 7F0178           (    forth6809.asm):01925                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
D95B 7F0179           (    forth6809.asm):01926                     CLR   OUTHEAD
D95E 7F017A           (    forth6809.asm):01927                     CLR   OUTTAIL
D961 7F017B           (    forth6809.asm):01928                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01929         
                      (    forth6809.asm):01930         
D964 7F017C           (    forth6809.asm):01931                     CLR   FECOUNT
D967 7F017D           (    forth6809.asm):01932                     CLR   OVRNCOUNT
D96A 7F017E           (    forth6809.asm):01933                     CLR   PECOUNT
D96D 7F017F           (    forth6809.asm):01934                     CLR   POLLREADYCNT
D970 39               (    forth6809.asm):01935                     RTS
                      (    forth6809.asm):01936         
                      (    forth6809.asm):01937         ; ------------------------------------------------------------
                      (    forth6809.asm):01938         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01939         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01940         ; INITSERIAL
                      (    forth6809.asm):01941         ;    Inputs:
                      (    forth6809.asm):01942         ;        none
                      (    forth6809.asm):01943         ;    Outputs:
                      (    forth6809.asm):01944         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01945         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01946         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01947         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01948         ; ------------------------------------------------------------
D971 BDD952           (    forth6809.asm):01949         INITSERIAL: JSR   SERBUFCLR
D974 8603             (    forth6809.asm):01950                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
D976 B7C008           (    forth6809.asm):01951                     STA   ACIACR
D979 12               (    forth6809.asm):01952                     NOP                     ; Settling Delay
D97A 12               (    forth6809.asm):01953                     NOP
                      (    forth6809.asm):01954         
                      (    forth6809.asm):01955                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01956                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01957                     ELSE                    ; <<<<<>>>>>
D97B 8615             (    forth6809.asm):01958                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01959                     ENDC                    ; <<<<<<<<<<
D97D B7C008           (    forth6809.asm):01960                     STA   ACIACR            ; See bugfix: INITSERIAL.1
D980 39               (    forth6809.asm):01961                     RTS
                      (    forth6809.asm):01962         
                      (    forth6809.asm):01963                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01964         ; ------------------------------------------------------------
                      (    forth6809.asm):01965         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01966         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01967         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01968         ; INFILL
                      (    forth6809.asm):01969         ;    Inputs:
                      (    forth6809.asm):01970         ;        none
                      (    forth6809.asm):01971         ;    Outputs:
                      (    forth6809.asm):01972         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01973         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01974         ; ------------------------------------------------------------
D981                  (    forth6809.asm):01975         INFILL:     LDA   INHEAD
                      (    forth6809.asm):01976                     SUBA  INTAIL
                      (    forth6809.asm):01977                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):01978                     RTS
                      (    forth6809.asm):01979         ; ------------------------------------------------------------
                      (    forth6809.asm):01980         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01981         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01982         ; receive path with interrupts already masked.
                      (    forth6809.asm):01983         ; RTSCHECKHI
                      (    forth6809.asm):01984         ;    Inputs:
                      (    forth6809.asm):01985         ;        none
                      (    forth6809.asm):01986         ;    Outputs:
                      (    forth6809.asm):01987         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01988         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01989         ; ------------------------------------------------------------
D981                  (    forth6809.asm):01990         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):01991                     CMPA  #INHIWATER
                      (    forth6809.asm):01992                     BLO   RTSCHIDONE
                      (    forth6809.asm):01993                     TST   RTSSTATE
                      (    forth6809.asm):01994                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):01995                     LDA   #CR_RTSHI
                      (    forth6809.asm):01996                     STA   ACIACR
                      (    forth6809.asm):01997                     LDA   #1
                      (    forth6809.asm):01998                     STA   RTSSTATE
D981                  (    forth6809.asm):01999         RTSCHIDONE: RTS
                      (    forth6809.asm):02000         ; ------------------------------------------------------------
                      (    forth6809.asm):02001         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02002         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02003         ; enables it only while output is pending.
                      (    forth6809.asm):02004         ; UPDATE_RTS
                      (    forth6809.asm):02005         ;    Inputs:
                      (    forth6809.asm):02006         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02007         ;    Outputs:
                      (    forth6809.asm):02008         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02009         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02010         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02011         UPDATE_RTS:
                      (    forth6809.asm):02012                     TST   RTSSTATE
                      (    forth6809.asm):02013                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02014         
                      (    forth6809.asm):02015                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02016                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02017         
                      (    forth6809.asm):02018                                             ; $B5/%1011_0101
                      (    forth6809.asm):02019                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02020                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02021         
D981                  (    forth6809.asm):02022         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02023                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02024                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02025         
D981                  (    forth6809.asm):02026         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02027                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02028                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
D981                  (    forth6809.asm):02029         WRITE_CR:
                      (    forth6809.asm):02030                     STA   ACIACR
                      (    forth6809.asm):02031                     RTS
                      (    forth6809.asm):02032         ; ------------------------------------------------------------
                      (    forth6809.asm):02033         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02034         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02035         ; Called after a character is added to the ring.
                      (    forth6809.asm):02036         ; CHKHI
                      (    forth6809.asm):02037         ;    Inputs:
                      (    forth6809.asm):02038         ;        RegB = input ring fill level
                      (    forth6809.asm):02039         ;    Outputs:
                      (    forth6809.asm):02040         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02041         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02042         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02043         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02044         CHKHI:
                      (    forth6809.asm):02045                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02046                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02047                     TST   RTSSTATE
                      (    forth6809.asm):02048                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02049                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02050                     STA   RTSSTATE
                      (    forth6809.asm):02051                     JSR   UPDATE_RTS
D981                  (    forth6809.asm):02052         CHKHIDONE:  RTS
                      (    forth6809.asm):02053         
                      (    forth6809.asm):02054         ; ------------------------------------------------------------
                      (    forth6809.asm):02055         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02056         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02057         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02058         ; CHKLO
                      (    forth6809.asm):02059         ;    Inputs:
                      (    forth6809.asm):02060         ;        RegB = input ring fill level
                      (    forth6809.asm):02061         ;    Outputs:
                      (    forth6809.asm):02062         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02063         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02064         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02065         CHKLO:
                      (    forth6809.asm):02066                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02067                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02068                     TST   RTSSTATE
                      (    forth6809.asm):02069                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02070                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02071                     STA   RTSSTATE
                      (    forth6809.asm):02072                     JSR   UPDATE_RTS
D981                  (    forth6809.asm):02073         CHKLODONE:  RTS
                      (    forth6809.asm):02074         ; ------------------------------------------------------------
                      (    forth6809.asm):02075         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02076         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02077         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02078         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02079         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02080         ;    Inputs:
                      (    forth6809.asm):02081         ;        none
                      (    forth6809.asm):02082         ;    Outputs:
                      (    forth6809.asm):02083         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02084         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02085         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02086         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02087         FLUSHOUTBUFFER:
                      (    forth6809.asm):02088                     LDB   OUTTAIL
                      (    forth6809.asm):02089                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02090                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02091         
                      (    forth6809.asm):02092                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02093                     BITA  #SR_CTS
                      (    forth6809.asm):02094                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02095         
                      (    forth6809.asm):02096                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02097                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02098                                             ; than spin-wait here.
                      (    forth6809.asm):02099         
                      (    forth6809.asm):02100                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02101                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02102                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02103         
                      (    forth6809.asm):02104                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02105                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02106                     STB   OUTTAIL
                      (    forth6809.asm):02107                                             ; One character sent - return rather than
                      (    forth6809.asm):02108                                             ; loop back for more (see header comment).
D981                  (    forth6809.asm):02109         FLUSHED:
                      (    forth6809.asm):02110                     RTS
                      (    forth6809.asm):02111         ; ------------------------------------------------------------
                      (    forth6809.asm):02112         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02113         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02114         ; PUTCHAR
                      (    forth6809.asm):02115         ;    Inputs:
                      (    forth6809.asm):02116         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02117         ;    Outputs:
                      (    forth6809.asm):02118         ;        none
                      (    forth6809.asm):02119         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02120         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02121         PUTCHAR:
                      (    forth6809.asm):02122                     PSHS  CC,X
                      (    forth6809.asm):02123                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02124         
                      (    forth6809.asm):02125                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02126                     INCB
                      (    forth6809.asm):02127                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02128                     CMPB  OUTTAIL
                      (    forth6809.asm):02129                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02130         
                      (    forth6809.asm):02131                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02132                     LDB   OUTHEAD
                      (    forth6809.asm):02133                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02134         
                      (    forth6809.asm):02135                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02136                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02137                     STB   OUTHEAD
                      (    forth6809.asm):02138         
                      (    forth6809.asm):02139                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02140                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02141         
                      (    forth6809.asm):02142                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02143                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02144                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02145                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02146                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02147                                             ; expects the critical section active
                      (    forth6809.asm):02148         
                      (    forth6809.asm):02149                     BRA   PUT_EXIT
                      (    forth6809.asm):02150         
                      (    forth6809.asm):02151         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02152         ; priming the pump by transmitting a character.
D981                  (    forth6809.asm):02153         CHK_INT_PATH:
                      (    forth6809.asm):02154                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02155                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02156         
                      (    forth6809.asm):02157                                             ; No! Restart.
                      (    forth6809.asm):02158                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02159                     LDB   OUTTAIL
                      (    forth6809.asm):02160                     LDA   B,X
                      (    forth6809.asm):02161                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02162         
                      (    forth6809.asm):02163                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02164                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02165                     STB   OUTTAIL
                      (    forth6809.asm):02166         
                      (    forth6809.asm):02167                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02168                     STA   OUTACTIVITY
                      (    forth6809.asm):02169                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02170         
D981                  (    forth6809.asm):02171         PUT_EXIT:
                      (    forth6809.asm):02172                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02173                                             ; by restoring the CC.
                      (    forth6809.asm):02174         ; ------------------------------------------------------------
                      (    forth6809.asm):02175         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02176         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02177         ; GETCHAR
                      (    forth6809.asm):02178         ;    Inputs:
                      (    forth6809.asm):02179         ;        none
                      (    forth6809.asm):02180         ;    Outputs:
                      (    forth6809.asm):02181         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02182         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02183         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02184         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02185         GETCHAR:
                      (    forth6809.asm):02186                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02187                     CMPB  INHEAD
                      (    forth6809.asm):02188                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02189         
                      (    forth6809.asm):02190                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02191                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02192         
                      (    forth6809.asm):02193                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02194                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02195                     STB   INTAIL
                      (    forth6809.asm):02196         
                      (    forth6809.asm):02197                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02198                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02199                     ORCC  #$10
                      (    forth6809.asm):02200                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02201                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02202                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02203                                             ; there's no already-loaded value here
                      (    forth6809.asm):02204                                             ; worth reusing.
                      (    forth6809.asm):02205                     JSR   CHKLO
                      (    forth6809.asm):02206                     ANDCC #$EF
                      (    forth6809.asm):02207         
                      (    forth6809.asm):02208                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02209                     RTS
                      (    forth6809.asm):02210         
D981                  (    forth6809.asm):02211         GET_NO_CHAR:
                      (    forth6809.asm):02212                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02213                     RTS
                      (    forth6809.asm):02214         ; ------------------------------------------------------------
                      (    forth6809.asm):02215         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02216         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02217         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02218         ; RTSCHECKLO
                      (    forth6809.asm):02219         ;    Inputs:
                      (    forth6809.asm):02220         ;        none
                      (    forth6809.asm):02221         ;    Outputs:
                      (    forth6809.asm):02222         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02223         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02224         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02225         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02226         RTSCHECKLO:
                      (    forth6809.asm):02227                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02228         
                      (    forth6809.asm):02229                     JSR   INFILL
                      (    forth6809.asm):02230                     CMPA  #INLOWATER
                      (    forth6809.asm):02231                     BHI   RTSCLODONE
                      (    forth6809.asm):02232                     TST   RTSSTATE
                      (    forth6809.asm):02233                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235         
                      (    forth6809.asm):02236                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02237         
                      (    forth6809.asm):02238                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02239                     CMPB  OUTHEAD
                      (    forth6809.asm):02240                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02241         
                      (    forth6809.asm):02242                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02243                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02244                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02245         
D981                  (    forth6809.asm):02246         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02247                     STA   ACIACR
                      (    forth6809.asm):02248         
D981                  (    forth6809.asm):02249         RTSCLOUNMASK:
                      (    forth6809.asm):02250                     ANDCC #$EF
                      (    forth6809.asm):02251         
D981                  (    forth6809.asm):02252         RTSCLODONE: RTS
                      (    forth6809.asm):02253         
                      (    forth6809.asm):02254         ; ------------------------------------------------------------
                      (    forth6809.asm):02255         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02256         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02257         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02258         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02259         ; IRQH
                      (    forth6809.asm):02260         ;    Inputs:
                      (    forth6809.asm):02261         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02262         ;    Outputs:
                      (    forth6809.asm):02263         ;        none (returns with RTI)
                      (    forth6809.asm):02264         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02265         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02266         ; ------------------------------------------------------------
D981                  (    forth6809.asm):02267         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02270                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02271                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02272                     BNE   INCHAR
                      (    forth6809.asm):02273                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02274                     BNE   OUTCHAR
                      (    forth6809.asm):02275                                             ; Ignore all other interrupts such as DCD change.
D981                  (    forth6809.asm):02276         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02277                                             ; & restores state.
                      (    forth6809.asm):02278         
D981                  (    forth6809.asm):02279         INCHAR:
                      (    forth6809.asm):02280                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02281                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02282                                             ; Any receiver error flagged?
                      (    forth6809.asm):02283                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02284         
                      (    forth6809.asm):02285                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02286                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02287                     INC   FECOUNT           ; more than one bit can be set at once.
D981                  (    forth6809.asm):02288         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02289                     BEQ   INXOVRN
                      (    forth6809.asm):02290                     INC   OVRNCOUNT
D981                  (    forth6809.asm):02291         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02292                     BEQ   INXPE
                      (    forth6809.asm):02293                     INC   PECOUNT
D981                  (    forth6809.asm):02294         INXPE:      RTI
                      (    forth6809.asm):02295         
D981                  (    forth6809.asm):02296         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02297                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02298                     LDB   INHEAD
                      (    forth6809.asm):02299                     STA   B,X
                      (    forth6809.asm):02300                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02301                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02302                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02303                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02304                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02305                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02306                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02307                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02308                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02309                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02310                     JSR   CHKHI             ; Protect the in buffer from overflow.
D981                  (    forth6809.asm):02311         IRQDONE1:   RTI
                      (    forth6809.asm):02312         
                      (    forth6809.asm):02313                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02314         
D981                  (    forth6809.asm):02315         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02316                     CMPB  OUTHEAD
                      (    forth6809.asm):02317                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02318         
                      (    forth6809.asm):02319                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02320                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02321                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02322         
                      (    forth6809.asm):02323                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02324                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02325                     STB   OUTTAIL
D981                  (    forth6809.asm):02326         IRQDONE2    RTI
                      (    forth6809.asm):02327         
D981                  (    forth6809.asm):02328         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02329                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02330                     CLR   OUTACTIVITY
                      (    forth6809.asm):02331                     JSR   UPDATE_RTS
D981                  (    forth6809.asm):02332         IRQDONE3    RTI
                      (    forth6809.asm):02333         
                      (    forth6809.asm):02334                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02335         
D981 3B               (    forth6809.asm):02336         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02337                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02338                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02339                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02340                                             ; the other unused vectors below
                      (    forth6809.asm):02341                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02342         
                      (    forth6809.asm):02343         ; ------------------------------------------------------------
                      (    forth6809.asm):02344         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02345         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02346         ; ------------------------------------------------------------
D982 3B               (    forth6809.asm):02347         SWI3H:      RTI
D983 3B               (    forth6809.asm):02348         SWI2H:      RTI
D984 3B               (    forth6809.asm):02349         FIRQH:      RTI
D985 3B               (    forth6809.asm):02350         NMIH:       RTI                     ; unused now that NMI -> WARM
D986 CCFF9D           (    forth6809.asm):02351         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
D989 3606             (    forth6809.asm):02352                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
D98B 7EE402           (    forth6809.asm):02353                     JMP   THROWW
                      (    forth6809.asm):02354         
                      (    forth6809.asm):02355         ; ============================================================
                      (    forth6809.asm):02356         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02357         ; ============================================================
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
                      (    forth6809.asm):02359         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02360         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02361         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02362         ; COLD
                      (    forth6809.asm):02363         ;    Inputs:
                      (    forth6809.asm):02364         ;        none (entered at reset)
                      (    forth6809.asm):02365         ;    Outputs:
                      (    forth6809.asm):02366         ;        none (does not return)
                      (    forth6809.asm):02367         ;    Registers: all changed.
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
D98E CC0240           (    forth6809.asm):02369         COLD:       LDD   #APPVARS
D991 DD0A             (    forth6809.asm):02370                     STD   VARHERE
D993 CC7000           (    forth6809.asm):02371                     LDD   #APPCODE
D996 DD08             (    forth6809.asm):02372                     STD   CODEHERE
D998 CC2000           (    forth6809.asm):02373                     LDD   #APPDICT
D99B DD06             (    forth6809.asm):02374                     STD   DPHERE
D99D CCD94C           (    forth6809.asm):02375                     LDD   #BASELATEST
D9A0 DD04             (    forth6809.asm):02376                     STD   LATEST
D9A2 BDE00B           (    forth6809.asm):02377                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02378         
D9A5 CC000A           (    forth6809.asm):02379                     LDD   #10
D9A8 DD02             (    forth6809.asm):02380                     STD   BASE
                      (    forth6809.asm):02381         
D9AA CC0106           (    forth6809.asm):02382                     LDD   #TIBBUF
D9AD DD39             (    forth6809.asm):02383                     STD   SRCADDR
D9AF CC0000           (    forth6809.asm):02384                     LDD   #0
D9B2 DD3B             (    forth6809.asm):02385                     STD   SRCLEN
D9B4 DD3D             (    forth6809.asm):02386                     STD   SRCID
                      (    forth6809.asm):02387         
D9B6 8EDA5C           (    forth6809.asm):02388                     LDX   #SIGNON
D9B9 3610             (    forth6809.asm):02389                     PSHU  X                 ; c-addr
D9BB CC000F           (    forth6809.asm):02390                     LDD   #SIGNONL
D9BE 3606             (    forth6809.asm):02391                     PSHU  D                 ; u
D9C0 BDF411           (    forth6809.asm):02392                     JSR   TYPEW
D9C3 BDFA20           (    forth6809.asm):02393                     JSR   CRW
D9C6 2008             (    forth6809.asm):02394                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02395         
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
                      (    forth6809.asm):02397         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02398         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02399         ; ------------------------------------------------------------
D9C8 CCFFFF           (    forth6809.asm):02400         ABORTW:     LDD   #-1
D9CB 3606             (    forth6809.asm):02401                     PSHU  D                 ; throw code (-1)
D9CD 7EE402           (    forth6809.asm):02402                     JMP   THROWW
                      (    forth6809.asm):02403         
                      (    forth6809.asm):02404         ; ------------------------------------------------------------
                      (    forth6809.asm):02405         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02406         ; ABORT
                      (    forth6809.asm):02407         ;    Inputs:
                      (    forth6809.asm):02408         ;        none
                      (    forth6809.asm):02409         ;    Outputs:
                      (    forth6809.asm):02410         ;        none (does not return)
                      (    forth6809.asm):02411         ;    Registers: RegU changed.
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
D9D0 CEBD00           (    forth6809.asm):02413         ABORT:      LDU   #SP0
                      (    forth6809.asm):02414                     ; falls through into QUIT
                      (    forth6809.asm):02415         
                      (    forth6809.asm):02416         ; ------------------------------------------------------------
                      (    forth6809.asm):02417         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02418         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02419         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02420         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02421         ; ------------------------------------------------------------
D9D3 10CEC000         (    forth6809.asm):02422         QUITW:      LDS   #RP0
D9D7 CC0000           (    forth6809.asm):02423                     LDD   #0
D9DA DD00             (    forth6809.asm):02424                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02425         
D9DC BDE3AD           (    forth6809.asm):02426         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02427         
D9DF DC06             (    forth6809.asm):02428                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
D9E1 3406             (    forth6809.asm):02429                     PSHS  D                 ; and THROW restore S, so the frame is
D9E3 DC08             (    forth6809.asm):02430                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
D9E5 3406             (    forth6809.asm):02431                     PSHS  D                 ; See shadow QLOOP.2
D9E7 DC0A             (    forth6809.asm):02432                     LDD   VARHERE
D9E9 3406             (    forth6809.asm):02433                     PSHS  D
D9EB DC04             (    forth6809.asm):02434                     LDD   LATEST
D9ED 3406             (    forth6809.asm):02435                     PSHS  D
                      (    forth6809.asm):02436         
D9EF CCDE35           (    forth6809.asm):02437                     LDD   #INTERPRET
D9F2 3606             (    forth6809.asm):02438                     PSHU  D                 ; xt
D9F4 BDE3D6           (    forth6809.asm):02439                     JSR   CATCHW
D9F7 3706             (    forth6809.asm):02440                     PULU  D                 ; throw code (0 = no error)
D9F9 3406             (    forth6809.asm):02441                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
D9FB 10830000         (    forth6809.asm):02442                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
D9FF 2743             (    forth6809.asm):02443                     BEQ   QOK
                      (    forth6809.asm):02444         
DA01 EC68             (    forth6809.asm):02445                     LDD   8,S
DA03 DD06             (    forth6809.asm):02446                     STD   DPHERE
DA05 BDE02C           (    forth6809.asm):02447                     JSR   PRUNE             ; unlink headers newer than DPHERE
DA08 EC66             (    forth6809.asm):02448                     LDD   6,S
DA0A DD08             (    forth6809.asm):02449                     STD   CODEHERE
DA0C EC64             (    forth6809.asm):02450                     LDD   4,S
DA0E DD0A             (    forth6809.asm):02451                     STD   VARHERE
DA10 EC62             (    forth6809.asm):02452                     LDD   2,S
DA12 DD04             (    forth6809.asm):02453                     STD   LATEST
DA14 CEBD00           (    forth6809.asm):02454                     LDU   #SP0
                      (    forth6809.asm):02455         
                      (    forth6809.asm):02456                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02457                     ; See bugfix: QLOOP.1
DA17 CC0000           (    forth6809.asm):02458                     LDD   #0
DA1A DD00             (    forth6809.asm):02459                     STD   STATE
                      (    forth6809.asm):02460         
DA1C ECE4             (    forth6809.asm):02461                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DA1E 1083FFFF         (    forth6809.asm):02462                     CMPD  #-1
DA22 2605             (    forth6809.asm):02463                     BNE   QSHOWERR
DA24 326A             (    forth6809.asm):02464                     LEAS  10,S              ; drop the frame
DA26 16FFB3           (    forth6809.asm):02465                     LBRA  QLOOP
                      (    forth6809.asm):02466         
DA29 BDFA20           (    forth6809.asm):02467         QSHOWERR:   JSR   CRW
DA2C 8EDA6F           (    forth6809.asm):02468                     LDX   #ERRMSG
DA2F 3610             (    forth6809.asm):02469                     PSHU  X                 ; c-addr
DA31 CC0008           (    forth6809.asm):02470                     LDD   #ERRMSGL
DA34 3606             (    forth6809.asm):02471                     PSHU  D                 ; u
DA36 BDF411           (    forth6809.asm):02472                     JSR   TYPEW
DA39 ECE4             (    forth6809.asm):02473                     LDD   ,S
DA3B 3606             (    forth6809.asm):02474                     PSHU  D                 ; n
DA3D BDF8EF           (    forth6809.asm):02475                     JSR   DOTW
DA40 326A             (    forth6809.asm):02476                     LEAS  10,S              ; drop the frame
DA42 2098             (    forth6809.asm):02477                     BRA   QLOOP
                      (    forth6809.asm):02478         
DA44 326A             (    forth6809.asm):02479         QOK:        LEAS  10,S              ; drop the frame
DA46 BDFA20           (    forth6809.asm):02480                     JSR   CRW               ; See bugfix: QOK.1
DA49 DC00             (    forth6809.asm):02481                     LDD   STATE
DA4B 268F             (    forth6809.asm):02482                     BNE   QLOOP
DA4D 8EDA6B           (    forth6809.asm):02483                     LDX   #OKMSG
DA50 3610             (    forth6809.asm):02484                     PSHU  X                 ; c-addr
DA52 CC0004           (    forth6809.asm):02485                     LDD   #OKMSGL
DA55 3606             (    forth6809.asm):02486                     PSHU  D                 ; u
DA57 BDF411           (    forth6809.asm):02487                     JSR   TYPEW
DA5A 2080             (    forth6809.asm):02488                     BRA   QLOOP
                      (    forth6809.asm):02489         
DA5C 3638303920464F52 (    forth6809.asm):02490         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02491         SIGNONL     EQU   *-SIGNON
DA6B 20206F6B         (    forth6809.asm):02492         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02493         OKMSGL      EQU   *-OKMSG
DA6F 20204552524F5220 (    forth6809.asm):02494         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02495         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02496         
                      (    forth6809.asm):02497         ; ============================================================
                      (    forth6809.asm):02498         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02499         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02500         ; ============================================================
                      (    forth6809.asm):02501         ; ------------------------------------------------------------
                      (    forth6809.asm):02502         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02503         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02504         ; LIT   ( -- x )
                      (    forth6809.asm):02505         ;    Inputs:
                      (    forth6809.asm):02506         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02507         ;    Outputs:
                      (    forth6809.asm):02508         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02509         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02510         ; ------------------------------------------------------------
DA77 3510             (    forth6809.asm):02511         LIT:        PULS  X
DA79 EC81             (    forth6809.asm):02512                     LDD   ,X++
DA7B 3606             (    forth6809.asm):02513                     PSHU  D                 ; x
DA7D 3410             (    forth6809.asm):02514                     PSHS  X
DA7F 39               (    forth6809.asm):02515                     RTS
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517         ; ------------------------------------------------------------
                      (    forth6809.asm):02518         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02519         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02520         ; address.
                      (    forth6809.asm):02521         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02522         ;    Inputs:
                      (    forth6809.asm):02523         ;        flag on the data stack
                      (    forth6809.asm):02524         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02525         ;    Outputs:
                      (    forth6809.asm):02526         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02527         ;        the offset
                      (    forth6809.asm):02528         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
DA80 3706             (    forth6809.asm):02530         ZBRANCH:    PULU  D                 ; flag
DA82 3510             (    forth6809.asm):02531                     PULS  X
DA84 10830000         (    forth6809.asm):02532                     CMPD  #0
DA88 2607             (    forth6809.asm):02533                     BNE   ZSKIP
DA8A EC84             (    forth6809.asm):02534                     LDD   ,X
DA8C 308B             (    forth6809.asm):02535                     LEAX  D,X
DA8E 3410             (    forth6809.asm):02536                     PSHS  X
DA90 39               (    forth6809.asm):02537                     RTS
DA91 3002             (    forth6809.asm):02538         ZSKIP:      LEAX  2,X
DA93 3410             (    forth6809.asm):02539                     PSHS  X
DA95 39               (    forth6809.asm):02540                     RTS
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
                      (    forth6809.asm):02543         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02544         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02545         ; BRANCH
                      (    forth6809.asm):02546         ;    Inputs:
                      (    forth6809.asm):02547         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02548         ;    Outputs:
                      (    forth6809.asm):02549         ;        return address set to the branch target
                      (    forth6809.asm):02550         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02551         ; ------------------------------------------------------------
DA96 3510             (    forth6809.asm):02552         BRANCH:     PULS  X
DA98 EC84             (    forth6809.asm):02553                     LDD   ,X
DA9A 308B             (    forth6809.asm):02554                     LEAX  D,X
DA9C 3410             (    forth6809.asm):02555                     PSHS  X
DA9E 39               (    forth6809.asm):02556                     RTS
                      (    forth6809.asm):02557         
                      (    forth6809.asm):02558         ; ------------------------------------------------------------
                      (    forth6809.asm):02559         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02560         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02561         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02562         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02563         ;    Inputs:
                      (    forth6809.asm):02564         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02565         ;        trampoline
                      (    forth6809.asm):02566         ;    Outputs:
                      (    forth6809.asm):02567         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02568         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02569         ; ------------------------------------------------------------
DA9F 3510             (    forth6809.asm):02570         DODOES:     PULS  X
DAA1 10AE81           (    forth6809.asm):02571                     LDY   ,X++
DAA4 EC84             (    forth6809.asm):02572                     LDD   ,X
DAA6 3606             (    forth6809.asm):02573                     PSHU  D                 ; pfa
DAA8 6EA4             (    forth6809.asm):02574                     JMP   ,Y
                      (    forth6809.asm):02575         
                      (    forth6809.asm):02576         ; ------------------------------------------------------------
                      (    forth6809.asm):02577         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02578         ; field address on the stack.
                      (    forth6809.asm):02579         ; DOESRT0
                      (    forth6809.asm):02580         ;    Inputs:
                      (    forth6809.asm):02581         ;        none
                      (    forth6809.asm):02582         ;    Outputs:
                      (    forth6809.asm):02583         ;        none
                      (    forth6809.asm):02584         ;    Registers: none.
                      (    forth6809.asm):02585         ; ------------------------------------------------------------
DAAA 39               (    forth6809.asm):02586         DOESRT0:    RTS
                      (    forth6809.asm):02587         
                      (    forth6809.asm):02588         ; ------------------------------------------------------------
                      (    forth6809.asm):02589         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02590         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02591         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02592         ; SETDOES
                      (    forth6809.asm):02593         ;    Inputs:
                      (    forth6809.asm):02594         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02595         ;        BEHAVIOR)
                      (    forth6809.asm):02596         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02597         ;        address
                      (    forth6809.asm):02598         ;    Outputs:
                      (    forth6809.asm):02599         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02600         ;        defining word's caller
                      (    forth6809.asm):02601         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02602         ; ------------------------------------------------------------
DAAB 3510             (    forth6809.asm):02603         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DAAD 1F12             (    forth6809.asm):02604                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02605         
DAAF 9E04             (    forth6809.asm):02606                     LDX   LATEST
DAB1 E684             (    forth6809.asm):02607                     LDB   ,X
DAB3 C41F             (    forth6809.asm):02608                     ANDB  #$1F
DAB5 4F               (    forth6809.asm):02609                     CLRA
DAB6 308B             (    forth6809.asm):02610                     LEAX  D,X               ; header + name length
DAB8 EC03             (    forth6809.asm):02611                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DABA C30003           (    forth6809.asm):02612                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DABD 1F01             (    forth6809.asm):02613                     TFR   D,X
                      (    forth6809.asm):02614         
DABF 10AF84           (    forth6809.asm):02615                     STY   ,X                ; patch it
                      (    forth6809.asm):02616         
DAC2 3510             (    forth6809.asm):02617                     PULS  X                 ; X = the OUTER defining word's own return addr
DAC4 6E84             (    forth6809.asm):02618                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02619         
                      (    forth6809.asm):02620         ; ------------------------------------------------------------
                      (    forth6809.asm):02621         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02622         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02623         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02624         ;    Inputs:
                      (    forth6809.asm):02625         ;        pfa on the data stack
                      (    forth6809.asm):02626         ;    Outputs:
                      (    forth6809.asm):02627         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02628         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02629         ; ------------------------------------------------------------
DAC6 3710             (    forth6809.asm):02630         DODEFER:    PULU  X                 ; pfa
DAC8 EC84             (    forth6809.asm):02631                     LDD   ,X
DACA 1F01             (    forth6809.asm):02632                     TFR   D,X
DACC 6E84             (    forth6809.asm):02633                     JMP   ,X
                      (    forth6809.asm):02634         
                      (    forth6809.asm):02635         ; ------------------------------------------------------------
                      (    forth6809.asm):02636         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02637         ; DOABORTUNDEF
                      (    forth6809.asm):02638         ;    Inputs:
                      (    forth6809.asm):02639         ;        none
                      (    forth6809.asm):02640         ;    Outputs:
                      (    forth6809.asm):02641         ;        none (does not return)
                      (    forth6809.asm):02642         ;    Registers: RegD changed.
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
DACE                  (    forth6809.asm):02644         DOABORTUNDEF:
DACE CCFFEB           (    forth6809.asm):02645                     LDD   #-21
DAD1 3606             (    forth6809.asm):02646                     PSHU  D                 ; throw code (-21)
DAD3 7EE402           (    forth6809.asm):02647                     JMP   THROWW
                      (    forth6809.asm):02648         
                      (    forth6809.asm):02649         ; ------------------------------------------------------------
                      (    forth6809.asm):02650         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02651         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02652         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02653         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02654         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02655         ;    Inputs:
                      (    forth6809.asm):02656         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02657         ;    Outputs:
                      (    forth6809.asm):02658         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02659         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02660         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
DAD6 3710             (    forth6809.asm):02662         DOMARKER:   PULU  X                 ; pfa
DAD8 EC84             (    forth6809.asm):02663                     LDD   ,X
DADA DD06             (    forth6809.asm):02664                     STD   DPHERE
DADC EC02             (    forth6809.asm):02665                     LDD   2,X
DADE DD08             (    forth6809.asm):02666                     STD   CODEHERE
DAE0 EC04             (    forth6809.asm):02667                     LDD   4,X
DAE2 DD0A             (    forth6809.asm):02668                     STD   VARHERE
DAE4 EC06             (    forth6809.asm):02669                     LDD   6,X
DAE6 DD04             (    forth6809.asm):02670                     STD   LATEST
DAE8 3008             (    forth6809.asm):02671                     LEAX  8,X               ; the saved search-order state follows
DAEA 108E0045         (    forth6809.asm):02672                     LDY   #SRCHSAVE
DAEE C616             (    forth6809.asm):02673                     LDB   #SRCHSAVESZ
DAF0 A680             (    forth6809.asm):02674         DMCOPY:     LDA   ,X+
DAF2 A7A0             (    forth6809.asm):02675                     STA   ,Y+
DAF4 5A               (    forth6809.asm):02676                     DECB
DAF5 26F9             (    forth6809.asm):02677                     BNE   DMCOPY
DAF7 DC06             (    forth6809.asm):02678                     LDD   DPHERE
DAF9 7EE02C           (    forth6809.asm):02679                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02680         
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
                      (    forth6809.asm):02682         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02683         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02684         ; ------------------------------------------------------------
DAFC 3710             (    forth6809.asm):02685         EXECUTEW:   PULU  X                 ; xt
DAFE AD84             (    forth6809.asm):02686                     JSR   ,X
DB00 39               (    forth6809.asm):02687                     RTS
                      (    forth6809.asm):02688         
                      (    forth6809.asm):02689         ; ============================================================
                      (    forth6809.asm):02690         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02691         ; ============================================================
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
                      (    forth6809.asm):02693         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02694         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02695         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02696         ;    Inputs:
                      (    forth6809.asm):02697         ;        RegX = address of the here pointer
                      (    forth6809.asm):02698         ;        x on the data stack
                      (    forth6809.asm):02699         ;    Outputs:
                      (    forth6809.asm):02700         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02701         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02702         ; ------------------------------------------------------------
DB01 3706             (    forth6809.asm):02703         APPENDCELL: PULU  D                 ; x
DB03 10AE84           (    forth6809.asm):02704                     LDY   ,X
DB06 EDA1             (    forth6809.asm):02705                     STD   ,Y++
DB08 10AF84           (    forth6809.asm):02706                     STY   ,X
DB0B 39               (    forth6809.asm):02707                     RTS
                      (    forth6809.asm):02708         
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
                      (    forth6809.asm):02710         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02711         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02712         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02713         ;    Inputs:
                      (    forth6809.asm):02714         ;        RegX = address of the here pointer
                      (    forth6809.asm):02715         ;        char on the data stack
                      (    forth6809.asm):02716         ;    Outputs:
                      (    forth6809.asm):02717         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02718         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
DB0C 3706             (    forth6809.asm):02720         APPENDBYTE: PULU  D                 ; char
DB0E 10AE84           (    forth6809.asm):02721                     LDY   ,X
DB11 E7A0             (    forth6809.asm):02722                     STB   ,Y+
DB13 10AF84           (    forth6809.asm):02723                     STY   ,X
DB16 39               (    forth6809.asm):02724                     RTS
                      (    forth6809.asm):02725         
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
                      (    forth6809.asm):02727         ; ,  ( x -- )
                      (    forth6809.asm):02728         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02729         ; ------------------------------------------------------------
DB17 8E0008           (    forth6809.asm):02730         COMMAW:     LDX   #CODEHERE
DB1A 7EDB01           (    forth6809.asm):02731                     JMP   APPENDCELL
                      (    forth6809.asm):02732         
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
                      (    forth6809.asm):02734         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02735         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02736         ; ------------------------------------------------------------
DB1D 8E0008           (    forth6809.asm):02737         CODECOMMA:  LDX   #CODEHERE
DB20 7EDB01           (    forth6809.asm):02738                     JMP   APPENDCELL
                      (    forth6809.asm):02739         
                      (    forth6809.asm):02740         ; ------------------------------------------------------------
                      (    forth6809.asm):02741         ; C,  ( char -- )
                      (    forth6809.asm):02742         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02743         ; ------------------------------------------------------------
DB23 8E0008           (    forth6809.asm):02744         CCOMMAW:    LDX   #CODEHERE
DB26 7EDB0C           (    forth6809.asm):02745                     JMP   APPENDBYTE
                      (    forth6809.asm):02746         
                      (    forth6809.asm):02747         ; ------------------------------------------------------------
                      (    forth6809.asm):02748         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02749         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
DB29 8E0008           (    forth6809.asm):02751         CCOMMA1:    LDX   #CODEHERE
DB2C 7EDB0C           (    forth6809.asm):02752                     JMP   APPENDBYTE
                      (    forth6809.asm):02753         
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
                      (    forth6809.asm):02755         ; V,  ( x -- )
                      (    forth6809.asm):02756         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02757         ; ------------------------------------------------------------
DB2F 8E000A           (    forth6809.asm):02758         VCOMMAW:    LDX   #VARHERE
DB32 7EDB01           (    forth6809.asm):02759                     JMP   APPENDCELL
                      (    forth6809.asm):02760         
                      (    forth6809.asm):02761         ; ------------------------------------------------------------
                      (    forth6809.asm):02762         ; VC,  ( char -- )
                      (    forth6809.asm):02763         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02764         ; ------------------------------------------------------------
DB35 8E000A           (    forth6809.asm):02765         VCCOMMAW:   LDX   #VARHERE
DB38 7EDB0C           (    forth6809.asm):02766                     JMP   APPENDBYTE
                      (    forth6809.asm):02767         
                      (    forth6809.asm):02768         ; ------------------------------------------------------------
                      (    forth6809.asm):02769         ; ALLOT  ( n -- )
                      (    forth6809.asm):02770         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
DB3B 3706             (    forth6809.asm):02772         ALLOTW:     PULU  D                 ; n
DB3D 9E08             (    forth6809.asm):02773                     LDX   CODEHERE
DB3F 308B             (    forth6809.asm):02774                     LEAX  D,X
DB41 9F08             (    forth6809.asm):02775                     STX   CODEHERE
DB43 39               (    forth6809.asm):02776                     RTS
                      (    forth6809.asm):02777         
                      (    forth6809.asm):02778         ; ------------------------------------------------------------
                      (    forth6809.asm):02779         ; VALLOT  ( n -- )
                      (    forth6809.asm):02780         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
DB44 3706             (    forth6809.asm):02782         VALLOTW:    PULU  D                 ; n
DB46 9E0A             (    forth6809.asm):02783                     LDX   VARHERE
DB48 308B             (    forth6809.asm):02784                     LEAX  D,X
DB4A 9F0A             (    forth6809.asm):02785                     STX   VARHERE
DB4C 39               (    forth6809.asm):02786                     RTS
                      (    forth6809.asm):02787         
                      (    forth6809.asm):02788         ; ------------------------------------------------------------
                      (    forth6809.asm):02789         ; HERE  ( -- addr )
                      (    forth6809.asm):02790         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
DB4D DC08             (    forth6809.asm):02792         HEREW:      LDD   CODEHERE
DB4F 3606             (    forth6809.asm):02793                     PSHU  D                 ; addr
DB51 39               (    forth6809.asm):02794                     RTS
                      (    forth6809.asm):02795         
                      (    forth6809.asm):02796         ; ------------------------------------------------------------
                      (    forth6809.asm):02797         ; VHERE  ( -- addr )
                      (    forth6809.asm):02798         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02799         ; ------------------------------------------------------------
DB52 DC0A             (    forth6809.asm):02800         VHEREW:     LDD   VARHERE
DB54 3606             (    forth6809.asm):02801                     PSHU  D                 ; addr
DB56 39               (    forth6809.asm):02802                     RTS
                      (    forth6809.asm):02803         
                      (    forth6809.asm):02804         ; ------------------------------------------------------------
                      (    forth6809.asm):02805         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02806         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02807         ; ------------------------------------------------------------
DB57 DC08             (    forth6809.asm):02808         PADW:       LDD   CODEHERE
DB59 C30080           (    forth6809.asm):02809                     ADDD  #PADOFFSET
DB5C 3606             (    forth6809.asm):02810                     PSHU  D                 ; c-addr
DB5E 39               (    forth6809.asm):02811                     RTS
                      (    forth6809.asm):02812         
                      (    forth6809.asm):02813         ; ------------------------------------------------------------
                      (    forth6809.asm):02814         ; UNUSED  ( -- u )
                      (    forth6809.asm):02815         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02816         ; ------------------------------------------------------------
DB5F CCB900           (    forth6809.asm):02817         UNUSEDW:    LDD   #CODETOP
DB62 9308             (    forth6809.asm):02818                     SUBD  CODEHERE
DB64 3606             (    forth6809.asm):02819                     PSHU  D                 ; u
DB66 39               (    forth6809.asm):02820                     RTS
                      (    forth6809.asm):02821         
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
                      (    forth6809.asm):02823         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02824         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02825         ; ------------------------------------------------------------
DB67 CC1FFF           (    forth6809.asm):02826         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DB6A 930A             (    forth6809.asm):02827                     SUBD  VARHERE
DB6C 3606             (    forth6809.asm):02828                     PSHU  D                 ; u
DB6E 39               (    forth6809.asm):02829                     RTS
                      (    forth6809.asm):02830         
                      (    forth6809.asm):02831         ; ============================================================
                      (    forth6809.asm):02832         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02833         ; ============================================================
                      (    forth6809.asm):02834         ; ------------------------------------------------------------
                      (    forth6809.asm):02835         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02836         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02837         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02838         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02839         ; wordlist are updated.
                      (    forth6809.asm):02840         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02841         ;    Inputs:
                      (    forth6809.asm):02842         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02843         ;        name parsed from the input stream
                      (    forth6809.asm):02844         ;    Outputs:
                      (    forth6809.asm):02845         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02846         ;        LATEST = address of the new header
                      (    forth6809.asm):02847         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02848         ; ------------------------------------------------------------
DB6F CC0020           (    forth6809.asm):02849         HEADER:     LDD   #32
DB72 3606             (    forth6809.asm):02850                     PSHU  D
DB74 BDDEB5           (    forth6809.asm):02851                     JSR   WORDW
DB77 3710             (    forth6809.asm):02852                     PULU  X                 ; c-addr of the name
DB79 3706             (    forth6809.asm):02853                     PULU  D                 ; smudge flag in B
DB7B A680             (    forth6809.asm):02854                     LDA   ,X+               ; name length, X = name text
DB7D 3402             (    forth6809.asm):02855                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DB7F 5D               (    forth6809.asm):02856                     TSTB
DB80 2702             (    forth6809.asm):02857                     BEQ   HDNOSM
DB82 8A40             (    forth6809.asm):02858                     ORA   #$40
DB84 109E06           (    forth6809.asm):02859         HDNOSM:     LDY   DPHERE
DB87 3420             (    forth6809.asm):02860                     PSHS  Y                 ; 0,S = address of the new header
DB89 A7A0             (    forth6809.asm):02861                     STA   ,Y+
DB8B E662             (    forth6809.asm):02862                     LDB   2,S
DB8D 2707             (    forth6809.asm):02863                     BEQ   HDNONM
DB8F A680             (    forth6809.asm):02864         HDCPY:      LDA   ,X+
DB91 A7A0             (    forth6809.asm):02865                     STA   ,Y+
DB93 5A               (    forth6809.asm):02866                     DECB
DB94 26F9             (    forth6809.asm):02867                     BNE   HDCPY
DB96 9E47             (    forth6809.asm):02868         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
DB98 EC84             (    forth6809.asm):02869                     LDD   ,X
DB9A EDA1             (    forth6809.asm):02870                     STD   ,Y++              ; LINK = old head of that wordlist
DB9C DC08             (    forth6809.asm):02871                     LDD   CODEHERE
DB9E EDA1             (    forth6809.asm):02872                     STD   ,Y++
DBA0 109F06           (    forth6809.asm):02873                     STY   DPHERE
DBA3 3506             (    forth6809.asm):02874                     PULS  D
DBA5 DD04             (    forth6809.asm):02875                     STD   LATEST            ; LATEST = newest header of any wordlist
DBA7 ED84             (    forth6809.asm):02876                     STD   ,X                ; and the new head of the CURRENT wordlist
DBA9 3261             (    forth6809.asm):02877                     LEAS  1,S
DBAB 39               (    forth6809.asm):02878                     RTS
                      (    forth6809.asm):02879         
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
                      (    forth6809.asm):02881         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):02882         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):02883         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):02884         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):02885         ; SMUDGE   ( -- )
                      (    forth6809.asm):02886         ;    Inputs:
                      (    forth6809.asm):02887         ;        none
                      (    forth6809.asm):02888         ;    Outputs:
                      (    forth6809.asm):02889         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):02890         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
DBAC 9E04             (    forth6809.asm):02892         SMUDGEW:    LDX   LATEST
DBAE A684             (    forth6809.asm):02893                     LDA   ,X
DBB0 8840             (    forth6809.asm):02894                     EORA  #$40
DBB2 A784             (    forth6809.asm):02895                     STA   ,X
DBB4 39               (    forth6809.asm):02896                     RTS
                      (    forth6809.asm):02897         
                      (    forth6809.asm):02898         ; ============================================================
                      (    forth6809.asm):02899         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02900         ; ============================================================
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
                      (    forth6809.asm):02902         ; :  ( "name" -- )
                      (    forth6809.asm):02903         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02904         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02905         ; CSP and enter compile state.
                      (    forth6809.asm):02906         ; ------------------------------------------------------------
DBB5 CCFFFF           (    forth6809.asm):02907         COLONW:     LDD   #TRUEV
DBB8 3606             (    forth6809.asm):02908                     PSHU  D
DBBA BDDB6F           (    forth6809.asm):02909                     JSR   HEADER
DBBD DC08             (    forth6809.asm):02910                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DBBF DD1F             (    forth6809.asm):02911                     STD   CURXT             ; See bugfix: COLONW.1
DBC1 1F30             (    forth6809.asm):02912                     TFR   U,D
DBC3 DD21             (    forth6809.asm):02913                     STD   CSP
DBC5 CCFFFF           (    forth6809.asm):02914                     LDD   #-1
DBC8 DD00             (    forth6809.asm):02915                     STD   STATE
DBCA 39               (    forth6809.asm):02916                     RTS
                      (    forth6809.asm):02917         
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
                      (    forth6809.asm):02919         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02920         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02921         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02922         ; new word and return to interpret state.
                      (    forth6809.asm):02923         ; ------------------------------------------------------------
DBCB CC0039           (    forth6809.asm):02924         SEMIW:      LDD   #RTSOPC
DBCE 3606             (    forth6809.asm):02925                     PSHU  D
DBD0 BDDB29           (    forth6809.asm):02926                     JSR   CCOMMA1
DBD3 1F30             (    forth6809.asm):02927                     TFR   U,D
DBD5 109321           (    forth6809.asm):02928                     CMPD  CSP
DBD8 2703             (    forth6809.asm):02929                     BEQ   SEMIOK
DBDA BDE3CD           (    forth6809.asm):02930                     JSR   CFERR
DBDD 9E04             (    forth6809.asm):02931         SEMIOK:     LDX   LATEST
DBDF A684             (    forth6809.asm):02932                     LDA   ,X
DBE1 84BF             (    forth6809.asm):02933                     ANDA  #$BF
DBE3 A784             (    forth6809.asm):02934                     STA   ,X
DBE5 CC0000           (    forth6809.asm):02935                     LDD   #0
DBE8 DD00             (    forth6809.asm):02936                     STD   STATE
DBEA 39               (    forth6809.asm):02937                     RTS
                      (    forth6809.asm):02938         
                      (    forth6809.asm):02939         ; ------------------------------------------------------------
                      (    forth6809.asm):02940         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02941         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02942         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02943         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02944         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02945         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
DBEB DC08             (    forth6809.asm):02947         NONAMEW:    LDD   CODEHERE
DBED 3606             (    forth6809.asm):02948                     PSHU  D                 ; xt
DBEF DD1F             (    forth6809.asm):02949                     STD   CURXT             ; See bugfix: NONAMEW.1
DBF1 1F30             (    forth6809.asm):02950                     TFR   U,D
DBF3 DD21             (    forth6809.asm):02951                     STD   CSP
DBF5 CCFFFF           (    forth6809.asm):02952                     LDD   #-1
DBF8 DD00             (    forth6809.asm):02953                     STD   STATE
DBFA 39               (    forth6809.asm):02954                     RTS
                      (    forth6809.asm):02955         
                      (    forth6809.asm):02956         ; ------------------------------------------------------------
                      (    forth6809.asm):02957         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02958         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02959         ; BLDDOES
                      (    forth6809.asm):02960         ;    Inputs:
                      (    forth6809.asm):02961         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02962         ;    Outputs:
                      (    forth6809.asm):02963         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02964         ;    Registers: all changed.
                      (    forth6809.asm):02965         ; BLDSELF
                      (    forth6809.asm):02966         ;    Inputs:
                      (    forth6809.asm):02967         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02968         ;    Outputs:
                      (    forth6809.asm):02969         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02970         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02971         ;    Registers: all changed.
                      (    forth6809.asm):02972         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02973         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02974         ; ------------------------------------------------------------
DBFB 3406             (    forth6809.asm):02975         BLDDOES:    PSHS  D                 ; behaviour address
DBFD CC0000           (    forth6809.asm):02976                     LDD   #0
DC00 3606             (    forth6809.asm):02977                     PSHU  D
DC02 BDDB6F           (    forth6809.asm):02978                     JSR   HEADER
DC05 CCDA9F           (    forth6809.asm):02979                     LDD   #DODOES
DC08 3606             (    forth6809.asm):02980                     PSHU  D
DC0A BDE83D           (    forth6809.asm):02981                     JSR   CCALL
DC0D 3506             (    forth6809.asm):02982                     PULS  D
DC0F 3606             (    forth6809.asm):02983                     PSHU  D                 ; behaviour address
DC11 BDDB1D           (    forth6809.asm):02984                     JSR   CODECOMMA
DC14 39               (    forth6809.asm):02985                     RTS
                      (    forth6809.asm):02986         
DC15 BDDBFB           (    forth6809.asm):02987         BLDSELF:    JSR   BLDDOES
DC18 DC08             (    forth6809.asm):02988                     LDD   CODEHERE          ; PFA = the cell after this one
DC1A C30002           (    forth6809.asm):02989                     ADDD  #2                ; See bugfix: CONSTANTW.1
DC1D 3606             (    forth6809.asm):02990                     PSHU  D
DC1F BDDB1D           (    forth6809.asm):02991                     JSR   CODECOMMA
DC22 39               (    forth6809.asm):02992                     RTS
                      (    forth6809.asm):02993         
                      (    forth6809.asm):02994         ; ------------------------------------------------------------
                      (    forth6809.asm):02995         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02996         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02997         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02998         ; address in the code area, on the stack.
                      (    forth6809.asm):02999         ; ------------------------------------------------------------
DC23 CCDAAA           (    forth6809.asm):03000         CREATEW:    LDD   #DOESRT0
DC26 BDDC15           (    forth6809.asm):03001                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DC29 39               (    forth6809.asm):03002                     RTS
                      (    forth6809.asm):03003         
                      (    forth6809.asm):03004         ; ------------------------------------------------------------
                      (    forth6809.asm):03005         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03006         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03007         ; of the word being defined.
                      (    forth6809.asm):03008         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03009         ; ------------------------------------------------------------
DC2A CCDAAB           (    forth6809.asm):03010         DOESGTW:    LDD   #SETDOES
DC2D 3606             (    forth6809.asm):03011                     PSHU  D
DC2F BDE83D           (    forth6809.asm):03012                     JSR   CCALL
DC32 39               (    forth6809.asm):03013                     RTS
                      (    forth6809.asm):03014         
                      (    forth6809.asm):03015         ; ------------------------------------------------------------
                      (    forth6809.asm):03016         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03017         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03018         ; area, initialised to zero.
                      (    forth6809.asm):03019         ; ------------------------------------------------------------
DC33 CC0000           (    forth6809.asm):03020         VARIABLEW:  LDD   #0
DC36 3606             (    forth6809.asm):03021                     PSHU  D
DC38 BDDB6F           (    forth6809.asm):03022                     JSR   HEADER
DC3B CCDA9F           (    forth6809.asm):03023                     LDD   #DODOES
DC3E 3606             (    forth6809.asm):03024                     PSHU  D
DC40 BDE83D           (    forth6809.asm):03025                     JSR   CCALL
DC43 CCDAAA           (    forth6809.asm):03026                     LDD   #DOESRT0
DC46 3606             (    forth6809.asm):03027                     PSHU  D
DC48 BDDB1D           (    forth6809.asm):03028                     JSR   CODECOMMA
DC4B DC0A             (    forth6809.asm):03029                     LDD   VARHERE
DC4D 3606             (    forth6809.asm):03030                     PSHU  D
DC4F BDDB1D           (    forth6809.asm):03031                     JSR   CODECOMMA
DC52 CC0000           (    forth6809.asm):03032                     LDD   #0
DC55 9E0A             (    forth6809.asm):03033                     LDX   VARHERE
DC57 ED81             (    forth6809.asm):03034                     STD   ,X++
DC59 9F0A             (    forth6809.asm):03035                     STX   VARHERE
DC5B 39               (    forth6809.asm):03036                     RTS
                      (    forth6809.asm):03037         
                      (    forth6809.asm):03038         ; ------------------------------------------------------------
                      (    forth6809.asm):03039         ; @  ( a-addr -- x )
                      (    forth6809.asm):03040         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03041         ; ------------------------------------------------------------
DC5C 3710             (    forth6809.asm):03042         FETCHW:     PULU  X                 ; a-addr
DC5E EC84             (    forth6809.asm):03043                     LDD   ,X
DC60 3606             (    forth6809.asm):03044                     PSHU  D                 ; x
DC62 39               (    forth6809.asm):03045                     RTS
                      (    forth6809.asm):03046         
                      (    forth6809.asm):03047         ; ------------------------------------------------------------
                      (    forth6809.asm):03048         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03049         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03050         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03051         ; ------------------------------------------------------------
DC63 CCDC5C           (    forth6809.asm):03052         CONSTANTW:  LDD   #FETCHW
DC66 BDDC15           (    forth6809.asm):03053                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DC69 BDDB17           (    forth6809.asm):03054                     JSR   COMMAW
DC6C 39               (    forth6809.asm):03055                     RTS
                      (    forth6809.asm):03056         
                      (    forth6809.asm):03057         ; ------------------------------------------------------------
                      (    forth6809.asm):03058         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03059         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03060         ;    Inputs:
                      (    forth6809.asm):03061         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03062         ;    Outputs:
                      (    forth6809.asm):03063         ;        pfa replaced by the value
                      (    forth6809.asm):03064         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03065         ; ------------------------------------------------------------
DC6D 3710             (    forth6809.asm):03066         DOVALUE:    PULU  X                 ; pfa
DC6F EC84             (    forth6809.asm):03067                     LDD   ,X
DC71 3606             (    forth6809.asm):03068                     PSHU  D                 ; x
DC73 39               (    forth6809.asm):03069                     RTS
                      (    forth6809.asm):03070         
                      (    forth6809.asm):03071         ; ------------------------------------------------------------
                      (    forth6809.asm):03072         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03073         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03074         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03075         ; ------------------------------------------------------------
DC74 CCDC6D           (    forth6809.asm):03076         VALUEW:     LDD   #DOVALUE
DC77 BDDBFB           (    forth6809.asm):03077                     JSR   BLDDOES
DC7A DC0A             (    forth6809.asm):03078                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DC7C 3606             (    forth6809.asm):03079                     PSHU  D                 ; See bugfix: VALUEW.1
DC7E BDDB1D           (    forth6809.asm):03080                     JSR   CODECOMMA
DC81 BDDB2F           (    forth6809.asm):03081                     JSR   VCOMMAW           ; store x in the variable area
DC84 39               (    forth6809.asm):03082                     RTS
                      (    forth6809.asm):03083         
                      (    forth6809.asm):03084         ; ------------------------------------------------------------
                      (    forth6809.asm):03085         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03086         ; lower address as 2@ expects.

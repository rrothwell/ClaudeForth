E0E5 3263             (    forth6809.asm):03542         FDRET:      LEAS  3,S
E0E7 39               (    forth6809.asm):03543                     RTS
                      (    forth6809.asm):03544         
                      (    forth6809.asm):03545         ; ------------------------------------------------------------
                      (    forth6809.asm):03546         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03547         ; ROOT, for a name.
                      (    forth6809.asm):03548         ; SRCHORD
                      (    forth6809.asm):03549         ;    Inputs:
                      (    forth6809.asm):03550         ;        RegY = address of the name text
                      (    forth6809.asm):03551         ;        RegB = name length
                      (    forth6809.asm):03552         ;    Outputs:
                      (    forth6809.asm):03553         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03554         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03555         ; ------------------------------------------------------------
E0E8 3424             (    forth6809.asm):03556         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
E0EA 8E004B           (    forth6809.asm):03557                     LDX   #ORDER
E0ED 3410             (    forth6809.asm):03558                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
E0EF AEE4             (    forth6809.asm):03559         SOLOOP:     LDX   ,S
E0F1 9C49             (    forth6809.asm):03560                     CMPX  ORDEND
E0F3 2415             (    forth6809.asm):03561                     BHS   SOROOT
E0F5 10AE81           (    forth6809.asm):03562                     LDY   ,X++              ; WID
E0F8 AFE4             (    forth6809.asm):03563                     STX   ,S
E0FA AEA4             (    forth6809.asm):03564                     LDX   ,Y                ; newest header of that wordlist
E0FC 10AE63           (    forth6809.asm):03565                     LDY   3,S
E0FF E662             (    forth6809.asm):03566                     LDB   2,S
E101 8DA8             (    forth6809.asm):03567                     BSR   FDSEARCH
E103 8C0000           (    forth6809.asm):03568                     CMPX  #0
E106 27E7             (    forth6809.asm):03569                     BEQ   SOLOOP
E108 2009             (    forth6809.asm):03570                     BRA   SORDONE
E10A 9E5D             (    forth6809.asm):03571         SOROOT:     LDX   WLHEADS+2         ; ROOT
E10C 10AE63           (    forth6809.asm):03572                     LDY   3,S
E10F E662             (    forth6809.asm):03573                     LDB   2,S
E111 8D98             (    forth6809.asm):03574                     BSR   FDSEARCH
E113 3265             (    forth6809.asm):03575         SORDONE:    LEAS  5,S
E115 39               (    forth6809.asm):03576                     RTS
                      (    forth6809.asm):03577         
                      (    forth6809.asm):03578         ; ------------------------------------------------------------
                      (    forth6809.asm):03579         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03580         ; HDRXT
                      (    forth6809.asm):03581         ;    Inputs:
                      (    forth6809.asm):03582         ;        RegX = header
                      (    forth6809.asm):03583         ;    Outputs:
                      (    forth6809.asm):03584         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03585         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03586         ; ------------------------------------------------------------
E116 A684             (    forth6809.asm):03587         HDRXT:      LDA   ,X
E118 1F89             (    forth6809.asm):03588                     TFR   A,B
E11A C41F             (    forth6809.asm):03589                     ANDB  #$1F
E11C 3001             (    forth6809.asm):03590                     LEAX  1,X
E11E 3A               (    forth6809.asm):03591                     ABX
E11F AE02             (    forth6809.asm):03592                     LDX   2,X               ; CFA field
E121 39               (    forth6809.asm):03593                     RTS
                      (    forth6809.asm):03594         
                      (    forth6809.asm):03595         ; ------------------------------------------------------------
                      (    forth6809.asm):03596         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03597         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03598         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03599         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03600         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03601         ; ------------------------------------------------------------
E122 10AEC4           (    forth6809.asm):03602         FINDW:      LDY   ,U                ; counted string
E125 E6A0             (    forth6809.asm):03603                     LDB   ,Y+
E127 8DBF             (    forth6809.asm):03604                     BSR   SRCHORD
E129 8C0000           (    forth6809.asm):03605                     CMPX  #0
E12C 2712             (    forth6809.asm):03606                     BEQ   NOTFOUND
E12E 8DE6             (    forth6809.asm):03607                     BSR   HDRXT
E130 AFC4             (    forth6809.asm):03608                     STX   ,U                ; xt replaces c-addr
E132 4D               (    forth6809.asm):03609                     TSTA
E133 2A05             (    forth6809.asm):03610                     BPL   FISNORM
E135 CC0001           (    forth6809.asm):03611                     LDD   #1
E138 2003             (    forth6809.asm):03612                     BRA   FPUSH
E13A CCFFFF           (    forth6809.asm):03613         FISNORM:    LDD   #-1
E13D 3606             (    forth6809.asm):03614         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
E13F 39               (    forth6809.asm):03615                     RTS
                      (    forth6809.asm):03616         
E140 CC0000           (    forth6809.asm):03617         NOTFOUND:   LDD   #0
E143 3606             (    forth6809.asm):03618                     PSHU  D                 ; 0 = not found, c-addr still beneath
E145 39               (    forth6809.asm):03619                     RTS
                      (    forth6809.asm):03620         
                      (    forth6809.asm):03621         ; ------------------------------------------------------------
                      (    forth6809.asm):03622         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03623         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03624         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03625         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03626         ; ------------------------------------------------------------
E146 3710             (    forth6809.asm):03627         SEARCHWLW:  PULU  X                 ; wid
E148 8D2D             (    forth6809.asm):03628                     BSR   WIDCHK
E14A AE84             (    forth6809.asm):03629                     LDX   ,X                ; newest header of the wordlist
E14C 3706             (    forth6809.asm):03630                     PULU  D                 ; u
E14E 3720             (    forth6809.asm):03631                     PULU  Y                 ; c-addr
E150 4D               (    forth6809.asm):03632                     TSTA
E151 261E             (    forth6809.asm):03633                     BNE   SWNOT             ; longer than any name
E153 C11F             (    forth6809.asm):03634                     CMPB  #31
E155 221A             (    forth6809.asm):03635                     BHI   SWNOT
E157 BDE0AB           (    forth6809.asm):03636                     JSR   FDSEARCH
E15A 8C0000           (    forth6809.asm):03637                     CMPX  #0
E15D 2712             (    forth6809.asm):03638                     BEQ   SWNOT
E15F 8DB5             (    forth6809.asm):03639                     BSR   HDRXT
E161 3610             (    forth6809.asm):03640                     PSHU  X                 ; xt
E163 4D               (    forth6809.asm):03641                     TSTA
E164 2A05             (    forth6809.asm):03642                     BPL   SWNORM
E166 CC0001           (    forth6809.asm):03643                     LDD   #1
E169 2003             (    forth6809.asm):03644                     BRA   SWPUSH
E16B CCFFFF           (    forth6809.asm):03645         SWNORM:     LDD   #-1
E16E 3606             (    forth6809.asm):03646         SWPUSH:     PSHU  D
E170 39               (    forth6809.asm):03647                     RTS
E171 CC0000           (    forth6809.asm):03648         SWNOT:      LDD   #0
E174 3606             (    forth6809.asm):03649                     PSHU  D
E176 39               (    forth6809.asm):03650                     RTS
                      (    forth6809.asm):03651         
                      (    forth6809.asm):03652         ; ------------------------------------------------------------
                      (    forth6809.asm):03653         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03654         ; WIDCHK
                      (    forth6809.asm):03655         ;    Inputs:
                      (    forth6809.asm):03656         ;        RegX = candidate WID
                      (    forth6809.asm):03657         ;    Outputs:
                      (    forth6809.asm):03658         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03659         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03660         ; ------------------------------------------------------------
E177 1F10             (    forth6809.asm):03661         WIDCHK:     TFR   X,D
E179 83005B           (    forth6809.asm):03662                     SUBD  #WLHEADS
E17C 2509             (    forth6809.asm):03663                     BCS   WIDBAD
E17E C501             (    forth6809.asm):03664                     BITB  #1
E180 2605             (    forth6809.asm):03665                     BNE   WIDBAD
E182 9C45             (    forth6809.asm):03666                     CMPX  WLEND
E184 2401             (    forth6809.asm):03667                     BHS   WIDBAD
E186 39               (    forth6809.asm):03668                     RTS
E187 CCFFF5           (    forth6809.asm):03669         WIDBAD:     LDD   #-11
E18A 3606             (    forth6809.asm):03670                     PSHU  D
E18C 7EE541           (    forth6809.asm):03671                     JMP   THROWW
                      (    forth6809.asm):03672         
                      (    forth6809.asm):03673         ; ------------------------------------------------------------
                      (    forth6809.asm):03674         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03675         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03676         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03677         ; WLINIT
                      (    forth6809.asm):03678         ;    Inputs:
                      (    forth6809.asm):03679         ;        none
                      (    forth6809.asm):03680         ;    Outputs:
                      (    forth6809.asm):03681         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03682         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03683         ; ------------------------------------------------------------
E18F CCD94C           (    forth6809.asm):03684         WLINIT:     LDD   #BASELATEST
E192 DD5B             (    forth6809.asm):03685                     STD   WLHEADS
E194 CCD064           (    forth6809.asm):03686                     LDD   #BASEROOTLATEST
E197 DD5D             (    forth6809.asm):03687                     STD   WLHEADS+2
E199 CCD064           (    forth6809.asm):03688                     LDD   #H_FORTH
E19C DD6F             (    forth6809.asm):03689                     STD   WLNAMES
E19E CCD05B           (    forth6809.asm):03690                     LDD   #H_ROOT
E1A1 DD71             (    forth6809.asm):03691                     STD   WLNAMES+2
E1A3 CC005F           (    forth6809.asm):03692                     LDD   #WLHEADS+4
E1A6 DD45             (    forth6809.asm):03693                     STD   WLEND
E1A8 CC005B           (    forth6809.asm):03694                     LDD   #WLHEADS
E1AB DD47             (    forth6809.asm):03695                     STD   CURRENT
E1AD 7EE27D           (    forth6809.asm):03696                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03697         
                      (    forth6809.asm):03698         ; ------------------------------------------------------------
                      (    forth6809.asm):03699         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03700         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03701         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03702         ; PRUNE
                      (    forth6809.asm):03703         ;    Inputs:
                      (    forth6809.asm):03704         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03705         ;    Outputs:
                      (    forth6809.asm):03706         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03707         ;        into ROM
                      (    forth6809.asm):03708         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
E1B0 3406             (    forth6809.asm):03710         PRUNE:      PSHS  D                 ; 0,S = mark
E1B2 8E005B           (    forth6809.asm):03711                     LDX   #WLHEADS
E1B5 9C45             (    forth6809.asm):03712         PRLOOP:     CMPX  WLEND
E1B7 2421             (    forth6809.asm):03713                     BHS   PRNDONE
E1B9 10AE84           (    forth6809.asm):03714                     LDY   ,X                ; newest header of this wordlist
E1BC 108CC000         (    forth6809.asm):03715         PRWALK:     CMPY  #ROMSTRT
E1C0 2413             (    forth6809.asm):03716                     BHS   PRSTORE           ; ROM header: keep
E1C2 10ACE4           (    forth6809.asm):03717                     CMPY  ,S
E1C5 250E             (    forth6809.asm):03718                     BLO   PRSTORE           ; below the mark (or empty): keep
E1C7 E6A4             (    forth6809.asm):03719                     LDB   ,Y
E1C9 C41F             (    forth6809.asm):03720                     ANDB  #$1F
E1CB 4F               (    forth6809.asm):03721                     CLRA
E1CC 3121             (    forth6809.asm):03722                     LEAY  1,Y
E1CE 31AB             (    forth6809.asm):03723                     LEAY  D,Y
E1D0 10AEA4           (    forth6809.asm):03724                     LDY   ,Y                ; follow the LINK
E1D3 20E7             (    forth6809.asm):03725                     BRA   PRWALK
E1D5 10AF81           (    forth6809.asm):03726         PRSTORE:    STY   ,X++
E1D8 20DB             (    forth6809.asm):03727                     BRA   PRLOOP
E1DA 3262             (    forth6809.asm):03728         PRNDONE:     LEAS  2,S
E1DC 39               (    forth6809.asm):03729                     RTS
                      (    forth6809.asm):03730         
                      (    forth6809.asm):03731         ; ============================================================
                      (    forth6809.asm):03732         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03733         ; ============================================================
                      (    forth6809.asm):03734         ; ------------------------------------------------------------
                      (    forth6809.asm):03735         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03736         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03737         ; ------------------------------------------------------------
E1DD 9E45             (    forth6809.asm):03738         WORDLISTW:  LDX   WLEND
E1DF 8C006F           (    forth6809.asm):03739                     CMPX  #WLHEADS+2*WLCELLS
E1E2 240F             (    forth6809.asm):03740                     BHS   WLFULL
E1E4 CC0000           (    forth6809.asm):03741                     LDD   #0
E1E7 ED84             (    forth6809.asm):03742                     STD   ,X
E1E9 ED8814           (    forth6809.asm):03743                     STD   WLNOFF,X
E1EC 3610             (    forth6809.asm):03744                     PSHU  X
E1EE 3002             (    forth6809.asm):03745                     LEAX  2,X
E1F0 9F45             (    forth6809.asm):03746                     STX   WLEND
E1F2 39               (    forth6809.asm):03747                     RTS
E1F3 CCFFF8           (    forth6809.asm):03748         WLFULL:     LDD   #-8
E1F6 3606             (    forth6809.asm):03749                     PSHU  D
E1F8 7EE541           (    forth6809.asm):03750                     JMP   THROWW
                      (    forth6809.asm):03751         
                      (    forth6809.asm):03752         ; ------------------------------------------------------------
                      (    forth6809.asm):03753         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03754         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03755         ; ------------------------------------------------------------
E1FB CC005B           (    forth6809.asm):03756         FORTHWLW:   LDD   #WLHEADS
E1FE 3606             (    forth6809.asm):03757                     PSHU  D
E200 39               (    forth6809.asm):03758                     RTS
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03762         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03763         ; it, as it is always searched last.
                      (    forth6809.asm):03764         ; ------------------------------------------------------------
E201 9E49             (    forth6809.asm):03765         GETORDERW:  LDX   ORDEND
E203 8C004B           (    forth6809.asm):03766         GOLOOP:     CMPX  #ORDER
E206 2306             (    forth6809.asm):03767                     BLS   GODONE
E208 EC83             (    forth6809.asm):03768                     LDD   ,--X
E20A 3606             (    forth6809.asm):03769                     PSHU  D
E20C 20F5             (    forth6809.asm):03770                     BRA   GOLOOP
E20E DC49             (    forth6809.asm):03771         GODONE:     LDD   ORDEND
E210 83004B           (    forth6809.asm):03772                     SUBD  #ORDER
E213 44               (    forth6809.asm):03773                     LSRA
E214 56               (    forth6809.asm):03774                     RORB
E215 3606             (    forth6809.asm):03775                     PSHU  D                 ; n
E217 39               (    forth6809.asm):03776                     RTS
                      (    forth6809.asm):03777         
                      (    forth6809.asm):03778         ; ------------------------------------------------------------
                      (    forth6809.asm):03779         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03780         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03781         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03782         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03783         ; ------------------------------------------------------------
E218 3706             (    forth6809.asm):03784         SETORDERW:  PULU  D                 ; n
E21A 1083FFFF         (    forth6809.asm):03785                     CMPD  #-1
E21E 275D             (    forth6809.asm):03786                     BEQ   ONLYW             ; the minimum order
E220 4D               (    forth6809.asm):03787         SO1:        TSTA
E221 2B31             (    forth6809.asm):03788                     BMI   SOUNDER
E223 262A             (    forth6809.asm):03789                     BNE   SOOVER
E225 C108             (    forth6809.asm):03790                     CMPB  #WLMAX
E227 2226             (    forth6809.asm):03791                     BHI   SOOVER
E229 3404             (    forth6809.asm):03792                     PSHS  B                 ; 1,S = n
E22B 3404             (    forth6809.asm):03793                     PSHS  B                 ; 0,S = count down
E22D 1F32             (    forth6809.asm):03794                     TFR   U,Y
E22F 6DE4             (    forth6809.asm):03795         SOCHK:      TST   ,S
E231 2709             (    forth6809.asm):03796                     BEQ   SOCOPY
E233 AEA1             (    forth6809.asm):03797                     LDX   ,Y++
E235 BDE177           (    forth6809.asm):03798                     JSR   WIDCHK            ; keeps Y
E238 6AE4             (    forth6809.asm):03799                     DEC   ,S
E23A 20F3             (    forth6809.asm):03800                     BRA   SOCHK
E23C 3506             (    forth6809.asm):03801         SOCOPY:     PULS  A,B               ; B = n
E23E 8E004B           (    forth6809.asm):03802                     LDX   #ORDER
E241 5D               (    forth6809.asm):03803         SOCP2:      TSTB
E242 2708             (    forth6809.asm):03804                     BEQ   SOCPEND
E244 3720             (    forth6809.asm):03805                     PULU  Y
E246 10AF81           (    forth6809.asm):03806                     STY   ,X++
E249 5A               (    forth6809.asm):03807                     DECB
E24A 20F5             (    forth6809.asm):03808                     BRA   SOCP2
E24C 9F49             (    forth6809.asm):03809         SOCPEND:    STX   ORDEND
E24E 39               (    forth6809.asm):03810                     RTS
E24F CCFFCF           (    forth6809.asm):03811         SOOVER:     LDD   #-49
E252 2003             (    forth6809.asm):03812                     BRA   SOTHROW
E254 CCFFCE           (    forth6809.asm):03813         SOUNDER:    LDD   #-50
E257 3606             (    forth6809.asm):03814         SOTHROW:    PSHU  D
E259 7EE541           (    forth6809.asm):03815                     JMP   THROWW
                      (    forth6809.asm):03816         
                      (    forth6809.asm):03817         ; ------------------------------------------------------------
                      (    forth6809.asm):03818         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03819         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03820         ; ------------------------------------------------------------
E25C DC47             (    forth6809.asm):03821         GETCURW:    LDD   CURRENT
E25E 3606             (    forth6809.asm):03822                     PSHU  D
E260 39               (    forth6809.asm):03823                     RTS
                      (    forth6809.asm):03824         
                      (    forth6809.asm):03825         ; ------------------------------------------------------------
                      (    forth6809.asm):03826         ; SET-CURRENT  ( wid -- )
                      (    forth6809.asm):03827         ; Make wid the wordlist that receives new definitions. Throws -11 for
                      (    forth6809.asm):03828         ; an invalid wid.
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
E261 3710             (    forth6809.asm):03830         SETCURW:    PULU  X
E263 BDE177           (    forth6809.asm):03831                     JSR   WIDCHK
E266 9F47             (    forth6809.asm):03832                     STX   CURRENT
E268 39               (    forth6809.asm):03833                     RTS
                      (    forth6809.asm):03834         
                      (    forth6809.asm):03835         ; ------------------------------------------------------------
                      (    forth6809.asm):03836         ; DEFINITIONS  ( -- )
                      (    forth6809.asm):03837         ; Make the first wordlist of the search order the one that receives new
                      (    forth6809.asm):03838         ; definitions. Throws -50 when the search order is empty.
                      (    forth6809.asm):03839         ; ------------------------------------------------------------
E269                  (    forth6809.asm):03840         DEFINITIONSW:
E269 8E004B           (    forth6809.asm):03841                     LDX   #ORDER
E26C 9C49             (    forth6809.asm):03842                     CMPX  ORDEND
E26E 2405             (    forth6809.asm):03843                     BHS   DFUNDER
E270 EC84             (    forth6809.asm):03844                     LDD   ,X
E272 DD47             (    forth6809.asm):03845                     STD   CURRENT
E274 39               (    forth6809.asm):03846                     RTS
E275 CCFFCE           (    forth6809.asm):03847         DFUNDER:    LDD   #-50
E278 3606             (    forth6809.asm):03848                     PSHU  D
E27A 7EE541           (    forth6809.asm):03849                     JMP   THROWW
                      (    forth6809.asm):03850         
                      (    forth6809.asm):03851         ; ------------------------------------------------------------
                      (    forth6809.asm):03852         ; ONLY  ( -- )
                      (    forth6809.asm):03853         ; Set the minimum search order: FORTH only (ROOT is still searched).
                      (    forth6809.asm):03854         ; ------------------------------------------------------------
E27D CC005B           (    forth6809.asm):03855         ONLYW:      LDD   #WLHEADS
E280 DD4B             (    forth6809.asm):03856                     STD   ORDER
E282 CC004D           (    forth6809.asm):03857                     LDD   #ORDER+2
E285 DD49             (    forth6809.asm):03858                     STD   ORDEND
E287 39               (    forth6809.asm):03859                     RTS
                      (    forth6809.asm):03860         
                      (    forth6809.asm):03861         ; ------------------------------------------------------------
                      (    forth6809.asm):03862         ; Replace the first wordlist of the search order with the WID in RegX,
                      (    forth6809.asm):03863         ; or make it the only one if the order is empty.
                      (    forth6809.asm):03864         ; SETTOP
                      (    forth6809.asm):03865         ;    Inputs:
                      (    forth6809.asm):03866         ;        RegX = WID
                      (    forth6809.asm):03867         ;    Outputs:
                      (    forth6809.asm):03868         ;        ORDER(0) = WID; ORDEND at least ORDER+2
                      (    forth6809.asm):03869         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03870         ; ------------------------------------------------------------

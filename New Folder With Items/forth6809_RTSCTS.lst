F51D CCF508           (    forth6809.asm):07589                     LDD   #DOTSTR
F520 7EF3EC           (    forth6809.asm):07590                     JMP   CSTRCOMP
                      (    forth6809.asm):07591         
                      (    forth6809.asm):07592         ; ------------------------------------------------------------
                      (    forth6809.asm):07593         ; Run-time part of C"  The counted string follows the call: push its
                      (    forth6809.asm):07594         ; address and skip over it.
                      (    forth6809.asm):07595         ; DOCSTR
                      (    forth6809.asm):07596         ;    Outputs:
                      (    forth6809.asm):07597         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):07598         ;        the string

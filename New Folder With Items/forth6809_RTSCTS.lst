                      (    forth6809.asm):05133         ; ------------------------------------------------------------
                      (    forth6809.asm):05134         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05135         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05136         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05137         ; ------------------------------------------------------------
E8A0 CC0000           (    forth6809.asm):05138         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
E8A3 3606             (    forth6809.asm):05139                     PSHU  D
E8A5 CC0004           (    forth6809.asm):05140                     LDD   #TAGCASE
E8A8 3606             (    forth6809.asm):05141                     PSHU  D

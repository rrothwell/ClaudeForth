DEDE BDDCC8           (    forth6809.asm):03210                     JSR   VALLOTW
DEE1 39               (    forth6809.asm):03211                     RTS
                      (    forth6809.asm):03212         
                      (    forth6809.asm):03213         ; ------------------------------------------------------------
                      (    forth6809.asm):03214         ; DEFER  ( "name" -- )
                      (    forth6809.asm):03215         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):03216         ; throws -21.

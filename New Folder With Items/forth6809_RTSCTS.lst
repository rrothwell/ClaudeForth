                      (    forth6809.asm):04210         ; ============================================================
                      (    forth6809.asm):04211         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04212         ; ============================================================
                      (    forth6809.asm):04213                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04214         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04215         
                      (    forth6809.asm):04216         ; ------------------------------------------------------------
                      (    forth6809.asm):04217         ; KEY  ( -- char )
                      (    forth6809.asm):04218         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04219         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04220         ; ------------------------------------------------------------
E44D                  (    forth6809.asm):04221         KEYW:
                      (    forth6809.asm):04222         
E44D 7D0178           (    forth6809.asm):04223                     TST   RTSSTATE          ; Is throttling?
E450 2703             (    forth6809.asm):04224                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04225         
                      (    forth6809.asm):04226                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E452 BDD9E0           (    forth6809.asm):04227                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04228                                             ; by transmitting all chars.
                      (    forth6809.asm):04229         
E455                  (    forth6809.asm):04230         TRY_READ:
E455 BDDA4D           (    forth6809.asm):04231                     JSR   GETCHAR           ; Is char available in input buffer.
E458 25F3             (    forth6809.asm):04232                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04233                                             ; while still transmitting!
                      (    forth6809.asm):04234         
E45A 1F89             (    forth6809.asm):04235                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E45C 4F               (    forth6809.asm):04236                     CLRA                    ; Clear MSB.
E45D 3606             (    forth6809.asm):04237                     PSHU  D                 ; char
                      (    forth6809.asm):04238         
E45F 39               (    forth6809.asm):04239                     RTS
                      (    forth6809.asm):04240         
                      (    forth6809.asm):04241         ; ------------------------------------------------------------
                      (    forth6809.asm):04242         ; KEY?  ( -- flag )
                      (    forth6809.asm):04243         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04244         ; ------------------------------------------------------------
E460                  (    forth6809.asm):04245         KEYQW:
                      (    forth6809.asm):04246                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04247         
E460 B60176           (    forth6809.asm):04248                     LDA   INHEAD            ; Characters received?
E463 B10177           (    forth6809.asm):04249                     CMPA  INTAIL
                      (    forth6809.asm):04250         
                      (    forth6809.asm):04251                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04252         
E466 2606             (    forth6809.asm):04253                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04254         
E468 CC0000           (    forth6809.asm):04255                     LDD   #FALSEV           ; No! Return false result.
E46B 3606             (    forth6809.asm):04256                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04257         
E46D 39               (    forth6809.asm):04258                     RTS
                      (    forth6809.asm):04259         
E46E                  (    forth6809.asm):04260         KQTRUE:
E46E CCFFFF           (    forth6809.asm):04261                     LDD   #TRUEV            ; Yes! Return true result.
E471 3606             (    forth6809.asm):04262                     PSHU  D                 ; flag = true
E473 39               (    forth6809.asm):04263                     RTS
                      (    forth6809.asm):04264         
                      (    forth6809.asm):04265         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04266         
                      (    forth6809.asm):04267         ; ------------------------------------------------------------
                      (    forth6809.asm):04268         ; EMIT  ( char -- )
                      (    forth6809.asm):04269         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04270         ; discarded if the ring is full.
                      (    forth6809.asm):04271         ; ------------------------------------------------------------
E474                  (    forth6809.asm):04272         EMITW:
E474 3706             (    forth6809.asm):04273                     PULU  D                 ; char
E476 1F98             (    forth6809.asm):04274                     TFR   B,A
E478 BDDA02           (    forth6809.asm):04275                     JSR   PUTCHAR           ; Transmit char.
E47B 39               (    forth6809.asm):04276                     RTS
                      (    forth6809.asm):04277         
                      (    forth6809.asm):04278                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04279         ; ------------------------------------------------------------
                      (    forth6809.asm):04280         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04281         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04282         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04283         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04284         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04285         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04286         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04287         ; follow.
                      (    forth6809.asm):04288         ; ------------------------------------------------------------
E47C                  (    forth6809.asm):04289         KEYW:
                      (    forth6809.asm):04290                     LDA   ACIASR
                      (    forth6809.asm):04291                     BITA  #SR_RDRF
                      (    forth6809.asm):04292                     BEQ   KWAIT
                      (    forth6809.asm):04293                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04294                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E47C                  (    forth6809.asm):04295         KWAIT:
E47C                  (    forth6809.asm):04296         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04297                     BITA  #SR_RDRF
                      (    forth6809.asm):04298                     BEQ   KSPIN
E47C                  (    forth6809.asm):04299         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04300                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04301                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04302                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04303                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04304                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04305                     BEQ   KGETCH
                      (    forth6809.asm):04306                     BITA  #SR_FE
                      (    forth6809.asm):04307                     BEQ   KXFE
                      (    forth6809.asm):04308                     INC   FECOUNT
E47C                  (    forth6809.asm):04309         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04310                     BEQ   KXOVRN
                      (    forth6809.asm):04311                     INC   OVRNCOUNT
E47C                  (    forth6809.asm):04312         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04313                     BEQ   KGETCH
                      (    forth6809.asm):04314                     INC   PECOUNT
E47C                  (    forth6809.asm):04315         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04316                     TFR   A,B
                      (    forth6809.asm):04317                     CLRA
                      (    forth6809.asm):04318                     PSHU  D                 ; char
                      (    forth6809.asm):04319                     RTS
                      (    forth6809.asm):04320         
                      (    forth6809.asm):04321         ; ------------------------------------------------------------
                      (    forth6809.asm):04322         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04323         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04324         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04325         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04326         ;    Inputs:
                      (    forth6809.asm):04327         ;        none
                      (    forth6809.asm):04328         ;    Outputs:
                      (    forth6809.asm):04329         ;        XON or XOFF transmitted
                      (    forth6809.asm):04330         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04331         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04332         ; ------------------------------------------------------------
E47C                  (    forth6809.asm):04333         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04334                     BRA   PUTXCH
E47C                  (    forth6809.asm):04335         PUTXON:     LDA   #XONCH
E47C                  (    forth6809.asm):04336         PUTXCH:     PSHS  A
E47C                  (    forth6809.asm):04337         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04338                     BITB  #SR_TDRE
                      (    forth6809.asm):04339                     BEQ   PXWT
                      (    forth6809.asm):04340                     PULS  A
                      (    forth6809.asm):04341                     STA   ACIADR
                      (    forth6809.asm):04342                     RTS
                      (    forth6809.asm):04343         
                      (    forth6809.asm):04344         ; ------------------------------------------------------------
                      (    forth6809.asm):04345         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04346         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04347         ; ------------------------------------------------------------
E47C                  (    forth6809.asm):04348         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):04349                     BITA  #SR_RDRF
                      (    forth6809.asm):04350                     BEQ   KQFALSE
                      (    forth6809.asm):04351                     LDD   #TRUEV
                      (    forth6809.asm):04352                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04353                     RTS
E47C                  (    forth6809.asm):04354         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04355                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04356                     RTS
                      (    forth6809.asm):04357         
                      (    forth6809.asm):04358         ; ------------------------------------------------------------
                      (    forth6809.asm):04359         ; EMIT  ( char -- )  [polling build]

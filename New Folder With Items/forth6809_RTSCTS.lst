                      (    forth6809.asm):04712         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):04713         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):04714         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):04715         ; ------------------------------------------------------------
E64A CCDC04           (    forth6809.asm):04716         WHILEW:     LDD   #ZBRANCH
E64D 3606             (    forth6809.asm):04717                     PSHU  D
E64F BDE97C           (    forth6809.asm):04718                     JSR   CCALL
E652 CC0000           (    forth6809.asm):04719                     LDD   #0
E655 3606             (    forth6809.asm):04720                     PSHU  D
E657 BDDCA1           (    forth6809.asm):04721                     JSR   CODECOMMA
E65A DC08             (    forth6809.asm):04722                     LDD   CODEHERE
E65C 830002           (    forth6809.asm):04723                     SUBD  #2
E65F 3606             (    forth6809.asm):04724                     PSHU  D                 ; orig
E661 CC0001           (    forth6809.asm):04725                     LDD   #TAGFWD
E664 3606             (    forth6809.asm):04726                     PSHU  D
E666 39               (    forth6809.asm):04727                     RTS
                      (    forth6809.asm):04728         
                      (    forth6809.asm):04729         ; ------------------------------------------------------------
                      (    forth6809.asm):04730         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04731         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04732         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04733         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04734         ; ------------------------------------------------------------
E667 3706             (    forth6809.asm):04735         REPEATW:    PULU  D
E669 10830001         (    forth6809.asm):04736                     CMPD  #TAGFWD
E66D 2703             (    forth6809.asm):04737                     BEQ   RPOK1
E66F BDE50C           (    forth6809.asm):04738                     JSR   CFERR
E672 3710             (    forth6809.asm):04739         RPOK1:      PULU  X                 ; orig
E674 3410             (    forth6809.asm):04740                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04741         
                      (    forth6809.asm):04742                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04743                     ; See bugfix: REPEATW.1
E676 3040             (    forth6809.asm):04744                     LEAX  0,U               ; scan from top of control stack
E678 9F16             (    forth6809.asm):04745                     STX   MSCR2             ; MSCR2 = base of scan region
E67A 9F1A             (    forth6809.asm):04746                     STX   MSCR4             ; MSCR4 = scan pointer
E67C DC1A             (    forth6809.asm):04747         RPSCAN:     LDD   MSCR4
E67E 109321           (    forth6809.asm):04748                     CMPD  CSP
E681 2603             (    forth6809.asm):04749                     BNE   RPSCANOK
E683 BDE50C           (    forth6809.asm):04750                     JSR   CFERR             ; no matching BEGIN
E686 9E1A             (    forth6809.asm):04751         RPSCANOK:   LDX   MSCR4
E688 EC84             (    forth6809.asm):04752                     LDD   ,X
E68A 10830002         (    forth6809.asm):04753                     CMPD  #TAGBACK
E68E 2712             (    forth6809.asm):04754                     BEQ   RPFOUND
E690 10830001         (    forth6809.asm):04755                     CMPD  #TAGFWD
E694 2703             (    forth6809.asm):04756                     BEQ   RPSKIP
E696 BDE50C           (    forth6809.asm):04757                     JSR   CFERR             ; anything else is a genuine mismatch
E699 DC1A             (    forth6809.asm):04758         RPSKIP:     LDD   MSCR4
E69B C30004           (    forth6809.asm):04759                     ADDD  #4
E69E DD1A             (    forth6809.asm):04760                     STD   MSCR4
E6A0 20DA             (    forth6809.asm):04761                     BRA   RPSCAN
E6A2 9E1A             (    forth6809.asm):04762         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E6A4 EC02             (    forth6809.asm):04763                     LDD   2,X               ; dest = BEGIN's address
E6A6 3406             (    forth6809.asm):04764                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04765         
                      (    forth6809.asm):04766                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04767                     ; bytes, highest word first.
E6A8 DC1A             (    forth6809.asm):04768                     LDD   MSCR4
E6AA 9316             (    forth6809.asm):04769                     SUBD  MSCR2
E6AC DD18             (    forth6809.asm):04770                     STD   MSCR3             ; MSCR3 = bytes to shift
E6AE 2715             (    forth6809.asm):04771                     BEQ   RPSHIFTDONE
E6B0 DC18             (    forth6809.asm):04772         RPSHIFT:    LDD   MSCR3
E6B2 830002           (    forth6809.asm):04773                     SUBD  #2
E6B5 DD18             (    forth6809.asm):04774                     STD   MSCR3
E6B7 9E16             (    forth6809.asm):04775                     LDX   MSCR2
E6B9 308B             (    forth6809.asm):04776                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E6BB EC84             (    forth6809.asm):04777                     LDD   ,X
E6BD 3004             (    forth6809.asm):04778                     LEAX  4,X
E6BF ED84             (    forth6809.asm):04779                     STD   ,X                ; copy one word 4 bytes higher
E6C1 DC18             (    forth6809.asm):04780                     LDD   MSCR3
E6C3 26EB             (    forth6809.asm):04781                     BNE   RPSHIFT
E6C5                  (    forth6809.asm):04782         RPSHIFTDONE:
E6C5 9E16             (    forth6809.asm):04783                     LDX   MSCR2
E6C7 3004             (    forth6809.asm):04784                     LEAX  4,X
E6C9 1F13             (    forth6809.asm):04785                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04786         
E6CB CCDC1A           (    forth6809.asm):04787                     LDD   #BRANCH
E6CE 3606             (    forth6809.asm):04788                     PSHU  D
E6D0 BDE97C           (    forth6809.asm):04789                     JSR   CCALL
E6D3 CC0000           (    forth6809.asm):04790                     LDD   #0
E6D6 3606             (    forth6809.asm):04791                     PSHU  D
E6D8 BDDCA1           (    forth6809.asm):04792                     JSR   CODECOMMA
E6DB EC60             (    forth6809.asm):04793                     LDD   0,S               ; target = BEGIN's address
E6DD 3606             (    forth6809.asm):04794                     PSHU  D
E6DF DC08             (    forth6809.asm):04795                     LDD   CODEHERE
E6E1 830002           (    forth6809.asm):04796                     SUBD  #2                ; location = the operand just compiled
E6E4 3606             (    forth6809.asm):04797                     PSHU  D
E6E6 BDE576           (    forth6809.asm):04798                     JSR   PATCH
E6E9 DC08             (    forth6809.asm):04799                     LDD   CODEHERE
E6EB 3606             (    forth6809.asm):04800                     PSHU  D
E6ED EC62             (    forth6809.asm):04801                     LDD   2,S               ; orig
E6EF 3606             (    forth6809.asm):04802                     PSHU  D
E6F1 BDE576           (    forth6809.asm):04803                     JSR   PATCH
E6F4 3264             (    forth6809.asm):04804                     LEAS  4,S               ; drop the frame
E6F6 39               (    forth6809.asm):04805                     RTS
                      (    forth6809.asm):04806         
                      (    forth6809.asm):04807         ; ------------------------------------------------------------
                      (    forth6809.asm):04808         ; RECURSE  ( -- )
                      (    forth6809.asm):04809         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):04810         ; the xt held in CURXT.
                      (    forth6809.asm):04811         ; ------------------------------------------------------------
E6F7 DC1F             (    forth6809.asm):04812         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E6F9 3606             (    forth6809.asm):04813                     PSHU  D                 ; See bugfix: RECURSEW.1
E6FB BDE97C           (    forth6809.asm):04814                     JSR   CCALL
E6FE 39               (    forth6809.asm):04815                     RTS
                      (    forth6809.asm):04816         
                      (    forth6809.asm):04817         ; ------------------------------------------------------------
                      (    forth6809.asm):04818         ; DO  ( C: -- dest )
                      (    forth6809.asm):04819         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04820         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04821         ; ------------------------------------------------------------
E6FF CCE711           (    forth6809.asm):04822         DOW:        LDD   #DOSETUP
E702 3606             (    forth6809.asm):04823                     PSHU  D
E704 BDE97C           (    forth6809.asm):04824                     JSR   CCALL
E707 DC08             (    forth6809.asm):04825                     LDD   CODEHERE
E709 3606             (    forth6809.asm):04826                     PSHU  D                 ; dest
E70B CC0003           (    forth6809.asm):04827                     LDD   #TAGDO
E70E 3606             (    forth6809.asm):04828                     PSHU  D

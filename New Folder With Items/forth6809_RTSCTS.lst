                      (    forth6809.asm):08357         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08358         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08359         ; low byte of BASE is used.

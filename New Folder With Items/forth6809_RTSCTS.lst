                      (    forth6809.asm):04366                     BEQ   EMITWT
                      (    forth6809.asm):04367                     LDA   EMITCH
                      (    forth6809.asm):04368                     STA   ACIADR
                      (    forth6809.asm):04369                     RTS
                      (    forth6809.asm):04370         
                      (    forth6809.asm):04371                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04372         
                      (    forth6809.asm):04373         ; ------------------------------------------------------------
                      (    forth6809.asm):04374         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04375         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04376         ; echoing as it goes. Backspace and DEL erase the last character; LF

                      (    forth6809.asm):09209         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):09210         ; ============================================================
                      (    forth6809.asm):09211         ; ------------------------------------------------------------
                      (    forth6809.asm):09212         ; TRUE  ( -- flag )
                      (    forth6809.asm):09213         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09214         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):09215         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):09216         ; ------------------------------------------------------------
FF7C CCFFFF           (    forth6809.asm):09217         TRUEW:      LDD   #$FFFF
FF7F 3606             (    forth6809.asm):09218                     PSHU  D
FF81 39               (    forth6809.asm):09219                     RTS
                      (    forth6809.asm):09220         
                      (    forth6809.asm):09221         ; ------------------------------------------------------------
                      (    forth6809.asm):09222         ; FALSE  ( -- flag )
                      (    forth6809.asm):09223         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):09224         ; ------------------------------------------------------------
FF82 CC0000           (    forth6809.asm):09225         FALSEW:     LDD   #$0000
FF85 3606             (    forth6809.asm):09226                     PSHU  D
FF87 39               (    forth6809.asm):09227                     RTS
                      (    forth6809.asm):09228         
                      (    forth6809.asm):09229         ; ------------------------------------------------------------
                      (    forth6809.asm):09230         ; 1  ( -- 1 )
                      (    forth6809.asm):09231         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):09232         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):09233         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):09234         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):09235         ; ------------------------------------------------------------
FF88 CC0001           (    forth6809.asm):09236         POSONEW:    LDD   #1
FF8B 3606             (    forth6809.asm):09237                     PSHU  D
FF8D 39               (    forth6809.asm):09238                     RTS
                      (    forth6809.asm):09239         
                      (    forth6809.asm):09240         ; ------------------------------------------------------------
                      (    forth6809.asm):09241         ; -1  ( -- -1 )
                      (    forth6809.asm):09242         ; Push the constant -1.
                      (    forth6809.asm):09243         ; ------------------------------------------------------------
FF8E CCFFFF           (    forth6809.asm):09244         NEGONEW:    LDD   #-1
FF91 3606             (    forth6809.asm):09245                     PSHU  D
FF93 39               (    forth6809.asm):09246                     RTS
                      (    forth6809.asm):09247         
                      (    forth6809.asm):09248         ; ------------------------------------------------------------
                      (    forth6809.asm):09249         ; 2  ( -- 2 )
                      (    forth6809.asm):09250         ; Push the constant 2.
                      (    forth6809.asm):09251         ; ------------------------------------------------------------
FF94 CC0002           (    forth6809.asm):09252         POSTWOW:    LDD   #2
FF97 3606             (    forth6809.asm):09253                     PSHU  D
FF99 39               (    forth6809.asm):09254                     RTS
                      (    forth6809.asm):09255         
                      (    forth6809.asm):09256         ; ------------------------------------------------------------
                      (    forth6809.asm):09257         ; -2  ( -- -2 )
                      (    forth6809.asm):09258         ; Push the constant -2.
                      (    forth6809.asm):09259         ; ------------------------------------------------------------
FF9A CCFFFE           (    forth6809.asm):09260         NEGTWOW:    LDD   #-2
FF9D 3606             (    forth6809.asm):09261                     PSHU  D
FF9F 39               (    forth6809.asm):09262                     RTS
                      (    forth6809.asm):09263         
                      (    forth6809.asm):09264         ; Verify no collision with init code,
                      (    forth6809.asm):09265         ; value should match ORG INITCODE.
     FFA0             (    forth6809.asm):09266         BASECODEEND EQU   *
     264E             (    forth6809.asm):09267         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):09268         
                      (    forth6809.asm):09269         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):09270         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):09271         ; .bin file.
FFA0                  (    forth6809.asm):09272         BASEND:
FFA0 FFFFFFFF         (    forth6809.asm):09273                     FILL  $FF,INITCODE-BASEND
                      (    forth6809.asm):09274         
                      (    forth6809.asm):09275         ; ============================================================
                      (    forth6809.asm):09276         ; SECTION 2: INIT CODE (COLDSTRT / WARM)
                      (    forth6809.asm):09277         ; ============================================================
                      (    forth6809.asm):09278                     ORG   INITCODE          ; init code block
                      (    forth6809.asm):09279         
                      (    forth6809.asm):09280         ; ------------------------------------------------------------
                      (    forth6809.asm):09281         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):09282         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):09283         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):09284         ; enter COLD.
                      (    forth6809.asm):09285         ; COLDSTRT
                      (    forth6809.asm):09286         ;    Inputs:
                      (    forth6809.asm):09287         ;        hardware reset
                      (    forth6809.asm):09288         ;    Outputs:
                      (    forth6809.asm):09289         ;        does not return
                      (    forth6809.asm):09290         ;    Registers: all registers initialised.
                      (    forth6809.asm):09291         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):09292         COLDSTRT:
FFA4 1A50             (    forth6809.asm):09293                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):09294                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):09295                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):09296                     CLRA
FFAE 1F8B             (    forth6809.asm):09297                     TFR   A,DP
                      (    forth6809.asm):09298         
FFB0 8E0000           (    forth6809.asm):09299                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):09300                     LDB   #0
FFB5 6F80             (    forth6809.asm):09301         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):09302                     DECB
FFB8 26FB             (    forth6809.asm):09303                     BNE   CLRGLOB
                      (    forth6809.asm):09304         
FFBA BDE18F           (    forth6809.asm):09305                     JSR   WLINIT            ; FIND must work for the unit tests too
                      (    forth6809.asm):09306         
FFBD BDD971           (    forth6809.asm):09307                     JSR   INITSERIAL
                      (    forth6809.asm):09308         
FFC0 1CAF             (    forth6809.asm):09309                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):09310         
                      (    forth6809.asm):09311                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):09312         
                      (    forth6809.asm):09313                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):09314                     JSR   TSTRUNNER
                      (    forth6809.asm):09315                     ELSE                    ; <<<<<>>>>>
FFC2 12               (    forth6809.asm):09316                     NOP                     ; same size as JSR TSTRUNNER
FFC3 12               (    forth6809.asm):09317                     NOP                     ; See bugfix: COLDSTRT.2
FFC4 12               (    forth6809.asm):09318                     NOP
                      (    forth6809.asm):09319                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):09320         
FFC5 7EDB12           (    forth6809.asm):09321                     JMP   COLD
                      (    forth6809.asm):09322         
                      (    forth6809.asm):09323         ; ------------------------------------------------------------
                      (    forth6809.asm):09324         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):09325         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):09326         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):09327         ; WARM
                      (    forth6809.asm):09328         ;    Inputs:
                      (    forth6809.asm):09329         ;        NMI
                      (    forth6809.asm):09330         ;    Outputs:
                      (    forth6809.asm):09331         ;        does not return
                      (    forth6809.asm):09332         ;    Registers: all registers initialised.
                      (    forth6809.asm):09333         ; ------------------------------------------------------------
FFC8 1A50             (    forth6809.asm):09334         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFCA 4F               (    forth6809.asm):09335                     CLRA
FFCB 1F8B             (    forth6809.asm):09336                     TFR   A,DP
FFCD CEBD00           (    forth6809.asm):09337                     LDU   #SP0
FFD0 10CEC000         (    forth6809.asm):09338                     LDS   #RP0
                      (    forth6809.asm):09339         
FFD4 BDD971           (    forth6809.asm):09340                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):09341         
FFD7 8EFFE9           (    forth6809.asm):09342                     LDX   #WARMMSG
FFDA 3610             (    forth6809.asm):09343                     PSHU  X
FFDC CC0006           (    forth6809.asm):09344                     LDD   #WARMMSGL
FFDF 3606             (    forth6809.asm):09345                     PSHU  D
FFE1 BDF550           (    forth6809.asm):09346                     JSR   TYPEW
FFE4 1CAF             (    forth6809.asm):09347                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE6 7EDB54           (    forth6809.asm):09348                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):09349         
FFE9 20207761726D     (    forth6809.asm):09350         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):09351         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):09352         
                      (    forth6809.asm):09353                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEF             (    forth6809.asm):09354         INITEND     EQU   *
     004B             (    forth6809.asm):09355         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):09356         

                      (    forth6809.asm):02114         ; PUTCHAR
                      (    forth6809.asm):02115         ;    Inputs:
                      (    forth6809.asm):02116         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02117         ;    Outputs:
                      (    forth6809.asm):02118         ;        none
                      (    forth6809.asm):02119         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02120         ; ------------------------------------------------------------
DA02                  (    forth6809.asm):02121         PUTCHAR:
DA02 3411             (    forth6809.asm):02122                     PSHS  CC,X
DA04 1A50             (    forth6809.asm):02123                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02124         
DA06 F60179           (    forth6809.asm):02125                     LDB   OUTHEAD           ; Is buffer full?
DA09 5C               (    forth6809.asm):02126                     INCB
DA0A C43F             (    forth6809.asm):02127                     ANDB  #OUTBUFSZ-1
DA0C F1017A           (    forth6809.asm):02128                     CMPB  OUTTAIL
DA0F 273A             (    forth6809.asm):02129                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02130         
DA11 8E01C0           (    forth6809.asm):02131                     LDX   #OUTBUF           ; Put character into character slot.
DA14 F60179           (    forth6809.asm):02132                     LDB   OUTHEAD
DA17 A785             (    forth6809.asm):02133                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02134         
DA19 5C               (    forth6809.asm):02135                     INCB                    ; Update tail pointer to next character slot.
DA1A C43F             (    forth6809.asm):02136                     ANDB  #OUTBUFSZ-1
DA1C F70179           (    forth6809.asm):02137                     STB   OUTHEAD

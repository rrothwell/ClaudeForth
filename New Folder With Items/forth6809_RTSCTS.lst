F511 3606             (    forth6809.asm):07578                     PSHU  D
F513 3085             (    forth6809.asm):07579                     LEAX  B,X
F515 3410             (    forth6809.asm):07580                     PSHS  X
F517 7EF550           (    forth6809.asm):07581                     JMP   TYPEW
                      (    forth6809.asm):07582         
                      (    forth6809.asm):07583         ; ------------------------------------------------------------
                      (    forth6809.asm):07584         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):07585         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):07586         ; counted string.
                      (    forth6809.asm):07587         ; ------------------------------------------------------------

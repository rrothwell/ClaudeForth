                      (    forth6809.asm):01973         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01974         ; ------------------------------------------------------------
D981 B60176           (    forth6809.asm):01975         INFILL:     LDA   INHEAD
D984 B00177           (    forth6809.asm):01976                     SUBA  INTAIL
D987 843F             (    forth6809.asm):01977                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
D989 39               (    forth6809.asm):01978                     RTS
                      (    forth6809.asm):01979         ; ------------------------------------------------------------
                      (    forth6809.asm):01980         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01981         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01982         ; receive path with interrupts already masked.
                      (    forth6809.asm):01983         ; RTSCHECKHI
                      (    forth6809.asm):01984         ;    Inputs:
                      (    forth6809.asm):01985         ;        none
                      (    forth6809.asm):01986         ;    Outputs:
                      (    forth6809.asm):01987         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01988         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01989         ; ------------------------------------------------------------
D98A BDD981           (    forth6809.asm):01990         RTSCHECKHI: JSR   INFILL
D98D 8130             (    forth6809.asm):01991                     CMPA  #INHIWATER
D98F 250F             (    forth6809.asm):01992                     BLO   RTSCHIDONE
D991 7D0178           (    forth6809.asm):01993                     TST   RTSSTATE
D994 260A             (    forth6809.asm):01994                     BNE   RTSCHIDONE        ; already high - nothing to do
D996 86D5             (    forth6809.asm):01995                     LDA   #CR_RTSHI
D998 B7C008           (    forth6809.asm):01996                     STA   ACIACR
D99B 8601             (    forth6809.asm):01997                     LDA   #1
D99D B70178           (    forth6809.asm):01998                     STA   RTSSTATE
D9A0 39               (    forth6809.asm):01999         RTSCHIDONE: RTS
                      (    forth6809.asm):02000         ; ------------------------------------------------------------
                      (    forth6809.asm):02001         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02002         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02003         ; enables it only while output is pending.
                      (    forth6809.asm):02004         ; UPDATE_RTS
                      (    forth6809.asm):02005         ;    Inputs:
                      (    forth6809.asm):02006         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02007         ;    Outputs:
                      (    forth6809.asm):02008         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02009         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02010         ; ------------------------------------------------------------
D9A1                  (    forth6809.asm):02011         UPDATE_RTS:
D9A1 7D0178           (    forth6809.asm):02012                     TST   RTSSTATE
D9A4 260D             (    forth6809.asm):02013                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02014         
D9A6 7D017B           (    forth6809.asm):02015                     TST   OUTACTIVITY       ; Is active?
D9A9 2704             (    forth6809.asm):02016                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02017         
                      (    forth6809.asm):02018                                             ; $B5/%1011_0101
D9AB 86B5             (    forth6809.asm):02019                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
D9AD 2009             (    forth6809.asm):02020                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02021         
D9AF                  (    forth6809.asm):02022         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
D9AF 8695             (    forth6809.asm):02023                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
D9B1 2005             (    forth6809.asm):02024                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02025         
D9B3                  (    forth6809.asm):02026         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
D9B3 86D5             (    forth6809.asm):02027                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
D9B5 7F017B           (    forth6809.asm):02028                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
D9B8                  (    forth6809.asm):02029         WRITE_CR:
D9B8 B7C008           (    forth6809.asm):02030                     STA   ACIACR
D9BB 39               (    forth6809.asm):02031                     RTS
                      (    forth6809.asm):02032         ; ------------------------------------------------------------
                      (    forth6809.asm):02033         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02034         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02035         ; Called after a character is added to the ring.
                      (    forth6809.asm):02036         ; CHKHI
                      (    forth6809.asm):02037         ;    Inputs:
                      (    forth6809.asm):02038         ;        RegB = input ring fill level
                      (    forth6809.asm):02039         ;    Outputs:
                      (    forth6809.asm):02040         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02041         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02042         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02043         ; ------------------------------------------------------------
D9BC                  (    forth6809.asm):02044         CHKHI:
D9BC C130             (    forth6809.asm):02045                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
D9BE 250D             (    forth6809.asm):02046                     BLO   CHKHIDONE         ; No! Do nothing.
D9C0 7D0178           (    forth6809.asm):02047                     TST   RTSSTATE
D9C3 2608             (    forth6809.asm):02048                     BNE   CHKHIDONE         ; already high - nothing to do
D9C5 86FF             (    forth6809.asm):02049                     LDA   #INREJECT         ; Yes! De-assert RTS.
D9C7 B70178           (    forth6809.asm):02050                     STA   RTSSTATE
D9CA BDD9A1           (    forth6809.asm):02051                     JSR   UPDATE_RTS
D9CD 39               (    forth6809.asm):02052         CHKHIDONE:  RTS
                      (    forth6809.asm):02053         
                      (    forth6809.asm):02054         ; ------------------------------------------------------------
                      (    forth6809.asm):02055         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02056         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02057         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02058         ; CHKLO
                      (    forth6809.asm):02059         ;    Inputs:
                      (    forth6809.asm):02060         ;        RegB = input ring fill level
                      (    forth6809.asm):02061         ;    Outputs:
                      (    forth6809.asm):02062         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02063         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02064         ; ------------------------------------------------------------
D9CE                  (    forth6809.asm):02065         CHKLO:
D9CE C110             (    forth6809.asm):02066                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
D9D0 240D             (    forth6809.asm):02067                     BHS   CHKLODONE         ; No! Do nothing.
D9D2 7D0178           (    forth6809.asm):02068                     TST   RTSSTATE
D9D5 2708             (    forth6809.asm):02069                     BEQ   CHKLODONE         ; already low - nothing to do
D9D7 8600             (    forth6809.asm):02070                     LDA   #INACCEPT         ; Yes! Assert RTS.
D9D9 B70178           (    forth6809.asm):02071                     STA   RTSSTATE
D9DC BDD9A1           (    forth6809.asm):02072                     JSR   UPDATE_RTS
D9DF 39               (    forth6809.asm):02073         CHKLODONE:  RTS
                      (    forth6809.asm):02074         ; ------------------------------------------------------------
                      (    forth6809.asm):02075         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02076         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02077         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02078         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02079         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02080         ;    Inputs:
                      (    forth6809.asm):02081         ;        none
                      (    forth6809.asm):02082         ;    Outputs:
                      (    forth6809.asm):02083         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02084         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02085         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02086         ; ------------------------------------------------------------
D9E0                  (    forth6809.asm):02087         FLUSHOUTBUFFER:
D9E0 F6017A           (    forth6809.asm):02088                     LDB   OUTTAIL
D9E3 F10179           (    forth6809.asm):02089                     CMPB  OUTHEAD           ; Is transmit buffer empty?
D9E6 2719             (    forth6809.asm):02090                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02091         
D9E8 B6C008           (    forth6809.asm):02092                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
D9EB 8508             (    forth6809.asm):02093                     BITA  #SR_CTS
D9ED 2612             (    forth6809.asm):02094                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02095         
D9EF 8502             (    forth6809.asm):02096                     BITA  #SR_TDRE          ; Is transmit register empty?
D9F1 270E             (    forth6809.asm):02097                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02098                                             ; than spin-wait here.
                      (    forth6809.asm):02099         
D9F3 8E01C0           (    forth6809.asm):02100                     LDX   #OUTBUF           ; The out buffer is occupied.
D9F6 A685             (    forth6809.asm):02101                     LDA   B,X               ; Get the character from the out buffer.
D9F8 B7C009           (    forth6809.asm):02102                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02103         
D9FB 5C               (    forth6809.asm):02104                     INCB                    ; Update tail pointer to next character slot.
D9FC C43F             (    forth6809.asm):02105                     ANDB  #OUTBUFSZ-1
D9FE F7017A           (    forth6809.asm):02106                     STB   OUTTAIL
                      (    forth6809.asm):02107                                             ; One character sent - return rather than
                      (    forth6809.asm):02108                                             ; loop back for more (see header comment).

                      (    forth6809.asm):04463         ; to 0 and >IN to 0.
                      (    forth6809.asm):04464         ; ------------------------------------------------------------
E4EC 8E0106           (    forth6809.asm):04465         QUERYW:     LDX   #TIBBUF
E4EF 3610             (    forth6809.asm):04466                     PSHU  X

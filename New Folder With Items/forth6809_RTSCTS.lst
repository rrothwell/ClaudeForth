E50B 39               (    forth6809.asm):04478                     RTS
                      (    forth6809.asm):04479         
                      (    forth6809.asm):04480         ; ============================================================
                      (    forth6809.asm):04481         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04482         ; ============================================================
                      (    forth6809.asm):04483         ; ------------------------------------------------------------
                      (    forth6809.asm):04484         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04485         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04486         ; one expected.
                      (    forth6809.asm):04487         ; CFERR
                      (    forth6809.asm):04488         ;    Inputs:
                      (    forth6809.asm):04489         ;        none
                      (    forth6809.asm):04490         ;    Outputs:
                      (    forth6809.asm):04491         ;        does not return (THROW -22)
                      (    forth6809.asm):04492         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04493         ; ------------------------------------------------------------
E50C CCFFEA           (    forth6809.asm):04494         CFERR:      LDD   #-22
E50F 3606             (    forth6809.asm):04495                     PSHU  D                 ; -22
E511 BDE541           (    forth6809.asm):04496                     JSR   THROWW
E514 39               (    forth6809.asm):04497                     RTS
                      (    forth6809.asm):04498         
                      (    forth6809.asm):04499         ; ------------------------------------------------------------
                      (    forth6809.asm):04500         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04501         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04502         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04503         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04504         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04505         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04506         ; ------------------------------------------------------------
E515 3710             (    forth6809.asm):04507         CATCHW:     PULU  X                 ; xt
E517 DC0C             (    forth6809.asm):04508                     LDD   HANDLER
E519 3406             (    forth6809.asm):04509                     PSHS  D
E51B 3440             (    forth6809.asm):04510                     PSHS  U
                      (    forth6809.asm):04511                     ; Save the input source specification.
                      (    forth6809.asm):04512                     ; See bugfix: CATCHW.1
E51D DC39             (    forth6809.asm):04513                     LDD   SRCADDR
E51F 3406             (    forth6809.asm):04514                     PSHS  D
E521 DC3B             (    forth6809.asm):04515                     LDD   SRCLEN
E523 3406             (    forth6809.asm):04516                     PSHS  D
E525 DC3D             (    forth6809.asm):04517                     LDD   SRCID
E527 3406             (    forth6809.asm):04518                     PSHS  D
E529 DC10             (    forth6809.asm):04519                     LDD   TOIN
E52B 3406             (    forth6809.asm):04520                     PSHS  D
E52D 1F40             (    forth6809.asm):04521                     TFR   S,D
E52F DD0C             (    forth6809.asm):04522                     STD   HANDLER
                      (    forth6809.asm):04523         
E531 AD84             (    forth6809.asm):04524                     JSR   ,X
                      (    forth6809.asm):04525         
E533 3268             (    forth6809.asm):04526                     LEAS  8,S               ; drop saved input source
E535 3262             (    forth6809.asm):04527                     LEAS  2,S               ; saved U
E537 3506             (    forth6809.asm):04528                     PULS  D
E539 DD0C             (    forth6809.asm):04529                     STD   HANDLER
E53B CC0000           (    forth6809.asm):04530                     LDD   #0
E53E 3606             (    forth6809.asm):04531                     PSHU  D                 ; 0 = no exception
E540 39               (    forth6809.asm):04532                     RTS
                      (    forth6809.asm):04533         
                      (    forth6809.asm):04534         ; ------------------------------------------------------------
                      (    forth6809.asm):04535         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04536         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04537         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04538         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04539         ; ------------------------------------------------------------
E541 3706             (    forth6809.asm):04540         THROWW:     PULU  D                 ; n
E543 10830000         (    forth6809.asm):04541                     CMPD  #0
E547 2725             (    forth6809.asm):04542                     BEQ   THDONE
                      (    forth6809.asm):04543         
E549 DD0E             (    forth6809.asm):04544                     STD   THROWN
E54B 9E0C             (    forth6809.asm):04545                     LDX   HANDLER

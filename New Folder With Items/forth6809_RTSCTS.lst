E412 43               (    forth6809.asm):04170                     COMA
E413 53               (    forth6809.asm):04171                     COMB
E414 C30001           (    forth6809.asm):04172                     ADDD  #1
E417 ED42             (    forth6809.asm):04173                     STD   2,U
E419 2407             (    forth6809.asm):04174                     BCC   NQPOS32
E41B ECC4             (    forth6809.asm):04175                     LDD   ,U
E41D C30001           (    forth6809.asm):04176                     ADDD  #1
E420 EDC4             (    forth6809.asm):04177                     STD   ,U
                      (    forth6809.asm):04178         
E422                  (    forth6809.asm):04179         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):04180                     ; last character was '.' - determines which return convention
E422 AEE4             (    forth6809.asm):04181                     LDX   ,S
E424 E684             (    forth6809.asm):04182                     LDB   ,X
E426 5A               (    forth6809.asm):04183                     DECB
E427 3001             (    forth6809.asm):04184                     LEAX  1,X
E429 A685             (    forth6809.asm):04185                     LDA   B,X
E42B 3263             (    forth6809.asm):04186                     LEAS  3,S
E42D 812E             (    forth6809.asm):04187                     CMPA  #'.'
E42F 2606             (    forth6809.asm):04188                     BNE   NQSINGLE

F6BF 39               (    forth6809.asm):07860                     RTS
                      (    forth6809.asm):07861         
                      (    forth6809.asm):07862         ; ------------------------------------------------------------
                      (    forth6809.asm):07863         ; SEARCH  ( c-addr1 u1 c-addr2 u2 -- c-addr3 u3 flag )
                      (    forth6809.asm):07864         ; Search the string c-addr1 u1 for the string c-addr2 u2. If found,
                      (    forth6809.asm):07865         ; return the address and remaining length of the match and true;
                      (    forth6809.asm):07866         ; otherwise return the original string and false.
                      (    forth6809.asm):07867         ; ------------------------------------------------------------
F6C0 335A             (    forth6809.asm):07868         SEARCHW:    LEAU  -6,U              ; locals: 0,U candidate address, 2,U positions
F6C2 EC46             (    forth6809.asm):07869                     LDD   6,U               ; left, 4,U end of the needle.  Then u2 at 6,
F6C4 2606             (    forth6809.asm):07870                     BNE   SRCHNZ            ; c-addr2 at 8, u1 at 10, c-addr1 at 12
F6C6 EC4C             (    forth6809.asm):07871                     LDD   12,U              ; an empty needle matches at the start
F6C8 EDC4             (    forth6809.asm):07872                     STD   ,U
F6CA 2029             (    forth6809.asm):07873                     BRA   SFOUND
F6CC EC4A             (    forth6809.asm):07874         SRCHNZ:     LDD   10,U
F6CE A346             (    forth6809.asm):07875                     SUBD  6,U

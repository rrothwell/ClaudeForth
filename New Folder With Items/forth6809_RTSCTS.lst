FFF0 0000             (    forth6809.asm):09366         VRESV       FDB   $0000
FFF2 DB06             (    forth6809.asm):09367         VSWI3       FDB   SWI3H             ; SWI3
FFF4 DB07             (    forth6809.asm):09368         VSWI2       FDB   SWI2H             ; SWI2
FFF6 DB08             (    forth6809.asm):09369         VFIRQ       FDB   FIRQH             ; FIRQ
FFF8 DA9D             (    forth6809.asm):09370         VIRQ        FDB   IRQH              ; IRQ
FFFA DB0A             (    forth6809.asm):09371         VSWI        FDB   SWIH              ; SWI

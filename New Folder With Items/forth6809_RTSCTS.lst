                      (    forth6809.asm):04064         ; ------------------------------------------------------------
                      (    forth6809.asm):04065         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04066         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04067         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04068         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04069         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04070         ; NUMLOOP
                      (    forth6809.asm):04071         ;    Inputs:
                      (    forth6809.asm):04072         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04073         ;    Outputs:
                      (    forth6809.asm):04074         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04075         ;        the count remaining
                      (    forth6809.asm):04076         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04077         ; ------------------------------------------------------------
E391                  (    forth6809.asm):04078         TONUMBERW:
E391 ECC4             (    forth6809.asm):04079         NUMLOOP:    LDD   ,U
E393 2734             (    forth6809.asm):04080                     BEQ   NLDONE
E395 AE42             (    forth6809.asm):04081                     LDX   2,U
E397 A684             (    forth6809.asm):04082                     LDA   ,X
E399 8130             (    forth6809.asm):04083                     CMPA  #'0'
E39B 252C             (    forth6809.asm):04084                     BLO   NLDONE
E39D 8139             (    forth6809.asm):04085                     CMPA  #'9'
E39F 2204             (    forth6809.asm):04086                     BHI   NLALPHA
E3A1 8030             (    forth6809.asm):04087                     SUBA  #'0'
E3A3 200C             (    forth6809.asm):04088                     BRA   NLGOT
E3A5 84DF             (    forth6809.asm):04089         NLALPHA:    ANDA  #$DF
E3A7 8141             (    forth6809.asm):04090                     CMPA  #'A'
E3A9 251E             (    forth6809.asm):04091                     BLO   NLDONE
E3AB 815A             (    forth6809.asm):04092                     CMPA  #'Z'
E3AD 221A             (    forth6809.asm):04093                     BHI   NLDONE
E3AF 8037             (    forth6809.asm):04094                     SUBA  #'A'-10
E3B1 9103             (    forth6809.asm):04095         NLGOT:      CMPA  BASE+1
E3B3 2414             (    forth6809.asm):04096                     BHS   NLDONE
E3B5 1F89             (    forth6809.asm):04097                     TFR   A,B
E3B7 BDE350           (    forth6809.asm):04098                     JSR   UDMULADD
E3BA AE42             (    forth6809.asm):04099                     LDX   2,U
E3BC 3001             (    forth6809.asm):04100                     LEAX  1,X
E3BE AF42             (    forth6809.asm):04101                     STX   2,U

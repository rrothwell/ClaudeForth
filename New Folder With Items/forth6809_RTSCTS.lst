                      (    forth6809.asm):00328         ; ============================================================
                      (    forth6809.asm):00329         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00330         ;
                      (    forth6809.asm):00331         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00332         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00333         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00334         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00335         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00336         ; hand-built. Headers are in search order (shadow SECTION27.1).
                      (    forth6809.asm):00337         ;
                      (    forth6809.asm):00338         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00339         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00340         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00341         ; ============================================================
                      (    forth6809.asm):00342         
                      (    forth6809.asm):00343                     ORG   BASEDICT
                      (    forth6809.asm):00344         ; ROOT wordlist: the Search-Order words. It is always searched, last,
                      (    forth6809.asm):00345         ; and FORTH continues into it (the link of the first FORTH header names
                      (    forth6809.asm):00346         ; BASEROOTLATEST), so FORTH-WORDLIST also contains these words.
                      (    forth6809.asm):00347         ; See shadow BASEROOTLATEST.1

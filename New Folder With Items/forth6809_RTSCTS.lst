E3C7 20C8             (    forth6809.asm):04105                     BRA   NUMLOOP
E3C9 39               (    forth6809.asm):04106         NLDONE:     RTS
                      (    forth6809.asm):04107         
                      (    forth6809.asm):04108         ; ------------------------------------------------------------
                      (    forth6809.asm):04109         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04110         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04111         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04112         ;    Inputs:
                      (    forth6809.asm):04113         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04114         ;    Outputs:
                      (    forth6809.asm):04115         ;        single number: n and -1
                      (    forth6809.asm):04116         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04117         ;        not a number: c-addr and 0
                      (    forth6809.asm):04118         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04119         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04120         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04121         ; NUMBERQ.6.
                      (    forth6809.asm):04122         ; ------------------------------------------------------------
E3CA 3710             (    forth6809.asm):04123         NUMBERQ:    PULU  X                 ; c-addr
E3CC 327D             (    forth6809.asm):04124                     LEAS  -3,S
E3CE AFE4             (    forth6809.asm):04125                     STX   ,S
E3D0 E684             (    forth6809.asm):04126                     LDB   ,X
E3D2 276D             (    forth6809.asm):04127                     BEQ   NQBAD
E3D4 3001             (    forth6809.asm):04128                     LEAX  1,X
                      (    forth6809.asm):04129         
                      (    forth6809.asm):04130                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04131                     ; digit count. See shadow: NUMBERQ.1
E3D6 5A               (    forth6809.asm):04132                     DECB
E3D7 A685             (    forth6809.asm):04133                     LDA   B,X
E3D9 5C               (    forth6809.asm):04134                     INCB
E3DA 812E             (    forth6809.asm):04135                     CMPA  #'.'
E3DC 2603             (    forth6809.asm):04136                     BNE   NQNOSIGN
E3DE 5A               (    forth6809.asm):04137                     DECB
E3DF 2760             (    forth6809.asm):04138                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04139         
E3E1 6F62             (    forth6809.asm):04140         NQNOSIGN:   CLR   2,S
E3E3 A684             (    forth6809.asm):04141                     LDA   ,X
E3E5 812D             (    forth6809.asm):04142                     CMPA  #'-'
E3E7 2607             (    forth6809.asm):04143                     BNE   NQNOSIGN2
E3E9 6362             (    forth6809.asm):04144                     COM   2,S
E3EB 3001             (    forth6809.asm):04145                     LEAX  1,X
E3ED 5A               (    forth6809.asm):04146                     DECB
E3EE 2751             (    forth6809.asm):04147                     BEQ   NQBAD
                      (    forth6809.asm):04148         
E3F0 108E0000         (    forth6809.asm):04149         NQNOSIGN2:  LDY   #0
E3F4 3620             (    forth6809.asm):04150                     PSHU  Y                 ; ud low
E3F6 3620             (    forth6809.asm):04151                     PSHU  Y                 ; ud high
E3F8 3610             (    forth6809.asm):04152                     PSHU  X                 ; c-addr
E3FA 4F               (    forth6809.asm):04153                     CLRA
E3FB 3606             (    forth6809.asm):04154                     PSHU  D                 ; u
                      (    forth6809.asm):04155         
E3FD BDE391           (    forth6809.asm):04156                     JSR   NUMLOOP
                      (    forth6809.asm):04157         
E400 ECC4             (    forth6809.asm):04158                     LDD   ,U
E402 263B             (    forth6809.asm):04159                     BNE   NQBADF            ; unconverted characters remain
E404 3344             (    forth6809.asm):04160                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):04161         
                      (    forth6809.asm):04162                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E406 6D62             (    forth6809.asm):04163                     TST   2,S
E408 2718             (    forth6809.asm):04164                     BEQ   NQPOS32
E40A ECC4             (    forth6809.asm):04165                     LDD   ,U
E40C 43               (    forth6809.asm):04166                     COMA
E40D 53               (    forth6809.asm):04167                     COMB
E40E EDC4             (    forth6809.asm):04168                     STD   ,U

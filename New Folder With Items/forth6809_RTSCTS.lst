E7A7 3706             (    forth6809.asm):04955         PLOOPOK:    PULU  D                 ; dest
E7A9 3606             (    forth6809.asm):04956                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E7AB CCE7DB           (    forth6809.asm):04957                     LDD   #DOPLUSTEST
E7AE 3606             (    forth6809.asm):04958                     PSHU  D
E7B0 BDE97C           (    forth6809.asm):04959                     JSR   CCALL
E7B3 CC0000           (    forth6809.asm):04960                     LDD   #0
E7B6 3606             (    forth6809.asm):04961                     PSHU  D
E7B8 BDDCA1           (    forth6809.asm):04962                     JSR   CODECOMMA
E7BB DC08             (    forth6809.asm):04963                     LDD   CODEHERE
E7BD 830002           (    forth6809.asm):04964                     SUBD  #2
E7C0 3606             (    forth6809.asm):04965                     PSHU  D                 ; location; the parked dest is beneath
E7C2 BDE576           (    forth6809.asm):04966                     JSR   PATCH
                      (    forth6809.asm):04967         
E7C5 ECC4             (    forth6809.asm):04968                     LDD   ,U
E7C7 10830007         (    forth6809.asm):04969                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
E7CB 260D             (    forth6809.asm):04970                     BNE   PLOOPDONE
E7CD 3706             (    forth6809.asm):04971                     PULU  D
E7CF 3710             (    forth6809.asm):04972                     PULU  X                 ; ?DO skip operand
E7D1 DC08             (    forth6809.asm):04973                     LDD   CODEHERE
E7D3 3606             (    forth6809.asm):04974                     PSHU  D
E7D5 3610             (    forth6809.asm):04975                     PSHU  X
E7D7 BDE576           (    forth6809.asm):04976                     JSR   PATCH
E7DA 39               (    forth6809.asm):04977         PLOOPDONE:  RTS
                      (    forth6809.asm):04978         
                      (    forth6809.asm):04979         ; ------------------------------------------------------------
                      (    forth6809.asm):04980         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04981         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04982         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04983         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04984         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04985         ;    Inputs:
                      (    forth6809.asm):04986         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04987         ;    Outputs:
                      (    forth6809.asm):04988         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04989         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04990         ;        scratch.
                      (    forth6809.asm):04991         ; ------------------------------------------------------------
E7DB 3706             (    forth6809.asm):04992         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E7DD DD14             (    forth6809.asm):04993                     STD   MSCR              ; MSCR = step
E7DF EC66             (    forth6809.asm):04994                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E7E1 262D             (    forth6809.asm):04995                     BNE   DPTEXIT           ; set: exit
E7E3 EC62             (    forth6809.asm):04996                     LDD   2,S               ; old index
E7E5 A364             (    forth6809.asm):04997                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E7E7 DD16             (    forth6809.asm):04998                     STD   MSCR2
E7E9 EC62             (    forth6809.asm):04999                     LDD   2,S
E7EB D314             (    forth6809.asm):05000                     ADDD  MSCR              ; new_index = old_index + step
E7ED ED62             (    forth6809.asm):05001                     STD   2,S
E7EF A364             (    forth6809.asm):05002                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E7F1 DD18             (    forth6809.asm):05003                     STD   MSCR3
                      (    forth6809.asm):05004                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05005                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05006                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E7F3 DC14             (    forth6809.asm):05007                     LDD   MSCR              ; reload the step to test its sign
E7F5 2B09             (    forth6809.asm):05008                     BMI   DPNEG
E7F7 DC18             (    forth6809.asm):05009         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E7F9 109316           (    forth6809.asm):05010                     CMPD  MSCR2
E7FC 2512             (    forth6809.asm):05011                     BLO   DPTEXIT
E7FE 2007             (    forth6809.asm):05012                     BRA   DPCONT
E800 DC18             (    forth6809.asm):05013         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E802 109316           (    forth6809.asm):05014                     CMPD  MSCR2
E805 2209             (    forth6809.asm):05015                     BHI   DPTEXIT
E807 3510             (    forth6809.asm):05016         DPCONT:     PULS  X                 ; X = branch operand address
E809 EC84             (    forth6809.asm):05017                     LDD   ,X
E80B 308B             (    forth6809.asm):05018                     LEAX  D,X
E80D 3410             (    forth6809.asm):05019                     PSHS  X
E80F 39               (    forth6809.asm):05020                     RTS
E810 3510             (    forth6809.asm):05021         DPTEXIT:    PULS  X
E812 3002             (    forth6809.asm):05022                     LEAX  2,X               ; skip the branch operand
E814 3266             (    forth6809.asm):05023                     LEAS  6,S               ; discard the loop frame
E816 3410             (    forth6809.asm):05024                     PSHS  X
E818 39               (    forth6809.asm):05025                     RTS
                      (    forth6809.asm):05026         
                      (    forth6809.asm):05027         ; ------------------------------------------------------------
                      (    forth6809.asm):05028         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05029         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05030         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05031         ; ------------------------------------------------------------
E819 CCE83F           (    forth6809.asm):05032         QDOW:       LDD   #QDOSETUP
E81C 3606             (    forth6809.asm):05033                     PSHU  D
E81E BDE97C           (    forth6809.asm):05034                     JSR   CCALL
E821 CC0000           (    forth6809.asm):05035                     LDD   #0
E824 3606             (    forth6809.asm):05036                     PSHU  D
E826 BDDCA1           (    forth6809.asm):05037                     JSR   CODECOMMA
E829 DC08             (    forth6809.asm):05038                     LDD   CODEHERE
E82B 830002           (    forth6809.asm):05039                     SUBD  #2
E82E 3606             (    forth6809.asm):05040                     PSHU  D                 ; orig
E830 CC0007           (    forth6809.asm):05041                     LDD   #TAGQDO           ; See bugfix: QDOW.1
E833 3606             (    forth6809.asm):05042                     PSHU  D
E835 DC08             (    forth6809.asm):05043                     LDD   CODEHERE
E837 3606             (    forth6809.asm):05044                     PSHU  D                 ; dest
E839 CC0003           (    forth6809.asm):05045                     LDD   #TAGDO
E83C 3606             (    forth6809.asm):05046                     PSHU  D
E83E 39               (    forth6809.asm):05047                     RTS
                      (    forth6809.asm):05048         
                      (    forth6809.asm):05049         ; ------------------------------------------------------------
                      (    forth6809.asm):05050         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05051         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05052         ; branch operand.
                      (    forth6809.asm):05053         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05054         ;    Inputs:
                      (    forth6809.asm):05055         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05056         ;    Outputs:
                      (    forth6809.asm):05057         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05058         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05059         ; ------------------------------------------------------------
E83F 3706             (    forth6809.asm):05060         QDOSETUP:   PULU  D                 ; index
E841 DD14             (    forth6809.asm):05061                     STD   MSCR
E843 3706             (    forth6809.asm):05062                     PULU  D                 ; limit
E845 DD16             (    forth6809.asm):05063                     STD   MSCR2
E847 3510             (    forth6809.asm):05064                     PULS  X
E849 DC16             (    forth6809.asm):05065                     LDD   MSCR2
E84B 109314           (    forth6809.asm):05066                     CMPD  MSCR
E84E 2607             (    forth6809.asm):05067                     BNE   QDBUILD
E850 EC84             (    forth6809.asm):05068                     LDD   ,X
E852 308B             (    forth6809.asm):05069                     LEAX  D,X
E854 3410             (    forth6809.asm):05070                     PSHS  X
E856 39               (    forth6809.asm):05071                     RTS
E857 3002             (    forth6809.asm):05072         QDBUILD:    LEAX  2,X
E859 CC0000           (    forth6809.asm):05073                     LDD   #0
E85C 3406             (    forth6809.asm):05074                     PSHS  D
E85E DC16             (    forth6809.asm):05075                     LDD   MSCR2
E860 3406             (    forth6809.asm):05076                     PSHS  D
E862 DC14             (    forth6809.asm):05077                     LDD   MSCR
E864 3406             (    forth6809.asm):05078                     PSHS  D
E866 3410             (    forth6809.asm):05079                     PSHS  X
E868 39               (    forth6809.asm):05080                     RTS
                      (    forth6809.asm):05081         
                      (    forth6809.asm):05082         ; ------------------------------------------------------------
                      (    forth6809.asm):05083         ; UNLOOP  ( -- )
                      (    forth6809.asm):05084         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05085         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05086         ; ------------------------------------------------------------
E869 3510             (    forth6809.asm):05087         UNLOOPW:    PULS  X
E86B 3266             (    forth6809.asm):05088                     LEAS  6,S
E86D 3410             (    forth6809.asm):05089                     PSHS  X
E86F 39               (    forth6809.asm):05090                     RTS
                      (    forth6809.asm):05091         
                      (    forth6809.asm):05092         ; ------------------------------------------------------------
                      (    forth6809.asm):05093         ; EXIT  ( -- )
                      (    forth6809.asm):05094         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05095         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05096         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05097         ; ------------------------------------------------------------
E870 108E0000         (    forth6809.asm):05098         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
E874 1F31             (    forth6809.asm):05099                     TFR   U,X               ; X = scan pointer
E876 9C21             (    forth6809.asm):05100         EXSCAN:     CMPX  CSP
E878 270E             (    forth6809.asm):05101                     BEQ   EXSCANDONE
E87A EC84             (    forth6809.asm):05102                     LDD   ,X
E87C 10830003         (    forth6809.asm):05103                     CMPD  #TAGDO
E880 2602             (    forth6809.asm):05104                     BNE   EXNOTDO
E882 3121             (    forth6809.asm):05105                     LEAY  1,Y
E884 3004             (    forth6809.asm):05106         EXNOTDO:    LEAX  4,X
E886 20EE             (    forth6809.asm):05107                     BRA   EXSCAN
E888                  (    forth6809.asm):05108         EXSCANDONE:
E888 3420             (    forth6809.asm):05109                     PSHS  Y                 ; the count survives CCALL on S
E88A CCE89A           (    forth6809.asm):05110                     LDD   #EXITUNLOOP
E88D 3606             (    forth6809.asm):05111                     PSHU  D
E88F BDE97C           (    forth6809.asm):05112                     JSR   CCALL
E892 3506             (    forth6809.asm):05113                     PULS  D
E894 3606             (    forth6809.asm):05114                     PSHU  D
E896 BDDCA1           (    forth6809.asm):05115                     JSR   CODECOMMA
E899 39               (    forth6809.asm):05116                     RTS
                      (    forth6809.asm):05117         
                      (    forth6809.asm):05118         ; ------------------------------------------------------------
                      (    forth6809.asm):05119         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05120         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05121         ; EXITUNLOOP
                      (    forth6809.asm):05122         ;    Inputs:
                      (    forth6809.asm):05123         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05124         ;        address
                      (    forth6809.asm):05125         ;    Outputs:
                      (    forth6809.asm):05126         ;        returns to the caller of the definition
                      (    forth6809.asm):05127         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05128         ; ------------------------------------------------------------
E89A 3510             (    forth6809.asm):05129         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
E89C 3520             (    forth6809.asm):05130                     PULS  Y                 ; Y = return address
E89E 6EA4             (    forth6809.asm):05131                     JMP   ,Y

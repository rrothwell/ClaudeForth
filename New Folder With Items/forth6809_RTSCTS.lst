D97A 12               (    forth6809.asm):01953                     NOP
                      (    forth6809.asm):01954         
                      (    forth6809.asm):01955                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
D97B 8695             (    forth6809.asm):01956                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on

                      (    forth6809.asm):02173                                             ; by restoring the CC.
                      (    forth6809.asm):02174         ; ------------------------------------------------------------
                      (    forth6809.asm):02175         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02176         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02177         ; GETCHAR
                      (    forth6809.asm):02178         ;    Inputs:
                      (    forth6809.asm):02179         ;        none
                      (    forth6809.asm):02180         ;    Outputs:
                      (    forth6809.asm):02181         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02182         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02183         ;    Registers: RegA, RegB, RegX and CC changed.

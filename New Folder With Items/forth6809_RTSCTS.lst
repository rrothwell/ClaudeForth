                      (    forth6809.asm):02228         
DA77 BDD981           (    forth6809.asm):02229                     JSR   INFILL
DA7A 8110             (    forth6809.asm):02230                     CMPA  #INLOWATER
DA7C 221E             (    forth6809.asm):02231                     BHI   RTSCLODONE
DA7E 7D0178           (    forth6809.asm):02232                     TST   RTSSTATE
DA81 2719             (    forth6809.asm):02233                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235         
DA83 7F0178           (    forth6809.asm):02236                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02237         
DA86 F6017A           (    forth6809.asm):02238                     LDB   OUTTAIL           ; Check if chars are available.
DA89 F10179           (    forth6809.asm):02239                     CMPB  OUTHEAD
DA8C 2707             (    forth6809.asm):02240                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02241         
DA8E 86B5             (    forth6809.asm):02242                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
DA90 B7C008           (    forth6809.asm):02243                     STA   ACIACR            ; & to generate transmit slot available interrupts.
DA93 2005             (    forth6809.asm):02244                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02245         
DA95 8695             (    forth6809.asm):02246         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
DA97 B7C008           (    forth6809.asm):02247                     STA   ACIACR
                      (    forth6809.asm):02248         
DA9A                  (    forth6809.asm):02249         RTSCLOUNMASK:
DA9A 1CEF             (    forth6809.asm):02250                     ANDCC #$EF
                      (    forth6809.asm):02251         
DA9C 39               (    forth6809.asm):02252         RTSCLODONE: RTS
                      (    forth6809.asm):02253         
                      (    forth6809.asm):02254         ; ------------------------------------------------------------
                      (    forth6809.asm):02255         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02256         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02257         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02258         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02259         ; IRQH
                      (    forth6809.asm):02260         ;    Inputs:
                      (    forth6809.asm):02261         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02262         ;    Outputs:
                      (    forth6809.asm):02263         ;        none (returns with RTI)
                      (    forth6809.asm):02264         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02265         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02266         ; ------------------------------------------------------------
DA9D B6C008           (    forth6809.asm):02267         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02268         
DAA0 8580             (    forth6809.asm):02269                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DAA2 2708             (    forth6809.asm):02270                     BEQ   IRQDONE0          ; No! Just exit.
DAA4 8501             (    forth6809.asm):02271                     BITA  #SR_RDRF          ; Is an incoming character available?
DAA6 2605             (    forth6809.asm):02272                     BNE   INCHAR
DAA8 8502             (    forth6809.asm):02273                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DAAA 263C             (    forth6809.asm):02274                     BNE   OUTCHAR
                      (    forth6809.asm):02275                                             ; Ignore all other interrupts such as DCD change.
DAAC 3B               (    forth6809.asm):02276         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02277                                             ; & restores state.
                      (    forth6809.asm):02278         
DAAD                  (    forth6809.asm):02279         INCHAR:
DAAD F6C009           (    forth6809.asm):02280                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
DAB0 8570             (    forth6809.asm):02281                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02282                                             ; Any receiver error flagged?
DAB2 2716             (    forth6809.asm):02283                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02284         
DAB4 8510             (    forth6809.asm):02285                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DAB6 2703             (    forth6809.asm):02286                     BEQ   INXFE             ; Tally each flagged error independently -
DAB8 7C017C           (    forth6809.asm):02287                     INC   FECOUNT           ; more than one bit can be set at once.
DABB 8520             (    forth6809.asm):02288         INXFE:      BITA  #SR_OVRN
DABD 2703             (    forth6809.asm):02289                     BEQ   INXOVRN
DABF 7C017D           (    forth6809.asm):02290                     INC   OVRNCOUNT
DAC2 8540             (    forth6809.asm):02291         INXOVRN:    BITA  #SR_PE
DAC4 2703             (    forth6809.asm):02292                     BEQ   INXPE
DAC6 7C017E           (    forth6809.asm):02293                     INC   PECOUNT
DAC9 3B               (    forth6809.asm):02294         INXPE:      RTI
                      (    forth6809.asm):02295         
DACA 1F98             (    forth6809.asm):02296         INOK:       TFR   B,A               ; Transfer good character from the receiver.
DACC 8E0180           (    forth6809.asm):02297                     LDX   #INBUF            ; Store it in the empty in buffer slot.
DACF F60176           (    forth6809.asm):02298                     LDB   INHEAD
DAD2 A785             (    forth6809.asm):02299                     STA   B,X
DAD4 5C               (    forth6809.asm):02300                     INCB                    ; Figure out the new head,
DAD5 C43F             (    forth6809.asm):02301                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
DAD7 F10177           (    forth6809.asm):02302                     CMPB  INTAIL            ; Would the new head slot meet the tail?
DADA 270B             (    forth6809.asm):02303                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
DADC F70176           (    forth6809.asm):02304                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02305                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02306                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02307                     ; See shadow: INCHAR.1
DADF F00177           (    forth6809.asm):02308                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
DAE2 C43F             (    forth6809.asm):02309                     ANDB  #INBUFSZ-1
DAE4 BDD9BC           (    forth6809.asm):02310                     JSR   CHKHI             ; Protect the in buffer from overflow.
DAE7 3B               (    forth6809.asm):02311         IRQDONE1:   RTI
                      (    forth6809.asm):02312         
                      (    forth6809.asm):02313                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02314         
DAE8 F6017A           (    forth6809.asm):02315         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
DAEB F10179           (    forth6809.asm):02316                     CMPB  OUTHEAD
DAEE 270F             (    forth6809.asm):02317                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02318         
DAF0 8E01C0           (    forth6809.asm):02319                     LDX   #OUTBUF           ; No! The out buffer is occupied.
DAF3 A685             (    forth6809.asm):02320                     LDA   B,X               ; Get the character from the out buffer.
DAF5 B7C009           (    forth6809.asm):02321                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02322         
DAF8 5C               (    forth6809.asm):02323                     INCB                    ; Update the tail pointer pointing to the next char.
DAF9 C43F             (    forth6809.asm):02324                     ANDB  #OUTBUFSZ-1
DAFB F7017A           (    forth6809.asm):02325                     STB   OUTTAIL
DAFE 3B               (    forth6809.asm):02326         IRQDONE2    RTI
                      (    forth6809.asm):02327         
DAFF                  (    forth6809.asm):02328         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02329                     ; Commented-out code moved to shadow: TXOFF.1
DAFF 7F017B           (    forth6809.asm):02330                     CLR   OUTACTIVITY
DB02 BDD9A1           (    forth6809.asm):02331                     JSR   UPDATE_RTS
DB05 3B               (    forth6809.asm):02332         IRQDONE3    RTI
                      (    forth6809.asm):02333         
                      (    forth6809.asm):02334                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02335         
DB06                  (    forth6809.asm):02336         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02337                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02338                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02339                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02340                                             ; the other unused vectors below
                      (    forth6809.asm):02341                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02342         
                      (    forth6809.asm):02343         ; ------------------------------------------------------------
                      (    forth6809.asm):02344         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02345         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02346         ; ------------------------------------------------------------
DB06 3B               (    forth6809.asm):02347         SWI3H:      RTI
DB07 3B               (    forth6809.asm):02348         SWI2H:      RTI
DB08 3B               (    forth6809.asm):02349         FIRQH:      RTI
DB09 3B               (    forth6809.asm):02350         NMIH:       RTI                     ; unused now that NMI -> WARM
DB0A CCFF9D           (    forth6809.asm):02351         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DB0D 3606             (    forth6809.asm):02352                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DB0F 7EE541           (    forth6809.asm):02353                     JMP   THROWW
                      (    forth6809.asm):02354         
                      (    forth6809.asm):02355         ; ============================================================
                      (    forth6809.asm):02356         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02357         ; ============================================================
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
                      (    forth6809.asm):02359         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02360         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02361         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02362         ; COLD
                      (    forth6809.asm):02363         ;    Inputs:
                      (    forth6809.asm):02364         ;        none (entered at reset)
                      (    forth6809.asm):02365         ;    Outputs:
                      (    forth6809.asm):02366         ;        none (does not return)
                      (    forth6809.asm):02367         ;    Registers: all changed.
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
DB12 CC0240           (    forth6809.asm):02369         COLD:       LDD   #APPVARS
DB15 DD0A             (    forth6809.asm):02370                     STD   VARHERE
DB17 CC7000           (    forth6809.asm):02371                     LDD   #APPCODE
DB1A DD08             (    forth6809.asm):02372                     STD   CODEHERE
DB1C CC2000           (    forth6809.asm):02373                     LDD   #APPDICT
DB1F DD06             (    forth6809.asm):02374                     STD   DPHERE
DB21 CCD94C           (    forth6809.asm):02375                     LDD   #BASELATEST
DB24 DD04             (    forth6809.asm):02376                     STD   LATEST
DB26 BDE18F           (    forth6809.asm):02377                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02378         
DB29 CC000A           (    forth6809.asm):02379                     LDD   #10
DB2C DD02             (    forth6809.asm):02380                     STD   BASE
                      (    forth6809.asm):02381         
DB2E CC0106           (    forth6809.asm):02382                     LDD   #TIBBUF
DB31 DD39             (    forth6809.asm):02383                     STD   SRCADDR
DB33 CC0000           (    forth6809.asm):02384                     LDD   #0
DB36 DD3B             (    forth6809.asm):02385                     STD   SRCLEN
DB38 DD3D             (    forth6809.asm):02386                     STD   SRCID
                      (    forth6809.asm):02387         
DB3A 8EDBE0           (    forth6809.asm):02388                     LDX   #SIGNON
DB3D 3610             (    forth6809.asm):02389                     PSHU  X                 ; c-addr
DB3F CC000F           (    forth6809.asm):02390                     LDD   #SIGNONL
DB42 3606             (    forth6809.asm):02391                     PSHU  D                 ; u
DB44 BDF550           (    forth6809.asm):02392                     JSR   TYPEW
DB47 BDFB5F           (    forth6809.asm):02393                     JSR   CRW
DB4A 2008             (    forth6809.asm):02394                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02395         
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
                      (    forth6809.asm):02397         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02398         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02399         ; ------------------------------------------------------------
DB4C CCFFFF           (    forth6809.asm):02400         ABORTW:     LDD   #-1
DB4F 3606             (    forth6809.asm):02401                     PSHU  D                 ; throw code (-1)
DB51 7EE541           (    forth6809.asm):02402                     JMP   THROWW
                      (    forth6809.asm):02403         
                      (    forth6809.asm):02404         ; ------------------------------------------------------------
                      (    forth6809.asm):02405         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02406         ; ABORT
                      (    forth6809.asm):02407         ;    Inputs:
                      (    forth6809.asm):02408         ;        none
                      (    forth6809.asm):02409         ;    Outputs:
                      (    forth6809.asm):02410         ;        none (does not return)
                      (    forth6809.asm):02411         ;    Registers: RegU changed.
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
DB54 CEBD00           (    forth6809.asm):02413         ABORT:      LDU   #SP0
                      (    forth6809.asm):02414                     ; falls through into QUIT
                      (    forth6809.asm):02415         
                      (    forth6809.asm):02416         ; ------------------------------------------------------------
                      (    forth6809.asm):02417         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02418         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02419         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02420         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02421         ; ------------------------------------------------------------
DB57 10CEC000         (    forth6809.asm):02422         QUITW:      LDS   #RP0
DB5B CC0000           (    forth6809.asm):02423                     LDD   #0
DB5E DD00             (    forth6809.asm):02424                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02425         
DB60 BDE4EC           (    forth6809.asm):02426         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02427         
DB63 DC06             (    forth6809.asm):02428                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
DB65 3406             (    forth6809.asm):02429                     PSHS  D                 ; and THROW restore S, so the frame is
DB67 DC08             (    forth6809.asm):02430                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
DB69 3406             (    forth6809.asm):02431                     PSHS  D                 ; See shadow QLOOP.2
DB6B DC0A             (    forth6809.asm):02432                     LDD   VARHERE
DB6D 3406             (    forth6809.asm):02433                     PSHS  D
DB6F DC04             (    forth6809.asm):02434                     LDD   LATEST
DB71 3406             (    forth6809.asm):02435                     PSHS  D
                      (    forth6809.asm):02436         
DB73 CCDFB9           (    forth6809.asm):02437                     LDD   #INTERPRET
DB76 3606             (    forth6809.asm):02438                     PSHU  D                 ; xt
DB78 BDE515           (    forth6809.asm):02439                     JSR   CATCHW
DB7B 3706             (    forth6809.asm):02440                     PULU  D                 ; throw code (0 = no error)
DB7D 3406             (    forth6809.asm):02441                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DB7F 10830000         (    forth6809.asm):02442                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DB83 2743             (    forth6809.asm):02443                     BEQ   QOK
                      (    forth6809.asm):02444         
DB85 EC68             (    forth6809.asm):02445                     LDD   8,S
DB87 DD06             (    forth6809.asm):02446                     STD   DPHERE
DB89 BDE1B0           (    forth6809.asm):02447                     JSR   PRUNE             ; unlink headers newer than DPHERE
DB8C EC66             (    forth6809.asm):02448                     LDD   6,S
DB8E DD08             (    forth6809.asm):02449                     STD   CODEHERE
DB90 EC64             (    forth6809.asm):02450                     LDD   4,S
DB92 DD0A             (    forth6809.asm):02451                     STD   VARHERE
DB94 EC62             (    forth6809.asm):02452                     LDD   2,S
DB96 DD04             (    forth6809.asm):02453                     STD   LATEST
DB98 CEBD00           (    forth6809.asm):02454                     LDU   #SP0
                      (    forth6809.asm):02455         
                      (    forth6809.asm):02456                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02457                     ; See bugfix: QLOOP.1
DB9B CC0000           (    forth6809.asm):02458                     LDD   #0
DB9E DD00             (    forth6809.asm):02459                     STD   STATE
                      (    forth6809.asm):02460         
DBA0 ECE4             (    forth6809.asm):02461                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DBA2 1083FFFF         (    forth6809.asm):02462                     CMPD  #-1
DBA6 2605             (    forth6809.asm):02463                     BNE   QSHOWERR
DBA8 326A             (    forth6809.asm):02464                     LEAS  10,S              ; drop the frame
DBAA 16FFB3           (    forth6809.asm):02465                     LBRA  QLOOP
                      (    forth6809.asm):02466         
DBAD BDFB5F           (    forth6809.asm):02467         QSHOWERR:   JSR   CRW
DBB0 8EDBF3           (    forth6809.asm):02468                     LDX   #ERRMSG
DBB3 3610             (    forth6809.asm):02469                     PSHU  X                 ; c-addr
DBB5 CC0008           (    forth6809.asm):02470                     LDD   #ERRMSGL
DBB8 3606             (    forth6809.asm):02471                     PSHU  D                 ; u
DBBA BDF550           (    forth6809.asm):02472                     JSR   TYPEW
DBBD ECE4             (    forth6809.asm):02473                     LDD   ,S
DBBF 3606             (    forth6809.asm):02474                     PSHU  D                 ; n
DBC1 BDFA2E           (    forth6809.asm):02475                     JSR   DOTW
DBC4 326A             (    forth6809.asm):02476                     LEAS  10,S              ; drop the frame
DBC6 2098             (    forth6809.asm):02477                     BRA   QLOOP
                      (    forth6809.asm):02478         
DBC8 326A             (    forth6809.asm):02479         QOK:        LEAS  10,S              ; drop the frame
DBCA BDFB5F           (    forth6809.asm):02480                     JSR   CRW               ; See bugfix: QOK.1
DBCD DC00             (    forth6809.asm):02481                     LDD   STATE
DBCF 268F             (    forth6809.asm):02482                     BNE   QLOOP
DBD1 8EDBEF           (    forth6809.asm):02483                     LDX   #OKMSG
DBD4 3610             (    forth6809.asm):02484                     PSHU  X                 ; c-addr
DBD6 CC0004           (    forth6809.asm):02485                     LDD   #OKMSGL
DBD9 3606             (    forth6809.asm):02486                     PSHU  D                 ; u
DBDB BDF550           (    forth6809.asm):02487                     JSR   TYPEW
DBDE 2080             (    forth6809.asm):02488                     BRA   QLOOP
                      (    forth6809.asm):02489         
DBE0 3638303920464F52 (    forth6809.asm):02490         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02491         SIGNONL     EQU   *-SIGNON
DBEF 20206F6B         (    forth6809.asm):02492         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02493         OKMSGL      EQU   *-OKMSG
DBF3 20204552524F5220 (    forth6809.asm):02494         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02495         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02496         
                      (    forth6809.asm):02497         ; ============================================================
                      (    forth6809.asm):02498         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02499         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02500         ; ============================================================
                      (    forth6809.asm):02501         ; ------------------------------------------------------------
                      (    forth6809.asm):02502         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02503         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02504         ; LIT   ( -- x )
                      (    forth6809.asm):02505         ;    Inputs:
                      (    forth6809.asm):02506         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02507         ;    Outputs:
                      (    forth6809.asm):02508         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02509         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02510         ; ------------------------------------------------------------
DBFB 3510             (    forth6809.asm):02511         LIT:        PULS  X
DBFD EC81             (    forth6809.asm):02512                     LDD   ,X++
DBFF 3606             (    forth6809.asm):02513                     PSHU  D                 ; x
DC01 3410             (    forth6809.asm):02514                     PSHS  X
DC03 39               (    forth6809.asm):02515                     RTS
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517         ; ------------------------------------------------------------
                      (    forth6809.asm):02518         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02519         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02520         ; address.
                      (    forth6809.asm):02521         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02522         ;    Inputs:
                      (    forth6809.asm):02523         ;        flag on the data stack
                      (    forth6809.asm):02524         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02525         ;    Outputs:
                      (    forth6809.asm):02526         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02527         ;        the offset
                      (    forth6809.asm):02528         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
DC04 3706             (    forth6809.asm):02530         ZBRANCH:    PULU  D                 ; flag
DC06 3510             (    forth6809.asm):02531                     PULS  X
DC08 10830000         (    forth6809.asm):02532                     CMPD  #0
DC0C 2607             (    forth6809.asm):02533                     BNE   ZSKIP
DC0E EC84             (    forth6809.asm):02534                     LDD   ,X
DC10 308B             (    forth6809.asm):02535                     LEAX  D,X
DC12 3410             (    forth6809.asm):02536                     PSHS  X
DC14 39               (    forth6809.asm):02537                     RTS
DC15 3002             (    forth6809.asm):02538         ZSKIP:      LEAX  2,X
DC17 3410             (    forth6809.asm):02539                     PSHS  X
DC19 39               (    forth6809.asm):02540                     RTS
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
                      (    forth6809.asm):02543         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02544         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02545         ; BRANCH
                      (    forth6809.asm):02546         ;    Inputs:
                      (    forth6809.asm):02547         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02548         ;    Outputs:
                      (    forth6809.asm):02549         ;        return address set to the branch target
                      (    forth6809.asm):02550         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02551         ; ------------------------------------------------------------
DC1A 3510             (    forth6809.asm):02552         BRANCH:     PULS  X
DC1C EC84             (    forth6809.asm):02553                     LDD   ,X
DC1E 308B             (    forth6809.asm):02554                     LEAX  D,X
DC20 3410             (    forth6809.asm):02555                     PSHS  X
DC22 39               (    forth6809.asm):02556                     RTS
                      (    forth6809.asm):02557         
                      (    forth6809.asm):02558         ; ------------------------------------------------------------
                      (    forth6809.asm):02559         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02560         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02561         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02562         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02563         ;    Inputs:
                      (    forth6809.asm):02564         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02565         ;        trampoline
                      (    forth6809.asm):02566         ;    Outputs:
                      (    forth6809.asm):02567         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02568         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02569         ; ------------------------------------------------------------
DC23 3510             (    forth6809.asm):02570         DODOES:     PULS  X
DC25 10AE81           (    forth6809.asm):02571                     LDY   ,X++
DC28 EC84             (    forth6809.asm):02572                     LDD   ,X
DC2A 3606             (    forth6809.asm):02573                     PSHU  D                 ; pfa
DC2C 6EA4             (    forth6809.asm):02574                     JMP   ,Y
                      (    forth6809.asm):02575         
                      (    forth6809.asm):02576         ; ------------------------------------------------------------
                      (    forth6809.asm):02577         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02578         ; field address on the stack.
                      (    forth6809.asm):02579         ; DOESRT0
                      (    forth6809.asm):02580         ;    Inputs:
                      (    forth6809.asm):02581         ;        none
                      (    forth6809.asm):02582         ;    Outputs:
                      (    forth6809.asm):02583         ;        none
                      (    forth6809.asm):02584         ;    Registers: none.
                      (    forth6809.asm):02585         ; ------------------------------------------------------------
DC2E 39               (    forth6809.asm):02586         DOESRT0:    RTS
                      (    forth6809.asm):02587         
                      (    forth6809.asm):02588         ; ------------------------------------------------------------
                      (    forth6809.asm):02589         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02590         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02591         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02592         ; SETDOES
                      (    forth6809.asm):02593         ;    Inputs:
                      (    forth6809.asm):02594         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02595         ;        BEHAVIOR)
                      (    forth6809.asm):02596         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02597         ;        address
                      (    forth6809.asm):02598         ;    Outputs:
                      (    forth6809.asm):02599         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02600         ;        defining word's caller
                      (    forth6809.asm):02601         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02602         ; ------------------------------------------------------------
DC2F 3510             (    forth6809.asm):02603         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DC31 1F12             (    forth6809.asm):02604                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02605         
DC33 9E04             (    forth6809.asm):02606                     LDX   LATEST
DC35 E684             (    forth6809.asm):02607                     LDB   ,X
DC37 C41F             (    forth6809.asm):02608                     ANDB  #$1F
DC39 4F               (    forth6809.asm):02609                     CLRA
DC3A 308B             (    forth6809.asm):02610                     LEAX  D,X               ; header + name length
DC3C EC03             (    forth6809.asm):02611                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DC3E C30003           (    forth6809.asm):02612                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DC41 1F01             (    forth6809.asm):02613                     TFR   D,X
                      (    forth6809.asm):02614         
DC43 10AF84           (    forth6809.asm):02615                     STY   ,X                ; patch it
                      (    forth6809.asm):02616         
DC46 3510             (    forth6809.asm):02617                     PULS  X                 ; X = the OUTER defining word's own return addr
DC48 6E84             (    forth6809.asm):02618                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02619         
                      (    forth6809.asm):02620         ; ------------------------------------------------------------
                      (    forth6809.asm):02621         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02622         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02623         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02624         ;    Inputs:
                      (    forth6809.asm):02625         ;        pfa on the data stack
                      (    forth6809.asm):02626         ;    Outputs:
                      (    forth6809.asm):02627         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02628         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02629         ; ------------------------------------------------------------
DC4A 3710             (    forth6809.asm):02630         DODEFER:    PULU  X                 ; pfa
DC4C EC84             (    forth6809.asm):02631                     LDD   ,X
DC4E 1F01             (    forth6809.asm):02632                     TFR   D,X
DC50 6E84             (    forth6809.asm):02633                     JMP   ,X
                      (    forth6809.asm):02634         
                      (    forth6809.asm):02635         ; ------------------------------------------------------------
                      (    forth6809.asm):02636         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02637         ; DOABORTUNDEF
                      (    forth6809.asm):02638         ;    Inputs:
                      (    forth6809.asm):02639         ;        none
                      (    forth6809.asm):02640         ;    Outputs:
                      (    forth6809.asm):02641         ;        none (does not return)
                      (    forth6809.asm):02642         ;    Registers: RegD changed.
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
DC52                  (    forth6809.asm):02644         DOABORTUNDEF:
DC52 CCFFEB           (    forth6809.asm):02645                     LDD   #-21
DC55 3606             (    forth6809.asm):02646                     PSHU  D                 ; throw code (-21)
DC57 7EE541           (    forth6809.asm):02647                     JMP   THROWW
                      (    forth6809.asm):02648         
                      (    forth6809.asm):02649         ; ------------------------------------------------------------
                      (    forth6809.asm):02650         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02651         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02652         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02653         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02654         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02655         ;    Inputs:
                      (    forth6809.asm):02656         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02657         ;    Outputs:
                      (    forth6809.asm):02658         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02659         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02660         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
DC5A 3710             (    forth6809.asm):02662         DOMARKER:   PULU  X                 ; pfa
DC5C EC84             (    forth6809.asm):02663                     LDD   ,X
DC5E DD06             (    forth6809.asm):02664                     STD   DPHERE
DC60 EC02             (    forth6809.asm):02665                     LDD   2,X
DC62 DD08             (    forth6809.asm):02666                     STD   CODEHERE
DC64 EC04             (    forth6809.asm):02667                     LDD   4,X
DC66 DD0A             (    forth6809.asm):02668                     STD   VARHERE
DC68 EC06             (    forth6809.asm):02669                     LDD   6,X
DC6A DD04             (    forth6809.asm):02670                     STD   LATEST
DC6C 3008             (    forth6809.asm):02671                     LEAX  8,X               ; the saved search-order state follows
DC6E 108E0045         (    forth6809.asm):02672                     LDY   #SRCHSAVE
DC72 C616             (    forth6809.asm):02673                     LDB   #SRCHSAVESZ
DC74 A680             (    forth6809.asm):02674         DMCOPY:     LDA   ,X+
DC76 A7A0             (    forth6809.asm):02675                     STA   ,Y+
DC78 5A               (    forth6809.asm):02676                     DECB
DC79 26F9             (    forth6809.asm):02677                     BNE   DMCOPY
DC7B DC06             (    forth6809.asm):02678                     LDD   DPHERE
DC7D 7EE1B0           (    forth6809.asm):02679                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02680         
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
                      (    forth6809.asm):02682         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02683         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02684         ; ------------------------------------------------------------
DC80 3710             (    forth6809.asm):02685         EXECUTEW:   PULU  X                 ; xt
DC82 AD84             (    forth6809.asm):02686                     JSR   ,X
DC84 39               (    forth6809.asm):02687                     RTS
                      (    forth6809.asm):02688         
                      (    forth6809.asm):02689         ; ============================================================
                      (    forth6809.asm):02690         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02691         ; ============================================================
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
                      (    forth6809.asm):02693         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02694         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02695         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02696         ;    Inputs:
                      (    forth6809.asm):02697         ;        RegX = address of the here pointer
                      (    forth6809.asm):02698         ;        x on the data stack
                      (    forth6809.asm):02699         ;    Outputs:
                      (    forth6809.asm):02700         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02701         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02702         ; ------------------------------------------------------------
DC85 3706             (    forth6809.asm):02703         APPENDCELL: PULU  D                 ; x
DC87 10AE84           (    forth6809.asm):02704                     LDY   ,X
DC8A EDA1             (    forth6809.asm):02705                     STD   ,Y++
DC8C 10AF84           (    forth6809.asm):02706                     STY   ,X
DC8F 39               (    forth6809.asm):02707                     RTS
                      (    forth6809.asm):02708         
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
                      (    forth6809.asm):02710         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02711         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02712         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02713         ;    Inputs:
                      (    forth6809.asm):02714         ;        RegX = address of the here pointer
                      (    forth6809.asm):02715         ;        char on the data stack
                      (    forth6809.asm):02716         ;    Outputs:
                      (    forth6809.asm):02717         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02718         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
DC90 3706             (    forth6809.asm):02720         APPENDBYTE: PULU  D                 ; char
DC92 10AE84           (    forth6809.asm):02721                     LDY   ,X
DC95 E7A0             (    forth6809.asm):02722                     STB   ,Y+
DC97 10AF84           (    forth6809.asm):02723                     STY   ,X
DC9A 39               (    forth6809.asm):02724                     RTS
                      (    forth6809.asm):02725         
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
                      (    forth6809.asm):02727         ; ,  ( x -- )
                      (    forth6809.asm):02728         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02729         ; ------------------------------------------------------------
DC9B 8E0008           (    forth6809.asm):02730         COMMAW:     LDX   #CODEHERE
DC9E 7EDC85           (    forth6809.asm):02731                     JMP   APPENDCELL
                      (    forth6809.asm):02732         
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
                      (    forth6809.asm):02734         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02735         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02736         ; ------------------------------------------------------------
DCA1 8E0008           (    forth6809.asm):02737         CODECOMMA:  LDX   #CODEHERE
DCA4 7EDC85           (    forth6809.asm):02738                     JMP   APPENDCELL
                      (    forth6809.asm):02739         
                      (    forth6809.asm):02740         ; ------------------------------------------------------------
                      (    forth6809.asm):02741         ; C,  ( char -- )
                      (    forth6809.asm):02742         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02743         ; ------------------------------------------------------------
DCA7 8E0008           (    forth6809.asm):02744         CCOMMAW:    LDX   #CODEHERE
DCAA 7EDC90           (    forth6809.asm):02745                     JMP   APPENDBYTE
                      (    forth6809.asm):02746         
                      (    forth6809.asm):02747         ; ------------------------------------------------------------
                      (    forth6809.asm):02748         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02749         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
DCAD 8E0008           (    forth6809.asm):02751         CCOMMA1:    LDX   #CODEHERE
DCB0 7EDC90           (    forth6809.asm):02752                     JMP   APPENDBYTE
                      (    forth6809.asm):02753         
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
                      (    forth6809.asm):02755         ; V,  ( x -- )
                      (    forth6809.asm):02756         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02757         ; ------------------------------------------------------------
DCB3 8E000A           (    forth6809.asm):02758         VCOMMAW:    LDX   #VARHERE
DCB6 7EDC85           (    forth6809.asm):02759                     JMP   APPENDCELL
                      (    forth6809.asm):02760         
                      (    forth6809.asm):02761         ; ------------------------------------------------------------
                      (    forth6809.asm):02762         ; VC,  ( char -- )
                      (    forth6809.asm):02763         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02764         ; ------------------------------------------------------------
DCB9 8E000A           (    forth6809.asm):02765         VCCOMMAW:   LDX   #VARHERE
DCBC 7EDC90           (    forth6809.asm):02766                     JMP   APPENDBYTE
                      (    forth6809.asm):02767         
                      (    forth6809.asm):02768         ; ------------------------------------------------------------
                      (    forth6809.asm):02769         ; ALLOT  ( n -- )
                      (    forth6809.asm):02770         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
DCBF 3706             (    forth6809.asm):02772         ALLOTW:     PULU  D                 ; n
DCC1 9E08             (    forth6809.asm):02773                     LDX   CODEHERE
DCC3 308B             (    forth6809.asm):02774                     LEAX  D,X
DCC5 9F08             (    forth6809.asm):02775                     STX   CODEHERE
DCC7 39               (    forth6809.asm):02776                     RTS
                      (    forth6809.asm):02777         
                      (    forth6809.asm):02778         ; ------------------------------------------------------------
                      (    forth6809.asm):02779         ; VALLOT  ( n -- )
                      (    forth6809.asm):02780         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
DCC8 3706             (    forth6809.asm):02782         VALLOTW:    PULU  D                 ; n
DCCA 9E0A             (    forth6809.asm):02783                     LDX   VARHERE
DCCC 308B             (    forth6809.asm):02784                     LEAX  D,X
DCCE 9F0A             (    forth6809.asm):02785                     STX   VARHERE
DCD0 39               (    forth6809.asm):02786                     RTS
                      (    forth6809.asm):02787         
                      (    forth6809.asm):02788         ; ------------------------------------------------------------
                      (    forth6809.asm):02789         ; HERE  ( -- addr )
                      (    forth6809.asm):02790         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
DCD1 DC08             (    forth6809.asm):02792         HEREW:      LDD   CODEHERE
DCD3 3606             (    forth6809.asm):02793                     PSHU  D                 ; addr
DCD5 39               (    forth6809.asm):02794                     RTS
                      (    forth6809.asm):02795         
                      (    forth6809.asm):02796         ; ------------------------------------------------------------
                      (    forth6809.asm):02797         ; VHERE  ( -- addr )
                      (    forth6809.asm):02798         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02799         ; ------------------------------------------------------------
DCD6 DC0A             (    forth6809.asm):02800         VHEREW:     LDD   VARHERE
DCD8 3606             (    forth6809.asm):02801                     PSHU  D                 ; addr
DCDA 39               (    forth6809.asm):02802                     RTS
                      (    forth6809.asm):02803         
                      (    forth6809.asm):02804         ; ------------------------------------------------------------
                      (    forth6809.asm):02805         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02806         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02807         ; ------------------------------------------------------------
DCDB DC08             (    forth6809.asm):02808         PADW:       LDD   CODEHERE
DCDD C30080           (    forth6809.asm):02809                     ADDD  #PADOFFSET
DCE0 3606             (    forth6809.asm):02810                     PSHU  D                 ; c-addr
DCE2 39               (    forth6809.asm):02811                     RTS
                      (    forth6809.asm):02812         
                      (    forth6809.asm):02813         ; ------------------------------------------------------------
                      (    forth6809.asm):02814         ; UNUSED  ( -- u )
                      (    forth6809.asm):02815         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02816         ; ------------------------------------------------------------
DCE3 CCB900           (    forth6809.asm):02817         UNUSEDW:    LDD   #CODETOP
DCE6 9308             (    forth6809.asm):02818                     SUBD  CODEHERE
DCE8 3606             (    forth6809.asm):02819                     PSHU  D                 ; u
DCEA 39               (    forth6809.asm):02820                     RTS
                      (    forth6809.asm):02821         
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
                      (    forth6809.asm):02823         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02824         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02825         ; ------------------------------------------------------------
DCEB CC1FFF           (    forth6809.asm):02826         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DCEE 930A             (    forth6809.asm):02827                     SUBD  VARHERE
DCF0 3606             (    forth6809.asm):02828                     PSHU  D                 ; u
DCF2 39               (    forth6809.asm):02829                     RTS
                      (    forth6809.asm):02830         
                      (    forth6809.asm):02831         ; ============================================================
                      (    forth6809.asm):02832         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02833         ; ============================================================
                      (    forth6809.asm):02834         ; ------------------------------------------------------------
                      (    forth6809.asm):02835         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02836         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02837         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02838         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02839         ; wordlist are updated.
                      (    forth6809.asm):02840         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02841         ;    Inputs:
                      (    forth6809.asm):02842         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02843         ;        name parsed from the input stream
                      (    forth6809.asm):02844         ;    Outputs:
                      (    forth6809.asm):02845         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02846         ;        LATEST = address of the new header
                      (    forth6809.asm):02847         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02848         ; ------------------------------------------------------------
DCF3 CC0020           (    forth6809.asm):02849         HEADER:     LDD   #32
DCF6 3606             (    forth6809.asm):02850                     PSHU  D
DCF8 BDE039           (    forth6809.asm):02851                     JSR   WORDW
DCFB 3710             (    forth6809.asm):02852                     PULU  X                 ; c-addr of the name
DCFD 3706             (    forth6809.asm):02853                     PULU  D                 ; smudge flag in B
DCFF A680             (    forth6809.asm):02854                     LDA   ,X+               ; name length, X = name text
DD01 3402             (    forth6809.asm):02855                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DD03 5D               (    forth6809.asm):02856                     TSTB
DD04 2702             (    forth6809.asm):02857                     BEQ   HDNOSM
DD06 8A40             (    forth6809.asm):02858                     ORA   #$40
DD08 109E06           (    forth6809.asm):02859         HDNOSM:     LDY   DPHERE
DD0B 3420             (    forth6809.asm):02860                     PSHS  Y                 ; 0,S = address of the new header
DD0D A7A0             (    forth6809.asm):02861                     STA   ,Y+
DD0F E662             (    forth6809.asm):02862                     LDB   2,S
DD11 2707             (    forth6809.asm):02863                     BEQ   HDNONM
DD13 A680             (    forth6809.asm):02864         HDCPY:      LDA   ,X+
DD15 A7A0             (    forth6809.asm):02865                     STA   ,Y+
DD17 5A               (    forth6809.asm):02866                     DECB
DD18 26F9             (    forth6809.asm):02867                     BNE   HDCPY
DD1A 9E47             (    forth6809.asm):02868         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
DD1C EC84             (    forth6809.asm):02869                     LDD   ,X
DD1E EDA1             (    forth6809.asm):02870                     STD   ,Y++              ; LINK = old head of that wordlist
DD20 DC08             (    forth6809.asm):02871                     LDD   CODEHERE
DD22 EDA1             (    forth6809.asm):02872                     STD   ,Y++
DD24 109F06           (    forth6809.asm):02873                     STY   DPHERE
DD27 3506             (    forth6809.asm):02874                     PULS  D
DD29 DD04             (    forth6809.asm):02875                     STD   LATEST            ; LATEST = newest header of any wordlist
DD2B ED84             (    forth6809.asm):02876                     STD   ,X                ; and the new head of the CURRENT wordlist
DD2D 3261             (    forth6809.asm):02877                     LEAS  1,S
DD2F 39               (    forth6809.asm):02878                     RTS
                      (    forth6809.asm):02879         
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
                      (    forth6809.asm):02881         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):02882         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):02883         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):02884         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):02885         ; SMUDGE   ( -- )
                      (    forth6809.asm):02886         ;    Inputs:
                      (    forth6809.asm):02887         ;        none
                      (    forth6809.asm):02888         ;    Outputs:
                      (    forth6809.asm):02889         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):02890         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
DD30 9E04             (    forth6809.asm):02892         SMUDGEW:    LDX   LATEST
DD32 A684             (    forth6809.asm):02893                     LDA   ,X
DD34 8840             (    forth6809.asm):02894                     EORA  #$40
DD36 A784             (    forth6809.asm):02895                     STA   ,X
DD38 39               (    forth6809.asm):02896                     RTS
                      (    forth6809.asm):02897         
                      (    forth6809.asm):02898         ; ============================================================
                      (    forth6809.asm):02899         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02900         ; ============================================================
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
                      (    forth6809.asm):02902         ; :  ( "name" -- )
                      (    forth6809.asm):02903         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02904         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02905         ; CSP and enter compile state.
                      (    forth6809.asm):02906         ; ------------------------------------------------------------
DD39 CCFFFF           (    forth6809.asm):02907         COLONW:     LDD   #TRUEV
DD3C 3606             (    forth6809.asm):02908                     PSHU  D
DD3E BDDCF3           (    forth6809.asm):02909                     JSR   HEADER
DD41 DC08             (    forth6809.asm):02910                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DD43 DD1F             (    forth6809.asm):02911                     STD   CURXT             ; See bugfix: COLONW.1
DD45 1F30             (    forth6809.asm):02912                     TFR   U,D
DD47 DD21             (    forth6809.asm):02913                     STD   CSP
DD49 CCFFFF           (    forth6809.asm):02914                     LDD   #-1
DD4C DD00             (    forth6809.asm):02915                     STD   STATE
DD4E 39               (    forth6809.asm):02916                     RTS
                      (    forth6809.asm):02917         
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
                      (    forth6809.asm):02919         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02920         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02921         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02922         ; new word and return to interpret state.
                      (    forth6809.asm):02923         ; ------------------------------------------------------------
DD4F CC0039           (    forth6809.asm):02924         SEMIW:      LDD   #RTSOPC
DD52 3606             (    forth6809.asm):02925                     PSHU  D
DD54 BDDCAD           (    forth6809.asm):02926                     JSR   CCOMMA1
DD57 1F30             (    forth6809.asm):02927                     TFR   U,D
DD59 109321           (    forth6809.asm):02928                     CMPD  CSP
DD5C 2703             (    forth6809.asm):02929                     BEQ   SEMIOK
DD5E BDE50C           (    forth6809.asm):02930                     JSR   CFERR
DD61 9E04             (    forth6809.asm):02931         SEMIOK:     LDX   LATEST
DD63 A684             (    forth6809.asm):02932                     LDA   ,X
DD65 84BF             (    forth6809.asm):02933                     ANDA  #$BF
DD67 A784             (    forth6809.asm):02934                     STA   ,X
DD69 CC0000           (    forth6809.asm):02935                     LDD   #0
DD6C DD00             (    forth6809.asm):02936                     STD   STATE
DD6E 39               (    forth6809.asm):02937                     RTS
                      (    forth6809.asm):02938         
                      (    forth6809.asm):02939         ; ------------------------------------------------------------
                      (    forth6809.asm):02940         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02941         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02942         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02943         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02944         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02945         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
DD6F DC08             (    forth6809.asm):02947         NONAMEW:    LDD   CODEHERE
DD71 3606             (    forth6809.asm):02948                     PSHU  D                 ; xt
DD73 DD1F             (    forth6809.asm):02949                     STD   CURXT             ; See bugfix: NONAMEW.1
DD75 1F30             (    forth6809.asm):02950                     TFR   U,D
DD77 DD21             (    forth6809.asm):02951                     STD   CSP
DD79 CCFFFF           (    forth6809.asm):02952                     LDD   #-1
DD7C DD00             (    forth6809.asm):02953                     STD   STATE
DD7E 39               (    forth6809.asm):02954                     RTS
                      (    forth6809.asm):02955         
                      (    forth6809.asm):02956         ; ------------------------------------------------------------
                      (    forth6809.asm):02957         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02958         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02959         ; BLDDOES
                      (    forth6809.asm):02960         ;    Inputs:
                      (    forth6809.asm):02961         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02962         ;    Outputs:
                      (    forth6809.asm):02963         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02964         ;    Registers: all changed.
                      (    forth6809.asm):02965         ; BLDSELF
                      (    forth6809.asm):02966         ;    Inputs:
                      (    forth6809.asm):02967         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02968         ;    Outputs:
                      (    forth6809.asm):02969         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02970         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02971         ;    Registers: all changed.
                      (    forth6809.asm):02972         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02973         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02974         ; ------------------------------------------------------------
DD7F 3406             (    forth6809.asm):02975         BLDDOES:    PSHS  D                 ; behaviour address
DD81 CC0000           (    forth6809.asm):02976                     LDD   #0
DD84 3606             (    forth6809.asm):02977                     PSHU  D
DD86 BDDCF3           (    forth6809.asm):02978                     JSR   HEADER
DD89 CCDC23           (    forth6809.asm):02979                     LDD   #DODOES
DD8C 3606             (    forth6809.asm):02980                     PSHU  D
DD8E BDE97C           (    forth6809.asm):02981                     JSR   CCALL
DD91 3506             (    forth6809.asm):02982                     PULS  D
DD93 3606             (    forth6809.asm):02983                     PSHU  D                 ; behaviour address
DD95 BDDCA1           (    forth6809.asm):02984                     JSR   CODECOMMA
DD98 39               (    forth6809.asm):02985                     RTS
                      (    forth6809.asm):02986         
DD99 BDDD7F           (    forth6809.asm):02987         BLDSELF:    JSR   BLDDOES
DD9C DC08             (    forth6809.asm):02988                     LDD   CODEHERE          ; PFA = the cell after this one
DD9E C30002           (    forth6809.asm):02989                     ADDD  #2                ; See bugfix: CONSTANTW.1
DDA1 3606             (    forth6809.asm):02990                     PSHU  D
DDA3 BDDCA1           (    forth6809.asm):02991                     JSR   CODECOMMA
DDA6 39               (    forth6809.asm):02992                     RTS
                      (    forth6809.asm):02993         
                      (    forth6809.asm):02994         ; ------------------------------------------------------------
                      (    forth6809.asm):02995         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02996         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02997         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02998         ; address in the code area, on the stack.
                      (    forth6809.asm):02999         ; ------------------------------------------------------------
DDA7 CCDC2E           (    forth6809.asm):03000         CREATEW:    LDD   #DOESRT0
DDAA BDDD99           (    forth6809.asm):03001                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DDAD 39               (    forth6809.asm):03002                     RTS
                      (    forth6809.asm):03003         
                      (    forth6809.asm):03004         ; ------------------------------------------------------------
                      (    forth6809.asm):03005         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03006         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03007         ; of the word being defined.
                      (    forth6809.asm):03008         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03009         ; ------------------------------------------------------------
DDAE CCDC2F           (    forth6809.asm):03010         DOESGTW:    LDD   #SETDOES
DDB1 3606             (    forth6809.asm):03011                     PSHU  D
DDB3 BDE97C           (    forth6809.asm):03012                     JSR   CCALL
DDB6 39               (    forth6809.asm):03013                     RTS
                      (    forth6809.asm):03014         
                      (    forth6809.asm):03015         ; ------------------------------------------------------------
                      (    forth6809.asm):03016         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03017         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03018         ; area, initialised to zero.
                      (    forth6809.asm):03019         ; ------------------------------------------------------------
DDB7 CC0000           (    forth6809.asm):03020         VARIABLEW:  LDD   #0
DDBA 3606             (    forth6809.asm):03021                     PSHU  D
DDBC BDDCF3           (    forth6809.asm):03022                     JSR   HEADER
DDBF CCDC23           (    forth6809.asm):03023                     LDD   #DODOES
DDC2 3606             (    forth6809.asm):03024                     PSHU  D
DDC4 BDE97C           (    forth6809.asm):03025                     JSR   CCALL
DDC7 CCDC2E           (    forth6809.asm):03026                     LDD   #DOESRT0
DDCA 3606             (    forth6809.asm):03027                     PSHU  D
DDCC BDDCA1           (    forth6809.asm):03028                     JSR   CODECOMMA
DDCF DC0A             (    forth6809.asm):03029                     LDD   VARHERE
DDD1 3606             (    forth6809.asm):03030                     PSHU  D
DDD3 BDDCA1           (    forth6809.asm):03031                     JSR   CODECOMMA
DDD6 CC0000           (    forth6809.asm):03032                     LDD   #0
DDD9 9E0A             (    forth6809.asm):03033                     LDX   VARHERE
DDDB ED81             (    forth6809.asm):03034                     STD   ,X++
DDDD 9F0A             (    forth6809.asm):03035                     STX   VARHERE
DDDF 39               (    forth6809.asm):03036                     RTS
                      (    forth6809.asm):03037         
                      (    forth6809.asm):03038         ; ------------------------------------------------------------
                      (    forth6809.asm):03039         ; @  ( a-addr -- x )
                      (    forth6809.asm):03040         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03041         ; ------------------------------------------------------------
DDE0 3710             (    forth6809.asm):03042         FETCHW:     PULU  X                 ; a-addr
DDE2 EC84             (    forth6809.asm):03043                     LDD   ,X
DDE4 3606             (    forth6809.asm):03044                     PSHU  D                 ; x
DDE6 39               (    forth6809.asm):03045                     RTS
                      (    forth6809.asm):03046         
                      (    forth6809.asm):03047         ; ------------------------------------------------------------
                      (    forth6809.asm):03048         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03049         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03050         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03051         ; ------------------------------------------------------------
DDE7 CCDDE0           (    forth6809.asm):03052         CONSTANTW:  LDD   #FETCHW
DDEA BDDD99           (    forth6809.asm):03053                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DDED BDDC9B           (    forth6809.asm):03054                     JSR   COMMAW
DDF0 39               (    forth6809.asm):03055                     RTS
                      (    forth6809.asm):03056         
                      (    forth6809.asm):03057         ; ------------------------------------------------------------
                      (    forth6809.asm):03058         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03059         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03060         ;    Inputs:
                      (    forth6809.asm):03061         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03062         ;    Outputs:
                      (    forth6809.asm):03063         ;        pfa replaced by the value
                      (    forth6809.asm):03064         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03065         ; ------------------------------------------------------------
DDF1 3710             (    forth6809.asm):03066         DOVALUE:    PULU  X                 ; pfa
DDF3 EC84             (    forth6809.asm):03067                     LDD   ,X
DDF5 3606             (    forth6809.asm):03068                     PSHU  D                 ; x
DDF7 39               (    forth6809.asm):03069                     RTS
                      (    forth6809.asm):03070         
                      (    forth6809.asm):03071         ; ------------------------------------------------------------
                      (    forth6809.asm):03072         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03073         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03074         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03075         ; ------------------------------------------------------------
DDF8 CCDDF1           (    forth6809.asm):03076         VALUEW:     LDD   #DOVALUE
DDFB BDDD7F           (    forth6809.asm):03077                     JSR   BLDDOES
DDFE DC0A             (    forth6809.asm):03078                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DE00 3606             (    forth6809.asm):03079                     PSHU  D                 ; See bugfix: VALUEW.1
DE02 BDDCA1           (    forth6809.asm):03080                     JSR   CODECOMMA
DE05 BDDCB3           (    forth6809.asm):03081                     JSR   VCOMMAW           ; store x in the variable area
DE08 39               (    forth6809.asm):03082                     RTS
                      (    forth6809.asm):03083         
                      (    forth6809.asm):03084         ; ------------------------------------------------------------
                      (    forth6809.asm):03085         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03086         ; lower address as 2@ expects.
                      (    forth6809.asm):03087         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03088         ; ------------------------------------------------------------
DE09 7EF34F           (    forth6809.asm):03089         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03090         
                      (    forth6809.asm):03091         ; ------------------------------------------------------------
                      (    forth6809.asm):03092         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03093         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03094         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03095         ; ------------------------------------------------------------
DE0C CCDE09           (    forth6809.asm):03096         TWOVALUEW:  LDD   #DO2VALUE
DE0F BDDD7F           (    forth6809.asm):03097                     JSR   BLDDOES
DE12 DC0A             (    forth6809.asm):03098                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DE14 3606             (    forth6809.asm):03099                     PSHU  D
DE16 BDDCA1           (    forth6809.asm):03100                     JSR   CODECOMMA
DE19 BDDCB3           (    forth6809.asm):03101                     JSR   VCOMMAW           ; x2 at the lower address
DE1C BDDCB3           (    forth6809.asm):03102                     JSR   VCOMMAW           ; then x1
DE1F 39               (    forth6809.asm):03103                     RTS
                      (    forth6809.asm):03104         
                      (    forth6809.asm):03105         ; ------------------------------------------------------------
                      (    forth6809.asm):03106         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03107         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03108         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03109         ; ------------------------------------------------------------
DE20 CC0020           (    forth6809.asm):03110         TOW:        LDD   #32
DE23 3606             (    forth6809.asm):03111                     PSHU  D
DE25 BDE039           (    forth6809.asm):03112                     JSR   WORDW
DE28 BDE122           (    forth6809.asm):03113                     JSR   FINDW
DE2B 3706             (    forth6809.asm):03114                     PULU  D
DE2D 10830000         (    forth6809.asm):03115                     CMPD  #0
DE31 260A             (    forth6809.asm):03116                     BNE   TOFOUND
DE33 3706             (    forth6809.asm):03117                     PULU  D
DE35 CCFFF3           (    forth6809.asm):03118                     LDD   #-13
DE38 3606             (    forth6809.asm):03119                     PSHU  D
DE3A BDE541           (    forth6809.asm):03120                     JSR   THROWW
DE3D AEC4             (    forth6809.asm):03121         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
DE3F EC03             (    forth6809.asm):03122                     LDD   3,X
DE41 1083DE09         (    forth6809.asm):03123                     CMPD  #DO2VALUE
DE45 271A             (    forth6809.asm):03124                     BEQ   TOTWO
DE47 BDEA3D           (    forth6809.asm):03125                     JSR   TOBODYW
DE4A DC00             (    forth6809.asm):03126                     LDD   STATE
DE4C 270C             (    forth6809.asm):03127                     BEQ   TOIMMED
DE4E BDE989           (    forth6809.asm):03128                     JSR   LITERALW
DE51 CCF330           (    forth6809.asm):03129                     LDD   #STOREW
DE54 3606             (    forth6809.asm):03130                     PSHU  D
DE56 BDE97C           (    forth6809.asm):03131                     JSR   CCALL
DE59 39               (    forth6809.asm):03132                     RTS
DE5A 3710             (    forth6809.asm):03133         TOIMMED:    PULU  X                 ; a-addr of the value cell
DE5C 3706             (    forth6809.asm):03134                     PULU  D                 ; x
DE5E ED84             (    forth6809.asm):03135                     STD   ,X
DE60 39               (    forth6809.asm):03136                     RTS
DE61 BDEA3D           (    forth6809.asm):03137         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
DE64 DC00             (    forth6809.asm):03138                     LDD   STATE
DE66 270C             (    forth6809.asm):03139                     BEQ   TOTWOIMM
DE68 BDE989           (    forth6809.asm):03140                     JSR   LITERALW
DE6B CCF35A           (    forth6809.asm):03141                     LDD   #TWOSTOREW
DE6E 3606             (    forth6809.asm):03142                     PSHU  D
DE70 BDE97C           (    forth6809.asm):03143                     JSR   CCALL
DE73 39               (    forth6809.asm):03144                     RTS
DE74 7EF35A           (    forth6809.asm):03145         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03146         
                      (    forth6809.asm):03147         ; ------------------------------------------------------------
                      (    forth6809.asm):03148         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03149         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03150         ; the variable area, initialised to zero.
                      (    forth6809.asm):03151         ; ------------------------------------------------------------
DE77                  (    forth6809.asm):03152         TWOVARIABLEW:
DE77 CC0000           (    forth6809.asm):03153                     LDD   #0
DE7A 3606             (    forth6809.asm):03154                     PSHU  D
DE7C BDDCF3           (    forth6809.asm):03155                     JSR   HEADER
DE7F CCDC23           (    forth6809.asm):03156                     LDD   #DODOES
DE82 3606             (    forth6809.asm):03157                     PSHU  D
DE84 BDE97C           (    forth6809.asm):03158                     JSR   CCALL
DE87 CCDC2E           (    forth6809.asm):03159                     LDD   #DOESRT0
DE8A 3606             (    forth6809.asm):03160                     PSHU  D
DE8C BDDCA1           (    forth6809.asm):03161                     JSR   CODECOMMA
DE8F DC0A             (    forth6809.asm):03162                     LDD   VARHERE
DE91 3606             (    forth6809.asm):03163                     PSHU  D
DE93 BDDCA1           (    forth6809.asm):03164                     JSR   CODECOMMA
DE96 CC0000           (    forth6809.asm):03165                     LDD   #0
DE99 9E0A             (    forth6809.asm):03166                     LDX   VARHERE
DE9B ED81             (    forth6809.asm):03167                     STD   ,X++
DE9D ED81             (    forth6809.asm):03168                     STD   ,X++
DE9F 9F0A             (    forth6809.asm):03169                     STX   VARHERE
DEA1 39               (    forth6809.asm):03170                     RTS
                      (    forth6809.asm):03171         
                      (    forth6809.asm):03172         ; ------------------------------------------------------------
                      (    forth6809.asm):03173         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):03174         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):03175         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):03176         ; ------------------------------------------------------------
DEA2                  (    forth6809.asm):03177         TWOCONSTANTW:
DEA2 CCF34F           (    forth6809.asm):03178                     LDD   #TWOFETCHW
DEA5 BDDD99           (    forth6809.asm):03179                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DEA8 3706             (    forth6809.asm):03180                     PULU  D                 ; x2
DEAA DD14             (    forth6809.asm):03181                     STD   MSCR
DEAC DC14             (    forth6809.asm):03182                     LDD   MSCR
DEAE 3606             (    forth6809.asm):03183                     PSHU  D
DEB0 BDDC9B           (    forth6809.asm):03184                     JSR   COMMAW            ; x2 -> lower address

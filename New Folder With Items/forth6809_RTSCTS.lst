                      (    forth6809.asm):09134         ; ------------------------------------------------------------
                      (    forth6809.asm):09135         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09136         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09137         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09138         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09139         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09140         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09141         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09142         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09143         ; available the skip ends.
                      (    forth6809.asm):09144         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09145         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09146         ; ------------------------------------------------------------
FEEC 3706             (    forth6809.asm):09147         BRIFW:      PULU  D
FEEE 10830000         (    forth6809.asm):09148                     CMPD  #0
FEF2 266D             (    forth6809.asm):09149                     BNE   BRTHENW           ; true: nothing to skip
FEF4 CC0001           (    forth6809.asm):09150         BRELSEW:    LDD   #1
FEF7 3406             (    forth6809.asm):09151                     PSHS  D                 ; level
FEF9 BDF5F3           (    forth6809.asm):09152         BRNEXT:     JSR   PARSENAMEW
FEFC 3706             (    forth6809.asm):09153                     PULU  D                 ; length
FEFE 3710             (    forth6809.asm):09154                     PULU  X                 ; address
FF00 10830000         (    forth6809.asm):09155                     CMPD  #0
FF04 274E             (    forth6809.asm):09156                     BEQ   BRREFILL
FF06 10830004         (    forth6809.asm):09157                     CMPD  #4
FF0A 2734             (    forth6809.asm):09158                     BEQ   BR4
FF0C 10830006         (    forth6809.asm):09159                     CMPD  #6

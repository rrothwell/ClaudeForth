                      (    forth6809.asm):04013         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):04014         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):04015         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):04016         ; UDMULADD
                      (    forth6809.asm):04017         ;    Inputs:
                      (    forth6809.asm):04018         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):04019         ;        frame ( ud c-addr u )
                      (    forth6809.asm):04020         ;        RegB = digit value to add
                      (    forth6809.asm):04021         ;        BASE
                      (    forth6809.asm):04022         ;    Outputs:
                      (    forth6809.asm):04023         ;        ud = ud * BASE + digit
                      (    forth6809.asm):04024         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04025         ; ------------------------------------------------------------
E350 327E             (    forth6809.asm):04026         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
E352 E7E4             (    forth6809.asm):04027                     STB   ,S
E354 9603             (    forth6809.asm):04028                     LDA   BASE+1
E356 A761             (    forth6809.asm):04029                     STA   1,S

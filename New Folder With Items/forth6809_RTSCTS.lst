                      (    forth6809.asm):04830         
                      (    forth6809.asm):04831         ; ------------------------------------------------------------
                      (    forth6809.asm):04832         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04833         ; return address.
                      (    forth6809.asm):04834         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04835         ;    Inputs:
                      (    forth6809.asm):04836         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04837         ;    Outputs:
                      (    forth6809.asm):04838         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04839         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04840         ; ------------------------------------------------------------
E711 3706             (    forth6809.asm):04841         DOSETUP:    PULU  D                 ; index
E713 DD14             (    forth6809.asm):04842                     STD   MSCR
E715 3706             (    forth6809.asm):04843                     PULU  D                 ; limit
E717 DD16             (    forth6809.asm):04844                     STD   MSCR2
E719 3510             (    forth6809.asm):04845                     PULS  X
E71B CC0000           (    forth6809.asm):04846                     LDD   #0
E71E 3406             (    forth6809.asm):04847                     PSHS  D
E720 DC16             (    forth6809.asm):04848                     LDD   MSCR2
E722 3406             (    forth6809.asm):04849                     PSHS  D
E724 DC14             (    forth6809.asm):04850                     LDD   MSCR
E726 3406             (    forth6809.asm):04851                     PSHS  D
E728 3410             (    forth6809.asm):04852                     PSHS  X
E72A 39               (    forth6809.asm):04853                     RTS
                      (    forth6809.asm):04854         
                      (    forth6809.asm):04855         ; ------------------------------------------------------------
                      (    forth6809.asm):04856         ; I  ( -- n )
                      (    forth6809.asm):04857         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04858         ; address).
                      (    forth6809.asm):04859         ; ------------------------------------------------------------
E72B EC62             (    forth6809.asm):04860         IW:         LDD   2,S               ; n. See bugfix: IW.1
E72D 3606             (    forth6809.asm):04861                     PSHU  D
E72F 39               (    forth6809.asm):04862                     RTS
                      (    forth6809.asm):04863         
                      (    forth6809.asm):04864         ; ------------------------------------------------------------
                      (    forth6809.asm):04865         ; J  ( -- n )
                      (    forth6809.asm):04866         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04867         ; address and the inner loop frame).
                      (    forth6809.asm):04868         ; ------------------------------------------------------------
E730 EC68             (    forth6809.asm):04869         JW:         LDD   8,S               ; n. See bugfix: JW.1
E732 3606             (    forth6809.asm):04870                     PSHU  D
E734 39               (    forth6809.asm):04871                     RTS
                      (    forth6809.asm):04872         
                      (    forth6809.asm):04873         ; ------------------------------------------------------------
                      (    forth6809.asm):04874         ; LEAVE  ( -- )

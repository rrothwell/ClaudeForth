                      (    forth6809.asm):08146         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):08147         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):08148         ; each %name% that matches the name registered by REPLACES with its

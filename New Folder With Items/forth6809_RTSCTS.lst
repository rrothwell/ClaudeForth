F6A1 ED42             (    forth6809.asm):07847                     STD   2,U
F6A3 20EB             (    forth6809.asm):07848                     BRA   CMPLOOP
F6A5 EC44             (    forth6809.asm):07849         CMTIEBREAK: LDD   4,U
F6A7 10A3C4           (    forth6809.asm):07850                     CMPD  ,U
F6AA 2507             (    forth6809.asm):07851                     BLO   CMLT
F6AC 220A             (    forth6809.asm):07852                     BHI   CMGT
F6AE CC0000           (    forth6809.asm):07853                     LDD   #0
F6B1 2008             (    forth6809.asm):07854                     BRA   CMOUT
F6B3 CCFFFF           (    forth6809.asm):07855         CMLT:       LDD   #-1
F6B6 2003             (    forth6809.asm):07856                     BRA   CMOUT

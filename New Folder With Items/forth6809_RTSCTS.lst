E620 3706             (    forth6809.asm):04693         AGAINW:     PULU  D
E622 10830002         (    forth6809.asm):04694                     CMPD  #TAGBACK
E626 2703             (    forth6809.asm):04695                     BEQ   AGOK
E628 BDE50C           (    forth6809.asm):04696                     JSR   CFERR
E62B 3706             (    forth6809.asm):04697         AGOK:       PULU  D                 ; dest
E62D 3606             (    forth6809.asm):04698                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E62F CCDC1A           (    forth6809.asm):04699                     LDD   #BRANCH
E632 3606             (    forth6809.asm):04700                     PSHU  D
E634 BDE97C           (    forth6809.asm):04701                     JSR   CCALL

DEB6 39               (    forth6809.asm):03186                     RTS
                      (    forth6809.asm):03187         
                      (    forth6809.asm):03188         ; ------------------------------------------------------------
                      (    forth6809.asm):03189         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):03190         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):03191         ; the variable area.
                      (    forth6809.asm):03192         ; ------------------------------------------------------------
DEB7                  (    forth6809.asm):03193         BUFFERCOLONW:
DEB7 3706             (    forth6809.asm):03194                     PULU  D                 ; u
DEB9 DD16             (    forth6809.asm):03195                     STD   MSCR2
DEBB CC0000           (    forth6809.asm):03196                     LDD   #0
DEBE 3606             (    forth6809.asm):03197                     PSHU  D
DEC0 BDDCF3           (    forth6809.asm):03198                     JSR   HEADER
DEC3 CCDC23           (    forth6809.asm):03199                     LDD   #DODOES
DEC6 3606             (    forth6809.asm):03200                     PSHU  D
DEC8 BDE97C           (    forth6809.asm):03201                     JSR   CCALL
DECB CCDC2E           (    forth6809.asm):03202                     LDD   #DOESRT0
DECE 3606             (    forth6809.asm):03203                     PSHU  D
DED0 BDDCA1           (    forth6809.asm):03204                     JSR   CODECOMMA
DED3 DC0A             (    forth6809.asm):03205                     LDD   VARHERE
DED5 3606             (    forth6809.asm):03206                     PSHU  D
DED7 BDDCA1           (    forth6809.asm):03207                     JSR   CODECOMMA
DEDA DC16             (    forth6809.asm):03208                     LDD   MSCR2

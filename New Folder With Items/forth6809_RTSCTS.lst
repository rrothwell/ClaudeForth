                      (    forth6809.asm):07826         ; ------------------------------------------------------------
                      (    forth6809.asm):07827         ; COMPARE  ( c-addr1 u1 c-addr2 u2 -- n )
                      (    forth6809.asm):07828         ; Compare two strings byte by byte. n is -1, 0 or 1 as the first
                      (    forth6809.asm):07829         ; string is less than, equal to or greater than the second; if one is
                      (    forth6809.asm):07830         ; a prefix of the other, the shorter is less.
                      (    forth6809.asm):07831         ; ------------------------------------------------------------
F680 AE46             (    forth6809.asm):07832         COMPAREW:   LDX   6,U                ; Parameters stay on the data stack: u2 at 0,
F682 10AE42           (    forth6809.asm):07833                     LDY   2,U               ; c-addr2 at 2, u1 at 4, c-addr1 at 6
F685 EC44             (    forth6809.asm):07834                     LDD   4,U

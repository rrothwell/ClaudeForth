E8C0 BDE97C           (    forth6809.asm):05157                     JSR   CCALL
E8C3 CC0000           (    forth6809.asm):05158                     LDD   #0
E8C6 3606             (    forth6809.asm):05159                     PSHU  D
E8C8 BDDCA1           (    forth6809.asm):05160                     JSR   CODECOMMA
E8CB DC08             (    forth6809.asm):05161                     LDD   CODEHERE
E8CD 830002           (    forth6809.asm):05162                     SUBD  #2
E8D0 3606             (    forth6809.asm):05163                     PSHU  D                 ; orig
E8D2 CCEAB6           (    forth6809.asm):05164                     LDD   #DROPW
E8D5 3606             (    forth6809.asm):05165                     PSHU  D
E8D7 BDE97C           (    forth6809.asm):05166                     JSR   CCALL
E8DA CC0005           (    forth6809.asm):05167                     LDD   #TAGOF
E8DD 3606             (    forth6809.asm):05168                     PSHU  D

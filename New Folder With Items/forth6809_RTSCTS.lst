                      (    forth6809.asm):07566         ; DOTSTR
                      (    forth6809.asm):07567         ;    Inputs:
                      (    forth6809.asm):07568         ;        return address on S points at the count byte
                      (    forth6809.asm):07569         ;    Outputs:
                      (    forth6809.asm):07570         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):07571         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07572         ; ------------------------------------------------------------
F508 3510             (    forth6809.asm):07573         DOTSTR:     PULS  X
F50A E684             (    forth6809.asm):07574                     LDB   ,X
F50C 3001             (    forth6809.asm):07575                     LEAX  1,X
F50E 3610             (    forth6809.asm):07576                     PSHU  X

                      (    forth6809.asm):04572         ; ============================================================
                      (    forth6809.asm):04573         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04574         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04575         ; ============================================================
                      (    forth6809.asm):04576         ; ------------------------------------------------------------
                      (    forth6809.asm):04577         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04578         ; location.
                      (    forth6809.asm):04579         ; PATCH   ( target location -- )
                      (    forth6809.asm):04580         ;    Inputs:
                      (    forth6809.asm):04581         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04582         ;    Outputs:
                      (    forth6809.asm):04583         ;        the cell at location holds target - location
                      (    forth6809.asm):04584         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04585         ; ------------------------------------------------------------
E576 3710             (    forth6809.asm):04586         PATCH:      PULU  X                 ; location
E578 3706             (    forth6809.asm):04587                     PULU  D                 ; target
E57A 3410             (    forth6809.asm):04588                     PSHS  X
E57C A3E1             (    forth6809.asm):04589                     SUBD  ,S++              ; target - location
E57E ED84             (    forth6809.asm):04590                     STD   ,X
E580 39               (    forth6809.asm):04591                     RTS
                      (    forth6809.asm):04592         
                      (    forth6809.asm):04593         ; ------------------------------------------------------------
                      (    forth6809.asm):04594         ; IF  ( C: -- orig )
                      (    forth6809.asm):04595         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04596         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04597         ; ------------------------------------------------------------
E581 CCDC04           (    forth6809.asm):04598         IFW:        LDD   #ZBRANCH
E584 3606             (    forth6809.asm):04599                     PSHU  D
E586 BDE97C           (    forth6809.asm):04600                     JSR   CCALL
E589 CC0000           (    forth6809.asm):04601                     LDD   #0
E58C 3606             (    forth6809.asm):04602                     PSHU  D
E58E BDDCA1           (    forth6809.asm):04603                     JSR   CODECOMMA
E591 DC08             (    forth6809.asm):04604                     LDD   CODEHERE
E593 830002           (    forth6809.asm):04605                     SUBD  #2
E596 3606             (    forth6809.asm):04606                     PSHU  D                 ; orig
E598 CC0001           (    forth6809.asm):04607                     LDD   #TAGFWD
E59B 3606             (    forth6809.asm):04608                     PSHU  D
E59D 39               (    forth6809.asm):04609                     RTS
                      (    forth6809.asm):04610         
                      (    forth6809.asm):04611         ; ------------------------------------------------------------
                      (    forth6809.asm):04612         ; THEN  ( C: orig -- )
                      (    forth6809.asm):04613         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04614         ; operand to jump to the current code address.
                      (    forth6809.asm):04615         ; ------------------------------------------------------------
E59E 3706             (    forth6809.asm):04616         THENW:      PULU  D
E5A0 10830001         (    forth6809.asm):04617                     CMPD  #TAGFWD
E5A4 2703             (    forth6809.asm):04618                     BEQ   THOK
E5A6 BDE50C           (    forth6809.asm):04619                     JSR   CFERR
E5A9 3710             (    forth6809.asm):04620         THOK:       PULU  X                 ; orig
E5AB DC08             (    forth6809.asm):04621                     LDD   CODEHERE
E5AD 3606             (    forth6809.asm):04622                     PSHU  D
E5AF 3610             (    forth6809.asm):04623                     PSHU  X
E5B1 BDE576           (    forth6809.asm):04624                     JSR   PATCH
E5B4 39               (    forth6809.asm):04625                     RTS
                      (    forth6809.asm):04626         
                      (    forth6809.asm):04627         ; ------------------------------------------------------------
                      (    forth6809.asm):04628         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):04629         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):04630         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):04631         ; ------------------------------------------------------------
E5B5 3706             (    forth6809.asm):04632         ELSEW:      PULU  D
E5B7 10830001         (    forth6809.asm):04633                     CMPD  #TAGFWD
E5BB 2703             (    forth6809.asm):04634                     BEQ   ELOK
E5BD BDE50C           (    forth6809.asm):04635                     JSR   CFERR
E5C0 3706             (    forth6809.asm):04636         ELOK:       PULU  D                 ; orig1
E5C2 3406             (    forth6809.asm):04637                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E5C4 CCDC1A           (    forth6809.asm):04638                     LDD   #BRANCH
E5C7 3606             (    forth6809.asm):04639                     PSHU  D
E5C9 BDE97C           (    forth6809.asm):04640                     JSR   CCALL
E5CC CC0000           (    forth6809.asm):04641                     LDD   #0
E5CF 3606             (    forth6809.asm):04642                     PSHU  D
E5D1 BDDCA1           (    forth6809.asm):04643                     JSR   CODECOMMA
E5D4 DC08             (    forth6809.asm):04644                     LDD   CODEHERE
E5D6 3606             (    forth6809.asm):04645                     PSHU  D
E5D8 3506             (    forth6809.asm):04646                     PULS  D                 ; orig1
E5DA 3606             (    forth6809.asm):04647                     PSHU  D
E5DC BDE576           (    forth6809.asm):04648                     JSR   PATCH
E5DF DC08             (    forth6809.asm):04649                     LDD   CODEHERE
E5E1 830002           (    forth6809.asm):04650                     SUBD  #2
E5E4 3606             (    forth6809.asm):04651                     PSHU  D                 ; orig2
E5E6 CC0001           (    forth6809.asm):04652                     LDD   #TAGFWD
E5E9 3606             (    forth6809.asm):04653                     PSHU  D
E5EB 39               (    forth6809.asm):04654                     RTS
                      (    forth6809.asm):04655         
                      (    forth6809.asm):04656         ; ------------------------------------------------------------
                      (    forth6809.asm):04657         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):04658         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):04659         ; stack.
                      (    forth6809.asm):04660         ; ------------------------------------------------------------
E5EC DC08             (    forth6809.asm):04661         BEGINW:     LDD   CODEHERE
E5EE 3606             (    forth6809.asm):04662                     PSHU  D                 ; dest
E5F0 CC0002           (    forth6809.asm):04663                     LDD   #TAGBACK
E5F3 3606             (    forth6809.asm):04664                     PSHU  D
E5F5 39               (    forth6809.asm):04665                     RTS
                      (    forth6809.asm):04666         
                      (    forth6809.asm):04667         ; ------------------------------------------------------------
                      (    forth6809.asm):04668         ; UNTIL  ( C: dest -- )

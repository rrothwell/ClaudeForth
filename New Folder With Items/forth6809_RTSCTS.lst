                      (    forth6809.asm):07550         ; CONVERT  ( ud1 c-addr1 -- ud2 c-addr2 )
                      (    forth6809.asm):07551         ; Obsolescent. Convert the digits after c-addr1 using >NUMBER with no
                      (    forth6809.asm):07552         ; length limit; c-addr2 is the first character that is not a digit.
                      (    forth6809.asm):07553         ; ------------------------------------------------------------

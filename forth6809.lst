                      (    forth6809.asm):02865         ; ------------------------------------------------------------
                      (    forth6809.asm):02866         ; INTERPRET  ( -- )
                      (    forth6809.asm):02867         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02868         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02869         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02870         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02871         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02872         ; ------------------------------------------------------------
E2BD                  (    forth6809.asm):02873         INTERPRET:
E2BD CC0020           (    forth6809.asm):02874         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1

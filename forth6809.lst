                      (    forth6809.asm):07197         ; TSTLEAVE - unit test for LEAVE. Compiles
                      (    forth6809.asm):07198         ; "DO I DUP 3 LITERAL = IF LEAVE THEN + LOOP", limit=10,
                      (    forth6809.asm):07199         ; start=0 - would normally visit I=0..9, but LEAVE forces exit
                      (    forth6809.asm):07200         ; once I=3 is reached. LEAVE only sets a flag; the actual exit
                      (    forth6809.asm):07201         ; happens at the NEXT LOOP check (per its own documented
                      (    forth6809.asm):07202         ; behavior, "exit at its next LOOP") - confirmed by hand-trace
                      (    forth6809.asm):07203         ; of DOTEST's own logic (checks the flag first, before its
                      (    forth6809.asm):07204         ; normal increment/compare). Since + runs before LOOP's check,
                      (    forth6809.asm):07205         ; I=3 IS accumulated before the loop exits - sum=0+1+2+3=6, not
                      (    forth6809.asm):07206         ; 0+1+2=3 (which would indicate LEAVE incorrectly took effect
                      (    forth6809.asm):07207         ; immediately) and not the full 0..9 (which would indicate
                      (    forth6809.asm):07208         ; LEAVE didn't work at all).
                      (    forth6809.asm):07209         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):07210         TSTLEAVE: LDD  CODEHERE
                      (    forth6809.asm):07211                   STD  TSTCSAV
                      (    forth6809.asm):07212                   LDD  #TSTCBUF
                      (    forth6809.asm):07213                   STD  CODEHERE
                      (    forth6809.asm):07214         
                      (    forth6809.asm):07215                   JSR  DO
                      (    forth6809.asm):07216         
                      (    forth6809.asm):07217                   LDD  #IWORD
                      (    forth6809.asm):07218                   PSHU D
                      (    forth6809.asm):07219                   JSR  CCALL
                      (    forth6809.asm):07220         
                      (    forth6809.asm):07221                   LDD  #DUP
                      (    forth6809.asm):07222                   PSHU D
                      (    forth6809.asm):07223                   JSR  CCALL
                      (    forth6809.asm):07224         
                      (    forth6809.asm):07225                   LDD  #3
                      (    forth6809.asm):07226                   PSHU D
                      (    forth6809.asm):07227                   JSR  LITERALW
                      (    forth6809.asm):07228         
                      (    forth6809.asm):07229                   LDD  #EQUALW
                      (    forth6809.asm):07230                   PSHU D

CF01 7C017D           (    forth6809.asm):02448                     INC   OVRNCOUNT
CF04 8540             (    forth6809.asm):02449         INXOVRN:    BITA  #SR_PE
CF06 2703             (    forth6809.asm):02450                     BEQ   INXPE
CF08 7C017E           (    forth6809.asm):02451                     INC   PECOUNT
CF0B 3B               (    forth6809.asm):02452         INXPE:      RTI
                      (    forth6809.asm):02453         
CF0C 1F98             (    forth6809.asm):02454         INOK:       TFR   B,A               ; Transfer good character from the receiver.

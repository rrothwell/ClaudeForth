                      (    forth6809.asm):01168                   STU  TSTUB4
                      (    forth6809.asm):01169         
                      (    forth6809.asm):01170                   JSR  SPACEW
                      (    forth6809.asm):01171         
                      (    forth6809.asm):01172                   STU  TSTUAF

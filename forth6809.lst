                      (    forth6809.asm):02224                    BNE   RLFAIL
                      (    forth6809.asm):02225                    PULU  D
                      (    forth6809.asm):02226                    CMPD  #TSTVAL3
                      (    forth6809.asm):02227                    BNE   RLFAIL
                      (    forth6809.asm):02228                    PULU  D
                      (    forth6809.asm):02229                    CMPD  #TSTVAL2
                      (    forth6809.asm):02230                    BNE   RLFAIL
                      (    forth6809.asm):02231                    PULU  D
                      (    forth6809.asm):02232                    CMPD  #TSTGUARD
                      (    forth6809.asm):02233                    BNE   RLFAIL
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235                    LDD   TSTUB4
                      (    forth6809.asm):02236                    SUBD  TSTUAF
                      (    forth6809.asm):02237                    CMPD  #-2
                      (    forth6809.asm):02238                    BNE   RLFAIL
                      (    forth6809.asm):02239         

                      (    forth6809.asm):06257         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):06258         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):06259         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):06260         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):06261         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):06262         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):06263         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):06264         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):06265         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):06266         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):06267         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):06268         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):06269         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):06270         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):06271         ; ------------------------------------------------------------
                      (    forth6809.asm):06272         
                      (    forth6809.asm):06273         ; ------------------------------------------------------------
                      (    forth6809.asm):06274         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):06275         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):06276         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):06277         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):06278         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):06279         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):06280         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):06281         ; ------------------------------------------------------------
C245                  (    forth6809.asm):06282         TSTIFT1: LDD   CODEHERE
                      (    forth6809.asm):06283                  STD   TSTCSAV
                      (    forth6809.asm):06284                  LDD   #TSTCBUF
                      (    forth6809.asm):06285                  STD   CODEHERE
                      (    forth6809.asm):06286         
                      (    forth6809.asm):06287                  JSR   IF
                      (    forth6809.asm):06288         
                      (    forth6809.asm):06289                  LDD   #111
                      (    forth6809.asm):06290                  PSHU  D
                      (    forth6809.asm):06291                  JSR   LITERALW
                      (    forth6809.asm):06292         
                      (    forth6809.asm):06293                  JSR   THEN
                      (    forth6809.asm):06294         
                      (    forth6809.asm):06295                  LDD   #OPRTS
                      (    forth6809.asm):06296                  PSHU  D
                      (    forth6809.asm):06297                  JSR   CCOMMA
                      (    forth6809.asm):06298         
                      (    forth6809.asm):06299                  LDD   TSTCSAV
                      (    forth6809.asm):06300                  STD   CODEHERE
                      (    forth6809.asm):06301         
                      (    forth6809.asm):06302                  STU   TSTU0
                      (    forth6809.asm):06303         
                      (    forth6809.asm):06304                  LDD   #TSTGUARD
                      (    forth6809.asm):06305                  PSHU  D
                      (    forth6809.asm):06306                  LDD   #TRUEV
                      (    forth6809.asm):06307                  PSHU  D
                      (    forth6809.asm):06308                  STU   TSTUB4
                      (    forth6809.asm):06309         
                      (    forth6809.asm):06310                  JSR   TSTCBUF
                      (    forth6809.asm):06311         
                      (    forth6809.asm):06312                  STU   TSTUAF
                      (    forth6809.asm):06313         
                      (    forth6809.asm):06314                  PULU  D
                      (    forth6809.asm):06315                  CMPD  #111

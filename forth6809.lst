                      (    forth6809.asm):11124                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11125                       BNE  PSFAIL
                      (    forth6809.asm):11126         
                      (    forth6809.asm):11127                       PULU D
                      (    forth6809.asm):11128                       CMPD #TSTGUARD
                      (    forth6809.asm):11129                       BNE  PSFAIL
                      (    forth6809.asm):11130         
                      (    forth6809.asm):11131                       LDD  TSTUB4
                      (    forth6809.asm):11132                       SUBD TSTUAF
                      (    forth6809.asm):11133                       CMPD #-4
                      (    forth6809.asm):11134                       BNE  PSFAIL
                      (    forth6809.asm):11135         
                      (    forth6809.asm):11136                       LDD  #TRUEV
                      (    forth6809.asm):11137                       BRA  PSDONE
C29B                  (    forth6809.asm):11138         PSFAIL:       LDD  #FALSEV
C29B                  (    forth6809.asm):11139         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11140                       PSHU X
                      (    forth6809.asm):11141                       PSHU D
                      (    forth6809.asm):11142                       JSR  TSTREPORT
                      (    forth6809.asm):11143         

DEBA DEAA             (    forth6809.asm):01864                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01865                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01866                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01867                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):01868                  FDB   ABORT
                      (    forth6809.asm):01869         

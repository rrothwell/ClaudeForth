                      (    forth6809.asm):06252         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06253         ; ============================================================
                      (    forth6809.asm):06254         ; ------------------------------------------------------------
                      (    forth6809.asm):06255         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06256         ; address and length and skip over it.
                      (    forth6809.asm):06257         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06258         ;    Inputs:
                      (    forth6809.asm):06259         ;        return address on S points at the count byte
                      (    forth6809.asm):06260         ;    Outputs:
                      (    forth6809.asm):06261         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06262         ;        string
                      (    forth6809.asm):06263         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06264         ; ------------------------------------------------------------
F3BD 3510             (    forth6809.asm):06265         DOSTR:      PULS  X
F3BF E684             (    forth6809.asm):06266                     LDB   ,X
F3C1 3001             (    forth6809.asm):06267                     LEAX  1,X
F3C3 3610             (    forth6809.asm):06268                     PSHU  X
F3C5 4F               (    forth6809.asm):06269                     CLRA
F3C6 3606             (    forth6809.asm):06270                     PSHU  D
F3C8 3085             (    forth6809.asm):06271                     LEAX  B,X
F3CA 3410             (    forth6809.asm):06272                     PSHS  X
F3CC 39               (    forth6809.asm):06273                     RTS
                      (    forth6809.asm):06274         
                      (    forth6809.asm):06275         ; ------------------------------------------------------------
                      (    forth6809.asm):06276         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06277         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06278         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06279         ; PARSEQUOTE
                      (    forth6809.asm):06280         ;    Inputs:
                      (    forth6809.asm):06281         ;        none (parses from >IN)
                      (    forth6809.asm):06282         ;    Outputs:
                      (    forth6809.asm):06283         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06284         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06285         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06286         ; ------------------------------------------------------------
F3CD CC0022           (    forth6809.asm):06287         PARSEQUOTE: LDD   #34
F3D0 3606             (    forth6809.asm):06288                     PSHU  D
F3D2 BDF499           (    forth6809.asm):06289                     JSR   PARSEW
F3D5 6DC4             (    forth6809.asm):06290                     TST   ,U                ; high byte of the length
F3D7 2601             (    forth6809.asm):06291                     BNE   PQLONG
F3D9 39               (    forth6809.asm):06292                     RTS
F3DA CCFFEE           (    forth6809.asm):06293         PQLONG:     LDD   #-18
F3DD 3606             (    forth6809.asm):06294                     PSHU  D
F3DF 7EE63E           (    forth6809.asm):06295                     JMP   THROWW
                      (    forth6809.asm):06296         
                      (    forth6809.asm):06297         ; ------------------------------------------------------------
                      (    forth6809.asm):06298         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06299         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06300         ;    Inputs:
                      (    forth6809.asm):06301         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06302         ;        c-addr u on the data stack
                      (    forth6809.asm):06303         ;    Outputs:
                      (    forth6809.asm):06304         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06305         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06306         ; ------------------------------------------------------------
F3E2 3606             (    forth6809.asm):06307         CSTRCOMP:   PSHU  D
F3E4 BDEA79           (    forth6809.asm):06308                     JSR   CCALL
F3E7 3706             (    forth6809.asm):06309                     PULU  D                 ; u
F3E9 3720             (    forth6809.asm):06310                     PULU  Y                 ; c-addr
F3EB 9E08             (    forth6809.asm):06311                     LDX   CODEHERE
F3ED E780             (    forth6809.asm):06312                     STB   ,X+
F3EF 5D               (    forth6809.asm):06313                     TSTB
F3F0 2707             (    forth6809.asm):06314                     BEQ   CSEND

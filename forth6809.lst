                      (    forth6809.asm):02278                    BNE   RLFAIL
                      (    forth6809.asm):02279                    PULU  D
                      (    forth6809.asm):02280                    CMPD  #TSTGUARD
                      (    forth6809.asm):02281                    BNE   RLFAIL
                      (    forth6809.asm):02282         

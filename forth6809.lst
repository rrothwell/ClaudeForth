                      (    forth6809.asm):08032         ; ------------------------------------------------------------
                      (    forth6809.asm):08033         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08034         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08035         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08036         ; enter COLD.
                      (    forth6809.asm):08037         ; COLDSTRT
                      (    forth6809.asm):08038         ;    Inputs:
                      (    forth6809.asm):08039         ;        hardware reset
                      (    forth6809.asm):08040         ;    Outputs:
                      (    forth6809.asm):08041         ;        does not return
                      (    forth6809.asm):08042         ;    Registers: all registers initialised.
                      (    forth6809.asm):08043         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08044         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08045                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08046                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08047                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08048                     CLRA
FFAE 1F8B             (    forth6809.asm):08049                     TFR   A,DP
                      (    forth6809.asm):08050         
FFB0 8E0000           (    forth6809.asm):08051                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08052                     LDB   #0
FFB5 6F80             (    forth6809.asm):08053         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):08054                     DECB
FFB8 26FB             (    forth6809.asm):08055                     BNE   CLRGLOB
                      (    forth6809.asm):08056         
FFBA BDDCE3           (    forth6809.asm):08057                     JSR   INITSERIAL
                      (    forth6809.asm):08058         
FFBD 1CAF             (    forth6809.asm):08059                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08060         
                      (    forth6809.asm):08061                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08062         
                      (    forth6809.asm):08063                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08064                     JSR   TSTRUNNER
                      (    forth6809.asm):08065                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08066                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08067                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):08068                     NOP
                      (    forth6809.asm):08069                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08070         
FFC2 7EDE84           (    forth6809.asm):08071                     JMP   COLD
                      (    forth6809.asm):08072         
                      (    forth6809.asm):08073         ; ------------------------------------------------------------
                      (    forth6809.asm):08074         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08075         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08076         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08077         ; WARM
                      (    forth6809.asm):08078         ;    Inputs:
                      (    forth6809.asm):08079         ;        NMI
                      (    forth6809.asm):08080         ;    Outputs:
                      (    forth6809.asm):08081         ;        does not return
                      (    forth6809.asm):08082         ;    Registers: all registers initialised.
                      (    forth6809.asm):08083         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):08084         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08085                     CLRA
FFC8 1F8B             (    forth6809.asm):08086                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08087                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08088                     LDS   #RP0
                      (    forth6809.asm):08089         
FFD1 BDDCE3           (    forth6809.asm):08090                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):08091         
FFD4 8EFFE6           (    forth6809.asm):08092                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08093                     PSHU  X
FFD9 CC0006           (    forth6809.asm):08094                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08095                     PSHU  D
FFDE BDF555           (    forth6809.asm):08096                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):08097                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE3 7EDEC3           (    forth6809.asm):08098                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):08099         
FFE6 20207761726D     (    forth6809.asm):08100         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):08101         WARMMSGL    EQU   *-WARMMSG

                      (    forth6809.asm):06297                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):06298                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):06299                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):06300                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):06301                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):06302                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):06303                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):06304                   ; high cell.
E5C3 0D22             (    forth6809.asm):06305                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):06306                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):06307                   LDD   UDLO
E5C9 43               (    forth6809.asm):06308                   COMA
E5CA 53               (    forth6809.asm):06309                   COMB
E5CB C30001           (    forth6809.asm):06310                   ADDD  #1
E5CE DD76             (    forth6809.asm):06311                   STD   UDLO
E5D0 3401             (    forth6809.asm):06312                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):06313                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):06314                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):06315                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):06316                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):06317                                      ; silently overwrote the real carry here
                      (    forth6809.asm):06318                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):06319                                      ; making the high-cell increment run
                      (    forth6809.asm):06320                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):06321                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):06322                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):06323                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):06324                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):06325                                      ; matching "always increment" rather than
                      (    forth6809.asm):06326                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):06327                   LDD   UDHI
E5D4 43               (    forth6809.asm):06328                   COMA
E5D5 53               (    forth6809.asm):06329                   COMB
E5D6 3501             (    forth6809.asm):06330                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):06331                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):06332                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):06333                                      ; when there's no carry - the complemented
                      (    forth6809.asm):06334                                      ; value was computed in D but never
                      (    forth6809.asm):06335                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):06336                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):06337                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):06338                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):06339                                      ; was always seen as set, so this branch
                      (    forth6809.asm):06340                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):06341                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):06342                                      ; alone would have made this second,
                      (    forth6809.asm):06343                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):06344                                      ; only past the "+1", never past the
                      (    forth6809.asm):06345                                      ; store itself - the store always runs,
                      (    forth6809.asm):06346                                      ; either way.
E5DA C30001           (    forth6809.asm):06347                   ADDD  #1
E5DD DD74             (    forth6809.asm):06348         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):06349         
E5DF                  (    forth6809.asm):06350         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):06351                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):06352                   LDX   CADDR
E5E1 E684             (    forth6809.asm):06353                   LDB   ,X
E5E3 5A               (    forth6809.asm):06354                   DECB

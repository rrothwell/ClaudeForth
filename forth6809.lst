                      (    forth6809.asm):10452         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (    forth6809.asm):10453         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (    forth6809.asm):10454         ; IS tests, but gets its own dedicated test here too.
                      (    forth6809.asm):10455         ;
                      (    forth6809.asm):10456         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (    forth6809.asm):10457         ; itself (a pure address computation) - wrong, confirmed via
                      (    forth6809.asm):10458         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (    forth6809.asm):10459         ; returning the VALUE stored there, not the address itself. This
                      (    forth6809.asm):10460         ; is genuinely correct behavior for this system's own trampoline
                      (    forth6809.asm):10461         ; design, not a bug in TOBODY - reconciled directly against why
                      (    forth6809.asm):10462         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (    forth6809.asm):10463         ; same TOBODY and passed on real hardware, never surfaced this:
                      (    forth6809.asm):10464         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (    forth6809.asm):10465         ; own compile-time code stores a genuinely meaningful value at
                      (    forth6809.asm):10466         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (    forth6809.asm):10467         ; value) - "the body" for this system's own design IS the value
                      (    forth6809.asm):10468         ; at xt+5, not xt+5's own address. This test never initialized
                      (    forth6809.asm):10469         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (    forth6809.asm):10470         ; whatever garbage happened to already be there - now sets a
                      (    forth6809.asm):10471         ; known value there first and verifies TOBODY returns exactly
                      (    forth6809.asm):10472         ; that.
                      (    forth6809.asm):10473         ; ------------------------------------------------------------
C272                  (    forth6809.asm):10474         TSTTOBODY: LDD  #TSTVAL1
                      (    forth6809.asm):10475                    STD  TSTCBUF+5
                      (    forth6809.asm):10476         
                      (    forth6809.asm):10477                    STU  TSTU0
                      (    forth6809.asm):10478         
                      (    forth6809.asm):10479                    LDD  #TSTGUARD
                      (    forth6809.asm):10480                    PSHU D
                      (    forth6809.asm):10481                    LDD  #TSTCBUF
                      (    forth6809.asm):10482                    PSHU D
                      (    forth6809.asm):10483                    STU  TSTUB4
                      (    forth6809.asm):10484         
                      (    forth6809.asm):10485                    JSR  TOBODY
                      (    forth6809.asm):10486         
                      (    forth6809.asm):10487                    STU  TSTUAF
                      (    forth6809.asm):10488         
                      (    forth6809.asm):10489                    PULU D
                      (    forth6809.asm):10490                    CMPD #TSTVAL1
                      (    forth6809.asm):10491                    BNE  TBFAIL
                      (    forth6809.asm):10492                    PULU D
                      (    forth6809.asm):10493                    CMPD #TSTGUARD
                      (    forth6809.asm):10494                    BNE  TBFAIL
                      (    forth6809.asm):10495         
                      (    forth6809.asm):10496                    LDD  TSTUB4
                      (    forth6809.asm):10497                    SUBD TSTUAF
                      (    forth6809.asm):10498                    CMPD #0
                      (    forth6809.asm):10499                    BNE  TBFAIL
                      (    forth6809.asm):10500         
                      (    forth6809.asm):10501                    LDD  #TRUEV
                      (    forth6809.asm):10502                    BRA  TBDONE
C272                  (    forth6809.asm):10503         TBFAIL:    LDD  #FALSEV
C272                  (    forth6809.asm):10504         TBDONE:    LDX  #TSTTBNAME
                      (    forth6809.asm):10505                    PSHU X
                      (    forth6809.asm):10506                    PSHU D
                      (    forth6809.asm):10507                    JSR  TSTREPORT
                      (    forth6809.asm):10508         
                      (    forth6809.asm):10509                    LDU  TSTU0
                      (    forth6809.asm):10510                    RTS
                      (    forth6809.asm):10511         
C272                  (    forth6809.asm):10512         TSTTBNAME: FCB  9
                      (    forth6809.asm):10513                    FCC  "TSTTOBODY"
                      (    forth6809.asm):10514         

                      (    forth6809.asm):03774                     ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03775                     ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03776                     ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03777                     ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03778                     ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03779                     ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03780                     ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03781                     ; high cell.
E482 0D22             (    forth6809.asm):03782                     TST   NUMNEG
E484 2718             (    forth6809.asm):03783                     BEQ   NQPOS32
E486 DC76             (    forth6809.asm):03784                     LDD   UDLO
E488 43               (    forth6809.asm):03785                     COMA
E489 53               (    forth6809.asm):03786                     COMB
E48A C30001           (    forth6809.asm):03787                     ADDD  #1
E48D DD76             (    forth6809.asm):03788                     STD   UDLO
E48F 3401             (    forth6809.asm):03789                     PSHS  CC                ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03790                                             ; addition above, before it gets destroyed.
                      (    forth6809.asm):03791                                             ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03792                                             ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03793                                             ; operand - a documented quirk, but one that
                      (    forth6809.asm):03794                                             ; silently overwrote the real carry here

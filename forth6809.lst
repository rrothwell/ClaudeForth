                      (    forth6809.asm):02260         
                      (    forth6809.asm):02261                     LDA   ACIASR           ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02262                     BITA  #SR_CTS
                      (    forth6809.asm):02263                     BNE   FLUSHED          ; Yes! Exit.
                      (    forth6809.asm):02264         
                      (    forth6809.asm):02265                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02266                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02267                                              ; than spin-wait here.
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269                     LDX   #OUTBUF         ; The out buffer is occupied.

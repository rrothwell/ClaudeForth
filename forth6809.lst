E914 EC62             (    forth6809.asm):04153                     LDD   2,S
E916 D329             (    forth6809.asm):04154                     ADDD  MSCR              ; new_index = old_index + step
E918 ED62             (    forth6809.asm):04155                     STD   2,S
E91A A364             (    forth6809.asm):04156                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E91C DD2D             (    forth6809.asm):04157                     STD   MSCR3
                      (    forth6809.asm):04158                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04159                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04160                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

                      (    forth6809.asm):01527         ; SERBUFCLR
                      (    forth6809.asm):01528         ;    Inputs:
                      (    forth6809.asm):01529         ;        none
                      (    forth6809.asm):01530         ;    Outputs:
                      (    forth6809.asm):01531         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01532         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01533         ;    Registers: only CC changed.

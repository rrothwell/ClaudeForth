                      (    forth6809.asm):02380         ; ------------------------------------------------------------
                      (    forth6809.asm):02381         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02382         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02383         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02384         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02385         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02386         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02387         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02388         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02389         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02390         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02391         ;
                      (    forth6809.asm):02392         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02393         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02394         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02395         ; right value once.
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
C19E BDFC2B           (    forth6809.asm):02397         TSTRETSTACK: JSR CRW
C1A1 8EC1B2           (    forth6809.asm):02398                    LDX   #TSTRETMSG
C1A4 3610             (    forth6809.asm):02399                    PSHU  X
C1A6 CC0008           (    forth6809.asm):02400                    LDD   #8
C1A9 3606             (    forth6809.asm):02401                    PSHU  D
C1AB BDF60B           (    forth6809.asm):02402                    JSR   TYPE
C1AE BDFC2B           (    forth6809.asm):02403                    JSR   CRW
                      (    forth6809.asm):02404         
                      (    forth6809.asm):02405                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02406         
                      (    forth6809.asm):02407                    JSR   TSTTOR
                      (    forth6809.asm):02408                    JSR   TSTRFETCH
                      (    forth6809.asm):02409                    JSR   TSTTWOTOR
                      (    forth6809.asm):02410                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412                    ENDC ; <<<<
                      (    forth6809.asm):02413         
C1B1 39               (    forth6809.asm):02414                    RTS
                      (    forth6809.asm):02415         
C1B2 526574537461636B (    forth6809.asm):02416         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02417         
                      (    forth6809.asm):02418                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02419         
                      (    forth6809.asm):02420         ; ------------------------------------------------------------
                      (    forth6809.asm):02421         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02422         ; every other test group in this file, these words operate
                      (    forth6809.asm):02423         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02424         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02425         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02426         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02427         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02428         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02429         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02430         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02431         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02432         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02433         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02434         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02435         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
                      (    forth6809.asm):02437         
                      (    forth6809.asm):02438         ; ------------------------------------------------------------
                      (    forth6809.asm):02439         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02440         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02441         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02442         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02443         ; value would never actually have left.
                      (    forth6809.asm):02444         ; ------------------------------------------------------------
C1BA                  (    forth6809.asm):02445         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02446         
                      (    forth6809.asm):02447                  LDD   #TSTGUARD
                      (    forth6809.asm):02448                  PSHU  D
                      (    forth6809.asm):02449                  LDD   #TSTVAL1
                      (    forth6809.asm):02450                  PSHU  D
                      (    forth6809.asm):02451                  STU   TSTUB4
                      (    forth6809.asm):02452         
                      (    forth6809.asm):02453                  JSR   TOR
                      (    forth6809.asm):02454         
                      (    forth6809.asm):02455                  STU   TSTUMID
                      (    forth6809.asm):02456         
                      (    forth6809.asm):02457                  LDD   TSTUB4
                      (    forth6809.asm):02458                  SUBD  TSTUMID
                      (    forth6809.asm):02459                  CMPD  #-2
                      (    forth6809.asm):02460                  BNE   TRFAIL
                      (    forth6809.asm):02461         
                      (    forth6809.asm):02462                  JSR   FROMR
                      (    forth6809.asm):02463         
                      (    forth6809.asm):02464                  STU   TSTUAF
                      (    forth6809.asm):02465         
                      (    forth6809.asm):02466                  PULU  D
                      (    forth6809.asm):02467                  CMPD  #TSTVAL1
                      (    forth6809.asm):02468                  BNE   TRFAIL
                      (    forth6809.asm):02469                  PULU  D
                      (    forth6809.asm):02470                  CMPD  #TSTGUARD
                      (    forth6809.asm):02471                  BNE   TRFAIL
                      (    forth6809.asm):02472         
                      (    forth6809.asm):02473                  LDD   TSTUB4
                      (    forth6809.asm):02474                  SUBD  TSTUAF
                      (    forth6809.asm):02475                  CMPD  #0
                      (    forth6809.asm):02476                  BNE   TRFAIL
                      (    forth6809.asm):02477         
                      (    forth6809.asm):02478                  LDD   #TRUEV
                      (    forth6809.asm):02479                  BRA   TRDONE
C1BA                  (    forth6809.asm):02480         TRFAIL:  LDD   #FALSEV
C1BA                  (    forth6809.asm):02481         TRDONE:  LDX   #TSTTORNAME
                      (    forth6809.asm):02482                  PSHU  X
                      (    forth6809.asm):02483                  PSHU  D
                      (    forth6809.asm):02484                  JSR   TSTREPORT
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486                  LDU   TSTU0
                      (    forth6809.asm):02487                  RTS
                      (    forth6809.asm):02488         
C1BA                  (    forth6809.asm):02489         TSTTORNAME: FCB  6
                      (    forth6809.asm):02490                     FCC  "TSTTOR"
                      (    forth6809.asm):02491         
                      (    forth6809.asm):02492         ; ------------------------------------------------------------
                      (    forth6809.asm):02493         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02494         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02495         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02496         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02497         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02498         ; not assumed from the name.
                      (    forth6809.asm):02499         ; ------------------------------------------------------------
C1BA                  (    forth6809.asm):02500         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02501         
                      (    forth6809.asm):02502                    LDD  #TSTGUARD
                      (    forth6809.asm):02503                    PSHU D
                      (    forth6809.asm):02504                    LDD  #TSTVAL1
                      (    forth6809.asm):02505                    PSHU D
                      (    forth6809.asm):02506                    STU  TSTUB4
                      (    forth6809.asm):02507         
                      (    forth6809.asm):02508                    JSR  TOR
                      (    forth6809.asm):02509                    JSR  RFETCH
                      (    forth6809.asm):02510                    JSR  FROMR
                      (    forth6809.asm):02511         
                      (    forth6809.asm):02512                    STU  TSTUAF
                      (    forth6809.asm):02513         
                      (    forth6809.asm):02514                    PULU D
                      (    forth6809.asm):02515                    CMPD #TSTVAL1
                      (    forth6809.asm):02516                    BNE  RFFAIL
                      (    forth6809.asm):02517                    PULU D
                      (    forth6809.asm):02518                    CMPD #TSTVAL1
                      (    forth6809.asm):02519                    BNE  RFFAIL
                      (    forth6809.asm):02520                    PULU D
                      (    forth6809.asm):02521                    CMPD #TSTGUARD
                      (    forth6809.asm):02522                    BNE  RFFAIL
                      (    forth6809.asm):02523         
                      (    forth6809.asm):02524                    LDD  TSTUB4
                      (    forth6809.asm):02525                    SUBD TSTUAF
                      (    forth6809.asm):02526                    CMPD #2
                      (    forth6809.asm):02527                    BNE  RFFAIL
                      (    forth6809.asm):02528         
                      (    forth6809.asm):02529                    LDD  #TRUEV
                      (    forth6809.asm):02530                    BRA  RFDONE
C1BA                  (    forth6809.asm):02531         RFFAIL:    LDD  #FALSEV
C1BA                  (    forth6809.asm):02532         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02533                    PSHU X
                      (    forth6809.asm):02534                    PSHU D
                      (    forth6809.asm):02535                    JSR  TSTREPORT
                      (    forth6809.asm):02536         
                      (    forth6809.asm):02537                    LDU  TSTU0
                      (    forth6809.asm):02538                    RTS
                      (    forth6809.asm):02539         
C1BA                  (    forth6809.asm):02540         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02541                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02542         
                      (    forth6809.asm):02543         ; ------------------------------------------------------------
                      (    forth6809.asm):02544         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02545         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02546         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02547         ; verifying the round trip.
                      (    forth6809.asm):02548         ; ------------------------------------------------------------
C1BA                  (    forth6809.asm):02549         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02550         
                      (    forth6809.asm):02551                    LDD  #TSTGUARD
                      (    forth6809.asm):02552                    PSHU D
                      (    forth6809.asm):02553                    LDD  #TSTVAL1
                      (    forth6809.asm):02554                    PSHU D
                      (    forth6809.asm):02555                    LDD  #TSTVAL2
                      (    forth6809.asm):02556                    PSHU D
                      (    forth6809.asm):02557                    STU  TSTUB4
                      (    forth6809.asm):02558         
                      (    forth6809.asm):02559                    JSR  TWOTOR
                      (    forth6809.asm):02560         
                      (    forth6809.asm):02561                    STU  TSTUMID
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563                    LDD  TSTUB4
                      (    forth6809.asm):02564                    SUBD TSTUMID
                      (    forth6809.asm):02565                    CMPD #-4
                      (    forth6809.asm):02566                    BNE  T2RFAIL
                      (    forth6809.asm):02567         
                      (    forth6809.asm):02568                    JSR  TWOFROMR
                      (    forth6809.asm):02569         
                      (    forth6809.asm):02570                    STU  TSTUAF
                      (    forth6809.asm):02571         
                      (    forth6809.asm):02572                    PULU D
                      (    forth6809.asm):02573                    CMPD #TSTVAL2
                      (    forth6809.asm):02574                    BNE  T2RFAIL
                      (    forth6809.asm):02575                    PULU D
                      (    forth6809.asm):02576                    CMPD #TSTVAL1
                      (    forth6809.asm):02577                    BNE  T2RFAIL
                      (    forth6809.asm):02578                    PULU D
                      (    forth6809.asm):02579                    CMPD #TSTGUARD
                      (    forth6809.asm):02580                    BNE  T2RFAIL
                      (    forth6809.asm):02581         
                      (    forth6809.asm):02582                    LDD  TSTUB4
                      (    forth6809.asm):02583                    SUBD TSTUAF
                      (    forth6809.asm):02584                    CMPD #0
                      (    forth6809.asm):02585                    BNE  T2RFAIL
                      (    forth6809.asm):02586         
                      (    forth6809.asm):02587                    LDD  #TRUEV
                      (    forth6809.asm):02588                    BRA  T2RDONE
C1BA                  (    forth6809.asm):02589         T2RFAIL:   LDD  #FALSEV
C1BA                  (    forth6809.asm):02590         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02591                    PSHU X
                      (    forth6809.asm):02592                    PSHU D
                      (    forth6809.asm):02593                    JSR  TSTREPORT
                      (    forth6809.asm):02594         
                      (    forth6809.asm):02595                    LDU  TSTU0
                      (    forth6809.asm):02596                    RTS
                      (    forth6809.asm):02597         
C1BA                  (    forth6809.asm):02598         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02599                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02600         
                      (    forth6809.asm):02601         ; ------------------------------------------------------------
                      (    forth6809.asm):02602         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02603         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02604         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02605         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02606         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
C1BA                  (    forth6809.asm):02608         TSTTWORFETCH: STU  TSTU0
                      (    forth6809.asm):02609         
                      (    forth6809.asm):02610                       LDD  #TSTGUARD
                      (    forth6809.asm):02611                       PSHU D
                      (    forth6809.asm):02612                       LDD  #TSTVAL1
                      (    forth6809.asm):02613                       PSHU D
                      (    forth6809.asm):02614                       LDD  #TSTVAL2
                      (    forth6809.asm):02615                       PSHU D
                      (    forth6809.asm):02616                       STU  TSTUB4
                      (    forth6809.asm):02617         
                      (    forth6809.asm):02618                       JSR  TWOTOR
                      (    forth6809.asm):02619                       JSR  TWORFETCH
                      (    forth6809.asm):02620                       JSR  TWOFROMR
                      (    forth6809.asm):02621         
                      (    forth6809.asm):02622                       STU  TSTUAF
                      (    forth6809.asm):02623         
                      (    forth6809.asm):02624                       PULU D
                      (    forth6809.asm):02625                       CMPD #TSTVAL2
                      (    forth6809.asm):02626                       BNE  T2FFAIL
                      (    forth6809.asm):02627                       PULU D
                      (    forth6809.asm):02628                       CMPD #TSTVAL1
                      (    forth6809.asm):02629                       BNE  T2FFAIL
                      (    forth6809.asm):02630                       PULU D
                      (    forth6809.asm):02631                       CMPD #TSTVAL2
                      (    forth6809.asm):02632                       BNE  T2FFAIL
                      (    forth6809.asm):02633                       PULU D
                      (    forth6809.asm):02634                       CMPD #TSTVAL1
                      (    forth6809.asm):02635                       BNE  T2FFAIL
                      (    forth6809.asm):02636                       PULU D
                      (    forth6809.asm):02637                       CMPD #TSTGUARD
                      (    forth6809.asm):02638                       BNE  T2FFAIL
                      (    forth6809.asm):02639         
                      (    forth6809.asm):02640                       LDD  TSTUB4
                      (    forth6809.asm):02641                       SUBD TSTUAF
                      (    forth6809.asm):02642                       CMPD #4
                      (    forth6809.asm):02643                       BNE  T2FFAIL
                      (    forth6809.asm):02644         
                      (    forth6809.asm):02645                       LDD  #TRUEV
                      (    forth6809.asm):02646                       BRA  T2FDONE
C1BA                  (    forth6809.asm):02647         T2FFAIL:       LDD  #FALSEV
C1BA                  (    forth6809.asm):02648         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02649                       PSHU X
                      (    forth6809.asm):02650                       PSHU D
                      (    forth6809.asm):02651                       JSR  TSTREPORT
                      (    forth6809.asm):02652         
                      (    forth6809.asm):02653                       LDU  TSTU0
                      (    forth6809.asm):02654                       RTS
                      (    forth6809.asm):02655         
C1BA                  (    forth6809.asm):02656         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02657                           FCC  "TSTTWORFETCH"
                      (    forth6809.asm):02658         
                      (    forth6809.asm):02659                    ENDC ; <<<<
                      (    forth6809.asm):02660         
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
                      (    forth6809.asm):02662         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02663         ; Covers every word in that section, with representative
                      (    forth6809.asm):02664         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02665         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02666         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02667         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02668         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02669         ; cases chosen.
                      (    forth6809.asm):02670         ; ------------------------------------------------------------
C1BA BDFC2B           (    forth6809.asm):02671         TSTSARITH: JSR   CRW
C1BD 8EC1CE           (    forth6809.asm):02672                    LDX   #TSTSARITHMSG
C1C0 3610             (    forth6809.asm):02673                    PSHU  X
C1C2 CC000B           (    forth6809.asm):02674                    LDD   #11
C1C5 3606             (    forth6809.asm):02675                    PSHU  D
C1C7 BDF60B           (    forth6809.asm):02676                    JSR   TYPE
C1CA BDFC2B           (    forth6809.asm):02677                    JSR   CRW
                      (    forth6809.asm):02678         
                      (    forth6809.asm):02679                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):02680         
                      (    forth6809.asm):02681                    JSR   TSTPLUS
                      (    forth6809.asm):02682                    JSR   TSTMINUS
                      (    forth6809.asm):02683                    JSR   TSTSTAR1
                      (    forth6809.asm):02684                    JSR   TSTSTAR2
                      (    forth6809.asm):02685                    JSR   TSTSLASH1
                      (    forth6809.asm):02686                    JSR   TSTSLASH2
                      (    forth6809.asm):02687                    JSR   TSTSLASHZ
                      (    forth6809.asm):02688                    JSR   TSTMODW
                      (    forth6809.asm):02689                    JSR   TSTMODZ
                      (    forth6809.asm):02690                    JSR   TSTSLMOD
                      (    forth6809.asm):02691                    JSR   TSTSLMODZ
                      (    forth6809.asm):02692                    JSR   TSTNEGATE
                      (    forth6809.asm):02693                    JSR   TSTABS1
                      (    forth6809.asm):02694                    JSR   TSTABS2
                      (    forth6809.asm):02695                    JSR   TSTMIN1
                      (    forth6809.asm):02696                    JSR   TSTMIN2
                      (    forth6809.asm):02697                    JSR   TSTMAX1
                      (    forth6809.asm):02698                    JSR   TSTMAX2
                      (    forth6809.asm):02699                    JSR   TSTONEP
                      (    forth6809.asm):02700                    JSR   TSTONEM
                      (    forth6809.asm):02701                    JSR   TSTTWOP
                      (    forth6809.asm):02702                    JSR   TSTTWOS
                      (    forth6809.asm):02703                    JSR   TSTTWOD1
                      (    forth6809.asm):02704                    JSR   TSTTWOD2
                      (    forth6809.asm):02705                    JSR   TSTSTSL
                      (    forth6809.asm):02706                    JSR   TSTSTSLZ
                      (    forth6809.asm):02707                    JSR   TSTSTSM
                      (    forth6809.asm):02708                    JSR   TSTSTSMZ
                      (    forth6809.asm):02709         
                      (    forth6809.asm):02710                    ENDC ; <<<<
                      (    forth6809.asm):02711         
C1CD 39               (    forth6809.asm):02712                    RTS
                      (    forth6809.asm):02713         
C1CE 5341726974686D65 (    forth6809.asm):02714         TSTSARITHMSG: FCC "SArithmetic"

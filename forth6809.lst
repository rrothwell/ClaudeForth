                      (    forth6809.asm):06985         ;    Inputs:
                      (    forth6809.asm):06986         ;        RegD = byte count, RegX = source address, U = SUBSTITUTE's
                      (    forth6809.asm):06987         ;        frame (6,U output length, 8,U write pointer, 10,U capacity)
                      (    forth6809.asm):06988         ;    Outputs:
                      (    forth6809.asm):06989         ;        bytes appended at the write pointer; length and pointer advanced

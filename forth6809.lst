                      (    forth6809.asm):15270         ; TSTTHROWZERO - unit test for THROW(0). Confirmed via its own
                      (    forth6809.asm):15271         ; code that N=0 is a genuine, unconditional no-op (BEQ THDONE
                      (    forth6809.asm):15272         ; skips everything, never touching HANDLER or ABORT), so this
                      (    forth6809.asm):15273         ; is the one THROW call in this section safe to make directly,
                      (    forth6809.asm):15274         ; without any CATCH wrapping it. Verifies it consumes its
                      (    forth6809.asm):15275         ; argument and does nothing else - no non-local exit, no stack
                      (    forth6809.asm):15276         ; disturbance beyond popping the 0 itself.
                      (    forth6809.asm):15277         ; ------------------------------------------------------------

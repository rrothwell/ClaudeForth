                      (    forth6809.asm):08071         ; ============================================================
                      (    forth6809.asm):08072         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):08073         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):08074         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):08075         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):08076         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):08077         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):08078         ; ============================================================
                      (    forth6809.asm):08079         ; ------------------------------------------------------------
                      (    forth6809.asm):08080         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):08081         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):08082         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):08083         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):08084         ; - no indirection, no value cell.
                      (    forth6809.asm):08085         ;
                      (    forth6809.asm):08086         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):08087         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):08088         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):08089         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):08090         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):08091         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):08092         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):08093         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):08094         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):08095         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):08096         ; ------------------------------------------------------------
FEA1 CCFFFF           (    forth6809.asm):08097         TRUEBODY:  LDD   #$FFFF
FEA4 3606             (    forth6809.asm):08098                    PSHU  D
FEA6 39               (    forth6809.asm):08099                    RTS
                      (    forth6809.asm):08100         
FEA7 CC0000           (    forth6809.asm):08101         FALSEBODY: LDD   #$0000
FEAA 3606             (    forth6809.asm):08102                    PSHU  D
FEAC 39               (    forth6809.asm):08103                    RTS
                      (    forth6809.asm):08104         
                      (    forth6809.asm):08105         ; ------------------------------------------------------------
                      (    forth6809.asm):08106         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):08107         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):08108         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):08109         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):08110         ; ------------------------------------------------------------
FEAD CC0001           (    forth6809.asm):08111         ONEBODY:   LDD   #1
FEB0 3606             (    forth6809.asm):08112                    PSHU  D
FEB2 39               (    forth6809.asm):08113                    RTS
                      (    forth6809.asm):08114         
FEB3 CCFFFF           (    forth6809.asm):08115         MONEBODY:  LDD   #-1
FEB6 3606             (    forth6809.asm):08116                    PSHU  D
FEB8 39               (    forth6809.asm):08117                    RTS
                      (    forth6809.asm):08118         
FEB9 CC0002           (    forth6809.asm):08119         TWOBODY:   LDD   #2
FEBC 3606             (    forth6809.asm):08120                    PSHU  D
FEBE 39               (    forth6809.asm):08121                    RTS
                      (    forth6809.asm):08122         
FEBF CCFFFE           (    forth6809.asm):08123         MTWOBODY:  LDD   #-2
FEC2 3606             (    forth6809.asm):08124                    PSHU  D
FEC4 39               (    forth6809.asm):08125                    RTS
                      (    forth6809.asm):08126         
                      (    forth6809.asm):08127         ; Verify no collision with init code,
                      (    forth6809.asm):08128         ; value should match ORG INITCODE.
     FEC5             (    forth6809.asm):08129         BASECODEEND  EQU   *
     2171             (    forth6809.asm):08130         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):08131         
                      (    forth6809.asm):08132         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08133         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):08134         ; .bin file.
FEC5                  (    forth6809.asm):08135         BASEND:
FEC5 FFFFFFFFFFFFFFFF (    forth6809.asm):08136                  FILL $FF,INITCODE-BASEND

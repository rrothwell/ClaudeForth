                      (    forth6809.asm):04819         ; TSTLOGIC - logic, shift, and address-arithmetic tests (glossary
                      (    forth6809.asm):04820         ; section 3.6). Covers every word in that section. Several of
                      (    forth6809.asm):04821         ; these (INVERT, CELLS, CELL+, CHARS, CHAR+, ALIGNED) modify the
                      (    forth6809.asm):04822         ; top of stack in place (LDD/op/STD) rather than PULU/PSHU - the
                      (    forth6809.asm):04823         ; tests verify what's observable via the stack either way, not
                      (    forth6809.asm):04824         ; how each implementation gets there. Three words (CHARS, ALIGN,
                      (    forth6809.asm):04825         ; ALIGNED) are documented no-ops on this system; CHARS/ALIGNED
                      (    forth6809.asm):04826         ; still get a normal single-value test (verifying identity),
                      (    forth6809.asm):04827         ; while ALIGN - which takes no stack arguments at all - gets a
                      (    forth6809.asm):04828         ; dedicated test pushing decoy values to confirm the whole stack,
                      (    forth6809.asm):04829         ; not just one value, is genuinely undisturbed. RSHIFT tested
                      (    forth6809.asm):04830         ; against a negative input specifically, since it's documented
                      (    forth6809.asm):04831         ; logical (zero-fill), not arithmetic (sign-preserving) - the
                      (    forth6809.asm):04832         ; case that actually distinguishes the two conventions, same
                      (    forth6809.asm):04833         ; reasoning already applied to 2/ and FM/MOD vs SM/REM earlier.
                      (    forth6809.asm):04834         ; ------------------------------------------------------------
C100                  (    forth6809.asm):04835         TSTLOGIC:  JSR   CRW
                      (    forth6809.asm):04836                    LDX   #TSTLOGICMSG
                      (    forth6809.asm):04837                    PSHU  X
                      (    forth6809.asm):04838                    LDD   #5
                      (    forth6809.asm):04839                    PSHU  D
                      (    forth6809.asm):04840                    JSR   TYPE
                      (    forth6809.asm):04841                    JSR   CRW
                      (    forth6809.asm):04842         
                      (    forth6809.asm):04843                    IFEQ TSTSELECTOR-5  ; >>>>
                      (    forth6809.asm):04844         
                      (    forth6809.asm):04845                    JSR   TSTAND
                      (    forth6809.asm):04846                    JSR   TSTOR
                      (    forth6809.asm):04847                    JSR   TSTXOR
                      (    forth6809.asm):04848                    JSR   TSTINV
                      (    forth6809.asm):04849                    JSR   TSTLSH
                      (    forth6809.asm):04850                    JSR   TSTRSH
                      (    forth6809.asm):04851                    JSR   TSTCELS
                      (    forth6809.asm):04852                    JSR   TSTCELP
                      (    forth6809.asm):04853                    JSR   TSTCHRS
                      (    forth6809.asm):04854                    JSR   TSTCHRP
                      (    forth6809.asm):04855                    JSR   TSTALGD
                      (    forth6809.asm):04856                    JSR   TSTALGN
                      (    forth6809.asm):04857         
                      (    forth6809.asm):04858                    ENDC ; <<<<
                      (    forth6809.asm):04859         
                      (    forth6809.asm):04860                    RTS
                      (    forth6809.asm):04861         
C100                  (    forth6809.asm):04862         TSTLOGICMSG: FCC "Logic"
                      (    forth6809.asm):04863         
                      (    forth6809.asm):04864                    IFEQ TSTSELECTOR-5  ; >>>>
                      (    forth6809.asm):04865         
                      (    forth6809.asm):04866         ; ------------------------------------------------------------

                      (    forth6809.asm):07751         ; ------------------------------------------------------------
                      (    forth6809.asm):07752         ; TSTDEFWORDS - defining-words tests (glossary section 3.9, 17
                      (    forth6809.asm):07753         ; words, 12 tests since VALUE/TO and IS/ACTION-OF are each
                      (    forth6809.asm):07754         ; combined into one test). Every defining word parses a name
                      (    forth6809.asm):07755         ; from the input source via WORD (HEADER's own mechanism,
                      (    forth6809.asm):07756         ; shared by :/CREATE) - a complexity nothing in section 3.8 had.
                      (    forth6809.asm):07757         ; Each test redirects CODEHERE, DPHERE, VARHERE, and
                      (    forth6809.asm):07758         ; SRCADDR/SRCLEN/TOIN together (a fake name, "TESTWD", reused
                      (    forth6809.asm):07759         ; safely across every test here since each redirect/restore
                      (    forth6809.asm):07760         ; cycle is fully isolated), calls the real defining word
                      (    forth6809.asm):07761         ; directly, saves the newly-defined word's own CFA (= CODEHERE
                      (    forth6809.asm):07762         ; at the moment the defining word was called), restores
                      (    forth6809.asm):07763         ; everything, then executes that CFA directly to verify runtime
                      (    forth6809.asm):07764         ; behavior.
                      (    forth6809.asm):07765         ;
                      (    forth6809.asm):07766         ; A real, structurally important finding from this section:
                      (    forth6809.asm):07767         ; HEADER writes to the real LATEST variable unconditionally, not
                      (    forth6809.asm):07768         ; a redirectable copy like CODEHERE/DPHERE/VARHERE - every test
                      (    forth6809.asm):07769         ; here explicitly saves and restores it, confirmed necessary by
                      (    forth6809.asm):07770         ; reading HEADER's own code directly, not assumed safe by analogy
                      (    forth6809.asm):07771         ; with the other three pointers.
                      (    forth6809.asm):07772         ;
                      (    forth6809.asm):07773         ; MARKER's own test is the one exception to the general
                      (    forth6809.asm):07774         ; redirect-then-restore-then-execute order: DOMARKER (confirmed
                      (    forth6809.asm):07775         ; by reading it directly) writes to the real DPHERE/CODEHERE/
                      (    forth6809.asm):07776         ; VARHERE/LATEST unconditionally too, so that test executes the
                      (    forth6809.asm):07777         ; marker word while still redirected, only restoring the real
                      (    forth6809.asm):07778         ; environment afterward - getting this order backwards would
                      (    forth6809.asm):07779         ; have corrupted the real dictionary pointers with scratch
                      (    forth6809.asm):07780         ; addresses.
                      (    forth6809.asm):07781         ;
                      (    forth6809.asm):07782         ; Bare CREATE (never followed by DOES>) is deliberately not
                      (    forth6809.asm):07783         ; tested on its own - traced its placeholder "behavior field"
                      (    forth6809.asm):07784         ; (a genuine compiled JSR DOESRT0 instruction) and confirmed
                      (    forth6809.asm):07785         ; DODOES reads that field as raw data, not as code to execute -
                      (    forth6809.asm):07786         ; which only produces a valid jump target for the raw-address
                      (    forth6809.asm):07787         ; form every other defining word uses (VARIABLE, CONSTANT, etc,
                      (    forth6809.asm):07788         ; via CODECOMMA), not CREATE's own placeholder JSR instruction.
                      (    forth6809.asm):07789         ; Bare CREATE's own direct-execution behavior isn't meant to be
                      (    forth6809.asm):07790         ; relied upon before a DOES> patches it.
                      (    forth6809.asm):07791         ; ------------------------------------------------------------
C23C BDFC2B           (    forth6809.asm):07792         TSTDEFWORDS: JSR CRW
C23F 8EC250           (    forth6809.asm):07793                    LDX   #TSTDEFMSG
C242 3610             (    forth6809.asm):07794                    PSHU  X
C244 CC0008           (    forth6809.asm):07795                    LDD   #8
C247 3606             (    forth6809.asm):07796                    PSHU  D
C249 BDF60B           (    forth6809.asm):07797                    JSR   TYPE
C24C BDFC2B           (    forth6809.asm):07798                    JSR   CRW
                      (    forth6809.asm):07799         
                      (    forth6809.asm):07800                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07801         
                      (    forth6809.asm):07802                    JSR   TSTVAR
                      (    forth6809.asm):07803                    JSR   TSTCONST
                      (    forth6809.asm):07804                    JSR   TSTCOLON
                      (    forth6809.asm):07805                    JSR   TSTCRDOES
                      (    forth6809.asm):07806                    JSR   TST2VAR
                      (    forth6809.asm):07807                    JSR   TST2CONST
                      (    forth6809.asm):07808                    JSR   TSTBUFC
                      (    forth6809.asm):07809                    JSR   TSTVALTO
                      (    forth6809.asm):07810                    JSR   TSTDEFER1
                      (    forth6809.asm):07811                    JSR   TSTDEFER2
                      (    forth6809.asm):07812                    JSR   TSTISOF
                      (    forth6809.asm):07813                    JSR   TSTMARKER

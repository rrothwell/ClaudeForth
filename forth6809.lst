EE05 0967             (    forth6809.asm):05279                     ROL   DIVREM+1
EE07 0966             (    forth6809.asm):05280                     ROL   DIVREM
EE09 DC66             (    forth6809.asm):05281                     LDD   DIVREM
EE0B 9364             (    forth6809.asm):05282                     SUBD  DIVDEN

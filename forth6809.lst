DED6 3606             (    forth6809.asm):05846                     PSHU  D
DED8 AF42             (    forth6809.asm):05847                     STX   2,U
DEDA ED44             (    forth6809.asm):05848                     STD   4,U
DEDC 39               (    forth6809.asm):05849                     RTS
                      (    forth6809.asm):05850         
                      (    forth6809.asm):05851         ; ------------------------------------------------------------
                      (    forth6809.asm):05852         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05853         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05854         ; ------------------------------------------------------------
DEDD 3706             (    forth6809.asm):05855         PICKW:      PULU  D                 ; u
DEDF 58               (    forth6809.asm):05856                     LSLB
DEE0 49               (    forth6809.asm):05857                     ROLA
DEE1 ECCB             (    forth6809.asm):05858                     LDD   D,U
DEE3 3606             (    forth6809.asm):05859                     PSHU  D
DEE5 39               (    forth6809.asm):05860                     RTS
                      (    forth6809.asm):05861         
                      (    forth6809.asm):05862         ; ------------------------------------------------------------
                      (    forth6809.asm):05863         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05864         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05865         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05866         ; the cell being moved.
                      (    forth6809.asm):05867         ; ------------------------------------------------------------
DEE6 ECC1             (    forth6809.asm):05868         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
DEE8 2718             (    forth6809.asm):05869                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
DEEA 1F02             (    forth6809.asm):05870                     TFR   D,Y               ; Y = cells to shift
DEEC 58               (    forth6809.asm):05871                     LSLB
DEED 49               (    forth6809.asm):05872                     ROLA
DEEE 30CB             (    forth6809.asm):05873                     LEAX  D,U               ; X = xu
DEF0 EC84             (    forth6809.asm):05874                     LDD   ,X
DEF2 3406             (    forth6809.asm):05875                     PSHS  D                 ; xu waits on the return stack
DEF4 EC1E             (    forth6809.asm):05876         RLOOP:      LDD   -2,X
DEF6 ED84             (    forth6809.asm):05877                     STD   ,X
DEF8 301E             (    forth6809.asm):05878                     LEAX  -2,X
DEFA 313F             (    forth6809.asm):05879                     LEAY  -1,Y
DEFC 26F6             (    forth6809.asm):05880                     BNE   RLOOP
DEFE 3506             (    forth6809.asm):05881                     PULS  D
DF00 EDC4             (    forth6809.asm):05882                     STD   ,U
DF02 39               (    forth6809.asm):05883         ROLLDONE:   RTS
                      (    forth6809.asm):05884         
                      (    forth6809.asm):05885         ; ------------------------------------------------------------
                      (    forth6809.asm):05886         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05887         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05888         ; while the others move.
                      (    forth6809.asm):05889         ; ------------------------------------------------------------
DF03 AE4A             (    forth6809.asm):05890         DROTW:      LDX   10,U              ; x1
DF05 10AE48           (    forth6809.asm):05891                     LDY   8,U               ; x2
DF08 EC46             (    forth6809.asm):05892                     LDD   6,U
DF0A ED4A             (    forth6809.asm):05893                     STD   10,U
DF0C EC44             (    forth6809.asm):05894                     LDD   4,U
DF0E ED48             (    forth6809.asm):05895                     STD   8,U
DF10 EC42             (    forth6809.asm):05896                     LDD   2,U
DF12 ED46             (    forth6809.asm):05897                     STD   6,U
DF14 EC40             (    forth6809.asm):05898                     LDD   0,U
DF16 ED44             (    forth6809.asm):05899                     STD   4,U
DF18 10AFC4           (    forth6809.asm):05900                     STY   ,U
DF1B AF42             (    forth6809.asm):05901                     STX   2,U
DF1D 39               (    forth6809.asm):05902                     RTS
                      (    forth6809.asm):05903         
                      (    forth6809.asm):05904         ; ------------------------------------------------------------
                      (    forth6809.asm):05905         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05906         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05907         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05908         ; the transfer.
                      (    forth6809.asm):05909         ; ------------------------------------------------------------
DF1E 3706             (    forth6809.asm):05910         TORW:       PULU  D                 ; x
DF20 3510             (    forth6809.asm):05911                     PULS  X
DF22 3406             (    forth6809.asm):05912                     PSHS  D
DF24 3410             (    forth6809.asm):05913                     PSHS  X
DF26 39               (    forth6809.asm):05914                     RTS
                      (    forth6809.asm):05915         
                      (    forth6809.asm):05916         ; ------------------------------------------------------------
                      (    forth6809.asm):05917         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05918         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05919         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05920         ; the transfer.
                      (    forth6809.asm):05921         ; ------------------------------------------------------------
DF27 3510             (    forth6809.asm):05922         FROMRW:     PULS  X
DF29 3506             (    forth6809.asm):05923                     PULS  D                 ; x
DF2B 3410             (    forth6809.asm):05924                     PSHS  X
DF2D 3606             (    forth6809.asm):05925                     PSHU  D
DF2F 39               (    forth6809.asm):05926                     RTS
                      (    forth6809.asm):05927         
                      (    forth6809.asm):05928         ; ------------------------------------------------------------
                      (    forth6809.asm):05929         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05930         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05931         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05932         ; back around the transfer.
                      (    forth6809.asm):05933         ; ------------------------------------------------------------
DF30 3510             (    forth6809.asm):05934         RFETCHW:    PULS  X
DF32 ECE4             (    forth6809.asm):05935                     LDD   ,S                ; x
DF34 3410             (    forth6809.asm):05936                     PSHS  X
DF36 3606             (    forth6809.asm):05937                     PSHU  D
DF38 39               (    forth6809.asm):05938                     RTS
                      (    forth6809.asm):05939         
                      (    forth6809.asm):05940         ; ------------------------------------------------------------
                      (    forth6809.asm):05941         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05942         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05943         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05944         ; put back around the transfer.
                      (    forth6809.asm):05945         ; ------------------------------------------------------------
DF39 3510             (    forth6809.asm):05946         TWOTORW:    PULS  X                 ; return address
DF3B 3706             (    forth6809.asm):05947                     PULU  D                 ; x2
DF3D 3720             (    forth6809.asm):05948                     PULU  Y                 ; x1
DF3F 3420             (    forth6809.asm):05949                     PSHS  Y
DF41 3406             (    forth6809.asm):05950                     PSHS  D
DF43 3410             (    forth6809.asm):05951                     PSHS  X
DF45 39               (    forth6809.asm):05952                     RTS
                      (    forth6809.asm):05953         
                      (    forth6809.asm):05954         ; ------------------------------------------------------------
                      (    forth6809.asm):05955         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05956         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05957         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05958         ; put back around the transfer.
                      (    forth6809.asm):05959         ; ------------------------------------------------------------
DF46 3510             (    forth6809.asm):05960         TWOFROMRW:  PULS  X                 ; return address
DF48 3506             (    forth6809.asm):05961                     PULS  D                 ; x2
DF4A 3520             (    forth6809.asm):05962                     PULS  Y                 ; x1
DF4C 3410             (    forth6809.asm):05963                     PSHS  X
DF4E 3620             (    forth6809.asm):05964                     PSHU  Y
DF50 3606             (    forth6809.asm):05965                     PSHU  D
DF52 39               (    forth6809.asm):05966                     RTS
                      (    forth6809.asm):05967         
                      (    forth6809.asm):05968         ; ------------------------------------------------------------
                      (    forth6809.asm):05969         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05970         ; Copy the top cell pair of the return stack.

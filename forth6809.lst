F53D CCF528           (    forth6809.asm):06976                     LDD   #DOTSTR
F540 7EF40C           (    forth6809.asm):06977                     JMP   CSTRCOMP
                      (    forth6809.asm):06978         
                      (    forth6809.asm):06979         ; ------------------------------------------------------------
                      (    forth6809.asm):06980         ; Run-time part of C"  The counted string follows the call: push its
                      (    forth6809.asm):06981         ; address and skip over it.
                      (    forth6809.asm):06982         ; DOCSTR
                      (    forth6809.asm):06983         ;    Outputs:
                      (    forth6809.asm):06984         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):06985         ;        the string
                      (    forth6809.asm):06986         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06987         ; ------------------------------------------------------------
F543 3510             (    forth6809.asm):06988         DOCSTR:     PULS  X

FDCC FE1900070000     (    forth6809.asm):06799                  FDB   EN9,EN9L,0    ; NEW: FLOORED - previously the one item
                      (    forth6809.asm):06800                                      ; in this area explicitly left open
                      (    forth6809.asm):06801                                      ; pending its own investigation (unlike
                      (    forth6809.asm):06802                                      ; WORDLISTS, this is a CORE query, not
                      (    forth6809.asm):06803                                      ; tied to an unimplemented optional word
                      (    forth6809.asm):06804                                      ; set, so "false by omission" wasn't the
                      (    forth6809.asm):06805                                      ; right default). Investigated by tracing
                      (    forth6809.asm):06806                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):06807                                      ; against this system's own SM/REM and
                      (    forth6809.asm):06808                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):06809                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):06810                                      ; dividend's own original sign) after
                      (    forth6809.asm):06811                                      ; dividing absolute values - exactly
                      (    forth6809.asm):06812                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):06813                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):06814                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):06815                                      ; adjustment step (correcting the
                      (    forth6809.asm):06816                                      ; quotient and remainder when the
                      (    forth6809.asm):06817                                      ; quotient would be negative with a
                      (    forth6809.asm):06818                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):06819                                      ; not have. This system's primary
                      (    forth6809.asm):06820                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):06821                                      ; symmetric division, not floored -
                      (    forth6809.asm):06822                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):06823                                      ; answer (recognized query, value false),
                      (    forth6809.asm):06824                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):06825                                      ; WORDLISTS correctly uses.

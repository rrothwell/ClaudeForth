F477 BDF4A9           (    forth6809.asm):09420                     JSR   BRCMP
F47A 26C4             (    forth6809.asm):09421                     BNE   BRNEXT
F47C ECE4             (    forth6809.asm):09422                     LDD   ,S                ; [THEN]: one level less
F47E 830001           (    forth6809.asm):09423                     SUBD  #1
F481 EDE4             (    forth6809.asm):09424                     STD   ,S
F483 2721             (    forth6809.asm):09425                     BEQ   BRDONE
F485 20B9             (    forth6809.asm):09426                     BRA   BRNEXT
F487 C604             (    forth6809.asm):09427         BR4:        LDB   #4
F489 108EF4B3         (    forth6809.asm):09428                     LDY   #BRSIF
F48D BDF4A9           (    forth6809.asm):09429                     JSR   BRCMP

                      (    forth6809.asm):08754                                    ; parsed-token output directly at CODEHERE
                      (    forth6809.asm):08755                                    ; (see TSTCBUF2's own comment), which would
                      (    forth6809.asm):08756                                    ; silently overwrite TESTWD's own already-
                      (    forth6809.asm):08757                                    ; compiled trampoline still sitting at
                      (    forth6809.asm):08758                                    ; TSTCBUF, corrupting the CFA TSTWCFA points
                      (    forth6809.asm):08759                                    ; to before this test's second execution.
                      (    forth6809.asm):08760                                    ; Confirmed via MAME: a crash jumping into
                      (    forth6809.asm):08761                                    ; invalid memory at TSTCBUF's own address,
                      (    forth6809.asm):08762                                    ; landing on WORD's own leftover length byte
                      (    forth6809.asm):08763                                    ; instead of the trampoline's real opcode.

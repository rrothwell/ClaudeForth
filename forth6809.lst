E869 2615             (    forth6809.asm):04174                     BNE   DTEXIT            ; set: exit
E86B EC62             (    forth6809.asm):04175                     LDD   2,S               ; index
E86D C30001           (    forth6809.asm):04176                     ADDD  #1
E870 ED62             (    forth6809.asm):04177                     STD   2,S
E872 10A364           (    forth6809.asm):04178                     CMPD  4,S               ; limit
E875 2709             (    forth6809.asm):04179                     BEQ   DTEXIT
E877 3510             (    forth6809.asm):04180                     PULS  X                 ; X = branch operand address
E879 EC84             (    forth6809.asm):04181                     LDD   ,X
E87B 308B             (    forth6809.asm):04182                     LEAX  D,X
E87D 3410             (    forth6809.asm):04183                     PSHS  X                 ; return to loop start
E87F 39               (    forth6809.asm):04184                     RTS
E880 3510             (    forth6809.asm):04185         DTEXIT:     PULS  X
E882 3002             (    forth6809.asm):04186                     LEAX  2,X               ; skip the branch operand
E884 3266             (    forth6809.asm):04187                     LEAS  6,S               ; discard the loop frame
E886 3410             (    forth6809.asm):04188                     PSHS  X
E888 39               (    forth6809.asm):04189                     RTS

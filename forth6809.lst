                      (    forth6809.asm):04894         
                      (    forth6809.asm):04895         ; ------------------------------------------------------------
                      (    forth6809.asm):04896         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):04897         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):04898         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):04899         ; put back around the transfer.
                      (    forth6809.asm):04900         ; ------------------------------------------------------------

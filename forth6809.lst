D350 F60176           (    forth6809.asm):02290                     LDB   INHEAD            ; Calculate current fill level fresh -
D353 F00177           (    forth6809.asm):02291                     SUBB  INTAIL            ; both pointers may have moved since
D356 C43F             (    forth6809.asm):02292                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02293                                             ; there's no already-loaded value here
                      (    forth6809.asm):02294                                             ; worth reusing.
D358 BDD2BC           (    forth6809.asm):02295                     JSR   CHKLO
D35B 1CEF             (    forth6809.asm):02296                     ANDCC #$EF
                      (    forth6809.asm):02297         
D35D 1CFE             (    forth6809.asm):02298                     ANDCC #$FE              ; Carry flag %0 = valid character
D35F 39               (    forth6809.asm):02299                     RTS
                      (    forth6809.asm):02300         
D360                  (    forth6809.asm):02301         GET_NO_CHAR:
D360 1A01             (    forth6809.asm):02302                     ORCC  #$01              ; Carry flag %1 = no valid character.
D362 39               (    forth6809.asm):02303                     RTS
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
                      (    forth6809.asm):02305         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02306         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02307         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02308         ; RTSCHECKLO
                      (    forth6809.asm):02309         ;    Inputs:
                      (    forth6809.asm):02310         ;        none
                      (    forth6809.asm):02311         ;    Outputs:
                      (    forth6809.asm):02312         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02313         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02314         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02315         ; ------------------------------------------------------------
D363                  (    forth6809.asm):02316         RTSCHECKLO:
D363 1A10             (    forth6809.asm):02317                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02318         
D365 BDD26F           (    forth6809.asm):02319                     JSR   INFILL
D368 8110             (    forth6809.asm):02320                     CMPA  #INLOWATER
D36A 221E             (    forth6809.asm):02321                     BHI   RTSCLODONE
D36C 7D0178           (    forth6809.asm):02322                     TST   RTSSTATE
D36F 2719             (    forth6809.asm):02323                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02324         
                      (    forth6809.asm):02325         
D371 7F0178           (    forth6809.asm):02326                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02327         
D374 F6017A           (    forth6809.asm):02328                     LDB   OUTTAIL           ; Check if chars are available.
D377 F10179           (    forth6809.asm):02329                     CMPB  OUTHEAD
D37A 2707             (    forth6809.asm):02330                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02331         
D37C 86B5             (    forth6809.asm):02332                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
D37E B7C008           (    forth6809.asm):02333                     STA   ACIACR            ; & to generate transmit slot available interrupts.
D381 2005             (    forth6809.asm):02334                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02335         
D383 8695             (    forth6809.asm):02336         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
D385 B7C008           (    forth6809.asm):02337                     STA   ACIACR
                      (    forth6809.asm):02338         
D388                  (    forth6809.asm):02339         RTSCLOUNMASK:
D388 1CEF             (    forth6809.asm):02340                     ANDCC #$EF
                      (    forth6809.asm):02341         
D38A 39               (    forth6809.asm):02342         RTSCLODONE: RTS
                      (    forth6809.asm):02343         
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02346         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02347         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02348         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02349         ; IRQH
                      (    forth6809.asm):02350         ;    Inputs:
                      (    forth6809.asm):02351         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02352         ;    Outputs:
                      (    forth6809.asm):02353         ;        none (returns with RTI)
                      (    forth6809.asm):02354         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02355         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02356         ; ------------------------------------------------------------
D38B B6C008           (    forth6809.asm):02357         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02358         
D38E 8580             (    forth6809.asm):02359                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
D390 2708             (    forth6809.asm):02360                     BEQ   IRQDONE0          ; No! Just exit.
D392 8501             (    forth6809.asm):02361                     BITA  #SR_RDRF          ; Is an incoming character available?
D394 2605             (    forth6809.asm):02362                     BNE   INCHAR
D396 8502             (    forth6809.asm):02363                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
D398 263C             (    forth6809.asm):02364                     BNE   OUTCHAR
                      (    forth6809.asm):02365                                             ; Ignore all other interrupts such as DCD change.
D39A 3B               (    forth6809.asm):02366         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02367                                             ; & restores state.
                      (    forth6809.asm):02368         
D39B                  (    forth6809.asm):02369         INCHAR:
D39B F6C009           (    forth6809.asm):02370                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
D39E 8570             (    forth6809.asm):02371                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02372                                             ; Any receiver error flagged?
D3A0 2716             (    forth6809.asm):02373                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02374         
D3A2 8510             (    forth6809.asm):02375                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
D3A4 2703             (    forth6809.asm):02376                     BEQ   INXFE             ; Tally each flagged error independently -
D3A6 7C017C           (    forth6809.asm):02377                     INC   FECOUNT           ; more than one bit can be set at once.
D3A9 8520             (    forth6809.asm):02378         INXFE:      BITA  #SR_OVRN
D3AB 2703             (    forth6809.asm):02379                     BEQ   INXOVRN
D3AD 7C017D           (    forth6809.asm):02380                     INC   OVRNCOUNT
D3B0 8540             (    forth6809.asm):02381         INXOVRN:    BITA  #SR_PE
D3B2 2703             (    forth6809.asm):02382                     BEQ   INXPE
D3B4 7C017E           (    forth6809.asm):02383                     INC   PECOUNT
D3B7 3B               (    forth6809.asm):02384         INXPE:      RTI
                      (    forth6809.asm):02385         
D3B8 1F98             (    forth6809.asm):02386         INOK:       TFR   B,A               ; Transfer good character from the receiver.
D3BA 8E0180           (    forth6809.asm):02387                     LDX   #INBUF            ; Store it in the empty in buffer slot.
D3BD F60176           (    forth6809.asm):02388                     LDB   INHEAD
D3C0 A785             (    forth6809.asm):02389                     STA   B,X
D3C2 5C               (    forth6809.asm):02390                     INCB                    ; Figure out the new head,
D3C3 C43F             (    forth6809.asm):02391                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
D3C5 F10177           (    forth6809.asm):02392                     CMPB  INTAIL            ; Would the new head slot meet the tail?
D3C8 270B             (    forth6809.asm):02393                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
D3CA F70176           (    forth6809.asm):02394                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02395                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02396                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02397                     ; See shadow: INCHAR.1
D3CD F00177           (    forth6809.asm):02398                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
D3D0 C43F             (    forth6809.asm):02399                     ANDB  #INBUFSZ-1
D3D2 BDD2AA           (    forth6809.asm):02400                     JSR   CHKHI             ; Protect the in buffer from overflow.
D3D5 3B               (    forth6809.asm):02401         IRQDONE1:   RTI
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02404         
D3D6 F6017A           (    forth6809.asm):02405         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
D3D9 F10179           (    forth6809.asm):02406                     CMPB  OUTHEAD
D3DC 270F             (    forth6809.asm):02407                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02408         
D3DE 8E01C0           (    forth6809.asm):02409                     LDX   #OUTBUF           ; No! The out buffer is occupied.
D3E1 A685             (    forth6809.asm):02410                     LDA   B,X               ; Get the character from the out buffer.
D3E3 B7C009           (    forth6809.asm):02411                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02412         
D3E6 5C               (    forth6809.asm):02413                     INCB                    ; Update the tail pointer pointing to the next char.
D3E7 C43F             (    forth6809.asm):02414                     ANDB  #OUTBUFSZ-1
D3E9 F7017A           (    forth6809.asm):02415                     STB   OUTTAIL
D3EC 3B               (    forth6809.asm):02416         IRQDONE2    RTI
                      (    forth6809.asm):02417         
D3ED                  (    forth6809.asm):02418         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02419                     ; Commented-out code moved to shadow: TXOFF.1
D3ED 7F017B           (    forth6809.asm):02420                     CLR   OUTACTIVITY
D3F0 BDD28F           (    forth6809.asm):02421                     JSR   UPDATE_RTS
D3F3 3B               (    forth6809.asm):02422         IRQDONE3    RTI
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02425         
D3F4                  (    forth6809.asm):02426         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA

                      (    forth6809.asm):01561         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01562         ; INFILL
                      (    forth6809.asm):01563         ;    Inputs:
                      (    forth6809.asm):01564         ;        none
                      (    forth6809.asm):01565         ;    Outputs:
                      (    forth6809.asm):01566         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01567         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01568         ; ------------------------------------------------------------
DCF3 B60176           (    forth6809.asm):01569         INFILL:     LDA   INHEAD
DCF6 B00177           (    forth6809.asm):01570                     SUBA  INTAIL
DCF9 843F             (    forth6809.asm):01571                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DCFB 39               (    forth6809.asm):01572                     RTS
                      (    forth6809.asm):01573         ; ------------------------------------------------------------
                      (    forth6809.asm):01574         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01575         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01576         ; receive path with interrupts already masked.
                      (    forth6809.asm):01577         ; RTSCHECKHI
                      (    forth6809.asm):01578         ;    Inputs:
                      (    forth6809.asm):01579         ;        none
                      (    forth6809.asm):01580         ;    Outputs:
                      (    forth6809.asm):01581         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01582         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01583         ; ------------------------------------------------------------
DCFC BDDCF3           (    forth6809.asm):01584         RTSCHECKHI: JSR   INFILL
DCFF 8130             (    forth6809.asm):01585                     CMPA  #INHIWATER
DD01 250F             (    forth6809.asm):01586                     BLO   RTSCHIDONE
DD03 7D0178           (    forth6809.asm):01587                     TST   RTSSTATE
DD06 260A             (    forth6809.asm):01588                     BNE   RTSCHIDONE        ; already high - nothing to do
DD08 86D5             (    forth6809.asm):01589                     LDA   #CR_RTSHI
DD0A B7C008           (    forth6809.asm):01590                     STA   ACIACR
DD0D 8601             (    forth6809.asm):01591                     LDA   #1
DD0F B70178           (    forth6809.asm):01592                     STA   RTSSTATE

                      (    forth6809.asm):01708                    PSHU  D
                      (    forth6809.asm):01709                    LDD   #TSTVAL1
                      (    forth6809.asm):01710                    PSHU  D
                      (    forth6809.asm):01711                    STU   TSTUB4
                      (    forth6809.asm):01712         
                      (    forth6809.asm):01713                    JSR   QDUP
                      (    forth6809.asm):01714         
                      (    forth6809.asm):01715                    STU   TSTUAF
                      (    forth6809.asm):01716         
                      (    forth6809.asm):01717                    PULU  D
                      (    forth6809.asm):01718                    CMPD  #TSTVAL1
                      (    forth6809.asm):01719                    BNE   QNFAIL
                      (    forth6809.asm):01720                    PULU  D
                      (    forth6809.asm):01721                    CMPD  #TSTVAL1
                      (    forth6809.asm):01722                    BNE   QNFAIL
                      (    forth6809.asm):01723                    PULU  D
                      (    forth6809.asm):01724                    CMPD  #TSTGUARD
                      (    forth6809.asm):01725                    BNE   QNFAIL
                      (    forth6809.asm):01726         
                      (    forth6809.asm):01727                    LDD   TSTUB4
                      (    forth6809.asm):01728                    SUBD  TSTUAF
                      (    forth6809.asm):01729                    CMPD  #2
                      (    forth6809.asm):01730                    BNE   QNFAIL
                      (    forth6809.asm):01731         
                      (    forth6809.asm):01732                    LDD   #TRUEV
                      (    forth6809.asm):01733                    BRA   QNDONE
C18F                  (    forth6809.asm):01734         QNFAIL:    LDD   #FALSEV
C18F                  (    forth6809.asm):01735         QNDONE:    LDX   #TSTQNNAME

                      (    forth6809.asm):13613         ; TSTUNESCAPE - unit test for UNESCAPE. Source "A%B" (3 chars,
                      (    forth6809.asm):13614         ; one '%' in the middle) doubles the '%' to produce "A%%B" (4
                      (    forth6809.asm):13615         ; chars) - confirmed via its own code and a prior session's
                      (    forth6809.asm):13616         ; already-corrected design comment that this is genuinely a
                      (    forth6809.asm):13617         ; doubling operation, not backslash-sequence decoding. Verifies
                      (    forth6809.asm):13618         ; every output character individually and the grown length,
                      (    forth6809.asm):13619         ; not just that some output was produced.
                      (    forth6809.asm):13620         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):13621         TSTUNESCAPE: LDA  #'A'
                      (    forth6809.asm):13622                      STA  TSTCBUF
                      (    forth6809.asm):13623                      LDA  #'%'
                      (    forth6809.asm):13624                      STA  TSTCBUF+1
                      (    forth6809.asm):13625                      LDA  #'B'
                      (    forth6809.asm):13626                      STA  TSTCBUF+2
                      (    forth6809.asm):13627         
                      (    forth6809.asm):13628                      STU  TSTU0
                      (    forth6809.asm):13629         
                      (    forth6809.asm):13630                      LDD  #TSTGUARD
                      (    forth6809.asm):13631                      PSHU D
                      (    forth6809.asm):13632                      LDD  #TSTCBUF
                      (    forth6809.asm):13633                      PSHU D
                      (    forth6809.asm):13634                      LDD  #3

                      (    forth6809.asm):01024         ; TSTQDUPNZ - unit test for ?DUP ( n -- n n | 0 ), nonzero case.
                      (    forth6809.asm):01025         ; Verifies the nonzero value is duplicated, the guard beneath is
                      (    forth6809.asm):01026         ; undisturbed, and exactly one cell was added - same as DUP's
                      (    forth6809.asm):01027         ; own behavior for this case. ?DUP needs two tests, one per
                      (    forth6809.asm):01028         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01029         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01030         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):01031         TSTQDUPNZ: STU   TSTU0
                      (    forth6809.asm):01032         
                      (    forth6809.asm):01033                    LDD   #TSTGUARD
                      (    forth6809.asm):01034                    PSHU  D
                      (    forth6809.asm):01035                    LDD   #TSTVAL1
                      (    forth6809.asm):01036                    PSHU  D
                      (    forth6809.asm):01037                    STU   TSTUB4
                      (    forth6809.asm):01038         
                      (    forth6809.asm):01039                    JSR   QDUP
                      (    forth6809.asm):01040         
                      (    forth6809.asm):01041                    STU   TSTUAF
                      (    forth6809.asm):01042         
                      (    forth6809.asm):01043                    PULU  D
                      (    forth6809.asm):01044                    CMPD  #TSTVAL1
                      (    forth6809.asm):01045                    BNE   QNFAIL
                      (    forth6809.asm):01046                    PULU  D
                      (    forth6809.asm):01047                    CMPD  #TSTVAL1
                      (    forth6809.asm):01048                    BNE   QNFAIL
                      (    forth6809.asm):01049                    PULU  D
                      (    forth6809.asm):01050                    CMPD  #TSTGUARD
                      (    forth6809.asm):01051                    BNE   QNFAIL
                      (    forth6809.asm):01052         
                      (    forth6809.asm):01053                    LDD   TSTUB4
                      (    forth6809.asm):01054                    SUBD  TSTUAF
                      (    forth6809.asm):01055                    CMPD  #2
                      (    forth6809.asm):01056                    BNE   QNFAIL
                      (    forth6809.asm):01057         
                      (    forth6809.asm):01058                    LDD   #TRUEV
                      (    forth6809.asm):01059                    BRA   QNDONE
C15E                  (    forth6809.asm):01060         QNFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):01061         QNDONE:    LDX   #TSTQNNAME
                      (    forth6809.asm):01062                    PSHU  X
                      (    forth6809.asm):01063                    PSHU  D
                      (    forth6809.asm):01064                    JSR   TSTREPORT
                      (    forth6809.asm):01065         
                      (    forth6809.asm):01066                    LDU   TSTU0
                      (    forth6809.asm):01067                    RTS
                      (    forth6809.asm):01068         
C15E                  (    forth6809.asm):01069         TSTQNNAME: FCB  9
                      (    forth6809.asm):01070                    FCC  "TSTQDUPNZ"

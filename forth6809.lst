                      (    forth6809.asm):04285         
E781 EC68             (    forth6809.asm):04286         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E783 3606             (    forth6809.asm):04287                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E785 39               (    forth6809.asm):04288                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):04289                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):04290                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):04291                                   ; consumes it to jump into the loop body, so

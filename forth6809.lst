                      (    forth6809.asm):01937         ; ============================================================
                      (    forth6809.asm):01938         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):01939         ; ============================================================
                      (    forth6809.asm):01940         ; ------------------------------------------------------------
                      (    forth6809.asm):01941         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):01942         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):01943         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):01944         ; COLD
                      (    forth6809.asm):01945         ;    Inputs:
                      (    forth6809.asm):01946         ;        none (entered at reset)
                      (    forth6809.asm):01947         ;    Outputs:
                      (    forth6809.asm):01948         ;        none (does not return)
                      (    forth6809.asm):01949         ;    Registers: all changed.

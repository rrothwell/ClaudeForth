CF73 DD39             (    forth6809.asm):02542                     STD   SRCADDR
CF75 CC0000           (    forth6809.asm):02543                     LDD   #0
CF78 DD3B             (    forth6809.asm):02544                     STD   SRCLEN
CF7A DD3D             (    forth6809.asm):02545                     STD   SRCID
                      (    forth6809.asm):02546         
CF7C 8ED029           (    forth6809.asm):02547                     LDX   #SIGNON
CF7F 3610             (    forth6809.asm):02548                     PSHU  X                 ; c-addr
CF81 CC000F           (    forth6809.asm):02549                     LDD   #SIGNONL
CF84 3606             (    forth6809.asm):02550                     PSHU  D                 ; u

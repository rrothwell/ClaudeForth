                      (    forth6809.asm):01942         
                      (    forth6809.asm):01943         ; ------------------------------------------------------------
                      (    forth6809.asm):01944         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01945         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01946         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01947         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01948         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01949         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01950         ; flow control, not a chip feature.
                      (    forth6809.asm):01951         ; ------------------------------------------------------------

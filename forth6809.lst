                      (    forth6809.asm):00428         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00429         ;
                      (    forth6809.asm):00430         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00431         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00432         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00433         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00434         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00435         ; hand-built at the end of the section.
                      (    forth6809.asm):00436         ;
                      (    forth6809.asm):00437         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00438         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00439         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00440         ; ============================================================

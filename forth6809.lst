                      (    forth6809.asm):02793         
                      (    forth6809.asm):02794         ; ------------------------------------------------------------
                      (    forth6809.asm):02795         ; TSTSTAR2 - unit test for STAR. overflow case - product exceeds 16-bit range; ANS defines * as truncating, not erroring.
                      (    forth6809.asm):02796         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02797         TSTSTAR2:   STU   TSTU0
                      (    forth6809.asm):02798         

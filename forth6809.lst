E908 DD29             (    forth6809.asm):04147                     STD   MSCR              ; MSCR = step
E90A EC66             (    forth6809.asm):04148                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E90C 262D             (    forth6809.asm):04149                     BNE   DPTEXIT           ; set: exit
E90E EC62             (    forth6809.asm):04150                     LDD   2,S               ; old index
E910 A364             (    forth6809.asm):04151                     SUBD  4,S               ; old_u = old_index - limit, mod 65536

                      (    forth6809.asm):02911         
E308                  (    forth6809.asm):02912         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):02913                                             ; ANS's (ud1) stack order directly.
E308 DC00             (    forth6809.asm):02914                     LDD   STATE
E30A 27B1             (    forth6809.asm):02915                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):02916                                             ; nothing more to do
                      (    forth6809.asm):02917                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):02918                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):02919                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):02920                     ; pop it aside first, freeing UDLO to be compiled first.
E30C 3706             (    forth6809.asm):02921                     PULU  D
E30E DD24             (    forth6809.asm):02922                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,

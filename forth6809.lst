                      (    forth6809.asm):00560         ; ------------------------------------------------------------
                      (    forth6809.asm):00561         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00562         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00563         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00564         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00565         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00566         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00567         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00568         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00569         ;
                      (    forth6809.asm):00570         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00571         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00572         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00573         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00574         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00575         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00576         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00577         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00578         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00579         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00580         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00581         ; ------------------------------------------------------------
                      (    forth6809.asm):00582                  ORG   $0100
0100                  (    forth6809.asm):00583         MVCNT      RMB   2
0102                  (    forth6809.asm):00584         MVDST      RMB   2
0104                  (    forth6809.asm):00585         MVSRC      RMB   2
     0100             (    forth6809.asm):00586         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00587         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00588         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00589         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00590         
                      (    forth6809.asm):00591         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00592         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00593                  ORG USROMSTRT
                      (    forth6809.asm):00594         
                      (    forth6809.asm):00595         ; ============================================================
                      (    forth6809.asm):00596         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00597         ;
                      (    forth6809.asm):00598         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00599         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00600         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00601         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00602         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00603         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00604         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00605         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00606         ; this existed - the default build (UNITTESTS undefined, or
                      (    forth6809.asm):00607         ; defined as 0) removes it entirely and this block reverts to
                      (    forth6809.asm):00608         ; exactly that padding, computed automatically below via the ROM
                      (    forth6809.asm):00609         ; label rather than a fixed byte count, so it's correct either
                      (    forth6809.asm):00610         ; way without needing to be hand-adjusted. Pass
                      (    forth6809.asm):00611         ; --define=UNITTESTS on the lwasm command line (see the example
                      (    forth6809.asm):00612         ; at the end of this comment) to include it.
                      (    forth6809.asm):00613         ;
                      (    forth6809.asm):00614         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00615         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00616         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00617         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00618         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00619         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00620         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00621         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00622         ;
                      (    forth6809.asm):00623         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00624         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00625         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00626         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00627         ;
                      (    forth6809.asm):00628         ; Test groups are further gated by TSTSELECTOR (see below), one
                      (    forth6809.asm):00629         ; group at a time, since assembling every group together exhausts
                      (    forth6809.asm):00630         ; the available unused ROM space. Example command line, testing
                      (    forth6809.asm):00631         ; group 2 with tests included:
                      (    forth6809.asm):00632         ;
                      (    forth6809.asm):00633         ;   lwasm --6809 --format=raw \
                      (    forth6809.asm):00634         ;   --output=forth6809.bin --list=forth6809.lst \
                      (    forth6809.asm):00635         ;   --define=UNITTESTS --define=TSTSELECTOR=2 \
                      (    forth6809.asm):00636         ;   forth6809.asm
                      (    forth6809.asm):00637         ; ============================================================
                      (    forth6809.asm):00638                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00639         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00640                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00641                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00642                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00643                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00644                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00645                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00646                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00647                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00648                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00649                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00650                           ; choice is made, not what including it does.
                      (    forth6809.asm):00651                    ENDC
                      (    forth6809.asm):00652         
                      (    forth6809.asm):00653                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00654         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00655                    ENDC
                      (    forth6809.asm):00656         
                      (    forth6809.asm):00657                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00658         
C100                  (    forth6809.asm):00659         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
C100                  (    forth6809.asm):00660         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
C100                  (    forth6809.asm):00661         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
C100                  (    forth6809.asm):00662         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00663         
C100                  (    forth6809.asm):00664         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00665                                       ; under test, to prove an operation
                      (    forth6809.asm):00666                                       ; doesn't disturb what's beneath it
C100                  (    forth6809.asm):00667         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00668                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00669                                       ; that only appears to pass due to a
                      (    forth6809.asm):00670                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00671                                       ; caught rather than masked
C100                  (    forth6809.asm):00672         TSTVAL2  EQU   $2468         ; additional distinct, non-trivial
C100                  (    forth6809.asm):00673         TSTVAL3  EQU   $7B3D         ; values for multi-item tests (SWAP,
C100                  (    forth6809.asm):00674         TSTVAL4  EQU   $4E2C         ; OVER, ROT, 2DUP, 2ROT, etc) - none are
C100                  (    forth6809.asm):00675         TSTVAL5  EQU   $19A7         ; 0, 1, -1, TSTGUARD, or any of each
C100                  (    forth6809.asm):00676         TSTVAL6  EQU   $6D95         ; other
                      (    forth6809.asm):00677         
C100                  (    forth6809.asm):00678         TSTSCR   EQU   APPVARS+8     ; extra scratch cell - for tests (DEPTH)
                      (    forth6809.asm):00679                                       ; that need to compute an expected value
                      (    forth6809.asm):00680                                       ; independently before comparing
                      (    forth6809.asm):00681         
C100                  (    forth6809.asm):00682         TSTCBUF  EQU   APPVARS+10    ; compile-time test harness (section 3.8,
                      (    forth6809.asm):00683                                       ; control flow): scratch buffer real
                      (    forth6809.asm):00684                                       ; compile-time words (IF/THEN/DO/LOOP/
                      (    forth6809.asm):00685                                       ; etc) actually compile into - CODEHERE
                      (    forth6809.asm):00686                                       ; is redirected here for the duration of
                      (    forth6809.asm):00687                                       ; each compile, then restored, so the
                      (    forth6809.asm):00688                                       ; real ROM/dictionary is never touched.
                      (    forth6809.asm):00689                                       ; 80 bytes - generous headroom for the
                      (    forth6809.asm):00690                                       ; small test snippets planned (the
                      (    forth6809.asm):00691                                       ; largest, CASE with two OF clauses,
                      (    forth6809.asm):00692                                       ; comes nowhere close)
C100                  (    forth6809.asm):00693         TSTCSAV  EQU   APPVARS+90    ; saved CODEHERE, across a redirected
                      (    forth6809.asm):00694                                       ; compile
C100                  (    forth6809.asm):00695         TSTCSPS  EQU   APPVARS+92    ; saved CSP, across a redirected compile -
                      (    forth6809.asm):00696                                       ; EXIT's own frame-counting scan depends
                      (    forth6809.asm):00697                                       ; on CSP marking the right baseline
C100                  (    forth6809.asm):00698         TSTLSAV  EQU   APPVARS+94    ; saved LATEST, across a RECURSE test
                      (    forth6809.asm):00699                                       ; (which reads LATEST directly)
C100                  (    forth6809.asm):00700         TSTFHDR  EQU   APPVARS+96    ; fake dictionary header, for RECURSE to
                      (    forth6809.asm):00701                                       ; read via a redirected LATEST - 16
                      (    forth6809.asm):00702                                       ; bytes (LEN/FL + name + LINK + CFA,
                      (    forth6809.asm):00703                                       ; comfortably fits any short test name)
                      (    forth6809.asm):00704         
C100                  (    forth6809.asm):00705         TSTDBUF  EQU   APPVARS+112   ; defining-words test harness (section
                      (    forth6809.asm):00706                                       ; 3.9): scratch dictionary buffer -
                      (    forth6809.asm):00707                                       ; DPHERE is redirected here for the
                      (    forth6809.asm):00708                                       ; duration of each defining-word call,
                      (    forth6809.asm):00709                                       ; so a real header never lands in the
                      (    forth6809.asm):00710                                       ; real dictionary. 40 bytes.
C100                  (    forth6809.asm):00711         TSTDSAV  EQU   APPVARS+152   ; saved DPHERE
C100                  (    forth6809.asm):00712         TSTVBUF  EQU   APPVARS+154   ; scratch VARHERE buffer, for VARIABLE/
                      (    forth6809.asm):00713                                       ; VALUE/2VARIABLE/BUFFER: to reserve
                      (    forth6809.asm):00714                                       ; their own mutable space into. 20
                      (    forth6809.asm):00715                                       ; bytes.
C100                  (    forth6809.asm):00716         TSTVSAV  EQU   APPVARS+174   ; saved VARHERE
C100                  (    forth6809.asm):00717         TSTNAMEB EQU   APPVARS+176   ; scratch fake source text, for HEADER's
                      (    forth6809.asm):00718                                       ; own WORD-based name parsing (every
                      (    forth6809.asm):00719                                       ; defining word reads a name from the
                      (    forth6809.asm):00720                                       ; input source - unlike anything in
                      (    forth6809.asm):00721                                       ; section 3.8) - 16 bytes
C100                  (    forth6809.asm):00722         TSTSASAV EQU   APPVARS+192   ; saved SRCADDR
C100                  (    forth6809.asm):00723         TSTSLSAV EQU   APPVARS+194   ; saved SRCLEN
C100                  (    forth6809.asm):00724         TSTTISAV EQU   APPVARS+196   ; saved TOIN
C100                  (    forth6809.asm):00725         TSTWCFA  EQU   APPVARS+198   ; the newly-defined test word's own CFA -
                      (    forth6809.asm):00726                                       ; equal to CODEHERE (redirected) at the
                      (    forth6809.asm):00727                                       ; moment the defining word is called,
                      (    forth6809.asm):00728                                       ; saved so the compiled trampoline can
                      (    forth6809.asm):00729                                       ; be executed afterward to verify its
                      (    forth6809.asm):00730                                       ; runtime behavior
C100                  (    forth6809.asm):00731         TSTSTSAV EQU   APPVARS+200   ; saved STATE, across a :/; test
C100                  (    forth6809.asm):00732         TSTSMFLG EQU   APPVARS+202   ; scratch: header SMUDGE-bit check result
C100                  (    forth6809.asm):00733         TSTDOESA EQU   APPVARS+204   ; address of a compiled "JSR SETDOES" -
                      (    forth6809.asm):00734                                       ; JSR'd directly to simulate an outer
                      (    forth6809.asm):00735                                       ; defining word reaching that point,
                      (    forth6809.asm):00736                                       ; without needing to actually build one
C100                  (    forth6809.asm):00737         TSTCSAV2 EQU   APPVARS+212   ; MARKER test: CODEHERE right after
                      (    forth6809.asm):00738                                       ; executing the marker word (before it's
                      (    forth6809.asm):00739                                       ; overwritten by this test's own restore)
C100                  (    forth6809.asm):00740         TSTDSAV2 EQU   APPVARS+214   ; same, DPHERE
C100                  (    forth6809.asm):00741         TSTVSAV2 EQU   APPVARS+216   ; same, VARHERE
C100                  (    forth6809.asm):00742         TSTLSAV2 EQU   APPVARS+218   ; same, LATEST
C100                  (    forth6809.asm):00743         TSTCBUF2 EQU   APPVARS+220   ; a SECOND, separate CODEHERE-redirect
                      (    forth6809.asm):00744                                       ; target - real bug found via MAME: WORD
                      (    forth6809.asm):00745                                       ; writes its parsed-token output directly
                      (    forth6809.asm):00746                                       ; at CODEHERE (by its own documented
                      (    forth6809.asm):00747                                       ; design, matching the ANS transient-
                      (    forth6809.asm):00748                                       ; region contract - confirmed by reading
                      (    forth6809.asm):00749                                       ; WORD's own code, not assumed). Any test
                      (    forth6809.asm):00750                                       ; that parses a SECOND name later (TO,
                      (    forth6809.asm):00751                                       ; IS, ACTION-OF) must NOT redirect
                      (    forth6809.asm):00752                                       ; CODEHERE back to TSTCBUF for that
                      (    forth6809.asm):00753                                       ; second parse, since TSTCBUF still holds
                      (    forth6809.asm):00754                                       ; the FIRST word's already-compiled
                      (    forth6809.asm):00755                                       ; trampoline at that point - WORD would
                      (    forth6809.asm):00756                                       ; silently overwrite it, corrupting the
                      (    forth6809.asm):00757                                       ; CFA that TSTWCFA still points to before
                      (    forth6809.asm):00758                                       ; it gets a second chance to execute. 20
                      (    forth6809.asm):00759                                       ; bytes - comfortably fits any short
                      (    forth6809.asm):00760                                       ; parsed name plus its length byte.
C100                  (    forth6809.asm):00761         TSTUMID  EQU   APPVARS+240   ; intermediate U capture (section 3.3,
                      (    forth6809.asm):00762                                       ; return stack): >R/2>R tests capture U
                      (    forth6809.asm):00763                                       ; right after moving a value to the
                      (    forth6809.asm):00764                                       ; return stack, before moving it back -
                      (    forth6809.asm):00765                                       ; a round-trip-only check could pass even
                      (    forth6809.asm):00766                                       ; if both the move-out and move-back were
                      (    forth6809.asm):00767                                       ; broken no-ops, since the value would
                      (    forth6809.asm):00768                                       ; never have actually left; this catches
                      (    forth6809.asm):00769                                       ; that specifically.
                      (    forth6809.asm):00770         
C100                  (    forth6809.asm):00771         TSTOHSAV EQU   APPVARS+242   ; section 3.1 (System/Console I/O):
                      (    forth6809.asm):00772                                       ; saves OUTHEAD (the output ring buffer's
                      (    forth6809.asm):00773                                       ; write index) before an EMIT-family call,
                      (    forth6809.asm):00774                                       ; so the test can confirm the character(s)
                      (    forth6809.asm):00775                                       ; were genuinely queued into OUTBUF - not
                      (    forth6809.asm):00776                                       ; just that the call returned without
                      (    forth6809.asm):00777                                       ; crashing.
                      (    forth6809.asm):00778         
C100                  (    forth6809.asm):00779         TSTNEG1  EQU   $CFC7         ; -12345 - distinct, non-trivial negative
                      (    forth6809.asm):00780                                       ; test values, needed for arithmetic
                      (    forth6809.asm):00781                                       ; tests (ABS, NEGATE, MIN/MAX, signed
                      (    forth6809.asm):00782                                       ; division, 2/) whose logic genuinely
                      (    forth6809.asm):00783                                       ; branches on sign - TSTVAL1-6 above are
                      (    forth6809.asm):00784                                       ; all positive, which wouldn't exercise
                      (    forth6809.asm):00785                                       ; those branches
C100                  (    forth6809.asm):00786         TSTNEG2  EQU   $FEBF         ; -321
                      (    forth6809.asm):00787         
C100                  (    forth6809.asm):00788         TSTD1HI  EQU   $0001         ; TSTDBL1 = 70000 (positive, exceeds 16
C100                  (    forth6809.asm):00789         TSTD1LO  EQU   $1170         ; bits - exercises real double-cell width,
                      (    forth6809.asm):00790                                       ; not just a sign-extended single)
C100                  (    forth6809.asm):00791         TSTD2HI  EQU   $FFFE         ; TSTDBL2 = -70000
C100                  (    forth6809.asm):00792         TSTD2LO  EQU   $EE90
C100                  (    forth6809.asm):00793         TSTD3HI  EQU   $00BC         ; TSTDBL3 = 12345678
C100                  (    forth6809.asm):00794         TSTD3LO  EQU   $614E
C100                  (    forth6809.asm):00795         TSTDSHI  EQU   $0000         ; TSTDBLSMALL = 500 - small enough to fit
C100                  (    forth6809.asm):00796         TSTDSLO  EQU   $01F4         ; in a single cell, for D>S
                      (    forth6809.asm):00797         
                      (    forth6809.asm):00798         ; ------------------------------------------------------------
                      (    forth6809.asm):00799         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00800         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00801         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00802         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00803         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00804         TSTREPORT: PULU  D
                      (    forth6809.asm):00805                    STD   TSTFLAG
                      (    forth6809.asm):00806                    JSR   COUNT
                      (    forth6809.asm):00807                    JSR   TYPE
                      (    forth6809.asm):00808                    LDD   TSTFLAG
                      (    forth6809.asm):00809                    BEQ   TSTFAILR
                      (    forth6809.asm):00810                    LDD   #TSTOKMSG
                      (    forth6809.asm):00811                    PSHU  D
                      (    forth6809.asm):00812                    LDD   #TSTOKMSGL
                      (    forth6809.asm):00813                    PSHU  D
                      (    forth6809.asm):00814                    BRA   TSTPRINT
C100                  (    forth6809.asm):00815         TSTFAILR:  LDD   #TSTFAILMSG
                      (    forth6809.asm):00816                    PSHU  D
                      (    forth6809.asm):00817                    LDD   #TSTFAILMSGL
                      (    forth6809.asm):00818                    PSHU  D
C100                  (    forth6809.asm):00819         TSTPRINT:  JSR   TYPE
                      (    forth6809.asm):00820                    JSR   CRW
                      (    forth6809.asm):00821                    RTS
                      (    forth6809.asm):00822         
C100                  (    forth6809.asm):00823         TSTOKMSG:    FCC " OK"
C100                  (    forth6809.asm):00824         TSTOKMSGL    EQU  *-TSTOKMSG
C100                  (    forth6809.asm):00825         TSTFAILMSG:  FCC " FAIL"
C100                  (    forth6809.asm):00826         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00827         
                      (    forth6809.asm):00828         ; ------------------------------------------------------------
                      (    forth6809.asm):00829         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00830         ; here as they're written.
                      (    forth6809.asm):00831         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00832         TSTRUNNER: JSR   TSTSYSIO
                      (    forth6809.asm):00833                    JSR   TSTSTACK
                      (    forth6809.asm):00834                    JSR   TSTRETSTACK
                      (    forth6809.asm):00835                    JSR   TSTSARITH
                      (    forth6809.asm):00836                    JSR   TSTDARITH
                      (    forth6809.asm):00837                    JSR   TSTLOGIC
                      (    forth6809.asm):00838                    JSR   TSTCOMPARE
                      (    forth6809.asm):00839                    JSR   TSTCTRLFLOW
                      (    forth6809.asm):00840                    JSR   TSTDEFWORDS
                      (    forth6809.asm):00841                    JSR   TSTCOMPWORDS
                      (    forth6809.asm):00842                    JSR   TSTMEMORY
                      (    forth6809.asm):00843                    RTS
                      (    forth6809.asm):00844         
                      (    forth6809.asm):00845         ; ------------------------------------------------------------
                      (    forth6809.asm):00846         ; TSTSYSIO - System/Console I/O tests (glossary section 3.1, 12
                      (    forth6809.asm):00847         ; words, 7 tests). Six words are deliberately NOT tested here -
                      (    forth6809.asm):00848         ; KEY, ACCEPT, EXPECT, and QUERY all genuinely block on real
                      (    forth6809.asm):00849         ; input during automated, headless boot-time testing (confirmed
                      (    forth6809.asm):00850         ; by reading their own implementations: KEY spins on itself,
                      (    forth6809.asm):00851         ; ACCEPT calls KEY directly, EXPECT/QUERY both call ACCEPT); and
                      (    forth6809.asm):00852         ; ABORT/QUIT are both designed to never return (ABORT falls
                      (    forth6809.asm):00853         ; through into QUIT, which resets the return stack, discarding
                      (    forth6809.asm):00854         ; this entire call chain and hijacking the boot sequence into
                      (    forth6809.asm):00855         ; the interpreter's own top-level loop). See this group's own
                      (    forth6809.asm):00856         ; leading comment block, right before TSTKEYQ, for the full
                      (    forth6809.asm):00857         ; reasoning.
                      (    forth6809.asm):00858         ;
                      (    forth6809.asm):00859         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00860         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00861         ; thousands of times already across every prior test group.
                      (    forth6809.asm):00862         ; Each test here verifies the real queuing mechanism (OUTHEAD/
                      (    forth6809.asm):00863         ; OUTBUF), reading the actual character(s) back out of the
                      (    forth6809.asm):00864         ; output ring buffer to confirm they were genuinely queued, not
                      (    forth6809.asm):00865         ; just that the call returned without crashing.
                      (    forth6809.asm):00866         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00867         TSTSYSIO: JSR   CRW
                      (    forth6809.asm):00868                    LDX   #TSTSYSIOMSG
                      (    forth6809.asm):00869                    PSHU  X
                      (    forth6809.asm):00870                    LDD   #5
                      (    forth6809.asm):00871                    PSHU  D
                      (    forth6809.asm):00872                    JSR   TYPE
                      (    forth6809.asm):00873                    JSR   CRW
                      (    forth6809.asm):00874         
                      (    forth6809.asm):00875                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00876         
                      (    forth6809.asm):00877                    JSR   TSTKEYQ
                      (    forth6809.asm):00878                    JSR   TSTEMIT
                      (    forth6809.asm):00879                    JSR   TSTCR
                      (    forth6809.asm):00880                    JSR   TSTSPACE
                      (    forth6809.asm):00881                    JSR   TSTSPACES
                      (    forth6809.asm):00882                    JSR   TSTSPACESZ
                      (    forth6809.asm):00883                    JSR   TSTTYPE
                      (    forth6809.asm):00884         
                      (    forth6809.asm):00885                    ENDC ; <<<<
                      (    forth6809.asm):00886         
                      (    forth6809.asm):00887                    RTS
                      (    forth6809.asm):00888         
C100                  (    forth6809.asm):00889         TSTSYSIOMSG: FCC "SysIO"
                      (    forth6809.asm):00890         
                      (    forth6809.asm):00891                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00892         
                      (    forth6809.asm):00893         ; ------------------------------------------------------------
                      (    forth6809.asm):00894         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00895         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00896         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00897         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00898         ;
                      (    forth6809.asm):00899         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00900         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00901         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00902         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00903         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00904         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00905         ; where no real input will ever arrive.
                      (    forth6809.asm):00906         ;
                      (    forth6809.asm):00907         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00908         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00909         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00910         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00911         ; entirely, not just fail one test.
                      (    forth6809.asm):00912         ;
                      (    forth6809.asm):00913         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00914         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00915         ; thousands of times already across every prior test group
                      (    forth6809.asm):00916         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00917         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00918         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00919         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00920         ; returned.
                      (    forth6809.asm):00921         ; ------------------------------------------------------------
                      (    forth6809.asm):00922         
                      (    forth6809.asm):00923         ; ------------------------------------------------------------
                      (    forth6809.asm):00924         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00925         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00926         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00927         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00928         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00929         
                      (    forth6809.asm):00930                  LDD   #TSTGUARD
                      (    forth6809.asm):00931                  PSHU  D
                      (    forth6809.asm):00932                  STU   TSTUB4
                      (    forth6809.asm):00933         
                      (    forth6809.asm):00934                  JSR   KEYQ
                      (    forth6809.asm):00935         
                      (    forth6809.asm):00936                  STU   TSTUAF
                      (    forth6809.asm):00937         
                      (    forth6809.asm):00938                  PULU  D
                      (    forth6809.asm):00939                  CMPD  #FALSEV
                      (    forth6809.asm):00940                  BNE   KYFAIL
                      (    forth6809.asm):00941                  PULU  D
                      (    forth6809.asm):00942                  CMPD  #TSTGUARD
                      (    forth6809.asm):00943                  BNE   KYFAIL
                      (    forth6809.asm):00944         
                      (    forth6809.asm):00945                  LDD   TSTUB4
                      (    forth6809.asm):00946                  SUBD  TSTUAF
                      (    forth6809.asm):00947                  CMPD  #2
                      (    forth6809.asm):00948                  BNE   KYFAIL
                      (    forth6809.asm):00949         
                      (    forth6809.asm):00950                  LDD   #TRUEV
                      (    forth6809.asm):00951                  BRA   KYDONE
C100                  (    forth6809.asm):00952         KYFAIL: LDD   #FALSEV
C100                  (    forth6809.asm):00953         KYDONE: LDX   #TSTKEYQNAME
                      (    forth6809.asm):00954                  PSHU  X
                      (    forth6809.asm):00955                  PSHU  D
                      (    forth6809.asm):00956                  JSR   TSTREPORT
                      (    forth6809.asm):00957         
                      (    forth6809.asm):00958                  LDU   TSTU0
                      (    forth6809.asm):00959                  RTS
                      (    forth6809.asm):00960         
C100                  (    forth6809.asm):00961         TSTKEYQNAME: FCB  7
                      (    forth6809.asm):00962                      FCC  "TSTKEYQ"
                      (    forth6809.asm):00963         
                      (    forth6809.asm):00964         ; ------------------------------------------------------------
                      (    forth6809.asm):00965         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):00966         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):00967         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):00968         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):00969         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):00970         ; that the call returned.
                      (    forth6809.asm):00971         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00972         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):00973         
                      (    forth6809.asm):00974                  LDD   #TSTGUARD
                      (    forth6809.asm):00975                  PSHU  D
                      (    forth6809.asm):00976                  LDD   #65
                      (    forth6809.asm):00977                  PSHU  D
                      (    forth6809.asm):00978                  STU   TSTUB4
                      (    forth6809.asm):00979         
                      (    forth6809.asm):00980                  JSR   EMIT
                      (    forth6809.asm):00981         
                      (    forth6809.asm):00982                  STU   TSTUAF
                      (    forth6809.asm):00983         
                      (    forth6809.asm):00984                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):00985                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):00986                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):00987                                 ; different implementations, gated the same way
                      (    forth6809.asm):00988                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):00989                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):00990                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):00991                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):00992                                 ; always failed despite the character genuinely
                      (    forth6809.asm):00993                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):00994                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):00995                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):00996                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):00997                                 ; - checking it verifies the argument was
                      (    forth6809.asm):00998                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):00999                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):01000                                 ; conditional needed.
                      (    forth6809.asm):01001                  CMPA  #65
                      (    forth6809.asm):01002                  BNE   EMFAIL
                      (    forth6809.asm):01003         
                      (    forth6809.asm):01004                  PULU  D
                      (    forth6809.asm):01005                  CMPD  #TSTGUARD
                      (    forth6809.asm):01006                  BNE   EMFAIL
                      (    forth6809.asm):01007         
                      (    forth6809.asm):01008                  LDD   TSTUB4
                      (    forth6809.asm):01009                  SUBD  TSTUAF
                      (    forth6809.asm):01010                  CMPD  #-2
                      (    forth6809.asm):01011                  BNE   EMFAIL
                      (    forth6809.asm):01012         
                      (    forth6809.asm):01013                  LDD   #TRUEV
                      (    forth6809.asm):01014                  BRA   EMDONE
C100                  (    forth6809.asm):01015         EMFAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):01016         EMDONE:  LDX   #TSTEMITNAME
                      (    forth6809.asm):01017                  PSHU  X
                      (    forth6809.asm):01018                  PSHU  D
                      (    forth6809.asm):01019                  JSR   TSTREPORT
                      (    forth6809.asm):01020         
                      (    forth6809.asm):01021                  LDU   TSTU0
                      (    forth6809.asm):01022                  RTS
                      (    forth6809.asm):01023         
C100                  (    forth6809.asm):01024         TSTEMITNAME: FCB  7
                      (    forth6809.asm):01025                      FCC  "TSTEMIT"
                      (    forth6809.asm):01026         
                      (    forth6809.asm):01027         ; ------------------------------------------------------------
                      (    forth6809.asm):01028         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01029         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01030         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01031         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01032         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01033         
                      (    forth6809.asm):01034                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01035                  LDA   OUTHEAD
                      (    forth6809.asm):01036                  STA   TSTOHSAV
                      (    forth6809.asm):01037                  ENDC ; <<<<
                      (    forth6809.asm):01038         
                      (    forth6809.asm):01039         
                      (    forth6809.asm):01040                  LDD   #TSTGUARD
                      (    forth6809.asm):01041                  PSHU  D
                      (    forth6809.asm):01042                  STU   TSTUB4
                      (    forth6809.asm):01043         
                      (    forth6809.asm):01044                  JSR   CRW
                      (    forth6809.asm):01045         
                      (    forth6809.asm):01046                  STU   TSTUAF
                      (    forth6809.asm):01047         
                      (    forth6809.asm):01048                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01049                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01050                                   ; in order
                      (    forth6809.asm):01051                  LDA   TSTOHSAV
                      (    forth6809.asm):01052                  ADDA  #2
                      (    forth6809.asm):01053                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01054                  CMPA  OUTHEAD
                      (    forth6809.asm):01055                  BNE   CRFAIL
                      (    forth6809.asm):01056         
                      (    forth6809.asm):01057                  LDX   #OUTBUF
                      (    forth6809.asm):01058                  LDB   TSTOHSAV
                      (    forth6809.asm):01059                  LDA   B,X
                      (    forth6809.asm):01060                  CMPA  #13
                      (    forth6809.asm):01061                  BNE   CRFAIL
                      (    forth6809.asm):01062                  INCB
                      (    forth6809.asm):01063                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01064                  LDA   B,X
                      (    forth6809.asm):01065                  CMPA  #10
                      (    forth6809.asm):01066                  BNE   CRFAIL
                      (    forth6809.asm):01067                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01068                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01069                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01070                                   ; entirely different implementations, gated
                      (    forth6809.asm):01071                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01072                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01073                                   ; currently active build) writes directly to
                      (    forth6809.asm):01074                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01075                                   ; all, so this check always failed despite
                      (    forth6809.asm):01076                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01077                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01078                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01079                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01080                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01081                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01082                                   ; depth check below is the most this variant
                      (    forth6809.asm):01083                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01084                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01085                                   ; persistent state.
                      (    forth6809.asm):01086                  LDA   EMITCH
                      (    forth6809.asm):01087                  CMPA  #10
                      (    forth6809.asm):01088                  BNE   CRFAIL
                      (    forth6809.asm):01089                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01090         
                      (    forth6809.asm):01091                  PULU  D
                      (    forth6809.asm):01092                  CMPD  #TSTGUARD
                      (    forth6809.asm):01093                  BNE   CRFAIL
                      (    forth6809.asm):01094         
                      (    forth6809.asm):01095                  LDD   TSTUB4
                      (    forth6809.asm):01096                  SUBD  TSTUAF
                      (    forth6809.asm):01097                  CMPD  #0
                      (    forth6809.asm):01098                  BNE   CRFAIL
                      (    forth6809.asm):01099         
                      (    forth6809.asm):01100                  LDD   #TRUEV
                      (    forth6809.asm):01101                  BRA   CRDONE
C100                  (    forth6809.asm):01102         CRFAIL: LDD   #FALSEV
C100                  (    forth6809.asm):01103         CRDONE: LDX   #TSTCRNAME
                      (    forth6809.asm):01104                  PSHU  X
                      (    forth6809.asm):01105                  PSHU  D
                      (    forth6809.asm):01106                  JSR   TSTREPORT
                      (    forth6809.asm):01107         
                      (    forth6809.asm):01108                  LDU   TSTU0
                      (    forth6809.asm):01109                  RTS
                      (    forth6809.asm):01110         
C100                  (    forth6809.asm):01111         TSTCRNAME: FCB  5
                      (    forth6809.asm):01112                    FCC  "TSTCR"
                      (    forth6809.asm):01113         
                      (    forth6809.asm):01114         ; ------------------------------------------------------------
                      (    forth6809.asm):01115         ; TSTSPACE - unit test for SPACE. Verifies one space (32) is
                      (    forth6809.asm):01116         ; genuinely queued.
                      (    forth6809.asm):01117         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01118         TSTSPACE: STU  TSTU0
                      (    forth6809.asm):01119         
                      (    forth6809.asm):01120                   LDD  #TSTGUARD
                      (    forth6809.asm):01121                   PSHU D
                      (    forth6809.asm):01122                   STU  TSTUB4
                      (    forth6809.asm):01123         
                      (    forth6809.asm):01124                   JSR  SPACEW
                      (    forth6809.asm):01125         
                      (    forth6809.asm):01126                   STU  TSTUAF
                      (    forth6809.asm):01127         
                      (    forth6809.asm):01128                   LDA  EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF - same
                      (    forth6809.asm):01129                                 ; fix and same reasoning as TSTEMIT's own fix
                      (    forth6809.asm):01130                                 ; (see its comment). SPACEW calls EMIT
                      (    forth6809.asm):01131                                 ; internally with a single character (32), so
                      (    forth6809.asm):01132                                 ; EMITCH correctly reflects it regardless of
                      (    forth6809.asm):01133                                 ; which EMIT variant is active.
                      (    forth6809.asm):01134                   CMPA #32
                      (    forth6809.asm):01135                   BNE  SCFAIL
                      (    forth6809.asm):01136         
                      (    forth6809.asm):01137                   PULU D
                      (    forth6809.asm):01138                   CMPD #TSTGUARD
                      (    forth6809.asm):01139                   BNE  SCFAIL
                      (    forth6809.asm):01140         
                      (    forth6809.asm):01141                   LDD  TSTUB4
                      (    forth6809.asm):01142                   SUBD TSTUAF
                      (    forth6809.asm):01143                   CMPD #0
                      (    forth6809.asm):01144                   BNE  SCFAIL
                      (    forth6809.asm):01145         
                      (    forth6809.asm):01146                   LDD  #TRUEV
                      (    forth6809.asm):01147                   BRA  SCDONE
C100                  (    forth6809.asm):01148         SCFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):01149         SCDONE:  LDX  #TSTSPACENAME
                      (    forth6809.asm):01150                   PSHU X
                      (    forth6809.asm):01151                   PSHU D
                      (    forth6809.asm):01152                   JSR  TSTREPORT
                      (    forth6809.asm):01153         
                      (    forth6809.asm):01154                   LDU  TSTU0
                      (    forth6809.asm):01155                   RTS
                      (    forth6809.asm):01156         
C100                  (    forth6809.asm):01157         TSTSPACENAME: FCB  8
                      (    forth6809.asm):01158                       FCC  "TSTSPACE"
                      (    forth6809.asm):01159         
                      (    forth6809.asm):01160         ; ------------------------------------------------------------
                      (    forth6809.asm):01161         ; TSTSPACES - unit test for SPACES, normal (n=3) case. Verifies
                      (    forth6809.asm):01162         ; all three queued bytes are genuinely spaces (32), not just
                      (    forth6809.asm):01163         ; that OUTHEAD advanced by the right count.
                      (    forth6809.asm):01164         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01165         TSTSPACES: STU  TSTU0
                      (    forth6809.asm):01166         
                      (    forth6809.asm):01167                    IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01168                    LDA  OUTHEAD
                      (    forth6809.asm):01169                    STA  TSTOHSAV
                      (    forth6809.asm):01170                    ENDC ; <<<<
                      (    forth6809.asm):01171         
                      (    forth6809.asm):01172                    LDD  #TSTGUARD
                      (    forth6809.asm):01173                    PSHU D
                      (    forth6809.asm):01174                    LDD  #3
                      (    forth6809.asm):01175                    PSHU D
                      (    forth6809.asm):01176                    STU  TSTUB4
                      (    forth6809.asm):01177         
                      (    forth6809.asm):01178                    JSR  SPACESW
                      (    forth6809.asm):01179         
                      (    forth6809.asm):01180                    STU  TSTUAF
                      (    forth6809.asm):01181         
                      (    forth6809.asm):01182                    IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01183                                     ; queues all three bytes into OUTBUF,
                      (    forth6809.asm):01184                                     ; verifiable individually
                      (    forth6809.asm):01185                    LDA  TSTOHSAV
                      (    forth6809.asm):01186                    ADDA #3
                      (    forth6809.asm):01187                    ANDA #OUTBUFSZ-1
                      (    forth6809.asm):01188                    CMPA OUTHEAD
                      (    forth6809.asm):01189                    BNE  SSFAIL
                      (    forth6809.asm):01190         
                      (    forth6809.asm):01191                    LDX  #OUTBUF
                      (    forth6809.asm):01192                    LDB  TSTOHSAV
                      (    forth6809.asm):01193                    LDA  B,X
                      (    forth6809.asm):01194                    CMPA #32
                      (    forth6809.asm):01195                    BNE  SSFAIL
                      (    forth6809.asm):01196                    INCB
                      (    forth6809.asm):01197                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01198                    LDA  B,X
                      (    forth6809.asm):01199                    CMPA #32
                      (    forth6809.asm):01200                    BNE  SSFAIL
                      (    forth6809.asm):01201                    INCB
                      (    forth6809.asm):01202                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01203                    LDA  B,X
                      (    forth6809.asm):01204                    CMPA #32
                      (    forth6809.asm):01205                    BNE  SSFAIL
                      (    forth6809.asm):01206                    ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking
                      (    forth6809.asm):01207                                     ; OUTHEAD/OUTBUF - same fix and reasoning as
                      (    forth6809.asm):01208                                     ; TSTCR's own fix. In polling mode, EMITCH
                      (    forth6809.asm):01209                                     ; only reflects the LAST of the three
                      (    forth6809.asm):01210                                     ; identical spaces emitted, and there is no
                      (    forth6809.asm):01211                                     ; persistent per-call count to verify
                      (    forth6809.asm):01212                                     ; exactly three calls happened, not just
                      (    forth6809.asm):01213                                     ; one or two - a genuine limitation of a
                      (    forth6809.asm):01214                                     ; direct hardware write with no buffering,
                      (    forth6809.asm):01215                                     ; not something this test can work around.
                      (    forth6809.asm):01216                                     ; The depth check below still confirms n=3
                      (    forth6809.asm):01217                                     ; was correctly consumed as an argument.
                      (    forth6809.asm):01218                    LDA  EMITCH
                      (    forth6809.asm):01219                    CMPA #32
                      (    forth6809.asm):01220                    BNE  SSFAIL
                      (    forth6809.asm):01221                    ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01222         
                      (    forth6809.asm):01223                    PULU D
                      (    forth6809.asm):01224                    CMPD #TSTGUARD
                      (    forth6809.asm):01225                    BNE  SSFAIL
                      (    forth6809.asm):01226         
                      (    forth6809.asm):01227                    LDD  TSTUB4
                      (    forth6809.asm):01228                    SUBD TSTUAF
                      (    forth6809.asm):01229                    CMPD #-2
                      (    forth6809.asm):01230                    BNE  SSFAIL
                      (    forth6809.asm):01231         
                      (    forth6809.asm):01232                    LDD  #TRUEV
                      (    forth6809.asm):01233                    BRA  SSDONE
C100                  (    forth6809.asm):01234         SSFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):01235         SSDONE:    LDX  #TSTSPACESNAME
                      (    forth6809.asm):01236                    PSHU X
                      (    forth6809.asm):01237                    PSHU D
                      (    forth6809.asm):01238                    JSR  TSTREPORT
                      (    forth6809.asm):01239         
                      (    forth6809.asm):01240                    LDU  TSTU0
                      (    forth6809.asm):01241                    RTS
                      (    forth6809.asm):01242         
C100                  (    forth6809.asm):01243         TSTSPACESNAME: FCB  9
                      (    forth6809.asm):01244                        FCC  "TSTSPACES"
                      (    forth6809.asm):01245         
                      (    forth6809.asm):01246         ; ------------------------------------------------------------
                      (    forth6809.asm):01247         ; TSTSPACESZ - unit test for SPACES, n<=0 case. Documented
                      (    forth6809.asm):01248         ; behavior is "no output if n <= 0" - verifies OUTHEAD genuinely
                      (    forth6809.asm):01249         ; doesn't advance at all, not just that the call didn't crash.
                      (    forth6809.asm):01250         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01251         TSTSPACESZ: LDA  OUTHEAD
                      (    forth6809.asm):01252                     STA  TSTOHSAV
                      (    forth6809.asm):01253         
                      (    forth6809.asm):01254                     STU  TSTU0
                      (    forth6809.asm):01255         
                      (    forth6809.asm):01256                     LDD  #TSTGUARD
                      (    forth6809.asm):01257                     PSHU D
                      (    forth6809.asm):01258                     LDD  #0
                      (    forth6809.asm):01259                     PSHU D
                      (    forth6809.asm):01260                     STU  TSTUB4
                      (    forth6809.asm):01261         
                      (    forth6809.asm):01262                     JSR  SPACESW
                      (    forth6809.asm):01263         
                      (    forth6809.asm):01264                     STU  TSTUAF
                      (    forth6809.asm):01265         
                      (    forth6809.asm):01266                     LDA  TSTOHSAV
                      (    forth6809.asm):01267                     CMPA OUTHEAD
                      (    forth6809.asm):01268                     BNE  S0FAIL
                      (    forth6809.asm):01269         
                      (    forth6809.asm):01270                     PULU D
                      (    forth6809.asm):01271                     CMPD #TSTGUARD
                      (    forth6809.asm):01272                     BNE  S0FAIL
                      (    forth6809.asm):01273         
                      (    forth6809.asm):01274                     LDD  TSTUB4
                      (    forth6809.asm):01275                     SUBD TSTUAF
                      (    forth6809.asm):01276                     CMPD #-2
                      (    forth6809.asm):01277                     BNE  S0FAIL
                      (    forth6809.asm):01278         
                      (    forth6809.asm):01279                     LDD  #TRUEV
                      (    forth6809.asm):01280                     BRA  S0DONE
C100                  (    forth6809.asm):01281         S0FAIL:     LDD  #FALSEV
C100                  (    forth6809.asm):01282         S0DONE:     LDX  #TSTSPACESZNAME
                      (    forth6809.asm):01283                     PSHU X
                      (    forth6809.asm):01284                     PSHU D
                      (    forth6809.asm):01285                     JSR  TSTREPORT
                      (    forth6809.asm):01286         
                      (    forth6809.asm):01287                     LDU  TSTU0
                      (    forth6809.asm):01288                     RTS
                      (    forth6809.asm):01289         
C100                  (    forth6809.asm):01290         TSTSPACESZNAME: FCB  10
                      (    forth6809.asm):01291                         FCC  "TSTSPACESZ"
                      (    forth6809.asm):01292         
                      (    forth6809.asm):01293         ; ------------------------------------------------------------
                      (    forth6809.asm):01294         ; TSTTYPE - unit test for TYPE. Writes a known 2-character
                      (    forth6809.asm):01295         ; string into scratch, calls TYPE on it, and verifies both
                      (    forth6809.asm):01296         ; queued bytes genuinely match the source string, in order -
                      (    forth6809.asm):01297         ; not just that OUTHEAD advanced by the right count.
                      (    forth6809.asm):01298         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01299         TSTTYPE: LDA   #'A'
                      (    forth6809.asm):01300                  STA   TSTNAMEB
                      (    forth6809.asm):01301                  LDA   #'B'
                      (    forth6809.asm):01302                  STA   TSTNAMEB+1
                      (    forth6809.asm):01303         
                      (    forth6809.asm):01304                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01305                  LDA   OUTHEAD
                      (    forth6809.asm):01306                  STA   TSTOHSAV
                      (    forth6809.asm):01307                  ENDC ; <<<<
                      (    forth6809.asm):01308         
                      (    forth6809.asm):01309                  STU   TSTU0
                      (    forth6809.asm):01310         
                      (    forth6809.asm):01311                  LDD   #TSTGUARD
                      (    forth6809.asm):01312                  PSHU  D
                      (    forth6809.asm):01313                  LDD   #TSTNAMEB
                      (    forth6809.asm):01314                  PSHU  D
                      (    forth6809.asm):01315                  LDD   #2
                      (    forth6809.asm):01316                  PSHU  D
                      (    forth6809.asm):01317                  STU   TSTUB4
                      (    forth6809.asm):01318         
                      (    forth6809.asm):01319                  JSR   TYPE
                      (    forth6809.asm):01320         
                      (    forth6809.asm):01321                  STU   TSTUAF
                      (    forth6809.asm):01322         
                      (    forth6809.asm):01323                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01324                                   ; (called internally by TYPE for each
                      (    forth6809.asm):01325                                   ; character) queues both bytes into OUTBUF,
                      (    forth6809.asm):01326                                   ; verifiable in order
                      (    forth6809.asm):01327                  LDA   TSTOHSAV
                      (    forth6809.asm):01328                  ADDA  #2
                      (    forth6809.asm):01329                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01330                  CMPA  OUTHEAD
                      (    forth6809.asm):01331                  BNE   TEFAIL
                      (    forth6809.asm):01332         
                      (    forth6809.asm):01333                  LDX   #OUTBUF
                      (    forth6809.asm):01334                  LDB   TSTOHSAV
                      (    forth6809.asm):01335                  LDA   B,X
                      (    forth6809.asm):01336                  CMPA  #'A'
                      (    forth6809.asm):01337                  BNE   TEFAIL
                      (    forth6809.asm):01338                  INCB
                      (    forth6809.asm):01339                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01340                  LDA   B,X
                      (    forth6809.asm):01341                  CMPA  #'B'
                      (    forth6809.asm):01342                  BNE   TEFAIL
                      (    forth6809.asm):01343                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01344                                   ; OUTBUF - same fix and reasoning as TSTCR's
                      (    forth6809.asm):01345                                   ; own fix. EMITCH only reflects the LAST of
                      (    forth6809.asm):01346                                   ; the two characters TYPE emits ('B') by the
                      (    forth6809.asm):01347                                   ; time this runs; the depth check below still
                      (    forth6809.asm):01348                                   ; confirms the addr/len arguments were
                      (    forth6809.asm):01349                                   ; correctly consumed.
                      (    forth6809.asm):01350                  LDA   EMITCH
                      (    forth6809.asm):01351                  CMPA  #'B'
                      (    forth6809.asm):01352                  BNE   TEFAIL
                      (    forth6809.asm):01353                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01354         
                      (    forth6809.asm):01355                  PULU  D
                      (    forth6809.asm):01356                  CMPD  #TSTGUARD
                      (    forth6809.asm):01357                  BNE   TEFAIL
                      (    forth6809.asm):01358         
                      (    forth6809.asm):01359                  LDD   TSTUB4
                      (    forth6809.asm):01360                  SUBD  TSTUAF
                      (    forth6809.asm):01361                  CMPD  #-4
                      (    forth6809.asm):01362                  BNE   TEFAIL
                      (    forth6809.asm):01363         
                      (    forth6809.asm):01364                  LDD   #TRUEV
                      (    forth6809.asm):01365                  BRA   TEDONE
C100                  (    forth6809.asm):01366         TEFAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):01367         TEDONE:  LDX   #TSTTYPENAME
                      (    forth6809.asm):01368                  PSHU  X
                      (    forth6809.asm):01369                  PSHU  D
                      (    forth6809.asm):01370                  JSR   TSTREPORT
                      (    forth6809.asm):01371         
                      (    forth6809.asm):01372                  LDU   TSTU0
                      (    forth6809.asm):01373                  RTS
                      (    forth6809.asm):01374         
C100                  (    forth6809.asm):01375         TSTTYPENAME: FCB  7
                      (    forth6809.asm):01376                      FCC  "TSTTYPE"
                      (    forth6809.asm):01377         
                      (    forth6809.asm):01378                    ENDC ; <<<<
                      (    forth6809.asm):01379         

F4AB 2404             (    forth6809.asm):06654                     BCC   SQEH2
F4AD 1F98             (    forth6809.asm):06655                     TFR   B,A               ; one digit only
F4AF 20DA             (    forth6809.asm):06656                     BRA   SQEPUT
F4B1 3121             (    forth6809.asm):06657         SQEH2:      LEAY  1,Y
F4B3 58               (    forth6809.asm):06658                     ASLB

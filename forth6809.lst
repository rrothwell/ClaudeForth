                      (   unit_tests.asm):09858         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (   unit_tests.asm):09859         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (   unit_tests.asm):09860         ; IS tests, but gets its own dedicated test here too.
                      (   unit_tests.asm):09861         ;
                      (   unit_tests.asm):09862         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (   unit_tests.asm):09863         ; itself (a pure address computation) - wrong, confirmed via
                      (   unit_tests.asm):09864         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (   unit_tests.asm):09865         ; returning the VALUE stored there, not the address itself. This
                      (   unit_tests.asm):09866         ; is genuinely correct behavior for this system's own trampoline
                      (   unit_tests.asm):09867         ; design, not a bug in TOBODY - reconciled directly against why
                      (   unit_tests.asm):09868         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (   unit_tests.asm):09869         ; same TOBODY and passed on real hardware, never surfaced this:
                      (   unit_tests.asm):09870         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (   unit_tests.asm):09871         ; own compile-time code stores a genuinely meaningful value at
                      (   unit_tests.asm):09872         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (   unit_tests.asm):09873         ; value) - "the body" for this system's own design IS the value
                      (   unit_tests.asm):09874         ; at xt+5, not xt+5's own address. This test never initialized
                      (   unit_tests.asm):09875         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (   unit_tests.asm):09876         ; whatever garbage happened to already be there - now sets a
                      (   unit_tests.asm):09877         ; known value there first and verifies TOBODY returns exactly
                      (   unit_tests.asm):09878         ; that.
                      (   unit_tests.asm):09879         ; ------------------------------------------------------------
C281                  (   unit_tests.asm):09880         TSTTOBODY: LDD  #TSTVAL1
                      (   unit_tests.asm):09881                    STD  TSTCBUF+5
                      (   unit_tests.asm):09882         
                      (   unit_tests.asm):09883                    STU  TSTU0
                      (   unit_tests.asm):09884         
                      (   unit_tests.asm):09885                    LDD  #TSTGUARD
                      (   unit_tests.asm):09886                    PSHU D
                      (   unit_tests.asm):09887                    LDD  #TSTCBUF
                      (   unit_tests.asm):09888                    PSHU D
                      (   unit_tests.asm):09889                    STU  TSTUB4
                      (   unit_tests.asm):09890         
                      (   unit_tests.asm):09891                    JSR  TOBODY
                      (   unit_tests.asm):09892         
                      (   unit_tests.asm):09893                    STU  TSTUAF
                      (   unit_tests.asm):09894         
                      (   unit_tests.asm):09895                    PULU D
                      (   unit_tests.asm):09896                    CMPD #TSTVAL1
                      (   unit_tests.asm):09897                    BNE  TBFAIL
                      (   unit_tests.asm):09898                    PULU D
                      (   unit_tests.asm):09899                    CMPD #TSTGUARD
                      (   unit_tests.asm):09900                    BNE  TBFAIL
                      (   unit_tests.asm):09901         
                      (   unit_tests.asm):09902                    LDD  TSTUB4
                      (   unit_tests.asm):09903                    SUBD TSTUAF
                      (   unit_tests.asm):09904                    CMPD #0
                      (   unit_tests.asm):09905                    BNE  TBFAIL
                      (   unit_tests.asm):09906         
                      (   unit_tests.asm):09907                    LDD  #TRUEV
                      (   unit_tests.asm):09908                    BRA  TBDONE
C281                  (   unit_tests.asm):09909         TBFAIL:    LDD  #FALSEV
C281                  (   unit_tests.asm):09910         TBDONE:    LDX  #TSTTBNAME

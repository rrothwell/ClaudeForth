     DEE3             (    forth6809.asm):13190         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):13191                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):13192                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):13193                                   ; were chained on after it; before that,
                      (    forth6809.asm):13194                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):13195                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):13196                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):13197                                   ; before this one.
                      (    forth6809.asm):13198         
                      (    forth6809.asm):13199         ; Verify no collision with base code.
                      (    forth6809.asm):13200         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):13201         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):13202         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):13203         
                      (    forth6809.asm):13204         ; ============================================================
                      (    forth6809.asm):13205         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):13206         ; ============================================================
                      (    forth6809.asm):13207                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):13208                                        ; entirely - every routine from here through
                      (    forth6809.asm):13209                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):13210                                        ; every primitive) would otherwise have
                      (    forth6809.asm):13211                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):13212                                        ; WARM message left the location counter,
                      (    forth6809.asm):13213                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):13214                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):13215                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):13216         
                      (    forth6809.asm):13217         ; ------------------------------------------------------------
                      (    forth6809.asm):13218         ; INITSERIAL - initializes the ACIA: master reset, then selects

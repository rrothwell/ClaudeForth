D8D4 A646             (    forth6809.asm):04168                     LDA   6,U
D8D6 E661             (    forth6809.asm):04169                     LDB   1,S
D8D8 3D               (    forth6809.asm):04170                     MUL
D8D9 EBE4             (    forth6809.asm):04171                     ADDB  ,S
D8DB 2401             (    forth6809.asm):04172                     BCC   UM1

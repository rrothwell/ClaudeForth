DDCC 5C               (    forth6809.asm):01820                     INCB                    ; Update the tail pointer
DDCD C43F             (    forth6809.asm):01821                     ANDB  #INBUFSZ-1        ; to point to the next character.
DDCF F70177           (    forth6809.asm):01822                     STB   INTAIL
                      (    forth6809.asm):01823         

                      (    forth6809.asm):07771         ; ============================================================
                      (    forth6809.asm):07772         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07773         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07774         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07775         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07776         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07777         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07778         ; ============================================================
                      (    forth6809.asm):07779         ; ------------------------------------------------------------
                      (    forth6809.asm):07780         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07781         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07782         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07783         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07784         ; - no indirection, no value cell.
                      (    forth6809.asm):07785         ;
                      (    forth6809.asm):07786         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07787         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07788         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07789         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07790         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07791         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07792         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07793         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07794         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07795         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07796         ; ------------------------------------------------------------
FE0C CCFFFF           (    forth6809.asm):07797         TRUEBODY:  LDD   #$FFFF
FE0F 3606             (    forth6809.asm):07798                    PSHU  D
FE11 39               (    forth6809.asm):07799                    RTS
                      (    forth6809.asm):07800         
FE12 CC0000           (    forth6809.asm):07801         FALSEBODY: LDD   #$0000
FE15 3606             (    forth6809.asm):07802                    PSHU  D
FE17 39               (    forth6809.asm):07803                    RTS
                      (    forth6809.asm):07804         
                      (    forth6809.asm):07805         ; ------------------------------------------------------------
                      (    forth6809.asm):07806         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07807         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07808         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07809         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07810         ; ------------------------------------------------------------
FE18 CC0001           (    forth6809.asm):07811         ONEBODY:   LDD   #1
FE1B 3606             (    forth6809.asm):07812                    PSHU  D
FE1D 39               (    forth6809.asm):07813                    RTS
                      (    forth6809.asm):07814         
FE1E CCFFFF           (    forth6809.asm):07815         MONEBODY:  LDD   #-1
FE21 3606             (    forth6809.asm):07816                    PSHU  D
FE23 39               (    forth6809.asm):07817                    RTS
                      (    forth6809.asm):07818         
FE24 CC0002           (    forth6809.asm):07819         TWOBODY:   LDD   #2
FE27 3606             (    forth6809.asm):07820                    PSHU  D
FE29 39               (    forth6809.asm):07821                    RTS
                      (    forth6809.asm):07822         
FE2A CCFFFE           (    forth6809.asm):07823         MTWOBODY:  LDD   #-2
FE2D 3606             (    forth6809.asm):07824                    PSHU  D
FE2F 39               (    forth6809.asm):07825                    RTS
                      (    forth6809.asm):07826         
                      (    forth6809.asm):07827         ; Verify no collision with init code,
                      (    forth6809.asm):07828         ; value should match ORG INITCODE.
     FE30             (    forth6809.asm):07829         BASECODEEND  EQU   *
     20EA             (    forth6809.asm):07830         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07831         
                      (    forth6809.asm):07832         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07833         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07834         ; .bin file.
FE30                  (    forth6809.asm):07835         BASEND:
FE30 FFFFFFFFFFFFFFFF (    forth6809.asm):07836                  FILL $FF,INITCODE-BASEND

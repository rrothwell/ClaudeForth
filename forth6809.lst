                      (    forth6809.asm):04924         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04925         ;    Inputs:
                      (    forth6809.asm):04926         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04927         ;    Outputs:
                      (    forth6809.asm):04928         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04929         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04930         ; ------------------------------------------------------------
DFFF 3706             (    forth6809.asm):04931         DOSETUP:    PULU  D                 ; index
E001 DD14             (    forth6809.asm):04932                     STD   MSCR
E003 3706             (    forth6809.asm):04933                     PULU  D                 ; limit
E005 DD16             (    forth6809.asm):04934                     STD   MSCR2
E007 3510             (    forth6809.asm):04935                     PULS  X
E009 CC0000           (    forth6809.asm):04936                     LDD   #0
E00C 3406             (    forth6809.asm):04937                     PSHS  D
E00E DC16             (    forth6809.asm):04938                     LDD   MSCR2
E010 3406             (    forth6809.asm):04939                     PSHS  D
E012 DC14             (    forth6809.asm):04940                     LDD   MSCR
E014 3406             (    forth6809.asm):04941                     PSHS  D
E016 3410             (    forth6809.asm):04942                     PSHS  X
E018 39               (    forth6809.asm):04943                     RTS
                      (    forth6809.asm):04944         
                      (    forth6809.asm):04945         ; ------------------------------------------------------------
                      (    forth6809.asm):04946         ; I  ( -- n )
                      (    forth6809.asm):04947         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04948         ; address).
                      (    forth6809.asm):04949         ; ------------------------------------------------------------
E019 EC62             (    forth6809.asm):04950         IW:         LDD   2,S               ; n. See bugfix: IW.1
E01B 3606             (    forth6809.asm):04951                     PSHU  D
E01D 39               (    forth6809.asm):04952                     RTS
                      (    forth6809.asm):04953         
                      (    forth6809.asm):04954         ; ------------------------------------------------------------
                      (    forth6809.asm):04955         ; J  ( -- n )
                      (    forth6809.asm):04956         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04957         ; address and the inner loop frame).
                      (    forth6809.asm):04958         ; ------------------------------------------------------------
E01E EC68             (    forth6809.asm):04959         JW:         LDD   8,S               ; n. See bugfix: JW.1
E020 3606             (    forth6809.asm):04960                     PSHU  D
E022 39               (    forth6809.asm):04961                     RTS
                      (    forth6809.asm):04962         
                      (    forth6809.asm):04963         ; ------------------------------------------------------------
                      (    forth6809.asm):04964         ; LEAVE  ( -- )
                      (    forth6809.asm):04965         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04966         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04967         ; ------------------------------------------------------------
E023 CCFFFF           (    forth6809.asm):04968         LEAVEW:     LDD   #TRUEV            ; true
E026 ED66             (    forth6809.asm):04969                     STD   6,S               ; See bugfix: LEAVEW.1
E028 39               (    forth6809.asm):04970                     RTS
                      (    forth6809.asm):04971         
                      (    forth6809.asm):04972         ; ------------------------------------------------------------
                      (    forth6809.asm):04973         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04974         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04975         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04976         ; ------------------------------------------------------------
E029 3706             (    forth6809.asm):04977         LOOPW:      PULU  D
E02B 10830003         (    forth6809.asm):04978                     CMPD  #TAGDO
E02F 2703             (    forth6809.asm):04979                     BEQ   LOOPOK
E031 BDDDFA           (    forth6809.asm):04980                     JSR   CFERR
E034 3706             (    forth6809.asm):04981         LOOPOK:     PULU  D                 ; dest
E036 3606             (    forth6809.asm):04982                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E038 CCE068           (    forth6809.asm):04983                     LDD   #DOTEST
E03B 3606             (    forth6809.asm):04984                     PSHU  D
E03D BDE26A           (    forth6809.asm):04985                     JSR   CCALL
E040 CC0000           (    forth6809.asm):04986                     LDD   #0
E043 3606             (    forth6809.asm):04987                     PSHU  D
E045 BDD58F           (    forth6809.asm):04988                     JSR   CODECOMMA
E048 DC08             (    forth6809.asm):04989                     LDD   CODEHERE
E04A 830002           (    forth6809.asm):04990                     SUBD  #2
E04D 3606             (    forth6809.asm):04991                     PSHU  D                 ; location; the parked dest is beneath
E04F BDDE64           (    forth6809.asm):04992                     JSR   PATCH
                      (    forth6809.asm):04993         
E052 ECC4             (    forth6809.asm):04994                     LDD   ,U
E054 10830007         (    forth6809.asm):04995                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E058 260D             (    forth6809.asm):04996                     BNE   LOOPDONE
E05A 3706             (    forth6809.asm):04997                     PULU  D
E05C 3710             (    forth6809.asm):04998                     PULU  X                 ; ?DO skip operand
E05E DC08             (    forth6809.asm):04999                     LDD   CODEHERE
E060 3606             (    forth6809.asm):05000                     PSHU  D
E062 3610             (    forth6809.asm):05001                     PSHU  X
E064 BDDE64           (    forth6809.asm):05002                     JSR   PATCH
E067 39               (    forth6809.asm):05003         LOOPDONE:   RTS
                      (    forth6809.asm):05004         
                      (    forth6809.asm):05005         ; ------------------------------------------------------------
                      (    forth6809.asm):05006         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05007         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05008         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05009         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05010         ; DOTEST
                      (    forth6809.asm):05011         ;    Inputs:
                      (    forth6809.asm):05012         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05013         ;        first)
                      (    forth6809.asm):05014         ;    Outputs:
                      (    forth6809.asm):05015         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05016         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05017         ; ------------------------------------------------------------
E068 EC66             (    forth6809.asm):05018         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E06A 2615             (    forth6809.asm):05019                     BNE   DTEXIT            ; set: exit
E06C EC62             (    forth6809.asm):05020                     LDD   2,S               ; index
E06E C30001           (    forth6809.asm):05021                     ADDD  #1
E071 ED62             (    forth6809.asm):05022                     STD   2,S
E073 10A364           (    forth6809.asm):05023                     CMPD  4,S               ; limit
E076 2709             (    forth6809.asm):05024                     BEQ   DTEXIT
E078 3510             (    forth6809.asm):05025                     PULS  X                 ; X = branch operand address
E07A EC84             (    forth6809.asm):05026                     LDD   ,X
E07C 308B             (    forth6809.asm):05027                     LEAX  D,X
E07E 3410             (    forth6809.asm):05028                     PSHS  X                 ; return to loop start
E080 39               (    forth6809.asm):05029                     RTS
E081 3510             (    forth6809.asm):05030         DTEXIT:     PULS  X
E083 3002             (    forth6809.asm):05031                     LEAX  2,X               ; skip the branch operand
E085 3266             (    forth6809.asm):05032                     LEAS  6,S               ; discard the loop frame
E087 3410             (    forth6809.asm):05033                     PSHS  X
E089 39               (    forth6809.asm):05034                     RTS
                      (    forth6809.asm):05035         
                      (    forth6809.asm):05036         ; ------------------------------------------------------------
                      (    forth6809.asm):05037         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05038         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05039         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05040         ; ------------------------------------------------------------
E08A 3706             (    forth6809.asm):05041         PLUSLOOPW:  PULU  D
E08C 10830003         (    forth6809.asm):05042                     CMPD  #TAGDO
E090 2703             (    forth6809.asm):05043                     BEQ   PLOOPOK
E092 BDDDFA           (    forth6809.asm):05044                     JSR   CFERR
E095 3706             (    forth6809.asm):05045         PLOOPOK:    PULU  D                 ; dest
E097 3606             (    forth6809.asm):05046                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E099 CCE0C9           (    forth6809.asm):05047                     LDD   #DOPLUSTEST
E09C 3606             (    forth6809.asm):05048                     PSHU  D
E09E BDE26A           (    forth6809.asm):05049                     JSR   CCALL
E0A1 CC0000           (    forth6809.asm):05050                     LDD   #0
E0A4 3606             (    forth6809.asm):05051                     PSHU  D
E0A6 BDD58F           (    forth6809.asm):05052                     JSR   CODECOMMA
E0A9 DC08             (    forth6809.asm):05053                     LDD   CODEHERE
E0AB 830002           (    forth6809.asm):05054                     SUBD  #2
E0AE 3606             (    forth6809.asm):05055                     PSHU  D                 ; location; the parked dest is beneath
E0B0 BDDE64           (    forth6809.asm):05056                     JSR   PATCH
                      (    forth6809.asm):05057         
E0B3 ECC4             (    forth6809.asm):05058                     LDD   ,U
E0B5 10830007         (    forth6809.asm):05059                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
E0B9 260D             (    forth6809.asm):05060                     BNE   PLOOPDONE
E0BB 3706             (    forth6809.asm):05061                     PULU  D
E0BD 3710             (    forth6809.asm):05062                     PULU  X                 ; ?DO skip operand
E0BF DC08             (    forth6809.asm):05063                     LDD   CODEHERE
E0C1 3606             (    forth6809.asm):05064                     PSHU  D
E0C3 3610             (    forth6809.asm):05065                     PSHU  X
E0C5 BDDE64           (    forth6809.asm):05066                     JSR   PATCH
E0C8 39               (    forth6809.asm):05067         PLOOPDONE:  RTS
                      (    forth6809.asm):05068         
                      (    forth6809.asm):05069         ; ------------------------------------------------------------
                      (    forth6809.asm):05070         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05071         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05072         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05073         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05074         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05075         ;    Inputs:
                      (    forth6809.asm):05076         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05077         ;    Outputs:
                      (    forth6809.asm):05078         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05079         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05080         ;        scratch.
                      (    forth6809.asm):05081         ; ------------------------------------------------------------
E0C9 3706             (    forth6809.asm):05082         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E0CB DD14             (    forth6809.asm):05083                     STD   MSCR              ; MSCR = step
E0CD EC66             (    forth6809.asm):05084                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E0CF 262D             (    forth6809.asm):05085                     BNE   DPTEXIT           ; set: exit
E0D1 EC62             (    forth6809.asm):05086                     LDD   2,S               ; old index
E0D3 A364             (    forth6809.asm):05087                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E0D5 DD16             (    forth6809.asm):05088                     STD   MSCR2
E0D7 EC62             (    forth6809.asm):05089                     LDD   2,S
E0D9 D314             (    forth6809.asm):05090                     ADDD  MSCR              ; new_index = old_index + step
E0DB ED62             (    forth6809.asm):05091                     STD   2,S
E0DD A364             (    forth6809.asm):05092                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E0DF DD18             (    forth6809.asm):05093                     STD   MSCR3
                      (    forth6809.asm):05094                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05095                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05096                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E0E1 DC14             (    forth6809.asm):05097                     LDD   MSCR              ; reload the step to test its sign
E0E3 2B09             (    forth6809.asm):05098                     BMI   DPNEG
E0E5 DC18             (    forth6809.asm):05099         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E0E7 109316           (    forth6809.asm):05100                     CMPD  MSCR2
E0EA 2512             (    forth6809.asm):05101                     BLO   DPTEXIT
E0EC 2007             (    forth6809.asm):05102                     BRA   DPCONT
E0EE DC18             (    forth6809.asm):05103         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E0F0 109316           (    forth6809.asm):05104                     CMPD  MSCR2
E0F3 2209             (    forth6809.asm):05105                     BHI   DPTEXIT
E0F5 3510             (    forth6809.asm):05106         DPCONT:     PULS  X                 ; X = branch operand address
E0F7 EC84             (    forth6809.asm):05107                     LDD   ,X
E0F9 308B             (    forth6809.asm):05108                     LEAX  D,X
E0FB 3410             (    forth6809.asm):05109                     PSHS  X
E0FD 39               (    forth6809.asm):05110                     RTS
E0FE 3510             (    forth6809.asm):05111         DPTEXIT:    PULS  X
E100 3002             (    forth6809.asm):05112                     LEAX  2,X               ; skip the branch operand
E102 3266             (    forth6809.asm):05113                     LEAS  6,S               ; discard the loop frame
E104 3410             (    forth6809.asm):05114                     PSHS  X
E106 39               (    forth6809.asm):05115                     RTS
                      (    forth6809.asm):05116         
                      (    forth6809.asm):05117         ; ------------------------------------------------------------
                      (    forth6809.asm):05118         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05119         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05120         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05121         ; ------------------------------------------------------------
E107 CCE12D           (    forth6809.asm):05122         QDOW:       LDD   #QDOSETUP
E10A 3606             (    forth6809.asm):05123                     PSHU  D
E10C BDE26A           (    forth6809.asm):05124                     JSR   CCALL
E10F CC0000           (    forth6809.asm):05125                     LDD   #0
E112 3606             (    forth6809.asm):05126                     PSHU  D
E114 BDD58F           (    forth6809.asm):05127                     JSR   CODECOMMA
E117 DC08             (    forth6809.asm):05128                     LDD   CODEHERE
E119 830002           (    forth6809.asm):05129                     SUBD  #2
E11C 3606             (    forth6809.asm):05130                     PSHU  D                 ; orig
E11E CC0007           (    forth6809.asm):05131                     LDD   #TAGQDO           ; See bugfix: QDOW.1
E121 3606             (    forth6809.asm):05132                     PSHU  D
E123 DC08             (    forth6809.asm):05133                     LDD   CODEHERE
E125 3606             (    forth6809.asm):05134                     PSHU  D                 ; dest
E127 CC0003           (    forth6809.asm):05135                     LDD   #TAGDO
E12A 3606             (    forth6809.asm):05136                     PSHU  D
E12C 39               (    forth6809.asm):05137                     RTS
                      (    forth6809.asm):05138         
                      (    forth6809.asm):05139         ; ------------------------------------------------------------
                      (    forth6809.asm):05140         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05141         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05142         ; branch operand.
                      (    forth6809.asm):05143         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05144         ;    Inputs:
                      (    forth6809.asm):05145         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05146         ;    Outputs:
                      (    forth6809.asm):05147         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05148         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05149         ; ------------------------------------------------------------
E12D 3706             (    forth6809.asm):05150         QDOSETUP:   PULU  D                 ; index
E12F DD14             (    forth6809.asm):05151                     STD   MSCR
E131 3706             (    forth6809.asm):05152                     PULU  D                 ; limit
E133 DD16             (    forth6809.asm):05153                     STD   MSCR2
E135 3510             (    forth6809.asm):05154                     PULS  X
E137 DC16             (    forth6809.asm):05155                     LDD   MSCR2
E139 109314           (    forth6809.asm):05156                     CMPD  MSCR
E13C 2607             (    forth6809.asm):05157                     BNE   QDBUILD
E13E EC84             (    forth6809.asm):05158                     LDD   ,X
E140 308B             (    forth6809.asm):05159                     LEAX  D,X
E142 3410             (    forth6809.asm):05160                     PSHS  X
E144 39               (    forth6809.asm):05161                     RTS
E145 3002             (    forth6809.asm):05162         QDBUILD:    LEAX  2,X
E147 CC0000           (    forth6809.asm):05163                     LDD   #0
E14A 3406             (    forth6809.asm):05164                     PSHS  D
E14C DC16             (    forth6809.asm):05165                     LDD   MSCR2
E14E 3406             (    forth6809.asm):05166                     PSHS  D
E150 DC14             (    forth6809.asm):05167                     LDD   MSCR
E152 3406             (    forth6809.asm):05168                     PSHS  D
E154 3410             (    forth6809.asm):05169                     PSHS  X
E156 39               (    forth6809.asm):05170                     RTS
                      (    forth6809.asm):05171         
                      (    forth6809.asm):05172         ; ------------------------------------------------------------
                      (    forth6809.asm):05173         ; UNLOOP  ( -- )
                      (    forth6809.asm):05174         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05175         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05176         ; ------------------------------------------------------------
E157 3510             (    forth6809.asm):05177         UNLOOPW:    PULS  X
E159 3266             (    forth6809.asm):05178                     LEAS  6,S
E15B 3410             (    forth6809.asm):05179                     PSHS  X
E15D 39               (    forth6809.asm):05180                     RTS
                      (    forth6809.asm):05181         
                      (    forth6809.asm):05182         ; ------------------------------------------------------------
                      (    forth6809.asm):05183         ; EXIT  ( -- )
                      (    forth6809.asm):05184         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05185         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05186         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05187         ; ------------------------------------------------------------
E15E 108E0000         (    forth6809.asm):05188         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
E162 1F31             (    forth6809.asm):05189                     TFR   U,X               ; X = scan pointer
E164 9C21             (    forth6809.asm):05190         EXSCAN:     CMPX  CSP
E166 270E             (    forth6809.asm):05191                     BEQ   EXSCANDONE
E168 EC84             (    forth6809.asm):05192                     LDD   ,X
E16A 10830003         (    forth6809.asm):05193                     CMPD  #TAGDO
E16E 2602             (    forth6809.asm):05194                     BNE   EXNOTDO
E170 3121             (    forth6809.asm):05195                     LEAY  1,Y
E172 3004             (    forth6809.asm):05196         EXNOTDO:    LEAX  4,X
E174 20EE             (    forth6809.asm):05197                     BRA   EXSCAN
E176                  (    forth6809.asm):05198         EXSCANDONE:
E176 3420             (    forth6809.asm):05199                     PSHS  Y                 ; the count survives CCALL on S
E178 CCE188           (    forth6809.asm):05200                     LDD   #EXITUNLOOP
E17B 3606             (    forth6809.asm):05201                     PSHU  D
E17D BDE26A           (    forth6809.asm):05202                     JSR   CCALL
E180 3506             (    forth6809.asm):05203                     PULS  D
E182 3606             (    forth6809.asm):05204                     PSHU  D
E184 BDD58F           (    forth6809.asm):05205                     JSR   CODECOMMA
E187 39               (    forth6809.asm):05206                     RTS
                      (    forth6809.asm):05207         
                      (    forth6809.asm):05208         ; ------------------------------------------------------------
                      (    forth6809.asm):05209         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05210         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05211         ; EXITUNLOOP
                      (    forth6809.asm):05212         ;    Inputs:
                      (    forth6809.asm):05213         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05214         ;        address
                      (    forth6809.asm):05215         ;    Outputs:
                      (    forth6809.asm):05216         ;        returns to the caller of the definition
                      (    forth6809.asm):05217         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05218         ; ------------------------------------------------------------
E188 3510             (    forth6809.asm):05219         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
E18A 3520             (    forth6809.asm):05220                     PULS  Y                 ; Y = return address
E18C 6EA4             (    forth6809.asm):05221                     JMP   ,Y
                      (    forth6809.asm):05222         
                      (    forth6809.asm):05223         ; ------------------------------------------------------------
                      (    forth6809.asm):05224         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05225         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05226         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05227         ; ------------------------------------------------------------
E18E CC0000           (    forth6809.asm):05228         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
E191 3606             (    forth6809.asm):05229                     PSHU  D
E193 CC0004           (    forth6809.asm):05230                     LDD   #TAGCASE
E196 3606             (    forth6809.asm):05231                     PSHU  D
E198 39               (    forth6809.asm):05232                     RTS
                      (    forth6809.asm):05233         
                      (    forth6809.asm):05234         ; ------------------------------------------------------------
                      (    forth6809.asm):05235         ; OF  ( C: -- orig )
                      (    forth6809.asm):05236         ; Compile OVER = ZBRANCH <operand> DROP. Leave orig (the operand
                      (    forth6809.asm):05237         ; address) and TAGOF.
                      (    forth6809.asm):05238         ; ------------------------------------------------------------
E199 CCE39E           (    forth6809.asm):05239         OFW:        LDD   #OVERW
E19C 3606             (    forth6809.asm):05240                     PSHU  D
E19E BDE26A           (    forth6809.asm):05241                     JSR   CCALL
E1A1 CCE9B8           (    forth6809.asm):05242                     LDD   #EQUALW
E1A4 3606             (    forth6809.asm):05243                     PSHU  D
E1A6 BDE26A           (    forth6809.asm):05244                     JSR   CCALL
E1A9 CCD4F2           (    forth6809.asm):05245                     LDD   #ZBRANCH

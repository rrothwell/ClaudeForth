                      (    forth6809.asm):03669         ; ------------------------------------------------------------
                      (    forth6809.asm):03670         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03671         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03672         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03673         ; FDSEARCH
                      (    forth6809.asm):03674         ;    Inputs:
                      (    forth6809.asm):03675         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03676         ;        RegY = address of the name text
                      (    forth6809.asm):03677         ;        RegB = name length
                      (    forth6809.asm):03678         ;    Outputs:
                      (    forth6809.asm):03679         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03680         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03681         ; ------------------------------------------------------------
D3F1 3424             (    forth6809.asm):03682         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D3F3 8C0000           (    forth6809.asm):03683         FDLOOP:     CMPX  #0
D3F6 2733             (    forth6809.asm):03684                     BEQ   FDRET
D3F8 A684             (    forth6809.asm):03685                     LDA   ,X
D3FA 8540             (    forth6809.asm):03686                     BITA  #$40
D3FC 2620             (    forth6809.asm):03687                     BNE   FDNEXT            ; smudged
D3FE 841F             (    forth6809.asm):03688                     ANDA  #$1F
D400 A1E4             (    forth6809.asm):03689                     CMPA  ,S
D402 261A             (    forth6809.asm):03690                     BNE   FDNEXT
D404 3410             (    forth6809.asm):03691                     PSHS  X                 ; header, kept across the compare
D406 3001             (    forth6809.asm):03692                     LEAX  1,X
D408 10AE63           (    forth6809.asm):03693                     LDY   3,S               ; name text
D40B E662             (    forth6809.asm):03694                     LDB   2,S               ; length
D40D 2709             (    forth6809.asm):03695                     BEQ   FDHIT
D40F A680             (    forth6809.asm):03696         FDCMP:      LDA   ,X+
D411 A1A0             (    forth6809.asm):03697                     CMPA  ,Y+
D413 2607             (    forth6809.asm):03698                     BNE   FDMISS
D415 5A               (    forth6809.asm):03699                     DECB
D416 26F7             (    forth6809.asm):03700                     BNE   FDCMP
D418 3510             (    forth6809.asm):03701         FDHIT:      PULS  X                 ; header
D41A 200F             (    forth6809.asm):03702                     BRA   FDRET
D41C 3510             (    forth6809.asm):03703         FDMISS:     PULS  X
D41E E684             (    forth6809.asm):03704         FDNEXT:     LDB   ,X
D420 C41F             (    forth6809.asm):03705                     ANDB  #$1F
D422 4F               (    forth6809.asm):03706                     CLRA
D423 3001             (    forth6809.asm):03707                     LEAX  1,X
D425 308B             (    forth6809.asm):03708                     LEAX  D,X
D427 AE84             (    forth6809.asm):03709                     LDX   ,X                ; LINK field
D429 20C8             (    forth6809.asm):03710                     BRA   FDLOOP
D42B 3263             (    forth6809.asm):03711         FDRET:      LEAS  3,S
D42D 39               (    forth6809.asm):03712                     RTS
                      (    forth6809.asm):03713         
                      (    forth6809.asm):03714         ; ------------------------------------------------------------
                      (    forth6809.asm):03715         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03716         ; ROOT, for a name.
                      (    forth6809.asm):03717         ; SRCHORD
                      (    forth6809.asm):03718         ;    Inputs:
                      (    forth6809.asm):03719         ;        RegY = address of the name text
                      (    forth6809.asm):03720         ;        RegB = name length
                      (    forth6809.asm):03721         ;    Outputs:
                      (    forth6809.asm):03722         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03723         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03724         ; ------------------------------------------------------------
D42E 3424             (    forth6809.asm):03725         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D430 8E004B           (    forth6809.asm):03726                     LDX   #ORDER
D433 3410             (    forth6809.asm):03727                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D435 AEE4             (    forth6809.asm):03728         SOLOOP:     LDX   ,S
D437 9C49             (    forth6809.asm):03729                     CMPX  ORDEND
D439 2415             (    forth6809.asm):03730                     BHS   SOROOT
D43B 10AE81           (    forth6809.asm):03731                     LDY   ,X++              ; WID
D43E AFE4             (    forth6809.asm):03732                     STX   ,S
D440 AEA4             (    forth6809.asm):03733                     LDX   ,Y                ; newest header of that wordlist
D442 10AE63           (    forth6809.asm):03734                     LDY   3,S
D445 E662             (    forth6809.asm):03735                     LDB   2,S
D447 8DA8             (    forth6809.asm):03736                     BSR   FDSEARCH
D449 8C0000           (    forth6809.asm):03737                     CMPX  #0
D44C 27E7             (    forth6809.asm):03738                     BEQ   SOLOOP
D44E 2009             (    forth6809.asm):03739                     BRA   SORDONE
D450 9E5D             (    forth6809.asm):03740         SOROOT:     LDX   WLHEADS+2         ; ROOT
D452 10AE63           (    forth6809.asm):03741                     LDY   3,S
D455 E662             (    forth6809.asm):03742                     LDB   2,S
D457 8D98             (    forth6809.asm):03743                     BSR   FDSEARCH
D459 3265             (    forth6809.asm):03744         SORDONE:    LEAS  5,S
D45B 39               (    forth6809.asm):03745                     RTS
                      (    forth6809.asm):03746         
                      (    forth6809.asm):03747         ; ------------------------------------------------------------
                      (    forth6809.asm):03748         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03749         ; HDRXT
                      (    forth6809.asm):03750         ;    Inputs:
                      (    forth6809.asm):03751         ;        RegX = header
                      (    forth6809.asm):03752         ;    Outputs:
                      (    forth6809.asm):03753         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03754         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03755         ; ------------------------------------------------------------
D45C A684             (    forth6809.asm):03756         HDRXT:      LDA   ,X
D45E 1F89             (    forth6809.asm):03757                     TFR   A,B
D460 C41F             (    forth6809.asm):03758                     ANDB  #$1F
D462 3001             (    forth6809.asm):03759                     LEAX  1,X
D464 3A               (    forth6809.asm):03760                     ABX
D465 AE02             (    forth6809.asm):03761                     LDX   2,X               ; CFA field
D467 39               (    forth6809.asm):03762                     RTS
                      (    forth6809.asm):03763         
                      (    forth6809.asm):03764         ; ------------------------------------------------------------
                      (    forth6809.asm):03765         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03766         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03767         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03768         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03769         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03770         ; ------------------------------------------------------------
D468 10AEC4           (    forth6809.asm):03771         FINDW:      LDY   ,U                ; counted string
D46B E6A0             (    forth6809.asm):03772                     LDB   ,Y+
D46D 8DBF             (    forth6809.asm):03773                     BSR   SRCHORD
D46F 8C0000           (    forth6809.asm):03774                     CMPX  #0
D472 2712             (    forth6809.asm):03775                     BEQ   NOTFOUND
D474 8DE6             (    forth6809.asm):03776                     BSR   HDRXT
D476 AFC4             (    forth6809.asm):03777                     STX   ,U                ; xt replaces c-addr
D478 4D               (    forth6809.asm):03778                     TSTA
D479 2A05             (    forth6809.asm):03779                     BPL   FISNORM
D47B CC0001           (    forth6809.asm):03780                     LDD   #1
D47E 2003             (    forth6809.asm):03781                     BRA   FPUSH
D480 CCFFFF           (    forth6809.asm):03782         FISNORM:    LDD   #-1
D483 3606             (    forth6809.asm):03783         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D485 39               (    forth6809.asm):03784                     RTS
                      (    forth6809.asm):03785         
D486 CC0000           (    forth6809.asm):03786         NOTFOUND:   LDD   #0
D489 3606             (    forth6809.asm):03787                     PSHU  D                 ; 0 = not found, c-addr still beneath
D48B 39               (    forth6809.asm):03788                     RTS
                      (    forth6809.asm):03789         
                      (    forth6809.asm):03790         ; ------------------------------------------------------------
                      (    forth6809.asm):03791         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03792         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03793         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03794         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03795         ; ------------------------------------------------------------
D48C 3710             (    forth6809.asm):03796         SEARCHWLW:  PULU  X                 ; wid
D48E 8D2D             (    forth6809.asm):03797                     BSR   WIDCHK
D490 AE84             (    forth6809.asm):03798                     LDX   ,X                ; newest header of the wordlist
D492 3706             (    forth6809.asm):03799                     PULU  D                 ; u
D494 3720             (    forth6809.asm):03800                     PULU  Y                 ; c-addr
D496 4D               (    forth6809.asm):03801                     TSTA
D497 261E             (    forth6809.asm):03802                     BNE   SWNOT             ; longer than any name
D499 C11F             (    forth6809.asm):03803                     CMPB  #31
D49B 221A             (    forth6809.asm):03804                     BHI   SWNOT
D49D BDD3F1           (    forth6809.asm):03805                     JSR   FDSEARCH
D4A0 8C0000           (    forth6809.asm):03806                     CMPX  #0
D4A3 2712             (    forth6809.asm):03807                     BEQ   SWNOT
D4A5 8DB5             (    forth6809.asm):03808                     BSR   HDRXT
D4A7 3610             (    forth6809.asm):03809                     PSHU  X                 ; xt
D4A9 4D               (    forth6809.asm):03810                     TSTA
D4AA 2A05             (    forth6809.asm):03811                     BPL   SWNORM
D4AC CC0001           (    forth6809.asm):03812                     LDD   #1
D4AF 2003             (    forth6809.asm):03813                     BRA   SWPUSH
D4B1 CCFFFF           (    forth6809.asm):03814         SWNORM:     LDD   #-1
D4B4 3606             (    forth6809.asm):03815         SWPUSH:     PSHU  D
D4B6 39               (    forth6809.asm):03816                     RTS
D4B7 CC0000           (    forth6809.asm):03817         SWNOT:      LDD   #0
D4BA 3606             (    forth6809.asm):03818                     PSHU  D
D4BC 39               (    forth6809.asm):03819                     RTS
                      (    forth6809.asm):03820         
                      (    forth6809.asm):03821         ; ------------------------------------------------------------
                      (    forth6809.asm):03822         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03823         ; WIDCHK
                      (    forth6809.asm):03824         ;    Inputs:
                      (    forth6809.asm):03825         ;        RegX = candidate WID
                      (    forth6809.asm):03826         ;    Outputs:
                      (    forth6809.asm):03827         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03828         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
D4BD 1F10             (    forth6809.asm):03830         WIDCHK:     TFR   X,D
D4BF 83005B           (    forth6809.asm):03831                     SUBD  #WLHEADS
D4C2 2509             (    forth6809.asm):03832                     BCS   WIDBAD
D4C4 C501             (    forth6809.asm):03833                     BITB  #1
D4C6 2605             (    forth6809.asm):03834                     BNE   WIDBAD
D4C8 9C45             (    forth6809.asm):03835                     CMPX  WLEND
D4CA 2401             (    forth6809.asm):03836                     BHS   WIDBAD
D4CC 39               (    forth6809.asm):03837                     RTS
D4CD CCFFF5           (    forth6809.asm):03838         WIDBAD:     LDD   #-11
D4D0 3606             (    forth6809.asm):03839                     PSHU  D
D4D2 7ED905           (    forth6809.asm):03840                     JMP   THROWW
                      (    forth6809.asm):03841         
                      (    forth6809.asm):03842         ; ------------------------------------------------------------
                      (    forth6809.asm):03843         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03844         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03845         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03846         ; WLINIT
                      (    forth6809.asm):03847         ;    Inputs:
                      (    forth6809.asm):03848         ;        none
                      (    forth6809.asm):03849         ;    Outputs:
                      (    forth6809.asm):03850         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03851         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03852         ; ------------------------------------------------------------
D4D5 CCCDFA           (    forth6809.asm):03853         WLINIT:     LDD   #BASELATEST
D4D8 DD5B             (    forth6809.asm):03854                     STD   WLHEADS
D4DA CCC4CB           (    forth6809.asm):03855                     LDD   #BASEROOTLATEST
D4DD DD5D             (    forth6809.asm):03856                     STD   WLHEADS+2
D4DF CCC4CB           (    forth6809.asm):03857                     LDD   #H_FORTH
D4E2 DD6F             (    forth6809.asm):03858                     STD   WLNAMES
D4E4 CCC4C2           (    forth6809.asm):03859                     LDD   #H_ROOT
D4E7 DD71             (    forth6809.asm):03860                     STD   WLNAMES+2
D4E9 CC005F           (    forth6809.asm):03861                     LDD   #WLHEADS+4
D4EC DD45             (    forth6809.asm):03862                     STD   WLEND
D4EE CC005B           (    forth6809.asm):03863                     LDD   #WLHEADS
D4F1 DD47             (    forth6809.asm):03864                     STD   CURRENT
D4F3 7ED5C3           (    forth6809.asm):03865                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03866         
                      (    forth6809.asm):03867         ; ------------------------------------------------------------
                      (    forth6809.asm):03868         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03869         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03870         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03871         ; PRUNE
                      (    forth6809.asm):03872         ;    Inputs:
                      (    forth6809.asm):03873         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03874         ;    Outputs:
                      (    forth6809.asm):03875         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03876         ;        into ROM
                      (    forth6809.asm):03877         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03878         ; ------------------------------------------------------------
D4F6 3406             (    forth6809.asm):03879         PRUNE:      PSHS  D                 ; 0,S = mark
D4F8 8E005B           (    forth6809.asm):03880                     LDX   #WLHEADS
D4FB 9C45             (    forth6809.asm):03881         PRLOOP:     CMPX  WLEND
D4FD 2421             (    forth6809.asm):03882                     BHS   PRNDONE
D4FF 10AE84           (    forth6809.asm):03883                     LDY   ,X                ; newest header of this wordlist
D502 108CC000         (    forth6809.asm):03884         PRWALK:     CMPY  #ROMSTRT
D506 2413             (    forth6809.asm):03885                     BHS   PRSTORE           ; ROM header: keep
D508 10ACE4           (    forth6809.asm):03886                     CMPY  ,S
D50B 250E             (    forth6809.asm):03887                     BLO   PRSTORE           ; below the mark (or empty): keep
D50D E6A4             (    forth6809.asm):03888                     LDB   ,Y
D50F C41F             (    forth6809.asm):03889                     ANDB  #$1F
D511 4F               (    forth6809.asm):03890                     CLRA
D512 3121             (    forth6809.asm):03891                     LEAY  1,Y
D514 31AB             (    forth6809.asm):03892                     LEAY  D,Y
D516 10AEA4           (    forth6809.asm):03893                     LDY   ,Y                ; follow the LINK
D519 20E7             (    forth6809.asm):03894                     BRA   PRWALK
D51B 10AF81           (    forth6809.asm):03895         PRSTORE:    STY   ,X++
D51E 20DB             (    forth6809.asm):03896                     BRA   PRLOOP
D520 3262             (    forth6809.asm):03897         PRNDONE:     LEAS  2,S
D522 39               (    forth6809.asm):03898                     RTS
                      (    forth6809.asm):03899         
                      (    forth6809.asm):03900         ; ============================================================
                      (    forth6809.asm):03901         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03902         ; ============================================================
                      (    forth6809.asm):03903         ; ------------------------------------------------------------
                      (    forth6809.asm):03904         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03905         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03906         ; ------------------------------------------------------------
D523 9E45             (    forth6809.asm):03907         WORDLISTW:  LDX   WLEND
D525 8C006F           (    forth6809.asm):03908                     CMPX  #WLHEADS+2*WLCELLS
D528 240F             (    forth6809.asm):03909                     BHS   WLFULL
D52A CC0000           (    forth6809.asm):03910                     LDD   #0
D52D ED84             (    forth6809.asm):03911                     STD   ,X
D52F ED8814           (    forth6809.asm):03912                     STD   WLNOFF,X
D532 3610             (    forth6809.asm):03913                     PSHU  X
D534 3002             (    forth6809.asm):03914                     LEAX  2,X
D536 9F45             (    forth6809.asm):03915                     STX   WLEND
D538 39               (    forth6809.asm):03916                     RTS
D539 CCFFF8           (    forth6809.asm):03917         WLFULL:     LDD   #-8
D53C 3606             (    forth6809.asm):03918                     PSHU  D
D53E 7ED905           (    forth6809.asm):03919                     JMP   THROWW
                      (    forth6809.asm):03920         
                      (    forth6809.asm):03921         ; ------------------------------------------------------------
                      (    forth6809.asm):03922         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03923         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03924         ; ------------------------------------------------------------
D541 CC005B           (    forth6809.asm):03925         FORTHWLW:   LDD   #WLHEADS
D544 3606             (    forth6809.asm):03926                     PSHU  D
D546 39               (    forth6809.asm):03927                     RTS
                      (    forth6809.asm):03928         
                      (    forth6809.asm):03929         ; ------------------------------------------------------------
                      (    forth6809.asm):03930         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03931         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03932         ; it, as it is always searched last.
                      (    forth6809.asm):03933         ; ------------------------------------------------------------
D547 9E49             (    forth6809.asm):03934         GETORDERW:  LDX   ORDEND
D549 8C004B           (    forth6809.asm):03935         GOLOOP:     CMPX  #ORDER
D54C 2306             (    forth6809.asm):03936                     BLS   GODONE
D54E EC83             (    forth6809.asm):03937                     LDD   ,--X
D550 3606             (    forth6809.asm):03938                     PSHU  D
D552 20F5             (    forth6809.asm):03939                     BRA   GOLOOP
D554 DC49             (    forth6809.asm):03940         GODONE:     LDD   ORDEND
D556 83004B           (    forth6809.asm):03941                     SUBD  #ORDER
D559 44               (    forth6809.asm):03942                     LSRA
D55A 56               (    forth6809.asm):03943                     RORB
D55B 3606             (    forth6809.asm):03944                     PSHU  D                 ; n
D55D 39               (    forth6809.asm):03945                     RTS
                      (    forth6809.asm):03946         
                      (    forth6809.asm):03947         ; ------------------------------------------------------------
                      (    forth6809.asm):03948         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03949         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03950         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03951         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03952         ; ------------------------------------------------------------
D55E 3706             (    forth6809.asm):03953         SETORDERW:  PULU  D                 ; n
D560 1083FFFF         (    forth6809.asm):03954                     CMPD  #-1
D564 275D             (    forth6809.asm):03955                     BEQ   ONLYW             ; the minimum order
D566 4D               (    forth6809.asm):03956         SO1:        TSTA
D567 2B31             (    forth6809.asm):03957                     BMI   SOUNDER
D569 262A             (    forth6809.asm):03958                     BNE   SOOVER
D56B C108             (    forth6809.asm):03959                     CMPB  #WLMAX
D56D 2226             (    forth6809.asm):03960                     BHI   SOOVER
D56F 3404             (    forth6809.asm):03961                     PSHS  B                 ; 1,S = n
D571 3404             (    forth6809.asm):03962                     PSHS  B                 ; 0,S = count down
D573 1F32             (    forth6809.asm):03963                     TFR   U,Y
D575 6DE4             (    forth6809.asm):03964         SOCHK:      TST   ,S
D577 2709             (    forth6809.asm):03965                     BEQ   SOCOPY
D579 AEA1             (    forth6809.asm):03966                     LDX   ,Y++
D57B BDD4BD           (    forth6809.asm):03967                     JSR   WIDCHK            ; keeps Y
D57E 6AE4             (    forth6809.asm):03968                     DEC   ,S
D580 20F3             (    forth6809.asm):03969                     BRA   SOCHK

                      (    forth6809.asm):05205                                  ; own flags from the PULU above - and PULU
                      (    forth6809.asm):05206                                  ; doesn't set flags on genuine 6809 anyway
                      (    forth6809.asm):05207                                  ; (same class as TRYNUM/STOD/SIGN's own fixes

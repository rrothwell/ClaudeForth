C18F                  (    forth6809.asm):02218         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):02219                    PSHU  X
                      (    forth6809.asm):02220                    PSHU  D
                      (    forth6809.asm):02221                    JSR   TSTREPORT
                      (    forth6809.asm):02222         

                      (    forth6809.asm):06490         ; ------------------------------------------------------------
F3DF CC0020           (    forth6809.asm):06491         BLANKW:     LDD   #32
F3E2 3606             (    forth6809.asm):06492                     PSHU  D
F3E4 7EF3C1           (    forth6809.asm):06493                     JMP   FILLW
                      (    forth6809.asm):06494         

                      (    forth6809.asm):11941         ; TSTMOVE3 - unit test for MOVE, overlapping case with dst <
                      (    forth6809.asm):11942         ; src (dst = TSTCBUF, src = TSTCBUF+2, 5 bytes - a 2-byte
                      (    forth6809.asm):11943         ; backward shift). MOVE delegates to plain CMOVE (low-to-high)
                      (    forth6809.asm):11944         ; whenever dst < src, avoiding the mirror-image corruption a
                      (    forth6809.asm):11945         ; naive high-to-low copy would cause here. Expected result
                      (    forth6809.asm):11946         ; hand-derived and independently simulated before writing:
                      (    forth6809.asm):11947         ; "ABCDEDE" across bytes 0-6 (bytes 5-6 untouched, outside the
                      (    forth6809.asm):11948         ; destination range).
                      (    forth6809.asm):11949         ; ------------------------------------------------------------

                      (    forth6809.asm):06803                  PSHU  D
                      (    forth6809.asm):06804                  JSR   CCALL
                      (    forth6809.asm):06805         
                      (    forth6809.asm):06806                  LDD   #PLUS
                      (    forth6809.asm):06807                  PSHU  D
                      (    forth6809.asm):06808                  JSR   CCALL
                      (    forth6809.asm):06809         
                      (    forth6809.asm):06810                  JSR   LOOP
                      (    forth6809.asm):06811         

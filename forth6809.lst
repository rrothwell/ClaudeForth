                      (    forth6809.asm):11323         
                      (    forth6809.asm):11324                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):11325                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):11326                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):11327                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):11328                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):11329                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):11330                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):11331                   ; high cell.
E5C3 0D22             (    forth6809.asm):11332                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):11333                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):11334                   LDD   UDLO
E5C9 43               (    forth6809.asm):11335                   COMA
E5CA 53               (    forth6809.asm):11336                   COMB
E5CB C30001           (    forth6809.asm):11337                   ADDD  #1
E5CE DD76             (    forth6809.asm):11338                   STD   UDLO
E5D0 3401             (    forth6809.asm):11339                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):11340                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):11341                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):11342                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):11343                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):11344                                      ; silently overwrote the real carry here
                      (    forth6809.asm):11345                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):11346                                      ; making the high-cell increment run
                      (    forth6809.asm):11347                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):11348                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):11349                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):11350                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):11351                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):11352                                      ; matching "always increment" rather than
                      (    forth6809.asm):11353                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):11354                   LDD   UDHI
E5D4 43               (    forth6809.asm):11355                   COMA
E5D5 53               (    forth6809.asm):11356                   COMB
E5D6 3501             (    forth6809.asm):11357                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):11358                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):11359                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):11360                                      ; when there's no carry - the complemented
                      (    forth6809.asm):11361                                      ; value was computed in D but never
                      (    forth6809.asm):11362                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):11363                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):11364                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):11365                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):11366                                      ; was always seen as set, so this branch
                      (    forth6809.asm):11367                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):11368                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):11369                                      ; alone would have made this second,
                      (    forth6809.asm):11370                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):11371                                      ; only past the "+1", never past the
                      (    forth6809.asm):11372                                      ; store itself - the store always runs,
                      (    forth6809.asm):11373                                      ; either way.
E5DA C30001           (    forth6809.asm):11374                   ADDD  #1
E5DD DD74             (    forth6809.asm):11375         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):11376         
E5DF                  (    forth6809.asm):11377         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):11378                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):11379                   LDX   CADDR
E5E1 E684             (    forth6809.asm):11380                   LDB   ,X
E5E3 5A               (    forth6809.asm):11381                   DECB
E5E4 3001             (    forth6809.asm):11382                   LEAX  1,X
E5E6 A685             (    forth6809.asm):11383                   LDA   B,X
E5E8 812E             (    forth6809.asm):11384                   CMPA  #'.'
E5EA 260E             (    forth6809.asm):11385                   BNE   NQSINGLE
                      (    forth6809.asm):11386         

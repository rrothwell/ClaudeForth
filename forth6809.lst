                      (    forth6809.asm):12789         ; ------------------------------------------------------------
                      (    forth6809.asm):12790         ; TSTDOTQUOTE - unit test for .". No STATE check at all in its
                      (    forth6809.asm):12791         ; own code (confirmed by reading it directly - matches "no
                      (    forth6809.asm):12792         ; interpretation semantics, per ANS" without a specific -14
                      (    forth6809.asm):12793         ; throw, unlike [CHAR]/S"), so only the compiling case is
                      (    forth6809.asm):12794         ; tested, matching how it's actually meant to be used. Its own
                      (    forth6809.asm):12795         ; runtime (DOTSTR) calls TYPE internally, which has two entirely
                      (    forth6809.asm):12796         ; different implementations gated by SERIALPOLL (the same real
                      (    forth6809.asm):12797         ; finding from section 3.1) - applying that lesson from the
                      (    forth6809.asm):12798         ; start here rather than re-discovering it: EMITCH works
                      (    forth6809.asm):12799         ; universally for a single-character check, but this outputs
                      (    forth6809.asm):12800         ; multiple characters, so - matching TSTCR's own established
                      (    forth6809.asm):12801         ; fix - the full OUTHEAD/OUTBUF check only applies under
                      (    forth6809.asm):12802         ; SERIALPOLL=0, with a narrower EMITCH-based check (last
                      (    forth6809.asm):12803         ; character only, plus the stack-depth check) for SERIALPOLL=1.
                      (    forth6809.asm):12804         ; ------------------------------------------------------------
C2B1                  (    forth6809.asm):12805         TSTDOTQUOTE: LDD  CODEHERE
                      (    forth6809.asm):12806                      STD  TSTCSAV
                      (    forth6809.asm):12807                      LDD  SRCADDR
                      (    forth6809.asm):12808                      STD  TSTSASAV
                      (    forth6809.asm):12809                      LDD  SRCLEN
                      (    forth6809.asm):12810                      STD  TSTSLSAV
                      (    forth6809.asm):12811                      LDD  TOIN
                      (    forth6809.asm):12812                      STD  TSTTISAV
                      (    forth6809.asm):12813         
                      (    forth6809.asm):12814                      LDA  #'H'
                      (    forth6809.asm):12815                      STA  TSTNAMEB
                      (    forth6809.asm):12816                      LDA  #'I'
                      (    forth6809.asm):12817                      STA  TSTNAMEB+1
                      (    forth6809.asm):12818                      LDA  #34
                      (    forth6809.asm):12819                      STA  TSTNAMEB+2
                      (    forth6809.asm):12820         
                      (    forth6809.asm):12821                      LDD  #TSTCBUF
                      (    forth6809.asm):12822                      STD  CODEHERE
                      (    forth6809.asm):12823                      LDD  #TSTNAMEB
                      (    forth6809.asm):12824                      STD  SRCADDR
                      (    forth6809.asm):12825                      LDD  #3
                      (    forth6809.asm):12826                      STD  SRCLEN
                      (    forth6809.asm):12827                      LDD  #0
                      (    forth6809.asm):12828                      STD  TOIN
                      (    forth6809.asm):12829         
                      (    forth6809.asm):12830                      JSR  DOTQUOTE
                      (    forth6809.asm):12831         
                      (    forth6809.asm):12832                      LDD  #OPRTS
                      (    forth6809.asm):12833                      PSHU D
                      (    forth6809.asm):12834                      JSR  CCOMMA
                      (    forth6809.asm):12835         
                      (    forth6809.asm):12836                      LDD  TSTCSAV
                      (    forth6809.asm):12837                      STD  CODEHERE
                      (    forth6809.asm):12838                      LDD  TSTSASAV
                      (    forth6809.asm):12839                      STD  SRCADDR
                      (    forth6809.asm):12840                      LDD  TSTSLSAV
                      (    forth6809.asm):12841                      STD  SRCLEN
                      (    forth6809.asm):12842                      LDD  TSTTISAV
                      (    forth6809.asm):12843                      STD  TOIN
                      (    forth6809.asm):12844         
                      (    forth6809.asm):12845                      IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):12846                      LDA  OUTHEAD
                      (    forth6809.asm):12847                      STA  TSTOHSAV
                      (    forth6809.asm):12848                      ENDC ; <<<<
                      (    forth6809.asm):12849         
                      (    forth6809.asm):12850                      STU  TSTU0
                      (    forth6809.asm):12851         
                      (    forth6809.asm):12852                      LDD  #TSTGUARD
                      (    forth6809.asm):12853                      PSHU D
                      (    forth6809.asm):12854                      STU  TSTUB4
                      (    forth6809.asm):12855         
                      (    forth6809.asm):12856                      LDX  #TSTCBUF
                      (    forth6809.asm):12857                      JSR  ,X
                      (    forth6809.asm):12858         
                      (    forth6809.asm):12859                      STU  TSTUAF
                      (    forth6809.asm):12860         
                      (    forth6809.asm):12861                      IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):12862                      LDA  TSTOHSAV
                      (    forth6809.asm):12863                      ADDA #2
                      (    forth6809.asm):12864                      ANDA #OUTBUFSZ-1
                      (    forth6809.asm):12865                      CMPA OUTHEAD
                      (    forth6809.asm):12866                      BNE  DXFAIL
                      (    forth6809.asm):12867         
                      (    forth6809.asm):12868                      LDX  #OUTBUF
                      (    forth6809.asm):12869                      LDB  TSTOHSAV
                      (    forth6809.asm):12870                      LDA  B,X
                      (    forth6809.asm):12871                      CMPA #'H'
                      (    forth6809.asm):12872                      BNE  DXFAIL
                      (    forth6809.asm):12873                      INCB
                      (    forth6809.asm):12874                      ANDB #OUTBUFSZ-1
                      (    forth6809.asm):12875                      LDA  B,X
                      (    forth6809.asm):12876                      CMPA #'I'
                      (    forth6809.asm):12877                      BNE  DXFAIL
                      (    forth6809.asm):12878                      ELSE  ; <<<<>>>>
                      (    forth6809.asm):12879                      LDA  EMITCH
                      (    forth6809.asm):12880                      CMPA #'I'
                      (    forth6809.asm):12881                      BNE  DXFAIL
                      (    forth6809.asm):12882                      ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):12883         
                      (    forth6809.asm):12884                      PULU D
                      (    forth6809.asm):12885                      CMPD #TSTGUARD
                      (    forth6809.asm):12886                      BNE  DXFAIL
                      (    forth6809.asm):12887         
                      (    forth6809.asm):12888                      LDD  TSTUB4
                      (    forth6809.asm):12889                      SUBD TSTUAF
                      (    forth6809.asm):12890                      CMPD #0
                      (    forth6809.asm):12891                      BNE  DXFAIL
                      (    forth6809.asm):12892         
                      (    forth6809.asm):12893                      LDD  #TRUEV
                      (    forth6809.asm):12894                      BRA  DXDONE
C2B1                  (    forth6809.asm):12895         DXFAIL:      LDD  #FALSEV
C2B1                  (    forth6809.asm):12896         DXDONE:      LDX  #TSTDQNAME
                      (    forth6809.asm):12897                      PSHU X
                      (    forth6809.asm):12898                      PSHU D
                      (    forth6809.asm):12899                      JSR  TSTREPORT
                      (    forth6809.asm):12900         
                      (    forth6809.asm):12901                      LDU  TSTU0
                      (    forth6809.asm):12902                      RTS
                      (    forth6809.asm):12903         
C2B1                  (    forth6809.asm):12904         TSTDQNAME: FCB  11
                      (    forth6809.asm):12905                    FCC  "TSTDOTQUOTE"
                      (    forth6809.asm):12906         
                      (    forth6809.asm):12907         ; ------------------------------------------------------------
                      (    forth6809.asm):12908         ; TSTSCOMPARE - unit test for COMPARE. Four sequential sub-cases
                      (    forth6809.asm):12909         ; within one test body, each popping and verifying its own
                      (    forth6809.asm):12910         ; result immediately: less-than, equal, greater-than, and the
                      (    forth6809.asm):12911         ; prefix tie-break case specifically (a shorter string that's a
                      (    forth6809.asm):12912         ; true prefix of a longer one compares less, per the standard
                      (    forth6809.asm):12913         ; three-way convention) - not just LT/EQ/GT on same-length
                      (    forth6809.asm):12914         ; strings, which alone wouldn't exercise the tie-break path at
                      (    forth6809.asm):12915         ; all.
                      (    forth6809.asm):12916         ; ------------------------------------------------------------
C2B1                  (    forth6809.asm):12917         TSTSCOMPARE: LDA  #'A'
                      (    forth6809.asm):12918                     STA  TSTCBUF
                      (    forth6809.asm):12919                     LDA  #'B'
                      (    forth6809.asm):12920                     STA  TSTCBUF+1

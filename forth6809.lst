                      (    forth6809.asm):03234         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03235         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03236         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03237         ;    Inputs:
                      (    forth6809.asm):03238         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03239         ;    Outputs:
                      (    forth6809.asm):03240         ;        single number: n and -1
                      (    forth6809.asm):03241         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03242         ;        not a number: c-addr and 0
                      (    forth6809.asm):03243         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03244         ; ------------------------------------------------------------
E4CA 3710             (    forth6809.asm):03245         NUMBERQ:    PULU  X                 ; c-addr
E4CC 9F1F             (    forth6809.asm):03246                     STX   CADDR
E4CE A684             (    forth6809.asm):03247                     LDA   ,X
E4D0 2772             (    forth6809.asm):03248                     BEQ   NQBAD
E4D2 9721             (    forth6809.asm):03249                     STA   CNTREM
E4D4 3001             (    forth6809.asm):03250                     LEAX  1,X
                      (    forth6809.asm):03251         
                      (    forth6809.asm):03252                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03253                     ; digit count. See shadow: NUMBERQ.1
E4D6 D621             (    forth6809.asm):03254                     LDB   CNTREM
E4D8 5A               (    forth6809.asm):03255                     DECB
E4D9 A685             (    forth6809.asm):03256                     LDA   B,X
E4DB 812E             (    forth6809.asm):03257                     CMPA  #'.'
E4DD 2604             (    forth6809.asm):03258                     BNE   NQNOSIGN
E4DF 0A21             (    forth6809.asm):03259                     DEC   CNTREM
E4E1 2761             (    forth6809.asm):03260                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03261         
E4E3 0F22             (    forth6809.asm):03262         NQNOSIGN:   CLR   NUMNEG
E4E5 A684             (    forth6809.asm):03263                     LDA   ,X
E4E7 812D             (    forth6809.asm):03264                     CMPA  #'-'
E4E9 2608             (    forth6809.asm):03265                     BNE   NQNOSIGN2
E4EB 0322             (    forth6809.asm):03266                     COM   NUMNEG
E4ED 3001             (    forth6809.asm):03267                     LEAX  1,X
E4EF 0A21             (    forth6809.asm):03268                     DEC   CNTREM
E4F1 2751             (    forth6809.asm):03269                     BEQ   NQBAD
                      (    forth6809.asm):03270         

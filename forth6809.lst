                      (    forth6809.asm):04011         ; ------------------------------------------------------------
                      (    forth6809.asm):04012         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):04013         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):04014         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):04015         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):04016         ; either is safe to call from ACCEPT at any point without
                      (    forth6809.asm):04017         ; disturbing whatever's on U. See ACCEPT for where these are
                      (    forth6809.asm):04018         ; called: XON at the start of every line (the host may stream
                      (    forth6809.asm):04019         ; characters continuously while ACCEPT's own tight loop is
                      (    forth6809.asm):04020         ; polling), XOFF the instant a line is complete (CR seen), before
                      (    forth6809.asm):04021         ; handing off to INTERPRET/compilation - which does arbitrary,
                      (    forth6809.asm):04022         ; variable-length work with KEY never polled at all, exactly the
                      (    forth6809.asm):04023         ; window where a host that kept sending would build up a backlog
                      (    forth6809.asm):04024         ; this polling build (with no ring buffer to hold it) has no way
                      (    forth6809.asm):04025         ; to recover from correctly.
                      (    forth6809.asm):04026         ; ------------------------------------------------------------

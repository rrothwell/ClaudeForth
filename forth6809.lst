F4B1 1F02             (    forth6809.asm):06478                     TFR   D,Y               ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):06479                                             ; iteration - and inside the loop, LDA
                      (    forth6809.asm):06480                                             ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):06481                                             ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):06482                                             ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):06483                                             ; The high byte took on the fill character's
                      (    forth6809.asm):06484                                             ; value instead of the count's real high
                      (    forth6809.asm):06485                                             ; byte, so the count almost never reached
                      (    forth6809.asm):06486                                             ; zero at the intended point - FILL ran far
                      (    forth6809.asm):06487                                             ; past the requested length. Keeping the
                      (    forth6809.asm):06488                                             ; count in Y instead removes the conflict
                      (    forth6809.asm):06489                                             ; entirely (Y is untouched by loading the
                      (    forth6809.asm):06490                                             ; fill character into A) and removes the
                      (    forth6809.asm):06491                                             ; per-iteration memory round-trip - also
                      (    forth6809.asm):06492                                             ; addresses the redundant scratch usage
                      (    forth6809.asm):06493                                             ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):06494                                             ; MAME debugger.
F4B3 3706             (    forth6809.asm):06495                     PULU  D
F4B5 1F01             (    forth6809.asm):06496                     TFR   D,X               ; address, kept directly in X rather than
                      (    forth6809.asm):06497                                             ; round-tripping through FILLADDR too

                      (   unit_tests.asm):00406         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (   unit_tests.asm):00407         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (   unit_tests.asm):00408         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (   unit_tests.asm):00409         ; power of two) and that the queued byte at the old OUTHEAD
                      (   unit_tests.asm):00410         ; position genuinely matches the character emitted - not just
                      (   unit_tests.asm):00411         ; that the call returned.
                      (   unit_tests.asm):00412         ; ------------------------------------------------------------

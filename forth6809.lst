FFF2 DE78             (    forth6809.asm):08117         VSWI3       FDB   SWI3H             ; SWI3
FFF4 DE79             (    forth6809.asm):08118         VSWI2       FDB   SWI2H             ; SWI2
FFF6 DE7A             (    forth6809.asm):08119         VFIRQ       FDB   FIRQH             ; FIRQ
FFF8 DE0F             (    forth6809.asm):08120         VIRQ        FDB   IRQH              ; IRQ
FFFA DE7C             (    forth6809.asm):08121         VSWI        FDB   SWIH              ; SWI

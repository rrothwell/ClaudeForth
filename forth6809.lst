                      (    forth6809.asm):05718         ; ============================================================
                      (    forth6809.asm):05719         ; SECTION 14: STACK MANIPULATION (Core + Core Ext + return stack)
                      (    forth6809.asm):05720         ; ============================================================
                      (    forth6809.asm):05721         ; ------------------------------------------------------------
                      (    forth6809.asm):05722         ; DUP  ( x -- x x )
                      (    forth6809.asm):05723         ; Duplicate the top cell.
                      (    forth6809.asm):05724         ; ------------------------------------------------------------
DE63 ECC4             (    forth6809.asm):05725         DUPW:       LDD   ,U                ; x
DE65 3606             (    forth6809.asm):05726                     PSHU  D
DE67 39               (    forth6809.asm):05727                     RTS
                      (    forth6809.asm):05728         
                      (    forth6809.asm):05729         ; ------------------------------------------------------------
                      (    forth6809.asm):05730         ; DROP  ( x -- )
                      (    forth6809.asm):05731         ; Discard the top cell.
                      (    forth6809.asm):05732         ; ------------------------------------------------------------
DE68 3342             (    forth6809.asm):05733         DROPW:      LEAU  2,U               ; x
DE6A 39               (    forth6809.asm):05734                     RTS
                      (    forth6809.asm):05735         
                      (    forth6809.asm):05736         ; ------------------------------------------------------------
                      (    forth6809.asm):05737         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05738         ; Exchange the top two cells.
                      (    forth6809.asm):05739         ; ------------------------------------------------------------
DE6B ECC4             (    forth6809.asm):05740         SWAPW:      LDD   ,U                ; x2
DE6D AE42             (    forth6809.asm):05741                     LDX   2,U               ; x1
DE6F AFC4             (    forth6809.asm):05742                     STX   ,U
DE71 ED42             (    forth6809.asm):05743                     STD   2,U
DE73 39               (    forth6809.asm):05744                     RTS
                      (    forth6809.asm):05745         
                      (    forth6809.asm):05746         ; ------------------------------------------------------------
                      (    forth6809.asm):05747         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05748         ; Copy the second cell to the top.
                      (    forth6809.asm):05749         ; ------------------------------------------------------------
DE74 EC42             (    forth6809.asm):05750         OVERW:      LDD   2,U               ; x1
DE76 3606             (    forth6809.asm):05751                     PSHU  D
DE78 39               (    forth6809.asm):05752                     RTS
                      (    forth6809.asm):05753         
                      (    forth6809.asm):05754         ; ------------------------------------------------------------
                      (    forth6809.asm):05755         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05756         ; Rotate the third cell to the top.
                      (    forth6809.asm):05757         ; ------------------------------------------------------------
DE79 ECC4             (    forth6809.asm):05758         ROTW:       LDD   ,U                ; x3
DE7B AE42             (    forth6809.asm):05759                     LDX   2,U               ; x2
DE7D 10AE44           (    forth6809.asm):05760                     LDY   4,U               ; x1
DE80 10AFC4           (    forth6809.asm):05761                     STY   ,U
DE83 ED42             (    forth6809.asm):05762                     STD   2,U
DE85 AF44             (    forth6809.asm):05763                     STX   4,U
DE87 39               (    forth6809.asm):05764                     RTS
                      (    forth6809.asm):05765         
                      (    forth6809.asm):05766         ; ------------------------------------------------------------
                      (    forth6809.asm):05767         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05768         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05769         ; ------------------------------------------------------------
DE88 ECC4             (    forth6809.asm):05770         QDUPW:      LDD   ,U                ; x
DE8A 10830000         (    forth6809.asm):05771                     CMPD  #0
DE8E 2702             (    forth6809.asm):05772                     BEQ   QDUPDONE
DE90 3606             (    forth6809.asm):05773                     PSHU  D
DE92 39               (    forth6809.asm):05774         QDUPDONE:   RTS
                      (    forth6809.asm):05775         
                      (    forth6809.asm):05776         ; ------------------------------------------------------------
                      (    forth6809.asm):05777         ; DEPTH  ( -- +n )

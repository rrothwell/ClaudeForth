                      (    forth6809.asm):03732                     ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03733                     ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03734                     ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03735                     ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03736                     ; NUMLOOP runs, so it isn't mistaken for a digit. The decision

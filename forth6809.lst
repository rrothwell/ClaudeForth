                      (    forth6809.asm):04380         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04381         ; ============================================================
                      (    forth6809.asm):04382                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04383         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04384         
                      (    forth6809.asm):04385         ; ------------------------------------------------------------
                      (    forth6809.asm):04386         ; KEY  ( -- char )
                      (    forth6809.asm):04387         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04388         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04389         ; ------------------------------------------------------------
D917                  (    forth6809.asm):04390         KEYACIA:
                      (    forth6809.asm):04391         
D917 7D0178           (    forth6809.asm):04392                     TST   RTSSTATE          ; Is throttling?
D91A 2703             (    forth6809.asm):04393                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04394         
                      (    forth6809.asm):04395                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
D91C BDCE8E           (    forth6809.asm):04396                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04397                                             ; by transmitting all chars.
                      (    forth6809.asm):04398         
D91F                  (    forth6809.asm):04399         TRY_READ:

                      (    forth6809.asm):06272                  JSR   LITERALW
                      (    forth6809.asm):06273         
                      (    forth6809.asm):06274                  JSR   THEN
                      (    forth6809.asm):06275         
                      (    forth6809.asm):06276                  LDD   #OPRTS
                      (    forth6809.asm):06277                  PSHU  D
                      (    forth6809.asm):06278                  JSR   CCOMMA
                      (    forth6809.asm):06279         
                      (    forth6809.asm):06280                  LDD   TSTCSAV
                      (    forth6809.asm):06281                  STD   CODEHERE
                      (    forth6809.asm):06282         
                      (    forth6809.asm):06283                  STU   TSTU0
                      (    forth6809.asm):06284         
                      (    forth6809.asm):06285                  LDD   #TSTGUARD
                      (    forth6809.asm):06286                  PSHU  D
                      (    forth6809.asm):06287                  LDD   #TRUEV
                      (    forth6809.asm):06288                  PSHU  D
                      (    forth6809.asm):06289                  STU   TSTUB4
                      (    forth6809.asm):06290         
                      (    forth6809.asm):06291                  JSR   TSTCBUF
                      (    forth6809.asm):06292         
                      (    forth6809.asm):06293                  STU   TSTUAF
                      (    forth6809.asm):06294         
                      (    forth6809.asm):06295                  PULU  D

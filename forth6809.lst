                      (    forth6809.asm):07216         ; TSTLEAVE - unit test for LEAVE. Compiles
                      (    forth6809.asm):07217         ; "DO I DUP 3 LITERAL = IF LEAVE THEN + LOOP", limit=10,
                      (    forth6809.asm):07218         ; start=0 - would normally visit I=0..9, but LEAVE forces exit
                      (    forth6809.asm):07219         ; once I=3 is reached. LEAVE only sets a flag; the actual exit
                      (    forth6809.asm):07220         ; happens at the NEXT LOOP check (per its own documented
                      (    forth6809.asm):07221         ; behavior, "exit at its next LOOP") - confirmed by hand-trace
                      (    forth6809.asm):07222         ; of DOTEST's own logic (checks the flag first, before its
                      (    forth6809.asm):07223         ; normal increment/compare). Since + runs before LOOP's check,
                      (    forth6809.asm):07224         ; I=3 IS accumulated before the loop exits - sum=0+1+2+3=6, not
                      (    forth6809.asm):07225         ; 0+1+2=3 (which would indicate LEAVE incorrectly took effect
                      (    forth6809.asm):07226         ; immediately) and not the full 0..9 (which would indicate
                      (    forth6809.asm):07227         ; LEAVE didn't work at all).
                      (    forth6809.asm):07228         ; ------------------------------------------------------------

                      (    forth6809.asm):01159         
                      (    forth6809.asm):01160                  LDU   TSTU0
                      (    forth6809.asm):01161                  RTS
                      (    forth6809.asm):01162         
C182                  (    forth6809.asm):01163         TSTCRNAME: FCB  5
                      (    forth6809.asm):01164                    FCC  "TSTCR"
                      (    forth6809.asm):01165         

                      (   unit_tests.asm):00261         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (   unit_tests.asm):00262         ; here as they're written.
                      (   unit_tests.asm):00263         ; ------------------------------------------------------------
C135 BDC16C           (   unit_tests.asm):00264         TSTRUNNER:  JSR   TSTSYSIO
C138 BDC185           (   unit_tests.asm):00265                     JSR   TSTSTACK
C13B BDC19E           (   unit_tests.asm):00266                     JSR   TSTRETSTACK
C13E BDC1BA           (   unit_tests.asm):00267                     JSR   TSTSARITH
C141 BDC1D9           (   unit_tests.asm):00268                     JSR   TSTDARITH
C144 BDC1F8           (   unit_tests.asm):00269                     JSR   TSTLOGIC
C147 BDC211           (   unit_tests.asm):00270                     JSR   TSTCOMPARE
C14A BDC22C           (   unit_tests.asm):00271                     JSR   TSTCTRLFLOW
C14D BDC248           (   unit_tests.asm):00272                     JSR   TSTDEFWORDS
C150 BDC264           (   unit_tests.asm):00273                     JSR   TSTCOMPWORDS
C153 BDC281           (   unit_tests.asm):00274                     JSR   TSTMEMORY

FD03 8EFD43           (    forth6809.asm):06718         ENV2START: LDX  #ENVTABLE2  ; NEW: double-cell query table - kept
                      (    forth6809.asm):06719                                     ; entirely separate from ENVTABLE above
                      (    forth6809.asm):06720                                     ; rather than trying to unify both cases

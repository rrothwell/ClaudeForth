CF59 CC7000           (    forth6809.asm):02530                     LDD   #APPCODE
CF5C DD08             (    forth6809.asm):02531                     STD   CODEHERE
CF5E CC2000           (    forth6809.asm):02532                     LDD   #APPDICT
CF61 DD06             (    forth6809.asm):02533                     STD   DPHERE
CF63 CCCD8A           (    forth6809.asm):02534                     LDD   #BASELATEST
CF66 DD04             (    forth6809.asm):02535                     STD   LATEST
CF68 BDD5E9           (    forth6809.asm):02536                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02537         
CF6B CC000A           (    forth6809.asm):02538                     LDD   #10
CF6E DD02             (    forth6809.asm):02539                     STD   BASE
                      (    forth6809.asm):02540         

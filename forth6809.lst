CF08 5C               (    forth6809.asm):02347                     INCB                    ; Update the tail pointer
CF09 C43F             (    forth6809.asm):02348                     ANDB  #INBUFSZ-1        ; to point to the next character.
CF0B F70177           (    forth6809.asm):02349                     STB   INTAIL
                      (    forth6809.asm):02350         

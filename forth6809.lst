                      (    forth6809.asm):04277         ; ------------------------------------------------------------
                      (    forth6809.asm):04278         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04279         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04280         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04281         ;    Inputs:
                      (    forth6809.asm):04282         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04283         ;    Outputs:
                      (    forth6809.asm):04284         ;        single number: n and -1
                      (    forth6809.asm):04285         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04286         ;        not a number: c-addr and 0
                      (    forth6809.asm):04287         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04288         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04289         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04290         ; NUMBERQ.6.
                      (    forth6809.asm):04291         ; ------------------------------------------------------------
D710 3710             (    forth6809.asm):04292         NUMBERQ:    PULU  X                 ; c-addr
D712 327D             (    forth6809.asm):04293                     LEAS  -3,S
D714 AFE4             (    forth6809.asm):04294                     STX   ,S
D716 E684             (    forth6809.asm):04295                     LDB   ,X
D718 276D             (    forth6809.asm):04296                     BEQ   NQBAD
D71A 3001             (    forth6809.asm):04297                     LEAX  1,X
                      (    forth6809.asm):04298         
                      (    forth6809.asm):04299                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04300                     ; digit count. See shadow: NUMBERQ.1
D71C 5A               (    forth6809.asm):04301                     DECB
D71D A685             (    forth6809.asm):04302                     LDA   B,X

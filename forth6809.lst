                      (    forth6809.asm):15592         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):15593         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):15594         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):15595         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):15596         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):15597         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):15598         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):15599         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):15600         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):15601         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):15602         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):15603         ; they no longer need indirection.
                      (    forth6809.asm):15604         ;
                      (    forth6809.asm):15605         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):15606         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):15607         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):15608         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):15609         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):15610         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):15611         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):15612         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):15613         ;
                      (    forth6809.asm):15614         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):15615         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):15616         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):15617         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):15618         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):15619         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):15620         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):15621         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):15622         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):15623         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):15624         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):15625         ;
                      (    forth6809.asm):15626         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):15627         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):15628         ;
                      (    forth6809.asm):15629         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):15630         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):15631         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):15632         ; ============================================================

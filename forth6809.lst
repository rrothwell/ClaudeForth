E3F4 2718             (    forth6809.asm):03385                     BEQ   NQPOS32
E3F6 DC76             (    forth6809.asm):03386                     LDD   UDLO
E3F8 43               (    forth6809.asm):03387                     COMA
E3F9 53               (    forth6809.asm):03388                     COMB
E3FA C30001           (    forth6809.asm):03389                     ADDD  #1
E3FD DD76             (    forth6809.asm):03390                     STD   UDLO

                      (    forth6809.asm):00885         
                      (    forth6809.asm):00886         ; ============================================================
                      (    forth6809.asm):00887         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00888         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):00889         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):00890         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):00891         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):00892         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):00893         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):00894         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):00895         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):00896         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):00897         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):00898         ; they no longer need indirection.
                      (    forth6809.asm):00899         ;
                      (    forth6809.asm):00900         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):00901         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):00902         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):00903         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):00904         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):00905         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):00906         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):00907         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):00908         ;
                      (    forth6809.asm):00909         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):00910         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):00911         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):00912         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):00913         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):00914         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):00915         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):00916         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):00917         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):00918         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):00919         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):00920         ;
                      (    forth6809.asm):00921         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):00922         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):00923         ;
                      (    forth6809.asm):00924         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):00925         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):00926         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):00927         ; ============================================================

                      (    forth6809.asm):06414                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):06415                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):06416                                   ; before this one.
                      (    forth6809.asm):06417         
                      (    forth6809.asm):06418         ; Verify no collision with base code.
                      (    forth6809.asm):06419         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):06420         BASEDICTEND  EQU   *

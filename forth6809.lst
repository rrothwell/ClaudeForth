                      (    forth6809.asm):04340         ; ============================================================
                      (    forth6809.asm):04341         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04342         ; ============================================================
                      (    forth6809.asm):04343                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04344         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04345         
                      (    forth6809.asm):04346         ; ------------------------------------------------------------
                      (    forth6809.asm):04347         ; KEY  ( -- char )
                      (    forth6809.asm):04348         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04349         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04350         ; ------------------------------------------------------------
D9BB                  (    forth6809.asm):04351         KEYW:
                      (    forth6809.asm):04352         
D9BB 7D0178           (    forth6809.asm):04353                     TST   RTSSTATE          ; Is throttling?
D9BE 2703             (    forth6809.asm):04354                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04355         
                      (    forth6809.asm):04356                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
D9C0 BDCF4E           (    forth6809.asm):04357                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04358                                             ; by transmitting all chars.
                      (    forth6809.asm):04359         
D9C3                  (    forth6809.asm):04360         TRY_READ:
D9C3 BDCFBB           (    forth6809.asm):04361                     JSR   GETCHAR           ; Is char available in input buffer.
D9C6 25F3             (    forth6809.asm):04362                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04363                                             ; while still transmitting!
                      (    forth6809.asm):04364         
D9C8 1F89             (    forth6809.asm):04365                     TFR   A,B               ; Move char result to Reg B (LSB of D)
D9CA 4F               (    forth6809.asm):04366                     CLRA                    ; Clear MSB.
D9CB 3606             (    forth6809.asm):04367                     PSHU  D                 ; char
                      (    forth6809.asm):04368         
D9CD 39               (    forth6809.asm):04369                     RTS
                      (    forth6809.asm):04370         
                      (    forth6809.asm):04371         ; ------------------------------------------------------------
                      (    forth6809.asm):04372         ; KEY?  ( -- flag )
                      (    forth6809.asm):04373         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04374         ; ------------------------------------------------------------
D9CE                  (    forth6809.asm):04375         KEYQW:
                      (    forth6809.asm):04376                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04377         
D9CE B60176           (    forth6809.asm):04378                     LDA   INHEAD            ; Characters received?
D9D1 B10177           (    forth6809.asm):04379                     CMPA  INTAIL
                      (    forth6809.asm):04380         
                      (    forth6809.asm):04381                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04382         
D9D4 2606             (    forth6809.asm):04383                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04384         
D9D6 CC0000           (    forth6809.asm):04385                     LDD   #FALSEV           ; No! Return false result.
D9D9 3606             (    forth6809.asm):04386                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04387         
D9DB 39               (    forth6809.asm):04388                     RTS
                      (    forth6809.asm):04389         
D9DC                  (    forth6809.asm):04390         KQTRUE:
D9DC CCFFFF           (    forth6809.asm):04391                     LDD   #TRUEV            ; Yes! Return true result.
D9DF 3606             (    forth6809.asm):04392                     PSHU  D                 ; flag = true
D9E1 39               (    forth6809.asm):04393                     RTS
                      (    forth6809.asm):04394         
                      (    forth6809.asm):04395         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04396         
                      (    forth6809.asm):04397         ; ------------------------------------------------------------
                      (    forth6809.asm):04398         ; EMIT  ( char -- )
                      (    forth6809.asm):04399         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04400         ; discarded if the ring is full.
                      (    forth6809.asm):04401         ; ------------------------------------------------------------
D9E2                  (    forth6809.asm):04402         EMITW:
D9E2 3706             (    forth6809.asm):04403                     PULU  D                 ; char

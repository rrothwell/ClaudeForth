                      (    forth6809.asm):04922         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):04923         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):04924         ; of this call is on top of S, so it is lifted off and put back around

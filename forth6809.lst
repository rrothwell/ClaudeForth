E08D 3620             (    forth6809.asm):05964                     PSHU  Y
E08F 3606             (    forth6809.asm):05965                     PSHU  D
E091 39               (    forth6809.asm):05966                     RTS
                      (    forth6809.asm):05967         
                      (    forth6809.asm):05968         ; ------------------------------------------------------------
                      (    forth6809.asm):05969         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05970         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05971         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05972         ; and put back around the transfer.
                      (    forth6809.asm):05973         ; ------------------------------------------------------------
E092 3510             (    forth6809.asm):05974         TWORFETCHW: PULS  X                 ; return address

                      (    forth6809.asm):07503         ; ============================================================
                      (    forth6809.asm):07504         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07505         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07506         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07507         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07508         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07509         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07510         ; ============================================================
                      (    forth6809.asm):07511         ; ------------------------------------------------------------
                      (    forth6809.asm):07512         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07513         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07514         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07515         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07516         ; - no indirection, no value cell.
                      (    forth6809.asm):07517         ;
                      (    forth6809.asm):07518         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07519         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07520         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07521         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07522         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07523         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07524         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07525         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07526         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07527         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07528         ; ------------------------------------------------------------
FF61 CCFFFF           (    forth6809.asm):07529         TRUEBODY:  LDD   #$FFFF
FF64 3606             (    forth6809.asm):07530                    PSHU  D
FF66 39               (    forth6809.asm):07531                    RTS
                      (    forth6809.asm):07532         
FF67 CC0000           (    forth6809.asm):07533         FALSEBODY: LDD   #$0000
FF6A 3606             (    forth6809.asm):07534                    PSHU  D
FF6C 39               (    forth6809.asm):07535                    RTS
                      (    forth6809.asm):07536         
                      (    forth6809.asm):07537         ; ------------------------------------------------------------
                      (    forth6809.asm):07538         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07539         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07540         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07541         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07542         ; ------------------------------------------------------------
FF6D CC0001           (    forth6809.asm):07543         ONEBODY:   LDD   #1
FF70 3606             (    forth6809.asm):07544                    PSHU  D
FF72 39               (    forth6809.asm):07545                    RTS
                      (    forth6809.asm):07546         
FF73 CCFFFF           (    forth6809.asm):07547         MONEBODY:  LDD   #-1
FF76 3606             (    forth6809.asm):07548                    PSHU  D
FF78 39               (    forth6809.asm):07549                    RTS
                      (    forth6809.asm):07550         
FF79 CC0002           (    forth6809.asm):07551         TWOBODY:   LDD   #2
FF7C 3606             (    forth6809.asm):07552                    PSHU  D
FF7E 39               (    forth6809.asm):07553                    RTS
                      (    forth6809.asm):07554         
FF7F CCFFFE           (    forth6809.asm):07555         MTWOBODY:  LDD   #-2
FF82 3606             (    forth6809.asm):07556                    PSHU  D
FF84 39               (    forth6809.asm):07557                    RTS
                      (    forth6809.asm):07558         
                      (    forth6809.asm):07559         ; Verify no collision with init code,
                      (    forth6809.asm):07560         ; value should match ORG INITCODE.
     FF85             (    forth6809.asm):07561         BASECODEEND  EQU   *
     2257             (    forth6809.asm):07562         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07563         
                      (    forth6809.asm):07564         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07565         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07566         ; .bin file.
FF85                  (    forth6809.asm):07567         BASEND:
FF85 FFFFFFFFFFFFFFFF (    forth6809.asm):07568                  FILL $FF,INITCODE-BASEND
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFF
                      (    forth6809.asm):07569         

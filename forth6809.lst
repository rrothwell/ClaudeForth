                      (    forth6809.asm):09686         ; TSTTICK1 - unit test for ' (tick), found case. Builds a fake
                      (    forth6809.asm):09687         ; header pointing at DUP's own CFA, redirects LATEST to it and
                      (    forth6809.asm):09688         ; SRCADDR to a matching fake name, and verifies TICK returns the
                      (    forth6809.asm):09689         ; correct xt. Redirects CODEHERE too, even though TICK doesn't
                      (    forth6809.asm):09690         ; itself compile anything - WORD's own internal parse still
                      (    forth6809.asm):09691         ; writes through it regardless (the same real bug found via MAME
                      (    forth6809.asm):09692         ; earlier applies to any word that calls WORD, not just the
                      (    forth6809.asm):09693         ; defining words that originally surfaced it).
                      (    forth6809.asm):09694         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):09695         TSTTICK1: LDD  CODEHERE
                      (    forth6809.asm):09696                   STD  TSTCSAV
                      (    forth6809.asm):09697                   LDD  LATEST
                      (    forth6809.asm):09698                   STD  TSTLSAV
                      (    forth6809.asm):09699                   LDD  SRCADDR
                      (    forth6809.asm):09700                   STD  TSTSASAV
                      (    forth6809.asm):09701                   LDD  SRCLEN
                      (    forth6809.asm):09702                   STD  TSTSLSAV
                      (    forth6809.asm):09703                   LDD  TOIN
                      (    forth6809.asm):09704                   STD  TSTTISAV
                      (    forth6809.asm):09705         
                      (    forth6809.asm):09706                   LDA  #3
                      (    forth6809.asm):09707                   STA  TSTFHDR
                      (    forth6809.asm):09708                   LDA  #'F'
                      (    forth6809.asm):09709                   STA  TSTFHDR+1
                      (    forth6809.asm):09710                   LDA  #'O'
                      (    forth6809.asm):09711                   STA  TSTFHDR+2
                      (    forth6809.asm):09712                   LDA  #'O'
                      (    forth6809.asm):09713                   STA  TSTFHDR+3
                      (    forth6809.asm):09714                   LDD  #0
                      (    forth6809.asm):09715                   STD  TSTFHDR+4
                      (    forth6809.asm):09716                   LDD  #DUP
                      (    forth6809.asm):09717                   STD  TSTFHDR+6
                      (    forth6809.asm):09718         
                      (    forth6809.asm):09719                   LDA  #'F'
                      (    forth6809.asm):09720                   STA  TSTNAMEB
                      (    forth6809.asm):09721                   LDA  #'O'
                      (    forth6809.asm):09722                   STA  TSTNAMEB+1
                      (    forth6809.asm):09723                   LDA  #'O'
                      (    forth6809.asm):09724                   STA  TSTNAMEB+2
                      (    forth6809.asm):09725         
                      (    forth6809.asm):09726                   LDD  #TSTCBUF
                      (    forth6809.asm):09727                   STD  CODEHERE
                      (    forth6809.asm):09728                   LDD  #TSTFHDR
                      (    forth6809.asm):09729                   STD  LATEST
                      (    forth6809.asm):09730                   LDD  #TSTNAMEB
                      (    forth6809.asm):09731                   STD  SRCADDR
                      (    forth6809.asm):09732                   LDD  #3
                      (    forth6809.asm):09733                   STD  SRCLEN
                      (    forth6809.asm):09734                   LDD  #0
                      (    forth6809.asm):09735                   STD  TOIN
                      (    forth6809.asm):09736         
                      (    forth6809.asm):09737                   STU  TSTU0
                      (    forth6809.asm):09738         
                      (    forth6809.asm):09739                   LDD  #TSTGUARD
                      (    forth6809.asm):09740                   PSHU D
                      (    forth6809.asm):09741                   STU  TSTUB4
                      (    forth6809.asm):09742         
                      (    forth6809.asm):09743                   JSR  TICK
                      (    forth6809.asm):09744         
                      (    forth6809.asm):09745                   STU  TSTUAF
                      (    forth6809.asm):09746         
                      (    forth6809.asm):09747                   LDD  TSTCSAV
                      (    forth6809.asm):09748                   STD  CODEHERE
                      (    forth6809.asm):09749                   LDD  TSTLSAV
                      (    forth6809.asm):09750                   STD  LATEST
                      (    forth6809.asm):09751                   LDD  TSTSASAV
                      (    forth6809.asm):09752                   STD  SRCADDR
                      (    forth6809.asm):09753                   LDD  TSTSLSAV
                      (    forth6809.asm):09754                   STD  SRCLEN
                      (    forth6809.asm):09755                   LDD  TSTTISAV
                      (    forth6809.asm):09756                   STD  TOIN
                      (    forth6809.asm):09757         
                      (    forth6809.asm):09758                   PULU D
                      (    forth6809.asm):09759                   CMPD #DUP
                      (    forth6809.asm):09760                   BNE  TK1FAIL
                      (    forth6809.asm):09761                   PULU D
                      (    forth6809.asm):09762                   CMPD #TSTGUARD
                      (    forth6809.asm):09763                   BNE  TK1FAIL
                      (    forth6809.asm):09764         
                      (    forth6809.asm):09765                   LDD  TSTUB4
                      (    forth6809.asm):09766                   SUBD TSTUAF
                      (    forth6809.asm):09767                   CMPD #2
                      (    forth6809.asm):09768                   BNE  TK1FAIL
                      (    forth6809.asm):09769         

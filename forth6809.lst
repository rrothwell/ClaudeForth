E4AB 2751             (    forth6809.asm):03197                     BEQ   NQBAD
                      (    forth6809.asm):03198         
E4AD 108E0000         (    forth6809.asm):03199         NQNOSIGN2:  LDY   #0
E4B1 3620             (    forth6809.asm):03200                     PSHU  Y                 ; ud low
E4B3 3620             (    forth6809.asm):03201                     PSHU  Y                 ; ud high
E4B5 3610             (    forth6809.asm):03202                     PSHU  X                 ; c-addr
E4B7 4F               (    forth6809.asm):03203                     CLRA
E4B8 3606             (    forth6809.asm):03204                     PSHU  D                 ; u
                      (    forth6809.asm):03205         
E4BA BDE44E           (    forth6809.asm):03206                     JSR   NUMLOOP
                      (    forth6809.asm):03207         
E4BD ECC4             (    forth6809.asm):03208                     LDD   ,U

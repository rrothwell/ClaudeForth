                      (    forth6809.asm):07635         ; pattern as TSTTHENZ - wrong value in place of TAGBACK.
                      (    forth6809.asm):07636         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07637         TSTUNTILZ: STU  TSTU0
                      (    forth6809.asm):07638         
                      (    forth6809.asm):07639                    LDD  #0
                      (    forth6809.asm):07640                    PSHU D

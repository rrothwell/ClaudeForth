                      (    forth6809.asm):00339         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00340         ;
                      (    forth6809.asm):00341         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00342         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00343         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00344         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00345         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00346         ; hand-built at the end of the section.
                      (    forth6809.asm):00347         ;
                      (    forth6809.asm):00348         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00349         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00350         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00351         ; ============================================================

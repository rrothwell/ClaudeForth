                      (   unit_tests.asm):10790         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (   unit_tests.asm):10791         ; direct memory-access words (no compile-time behavior, no
                      (   unit_tests.asm):10792         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (   unit_tests.asm):10793         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (   unit_tests.asm):10794         ; same redirect-based safety established for sections 3.8/3.9.
                      (   unit_tests.asm):10795         ; TSTCBUF is reused here as general scratch memory for the
                      (   unit_tests.asm):10796         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (   unit_tests.asm):10797         ; runs exclusively of every other.
                      (   unit_tests.asm):10798         ;
                      (   unit_tests.asm):10799         ; MOVE is traced to genuinely choose its copy direction based on
                      (   unit_tests.asm):10800         ; comparing src and dst addresses (delegating to CMOVE or
                      (   unit_tests.asm):10801         ; CMOVE> as appropriate) - so its own tests specifically include
                      (   unit_tests.asm):10802         ; overlapping regions in both directions, not just a trivial
                      (   unit_tests.asm):10803         ; non-overlapping case, to verify that claim for real.
                      (   unit_tests.asm):10804         ; ------------------------------------------------------------
                      (   unit_tests.asm):10805         
                      (   unit_tests.asm):10806         ; ------------------------------------------------------------

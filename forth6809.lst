                      (    forth6809.asm):18005                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):18006         
E8BF EC68             (    forth6809.asm):18007         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E8C1 3606             (    forth6809.asm):18008                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E8C3 39               (    forth6809.asm):18009                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):18010                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):18011                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):18012                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):18013                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):18014                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):18015                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):18016                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):18017                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):18018                                   ; index@6][outer-limit@8][outer-leave@10] -

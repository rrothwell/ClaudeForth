                      (    forth6809.asm):03049         ; ------------------------------------------------------------
                      (    forth6809.asm):03050         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03051         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03052         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03053         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03054         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03055         ; ------------------------------------------------------------
E2A0 3706             (    forth6809.asm):03056         WORDW:      PULU  D                 ; char
E2A2 327D             (    forth6809.asm):03057                     LEAS  -3,S              ; frame (5k): 0,S = delimiter,
E2A4 E7E4             (    forth6809.asm):03058                     STB   ,S                ; 1,S = start of the text
E2A6 DC10             (    forth6809.asm):03059                     LDD   TOIN

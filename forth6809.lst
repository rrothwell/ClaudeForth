                      (    forth6809.asm):03723                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03724                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03725                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03726                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03727                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03728                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03729                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03730                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03731                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03732                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03733                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03734                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03735                  ; for it.
E450 D621             (    forth6809.asm):03736                  LDB   CNTREM
E452 5A               (    forth6809.asm):03737                  DECB
E453 A685             (    forth6809.asm):03738                  LDA   B,X
E455 812E             (    forth6809.asm):03739                  CMPA  #'.'
E457 2604             (    forth6809.asm):03740                  BNE   NQNOSIGN
E459 0A21             (    forth6809.asm):03741                  DEC   CNTREM
E45B 2766             (    forth6809.asm):03742                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03743         
E45D 0F22             (    forth6809.asm):03744         NQNOSIGN: CLR   NUMNEG
E45F A684             (    forth6809.asm):03745                  LDA   ,X
E461 812D             (    forth6809.asm):03746                  CMPA  #'-'
E463 2608             (    forth6809.asm):03747                  BNE   NQNOSIGN2
E465 0322             (    forth6809.asm):03748                  COM   NUMNEG
E467 3001             (    forth6809.asm):03749                  LEAX  1,X
E469 0A21             (    forth6809.asm):03750                  DEC   CNTREM
E46B 2756             (    forth6809.asm):03751                  BEQ   NQBAD
                      (    forth6809.asm):03752         

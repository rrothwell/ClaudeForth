                      (    forth6809.asm):08583         ; ------------------------------------------------------------
                      (    forth6809.asm):08584         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08585         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08586         ; low byte of BASE is used.
                      (    forth6809.asm):08587         ; UDDIGIT
                      (    forth6809.asm):08588         ;    Inputs:
                      (    forth6809.asm):08589         ;        ud on the data stack
                      (    forth6809.asm):08590         ;    Outputs:

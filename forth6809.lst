                      (    forth6809.asm):08001         ;    Inputs:
                      (    forth6809.asm):08002         ;        NMI
                      (    forth6809.asm):08003         ;    Outputs:
                      (    forth6809.asm):08004         ;        does not return
                      (    forth6809.asm):08005         ;    Registers: all registers initialised.

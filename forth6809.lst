                      (    forth6809.asm):01870         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01871         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01872         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01873         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01874         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01875         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01876         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01877         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01878         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01879         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01880         ; were chained on after H_QUIT in a later turn.
DDD8 05               (    forth6809.asm):01881         H_ABORT: FCB   5
DDD9 41424F5254       (    forth6809.asm):01882                  FCC   "ABORT"
DDDE DDCE             (    forth6809.asm):01883                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01884                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01885                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01886                                        ; now H_FALSE, the chain's newest entry
DDE0 DF24             (    forth6809.asm):01887                  FDB   ABORT
                      (    forth6809.asm):01888         

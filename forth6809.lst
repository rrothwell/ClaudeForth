                      (    forth6809.asm):02327                    PULU  D
                      (    forth6809.asm):02328                    CMPD  #TSTVAL5
                      (    forth6809.asm):02329                    BNE   RO2FAIL
                      (    forth6809.asm):02330                    PULU  D
                      (    forth6809.asm):02331                    CMPD  #TSTVAL4
                      (    forth6809.asm):02332                    BNE   RO2FAIL
                      (    forth6809.asm):02333                    PULU  D
                      (    forth6809.asm):02334                    CMPD  #TSTVAL3
                      (    forth6809.asm):02335                    BNE   RO2FAIL

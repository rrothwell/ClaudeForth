                      (    forth6809.asm):03459         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03460         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03461         ; ------------------------------------------------------------
E579                  (    forth6809.asm):03462         EMITW:      PULU  D                 ; char

E51B 27F1             (    forth6809.asm):03953                  BEQ   ALOOP
E51D C108             (    forth6809.asm):03954                  CMPB  #8
E51F 2724             (    forth6809.asm):03955                  BEQ   ABKSP
E521 C17F             (    forth6809.asm):03956                  CMPB  #127
E523 2720             (    forth6809.asm):03957                  BEQ   ABKSP
                      (    forth6809.asm):03958         
E525 DC39             (    forth6809.asm):03959                  LDD   ACNT
E527 109335           (    forth6809.asm):03960                  CMPD  AMAX
E52A 27E2             (    forth6809.asm):03961                  BEQ   ALOOP
                      (    forth6809.asm):03962         
E52C 9E37             (    forth6809.asm):03963                  LDX   ABUFP
E52E 308B             (    forth6809.asm):03964                  LEAX  D,X
E530 963B             (    forth6809.asm):03965                  LDA   ACH
E532 A784             (    forth6809.asm):03966                  STA   ,X
E534 DC39             (    forth6809.asm):03967                  LDD   ACNT
E536 C30001           (    forth6809.asm):03968                  ADDD  #1
E539 DD39             (    forth6809.asm):03969                  STD   ACNT
                      (    forth6809.asm):03970         
E53B 4F               (    forth6809.asm):03971                  CLRA
E53C D63B             (    forth6809.asm):03972                  LDB   ACH
E53E 3606             (    forth6809.asm):03973                  PSHU  D
E540 BDE4ED           (    forth6809.asm):03974                  JSR   EMIT

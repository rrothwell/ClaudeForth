                      (    forth6809.asm):00001         ; ============================================================
                      (    forth6809.asm):00002         ; 6809 ANS FORTH - consolidated source
                      (    forth6809.asm):00003         ; Assembled from the full design conversation.
                      (    forth6809.asm):00004         ;
                      (    forth6809.asm):00005         ; GLOBALS LAYOUT: applied. Every scratch/global cell now has a
                      (    forth6809.asm):00006         ; fixed RMB-assigned address in page zero ($0000-$00FF, DP=$00
                      (    forth6809.asm):00007         ; at reset) - see the GLOBALS section below for the full layout
                      (    forth6809.asm):00008         ; and its byte budget (256 of 256 bytes used, 0 free - the page
                      (    forth6809.asm):00009         ; is now fully packed; any future scratch cell will need to
                      (    forth6809.asm):00010         ; reuse an existing one or move a cell out of page zero).
                      (    forth6809.asm):00011         ;
                      (    forth6809.asm):00012         ; SERIAL HANDSHAKING: RTS (hardware, output) is implemented -
                      (    forth6809.asm):00013         ; IRQH/KEY toggle it based on the input ring's fill level
                      (    forth6809.asm):00014         ; against INHIWATER/INLOWATER (see SECTION 3). CTS (input) needs
                      (    forth6809.asm):00015         ; no firmware logic at all: the 6850 hardware automatically
                      (    forth6809.asm):00016         ; inhibits TDRE while CTS is deasserted, and this system's
                      (    forth6809.asm):00017         ; existing TDRE-gated transmit logic already respects that with
                      (    forth6809.asm):00018         ; no code changes. Software (XON/XOFF) handshaking remains not
                      (    forth6809.asm):00019         ; implemented - this system still neither transmits nor
                      (    forth6809.asm):00020         ; recognizes those bytes.
                      (    forth6809.asm):00021         ;
                      (    forth6809.asm):00022         ; DICTIONARY: applied (SECTION 27), 220 entries (215 original +
                      (    forth6809.asm):00023         ; DOES> + TRUE + FALSE + [COMPILE], added in later passes - see
                      (    forth6809.asm):00024         ; below). [COMPILE] (XCOMPILE, section 13) is the obsolescent
                      (    forth6809.asm):00025         ; predecessor to POSTPONE, added for ANS Annex F test coverage
                      (    forth6809.asm):00026         ; (F.6.2.2530) - see XCOMPILE's own header/comment for how it
                      (    forth6809.asm):00027         ; differs from POSTPONE, and BASECODE's EQU below for the
                      (    forth6809.asm):00028         ; resulting header-table growth.
                      (    forth6809.asm):00029         ; Every primitive with a real code label now has a real ROM
                      (    forth6809.asm):00030         ; header, chained via LINK, CFA pointing directly at its code.
                      (    forth6809.asm):00031         ; Building this surfaced two real findings, not just mechanical
                      (    forth6809.asm):00032         ; work: (1) the original 1024-byte BASEDICT could not hold the
                      (    forth6809.asm):00033         ; header table (1954 bytes needed) - BASEDICT was resized to
                      (    forth6809.asm):00034         ; 2048 bytes ($E000-$E7FF), taking the space from BASECODE (then
                      (    forth6809.asm):00035         ; $E800-$FFBF, 6080 bytes, was 7104). This resize was based on
                      (    forth6809.asm):00036         ; the header-table budget alone; the actual assembled byte size
                      (    forth6809.asm):00037         ; of BASECODE's code was never measured with a real 6809
                      (    forth6809.asm):00038         ; assembler, so whether 6080 bytes was enough for all ~530
                      (    forth6809.asm):00039         ; routine labels in this file was never verified before BASECODE
                      (    forth6809.asm):00040         ; moved again (below). (2) DOES>
                      (    forth6809.asm):00041         ; initially had no corresponding code anywhere in the file -
                      (    forth6809.asm):00042         ; SETDOES and the DOES> compiling word (code label DOESGT, since
                      (    forth6809.asm):00043         ; a literal ">" is not a valid 6809 assembler label) were added
                      (    forth6809.asm):00044         ; in a follow-up pass, alongside DODOES/DOESRT0, closing that
                      (    forth6809.asm):00045         ; gap; DOESBEH was added to the GLOBALS layout to support it,
                      (    forth6809.asm):00046         ; using 2 of the page's last 3 free bytes (1 now remains). TRUE
                      (    forth6809.asm):00047         ; and FALSE were added in a still later pass: CONSTANT TRUE -1
                      (    forth6809.asm):00048         ; and CONSTANT FALSE 0, the first CONSTANT-pattern ROM-resident
                      (    forth6809.asm):00049         ; words in this system (TRUEBODY/FALSEBODY, section 26) - every
                      (    forth6809.asm):00050         ; other ROM word's CFA is a plain code label, but a CONSTANT's
                      (    forth6809.asm):00051         ; CFA is the DODOES-trampoline pattern, built by hand here with
                      (    forth6809.asm):00052         ; fixed, assemble-time addresses since there is no interactive
                      (    forth6809.asm):00053         ; CREATE/CONSTANT phase for ROM content.
                      (    forth6809.asm):00054         ;
                      (    forth6809.asm):00055         ; BASEDICT now holds 1992 bytes ($D83F-$E006) - grown from the
                      (    forth6809.asm):00056         ; earlier exact-fit 1973 bytes when H_ABORT/H_QUIT (formerly
                      (    forth6809.asm):00057         ; ABORTHDR/QUITHDR) and BASELATEST moved in from their own
                      (    forth6809.asm):00058         ; section so every dictionary header lives in one contiguous
                      (    forth6809.asm):00059         ; block. BASECODE's start ($DFF4) did not move to match, since
                      (    forth6809.asm):00060         ; it's a fixed address, not derived from BASEDICT's real size -
                      (    forth6809.asm):00061         ; this reintroduces a real overlap, 19 bytes ($DFF4-$E006),
                      (    forth6809.asm):00062         ; between the two. Not resolved here; see the open-items
                      (    forth6809.asm):00063         ; checklist. USROMSTRT/USROMEND, INOUT, RSTACK, DSTACK, CODETOP,
                      (    forth6809.asm):00064         ; APPCODE, APPDICT, and APPVARS remain mutually consistent
                      (    forth6809.asm):00065         ; otherwise, with no other overlaps anywhere in the current
                      (    forth6809.asm):00066         ; memory map. See the ROM Size Required section of the
                      (    forth6809.asm):00067         ; documentation and the open-items checklist for real content
                      (    forth6809.asm):00068         ; totals and remaining margin.
                      (    forth6809.asm):00069         ;
                      (    forth6809.asm):00070         ; This file preserves the code exactly as derived and verified
                      (    forth6809.asm):00071         ; turn-by-turn in the conversation, including the corrected
                      (    forth6809.asm):00072         ; versions of every bug that was caught and fixed in place.
                      (    forth6809.asm):00073         ; SUBSTITUTE is complete but deliberately scoped to a single
                      (    forth6809.asm):00074         ; registered name/value pair, not a full table (see REPLACES).
                      (    forth6809.asm):00075         ; ENVTABLE's /HOLD and /PAD entries were both added this session
                      (    forth6809.asm):00076         ; (HOLDMINSIZE and PADMINSIZE respectively - see the entries
                      (    forth6809.asm):00077         ; themselves for why each uses its own, conceptually correct
                      (    forth6809.asm):00078         ; constant rather than the numerically-equal PADOFFSET). The
                      (    forth6809.asm):00079         ; DPHERE/CODEHERE/VARHERE boundary checks remain explicitly
                      (    forth6809.asm):00080         ; incomplete/absent - see the inline notes preserved from that
                      (    forth6809.asm):00081         ; discussion, and the open-items checklist.
                      (    forth6809.asm):00082         ; ============================================================
                      (    forth6809.asm):00083         
                      (    forth6809.asm):00084         ; ------------------------------------------------------------
                      (    forth6809.asm):00085         ; MEMORY MAP
                      (    forth6809.asm):00086         ; ------------------------------------------------------------
     C000             (    forth6809.asm):00087         ROMSTRT  EQU $C000     ; true physical start of the 16K EPROM's own
                      (    forth6809.asm):00088                                 ; address decode (distinct from USROMSTRT
                      (    forth6809.asm):00089                                 ; below, which excludes INOUT's 256-byte
                      (    forth6809.asm):00090                                 ; shadow) - see the ROM Size Required section
                      (    forth6809.asm):00091                                 ; of the documentation, and the ROM: padding
                      (    forth6809.asm):00092                                 ; block right before SECTION 27
     C100             (    forth6809.asm):00093         USROMSTRT EQU $C100     ; Usable ROM start. Beginning of the usable
                      (    forth6809.asm):00094                                  ; EPROM address range. INITCODE, BASECODE,
                      (    forth6809.asm):00095                                  ; and BASEDICT must all fall within
                      (    forth6809.asm):00096                                  ; USROMSTRT..USROMEND - see the verification
                      (    forth6809.asm):00097                                  ; note below each one's EQU.
     FFEF             (    forth6809.asm):00098         USROMEND EQU  VECTORS-1 ; Usable ROM end. Corrected: 1 before VECTORS'
                      (    forth6809.asm):00099                                  ; start ($FFEF), not one past VECTORS' end as
                      (    forth6809.asm):00100                                  ; originally defined - this is a real 16-bit
                      (    forth6809.asm):00101                                  ; address (the last byte available before the
                      (    forth6809.asm):00102                                  ; reserved vector table), usable directly in
                      (    forth6809.asm):00103                                  ; comparisons or as a memory operand, unlike
                      (    forth6809.asm):00104                                  ; the previous $10000 definition
     FFF0             (    forth6809.asm):00105         VECTORS  EQU  $FFF0
     FFA4             (    forth6809.asm):00106         INITCODE EQU  $FFA4     ; was $FFA9 - shifted down 3 bytes, per
                      (    forth6809.asm):00107                                  ; explicit request, to make room for the
                      (    forth6809.asm):00108                                  ; UNITTESTS call site's own fix (below):
                      (    forth6809.asm):00109                                  ; that site now always emits exactly 3 bytes
                      (    forth6809.asm):00110                                  ; (either the real JSR TSTRUNNER, or 3 NOPs
                      (    forth6809.asm):00111                                  ; as a placeholder when the test framework is
                      (    forth6809.asm):00112                                  ; excluded), so COLDSTRT's total size no
                      (    forth6809.asm):00113                                  ; longer depends on UNITTESTS at all -
                      (    forth6809.asm):00114                                  ; previously it did (JSR TSTRUNNER only
                      (    forth6809.asm):00115                                  ; existed when included, with nothing emitted
                      (    forth6809.asm):00116                                  ; when excluded - using this file's original,
                      (    forth6809.asm):00117                                  ; since-reversed UNITTESTS convention at the
                      (    forth6809.asm):00118                                  ; time this fix was made), meaning INITCODE's
                      (    forth6809.asm):00119                                  ; fixed position here could be correct for
                      (    forth6809.asm):00120                                  ; one setting and wrong for the other, risking
                      (    forth6809.asm):00121                                  ; an overflow into VECTORS when tests were
                      (    forth6809.asm):00122                                  ; compiled in. Prior
                      (    forth6809.asm):00123                                  ; history: was $FFA2 - shifted up 7 bytes to
                      (    forth6809.asm):00124                                  ; reduce the overlap with BASECODE's nominal
                      (    forth6809.asm):00125                                  ; end ($FFB4) from 19 bytes to 12 - improved,
                      (    forth6809.asm):00126                                  ; not resolved. CORRECTED: INITCODE's real
                      (    forth6809.asm):00127                                  ; content is 71 bytes ($47), confirmed by an
                      (    forth6809.asm):00128                                  ; actual assembler run - not the 78-byte
                      (    forth6809.asm):00129                                  ; manual estimate relied on for several
                      (    forth6809.asm):00130                                  ; turns, which was wrong by 7 bytes. That
                      (    forth6809.asm):00131                                  ; 71-byte figure was measured with the old
                      (    forth6809.asm):00132                                  ; structure (test framework excluded emitting
                      (    forth6809.asm):00133                                  ; 0 bytes for
                      (    forth6809.asm):00134                                  ; the TSTRUNNER call site) - with the fix
                      (    forth6809.asm):00135                                  ; above, that site now always emits 3 bytes
                      (    forth6809.asm):00136                                  ; either way, so real content is reasoned to
                      (    forth6809.asm):00137                                  ; be 74 bytes now (71+3), not yet re-measured
                      (    forth6809.asm):00138                                  ; by a real assembler run. At $FFA6, that
                      (    forth6809.asm):00139                                  ; reasoned end is $FFEF - unchanged, since
                      (    forth6809.asm):00140                                  ; the 3-byte shift in INITCODE's own start
                      (    forth6809.asm):00141                                  ; and the 3-byte growth in content offset
                      (    forth6809.asm):00142                                  ; exactly - still one byte below VECTORS, if
                      (    forth6809.asm):00143                                  ; the reasoning above holds; confirm on
                      (    forth6809.asm):00144                                  ; assembly. A prior turn claimed this general
                      (    forth6809.asm):00145                                  ; shift created a new 7-byte VECTORS overlap;
                      (    forth6809.asm):00146                                  ; that was based on the incorrect 78-byte
                      (    forth6809.asm):00147                                  ; estimate and was wrong - retracted here. The
                      (    forth6809.asm):00148                                  ; BASECODE overlap (12 bytes against its
                      (    forth6809.asm):00149                                  ; nominal budget) is separate and unaffected
                      (    forth6809.asm):00150                                  ; by this correction; not resolved. See the
                      (    forth6809.asm):00151                                  ; open-items checklist.
                      (    forth6809.asm):00152                                  ;
                      (    forth6809.asm):00153                                  ; UPDATE: shifted down a further 2 bytes,
                      (    forth6809.asm):00154                                  ; $FFA6 -> $FFA4, confirmed working by the
                      (    forth6809.asm):00155                                  ; user against a real assembler run. Reason:
                      (    forth6809.asm):00156                                  ; COLDSTRT's own interrupt-mask bug fix
                      (    forth6809.asm):00157                                  ; (ANDCC #$AF, added right after JSR
                      (    forth6809.asm):00158                                  ; INITSERIAL - see COLDSTRT's own comment)
                      (    forth6809.asm):00159                                  ; is a 2-byte instruction, growing COLDSTRT's
                      (    forth6809.asm):00160                                  ; total size by exactly that much; INITCODE's
                      (    forth6809.asm):00161                                  ; own fixed budget against VECTORS needed the
                      (    forth6809.asm):00162                                  ; same 2 bytes back to stay within it.
                      (    forth6809.asm):00163         ;BASECODE EQU  $DE2E     ; was $DE5E ($DE7A, $DEEA, $DF6A, $DF8A, $DFCA,
                      (    forth6809.asm):00164         ;BASECODE EQU  $DD2E     ; was $DE5E ($DE7A, $DEEA, $DF6A, $DF8A, $DFCA,
                      (    forth6809.asm):00165         ;BASECODE EQU  $DD3A     ; shifted up $0C (12 bytes) from $DD2E: BASEDICT
                      (    forth6809.asm):00166                                  ; grew by :NONAME's header entry (FCB + the
                      (    forth6809.asm):00167                                  ; 7-char name + two FDBs = 12 bytes), which a
                      (    forth6809.asm):00168                                  ; byte-count check mistakenly said still fit
                      (    forth6809.asm):00169                                  ; under the old BASECODE address (an error in
                      (    forth6809.asm):00170                                  ; that count, not in BASEDICT's real size) -
                      (    forth6809.asm):00171                                  ; actually assembling showed BASEDICT's real
                      (    forth6809.asm):00172                                  ; content overflowing $DD2E by 3 bytes. $DD3A
                      (    forth6809.asm):00173                                  ; left 9 bytes of margin.
     DD54             (    forth6809.asm):00174         BASECODE EQU  $DD54     ; shifted up another $0E (14 bytes) from $DD46:
                      (    forth6809.asm):00175                                  ; BASEDICT grew again by H_XCOMPILE's header
                      (    forth6809.asm):00176                                  ; entry (FCB + the 9-char name "[COMPILE]" +
                      (    forth6809.asm):00177                                  ; two FDBs = 14 bytes), added to give the new
                      (    forth6809.asm):00178                                  ; [COMPILE] word (see XCOMPILE, section 13) a
                      (    forth6809.asm):00179                                  ; dictionary entry. Same 9-byte margin as
                      (    forth6809.asm):00180                                  ; before this entry was added, assuming that
                      (    forth6809.asm):00181                                  ; margin was still accurate going in - not
                      (    forth6809.asm):00182                                  ; reverified by a real assembler run yet (no
                      (    forth6809.asm):00183                                  ; lwasm/lwtools available in this environment);
                      (    forth6809.asm):00184                                  ; confirm on assembly before relying on it.
                      (    forth6809.asm):00185         ;BASECODE EQU  $DD46    ; shifted up another $0C (12 bytes) from $DD3A:
                      (    forth6809.asm):00186                                  ; BASEDICT grew again by H_TONUMBER's header
                      (    forth6809.asm):00187                                  ; entry (same shape as :NONAME's - FCB + a
                      (    forth6809.asm):00188                                  ; 7-char name + two FDBs = 12 bytes), added to
                      (    forth6809.asm):00189                                  ; give >NUMBER a dictionary entry (it had working
                      (    forth6809.asm):00190                                  ; code but was unreachable by name). Using the
                      (    forth6809.asm):00191                                  ; corrected 5-bytes-per-entry-overhead formula
                      (    forth6809.asm):00192                                  ; this time (not the 4-byte one that caused the
                      (    forth6809.asm):00193                                  ; earlier $DD2E mistake): same 9-byte margin as
                      (    forth6809.asm):00194                                  ; before this entry was added.
                      (    forth6809.asm):00195                                  ; Prior history (pre-:NONAME): was $DE5E
                      (    forth6809.asm):00196                                  ; ($DE7A, $DEEA, $DF6A, $DF8A, $DFCA, $DFDA,
                      (    forth6809.asm):00197                                  ; $DFEA, $E02A before that) - shifted down a
                      (    forth6809.asm):00198                                  ; further $30 (48 bytes) that time.
                      (    forth6809.asm):00199                                  ; Reason: IRQH was rewritten for symmetry
                      (    forth6809.asm):00200                                  ; between its RX/TX halves and single-point-
                      (    forth6809.asm):00201                                  ; of-exit (all paths RTI through IRQDONE),
                      (    forth6809.asm):00202                                  ; and gained new FE/OVRN/PE receiver-error
                      (    forth6809.asm):00203                                  ; counting (SR_FE/SR_OVRN/SR_PE, tested from
                      (    forth6809.asm):00204                                  ; the same ACIASR read, before ACIADR is
                      (    forth6809.asm):00205                                  ; read, incrementing FECOUNT/OVRNCOUNT/
                      (    forth6809.asm):00206                                  ; PECOUNT and discarding the byte rather than
                      (    forth6809.asm):00207                                  ; storing it in INBUF when any is flagged) -
                      (    forth6809.asm):00208                                  ; both add code, and the single-exit style
                      (    forth6809.asm):00209                                  ; costs extra bytes/branches versus falling
                      (    forth6809.asm):00210                                  ; through. Value provided by the user
                      (    forth6809.asm):00211                                  ; directly; not independently re-derived or
                      (    forth6809.asm):00212                                  ; re-verified here. Confirm on assembly/MAME
                      (    forth6809.asm):00213                                  ; rather than trust a static estimate.
                      (    forth6809.asm):00214                                  ;
                      (    forth6809.asm):00215                                  ; Earlier history, preserved below in order:
                      (    forth6809.asm):00216                                  ;
                      (    forth6809.asm):00217                                  ; UPDATE: was $DE7A - shifted down a
                      (    forth6809.asm):00218                                  ; further $70 (112 bytes) at that point. Unlike every
                      (    forth6809.asm):00219                                  ; earlier shift in this chain (each resolving
                      (    forth6809.asm):00220                                  ; a memory-map overlap from reorganizing
                      (    forth6809.asm):00221                                  ; other regions), this one is for a different
                      (    forth6809.asm):00222                                  ; reason: SERIALPOLL=0 (interrupt-driven ACIA
                      (    forth6809.asm):00223                                  ; I/O, IRQH servicing INBUF/OUTBUF ring
                      (    forth6809.asm):00224                                  ; buffers with RTS/CTS flow control) is
                      (    forth6809.asm):00225                                  ; genuinely larger code than the SERIALPOLL=1
                      (    forth6809.asm):00226                                  ; polling path it replaces, and the two are
                      (    forth6809.asm):00227                                  ; mutually exclusive (IFEQ/ELSE/ENDC on the
                      (    forth6809.asm):00228                                  ; same flag, never both assembled at once) -
                      (    forth6809.asm):00229                                  ; but BASECODE's own budget was only ever
                      (    forth6809.asm):00230                                  ; sized against the polling path's smaller
                      (    forth6809.asm):00231                                  ; footprint, so selecting SERIALPOLL=0
                      (    forth6809.asm):00232                                  ; collided against BASEDICT below. Value
                      (    forth6809.asm):00233                                  ; provided by the user directly to resolve
                      (    forth6809.asm):00234                                  ; that collision; not independently re-
                      (    forth6809.asm):00235                                  ; derived or re-verified here. Confirm on
                      (    forth6809.asm):00236                                  ; assembly/MAME rather than trust a static
                      (    forth6809.asm):00237                                  ; estimate. See the open-items checklist.
                      (    forth6809.asm):00238                                  ;
                      (    forth6809.asm):00239                                  ; UPDATE: shifted down a further $1C (28
                      (    forth6809.asm):00240                                  ; bytes), $DE7A -> $DE5E, confirmed working
                      (    forth6809.asm):00241                                  ; by the user against a real assembler run.
                      (    forth6809.asm):00242                                  ; Reason: the ECHOEMIT non-blocking-echo fix
                      (    forth6809.asm):00243                                  ; (see ACCEPT's own comment) added a new
                      (    forth6809.asm):00244                                  ; routine to the interrupt-driven code path,
                      (    forth6809.asm):00245                                  ; growing its total size by that much; also
                      (    forth6809.asm):00246                                  ; added, in the same change: a FILL directive
                      (    forth6809.asm):00247                                  ; right before SECTION 1 (VECTORS), to stop
                      (    forth6809.asm):00248                                  ; the assembler from omitting the gap between
                      (    forth6809.asm):00249                                  ; INITCODE and VECTORS when generating the
                      (    forth6809.asm):00250                                  ; raw .bin file.
                      (    forth6809.asm):00251         ;BASEDICT EQU  $D643     ; was $D673 ($D68F, $D6FF, $D77F, $D79F, $D7DF,
     D543             (    forth6809.asm):00252         BASEDICT EQU  $D543     ; was $D673 ($D68F, $D6FF, $D77F, $D79F, $D7DF,
                      (    forth6809.asm):00253                                  ; $D7EF, $D7FF, $D83F before that) - shifted
                      (    forth6809.asm):00254                                  ; down the same further $30 (48 bytes) as
                      (    forth6809.asm):00255                                  ; BASECODE above, for the same reason (the
                      (    forth6809.asm):00256                                  ; rewritten, symmetric/single-exit IRQH plus
                      (    forth6809.asm):00257                                  ; the new FE/OVRN/PE receiver-error counting -
                      (    forth6809.asm):00258                                  ; see BASECODE's own comment for the full
                      (    forth6809.asm):00259                                  ; explanation). Value provided by the user
                      (    forth6809.asm):00260                                  ; directly; not independently re-derived or
                      (    forth6809.asm):00261                                  ; re-verified here. Confirm on assembly/MAME
                      (    forth6809.asm):00262                                  ; rather than trust a static estimate.
                      (    forth6809.asm):00263                                  ;
                      (    forth6809.asm):00264                                  ; Earlier history, preserved below in order:
                      (    forth6809.asm):00265                                  ;
                      (    forth6809.asm):00266                                  ; UPDATE: shifted down the same $70 (112 bytes)
                      (    forth6809.asm):00267                                  ; as BASECODE above, at that point, for the
                      (    forth6809.asm):00268                                  ; same reason (making room for SERIALPOLL=0's
                      (    forth6809.asm):00269                                  ; larger, interrupt-driven code path - see
                      (    forth6809.asm):00270                                  ; BASECODE's own comment for the full
                      (    forth6809.asm):00271                                  ; explanation). Value provided by the user
                      (    forth6809.asm):00272                                  ; directly; not independently re-derived or
                      (    forth6809.asm):00273                                  ; re-verified here. Confirm on assembly/MAME
                      (    forth6809.asm):00274                                  ; rather than trust a static estimate. See the
                      (    forth6809.asm):00275                                  ; open-items checklist.
                      (    forth6809.asm):00276                                  ;
                      (    forth6809.asm):00277                                  ; UPDATE: shifted down the same further $1C
                      (    forth6809.asm):00278                                  ; (28 bytes) as BASECODE above, $D68F -> $D673,
                      (    forth6809.asm):00279                                  ; same reason and same confirmation - see
                      (    forth6809.asm):00280                                  ; BASECODE's own comment for the full
                      (    forth6809.asm):00281                                  ; explanation.
     C000             (    forth6809.asm):00282         INOUT    EQU  $C000     ; was $DF00 - moved so INOUT (256 B) sits
                      (    forth6809.asm):00283                                  ; directly below USROMSTRT ($C100), contiguous,
                      (    forth6809.asm):00284                                  ; no gap. This also resolves the INOUT portion
                      (    forth6809.asm):00285                                  ; of the collision flagged when BASEDICT moved
                      (    forth6809.asm):00286                                  ; to $D85D: INOUT no longer overlaps BASEDICT
                      (    forth6809.asm):00287                                  ; ($D85D-$E011), since $C0FF < $D85D. The
                      (    forth6809.asm):00288                                  ; DSTACK and RSTACK portions of that same
                      (    forth6809.asm):00289                                  ; collision were NOT touched by this specific
                      (    forth6809.asm):00290                                  ; change, but were resolved separately when
                      (    forth6809.asm):00291                                  ; those two regions moved (see below). This
                      (    forth6809.asm):00292                                  ; move ALSO overlapped APPCODE at the time
                      (    forth6809.asm):00293                                  ; ($7000-$D7FF then) - since resolved too, when
                      (    forth6809.asm):00294                                  ; APPCODE moved down $2000 (see below).
     C0FF             (    forth6809.asm):00295         INOUTEND EQU  INOUT+$FF
     BFFF             (    forth6809.asm):00296         RSTACK   EQU  $BFFF     ; was $BEFF - occupied range is $BD00-$BFFF
                      (    forth6809.asm):00297                                  ; (768 bytes, unchanged size). RESOLVED: once a
                      (    forth6809.asm):00298                                  ; 512-byte gap sat between this and DSTACK
                      (    forth6809.asm):00299                                  ; below; DSTACK moving up $200 closed it - now
                      (    forth6809.asm):00300                                  ; exactly contiguous, no gap
     BCFF             (    forth6809.asm):00301         DSTACK   EQU  $BCFF     ; was $BAFF - moved up $200. RESOLVED (both):
                      (    forth6809.asm):00302                                  ; occupied range is now $B900-$BCFF, which
                      (    forth6809.asm):00303                                  ; exactly matches CODETOP ($B900) as its true
                      (    forth6809.asm):00304                                  ; bottom - the 512-byte mismatch is gone - and
                      (    forth6809.asm):00305                                  ; is now exactly contiguous with RSTACK's
                      (    forth6809.asm):00306                                  ; bottom ($BD00), closing that gap too
     B900             (    forth6809.asm):00307         CODETOP  EQU  $B900     ; was $B800 - code space ceiling (data stack
                      (    forth6809.asm):00308                                  ; begins here). RESOLVED: this once no longer
                      (    forth6809.asm):00309                                  ; matched DSTACK's true occupied bottom (was
                      (    forth6809.asm):00310                                  ; $B700, a 512-byte mismatch) - now that DSTACK
                      (    forth6809.asm):00311                                  ; moved up $200 to $B900, CODETOP matches it
                      (    forth6809.asm):00312                                  ; exactly again
                      (    forth6809.asm):00313         
                      (    forth6809.asm):00314         ; ANS transient-region minimums (forth-standard.org/standard/usage,
                      (    forth6809.asm):00315         ; section 3.3.3.6 "Other transient regions"), verified against this
                      (    forth6809.asm):00316         ; system's actual layout and used to replace the bare "84" that used
                      (    forth6809.asm):00317         ; to sit directly inside PADW with a named, documented constant:
                      (    forth6809.asm):00318         ;   PADMINSIZE  - PAD's own scratch region, size in characters. WORD
                      (    forth6809.asm):00319         ;                 originally used a separate, fixed WORDBUF that
                      (    forth6809.asm):00320         ;                 happened to meet its own 33-character minimum
                      (    forth6809.asm):00321         ;                 exactly (WORDBUF's span up to where SIBUF used to
                      (    forth6809.asm):00322         ;                 begin was precisely 33 bytes, confirmed by address
                      (    forth6809.asm):00323         ;                 subtraction) - but WORD has since been redesigned
                      (    forth6809.asm):00324         ;                 (see below, and WORD itself in the Header/Compiling
                      (    forth6809.asm):00325         ;                 section) to use this same CODEHERE-to-PAD gap
                      (    forth6809.asm):00326         ;                 instead, matching the traditional fig-Forth layout,
                      (    forth6809.asm):00327         ;                 so WORDBUF itself is retired along with SIBUF.
                      (    forth6809.asm):00328         ;   HOLDMINSIZE - pictured numeric output buffer, size in characters,
                      (    forth6809.asm):00329         ;                 (2 * n) + 2 where n = bits per cell (16 here) = 34.
                      (    forth6809.asm):00330         ;                 LTNUM ("<#") anchors HLD to PADW's own return value
                      (    forth6809.asm):00331         ;                 and HOLD decrements before storing, so this buffer
                      (    forth6809.asm):00332         ;                 grows downward from PAD into the CODEHERE-to-PAD
                      (    forth6809.asm):00333         ;                 gap, not into PAD's own region above it - confirmed
                      (    forth6809.asm):00334         ;                 by tracing LTNUM/HOLD. The gap must be at least
                      (    forth6809.asm):00335         ;                 HOLDMINSIZE wide for this to fit.
                      (    forth6809.asm):00336         ; PADOFFSET (below) satisfies both: it equals PADMINSIZE, which is
                      (    forth6809.asm):00337         ; itself well above HOLDMINSIZE (128 vs 34, 94 bytes of margin) - kept
                      (    forth6809.asm):00338         ; as a single, larger-than-either-strict-minimum offset rather than
                      (    forth6809.asm):00339         ; two separately-tuned numbers, matching "larger than minimum is
                      (    forth6809.asm):00340         ; satisfactory" for a small system.
                      (    forth6809.asm):00341         ;
                      (    forth6809.asm):00342         ; PADMINSIZE was raised from the original 84 to 128 after the 84
                      (    forth6809.asm):00343         ; value was found to cap WORDMAXCHARS (below) at 46 characters,
                      (    forth6809.asm):00344         ; silently truncating any S" string longer than that (WORD would
                      (    forth6809.asm):00345         ; stop scanning at the cap without having seen the closing '"',
                      (    forth6809.asm):00346         ; leaving unconsumed text to be misparsed as a bogus next word).
                      (    forth6809.asm):00347         ; The longest S" strings actually in use (ans_tests/ttester.fs) run
                      (    forth6809.asm):00348         ; to 62 characters, so 128 leaves headroom well beyond that. PAD is
                      (    forth6809.asm):00349         ; computed dynamically as CODEHERE+PADOFFSET (see PADW) rather than
                      (    forth6809.asm):00350         ; living at a fixed address, so this change carries no collision
                      (    forth6809.asm):00351         ; risk with anything else in memory - the only cost is a small,
                      (    forth6809.asm):00352         ; negligible reduction in dictionary headroom before CODEHERE+
                      (    forth6809.asm):00353         ; PADOFFSET could reach CODETOP.
     0080             (    forth6809.asm):00354         PADMINSIZE  EQU 128
     0021             (    forth6809.asm):00355         WORDMINSIZE EQU 33
     0022             (    forth6809.asm):00356         HOLDMINSIZE EQU 34
     0080             (    forth6809.asm):00357         PADOFFSET   EQU PADMINSIZE  ; CODEHERE-to-PAD gap; also governs how
                      (    forth6809.asm):00358                                     ; much of PAD's own upward-growing region
                      (    forth6809.asm):00359                                     ; (now used by both the user and, per this
                      (    forth6809.asm):00360                                     ; change, interpreted-mode S" text) is
                      (    forth6809.asm):00361                                     ; guaranteed available before something
                      (    forth6809.asm):00362                                     ; else might claim it
     005A             (    forth6809.asm):00363         WORDMAXCHARS EQU PADOFFSET-HOLDMINSIZE-1-3  ; max characters WORD can
                      (    forth6809.asm):00364                                     ; scan when using the CODEHERE-to-PAD gap
                      (    forth6809.asm):00365                                     ; (see WORD, below) - reserves HOLDMINSIZE
                      (    forth6809.asm):00366                                     ; bytes at the PAD end for the pictured
                      (    forth6809.asm):00367                                     ; numeric output buffer (which grows
                      (    forth6809.asm):00368                                     ; downward from PAD into this same gap),
                      (    forth6809.asm):00369                                     ; using the remaining space at the
                      (    forth6809.asm):00370                                     ; CODEHERE end, less 1 byte for WORD's own
                      (    forth6809.asm):00371                                     ; leading count byte, less a further 3
                      (    forth6809.asm):00372                                     ; bytes for the worst case: S"/."/ABORT"
                      (    forth6809.asm):00373                                     ; all reserve 3 bytes ahead of CODEHERE
                      (    forth6809.asm):00374                                     ; before calling WORD (see SQUOTE/
                      (    forth6809.asm):00375                                     ; DOTQUOTE/AQSTOK), so their text lands 3
                      (    forth6809.asm):00376                                     ; bytes further into this same gap than
                      (    forth6809.asm):00377                                     ; plain WORD-parsing (e.g. a dictionary
                      (    forth6809.asm):00378                                     ; name for FIND) does. Sized for that
                      (    forth6809.asm):00379                                     ; worst case uniformly, rather than giving
                      (    forth6809.asm):00380                                     ; different callers different effective
                      (    forth6809.asm):00381                                     ; limits - simpler and safer than trying
                      (    forth6809.asm):00382                                     ; to track which caller needs which cap.
                      (    forth6809.asm):00383                                     ; 128-34-1-3 = 90.
                      (    forth6809.asm):00384         
     7000             (    forth6809.asm):00385         APPCODE  EQU  $7000     ; was $5000 - back to its original address.
                      (    forth6809.asm):00386                                  ; RESOLVED: this once overlapped DSTACK's true
                      (    forth6809.asm):00387                                  ; range by 512 bytes ($B700-$B8FF), a direct
                      (    forth6809.asm):00388                                  ; consequence of the CODETOP/DSTACK mismatch -
                      (    forth6809.asm):00389                                  ; now that DSTACK moved and CODETOP matches it
                      (    forth6809.asm):00390                                  ; again, APPCODE's nominal range (up to
                      (    forth6809.asm):00391                                  ; CODETOP-1) no longer reaches into DSTACK
     2000             (    forth6809.asm):00392         APPDICT  EQU  $2000     ; was $015B - moved up, size unchanged (20133
                      (    forth6809.asm):00393                                  ; bytes, now $2000-$6EA4). REDUCED BUT NOT
                      (    forth6809.asm):00394                                  ; RESOLVED: still overlaps APPVARS below by 347
                      (    forth6809.asm):00395                                  ; bytes ($2000-$215A), though SIBUF/WORDBUF/
                      (    forth6809.asm):00396                                  ; TIBBUF/OUTBUF (swallowed by the previous
                      (    forth6809.asm):00397                                  ; APPDICT address) are now clear. See the
                      (    forth6809.asm):00398                                  ; open-items checklist
     021B             (    forth6809.asm):00399         APPVARS  EQU  $021B     ; grown from 256 to 8000 bytes (end now $215A,
                      (    forth6809.asm):00400                                  ; was $031A), taking the space directly from
                      (    forth6809.asm):00401                                  ; APPDICT above it; start address unchanged.
                      (    forth6809.asm):00402                                  ; That 8000-byte figure describes the original
                      (    forth6809.asm):00403                                  ; intent, not the current actual usable size -
                      (    forth6809.asm):00404                                  ; see APPVARSEND below, which now tracks
                      (    forth6809.asm):00405                                  ; APPDICT's real position instead
     1FFF             (    forth6809.asm):00406         APPVARSEND EQU APPDICT-1 ; was APPVARS+8000 ($215B) - now derives
                      (    forth6809.asm):00407                                  ; directly from wherever APPDICT actually
                      (    forth6809.asm):00408                                  ; starts, currently $1FFF (7653 bytes usable,
                      (    forth6809.asm):00409                                  ; down from the static 8000). Self-correcting:
                      (    forth6809.asm):00410                                  ; this can no longer go stale if APPDICT moves
                      (    forth6809.asm):00411                                  ; again, unlike the previous fixed-size
                      (    forth6809.asm):00412                                  ; definition. VUNUSEDW (below) is unchanged -
                      (    forth6809.asm):00413                                  ; it already computed against APPVARSEND
                      (    forth6809.asm):00414         ; SIBUF EQU $01FB retired - was interpreted-mode S"'s fixed, dedicated
                      (    forth6809.asm):00415         ; 32-byte scratch buffer; S" now writes into PAD instead (see SQINTERP,
                      (    forth6809.asm):00416         ; String Words section), which is both larger and correctly per-call
                      (    forth6809.asm):00417         ; rather than a single buffer shared by every S" call in a session.
                      (    forth6809.asm):00418         ; The $01FB-$021A range it used to occupy is left unclaimed rather
                      (    forth6809.asm):00419         ; than reassigned - APPVARS below still starts at its own, unchanged
                      (    forth6809.asm):00420         ; address ($021B) - to avoid any risk to the rest of this carefully-
                      (    forth6809.asm):00421         ; verified memory map for the sake of reclaiming 32 bytes on a system
                      (    forth6809.asm):00422         ; with headroom to spare; reclaiming it would need APPVARS to move,
                      (    forth6809.asm):00423         ; a separate, larger change not undertaken here.
                      (    forth6809.asm):00424         ; WORDBUF EQU $01DA also retired, for the same reason as SIBUF above -
                      (    forth6809.asm):00425         ; WORD now uses the CODEHERE-to-PAD gap directly (see WORD in the
                      (    forth6809.asm):00426         ; Header/Compiling section, and WORDMAXCHARS above) rather than a
                      (    forth6809.asm):00427         ; fixed, separately-allocated buffer capped at 31 characters. The
                      (    forth6809.asm):00428         ; $01DA-$01FA range it used to occupy is left unclaimed, same
                      (    forth6809.asm):00429         ; reasoning as SIBUF's retirement above - EXCEPT for its first 3
                      (    forth6809.asm):00430         ; bytes, now claimed below for FECOUNT/OVRNCOUNT/PECOUNT (IRQH's
                      (    forth6809.asm):00431         ; receiver-error counters); $01DD-$01FA (30 bytes) is still
                      (    forth6809.asm):00432         ; unclaimed, and SIBUF's own $01FB-$021A range is untouched.
                      (    forth6809.asm):00433         
                      (    forth6809.asm):00434         ;TIBBUF   EQU  $018A     ; was $0284
     0106             (    forth6809.asm):00435         TIBBUF   EQU  $0106      ; was $018A
     0050             (    forth6809.asm):00436         TIBBUFL  EQU  80         ; $50, next free address is 
                      (    forth6809.asm):00437         
     0000             (    forth6809.asm):00438         GLOBALS  EQU  $0000
                      (    forth6809.asm):00439         
     BD00             (    forth6809.asm):00440         SP0      EQU  DSTACK+1
     C000             (    forth6809.asm):00441         RP0      EQU  RSTACK+1
                      (    forth6809.asm):00442         
                      (    forth6809.asm):00443         ; ------------------------------------------------------------
                      (    forth6809.asm):00444         ; SERIALPOLL - conditional-assembly switch for serial I/O.
                      (    forth6809.asm):00445         ; 1 (default): KEY/KEYQ/EMIT poll ACIASR directly, no interrupts,
                      (    forth6809.asm):00446         ; no ring buffers, no RTS/CTS handshaking - IRQH is a harmless RTI
                      (    forth6809.asm):00447         ; stub, matching the other unused vectors (NMIH/FIRQH/SWI2H/
                      (    forth6809.asm):00448         ; SWI3H). 0: the original interrupt-driven implementation, with
                      (    forth6809.asm):00449         ; INBUF/OUTBUF ring buffers serviced by IRQH and RTS-based flow
                      (    forth6809.asm):00450         ; control via INFILL/RTSCHECKHI/RTSCHECKLO. Uses LWASM's IFEQ/
                      (    forth6809.asm):00451         ; ELSE/ENDC (a numeric-expression test, not IFDEF/IFNDEF, since
                      (    forth6809.asm):00452         ; this is a value to compare, not a symbol's mere presence).
                      (    forth6809.asm):00453         ;
                      (    forth6809.asm):00454         ; Was a fixed EQU, meaning it could only ever be changed by
                      (    forth6809.asm):00455         ; editing this file directly - unlike UNITTESTS/TSTSELECTOR
                      (    forth6809.asm):00456         ; below, a plain EQU cannot be overridden via lwasm's own -D
                      (    forth6809.asm):00457         ; command-line option (EQU is a one-time, permanent binding;
                      (    forth6809.asm):00458         ; -D's own documented behavior is to predefine a symbol "as
                      (    forth6809.asm):00459         ; though...defined using the SET directive," which a later EQU
                      (    forth6809.asm):00460         ; for the same symbol does not honor). Switched to the same
                      (    forth6809.asm):00461         ; IFNDEF/SET/ENDC pattern as UNITTESTS/TSTSELECTOR immediately
                      (    forth6809.asm):00462         ; below for exactly that reason: SERIALPOLL can now be selected
                      (    forth6809.asm):00463         ; at build time with -DSERIALPOLL=0 (interrupt-driven) or
                      (    forth6809.asm):00464         ; -DSERIALPOLL=1 (polling, same as omitting -D entirely, since 1
                      (    forth6809.asm):00465         ; remains the fallback default here).
                      (    forth6809.asm):00466         ; ------------------------------------------------------------
                      (    forth6809.asm):00467                    IFNDEF SERIALPOLL
0000                  (    forth6809.asm):00468         SERIALPOLL SET 1   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00469                    ENDC
                      (    forth6809.asm):00470         
                      (    forth6809.asm):00471         ; ------------------------------------------------------------
                      (    forth6809.asm):00472         ; ACIA (6850) constants - the chip sits at INOUT+8, not at the
                      (    forth6809.asm):00473         ; base of the I/O block, leaving INOUT+0..INOUT+7 free for other
                      (    forth6809.asm):00474         ; memory-mapped devices sharing this 256-byte region
                      (    forth6809.asm):00475         ; ------------------------------------------------------------
     C008             (    forth6809.asm):00476         ACIA     EQU  INOUT+8
     C008             (    forth6809.asm):00477         ACIACR   EQU  ACIA
     C008             (    forth6809.asm):00478         ACIASR   EQU  ACIA
     C009             (    forth6809.asm):00479         ACIADR   EQU  ACIA+1
                      (    forth6809.asm):00480         
                      (    forth6809.asm):00481         ; ACIA Status Register Bits
                      (    forth6809.asm):00482         
     0080             (    forth6809.asm):00483         SR_IRQ   EQU %10000000  ; ($80) (Interrupt Request)
     0001             (    forth6809.asm):00484         SR_RDRF  EQU %00000001  ; ($01) (Receive Data Register Full)
     0002             (    forth6809.asm):00485         SR_TDRE  EQU %00000010  ; ($02) (Transmit Data Register Empty)
     0008             (    forth6809.asm):00486         SR_CTS   EQU %00001000  ; ($08) (Clear to send is blocking transmit.)
                      (    forth6809.asm):00487         
                      (    forth6809.asm):00488         ; Errors only meaningful together with RDRF
     0010             (    forth6809.asm):00489         SR_FE    EQU %00010000  ; ($10) (Framing Error)
     0020             (    forth6809.asm):00490         SR_OVRN  EQU %00100000  ; ($20) (Overrun Error)
     0040             (    forth6809.asm):00491         SR_PE    EQU %01000000  ; ($40) (Parity Error)
                      (    forth6809.asm):00492         
                      (    forth6809.asm):00493         ; ACIA Control Register Bits
                      (    forth6809.asm):00494         
     0003             (    forth6809.asm):00495         CR_RESET  EQU %00000011 ; ($03) (Master Reset mode)
     0095             (    forth6809.asm):00496         CR_BASE   EQU %10010101 ; ($95) (Rx Int Enabled, 8-N-1, /16 Clock)
     0095             (    forth6809.asm):00497         CR_RXON   EQU %10010101 ; ($95) (Rx Int Enabled, 8-N-1, /16 Clock)
     00B5             (    forth6809.asm):00498         CR_RXTX   EQU %10110101   ; ($B5) (Rx Int Enabled, Tx Int/RTS Control, 8-N-1, /16 Clock) -
                      (    forth6809.asm):00499                                    ; stray trailing "|" before this comment removed: a dangling
                      (    forth6809.asm):00500                                    ; bitwise-OR operator with nothing on its right, presumably a
                      (    forth6809.asm):00501                                    ; typo left over from editing. Left alone, lwasm's expression
                      (    forth6809.asm):00502                                    ; parser evidently tolerated it (whitespace before ";" likely
                      (    forth6809.asm):00503                                    ; meant the "|" and comment were never actually joined into one
                      (    forth6809.asm):00504                                    ; malformed expression token) - but it was never intentional and
                      (    forth6809.asm):00505                                    ; is worth removing before it causes a real problem elsewhere.
     0015             (    forth6809.asm):00506         CR_POLL   EQU %00010101 ; ($15) (All Ints Disabled, Polling mode, 8-N-1, /16 Clock)
     00D5             (    forth6809.asm):00507         CR_RTSHI  EQU %11010101 ; ($D5) (RTS High, Transmit Interrupt Disabled, 8-N-1, /16 Clock)                    
                      (    forth6809.asm):00508         
                      (    forth6809.asm):00509         ; CR_POLL
                      (    forth6809.asm):00510         
                      (    forth6809.asm):00511         ; bit7=0 (RX interrupt disabled), bits6-5=00 (RTS
                      (    forth6809.asm):00512         ; low, TX interrupt disabled) - CR_RXON ($95) with
                      (    forth6809.asm):00513         ; only the RX-interrupt-enable bit cleared. Used
                      (    forth6809.asm):00514         ; only when SERIALPOLL=1; RTS stays permanently
                      (    forth6809.asm):00515         ; low (asserted), since polling mode has no ring
                      (    forth6809.asm):00516         ; buffer to overflow and so needs no flow control
                      (    forth6809.asm):00517         
                      (    forth6809.asm):00518         ; CR_RTSHI
                      (    forth6809.asm):00519         
                      (    forth6809.asm):00520         ; bits6-5=10: RTS high, TX int disabled, RX int enabled -
                      (    forth6809.asm):00521         ; derived from CR_RXON ($95) with bits6-5 changed from
                      (    forth6809.asm):00522         ; 00 to 10; the ACIA has no combination offering RTS
                      (    forth6809.asm):00523         ; high AND TX interrupt enabled simultaneously (bits6-5
                      (    forth6809.asm):00524         ; only has 00/01/10/11, and only 01 enables TX interrupt,
                      (    forth6809.asm):00525         ; which always ties RTS low) - EMIT/IRQH's OUTCHAR must
                      (    forth6809.asm):00526         ; respect this and defer transmission while RTS is high
                      (    forth6809.asm):00527         
                      (    forth6809.asm):00528         ; Ring buffer control
     0176             (    forth6809.asm):00529         SERBUFCTL  EQU  $0176
     0180             (    forth6809.asm):00530         SERBUF     EQU  $0180     ; was $0200 - USER0/USER1 removed entirely (see
                      (    forth6809.asm):00531                                  ; below); the 4 buffers (SERBUF's 4-byte index
                      (    forth6809.asm):00532                                  ; block, INBUF, OUTBUF, TIBBUF) still sit
                      (    forth6809.asm):00533                                  ; contiguously right after MVSCRATCH, with no
                      (    forth6809.asm):00534                                  ; gap - WORDBUF and SIBUF, which used to sit
                      (    forth6809.asm):00535                                  ; right after TIBBUF and WORDBUF respectively
                      (    forth6809.asm):00536                                  ; (closing what was once an 11-byte gap,
                      (    forth6809.asm):00537                                  ; $02F5-$02FF, in an earlier address scheme),
                      (    forth6809.asm):00538                                  ; are now both retired (see above) rather than
                      (    forth6809.asm):00539                                  ; part of this contiguous run
     0040             (    forth6809.asm):00540         INBUFSZ  EQU  64
     0040             (    forth6809.asm):00541         OUTBUFSZ EQU  64
     0030             (    forth6809.asm):00542         INHIWATER EQU 48         ; input ring fill level (of 64) at/above which RTS is
                      (    forth6809.asm):00543                                  ; asserted high, telling the remote device to pause
     0010             (    forth6809.asm):00544         INLOWATER EQU 16         ; fill level at/below which RTS is reasserted low;
                      (    forth6809.asm):00545                                  ; deliberately well below INHIWATER (hysteresis) so
                      (    forth6809.asm):00546                                  ; RTS doesn't chatter right at a single threshold
                      (    forth6809.asm):00547         
                      (    forth6809.asm):00548         ; Input control
                      (    forth6809.asm):00549         ; /RTS flag states
     0000             (    forth6809.asm):00550         INACCEPT      EQU $00
     00FF             (    forth6809.asm):00551         INREJECT      EQU $FF
                      (    forth6809.asm):00552         
                      (    forth6809.asm):00553         ; Output control
                      (    forth6809.asm):00554         ; Transmit buffer interrupt active flag states.
     0000             (    forth6809.asm):00555         OUTIDLE       EQU $00
     00FF             (    forth6809.asm):00556         OUTBUSY       EQU $FF
                      (    forth6809.asm):00557         
                      (    forth6809.asm):00558         ; Software (in-band) flow control - polling build only. The
                      (    forth6809.asm):00559         ; interrupt-driven build has real RTS/CTS hardware flow control
                      (    forth6809.asm):00560         ; already (CHKHI/CHKLO/UPDATE_RTS); polling mode has no ring
                      (    forth6809.asm):00561         ; buffer and no hardware handshaking at all, so it needs its own
                      (    forth6809.asm):00562         ; substitute - see ACCEPT and PUTXON/PUTXOFF.
     0011             (    forth6809.asm):00563         XONCH         EQU $11
     0013             (    forth6809.asm):00564         XOFFCH        EQU $13
                      (    forth6809.asm):00565         
                      (    forth6809.asm):00566         ; ------------------------------------------------------------
                      (    forth6809.asm):00567         ; Flag / opcode constants
                      (    forth6809.asm):00568         ; ------------------------------------------------------------
     FFFF             (    forth6809.asm):00569         TRUEV    EQU  $FFFF
     0000             (    forth6809.asm):00570         FALSEV   EQU  $0000
     00BD             (    forth6809.asm):00571         OPJSR    EQU  $BD
     0039             (    forth6809.asm):00572         OPRTS    EQU  $39        ; used by section 3.8's control-flow test
                      (    forth6809.asm):00573                                  ; harness to terminate each compiled test
                      (    forth6809.asm):00574                                  ; snippet, compiled via CCOMMA
     0039             (    forth6809.asm):00575         RTSOPC   EQU  $39
                      (    forth6809.asm):00576         
                      (    forth6809.asm):00577         ; ------------------------------------------------------------
                      (    forth6809.asm):00578         ; Control-flow compile-time tags
                      (    forth6809.asm):00579         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00580         TAGFWD   EQU  1
     0002             (    forth6809.asm):00581         TAGBACK  EQU  2
     0003             (    forth6809.asm):00582         TAGDO    EQU  3
     0004             (    forth6809.asm):00583         TAGCASE  EQU  4
     0005             (    forth6809.asm):00584         TAGOF    EQU  5
     0006             (    forth6809.asm):00585         TAGENDOF EQU  6
     0007             (    forth6809.asm):00586         TAGQDO   EQU  7   ; ?DO's own pending zero-trip forward-branch marker,
                      (    forth6809.asm):00587                           ; distinct from TAGFWD - LOOP/PLUSLOOP peek past their
                      (    forth6809.asm):00588                           ; TAGDO frame for exactly this tag to decide whether
                      (    forth6809.asm):00589                           ; there's a ?DO patch waiting. Reusing TAGFWD for that
                      (    forth6809.asm):00590                           ; peek was a real bug: DO ... LOOP nested inside an
                      (    forth6809.asm):00591                           ; still-open IF/WHILE (which legitimately has its own
                      (    forth6809.asm):00592                           ; TAGFWD sitting in that exact spot) got its frame
                      (    forth6809.asm):00593                           ; mistaken for a ?DO patch and consumed by LOOP,
                      (    forth6809.asm):00594                           ; leaving the enclosing THEN/REPEAT to find the wrong
                      (    forth6809.asm):00595                           ; tag and throw -22. A plain DO never has anything
                      (    forth6809.asm):00596                           ; genuine for LOOP to find here, so nothing needs to
                      (    forth6809.asm):00597                           ; match TAGQDO in that case - the enclosing frame is
                      (    forth6809.asm):00598                           ; now left alone as it should be.
                      (    forth6809.asm):00599         
                      (    forth6809.asm):00600         ; ============================================================
                      (    forth6809.asm):00601         ; GLOBALS - real layout, applied. Every scratch/state cell
                      (    forth6809.asm):00602         ; referenced across the whole build now has a fixed address
                      (    forth6809.asm):00603         ; in page zero (DP = $00 at reset, set in COLDSTRT), laid out
                      (    forth6809.asm):00604         ; in RMB order below. Total: 256 of 256 bytes used - the page
                      (    forth6809.asm):00605         ; is fully packed. (DOESBEH and RTSSTATE were added in later
                      (    forth6809.asm):00606         ; passes, after this comment was first written with 253/256;
                      (    forth6809.asm):00607         ; they used up the last 3 bytes of headroom entirely.)
                      (    forth6809.asm):00608         ;
                      (    forth6809.asm):00609         ; SNEND, which appeared in the original placeholder list
                      (    forth6809.asm):00610         ; (documented under S"/."/SLITERAL/ABORT"'s string runtime),
                      (    forth6809.asm):00611         ; was dropped here: a full pass over every reference confirmed
                      (    forth6809.asm):00612         ; it is never actually read or written anywhere - SCNT/SPTR
                      (    forth6809.asm):00613         ; alone carry that runtime. CSAVE was removed earlier (see the
                      (    forth6809.asm):00614         ; COMMA/CODECOMMA history) and was never part of this layout.
                      (    forth6809.asm):00615         ; ============================================================
                      (    forth6809.asm):00616                  ORG   $0000        ; GLOBALS page - Direct Page (DP) set to $00 at reset

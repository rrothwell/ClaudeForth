FB98 272F             (    forth6809.asm):07779                     BEQ   ENVNOTFOUND
FB9A 3410             (    forth6809.asm):07780                     PSHS  X                 ; See bugfix: ENVQW.2
FB9C 3606             (    forth6809.asm):07781                     PSHU  D
FB9E EC02             (    forth6809.asm):07782                     LDD   2,X
FBA0 3606             (    forth6809.asm):07783                     PSHU  D
FBA2 DCF1             (    forth6809.asm):07784                     LDD   ENVADDR
FBA4 3606             (    forth6809.asm):07785                     PSHU  D
FBA6 DCEF             (    forth6809.asm):07786                     LDD   ENVLEN
FBA8 3606             (    forth6809.asm):07787                     PSHU  D
FBAA BDF5D4           (    forth6809.asm):07788                     JSR   COMPAREW
FBAD 3510             (    forth6809.asm):07789                     PULS  X
FBAF 3706             (    forth6809.asm):07790                     PULU  D
FBB1 10830000         (    forth6809.asm):07791                     CMPD  #0
FBB5 2704             (    forth6809.asm):07792                     BEQ   ENV2FOUND
FBB7 3008             (    forth6809.asm):07793                     LEAX  8,X               ; 8-byte entries
FBB9 20D7             (    forth6809.asm):07794                     BRA   ENV2LOOP
FBBB EC04             (    forth6809.asm):07795         ENV2FOUND:  LDD   4,X               ; low cell, pushed first
FBBD 3606             (    forth6809.asm):07796                     PSHU  D
FBBF EC06             (    forth6809.asm):07797                     LDD   6,X               ; high cell - pushed second/top
FBC1 3606             (    forth6809.asm):07798                     PSHU  D
FBC3 CCFFFF           (    forth6809.asm):07799                     LDD   #TRUEV

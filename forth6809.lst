                      (    forth6809.asm):04234         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04235         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04236         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04237         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04238         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04239         ; NUMLOOP
                      (    forth6809.asm):04240         ;    Inputs:
                      (    forth6809.asm):04241         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04242         ;    Outputs:
                      (    forth6809.asm):04243         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04244         ;        the count remaining
                      (    forth6809.asm):04245         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04246         ; ------------------------------------------------------------

                      (    forth6809.asm):07109                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):07110         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07111                  ORCC  #$50
FFA6 10CEC000         (    forth6809.asm):07112                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07113                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07114                  CLRA
FFAE 1F8B             (    forth6809.asm):07115                  TFR   A,DP
                      (    forth6809.asm):07116         

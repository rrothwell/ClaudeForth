                      (   unit_tests.asm):10297         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (   unit_tests.asm):10298         ; tests since several are combined into round-trip tests that
                      (   unit_tests.asm):10299         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (   unit_tests.asm):10300         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (   unit_tests.asm):10301         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (   unit_tests.asm):10302         ; sequential walk-through per region.
                      (   unit_tests.asm):10303         ;
                      (   unit_tests.asm):10304         ; MOVE is traced from its own code to genuinely choose its copy
                      (   unit_tests.asm):10305         ; direction by comparing src and dst addresses, delegating to
                      (   unit_tests.asm):10306         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (   unit_tests.asm):10307         ; specifically include both overlap directions (TSTMOVE2/
                      (   unit_tests.asm):10308         ; TSTMOVE3), each with its expected result hand-derived and
                      (   unit_tests.asm):10309         ; independently simulated in Python before writing the test, not
                      (   unit_tests.asm):10310         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (   unit_tests.asm):10311         ; ------------------------------------------------------------

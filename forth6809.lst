                      (    forth6809.asm):07498         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):07499         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):07500         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):07501         ; ------------------------------------------------------------
F9E2 BDF9F7           (    forth6809.asm):07502         NUMW:       JSR   UDDIGIT           ; ud1 is divided in place on the data stack
F9E5 810A             (    forth6809.asm):07503                     CMPA  #10
F9E7 2504             (    forth6809.asm):07504                     BLO   NDIGIT
F9E9 8B37             (    forth6809.asm):07505                     ADDA  #'A'-10
F9EB 2002             (    forth6809.asm):07506                     BRA   NHOLD

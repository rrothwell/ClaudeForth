F592                  (    forth6809.asm):21155         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):21156                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):21157                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):21158                                   ; characters and (worse) shared identically
                      (    forth6809.asm):21159                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):21160                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):21161                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):21162                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):21163                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):21164                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):21165                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):21166                                   ; testing/design decision: rather than give
                      (    forth6809.asm):21167                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):21168                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):21169                                   ; definition for stable storage instead - but
                      (    forth6809.asm):21170                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):21171                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):21172                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):21173                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):21174                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):21175                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):21176                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):21177                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):21178                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):21179                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):21180                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):21181                   JSR  PADW
F595 3710             (    forth6809.asm):21182                   PULU X

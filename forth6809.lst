D4CC 20B5             (    forth6809.asm):03563                     BRA   ILOOP
                      (    forth6809.asm):03564         
D4CE                  (    forth6809.asm):03565         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03566                                             ; ANS's (ud1) stack order directly.
D4CE DC00             (    forth6809.asm):03567                     LDD   STATE
D4D0 27B1             (    forth6809.asm):03568                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03569                                             ; nothing more to do
                      (    forth6809.asm):03570                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03571                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03572                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03573                     ; pop it aside first, freeing UDLO to be compiled first.
D4D2 3706             (    forth6809.asm):03574                     PULU  D
D4D4 DD1A             (    forth6809.asm):03575                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,

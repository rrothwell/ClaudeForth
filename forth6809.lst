C100                  (    forth6809.asm):02088         TSTTUCK:   STU   TSTU0
                      (    forth6809.asm):02089         
                      (    forth6809.asm):02090                    LDD   #TSTGUARD
                      (    forth6809.asm):02091                    PSHU  D
                      (    forth6809.asm):02092                    LDD   #TSTVAL1
                      (    forth6809.asm):02093                    PSHU  D
                      (    forth6809.asm):02094                    LDD   #TSTVAL2
                      (    forth6809.asm):02095                    PSHU  D
                      (    forth6809.asm):02096                    STU   TSTUB4
                      (    forth6809.asm):02097         
                      (    forth6809.asm):02098                    JSR   TUCK
                      (    forth6809.asm):02099         
                      (    forth6809.asm):02100                    STU   TSTUAF
                      (    forth6809.asm):02101         
                      (    forth6809.asm):02102                    PULU  D
                      (    forth6809.asm):02103                    CMPD  #TSTVAL2
                      (    forth6809.asm):02104                    BNE   TKFAIL
                      (    forth6809.asm):02105                    PULU  D
                      (    forth6809.asm):02106                    CMPD  #TSTVAL1
                      (    forth6809.asm):02107                    BNE   TKFAIL
                      (    forth6809.asm):02108                    PULU  D
                      (    forth6809.asm):02109                    CMPD  #TSTVAL2
                      (    forth6809.asm):02110                    BNE   TKFAIL
                      (    forth6809.asm):02111                    PULU  D
                      (    forth6809.asm):02112                    CMPD  #TSTGUARD
                      (    forth6809.asm):02113                    BNE   TKFAIL
                      (    forth6809.asm):02114         
                      (    forth6809.asm):02115                    LDD   TSTUB4
                      (    forth6809.asm):02116                    SUBD  TSTUAF
                      (    forth6809.asm):02117                    CMPD  #2
                      (    forth6809.asm):02118                    BNE   TKFAIL
                      (    forth6809.asm):02119         
                      (    forth6809.asm):02120                    LDD   #TRUEV
                      (    forth6809.asm):02121                    BRA   TKDONE
C100                  (    forth6809.asm):02122         TKFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):02123         TKDONE:    LDX   #TSTTUCKNAME
                      (    forth6809.asm):02124                    PSHU  X
                      (    forth6809.asm):02125                    PSHU  D
                      (    forth6809.asm):02126                    JSR   TSTREPORT
                      (    forth6809.asm):02127         

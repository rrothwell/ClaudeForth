                      (    forth6809.asm):22867                                      ; CODEHERE-to-PAD gap reserved for the
                      (    forth6809.asm):22868                                      ; pictured numeric output buffer, the same
                      (    forth6809.asm):22869                                      ; amount WORDMAXCHARS deliberately holds
                      (    forth6809.asm):22870                                      ; back from WORD's own use at the other
                      (    forth6809.asm):22871                                      ; end of that same shared gap. PADOFFSET
                      (    forth6809.asm):22872                                      ; is the total gap width, most of which is
                      (    forth6809.asm):22873                                      ; actually earmarked for WORD's own
                      (    forth6809.asm):22874                                      ; parsing - reporting it here would
                      (    forth6809.asm):22875                                      ; overstate what HOLD can safely use
                      (    forth6809.asm):22876                                      ; without risking collision with whatever
                      (    forth6809.asm):22877                                      ; WORD is doing in the same space.
FD7F FDCE00040054     (    forth6809.asm):22878                  FDB   EN8,EN8L,PADMINSIZE  ; NEW: /PAD, the last of the two
                      (    forth6809.asm):22879                                      ; entries the top-of-file note originally
                      (    forth6809.asm):22880                                      ; flagged as absent - now both present.
                      (    forth6809.asm):22881                                      ; Answers PADMINSIZE (84) directly, per
                      (    forth6809.asm):22882                                      ; ANS's own /PAD meaning (3.3.3.6, "the
                      (    forth6809.asm):22883                                      ; size of the scratch area whose address
                      (    forth6809.asm):22884                                      ; is returned by PAD") - PAD's own region,
                      (    forth6809.asm):22885                                      ; growing upward from PAD itself, distinct
                      (    forth6809.asm):22886                                      ; from HOLDMINSIZE above (which answers
                      (    forth6809.asm):22887                                      ; for a different region entirely, the
                      (    forth6809.asm):22888                                      ; downward-growing pictured-numeric buffer
                      (    forth6809.asm):22889                                      ; in the CODEHERE-to-PAD gap). PADOFFSET
                      (    forth6809.asm):22890                                      ; happens to equal PADMINSIZE numerically
                      (    forth6809.asm):22891                                      ; in this implementation (PADOFFSET EQU
                      (    forth6809.asm):22892                                      ; PADMINSIZE), but /PAD is answered with
                      (    forth6809.asm):22893                                      ; the conceptually correct constant, not
                      (    forth6809.asm):22894                                      ; the coincidentally-equal one.
FD85 FDD200070000     (    forth6809.asm):22895                  FDB   EN9,EN9L,0    ; NEW: FLOORED - previously the one item
                      (    forth6809.asm):22896                                      ; in this area explicitly left open
                      (    forth6809.asm):22897                                      ; pending its own investigation (unlike
                      (    forth6809.asm):22898                                      ; WORDLISTS, this is a CORE query, not
                      (    forth6809.asm):22899                                      ; tied to an unimplemented optional word
                      (    forth6809.asm):22900                                      ; set, so "false by omission" wasn't the
                      (    forth6809.asm):22901                                      ; right default). Investigated by tracing
                      (    forth6809.asm):22902                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):22903                                      ; against this system's own SM/REM and
                      (    forth6809.asm):22904                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):22905                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):22906                                      ; dividend's own original sign) after
                      (    forth6809.asm):22907                                      ; dividing absolute values - exactly
                      (    forth6809.asm):22908                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):22909                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):22910                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):22911                                      ; adjustment step (correcting the
                      (    forth6809.asm):22912                                      ; quotient and remainder when the
                      (    forth6809.asm):22913                                      ; quotient would be negative with a
                      (    forth6809.asm):22914                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):22915                                      ; not have. This system's primary
                      (    forth6809.asm):22916                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):22917                                      ; symmetric division, not floored -
                      (    forth6809.asm):22918                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):22919                                      ; answer (recognized query, value false),
                      (    forth6809.asm):22920                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):22921                                      ; WORDLISTS correctly uses.
FD8B FDD9000800FF     (    forth6809.asm):22922                  FDB   EN10,EN10L,255  ; NEW: MAX-CHAR - maximum value of any
                      (    forth6809.asm):22923                                      ; character in this implementation's
                      (    forth6809.asm):22924                                      ; character set (3.2.6). This system uses
                      (    forth6809.asm):22925                                      ; 8-bit characters throughout (matching
                      (    forth6809.asm):22926                                      ; ADDRESS-UNIT-BITS=8, already in this
                      (    forth6809.asm):22927                                      ; table) - a single byte's maximum value
                      (    forth6809.asm):22928                                      ; is 255.

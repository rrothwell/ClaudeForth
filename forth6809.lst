                      (    forth6809.asm):03476         ; ============================================================
                      (    forth6809.asm):03477         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):03478         ; ============================================================
                      (    forth6809.asm):03479         ; ------------------------------------------------------------
                      (    forth6809.asm):03480         ; INTERPRET  ( -- )
                      (    forth6809.asm):03481         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03482         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03483         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03484         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03485         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03486         ; ------------------------------------------------------------
D527                  (    forth6809.asm):03487         INTERPRET:

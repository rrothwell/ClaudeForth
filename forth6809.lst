                      (    forth6809.asm):08211         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (    forth6809.asm):08212         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (    forth6809.asm):08213         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (    forth6809.asm):08214         ; compiled as the new behavior, terminated with RTS) - executing
                      (    forth6809.asm):08215         ; TESTWD should push 6 (5 fetched, then incremented).
                      (    forth6809.asm):08216         ;
                      (    forth6809.asm):08217         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (    forth6809.asm):08218         ; return": it patches LATEST's behavior field using the return
                      (    forth6809.asm):08219         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (    forth6809.asm):08220         ; SECOND return address and jumps there - designed for the
                      (    forth6809.asm):08221         ; normal case where DOES> is reached from inside an enclosing
                      (    forth6809.asm):08222         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (    forth6809.asm):08223         ; would compile), which itself has its own caller. Traced by
                      (    forth6809.asm):08224         ; hand: calling directly into the compiled "JSR SETDOES"
                      (    forth6809.asm):08225         ; instruction itself (not through an intermediate wrapper)
                      (    forth6809.asm):08226         ; naturally supplies exactly the two stack levels SETDOES
                      (    forth6809.asm):08227         ; expects - its own JSR provides the first (becoming the new
                      (    forth6809.asm):08228         ; behavior field value), and this test's own call provides the
                      (    forth6809.asm):08229         ; second (correctly resuming here afterward) - no extra
                      (    forth6809.asm):08230         ; scaffolding needed, confirmed correct rather than assumed.
                      (    forth6809.asm):08231         ; ------------------------------------------------------------
C25B                  (    forth6809.asm):08232         TSTCRDOES: LDD  CODEHERE
                      (    forth6809.asm):08233                    STD  TSTCSAV
                      (    forth6809.asm):08234                    LDD  DPHERE
                      (    forth6809.asm):08235                    STD  TSTDSAV
                      (    forth6809.asm):08236                    LDD  VARHERE
                      (    forth6809.asm):08237                    STD  TSTVSAV
                      (    forth6809.asm):08238                    LDD  SRCADDR
                      (    forth6809.asm):08239                    STD  TSTSASAV
                      (    forth6809.asm):08240                    LDD  SRCLEN
                      (    forth6809.asm):08241                    STD  TSTSLSAV
                      (    forth6809.asm):08242                    LDD  TOIN
                      (    forth6809.asm):08243                    STD  TSTTISAV
                      (    forth6809.asm):08244                    LDD  LATEST
                      (    forth6809.asm):08245                    STD  TSTLSAV
                      (    forth6809.asm):08246         
                      (    forth6809.asm):08247                    LDA  #'T'
                      (    forth6809.asm):08248                    STA  TSTNAMEB
                      (    forth6809.asm):08249                    LDA  #'E'
                      (    forth6809.asm):08250                    STA  TSTNAMEB+1
                      (    forth6809.asm):08251                    LDA  #'S'
                      (    forth6809.asm):08252                    STA  TSTNAMEB+2
                      (    forth6809.asm):08253                    LDA  #'T'
                      (    forth6809.asm):08254                    STA  TSTNAMEB+3
                      (    forth6809.asm):08255                    LDA  #'W'
                      (    forth6809.asm):08256                    STA  TSTNAMEB+4
                      (    forth6809.asm):08257                    LDA  #'D'
                      (    forth6809.asm):08258                    STA  TSTNAMEB+5
                      (    forth6809.asm):08259         
                      (    forth6809.asm):08260                    LDD  #TSTCBUF
                      (    forth6809.asm):08261                    STD  CODEHERE
                      (    forth6809.asm):08262                    LDD  #TSTDBUF
                      (    forth6809.asm):08263                    STD  DPHERE
                      (    forth6809.asm):08264                    LDD  #TSTVBUF
                      (    forth6809.asm):08265                    STD  VARHERE
                      (    forth6809.asm):08266                    LDD  #TSTNAMEB
                      (    forth6809.asm):08267                    STD  SRCADDR
                      (    forth6809.asm):08268                    LDD  #6
                      (    forth6809.asm):08269                    STD  SRCLEN
                      (    forth6809.asm):08270                    LDD  #0
                      (    forth6809.asm):08271                    STD  TOIN

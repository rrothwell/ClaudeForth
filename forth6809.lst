E3FE AE42             (    forth6809.asm):05726                     LDX   2,U               ; x1
E400 3606             (    forth6809.asm):05727                     PSHU  D
E402 AF42             (    forth6809.asm):05728                     STX   2,U
E404 ED44             (    forth6809.asm):05729                     STD   4,U
E406 39               (    forth6809.asm):05730                     RTS
                      (    forth6809.asm):05731         
                      (    forth6809.asm):05732         ; ------------------------------------------------------------
                      (    forth6809.asm):05733         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05734         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05735         ; ------------------------------------------------------------
E407 3706             (    forth6809.asm):05736         PICKW:      PULU  D                 ; u
E409 58               (    forth6809.asm):05737                     LSLB
E40A 49               (    forth6809.asm):05738                     ROLA
E40B ECCB             (    forth6809.asm):05739                     LDD   D,U
E40D 3606             (    forth6809.asm):05740                     PSHU  D
E40F 39               (    forth6809.asm):05741                     RTS
                      (    forth6809.asm):05742         
                      (    forth6809.asm):05743         ; ------------------------------------------------------------
                      (    forth6809.asm):05744         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05745         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05746         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05747         ; the cell being moved.
                      (    forth6809.asm):05748         ; ------------------------------------------------------------
E410 ECC1             (    forth6809.asm):05749         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
E412 2718             (    forth6809.asm):05750                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
E414 1F02             (    forth6809.asm):05751                     TFR   D,Y               ; Y = cells to shift
E416 58               (    forth6809.asm):05752                     LSLB
E417 49               (    forth6809.asm):05753                     ROLA
E418 30CB             (    forth6809.asm):05754                     LEAX  D,U               ; X = xu
E41A EC84             (    forth6809.asm):05755                     LDD   ,X
E41C 3406             (    forth6809.asm):05756                     PSHS  D                 ; xu waits on the return stack
E41E EC1E             (    forth6809.asm):05757         RLOOP:      LDD   -2,X
E420 ED84             (    forth6809.asm):05758                     STD   ,X
E422 301E             (    forth6809.asm):05759                     LEAX  -2,X
E424 313F             (    forth6809.asm):05760                     LEAY  -1,Y
E426 26F6             (    forth6809.asm):05761                     BNE   RLOOP
E428 3506             (    forth6809.asm):05762                     PULS  D
E42A EDC4             (    forth6809.asm):05763                     STD   ,U
E42C 39               (    forth6809.asm):05764         ROLLDONE:   RTS
                      (    forth6809.asm):05765         
                      (    forth6809.asm):05766         ; ------------------------------------------------------------
                      (    forth6809.asm):05767         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05768         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05769         ; while the others move.
                      (    forth6809.asm):05770         ; ------------------------------------------------------------
E42D AE4A             (    forth6809.asm):05771         DROTW:      LDX   10,U              ; x1
E42F 10AE48           (    forth6809.asm):05772                     LDY   8,U               ; x2
E432 EC46             (    forth6809.asm):05773                     LDD   6,U
E434 ED4A             (    forth6809.asm):05774                     STD   10,U

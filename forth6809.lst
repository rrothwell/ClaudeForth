                      (    forth6809.asm):08017         ; ------------------------------------------------------------
                      (    forth6809.asm):08018         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08019         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08020         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08021         ; enter COLD.
                      (    forth6809.asm):08022         ; COLDSTRT
                      (    forth6809.asm):08023         ;    Inputs:
                      (    forth6809.asm):08024         ;        hardware reset
                      (    forth6809.asm):08025         ;    Outputs:
                      (    forth6809.asm):08026         ;        does not return
                      (    forth6809.asm):08027         ;    Registers: all registers initialised.
                      (    forth6809.asm):08028         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08029         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08030                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08031                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08032                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08033                     CLRA
FFAE 1F8B             (    forth6809.asm):08034                     TFR   A,DP
                      (    forth6809.asm):08035         
FFB0 8E0000           (    forth6809.asm):08036                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08037                     LDB   #0
FFB5 6F80             (    forth6809.asm):08038         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):08039                     DECB
FFB8 26FB             (    forth6809.asm):08040                     BNE   CLRGLOB
                      (    forth6809.asm):08041         
FFBA BDDCE3           (    forth6809.asm):08042                     JSR   INITSERIAL
                      (    forth6809.asm):08043         
FFBD 1CAF             (    forth6809.asm):08044                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08045         
                      (    forth6809.asm):08046                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08047         
                      (    forth6809.asm):08048                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08049                     JSR   TSTRUNNER
                      (    forth6809.asm):08050                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08051                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08052                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):08053                     NOP
                      (    forth6809.asm):08054                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08055         
FFC2 7EDE84           (    forth6809.asm):08056                     JMP   COLD
                      (    forth6809.asm):08057         
                      (    forth6809.asm):08058         ; ------------------------------------------------------------
                      (    forth6809.asm):08059         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08060         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08061         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08062         ; WARM
                      (    forth6809.asm):08063         ;    Inputs:
                      (    forth6809.asm):08064         ;        NMI
                      (    forth6809.asm):08065         ;    Outputs:
                      (    forth6809.asm):08066         ;        does not return
                      (    forth6809.asm):08067         ;    Registers: all registers initialised.
                      (    forth6809.asm):08068         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):08069         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08070                     CLRA
FFC8 1F8B             (    forth6809.asm):08071                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08072                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08073                     LDS   #RP0
                      (    forth6809.asm):08074         
FFD1 BDDCE3           (    forth6809.asm):08075                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):08076         
FFD4 8EFFE6           (    forth6809.asm):08077                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08078                     PSHU  X
FFD9 CC0006           (    forth6809.asm):08079                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08080                     PSHU  D
FFDE BDF4F1           (    forth6809.asm):08081                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):08082                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE3 7EDEC3           (    forth6809.asm):08083                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):08084         
FFE6 20207761726D     (    forth6809.asm):08085         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):08086         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):08087         
                      (    forth6809.asm):08088                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEC             (    forth6809.asm):08089         INITEND     EQU   *
     0048             (    forth6809.asm):08090         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08091         

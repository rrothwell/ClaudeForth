                      (    forth6809.asm):09398         ; ------------------------------------------------------------
                      (    forth6809.asm):09399         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09400         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09401         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09402         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09403         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09404         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09405         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09406         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09407         ; available the skip ends.
                      (    forth6809.asm):09408         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09409         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09410         ; ------------------------------------------------------------
F3E0 3706             (    forth6809.asm):09411         BRIFW:      PULU  D
F3E2 10830000         (    forth6809.asm):09412                     CMPD  #0
F3E6 266D             (    forth6809.asm):09413                     BNE   BRTHENW           ; true: nothing to skip
F3E8 CC0001           (    forth6809.asm):09414         BRELSEW:    LDD   #1
F3EB 3406             (    forth6809.asm):09415                     PSHS  D                 ; level
F3ED BDEA89           (    forth6809.asm):09416         BRNEXT:     JSR   PARSENAMEW
F3F0 3706             (    forth6809.asm):09417                     PULU  D                 ; length
F3F2 3710             (    forth6809.asm):09418                     PULU  X                 ; address
F3F4 10830000         (    forth6809.asm):09419                     CMPD  #0
F3F8 274E             (    forth6809.asm):09420                     BEQ   BRREFILL
F3FA 10830004         (    forth6809.asm):09421                     CMPD  #4
F3FE 2734             (    forth6809.asm):09422                     BEQ   BR4
F400 10830006         (    forth6809.asm):09423                     CMPD  #6
F404 26E7             (    forth6809.asm):09424                     BNE   BRNEXT
F406 C606             (    forth6809.asm):09425                     LDB   #6
F408 108EF464         (    forth6809.asm):09426                     LDY   #BRSELSE
F40C 3410             (    forth6809.asm):09427                     PSHS  X
F40E BDF456           (    forth6809.asm):09428                     JSR   BRCMP
F411 3510             (    forth6809.asm):09429                     PULS  X
F413 2609             (    forth6809.asm):09430                     BNE   BR6B
F415 ECE4             (    forth6809.asm):09431                     LDD   ,S                ; [ELSE]: ends the skip at level 1
F417 830001           (    forth6809.asm):09432                     SUBD  #1
F41A 2737             (    forth6809.asm):09433                     BEQ   BRDONE
F41C 20CF             (    forth6809.asm):09434                     BRA   BRNEXT
F41E C606             (    forth6809.asm):09435         BR6B:       LDB   #6
F420 108EF46A         (    forth6809.asm):09436                     LDY   #BRSTHEN
F424 BDF456           (    forth6809.asm):09437                     JSR   BRCMP
F427 26C4             (    forth6809.asm):09438                     BNE   BRNEXT
F429 ECE4             (    forth6809.asm):09439                     LDD   ,S                ; [THEN]: one level less
F42B 830001           (    forth6809.asm):09440                     SUBD  #1
F42E EDE4             (    forth6809.asm):09441                     STD   ,S
F430 2721             (    forth6809.asm):09442                     BEQ   BRDONE
F432 20B9             (    forth6809.asm):09443                     BRA   BRNEXT
F434 C604             (    forth6809.asm):09444         BR4:        LDB   #4
F436 108EF460         (    forth6809.asm):09445                     LDY   #BRSIF
F43A BDF456           (    forth6809.asm):09446                     JSR   BRCMP
F43D 26AE             (    forth6809.asm):09447                     BNE   BRNEXT
F43F ECE4             (    forth6809.asm):09448                     LDD   ,S                ; [IF]: one level more
F441 C30001           (    forth6809.asm):09449                     ADDD  #1
F444 EDE4             (    forth6809.asm):09450                     STD   ,S
F446 20A5             (    forth6809.asm):09451                     BRA   BRNEXT
F448 BDF09B           (    forth6809.asm):09452         BRREFILL:   JSR   REFILLW
F44B 3706             (    forth6809.asm):09453                     PULU  D
F44D 10830000         (    forth6809.asm):09454                     CMPD  #0
F451 269A             (    forth6809.asm):09455                     BNE   BRNEXT
F453 3262             (    forth6809.asm):09456         BRDONE:     LEAS  2,S
F455 39               (    forth6809.asm):09457         BRTHENW:    RTS

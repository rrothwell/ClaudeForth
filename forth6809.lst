E07A 3706             (    forth6809.asm):05947                     PULU  D                 ; x2
E07C 3720             (    forth6809.asm):05948                     PULU  Y                 ; x1
E07E 3420             (    forth6809.asm):05949                     PSHS  Y
E080 3406             (    forth6809.asm):05950                     PSHS  D
E082 3410             (    forth6809.asm):05951                     PSHS  X
E084 39               (    forth6809.asm):05952                     RTS
                      (    forth6809.asm):05953         
                      (    forth6809.asm):05954         ; ------------------------------------------------------------
                      (    forth6809.asm):05955         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05956         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05957         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05958         ; put back around the transfer.
                      (    forth6809.asm):05959         ; ------------------------------------------------------------
E085 3510             (    forth6809.asm):05960         TWOFROMRW:  PULS  X                 ; return address

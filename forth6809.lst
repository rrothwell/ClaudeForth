                      (    forth6809.asm):03034         ; ------------------------------------------------------------
                      (    forth6809.asm):03035         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03036         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03037         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03038         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03039         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03040         ; ------------------------------------------------------------

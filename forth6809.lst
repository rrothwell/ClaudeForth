                      (    forth6809.asm):01192         
                      (    forth6809.asm):01193                   LDD  TSTUB4
                      (    forth6809.asm):01194                   SUBD TSTUAF
                      (    forth6809.asm):01195                   CMPD #0
                      (    forth6809.asm):01196                   BNE  SCFAIL
                      (    forth6809.asm):01197         
                      (    forth6809.asm):01198                   LDD  #TRUEV
                      (    forth6809.asm):01199                   BRA  SCDONE

                      (    forth6809.asm):06818         ;    Outputs:
                      (    forth6809.asm):06819         ;        RegX = entry address, or 0 if there is none. An entry is: 0 link,
                      (    forth6809.asm):06820         ;        2 name length, 3 text length, 4 text capacity, 5 name, then text.
                      (    forth6809.asm):06821         ;    Registers: RegA, RegB, RegX and RegY changed. A length over 255 is
                      (    forth6809.asm):06822         ;        never found.

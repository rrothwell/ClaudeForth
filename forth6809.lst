DC72 39               (    forth6809.asm):01610                     RTS
                      (    forth6809.asm):01611         
                      (    forth6809.asm):01612                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01613         ; ------------------------------------------------------------
                      (    forth6809.asm):01614         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01615         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01616         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01617         ; INFILL
                      (    forth6809.asm):01618         ;    Inputs:
                      (    forth6809.asm):01619         ;        none
                      (    forth6809.asm):01620         ;    Outputs:
                      (    forth6809.asm):01621         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01622         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01623         ; ------------------------------------------------------------
DC73 B60176           (    forth6809.asm):01624         INFILL:     LDA   INHEAD
DC76 B00177           (    forth6809.asm):01625                     SUBA  INTAIL
DC79 843F             (    forth6809.asm):01626                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DC7B 39               (    forth6809.asm):01627                     RTS
                      (    forth6809.asm):01628         ; ------------------------------------------------------------
                      (    forth6809.asm):01629         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01630         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01631         ; receive path with interrupts already masked.
                      (    forth6809.asm):01632         ; RTSCHECKHI
                      (    forth6809.asm):01633         ;    Inputs:
                      (    forth6809.asm):01634         ;        none
                      (    forth6809.asm):01635         ;    Outputs:
                      (    forth6809.asm):01636         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01637         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01638         ; ------------------------------------------------------------
DC7C BDDC73           (    forth6809.asm):01639         RTSCHECKHI: JSR   INFILL
DC7F 8130             (    forth6809.asm):01640                     CMPA  #INHIWATER
DC81 250F             (    forth6809.asm):01641                     BLO   RTSCHIDONE
DC83 7D0178           (    forth6809.asm):01642                     TST   RTSSTATE
DC86 260A             (    forth6809.asm):01643                     BNE   RTSCHIDONE        ; already high - nothing to do
DC88 86D5             (    forth6809.asm):01644                     LDA   #CR_RTSHI
DC8A B7C008           (    forth6809.asm):01645                     STA   ACIACR
DC8D 8601             (    forth6809.asm):01646                     LDA   #1
DC8F B70178           (    forth6809.asm):01647                     STA   RTSSTATE
DC92 39               (    forth6809.asm):01648         RTSCHIDONE: RTS
                      (    forth6809.asm):01649         ; ------------------------------------------------------------
                      (    forth6809.asm):01650         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01651         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01652         ; enables it only while output is pending.
                      (    forth6809.asm):01653         ; UPDATE_RTS
                      (    forth6809.asm):01654         ;    Inputs:
                      (    forth6809.asm):01655         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01656         ;    Outputs:
                      (    forth6809.asm):01657         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01658         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01659         ; ------------------------------------------------------------
DC93                  (    forth6809.asm):01660         UPDATE_RTS:
DC93 7D0178           (    forth6809.asm):01661                     TST   RTSSTATE
DC96 260D             (    forth6809.asm):01662                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01663         
DC98 7D017B           (    forth6809.asm):01664                     TST   OUTACTIVITY       ; Is active?
DC9B 2704             (    forth6809.asm):01665                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01666         
                      (    forth6809.asm):01667                                             ; $B5/%1011_0101
DC9D 86B5             (    forth6809.asm):01668                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DC9F 2009             (    forth6809.asm):01669                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01670         
DCA1                  (    forth6809.asm):01671         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DCA1 8695             (    forth6809.asm):01672                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DCA3 2005             (    forth6809.asm):01673                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01674         
DCA5                  (    forth6809.asm):01675         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DCA5 86D5             (    forth6809.asm):01676                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DCA7 7F017B           (    forth6809.asm):01677                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DCAA                  (    forth6809.asm):01678         WRITE_CR:
DCAA B7C008           (    forth6809.asm):01679                     STA   ACIACR
DCAD 39               (    forth6809.asm):01680                     RTS
                      (    forth6809.asm):01681         ; ------------------------------------------------------------
                      (    forth6809.asm):01682         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01683         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01684         ; Called after a character is added to the ring.
                      (    forth6809.asm):01685         ; CHKHI
                      (    forth6809.asm):01686         ;    Inputs:
                      (    forth6809.asm):01687         ;        RegB = input ring fill level
                      (    forth6809.asm):01688         ;    Outputs:
                      (    forth6809.asm):01689         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01690         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01691         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01692         ; ------------------------------------------------------------
DCAE                  (    forth6809.asm):01693         CHKHI:
DCAE C130             (    forth6809.asm):01694                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DCB0 250D             (    forth6809.asm):01695                     BLO   CHKHIDONE         ; No! Do nothing.
DCB2 7D0178           (    forth6809.asm):01696                     TST   RTSSTATE
DCB5 2608             (    forth6809.asm):01697                     BNE   CHKHIDONE         ; already high - nothing to do
DCB7 86FF             (    forth6809.asm):01698                     LDA   #INREJECT         ; Yes! De-assert RTS.
DCB9 B70178           (    forth6809.asm):01699                     STA   RTSSTATE
DCBC BDDC93           (    forth6809.asm):01700                     JSR   UPDATE_RTS
DCBF 39               (    forth6809.asm):01701         CHKHIDONE:  RTS
                      (    forth6809.asm):01702         
                      (    forth6809.asm):01703         ; ------------------------------------------------------------
                      (    forth6809.asm):01704         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01705         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01706         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01707         ; CHKLO
                      (    forth6809.asm):01708         ;    Inputs:
                      (    forth6809.asm):01709         ;        RegB = input ring fill level
                      (    forth6809.asm):01710         ;    Outputs:
                      (    forth6809.asm):01711         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01712         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01713         ; ------------------------------------------------------------
DCC0                  (    forth6809.asm):01714         CHKLO:
DCC0 C110             (    forth6809.asm):01715                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DCC2 240D             (    forth6809.asm):01716                     BHS   CHKLODONE         ; No! Do nothing.
DCC4 7D0178           (    forth6809.asm):01717                     TST   RTSSTATE
DCC7 2708             (    forth6809.asm):01718                     BEQ   CHKLODONE         ; already low - nothing to do
DCC9 8600             (    forth6809.asm):01719                     LDA   #INACCEPT         ; Yes! Assert RTS.
DCCB B70178           (    forth6809.asm):01720                     STA   RTSSTATE
DCCE BDDC93           (    forth6809.asm):01721                     JSR   UPDATE_RTS
DCD1 39               (    forth6809.asm):01722         CHKLODONE:  RTS
                      (    forth6809.asm):01723         ; ------------------------------------------------------------
                      (    forth6809.asm):01724         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01725         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01726         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01727         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01728         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01729         ;    Inputs:
                      (    forth6809.asm):01730         ;        none
                      (    forth6809.asm):01731         ;    Outputs:
                      (    forth6809.asm):01732         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01733         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01734         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01735         ; ------------------------------------------------------------
DCD2                  (    forth6809.asm):01736         FLUSHOUTBUFFER:
DCD2 F6017A           (    forth6809.asm):01737                     LDB   OUTTAIL
DCD5 F10179           (    forth6809.asm):01738                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DCD8 2719             (    forth6809.asm):01739                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01740         
DCDA B6C008           (    forth6809.asm):01741                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DCDD 8508             (    forth6809.asm):01742                     BITA  #SR_CTS
DCDF 2612             (    forth6809.asm):01743                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01744         
DCE1 8502             (    forth6809.asm):01745                     BITA  #SR_TDRE          ; Is transmit register empty?
DCE3 270E             (    forth6809.asm):01746                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01747                                             ; than spin-wait here.
                      (    forth6809.asm):01748         
DCE5 8E01C0           (    forth6809.asm):01749                     LDX   #OUTBUF           ; The out buffer is occupied.
DCE8 A685             (    forth6809.asm):01750                     LDA   B,X               ; Get the character from the out buffer.
DCEA B7C009           (    forth6809.asm):01751                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01752         
DCED 5C               (    forth6809.asm):01753                     INCB                    ; Update tail pointer to next character slot.
DCEE C43F             (    forth6809.asm):01754                     ANDB  #OUTBUFSZ-1
DCF0 F7017A           (    forth6809.asm):01755                     STB   OUTTAIL
                      (    forth6809.asm):01756                                             ; One character sent - return rather than
                      (    forth6809.asm):01757                                             ; loop back for more (see header comment).
DCF3                  (    forth6809.asm):01758         FLUSHED:
DCF3 39               (    forth6809.asm):01759                     RTS
                      (    forth6809.asm):01760         ; ------------------------------------------------------------
                      (    forth6809.asm):01761         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01762         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01763         ; PUTCHAR
                      (    forth6809.asm):01764         ;    Inputs:
                      (    forth6809.asm):01765         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01766         ;    Outputs:
                      (    forth6809.asm):01767         ;        none
                      (    forth6809.asm):01768         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01769         ; ------------------------------------------------------------
DCF4                  (    forth6809.asm):01770         PUTCHAR:
DCF4 3411             (    forth6809.asm):01771                     PSHS  CC,X
DCF6 1A50             (    forth6809.asm):01772                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01773         
DCF8 F60179           (    forth6809.asm):01774                     LDB   OUTHEAD           ; Is buffer full?
DCFB 5C               (    forth6809.asm):01775                     INCB
DCFC C43F             (    forth6809.asm):01776                     ANDB  #OUTBUFSZ-1
DCFE F1017A           (    forth6809.asm):01777                     CMPB  OUTTAIL
DD01 273A             (    forth6809.asm):01778                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01779         
DD03 8E01C0           (    forth6809.asm):01780                     LDX   #OUTBUF           ; Put character into character slot.
DD06 F60179           (    forth6809.asm):01781                     LDB   OUTHEAD
DD09 A785             (    forth6809.asm):01782                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01783         
DD0B 5C               (    forth6809.asm):01784                     INCB                    ; Update tail pointer to next character slot.
DD0C C43F             (    forth6809.asm):01785                     ANDB  #OUTBUFSZ-1
DD0E F70179           (    forth6809.asm):01786                     STB   OUTHEAD
                      (    forth6809.asm):01787         
DD11 7D0178           (    forth6809.asm):01788                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
DD14 2709             (    forth6809.asm):01789                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):01790         
                      (    forth6809.asm):01791                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):01792                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
DD16 1CAF             (    forth6809.asm):01793                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only

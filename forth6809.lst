                      (    forth6809.asm):03544         
E420 ECC4             (    forth6809.asm):03545                     LDD   ,U
E422 263B             (    forth6809.asm):03546                     BNE   NQBADF            ; unconverted characters remain
E424 3344             (    forth6809.asm):03547                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):03548         
                      (    forth6809.asm):03549                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E426 6D62             (    forth6809.asm):03550                     TST   2,S
E428 2718             (    forth6809.asm):03551                     BEQ   NQPOS32

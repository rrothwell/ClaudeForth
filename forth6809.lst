                      (    forth6809.asm):00449         
                      (    forth6809.asm):00450         ; ============================================================
                      (    forth6809.asm):00451         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00452         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):00453         ; chained via LINK, living in BASEDICT ($D85D-$E011, an exact fit
                      (    forth6809.asm):00454         ; for this dictionary's 1973 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):00455         ; directly at each primitive's own code label for almost every
                      (    forth6809.asm):00456         ; entry - these are raw code entries, not DODOES trampolines, so
                      (    forth6809.asm):00457         ; CFA = the label itself. The two exceptions are TRUE and FALSE
                      (    forth6809.asm):00458         ; (added in a later pass, chain's newest entries): their CFA is
                      (    forth6809.asm):00459         ; the DODOES-trampoline pattern instead, matching what CONSTANT
                      (    forth6809.asm):00460         ; would compile interactively - see TRUEBODY/FALSEBODY, section
                      (    forth6809.asm):00461         ; 26, for why and how.
                      (    forth6809.asm):00462         ;
                      (    forth6809.asm):00463         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):00464         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):00465         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):00466         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):00467         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):00468         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):00469         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):00470         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):00471         ;
                      (    forth6809.asm):00472         ; ABORT and QUIT already have hand-built headers (ABORTHDR/
                      (    forth6809.asm):00473         ; QUITHDR, section 26) and are NOT duplicated here. This chain
                      (    forth6809.asm):00474         ; is spliced in below them: QUITHDR -> ABORTHDR -> (newest entry
                      (    forth6809.asm):00475         ; below) -> ... -> (oldest entry) -> 0. BASELATEST remains QUITHDR.
                      (    forth6809.asm):00476         ;
                      (    forth6809.asm):00477         ; ABORTHDR's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):00478         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):00479         ;
                      (    forth6809.asm):00480         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):00481         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):00482         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):00483         ; ============================================================

                      (    forth6809.asm):04224         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04225         ; ------------------------------------------------------------
E85F 3706             (    forth6809.asm):04226         QDOSETUP:   PULU  D                 ; index

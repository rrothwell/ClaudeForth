                      (    forth6809.asm):09488         ; TSTCOMPWORDS - compiling-words tests (glossary section 3.10,
                      (    forth6809.asm):09489         ; 13 words, 17 tests since several get separate cases: TICK
                      (    forth6809.asm):09490         ; found/not-found, ['] compiling/interpreting state, POSTPONE
                      (    forth6809.asm):09491         ; normal/immediate word, SLITERAL compiling/interpreting state,
                      (    forth6809.asm):09492         ; ABORT" false/true flag). Reuses the scratch infrastructure
                      (    forth6809.asm):09493         ; established for sections 3.8/3.9 throughout.
                      (    forth6809.asm):09494         ;
                      (    forth6809.asm):09495         ; POSTPONE is this section's hardest case: a genuine two-level
                      (    forth6809.asm):09496         ; compile-time mechanism. Traced its own code first - for a
                      (    forth6809.asm):09497         ; normal word, it compiles code that ITSELF compiles a call to
                      (    forth6809.asm):09498         ; that word later, when the current definition eventually runs,
                      (    forth6809.asm):09499         ; not immediately (standard ANS semantics: POSTPONE appends a
                      (    forth6809.asm):09500         ; word's own compilation semantics to the current definition,
                      (    forth6809.asm):09501         ; and for an ordinary word that semantics IS "compile a call to
                      (    forth6809.asm):09502         ; it", so appending it only makes sense if the current
                      (    forth6809.asm):09503         ; definition later performs that compiling action itself,
                      (    forth6809.asm):09504         ; against whatever's being compiled at that later point).
                      (    forth6809.asm):09505         ; Verified via the compiled byte sequence directly rather than
                      (    forth6809.asm):09506         ; fully executing a triple-nested compile chain.
                      (    forth6809.asm):09507         ;
                      (    forth6809.asm):09508         ; ABORT" is safely testable for both its flag cases - confirmed
                      (    forth6809.asm):09509         ; by reading its own runtime code that it uses THROW -2
                      (    forth6809.asm):09510         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09511         ; ABORT itself uses (still deliberately untested, per section
                      (    forth6809.asm):09512         ; 3.1's own reasoning).
                      (    forth6809.asm):09513         ; ------------------------------------------------------------
C25B BDFC2B           (    forth6809.asm):09514         TSTCOMPWORDS: JSR CRW
C25E 8EC26F           (    forth6809.asm):09515                    LDX   #TSTCWMSG
C261 3610             (    forth6809.asm):09516                    PSHU  X
C263 CC0009           (    forth6809.asm):09517                    LDD   #9
C266 3606             (    forth6809.asm):09518                    PSHU  D
C268 BDF60B           (    forth6809.asm):09519                    JSR   TYPE
C26B BDFC2B           (    forth6809.asm):09520                    JSR   CRW
                      (    forth6809.asm):09521         
                      (    forth6809.asm):09522                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09523         
                      (    forth6809.asm):09524                    JSR   TSTIMMED
                      (    forth6809.asm):09525                    JSR   TSTSTATE
                      (    forth6809.asm):09526                    JSR   TSTBRACKETS
                      (    forth6809.asm):09527                    JSR   TSTTICK1
                      (    forth6809.asm):09528                    JSR   TSTTICK2
                      (    forth6809.asm):09529                    JSR   TSTCOMPCOMMA
                      (    forth6809.asm):09530                    JSR   TSTLITERAL
                      (    forth6809.asm):09531                    JSR   TSTBRACKTICK1
                      (    forth6809.asm):09532                    JSR   TSTBRACKTICK2
                      (    forth6809.asm):09533                    JSR   TSTPOSTPONE1
                      (    forth6809.asm):09534                    JSR   TSTPOSTPONE2
                      (    forth6809.asm):09535                    JSR   TSTTOBODY
                      (    forth6809.asm):09536                    JSR   TSTEXECUTE
                      (    forth6809.asm):09537                    JSR   TSTSLITERAL1
                      (    forth6809.asm):09538                    JSR   TSTSLITERAL2
                      (    forth6809.asm):09539                    JSR   TSTABORTQ1
                      (    forth6809.asm):09540                    JSR   TSTABORTQ2
                      (    forth6809.asm):09541         
                      (    forth6809.asm):09542                    ENDC ; <<<<
                      (    forth6809.asm):09543         
C26E 39               (    forth6809.asm):09544                    RTS
                      (    forth6809.asm):09545         
C26F 436F6D70576F7264 (    forth6809.asm):09546         TSTCWMSG: FCC "CompWords"
     73
                      (    forth6809.asm):09547         
                      (    forth6809.asm):09548                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09549         
                      (    forth6809.asm):09550         ; ------------------------------------------------------------
                      (    forth6809.asm):09551         ; Compiling-words test harness (glossary section 3.10). Reuses
                      (    forth6809.asm):09552         ; the scratch infrastructure established for sections 3.8/3.9
                      (    forth6809.asm):09553         ; (TSTCBUF/TSTCBUF2 for CODEHERE redirects, TSTFHDR for a fake
                      (    forth6809.asm):09554         ; dictionary header, TSTNAMEB for a fake source name). POSTPONE
                      (    forth6809.asm):09555         ; is this section's own hardest case: a genuine two-level
                      (    forth6809.asm):09556         ; compile-time mechanism (compiling code that, for a normal
                      (    forth6809.asm):09557         ; word, itself compiles a call to that word later, when the
                      (    forth6809.asm):09558         ; current definition eventually runs - not immediately, unlike
                      (    forth6809.asm):09559         ; every other compile-time word tested so far). ABORT" is safely
                      (    forth6809.asm):09560         ; testable for both its true and false flag cases - traced its
                      (    forth6809.asm):09561         ; own runtime behavior directly and confirmed it uses THROW -2
                      (    forth6809.asm):09562         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09563         ; ABORT itself uses (which remains untested, per section 3.1's
                      (    forth6809.asm):09564         ; own reasoning).
                      (    forth6809.asm):09565         ; ------------------------------------------------------------
                      (    forth6809.asm):09566         
                      (    forth6809.asm):09567         ; ------------------------------------------------------------
                      (    forth6809.asm):09568         ; TSTIMMED - unit test for IMMEDIATE. Builds a fake header (LEN/
                      (    forth6809.asm):09569         ; FL=3, no flags), points LATEST at it, calls IMMEDIATE, and
                      (    forth6809.asm):09570         ; verifies the header's own LEN/FL byte now has bit 7 set -
                      (    forth6809.asm):09571         ; confirmed a memory-only operation with no data-stack effect,
                      (    forth6809.asm):09572         ; so the guard check is the whole verification beyond that.
                      (    forth6809.asm):09573         ; ------------------------------------------------------------
C278                  (    forth6809.asm):09574         TSTIMMED: LDD  LATEST
                      (    forth6809.asm):09575                   STD  TSTLSAV
                      (    forth6809.asm):09576         
                      (    forth6809.asm):09577                   LDA  #3
                      (    forth6809.asm):09578                   STA  TSTFHDR
                      (    forth6809.asm):09579                   LDA  #'F'
                      (    forth6809.asm):09580                   STA  TSTFHDR+1
                      (    forth6809.asm):09581                   LDA  #'O'
                      (    forth6809.asm):09582                   STA  TSTFHDR+2
                      (    forth6809.asm):09583                   LDA  #'O'

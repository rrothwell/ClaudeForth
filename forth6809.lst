                      (    forth6809.asm):04183         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):04184         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):04185         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):04186         ; UDMULADD
                      (    forth6809.asm):04187         ;    Inputs:
                      (    forth6809.asm):04188         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):04189         ;        frame ( ud c-addr u )
                      (    forth6809.asm):04190         ;        RegB = digit value to add
                      (    forth6809.asm):04191         ;        BASE
                      (    forth6809.asm):04192         ;    Outputs:
                      (    forth6809.asm):04193         ;        ud = ud * BASE + digit
                      (    forth6809.asm):04194         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04195         ; ------------------------------------------------------------
D7AA 327E             (    forth6809.asm):04196         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
D7AC E7E4             (    forth6809.asm):04197                     STB   ,S
D7AE 9603             (    forth6809.asm):04198                     LDA   BASE+1
D7B0 A761             (    forth6809.asm):04199                     STA   1,S
D7B2 A647             (    forth6809.asm):04200                     LDA   7,U
D7B4 E661             (    forth6809.asm):04201                     LDB   1,S
D7B6 3D               (    forth6809.asm):04202                     MUL

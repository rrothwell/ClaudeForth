                      (    forth6809.asm):05358         ; MOD  ( n1 n2 -- n3 )
                      (    forth6809.asm):05359         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05360         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05361         ; zero.
                      (    forth6809.asm):05362         ; ------------------------------------------------------------

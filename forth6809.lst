     54482076312E30
     000F             (    forth6809.asm):02116         SIGNONL     EQU   *-SIGNON
DF5B 20206F6B         (    forth6809.asm):02117         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02118         OKMSGL      EQU   *-OKMSG
DF5F 20204552524F5220 (    forth6809.asm):02119         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02120         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02121         
                      (    forth6809.asm):02122         ; ============================================================
                      (    forth6809.asm):02123         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02124         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02125         ; ============================================================
                      (    forth6809.asm):02126         ; ------------------------------------------------------------
                      (    forth6809.asm):02127         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02128         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02129         ; LIT   ( -- x )
                      (    forth6809.asm):02130         ;    Inputs:
                      (    forth6809.asm):02131         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02132         ;    Outputs:
                      (    forth6809.asm):02133         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02134         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02135         ; ------------------------------------------------------------
DF67 3510             (    forth6809.asm):02136         LIT:        PULS  X
DF69 EC81             (    forth6809.asm):02137                     LDD   ,X++
DF6B 3606             (    forth6809.asm):02138                     PSHU  D                 ; x
DF6D 3410             (    forth6809.asm):02139                     PSHS  X
DF6F 39               (    forth6809.asm):02140                     RTS
                      (    forth6809.asm):02141         
                      (    forth6809.asm):02142         ; ------------------------------------------------------------
                      (    forth6809.asm):02143         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02144         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02145         ; address.
                      (    forth6809.asm):02146         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02147         ;    Inputs:
                      (    forth6809.asm):02148         ;        flag on the data stack
                      (    forth6809.asm):02149         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02150         ;    Outputs:
                      (    forth6809.asm):02151         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02152         ;        the offset
                      (    forth6809.asm):02153         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02154         ; ------------------------------------------------------------
DF70 3706             (    forth6809.asm):02155         ZBRANCH:    PULU  D                 ; flag
DF72 3510             (    forth6809.asm):02156                     PULS  X
DF74 10830000         (    forth6809.asm):02157                     CMPD  #0
DF78 2607             (    forth6809.asm):02158                     BNE   ZSKIP
DF7A EC84             (    forth6809.asm):02159                     LDD   ,X
DF7C 308B             (    forth6809.asm):02160                     LEAX  D,X
DF7E 3410             (    forth6809.asm):02161                     PSHS  X
DF80 39               (    forth6809.asm):02162                     RTS
DF81 3002             (    forth6809.asm):02163         ZSKIP:      LEAX  2,X
DF83 3410             (    forth6809.asm):02164                     PSHS  X
DF85 39               (    forth6809.asm):02165                     RTS
                      (    forth6809.asm):02166         
                      (    forth6809.asm):02167         ; ------------------------------------------------------------
                      (    forth6809.asm):02168         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02169         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02170         ; BRANCH
                      (    forth6809.asm):02171         ;    Inputs:
                      (    forth6809.asm):02172         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02173         ;    Outputs:
                      (    forth6809.asm):02174         ;        return address set to the branch target
                      (    forth6809.asm):02175         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02176         ; ------------------------------------------------------------
DF86 3510             (    forth6809.asm):02177         BRANCH:     PULS  X
DF88 EC84             (    forth6809.asm):02178                     LDD   ,X
DF8A 308B             (    forth6809.asm):02179                     LEAX  D,X
DF8C 3410             (    forth6809.asm):02180                     PSHS  X
DF8E 39               (    forth6809.asm):02181                     RTS
                      (    forth6809.asm):02182         
                      (    forth6809.asm):02183         ; ------------------------------------------------------------
                      (    forth6809.asm):02184         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02185         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02186         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02187         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02188         ;    Inputs:
                      (    forth6809.asm):02189         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02190         ;        trampoline
                      (    forth6809.asm):02191         ;    Outputs:
                      (    forth6809.asm):02192         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02193         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
DF8F 3510             (    forth6809.asm):02195         DODOES:     PULS  X
DF91 10AE81           (    forth6809.asm):02196                     LDY   ,X++
DF94 EC84             (    forth6809.asm):02197                     LDD   ,X
DF96 3606             (    forth6809.asm):02198                     PSHU  D                 ; pfa
DF98 6EA4             (    forth6809.asm):02199                     JMP   ,Y
                      (    forth6809.asm):02200         
                      (    forth6809.asm):02201         ; ------------------------------------------------------------
                      (    forth6809.asm):02202         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02203         ; field address on the stack.
                      (    forth6809.asm):02204         ; DOESRT0
                      (    forth6809.asm):02205         ;    Inputs:
                      (    forth6809.asm):02206         ;        none
                      (    forth6809.asm):02207         ;    Outputs:
                      (    forth6809.asm):02208         ;        none
                      (    forth6809.asm):02209         ;    Registers: none.
                      (    forth6809.asm):02210         ; ------------------------------------------------------------
DF9A 39               (    forth6809.asm):02211         DOESRT0:    RTS
                      (    forth6809.asm):02212         
                      (    forth6809.asm):02213         ; ------------------------------------------------------------
                      (    forth6809.asm):02214         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02215         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02216         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02217         ; SETDOES
                      (    forth6809.asm):02218         ;    Inputs:
                      (    forth6809.asm):02219         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02220         ;        BEHAVIOR)
                      (    forth6809.asm):02221         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02222         ;        address
                      (    forth6809.asm):02223         ;    Outputs:
                      (    forth6809.asm):02224         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02225         ;        defining word's caller
                      (    forth6809.asm):02226         ;    Registers: RegD, RegX, RegY, CC and HDRFLAGS changed.
                      (    forth6809.asm):02227         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):02228         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF9D 1F12             (    forth6809.asm):02229                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02230         
DF9F 9E04             (    forth6809.asm):02231                     LDX   LATEST
DFA1 A684             (    forth6809.asm):02232                     LDA   ,X
DFA3 971E             (    forth6809.asm):02233                     STA   HDRFLAGS
DFA5 3001             (    forth6809.asm):02234                     LEAX  1,X
DFA7 D61E             (    forth6809.asm):02235                     LDB   HDRFLAGS
DFA9 C41F             (    forth6809.asm):02236                     ANDB  #$1F
DFAB 4F               (    forth6809.asm):02237                     CLRA
DFAC 308B             (    forth6809.asm):02238                     LEAX  D,X               ; skip name -> LINK field
DFAE 3002             (    forth6809.asm):02239                     LEAX  2,X               ; skip LINK -> CFA field
DFB0 EC84             (    forth6809.asm):02240                     LDD   ,X                ; D = CFA (trampoline address)
DFB2 C30003           (    forth6809.asm):02241                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFB5 1F01             (    forth6809.asm):02242                     TFR   D,X
                      (    forth6809.asm):02243         
DFB7 10AF84           (    forth6809.asm):02244                     STY   ,X                ; patch it
                      (    forth6809.asm):02245         
DFBA 3510             (    forth6809.asm):02246                     PULS  X                 ; X = the OUTER defining word's own return addr
DFBC 6E84             (    forth6809.asm):02247                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02248         
                      (    forth6809.asm):02249         ; ------------------------------------------------------------
                      (    forth6809.asm):02250         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02251         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02252         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02253         ;    Inputs:
                      (    forth6809.asm):02254         ;        pfa on the data stack
                      (    forth6809.asm):02255         ;    Outputs:
                      (    forth6809.asm):02256         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02257         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02258         ; ------------------------------------------------------------
DFBE 3710             (    forth6809.asm):02259         DODEFER:    PULU  X                 ; pfa
DFC0 EC84             (    forth6809.asm):02260                     LDD   ,X
DFC2 1F01             (    forth6809.asm):02261                     TFR   D,X
DFC4 6E84             (    forth6809.asm):02262                     JMP   ,X
                      (    forth6809.asm):02263         
                      (    forth6809.asm):02264         ; ------------------------------------------------------------
                      (    forth6809.asm):02265         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02266         ; DOABORTUNDEF
                      (    forth6809.asm):02267         ;    Inputs:
                      (    forth6809.asm):02268         ;        none
                      (    forth6809.asm):02269         ;    Outputs:
                      (    forth6809.asm):02270         ;        none (does not return)
                      (    forth6809.asm):02271         ;    Registers: RegD changed.
                      (    forth6809.asm):02272         ; ------------------------------------------------------------
DFC6                  (    forth6809.asm):02273         DOABORTUNDEF:
DFC6 CCFFEB           (    forth6809.asm):02274                     LDD   #-21
DFC9 3606             (    forth6809.asm):02275                     PSHU  D                 ; throw code (-21)
DFCB 7EE646           (    forth6809.asm):02276                     JMP   THROWW
                      (    forth6809.asm):02277         
                      (    forth6809.asm):02278         ; ------------------------------------------------------------
                      (    forth6809.asm):02279         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02280         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02281         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02282         ;    Inputs:
                      (    forth6809.asm):02283         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02284         ;    Outputs:
                      (    forth6809.asm):02285         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02286         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02287         ; ------------------------------------------------------------
DFCE 3710             (    forth6809.asm):02288         DOMARKER:   PULU  X                 ; pfa
DFD0 EC84             (    forth6809.asm):02289                     LDD   ,X
DFD2 DD06             (    forth6809.asm):02290                     STD   DPHERE
DFD4 EC02             (    forth6809.asm):02291                     LDD   2,X
DFD6 DD08             (    forth6809.asm):02292                     STD   CODEHERE
DFD8 EC04             (    forth6809.asm):02293                     LDD   4,X
DFDA DD0A             (    forth6809.asm):02294                     STD   VARHERE
DFDC EC06             (    forth6809.asm):02295                     LDD   6,X
DFDE DD04             (    forth6809.asm):02296                     STD   LATEST
DFE0 39               (    forth6809.asm):02297                     RTS
                      (    forth6809.asm):02298         
                      (    forth6809.asm):02299         ; ------------------------------------------------------------
                      (    forth6809.asm):02300         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02301         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02302         ; ------------------------------------------------------------
DFE1 3710             (    forth6809.asm):02303         EXECUTEW:   PULU  X                 ; xt
DFE3 AD84             (    forth6809.asm):02304                     JSR   ,X
DFE5 39               (    forth6809.asm):02305                     RTS
                      (    forth6809.asm):02306         
                      (    forth6809.asm):02307         ; ============================================================
                      (    forth6809.asm):02308         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02309         ; ============================================================
                      (    forth6809.asm):02310         ; ------------------------------------------------------------
                      (    forth6809.asm):02311         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02312         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02313         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02314         ;    Inputs:
                      (    forth6809.asm):02315         ;        RegX = address of the here pointer
                      (    forth6809.asm):02316         ;        x on the data stack
                      (    forth6809.asm):02317         ;    Outputs:
                      (    forth6809.asm):02318         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02319         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02320         ; ------------------------------------------------------------
DFE6 3706             (    forth6809.asm):02321         APPENDCELL: PULU  D                 ; x
DFE8 10AE84           (    forth6809.asm):02322                     LDY   ,X
DFEB EDA1             (    forth6809.asm):02323                     STD   ,Y++
DFED 10AF84           (    forth6809.asm):02324                     STY   ,X
DFF0 39               (    forth6809.asm):02325                     RTS
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327         ; ------------------------------------------------------------
                      (    forth6809.asm):02328         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02329         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02330         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02331         ;    Inputs:
                      (    forth6809.asm):02332         ;        RegX = address of the here pointer
                      (    forth6809.asm):02333         ;        char on the data stack
                      (    forth6809.asm):02334         ;    Outputs:
                      (    forth6809.asm):02335         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02336         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02337         ; ------------------------------------------------------------
DFF1 3706             (    forth6809.asm):02338         APPENDBYTE: PULU  D                 ; char
DFF3 10AE84           (    forth6809.asm):02339                     LDY   ,X
DFF6 E7A0             (    forth6809.asm):02340                     STB   ,Y+
DFF8 10AF84           (    forth6809.asm):02341                     STY   ,X
DFFB 39               (    forth6809.asm):02342                     RTS
                      (    forth6809.asm):02343         
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; ,  ( x -- )
                      (    forth6809.asm):02346         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02347         ; ------------------------------------------------------------
DFFC 8E0008           (    forth6809.asm):02348         COMMAW:     LDX   #CODEHERE
DFFF 7EDFE6           (    forth6809.asm):02349                     JMP   APPENDCELL
                      (    forth6809.asm):02350         
                      (    forth6809.asm):02351         ; ------------------------------------------------------------
                      (    forth6809.asm):02352         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02353         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02354         ; ------------------------------------------------------------
E002 8E0008           (    forth6809.asm):02355         CODECOMMA:  LDX   #CODEHERE
E005 7EDFE6           (    forth6809.asm):02356                     JMP   APPENDCELL
                      (    forth6809.asm):02357         
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
                      (    forth6809.asm):02359         ; C,  ( char -- )
                      (    forth6809.asm):02360         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02361         ; ------------------------------------------------------------
E008 8E0008           (    forth6809.asm):02362         CCOMMAW:    LDX   #CODEHERE
E00B 7EDFF1           (    forth6809.asm):02363                     JMP   APPENDBYTE
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         ; ------------------------------------------------------------
                      (    forth6809.asm):02366         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02367         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
E00E 8E0008           (    forth6809.asm):02369         CCOMMA1:    LDX   #CODEHERE
E011 7EDFF1           (    forth6809.asm):02370                     JMP   APPENDBYTE
                      (    forth6809.asm):02371         
                      (    forth6809.asm):02372         ; ------------------------------------------------------------
                      (    forth6809.asm):02373         ; V,  ( x -- )
                      (    forth6809.asm):02374         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02375         ; ------------------------------------------------------------
E014 8E000A           (    forth6809.asm):02376         VCOMMAW:    LDX   #VARHERE
E017 7EDFE6           (    forth6809.asm):02377                     JMP   APPENDCELL
                      (    forth6809.asm):02378         
                      (    forth6809.asm):02379         ; ------------------------------------------------------------
                      (    forth6809.asm):02380         ; VC,  ( char -- )
                      (    forth6809.asm):02381         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02382         ; ------------------------------------------------------------
E01A 8E000A           (    forth6809.asm):02383         VCCOMMAW:   LDX   #VARHERE
E01D 7EDFF1           (    forth6809.asm):02384                     JMP   APPENDBYTE
                      (    forth6809.asm):02385         
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; ALLOT  ( n -- )
                      (    forth6809.asm):02388         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
E020 3706             (    forth6809.asm):02390         ALLOTW:     PULU  D                 ; n
E022 9E08             (    forth6809.asm):02391                     LDX   CODEHERE
E024 308B             (    forth6809.asm):02392                     LEAX  D,X
E026 9F08             (    forth6809.asm):02393                     STX   CODEHERE
E028 39               (    forth6809.asm):02394                     RTS
                      (    forth6809.asm):02395         
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
                      (    forth6809.asm):02397         ; VALLOT  ( n -- )
                      (    forth6809.asm):02398         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02399         ; ------------------------------------------------------------
E029 3706             (    forth6809.asm):02400         VALLOTW:    PULU  D                 ; n
E02B 9E0A             (    forth6809.asm):02401                     LDX   VARHERE
E02D 308B             (    forth6809.asm):02402                     LEAX  D,X
E02F 9F0A             (    forth6809.asm):02403                     STX   VARHERE
E031 39               (    forth6809.asm):02404                     RTS
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
                      (    forth6809.asm):02407         ; HERE  ( -- addr )
                      (    forth6809.asm):02408         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02409         ; ------------------------------------------------------------
E032 DC08             (    forth6809.asm):02410         HEREW:      LDD   CODEHERE
E034 3606             (    forth6809.asm):02411                     PSHU  D                 ; addr
E036 39               (    forth6809.asm):02412                     RTS
                      (    forth6809.asm):02413         
                      (    forth6809.asm):02414         ; ------------------------------------------------------------
                      (    forth6809.asm):02415         ; VHERE  ( -- addr )
                      (    forth6809.asm):02416         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02417         ; ------------------------------------------------------------
E037 DC0A             (    forth6809.asm):02418         VHEREW:     LDD   VARHERE
E039 3606             (    forth6809.asm):02419                     PSHU  D                 ; addr
E03B 39               (    forth6809.asm):02420                     RTS
                      (    forth6809.asm):02421         
                      (    forth6809.asm):02422         ; ------------------------------------------------------------
                      (    forth6809.asm):02423         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02424         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02425         ; ------------------------------------------------------------
E03C DC08             (    forth6809.asm):02426         PADW:       LDD   CODEHERE
E03E C30080           (    forth6809.asm):02427                     ADDD  #PADOFFSET
E041 3606             (    forth6809.asm):02428                     PSHU  D                 ; c-addr
E043 39               (    forth6809.asm):02429                     RTS
                      (    forth6809.asm):02430         
                      (    forth6809.asm):02431         ; ------------------------------------------------------------
                      (    forth6809.asm):02432         ; UNUSED  ( -- u )
                      (    forth6809.asm):02433         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02434         ; ------------------------------------------------------------
E044 CCB900           (    forth6809.asm):02435         UNUSEDW:    LDD   #CODETOP
E047 9308             (    forth6809.asm):02436                     SUBD  CODEHERE
E049 3606             (    forth6809.asm):02437                     PSHU  D                 ; u
E04B 39               (    forth6809.asm):02438                     RTS
                      (    forth6809.asm):02439         
                      (    forth6809.asm):02440         ; ------------------------------------------------------------
                      (    forth6809.asm):02441         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02442         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02443         ; ------------------------------------------------------------
E04C CC1FFF           (    forth6809.asm):02444         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E04F 930A             (    forth6809.asm):02445                     SUBD  VARHERE
E051 3606             (    forth6809.asm):02446                     PSHU  D                 ; u
E053 39               (    forth6809.asm):02447                     RTS
                      (    forth6809.asm):02448         
                      (    forth6809.asm):02449         ; ============================================================
                      (    forth6809.asm):02450         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02451         ; ============================================================
                      (    forth6809.asm):02452         ; ------------------------------------------------------------
                      (    forth6809.asm):02453         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02454         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02455         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02456         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02457         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02458         ;    Inputs:
                      (    forth6809.asm):02459         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02460         ;        name parsed from the input stream
                      (    forth6809.asm):02461         ;    Outputs:
                      (    forth6809.asm):02462         ;        header built at DPHERE; LATEST and NEWHDR = address of the
                      (    forth6809.asm):02463         ;        new header
                      (    forth6809.asm):02464         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02465         ; ------------------------------------------------------------
E054 CC0020           (    forth6809.asm):02466         HEADER:     LDD   #32
E057 3606             (    forth6809.asm):02467                     PSHU  D
E059 BDE34F           (    forth6809.asm):02468                     JSR   WORDW
E05C 3710             (    forth6809.asm):02469                     PULU  X                 ; c-addr of the name
E05E A684             (    forth6809.asm):02470                     LDA   ,X
E060 973E             (    forth6809.asm):02471                     STA   NAMELEN
E062 3001             (    forth6809.asm):02472                     LEAX  1,X
E064 9F3C             (    forth6809.asm):02473                     STX   NAMEP
                      (    forth6809.asm):02474         
E066 3706             (    forth6809.asm):02475                     PULU  D                 ; smudge flag
E068 3404             (    forth6809.asm):02476                     PSHS  B
                      (    forth6809.asm):02477         
E06A DC06             (    forth6809.asm):02478                     LDD   DPHERE
E06C DD3A             (    forth6809.asm):02479                     STD   NEWHDR
E06E 9E06             (    forth6809.asm):02480                     LDX   DPHERE
E070 963E             (    forth6809.asm):02481                     LDA   NAMELEN
E072 6DE0             (    forth6809.asm):02482                     TST   ,S+               ; smudge flag
E074 2702             (    forth6809.asm):02483                     BEQ   HDNOSM
E076 8A40             (    forth6809.asm):02484                     ORA   #$40
E078 A780             (    forth6809.asm):02485         HDNOSM:     STA   ,X+
E07A 109E3C           (    forth6809.asm):02486                     LDY   NAMEP
E07D D63E             (    forth6809.asm):02487                     LDB   NAMELEN
E07F 2707             (    forth6809.asm):02488                     BEQ   HDNONM
E081 A6A0             (    forth6809.asm):02489         HDCPY:      LDA   ,Y+
E083 A780             (    forth6809.asm):02490                     STA   ,X+
E085 5A               (    forth6809.asm):02491                     DECB
E086 26F9             (    forth6809.asm):02492                     BNE   HDCPY
E088 DC04             (    forth6809.asm):02493         HDNONM:     LDD   LATEST
E08A ED81             (    forth6809.asm):02494                     STD   ,X++
E08C DC08             (    forth6809.asm):02495                     LDD   CODEHERE
E08E ED81             (    forth6809.asm):02496                     STD   ,X++
E090 9F06             (    forth6809.asm):02497                     STX   DPHERE
E092 DC3A             (    forth6809.asm):02498                     LDD   NEWHDR
E094 DD04             (    forth6809.asm):02499                     STD   LATEST
E096 39               (    forth6809.asm):02500                     RTS
                      (    forth6809.asm):02501         
                      (    forth6809.asm):02502         ; ============================================================
                      (    forth6809.asm):02503         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02504         ; ============================================================
                      (    forth6809.asm):02505         ; ------------------------------------------------------------
                      (    forth6809.asm):02506         ; :  ( "name" -- )
                      (    forth6809.asm):02507         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02508         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02509         ; CSP and enter compile state.
                      (    forth6809.asm):02510         ; ------------------------------------------------------------
E097 CCFFFF           (    forth6809.asm):02511         COLONW:     LDD   #TRUEV
E09A 3606             (    forth6809.asm):02512                     PSHU  D
E09C BDE054           (    forth6809.asm):02513                     JSR   HEADER
E09F DC08             (    forth6809.asm):02514                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E0A1 DD3A             (    forth6809.asm):02515                     STD   CURXT             ; See bugfix: COLONW.1
E0A3 1F30             (    forth6809.asm):02516                     TFR   U,D
E0A5 DD43             (    forth6809.asm):02517                     STD   CSP
E0A7 CCFFFF           (    forth6809.asm):02518                     LDD   #-1
E0AA DD00             (    forth6809.asm):02519                     STD   STATE
E0AC 39               (    forth6809.asm):02520                     RTS
                      (    forth6809.asm):02521         
                      (    forth6809.asm):02522         ; ------------------------------------------------------------
                      (    forth6809.asm):02523         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02524         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02525         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02526         ; new word and return to interpret state.
                      (    forth6809.asm):02527         ; ------------------------------------------------------------
E0AD CC0039           (    forth6809.asm):02528         SEMIW:      LDD   #RTSOPC
E0B0 3606             (    forth6809.asm):02529                     PSHU  D
E0B2 BDE00E           (    forth6809.asm):02530                     JSR   CCOMMA1
E0B5 1F30             (    forth6809.asm):02531                     TFR   U,D
E0B7 109343           (    forth6809.asm):02532                     CMPD  CSP
E0BA 2703             (    forth6809.asm):02533                     BEQ   SEMIOK
E0BC BDE611           (    forth6809.asm):02534                     JSR   CFERR
E0BF 9E04             (    forth6809.asm):02535         SEMIOK:     LDX   LATEST
E0C1 A684             (    forth6809.asm):02536                     LDA   ,X
E0C3 84BF             (    forth6809.asm):02537                     ANDA  #$BF
E0C5 A784             (    forth6809.asm):02538                     STA   ,X
E0C7 CC0000           (    forth6809.asm):02539                     LDD   #0
E0CA DD00             (    forth6809.asm):02540                     STD   STATE
E0CC 39               (    forth6809.asm):02541                     RTS
                      (    forth6809.asm):02542         
                      (    forth6809.asm):02543         ; ------------------------------------------------------------
                      (    forth6809.asm):02544         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02545         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02546         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02547         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02548         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02549         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02550         ; ------------------------------------------------------------
E0CD DC08             (    forth6809.asm):02551         NONAMEW:    LDD   CODEHERE
E0CF 3606             (    forth6809.asm):02552                     PSHU  D                 ; xt
E0D1 DD3A             (    forth6809.asm):02553                     STD   CURXT             ; See bugfix: NONAMEW.1
E0D3 1F30             (    forth6809.asm):02554                     TFR   U,D
E0D5 DD43             (    forth6809.asm):02555                     STD   CSP
E0D7 CCFFFF           (    forth6809.asm):02556                     LDD   #-1
E0DA DD00             (    forth6809.asm):02557                     STD   STATE
E0DC 39               (    forth6809.asm):02558                     RTS
                      (    forth6809.asm):02559         
                      (    forth6809.asm):02560         ; ------------------------------------------------------------
                      (    forth6809.asm):02561         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02562         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02563         ; BLDDOES
                      (    forth6809.asm):02564         ;    Inputs:
                      (    forth6809.asm):02565         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02566         ;    Outputs:
                      (    forth6809.asm):02567         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02568         ;    Registers: all changed.
                      (    forth6809.asm):02569         ; BLDSELF
                      (    forth6809.asm):02570         ;    Inputs:
                      (    forth6809.asm):02571         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02572         ;    Outputs:
                      (    forth6809.asm):02573         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02574         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02575         ;    Registers: all changed.
                      (    forth6809.asm):02576         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02577         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02578         ; ------------------------------------------------------------
E0DD 3406             (    forth6809.asm):02579         BLDDOES:    PSHS  D                 ; behaviour address
E0DF CC0000           (    forth6809.asm):02580                     LDD   #0
E0E2 3606             (    forth6809.asm):02581                     PSHU  D
E0E4 BDE054           (    forth6809.asm):02582                     JSR   HEADER
E0E7 CCDF8F           (    forth6809.asm):02583                     LDD   #DODOES
E0EA 3606             (    forth6809.asm):02584                     PSHU  D
E0EC BDEABB           (    forth6809.asm):02585                     JSR   CCALL
E0EF 3506             (    forth6809.asm):02586                     PULS  D
E0F1 3606             (    forth6809.asm):02587                     PSHU  D                 ; behaviour address
E0F3 BDE002           (    forth6809.asm):02588                     JSR   CODECOMMA
E0F6 39               (    forth6809.asm):02589                     RTS
                      (    forth6809.asm):02590         
E0F7 BDE0DD           (    forth6809.asm):02591         BLDSELF:    JSR   BLDDOES
E0FA DC08             (    forth6809.asm):02592                     LDD   CODEHERE          ; PFA = the cell after this one
E0FC C30002           (    forth6809.asm):02593                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0FF 3606             (    forth6809.asm):02594                     PSHU  D
E101 BDE002           (    forth6809.asm):02595                     JSR   CODECOMMA
E104 39               (    forth6809.asm):02596                     RTS
                      (    forth6809.asm):02597         
                      (    forth6809.asm):02598         ; ------------------------------------------------------------
                      (    forth6809.asm):02599         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02600         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02601         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02602         ; address in the code area, on the stack.
                      (    forth6809.asm):02603         ; ------------------------------------------------------------
E105 CCDF9A           (    forth6809.asm):02604         CREATEW:    LDD   #DOESRT0
E108 BDE0F7           (    forth6809.asm):02605                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E10B 39               (    forth6809.asm):02606                     RTS
                      (    forth6809.asm):02607         
                      (    forth6809.asm):02608         ; ------------------------------------------------------------
                      (    forth6809.asm):02609         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02610         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02611         ; of the word being defined.
                      (    forth6809.asm):02612         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02613         ; ------------------------------------------------------------
E10C CCDF9B           (    forth6809.asm):02614         DOESGTW:    LDD   #SETDOES
E10F 3606             (    forth6809.asm):02615                     PSHU  D
E111 BDEABB           (    forth6809.asm):02616                     JSR   CCALL
E114 39               (    forth6809.asm):02617                     RTS
                      (    forth6809.asm):02618         
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
                      (    forth6809.asm):02620         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02621         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02622         ; area, initialised to zero.
                      (    forth6809.asm):02623         ; ------------------------------------------------------------
E115 CC0000           (    forth6809.asm):02624         VARIABLEW:  LDD   #0
E118 3606             (    forth6809.asm):02625                     PSHU  D
E11A BDE054           (    forth6809.asm):02626                     JSR   HEADER
E11D CCDF8F           (    forth6809.asm):02627                     LDD   #DODOES
E120 3606             (    forth6809.asm):02628                     PSHU  D
E122 BDEABB           (    forth6809.asm):02629                     JSR   CCALL
E125 CCDF9A           (    forth6809.asm):02630                     LDD   #DOESRT0
E128 3606             (    forth6809.asm):02631                     PSHU  D
E12A BDE002           (    forth6809.asm):02632                     JSR   CODECOMMA
E12D DC0A             (    forth6809.asm):02633                     LDD   VARHERE
E12F 3606             (    forth6809.asm):02634                     PSHU  D
E131 BDE002           (    forth6809.asm):02635                     JSR   CODECOMMA
E134 CC0000           (    forth6809.asm):02636                     LDD   #0
E137 9E0A             (    forth6809.asm):02637                     LDX   VARHERE
E139 ED81             (    forth6809.asm):02638                     STD   ,X++
E13B 9F0A             (    forth6809.asm):02639                     STX   VARHERE
E13D 39               (    forth6809.asm):02640                     RTS
                      (    forth6809.asm):02641         
                      (    forth6809.asm):02642         ; ------------------------------------------------------------
                      (    forth6809.asm):02643         ; @  ( a-addr -- x )
                      (    forth6809.asm):02644         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02645         ; ------------------------------------------------------------
E13E 3710             (    forth6809.asm):02646         FETCHW:     PULU  X                 ; a-addr
E140 EC84             (    forth6809.asm):02647                     LDD   ,X
E142 3606             (    forth6809.asm):02648                     PSHU  D                 ; x
E144 39               (    forth6809.asm):02649                     RTS
                      (    forth6809.asm):02650         
                      (    forth6809.asm):02651         ; ------------------------------------------------------------
                      (    forth6809.asm):02652         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02653         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02654         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02655         ; ------------------------------------------------------------
E145 CCE13E           (    forth6809.asm):02656         CONSTANTW:  LDD   #FETCHW
E148 BDE0F7           (    forth6809.asm):02657                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E14B BDDFFC           (    forth6809.asm):02658                     JSR   COMMAW
E14E 39               (    forth6809.asm):02659                     RTS
                      (    forth6809.asm):02660         
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
                      (    forth6809.asm):02662         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02663         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02664         ;    Inputs:
                      (    forth6809.asm):02665         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02666         ;    Outputs:
                      (    forth6809.asm):02667         ;        pfa replaced by the value
                      (    forth6809.asm):02668         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02669         ; ------------------------------------------------------------
E14F 3710             (    forth6809.asm):02670         DOVALUE:    PULU  X                 ; pfa
E151 EC84             (    forth6809.asm):02671                     LDD   ,X
E153 3606             (    forth6809.asm):02672                     PSHU  D                 ; x
E155 39               (    forth6809.asm):02673                     RTS
                      (    forth6809.asm):02674         
                      (    forth6809.asm):02675         ; ------------------------------------------------------------
                      (    forth6809.asm):02676         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02677         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02678         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02679         ; ------------------------------------------------------------
E156 CCE14F           (    forth6809.asm):02680         VALUEW:     LDD   #DOVALUE
E159 BDE0DD           (    forth6809.asm):02681                     JSR   BLDDOES
E15C DC0A             (    forth6809.asm):02682                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E15E 3606             (    forth6809.asm):02683                     PSHU  D                 ; See bugfix: VALUEW.1
E160 BDE002           (    forth6809.asm):02684                     JSR   CODECOMMA
E163 BDE014           (    forth6809.asm):02685                     JSR   VCOMMAW           ; store x in the variable area
E166 39               (    forth6809.asm):02686                     RTS
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
                      (    forth6809.asm):02689         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02690         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02691         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
E167 CC0020           (    forth6809.asm):02693         TOW:        LDD   #32
E16A 3606             (    forth6809.asm):02694                     PSHU  D
E16C BDE34F           (    forth6809.asm):02695                     JSR   WORDW
E16F BDE3BB           (    forth6809.asm):02696                     JSR   FINDW
E172 3706             (    forth6809.asm):02697                     PULU  D
E174 10830000         (    forth6809.asm):02698                     CMPD  #0
E178 260A             (    forth6809.asm):02699                     BNE   TOFOUND
E17A 3706             (    forth6809.asm):02700                     PULU  D
E17C CCFFF3           (    forth6809.asm):02701                     LDD   #-13
E17F 3606             (    forth6809.asm):02702                     PSHU  D
E181 BDE646           (    forth6809.asm):02703                     JSR   THROWW
E184 BDEB6D           (    forth6809.asm):02704         TOFOUND:    JSR   TOBODYW
E187 DC00             (    forth6809.asm):02705                     LDD   STATE
E189 270C             (    forth6809.asm):02706                     BEQ   TOIMMED
E18B BDEAC8           (    forth6809.asm):02707                     JSR   LITERALW
E18E CCF3CD           (    forth6809.asm):02708                     LDD   #STOREW
E191 3606             (    forth6809.asm):02709                     PSHU  D
E193 BDEABB           (    forth6809.asm):02710                     JSR   CCALL
E196 39               (    forth6809.asm):02711                     RTS
E197 3710             (    forth6809.asm):02712         TOIMMED:    PULU  X                 ; a-addr of the value cell
E199 3706             (    forth6809.asm):02713                     PULU  D                 ; x
E19B ED84             (    forth6809.asm):02714                     STD   ,X
E19D 39               (    forth6809.asm):02715                     RTS
                      (    forth6809.asm):02716         
                      (    forth6809.asm):02717         ; ------------------------------------------------------------
                      (    forth6809.asm):02718         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02719         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02720         ; the variable area, initialised to zero.
                      (    forth6809.asm):02721         ; ------------------------------------------------------------
E19E                  (    forth6809.asm):02722         TWOVARIABLEW:
E19E CC0000           (    forth6809.asm):02723                     LDD   #0
E1A1 3606             (    forth6809.asm):02724                     PSHU  D
E1A3 BDE054           (    forth6809.asm):02725                     JSR   HEADER
E1A6 CCDF8F           (    forth6809.asm):02726                     LDD   #DODOES
E1A9 3606             (    forth6809.asm):02727                     PSHU  D
E1AB BDEABB           (    forth6809.asm):02728                     JSR   CCALL
E1AE CCDF9A           (    forth6809.asm):02729                     LDD   #DOESRT0
E1B1 3606             (    forth6809.asm):02730                     PSHU  D
E1B3 BDE002           (    forth6809.asm):02731                     JSR   CODECOMMA
E1B6 DC0A             (    forth6809.asm):02732                     LDD   VARHERE
E1B8 3606             (    forth6809.asm):02733                     PSHU  D
E1BA BDE002           (    forth6809.asm):02734                     JSR   CODECOMMA
E1BD CC0000           (    forth6809.asm):02735                     LDD   #0
E1C0 9E0A             (    forth6809.asm):02736                     LDX   VARHERE
E1C2 ED81             (    forth6809.asm):02737                     STD   ,X++
E1C4 ED81             (    forth6809.asm):02738                     STD   ,X++
E1C6 9F0A             (    forth6809.asm):02739                     STX   VARHERE
E1C8 39               (    forth6809.asm):02740                     RTS
                      (    forth6809.asm):02741         
                      (    forth6809.asm):02742         ; ------------------------------------------------------------
                      (    forth6809.asm):02743         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02744         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02745         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02746         ; ------------------------------------------------------------
E1C9                  (    forth6809.asm):02747         TWOCONSTANTW:
E1C9 CCF3EC           (    forth6809.asm):02748                     LDD   #TWOFETCHW
E1CC BDE0F7           (    forth6809.asm):02749                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1CF 3706             (    forth6809.asm):02750                     PULU  D                 ; x2
E1D1 DD29             (    forth6809.asm):02751                     STD   MSCR
E1D3 DC29             (    forth6809.asm):02752                     LDD   MSCR
E1D5 3606             (    forth6809.asm):02753                     PSHU  D
E1D7 BDDFFC           (    forth6809.asm):02754                     JSR   COMMAW            ; x2 -> lower address
E1DA BDDFFC           (    forth6809.asm):02755                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1
E1DD 39               (    forth6809.asm):02756                     RTS
                      (    forth6809.asm):02757         
                      (    forth6809.asm):02758         ; ------------------------------------------------------------
                      (    forth6809.asm):02759         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02760         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):02761         ; the variable area.
                      (    forth6809.asm):02762         ; ------------------------------------------------------------
E1DE                  (    forth6809.asm):02763         BUFFERCOLONW:
E1DE 3706             (    forth6809.asm):02764                     PULU  D                 ; u
E1E0 DD2B             (    forth6809.asm):02765                     STD   MSCR2
E1E2 CC0000           (    forth6809.asm):02766                     LDD   #0
E1E5 3606             (    forth6809.asm):02767                     PSHU  D
E1E7 BDE054           (    forth6809.asm):02768                     JSR   HEADER
E1EA CCDF8F           (    forth6809.asm):02769                     LDD   #DODOES
E1ED 3606             (    forth6809.asm):02770                     PSHU  D
E1EF BDEABB           (    forth6809.asm):02771                     JSR   CCALL
E1F2 CCDF9A           (    forth6809.asm):02772                     LDD   #DOESRT0
E1F5 3606             (    forth6809.asm):02773                     PSHU  D
E1F7 BDE002           (    forth6809.asm):02774                     JSR   CODECOMMA
E1FA DC0A             (    forth6809.asm):02775                     LDD   VARHERE
E1FC 3606             (    forth6809.asm):02776                     PSHU  D
E1FE BDE002           (    forth6809.asm):02777                     JSR   CODECOMMA

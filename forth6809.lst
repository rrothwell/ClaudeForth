                      (    forth6809.asm):02565         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02566         ; ============================================================
DD82 CC021B           (    forth6809.asm):02567         COLD:    LDD   #APPVARS
DD85 DD0A             (    forth6809.asm):02568                  STD   VARHERE
DD87 CC7000           (    forth6809.asm):02569                  LDD   #APPCODE
DD8A DD08             (    forth6809.asm):02570                  STD   CODEHERE
DD8C CC2000           (    forth6809.asm):02571                  LDD   #APPDICT
DD8F DD06             (    forth6809.asm):02572                  STD   DPHERE
DD91 CCDD3F           (    forth6809.asm):02573                  LDD   #BASELATEST
DD94 DD04             (    forth6809.asm):02574                  STD   LATEST
                      (    forth6809.asm):02575         
DD96 CC000A           (    forth6809.asm):02576                  LDD   #10
DD99 DD02             (    forth6809.asm):02577                  STD   BASE
                      (    forth6809.asm):02578         
DD9B CC0106           (    forth6809.asm):02579                  LDD   #TIBBUF
DD9E DDDB             (    forth6809.asm):02580                  STD   SRCADDR
DDA0 CC0000           (    forth6809.asm):02581                  LDD   #0
DDA3 DDDD             (    forth6809.asm):02582                  STD   SRCLEN
DDA5 DDDF             (    forth6809.asm):02583                  STD   SRCID
                      (    forth6809.asm):02584         
DDA7 8EDE2A           (    forth6809.asm):02585                  LDX   #SIGNON
DDAA 3610             (    forth6809.asm):02586                  PSHU  X
DDAC CC000F           (    forth6809.asm):02587                  LDD   #SIGNONL
DDAF 3606             (    forth6809.asm):02588                  PSHU  D
DDB1 BDF4E0           (    forth6809.asm):02589                  JSR   TYPE
DDB4 BDFB00           (    forth6809.asm):02590                  JSR   CRW

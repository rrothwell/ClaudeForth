                      (    forth6809.asm):00938         ; ------------------------------------------------------------
                      (    forth6809.asm):00939         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00940         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00941         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00942         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00943         ;
                      (    forth6809.asm):00944         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00945         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00946         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00947         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00948         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00949         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00950         ; where no real input will ever arrive.
                      (    forth6809.asm):00951         ;
                      (    forth6809.asm):00952         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00953         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00954         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00955         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00956         ; entirely, not just fail one test.
                      (    forth6809.asm):00957         ;
                      (    forth6809.asm):00958         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00959         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00960         ; thousands of times already across every prior test group
                      (    forth6809.asm):00961         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00962         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00963         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00964         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00965         ; returned.
                      (    forth6809.asm):00966         ; ------------------------------------------------------------
                      (    forth6809.asm):00967         
                      (    forth6809.asm):00968         ; ------------------------------------------------------------
                      (    forth6809.asm):00969         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00970         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00971         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00972         ; ------------------------------------------------------------
C17C                  (    forth6809.asm):00973         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00974         
                      (    forth6809.asm):00975                  LDD   #TSTGUARD
                      (    forth6809.asm):00976                  PSHU  D
                      (    forth6809.asm):00977                  STU   TSTUB4
                      (    forth6809.asm):00978         
                      (    forth6809.asm):00979                  JSR   KEYQ
                      (    forth6809.asm):00980         
                      (    forth6809.asm):00981                  STU   TSTUAF
                      (    forth6809.asm):00982         
                      (    forth6809.asm):00983                  PULU  D
                      (    forth6809.asm):00984                  CMPD  #FALSEV
                      (    forth6809.asm):00985                  BNE   KYFAIL
                      (    forth6809.asm):00986                  PULU  D
                      (    forth6809.asm):00987                  CMPD  #TSTGUARD
                      (    forth6809.asm):00988                  BNE   KYFAIL
                      (    forth6809.asm):00989         
                      (    forth6809.asm):00990                  LDD   TSTUB4
                      (    forth6809.asm):00991                  SUBD  TSTUAF
                      (    forth6809.asm):00992                  CMPD  #2
                      (    forth6809.asm):00993                  BNE   KYFAIL
                      (    forth6809.asm):00994         
                      (    forth6809.asm):00995                  LDD   #TRUEV
                      (    forth6809.asm):00996                  BRA   KYDONE
C17C                  (    forth6809.asm):00997         KYFAIL: LDD   #FALSEV
C17C                  (    forth6809.asm):00998         KYDONE: LDX   #TSTKEYQNAME
                      (    forth6809.asm):00999                  PSHU  X
                      (    forth6809.asm):01000                  PSHU  D
                      (    forth6809.asm):01001                  JSR   TSTREPORT
                      (    forth6809.asm):01002         
                      (    forth6809.asm):01003                  LDU   TSTU0
                      (    forth6809.asm):01004                  RTS
                      (    forth6809.asm):01005         
C17C                  (    forth6809.asm):01006         TSTKEYQNAME: FCB  7
                      (    forth6809.asm):01007                      FCC  "TSTKEYQ"
                      (    forth6809.asm):01008         
                      (    forth6809.asm):01009         ; ------------------------------------------------------------
                      (    forth6809.asm):01010         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):01011         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):01012         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):01013         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):01014         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):01015         ; that the call returned.
                      (    forth6809.asm):01016         ; ------------------------------------------------------------
C17C                  (    forth6809.asm):01017         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):01018         
                      (    forth6809.asm):01019                  LDD   #TSTGUARD
                      (    forth6809.asm):01020                  PSHU  D
                      (    forth6809.asm):01021                  LDD   #65
                      (    forth6809.asm):01022                  PSHU  D
                      (    forth6809.asm):01023                  STU   TSTUB4
                      (    forth6809.asm):01024         
                      (    forth6809.asm):01025                  JSR   EMIT
                      (    forth6809.asm):01026         
                      (    forth6809.asm):01027                  STU   TSTUAF
                      (    forth6809.asm):01028         
                      (    forth6809.asm):01029                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):01030                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):01031                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):01032                                 ; different implementations, gated the same way
                      (    forth6809.asm):01033                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):01034                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):01035                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):01036                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):01037                                 ; always failed despite the character genuinely
                      (    forth6809.asm):01038                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):01039                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):01040                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):01041                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):01042                                 ; - checking it verifies the argument was
                      (    forth6809.asm):01043                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):01044                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):01045                                 ; conditional needed.
                      (    forth6809.asm):01046                  CMPA  #65
                      (    forth6809.asm):01047                  BNE   EMFAIL
                      (    forth6809.asm):01048         
                      (    forth6809.asm):01049                  PULU  D
                      (    forth6809.asm):01050                  CMPD  #TSTGUARD
                      (    forth6809.asm):01051                  BNE   EMFAIL
                      (    forth6809.asm):01052         
                      (    forth6809.asm):01053                  LDD   TSTUB4
                      (    forth6809.asm):01054                  SUBD  TSTUAF
                      (    forth6809.asm):01055                  CMPD  #-2
                      (    forth6809.asm):01056                  BNE   EMFAIL
                      (    forth6809.asm):01057         
                      (    forth6809.asm):01058                  LDD   #TRUEV
                      (    forth6809.asm):01059                  BRA   EMDONE
C17C                  (    forth6809.asm):01060         EMFAIL:  LDD   #FALSEV
C17C                  (    forth6809.asm):01061         EMDONE:  LDX   #TSTEMITNAME
                      (    forth6809.asm):01062                  PSHU  X
                      (    forth6809.asm):01063                  PSHU  D
                      (    forth6809.asm):01064                  JSR   TSTREPORT
                      (    forth6809.asm):01065         
                      (    forth6809.asm):01066                  LDU   TSTU0
                      (    forth6809.asm):01067                  RTS
                      (    forth6809.asm):01068         
C17C                  (    forth6809.asm):01069         TSTEMITNAME: FCB  7
                      (    forth6809.asm):01070                      FCC  "TSTEMIT"
                      (    forth6809.asm):01071         
                      (    forth6809.asm):01072         ; ------------------------------------------------------------
                      (    forth6809.asm):01073         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01074         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01075         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01076         ; ------------------------------------------------------------
C17C                  (    forth6809.asm):01077         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01078         
                      (    forth6809.asm):01079                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01080                  LDA   OUTHEAD
                      (    forth6809.asm):01081                  STA   TSTOHSAV
                      (    forth6809.asm):01082                  ENDC ; <<<<
                      (    forth6809.asm):01083         
                      (    forth6809.asm):01084         
                      (    forth6809.asm):01085                  LDD   #TSTGUARD
                      (    forth6809.asm):01086                  PSHU  D
                      (    forth6809.asm):01087                  STU   TSTUB4
                      (    forth6809.asm):01088         
                      (    forth6809.asm):01089                  JSR   CRW
                      (    forth6809.asm):01090         
                      (    forth6809.asm):01091                  STU   TSTUAF
                      (    forth6809.asm):01092         
                      (    forth6809.asm):01093                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01094                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01095                                   ; in order
                      (    forth6809.asm):01096                  LDA   TSTOHSAV
                      (    forth6809.asm):01097                  ADDA  #2
                      (    forth6809.asm):01098                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01099                  CMPA  OUTHEAD
                      (    forth6809.asm):01100                  BNE   CRFAIL
                      (    forth6809.asm):01101         
                      (    forth6809.asm):01102                  LDX   #OUTBUF
                      (    forth6809.asm):01103                  LDB   TSTOHSAV
                      (    forth6809.asm):01104                  LDA   B,X
                      (    forth6809.asm):01105                  CMPA  #13
                      (    forth6809.asm):01106                  BNE   CRFAIL
                      (    forth6809.asm):01107                  INCB
                      (    forth6809.asm):01108                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01109                  LDA   B,X
                      (    forth6809.asm):01110                  CMPA  #10
                      (    forth6809.asm):01111                  BNE   CRFAIL
                      (    forth6809.asm):01112                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01113                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01114                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01115                                   ; entirely different implementations, gated
                      (    forth6809.asm):01116                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01117                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01118                                   ; currently active build) writes directly to
                      (    forth6809.asm):01119                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01120                                   ; all, so this check always failed despite
                      (    forth6809.asm):01121                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01122                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01123                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01124                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01125                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01126                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01127                                   ; depth check below is the most this variant
                      (    forth6809.asm):01128                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01129                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01130                                   ; persistent state.
                      (    forth6809.asm):01131                  LDA   EMITCH
                      (    forth6809.asm):01132                  CMPA  #10
                      (    forth6809.asm):01133                  BNE   CRFAIL
                      (    forth6809.asm):01134                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01135         
                      (    forth6809.asm):01136                  PULU  D
                      (    forth6809.asm):01137                  CMPD  #TSTGUARD
                      (    forth6809.asm):01138                  BNE   CRFAIL
                      (    forth6809.asm):01139         
                      (    forth6809.asm):01140                  LDD   TSTUB4
                      (    forth6809.asm):01141                  SUBD  TSTUAF
                      (    forth6809.asm):01142                  CMPD  #0
                      (    forth6809.asm):01143                  BNE   CRFAIL
                      (    forth6809.asm):01144         
                      (    forth6809.asm):01145                  LDD   #TRUEV
                      (    forth6809.asm):01146                  BRA   CRDONE
C17C                  (    forth6809.asm):01147         CRFAIL: LDD   #FALSEV
C17C                  (    forth6809.asm):01148         CRDONE: LDX   #TSTCRNAME
                      (    forth6809.asm):01149                  PSHU  X
                      (    forth6809.asm):01150                  PSHU  D
                      (    forth6809.asm):01151                  JSR   TSTREPORT
                      (    forth6809.asm):01152         
                      (    forth6809.asm):01153                  LDU   TSTU0
                      (    forth6809.asm):01154                  RTS
                      (    forth6809.asm):01155         
C17C                  (    forth6809.asm):01156         TSTCRNAME: FCB  5
                      (    forth6809.asm):01157                    FCC  "TSTCR"
                      (    forth6809.asm):01158         
                      (    forth6809.asm):01159         ; ------------------------------------------------------------
                      (    forth6809.asm):01160         ; TSTSPACE - unit test for SPACE. Verifies one space (32) is
                      (    forth6809.asm):01161         ; genuinely queued.
                      (    forth6809.asm):01162         ; ------------------------------------------------------------
C17C                  (    forth6809.asm):01163         TSTSPACE: STU  TSTU0
                      (    forth6809.asm):01164         
                      (    forth6809.asm):01165                   LDD  #TSTGUARD
                      (    forth6809.asm):01166                   PSHU D
                      (    forth6809.asm):01167                   STU  TSTUB4
                      (    forth6809.asm):01168         

                      (    forth6809.asm):02485         ; ------------------------------------------------------------
                      (    forth6809.asm):02486         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02487         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02488         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02489         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02490         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02491         ; not assumed from the name.
                      (    forth6809.asm):02492         ; ------------------------------------------------------------
C1B4                  (    forth6809.asm):02493         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02494         
                      (    forth6809.asm):02495                    LDD  #TSTGUARD
                      (    forth6809.asm):02496                    PSHU D
                      (    forth6809.asm):02497                    LDD  #TSTVAL1
                      (    forth6809.asm):02498                    PSHU D
                      (    forth6809.asm):02499                    STU  TSTUB4
                      (    forth6809.asm):02500         
                      (    forth6809.asm):02501                    JSR  TOR
                      (    forth6809.asm):02502                    JSR  RFETCH
                      (    forth6809.asm):02503                    JSR  FROMR
                      (    forth6809.asm):02504         
                      (    forth6809.asm):02505                    STU  TSTUAF
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507                    PULU D
                      (    forth6809.asm):02508                    CMPD #TSTVAL1
                      (    forth6809.asm):02509                    BNE  RFFAIL
                      (    forth6809.asm):02510                    PULU D
                      (    forth6809.asm):02511                    CMPD #TSTVAL1
                      (    forth6809.asm):02512                    BNE  RFFAIL
                      (    forth6809.asm):02513                    PULU D
                      (    forth6809.asm):02514                    CMPD #TSTGUARD
                      (    forth6809.asm):02515                    BNE  RFFAIL
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517                    LDD  TSTUB4
                      (    forth6809.asm):02518                    SUBD TSTUAF
                      (    forth6809.asm):02519                    CMPD #2
                      (    forth6809.asm):02520                    BNE  RFFAIL
                      (    forth6809.asm):02521         
                      (    forth6809.asm):02522                    LDD  #TRUEV
                      (    forth6809.asm):02523                    BRA  RFDONE
C1B4                  (    forth6809.asm):02524         RFFAIL:    LDD  #FALSEV
C1B4                  (    forth6809.asm):02525         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02526                    PSHU X
                      (    forth6809.asm):02527                    PSHU D
                      (    forth6809.asm):02528                    JSR  TSTREPORT
                      (    forth6809.asm):02529         
                      (    forth6809.asm):02530                    LDU  TSTU0
                      (    forth6809.asm):02531                    RTS
                      (    forth6809.asm):02532         
C1B4                  (    forth6809.asm):02533         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02534                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02535         
                      (    forth6809.asm):02536         ; ------------------------------------------------------------
                      (    forth6809.asm):02537         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02538         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02539         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02540         ; verifying the round trip.
                      (    forth6809.asm):02541         ; ------------------------------------------------------------
C1B4                  (    forth6809.asm):02542         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02543         
                      (    forth6809.asm):02544                    LDD  #TSTGUARD
                      (    forth6809.asm):02545                    PSHU D
                      (    forth6809.asm):02546                    LDD  #TSTVAL1
                      (    forth6809.asm):02547                    PSHU D
                      (    forth6809.asm):02548                    LDD  #TSTVAL2
                      (    forth6809.asm):02549                    PSHU D
                      (    forth6809.asm):02550                    STU  TSTUB4
                      (    forth6809.asm):02551         
                      (    forth6809.asm):02552                    JSR  TWOTOR
                      (    forth6809.asm):02553         
                      (    forth6809.asm):02554                    STU  TSTUMID
                      (    forth6809.asm):02555         
                      (    forth6809.asm):02556                    LDD  TSTUB4
                      (    forth6809.asm):02557                    SUBD TSTUMID
                      (    forth6809.asm):02558                    CMPD #-4
                      (    forth6809.asm):02559                    BNE  T2RFAIL
                      (    forth6809.asm):02560         
                      (    forth6809.asm):02561                    JSR  TWOFROMR
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563                    STU  TSTUAF
                      (    forth6809.asm):02564         
                      (    forth6809.asm):02565                    PULU D
                      (    forth6809.asm):02566                    CMPD #TSTVAL2
                      (    forth6809.asm):02567                    BNE  T2RFAIL
                      (    forth6809.asm):02568                    PULU D
                      (    forth6809.asm):02569                    CMPD #TSTVAL1
                      (    forth6809.asm):02570                    BNE  T2RFAIL
                      (    forth6809.asm):02571                    PULU D
                      (    forth6809.asm):02572                    CMPD #TSTGUARD
                      (    forth6809.asm):02573                    BNE  T2RFAIL
                      (    forth6809.asm):02574         
                      (    forth6809.asm):02575                    LDD  TSTUB4
                      (    forth6809.asm):02576                    SUBD TSTUAF
                      (    forth6809.asm):02577                    CMPD #0
                      (    forth6809.asm):02578                    BNE  T2RFAIL
                      (    forth6809.asm):02579         
                      (    forth6809.asm):02580                    LDD  #TRUEV
                      (    forth6809.asm):02581                    BRA  T2RDONE
C1B4                  (    forth6809.asm):02582         T2RFAIL:   LDD  #FALSEV
C1B4                  (    forth6809.asm):02583         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02584                    PSHU X
                      (    forth6809.asm):02585                    PSHU D
                      (    forth6809.asm):02586                    JSR  TSTREPORT
                      (    forth6809.asm):02587         
                      (    forth6809.asm):02588                    LDU  TSTU0
                      (    forth6809.asm):02589                    RTS
                      (    forth6809.asm):02590         
C1B4                  (    forth6809.asm):02591         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02592                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02593         
                      (    forth6809.asm):02594         ; ------------------------------------------------------------
                      (    forth6809.asm):02595         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02596         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02597         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02598         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02599         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02600         ; ------------------------------------------------------------

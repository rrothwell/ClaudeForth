00EF                  (    forth6809.asm):00585         ENVLEN     RMB   2   ; offset $EF
00F1                  (    forth6809.asm):00586         ENVADDR    RMB   2   ; offset $F1
00F3                  (    forth6809.asm):00587         QSAVEDP    RMB   2   ; offset $F3
00F5                  (    forth6809.asm):00588         QSAVECODE  RMB   2   ; offset $F5
00F7                  (    forth6809.asm):00589         QSAVEVAR   RMB   2   ; offset $F7
00F9                  (    forth6809.asm):00590         QSAVELATEST RMB  2   ; offset $F9
00FB                  (    forth6809.asm):00591         QTHROWCODE RMB   2   ; offset $FB
00FD                  (    forth6809.asm):00592         DOESBEH    RMB   2   ; offset $FD - SETDOES scratch
00FF                  (    forth6809.asm):00593         RTSSTATE   RMB   1   ; offset $FF - 0 = RTS low (normal), nonzero = RTS
                      (    forth6809.asm):00594                               ; high (paused) - see CR_RTSHI. GLOBALS page is now
                      (    forth6809.asm):00595                               ; fully packed: 256 of 256 bytes used, 0 free.
                      (    forth6809.asm):00596         
     0100             (    forth6809.asm):00597         GLOBALS_USED EQU 256  ; total bytes used, of 256 available - fully packed
                      (    forth6809.asm):00598         
                      (    forth6809.asm):00599         ; ------------------------------------------------------------
                      (    forth6809.asm):00600         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00601         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00602         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00603         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00604         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00605         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00606         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00607         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00608         ;
                      (    forth6809.asm):00609         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00610         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00611         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00612         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00613         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00614         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00615         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00616         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00617         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00618         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00619         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00620         ; ------------------------------------------------------------
                      (    forth6809.asm):00621                  ORG   $0100
0100                  (    forth6809.asm):00622         MVCNT      RMB   2
0102                  (    forth6809.asm):00623         MVDST      RMB   2
0104                  (    forth6809.asm):00624         MVSRC      RMB   2
     0100             (    forth6809.asm):00625         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00626         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00627         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00628         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00629         
                      (    forth6809.asm):00630         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00631         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00632                  ORG USROMSTRT
                      (    forth6809.asm):00633         
                      (    forth6809.asm):00634                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00635         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00636                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00637                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00638                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00639                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00640                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00641                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00642                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00643                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00644                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00645                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00646                           ; choice is made, not what including it does.
                      (    forth6809.asm):00647                    ENDC
                      (    forth6809.asm):00648         
                      (    forth6809.asm):00649                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00650         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00651                    ENDC
                      (    forth6809.asm):00652         
                      (    forth6809.asm):00653                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00654         
                      (    forth6809.asm):00655         ; ------------------------------------------------------------
                      (    forth6809.asm):00656         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00657         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00658         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00659         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00660         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00661         ; ------------------------------------------------------------
                      (    forth6809.asm):00662                  INCLUDE unit_tests.asm
                      (    forth6809.asm):00663         
                      (    forth6809.asm):00664                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00665         

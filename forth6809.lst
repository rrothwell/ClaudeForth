                      (    forth6809.asm):01531         ; ------------------------------------------------------------
                      (    forth6809.asm):01532         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01533         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01534         ; INITSERIAL
                      (    forth6809.asm):01535         ;    Inputs:
                      (    forth6809.asm):01536         ;        none
                      (    forth6809.asm):01537         ;    Outputs:

                      (    forth6809.asm):11995         ; ------------------------------------------------------------
                      (    forth6809.asm):11996         ; TSTSTRPARSE - strings & parsing tests (glossary section 3.12,
                      (    forth6809.asm):11997         ; 16 words, 19 tests since several get separate cases: [CHAR]
                      (    forth6809.asm):11998         ; compiling/interpreting state, S" compiling/interpreting state
                      (    forth6809.asm):11999         ; (this word genuinely has both), SEARCH found/not-found,
                      (    forth6809.asm):12000         ; REPLACES/SUBSTITUTE combined across two tests (covering all 4
                      (    forth6809.asm):12001         ; of SUBSTITUTE's own documented %-delimiter cases), SNAME
                      (    forth6809.asm):12002         ; found/not-found.
                      (    forth6809.asm):12003         ;
                      (    forth6809.asm):12004         ; . has no STATE check at all in its own code (confirmed by
                      (    forth6809.asm):12005         ; reading it directly - matches "no interpretation semantics,
                      (    forth6809.asm):12006         ; per ANS" without a specific -14 throw, unlike [CHAR]/S"), so
                      (    forth6809.asm):12007         ; only its compiling case is tested. Its own runtime calls TYPE
                      (    forth6809.asm):12008         ; internally, so its own test applies the SERIALPOLL-conditional
                      (    forth6809.asm):12009         ; lesson from section 3.1 from the start, rather than
                      (    forth6809.asm):12010         ; re-discovering it via a failed MAME run.
                      (    forth6809.asm):12011         ;
                      (    forth6809.asm):12012         ; SUBSTITUTE/REPLACES/UNESCAPE all carry extensive prior-session
                      (    forth6809.asm):12013         ; bug-fix history in their own comments - confirmed fresh against

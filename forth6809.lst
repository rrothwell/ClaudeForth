                      (    forth6809.asm):08380         ; ------------------------------------------------------------
                      (    forth6809.asm):08381         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08382         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08383         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08384         ; WARM
                      (    forth6809.asm):08385         ;    Inputs:
                      (    forth6809.asm):08386         ;        NMI
                      (    forth6809.asm):08387         ;    Outputs:
                      (    forth6809.asm):08388         ;        does not return
                      (    forth6809.asm):08389         ;    Registers: all registers initialised.
                      (    forth6809.asm):08390         ; ------------------------------------------------------------

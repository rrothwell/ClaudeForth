E5D4 43               (    forth6809.asm):19219                   COMA
E5D5 53               (    forth6809.asm):19220                   COMB
E5D6 3501             (    forth6809.asm):19221                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):19222                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):19223                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):19224                                      ; when there's no carry - the complemented
                      (    forth6809.asm):19225                                      ; value was computed in D but never
                      (    forth6809.asm):19226                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):19227                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):19228                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):19229                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):19230                                      ; was always seen as set, so this branch
                      (    forth6809.asm):19231                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):19232                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):19233                                      ; alone would have made this second,
                      (    forth6809.asm):19234                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):19235                                      ; only past the "+1", never past the
                      (    forth6809.asm):19236                                      ; store itself - the store always runs,
                      (    forth6809.asm):19237                                      ; either way.

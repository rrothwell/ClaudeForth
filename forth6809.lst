                      (    forth6809.asm):09974         ; TSTLITERAL - unit test for LITERAL. Already used extensively
                      (    forth6809.asm):09975         ; as an internal helper throughout sections 3.8/3.9's own tests,
                      (    forth6809.asm):09976         ; but gets its own dedicated, direct test here too, per this
                      (    forth6809.asm):09977         ; section's own coverage. Compiles a known value as a literal,
                      (    forth6809.asm):09978         ; then executes the result to confirm it genuinely pushes it.
                      (    forth6809.asm):09979         ; ------------------------------------------------------------
C27B                  (    forth6809.asm):09980         TSTLITERAL: LDD  CODEHERE
                      (    forth6809.asm):09981                     STD  TSTCSAV
                      (    forth6809.asm):09982         
                      (    forth6809.asm):09983                     LDD  #TSTCBUF
                      (    forth6809.asm):09984                     STD  CODEHERE
                      (    forth6809.asm):09985         
                      (    forth6809.asm):09986                     LDD  #TSTVAL1
                      (    forth6809.asm):09987                     PSHU D
                      (    forth6809.asm):09988                     JSR  LITERALW

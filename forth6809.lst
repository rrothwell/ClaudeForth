                      (    forth6809.asm):03688         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03689         ; to 0 and >IN to 0.
                      (    forth6809.asm):03690         ; ------------------------------------------------------------
E5B5 8E0106           (    forth6809.asm):03691         QUERYW:     LDX   #TIBBUF
E5B8 3610             (    forth6809.asm):03692                     PSHU  X
E5BA CC0050           (    forth6809.asm):03693                     LDD   #TIBBUFL
E5BD 3606             (    forth6809.asm):03694                     PSHU  D

DD78 F60179           (    forth6809.asm):01724                     LDB   OUTHEAD           ; Is buffer full?
DD7B 5C               (    forth6809.asm):01725                     INCB
DD7C C43F             (    forth6809.asm):01726                     ANDB  #OUTBUFSZ-1
DD7E F1017A           (    forth6809.asm):01727                     CMPB  OUTTAIL
DD81 273A             (    forth6809.asm):01728                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01729         
DD83 8E01C0           (    forth6809.asm):01730                     LDX   #OUTBUF           ; Put character into character slot.

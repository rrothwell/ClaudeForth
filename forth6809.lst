                      (    forth6809.asm):04876                    PSHU  D
                      (    forth6809.asm):04877                    LDD   #TSTVAL2
                      (    forth6809.asm):04878                    PSHU  D
                      (    forth6809.asm):04879                    STU   TSTUB4
                      (    forth6809.asm):04880         
                      (    forth6809.asm):04881                    JSR   ANDW
                      (    forth6809.asm):04882         
                      (    forth6809.asm):04883                    STU   TSTUAF

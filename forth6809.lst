D816 3606             (    forth6809.asm):04563                     PSHU  D
D818 39               (    forth6809.asm):04564                     RTS
D819 CC0087           (    forth6809.asm):04565         KEYVW:      LDD   #KEYV
D81C 3606             (    forth6809.asm):04566                     PSHU  D
D81E 39               (    forth6809.asm):04567                     RTS
D81F CC0089           (    forth6809.asm):04568         KEYQVW:     LDD   #KEYQV
D822 3606             (    forth6809.asm):04569                     PSHU  D
D824 39               (    forth6809.asm):04570                     RTS
                      (    forth6809.asm):04571         
D825 CCCE33           (    forth6809.asm):04572         COLDIO:     LDD   #IRQRTI           ; cold start only: no extra interrupt
D828 DD83             (    forth6809.asm):04573                     STD   IRQCHAIN          ; handlers, then the same as IOVINIT
D82A CCD7F0           (    forth6809.asm):04574         IOVINIT:    LDD   #EMITACIA

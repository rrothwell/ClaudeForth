                      (    forth6809.asm):03607                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):03608         
E906 EC68             (    forth6809.asm):03609         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E908 3606             (    forth6809.asm):03610                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E90A 39               (    forth6809.asm):03611                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):03612                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):03613                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):03614                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):03615                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):03616                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):03617                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):03618                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):03619                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):03620                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):03621                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):03622                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):03623                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):03624                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):03625                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):03626                                   ; limit, never progressing). Confirmed via a
                      (    forth6809.asm):03627                                   ; real MULT-TABLE test on MAME.

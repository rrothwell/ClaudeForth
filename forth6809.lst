                      (    forth6809.asm):00898         ; ------------------------------------------------------------
                      (    forth6809.asm):00899         ; TSTSYSIO - System/Console I/O tests (glossary section 3.1, 12
                      (    forth6809.asm):00900         ; words, 7 tests). Six words are deliberately NOT tested here -
                      (    forth6809.asm):00901         ; KEY, ACCEPT, EXPECT, and QUERY all genuinely block on real
                      (    forth6809.asm):00902         ; input during automated, headless boot-time testing (confirmed
                      (    forth6809.asm):00903         ; by reading their own implementations: KEY spins on itself,
                      (    forth6809.asm):00904         ; ACCEPT calls KEY directly, EXPECT/QUERY both call ACCEPT); and
                      (    forth6809.asm):00905         ; ABORT/QUIT are both designed to never return (ABORT falls
                      (    forth6809.asm):00906         ; through into QUIT, which resets the return stack, discarding
                      (    forth6809.asm):00907         ; this entire call chain and hijacking the boot sequence into
                      (    forth6809.asm):00908         ; the interpreter's own top-level loop). See this group's own
                      (    forth6809.asm):00909         ; leading comment block, right before TSTKEYQ, for the full
                      (    forth6809.asm):00910         ; reasoning.
                      (    forth6809.asm):00911         ;
                      (    forth6809.asm):00912         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00913         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00914         ; thousands of times already across every prior test group.
                      (    forth6809.asm):00915         ; Each test here verifies the real queuing mechanism (OUTHEAD/
                      (    forth6809.asm):00916         ; OUTBUF), reading the actual character(s) back out of the
                      (    forth6809.asm):00917         ; output ring buffer to confirm they were genuinely queued, not
                      (    forth6809.asm):00918         ; just that the call returned without crashing.
                      (    forth6809.asm):00919         ; ------------------------------------------------------------
C16C BDFC2B           (    forth6809.asm):00920         TSTSYSIO: JSR   CRW
C16F 8EC180           (    forth6809.asm):00921                    LDX   #TSTSYSIOMSG
C172 3610             (    forth6809.asm):00922                    PSHU  X
C174 CC0005           (    forth6809.asm):00923                    LDD   #5
C177 3606             (    forth6809.asm):00924                    PSHU  D
C179 BDF60B           (    forth6809.asm):00925                    JSR   TYPE
C17C BDFC2B           (    forth6809.asm):00926                    JSR   CRW
                      (    forth6809.asm):00927         
                      (    forth6809.asm):00928                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00929         
                      (    forth6809.asm):00930                    JSR   TSTKEYQ
                      (    forth6809.asm):00931                    JSR   TSTEMIT
                      (    forth6809.asm):00932                    JSR   TSTCR
                      (    forth6809.asm):00933                    JSR   TSTSPACE
                      (    forth6809.asm):00934                    JSR   TSTSPACES
                      (    forth6809.asm):00935                    JSR   TSTSPACESZ
                      (    forth6809.asm):00936                    JSR   TSTTYPE
                      (    forth6809.asm):00937         
                      (    forth6809.asm):00938                    ENDC ; <<<<
                      (    forth6809.asm):00939         
C17F 39               (    forth6809.asm):00940                    RTS
                      (    forth6809.asm):00941         
C180 537973494F       (    forth6809.asm):00942         TSTSYSIOMSG: FCC "SysIO"
                      (    forth6809.asm):00943         
                      (    forth6809.asm):00944                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00945         
                      (    forth6809.asm):00946         ; ------------------------------------------------------------
                      (    forth6809.asm):00947         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00948         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00949         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00950         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00951         ;
                      (    forth6809.asm):00952         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00953         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00954         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00955         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00956         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00957         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00958         ; where no real input will ever arrive.
                      (    forth6809.asm):00959         ;
                      (    forth6809.asm):00960         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00961         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00962         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00963         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00964         ; entirely, not just fail one test.
                      (    forth6809.asm):00965         ;
                      (    forth6809.asm):00966         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00967         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00968         ; thousands of times already across every prior test group
                      (    forth6809.asm):00969         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00970         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00971         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00972         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00973         ; returned.
                      (    forth6809.asm):00974         ; ------------------------------------------------------------
                      (    forth6809.asm):00975         
                      (    forth6809.asm):00976         ; ------------------------------------------------------------
                      (    forth6809.asm):00977         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00978         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00979         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00980         ; ------------------------------------------------------------
C185                  (    forth6809.asm):00981         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00982         
                      (    forth6809.asm):00983                  LDD   #TSTGUARD
                      (    forth6809.asm):00984                  PSHU  D
                      (    forth6809.asm):00985                  STU   TSTUB4
                      (    forth6809.asm):00986         
                      (    forth6809.asm):00987                  JSR   KEYQ
                      (    forth6809.asm):00988         
                      (    forth6809.asm):00989                  STU   TSTUAF
                      (    forth6809.asm):00990         
                      (    forth6809.asm):00991                  PULU  D
                      (    forth6809.asm):00992                  CMPD  #FALSEV
                      (    forth6809.asm):00993                  BNE   KYFAIL
                      (    forth6809.asm):00994                  PULU  D
                      (    forth6809.asm):00995                  CMPD  #TSTGUARD
                      (    forth6809.asm):00996                  BNE   KYFAIL
                      (    forth6809.asm):00997         
                      (    forth6809.asm):00998                  LDD   TSTUB4
                      (    forth6809.asm):00999                  SUBD  TSTUAF
                      (    forth6809.asm):01000                  CMPD  #2
                      (    forth6809.asm):01001                  BNE   KYFAIL
                      (    forth6809.asm):01002         
                      (    forth6809.asm):01003                  LDD   #TRUEV
                      (    forth6809.asm):01004                  BRA   KYDONE
C185                  (    forth6809.asm):01005         KYFAIL: LDD   #FALSEV
C185                  (    forth6809.asm):01006         KYDONE: LDX   #TSTKEYQNAME
                      (    forth6809.asm):01007                  PSHU  X
                      (    forth6809.asm):01008                  PSHU  D
                      (    forth6809.asm):01009                  JSR   TSTREPORT
                      (    forth6809.asm):01010         
                      (    forth6809.asm):01011                  LDU   TSTU0
                      (    forth6809.asm):01012                  RTS
                      (    forth6809.asm):01013         
C185                  (    forth6809.asm):01014         TSTKEYQNAME: FCB  7
                      (    forth6809.asm):01015                      FCC  "TSTKEYQ"
                      (    forth6809.asm):01016         
                      (    forth6809.asm):01017         ; ------------------------------------------------------------
                      (    forth6809.asm):01018         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):01019         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):01020         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):01021         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):01022         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):01023         ; that the call returned.
                      (    forth6809.asm):01024         ; ------------------------------------------------------------
C185                  (    forth6809.asm):01025         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):01026         
                      (    forth6809.asm):01027                  LDD   #TSTGUARD
                      (    forth6809.asm):01028                  PSHU  D
                      (    forth6809.asm):01029                  LDD   #65
                      (    forth6809.asm):01030                  PSHU  D
                      (    forth6809.asm):01031                  STU   TSTUB4
                      (    forth6809.asm):01032         
                      (    forth6809.asm):01033                  JSR   EMIT
                      (    forth6809.asm):01034         
                      (    forth6809.asm):01035                  STU   TSTUAF
                      (    forth6809.asm):01036         
                      (    forth6809.asm):01037                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):01038                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):01039                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):01040                                 ; different implementations, gated the same way
                      (    forth6809.asm):01041                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):01042                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):01043                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):01044                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):01045                                 ; always failed despite the character genuinely
                      (    forth6809.asm):01046                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):01047                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):01048                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):01049                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):01050                                 ; - checking it verifies the argument was
                      (    forth6809.asm):01051                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):01052                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):01053                                 ; conditional needed.
                      (    forth6809.asm):01054                  CMPA  #65
                      (    forth6809.asm):01055                  BNE   EMFAIL
                      (    forth6809.asm):01056         
                      (    forth6809.asm):01057                  PULU  D
                      (    forth6809.asm):01058                  CMPD  #TSTGUARD
                      (    forth6809.asm):01059                  BNE   EMFAIL
                      (    forth6809.asm):01060         
                      (    forth6809.asm):01061                  LDD   TSTUB4
                      (    forth6809.asm):01062                  SUBD  TSTUAF
                      (    forth6809.asm):01063                  CMPD  #-2
                      (    forth6809.asm):01064                  BNE   EMFAIL
                      (    forth6809.asm):01065         
                      (    forth6809.asm):01066                  LDD   #TRUEV
                      (    forth6809.asm):01067                  BRA   EMDONE
C185                  (    forth6809.asm):01068         EMFAIL:  LDD   #FALSEV
C185                  (    forth6809.asm):01069         EMDONE:  LDX   #TSTEMITNAME
                      (    forth6809.asm):01070                  PSHU  X
                      (    forth6809.asm):01071                  PSHU  D
                      (    forth6809.asm):01072                  JSR   TSTREPORT
                      (    forth6809.asm):01073         
                      (    forth6809.asm):01074                  LDU   TSTU0
                      (    forth6809.asm):01075                  RTS
                      (    forth6809.asm):01076         
C185                  (    forth6809.asm):01077         TSTEMITNAME: FCB  7
                      (    forth6809.asm):01078                      FCC  "TSTEMIT"
                      (    forth6809.asm):01079         
                      (    forth6809.asm):01080         ; ------------------------------------------------------------
                      (    forth6809.asm):01081         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01082         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01083         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01084         ; ------------------------------------------------------------
C185                  (    forth6809.asm):01085         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01086         
                      (    forth6809.asm):01087                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01088                  LDA   OUTHEAD
                      (    forth6809.asm):01089                  STA   TSTOHSAV
                      (    forth6809.asm):01090                  ENDC ; <<<<
                      (    forth6809.asm):01091         
                      (    forth6809.asm):01092         
                      (    forth6809.asm):01093                  LDD   #TSTGUARD
                      (    forth6809.asm):01094                  PSHU  D
                      (    forth6809.asm):01095                  STU   TSTUB4
                      (    forth6809.asm):01096         
                      (    forth6809.asm):01097                  JSR   CRW
                      (    forth6809.asm):01098         
                      (    forth6809.asm):01099                  STU   TSTUAF
                      (    forth6809.asm):01100         
                      (    forth6809.asm):01101                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01102                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01103                                   ; in order
                      (    forth6809.asm):01104                  LDA   TSTOHSAV
                      (    forth6809.asm):01105                  ADDA  #2
                      (    forth6809.asm):01106                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01107                  CMPA  OUTHEAD
                      (    forth6809.asm):01108                  BNE   CRFAIL
                      (    forth6809.asm):01109         
                      (    forth6809.asm):01110                  LDX   #OUTBUF
                      (    forth6809.asm):01111                  LDB   TSTOHSAV
                      (    forth6809.asm):01112                  LDA   B,X
                      (    forth6809.asm):01113                  CMPA  #13
                      (    forth6809.asm):01114                  BNE   CRFAIL
                      (    forth6809.asm):01115                  INCB
                      (    forth6809.asm):01116                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01117                  LDA   B,X
                      (    forth6809.asm):01118                  CMPA  #10
                      (    forth6809.asm):01119                  BNE   CRFAIL
                      (    forth6809.asm):01120                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01121                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01122                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01123                                   ; entirely different implementations, gated
                      (    forth6809.asm):01124                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01125                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01126                                   ; currently active build) writes directly to
                      (    forth6809.asm):01127                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01128                                   ; all, so this check always failed despite
                      (    forth6809.asm):01129                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01130                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01131                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01132                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01133                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01134                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01135                                   ; depth check below is the most this variant
                      (    forth6809.asm):01136                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01137                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01138                                   ; persistent state.
                      (    forth6809.asm):01139                  LDA   EMITCH
                      (    forth6809.asm):01140                  CMPA  #10
                      (    forth6809.asm):01141                  BNE   CRFAIL
                      (    forth6809.asm):01142                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01143         
                      (    forth6809.asm):01144                  PULU  D
                      (    forth6809.asm):01145                  CMPD  #TSTGUARD
                      (    forth6809.asm):01146                  BNE   CRFAIL
                      (    forth6809.asm):01147         
                      (    forth6809.asm):01148                  LDD   TSTUB4
                      (    forth6809.asm):01149                  SUBD  TSTUAF
                      (    forth6809.asm):01150                  CMPD  #0
                      (    forth6809.asm):01151                  BNE   CRFAIL
                      (    forth6809.asm):01152         
                      (    forth6809.asm):01153                  LDD   #TRUEV
                      (    forth6809.asm):01154                  BRA   CRDONE
C185                  (    forth6809.asm):01155         CRFAIL: LDD   #FALSEV
C185                  (    forth6809.asm):01156         CRDONE: LDX   #TSTCRNAME
                      (    forth6809.asm):01157                  PSHU  X
                      (    forth6809.asm):01158                  PSHU  D
                      (    forth6809.asm):01159                  JSR   TSTREPORT
                      (    forth6809.asm):01160         
                      (    forth6809.asm):01161                  LDU   TSTU0
                      (    forth6809.asm):01162                  RTS
                      (    forth6809.asm):01163         
C185                  (    forth6809.asm):01164         TSTCRNAME: FCB  5
                      (    forth6809.asm):01165                    FCC  "TSTCR"
                      (    forth6809.asm):01166         
                      (    forth6809.asm):01167         ; ------------------------------------------------------------

     0100             (    forth6809.asm):00662         GLOBALS_USED EQU 256  ; total bytes used, of 256 available - fully packed
                      (    forth6809.asm):00663         
                      (    forth6809.asm):00664         ; ------------------------------------------------------------
                      (    forth6809.asm):00665         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00666         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00667         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00668         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00669         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00670         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00671         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00672         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00673         ;
                      (    forth6809.asm):00674         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00675         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00676         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00677         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00678         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00679         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00680         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00681         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00682         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00683         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00684         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00685         ; ------------------------------------------------------------
                      (    forth6809.asm):00686                  ORG   $0100
0100                  (    forth6809.asm):00687         MVCNT      RMB   2
0102                  (    forth6809.asm):00688         MVDST      RMB   2
0104                  (    forth6809.asm):00689         MVSRC      RMB   2
     0100             (    forth6809.asm):00690         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00691         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00692         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00693         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00694         
                      (    forth6809.asm):00695         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00696         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00697                  ORG USROMSTRT
                      (    forth6809.asm):00698         
                      (    forth6809.asm):00699                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00700         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00701                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00702                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00703                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00704                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00705                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00706                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00707                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00708                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00709                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00710                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00711                           ; choice is made, not what including it does.
                      (    forth6809.asm):00712                    ENDC
                      (    forth6809.asm):00713         
                      (    forth6809.asm):00714                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00715         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00716                    ENDC
                      (    forth6809.asm):00717         
                      (    forth6809.asm):00718                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00719         
                      (    forth6809.asm):00720         ; ------------------------------------------------------------
                      (    forth6809.asm):00721         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00722         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00723         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00724         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00725         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00726         ; ------------------------------------------------------------
                      (    forth6809.asm):00727                  INCLUDE unit_tests.asm
                      (    forth6809.asm):00728         
                      (    forth6809.asm):00729                  ENDC  ; <<<<<<<<<<

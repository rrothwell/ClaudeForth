                      (    forth6809.asm):14981         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):14982         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):14983         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):14984         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):14985         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):14986         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):14987         ; ============================================================
                      (    forth6809.asm):14988         ; ------------------------------------------------------------
                      (    forth6809.asm):14989         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):14990         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):14991         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):14992         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):14993         ; - no indirection, no value cell.
                      (    forth6809.asm):14994         ;
                      (    forth6809.asm):14995         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):14996         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):14997         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):14998         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):14999         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):15000         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):15001         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):15002         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):15003         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):15004         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):15005         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):15006         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):15007                    PSHU  D
FF3C 39               (    forth6809.asm):15008                    RTS
                      (    forth6809.asm):15009         
FF3D CC0000           (    forth6809.asm):15010         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):15011                    PSHU  D
FF42 39               (    forth6809.asm):15012                    RTS
                      (    forth6809.asm):15013         
                      (    forth6809.asm):15014         ; ------------------------------------------------------------
                      (    forth6809.asm):15015         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):15016         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):15017         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):15018         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):15019         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):15020         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):15021                    PSHU  D
FF48 39               (    forth6809.asm):15022                    RTS
                      (    forth6809.asm):15023         
FF49 CCFFFF           (    forth6809.asm):15024         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):15025                    PSHU  D
FF4E 39               (    forth6809.asm):15026                    RTS
                      (    forth6809.asm):15027         
FF4F CC0002           (    forth6809.asm):15028         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):15029                    PSHU  D
FF54 39               (    forth6809.asm):15030                    RTS
                      (    forth6809.asm):15031         

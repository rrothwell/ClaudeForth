                      (    forth6809.asm):03062         ; ------------------------------------------------------------
                      (    forth6809.asm):03063         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):03064         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):03065         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):03066         ; UDMULADD
                      (    forth6809.asm):03067         ;    Inputs:
                      (    forth6809.asm):03068         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):03069         ;        frame ( ud c-addr u )
                      (    forth6809.asm):03070         ;        RegB = digit value to add
                      (    forth6809.asm):03071         ;        BASE
                      (    forth6809.asm):03072         ;    Outputs:
                      (    forth6809.asm):03073         ;        ud = ud * BASE + digit
                      (    forth6809.asm):03074         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03075         ; ------------------------------------------------------------

                      (    forth6809.asm):01788                    CMPD  TSTSCR
                      (    forth6809.asm):01789                    BNE   DHFAIL
                      (    forth6809.asm):01790         
                      (    forth6809.asm):01791                    LDD   TSTUB4
                      (    forth6809.asm):01792                    SUBD  TSTUAF
                      (    forth6809.asm):01793                    CMPD  #2
                      (    forth6809.asm):01794                    BNE   DHFAIL
                      (    forth6809.asm):01795         
                      (    forth6809.asm):01796                    PULU  D
                      (    forth6809.asm):01797                    CMPD  #TSTVAL3
                      (    forth6809.asm):01798                    BNE   DHFAIL
                      (    forth6809.asm):01799                    PULU  D
                      (    forth6809.asm):01800                    CMPD  #TSTVAL2
                      (    forth6809.asm):01801                    BNE   DHFAIL
                      (    forth6809.asm):01802                    PULU  D
                      (    forth6809.asm):01803                    CMPD  #TSTVAL1
                      (    forth6809.asm):01804                    BNE   DHFAIL
                      (    forth6809.asm):01805         

                      (    forth6809.asm):05469                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):05470                                   ; The high byte took on the fill character's
                      (    forth6809.asm):05471                                   ; value instead of the count's real high
                      (    forth6809.asm):05472                                   ; byte, so the count almost never reached
                      (    forth6809.asm):05473                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):05474                                   ; past the requested length. Keeping the
                      (    forth6809.asm):05475                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):05476                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):05477                                   ; fill character into A) and removes the
                      (    forth6809.asm):05478                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):05479                                   ; addresses the redundant scratch usage

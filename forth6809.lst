                      (    forth6809.asm):03191         ; INTERPRET  ( -- )
                      (    forth6809.asm):03192         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03193         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03194         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03195         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03196         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03197         ; ------------------------------------------------------------

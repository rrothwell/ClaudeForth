                      (    forth6809.asm):12422         ; TSTPARSE - unit test for PARSE. Uses a fake source starting
                      (    forth6809.asm):12423         ; with the delimiter itself (",XY", delimiter ',') specifically
                      (    forth6809.asm):12424         ; to verify PARSE's own documented distinguishing behavior -
                      (    forth6809.asm):12425         ; "does not skip leading delimiters, unlike WORD" - the leading
                      (    forth6809.asm):12426         ; comma should be hit immediately, returning a zero-length token
                      (    forth6809.asm):12427         ; right where TOIN started, not skipped over to find "XY".
                      (    forth6809.asm):12428         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):12429         TSTPARSE: LDD  SRCADDR
                      (    forth6809.asm):12430                   STD  TSTSASAV
                      (    forth6809.asm):12431                   LDD  SRCLEN
                      (    forth6809.asm):12432                   STD  TSTSLSAV
                      (    forth6809.asm):12433                   LDD  TOIN
                      (    forth6809.asm):12434                   STD  TSTTISAV
                      (    forth6809.asm):12435         
                      (    forth6809.asm):12436                   LDA  #','
                      (    forth6809.asm):12437                   STA  TSTNAMEB
                      (    forth6809.asm):12438                   LDA  #'X'
                      (    forth6809.asm):12439                   STA  TSTNAMEB+1
                      (    forth6809.asm):12440                   LDA  #'Y'
                      (    forth6809.asm):12441                   STA  TSTNAMEB+2
                      (    forth6809.asm):12442         
                      (    forth6809.asm):12443                   LDD  #TSTNAMEB
                      (    forth6809.asm):12444                   STD  SRCADDR
                      (    forth6809.asm):12445                   LDD  #3
                      (    forth6809.asm):12446                   STD  SRCLEN
                      (    forth6809.asm):12447                   LDD  #0
                      (    forth6809.asm):12448                   STD  TOIN
                      (    forth6809.asm):12449         
                      (    forth6809.asm):12450                   STU  TSTU0
                      (    forth6809.asm):12451         
                      (    forth6809.asm):12452                   LDD  #TSTGUARD
                      (    forth6809.asm):12453                   PSHU D
                      (    forth6809.asm):12454                   LDD  #','
                      (    forth6809.asm):12455                   PSHU D
                      (    forth6809.asm):12456                   STU  TSTUB4
                      (    forth6809.asm):12457         
                      (    forth6809.asm):12458                   JSR  PARSEW
                      (    forth6809.asm):12459         
                      (    forth6809.asm):12460                   STU  TSTUAF
                      (    forth6809.asm):12461         
                      (    forth6809.asm):12462                   LDD  TSTSASAV
                      (    forth6809.asm):12463                   STD  SRCADDR
                      (    forth6809.asm):12464                   LDD  TSTSLSAV
                      (    forth6809.asm):12465                   STD  SRCLEN
                      (    forth6809.asm):12466                   LDD  TSTTISAV
                      (    forth6809.asm):12467                   STD  TOIN
                      (    forth6809.asm):12468         
                      (    forth6809.asm):12469                   PULU D
                      (    forth6809.asm):12470                   CMPD #0
                      (    forth6809.asm):12471                   BNE  PRFAIL
                      (    forth6809.asm):12472                   PULU D
                      (    forth6809.asm):12473                   CMPD #TSTNAMEB
                      (    forth6809.asm):12474                   BNE  PRFAIL
                      (    forth6809.asm):12475                   PULU D
                      (    forth6809.asm):12476                   CMPD #TSTGUARD
                      (    forth6809.asm):12477                   BNE  PRFAIL
                      (    forth6809.asm):12478         
                      (    forth6809.asm):12479                   LDD  TSTUB4
                      (    forth6809.asm):12480                   SUBD TSTUAF
                      (    forth6809.asm):12481                   CMPD #2
                      (    forth6809.asm):12482                   BNE  PRFAIL
                      (    forth6809.asm):12483         
                      (    forth6809.asm):12484                   LDD  #TRUEV
                      (    forth6809.asm):12485                   BRA  PRDONE
C2AB                  (    forth6809.asm):12486         PRFAIL:   LDD  #FALSEV
C2AB                  (    forth6809.asm):12487         PRDONE:   LDX  #TSTPRNAME
                      (    forth6809.asm):12488                   PSHU X
                      (    forth6809.asm):12489                   PSHU D
                      (    forth6809.asm):12490                   JSR  TSTREPORT
                      (    forth6809.asm):12491         
                      (    forth6809.asm):12492                   LDU  TSTU0
                      (    forth6809.asm):12493                   RTS
                      (    forth6809.asm):12494         
C2AB                  (    forth6809.asm):12495         TSTPRNAME: FCB  8
                      (    forth6809.asm):12496                    FCC  "TSTPARSE"
                      (    forth6809.asm):12497         
                      (    forth6809.asm):12498         ; ------------------------------------------------------------
                      (    forth6809.asm):12499         ; TSTPARSENAME - unit test for PARSE-NAME. Fake source with 2
                      (    forth6809.asm):12500         ; leading spaces before the token ("  AB CD"), verifying it
                      (    forth6809.asm):12501         ; genuinely skips them - the opposite of PARSE's own behavior,
                      (    forth6809.asm):12502         ; confirming the two aren't accidentally sharing one code path
                      (    forth6809.asm):12503         ; that only happens to work for one of them.
                      (    forth6809.asm):12504         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):12505         TSTPARSENAME: LDD  SRCADDR
                      (    forth6809.asm):12506                       STD  TSTSASAV
                      (    forth6809.asm):12507                       LDD  SRCLEN
                      (    forth6809.asm):12508                       STD  TSTSLSAV
                      (    forth6809.asm):12509                       LDD  TOIN
                      (    forth6809.asm):12510                       STD  TSTTISAV
                      (    forth6809.asm):12511         

DAF6 BDDA26           (    forth6809.asm):04934                     JSR   PATCH
DAF9 39               (    forth6809.asm):04935                     RTS
                      (    forth6809.asm):04936         
                      (    forth6809.asm):04937         ; ------------------------------------------------------------
                      (    forth6809.asm):04938         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):04939         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):04940         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):04941         ; ------------------------------------------------------------
DAFA CCD04D           (    forth6809.asm):04942         WHILEW:     LDD   #ZBRANCH
DAFD 3606             (    forth6809.asm):04943                     PSHU  D
DAFF BDDE2C           (    forth6809.asm):04944                     JSR   CCALL
DB02 CC0000           (    forth6809.asm):04945                     LDD   #0
DB05 3606             (    forth6809.asm):04946                     PSHU  D
DB07 BDD0EA           (    forth6809.asm):04947                     JSR   CODECOMMA
DB0A DC08             (    forth6809.asm):04948                     LDD   CODEHERE
DB0C 830002           (    forth6809.asm):04949                     SUBD  #2
DB0F 3606             (    forth6809.asm):04950                     PSHU  D                 ; orig
DB11 CC0001           (    forth6809.asm):04951                     LDD   #TAGFWD
DB14 3606             (    forth6809.asm):04952                     PSHU  D
DB16 39               (    forth6809.asm):04953                     RTS
                      (    forth6809.asm):04954         
                      (    forth6809.asm):04955         ; ------------------------------------------------------------
                      (    forth6809.asm):04956         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04957         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04958         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04959         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04960         ; ------------------------------------------------------------
DB17 3706             (    forth6809.asm):04961         REPEATW:    PULU  D
DB19 10830001         (    forth6809.asm):04962                     CMPD  #TAGFWD
DB1D 2703             (    forth6809.asm):04963                     BEQ   RPOK1
DB1F BDD9BC           (    forth6809.asm):04964                     JSR   CFERR
DB22 3710             (    forth6809.asm):04965         RPOK1:      PULU  X                 ; orig
DB24 3410             (    forth6809.asm):04966                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04967         
                      (    forth6809.asm):04968                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04969                     ; See bugfix: REPEATW.1
DB26 3040             (    forth6809.asm):04970                     LEAX  0,U               ; scan from top of control stack
DB28 9F16             (    forth6809.asm):04971                     STX   MSCR2             ; MSCR2 = base of scan region
DB2A 9F1A             (    forth6809.asm):04972                     STX   MSCR4             ; MSCR4 = scan pointer
DB2C DC1A             (    forth6809.asm):04973         RPSCAN:     LDD   MSCR4
DB2E 109321           (    forth6809.asm):04974                     CMPD  CSP
DB31 2603             (    forth6809.asm):04975                     BNE   RPSCANOK
DB33 BDD9BC           (    forth6809.asm):04976                     JSR   CFERR             ; no matching BEGIN
DB36 9E1A             (    forth6809.asm):04977         RPSCANOK:   LDX   MSCR4
DB38 EC84             (    forth6809.asm):04978                     LDD   ,X
DB3A 10830002         (    forth6809.asm):04979                     CMPD  #TAGBACK
DB3E 2712             (    forth6809.asm):04980                     BEQ   RPFOUND
DB40 10830001         (    forth6809.asm):04981                     CMPD  #TAGFWD
DB44 2703             (    forth6809.asm):04982                     BEQ   RPSKIP
DB46 BDD9BC           (    forth6809.asm):04983                     JSR   CFERR             ; anything else is a genuine mismatch
DB49 DC1A             (    forth6809.asm):04984         RPSKIP:     LDD   MSCR4
DB4B C30004           (    forth6809.asm):04985                     ADDD  #4
DB4E DD1A             (    forth6809.asm):04986                     STD   MSCR4
DB50 20DA             (    forth6809.asm):04987                     BRA   RPSCAN
DB52 9E1A             (    forth6809.asm):04988         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
DB54 EC02             (    forth6809.asm):04989                     LDD   2,X               ; dest = BEGIN's address
DB56 3406             (    forth6809.asm):04990                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04991         
                      (    forth6809.asm):04992                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04993                     ; bytes, highest word first.
DB58 DC1A             (    forth6809.asm):04994                     LDD   MSCR4
DB5A 9316             (    forth6809.asm):04995                     SUBD  MSCR2
DB5C DD18             (    forth6809.asm):04996                     STD   MSCR3             ; MSCR3 = bytes to shift
DB5E 2715             (    forth6809.asm):04997                     BEQ   RPSHIFTDONE
DB60 DC18             (    forth6809.asm):04998         RPSHIFT:    LDD   MSCR3
DB62 830002           (    forth6809.asm):04999                     SUBD  #2
DB65 DD18             (    forth6809.asm):05000                     STD   MSCR3
DB67 9E16             (    forth6809.asm):05001                     LDX   MSCR2
DB69 308B             (    forth6809.asm):05002                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DB6B EC84             (    forth6809.asm):05003                     LDD   ,X
DB6D 3004             (    forth6809.asm):05004                     LEAX  4,X
DB6F ED84             (    forth6809.asm):05005                     STD   ,X                ; copy one word 4 bytes higher
DB71 DC18             (    forth6809.asm):05006                     LDD   MSCR3
DB73 26EB             (    forth6809.asm):05007                     BNE   RPSHIFT
DB75                  (    forth6809.asm):05008         RPSHIFTDONE:
DB75 9E16             (    forth6809.asm):05009                     LDX   MSCR2
DB77 3004             (    forth6809.asm):05010                     LEAX  4,X
DB79 1F13             (    forth6809.asm):05011                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):05012         
DB7B CCD063           (    forth6809.asm):05013                     LDD   #BRANCH
DB7E 3606             (    forth6809.asm):05014                     PSHU  D
DB80 BDDE2C           (    forth6809.asm):05015                     JSR   CCALL
DB83 CC0000           (    forth6809.asm):05016                     LDD   #0
DB86 3606             (    forth6809.asm):05017                     PSHU  D
DB88 BDD0EA           (    forth6809.asm):05018                     JSR   CODECOMMA
DB8B EC60             (    forth6809.asm):05019                     LDD   0,S               ; target = BEGIN's address
DB8D 3606             (    forth6809.asm):05020                     PSHU  D
DB8F DC08             (    forth6809.asm):05021                     LDD   CODEHERE
DB91 830002           (    forth6809.asm):05022                     SUBD  #2                ; location = the operand just compiled
DB94 3606             (    forth6809.asm):05023                     PSHU  D
DB96 BDDA26           (    forth6809.asm):05024                     JSR   PATCH
DB99 DC08             (    forth6809.asm):05025                     LDD   CODEHERE
DB9B 3606             (    forth6809.asm):05026                     PSHU  D
DB9D EC62             (    forth6809.asm):05027                     LDD   2,S               ; orig
DB9F 3606             (    forth6809.asm):05028                     PSHU  D
DBA1 BDDA26           (    forth6809.asm):05029                     JSR   PATCH
DBA4 3264             (    forth6809.asm):05030                     LEAS  4,S               ; drop the frame
DBA6 39               (    forth6809.asm):05031                     RTS
                      (    forth6809.asm):05032         
                      (    forth6809.asm):05033         ; ------------------------------------------------------------
                      (    forth6809.asm):05034         ; RECURSE  ( -- )
                      (    forth6809.asm):05035         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):05036         ; the xt held in CURXT.
                      (    forth6809.asm):05037         ; ------------------------------------------------------------
DBA7 DC1F             (    forth6809.asm):05038         RECURSEW:   LDD   CURXT             ; xt of word being compiled
DBA9 3606             (    forth6809.asm):05039                     PSHU  D                 ; See bugfix: RECURSEW.1
DBAB BDDE2C           (    forth6809.asm):05040                     JSR   CCALL
DBAE 39               (    forth6809.asm):05041                     RTS
                      (    forth6809.asm):05042         

                      (    forth6809.asm):07161         
FFBD 1CAF             (    forth6809.asm):07162                  ANDCC #$AF      ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07163                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07164                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07165                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07166                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07167                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07168                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07169                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07170                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07171                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07172                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07173                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07174                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07175                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07176                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07177                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07178                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07179                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07180                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07181                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07182                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07183                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07184                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07185                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07186                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07187                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07188                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07189                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07190                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07191                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07192                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07193                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07194                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07195                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07196                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07197                                  ; unused vectors).
                      (    forth6809.asm):07198         
                      (    forth6809.asm):07199                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07200                  JSR   TSTRUNNER
                      (    forth6809.asm):07201                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07202                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07203                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07204                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07205                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07206                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07207                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07208                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07209                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07210                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07211                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07212                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07213                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07214                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07215                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07216                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07217                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07218         
FFC2 7EDF16           (    forth6809.asm):07219                  JMP   COLD
                      (    forth6809.asm):07220         
FFC5 1A50             (    forth6809.asm):07221         WARM:    ORCC  #$50
FFC7 4F               (    forth6809.asm):07222                  CLRA
FFC8 1F8B             (    forth6809.asm):07223                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07224                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07225                  LDS   #RP0
                      (    forth6809.asm):07226         
FFD1 BDDE6C           (    forth6809.asm):07227                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07228                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07229                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07230                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07231                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07232                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07233                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07234                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07235                                         ; reported separately) left either side
                      (    forth6809.asm):07236                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07237                                         ; would previously have inherited it
                      (    forth6809.asm):07238                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07239                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07240                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07241                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07242                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07243                                         ; only once setup is complete.
                      (    forth6809.asm):07244         

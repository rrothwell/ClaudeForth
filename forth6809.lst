                      (    forth6809.asm):01594         ; ------------------------------------------------------------
                      (    forth6809.asm):01595         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01596         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01597         ; enables it only while output is pending.
                      (    forth6809.asm):01598         ; UPDATE_RTS
                      (    forth6809.asm):01599         ;    Inputs:
                      (    forth6809.asm):01600         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01601         ;    Outputs:
                      (    forth6809.asm):01602         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01603         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01604         ; ------------------------------------------------------------
DD13                  (    forth6809.asm):01605         UPDATE_RTS:
DD13 7D0178           (    forth6809.asm):01606                     TST   RTSSTATE
DD16 260D             (    forth6809.asm):01607                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01608         
DD18 7D017B           (    forth6809.asm):01609                     TST   OUTACTIVITY       ; Is active?
DD1B 2704             (    forth6809.asm):01610                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01611         
                      (    forth6809.asm):01612                                             ; $B5/%1011_0101
DD1D 86B5             (    forth6809.asm):01613                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DD1F 2009             (    forth6809.asm):01614                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01615         
DD21                  (    forth6809.asm):01616         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DD21 8695             (    forth6809.asm):01617                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DD23 2005             (    forth6809.asm):01618                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01619         
DD25                  (    forth6809.asm):01620         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DD25 86D5             (    forth6809.asm):01621                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DD27 7F017B           (    forth6809.asm):01622                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DD2A                  (    forth6809.asm):01623         WRITE_CR:
DD2A B7C008           (    forth6809.asm):01624                     STA   ACIACR
DD2D 39               (    forth6809.asm):01625                     RTS
                      (    forth6809.asm):01626         ; ------------------------------------------------------------
                      (    forth6809.asm):01627         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01628         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01629         ; Called after a character is added to the ring.
                      (    forth6809.asm):01630         ; CHKHI
                      (    forth6809.asm):01631         ;    Inputs:
                      (    forth6809.asm):01632         ;        RegB = input ring fill level
                      (    forth6809.asm):01633         ;    Outputs:
                      (    forth6809.asm):01634         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01635         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01636         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01637         ; ------------------------------------------------------------
DD2E                  (    forth6809.asm):01638         CHKHI:
DD2E C130             (    forth6809.asm):01639                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DD30 250D             (    forth6809.asm):01640                     BLO   CHKHIDONE         ; No! Do nothing.
DD32 7D0178           (    forth6809.asm):01641                     TST   RTSSTATE
DD35 2608             (    forth6809.asm):01642                     BNE   CHKHIDONE         ; already high - nothing to do
DD37 86FF             (    forth6809.asm):01643                     LDA   #INREJECT         ; Yes! De-assert RTS.
DD39 B70178           (    forth6809.asm):01644                     STA   RTSSTATE
DD3C BDDD13           (    forth6809.asm):01645                     JSR   UPDATE_RTS
DD3F 39               (    forth6809.asm):01646         CHKHIDONE:  RTS
                      (    forth6809.asm):01647         
                      (    forth6809.asm):01648         ; ------------------------------------------------------------
                      (    forth6809.asm):01649         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01650         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01651         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01652         ; CHKLO
                      (    forth6809.asm):01653         ;    Inputs:
                      (    forth6809.asm):01654         ;        RegB = input ring fill level
                      (    forth6809.asm):01655         ;    Outputs:
                      (    forth6809.asm):01656         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01657         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01658         ; ------------------------------------------------------------
DD40                  (    forth6809.asm):01659         CHKLO:
DD40 C110             (    forth6809.asm):01660                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DD42 240D             (    forth6809.asm):01661                     BHS   CHKLODONE         ; No! Do nothing.
DD44 7D0178           (    forth6809.asm):01662                     TST   RTSSTATE
DD47 2708             (    forth6809.asm):01663                     BEQ   CHKLODONE         ; already low - nothing to do
DD49 8600             (    forth6809.asm):01664                     LDA   #INACCEPT         ; Yes! Assert RTS.
DD4B B70178           (    forth6809.asm):01665                     STA   RTSSTATE
DD4E BDDD13           (    forth6809.asm):01666                     JSR   UPDATE_RTS
DD51 39               (    forth6809.asm):01667         CHKLODONE:  RTS
                      (    forth6809.asm):01668         ; ------------------------------------------------------------
                      (    forth6809.asm):01669         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01670         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01671         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01672         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01673         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01674         ;    Inputs:
                      (    forth6809.asm):01675         ;        none
                      (    forth6809.asm):01676         ;    Outputs:
                      (    forth6809.asm):01677         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01678         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01679         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01680         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01681         FLUSHOUTBUFFER:
DD52 F6017A           (    forth6809.asm):01682                     LDB   OUTTAIL
DD55 F10179           (    forth6809.asm):01683                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DD58 2719             (    forth6809.asm):01684                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01685         
DD5A B6C008           (    forth6809.asm):01686                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01687                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01688                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01689         
DD61 8502             (    forth6809.asm):01690                     BITA  #SR_TDRE          ; Is transmit register empty?
DD63 270E             (    forth6809.asm):01691                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01692                                             ; than spin-wait here.
                      (    forth6809.asm):01693         
DD65 8E01C0           (    forth6809.asm):01694                     LDX   #OUTBUF           ; The out buffer is occupied.
DD68 A685             (    forth6809.asm):01695                     LDA   B,X               ; Get the character from the out buffer.
DD6A B7C009           (    forth6809.asm):01696                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01697         
DD6D 5C               (    forth6809.asm):01698                     INCB                    ; Update tail pointer to next character slot.
DD6E C43F             (    forth6809.asm):01699                     ANDB  #OUTBUFSZ-1
DD70 F7017A           (    forth6809.asm):01700                     STB   OUTTAIL
                      (    forth6809.asm):01701                                             ; One character sent - return rather than
                      (    forth6809.asm):01702                                             ; loop back for more (see header comment).
DD73                  (    forth6809.asm):01703         FLUSHED:
DD73 39               (    forth6809.asm):01704                     RTS
                      (    forth6809.asm):01705         ; ------------------------------------------------------------
                      (    forth6809.asm):01706         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01707         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01708         ; PUTCHAR
                      (    forth6809.asm):01709         ;    Inputs:
                      (    forth6809.asm):01710         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01711         ;    Outputs:
                      (    forth6809.asm):01712         ;        none
                      (    forth6809.asm):01713         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01714         ; ------------------------------------------------------------
DD74                  (    forth6809.asm):01715         PUTCHAR:
DD74 3411             (    forth6809.asm):01716                     PSHS  CC,X
DD76 1A50             (    forth6809.asm):01717                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01718         
DD78 F60179           (    forth6809.asm):01719                     LDB   OUTHEAD           ; Is buffer full?
DD7B 5C               (    forth6809.asm):01720                     INCB
DD7C C43F             (    forth6809.asm):01721                     ANDB  #OUTBUFSZ-1
DD7E F1017A           (    forth6809.asm):01722                     CMPB  OUTTAIL
DD81 273A             (    forth6809.asm):01723                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01724         
DD83 8E01C0           (    forth6809.asm):01725                     LDX   #OUTBUF           ; Put character into character slot.
DD86 F60179           (    forth6809.asm):01726                     LDB   OUTHEAD
DD89 A785             (    forth6809.asm):01727                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01728         
DD8B 5C               (    forth6809.asm):01729                     INCB                    ; Update tail pointer to next character slot.
DD8C C43F             (    forth6809.asm):01730                     ANDB  #OUTBUFSZ-1
DD8E F70179           (    forth6809.asm):01731                     STB   OUTHEAD
                      (    forth6809.asm):01732         
DD91 7D0178           (    forth6809.asm):01733                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
DD94 2709             (    forth6809.asm):01734                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):01735         

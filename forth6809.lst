D2AA C130             (    forth6809.asm):02135                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
D2AC 250D             (    forth6809.asm):02136                     BLO   CHKHIDONE         ; No! Do nothing.
D2AE 7D0178           (    forth6809.asm):02137                     TST   RTSSTATE
D2B1 2608             (    forth6809.asm):02138                     BNE   CHKHIDONE         ; already high - nothing to do
D2B3 86FF             (    forth6809.asm):02139                     LDA   #INREJECT         ; Yes! De-assert RTS.
D2B5 B70178           (    forth6809.asm):02140                     STA   RTSSTATE

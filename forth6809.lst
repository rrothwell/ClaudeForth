                      (    forth6809.asm):05502         ;    Outputs:
                      (    forth6809.asm):05503         ;        PRODLO = quotient, DIVREM = remainder (data stack popped)
                      (    forth6809.asm):05504         ;    Registers: RegA, RegB and RegD changed; many scratch cells used.
                      (    forth6809.asm):05505         ; ------------------------------------------------------------

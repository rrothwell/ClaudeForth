                      (    forth6809.asm):11091         
                      (    forth6809.asm):11092         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):11093         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):11094         ; .bin file.
FFED FFFFFF           (    forth6809.asm):11095                     FILL  $FF,VECTORS-INITEND

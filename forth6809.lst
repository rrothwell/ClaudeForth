                      (    forth6809.asm):03040         
E206 108C0000         (    forth6809.asm):03041         SKIPLP:     CMPY  #0
E20A 274D             (    forth6809.asm):03042                     BEQ   EMPTY
E20C A684             (    forth6809.asm):03043                     LDA   ,X
E20E A1E4             (    forth6809.asm):03044                     CMPA  ,S
E210 2606             (    forth6809.asm):03045                     BNE   STARTW
E212 3001             (    forth6809.asm):03046                     LEAX  1,X
E214 313F             (    forth6809.asm):03047                     LEAY  -1,Y
E216 20EE             (    forth6809.asm):03048                     BRA   SKIPLP
                      (    forth6809.asm):03049         
E218 AF61             (    forth6809.asm):03050         STARTW:     STX   1,S
E21A C600             (    forth6809.asm):03051                     LDB   #0
                      (    forth6809.asm):03052         
E21C 108C0000         (    forth6809.asm):03053         SCANLP:     CMPY  #0
E220 2715             (    forth6809.asm):03054                     BEQ   ENDW
E222 A684             (    forth6809.asm):03055                     LDA   ,X
E224 A1E4             (    forth6809.asm):03056                     CMPA  ,S
E226 270B             (    forth6809.asm):03057                     BEQ   CONSUME
E228 C15A             (    forth6809.asm):03058                     CMPB  #WORDMAXCHARS     ; Length limit. See shadow: WORDW.2
E22A 270B             (    forth6809.asm):03059                     BEQ   ENDW
E22C 3001             (    forth6809.asm):03060                     LEAX  1,X
E22E 313F             (    forth6809.asm):03061                     LEAY  -1,Y
E230 5C               (    forth6809.asm):03062                     INCB
E231 20E9             (    forth6809.asm):03063                     BRA   SCANLP
                      (    forth6809.asm):03064         
E233 3001             (    forth6809.asm):03065         CONSUME:    LEAX  1,X
E235 313F             (    forth6809.asm):03066                     LEAY  -1,Y
E237 3404             (    forth6809.asm):03067         ENDW:       PSHS  B                 ; Save the count. See bugfix: WORDW.3
E239 1F10             (    forth6809.asm):03068                     TFR   X,D
E23B 9339             (    forth6809.asm):03069                     SUBD  SRCADDR
E23D DD10             (    forth6809.asm):03070                     STD   TOIN
E23F 3504             (    forth6809.asm):03071                     PULS  B
                      (    forth6809.asm):03072         
E241 9E08             (    forth6809.asm):03073                     LDX   CODEHERE          ; Result buffer; CODEHERE is not advanced.
                      (    forth6809.asm):03074                                             ; See shadow: WORDW.4
E243 E780             (    forth6809.asm):03075                     STB   ,X+
E245 10AE61           (    forth6809.asm):03076                     LDY   1,S
E248 5D               (    forth6809.asm):03077         COPYLP:     TSTB
E249 2707             (    forth6809.asm):03078                     BEQ   COPYDONE
E24B A6A0             (    forth6809.asm):03079                     LDA   ,Y+
E24D A780             (    forth6809.asm):03080                     STA   ,X+
E24F 5A               (    forth6809.asm):03081                     DECB
E250 20F6             (    forth6809.asm):03082                     BRA   COPYLP
E252 3263             (    forth6809.asm):03083         COPYDONE:   LEAS  3,S               ; drop the frame
E254 9E08             (    forth6809.asm):03084                     LDX   CODEHERE          ; Result address (see WORDW.4)
E256 3610             (    forth6809.asm):03085                     PSHU  X                 ; c-addr
E258 39               (    forth6809.asm):03086                     RTS
                      (    forth6809.asm):03087         

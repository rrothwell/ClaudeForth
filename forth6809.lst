                      (    forth6809.asm):07164         ; TSTLEAVE - unit test for LEAVE. Compiles
                      (    forth6809.asm):07165         ; "DO I DUP 3 LITERAL = IF LEAVE THEN + LOOP", limit=10,
                      (    forth6809.asm):07166         ; start=0 - would normally visit I=0..9, but LEAVE forces exit
                      (    forth6809.asm):07167         ; once I=3 is reached. LEAVE only sets a flag; the actual exit
                      (    forth6809.asm):07168         ; happens at the NEXT LOOP check (per its own documented
                      (    forth6809.asm):07169         ; behavior, "exit at its next LOOP") - confirmed by hand-trace
                      (    forth6809.asm):07170         ; of DOTEST's own logic (checks the flag first, before its
                      (    forth6809.asm):07171         ; normal increment/compare). Since + runs before LOOP's check,
                      (    forth6809.asm):07172         ; I=3 IS accumulated before the loop exits - sum=0+1+2+3=6, not
                      (    forth6809.asm):07173         ; 0+1+2=3 (which would indicate LEAVE incorrectly took effect
                      (    forth6809.asm):07174         ; immediately) and not the full 0..9 (which would indicate
                      (    forth6809.asm):07175         ; LEAVE didn't work at all).
                      (    forth6809.asm):07176         ; ------------------------------------------------------------

                      (    forth6809.asm):06585         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (    forth6809.asm):06586         ; clause. Compiles
                      (    forth6809.asm):06587         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (    forth6809.asm):06588         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (    forth6809.asm):06589         ; with selector=2, matching the second clause. Traced by hand:
                      (    forth6809.asm):06590         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (    forth6809.asm):06591         ; runs on a match, consuming the selector; ENDOF compiles an
                      (    forth6809.asm):06592         ; unconditional branch past the remaining clauses AND patches
                      (    forth6809.asm):06593         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (    forth6809.asm):06594         ; patches every pending ENDOF branch to the true end and
                      (    forth6809.asm):06595         ; compiles a final fallback DROP for the no-match case.
                      (    forth6809.asm):06596         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):06597         TSTCASE1: LDD  CODEHERE
                      (    forth6809.asm):06598                   STD  TSTCSAV
                      (    forth6809.asm):06599                   LDD  #TSTCBUF
                      (    forth6809.asm):06600                   STD  CODEHERE
                      (    forth6809.asm):06601         
                      (    forth6809.asm):06602                   JSR  CASEW
                      (    forth6809.asm):06603         
                      (    forth6809.asm):06604                   LDD  #1
                      (    forth6809.asm):06605                   PSHU D
                      (    forth6809.asm):06606                   JSR  LITERALW
                      (    forth6809.asm):06607                   JSR  OF
                      (    forth6809.asm):06608                   LDD  #111
                      (    forth6809.asm):06609                   PSHU D
                      (    forth6809.asm):06610                   JSR  LITERALW
                      (    forth6809.asm):06611                   JSR  ENDOF
                      (    forth6809.asm):06612         
                      (    forth6809.asm):06613                   LDD  #2
                      (    forth6809.asm):06614                   PSHU D
                      (    forth6809.asm):06615                   JSR  LITERALW
                      (    forth6809.asm):06616                   JSR  OF
                      (    forth6809.asm):06617                   LDD  #222
                      (    forth6809.asm):06618                   PSHU D
                      (    forth6809.asm):06619                   JSR  LITERALW
                      (    forth6809.asm):06620                   JSR  ENDOF
                      (    forth6809.asm):06621         
                      (    forth6809.asm):06622                   JSR  ENDCASE
                      (    forth6809.asm):06623         
                      (    forth6809.asm):06624                   LDD  #OPRTS
                      (    forth6809.asm):06625                   PSHU D
                      (    forth6809.asm):06626                   JSR  CCOMMA
                      (    forth6809.asm):06627         
                      (    forth6809.asm):06628                   LDD  TSTCSAV
                      (    forth6809.asm):06629                   STD  CODEHERE
                      (    forth6809.asm):06630         
                      (    forth6809.asm):06631                   STU  TSTU0
                      (    forth6809.asm):06632         
                      (    forth6809.asm):06633                   LDD  #TSTGUARD
                      (    forth6809.asm):06634                   PSHU D
                      (    forth6809.asm):06635                   LDD  #2
                      (    forth6809.asm):06636                   PSHU D
                      (    forth6809.asm):06637                   STU  TSTUB4
                      (    forth6809.asm):06638         
                      (    forth6809.asm):06639                   JSR  TSTCBUF
                      (    forth6809.asm):06640         
                      (    forth6809.asm):06641                   STU  TSTUAF
                      (    forth6809.asm):06642         
                      (    forth6809.asm):06643                   PULU D
                      (    forth6809.asm):06644                   CMPD #222
                      (    forth6809.asm):06645                   BNE  C1FAIL
                      (    forth6809.asm):06646                   PULU D
                      (    forth6809.asm):06647                   CMPD #TSTGUARD
                      (    forth6809.asm):06648                   BNE  C1FAIL
                      (    forth6809.asm):06649         
                      (    forth6809.asm):06650                   LDD  TSTUB4
                      (    forth6809.asm):06651                   SUBD TSTUAF
                      (    forth6809.asm):06652                   CMPD #0
                      (    forth6809.asm):06653                   BNE  C1FAIL
                      (    forth6809.asm):06654         
                      (    forth6809.asm):06655                   LDD  #TRUEV
                      (    forth6809.asm):06656                   BRA  C1DONE
C1F2                  (    forth6809.asm):06657         C1FAIL:   LDD  #FALSEV
C1F2                  (    forth6809.asm):06658         C1DONE:   LDX  #TSTCASE1NAME
                      (    forth6809.asm):06659                   PSHU X
                      (    forth6809.asm):06660                   PSHU D
                      (    forth6809.asm):06661                   JSR  TSTREPORT
                      (    forth6809.asm):06662         
                      (    forth6809.asm):06663                   LDU  TSTU0
                      (    forth6809.asm):06664                   RTS
                      (    forth6809.asm):06665         
C1F2                  (    forth6809.asm):06666         TSTCASE1NAME: FCB  9
                      (    forth6809.asm):06667                       FCC  "TSTCASE1"
                      (    forth6809.asm):06668         
                      (    forth6809.asm):06669         ; ------------------------------------------------------------
                      (    forth6809.asm):06670         ; TSTCASE2 - unit test for CASE/OF/ENDOF/ENDCASE, no-match
                      (    forth6809.asm):06671         ; case. Same compiled snippet as TSTCASE1, run with a selector
                      (    forth6809.asm):06672         ; (99) matching neither clause - should fall through both OF
                      (    forth6809.asm):06673         ; checks (selector preserved across each non-match, per the
                      (    forth6809.asm):06674         ; documented "( x n -- | x )" effect) and reach ENDCASE's own
                      (    forth6809.asm):06675         ; fallback DROP, consuming the selector with nothing pushed in
                      (    forth6809.asm):06676         ; its place.
                      (    forth6809.asm):06677         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):06678         TSTCASE2: LDD  CODEHERE
                      (    forth6809.asm):06679                   STD  TSTCSAV
                      (    forth6809.asm):06680                   LDD  #TSTCBUF
                      (    forth6809.asm):06681                   STD  CODEHERE
                      (    forth6809.asm):06682         
                      (    forth6809.asm):06683                   JSR  CASEW
                      (    forth6809.asm):06684         
                      (    forth6809.asm):06685                   LDD  #1
                      (    forth6809.asm):06686                   PSHU D
                      (    forth6809.asm):06687                   JSR  LITERALW
                      (    forth6809.asm):06688                   JSR  OF
                      (    forth6809.asm):06689                   LDD  #111
                      (    forth6809.asm):06690                   PSHU D
                      (    forth6809.asm):06691                   JSR  LITERALW
                      (    forth6809.asm):06692                   JSR  ENDOF
                      (    forth6809.asm):06693         
                      (    forth6809.asm):06694                   LDD  #2
                      (    forth6809.asm):06695                   PSHU D
                      (    forth6809.asm):06696                   JSR  LITERALW
                      (    forth6809.asm):06697                   JSR  OF
                      (    forth6809.asm):06698                   LDD  #222
                      (    forth6809.asm):06699                   PSHU D
                      (    forth6809.asm):06700                   JSR  LITERALW
                      (    forth6809.asm):06701                   JSR  ENDOF
                      (    forth6809.asm):06702         
                      (    forth6809.asm):06703                   JSR  ENDCASE
                      (    forth6809.asm):06704         
                      (    forth6809.asm):06705                   LDD  #OPRTS
                      (    forth6809.asm):06706                   PSHU D
                      (    forth6809.asm):06707                   JSR  CCOMMA
                      (    forth6809.asm):06708         
                      (    forth6809.asm):06709                   LDD  TSTCSAV
                      (    forth6809.asm):06710                   STD  CODEHERE
                      (    forth6809.asm):06711         
                      (    forth6809.asm):06712                   STU  TSTU0
                      (    forth6809.asm):06713         
                      (    forth6809.asm):06714                   LDD  #TSTGUARD
                      (    forth6809.asm):06715                   PSHU D
                      (    forth6809.asm):06716                   LDD  #99
                      (    forth6809.asm):06717                   PSHU D
                      (    forth6809.asm):06718                   STU  TSTUB4
                      (    forth6809.asm):06719         
                      (    forth6809.asm):06720                   JSR  TSTCBUF
                      (    forth6809.asm):06721         
                      (    forth6809.asm):06722                   STU  TSTUAF
                      (    forth6809.asm):06723         
                      (    forth6809.asm):06724                   PULU D
                      (    forth6809.asm):06725                   CMPD #TSTGUARD
                      (    forth6809.asm):06726                   BNE  C2FAIL
                      (    forth6809.asm):06727         
                      (    forth6809.asm):06728                   LDD  TSTUB4
                      (    forth6809.asm):06729                   SUBD TSTUAF
                      (    forth6809.asm):06730                   CMPD #-2
                      (    forth6809.asm):06731                   BNE  C2FAIL
                      (    forth6809.asm):06732         
                      (    forth6809.asm):06733                   LDD  #TRUEV
                      (    forth6809.asm):06734                   BRA  C2DONE
C1F2                  (    forth6809.asm):06735         C2FAIL:   LDD  #FALSEV
C1F2                  (    forth6809.asm):06736         C2DONE:   LDX  #TSTCASE2NAME
                      (    forth6809.asm):06737                   PSHU X
                      (    forth6809.asm):06738                   PSHU D
                      (    forth6809.asm):06739                   JSR  TSTREPORT
                      (    forth6809.asm):06740         
                      (    forth6809.asm):06741                   LDU  TSTU0
                      (    forth6809.asm):06742                   RTS
                      (    forth6809.asm):06743         
C1F2                  (    forth6809.asm):06744         TSTCASE2NAME: FCB  9
                      (    forth6809.asm):06745                       FCC  "TSTCASE2"
                      (    forth6809.asm):06746         
                      (    forth6809.asm):06747         ; ------------------------------------------------------------
                      (    forth6809.asm):06748         ; TSTTHENZ - unit test for THEN, tag-mismatch case. Pushes a
                      (    forth6809.asm):06749         ; wrong value (0, matching none of TAGFWD/TAGBACK/TAGDO/TAGOF)
                      (    forth6809.asm):06750         ; in place of the expected TAGFWD, then calls THEN via CATCH.
                      (    forth6809.asm):06751         ; CFERR (confirmed by reading it directly) throws -22
                      (    forth6809.asm):06752         ; immediately without ever touching CODEHERE - the error path
                      (    forth6809.asm):06753         ; never reaches any compiling code - so this needs no CODEHERE
                      (    forth6809.asm):06754         ; redirect, unlike every other test in this section. Same
                      (    forth6809.asm):06755         ; CATCH-based pattern as the divide-by-zero tests in earlier
                      (    forth6809.asm):06756         ; sections: verify the thrown code and CATCH's own depth-
                      (    forth6809.asm):06757         ; restoration contract, not the unspecified i*x values.
                      (    forth6809.asm):06758         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):06759         TSTTHENZ: STU  TSTU0
                      (    forth6809.asm):06760         
                      (    forth6809.asm):06761                   LDD  #0
                      (    forth6809.asm):06762                   PSHU D
                      (    forth6809.asm):06763                   LDD  #0
                      (    forth6809.asm):06764                   PSHU D
                      (    forth6809.asm):06765                   LDX  #THEN
                      (    forth6809.asm):06766                   PSHU X
                      (    forth6809.asm):06767                   STU  TSTUB4
                      (    forth6809.asm):06768         
                      (    forth6809.asm):06769                   JSR  CATCH
                      (    forth6809.asm):06770         
                      (    forth6809.asm):06771                   STU  TSTUAF
                      (    forth6809.asm):06772         
                      (    forth6809.asm):06773                   PULU D
                      (    forth6809.asm):06774                   CMPD #-22
                      (    forth6809.asm):06775                   BNE  T3FAIL
                      (    forth6809.asm):06776         
                      (    forth6809.asm):06777                   LDD  TSTUB4
                      (    forth6809.asm):06778                   SUBD TSTUAF
                      (    forth6809.asm):06779                   CMPD #0
                      (    forth6809.asm):06780                   BNE  T3FAIL
                      (    forth6809.asm):06781         
                      (    forth6809.asm):06782                   LDD  #TRUEV
                      (    forth6809.asm):06783                   BRA  T3DONE
C1F2                  (    forth6809.asm):06784         T3FAIL:   LDD  #FALSEV
C1F2                  (    forth6809.asm):06785         T3DONE:   LDX  #TSTTHENZNAME
                      (    forth6809.asm):06786                   PSHU X
                      (    forth6809.asm):06787                   PSHU D
                      (    forth6809.asm):06788                   JSR  TSTREPORT
                      (    forth6809.asm):06789         
                      (    forth6809.asm):06790                   LDU  TSTU0
                      (    forth6809.asm):06791                   RTS
                      (    forth6809.asm):06792         
C1F2                  (    forth6809.asm):06793         TSTTHENZNAME: FCB  8
                      (    forth6809.asm):06794                       FCC  "TSTTHENZ"
                      (    forth6809.asm):06795         
                      (    forth6809.asm):06796         ; ------------------------------------------------------------
                      (    forth6809.asm):06797         ; TSTUNTILZ - unit test for UNTIL, tag-mismatch case. Same
                      (    forth6809.asm):06798         ; pattern as TSTTHENZ - wrong value in place of TAGBACK.
                      (    forth6809.asm):06799         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):06800         TSTUNTILZ: STU  TSTU0
                      (    forth6809.asm):06801         
                      (    forth6809.asm):06802                    LDD  #0
                      (    forth6809.asm):06803                    PSHU D
                      (    forth6809.asm):06804                    LDD  #0
                      (    forth6809.asm):06805                    PSHU D
                      (    forth6809.asm):06806                    LDX  #UNTIL
                      (    forth6809.asm):06807                    PSHU X
                      (    forth6809.asm):06808                    STU  TSTUB4
                      (    forth6809.asm):06809         
                      (    forth6809.asm):06810                    JSR  CATCH
                      (    forth6809.asm):06811         
                      (    forth6809.asm):06812                    STU  TSTUAF
                      (    forth6809.asm):06813         
                      (    forth6809.asm):06814                    PULU D
                      (    forth6809.asm):06815                    CMPD #-22
                      (    forth6809.asm):06816                    BNE  U3FAIL
                      (    forth6809.asm):06817         
                      (    forth6809.asm):06818                    LDD  TSTUB4
                      (    forth6809.asm):06819                    SUBD TSTUAF
                      (    forth6809.asm):06820                    CMPD #0
                      (    forth6809.asm):06821                    BNE  U3FAIL
                      (    forth6809.asm):06822         
                      (    forth6809.asm):06823                    LDD  #TRUEV
                      (    forth6809.asm):06824                    BRA  U3DONE
C1F2                  (    forth6809.asm):06825         U3FAIL:    LDD  #FALSEV
C1F2                  (    forth6809.asm):06826         U3DONE:    LDX  #TSTUNTLZNAME
                      (    forth6809.asm):06827                    PSHU X
                      (    forth6809.asm):06828                    PSHU D
                      (    forth6809.asm):06829                    JSR  TSTREPORT
                      (    forth6809.asm):06830         
                      (    forth6809.asm):06831                    LDU  TSTU0
                      (    forth6809.asm):06832                    RTS

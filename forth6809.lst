                      (    forth6809.asm):02536         
CFDB CC000A           (    forth6809.asm):02537                     LDD   #10
CFDE DD02             (    forth6809.asm):02538                     STD   BASE
                      (    forth6809.asm):02539         
CFE0 CC0106           (    forth6809.asm):02540                     LDD   #TIBBUF
CFE3 DD39             (    forth6809.asm):02541                     STD   SRCADDR
CFE5 CC0000           (    forth6809.asm):02542                     LDD   #0
CFE8 DD3B             (    forth6809.asm):02543                     STD   SRCLEN
CFEA DD3D             (    forth6809.asm):02544                     STD   SRCID
                      (    forth6809.asm):02545         
CFEC 8ED099           (    forth6809.asm):02546                     LDX   #SIGNON
CFEF 3610             (    forth6809.asm):02547                     PSHU  X                 ; c-addr
CFF1 CC000F           (    forth6809.asm):02548                     LDD   #SIGNONL
CFF4 3606             (    forth6809.asm):02549                     PSHU  D                 ; u

                      (    forth6809.asm):12435         ; to verify PARSE's own documented distinguishing behavior -
                      (    forth6809.asm):12436         ; "does not skip leading delimiters, unlike WORD" - the leading
                      (    forth6809.asm):12437         ; comma should be hit immediately, returning a zero-length token
                      (    forth6809.asm):12438         ; right where TOIN started, not skipped over to find "XY".
                      (    forth6809.asm):12439         ; ------------------------------------------------------------

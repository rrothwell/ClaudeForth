F87B 2715             (    forth6809.asm):14726                    BEQ  UEDONE
F87D A680             (    forth6809.asm):14727                    LDA  ,X+
F87F 8125             (    forth6809.asm):14728                    CMPA #'%'
F881 2604             (    forth6809.asm):14729                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):14730                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):14731                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):14732                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):14733                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):14734                                   ; the same string correctly, since this runs
                      (    forth6809.asm):14735                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):14736         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):14737                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):14738                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):14739                    SUBD #1
F88E DDA9             (    forth6809.asm):14740                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):14741                    BRA  UELOOP
F892 1F20             (    forth6809.asm):14742         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):14743                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):14744                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):14745                                   ; required return values, and separately,
                      (    forth6809.asm):14746                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):14747                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):14748                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):14749                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):14750                                   ; characters. Now computed directly as the
                      (    forth6809.asm):14751                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):14752                                   ; original destination address (UEDST) -
                      (    forth6809.asm):14753                                   ; correct regardless of how many characters
                      (    forth6809.asm):14754                                   ; were doubled, since it's derived from
                      (    forth6809.asm):14755                                   ; where writing actually stopped rather than
                      (    forth6809.asm):14756                                   ; incremented alongside it.

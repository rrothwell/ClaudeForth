                      (    forth6809.asm):06797         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):06798         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):06799         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):06800         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):06801         ; (off-by-one, wrong direction, wrong starting value) would

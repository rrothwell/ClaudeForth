E88A 10A344           (    forth6809.asm):07489                     CMPD  4,U               ; addr1
E88D 22E1             (    forth6809.asm):07490                     BHI   CMOVEGTW          ; addr2 above addr1: copy from the top
E88F 7EE856           (    forth6809.asm):07491                     JMP   CMOVEW

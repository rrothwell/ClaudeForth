                      (    forth6809.asm):09927                       PSHU D
                      (    forth6809.asm):09928                       JSR  COMPILECOMMA
                      (    forth6809.asm):09929         
                      (    forth6809.asm):09930                       LDD  #OPRTS
                      (    forth6809.asm):09931                       PSHU D
                      (    forth6809.asm):09932                       JSR  CCOMMA
                      (    forth6809.asm):09933         
                      (    forth6809.asm):09934                       LDD  TSTCSAV
                      (    forth6809.asm):09935                       STD  CODEHERE
                      (    forth6809.asm):09936         
                      (    forth6809.asm):09937                       STU  TSTU0
                      (    forth6809.asm):09938         
                      (    forth6809.asm):09939                       LDD  #TSTGUARD
                      (    forth6809.asm):09940                       PSHU D
                      (    forth6809.asm):09941                       LDD  #TSTVAL1
                      (    forth6809.asm):09942                       PSHU D
                      (    forth6809.asm):09943                       STU  TSTUB4
                      (    forth6809.asm):09944         
                      (    forth6809.asm):09945                       LDX  #TSTCBUF
                      (    forth6809.asm):09946                       JSR  ,X
                      (    forth6809.asm):09947         
                      (    forth6809.asm):09948                       STU  TSTUAF
                      (    forth6809.asm):09949         
                      (    forth6809.asm):09950                       PULU D
                      (    forth6809.asm):09951                       CMPD #TSTVAL1
                      (    forth6809.asm):09952                       BNE  CCFAIL
                      (    forth6809.asm):09953                       PULU D
                      (    forth6809.asm):09954                       CMPD #TSTVAL1
                      (    forth6809.asm):09955                       BNE  CCFAIL

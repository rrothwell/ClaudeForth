                      (    forth6809.asm):05566         ; BUG FIX (found from a hardware report on UM/MOD's own ANS Annex F
                      (    forth6809.asm):05567         ; boundary test, F.6.1.2370: "MAX-UINT MAX-UINT UM* MAX-UINT UM/MOD
                      (    forth6809.asm):05568         ; -> 0 MAX-UINT" - got 0 65535 for (remainder, quotient) wrong-way-
                      (    forth6809.asm):05569         ; round, actually got (1, 0) - and traced back here, since SM/REM,
                      (    forth6809.asm):05570         ; UM/MOD, FM/MOD, and plain /, MOD, /MOD (via DIVCOMMON) all share
                      (    forth6809.asm):05571         ; this one routine). This is the classic off-by-one-bit boundary bug
                      (    forth6809.asm):05572         ; in a 32-bit-dividend/16-bit-divisor restoring-division shift loop:
                      (    forth6809.asm):05573         ; DIVREM is only a 16-bit register, but the value it needs to compare
                      (    forth6809.asm):05574         ; against DIVDEN (the divisor) each iteration, just after the whole
                      (    forth6809.asm):05575         ; DIVREM:PRODHI:PRODLO chain shifts left by one bit, can transiently
                      (    forth6809.asm):05576         ; need a 17th bit - the true "remainder so far, doubled, plus the new
                      (    forth6809.asm):05577         ; incoming dividend bit" can reach up to 2*(DIVDEN-1)+1, which for a
                      (    forth6809.asm):05578         ; divisor near MAX-UINT (as in the failing test, DIVDEN=$FFFF) can
                      (    forth6809.asm):05579         ; exceed $FFFF and overflow the 16-bit DIVREM register. The old code
                      (    forth6809.asm):05580         ; (ROL DIVREM as the last link in the shift chain, then straight into
                      (    forth6809.asm):05581         ; LDD DIVREM/SUBD DIVDEN/BLO) simply discarded that overflow bit - it
                      (    forth6809.asm):05582         ; falls out of ROL DIVREM's own carry flag and was never tested -  so
                      (    forth6809.asm):05583         ; whenever it was set, DIVREM's 16 bits alone read as SMALLER than
                      (    forth6809.asm):05584         ; DIVDEN even though the true (17-bit) value was actually larger,
                      (    forth6809.asm):05585         ; wrongly skipping a subtraction (and its quotient bit) that should
                      (    forth6809.asm):05586         ; have happened. Confirmed by simulating this exact instruction
                      (    forth6809.asm):05587         ; sequence in Python against a known-correct reference division and a
                      (    forth6809.asm):05588         ; 200,000-case random fuzz run: the original code was the only one
                      (    forth6809.asm):05589         ; that failed, and only on inputs that hit this exact overflow
                      (    forth6809.asm):05590         ; condition (the MAX-UINT/MAX-UINT case being the smallest/simplest
                      (    forth6809.asm):05591         ; one in this test corpus, not a coincidence - DIVDEN=$FFFF is the
                      (    forth6809.asm):05592         ; case where the overflow condition is easiest to trigger). Fixed by
                      (    forth6809.asm):05593         ; testing the carry out of ROL DIVREM (the chain's final link, so
                      (    forth6809.asm):05594         ; this carry IS that discarded 17th bit) before ever touching DIVREM
                      (    forth6809.asm):05595         ; via LDD: if set, the true 17-bit value is DIVREM+$10000, which is
                      (    forth6809.asm):05596         ; always >= any 16-bit DIVDEN, so the subtraction is known to succeed
                      (    forth6809.asm):05597         ; without needing the CMPD/BLO test at all - and the plain 16-bit
                      (    forth6809.asm):05598         ; "DIVREM - DIVDEN" (letting it wrap how it wraps) IS the correct new
                      (    forth6809.asm):05599         ; remainder, since adding $10000 then subtracting DIVDEN and dropping
                      (    forth6809.asm):05600         ; the now-impossible 17th bit again is exactly equivalent mod $10000.
                      (    forth6809.asm):05601         ; LDD does not itself affect the carry flag on the 6809 (only N/Z,
                      (    forth6809.asm):05602         ; clears V), but BCS is placed immediately after ROL DIVREM anyway,
                      (    forth6809.asm):05603         ; before anything else, so this isn't relied upon.
EE9E 0F66             (    forth6809.asm):05604         UDIV32:  CLR   DIVREM
EEA0 0F67             (    forth6809.asm):05605                  CLR   DIVREM+1
EEA2 C620             (    forth6809.asm):05606                  LDB   #32
EEA4 D768             (    forth6809.asm):05607                  STB   DIVCNT
EEA6 0860             (    forth6809.asm):05608         UD32LP:  ASL   PRODLO+1
EEA8 095F             (    forth6809.asm):05609                  ROL   PRODLO
EEAA 095E             (    forth6809.asm):05610                  ROL   PRODHI+1
EEAC 095D             (    forth6809.asm):05611                  ROL   PRODHI
EEAE 0967             (    forth6809.asm):05612                  ROL   DIVREM+1

F8A3 3706             (    forth6809.asm):05948         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F8A5 DDAB             (    forth6809.asm):05949                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):05950                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):05951                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):05952                                   ; real source length was misread as an
                      (    forth6809.asm):05953                                   ; address, the real source address was never
                      (    forth6809.asm):05954                                   ; popped at all, and the true destination
                      (    forth6809.asm):05955                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):05956                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):05957                                   ; c-addr2 (dest) is on top, popped first.
F8A7 3706             (    forth6809.asm):05958                    PULU D         ; next: u1 (source length)
F8A9 DDA9             (    forth6809.asm):05959                    STD  UESRCLEN
F8AB 3706             (    forth6809.asm):05960                    PULU D         ; next: c-addr1 (source address)
F8AD DDA7             (    forth6809.asm):05961                    STD  UEADDR
F8AF CC0000           (    forth6809.asm):05962                    LDD  #0
F8B2 DDAD             (    forth6809.asm):05963                    STD  UEOUTLEN
F8B4 9EA7             (    forth6809.asm):05964                    LDX  UEADDR
F8B6 109EAB           (    forth6809.asm):05965                    LDY  UEDST
                      (    forth6809.asm):05966         
                      (    forth6809.asm):05967                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):05968                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):05969                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):05970                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):05971                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):05972                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):05973                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):05974                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):05975                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):05976                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):05977                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):05978                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):05979                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):05980                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):05981                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):05982                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):05983                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):05984                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):05985                    ; wrong algorithm entirely, not a smaller bug within it.
F8B9 DCA9             (    forth6809.asm):05986         UELOOP:    LDD  UESRCLEN
F8BB 2715             (    forth6809.asm):05987                    BEQ  UEDONE
F8BD A680             (    forth6809.asm):05988                    LDA  ,X+
F8BF 8125             (    forth6809.asm):05989                    CMPA #'%'
F8C1 2604             (    forth6809.asm):05990                    BNE  UENOTPCT
F8C3 C625             (    forth6809.asm):05991                    LDB  #'%'      ; write the extra '%' first - the character
F8C5 E7A0             (    forth6809.asm):05992                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):05993                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):05994                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):05995                                   ; the same string correctly, since this runs
                      (    forth6809.asm):05996                                   ; independently for each one the loop visits.
F8C7 A7A0             (    forth6809.asm):05997         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):05998                                   ; every character, '%' or not
F8C9 DCA9             (    forth6809.asm):05999                    LDD  UESRCLEN
F8CB 830001           (    forth6809.asm):06000                    SUBD #1
F8CE DDA9             (    forth6809.asm):06001                    STD  UESRCLEN
F8D0 20E7             (    forth6809.asm):06002                    BRA  UELOOP
F8D2 1F20             (    forth6809.asm):06003         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F8D4 93AB             (    forth6809.asm):06004                    SUBD UEDST     ; overwriting whatever was left on top of
F8D6 DDAD             (    forth6809.asm):06005                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06006                                   ; required return values, and separately,
                      (    forth6809.asm):06007                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06008                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06009                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06010                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06011                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06012                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06013                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06014                                   ; correct regardless of how many characters
                      (    forth6809.asm):06015                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06016                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06017                                   ; incremented alongside it.
F8D8 DCAB             (    forth6809.asm):06018                    LDD  UEDST
F8DA 3606             (    forth6809.asm):06019                    PSHU D         ; push c-addr2 (destination address)
F8DC DCAD             (    forth6809.asm):06020                    LDD  UEOUTLEN
F8DE 3606             (    forth6809.asm):06021                    PSHU D         ; push u2 (actual unescaped length)
F8E0 39               (    forth6809.asm):06022                    RTS
                      (    forth6809.asm):06023         
                      (    forth6809.asm):06024         ; REPLACES/SUBSTITUTE - single-slot simplified version, per
                      (    forth6809.asm):06025         ; the explicit scoping-down discussed in the source conversation
F8E1 3706             (    forth6809.asm):06026         REPLACESW: PULU D
F8E3 DDB5             (    forth6809.asm):06027                    STD  REPLNLEN

E30D BDDFFC           (    forth6809.asm):02991                     JSR   CODECOMMA
E310 20B5             (    forth6809.asm):02992                     BRA   ILOOP
                      (    forth6809.asm):02993         
E312                  (    forth6809.asm):02994         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):02995                                             ; ANS's (ud1) stack order directly.
E312 DC00             (    forth6809.asm):02996                     LDD   STATE
E314 27B1             (    forth6809.asm):02997                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):02998                                             ; nothing more to do
                      (    forth6809.asm):02999                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03000                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03001                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03002                     ; pop it aside first, freeing UDLO to be compiled first.
E316 3706             (    forth6809.asm):03003                     PULU  D
E318 DD2F             (    forth6809.asm):03004                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03005                                             ; untouched by CCALL/CODECOMMA
E31A CCDF60           (    forth6809.asm):03006                     LDD   #LIT
E31D 3606             (    forth6809.asm):03007                     PSHU  D
E31F BDEAB9           (    forth6809.asm):03008                     JSR   CCALL
E322 BDDFFC           (    forth6809.asm):03009                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
E325 CCDF60           (    forth6809.asm):03010                     LDD   #LIT
E328 3606             (    forth6809.asm):03011                     PSHU  D

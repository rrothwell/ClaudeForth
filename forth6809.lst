                      (    forth6809.asm):04237         
                      (    forth6809.asm):04238         ; ------------------------------------------------------------
                      (    forth6809.asm):04239         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04240         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04241         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04242         ;    Inputs:
                      (    forth6809.asm):04243         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04244         ;    Outputs:
                      (    forth6809.asm):04245         ;        single number: n and -1
                      (    forth6809.asm):04246         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04247         ;        not a number: c-addr and 0
                      (    forth6809.asm):04248         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04249         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04250         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04251         ; NUMBERQ.6.
                      (    forth6809.asm):04252         ; ------------------------------------------------------------
D938 3710             (    forth6809.asm):04253         NUMBERQ:    PULU  X                 ; c-addr
D93A 327D             (    forth6809.asm):04254                     LEAS  -3,S
D93C AFE4             (    forth6809.asm):04255                     STX   ,S
D93E E684             (    forth6809.asm):04256                     LDB   ,X
D940 276D             (    forth6809.asm):04257                     BEQ   NQBAD
D942 3001             (    forth6809.asm):04258                     LEAX  1,X
                      (    forth6809.asm):04259         
                      (    forth6809.asm):04260                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04261                     ; digit count. See shadow: NUMBERQ.1
D944 5A               (    forth6809.asm):04262                     DECB
D945 A685             (    forth6809.asm):04263                     LDA   B,X
D947 5C               (    forth6809.asm):04264                     INCB
D948 812E             (    forth6809.asm):04265                     CMPA  #'.'
D94A 2603             (    forth6809.asm):04266                     BNE   NQNOSIGN
D94C 5A               (    forth6809.asm):04267                     DECB
D94D 2760             (    forth6809.asm):04268                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04269         

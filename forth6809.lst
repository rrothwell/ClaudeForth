E5A6 0322             (    forth6809.asm):06279                  COM   NUMNEG
E5A8 3001             (    forth6809.asm):06280                  LEAX  1,X
E5AA 0A21             (    forth6809.asm):06281                  DEC   CNTREM
E5AC 2756             (    forth6809.asm):06282                  BEQ   NQBAD
                      (    forth6809.asm):06283         

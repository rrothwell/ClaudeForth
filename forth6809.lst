                      (    forth6809.asm):02428                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02429                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02430                                             ; the other unused vectors below
                      (    forth6809.asm):02431                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02432         
                      (    forth6809.asm):02433         ; ------------------------------------------------------------
                      (    forth6809.asm):02434         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02435         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
D3F4 3B               (    forth6809.asm):02437         SWI3H:      RTI
D3F5 3B               (    forth6809.asm):02438         SWI2H:      RTI
D3F6 3B               (    forth6809.asm):02439         FIRQH:      RTI
D3F7 3B               (    forth6809.asm):02440         NMIH:       RTI                     ; unused now that NMI -> WARM
D3F8 CCFF9D           (    forth6809.asm):02441         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
D3FB 3606             (    forth6809.asm):02442                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
D3FD 7EDE2F           (    forth6809.asm):02443                     JMP   THROWW

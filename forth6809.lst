                      (    forth6809.asm):06987         ; SECTION 20: NUMERIC OUTPUT (pictured + direct)
                      (    forth6809.asm):06988         ; ============================================================
                      (    forth6809.asm):06989         ; ------------------------------------------------------------
                      (    forth6809.asm):06990         ; <#  ( -- )
                      (    forth6809.asm):06991         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):06992         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):06993         ; ------------------------------------------------------------
F841 BDE034           (    forth6809.asm):06994         LTNUMW:     JSR   PADW

                      (    forth6809.asm):01615         ; TSTDROT - unit test for 2ROT
                      (    forth6809.asm):01616         ; ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 ). Verifies the
                      (    forth6809.asm):01617         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):01618         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):01619         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01620         TSTDROT:   STU   TSTU0
                      (    forth6809.asm):01621         
                      (    forth6809.asm):01622                    LDD   #TSTGUARD
                      (    forth6809.asm):01623                    PSHU  D

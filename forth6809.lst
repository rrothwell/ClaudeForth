                      (    forth6809.asm):03964         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03965         ; location.
                      (    forth6809.asm):03966         ; PATCH   ( target location -- )
                      (    forth6809.asm):03967         ;    Inputs:
                      (    forth6809.asm):03968         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03969         ;    Outputs:
                      (    forth6809.asm):03970         ;        the cell at location holds target - location
                      (    forth6809.asm):03971         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03972         ; ------------------------------------------------------------
E596 3710             (    forth6809.asm):03973         PATCH:      PULU  X                 ; location
E598 3706             (    forth6809.asm):03974                     PULU  D                 ; target
E59A 3410             (    forth6809.asm):03975                     PSHS  X

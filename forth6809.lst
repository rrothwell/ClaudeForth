                      (    forth6809.asm):02587         ; ============================================================
                      (    forth6809.asm):02588         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02589         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02590         ; ============================================================
                      (    forth6809.asm):02591         ; ------------------------------------------------------------
                      (    forth6809.asm):02592         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02593         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02594         ; LIT   ( -- x )
                      (    forth6809.asm):02595         ;    Inputs:
                      (    forth6809.asm):02596         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02597         ;    Outputs:
                      (    forth6809.asm):02598         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02599         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02600         ; ------------------------------------------------------------
D4E9 3510             (    forth6809.asm):02601         LIT:        PULS  X
D4EB EC81             (    forth6809.asm):02602                     LDD   ,X++
D4ED 3606             (    forth6809.asm):02603                     PSHU  D                 ; x
D4EF 3410             (    forth6809.asm):02604                     PSHS  X
D4F1 39               (    forth6809.asm):02605                     RTS
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02609         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02610         ; address.
                      (    forth6809.asm):02611         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02612         ;    Inputs:
                      (    forth6809.asm):02613         ;        flag on the data stack
                      (    forth6809.asm):02614         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02615         ;    Outputs:
                      (    forth6809.asm):02616         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02617         ;        the offset
                      (    forth6809.asm):02618         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
D4F2 3706             (    forth6809.asm):02620         ZBRANCH:    PULU  D                 ; flag
D4F4 3510             (    forth6809.asm):02621                     PULS  X
D4F6 10830000         (    forth6809.asm):02622                     CMPD  #0
D4FA 2607             (    forth6809.asm):02623                     BNE   ZSKIP
D4FC EC84             (    forth6809.asm):02624                     LDD   ,X
D4FE 308B             (    forth6809.asm):02625                     LEAX  D,X
D500 3410             (    forth6809.asm):02626                     PSHS  X
D502 39               (    forth6809.asm):02627                     RTS
D503 3002             (    forth6809.asm):02628         ZSKIP:      LEAX  2,X
D505 3410             (    forth6809.asm):02629                     PSHS  X
D507 39               (    forth6809.asm):02630                     RTS
                      (    forth6809.asm):02631         
                      (    forth6809.asm):02632         ; ------------------------------------------------------------
                      (    forth6809.asm):02633         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02634         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02635         ; BRANCH
                      (    forth6809.asm):02636         ;    Inputs:
                      (    forth6809.asm):02637         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02638         ;    Outputs:
                      (    forth6809.asm):02639         ;        return address set to the branch target
                      (    forth6809.asm):02640         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02641         ; ------------------------------------------------------------
D508 3510             (    forth6809.asm):02642         BRANCH:     PULS  X
D50A EC84             (    forth6809.asm):02643                     LDD   ,X
D50C 308B             (    forth6809.asm):02644                     LEAX  D,X
D50E 3410             (    forth6809.asm):02645                     PSHS  X
D510 39               (    forth6809.asm):02646                     RTS
                      (    forth6809.asm):02647         
                      (    forth6809.asm):02648         ; ------------------------------------------------------------
                      (    forth6809.asm):02649         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02650         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02651         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02652         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02653         ;    Inputs:
                      (    forth6809.asm):02654         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02655         ;        trampoline
                      (    forth6809.asm):02656         ;    Outputs:
                      (    forth6809.asm):02657         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02658         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
D511 3510             (    forth6809.asm):02660         DODOES:     PULS  X
D513 10AE81           (    forth6809.asm):02661                     LDY   ,X++
D516 EC84             (    forth6809.asm):02662                     LDD   ,X
D518 3606             (    forth6809.asm):02663                     PSHU  D                 ; pfa
D51A 6EA4             (    forth6809.asm):02664                     JMP   ,Y
                      (    forth6809.asm):02665         
                      (    forth6809.asm):02666         ; ------------------------------------------------------------
                      (    forth6809.asm):02667         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02668         ; field address on the stack.
                      (    forth6809.asm):02669         ; DOESRT0
                      (    forth6809.asm):02670         ;    Inputs:
                      (    forth6809.asm):02671         ;        none
                      (    forth6809.asm):02672         ;    Outputs:
                      (    forth6809.asm):02673         ;        none
                      (    forth6809.asm):02674         ;    Registers: none.
                      (    forth6809.asm):02675         ; ------------------------------------------------------------
D51C 39               (    forth6809.asm):02676         DOESRT0:    RTS
                      (    forth6809.asm):02677         
                      (    forth6809.asm):02678         ; ------------------------------------------------------------
                      (    forth6809.asm):02679         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02680         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02681         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02682         ; SETDOES
                      (    forth6809.asm):02683         ;    Inputs:
                      (    forth6809.asm):02684         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02685         ;        BEHAVIOR)
                      (    forth6809.asm):02686         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02687         ;        address
                      (    forth6809.asm):02688         ;    Outputs:
                      (    forth6809.asm):02689         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02690         ;        defining word's caller
                      (    forth6809.asm):02691         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
D51D 3510             (    forth6809.asm):02693         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D51F 1F12             (    forth6809.asm):02694                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02695         
D521 9E04             (    forth6809.asm):02696                     LDX   LATEST
D523 E684             (    forth6809.asm):02697                     LDB   ,X
D525 C41F             (    forth6809.asm):02698                     ANDB  #$1F
D527 4F               (    forth6809.asm):02699                     CLRA
D528 308B             (    forth6809.asm):02700                     LEAX  D,X               ; header + name length
D52A EC03             (    forth6809.asm):02701                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D52C C30003           (    forth6809.asm):02702                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D52F 1F01             (    forth6809.asm):02703                     TFR   D,X
                      (    forth6809.asm):02704         
D531 10AF84           (    forth6809.asm):02705                     STY   ,X                ; patch it
                      (    forth6809.asm):02706         
D534 3510             (    forth6809.asm):02707                     PULS  X                 ; X = the OUTER defining word's own return addr
D536 6E84             (    forth6809.asm):02708                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02709         
                      (    forth6809.asm):02710         ; ------------------------------------------------------------
                      (    forth6809.asm):02711         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02712         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02713         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02714         ;    Inputs:
                      (    forth6809.asm):02715         ;        pfa on the data stack
                      (    forth6809.asm):02716         ;    Outputs:
                      (    forth6809.asm):02717         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02718         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
D538 3710             (    forth6809.asm):02720         DODEFER:    PULU  X                 ; pfa
D53A EC84             (    forth6809.asm):02721                     LDD   ,X
D53C 1F01             (    forth6809.asm):02722                     TFR   D,X
D53E 6E84             (    forth6809.asm):02723                     JMP   ,X
                      (    forth6809.asm):02724         
                      (    forth6809.asm):02725         ; ------------------------------------------------------------
                      (    forth6809.asm):02726         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02727         ; DOABORTUNDEF
                      (    forth6809.asm):02728         ;    Inputs:
                      (    forth6809.asm):02729         ;        none
                      (    forth6809.asm):02730         ;    Outputs:
                      (    forth6809.asm):02731         ;        none (does not return)
                      (    forth6809.asm):02732         ;    Registers: RegD changed.
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
D540                  (    forth6809.asm):02734         DOABORTUNDEF:
D540 CCFFEB           (    forth6809.asm):02735                     LDD   #-21
D543 3606             (    forth6809.asm):02736                     PSHU  D                 ; throw code (-21)
D545 7EDE2F           (    forth6809.asm):02737                     JMP   THROWW
                      (    forth6809.asm):02738         
                      (    forth6809.asm):02739         ; ------------------------------------------------------------
                      (    forth6809.asm):02740         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02741         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02742         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02743         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02744         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02745         ;    Inputs:
                      (    forth6809.asm):02746         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02747         ;    Outputs:
                      (    forth6809.asm):02748         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02749         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02750         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
D548 3710             (    forth6809.asm):02752         DOMARKER:   PULU  X                 ; pfa
D54A EC84             (    forth6809.asm):02753                     LDD   ,X
D54C DD06             (    forth6809.asm):02754                     STD   DPHERE
D54E EC02             (    forth6809.asm):02755                     LDD   2,X
D550 DD08             (    forth6809.asm):02756                     STD   CODEHERE
D552 EC04             (    forth6809.asm):02757                     LDD   4,X
D554 DD0A             (    forth6809.asm):02758                     STD   VARHERE
D556 EC06             (    forth6809.asm):02759                     LDD   6,X
D558 DD04             (    forth6809.asm):02760                     STD   LATEST
D55A 3008             (    forth6809.asm):02761                     LEAX  8,X               ; the saved search-order state follows
D55C 108E0045         (    forth6809.asm):02762                     LDY   #SRCHSAVE
D560 C616             (    forth6809.asm):02763                     LDB   #SRCHSAVESZ
D562 A680             (    forth6809.asm):02764         DMCOPY:     LDA   ,X+
D564 A7A0             (    forth6809.asm):02765                     STA   ,Y+
D566 5A               (    forth6809.asm):02766                     DECB
D567 26F9             (    forth6809.asm):02767                     BNE   DMCOPY
D569 DC06             (    forth6809.asm):02768                     LDD   DPHERE
D56B 7EDA9E           (    forth6809.asm):02769                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02770         
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
                      (    forth6809.asm):02772         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02773         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02774         ; ------------------------------------------------------------
D56E 3710             (    forth6809.asm):02775         EXECUTEW:   PULU  X                 ; xt
D570 AD84             (    forth6809.asm):02776                     JSR   ,X
D572 39               (    forth6809.asm):02777                     RTS
                      (    forth6809.asm):02778         
                      (    forth6809.asm):02779         ; ============================================================
                      (    forth6809.asm):02780         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02781         ; ============================================================
                      (    forth6809.asm):02782         ; ------------------------------------------------------------
                      (    forth6809.asm):02783         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02784         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02785         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02786         ;    Inputs:
                      (    forth6809.asm):02787         ;        RegX = address of the here pointer
                      (    forth6809.asm):02788         ;        x on the data stack
                      (    forth6809.asm):02789         ;    Outputs:
                      (    forth6809.asm):02790         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02791         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02792         ; ------------------------------------------------------------
D573 3706             (    forth6809.asm):02793         APPENDCELL: PULU  D                 ; x
D575 10AE84           (    forth6809.asm):02794                     LDY   ,X
D578 EDA1             (    forth6809.asm):02795                     STD   ,Y++
D57A 10AF84           (    forth6809.asm):02796                     STY   ,X
D57D 39               (    forth6809.asm):02797                     RTS
                      (    forth6809.asm):02798         
                      (    forth6809.asm):02799         ; ------------------------------------------------------------
                      (    forth6809.asm):02800         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02801         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02802         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02803         ;    Inputs:
                      (    forth6809.asm):02804         ;        RegX = address of the here pointer
                      (    forth6809.asm):02805         ;        char on the data stack
                      (    forth6809.asm):02806         ;    Outputs:
                      (    forth6809.asm):02807         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02808         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02809         ; ------------------------------------------------------------
D57E 3706             (    forth6809.asm):02810         APPENDBYTE: PULU  D                 ; char
D580 10AE84           (    forth6809.asm):02811                     LDY   ,X
D583 E7A0             (    forth6809.asm):02812                     STB   ,Y+
D585 10AF84           (    forth6809.asm):02813                     STY   ,X
D588 39               (    forth6809.asm):02814                     RTS
                      (    forth6809.asm):02815         
                      (    forth6809.asm):02816         ; ------------------------------------------------------------
                      (    forth6809.asm):02817         ; ,  ( x -- )
                      (    forth6809.asm):02818         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02819         ; ------------------------------------------------------------
D589 8E0008           (    forth6809.asm):02820         COMMAW:     LDX   #CODEHERE
D58C 7ED573           (    forth6809.asm):02821                     JMP   APPENDCELL
                      (    forth6809.asm):02822         
                      (    forth6809.asm):02823         ; ------------------------------------------------------------
                      (    forth6809.asm):02824         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02825         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02826         ; ------------------------------------------------------------
D58F 8E0008           (    forth6809.asm):02827         CODECOMMA:  LDX   #CODEHERE
D592 7ED573           (    forth6809.asm):02828                     JMP   APPENDCELL
                      (    forth6809.asm):02829         
                      (    forth6809.asm):02830         ; ------------------------------------------------------------
                      (    forth6809.asm):02831         ; C,  ( char -- )
                      (    forth6809.asm):02832         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02833         ; ------------------------------------------------------------
D595 8E0008           (    forth6809.asm):02834         CCOMMAW:    LDX   #CODEHERE
D598 7ED57E           (    forth6809.asm):02835                     JMP   APPENDBYTE
                      (    forth6809.asm):02836         
                      (    forth6809.asm):02837         ; ------------------------------------------------------------
                      (    forth6809.asm):02838         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02839         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02840         ; ------------------------------------------------------------
D59B 8E0008           (    forth6809.asm):02841         CCOMMA1:    LDX   #CODEHERE
D59E 7ED57E           (    forth6809.asm):02842                     JMP   APPENDBYTE
                      (    forth6809.asm):02843         
                      (    forth6809.asm):02844         ; ------------------------------------------------------------
                      (    forth6809.asm):02845         ; V,  ( x -- )
                      (    forth6809.asm):02846         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02847         ; ------------------------------------------------------------
D5A1 8E000A           (    forth6809.asm):02848         VCOMMAW:    LDX   #VARHERE
D5A4 7ED573           (    forth6809.asm):02849                     JMP   APPENDCELL
                      (    forth6809.asm):02850         
                      (    forth6809.asm):02851         ; ------------------------------------------------------------
                      (    forth6809.asm):02852         ; VC,  ( char -- )
                      (    forth6809.asm):02853         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02854         ; ------------------------------------------------------------
D5A7 8E000A           (    forth6809.asm):02855         VCCOMMAW:   LDX   #VARHERE
D5AA 7ED57E           (    forth6809.asm):02856                     JMP   APPENDBYTE
                      (    forth6809.asm):02857         
                      (    forth6809.asm):02858         ; ------------------------------------------------------------
                      (    forth6809.asm):02859         ; ALLOT  ( n -- )
                      (    forth6809.asm):02860         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02861         ; ------------------------------------------------------------
D5AD 3706             (    forth6809.asm):02862         ALLOTW:     PULU  D                 ; n
D5AF 9E08             (    forth6809.asm):02863                     LDX   CODEHERE
D5B1 308B             (    forth6809.asm):02864                     LEAX  D,X
D5B3 9F08             (    forth6809.asm):02865                     STX   CODEHERE
D5B5 39               (    forth6809.asm):02866                     RTS
                      (    forth6809.asm):02867         
                      (    forth6809.asm):02868         ; ------------------------------------------------------------
                      (    forth6809.asm):02869         ; VALLOT  ( n -- )
                      (    forth6809.asm):02870         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02871         ; ------------------------------------------------------------
D5B6 3706             (    forth6809.asm):02872         VALLOTW:    PULU  D                 ; n
D5B8 9E0A             (    forth6809.asm):02873                     LDX   VARHERE
D5BA 308B             (    forth6809.asm):02874                     LEAX  D,X
D5BC 9F0A             (    forth6809.asm):02875                     STX   VARHERE
D5BE 39               (    forth6809.asm):02876                     RTS
                      (    forth6809.asm):02877         
                      (    forth6809.asm):02878         ; ------------------------------------------------------------
                      (    forth6809.asm):02879         ; HERE  ( -- addr )
                      (    forth6809.asm):02880         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02881         ; ------------------------------------------------------------
D5BF DC08             (    forth6809.asm):02882         HEREW:      LDD   CODEHERE
D5C1 3606             (    forth6809.asm):02883                     PSHU  D                 ; addr
D5C3 39               (    forth6809.asm):02884                     RTS
                      (    forth6809.asm):02885         
                      (    forth6809.asm):02886         ; ------------------------------------------------------------
                      (    forth6809.asm):02887         ; VHERE  ( -- addr )
                      (    forth6809.asm):02888         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02889         ; ------------------------------------------------------------
D5C4 DC0A             (    forth6809.asm):02890         VHEREW:     LDD   VARHERE
D5C6 3606             (    forth6809.asm):02891                     PSHU  D                 ; addr
D5C8 39               (    forth6809.asm):02892                     RTS
                      (    forth6809.asm):02893         
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
                      (    forth6809.asm):02895         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02896         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02897         ; ------------------------------------------------------------
D5C9 DC08             (    forth6809.asm):02898         PADW:       LDD   CODEHERE
D5CB C30080           (    forth6809.asm):02899                     ADDD  #PADOFFSET
D5CE 3606             (    forth6809.asm):02900                     PSHU  D                 ; c-addr
D5D0 39               (    forth6809.asm):02901                     RTS
                      (    forth6809.asm):02902         
                      (    forth6809.asm):02903         ; ------------------------------------------------------------
                      (    forth6809.asm):02904         ; UNUSED  ( -- u )
                      (    forth6809.asm):02905         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02906         ; ------------------------------------------------------------
D5D1 CCB900           (    forth6809.asm):02907         UNUSEDW:    LDD   #CODETOP
D5D4 9308             (    forth6809.asm):02908                     SUBD  CODEHERE
D5D6 3606             (    forth6809.asm):02909                     PSHU  D                 ; u
D5D8 39               (    forth6809.asm):02910                     RTS
                      (    forth6809.asm):02911         
                      (    forth6809.asm):02912         ; ------------------------------------------------------------
                      (    forth6809.asm):02913         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02914         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02915         ; ------------------------------------------------------------
D5D9 CC1FFF           (    forth6809.asm):02916         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D5DC 930A             (    forth6809.asm):02917                     SUBD  VARHERE
D5DE 3606             (    forth6809.asm):02918                     PSHU  D                 ; u
D5E0 39               (    forth6809.asm):02919                     RTS
                      (    forth6809.asm):02920         
                      (    forth6809.asm):02921         ; ============================================================
                      (    forth6809.asm):02922         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02923         ; ============================================================
                      (    forth6809.asm):02924         ; ------------------------------------------------------------
                      (    forth6809.asm):02925         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02926         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02927         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02928         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02929         ; wordlist are updated.
                      (    forth6809.asm):02930         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02931         ;    Inputs:
                      (    forth6809.asm):02932         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02933         ;        name parsed from the input stream
                      (    forth6809.asm):02934         ;    Outputs:
                      (    forth6809.asm):02935         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02936         ;        LATEST = address of the new header
                      (    forth6809.asm):02937         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02938         ; ------------------------------------------------------------
D5E1 CC0020           (    forth6809.asm):02939         HEADER:     LDD   #32
D5E4 3606             (    forth6809.asm):02940                     PSHU  D
D5E6 BDD927           (    forth6809.asm):02941                     JSR   WORDW
D5E9 3710             (    forth6809.asm):02942                     PULU  X                 ; c-addr of the name
D5EB 3706             (    forth6809.asm):02943                     PULU  D                 ; smudge flag in B
D5ED A680             (    forth6809.asm):02944                     LDA   ,X+               ; name length, X = name text
D5EF 3402             (    forth6809.asm):02945                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D5F1 5D               (    forth6809.asm):02946                     TSTB
D5F2 2702             (    forth6809.asm):02947                     BEQ   HDNOSM
D5F4 8A40             (    forth6809.asm):02948                     ORA   #$40
D5F6 109E06           (    forth6809.asm):02949         HDNOSM:     LDY   DPHERE
D5F9 3420             (    forth6809.asm):02950                     PSHS  Y                 ; 0,S = address of the new header
D5FB A7A0             (    forth6809.asm):02951                     STA   ,Y+
D5FD E662             (    forth6809.asm):02952                     LDB   2,S
D5FF 2707             (    forth6809.asm):02953                     BEQ   HDNONM
D601 A680             (    forth6809.asm):02954         HDCPY:      LDA   ,X+
D603 A7A0             (    forth6809.asm):02955                     STA   ,Y+
D605 5A               (    forth6809.asm):02956                     DECB
D606 26F9             (    forth6809.asm):02957                     BNE   HDCPY
D608 9E47             (    forth6809.asm):02958         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D60A EC84             (    forth6809.asm):02959                     LDD   ,X
D60C EDA1             (    forth6809.asm):02960                     STD   ,Y++              ; LINK = old head of that wordlist
D60E DC08             (    forth6809.asm):02961                     LDD   CODEHERE
D610 EDA1             (    forth6809.asm):02962                     STD   ,Y++
D612 109F06           (    forth6809.asm):02963                     STY   DPHERE
D615 3506             (    forth6809.asm):02964                     PULS  D
D617 DD04             (    forth6809.asm):02965                     STD   LATEST            ; LATEST = newest header of any wordlist
D619 ED84             (    forth6809.asm):02966                     STD   ,X                ; and the new head of the CURRENT wordlist
D61B 3261             (    forth6809.asm):02967                     LEAS  1,S
D61D 39               (    forth6809.asm):02968                     RTS
                      (    forth6809.asm):02969         
                      (    forth6809.asm):02970         ; ------------------------------------------------------------
                      (    forth6809.asm):02971         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):02972         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):02973         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):02974         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):02975         ; SMUDGE   ( -- )
                      (    forth6809.asm):02976         ;    Inputs:
                      (    forth6809.asm):02977         ;        none
                      (    forth6809.asm):02978         ;    Outputs:
                      (    forth6809.asm):02979         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):02980         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):02981         ; ------------------------------------------------------------
D61E 9E04             (    forth6809.asm):02982         SMUDGEW:    LDX   LATEST
D620 A684             (    forth6809.asm):02983                     LDA   ,X
D622 8840             (    forth6809.asm):02984                     EORA  #$40
D624 A784             (    forth6809.asm):02985                     STA   ,X
D626 39               (    forth6809.asm):02986                     RTS
                      (    forth6809.asm):02987         
                      (    forth6809.asm):02988         ; ============================================================
                      (    forth6809.asm):02989         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02990         ; ============================================================
                      (    forth6809.asm):02991         ; ------------------------------------------------------------
                      (    forth6809.asm):02992         ; :  ( "name" -- )
                      (    forth6809.asm):02993         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02994         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02995         ; CSP and enter compile state.
                      (    forth6809.asm):02996         ; ------------------------------------------------------------
D627 CCFFFF           (    forth6809.asm):02997         COLONW:     LDD   #TRUEV
D62A 3606             (    forth6809.asm):02998                     PSHU  D
D62C BDD5E1           (    forth6809.asm):02999                     JSR   HEADER
D62F DC08             (    forth6809.asm):03000                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D631 DD1F             (    forth6809.asm):03001                     STD   CURXT             ; See bugfix: COLONW.1
D633 1F30             (    forth6809.asm):03002                     TFR   U,D
D635 DD21             (    forth6809.asm):03003                     STD   CSP
D637 CCFFFF           (    forth6809.asm):03004                     LDD   #-1
D63A DD00             (    forth6809.asm):03005                     STD   STATE
D63C 39               (    forth6809.asm):03006                     RTS
                      (    forth6809.asm):03007         
                      (    forth6809.asm):03008         ; ------------------------------------------------------------
                      (    forth6809.asm):03009         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03010         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03011         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03012         ; new word and return to interpret state.
                      (    forth6809.asm):03013         ; ------------------------------------------------------------
D63D CC0039           (    forth6809.asm):03014         SEMIW:      LDD   #RTSOPC
D640 3606             (    forth6809.asm):03015                     PSHU  D
D642 BDD59B           (    forth6809.asm):03016                     JSR   CCOMMA1
D645 1F30             (    forth6809.asm):03017                     TFR   U,D
D647 109321           (    forth6809.asm):03018                     CMPD  CSP
D64A 2703             (    forth6809.asm):03019                     BEQ   SEMIOK
D64C BDDDFA           (    forth6809.asm):03020                     JSR   CFERR
D64F 9E04             (    forth6809.asm):03021         SEMIOK:     LDX   LATEST
D651 A684             (    forth6809.asm):03022                     LDA   ,X
D653 84BF             (    forth6809.asm):03023                     ANDA  #$BF
D655 A784             (    forth6809.asm):03024                     STA   ,X
D657 CC0000           (    forth6809.asm):03025                     LDD   #0
D65A DD00             (    forth6809.asm):03026                     STD   STATE
D65C 39               (    forth6809.asm):03027                     RTS
                      (    forth6809.asm):03028         
                      (    forth6809.asm):03029         ; ------------------------------------------------------------
                      (    forth6809.asm):03030         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03031         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03032         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03033         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03034         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03035         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03036         ; ------------------------------------------------------------
D65D DC08             (    forth6809.asm):03037         NONAMEW:    LDD   CODEHERE
D65F 3606             (    forth6809.asm):03038                     PSHU  D                 ; xt
D661 DD1F             (    forth6809.asm):03039                     STD   CURXT             ; See bugfix: NONAMEW.1
D663 1F30             (    forth6809.asm):03040                     TFR   U,D
D665 DD21             (    forth6809.asm):03041                     STD   CSP
D667 CCFFFF           (    forth6809.asm):03042                     LDD   #-1
D66A DD00             (    forth6809.asm):03043                     STD   STATE
D66C 39               (    forth6809.asm):03044                     RTS
                      (    forth6809.asm):03045         
                      (    forth6809.asm):03046         ; ------------------------------------------------------------
                      (    forth6809.asm):03047         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03048         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03049         ; BLDDOES
                      (    forth6809.asm):03050         ;    Inputs:
                      (    forth6809.asm):03051         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03052         ;    Outputs:
                      (    forth6809.asm):03053         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03054         ;    Registers: all changed.
                      (    forth6809.asm):03055         ; BLDSELF
                      (    forth6809.asm):03056         ;    Inputs:
                      (    forth6809.asm):03057         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03058         ;    Outputs:
                      (    forth6809.asm):03059         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03060         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03061         ;    Registers: all changed.
                      (    forth6809.asm):03062         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03063         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03064         ; ------------------------------------------------------------
D66D 3406             (    forth6809.asm):03065         BLDDOES:    PSHS  D                 ; behaviour address
D66F CC0000           (    forth6809.asm):03066                     LDD   #0
D672 3606             (    forth6809.asm):03067                     PSHU  D
D674 BDD5E1           (    forth6809.asm):03068                     JSR   HEADER
D677 CCD511           (    forth6809.asm):03069                     LDD   #DODOES
D67A 3606             (    forth6809.asm):03070                     PSHU  D
D67C BDE26A           (    forth6809.asm):03071                     JSR   CCALL
D67F 3506             (    forth6809.asm):03072                     PULS  D
D681 3606             (    forth6809.asm):03073                     PSHU  D                 ; behaviour address
D683 BDD58F           (    forth6809.asm):03074                     JSR   CODECOMMA
D686 39               (    forth6809.asm):03075                     RTS
                      (    forth6809.asm):03076         
D687 BDD66D           (    forth6809.asm):03077         BLDSELF:    JSR   BLDDOES
D68A DC08             (    forth6809.asm):03078                     LDD   CODEHERE          ; PFA = the cell after this one
D68C C30002           (    forth6809.asm):03079                     ADDD  #2                ; See bugfix: CONSTANTW.1
D68F 3606             (    forth6809.asm):03080                     PSHU  D
D691 BDD58F           (    forth6809.asm):03081                     JSR   CODECOMMA
D694 39               (    forth6809.asm):03082                     RTS
                      (    forth6809.asm):03083         
                      (    forth6809.asm):03084         ; ------------------------------------------------------------
                      (    forth6809.asm):03085         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03086         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03087         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03088         ; address in the code area, on the stack.
                      (    forth6809.asm):03089         ; ------------------------------------------------------------
D695 CCD51C           (    forth6809.asm):03090         CREATEW:    LDD   #DOESRT0
D698 BDD687           (    forth6809.asm):03091                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D69B 39               (    forth6809.asm):03092                     RTS
                      (    forth6809.asm):03093         
                      (    forth6809.asm):03094         ; ------------------------------------------------------------
                      (    forth6809.asm):03095         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03096         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03097         ; of the word being defined.
                      (    forth6809.asm):03098         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03099         ; ------------------------------------------------------------
D69C CCD51D           (    forth6809.asm):03100         DOESGTW:    LDD   #SETDOES
D69F 3606             (    forth6809.asm):03101                     PSHU  D
D6A1 BDE26A           (    forth6809.asm):03102                     JSR   CCALL
D6A4 39               (    forth6809.asm):03103                     RTS
                      (    forth6809.asm):03104         
                      (    forth6809.asm):03105         ; ------------------------------------------------------------
                      (    forth6809.asm):03106         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03107         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03108         ; area, initialised to zero.
                      (    forth6809.asm):03109         ; ------------------------------------------------------------
D6A5 CC0000           (    forth6809.asm):03110         VARIABLEW:  LDD   #0
D6A8 3606             (    forth6809.asm):03111                     PSHU  D
D6AA BDD5E1           (    forth6809.asm):03112                     JSR   HEADER
D6AD CCD511           (    forth6809.asm):03113                     LDD   #DODOES
D6B0 3606             (    forth6809.asm):03114                     PSHU  D
D6B2 BDE26A           (    forth6809.asm):03115                     JSR   CCALL
D6B5 CCD51C           (    forth6809.asm):03116                     LDD   #DOESRT0
D6B8 3606             (    forth6809.asm):03117                     PSHU  D
D6BA BDD58F           (    forth6809.asm):03118                     JSR   CODECOMMA
D6BD DC0A             (    forth6809.asm):03119                     LDD   VARHERE
D6BF 3606             (    forth6809.asm):03120                     PSHU  D
D6C1 BDD58F           (    forth6809.asm):03121                     JSR   CODECOMMA
D6C4 CC0000           (    forth6809.asm):03122                     LDD   #0
D6C7 9E0A             (    forth6809.asm):03123                     LDX   VARHERE
D6C9 ED81             (    forth6809.asm):03124                     STD   ,X++
D6CB 9F0A             (    forth6809.asm):03125                     STX   VARHERE
D6CD 39               (    forth6809.asm):03126                     RTS
                      (    forth6809.asm):03127         
                      (    forth6809.asm):03128         ; ------------------------------------------------------------
                      (    forth6809.asm):03129         ; @  ( a-addr -- x )
                      (    forth6809.asm):03130         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03131         ; ------------------------------------------------------------
D6CE 3710             (    forth6809.asm):03132         FETCHW:     PULU  X                 ; a-addr
D6D0 EC84             (    forth6809.asm):03133                     LDD   ,X
D6D2 3606             (    forth6809.asm):03134                     PSHU  D                 ; x
D6D4 39               (    forth6809.asm):03135                     RTS
                      (    forth6809.asm):03136         
                      (    forth6809.asm):03137         ; ------------------------------------------------------------
                      (    forth6809.asm):03138         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03139         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03140         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03141         ; ------------------------------------------------------------
D6D5 CCD6CE           (    forth6809.asm):03142         CONSTANTW:  LDD   #FETCHW
D6D8 BDD687           (    forth6809.asm):03143                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D6DB BDD589           (    forth6809.asm):03144                     JSR   COMMAW
D6DE 39               (    forth6809.asm):03145                     RTS
                      (    forth6809.asm):03146         
                      (    forth6809.asm):03147         ; ------------------------------------------------------------
                      (    forth6809.asm):03148         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03149         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03150         ;    Inputs:
                      (    forth6809.asm):03151         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03152         ;    Outputs:
                      (    forth6809.asm):03153         ;        pfa replaced by the value
                      (    forth6809.asm):03154         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03155         ; ------------------------------------------------------------
D6DF 3710             (    forth6809.asm):03156         DOVALUE:    PULU  X                 ; pfa
D6E1 EC84             (    forth6809.asm):03157                     LDD   ,X
D6E3 3606             (    forth6809.asm):03158                     PSHU  D                 ; x
D6E5 39               (    forth6809.asm):03159                     RTS
                      (    forth6809.asm):03160         
                      (    forth6809.asm):03161         ; ------------------------------------------------------------
                      (    forth6809.asm):03162         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03163         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03164         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03165         ; ------------------------------------------------------------
D6E6 CCD6DF           (    forth6809.asm):03166         VALUEW:     LDD   #DOVALUE
D6E9 BDD66D           (    forth6809.asm):03167                     JSR   BLDDOES
D6EC DC0A             (    forth6809.asm):03168                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D6EE 3606             (    forth6809.asm):03169                     PSHU  D                 ; See bugfix: VALUEW.1
D6F0 BDD58F           (    forth6809.asm):03170                     JSR   CODECOMMA
D6F3 BDD5A1           (    forth6809.asm):03171                     JSR   VCOMMAW           ; store x in the variable area
D6F6 39               (    forth6809.asm):03172                     RTS
                      (    forth6809.asm):03173         
                      (    forth6809.asm):03174         ; ------------------------------------------------------------
                      (    forth6809.asm):03175         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03176         ; lower address as 2@ expects.
                      (    forth6809.asm):03177         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03178         ; ------------------------------------------------------------
D6F7 7EEC2B           (    forth6809.asm):03179         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03180         
                      (    forth6809.asm):03181         ; ------------------------------------------------------------
                      (    forth6809.asm):03182         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03183         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03184         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03185         ; ------------------------------------------------------------
D6FA CCD6F7           (    forth6809.asm):03186         TWOVALUEW:  LDD   #DO2VALUE
D6FD BDD66D           (    forth6809.asm):03187                     JSR   BLDDOES
D700 DC0A             (    forth6809.asm):03188                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D702 3606             (    forth6809.asm):03189                     PSHU  D
D704 BDD58F           (    forth6809.asm):03190                     JSR   CODECOMMA
D707 BDD5A1           (    forth6809.asm):03191                     JSR   VCOMMAW           ; x2 at the lower address
D70A BDD5A1           (    forth6809.asm):03192                     JSR   VCOMMAW           ; then x1
D70D 39               (    forth6809.asm):03193                     RTS
                      (    forth6809.asm):03194         
                      (    forth6809.asm):03195         ; ------------------------------------------------------------
                      (    forth6809.asm):03196         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03197         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03198         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03199         ; ------------------------------------------------------------
D70E CC0020           (    forth6809.asm):03200         TOW:        LDD   #32
D711 3606             (    forth6809.asm):03201                     PSHU  D
D713 BDD927           (    forth6809.asm):03202                     JSR   WORDW
D716 BDDA10           (    forth6809.asm):03203                     JSR   FINDW
D719 3706             (    forth6809.asm):03204                     PULU  D
D71B 10830000         (    forth6809.asm):03205                     CMPD  #0
D71F 260A             (    forth6809.asm):03206                     BNE   TOFOUND
D721 3706             (    forth6809.asm):03207                     PULU  D
D723 CCFFF3           (    forth6809.asm):03208                     LDD   #-13
D726 3606             (    forth6809.asm):03209                     PSHU  D
D728 BDDE2F           (    forth6809.asm):03210                     JSR   THROWW
D72B AEC4             (    forth6809.asm):03211         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
D72D EC03             (    forth6809.asm):03212                     LDD   3,X
D72F 1083D6F7         (    forth6809.asm):03213                     CMPD  #DO2VALUE
D733 271A             (    forth6809.asm):03214                     BEQ   TOTWO
D735 BDE32B           (    forth6809.asm):03215                     JSR   TOBODYW
D738 DC00             (    forth6809.asm):03216                     LDD   STATE
D73A 270C             (    forth6809.asm):03217                     BEQ   TOIMMED
D73C BDE277           (    forth6809.asm):03218                     JSR   LITERALW
D73F CCEC0C           (    forth6809.asm):03219                     LDD   #STOREW
D742 3606             (    forth6809.asm):03220                     PSHU  D
D744 BDE26A           (    forth6809.asm):03221                     JSR   CCALL
D747 39               (    forth6809.asm):03222                     RTS
D748 3710             (    forth6809.asm):03223         TOIMMED:    PULU  X                 ; a-addr of the value cell
D74A 3706             (    forth6809.asm):03224                     PULU  D                 ; x
D74C ED84             (    forth6809.asm):03225                     STD   ,X
D74E 39               (    forth6809.asm):03226                     RTS
D74F BDE32B           (    forth6809.asm):03227         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
D752 DC00             (    forth6809.asm):03228                     LDD   STATE
D754 270C             (    forth6809.asm):03229                     BEQ   TOTWOIMM
D756 BDE277           (    forth6809.asm):03230                     JSR   LITERALW
D759 CCEC36           (    forth6809.asm):03231                     LDD   #TWOSTOREW
D75C 3606             (    forth6809.asm):03232                     PSHU  D
D75E BDE26A           (    forth6809.asm):03233                     JSR   CCALL
D761 39               (    forth6809.asm):03234                     RTS
D762 7EEC36           (    forth6809.asm):03235         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03236         
                      (    forth6809.asm):03237         ; ------------------------------------------------------------
                      (    forth6809.asm):03238         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03239         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03240         ; the variable area, initialised to zero.
                      (    forth6809.asm):03241         ; ------------------------------------------------------------
D765                  (    forth6809.asm):03242         TWOVARIABLEW:
D765 CC0000           (    forth6809.asm):03243                     LDD   #0
D768 3606             (    forth6809.asm):03244                     PSHU  D
D76A BDD5E1           (    forth6809.asm):03245                     JSR   HEADER
D76D CCD511           (    forth6809.asm):03246                     LDD   #DODOES
D770 3606             (    forth6809.asm):03247                     PSHU  D
D772 BDE26A           (    forth6809.asm):03248                     JSR   CCALL
D775 CCD51C           (    forth6809.asm):03249                     LDD   #DOESRT0
D778 3606             (    forth6809.asm):03250                     PSHU  D
D77A BDD58F           (    forth6809.asm):03251                     JSR   CODECOMMA
D77D DC0A             (    forth6809.asm):03252                     LDD   VARHERE
D77F 3606             (    forth6809.asm):03253                     PSHU  D
D781 BDD58F           (    forth6809.asm):03254                     JSR   CODECOMMA
D784 CC0000           (    forth6809.asm):03255                     LDD   #0
D787 9E0A             (    forth6809.asm):03256                     LDX   VARHERE
D789 ED81             (    forth6809.asm):03257                     STD   ,X++

                      (    forth6809.asm):10341                       BNE  PP1FAIL
                      (    forth6809.asm):10342                       LDD  6,X
                      (    forth6809.asm):10343                       CMPD #COMPILECOMMA
                      (    forth6809.asm):10344                       BNE  PP1FAIL
                      (    forth6809.asm):10345         

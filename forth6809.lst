DFC3 DFB4             (    forth6809.asm):01866                  FDB   H_ABORT
DFC5 E03A             (    forth6809.asm):01867                  FDB   QUIT
                      (    forth6809.asm):01868         
                      (    forth6809.asm):01869         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):01870         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):01871         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):01872         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):01873         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):01874         ; reconstructs and pushes the original c-addr, then 0.
DFC7 04               (    forth6809.asm):01875         H_FIND:  FCB   4
DFC8 46494E44         (    forth6809.asm):01876                  FCC   "FIND"
DFCC DFBE             (    forth6809.asm):01877                  FDB   H_QUIT
DFCE E576             (    forth6809.asm):01878                  FDB   FIND
                      (    forth6809.asm):01879         

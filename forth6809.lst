                      (    forth6809.asm):02026                    CMPD  #-10
                      (    forth6809.asm):02027                    BNE   SZFAIL
                      (    forth6809.asm):02028         
                      (    forth6809.asm):02029                    LDD   TSTUB4
                      (    forth6809.asm):02030                    SUBD  TSTUAF
                      (    forth6809.asm):02031                    CMPD  #0
                      (    forth6809.asm):02032                    BNE   SZFAIL
                      (    forth6809.asm):02033         
                      (    forth6809.asm):02034                    LDD   #TRUEV
                      (    forth6809.asm):02035                    BRA   SZDONE
C100                  (    forth6809.asm):02036         SZFAIL:     LDD   #FALSEV

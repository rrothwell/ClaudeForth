                      (    forth6809.asm):02298                     LDB   OUTHEAD
                      (    forth6809.asm):02299                     STA   B,X
                      (    forth6809.asm):02300         
                      (    forth6809.asm):02301                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02302                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02303                     STB   OUTHEAD
                      (    forth6809.asm):02304         

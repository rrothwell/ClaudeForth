DC1E 39               (    forth6809.asm):01625                     RTS
                      (    forth6809.asm):01626         
                      (    forth6809.asm):01627                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01628         ; ------------------------------------------------------------
                      (    forth6809.asm):01629         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01630         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01631         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01632         ; INFILL
                      (    forth6809.asm):01633         ;    Inputs:
                      (    forth6809.asm):01634         ;        none
                      (    forth6809.asm):01635         ;    Outputs:
                      (    forth6809.asm):01636         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01637         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01638         ; ------------------------------------------------------------
DC1F B60176           (    forth6809.asm):01639         INFILL:     LDA   INHEAD
DC22 B00177           (    forth6809.asm):01640                     SUBA  INTAIL
DC25 843F             (    forth6809.asm):01641                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DC27 39               (    forth6809.asm):01642                     RTS
                      (    forth6809.asm):01643         ; ------------------------------------------------------------
                      (    forth6809.asm):01644         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01645         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01646         ; receive path with interrupts already masked.
                      (    forth6809.asm):01647         ; RTSCHECKHI
                      (    forth6809.asm):01648         ;    Inputs:
                      (    forth6809.asm):01649         ;        none
                      (    forth6809.asm):01650         ;    Outputs:
                      (    forth6809.asm):01651         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01652         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01653         ; ------------------------------------------------------------
DC28 BDDC1F           (    forth6809.asm):01654         RTSCHECKHI: JSR   INFILL
DC2B 8130             (    forth6809.asm):01655                     CMPA  #INHIWATER
DC2D 250F             (    forth6809.asm):01656                     BLO   RTSCHIDONE
DC2F 7D0178           (    forth6809.asm):01657                     TST   RTSSTATE
DC32 260A             (    forth6809.asm):01658                     BNE   RTSCHIDONE        ; already high - nothing to do
DC34 86D5             (    forth6809.asm):01659                     LDA   #CR_RTSHI
DC36 B7C008           (    forth6809.asm):01660                     STA   ACIACR
DC39 8601             (    forth6809.asm):01661                     LDA   #1
DC3B B70178           (    forth6809.asm):01662                     STA   RTSSTATE
DC3E 39               (    forth6809.asm):01663         RTSCHIDONE: RTS
                      (    forth6809.asm):01664         ; ------------------------------------------------------------
                      (    forth6809.asm):01665         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01666         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01667         ; enables it only while output is pending.
                      (    forth6809.asm):01668         ; UPDATE_RTS
                      (    forth6809.asm):01669         ;    Inputs:
                      (    forth6809.asm):01670         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01671         ;    Outputs:
                      (    forth6809.asm):01672         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01673         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01674         ; ------------------------------------------------------------
DC3F                  (    forth6809.asm):01675         UPDATE_RTS:
DC3F 7D0178           (    forth6809.asm):01676                     TST   RTSSTATE
DC42 260D             (    forth6809.asm):01677                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01678         
DC44 7D017B           (    forth6809.asm):01679                     TST   OUTACTIVITY       ; Is active?
DC47 2704             (    forth6809.asm):01680                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01681         
                      (    forth6809.asm):01682                                             ; $B5/%1011_0101
DC49 86B5             (    forth6809.asm):01683                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DC4B 2009             (    forth6809.asm):01684                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01685         
DC4D                  (    forth6809.asm):01686         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DC4D 8695             (    forth6809.asm):01687                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DC4F 2005             (    forth6809.asm):01688                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01689         
DC51                  (    forth6809.asm):01690         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DC51 86D5             (    forth6809.asm):01691                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DC53 7F017B           (    forth6809.asm):01692                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DC56                  (    forth6809.asm):01693         WRITE_CR:
DC56 B7C008           (    forth6809.asm):01694                     STA   ACIACR
DC59 39               (    forth6809.asm):01695                     RTS
                      (    forth6809.asm):01696         ; ------------------------------------------------------------
                      (    forth6809.asm):01697         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01698         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01699         ; Called after a character is added to the ring.
                      (    forth6809.asm):01700         ; CHKHI
                      (    forth6809.asm):01701         ;    Inputs:
                      (    forth6809.asm):01702         ;        RegB = input ring fill level
                      (    forth6809.asm):01703         ;    Outputs:
                      (    forth6809.asm):01704         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01705         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01706         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01707         ; ------------------------------------------------------------
DC5A                  (    forth6809.asm):01708         CHKHI:
DC5A C130             (    forth6809.asm):01709                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DC5C 250D             (    forth6809.asm):01710                     BLO   CHKHIDONE         ; No! Do nothing.
DC5E 7D0178           (    forth6809.asm):01711                     TST   RTSSTATE
DC61 2608             (    forth6809.asm):01712                     BNE   CHKHIDONE         ; already high - nothing to do
DC63 86FF             (    forth6809.asm):01713                     LDA   #INREJECT         ; Yes! De-assert RTS.
DC65 B70178           (    forth6809.asm):01714                     STA   RTSSTATE
DC68 BDDC3F           (    forth6809.asm):01715                     JSR   UPDATE_RTS
DC6B 39               (    forth6809.asm):01716         CHKHIDONE:  RTS
                      (    forth6809.asm):01717         
                      (    forth6809.asm):01718         ; ------------------------------------------------------------
                      (    forth6809.asm):01719         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01720         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01721         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01722         ; CHKLO
                      (    forth6809.asm):01723         ;    Inputs:
                      (    forth6809.asm):01724         ;        RegB = input ring fill level
                      (    forth6809.asm):01725         ;    Outputs:
                      (    forth6809.asm):01726         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01727         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01728         ; ------------------------------------------------------------
DC6C                  (    forth6809.asm):01729         CHKLO:
DC6C C110             (    forth6809.asm):01730                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DC6E 240D             (    forth6809.asm):01731                     BHS   CHKLODONE         ; No! Do nothing.
DC70 7D0178           (    forth6809.asm):01732                     TST   RTSSTATE
DC73 2708             (    forth6809.asm):01733                     BEQ   CHKLODONE         ; already low - nothing to do
DC75 8600             (    forth6809.asm):01734                     LDA   #INACCEPT         ; Yes! Assert RTS.
DC77 B70178           (    forth6809.asm):01735                     STA   RTSSTATE
DC7A BDDC3F           (    forth6809.asm):01736                     JSR   UPDATE_RTS
DC7D 39               (    forth6809.asm):01737         CHKLODONE:  RTS
                      (    forth6809.asm):01738         ; ------------------------------------------------------------
                      (    forth6809.asm):01739         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01740         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01741         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01742         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01743         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01744         ;    Inputs:
                      (    forth6809.asm):01745         ;        none
                      (    forth6809.asm):01746         ;    Outputs:
                      (    forth6809.asm):01747         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01748         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01749         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01750         ; ------------------------------------------------------------
DC7E                  (    forth6809.asm):01751         FLUSHOUTBUFFER:
DC7E F6017A           (    forth6809.asm):01752                     LDB   OUTTAIL
DC81 F10179           (    forth6809.asm):01753                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DC84 2719             (    forth6809.asm):01754                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01755         
DC86 B6C008           (    forth6809.asm):01756                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DC89 8508             (    forth6809.asm):01757                     BITA  #SR_CTS
DC8B 2612             (    forth6809.asm):01758                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01759         
DC8D 8502             (    forth6809.asm):01760                     BITA  #SR_TDRE          ; Is transmit register empty?
DC8F 270E             (    forth6809.asm):01761                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01762                                             ; than spin-wait here.
                      (    forth6809.asm):01763         
DC91 8E01C0           (    forth6809.asm):01764                     LDX   #OUTBUF           ; The out buffer is occupied.
DC94 A685             (    forth6809.asm):01765                     LDA   B,X               ; Get the character from the out buffer.
DC96 B7C009           (    forth6809.asm):01766                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01767         
DC99 5C               (    forth6809.asm):01768                     INCB                    ; Update tail pointer to next character slot.
DC9A C43F             (    forth6809.asm):01769                     ANDB  #OUTBUFSZ-1
DC9C F7017A           (    forth6809.asm):01770                     STB   OUTTAIL
                      (    forth6809.asm):01771                                             ; One character sent - return rather than
                      (    forth6809.asm):01772                                             ; loop back for more (see header comment).
DC9F                  (    forth6809.asm):01773         FLUSHED:
DC9F 39               (    forth6809.asm):01774                     RTS
                      (    forth6809.asm):01775         ; ------------------------------------------------------------
                      (    forth6809.asm):01776         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01777         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01778         ; PUTCHAR
                      (    forth6809.asm):01779         ;    Inputs:
                      (    forth6809.asm):01780         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01781         ;    Outputs:
                      (    forth6809.asm):01782         ;        none
                      (    forth6809.asm):01783         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01784         ; ------------------------------------------------------------
DCA0                  (    forth6809.asm):01785         PUTCHAR:
DCA0 3411             (    forth6809.asm):01786                     PSHS  CC,X
DCA2 1A50             (    forth6809.asm):01787                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01788         
DCA4 F60179           (    forth6809.asm):01789                     LDB   OUTHEAD           ; Is buffer full?
DCA7 5C               (    forth6809.asm):01790                     INCB
DCA8 C43F             (    forth6809.asm):01791                     ANDB  #OUTBUFSZ-1
DCAA F1017A           (    forth6809.asm):01792                     CMPB  OUTTAIL
DCAD 273A             (    forth6809.asm):01793                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01794         
DCAF 8E01C0           (    forth6809.asm):01795                     LDX   #OUTBUF           ; Put character into character slot.
DCB2 F60179           (    forth6809.asm):01796                     LDB   OUTHEAD
DCB5 A785             (    forth6809.asm):01797                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01798         
DCB7 5C               (    forth6809.asm):01799                     INCB                    ; Update tail pointer to next character slot.
DCB8 C43F             (    forth6809.asm):01800                     ANDB  #OUTBUFSZ-1

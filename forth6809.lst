                      (    forth6809.asm):14798         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):14799         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):14800         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):14801         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):14802         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):14803         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):14804         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):14805         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):14806         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):14807         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):14808         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):14809         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):14810                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):14811                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):14812                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):14813                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):14814                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):14815                  FDB   ABORT
                      (    forth6809.asm):14816         
DEBE 04               (    forth6809.asm):14817         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):14818                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):14819                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):14820                  FDB   QUIT
                      (    forth6809.asm):14821         
                      (    forth6809.asm):14822         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):14823         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):14824         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):14825         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):14826         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):14827         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):14828         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):14829                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):14830                  FDB   H_QUIT
DECE E476             (    forth6809.asm):14831                  FDB   FIND
                      (    forth6809.asm):14832         

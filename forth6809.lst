                      (   unit_tests.asm):08237         ; unit test for 2CONSTANT. Compiles "100 200 2CONSTANT
                      (   unit_tests.asm):08238         ; TESTWD" into scratch (x1=100 stored at the lower address,
                      (   unit_tests.asm):08239         ; x2=200 at the higher, matching 2@/2!'s own convention),
                      (   unit_tests.asm):08240         ; then executes the result. Verifies it pushes both cells
                      (   unit_tests.asm):08241         ; correctly ordered (200 on top/popped first, 100 deeper -
                      (   unit_tests.asm):08242         ; matching 2@'s own documented behavior), not their own
                      (   unit_tests.asm):08243         ; address.
                      (   unit_tests.asm):08244         ; TST2CONST
                      (   unit_tests.asm):08245         ;    Inputs:
                      (   unit_tests.asm):08246         ;        none
                      (   unit_tests.asm):08247         ;    Outputs:
                      (   unit_tests.asm):08248         ;        prints "TST2CONST OK" or "TST2CONST FAIL" (TSTREPORT)
                      (   unit_tests.asm):08249         ;    Registers: U restored; all others changed.

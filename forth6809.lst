                      (    forth6809.asm):00330         
                      (    forth6809.asm):00331         ; ------------------------------------------------------------
                      (    forth6809.asm):00332         ; Optional word sets, to recover ROM when the board does not need
                      (    forth6809.asm):00333         ; them. Each switch removes both the dictionary headers and the code
                      (    forth6809.asm):00334         ; of its words; the headers and code are two contiguous blocks.
                      (    forth6809.asm):00335         ; STRINGSET: String word set: /STRING -TRAILING SEARCH BLANK SLITERAL
                      (    forth6809.asm):00336         ;            and the headers of CMOVE CMOVE> COMPARE (their code is
                      (    forth6809.asm):00337         ;            always kept because MOVE and ENVIRONMENT? use it).
                      (    forth6809.asm):00338         ; STRINGEXT: String extension: UNESCAPE REPLACES CLR-REPLACES
                      (    forth6809.asm):00339         ;            SUBSTITUTE. Set with lwasm -DSTRINGSET=0 -DSTRINGEXT=0.
                      (    forth6809.asm):00340         ; SNAME (xt to name, all wordlists) is not a string word; it is
                      (    forth6809.asm):00341         ; always kept for the disassembler/decompiler.
                      (    forth6809.asm):00342         ; DISASM:    Disassembler words DASM and DIS (about 1.2 KB of ROM). The
                      (    forth6809.asm):00343         ;            constants BASECODE and BASEDICT above depend on it. Set
                      (    forth6809.asm):00344         ;            with lwasm -DDISASM=0. The larger unit test groups do
                      (    forth6809.asm):00345         ;            not fit below the dictionary when DISASM is 1.
                      (    forth6809.asm):00346         ; The unit tests need both set to 1.
                      (    forth6809.asm):00347         ; ------------------------------------------------------------
                      (    forth6809.asm):00348                     IFNDEF STRINGSET
     0001             (    forth6809.asm):00349         STRINGSET   SET   1                 ; default if -D not passed
                      (    forth6809.asm):00350                     ENDC
                      (    forth6809.asm):00351                     IFNDEF STRINGEXT
     0001             (    forth6809.asm):00352         STRINGEXT   SET   1                 ; default if -D not passed
                      (    forth6809.asm):00353                     ENDC
                      (    forth6809.asm):00354         
                      (    forth6809.asm):00355                     IFNDEF UNITTESTS
C100                  (    forth6809.asm):00356         UNITTESTS   SET   0                 ; default if -D not passed
                      (    forth6809.asm):00357                     ; Default 0: unit tests excluded; -DUNITTESTS=1 includes them.
                      (    forth6809.asm):00358                     ; Original comment: shadow UNITTESTS.1.
                      (    forth6809.asm):00359                     ENDC
                      (    forth6809.asm):00360         
                      (    forth6809.asm):00361                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00362         TSTSELECTOR SET   2                 ; default if -D not passed
                      (    forth6809.asm):00363                     ENDC
                      (    forth6809.asm):00364         
                      (    forth6809.asm):00365                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):00366         
                      (    forth6809.asm):00367         ; ------------------------------------------------------------
                      (    forth6809.asm):00368         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00369         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00370         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00371         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00372         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00373         ; ------------------------------------------------------------
                      (    forth6809.asm):00374                     IFEQ  STRINGSET*STRINGEXT
                      (    forth6809.asm):00375                     ERROR "UNITTESTS=1 needs STRINGSET=1 and STRINGEXT=1"
                      (    forth6809.asm):00376                     ENDC
                      (    forth6809.asm):00377                     INCLUDE unit_tests.asm
                      (    forth6809.asm):00378         
                      (    forth6809.asm):00379                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):00380         
     C100             (    forth6809.asm):00381         TSTEND     EQU *                   ; Mark where tests end to size spare space.
                      (    forth6809.asm):00382         
C100                  (    forth6809.asm):00383         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00384                     FILL  $FF,BASEDICT-ROM

                      (    forth6809.asm):23135         ; ============================================================
                      (    forth6809.asm):23136         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):23137         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):23138         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):23139         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):23140         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):23141         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):23142         ; ============================================================
                      (    forth6809.asm):23143         ; ------------------------------------------------------------
                      (    forth6809.asm):23144         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):23145         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):23146         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):23147         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):23148         ; - no indirection, no value cell.
                      (    forth6809.asm):23149         ;
                      (    forth6809.asm):23150         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):23151         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):23152         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):23153         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):23154         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):23155         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):23156         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):23157         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):23158         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):23159         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):23160         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):23161         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):23162                    PSHU  D
FF3C 39               (    forth6809.asm):23163                    RTS
                      (    forth6809.asm):23164         
FF3D CC0000           (    forth6809.asm):23165         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):23166                    PSHU  D
FF42 39               (    forth6809.asm):23167                    RTS
                      (    forth6809.asm):23168         
                      (    forth6809.asm):23169         ; ------------------------------------------------------------
                      (    forth6809.asm):23170         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):23171         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):23172         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):23173         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):23174         ; ------------------------------------------------------------

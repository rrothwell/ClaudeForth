DD15 31               (    forth6809.asm):01973                  FCC   "1"
DD16 DD0B             (    forth6809.asm):01974                  FDB   H_FIND
DD18 FF70             (    forth6809.asm):01975                  FDB   ONEBODY
                      (    forth6809.asm):01976         
DD1A 02               (    forth6809.asm):01977         H_M1:    FCB   2

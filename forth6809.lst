                      (    forth6809.asm):02940         ; ============================================================
                      (    forth6809.asm):02941         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02942         ; ============================================================
                      (    forth6809.asm):02943         ; ------------------------------------------------------------
                      (    forth6809.asm):02944         ; INTERPRET  ( -- )
                      (    forth6809.asm):02945         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02946         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02947         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02948         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02949         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02950         ; ------------------------------------------------------------
E170                  (    forth6809.asm):02951         INTERPRET:
E170 CC0020           (    forth6809.asm):02952         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
E173 3606             (    forth6809.asm):02953                     PSHU  D                 ; char
E175 BDE1F0           (    forth6809.asm):02954                     JSR   WORDW
E178 AEC4             (    forth6809.asm):02955                     LDX   ,U
E17A A684             (    forth6809.asm):02956                     LDA   ,X
E17C 276F             (    forth6809.asm):02957                     BEQ   IDONE
                      (    forth6809.asm):02958         
E17E BDE262           (    forth6809.asm):02959                     JSR   FINDW
E181 3706             (    forth6809.asm):02960                     PULU  D
E183 5D               (    forth6809.asm):02961                     TSTB
E184 10270011         (    forth6809.asm):02962                     LBEQ  TRYNUM
                      (    forth6809.asm):02963         

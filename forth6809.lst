                      (    forth6809.asm):03198         ; Convert digits at NADDR into UDHI:UDLO, in BASE, until NCNT
                      (    forth6809.asm):03199         ; characters are used or a non-digit is reached.
                      (    forth6809.asm):03200         ; NUMLOOP
                      (    forth6809.asm):03201         ;    Inputs:
                      (    forth6809.asm):03202         ;        NADDR = address of the first character
                      (    forth6809.asm):03203         ;        NCNT = number of characters
                      (    forth6809.asm):03204         ;        UDHI:UDLO = initial value
                      (    forth6809.asm):03205         ;    Outputs:
                      (    forth6809.asm):03206         ;        UDHI:UDLO = accumulated value
                      (    forth6809.asm):03207         ;        NADDR, NCNT = first unconverted character and the count
                      (    forth6809.asm):03208         ;        remaining
                      (    forth6809.asm):03209         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03210         ; ------------------------------------------------------------

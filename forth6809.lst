                      (    forth6809.asm):15017                                      ; Answers PADMINSIZE (84) directly, per
                      (    forth6809.asm):15018                                      ; ANS's own /PAD meaning (3.3.3.6, "the
                      (    forth6809.asm):15019                                      ; size of the scratch area whose address
                      (    forth6809.asm):15020                                      ; is returned by PAD") - PAD's own region,
                      (    forth6809.asm):15021                                      ; growing upward from PAD itself, distinct
                      (    forth6809.asm):15022                                      ; from HOLDMINSIZE above (which answers
                      (    forth6809.asm):15023                                      ; for a different region entirely, the
                      (    forth6809.asm):15024                                      ; downward-growing pictured-numeric buffer
                      (    forth6809.asm):15025                                      ; in the CODEHERE-to-PAD gap). PADOFFSET
                      (    forth6809.asm):15026                                      ; happens to equal PADMINSIZE numerically
                      (    forth6809.asm):15027                                      ; in this implementation (PADOFFSET EQU
                      (    forth6809.asm):15028                                      ; PADMINSIZE), but /PAD is answered with
                      (    forth6809.asm):15029                                      ; the conceptually correct constant, not
                      (    forth6809.asm):15030                                      ; the coincidentally-equal one.
FD85 FDD200070000     (    forth6809.asm):15031                  FDB   EN9,EN9L,0    ; NEW: FLOORED - previously the one item
                      (    forth6809.asm):15032                                      ; in this area explicitly left open
                      (    forth6809.asm):15033                                      ; pending its own investigation (unlike
                      (    forth6809.asm):15034                                      ; WORDLISTS, this is a CORE query, not
                      (    forth6809.asm):15035                                      ; tied to an unimplemented optional word
                      (    forth6809.asm):15036                                      ; set, so "false by omission" wasn't the
                      (    forth6809.asm):15037                                      ; right default). Investigated by tracing
                      (    forth6809.asm):15038                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):15039                                      ; against this system's own SM/REM and
                      (    forth6809.asm):15040                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):15041                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):15042                                      ; dividend's own original sign) after
                      (    forth6809.asm):15043                                      ; dividing absolute values - exactly
                      (    forth6809.asm):15044                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):15045                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):15046                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):15047                                      ; adjustment step (correcting the
                      (    forth6809.asm):15048                                      ; quotient and remainder when the
                      (    forth6809.asm):15049                                      ; quotient would be negative with a
                      (    forth6809.asm):15050                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):15051                                      ; not have. This system's primary
                      (    forth6809.asm):15052                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):15053                                      ; symmetric division, not floored -
                      (    forth6809.asm):15054                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):15055                                      ; answer (recognized query, value false),
                      (    forth6809.asm):15056                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):15057                                      ; WORDLISTS correctly uses.
FD8B FDD9000800FF     (    forth6809.asm):15058                  FDB   EN10,EN10L,255  ; NEW: MAX-CHAR - maximum value of any

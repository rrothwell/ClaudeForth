                      (    forth6809.asm):17959                                   ; were chained on after it; before that,
                      (    forth6809.asm):17960                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):17961                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):17962                                   ; a placeholder, found and fixed several turns

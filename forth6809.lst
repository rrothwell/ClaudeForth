                      (    forth6809.asm):10241                       LDD  STATE
                      (    forth6809.asm):10242                       STD  TSTSTSAV
                      (    forth6809.asm):10243         
                      (    forth6809.asm):10244                       LDA  #3
                      (    forth6809.asm):10245                       STA  TSTFHDR
                      (    forth6809.asm):10246                       LDA  #'F'
                      (    forth6809.asm):10247                       STA  TSTFHDR+1
                      (    forth6809.asm):10248                       LDA  #'O'
                      (    forth6809.asm):10249                       STA  TSTFHDR+2
                      (    forth6809.asm):10250                       LDA  #'O'

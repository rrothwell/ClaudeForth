                      (   unit_tests.asm):03546         ; TSTUMSM2 - unit test for UMSLASHMOD, MAX-UINT/MAX-UINT boundary
                      (   unit_tests.asm):03547         ; case (ANS Annex F F.6.1.2370: "MAX-UINT MAX-UINT UM* MAX-UINT
                      (   unit_tests.asm):03548         ; UM/MOD -> 0 MAX-UINT"). Direct regression test for the UDIV32 bug
                      (   unit_tests.asm):03549         ; found from a hardware report on exactly this case - see UDIV32's
                      (   unit_tests.asm):03550         ; own header/comment (forth6809.asm) for the full root-cause
                      (   unit_tests.asm):03551         ; analysis: a restoring-division boundary bug where the 16-bit
                      (   unit_tests.asm):03552         ; DIVREM register silently lost a 17th overflow bit whenever the
                      (   unit_tests.asm):03553         ; divisor was large enough (DIVDEN >= $8001) for the doubled-
                      (   unit_tests.asm):03554         ; remainder-plus-next-bit candidate to exceed $FFFF before the
                      (   unit_tests.asm):03555         ; compare-and-subtract step - wrongly skipping a subtraction (and
                      (   unit_tests.asm):03556         ; its quotient bit) it should have taken. Only UM/MOD can actually
                      (   unit_tests.asm):03557         ; reach that condition: it alone passes an arbitrary UNSIGNED
                      (   unit_tests.asm):03558         ; 16-bit divisor (up to $FFFF) straight through to UDIV32, where
                      (   unit_tests.asm):03559         ; SM/REM, FM/MOD, and plain /, MOD, /MOD all derive UDIV32's
                      (   unit_tests.asm):03560         ; divisor from a SIGNED single-cell value (magnitude capped at
                      (   unit_tests.asm):03561         ; $8000, from MIN-INT) - just low enough that 2*($8000-1)+1 =
                      (   unit_tests.asm):03562         ; $FFFF still fits in 16 bits, so none of those words can ever
                      (   unit_tests.asm):03563         ; trigger this particular bug regardless of input. That's why this
                      (   unit_tests.asm):03564         ; one boundary case, through UM/MOD specifically, is the test that
                      (   unit_tests.asm):03565         ; actually exercises the fixed code path - a plain mid-range
                      (   unit_tests.asm):03566         ; UMSLASHMOD case (TSTUMSM, above) does not.
                      (   unit_tests.asm):03567         ;
                      (   unit_tests.asm):03568         ; Dividend: MAX-UINT*MAX-UINT = $FFFE0001 (confirmed via UMSTAR's
                      (   unit_tests.asm):03569         ; own ANS Annex F case, F.6.1.2360: "MAX-UINT MAX-UINT UM* -> 1
                      (   unit_tests.asm):03570         ; 1 INVERT", i.e. low cell 1, high cell MAX-UINT/$FFFF - same
                      (   unit_tests.asm):03571         ; double value, split differently in that test's own terms).
                      (   unit_tests.asm):03572         ; Divisor: MAX-UINT ($FFFF). Expected: remainder 0, quotient
                      (   unit_tests.asm):03573         ; MAX-UINT ($FFFF) - verified against the buggy/fixed UDIV32
                      (   unit_tests.asm):03574         ; algorithm directly in a Python simulation and a 200,000-case
                      (   unit_tests.asm):03575         ; random fuzz run before applying the fix (see the project's own
                      (   unit_tests.asm):03576         ; learnings notes), not just by hand-tracing.
                      (   unit_tests.asm):03577         ; ------------------------------------------------------------
C1F8                  (   unit_tests.asm):03578         TSTUMSM2:   STU   TSTU0
                      (   unit_tests.asm):03579         
                      (   unit_tests.asm):03580                     LDD   #TSTGUARD
                      (   unit_tests.asm):03581                     PSHU  D
                      (   unit_tests.asm):03582                     LDD   #$0001
                      (   unit_tests.asm):03583                     PSHU  D
                      (   unit_tests.asm):03584                     LDD   #$FFFE
                      (   unit_tests.asm):03585                     PSHU  D
                      (   unit_tests.asm):03586                     LDD   #$FFFF
                      (   unit_tests.asm):03587                     PSHU  D
                      (   unit_tests.asm):03588                     STU   TSTUB4
                      (   unit_tests.asm):03589         
                      (   unit_tests.asm):03590                     JSR   UMSLASHMOD
                      (   unit_tests.asm):03591         
                      (   unit_tests.asm):03592                     STU   TSTUAF
                      (   unit_tests.asm):03593         
                      (   unit_tests.asm):03594                     PULU  D
                      (   unit_tests.asm):03595                     CMPD  #$FFFF
                      (   unit_tests.asm):03596                     BNE   UM2FAIL
                      (   unit_tests.asm):03597                     PULU  D
                      (   unit_tests.asm):03598                     CMPD  #$0000
                      (   unit_tests.asm):03599                     BNE   UM2FAIL
                      (   unit_tests.asm):03600                     PULU  D
                      (   unit_tests.asm):03601                     CMPD  #TSTGUARD
                      (   unit_tests.asm):03602                     BNE   UM2FAIL
                      (   unit_tests.asm):03603         
                      (   unit_tests.asm):03604                     LDD   TSTUB4
                      (   unit_tests.asm):03605                     SUBD  TSTUAF
                      (   unit_tests.asm):03606                     CMPD  #-2
                      (   unit_tests.asm):03607                     BNE   UM2FAIL
                      (   unit_tests.asm):03608         

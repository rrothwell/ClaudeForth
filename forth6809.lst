                      (    forth6809.asm):07369         ; TSTUNLOOP - unit test for UNLOOP. A true no-op (bare RTS) per
                      (    forth6809.asm):07370         ; its own extensively-documented design history in the source -
                      (    forth6809.asm):07371         ; superseded by EXIT's own automatic frame-discarding, kept
                      (    forth6809.asm):07372         ; only for source compatibility. Not compile-time/immediate
                      (    forth6809.asm):07373         ; like the rest of this section - a plain runtime word, tested
                      (    forth6809.asm):07374         ; directly without the compile harness, same pattern as ALIGN's
                      (    forth6809.asm):07375         ; own test in section 3.6: pushes decoy values, calls UNLOOP,
                      (    forth6809.asm):07376         ; confirms the whole stack is genuinely undisturbed.
                      (    forth6809.asm):07377         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07378         TSTUNLOOP: STU  TSTU0
                      (    forth6809.asm):07379         
                      (    forth6809.asm):07380                    LDD  #TSTGUARD
                      (    forth6809.asm):07381                    PSHU D
                      (    forth6809.asm):07382                    LDD  #TSTVAL1
                      (    forth6809.asm):07383                    PSHU D
                      (    forth6809.asm):07384                    LDD  #TSTVAL2
                      (    forth6809.asm):07385                    PSHU D
                      (    forth6809.asm):07386                    STU  TSTUB4
                      (    forth6809.asm):07387         
                      (    forth6809.asm):07388                    JSR  UNLOOP
                      (    forth6809.asm):07389         
                      (    forth6809.asm):07390                    STU  TSTUAF
                      (    forth6809.asm):07391         
                      (    forth6809.asm):07392                    PULU D
                      (    forth6809.asm):07393                    CMPD #TSTVAL2
                      (    forth6809.asm):07394                    BNE  UOFAIL
                      (    forth6809.asm):07395                    PULU D
                      (    forth6809.asm):07396                    CMPD #TSTVAL1
                      (    forth6809.asm):07397                    BNE  UOFAIL
                      (    forth6809.asm):07398                    PULU D
                      (    forth6809.asm):07399                    CMPD #TSTGUARD
                      (    forth6809.asm):07400                    BNE  UOFAIL
                      (    forth6809.asm):07401         
                      (    forth6809.asm):07402                    LDD  TSTUB4
                      (    forth6809.asm):07403                    SUBD TSTUAF
                      (    forth6809.asm):07404                    CMPD #0
                      (    forth6809.asm):07405                    BNE  UOFAIL
                      (    forth6809.asm):07406         
                      (    forth6809.asm):07407                    LDD  #TRUEV
                      (    forth6809.asm):07408                    BRA  UODONE
C100                  (    forth6809.asm):07409         UOFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):07410         UODONE:    LDX  #TSTUNLOOPNAME
                      (    forth6809.asm):07411                    PSHU X
                      (    forth6809.asm):07412                    PSHU D

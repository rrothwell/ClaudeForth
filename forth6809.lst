                      (    forth6809.asm):08283         ; ------------------------------------------------------------
                      (    forth6809.asm):08284         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):08285         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):08286         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):08287         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):08288         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):08289         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):08290         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):08291         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):08292         ; available the skip ends.
                      (    forth6809.asm):08293         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):08294         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):08295         ; ------------------------------------------------------------
FEDE 3706             (    forth6809.asm):08296         BRIFW:      PULU  D
FEE0 10830000         (    forth6809.asm):08297                     CMPD  #0
FEE4 266D             (    forth6809.asm):08298                     BNE   BRTHENW           ; true: nothing to skip
FEE6 CC0001           (    forth6809.asm):08299         BRELSEW:    LDD   #1
FEE9 3406             (    forth6809.asm):08300                     PSHS  D                 ; level
FEEB BDF613           (    forth6809.asm):08301         BRNEXT:     JSR   PARSENAMEW
FEEE 3706             (    forth6809.asm):08302                     PULU  D                 ; length
FEF0 3710             (    forth6809.asm):08303                     PULU  X                 ; address
FEF2 10830000         (    forth6809.asm):08304                     CMPD  #0
FEF6 274E             (    forth6809.asm):08305                     BEQ   BRREFILL
FEF8 10830004         (    forth6809.asm):08306                     CMPD  #4
FEFC 2734             (    forth6809.asm):08307                     BEQ   BR4
FEFE 10830006         (    forth6809.asm):08308                     CMPD  #6
FF02 26E7             (    forth6809.asm):08309                     BNE   BRNEXT
FF04 C606             (    forth6809.asm):08310                     LDB   #6
FF06 108EFF62         (    forth6809.asm):08311                     LDY   #BRSELSE
FF0A 3410             (    forth6809.asm):08312                     PSHS  X
FF0C BDFF54           (    forth6809.asm):08313                     JSR   BRCMP
FF0F 3510             (    forth6809.asm):08314                     PULS  X
FF11 2609             (    forth6809.asm):08315                     BNE   BR6B
FF13 ECE4             (    forth6809.asm):08316                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FF15 830001           (    forth6809.asm):08317                     SUBD  #1
FF18 2737             (    forth6809.asm):08318                     BEQ   BRDONE
FF1A 20CF             (    forth6809.asm):08319                     BRA   BRNEXT
FF1C C606             (    forth6809.asm):08320         BR6B:       LDB   #6
FF1E 108EFF68         (    forth6809.asm):08321                     LDY   #BRSTHEN
FF22 BDFF54           (    forth6809.asm):08322                     JSR   BRCMP
FF25 26C4             (    forth6809.asm):08323                     BNE   BRNEXT
FF27 ECE4             (    forth6809.asm):08324                     LDD   ,S                ; [THEN]: one level less
FF29 830001           (    forth6809.asm):08325                     SUBD  #1
FF2C EDE4             (    forth6809.asm):08326                     STD   ,S
FF2E 2721             (    forth6809.asm):08327                     BEQ   BRDONE
FF30 20B9             (    forth6809.asm):08328                     BRA   BRNEXT
FF32 C604             (    forth6809.asm):08329         BR4:        LDB   #4
FF34 108EFF5E         (    forth6809.asm):08330                     LDY   #BRSIF
FF38 BDFF54           (    forth6809.asm):08331                     JSR   BRCMP
FF3B 26AE             (    forth6809.asm):08332                     BNE   BRNEXT
FF3D ECE4             (    forth6809.asm):08333                     LDD   ,S                ; [IF]: one level more
FF3F C30001           (    forth6809.asm):08334                     ADDD  #1
FF42 EDE4             (    forth6809.asm):08335                     STD   ,S
FF44 20A5             (    forth6809.asm):08336                     BRA   BRNEXT
FF46 BDFBF8           (    forth6809.asm):08337         BRREFILL:   JSR   REFILLW
FF49 3706             (    forth6809.asm):08338                     PULU  D
FF4B 10830000         (    forth6809.asm):08339                     CMPD  #0
FF4F 269A             (    forth6809.asm):08340                     BNE   BRNEXT
FF51 3262             (    forth6809.asm):08341         BRDONE:     LEAS  2,S
FF53 39               (    forth6809.asm):08342         BRTHENW:    RTS
                      (    forth6809.asm):08343         
                      (    forth6809.asm):08344         ; Compare B characters at X with the pattern at Y. Case matters, as it
                      (    forth6809.asm):08345         ; does for every name in this system. Z is set if equal.
FF54 A680             (    forth6809.asm):08346         BRCMP:      LDA   ,X+
FF56 A1A0             (    forth6809.asm):08347                     CMPA  ,Y+
FF58 2603             (    forth6809.asm):08348                     BNE   BRCX
FF5A 5A               (    forth6809.asm):08349                     DECB
FF5B 26F7             (    forth6809.asm):08350                     BNE   BRCMP
FF5D 39               (    forth6809.asm):08351         BRCX:       RTS
                      (    forth6809.asm):08352         
FF5E 5B49465D         (    forth6809.asm):08353         BRSIF:      FCC   "[IF]"
FF62 5B454C53455D     (    forth6809.asm):08354         BRSELSE:    FCC   "[ELSE]"
FF68 5B5448454E5D     (    forth6809.asm):08355         BRSTHEN:    FCC   "[THEN]"
                      (    forth6809.asm):08356         
                      (    forth6809.asm):08357         ; ============================================================
                      (    forth6809.asm):08358         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):08359         ; ============================================================
                      (    forth6809.asm):08360         ; ------------------------------------------------------------
                      (    forth6809.asm):08361         ; TRUE  ( -- flag )
                      (    forth6809.asm):08362         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08363         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08364         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08365         ; ------------------------------------------------------------
FF6E CCFFFF           (    forth6809.asm):08366         TRUEW:      LDD   #$FFFF
FF71 3606             (    forth6809.asm):08367                     PSHU  D
FF73 39               (    forth6809.asm):08368                     RTS
                      (    forth6809.asm):08369         
                      (    forth6809.asm):08370         ; ------------------------------------------------------------
                      (    forth6809.asm):08371         ; FALSE  ( -- flag )
                      (    forth6809.asm):08372         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08373         ; ------------------------------------------------------------
FF74 CC0000           (    forth6809.asm):08374         FALSEW:     LDD   #$0000
FF77 3606             (    forth6809.asm):08375                     PSHU  D
FF79 39               (    forth6809.asm):08376                     RTS
                      (    forth6809.asm):08377         
                      (    forth6809.asm):08378         ; ------------------------------------------------------------
                      (    forth6809.asm):08379         ; 1  ( -- 1 )
                      (    forth6809.asm):08380         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08381         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08382         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):08383         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):08384         ; ------------------------------------------------------------
FF7A CC0001           (    forth6809.asm):08385         POSONEW:    LDD   #1
FF7D 3606             (    forth6809.asm):08386                     PSHU  D
FF7F 39               (    forth6809.asm):08387                     RTS
                      (    forth6809.asm):08388         
                      (    forth6809.asm):08389         ; ------------------------------------------------------------
                      (    forth6809.asm):08390         ; -1  ( -- -1 )
                      (    forth6809.asm):08391         ; Push the constant -1.
                      (    forth6809.asm):08392         ; ------------------------------------------------------------
FF80 CCFFFF           (    forth6809.asm):08393         NEGONEW:    LDD   #-1
FF83 3606             (    forth6809.asm):08394                     PSHU  D
FF85 39               (    forth6809.asm):08395                     RTS
                      (    forth6809.asm):08396         
                      (    forth6809.asm):08397         ; ------------------------------------------------------------
                      (    forth6809.asm):08398         ; 2  ( -- 2 )
                      (    forth6809.asm):08399         ; Push the constant 2.
                      (    forth6809.asm):08400         ; ------------------------------------------------------------

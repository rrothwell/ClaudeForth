                      (    forth6809.asm):03406         ; ============================================================
                      (    forth6809.asm):03407         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03408         ; ============================================================
                      (    forth6809.asm):03409                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03410         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03411         
                      (    forth6809.asm):03412         ; ------------------------------------------------------------
                      (    forth6809.asm):03413         ; KEY  ( -- char )
                      (    forth6809.asm):03414         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03415         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03416         ; ------------------------------------------------------------
E3C2                  (    forth6809.asm):03417         KEYW:
                      (    forth6809.asm):03418         
                      (    forth6809.asm):03419                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03420                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03421         
                      (    forth6809.asm):03422                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):03423                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03424                                             ; by transmitting all chars.
                      (    forth6809.asm):03425         
E3C2                  (    forth6809.asm):03426         TRY_READ:
                      (    forth6809.asm):03427                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03428                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03429                                             ; while still transmitting!
                      (    forth6809.asm):03430         
                      (    forth6809.asm):03431                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03432                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03433                     PSHU  D                 ; char
                      (    forth6809.asm):03434         
                      (    forth6809.asm):03435                     RTS
                      (    forth6809.asm):03436         
                      (    forth6809.asm):03437         ; ------------------------------------------------------------
                      (    forth6809.asm):03438         ; KEY?  ( -- flag )
                      (    forth6809.asm):03439         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03440         ; ------------------------------------------------------------
E3C2                  (    forth6809.asm):03441         KEYQW:
                      (    forth6809.asm):03442                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03443         
                      (    forth6809.asm):03444                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03445                     CMPA  INTAIL
                      (    forth6809.asm):03446         
                      (    forth6809.asm):03447                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03448         
                      (    forth6809.asm):03449                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03450         
                      (    forth6809.asm):03451                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03452                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03453         
                      (    forth6809.asm):03454                     RTS
                      (    forth6809.asm):03455         
E3C2                  (    forth6809.asm):03456         KQTRUE:
                      (    forth6809.asm):03457                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03458                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03459                     RTS
                      (    forth6809.asm):03460         
                      (    forth6809.asm):03461         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03462         
                      (    forth6809.asm):03463         ; ------------------------------------------------------------
                      (    forth6809.asm):03464         ; EMIT  ( char -- )
                      (    forth6809.asm):03465         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03466         ; discarded if the ring is full.
                      (    forth6809.asm):03467         ; ------------------------------------------------------------
E3C2                  (    forth6809.asm):03468         EMITW:
                      (    forth6809.asm):03469                     PULU  D                 ; char
                      (    forth6809.asm):03470                     TFR   B,A
                      (    forth6809.asm):03471                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03472                     RTS
                      (    forth6809.asm):03473         
                      (    forth6809.asm):03474                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03475         ; ------------------------------------------------------------
                      (    forth6809.asm):03476         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03477         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03478         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03479         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03480         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03481         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03482         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03483         ; follow.
                      (    forth6809.asm):03484         ; ------------------------------------------------------------
E3C2                  (    forth6809.asm):03485         KEYW:
E3C2 B6C008           (    forth6809.asm):03486                     LDA   ACIASR
E3C5 8501             (    forth6809.asm):03487                     BITA  #SR_RDRF
E3C7 2705             (    forth6809.asm):03488                     BEQ   KWAIT
E3C9 7C017F           (    forth6809.asm):03489                     INC   POLLREADYCNT      ; character was already queued when we
E3CC 2007             (    forth6809.asm):03490                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E3CE                  (    forth6809.asm):03491         KWAIT:
E3CE B6C008           (    forth6809.asm):03492         KSPIN:      LDA   ACIASR
E3D1 8501             (    forth6809.asm):03493                     BITA  #SR_RDRF
E3D3 27F9             (    forth6809.asm):03494                     BEQ   KSPIN
E3D5                  (    forth6809.asm):03495         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03496                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03497                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03498                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03499                                             ; RDRF and the latched error bits together
E3D5 8570             (    forth6809.asm):03500                     BITA  #SR_FE+SR_OVRN+SR_PE
E3D7 2715             (    forth6809.asm):03501                     BEQ   KGETCH
E3D9 8510             (    forth6809.asm):03502                     BITA  #SR_FE
E3DB 2703             (    forth6809.asm):03503                     BEQ   KXFE
E3DD 7C017C           (    forth6809.asm):03504                     INC   FECOUNT
E3E0 8520             (    forth6809.asm):03505         KXFE:       BITA  #SR_OVRN
E3E2 2703             (    forth6809.asm):03506                     BEQ   KXOVRN
E3E4 7C017D           (    forth6809.asm):03507                     INC   OVRNCOUNT
E3E7 8540             (    forth6809.asm):03508         KXOVRN:     BITA  #SR_PE
E3E9 2703             (    forth6809.asm):03509                     BEQ   KGETCH
E3EB 7C017E           (    forth6809.asm):03510                     INC   PECOUNT
E3EE B6C009           (    forth6809.asm):03511         KGETCH:     LDA   ACIADR
E3F1 1F89             (    forth6809.asm):03512                     TFR   A,B
E3F3 4F               (    forth6809.asm):03513                     CLRA
E3F4 3606             (    forth6809.asm):03514                     PSHU  D                 ; char
E3F6 39               (    forth6809.asm):03515                     RTS
                      (    forth6809.asm):03516         
                      (    forth6809.asm):03517         ; ------------------------------------------------------------
                      (    forth6809.asm):03518         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03519         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03520         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03521         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03522         ;    Inputs:
                      (    forth6809.asm):03523         ;        none
                      (    forth6809.asm):03524         ;    Outputs:
                      (    forth6809.asm):03525         ;        XON or XOFF transmitted
                      (    forth6809.asm):03526         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03527         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03528         ; ------------------------------------------------------------
E3F7 8613             (    forth6809.asm):03529         PUTXOFF:    LDA   #XOFFCH
E3F9 2002             (    forth6809.asm):03530                     BRA   PUTXCH
E3FB 8611             (    forth6809.asm):03531         PUTXON:     LDA   #XONCH
E3FD 3402             (    forth6809.asm):03532         PUTXCH:     PSHS  A
E3FF F6C008           (    forth6809.asm):03533         PXWT:       LDB   ACIASR
E402 C502             (    forth6809.asm):03534                     BITB  #SR_TDRE
E404 27F9             (    forth6809.asm):03535                     BEQ   PXWT
E406 3502             (    forth6809.asm):03536                     PULS  A
E408 B7C009           (    forth6809.asm):03537                     STA   ACIADR
E40B 39               (    forth6809.asm):03538                     RTS
                      (    forth6809.asm):03539         
                      (    forth6809.asm):03540         ; ------------------------------------------------------------
                      (    forth6809.asm):03541         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03542         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03543         ; ------------------------------------------------------------
E40C B6C008           (    forth6809.asm):03544         KEYQW:      LDA   ACIASR
E40F 8501             (    forth6809.asm):03545                     BITA  #SR_RDRF
E411 2706             (    forth6809.asm):03546                     BEQ   KQFALSE
E413 CCFFFF           (    forth6809.asm):03547                     LDD   #TRUEV
E416 3606             (    forth6809.asm):03548                     PSHU  D                 ; flag = true
E418 39               (    forth6809.asm):03549                     RTS
E419 CC0000           (    forth6809.asm):03550         KQFALSE:    LDD   #FALSEV
E41C 3606             (    forth6809.asm):03551                     PSHU  D                 ; flag = false
E41E 39               (    forth6809.asm):03552                     RTS
                      (    forth6809.asm):03553         
                      (    forth6809.asm):03554         ; ------------------------------------------------------------
                      (    forth6809.asm):03555         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03556         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03557         ; ------------------------------------------------------------
E41F 3706             (    forth6809.asm):03558         EMITW:      PULU  D                 ; char
E421 D73C             (    forth6809.asm):03559                     STB   EMITCH
E423 B6C008           (    forth6809.asm):03560         EMITWT:     LDA   ACIASR
E426 8502             (    forth6809.asm):03561                     BITA  #SR_TDRE
E428 27F9             (    forth6809.asm):03562                     BEQ   EMITWT
E42A 963C             (    forth6809.asm):03563                     LDA   EMITCH
E42C B7C009           (    forth6809.asm):03564                     STA   ACIADR
E42F 39               (    forth6809.asm):03565                     RTS
                      (    forth6809.asm):03566         
                      (    forth6809.asm):03567                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03568         
                      (    forth6809.asm):03569         ; ------------------------------------------------------------
                      (    forth6809.asm):03570         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03571         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03572         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03573         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03574         ; ------------------------------------------------------------
E430 3706             (    forth6809.asm):03575         ACCEPTW:    PULU  D                 ; +n1
E432 DD35             (    forth6809.asm):03576                     STD   AMAX
E434 3706             (    forth6809.asm):03577                     PULU  D                 ; c-addr
E436 DD37             (    forth6809.asm):03578                     STD   ABUFP
E438 CC0000           (    forth6809.asm):03579                     LDD   #0
E43B DD39             (    forth6809.asm):03580                     STD   ACNT
                      (    forth6809.asm):03581         
                      (    forth6809.asm):03582                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03583                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03584                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03585                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03586                                             ; stream this line's characters
E43D BDE3FB           (    forth6809.asm):03587                     JSR   PUTXON
                      (    forth6809.asm):03588                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03589         
E440 BDE3C2           (    forth6809.asm):03590         ALOOP:      JSR   KEYW
E443 3706             (    forth6809.asm):03591                     PULU  D
E445 D73B             (    forth6809.asm):03592                     STB   ACH
                      (    forth6809.asm):03593         
E447 C10D             (    forth6809.asm):03594                     CMPB  #13
E449 274F             (    forth6809.asm):03595                     BEQ   ADONE
E44B C10A             (    forth6809.asm):03596                     CMPB  #10
E44D 27F1             (    forth6809.asm):03597                     BEQ   ALOOP
E44F C108             (    forth6809.asm):03598                     CMPB  #8
E451 2724             (    forth6809.asm):03599                     BEQ   ABKSP
E453 C17F             (    forth6809.asm):03600                     CMPB  #127
E455 2720             (    forth6809.asm):03601                     BEQ   ABKSP
                      (    forth6809.asm):03602         
E457 DC39             (    forth6809.asm):03603                     LDD   ACNT
E459 109335           (    forth6809.asm):03604                     CMPD  AMAX
E45C 27E2             (    forth6809.asm):03605                     BEQ   ALOOP
                      (    forth6809.asm):03606         
E45E 9E37             (    forth6809.asm):03607                     LDX   ABUFP
E460 308B             (    forth6809.asm):03608                     LEAX  D,X
E462 963B             (    forth6809.asm):03609                     LDA   ACH
E464 A784             (    forth6809.asm):03610                     STA   ,X
E466 DC39             (    forth6809.asm):03611                     LDD   ACNT
E468 C30001           (    forth6809.asm):03612                     ADDD  #1
E46B DD39             (    forth6809.asm):03613                     STD   ACNT
                      (    forth6809.asm):03614         
E46D 4F               (    forth6809.asm):03615                     CLRA
E46E D63B             (    forth6809.asm):03616                     LDB   ACH
E470 3606             (    forth6809.asm):03617                     PSHU  D
E472 BDE41F           (    forth6809.asm):03618                     JSR   EMITW
E475 20C9             (    forth6809.asm):03619                     BRA   ALOOP
                      (    forth6809.asm):03620         
E477 DC39             (    forth6809.asm):03621         ABKSP:      LDD   ACNT
E479 27C5             (    forth6809.asm):03622                     BEQ   ALOOP
E47B 830001           (    forth6809.asm):03623                     SUBD  #1
E47E DD39             (    forth6809.asm):03624                     STD   ACNT
E480 CC0008           (    forth6809.asm):03625                     LDD   #8
E483 3606             (    forth6809.asm):03626                     PSHU  D
E485 BDE41F           (    forth6809.asm):03627                     JSR   EMITW
E488 CC0020           (    forth6809.asm):03628                     LDD   #32
E48B 3606             (    forth6809.asm):03629                     PSHU  D
E48D BDE41F           (    forth6809.asm):03630                     JSR   EMITW
E490 CC0008           (    forth6809.asm):03631                     LDD   #8
E493 3606             (    forth6809.asm):03632                     PSHU  D
E495 BDE41F           (    forth6809.asm):03633                     JSR   EMITW
E498 20A6             (    forth6809.asm):03634                     BRA   ALOOP
                      (    forth6809.asm):03635         
E49A                  (    forth6809.asm):03636         ADONE:
                      (    forth6809.asm):03637                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03638                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03639                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03640                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03641                                             ; with KEY never polled at all
E49A BDE3F7           (    forth6809.asm):03642                     JSR   PUTXOFF
                      (    forth6809.asm):03643                     ENDC                    ; <<<<<<<<<<
E49D DC39             (    forth6809.asm):03644                     LDD   ACNT
E49F 3606             (    forth6809.asm):03645                     PSHU  D                 ; +n2
E4A1 39               (    forth6809.asm):03646                     RTS
                      (    forth6809.asm):03647         
                      (    forth6809.asm):03648         ; ------------------------------------------------------------
                      (    forth6809.asm):03649         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03650         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03651         ; ------------------------------------------------------------
E4A2 BDE430           (    forth6809.asm):03652         EXPECTW:    JSR   ACCEPTW
E4A5 3706             (    forth6809.asm):03653                     PULU  D
E4A7 DDE1             (    forth6809.asm):03654                     STD   SPAN
E4A9 39               (    forth6809.asm):03655                     RTS
                      (    forth6809.asm):03656         
                      (    forth6809.asm):03657         ; ------------------------------------------------------------
                      (    forth6809.asm):03658         ; QUERY  ( -- )
                      (    forth6809.asm):03659         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03660         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03661         ; to 0 and >IN to 0.
                      (    forth6809.asm):03662         ; ------------------------------------------------------------
E4AA 8E0106           (    forth6809.asm):03663         QUERYW:     LDX   #TIBBUF
E4AD 3610             (    forth6809.asm):03664                     PSHU  X
E4AF CC0050           (    forth6809.asm):03665                     LDD   #TIBBUFL
E4B2 3606             (    forth6809.asm):03666                     PSHU  D
E4B4 BDE430           (    forth6809.asm):03667                     JSR   ACCEPTW
E4B7 3706             (    forth6809.asm):03668                     PULU  D
E4B9 DD12             (    forth6809.asm):03669                     STD   NTIB
E4BB DDDD             (    forth6809.asm):03670                     STD   SRCLEN
E4BD CC0106           (    forth6809.asm):03671                     LDD   #TIBBUF
E4C0 DDDB             (    forth6809.asm):03672                     STD   SRCADDR
E4C2 CC0000           (    forth6809.asm):03673                     LDD   #0
E4C5 DDDF             (    forth6809.asm):03674                     STD   SRCID
E4C7 DD10             (    forth6809.asm):03675                     STD   TOIN
E4C9 39               (    forth6809.asm):03676                     RTS
                      (    forth6809.asm):03677         
                      (    forth6809.asm):03678         ; ============================================================
                      (    forth6809.asm):03679         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03680         ; ============================================================
                      (    forth6809.asm):03681         ; ------------------------------------------------------------
                      (    forth6809.asm):03682         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03683         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03684         ; one expected.
                      (    forth6809.asm):03685         ; CFERR
                      (    forth6809.asm):03686         ;    Inputs:
                      (    forth6809.asm):03687         ;        none
                      (    forth6809.asm):03688         ;    Outputs:
                      (    forth6809.asm):03689         ;        does not return (THROW -22)
                      (    forth6809.asm):03690         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03691         ; ------------------------------------------------------------
E4CA CCFFEA           (    forth6809.asm):03692         CFERR:      LDD   #-22
E4CD 3606             (    forth6809.asm):03693                     PSHU  D                 ; -22
E4CF BDE4FF           (    forth6809.asm):03694                     JSR   THROWW
E4D2 39               (    forth6809.asm):03695                     RTS
                      (    forth6809.asm):03696         
                      (    forth6809.asm):03697         ; ------------------------------------------------------------
                      (    forth6809.asm):03698         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03699         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03700         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03701         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03702         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03703         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03704         ; ------------------------------------------------------------
E4D3 3710             (    forth6809.asm):03705         CATCHW:     PULU  X                 ; xt
E4D5 DC0C             (    forth6809.asm):03706                     LDD   HANDLER
E4D7 3406             (    forth6809.asm):03707                     PSHS  D
E4D9 3440             (    forth6809.asm):03708                     PSHS  U
                      (    forth6809.asm):03709                     ; Save the input source specification.
                      (    forth6809.asm):03710                     ; See bugfix: CATCHW.1
E4DB DCDB             (    forth6809.asm):03711                     LDD   SRCADDR
E4DD 3406             (    forth6809.asm):03712                     PSHS  D
E4DF DCDD             (    forth6809.asm):03713                     LDD   SRCLEN
E4E1 3406             (    forth6809.asm):03714                     PSHS  D
E4E3 DCDF             (    forth6809.asm):03715                     LDD   SRCID
E4E5 3406             (    forth6809.asm):03716                     PSHS  D
E4E7 DC10             (    forth6809.asm):03717                     LDD   TOIN
E4E9 3406             (    forth6809.asm):03718                     PSHS  D
E4EB 1F40             (    forth6809.asm):03719                     TFR   S,D
E4ED DD0C             (    forth6809.asm):03720                     STD   HANDLER
                      (    forth6809.asm):03721         
E4EF AD84             (    forth6809.asm):03722                     JSR   ,X
                      (    forth6809.asm):03723         
E4F1 3268             (    forth6809.asm):03724                     LEAS  8,S               ; drop saved input source
E4F3 3262             (    forth6809.asm):03725                     LEAS  2,S               ; saved U
E4F5 3506             (    forth6809.asm):03726                     PULS  D
E4F7 DD0C             (    forth6809.asm):03727                     STD   HANDLER
E4F9 CC0000           (    forth6809.asm):03728                     LDD   #0
E4FC 3606             (    forth6809.asm):03729                     PSHU  D                 ; 0 = no exception
E4FE 39               (    forth6809.asm):03730                     RTS
                      (    forth6809.asm):03731         
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
                      (    forth6809.asm):03733         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03734         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03735         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03736         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03737         ; ------------------------------------------------------------
E4FF 3706             (    forth6809.asm):03738         THROWW:     PULU  D                 ; n
E501 10830000         (    forth6809.asm):03739                     CMPD  #0
E505 2725             (    forth6809.asm):03740                     BEQ   THDONE
                      (    forth6809.asm):03741         
E507 DD0E             (    forth6809.asm):03742                     STD   THROWN
E509 9E0C             (    forth6809.asm):03743                     LDX   HANDLER
E50B 2720             (    forth6809.asm):03744                     BEQ   THUNCAU
                      (    forth6809.asm):03745         
E50D 1F14             (    forth6809.asm):03746                     TFR   X,S
E50F 3506             (    forth6809.asm):03747                     PULS  D                 ; restore input source saved by CATCH
E511 DD10             (    forth6809.asm):03748                     STD   TOIN
E513 3506             (    forth6809.asm):03749                     PULS  D
E515 DDDF             (    forth6809.asm):03750                     STD   SRCID
E517 3506             (    forth6809.asm):03751                     PULS  D
E519 DDDD             (    forth6809.asm):03752                     STD   SRCLEN
E51B 3506             (    forth6809.asm):03753                     PULS  D
E51D DDDB             (    forth6809.asm):03754                     STD   SRCADDR
E51F 3506             (    forth6809.asm):03755                     PULS  D
E521 1F03             (    forth6809.asm):03756                     TFR   D,U
E523 3506             (    forth6809.asm):03757                     PULS  D
E525 DD0C             (    forth6809.asm):03758                     STD   HANDLER
                      (    forth6809.asm):03759         
E527 DC0E             (    forth6809.asm):03760                     LDD   THROWN
E529 3606             (    forth6809.asm):03761                     PSHU  D
E52B 39               (    forth6809.asm):03762                     RTS
E52C 39               (    forth6809.asm):03763         THDONE:     RTS
                      (    forth6809.asm):03764         
                      (    forth6809.asm):03765                     ; No CATCH is active: leave n on the stack and ABORT.
E52D DC0E             (    forth6809.asm):03766         THUNCAU:    LDD   THROWN
E52F 3606             (    forth6809.asm):03767                     PSHU  D
E531 7EDD3F           (    forth6809.asm):03768                     JMP   ABORT
                      (    forth6809.asm):03769         
                      (    forth6809.asm):03770         ; ============================================================
                      (    forth6809.asm):03771         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03772         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03773         ; ============================================================
                      (    forth6809.asm):03774         ; ------------------------------------------------------------
                      (    forth6809.asm):03775         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03776         ; location.
                      (    forth6809.asm):03777         ; PATCH   ( target location -- )
                      (    forth6809.asm):03778         ;    Inputs:
                      (    forth6809.asm):03779         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03780         ;    Outputs:
                      (    forth6809.asm):03781         ;        the cell at location holds target - location
                      (    forth6809.asm):03782         ;    Registers: RegD and RegX changed; PFIELD and PTARGET used as
                      (    forth6809.asm):03783         ;        scratch.
                      (    forth6809.asm):03784         ; ------------------------------------------------------------
E534 3706             (    forth6809.asm):03785         PATCH:      PULU  D
E536 DD44             (    forth6809.asm):03786                     STD   PFIELD            ; location
E538 3706             (    forth6809.asm):03787                     PULU  D
E53A DD42             (    forth6809.asm):03788                     STD   PTARGET           ; target
E53C DC42             (    forth6809.asm):03789                     LDD   PTARGET
E53E 9344             (    forth6809.asm):03790                     SUBD  PFIELD
E540 9E44             (    forth6809.asm):03791                     LDX   PFIELD
E542 ED84             (    forth6809.asm):03792                     STD   ,X
E544 39               (    forth6809.asm):03793                     RTS
                      (    forth6809.asm):03794         
                      (    forth6809.asm):03795         ; ------------------------------------------------------------
                      (    forth6809.asm):03796         ; IF  ( C: -- orig )
                      (    forth6809.asm):03797         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03798         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03799         ; ------------------------------------------------------------
E545 CCDDE5           (    forth6809.asm):03800         IFW:        LDD   #ZBRANCH
E548 3606             (    forth6809.asm):03801                     PSHU  D
E54A BDE97A           (    forth6809.asm):03802                     JSR   CCALL
E54D CC0000           (    forth6809.asm):03803                     LDD   #0
E550 3606             (    forth6809.asm):03804                     PSHU  D
E552 BDDE78           (    forth6809.asm):03805                     JSR   CODECOMMA
E555 DC08             (    forth6809.asm):03806                     LDD   CODEHERE
E557 830002           (    forth6809.asm):03807                     SUBD  #2
E55A 3606             (    forth6809.asm):03808                     PSHU  D                 ; orig
E55C CC0001           (    forth6809.asm):03809                     LDD   #TAGFWD
E55F 3606             (    forth6809.asm):03810                     PSHU  D
E561 39               (    forth6809.asm):03811                     RTS
                      (    forth6809.asm):03812         
                      (    forth6809.asm):03813         ; ------------------------------------------------------------
                      (    forth6809.asm):03814         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03815         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03816         ; operand to jump to the current code address.
                      (    forth6809.asm):03817         ; ------------------------------------------------------------
E562 3706             (    forth6809.asm):03818         THENW:      PULU  D
E564 10830001         (    forth6809.asm):03819                     CMPD  #TAGFWD
E568 2703             (    forth6809.asm):03820                     BEQ   THOK
E56A BDE4CA           (    forth6809.asm):03821                     JSR   CFERR
E56D 3710             (    forth6809.asm):03822         THOK:       PULU  X                 ; orig
E56F DC08             (    forth6809.asm):03823                     LDD   CODEHERE
E571 3606             (    forth6809.asm):03824                     PSHU  D
E573 3610             (    forth6809.asm):03825                     PSHU  X
E575 BDE534           (    forth6809.asm):03826                     JSR   PATCH
E578 39               (    forth6809.asm):03827                     RTS
                      (    forth6809.asm):03828         
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
                      (    forth6809.asm):03830         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03831         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03832         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03833         ; ------------------------------------------------------------
E579 3706             (    forth6809.asm):03834         ELSEW:      PULU  D
E57B 10830001         (    forth6809.asm):03835                     CMPD  #TAGFWD
E57F 2703             (    forth6809.asm):03836                     BEQ   ELOK
E581 BDE4CA           (    forth6809.asm):03837                     JSR   CFERR
E584 3706             (    forth6809.asm):03838         ELOK:       PULU  D                 ; orig1
E586 DD29             (    forth6809.asm):03839                     STD   MSCR              ; See bugfix: ELSEW.1
E588 CCDDFB           (    forth6809.asm):03840                     LDD   #BRANCH
E58B 3606             (    forth6809.asm):03841                     PSHU  D
E58D BDE97A           (    forth6809.asm):03842                     JSR   CCALL
E590 CC0000           (    forth6809.asm):03843                     LDD   #0
E593 3606             (    forth6809.asm):03844                     PSHU  D

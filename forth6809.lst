                      (    forth6809.asm):01702         
DD6D 5C               (    forth6809.asm):01703                     INCB                    ; Update tail pointer to next character slot.
DD6E C43F             (    forth6809.asm):01704                     ANDB  #OUTBUFSZ-1
DD70 F7017A           (    forth6809.asm):01705                     STB   OUTTAIL

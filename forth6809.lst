                      (    forth6809.asm):10464         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (    forth6809.asm):10465         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (    forth6809.asm):10466         ; IS tests, but gets its own dedicated test here too.
                      (    forth6809.asm):10467         ;
                      (    forth6809.asm):10468         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (    forth6809.asm):10469         ; itself (a pure address computation) - wrong, confirmed via
                      (    forth6809.asm):10470         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (    forth6809.asm):10471         ; returning the VALUE stored there, not the address itself. This
                      (    forth6809.asm):10472         ; is genuinely correct behavior for this system's own trampoline
                      (    forth6809.asm):10473         ; design, not a bug in TOBODY - reconciled directly against why
                      (    forth6809.asm):10474         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (    forth6809.asm):10475         ; same TOBODY and passed on real hardware, never surfaced this:
                      (    forth6809.asm):10476         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (    forth6809.asm):10477         ; own compile-time code stores a genuinely meaningful value at
                      (    forth6809.asm):10478         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (    forth6809.asm):10479         ; value) - "the body" for this system's own design IS the value
                      (    forth6809.asm):10480         ; at xt+5, not xt+5's own address. This test never initialized
                      (    forth6809.asm):10481         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (    forth6809.asm):10482         ; whatever garbage happened to already be there - now sets a
                      (    forth6809.asm):10483         ; known value there first and verifies TOBODY returns exactly
                      (    forth6809.asm):10484         ; that.
                      (    forth6809.asm):10485         ; ------------------------------------------------------------
C278                  (    forth6809.asm):10486         TSTTOBODY: LDD  #TSTVAL1
                      (    forth6809.asm):10487                    STD  TSTCBUF+5
                      (    forth6809.asm):10488         
                      (    forth6809.asm):10489                    STU  TSTU0
                      (    forth6809.asm):10490         
                      (    forth6809.asm):10491                    LDD  #TSTGUARD
                      (    forth6809.asm):10492                    PSHU D
                      (    forth6809.asm):10493                    LDD  #TSTCBUF
                      (    forth6809.asm):10494                    PSHU D
                      (    forth6809.asm):10495                    STU  TSTUB4
                      (    forth6809.asm):10496         
                      (    forth6809.asm):10497                    JSR  TOBODY
                      (    forth6809.asm):10498         
                      (    forth6809.asm):10499                    STU  TSTUAF
                      (    forth6809.asm):10500         
                      (    forth6809.asm):10501                    PULU D
                      (    forth6809.asm):10502                    CMPD #TSTVAL1
                      (    forth6809.asm):10503                    BNE  TBFAIL
                      (    forth6809.asm):10504                    PULU D
                      (    forth6809.asm):10505                    CMPD #TSTGUARD
                      (    forth6809.asm):10506                    BNE  TBFAIL
                      (    forth6809.asm):10507         
                      (    forth6809.asm):10508                    LDD  TSTUB4
                      (    forth6809.asm):10509                    SUBD TSTUAF
                      (    forth6809.asm):10510                    CMPD #0
                      (    forth6809.asm):10511                    BNE  TBFAIL
                      (    forth6809.asm):10512         
                      (    forth6809.asm):10513                    LDD  #TRUEV
                      (    forth6809.asm):10514                    BRA  TBDONE
C278                  (    forth6809.asm):10515         TBFAIL:    LDD  #FALSEV
C278                  (    forth6809.asm):10516         TBDONE:    LDX  #TSTTBNAME
                      (    forth6809.asm):10517                    PSHU X
                      (    forth6809.asm):10518                    PSHU D
                      (    forth6809.asm):10519                    JSR  TSTREPORT
                      (    forth6809.asm):10520         
                      (    forth6809.asm):10521                    LDU  TSTU0
                      (    forth6809.asm):10522                    RTS
                      (    forth6809.asm):10523         
C278                  (    forth6809.asm):10524         TSTTBNAME: FCB  9
                      (    forth6809.asm):10525                    FCC  "TSTTOBODY"
                      (    forth6809.asm):10526         

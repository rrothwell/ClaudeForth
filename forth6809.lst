E462 251E             (    forth6809.asm):03148                     BLO   NLDONE
E464 815A             (    forth6809.asm):03149                     CMPA  #'Z'
E466 221A             (    forth6809.asm):03150                     BHI   NLDONE
E468 8037             (    forth6809.asm):03151                     SUBA  #'A'-10

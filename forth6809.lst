                      (    forth6809.asm):10419         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (    forth6809.asm):10420         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (    forth6809.asm):10421         ; IS tests, but gets its own dedicated test here too.
                      (    forth6809.asm):10422         ;
                      (    forth6809.asm):10423         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (    forth6809.asm):10424         ; itself (a pure address computation) - wrong, confirmed via
                      (    forth6809.asm):10425         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (    forth6809.asm):10426         ; returning the VALUE stored there, not the address itself. This
                      (    forth6809.asm):10427         ; is genuinely correct behavior for this system's own trampoline
                      (    forth6809.asm):10428         ; design, not a bug in TOBODY - reconciled directly against why
                      (    forth6809.asm):10429         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (    forth6809.asm):10430         ; same TOBODY and passed on real hardware, never surfaced this:
                      (    forth6809.asm):10431         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (    forth6809.asm):10432         ; own compile-time code stores a genuinely meaningful value at
                      (    forth6809.asm):10433         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (    forth6809.asm):10434         ; value) - "the body" for this system's own design IS the value
                      (    forth6809.asm):10435         ; at xt+5, not xt+5's own address. This test never initialized
                      (    forth6809.asm):10436         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (    forth6809.asm):10437         ; whatever garbage happened to already be there - now sets a
                      (    forth6809.asm):10438         ; known value there first and verifies TOBODY returns exactly
                      (    forth6809.asm):10439         ; that.
                      (    forth6809.asm):10440         ; ------------------------------------------------------------
C100                  (    forth6809.asm):10441         TSTTOBODY: LDD  #TSTVAL1
                      (    forth6809.asm):10442                    STD  TSTCBUF+5
                      (    forth6809.asm):10443         
                      (    forth6809.asm):10444                    STU  TSTU0
                      (    forth6809.asm):10445         
                      (    forth6809.asm):10446                    LDD  #TSTGUARD
                      (    forth6809.asm):10447                    PSHU D
                      (    forth6809.asm):10448                    LDD  #TSTCBUF
                      (    forth6809.asm):10449                    PSHU D
                      (    forth6809.asm):10450                    STU  TSTUB4
                      (    forth6809.asm):10451         
                      (    forth6809.asm):10452                    JSR  TOBODY
                      (    forth6809.asm):10453         
                      (    forth6809.asm):10454                    STU  TSTUAF
                      (    forth6809.asm):10455         
                      (    forth6809.asm):10456                    PULU D
                      (    forth6809.asm):10457                    CMPD #TSTVAL1
                      (    forth6809.asm):10458                    BNE  TBFAIL
                      (    forth6809.asm):10459                    PULU D
                      (    forth6809.asm):10460                    CMPD #TSTGUARD
                      (    forth6809.asm):10461                    BNE  TBFAIL
                      (    forth6809.asm):10462         
                      (    forth6809.asm):10463                    LDD  TSTUB4
                      (    forth6809.asm):10464                    SUBD TSTUAF
                      (    forth6809.asm):10465                    CMPD #0
                      (    forth6809.asm):10466                    BNE  TBFAIL
                      (    forth6809.asm):10467         
                      (    forth6809.asm):10468                    LDD  #TRUEV
                      (    forth6809.asm):10469                    BRA  TBDONE

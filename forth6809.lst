D742 DC04             (    forth6809.asm):04121                     LDD   LATEST
D744 ED8814           (    forth6809.asm):04122                     STD   WLNOFF,X          ; the header of the naming word
D747 7ED0E4           (    forth6809.asm):04123                     JMP   COMMAW

                      (    forth6809.asm):07456         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (    forth6809.asm):07457         ; clause. Compiles
                      (    forth6809.asm):07458         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (    forth6809.asm):07459         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (    forth6809.asm):07460         ; with selector=2, matching the second clause. Traced by hand:
                      (    forth6809.asm):07461         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (    forth6809.asm):07462         ; runs on a match, consuming the selector; ENDOF compiles an
                      (    forth6809.asm):07463         ; unconditional branch past the remaining clauses AND patches
                      (    forth6809.asm):07464         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (    forth6809.asm):07465         ; patches every pending ENDOF branch to the true end and
                      (    forth6809.asm):07466         ; compiles a final fallback DROP for the no-match case.
                      (    forth6809.asm):07467         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):07468         TSTCASE1: LDD  CODEHERE
                      (    forth6809.asm):07469                   STD  TSTCSAV
                      (    forth6809.asm):07470                   LDD  #TSTCBUF
                      (    forth6809.asm):07471                   STD  CODEHERE
                      (    forth6809.asm):07472         
                      (    forth6809.asm):07473                   JSR  CASEW
                      (    forth6809.asm):07474         
                      (    forth6809.asm):07475                   LDD  #1
                      (    forth6809.asm):07476                   PSHU D
                      (    forth6809.asm):07477                   JSR  LITERALW
                      (    forth6809.asm):07478                   JSR  OF
                      (    forth6809.asm):07479                   LDD  #111
                      (    forth6809.asm):07480                   PSHU D
                      (    forth6809.asm):07481                   JSR  LITERALW
                      (    forth6809.asm):07482                   JSR  ENDOF
                      (    forth6809.asm):07483         
                      (    forth6809.asm):07484                   LDD  #2
                      (    forth6809.asm):07485                   PSHU D
                      (    forth6809.asm):07486                   JSR  LITERALW
                      (    forth6809.asm):07487                   JSR  OF
                      (    forth6809.asm):07488                   LDD  #222
                      (    forth6809.asm):07489                   PSHU D
                      (    forth6809.asm):07490                   JSR  LITERALW
                      (    forth6809.asm):07491                   JSR  ENDOF
                      (    forth6809.asm):07492         
                      (    forth6809.asm):07493                   JSR  ENDCASE
                      (    forth6809.asm):07494         
                      (    forth6809.asm):07495                   LDD  #OPRTS
                      (    forth6809.asm):07496                   PSHU D
                      (    forth6809.asm):07497                   JSR  CCOMMA
                      (    forth6809.asm):07498         
                      (    forth6809.asm):07499                   LDD  TSTCSAV
                      (    forth6809.asm):07500                   STD  CODEHERE
                      (    forth6809.asm):07501         
                      (    forth6809.asm):07502                   STU  TSTU0
                      (    forth6809.asm):07503         
                      (    forth6809.asm):07504                   LDD  #TSTGUARD
                      (    forth6809.asm):07505                   PSHU D
                      (    forth6809.asm):07506                   LDD  #2
                      (    forth6809.asm):07507                   PSHU D
                      (    forth6809.asm):07508                   STU  TSTUB4
                      (    forth6809.asm):07509         
                      (    forth6809.asm):07510                   JSR  TSTCBUF
                      (    forth6809.asm):07511         
                      (    forth6809.asm):07512                   STU  TSTUAF
                      (    forth6809.asm):07513         
                      (    forth6809.asm):07514                   PULU D
                      (    forth6809.asm):07515                   CMPD #222
                      (    forth6809.asm):07516                   BNE  C1FAIL
                      (    forth6809.asm):07517                   PULU D
                      (    forth6809.asm):07518                   CMPD #TSTGUARD
                      (    forth6809.asm):07519                   BNE  C1FAIL
                      (    forth6809.asm):07520         
                      (    forth6809.asm):07521                   LDD  TSTUB4
                      (    forth6809.asm):07522                   SUBD TSTUAF
                      (    forth6809.asm):07523                   CMPD #0
                      (    forth6809.asm):07524                   BNE  C1FAIL
                      (    forth6809.asm):07525         
                      (    forth6809.asm):07526                   LDD  #TRUEV
                      (    forth6809.asm):07527                   BRA  C1DONE
C23C                  (    forth6809.asm):07528         C1FAIL:   LDD  #FALSEV
C23C                  (    forth6809.asm):07529         C1DONE:   LDX  #TSTCASE1NAME
                      (    forth6809.asm):07530                   PSHU X
                      (    forth6809.asm):07531                   PSHU D
                      (    forth6809.asm):07532                   JSR  TSTREPORT
                      (    forth6809.asm):07533         
                      (    forth6809.asm):07534                   LDU  TSTU0
                      (    forth6809.asm):07535                   RTS
                      (    forth6809.asm):07536         
C23C                  (    forth6809.asm):07537         TSTCASE1NAME: FCB  9
                      (    forth6809.asm):07538                       FCC  "TSTCASE1"

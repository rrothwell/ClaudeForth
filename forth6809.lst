D723 9F49             (    forth6809.asm):04092                     STX   ORDEND
D725 EC1C             (    forth6809.asm):04093         ALLOOP:     LDD   -4,X              ; open a gap at the front
D727 ED1E             (    forth6809.asm):04094                     STD   -2,X
D729 301E             (    forth6809.asm):04095                     LEAX  -2,X
D72B 8C004D           (    forth6809.asm):04096                     CMPX  #ORDER+2
D72E 22F5             (    forth6809.asm):04097                     BHI   ALLOOP

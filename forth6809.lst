                      (    forth6809.asm):05850         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):05851         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):05852         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):05853         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):05854         ; (off-by-one, wrong direction, wrong starting value) would
                      (    forth6809.asm):05855         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (    forth6809.asm):05856         ; just "some number of iterations happened."
                      (    forth6809.asm):05857         ;
                      (    forth6809.asm):05858         ; The documented limit=index edge case (runs at least once) is
                      (    forth6809.asm):05859         ; deliberately NOT tested here: traced precisely (simulated the
                      (    forth6809.asm):05860         ; real DOTEST increment-and-compare-equal logic) and confirmed
                      (    forth6809.asm):05861         ; it takes a full 65536 iterations to naturally reconverge on
                      (    forth6809.asm):05862         ; equality, not one - true to the letter of "at least once" but
                      (    forth6809.asm):05863         ; impractical for a boot-time self-check. Left untested, not
                      (    forth6809.asm):05864         ; guessed at; noted in the open-items checklist.
                      (    forth6809.asm):05865         ; ------------------------------------------------------------

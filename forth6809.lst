                      (    forth6809.asm):06823         ; TSTUNLOOP - unit test for UNLOOP. A true no-op (bare RTS) per
                      (    forth6809.asm):06824         ; its own extensively-documented design history in the source -
                      (    forth6809.asm):06825         ; superseded by EXIT's own automatic frame-discarding, kept
                      (    forth6809.asm):06826         ; only for source compatibility. Not compile-time/immediate
                      (    forth6809.asm):06827         ; like the rest of this section - a plain runtime word, tested
                      (    forth6809.asm):06828         ; directly without the compile harness, same pattern as ALIGN's
                      (    forth6809.asm):06829         ; own test in section 3.6: pushes decoy values, calls UNLOOP,
                      (    forth6809.asm):06830         ; confirms the whole stack is genuinely undisturbed.
                      (    forth6809.asm):06831         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):06832         TSTUNLOOP: STU  TSTU0
                      (    forth6809.asm):06833         
                      (    forth6809.asm):06834                    LDD  #TSTGUARD
                      (    forth6809.asm):06835                    PSHU D
                      (    forth6809.asm):06836                    LDD  #TSTVAL1
                      (    forth6809.asm):06837                    PSHU D
                      (    forth6809.asm):06838                    LDD  #TSTVAL2
                      (    forth6809.asm):06839                    PSHU D
                      (    forth6809.asm):06840                    STU  TSTUB4
                      (    forth6809.asm):06841         
                      (    forth6809.asm):06842                    JSR  UNLOOP
                      (    forth6809.asm):06843         
                      (    forth6809.asm):06844                    STU  TSTUAF
                      (    forth6809.asm):06845         
                      (    forth6809.asm):06846                    PULU D
                      (    forth6809.asm):06847                    CMPD #TSTVAL2
                      (    forth6809.asm):06848                    BNE  UOFAIL
                      (    forth6809.asm):06849                    PULU D
                      (    forth6809.asm):06850                    CMPD #TSTVAL1
                      (    forth6809.asm):06851                    BNE  UOFAIL
                      (    forth6809.asm):06852                    PULU D
                      (    forth6809.asm):06853                    CMPD #TSTGUARD
                      (    forth6809.asm):06854                    BNE  UOFAIL
                      (    forth6809.asm):06855         
                      (    forth6809.asm):06856                    LDD  TSTUB4
                      (    forth6809.asm):06857                    SUBD TSTUAF
                      (    forth6809.asm):06858                    CMPD #0
                      (    forth6809.asm):06859                    BNE  UOFAIL
                      (    forth6809.asm):06860         
                      (    forth6809.asm):06861                    LDD  #TRUEV
                      (    forth6809.asm):06862                    BRA  UODONE
C3C7                  (    forth6809.asm):06863         UOFAIL:    LDD  #FALSEV
C3C7                  (    forth6809.asm):06864         UODONE:    LDX  #TSTUNLOOPNAME
                      (    forth6809.asm):06865                    PSHU X
                      (    forth6809.asm):06866                    PSHU D
                      (    forth6809.asm):06867                    JSR  TSTREPORT
                      (    forth6809.asm):06868         
                      (    forth6809.asm):06869                    LDU  TSTU0
                      (    forth6809.asm):06870                    RTS
                      (    forth6809.asm):06871         
C3C7                  (    forth6809.asm):06872         TSTUNLOOPNAME: FCB  9
                      (    forth6809.asm):06873                        FCC  "TSTUNLOOP"
                      (    forth6809.asm):06874         
                      (    forth6809.asm):06875         ; ------------------------------------------------------------
                      (    forth6809.asm):06876         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (    forth6809.asm):06877         ; clause. Compiles
                      (    forth6809.asm):06878         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (    forth6809.asm):06879         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (    forth6809.asm):06880         ; with selector=2, matching the second clause. Traced by hand:
                      (    forth6809.asm):06881         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (    forth6809.asm):06882         ; runs on a match, consuming the selector; ENDOF compiles an
                      (    forth6809.asm):06883         ; unconditional branch past the remaining clauses AND patches
                      (    forth6809.asm):06884         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (    forth6809.asm):06885         ; patches every pending ENDOF branch to the true end and
                      (    forth6809.asm):06886         ; compiles a final fallback DROP for the no-match case.
                      (    forth6809.asm):06887         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):06888         TSTCASE1: LDD  CODEHERE
                      (    forth6809.asm):06889                   STD  TSTCSAV
                      (    forth6809.asm):06890                   LDD  #TSTCBUF
                      (    forth6809.asm):06891                   STD  CODEHERE
                      (    forth6809.asm):06892         
                      (    forth6809.asm):06893                   JSR  CASEW
                      (    forth6809.asm):06894         
                      (    forth6809.asm):06895                   LDD  #1
                      (    forth6809.asm):06896                   PSHU D
                      (    forth6809.asm):06897                   JSR  LITERALW
                      (    forth6809.asm):06898                   JSR  OF
                      (    forth6809.asm):06899                   LDD  #111
                      (    forth6809.asm):06900                   PSHU D
                      (    forth6809.asm):06901                   JSR  LITERALW
                      (    forth6809.asm):06902                   JSR  ENDOF
                      (    forth6809.asm):06903         
                      (    forth6809.asm):06904                   LDD  #2
                      (    forth6809.asm):06905                   PSHU D
                      (    forth6809.asm):06906                   JSR  LITERALW
                      (    forth6809.asm):06907                   JSR  OF
                      (    forth6809.asm):06908                   LDD  #222
                      (    forth6809.asm):06909                   PSHU D
                      (    forth6809.asm):06910                   JSR  LITERALW
                      (    forth6809.asm):06911                   JSR  ENDOF
                      (    forth6809.asm):06912         
                      (    forth6809.asm):06913                   JSR  ENDCASE
                      (    forth6809.asm):06914         
                      (    forth6809.asm):06915                   LDD  #OPRTS
                      (    forth6809.asm):06916                   PSHU D
                      (    forth6809.asm):06917                   JSR  CCOMMA
                      (    forth6809.asm):06918         
                      (    forth6809.asm):06919                   LDD  TSTCSAV
                      (    forth6809.asm):06920                   STD  CODEHERE
                      (    forth6809.asm):06921         
                      (    forth6809.asm):06922                   STU  TSTU0
                      (    forth6809.asm):06923         
                      (    forth6809.asm):06924                   LDD  #TSTGUARD
                      (    forth6809.asm):06925                   PSHU D
                      (    forth6809.asm):06926                   LDD  #2
                      (    forth6809.asm):06927                   PSHU D
                      (    forth6809.asm):06928                   STU  TSTUB4
                      (    forth6809.asm):06929         
                      (    forth6809.asm):06930                   JSR  TSTCBUF
                      (    forth6809.asm):06931         
                      (    forth6809.asm):06932                   STU  TSTUAF
                      (    forth6809.asm):06933         
                      (    forth6809.asm):06934                   PULU D
                      (    forth6809.asm):06935                   CMPD #222
                      (    forth6809.asm):06936                   BNE  C1FAIL
                      (    forth6809.asm):06937                   PULU D
                      (    forth6809.asm):06938                   CMPD #TSTGUARD
                      (    forth6809.asm):06939                   BNE  C1FAIL
                      (    forth6809.asm):06940         
                      (    forth6809.asm):06941                   LDD  TSTUB4
                      (    forth6809.asm):06942                   SUBD TSTUAF
                      (    forth6809.asm):06943                   CMPD #0
                      (    forth6809.asm):06944                   BNE  C1FAIL
                      (    forth6809.asm):06945         
                      (    forth6809.asm):06946                   LDD  #TRUEV
                      (    forth6809.asm):06947                   BRA  C1DONE
C3C7                  (    forth6809.asm):06948         C1FAIL:   LDD  #FALSEV
C3C7                  (    forth6809.asm):06949         C1DONE:   LDX  #TSTCASE1NAME
                      (    forth6809.asm):06950                   PSHU X
                      (    forth6809.asm):06951                   PSHU D
                      (    forth6809.asm):06952                   JSR  TSTREPORT
                      (    forth6809.asm):06953         
                      (    forth6809.asm):06954                   LDU  TSTU0
                      (    forth6809.asm):06955                   RTS
                      (    forth6809.asm):06956         
C3C7                  (    forth6809.asm):06957         TSTCASE1NAME: FCB  9
                      (    forth6809.asm):06958                       FCC  "TSTCASE1"
                      (    forth6809.asm):06959         
                      (    forth6809.asm):06960         ; ------------------------------------------------------------
                      (    forth6809.asm):06961         ; TSTCASE2 - unit test for CASE/OF/ENDOF/ENDCASE, no-match
                      (    forth6809.asm):06962         ; case. Same compiled snippet as TSTCASE1, run with a selector
                      (    forth6809.asm):06963         ; (99) matching neither clause - should fall through both OF
                      (    forth6809.asm):06964         ; checks (selector preserved across each non-match, per the
                      (    forth6809.asm):06965         ; documented "( x n -- | x )" effect) and reach ENDCASE's own
                      (    forth6809.asm):06966         ; fallback DROP, consuming the selector with nothing pushed in
                      (    forth6809.asm):06967         ; its place.
                      (    forth6809.asm):06968         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):06969         TSTCASE2: LDD  CODEHERE
                      (    forth6809.asm):06970                   STD  TSTCSAV
                      (    forth6809.asm):06971                   LDD  #TSTCBUF
                      (    forth6809.asm):06972                   STD  CODEHERE
                      (    forth6809.asm):06973         
                      (    forth6809.asm):06974                   JSR  CASEW
                      (    forth6809.asm):06975         
                      (    forth6809.asm):06976                   LDD  #1
                      (    forth6809.asm):06977                   PSHU D
                      (    forth6809.asm):06978                   JSR  LITERALW
                      (    forth6809.asm):06979                   JSR  OF
                      (    forth6809.asm):06980                   LDD  #111
                      (    forth6809.asm):06981                   PSHU D
                      (    forth6809.asm):06982                   JSR  LITERALW
                      (    forth6809.asm):06983                   JSR  ENDOF
                      (    forth6809.asm):06984         
                      (    forth6809.asm):06985                   LDD  #2
                      (    forth6809.asm):06986                   PSHU D
                      (    forth6809.asm):06987                   JSR  LITERALW
                      (    forth6809.asm):06988                   JSR  OF
                      (    forth6809.asm):06989                   LDD  #222
                      (    forth6809.asm):06990                   PSHU D
                      (    forth6809.asm):06991                   JSR  LITERALW
                      (    forth6809.asm):06992                   JSR  ENDOF
                      (    forth6809.asm):06993         
                      (    forth6809.asm):06994                   JSR  ENDCASE
                      (    forth6809.asm):06995         
                      (    forth6809.asm):06996                   LDD  #OPRTS
                      (    forth6809.asm):06997                   PSHU D
                      (    forth6809.asm):06998                   JSR  CCOMMA
                      (    forth6809.asm):06999         
                      (    forth6809.asm):07000                   LDD  TSTCSAV
                      (    forth6809.asm):07001                   STD  CODEHERE
                      (    forth6809.asm):07002         
                      (    forth6809.asm):07003                   STU  TSTU0
                      (    forth6809.asm):07004         
                      (    forth6809.asm):07005                   LDD  #TSTGUARD
                      (    forth6809.asm):07006                   PSHU D
                      (    forth6809.asm):07007                   LDD  #99
                      (    forth6809.asm):07008                   PSHU D
                      (    forth6809.asm):07009                   STU  TSTUB4
                      (    forth6809.asm):07010         
                      (    forth6809.asm):07011                   JSR  TSTCBUF
                      (    forth6809.asm):07012         
                      (    forth6809.asm):07013                   STU  TSTUAF
                      (    forth6809.asm):07014         
                      (    forth6809.asm):07015                   PULU D
                      (    forth6809.asm):07016                   CMPD #TSTGUARD
                      (    forth6809.asm):07017                   BNE  C2FAIL
                      (    forth6809.asm):07018         
                      (    forth6809.asm):07019                   LDD  TSTUB4
                      (    forth6809.asm):07020                   SUBD TSTUAF
                      (    forth6809.asm):07021                   CMPD #-2
                      (    forth6809.asm):07022                   BNE  C2FAIL
                      (    forth6809.asm):07023         
                      (    forth6809.asm):07024                   LDD  #TRUEV
                      (    forth6809.asm):07025                   BRA  C2DONE
C3C7                  (    forth6809.asm):07026         C2FAIL:   LDD  #FALSEV
C3C7                  (    forth6809.asm):07027         C2DONE:   LDX  #TSTCASE2NAME
                      (    forth6809.asm):07028                   PSHU X
                      (    forth6809.asm):07029                   PSHU D
                      (    forth6809.asm):07030                   JSR  TSTREPORT
                      (    forth6809.asm):07031         
                      (    forth6809.asm):07032                   LDU  TSTU0
                      (    forth6809.asm):07033                   RTS
                      (    forth6809.asm):07034         
C3C7                  (    forth6809.asm):07035         TSTCASE2NAME: FCB  9
                      (    forth6809.asm):07036                       FCC  "TSTCASE2"
                      (    forth6809.asm):07037         
                      (    forth6809.asm):07038         ; ------------------------------------------------------------
                      (    forth6809.asm):07039         ; TSTTHENZ - unit test for THEN, tag-mismatch case. Pushes a
                      (    forth6809.asm):07040         ; wrong value (0, matching none of TAGFWD/TAGBACK/TAGDO/TAGOF)
                      (    forth6809.asm):07041         ; in place of the expected TAGFWD, then calls THEN via CATCH.
                      (    forth6809.asm):07042         ; CFERR (confirmed by reading it directly) throws -22
                      (    forth6809.asm):07043         ; immediately without ever touching CODEHERE - the error path
                      (    forth6809.asm):07044         ; never reaches any compiling code - so this needs no CODEHERE
                      (    forth6809.asm):07045         ; redirect, unlike every other test in this section. Same
                      (    forth6809.asm):07046         ; CATCH-based pattern as the divide-by-zero tests in earlier
                      (    forth6809.asm):07047         ; sections: verify the thrown code and CATCH's own depth-
                      (    forth6809.asm):07048         ; restoration contract, not the unspecified i*x values.
                      (    forth6809.asm):07049         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):07050         TSTTHENZ: STU  TSTU0
                      (    forth6809.asm):07051         
                      (    forth6809.asm):07052                   LDD  #0
                      (    forth6809.asm):07053                   PSHU D
                      (    forth6809.asm):07054                   LDD  #0
                      (    forth6809.asm):07055                   PSHU D
                      (    forth6809.asm):07056                   LDX  #THEN
                      (    forth6809.asm):07057                   PSHU X
                      (    forth6809.asm):07058                   STU  TSTUB4
                      (    forth6809.asm):07059         
                      (    forth6809.asm):07060                   JSR  CATCH
                      (    forth6809.asm):07061         
                      (    forth6809.asm):07062                   STU  TSTUAF
                      (    forth6809.asm):07063         
                      (    forth6809.asm):07064                   PULU D
                      (    forth6809.asm):07065                   CMPD #-22
                      (    forth6809.asm):07066                   BNE  T3FAIL
                      (    forth6809.asm):07067         
                      (    forth6809.asm):07068                   LDD  TSTUB4
                      (    forth6809.asm):07069                   SUBD TSTUAF
                      (    forth6809.asm):07070                   CMPD #0
                      (    forth6809.asm):07071                   BNE  T3FAIL
                      (    forth6809.asm):07072         
                      (    forth6809.asm):07073                   LDD  #TRUEV
                      (    forth6809.asm):07074                   BRA  T3DONE
C3C7                  (    forth6809.asm):07075         T3FAIL:   LDD  #FALSEV
C3C7                  (    forth6809.asm):07076         T3DONE:   LDX  #TSTTHENZNAME
                      (    forth6809.asm):07077                   PSHU X
                      (    forth6809.asm):07078                   PSHU D
                      (    forth6809.asm):07079                   JSR  TSTREPORT
                      (    forth6809.asm):07080         
                      (    forth6809.asm):07081                   LDU  TSTU0
                      (    forth6809.asm):07082                   RTS
                      (    forth6809.asm):07083         
C3C7                  (    forth6809.asm):07084         TSTTHENZNAME: FCB  8
                      (    forth6809.asm):07085                       FCC  "TSTTHENZ"
                      (    forth6809.asm):07086         
                      (    forth6809.asm):07087         ; ------------------------------------------------------------
                      (    forth6809.asm):07088         ; TSTUNTILZ - unit test for UNTIL, tag-mismatch case. Same
                      (    forth6809.asm):07089         ; pattern as TSTTHENZ - wrong value in place of TAGBACK.
                      (    forth6809.asm):07090         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):07091         TSTUNTILZ: STU  TSTU0
                      (    forth6809.asm):07092         
                      (    forth6809.asm):07093                    LDD  #0
                      (    forth6809.asm):07094                    PSHU D
                      (    forth6809.asm):07095                    LDD  #0
                      (    forth6809.asm):07096                    PSHU D
                      (    forth6809.asm):07097                    LDX  #UNTIL
                      (    forth6809.asm):07098                    PSHU X
                      (    forth6809.asm):07099                    STU  TSTUB4
                      (    forth6809.asm):07100         
                      (    forth6809.asm):07101                    JSR  CATCH
                      (    forth6809.asm):07102         
                      (    forth6809.asm):07103                    STU  TSTUAF
                      (    forth6809.asm):07104         
                      (    forth6809.asm):07105                    PULU D
                      (    forth6809.asm):07106                    CMPD #-22
                      (    forth6809.asm):07107                    BNE  U3FAIL
                      (    forth6809.asm):07108         
                      (    forth6809.asm):07109                    LDD  TSTUB4
                      (    forth6809.asm):07110                    SUBD TSTUAF
                      (    forth6809.asm):07111                    CMPD #0
                      (    forth6809.asm):07112                    BNE  U3FAIL
                      (    forth6809.asm):07113         
                      (    forth6809.asm):07114                    LDD  #TRUEV
                      (    forth6809.asm):07115                    BRA  U3DONE
C3C7                  (    forth6809.asm):07116         U3FAIL:    LDD  #FALSEV
C3C7                  (    forth6809.asm):07117         U3DONE:    LDX  #TSTUNTLZNAME
                      (    forth6809.asm):07118                    PSHU X
                      (    forth6809.asm):07119                    PSHU D
                      (    forth6809.asm):07120                    JSR  TSTREPORT
                      (    forth6809.asm):07121         
                      (    forth6809.asm):07122                    LDU  TSTU0
                      (    forth6809.asm):07123                    RTS
                      (    forth6809.asm):07124         
C3C7                  (    forth6809.asm):07125         TSTUNTLZNAME: FCB  9
                      (    forth6809.asm):07126                       FCC  "TSTUNTILZ"
                      (    forth6809.asm):07127         
                      (    forth6809.asm):07128         ; ------------------------------------------------------------
                      (    forth6809.asm):07129         ; TSTENDOFZ - unit test for ENDOF, tag-mismatch case. Same
                      (    forth6809.asm):07130         ; pattern - wrong value in place of TAGOF.
                      (    forth6809.asm):07131         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):07132         TSTENDOFZ: STU  TSTU0
                      (    forth6809.asm):07133         
                      (    forth6809.asm):07134                    LDD  #0
                      (    forth6809.asm):07135                    PSHU D
                      (    forth6809.asm):07136                    LDD  #0
                      (    forth6809.asm):07137                    PSHU D
                      (    forth6809.asm):07138                    LDX  #ENDOF
                      (    forth6809.asm):07139                    PSHU X
                      (    forth6809.asm):07140                    STU  TSTUB4
                      (    forth6809.asm):07141         
                      (    forth6809.asm):07142                    JSR  CATCH
                      (    forth6809.asm):07143         
                      (    forth6809.asm):07144                    STU  TSTUAF
                      (    forth6809.asm):07145         
                      (    forth6809.asm):07146                    PULU D
                      (    forth6809.asm):07147                    CMPD #-22
                      (    forth6809.asm):07148                    BNE  EOFAIL
                      (    forth6809.asm):07149         
                      (    forth6809.asm):07150                    LDD  TSTUB4
                      (    forth6809.asm):07151                    SUBD TSTUAF
                      (    forth6809.asm):07152                    CMPD #0
                      (    forth6809.asm):07153                    BNE  EOFAIL
                      (    forth6809.asm):07154         
                      (    forth6809.asm):07155                    LDD  #TRUEV
                      (    forth6809.asm):07156                    BRA  EODONE
C3C7                  (    forth6809.asm):07157         EOFAIL:    LDD  #FALSEV
C3C7                  (    forth6809.asm):07158         EODONE:    LDX  #TSTENDFZNAME
                      (    forth6809.asm):07159                    PSHU X
                      (    forth6809.asm):07160                    PSHU D
                      (    forth6809.asm):07161                    JSR  TSTREPORT
                      (    forth6809.asm):07162         
                      (    forth6809.asm):07163                    LDU  TSTU0
                      (    forth6809.asm):07164                    RTS
                      (    forth6809.asm):07165         
C3C7                  (    forth6809.asm):07166         TSTENDFZNAME: FCB  9
                      (    forth6809.asm):07167                       FCC  "TSTENDOFZ"
                      (    forth6809.asm):07168         
                      (    forth6809.asm):07169                    ENDC ; <<<<
                      (    forth6809.asm):07170         
                      (    forth6809.asm):07171         ; ------------------------------------------------------------
                      (    forth6809.asm):07172         ; TSTDEFWORDS - defining-words tests (glossary section 3.9, 17
                      (    forth6809.asm):07173         ; words, 12 tests since VALUE/TO and IS/ACTION-OF are each
                      (    forth6809.asm):07174         ; combined into one test). Every defining word parses a name
                      (    forth6809.asm):07175         ; from the input source via WORD (HEADER's own mechanism,
                      (    forth6809.asm):07176         ; shared by :/CREATE) - a complexity nothing in section 3.8 had.
                      (    forth6809.asm):07177         ; Each test redirects CODEHERE, DPHERE, VARHERE, and
                      (    forth6809.asm):07178         ; SRCADDR/SRCLEN/TOIN together (a fake name, "TESTWD", reused
                      (    forth6809.asm):07179         ; safely across every test here since each redirect/restore
                      (    forth6809.asm):07180         ; cycle is fully isolated), calls the real defining word
                      (    forth6809.asm):07181         ; directly, saves the newly-defined word's own CFA (= CODEHERE
                      (    forth6809.asm):07182         ; at the moment the defining word was called), restores
                      (    forth6809.asm):07183         ; everything, then executes that CFA directly to verify runtime
                      (    forth6809.asm):07184         ; behavior.
                      (    forth6809.asm):07185         ;
                      (    forth6809.asm):07186         ; A real, structurally important finding from this section:
                      (    forth6809.asm):07187         ; HEADER writes to the real LATEST variable unconditionally, not
                      (    forth6809.asm):07188         ; a redirectable copy like CODEHERE/DPHERE/VARHERE - every test
                      (    forth6809.asm):07189         ; here explicitly saves and restores it, confirmed necessary by
                      (    forth6809.asm):07190         ; reading HEADER's own code directly, not assumed safe by analogy
                      (    forth6809.asm):07191         ; with the other three pointers.
                      (    forth6809.asm):07192         ;
                      (    forth6809.asm):07193         ; MARKER's own test is the one exception to the general
                      (    forth6809.asm):07194         ; redirect-then-restore-then-execute order: DOMARKER (confirmed
                      (    forth6809.asm):07195         ; by reading it directly) writes to the real DPHERE/CODEHERE/
                      (    forth6809.asm):07196         ; VARHERE/LATEST unconditionally too, so that test executes the
                      (    forth6809.asm):07197         ; marker word while still redirected, only restoring the real
                      (    forth6809.asm):07198         ; environment afterward - getting this order backwards would
                      (    forth6809.asm):07199         ; have corrupted the real dictionary pointers with scratch
                      (    forth6809.asm):07200         ; addresses.
                      (    forth6809.asm):07201         ;
                      (    forth6809.asm):07202         ; Bare CREATE (never followed by DOES>) is deliberately not
                      (    forth6809.asm):07203         ; tested on its own - traced its placeholder "behavior field"
                      (    forth6809.asm):07204         ; (a genuine compiled JSR DOESRT0 instruction) and confirmed
                      (    forth6809.asm):07205         ; DODOES reads that field as raw data, not as code to execute -
                      (    forth6809.asm):07206         ; which only produces a valid jump target for the raw-address
                      (    forth6809.asm):07207         ; form every other defining word uses (VARIABLE, CONSTANT, etc,
                      (    forth6809.asm):07208         ; via CODECOMMA), not CREATE's own placeholder JSR instruction.
                      (    forth6809.asm):07209         ; Bare CREATE's own direct-execution behavior isn't meant to be
                      (    forth6809.asm):07210         ; relied upon before a DOES> patches it.
                      (    forth6809.asm):07211         ; ------------------------------------------------------------
C3C7 BDFC2B           (    forth6809.asm):07212         TSTDEFWORDS: JSR CRW
C3CA 8EC3DB           (    forth6809.asm):07213                    LDX   #TSTDEFMSG
C3CD 3610             (    forth6809.asm):07214                    PSHU  X
C3CF CC0008           (    forth6809.asm):07215                    LDD   #8
C3D2 3606             (    forth6809.asm):07216                    PSHU  D

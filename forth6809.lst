                      (    forth6809.asm):03383                     ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03384                     ; apart without needing a separate flag of its own either
E3A0 DC76             (    forth6809.asm):03385                     LDD   UDLO

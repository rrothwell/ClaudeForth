                      (    forth6809.asm):05184         ; ------------------------------------------------------------
                      (    forth6809.asm):05185         ; /MOD  ( n1 n2 -- n3 n4 )
                      (    forth6809.asm):05186         ; Divide n1 by n2, giving the remainder n3 and the quotient n4.
                      (    forth6809.asm):05187         ; Division truncates toward zero; the remainder has the sign of the
                      (    forth6809.asm):05188         ; dividend. THROW -10 if the divisor is zero.
                      (    forth6809.asm):05189         ; ------------------------------------------------------------

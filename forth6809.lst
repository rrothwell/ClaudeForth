                      (    forth6809.asm):08061         ; ============================================================
                      (    forth6809.asm):08062         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):08063         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):08064         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):08065         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):08066         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):08067         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):08068         ; ============================================================
                      (    forth6809.asm):08069         ; ------------------------------------------------------------
                      (    forth6809.asm):08070         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):08071         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):08072         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):08073         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):08074         ; - no indirection, no value cell.
                      (    forth6809.asm):08075         ;
                      (    forth6809.asm):08076         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):08077         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):08078         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):08079         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):08080         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):08081         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):08082         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):08083         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):08084         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):08085         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):08086         ; ------------------------------------------------------------
FE97 CCFFFF           (    forth6809.asm):08087         TRUEBODY:  LDD   #$FFFF
FE9A 3606             (    forth6809.asm):08088                    PSHU  D
FE9C 39               (    forth6809.asm):08089                    RTS
                      (    forth6809.asm):08090         
FE9D CC0000           (    forth6809.asm):08091         FALSEBODY: LDD   #$0000
FEA0 3606             (    forth6809.asm):08092                    PSHU  D
FEA2 39               (    forth6809.asm):08093                    RTS
                      (    forth6809.asm):08094         
                      (    forth6809.asm):08095         ; ------------------------------------------------------------
                      (    forth6809.asm):08096         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):08097         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):08098         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):08099         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):08100         ; ------------------------------------------------------------
FEA3 CC0001           (    forth6809.asm):08101         ONEBODY:   LDD   #1
FEA6 3606             (    forth6809.asm):08102                    PSHU  D
FEA8 39               (    forth6809.asm):08103                    RTS
                      (    forth6809.asm):08104         
FEA9 CCFFFF           (    forth6809.asm):08105         MONEBODY:  LDD   #-1
FEAC 3606             (    forth6809.asm):08106                    PSHU  D
FEAE 39               (    forth6809.asm):08107                    RTS
                      (    forth6809.asm):08108         
FEAF CC0002           (    forth6809.asm):08109         TWOBODY:   LDD   #2
FEB2 3606             (    forth6809.asm):08110                    PSHU  D
FEB4 39               (    forth6809.asm):08111                    RTS
                      (    forth6809.asm):08112         
FEB5 CCFFFE           (    forth6809.asm):08113         MTWOBODY:  LDD   #-2
FEB8 3606             (    forth6809.asm):08114                    PSHU  D
FEBA 39               (    forth6809.asm):08115                    RTS
                      (    forth6809.asm):08116         
                      (    forth6809.asm):08117         ; Verify no collision with init code,
                      (    forth6809.asm):08118         ; value should match ORG INITCODE.
     FEBB             (    forth6809.asm):08119         BASECODEEND  EQU   *
     2167             (    forth6809.asm):08120         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):08121         
                      (    forth6809.asm):08122         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08123         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):08124         ; .bin file.
FEBB                  (    forth6809.asm):08125         BASEND:
FEBB FFFFFFFFFFFFFFFF (    forth6809.asm):08126                  FILL $FF,INITCODE-BASEND

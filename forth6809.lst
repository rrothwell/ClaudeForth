DFA9 39               (    forth6809.asm):05734                     RTS
                      (    forth6809.asm):05735         
                      (    forth6809.asm):05736         ; ------------------------------------------------------------
                      (    forth6809.asm):05737         ; SWAP  ( x1 x2 -- x2 x1 )

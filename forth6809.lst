                      (    forth6809.asm):01709                    PSHU  D
                      (    forth6809.asm):01710                    LDD   #TSTVAL1
                      (    forth6809.asm):01711                    PSHU  D
                      (    forth6809.asm):01712                    STU   TSTUB4
                      (    forth6809.asm):01713         
                      (    forth6809.asm):01714                    JSR   QDUP
                      (    forth6809.asm):01715         
                      (    forth6809.asm):01716                    STU   TSTUAF
                      (    forth6809.asm):01717         
                      (    forth6809.asm):01718                    PULU  D
                      (    forth6809.asm):01719                    CMPD  #TSTVAL1
                      (    forth6809.asm):01720                    BNE   QNFAIL
                      (    forth6809.asm):01721                    PULU  D
                      (    forth6809.asm):01722                    CMPD  #TSTVAL1
                      (    forth6809.asm):01723                    BNE   QNFAIL
                      (    forth6809.asm):01724                    PULU  D
                      (    forth6809.asm):01725                    CMPD  #TSTGUARD
                      (    forth6809.asm):01726                    BNE   QNFAIL
                      (    forth6809.asm):01727         
                      (    forth6809.asm):01728                    LDD   TSTUB4
                      (    forth6809.asm):01729                    SUBD  TSTUAF
                      (    forth6809.asm):01730                    CMPD  #2
                      (    forth6809.asm):01731                    BNE   QNFAIL
                      (    forth6809.asm):01732         
                      (    forth6809.asm):01733                    LDD   #TRUEV
                      (    forth6809.asm):01734                    BRA   QNDONE
C192                  (    forth6809.asm):01735         QNFAIL:    LDD   #FALSEV

E898 318B             (    forth6809.asm):07500                     LEAY  D,X               ; end address
E89A 10AF42           (    forth6809.asm):07501                     STY   2,U               ; keep it in u's slot as the loop limit
E89D A641             (    forth6809.asm):07502                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
E89F A780             (    forth6809.asm):07503         FILLOOP:    STA   ,X+

                      (    forth6809.asm):15039         
                      (    forth6809.asm):15040                  JSR  BASEW
                      (    forth6809.asm):15041         
                      (    forth6809.asm):15042                  STU  TSTUAF
                      (    forth6809.asm):15043         
                      (    forth6809.asm):15044                  PULU D

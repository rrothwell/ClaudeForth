                      (   unit_tests.asm):11708         ; TSTMOVE2 - unit test for MOVE, overlapping case with dst >
                      (   unit_tests.asm):11709         ; src (dst = TSTCBUF+2, src = TSTCBUF, 5 bytes - a 2-byte
                      (   unit_tests.asm):11710         ; forward shift). MOVE's own code compares addresses and
                      (   unit_tests.asm):11711         ; delegates to CMOVE> (high-to-low) whenever dst > src,
                      (   unit_tests.asm):11712         ; specifically to avoid the corruption a naive low-to-high copy
                      (   unit_tests.asm):11713         ; would cause here (byte 2 would get overwritten by the copy
                      (   unit_tests.asm):11714         ; before ever being read as a source byte). Expected result
                      (   unit_tests.asm):11715         ; hand-derived and independently simulated in Python before
                      (   unit_tests.asm):11716         ; writing this test, not guessed: "ABABCDE" across bytes 0-6.

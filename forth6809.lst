                      (    forth6809.asm):06836         ; ============================================================
                      (    forth6809.asm):06837         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06838         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06839         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06840         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06841         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06842         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06843         ; ============================================================
                      (    forth6809.asm):06844         ; ------------------------------------------------------------
                      (    forth6809.asm):06845         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06846         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06847         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06848         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06849         ; - no indirection, no value cell.
                      (    forth6809.asm):06850         ;
                      (    forth6809.asm):06851         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06852         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06853         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06854         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06855         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06856         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06857         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06858         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06859         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06860         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06861         ; ------------------------------------------------------------
FF82 CCFFFF           (    forth6809.asm):06862         TRUEBODY:  LDD   #$FFFF
FF85 3606             (    forth6809.asm):06863                    PSHU  D
FF87 39               (    forth6809.asm):06864                    RTS
                      (    forth6809.asm):06865         
FF88 CC0000           (    forth6809.asm):06866         FALSEBODY: LDD   #$0000
FF8B 3606             (    forth6809.asm):06867                    PSHU  D
FF8D 39               (    forth6809.asm):06868                    RTS
                      (    forth6809.asm):06869         
                      (    forth6809.asm):06870         ; ------------------------------------------------------------
                      (    forth6809.asm):06871         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):06872         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):06873         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):06874         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):06875         ; ------------------------------------------------------------
FF8E CC0001           (    forth6809.asm):06876         ONEBODY:   LDD   #1
FF91 3606             (    forth6809.asm):06877                    PSHU  D
FF93 39               (    forth6809.asm):06878                    RTS
                      (    forth6809.asm):06879         
FF94 CCFFFF           (    forth6809.asm):06880         MONEBODY:  LDD   #-1
FF97 3606             (    forth6809.asm):06881                    PSHU  D
FF99 39               (    forth6809.asm):06882                    RTS
                      (    forth6809.asm):06883         
FF9A CC0002           (    forth6809.asm):06884         TWOBODY:   LDD   #2
FF9D 3606             (    forth6809.asm):06885                    PSHU  D
FF9F 39               (    forth6809.asm):06886                    RTS
                      (    forth6809.asm):06887         
FFA0 CCFFFE           (    forth6809.asm):06888         MTWOBODY:  LDD   #-2
FFA3 3606             (    forth6809.asm):06889                    PSHU  D
FFA5 39               (    forth6809.asm):06890                    RTS
                      (    forth6809.asm):06891         
                      (    forth6809.asm):06892         ; Verify no collision with init code,
                      (    forth6809.asm):06893         ; value should match ORG INITCODE.
     FFA6             (    forth6809.asm):06894         BASECODEEND  EQU   *
     1FBC             (    forth6809.asm):06895         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):06896         

                      (    forth6809.asm):04457                     LDA   EMITCH
                      (    forth6809.asm):04458                     STA   ACIADR
                      (    forth6809.asm):04459                     RTS
                      (    forth6809.asm):04460         
                      (    forth6809.asm):04461                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04462         
                      (    forth6809.asm):04463         ; ------------------------------------------------------------
                      (    forth6809.asm):04464         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04465         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04466         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04467         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04468         ; ------------------------------------------------------------

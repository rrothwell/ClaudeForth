                      (    forth6809.asm):03386         ; ------------------------------------------------------------
                      (    forth6809.asm):03387         ; KEY  ( -- char )
                      (    forth6809.asm):03388         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03389         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03390         ; ------------------------------------------------------------
E546                  (    forth6809.asm):03391         KEYW:
                      (    forth6809.asm):03392         
E546 7D0178           (    forth6809.asm):03393                     TST   RTSSTATE          ; Is throttling?
E549 2703             (    forth6809.asm):03394                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03395         
                      (    forth6809.asm):03396                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E54B BDDD52           (    forth6809.asm):03397                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03398                                             ; by transmitting all chars.
                      (    forth6809.asm):03399         
E54E                  (    forth6809.asm):03400         TRY_READ:
E54E BDDDBF           (    forth6809.asm):03401                     JSR   GETCHAR           ; Is char available in input buffer.
E551 25F3             (    forth6809.asm):03402                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03403                                             ; while still transmitting!
                      (    forth6809.asm):03404         
E553 1F89             (    forth6809.asm):03405                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E555 4F               (    forth6809.asm):03406                     CLRA                    ; Clear MSB.
E556 3606             (    forth6809.asm):03407                     PSHU  D                 ; char
                      (    forth6809.asm):03408         
E558 39               (    forth6809.asm):03409                     RTS
                      (    forth6809.asm):03410         
                      (    forth6809.asm):03411         ; ------------------------------------------------------------
                      (    forth6809.asm):03412         ; KEY?  ( -- flag )
                      (    forth6809.asm):03413         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03414         ; ------------------------------------------------------------
E559                  (    forth6809.asm):03415         KEYQW:
                      (    forth6809.asm):03416                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03417         
E559 B60176           (    forth6809.asm):03418                     LDA   INHEAD            ; Characters received?
E55C B10177           (    forth6809.asm):03419                     CMPA  INTAIL
                      (    forth6809.asm):03420         
                      (    forth6809.asm):03421                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03422         
E55F 2606             (    forth6809.asm):03423                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03424         
E561 CC0000           (    forth6809.asm):03425                     LDD   #FALSEV           ; No! Return false result.
E564 3606             (    forth6809.asm):03426                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03427         
E566 39               (    forth6809.asm):03428                     RTS
                      (    forth6809.asm):03429         
E567                  (    forth6809.asm):03430         KQTRUE:
E567 CCFFFF           (    forth6809.asm):03431                     LDD   #TRUEV            ; Yes! Return true result.
E56A 3606             (    forth6809.asm):03432                     PSHU  D                 ; flag = true
E56C 39               (    forth6809.asm):03433                     RTS
                      (    forth6809.asm):03434         
                      (    forth6809.asm):03435         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03436         
                      (    forth6809.asm):03437         ; ------------------------------------------------------------
                      (    forth6809.asm):03438         ; EMIT  ( char -- )
                      (    forth6809.asm):03439         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03440         ; discarded if the ring is full.
                      (    forth6809.asm):03441         ; ------------------------------------------------------------
E56D                  (    forth6809.asm):03442         EMITW:
E56D 3706             (    forth6809.asm):03443                     PULU  D                 ; char
E56F 1F98             (    forth6809.asm):03444                     TFR   B,A
E571 BDDD74           (    forth6809.asm):03445                     JSR   PUTCHAR           ; Transmit char.
E574 39               (    forth6809.asm):03446                     RTS
                      (    forth6809.asm):03447         
                      (    forth6809.asm):03448                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03449         ; ------------------------------------------------------------
                      (    forth6809.asm):03450         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03451         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03452         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03453         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03454         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03455         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03456         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03457         ; follow.
                      (    forth6809.asm):03458         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03459         KEYW:
                      (    forth6809.asm):03460                     LDA   ACIASR
                      (    forth6809.asm):03461                     BITA  #SR_RDRF
                      (    forth6809.asm):03462                     BEQ   KWAIT
                      (    forth6809.asm):03463                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03464                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E575                  (    forth6809.asm):03465         KWAIT:
E575                  (    forth6809.asm):03466         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03467                     BITA  #SR_RDRF
                      (    forth6809.asm):03468                     BEQ   KSPIN
E575                  (    forth6809.asm):03469         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03470                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03471                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03472                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03473                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03474                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03475                     BEQ   KGETCH
                      (    forth6809.asm):03476                     BITA  #SR_FE
                      (    forth6809.asm):03477                     BEQ   KXFE
                      (    forth6809.asm):03478                     INC   FECOUNT
E575                  (    forth6809.asm):03479         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03480                     BEQ   KXOVRN
                      (    forth6809.asm):03481                     INC   OVRNCOUNT
E575                  (    forth6809.asm):03482         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03483                     BEQ   KGETCH
                      (    forth6809.asm):03484                     INC   PECOUNT
E575                  (    forth6809.asm):03485         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03486                     TFR   A,B
                      (    forth6809.asm):03487                     CLRA
                      (    forth6809.asm):03488                     PSHU  D                 ; char
                      (    forth6809.asm):03489                     RTS
                      (    forth6809.asm):03490         
                      (    forth6809.asm):03491         ; ------------------------------------------------------------
                      (    forth6809.asm):03492         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03493         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03494         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03495         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03496         ;    Inputs:
                      (    forth6809.asm):03497         ;        none
                      (    forth6809.asm):03498         ;    Outputs:
                      (    forth6809.asm):03499         ;        XON or XOFF transmitted
                      (    forth6809.asm):03500         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03501         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03502         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03503         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03504                     BRA   PUTXCH
E575                  (    forth6809.asm):03505         PUTXON:     LDA   #XONCH
E575                  (    forth6809.asm):03506         PUTXCH:     PSHS  A
E575                  (    forth6809.asm):03507         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03508                     BITB  #SR_TDRE
                      (    forth6809.asm):03509                     BEQ   PXWT
                      (    forth6809.asm):03510                     PULS  A
                      (    forth6809.asm):03511                     STA   ACIADR
                      (    forth6809.asm):03512                     RTS
                      (    forth6809.asm):03513         
                      (    forth6809.asm):03514         ; ------------------------------------------------------------
                      (    forth6809.asm):03515         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03516         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03517         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03518         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03519                     BITA  #SR_RDRF
                      (    forth6809.asm):03520                     BEQ   KQFALSE
                      (    forth6809.asm):03521                     LDD   #TRUEV
                      (    forth6809.asm):03522                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03523                     RTS
E575                  (    forth6809.asm):03524         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03525                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03526                     RTS
                      (    forth6809.asm):03527         
                      (    forth6809.asm):03528         ; ------------------------------------------------------------
                      (    forth6809.asm):03529         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03530         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03531         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03532         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03533                     STB   EMITCH
E575                  (    forth6809.asm):03534         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03535                     BITA  #SR_TDRE
                      (    forth6809.asm):03536                     BEQ   EMITWT
                      (    forth6809.asm):03537                     LDA   EMITCH
                      (    forth6809.asm):03538                     STA   ACIADR
                      (    forth6809.asm):03539                     RTS
                      (    forth6809.asm):03540         
                      (    forth6809.asm):03541                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03542         
                      (    forth6809.asm):03543         ; ------------------------------------------------------------
                      (    forth6809.asm):03544         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03545         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03546         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03547         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03548         ; ------------------------------------------------------------
E575 3706             (    forth6809.asm):03549         ACCEPTW:    PULU  D                 ; +n1
E577 DD35             (    forth6809.asm):03550                     STD   AMAX
E579 3706             (    forth6809.asm):03551                     PULU  D                 ; c-addr
E57B DD37             (    forth6809.asm):03552                     STD   ABUFP
E57D CC0000           (    forth6809.asm):03553                     LDD   #0
E580 DD39             (    forth6809.asm):03554                     STD   ACNT
                      (    forth6809.asm):03555         
                      (    forth6809.asm):03556                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03557                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03558                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03559                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03560                                             ; stream this line's characters
                      (    forth6809.asm):03561                     JSR   PUTXON
                      (    forth6809.asm):03562                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03563         
E582 BDE546           (    forth6809.asm):03564         ALOOP:      JSR   KEYW
E585 3706             (    forth6809.asm):03565                     PULU  D
E587 D73B             (    forth6809.asm):03566                     STB   ACH
                      (    forth6809.asm):03567         
E589 C10D             (    forth6809.asm):03568                     CMPB  #13
E58B 274F             (    forth6809.asm):03569                     BEQ   ADONE
E58D C10A             (    forth6809.asm):03570                     CMPB  #10
E58F 27F1             (    forth6809.asm):03571                     BEQ   ALOOP
E591 C108             (    forth6809.asm):03572                     CMPB  #8
E593 2724             (    forth6809.asm):03573                     BEQ   ABKSP
E595 C17F             (    forth6809.asm):03574                     CMPB  #127
E597 2720             (    forth6809.asm):03575                     BEQ   ABKSP
                      (    forth6809.asm):03576         
E599 DC39             (    forth6809.asm):03577                     LDD   ACNT
E59B 109335           (    forth6809.asm):03578                     CMPD  AMAX
E59E 27E2             (    forth6809.asm):03579                     BEQ   ALOOP
                      (    forth6809.asm):03580         
E5A0 9E37             (    forth6809.asm):03581                     LDX   ABUFP
E5A2 308B             (    forth6809.asm):03582                     LEAX  D,X
E5A4 963B             (    forth6809.asm):03583                     LDA   ACH
E5A6 A784             (    forth6809.asm):03584                     STA   ,X
E5A8 DC39             (    forth6809.asm):03585                     LDD   ACNT
E5AA C30001           (    forth6809.asm):03586                     ADDD  #1
E5AD DD39             (    forth6809.asm):03587                     STD   ACNT
                      (    forth6809.asm):03588         
E5AF 4F               (    forth6809.asm):03589                     CLRA
E5B0 D63B             (    forth6809.asm):03590                     LDB   ACH
E5B2 3606             (    forth6809.asm):03591                     PSHU  D
E5B4 BDE56D           (    forth6809.asm):03592                     JSR   EMITW
E5B7 20C9             (    forth6809.asm):03593                     BRA   ALOOP
                      (    forth6809.asm):03594         
E5B9 DC39             (    forth6809.asm):03595         ABKSP:      LDD   ACNT
E5BB 27C5             (    forth6809.asm):03596                     BEQ   ALOOP
E5BD 830001           (    forth6809.asm):03597                     SUBD  #1
E5C0 DD39             (    forth6809.asm):03598                     STD   ACNT
E5C2 CC0008           (    forth6809.asm):03599                     LDD   #8
E5C5 3606             (    forth6809.asm):03600                     PSHU  D
E5C7 BDE56D           (    forth6809.asm):03601                     JSR   EMITW
E5CA CC0020           (    forth6809.asm):03602                     LDD   #32
E5CD 3606             (    forth6809.asm):03603                     PSHU  D
E5CF BDE56D           (    forth6809.asm):03604                     JSR   EMITW
E5D2 CC0008           (    forth6809.asm):03605                     LDD   #8
E5D5 3606             (    forth6809.asm):03606                     PSHU  D
E5D7 BDE56D           (    forth6809.asm):03607                     JSR   EMITW
E5DA 20A6             (    forth6809.asm):03608                     BRA   ALOOP
                      (    forth6809.asm):03609         
E5DC                  (    forth6809.asm):03610         ADONE:
                      (    forth6809.asm):03611                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03612                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03613                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03614                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03615                                             ; with KEY never polled at all
                      (    forth6809.asm):03616                     JSR   PUTXOFF
                      (    forth6809.asm):03617                     ENDC                    ; <<<<<<<<<<
E5DC DC39             (    forth6809.asm):03618                     LDD   ACNT
E5DE 3606             (    forth6809.asm):03619                     PSHU  D                 ; +n2
E5E0 39               (    forth6809.asm):03620                     RTS
                      (    forth6809.asm):03621         
                      (    forth6809.asm):03622         ; ------------------------------------------------------------
                      (    forth6809.asm):03623         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03624         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03625         ; ------------------------------------------------------------
E5E1 BDE575           (    forth6809.asm):03626         EXPECTW:    JSR   ACCEPTW
E5E4 3706             (    forth6809.asm):03627                     PULU  D
E5E6 DDE1             (    forth6809.asm):03628                     STD   SPAN
E5E8 39               (    forth6809.asm):03629                     RTS
                      (    forth6809.asm):03630         
                      (    forth6809.asm):03631         ; ------------------------------------------------------------
                      (    forth6809.asm):03632         ; QUERY  ( -- )
                      (    forth6809.asm):03633         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03634         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03635         ; to 0 and >IN to 0.
                      (    forth6809.asm):03636         ; ------------------------------------------------------------
E5E9 8E0106           (    forth6809.asm):03637         QUERYW:     LDX   #TIBBUF
E5EC 3610             (    forth6809.asm):03638                     PSHU  X
E5EE CC0050           (    forth6809.asm):03639                     LDD   #TIBBUFL
E5F1 3606             (    forth6809.asm):03640                     PSHU  D
E5F3 BDE575           (    forth6809.asm):03641                     JSR   ACCEPTW
E5F6 3706             (    forth6809.asm):03642                     PULU  D
E5F8 DD12             (    forth6809.asm):03643                     STD   NTIB
E5FA DDDD             (    forth6809.asm):03644                     STD   SRCLEN
E5FC CC0106           (    forth6809.asm):03645                     LDD   #TIBBUF
E5FF DDDB             (    forth6809.asm):03646                     STD   SRCADDR
E601 CC0000           (    forth6809.asm):03647                     LDD   #0
E604 DDDF             (    forth6809.asm):03648                     STD   SRCID
E606 DD10             (    forth6809.asm):03649                     STD   TOIN
E608 39               (    forth6809.asm):03650                     RTS
                      (    forth6809.asm):03651         
                      (    forth6809.asm):03652         ; ============================================================
                      (    forth6809.asm):03653         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03654         ; ============================================================
                      (    forth6809.asm):03655         ; ------------------------------------------------------------
                      (    forth6809.asm):03656         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03657         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03658         ; one expected.
                      (    forth6809.asm):03659         ; CFERR
                      (    forth6809.asm):03660         ;    Inputs:
                      (    forth6809.asm):03661         ;        none
                      (    forth6809.asm):03662         ;    Outputs:
                      (    forth6809.asm):03663         ;        does not return (THROW -22)
                      (    forth6809.asm):03664         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03665         ; ------------------------------------------------------------
E609 CCFFEA           (    forth6809.asm):03666         CFERR:      LDD   #-22
E60C 3606             (    forth6809.asm):03667                     PSHU  D                 ; -22
E60E BDE63E           (    forth6809.asm):03668                     JSR   THROWW
E611 39               (    forth6809.asm):03669                     RTS
                      (    forth6809.asm):03670         
                      (    forth6809.asm):03671         ; ------------------------------------------------------------
                      (    forth6809.asm):03672         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03673         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03674         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03675         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03676         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03677         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03678         ; ------------------------------------------------------------
E612 3710             (    forth6809.asm):03679         CATCHW:     PULU  X                 ; xt
E614 DC0C             (    forth6809.asm):03680                     LDD   HANDLER
E616 3406             (    forth6809.asm):03681                     PSHS  D
E618 3440             (    forth6809.asm):03682                     PSHS  U
                      (    forth6809.asm):03683                     ; Save the input source specification.
                      (    forth6809.asm):03684                     ; See bugfix: CATCHW.1
E61A DCDB             (    forth6809.asm):03685                     LDD   SRCADDR
E61C 3406             (    forth6809.asm):03686                     PSHS  D
E61E DCDD             (    forth6809.asm):03687                     LDD   SRCLEN
E620 3406             (    forth6809.asm):03688                     PSHS  D
E622 DCDF             (    forth6809.asm):03689                     LDD   SRCID
E624 3406             (    forth6809.asm):03690                     PSHS  D
E626 DC10             (    forth6809.asm):03691                     LDD   TOIN
E628 3406             (    forth6809.asm):03692                     PSHS  D
E62A 1F40             (    forth6809.asm):03693                     TFR   S,D
E62C DD0C             (    forth6809.asm):03694                     STD   HANDLER
                      (    forth6809.asm):03695         
E62E AD84             (    forth6809.asm):03696                     JSR   ,X
                      (    forth6809.asm):03697         
E630 3268             (    forth6809.asm):03698                     LEAS  8,S               ; drop saved input source
E632 3262             (    forth6809.asm):03699                     LEAS  2,S               ; saved U
E634 3506             (    forth6809.asm):03700                     PULS  D
E636 DD0C             (    forth6809.asm):03701                     STD   HANDLER
E638 CC0000           (    forth6809.asm):03702                     LDD   #0
E63B 3606             (    forth6809.asm):03703                     PSHU  D                 ; 0 = no exception
E63D 39               (    forth6809.asm):03704                     RTS
                      (    forth6809.asm):03705         
                      (    forth6809.asm):03706         ; ------------------------------------------------------------
                      (    forth6809.asm):03707         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03708         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03709         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03710         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03711         ; ------------------------------------------------------------
E63E 3706             (    forth6809.asm):03712         THROWW:     PULU  D                 ; n
E640 10830000         (    forth6809.asm):03713                     CMPD  #0
E644 2725             (    forth6809.asm):03714                     BEQ   THDONE
                      (    forth6809.asm):03715         
E646 DD0E             (    forth6809.asm):03716                     STD   THROWN
E648 9E0C             (    forth6809.asm):03717                     LDX   HANDLER
E64A 2720             (    forth6809.asm):03718                     BEQ   THUNCAU
                      (    forth6809.asm):03719         
E64C 1F14             (    forth6809.asm):03720                     TFR   X,S
E64E 3506             (    forth6809.asm):03721                     PULS  D                 ; restore input source saved by CATCH
E650 DD10             (    forth6809.asm):03722                     STD   TOIN
E652 3506             (    forth6809.asm):03723                     PULS  D
E654 DDDF             (    forth6809.asm):03724                     STD   SRCID
E656 3506             (    forth6809.asm):03725                     PULS  D
E658 DDDD             (    forth6809.asm):03726                     STD   SRCLEN
E65A 3506             (    forth6809.asm):03727                     PULS  D
E65C DDDB             (    forth6809.asm):03728                     STD   SRCADDR
E65E 3506             (    forth6809.asm):03729                     PULS  D
E660 1F03             (    forth6809.asm):03730                     TFR   D,U
E662 3506             (    forth6809.asm):03731                     PULS  D
E664 DD0C             (    forth6809.asm):03732                     STD   HANDLER
                      (    forth6809.asm):03733         
E666 DC0E             (    forth6809.asm):03734                     LDD   THROWN
E668 3606             (    forth6809.asm):03735                     PSHU  D
E66A 39               (    forth6809.asm):03736                     RTS
E66B 39               (    forth6809.asm):03737         THDONE:     RTS
                      (    forth6809.asm):03738         
                      (    forth6809.asm):03739                     ; No CATCH is active: leave n on the stack and ABORT.
E66C DC0E             (    forth6809.asm):03740         THUNCAU:    LDD   THROWN
E66E 3606             (    forth6809.asm):03741                     PSHU  D
E670 7EDEC3           (    forth6809.asm):03742                     JMP   ABORT
                      (    forth6809.asm):03743         
                      (    forth6809.asm):03744         ; ============================================================
                      (    forth6809.asm):03745         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03746         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03747         ; ============================================================
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
                      (    forth6809.asm):03749         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03750         ; location.
                      (    forth6809.asm):03751         ; PATCH   ( target location -- )
                      (    forth6809.asm):03752         ;    Inputs:
                      (    forth6809.asm):03753         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03754         ;    Outputs:
                      (    forth6809.asm):03755         ;        the cell at location holds target - location
                      (    forth6809.asm):03756         ;    Registers: RegD and RegX changed; PFIELD and PTARGET used as
                      (    forth6809.asm):03757         ;        scratch.
                      (    forth6809.asm):03758         ; ------------------------------------------------------------
E673 3706             (    forth6809.asm):03759         PATCH:      PULU  D
E675 DD44             (    forth6809.asm):03760                     STD   PFIELD            ; location
E677 3706             (    forth6809.asm):03761                     PULU  D
E679 DD42             (    forth6809.asm):03762                     STD   PTARGET           ; target
E67B DC42             (    forth6809.asm):03763                     LDD   PTARGET
E67D 9344             (    forth6809.asm):03764                     SUBD  PFIELD
E67F 9E44             (    forth6809.asm):03765                     LDX   PFIELD
E681 ED84             (    forth6809.asm):03766                     STD   ,X
E683 39               (    forth6809.asm):03767                     RTS
                      (    forth6809.asm):03768         
                      (    forth6809.asm):03769         ; ------------------------------------------------------------
                      (    forth6809.asm):03770         ; IF  ( C: -- orig )
                      (    forth6809.asm):03771         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03772         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03773         ; ------------------------------------------------------------
E684 CCDF69           (    forth6809.asm):03774         IFW:        LDD   #ZBRANCH
E687 3606             (    forth6809.asm):03775                     PSHU  D
E689 BDEAB9           (    forth6809.asm):03776                     JSR   CCALL
E68C CC0000           (    forth6809.asm):03777                     LDD   #0
E68F 3606             (    forth6809.asm):03778                     PSHU  D
E691 BDDFFC           (    forth6809.asm):03779                     JSR   CODECOMMA
E694 DC08             (    forth6809.asm):03780                     LDD   CODEHERE
E696 830002           (    forth6809.asm):03781                     SUBD  #2
E699 3606             (    forth6809.asm):03782                     PSHU  D                 ; orig
E69B CC0001           (    forth6809.asm):03783                     LDD   #TAGFWD

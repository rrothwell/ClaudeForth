                      (    forth6809.asm):07874         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):07875         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):07876         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):07877         ; WARM
                      (    forth6809.asm):07878         ;    Inputs:
                      (    forth6809.asm):07879         ;        NMI
                      (    forth6809.asm):07880         ;    Outputs:
                      (    forth6809.asm):07881         ;        does not return
                      (    forth6809.asm):07882         ;    Registers: all registers initialised.
                      (    forth6809.asm):07883         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):07884         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):07885                     CLRA
FFC8 1F8B             (    forth6809.asm):07886                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07887                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07888                     LDS   #RP0
                      (    forth6809.asm):07889         
FFD1 BDDCE3           (    forth6809.asm):07890                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):07891         
FFD4 8EFFE6           (    forth6809.asm):07892                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):07893                     PSHU  X
FFD9 CC0006           (    forth6809.asm):07894                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):07895                     PSHU  D
FFDE BDF3FC           (    forth6809.asm):07896                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):07897                     ANDCC #$AF              ; Enable IRQ & FIRQ

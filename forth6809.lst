                      (    forth6809.asm):04542         ; ------------------------------------------------------------
                      (    forth6809.asm):04543         ; KEY, KEY? and EMIT go through the vectors KEYV, KEYQV and EMITV
                      (    forth6809.asm):04544         ; (page zero) so character I/O can be redirected. IOVINIT points
                      (    forth6809.asm):04545         ; them back at the ACIA routines; it runs at cold start, warm start
                      (    forth6809.asm):04546         ; and when QUIT handles an error.
                      (    forth6809.asm):04547         ; ------------------------------------------------------------
                      (    forth6809.asm):04548         ; Original direct entry points: shadow IOVEC.1.
D801 6E9F0087         (    forth6809.asm):04549         KEYW:       JMP   [KEYV]
D805 6E9F0089         (    forth6809.asm):04550         KEYQW:      JMP   [KEYQV]
D809 6E9F0085         (    forth6809.asm):04551         EMITW:      JMP   [EMITV]
                      (    forth6809.asm):04552         
                      (    forth6809.asm):04553         ; ------------------------------------------------------------
                      (    forth6809.asm):04554         ; IRQ-CHAIN ( -- addr )   address of the cell holding the next interrupt
                      (    forth6809.asm):04555         ; handler for interrupts that did not come from the ACIA.
                      (    forth6809.asm):04556         ; (EMIT) ( -- addr )  (KEY) ( -- addr )  (KEY?) ( -- addr )

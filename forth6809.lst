                      (    forth6809.asm):14986         ; Base/Radix Control test harness (glossary section 3.14). All
                      (    forth6809.asm):14987         ; four words are pure state-setting/reading with no I/O
                      (    forth6809.asm):14988         ; involved, so none of this section's tests need the
                      (    forth6809.asm):14989         ; SERIALPOLL-conditional complexity used throughout the printing
                      (    forth6809.asm):14990         ; sections. Combined into one test, given each word's own
                      (    forth6809.asm):14991         ; effect is trivially verified by reading BASE directly - four
                      (    forth6809.asm):14992         ; separate tests would just repeat the same save/set/verify/
                      (    forth6809.asm):14993         ; restore shape four times over. TSTBASAV (added in section
                      (    forth6809.asm):14994         ; 3.13, when the real, pre-COLD BASE=0 bug was found and fixed)
                      (    forth6809.asm):14995         ; is reused here to save/restore the real BASE across this test
                      (    forth6809.asm):14996         ; too, per the same established reasoning.
                      (    forth6809.asm):14997         ; ------------------------------------------------------------
                      (    forth6809.asm):14998         
                      (    forth6809.asm):14999         ; ------------------------------------------------------------
                      (    forth6809.asm):15000         ; TSTBASE - combined unit test for BASE, DECIMAL, HEX, and
                      (    forth6809.asm):15001         ; BINARY. Sets BASE via each of HEX/BINARY/DECIMAL in turn,
                      (    forth6809.asm):15002         ; verifying the correct value lands each time, then calls BASE
                      (    forth6809.asm):15003         ; itself and verifies both that it returns the variable's own
                      (    forth6809.asm):15004         ; address (not its value, per "( -- addr )") and that reading
                      (    forth6809.asm):15005         ; through that address reflects DECIMAL's own, most recent
                      (    forth6809.asm):15006         ; setting (10).
                      (    forth6809.asm):15007         ; ------------------------------------------------------------
C2E5                  (    forth6809.asm):15008         TSTBASE: LDD  BASE
                      (    forth6809.asm):15009                  STD  TSTBASAV
                      (    forth6809.asm):15010         
                      (    forth6809.asm):15011                  STU  TSTU0
                      (    forth6809.asm):15012         
                      (    forth6809.asm):15013                  JSR  HEXW
                      (    forth6809.asm):15014                  LDD  BASE
                      (    forth6809.asm):15015                  CMPD #16
                      (    forth6809.asm):15016                  BNE  BSFAIL
                      (    forth6809.asm):15017         
                      (    forth6809.asm):15018                  JSR  BINARYW
                      (    forth6809.asm):15019                  LDD  BASE
                      (    forth6809.asm):15020                  CMPD #2
                      (    forth6809.asm):15021                  BNE  BSFAIL

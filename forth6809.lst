                      (    forth6809.asm):06393         
                      (    forth6809.asm):06394                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06395                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06396                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06397                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06398                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06399                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06400                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06401                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06402                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06403                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06404                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06405                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06406                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):06407                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):06408                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):06409                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):06410                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):06411                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):06412                    ; wrong algorithm entirely, not a smaller bug within it.
F8A3 DCA9             (    forth6809.asm):06413         UELOOP:    LDD  UESRCLEN
F8A5 2715             (    forth6809.asm):06414                    BEQ  UEDONE
F8A7 A680             (    forth6809.asm):06415                    LDA  ,X+
F8A9 8125             (    forth6809.asm):06416                    CMPA #'%'
F8AB 2604             (    forth6809.asm):06417                    BNE  UENOTPCT
F8AD C625             (    forth6809.asm):06418                    LDB  #'%'      ; write the extra '%' first - the character
F8AF E7A0             (    forth6809.asm):06419                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06420                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06421                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06422                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06423                                   ; independently for each one the loop visits.
F8B1 A7A0             (    forth6809.asm):06424         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06425                                   ; every character, '%' or not
F8B3 DCA9             (    forth6809.asm):06426                    LDD  UESRCLEN
F8B5 830001           (    forth6809.asm):06427                    SUBD #1
F8B8 DDA9             (    forth6809.asm):06428                    STD  UESRCLEN
F8BA 20E7             (    forth6809.asm):06429                    BRA  UELOOP
F8BC 1F20             (    forth6809.asm):06430         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F8BE 93AB             (    forth6809.asm):06431                    SUBD UEDST     ; overwriting whatever was left on top of
F8C0 DDAD             (    forth6809.asm):06432                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06433                                   ; required return values, and separately,
                      (    forth6809.asm):06434                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06435                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06436                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06437                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06438                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06439                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06440                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06441                                   ; correct regardless of how many characters
                      (    forth6809.asm):06442                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06443                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06444                                   ; incremented alongside it.
F8C2 DCAB             (    forth6809.asm):06445                    LDD  UEDST
F8C4 3606             (    forth6809.asm):06446                    PSHU D         ; push c-addr2 (destination address)
F8C6 DCAD             (    forth6809.asm):06447                    LDD  UEOUTLEN
F8C8 3606             (    forth6809.asm):06448                    PSHU D         ; push u2 (actual unescaped length)
F8CA 39               (    forth6809.asm):06449                    RTS
                      (    forth6809.asm):06450         

F846 DD1C             (    forth6809.asm):06996                     STD   HLD
F848 39               (    forth6809.asm):06997                     RTS
                      (    forth6809.asm):06998         
                      (    forth6809.asm):06999         ; ------------------------------------------------------------
                      (    forth6809.asm):07000         ; HOLD  ( char -- )
                      (    forth6809.asm):07001         ; Add char to the front of the pictured numeric output string.
                      (    forth6809.asm):07002         ; ------------------------------------------------------------
F849 3706             (    forth6809.asm):07003         HOLDW:      PULU  D                 ; char
F84B 9E1C             (    forth6809.asm):07004                     LDX   HLD
F84D 301F             (    forth6809.asm):07005                     LEAX  -1,X

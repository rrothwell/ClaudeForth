                      (    forth6809.asm):13135         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):13136         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):13137         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):13138         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):13139         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):13140         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):13141         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):13142         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):13143         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):13144         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):13145         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):13146         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):13147                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):13148                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):13149                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):13150                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):13151                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):13152                  FDB   ABORT
                      (    forth6809.asm):13153         
DEBE 04               (    forth6809.asm):13154         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):13155                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):13156                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):13157                  FDB   QUIT
                      (    forth6809.asm):13158         
                      (    forth6809.asm):13159         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):13160         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):13161         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):13162         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):13163         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):13164         ; reconstructs and pushes the original c-addr, then 0.

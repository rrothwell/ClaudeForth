E468 2641             (    forth6809.asm):03744                   BNE   NQBAD
                      (    forth6809.asm):03745         
                      (    forth6809.asm):03746                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03747                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03748                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03749                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03750                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03751                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03752                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03753                   ; high cell.
E46A 0D22             (    forth6809.asm):03754                   TST   NUMNEG
E46C 2718             (    forth6809.asm):03755                   BEQ   NQPOS32
E46E DC76             (    forth6809.asm):03756                   LDD   UDLO
E470 43               (    forth6809.asm):03757                   COMA
E471 53               (    forth6809.asm):03758                   COMB
E472 C30001           (    forth6809.asm):03759                   ADDD  #1
E475 DD76             (    forth6809.asm):03760                   STD   UDLO
E477 3401             (    forth6809.asm):03761                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03762                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03763                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03764                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03765                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03766                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03767                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03768                                      ; making the high-cell increment run
                      (    forth6809.asm):03769                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03770                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03771                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03772                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03773                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03774                                      ; matching "always increment" rather than
                      (    forth6809.asm):03775                                      ; "increment only on genuine carry".
E479 DC74             (    forth6809.asm):03776                   LDD   UDHI
E47B 43               (    forth6809.asm):03777                   COMA
E47C 53               (    forth6809.asm):03778                   COMB
E47D 3501             (    forth6809.asm):03779                   PULS  CC          ; restore the TRUE carry
E47F 2403             (    forth6809.asm):03780                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03781                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03782                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03783                                      ; value was computed in D but never
                      (    forth6809.asm):03784                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03785                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03786                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03787                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03788                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03789                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03790                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03791                                      ; alone would have made this second,
                      (    forth6809.asm):03792                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03793                                      ; only past the "+1", never past the
                      (    forth6809.asm):03794                                      ; store itself - the store always runs,
                      (    forth6809.asm):03795                                      ; either way.
E481 C30001           (    forth6809.asm):03796                   ADDD  #1
E484 DD74             (    forth6809.asm):03797         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03798         
E486                  (    forth6809.asm):03799         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03800                   ; was '.' - determines which return convention to use
E486 9E1F             (    forth6809.asm):03801                   LDX   CADDR
E488 E684             (    forth6809.asm):03802                   LDB   ,X
E48A 5A               (    forth6809.asm):03803                   DECB
E48B 3001             (    forth6809.asm):03804                   LEAX  1,X
E48D A685             (    forth6809.asm):03805                   LDA   B,X
E48F 812E             (    forth6809.asm):03806                   CMPA  #'.'
E491 260E             (    forth6809.asm):03807                   BNE   NQSINGLE
                      (    forth6809.asm):03808         
                      (    forth6809.asm):03809                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03810                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03811                   ; apart without needing a separate flag of its own either
E493 DC76             (    forth6809.asm):03812                   LDD   UDLO
E495 3606             (    forth6809.asm):03813                   PSHU  D
E497 DC74             (    forth6809.asm):03814                   LDD   UDHI
E499 3606             (    forth6809.asm):03815                   PSHU  D
E49B CC0001           (    forth6809.asm):03816                   LDD   #1
E49E 3606             (    forth6809.asm):03817                   PSHU  D
E4A0 39               (    forth6809.asm):03818                   RTS
                      (    forth6809.asm):03819         
E4A1                  (    forth6809.asm):03820         NQSINGLE: ; SINGLE success - unchanged from the original convention
E4A1 DC76             (    forth6809.asm):03821                   LDD   UDLO
E4A3 3606             (    forth6809.asm):03822                   PSHU  D
E4A5 CCFFFF           (    forth6809.asm):03823                   LDD   #-1
E4A8 3606             (    forth6809.asm):03824                   PSHU  D
E4AA 39               (    forth6809.asm):03825                   RTS
                      (    forth6809.asm):03826         

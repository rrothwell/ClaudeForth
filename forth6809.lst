FEDC 3606             (    forth6809.asm):08113                     PSHU  D
FEDE 39               (    forth6809.asm):08114                     RTS
                      (    forth6809.asm):08115         
                      (    forth6809.asm):08116         ; ------------------------------------------------------------
                      (    forth6809.asm):08117         ; -1  ( -- -1 )
                      (    forth6809.asm):08118         ; Push the constant -1.
                      (    forth6809.asm):08119         ; ------------------------------------------------------------
FEDF CCFFFF           (    forth6809.asm):08120         NEGONEW:    LDD   #-1
FEE2 3606             (    forth6809.asm):08121                     PSHU  D
FEE4 39               (    forth6809.asm):08122                     RTS
                      (    forth6809.asm):08123         
                      (    forth6809.asm):08124         ; ------------------------------------------------------------

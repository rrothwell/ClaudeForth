E5C1 2641             (    forth6809.asm):03136                   BNE   NQBAD
                      (    forth6809.asm):03137         
                      (    forth6809.asm):03138                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03139                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03140                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03141                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03142                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03143                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03144                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03145                   ; high cell.
E5C3 0D22             (    forth6809.asm):03146                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):03147                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):03148                   LDD   UDLO
E5C9 43               (    forth6809.asm):03149                   COMA
E5CA 53               (    forth6809.asm):03150                   COMB
E5CB C30001           (    forth6809.asm):03151                   ADDD  #1
E5CE DD76             (    forth6809.asm):03152                   STD   UDLO
E5D0 3401             (    forth6809.asm):03153                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03154                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03155                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03156                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03157                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03158                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03159                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03160                                      ; making the high-cell increment run
                      (    forth6809.asm):03161                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03162                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03163                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03164                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03165                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03166                                      ; matching "always increment" rather than
                      (    forth6809.asm):03167                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):03168                   LDD   UDHI
E5D4 43               (    forth6809.asm):03169                   COMA
E5D5 53               (    forth6809.asm):03170                   COMB
E5D6 3501             (    forth6809.asm):03171                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):03172                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03173                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03174                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03175                                      ; value was computed in D but never
                      (    forth6809.asm):03176                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03177                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03178                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03179                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03180                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03181                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03182                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03183                                      ; alone would have made this second,
                      (    forth6809.asm):03184                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03185                                      ; only past the "+1", never past the
                      (    forth6809.asm):03186                                      ; store itself - the store always runs,
                      (    forth6809.asm):03187                                      ; either way.
E5DA C30001           (    forth6809.asm):03188                   ADDD  #1
E5DD DD74             (    forth6809.asm):03189         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03190         
E5DF                  (    forth6809.asm):03191         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03192                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):03193                   LDX   CADDR
E5E1 E684             (    forth6809.asm):03194                   LDB   ,X
E5E3 5A               (    forth6809.asm):03195                   DECB
E5E4 3001             (    forth6809.asm):03196                   LEAX  1,X
E5E6 A685             (    forth6809.asm):03197                   LDA   B,X

DA99 3406             (    forth6809.asm):04650                     PSHS  D
DA9B 1F40             (    forth6809.asm):04651                     TFR   S,D
DA9D DD0C             (    forth6809.asm):04652                     STD   HANDLER
                      (    forth6809.asm):04653         
DA9F AD84             (    forth6809.asm):04654                     JSR   ,X
                      (    forth6809.asm):04655         
DAA1 3268             (    forth6809.asm):04656                     LEAS  8,S               ; drop saved input source

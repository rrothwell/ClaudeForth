                      (    forth6809.asm):02360         ; ------------------------------------------------------------
                      (    forth6809.asm):02361         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02362         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02363         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02364         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02365         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02366         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02367         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02368         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02369         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02370         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02371         ;
                      (    forth6809.asm):02372         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02373         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02374         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02375         ; right value once.
                      (    forth6809.asm):02376         ; ------------------------------------------------------------
C18F BDFC2B           (    forth6809.asm):02377         TSTRETSTACK: JSR CRW
C192 8EC1A3           (    forth6809.asm):02378                    LDX   #TSTRETMSG
C195 3610             (    forth6809.asm):02379                    PSHU  X
C197 CC0008           (    forth6809.asm):02380                    LDD   #8
C19A 3606             (    forth6809.asm):02381                    PSHU  D
C19C BDF60B           (    forth6809.asm):02382                    JSR   TYPE
C19F BDFC2B           (    forth6809.asm):02383                    JSR   CRW
                      (    forth6809.asm):02384         
                      (    forth6809.asm):02385                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02386         
                      (    forth6809.asm):02387                    JSR   TSTTOR
                      (    forth6809.asm):02388                    JSR   TSTRFETCH
                      (    forth6809.asm):02389                    JSR   TSTTWOTOR
                      (    forth6809.asm):02390                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02391         
                      (    forth6809.asm):02392                    ENDC ; <<<<
                      (    forth6809.asm):02393         
C1A2 39               (    forth6809.asm):02394                    RTS
                      (    forth6809.asm):02395         
C1A3 526574537461636B (    forth6809.asm):02396         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02397         
                      (    forth6809.asm):02398                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02399         
                      (    forth6809.asm):02400         ; ------------------------------------------------------------
                      (    forth6809.asm):02401         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02402         ; every other test group in this file, these words operate
                      (    forth6809.asm):02403         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02404         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02405         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02406         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02407         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02408         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02409         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02410         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02411         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02412         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02413         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02414         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02415         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02416         ; ------------------------------------------------------------
                      (    forth6809.asm):02417         
                      (    forth6809.asm):02418         ; ------------------------------------------------------------
                      (    forth6809.asm):02419         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02420         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02421         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02422         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02423         ; value would never actually have left.
                      (    forth6809.asm):02424         ; ------------------------------------------------------------
C1AB                  (    forth6809.asm):02425         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02426         
                      (    forth6809.asm):02427                  LDD   #TSTGUARD
                      (    forth6809.asm):02428                  PSHU  D
                      (    forth6809.asm):02429                  LDD   #TSTVAL1
                      (    forth6809.asm):02430                  PSHU  D
                      (    forth6809.asm):02431                  STU   TSTUB4
                      (    forth6809.asm):02432         
                      (    forth6809.asm):02433                  JSR   TOR
                      (    forth6809.asm):02434         
                      (    forth6809.asm):02435                  STU   TSTUMID
                      (    forth6809.asm):02436         
                      (    forth6809.asm):02437                  LDD   TSTUB4
                      (    forth6809.asm):02438                  SUBD  TSTUMID
                      (    forth6809.asm):02439                  CMPD  #-2
                      (    forth6809.asm):02440                  BNE   TRFAIL
                      (    forth6809.asm):02441         
                      (    forth6809.asm):02442                  JSR   FROMR
                      (    forth6809.asm):02443         
                      (    forth6809.asm):02444                  STU   TSTUAF
                      (    forth6809.asm):02445         
                      (    forth6809.asm):02446                  PULU  D
                      (    forth6809.asm):02447                  CMPD  #TSTVAL1
                      (    forth6809.asm):02448                  BNE   TRFAIL
                      (    forth6809.asm):02449                  PULU  D
                      (    forth6809.asm):02450                  CMPD  #TSTGUARD
                      (    forth6809.asm):02451                  BNE   TRFAIL
                      (    forth6809.asm):02452         
                      (    forth6809.asm):02453                  LDD   TSTUB4
                      (    forth6809.asm):02454                  SUBD  TSTUAF
                      (    forth6809.asm):02455                  CMPD  #0
                      (    forth6809.asm):02456                  BNE   TRFAIL
                      (    forth6809.asm):02457         
                      (    forth6809.asm):02458                  LDD   #TRUEV
                      (    forth6809.asm):02459                  BRA   TRDONE
C1AB                  (    forth6809.asm):02460         TRFAIL:  LDD   #FALSEV
C1AB                  (    forth6809.asm):02461         TRDONE:  LDX   #TSTTORNAME
                      (    forth6809.asm):02462                  PSHU  X
                      (    forth6809.asm):02463                  PSHU  D
                      (    forth6809.asm):02464                  JSR   TSTREPORT
                      (    forth6809.asm):02465         

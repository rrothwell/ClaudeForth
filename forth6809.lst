                      (    forth6809.asm):11903                   BNE  MV2FAIL
                      (    forth6809.asm):11904                   LDA  TSTCBUF+3
                      (    forth6809.asm):11905                   CMPA #'B'
                      (    forth6809.asm):11906                   BNE  MV2FAIL

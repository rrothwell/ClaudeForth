                      (    forth6809.asm):05705         ; ------------------------------------------------------------
DE57 CC0106           (    forth6809.asm):05706         TIBW:       LDD   #TIBBUF
DE5A 3606             (    forth6809.asm):05707                     PSHU  D
DE5C 39               (    forth6809.asm):05708                     RTS
                      (    forth6809.asm):05709         
                      (    forth6809.asm):05710         ; ------------------------------------------------------------
                      (    forth6809.asm):05711         ; #TIB  ( -- a-addr )

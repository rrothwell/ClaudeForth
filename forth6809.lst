                      (    forth6809.asm):02344         
CE93 8E0180           (    forth6809.asm):02345                     LDX   #INBUF            ; Pull character from the out buffer.
CE96 A685             (    forth6809.asm):02346                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02347         
CE98 5C               (    forth6809.asm):02348                     INCB                    ; Update the tail pointer
CE99 C43F             (    forth6809.asm):02349                     ANDB  #INBUFSZ-1        ; to point to the next character.

                      (    forth6809.asm):06701         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):06702         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):06703         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):06704         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):06705         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):06706         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):06707         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):06708         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):06709         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):06710         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):06711         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):06712         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):06713         ; ------------------------------------------------------------
C242                  (    forth6809.asm):06714         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):06715                   STD  TSTLSAV
                      (    forth6809.asm):06716                   LDD  CODEHERE
                      (    forth6809.asm):06717                   STD  TSTCSAV
                      (    forth6809.asm):06718         
                      (    forth6809.asm):06719                   LDA  #3
                      (    forth6809.asm):06720                   STA  TSTFHDR
                      (    forth6809.asm):06721                   LDA  #'F'
                      (    forth6809.asm):06722                   STA  TSTFHDR+1
                      (    forth6809.asm):06723                   LDA  #'O'
                      (    forth6809.asm):06724                   STA  TSTFHDR+2
                      (    forth6809.asm):06725                   LDA  #'O'
                      (    forth6809.asm):06726                   STA  TSTFHDR+3
                      (    forth6809.asm):06727                   LDD  #0
                      (    forth6809.asm):06728                   STD  TSTFHDR+4
                      (    forth6809.asm):06729                   LDD  #DUP
                      (    forth6809.asm):06730                   STD  TSTFHDR+6
                      (    forth6809.asm):06731         
                      (    forth6809.asm):06732                   LDD  #TSTFHDR
                      (    forth6809.asm):06733                   STD  LATEST
                      (    forth6809.asm):06734         
                      (    forth6809.asm):06735                   LDD  #TSTCBUF
                      (    forth6809.asm):06736                   STD  CODEHERE
                      (    forth6809.asm):06737         
                      (    forth6809.asm):06738                   JSR  RECURSE
                      (    forth6809.asm):06739         
                      (    forth6809.asm):06740                   LDD  #OPRTS
                      (    forth6809.asm):06741                   PSHU D
                      (    forth6809.asm):06742                   JSR  CCOMMA
                      (    forth6809.asm):06743         
                      (    forth6809.asm):06744                   LDD  TSTCSAV
                      (    forth6809.asm):06745                   STD  CODEHERE
                      (    forth6809.asm):06746                   LDD  TSTLSAV
                      (    forth6809.asm):06747                   STD  LATEST
                      (    forth6809.asm):06748         
                      (    forth6809.asm):06749                   STU  TSTU0
                      (    forth6809.asm):06750         
                      (    forth6809.asm):06751                   LDD  #TSTGUARD
                      (    forth6809.asm):06752                   PSHU D
                      (    forth6809.asm):06753                   LDD  #TSTVAL1
                      (    forth6809.asm):06754                   PSHU D
                      (    forth6809.asm):06755                   STU  TSTUB4
                      (    forth6809.asm):06756         

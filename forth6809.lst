                      (    forth6809.asm):02193                    PSHU  D
                      (    forth6809.asm):02194                    LDD   #TSTVAL2
                      (    forth6809.asm):02195                    PSHU  D
                      (    forth6809.asm):02196                    LDD   #TSTVAL3
                      (    forth6809.asm):02197                    PSHU  D
                      (    forth6809.asm):02198                    LDD   #2
                      (    forth6809.asm):02199                    PSHU  D
                      (    forth6809.asm):02200                    STU   TSTUB4
                      (    forth6809.asm):02201         
                      (    forth6809.asm):02202                    JSR   PICK
                      (    forth6809.asm):02203         
                      (    forth6809.asm):02204                    STU   TSTUAF
                      (    forth6809.asm):02205         
                      (    forth6809.asm):02206                    PULU  D
                      (    forth6809.asm):02207                    CMPD  #TSTVAL1
                      (    forth6809.asm):02208                    BNE   PKFAIL
                      (    forth6809.asm):02209                    PULU  D
                      (    forth6809.asm):02210                    CMPD  #TSTVAL3
                      (    forth6809.asm):02211                    BNE   PKFAIL
                      (    forth6809.asm):02212                    PULU  D
                      (    forth6809.asm):02213                    CMPD  #TSTVAL2
                      (    forth6809.asm):02214                    BNE   PKFAIL
                      (    forth6809.asm):02215                    PULU  D
                      (    forth6809.asm):02216                    CMPD  #TSTVAL1
                      (    forth6809.asm):02217                    BNE   PKFAIL
                      (    forth6809.asm):02218                    PULU  D
                      (    forth6809.asm):02219                    CMPD  #TSTGUARD
                      (    forth6809.asm):02220                    BNE   PKFAIL
                      (    forth6809.asm):02221         
                      (    forth6809.asm):02222                    LDD   TSTUB4
                      (    forth6809.asm):02223                    SUBD  TSTUAF
                      (    forth6809.asm):02224                    CMPD  #0
                      (    forth6809.asm):02225                    BNE   PKFAIL
                      (    forth6809.asm):02226         
                      (    forth6809.asm):02227                    LDD   #TRUEV
                      (    forth6809.asm):02228                    BRA   PKDONE
C195                  (    forth6809.asm):02229         PKFAIL:    LDD   #FALSEV
C195                  (    forth6809.asm):02230         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):02231                    PSHU  X
                      (    forth6809.asm):02232                    PSHU  D
                      (    forth6809.asm):02233                    JSR   TSTREPORT
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235                    LDU   TSTU0
                      (    forth6809.asm):02236                    RTS

F4F6 964F             (    forth6809.asm):06649                     LDA   SCNT
F4F8 A780             (    forth6809.asm):06650                     STA   ,X+
F4FA 109E51           (    forth6809.asm):06651                     LDY   SPTR
F4FD D64F             (    forth6809.asm):06652                     LDB   SCNT

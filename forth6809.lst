                      (    forth6809.asm):02655         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02656         ; Covers every word in that section, with representative
                      (    forth6809.asm):02657         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02658         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02659         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02660         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02661         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02662         ; cases chosen.
                      (    forth6809.asm):02663         ; ------------------------------------------------------------

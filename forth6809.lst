                      (    forth6809.asm):04112         ; Create a new wordlist and a word that makes it the first wordlist of
                      (    forth6809.asm):04113         ; the search order. The word's header is recorded for ORDER.
                      (    forth6809.asm):04114         ; Throws -8 when all the wordlists are in use.
                      (    forth6809.asm):04115         ; ------------------------------------------------------------
D737                  (    forth6809.asm):04116         VOCABULARYW:

                      (    forth6809.asm):04843                    JSR   TSTAND
                      (    forth6809.asm):04844                    JSR   TSTOR
                      (    forth6809.asm):04845                    JSR   TSTXOR
                      (    forth6809.asm):04846                    JSR   TSTINV
                      (    forth6809.asm):04847                    JSR   TSTLSH
                      (    forth6809.asm):04848                    JSR   TSTRSH
                      (    forth6809.asm):04849                    JSR   TSTCELS
                      (    forth6809.asm):04850                    JSR   TSTCELP
                      (    forth6809.asm):04851                    JSR   TSTCHRS
                      (    forth6809.asm):04852                    JSR   TSTCHRP
                      (    forth6809.asm):04853                    JSR   TSTALGD
                      (    forth6809.asm):04854                    JSR   TSTALGN

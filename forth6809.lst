                      (    forth6809.asm):01569                    PSHU  D
                      (    forth6809.asm):01570                    LDD   #TSTVAL2
                      (    forth6809.asm):01571                    PSHU  D
                      (    forth6809.asm):01572                    LDD   #TSTVAL3
                      (    forth6809.asm):01573                    PSHU  D
                      (    forth6809.asm):01574                    LDD   #2
                      (    forth6809.asm):01575                    PSHU  D
                      (    forth6809.asm):01576                    STU   TSTUB4
                      (    forth6809.asm):01577         
                      (    forth6809.asm):01578                    JSR   ROLL
                      (    forth6809.asm):01579         
                      (    forth6809.asm):01580                    STU   TSTUAF
                      (    forth6809.asm):01581         
                      (    forth6809.asm):01582                    PULU  D
                      (    forth6809.asm):01583                    CMPD  #TSTVAL1
                      (    forth6809.asm):01584                    BNE   RLFAIL
                      (    forth6809.asm):01585                    PULU  D
                      (    forth6809.asm):01586                    CMPD  #TSTVAL3
                      (    forth6809.asm):01587                    BNE   RLFAIL
                      (    forth6809.asm):01588                    PULU  D
                      (    forth6809.asm):01589                    CMPD  #TSTVAL2
                      (    forth6809.asm):01590                    BNE   RLFAIL
                      (    forth6809.asm):01591                    PULU  D
                      (    forth6809.asm):01592                    CMPD  #TSTGUARD
                      (    forth6809.asm):01593                    BNE   RLFAIL
                      (    forth6809.asm):01594         
                      (    forth6809.asm):01595                    LDD   TSTUB4
                      (    forth6809.asm):01596                    SUBD  TSTUAF
                      (    forth6809.asm):01597                    CMPD  #-2
                      (    forth6809.asm):01598                    BNE   RLFAIL
                      (    forth6809.asm):01599         
                      (    forth6809.asm):01600                    LDD   #TRUEV
                      (    forth6809.asm):01601                    BRA   RLDONE
C100                  (    forth6809.asm):01602         RLFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):01603         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):01604                    PSHU  X
                      (    forth6809.asm):01605                    PSHU  D
                      (    forth6809.asm):01606                    JSR   TSTREPORT
                      (    forth6809.asm):01607         
                      (    forth6809.asm):01608                    LDU   TSTU0
                      (    forth6809.asm):01609                    RTS
                      (    forth6809.asm):01610         
C100                  (    forth6809.asm):01611         TSTROLLNAME: FCB  7
                      (    forth6809.asm):01612                      FCC  "TSTROLL"
                      (    forth6809.asm):01613         

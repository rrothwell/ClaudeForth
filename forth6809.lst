                      (    forth6809.asm):14422                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):14423                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):14424                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):14425                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):14426                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):14427                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):14428                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):14429                   ; high cell.
E5C3 0D22             (    forth6809.asm):14430                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):14431                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):14432                   LDD   UDLO
E5C9 43               (    forth6809.asm):14433                   COMA
E5CA 53               (    forth6809.asm):14434                   COMB
E5CB C30001           (    forth6809.asm):14435                   ADDD  #1
E5CE DD76             (    forth6809.asm):14436                   STD   UDLO
E5D0 3401             (    forth6809.asm):14437                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):14438                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):14439                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):14440                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):14441                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):14442                                      ; silently overwrote the real carry here
                      (    forth6809.asm):14443                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):14444                                      ; making the high-cell increment run
                      (    forth6809.asm):14445                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):14446                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):14447                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):14448                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):14449                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):14450                                      ; matching "always increment" rather than
                      (    forth6809.asm):14451                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):14452                   LDD   UDHI
E5D4 43               (    forth6809.asm):14453                   COMA
E5D5 53               (    forth6809.asm):14454                   COMB
E5D6 3501             (    forth6809.asm):14455                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):14456                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):14457                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):14458                                      ; when there's no carry - the complemented
                      (    forth6809.asm):14459                                      ; value was computed in D but never
                      (    forth6809.asm):14460                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):14461                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):14462                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):14463                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):14464                                      ; was always seen as set, so this branch
                      (    forth6809.asm):14465                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):14466                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):14467                                      ; alone would have made this second,
                      (    forth6809.asm):14468                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):14469                                      ; only past the "+1", never past the
                      (    forth6809.asm):14470                                      ; store itself - the store always runs,
                      (    forth6809.asm):14471                                      ; either way.
E5DA C30001           (    forth6809.asm):14472                   ADDD  #1
E5DD DD74             (    forth6809.asm):14473         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):14474         

                      (    forth6809.asm):05290         ; ------------------------------------------------------------
                      (    forth6809.asm):05291         ; Common part of /, MOD and /MOD: divide n1 by n2 with the sign
                      (    forth6809.asm):05292         ; handling for truncating division. THROW -10 if n2 is zero.
                      (    forth6809.asm):05293         ; DIVCOMMON   ( n1 n2 -- )
                      (    forth6809.asm):05294         ;    Inputs:
                      (    forth6809.asm):05295         ;        n1 and n2 on the data stack (n2 on top)
                      (    forth6809.asm):05296         ;    Outputs:
                      (    forth6809.asm):05297         ;        DIVNUM = quotient, DIVREM = remainder (data stack popped)
                      (    forth6809.asm):05298         ;    Registers: RegD changed; DIVNUM, DIVDEN, DIVREM, DNSIGN, DVSIGN

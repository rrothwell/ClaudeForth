                      (    forth6809.asm):00721                              ; GLOBALS page is now
                      (    forth6809.asm):00722                              ; fully packed bar 1: 255 of 256 bytes used, 1 free.
                      (    forth6809.asm):00723         
     00FF             (    forth6809.asm):00724         GLOBALS_USED EQU 255  ; total bytes used, of 256 available - nearly fully packed
                      (    forth6809.asm):00725         
                      (    forth6809.asm):00726         ; ------------------------------------------------------------
                      (    forth6809.asm):00727         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00728         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00729         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00730         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00731         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00732         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00733         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00734         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00735         ;
                      (    forth6809.asm):00736         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00737         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00738         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00739         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00740         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00741         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00742         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00743         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00744         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00745         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00746         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00747         ; ------------------------------------------------------------
                      (    forth6809.asm):00748                  ORG   $0100
0100                  (    forth6809.asm):00749         MVCNT    RMB   2
0102                  (    forth6809.asm):00750         MVDST    RMB   2
0104                  (    forth6809.asm):00751         MVSRC    RMB   2
     0100             (    forth6809.asm):00752         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00753         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00754         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00755         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00756         
                      (    forth6809.asm):00757         ; ------------------------------------------------------------
                      (    forth6809.asm):00758         ; Ring buffers for serial communications.
                      (    forth6809.asm):00759         ; One for input, one for output.
                      (    forth6809.asm):00760         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00761         ; The tricks are not used.
                      (    forth6809.asm):00762         ; ------------------------------------------------------------
                      (    forth6809.asm):00763                     ORG   SERBUFCTL    ; $176.
                      (    forth6809.asm):00764         
0176                  (    forth6809.asm):00765         INHEAD      RMB  1
0177                  (    forth6809.asm):00766         INTAIL      RMB  1
                      (    forth6809.asm):00767         ; RTSSTATE -> INREQUEST ?
0178                  (    forth6809.asm):00768         RTSSTATE   RMB  1  ; $00 = RTS Low (Clear), $FF = RTS High (Throttle) 
                      (    forth6809.asm):00769         
0179                  (    forth6809.asm):00770         OUTHEAD     RMB  1
017A                  (    forth6809.asm):00771         OUTTAIL     RMB  1
017B                  (    forth6809.asm):00772         OUTACTIVITY RMB  1  ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00773         
017C                  (    forth6809.asm):00774         FECOUNT     RMB  1  ; framing-error count, incremented by IRQH (interrupt
                      (    forth6809.asm):00775                             ; build) or by polling KEY (polling build - see below)
017D                  (    forth6809.asm):00776         OVRNCOUNT   RMB  1  ; overrun count, same as above
017E                  (    forth6809.asm):00777         PECOUNT     RMB  1  ; parity-error count, same as above
017F                  (    forth6809.asm):00778         POLLREADYCNT RMB 1  ; polling build only: counts every KEY call that found
                      (    forth6809.asm):00779                             ; RDRF already set on its very first check, before
                      (    forth6809.asm):00780                             ; spinning at all - i.e. a character was already
                      (    forth6809.asm):00781                             ; sitting queued when we came back to poll for it.
                      (    forth6809.asm):00782                             ; A high count relative to total characters received
                      (    forth6809.asm):00783                             ; is evidence the host is running ahead of what the
                      (    forth6809.asm):00784                             ; 6809 has actually consumed (a transport-buffered
                      (    forth6809.asm):00785                             ; backlog), distinct from a genuine ACIA overrun
                      (    forth6809.asm):00786                             ; (which OVRNCOUNT would show instead) - last free
                      (    forth6809.asm):00787                             ; byte in this block, right before SERBUF's 64-byte
                      (    forth6809.asm):00788                             ; alignment at $0180.
                      (    forth6809.asm):00789         
                      (    forth6809.asm):00790                     ORG   SERBUF    ; $180, a 64 byte boundary.
                      (    forth6809.asm):00791         
                      (    forth6809.asm):00792                     ALIGN 64       ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00793         INBUF       RMB INBUFSZ     ; Receive circular queue buffer
                      (    forth6809.asm):00794         
                      (    forth6809.asm):00795                     ALIGN 64       ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00796         OUTBUF      RMB OUTBUFSZ    ; Transmit circular queue buffer
                      (    forth6809.asm):00797         
                      (    forth6809.asm):00798         ; ------------------------------------------------------------
                      (    forth6809.asm):00799         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00800         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00801         ; ------------------------------------------------------------
                      (    forth6809.asm):00802                  ORG USROMSTRT
                      (    forth6809.asm):00803         
                      (    forth6809.asm):00804                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00805         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00806                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00807                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00808                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00809                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00810                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00811                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00812                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00813                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00814                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00815                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00816                           ; choice is made, not what including it does.
                      (    forth6809.asm):00817                    ENDC
                      (    forth6809.asm):00818         
                      (    forth6809.asm):00819                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00820         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00821                    ENDC
                      (    forth6809.asm):00822         
                      (    forth6809.asm):00823                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00824         
                      (    forth6809.asm):00825         ; ------------------------------------------------------------
                      (    forth6809.asm):00826         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00827         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00828         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00829         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00830         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00831         ; ------------------------------------------------------------
                      (    forth6809.asm):00832                  INCLUDE unit_tests.asm
                      (    forth6809.asm):00833         
                      (    forth6809.asm):00834                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00835         
C100                  (    forth6809.asm):00836         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00837                  FILL $FF,BASEDICT-ROM

                      (    forth6809.asm):08191         
                      (    forth6809.asm):08192                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):08193                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):08194                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):08195                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):08196                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):08197                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):08198                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):08199                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):08200                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):08201                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):08202                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):08203                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):08204                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):08205                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):08206                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):08207                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):08208                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):08209                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):08210                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):08211                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):08212                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):08213                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):08214                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):08215                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):08216                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):08217                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):08218                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):08219                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):08220                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):08221                                  ; too, not just the eventual interactive
                      (    forth6809.asm):08222                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):08223                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):08224                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):08225                                  ; nothing on this system ever drives it
                      (    forth6809.asm):08226                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):08227                                  ; unused vectors).
                      (    forth6809.asm):08228         
                      (    forth6809.asm):08229                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):08230                  JSR   TSTRUNNER
                      (    forth6809.asm):08231                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08232                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):08233                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):08234                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):08235                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):08236                                  ; excluded the test framework, meaning
                      (    forth6809.asm):08237                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):08238                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):08239                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):08240                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):08241                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):08242                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):08243                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):08244                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):08245                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):08246                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):08247                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):08248         
FFC2 7EDD90           (    forth6809.asm):08249                  JMP   COLD
                      (    forth6809.asm):08250         
FFC5 1A50             (    forth6809.asm):08251         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08252                  CLRA
FFC8 1F8B             (    forth6809.asm):08253                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08254                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08255                  LDS   #RP0
                      (    forth6809.asm):08256         
FFD1 BDDD73           (    forth6809.asm):08257                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):08258                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):08259                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):08260                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):08261                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):08262                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):08263                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):08264                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):08265                                         ; reported separately) left either side
                      (    forth6809.asm):08266                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):08267                                         ; would previously have inherited it
                      (    forth6809.asm):08268                                         ; unchanged rather than genuinely
                      (    forth6809.asm):08269                                         ; recovering. Placed here, matching
                      (    forth6809.asm):08270                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):08271                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):08272                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):08273                                         ; only once setup is complete.
                      (    forth6809.asm):08274         
FFD4 8EFFE6           (    forth6809.asm):08275                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08276                  PSHU  X
FFD9 CC0006           (    forth6809.asm):08277                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08278                  PSHU  D
FFDE BDF5A5           (    forth6809.asm):08279                  JSR   TYPE
FFE1 1CAF             (    forth6809.asm):08280                  ANDCC #$AF
FFE3 7EDDCF           (    forth6809.asm):08281                  JMP   ABORT      ; Enable IRQ & FIRQ
                      (    forth6809.asm):08282         
FFE6 20207761726D     (    forth6809.asm):08283         WARMMSG: FCC   "  warm"
     0006             (    forth6809.asm):08284         WARMMSGL EQU   *-WARMMSG
                      (    forth6809.asm):08285         
     FFEC             (    forth6809.asm):08286         INITEND  EQU   *          ; Verify no collision with vectors, value should match vector ORG
     0048             (    forth6809.asm):08287         INITSIZE EQU   INITEND-INITCODE
                      (    forth6809.asm):08288         
                      (    forth6809.asm):08289         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08290         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08291         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):08292                  FILL $FF,VECTORS-INITEND
                      (    forth6809.asm):08293         
                      (    forth6809.asm):08294         ; ============================================================
                      (    forth6809.asm):08295         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):08296         ; ============================================================
                      (    forth6809.asm):08297                  ORG   VECTORS       ; VECTORS is $FFF0
FFF0 0000             (    forth6809.asm):08298         VRESV    FDB   $0000
FFF2 DD84             (    forth6809.asm):08299         VSWI3    FDB   SWI3H
FFF4 DD85             (    forth6809.asm):08300         VSWI2    FDB   SWI2H
FFF6 DD86             (    forth6809.asm):08301         VFIRQ    FDB   FIRQH
FFF8 DD83             (    forth6809.asm):08302         VIRQ     FDB   IRQH
FFFA DD88             (    forth6809.asm):08303         VSWI     FDB   SWIH
FFFC FFC5             (    forth6809.asm):08304         VNMI     FDB   WARM            ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):08305         VRESET   FDB   COLDSTRT
                      (    forth6809.asm):08306         
     0000             (    forth6809.asm):08307         VECTOREND  EQU   *          ; Verify vectors size, value should match $10.
     0010             (    forth6809.asm):08308         VECTORSIZE EQU   VECTOREND-VECTORS
                      (    forth6809.asm):08309         
                      (    forth6809.asm):08310         ; ============================================================
                      (    forth6809.asm):08311         ; END OF CONSOLIDATED SOURCE
                      (    forth6809.asm):08312         ; ============================================================

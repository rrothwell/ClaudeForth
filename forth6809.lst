                      (    forth6809.asm):03950         ; DO  ( C: -- dest )
                      (    forth6809.asm):03951         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03952         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03953         ; ------------------------------------------------------------
E816 CCE828           (    forth6809.asm):03954         DOW:        LDD   #DOSETUP
E819 3606             (    forth6809.asm):03955                     PSHU  D

E7E5 3410             (    forth6809.asm):03902                     PSHS  X
E7E7 39               (    forth6809.asm):03903                     RTS
                      (    forth6809.asm):03904         
                      (    forth6809.asm):03905         ; ------------------------------------------------------------
                      (    forth6809.asm):03906         ; I  ( -- n )
                      (    forth6809.asm):03907         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):03908         ; address).
                      (    forth6809.asm):03909         ; ------------------------------------------------------------
E7E8 EC62             (    forth6809.asm):03910         IW:         LDD   2,S               ; n. See bugfix: IW.1
E7EA 3606             (    forth6809.asm):03911                     PSHU  D
E7EC 39               (    forth6809.asm):03912                     RTS
                      (    forth6809.asm):03913         
                      (    forth6809.asm):03914         ; ------------------------------------------------------------
                      (    forth6809.asm):03915         ; J  ( -- n )
                      (    forth6809.asm):03916         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):03917         ; address and the inner loop frame).
                      (    forth6809.asm):03918         ; ------------------------------------------------------------
E7ED EC68             (    forth6809.asm):03919         JW:         LDD   8,S               ; n. See bugfix: JW.1
E7EF 3606             (    forth6809.asm):03920                     PSHU  D
E7F1 39               (    forth6809.asm):03921                     RTS
                      (    forth6809.asm):03922         
                      (    forth6809.asm):03923         ; ------------------------------------------------------------
                      (    forth6809.asm):03924         ; LEAVE  ( -- )
                      (    forth6809.asm):03925         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):03926         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):03927         ; ------------------------------------------------------------
E7F2 CCFFFF           (    forth6809.asm):03928         LEAVEW:     LDD   #TRUEV            ; true
E7F5 ED66             (    forth6809.asm):03929                     STD   6,S               ; See bugfix: LEAVEW.1
E7F7 39               (    forth6809.asm):03930                     RTS
                      (    forth6809.asm):03931         
                      (    forth6809.asm):03932         ; ------------------------------------------------------------
                      (    forth6809.asm):03933         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):03934         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):03935         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):03936         ; ------------------------------------------------------------
E7F8 3706             (    forth6809.asm):03937         LOOPW:      PULU  D
E7FA 10830003         (    forth6809.asm):03938                     CMPD  #TAGDO
E7FE 2703             (    forth6809.asm):03939                     BEQ   LOOPOK
E800 BDE5C9           (    forth6809.asm):03940                     JSR   CFERR
E803 3706             (    forth6809.asm):03941         LOOPOK:     PULU  D                 ; dest
E805 3606             (    forth6809.asm):03942                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E807 CCE837           (    forth6809.asm):03943                     LDD   #DOTEST
E80A 3606             (    forth6809.asm):03944                     PSHU  D
E80C BDEA39           (    forth6809.asm):03945                     JSR   CCALL
E80F CC0000           (    forth6809.asm):03946                     LDD   #0
E812 3606             (    forth6809.asm):03947                     PSHU  D
E814 BDDFFA           (    forth6809.asm):03948                     JSR   CODECOMMA
E817 DC08             (    forth6809.asm):03949                     LDD   CODEHERE
E819 830002           (    forth6809.asm):03950                     SUBD  #2
E81C 3606             (    forth6809.asm):03951                     PSHU  D                 ; location; the parked dest is beneath
E81E BDE633           (    forth6809.asm):03952                     JSR   PATCH
                      (    forth6809.asm):03953         
E821 ECC4             (    forth6809.asm):03954                     LDD   ,U
E823 10830007         (    forth6809.asm):03955                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E827 260D             (    forth6809.asm):03956                     BNE   LOOPDONE
E829 3706             (    forth6809.asm):03957                     PULU  D
E82B 3710             (    forth6809.asm):03958                     PULU  X                 ; ?DO skip operand
E82D DC08             (    forth6809.asm):03959                     LDD   CODEHERE
E82F 3606             (    forth6809.asm):03960                     PSHU  D
E831 3610             (    forth6809.asm):03961                     PSHU  X
E833 BDE633           (    forth6809.asm):03962                     JSR   PATCH
E836 39               (    forth6809.asm):03963         LOOPDONE:   RTS
                      (    forth6809.asm):03964         
                      (    forth6809.asm):03965         ; ------------------------------------------------------------
                      (    forth6809.asm):03966         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):03967         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):03968         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):03969         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):03970         ; DOTEST
                      (    forth6809.asm):03971         ;    Inputs:
                      (    forth6809.asm):03972         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):03973         ;        first)
                      (    forth6809.asm):03974         ;    Outputs:
                      (    forth6809.asm):03975         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):03976         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03977         ; ------------------------------------------------------------
E837 EC66             (    forth6809.asm):03978         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E839 2615             (    forth6809.asm):03979                     BNE   DTEXIT            ; set: exit
E83B EC62             (    forth6809.asm):03980                     LDD   2,S               ; index
E83D C30001           (    forth6809.asm):03981                     ADDD  #1
E840 ED62             (    forth6809.asm):03982                     STD   2,S
E842 10A364           (    forth6809.asm):03983                     CMPD  4,S               ; limit
E845 2709             (    forth6809.asm):03984                     BEQ   DTEXIT
E847 3510             (    forth6809.asm):03985                     PULS  X                 ; X = branch operand address
E849 EC84             (    forth6809.asm):03986                     LDD   ,X
E84B 308B             (    forth6809.asm):03987                     LEAX  D,X
E84D 3410             (    forth6809.asm):03988                     PSHS  X                 ; return to loop start
E84F 39               (    forth6809.asm):03989                     RTS
E850 3510             (    forth6809.asm):03990         DTEXIT:     PULS  X
E852 3002             (    forth6809.asm):03991                     LEAX  2,X               ; skip the branch operand
E854 3266             (    forth6809.asm):03992                     LEAS  6,S               ; discard the loop frame
E856 3410             (    forth6809.asm):03993                     PSHS  X
E858 39               (    forth6809.asm):03994                     RTS
                      (    forth6809.asm):03995         
                      (    forth6809.asm):03996         ; ------------------------------------------------------------
                      (    forth6809.asm):03997         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):03998         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):03999         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04000         ; ------------------------------------------------------------
E859 3706             (    forth6809.asm):04001         PLUSLOOPW:  PULU  D
E85B 10830003         (    forth6809.asm):04002                     CMPD  #TAGDO
E85F 2703             (    forth6809.asm):04003                     BEQ   PLOOPOK
E861 BDE5C9           (    forth6809.asm):04004                     JSR   CFERR
E864 3706             (    forth6809.asm):04005         PLOOPOK:    PULU  D                 ; dest
E866 3606             (    forth6809.asm):04006                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E868 CCE898           (    forth6809.asm):04007                     LDD   #DOPLUSTEST
E86B 3606             (    forth6809.asm):04008                     PSHU  D
E86D BDEA39           (    forth6809.asm):04009                     JSR   CCALL
E870 CC0000           (    forth6809.asm):04010                     LDD   #0
E873 3606             (    forth6809.asm):04011                     PSHU  D
E875 BDDFFA           (    forth6809.asm):04012                     JSR   CODECOMMA
E878 DC08             (    forth6809.asm):04013                     LDD   CODEHERE
E87A 830002           (    forth6809.asm):04014                     SUBD  #2
E87D 3606             (    forth6809.asm):04015                     PSHU  D                 ; location; the parked dest is beneath
E87F BDE633           (    forth6809.asm):04016                     JSR   PATCH
                      (    forth6809.asm):04017         
E882 ECC4             (    forth6809.asm):04018                     LDD   ,U
E884 10830007         (    forth6809.asm):04019                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
E888 260D             (    forth6809.asm):04020                     BNE   PLOOPDONE
E88A 3706             (    forth6809.asm):04021                     PULU  D
E88C 3710             (    forth6809.asm):04022                     PULU  X                 ; ?DO skip operand
E88E DC08             (    forth6809.asm):04023                     LDD   CODEHERE
E890 3606             (    forth6809.asm):04024                     PSHU  D
E892 3610             (    forth6809.asm):04025                     PSHU  X
E894 BDE633           (    forth6809.asm):04026                     JSR   PATCH
E897 39               (    forth6809.asm):04027         PLOOPDONE:  RTS
                      (    forth6809.asm):04028         
                      (    forth6809.asm):04029         ; ------------------------------------------------------------
                      (    forth6809.asm):04030         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04031         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04032         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04033         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04034         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04035         ;    Inputs:
                      (    forth6809.asm):04036         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04037         ;    Outputs:
                      (    forth6809.asm):04038         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04039         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04040         ;        scratch.
                      (    forth6809.asm):04041         ; ------------------------------------------------------------
E898 3706             (    forth6809.asm):04042         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E89A DD14             (    forth6809.asm):04043                     STD   MSCR              ; MSCR = step
E89C EC66             (    forth6809.asm):04044                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E89E 262D             (    forth6809.asm):04045                     BNE   DPTEXIT           ; set: exit
E8A0 EC62             (    forth6809.asm):04046                     LDD   2,S               ; old index
E8A2 A364             (    forth6809.asm):04047                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E8A4 DD16             (    forth6809.asm):04048                     STD   MSCR2
E8A6 EC62             (    forth6809.asm):04049                     LDD   2,S
E8A8 D314             (    forth6809.asm):04050                     ADDD  MSCR              ; new_index = old_index + step
E8AA ED62             (    forth6809.asm):04051                     STD   2,S
E8AC A364             (    forth6809.asm):04052                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E8AE DD18             (    forth6809.asm):04053                     STD   MSCR3
                      (    forth6809.asm):04054                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04055                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04056                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E8B0 DC14             (    forth6809.asm):04057                     LDD   MSCR              ; reload the step to test its sign
E8B2 2B09             (    forth6809.asm):04058                     BMI   DPNEG
E8B4 DC18             (    forth6809.asm):04059         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E8B6 109316           (    forth6809.asm):04060                     CMPD  MSCR2
E8B9 2512             (    forth6809.asm):04061                     BLO   DPTEXIT
E8BB 2007             (    forth6809.asm):04062                     BRA   DPCONT
E8BD DC18             (    forth6809.asm):04063         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E8BF 109316           (    forth6809.asm):04064                     CMPD  MSCR2
E8C2 2209             (    forth6809.asm):04065                     BHI   DPTEXIT
E8C4 3510             (    forth6809.asm):04066         DPCONT:     PULS  X                 ; X = branch operand address
E8C6 EC84             (    forth6809.asm):04067                     LDD   ,X
E8C8 308B             (    forth6809.asm):04068                     LEAX  D,X
E8CA 3410             (    forth6809.asm):04069                     PSHS  X
E8CC 39               (    forth6809.asm):04070                     RTS
E8CD 3510             (    forth6809.asm):04071         DPTEXIT:    PULS  X
E8CF 3002             (    forth6809.asm):04072                     LEAX  2,X               ; skip the branch operand
E8D1 3266             (    forth6809.asm):04073                     LEAS  6,S               ; discard the loop frame
E8D3 3410             (    forth6809.asm):04074                     PSHS  X
E8D5 39               (    forth6809.asm):04075                     RTS
                      (    forth6809.asm):04076         
                      (    forth6809.asm):04077         ; ------------------------------------------------------------
                      (    forth6809.asm):04078         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):04079         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):04080         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):04081         ; ------------------------------------------------------------
E8D6 CCE8FC           (    forth6809.asm):04082         QDOW:       LDD   #QDOSETUP
E8D9 3606             (    forth6809.asm):04083                     PSHU  D
E8DB BDEA39           (    forth6809.asm):04084                     JSR   CCALL
E8DE CC0000           (    forth6809.asm):04085                     LDD   #0
E8E1 3606             (    forth6809.asm):04086                     PSHU  D
E8E3 BDDFFA           (    forth6809.asm):04087                     JSR   CODECOMMA
E8E6 DC08             (    forth6809.asm):04088                     LDD   CODEHERE
E8E8 830002           (    forth6809.asm):04089                     SUBD  #2
E8EB 3606             (    forth6809.asm):04090                     PSHU  D                 ; orig
E8ED CC0007           (    forth6809.asm):04091                     LDD   #TAGQDO           ; See bugfix: QDOW.1
E8F0 3606             (    forth6809.asm):04092                     PSHU  D
E8F2 DC08             (    forth6809.asm):04093                     LDD   CODEHERE
E8F4 3606             (    forth6809.asm):04094                     PSHU  D                 ; dest

                      (    forth6809.asm):08182         
FFBD 1CAF             (    forth6809.asm):08183                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08184         
                      (    forth6809.asm):08185                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08186         
                      (    forth6809.asm):08187                     IFNE  UNITTESTS         ; >>>>>>>>>>
FFBF BDC135           (    forth6809.asm):08188                     JSR   TSTRUNNER
                      (    forth6809.asm):08189                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):08190                     NOP                     ; same size as JSR TSTRUNNER
                      (    forth6809.asm):08191                     NOP                     ; See bugfix: COLDSTRT.2
                      (    forth6809.asm):08192                     NOP
                      (    forth6809.asm):08193                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08194         
FFC2 7EDD90           (    forth6809.asm):08195                     JMP   COLD

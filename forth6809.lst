                      (    forth6809.asm):08124         ; ============================================================
                      (    forth6809.asm):08125         ; SECTION 2: INIT CODE (COLDSTRT / WARM)
                      (    forth6809.asm):08126         ; ============================================================
                      (    forth6809.asm):08127                     ORG   INITCODE          ; init code block
                      (    forth6809.asm):08128         
                      (    forth6809.asm):08129         ; ------------------------------------------------------------
                      (    forth6809.asm):08130         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08131         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08132         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08133         ; enter COLD.
                      (    forth6809.asm):08134         ; COLDSTRT
                      (    forth6809.asm):08135         ;    Inputs:
                      (    forth6809.asm):08136         ;        hardware reset
                      (    forth6809.asm):08137         ;    Outputs:
                      (    forth6809.asm):08138         ;        does not return
                      (    forth6809.asm):08139         ;    Registers: all registers initialised.
                      (    forth6809.asm):08140         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08141         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08142                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08143                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08144                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08145                     CLRA
FFAE 1F8B             (    forth6809.asm):08146                     TFR   A,DP
                      (    forth6809.asm):08147         
FFB0 8E0000           (    forth6809.asm):08148                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08149                     LDB   #0
FFB5 6F80             (    forth6809.asm):08150         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):08151                     DECB
FFB8 26FB             (    forth6809.asm):08152                     BNE   CLRGLOB
                      (    forth6809.asm):08153         
FFBA BDDCE3           (    forth6809.asm):08154                     JSR   INITSERIAL
                      (    forth6809.asm):08155         
FFBD 1CAF             (    forth6809.asm):08156                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08157         
                      (    forth6809.asm):08158                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08159         
                      (    forth6809.asm):08160                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08161                     JSR   TSTRUNNER
                      (    forth6809.asm):08162                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08163                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08164                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):08165                     NOP
                      (    forth6809.asm):08166                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08167         
FFC2 7EDD00           (    forth6809.asm):08168                     JMP   COLD
                      (    forth6809.asm):08169         
                      (    forth6809.asm):08170         ; ------------------------------------------------------------
                      (    forth6809.asm):08171         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08172         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08173         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08174         ; WARM
                      (    forth6809.asm):08175         ;    Inputs:
                      (    forth6809.asm):08176         ;        NMI
                      (    forth6809.asm):08177         ;    Outputs:
                      (    forth6809.asm):08178         ;        does not return
                      (    forth6809.asm):08179         ;    Registers: all registers initialised.
                      (    forth6809.asm):08180         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):08181         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08182                     CLRA
FFC8 1F8B             (    forth6809.asm):08183                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08184                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08185                     LDS   #RP0
                      (    forth6809.asm):08186         
FFD1 BDDCE3           (    forth6809.asm):08187                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):08188         
FFD4 8EFFE6           (    forth6809.asm):08189                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08190                     PSHU  X
FFD9 CC0006           (    forth6809.asm):08191                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08192                     PSHU  D
FFDE BDF490           (    forth6809.asm):08193                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):08194                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE3 7EDD3F           (    forth6809.asm):08195                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):08196         
FFE6 20207761726D     (    forth6809.asm):08197         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):08198         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):08199         
                      (    forth6809.asm):08200                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEC             (    forth6809.asm):08201         INITEND     EQU   *
     0048             (    forth6809.asm):08202         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08203         
                      (    forth6809.asm):08204         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08205         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08206         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):08207                     FILL  $FF,VECTORS-INITEND
                      (    forth6809.asm):08208         
                      (    forth6809.asm):08209         ; ============================================================
                      (    forth6809.asm):08210         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):08211         ; ============================================================
                      (    forth6809.asm):08212                     ORG   VECTORS           ; hardware vector table
FFF0 0000             (    forth6809.asm):08213         VRESV       FDB   $0000
FFF2 DCF4             (    forth6809.asm):08214         VSWI3       FDB   SWI3H             ; SWI3
FFF4 DCF5             (    forth6809.asm):08215         VSWI2       FDB   SWI2H             ; SWI2
FFF6 DCF6             (    forth6809.asm):08216         VFIRQ       FDB   FIRQH             ; FIRQ
FFF8 DCF3             (    forth6809.asm):08217         VIRQ        FDB   IRQH              ; IRQ
FFFA DCF8             (    forth6809.asm):08218         VSWI        FDB   SWIH              ; SWI
FFFC FFC5             (    forth6809.asm):08219         VNMI        FDB   WARM              ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):08220         VRESET      FDB   COLDSTRT          ; reset
                      (    forth6809.asm):08221         
     0000             (    forth6809.asm):08222         VECTOREND   EQU   *                 ; vectors size, should be $10
     0010             (    forth6809.asm):08223         VECTORSIZE  EQU   VECTOREND-VECTORS
                      (    forth6809.asm):08224         

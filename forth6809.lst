                      (    forth6809.asm):01787                     STA  ACIACR
E035                  (    forth6809.asm):01788         RTSCLOUNMASK: ANDCC #$EF
E035                  (    forth6809.asm):01789         RTSCLODONE: RTS
                      (    forth6809.asm):01790         

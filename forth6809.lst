                      (    forth6809.asm):06270         
                      (    forth6809.asm):06271                  LDD   #111
                      (    forth6809.asm):06272                  PSHU  D
                      (    forth6809.asm):06273                  JSR   LITERALW
                      (    forth6809.asm):06274         
                      (    forth6809.asm):06275                  JSR   THEN
                      (    forth6809.asm):06276         
                      (    forth6809.asm):06277                  LDD   #OPRTS
                      (    forth6809.asm):06278                  PSHU  D
                      (    forth6809.asm):06279                  JSR   CCOMMA
                      (    forth6809.asm):06280         
                      (    forth6809.asm):06281                  LDD   TSTCSAV
                      (    forth6809.asm):06282                  STD   CODEHERE
                      (    forth6809.asm):06283         
                      (    forth6809.asm):06284                  STU   TSTU0
                      (    forth6809.asm):06285         
                      (    forth6809.asm):06286                  LDD   #TSTGUARD
                      (    forth6809.asm):06287                  PSHU  D
                      (    forth6809.asm):06288                  LDD   #TRUEV
                      (    forth6809.asm):06289                  PSHU  D
                      (    forth6809.asm):06290                  STU   TSTUB4
                      (    forth6809.asm):06291         
                      (    forth6809.asm):06292                  JSR   TSTCBUF
                      (    forth6809.asm):06293         
                      (    forth6809.asm):06294                  STU   TSTUAF
                      (    forth6809.asm):06295         
                      (    forth6809.asm):06296                  PULU  D
                      (    forth6809.asm):06297                  CMPD  #111
                      (    forth6809.asm):06298                  BNE   T1FAIL
                      (    forth6809.asm):06299                  PULU  D
                      (    forth6809.asm):06300                  CMPD  #TSTGUARD
                      (    forth6809.asm):06301                  BNE   T1FAIL
                      (    forth6809.asm):06302         
                      (    forth6809.asm):06303                  LDD   TSTUB4
                      (    forth6809.asm):06304                  SUBD  TSTUAF
                      (    forth6809.asm):06305                  CMPD  #0
                      (    forth6809.asm):06306                  BNE   T1FAIL
                      (    forth6809.asm):06307         
                      (    forth6809.asm):06308                  LDD   #TRUEV
                      (    forth6809.asm):06309                  BRA   T1DONE
C23C                  (    forth6809.asm):06310         T1FAIL:  LDD   #FALSEV
C23C                  (    forth6809.asm):06311         T1DONE:  LDX   #TSTIFT1NAME
                      (    forth6809.asm):06312                  PSHU  X

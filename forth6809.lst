                      (    forth6809.asm):02036         
     DD33             (    forth6809.asm):02037         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):02038                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):02039                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):02040                                   ; were chained on after it; before that,
                      (    forth6809.asm):02041                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):02042                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):02043                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):02044                                   ; before this one.
                      (    forth6809.asm):02045         
                      (    forth6809.asm):02046         ; Verify no collision with base code.
                      (    forth6809.asm):02047         ; Value should match ORG BASECODE
     DD3A             (    forth6809.asm):02048         BASEDICTEND  EQU   *
     07F7             (    forth6809.asm):02049         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):02050         
                      (    forth6809.asm):02051         ; ============================================================
                      (    forth6809.asm):02052         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02053         ; ============================================================
                      (    forth6809.asm):02054                     ORG   BASECODE  ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):02055                                     ; entirely - every routine from here through
                      (    forth6809.asm):02056                                     ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):02057                                     ; every primitive) would otherwise have
                      (    forth6809.asm):02058                                     ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):02059                                     ; WARM message left the location counter,
                      (    forth6809.asm):02060                                     ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02061                                     ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02062                                     ; instead of landing in BASECODE at all
                      (    forth6809.asm):02063         
                      (    forth6809.asm):02064         ; ------------------------------------------------------------
                      (    forth6809.asm):02065         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02066         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02067         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02068         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02069         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02070         ; ------------------------------------------------------------
                      (    forth6809.asm):02071         ; ------------------------------------------------------------
                      (    forth6809.asm):02072         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02073         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02074         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02075         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02076         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02077         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02078         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02079         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02080         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02081         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02082         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02083         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02084         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02085         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02086         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02087         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02088         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02089         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02090         ; not duplicated logic in either place.
                      (    forth6809.asm):02091         ; ------------------------------------------------------------
                      (    forth6809.asm):02092         
DD3A 7F0176           (    forth6809.asm):02093         SERBUFCLR:  CLR  INHEAD
DD3D 7F0177           (    forth6809.asm):02094                     CLR  INTAIL
DD40 7F0178           (    forth6809.asm):02095                     CLR  RTSSTATE    ; $00 = RTS Low (Clear)
DD43 7F0179           (    forth6809.asm):02096                     CLR  OUTHEAD
DD46 7F017A           (    forth6809.asm):02097                     CLR  OUTTAIL
DD49 7F017B           (    forth6809.asm):02098                     CLR  OUTACTIVITY  ; $00 = Idle
                      (    forth6809.asm):02099         
                      (    forth6809.asm):02100         
DD4C 7F017C           (    forth6809.asm):02101                     CLR  FECOUNT
DD4F 7F017D           (    forth6809.asm):02102                     CLR  OVRNCOUNT
DD52 7F017E           (    forth6809.asm):02103                     CLR  PECOUNT
DD55 7F017F           (    forth6809.asm):02104                     CLR  POLLREADYCNT
DD58 39               (    forth6809.asm):02105                     RTS
                      (    forth6809.asm):02106         
DD59 BDDD3A           (    forth6809.asm):02107         INITSERIAL: JSR  SERBUFCLR
DD5C 9603             (    forth6809.asm):02108                     LDA   CR_RESET    ; Master Software Reset command to 6850
DD5E B7C008           (    forth6809.asm):02109                     STA   ACIACR 
DD61 12               (    forth6809.asm):02110                     NOP               ; Settling Delay
DD62 12               (    forth6809.asm):02111                     NOP
                      (    forth6809.asm):02112                     
                      (    forth6809.asm):02113                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02114                     LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02115                     ELSE  ; <<<<<>>>>>
DD63 8615             (    forth6809.asm):02116                     LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02117                     ENDC  ; <<<<<<<<<<
DD65 B7C008           (    forth6809.asm):02118                     STA   ACIACR         ; was "STA ACIA" - same fix
DD68 39               (    forth6809.asm):02119                     RTS
                      (    forth6809.asm):02120         
                      (    forth6809.asm):02121                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02122         ; ------------------------------------------------------------
                      (    forth6809.asm):02123         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):02124         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):02125         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):02126         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):02127         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02128         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02129                     SUBA  INTAIL
                      (    forth6809.asm):02130                     ANDA  #INBUFSZ-1
                      (    forth6809.asm):02131                     RTS
                      (    forth6809.asm):02132         ; ------------------------------------------------------------
                      (    forth6809.asm):02133         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):02134         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):02135         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):02136         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):02137         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):02138         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):02139         ; flow control, not a chip feature.
                      (    forth6809.asm):02140         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02141         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):02142                     CMPA #INHIWATER
                      (    forth6809.asm):02143                     BLO  RTSCHIDONE
                      (    forth6809.asm):02144                     TST  RTSSTATE
                      (    forth6809.asm):02145                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02146                     LDA  #CR_RTSHI
                      (    forth6809.asm):02147                     STA  ACIACR
                      (    forth6809.asm):02148                     LDA  #1
                      (    forth6809.asm):02149                     STA  RTSSTATE
DD69                  (    forth6809.asm):02150         RTSCHIDONE: RTS
                      (    forth6809.asm):02151         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02152         UPDATE_RTS:
                      (    forth6809.asm):02153                     TST   RTSSTATE
                      (    forth6809.asm):02154                     BNE   SET_RTS_HI_TX_OFF      
                      (    forth6809.asm):02155         
                      (    forth6809.asm):02156                     TST   OUTACTIVITY           ; Is active?
                      (    forth6809.asm):02157                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02158         
                      (    forth6809.asm):02159                                           ; $B5/%1011_0101
                      (    forth6809.asm):02160                     LDA   #CR_RXTX        ; Yes! Accept input & transmit output
                      (    forth6809.asm):02161                     BRA   WRITE_CR        ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02162         
DD69                  (    forth6809.asm):02163         SET_RTS_LO_TX_OFF:                ; $95/%10010101
                      (    forth6809.asm):02164                     LDA   #CR_RXON        ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02165                     BRA   WRITE_CR        ; Why is OUTACTIVITY not updated here?
                      (    forth6809.asm):02166         
DD69                  (    forth6809.asm):02167         SET_RTS_HI_TX_OFF:                ; $D5/%1101_0101
                      (    forth6809.asm):02168                     LDA   #CR_RTSHI       ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02169                     CLR   OUTACTIVITY     ; Interrupts are hardware-disabled; clear state
DD69                  (    forth6809.asm):02170         WRITE_CR:
                      (    forth6809.asm):02171                     STA   ACIACR
                      (    forth6809.asm):02172                     RTS
                      (    forth6809.asm):02173         ; ------------------------------------------------------------
                      (    forth6809.asm):02174         ; CHKHI/CHKLO - replace the old combined CHKWATERLEVEL. That
                      (    forth6809.asm):02175         ; routine always paid for a TST RTSSTATE/BNE to pick a
                      (    forth6809.asm):02176         ; direction (hi vs lo) before checking either watermark - but
                      (    forth6809.asm):02177         ; the direction picked never actually depended on which caller
                      (    forth6809.asm):02178         ; was asking, only on the current RTSSTATE, and each caller
                      (    forth6809.asm):02179         ; only ever moves fill one way: INCHAR (via CHKHI) only ever
                      (    forth6809.asm):02180         ; adds to the ring, so only the hi threshold can ever usefully
                      (    forth6809.asm):02181         ; fire from that side; GETCHAR (via CHKLO) only ever drains it,
                      (    forth6809.asm):02182         ; so only the lo threshold can fire from that side. Whenever
                      (    forth6809.asm):02183         ; the old routing sent a caller into the "wrong" branch for its
                      (    forth6809.asm):02184         ; own direction (e.g. INCHAR landing in CHK_LO while RTSSTATE
                      (    forth6809.asm):02185         ; was REJECT), the comparison was provably always a no-op from
                      (    forth6809.asm):02186         ; that caller - the fill level only ever moves the way that
                      (    forth6809.asm):02187         ; caller pushes it, so the other threshold's condition can't
                      (    forth6809.asm):02188         ; newly become true there. Splitting into two direction-fixed
                      (    forth6809.asm):02189         ; routines removes that dead branch+comparison from both
                      (    forth6809.asm):02190         ; callers, and both take the current fill level pre-computed in
                      (    forth6809.asm):02191         ; RegB rather than reloading INHEAD/INTAIL themselves, so a
                      (    forth6809.asm):02192         ; caller that already has one of the two pointers in a register
                      (    forth6809.asm):02193         ; (see INCHAR) doesn't pay for a redundant reload.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02195         CHKHI:
                      (    forth6809.asm):02196                     CMPB  #INHIWATER      ; Is the buffer near full?
                      (    forth6809.asm):02197                     BLO   CHKHIDONE       ; No! Do nothing.
                      (    forth6809.asm):02198                     TST   RTSSTATE
                      (    forth6809.asm):02199                     BNE   CHKHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02200                     LDA   #INREJECT       ; Yes! De-assert RTS.
                      (    forth6809.asm):02201                     STA   RTSSTATE
                      (    forth6809.asm):02202                     JSR   UPDATE_RTS
DD69                  (    forth6809.asm):02203         CHKHIDONE:  RTS
                      (    forth6809.asm):02204         
DD69                  (    forth6809.asm):02205         CHKLO:
                      (    forth6809.asm):02206                     CMPB  #INLOWATER      ; Is the buffer near empty?
                      (    forth6809.asm):02207                     BHS   CHKLODONE       ; No! Do nothing.
                      (    forth6809.asm):02208                     TST   RTSSTATE
                      (    forth6809.asm):02209                     BEQ   CHKLODONE       ; already low - nothing to do
                      (    forth6809.asm):02210                     LDA   #INACCEPT       ; Yes! Assert RTS.
                      (    forth6809.asm):02211                     STA   RTSSTATE
                      (    forth6809.asm):02212                     JSR   UPDATE_RTS
DD69                  (    forth6809.asm):02213         CHKLODONE:  RTS
                      (    forth6809.asm):02214         ; ------------------------------------------------------------
                      (    forth6809.asm):02215         ; BUG FIX: this used to loop internally (BRA back to the top)
                      (    forth6809.asm):02216         ; until the whole OUTBUF drained or CTS blocked - an unbounded
                      (    forth6809.asm):02217         ; spin of up to ~64 characters (~5.5ms at 115200 baud). In
                      (    forth6809.asm):02218         ; practice only one character was ever observed to be processed
                      (    forth6809.asm):02219         ; per call anyway (TDRE is rarely ready again this soon after
                      (    forth6809.asm):02220         ; sending), so this now makes that explicit: sends at most ONE
                      (    forth6809.asm):02221         ; character per call and returns unconditionally, whatever the
                      (    forth6809.asm):02222         ; reason (buffer empty, CTS-blocked, TDRE not ready yet, or a
                      (    forth6809.asm):02223         ; character actually sent - including the TDRE-not-ready case,
                      (    forth6809.asm):02224         ; which used to spin-wait right here and now instead just
                      (    forth6809.asm):02225         ; returns to try again on the next call). Every caller (KEY,
                      (    forth6809.asm):02226         ; PUTCHAR) already calls this once per character it handles on
                      (    forth6809.asm):02227         ; its own side, so the buffer still drains at essentially the
                      (    forth6809.asm):02228         ; same rate - this removes the unbounded worst case and the
                      (    forth6809.asm):02229         ; TDRE spin-wait, without changing normal-case throughput.
DD69                  (    forth6809.asm):02230         FLUSHOUTBUFFER:
                      (    forth6809.asm):02231                     LDB   OUTTAIL

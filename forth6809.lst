                      (    forth6809.asm):02472         ; ------------------------------------------------------------
                      (    forth6809.asm):02473         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02474         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02475         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02476         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02477         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02478         ; not assumed from the name.
                      (    forth6809.asm):02479         ; ------------------------------------------------------------
C1AB                  (    forth6809.asm):02480         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02481         
                      (    forth6809.asm):02482                    LDD  #TSTGUARD
                      (    forth6809.asm):02483                    PSHU D
                      (    forth6809.asm):02484                    LDD  #TSTVAL1
                      (    forth6809.asm):02485                    PSHU D
                      (    forth6809.asm):02486                    STU  TSTUB4
                      (    forth6809.asm):02487         
                      (    forth6809.asm):02488                    JSR  TOR
                      (    forth6809.asm):02489                    JSR  RFETCH
                      (    forth6809.asm):02490                    JSR  FROMR
                      (    forth6809.asm):02491         
                      (    forth6809.asm):02492                    STU  TSTUAF
                      (    forth6809.asm):02493         
                      (    forth6809.asm):02494                    PULU D
                      (    forth6809.asm):02495                    CMPD #TSTVAL1
                      (    forth6809.asm):02496                    BNE  RFFAIL
                      (    forth6809.asm):02497                    PULU D
                      (    forth6809.asm):02498                    CMPD #TSTVAL1
                      (    forth6809.asm):02499                    BNE  RFFAIL
                      (    forth6809.asm):02500                    PULU D
                      (    forth6809.asm):02501                    CMPD #TSTGUARD
                      (    forth6809.asm):02502                    BNE  RFFAIL
                      (    forth6809.asm):02503         
                      (    forth6809.asm):02504                    LDD  TSTUB4
                      (    forth6809.asm):02505                    SUBD TSTUAF
                      (    forth6809.asm):02506                    CMPD #2
                      (    forth6809.asm):02507                    BNE  RFFAIL
                      (    forth6809.asm):02508         
                      (    forth6809.asm):02509                    LDD  #TRUEV
                      (    forth6809.asm):02510                    BRA  RFDONE
C1AB                  (    forth6809.asm):02511         RFFAIL:    LDD  #FALSEV
C1AB                  (    forth6809.asm):02512         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02513                    PSHU X
                      (    forth6809.asm):02514                    PSHU D
                      (    forth6809.asm):02515                    JSR  TSTREPORT
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517                    LDU  TSTU0
                      (    forth6809.asm):02518                    RTS
                      (    forth6809.asm):02519         
C1AB                  (    forth6809.asm):02520         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02521                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02522         
                      (    forth6809.asm):02523         ; ------------------------------------------------------------
                      (    forth6809.asm):02524         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02525         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02526         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02527         ; verifying the round trip.
                      (    forth6809.asm):02528         ; ------------------------------------------------------------
C1AB                  (    forth6809.asm):02529         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02530         
                      (    forth6809.asm):02531                    LDD  #TSTGUARD
                      (    forth6809.asm):02532                    PSHU D
                      (    forth6809.asm):02533                    LDD  #TSTVAL1
                      (    forth6809.asm):02534                    PSHU D
                      (    forth6809.asm):02535                    LDD  #TSTVAL2
                      (    forth6809.asm):02536                    PSHU D
                      (    forth6809.asm):02537                    STU  TSTUB4
                      (    forth6809.asm):02538         
                      (    forth6809.asm):02539                    JSR  TWOTOR
                      (    forth6809.asm):02540         
                      (    forth6809.asm):02541                    STU  TSTUMID
                      (    forth6809.asm):02542         
                      (    forth6809.asm):02543                    LDD  TSTUB4
                      (    forth6809.asm):02544                    SUBD TSTUMID
                      (    forth6809.asm):02545                    CMPD #-4
                      (    forth6809.asm):02546                    BNE  T2RFAIL
                      (    forth6809.asm):02547         
                      (    forth6809.asm):02548                    JSR  TWOFROMR
                      (    forth6809.asm):02549         
                      (    forth6809.asm):02550                    STU  TSTUAF
                      (    forth6809.asm):02551         
                      (    forth6809.asm):02552                    PULU D
                      (    forth6809.asm):02553                    CMPD #TSTVAL2
                      (    forth6809.asm):02554                    BNE  T2RFAIL
                      (    forth6809.asm):02555                    PULU D
                      (    forth6809.asm):02556                    CMPD #TSTVAL1
                      (    forth6809.asm):02557                    BNE  T2RFAIL
                      (    forth6809.asm):02558                    PULU D
                      (    forth6809.asm):02559                    CMPD #TSTGUARD
                      (    forth6809.asm):02560                    BNE  T2RFAIL
                      (    forth6809.asm):02561         
                      (    forth6809.asm):02562                    LDD  TSTUB4
                      (    forth6809.asm):02563                    SUBD TSTUAF
                      (    forth6809.asm):02564                    CMPD #0
                      (    forth6809.asm):02565                    BNE  T2RFAIL
                      (    forth6809.asm):02566         
                      (    forth6809.asm):02567                    LDD  #TRUEV
                      (    forth6809.asm):02568                    BRA  T2RDONE
C1AB                  (    forth6809.asm):02569         T2RFAIL:   LDD  #FALSEV
C1AB                  (    forth6809.asm):02570         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02571                    PSHU X
                      (    forth6809.asm):02572                    PSHU D
                      (    forth6809.asm):02573                    JSR  TSTREPORT
                      (    forth6809.asm):02574         
                      (    forth6809.asm):02575                    LDU  TSTU0
                      (    forth6809.asm):02576                    RTS
                      (    forth6809.asm):02577         
C1AB                  (    forth6809.asm):02578         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02579                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02580         
                      (    forth6809.asm):02581         ; ------------------------------------------------------------
                      (    forth6809.asm):02582         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02583         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02584         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02585         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02586         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02587         ; ------------------------------------------------------------
C1AB                  (    forth6809.asm):02588         TSTTWORFETCH: STU  TSTU0
                      (    forth6809.asm):02589         
                      (    forth6809.asm):02590                       LDD  #TSTGUARD
                      (    forth6809.asm):02591                       PSHU D
                      (    forth6809.asm):02592                       LDD  #TSTVAL1
                      (    forth6809.asm):02593                       PSHU D
                      (    forth6809.asm):02594                       LDD  #TSTVAL2
                      (    forth6809.asm):02595                       PSHU D
                      (    forth6809.asm):02596                       STU  TSTUB4
                      (    forth6809.asm):02597         
                      (    forth6809.asm):02598                       JSR  TWOTOR
                      (    forth6809.asm):02599                       JSR  TWORFETCH
                      (    forth6809.asm):02600                       JSR  TWOFROMR
                      (    forth6809.asm):02601         
                      (    forth6809.asm):02602                       STU  TSTUAF
                      (    forth6809.asm):02603         
                      (    forth6809.asm):02604                       PULU D
                      (    forth6809.asm):02605                       CMPD #TSTVAL2
                      (    forth6809.asm):02606                       BNE  T2FFAIL
                      (    forth6809.asm):02607                       PULU D
                      (    forth6809.asm):02608                       CMPD #TSTVAL1
                      (    forth6809.asm):02609                       BNE  T2FFAIL
                      (    forth6809.asm):02610                       PULU D
                      (    forth6809.asm):02611                       CMPD #TSTVAL2
                      (    forth6809.asm):02612                       BNE  T2FFAIL
                      (    forth6809.asm):02613                       PULU D
                      (    forth6809.asm):02614                       CMPD #TSTVAL1
                      (    forth6809.asm):02615                       BNE  T2FFAIL
                      (    forth6809.asm):02616                       PULU D
                      (    forth6809.asm):02617                       CMPD #TSTGUARD
                      (    forth6809.asm):02618                       BNE  T2FFAIL
                      (    forth6809.asm):02619         
                      (    forth6809.asm):02620                       LDD  TSTUB4
                      (    forth6809.asm):02621                       SUBD TSTUAF
                      (    forth6809.asm):02622                       CMPD #4
                      (    forth6809.asm):02623                       BNE  T2FFAIL
                      (    forth6809.asm):02624         
                      (    forth6809.asm):02625                       LDD  #TRUEV
                      (    forth6809.asm):02626                       BRA  T2FDONE
C1AB                  (    forth6809.asm):02627         T2FFAIL:       LDD  #FALSEV
C1AB                  (    forth6809.asm):02628         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02629                       PSHU X
                      (    forth6809.asm):02630                       PSHU D
                      (    forth6809.asm):02631                       JSR  TSTREPORT
                      (    forth6809.asm):02632         
                      (    forth6809.asm):02633                       LDU  TSTU0
                      (    forth6809.asm):02634                       RTS
                      (    forth6809.asm):02635         
C1AB                  (    forth6809.asm):02636         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02637                           FCC  "TSTTWORFETCH"
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639                    ENDC ; <<<<

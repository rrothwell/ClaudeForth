                      (    forth6809.asm):08544         ; TSTBUFC - unit test for BUFFER:. Compiles "10 BUFFER: TESTWD"
                      (    forth6809.asm):08545         ; into scratch (u=10, the requested size, popped before the name
                      (    forth6809.asm):08546         ; is even parsed - confirmed by reading BUFFERCOLON's own code,
                      (    forth6809.asm):08547         ; which pops u as its very first action, before calling HEADER),
                      (    forth6809.asm):08548         ; then executes the result. Verifies it pushes its own PFA
                      (    forth6809.asm):08549         ; address (matching VARIABLE's own DOESRT0 behavior - BUFFER:
                      (    forth6809.asm):08550         ; shares it) and that VARHERE genuinely advanced by exactly the
                      (    forth6809.asm):08551         ; requested 10 bytes - not just that some space was reserved.
                      (    forth6809.asm):08552         ; Contents are documented uninitialized, so not checked.
                      (    forth6809.asm):08553         ; ------------------------------------------------------------

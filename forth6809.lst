                      (    forth6809.asm):03367         ; ------------------------------------------------------------
                      (    forth6809.asm):03368         ; KEY  ( -- char )
                      (    forth6809.asm):03369         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03370         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03371         ; ------------------------------------------------------------
E4C1                  (    forth6809.asm):03372         KEYW:
                      (    forth6809.asm):03373         
E4C1 7D0178           (    forth6809.asm):03374                     TST   RTSSTATE          ; Is throttling?
E4C4 2703             (    forth6809.asm):03375                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03376         
                      (    forth6809.asm):03377                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E4C6 BDDCD2           (    forth6809.asm):03378                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,

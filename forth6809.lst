                      (    forth6809.asm):08309                    LDD  TSTTISAV
                      (    forth6809.asm):08310                    STD  TOIN
                      (    forth6809.asm):08311         
                      (    forth6809.asm):08312                    LDX  TSTDOESA  ; BUG FIX: was preceded by restoring LATEST
                      (    forth6809.asm):08313                                   ; to its real value here - but SETDOES
                      (    forth6809.asm):08314                                   ; (confirmed by reading its own code) reads
                      (    forth6809.asm):08315                                   ; LATEST directly to find which header to
                      (    forth6809.asm):08316                                   ; patch, so restoring it first meant SETDOES
                      (    forth6809.asm):08317                                   ; patched the real, wrong word instead of
                      (    forth6809.asm):08318                                   ; TESTWD, leaving TESTWD stuck on its
                      (    forth6809.asm):08319                                   ; original DOESRT0 placeholder. LATEST now
                      (    forth6809.asm):08320                                   ; stays pointed at TESTWD (this test's own
                      (    forth6809.asm):08321                                   ; fake header) until right after this call.
                      (    forth6809.asm):08322                    JSR  ,X
                      (    forth6809.asm):08323         
                      (    forth6809.asm):08324                    LDD  TSTLSAV
                      (    forth6809.asm):08325                    STD  LATEST
                      (    forth6809.asm):08326         

     0004             (    forth6809.asm):02106         OKMSGL      EQU   *-OKMSG
DF5F 20204552524F5220 (    forth6809.asm):02107         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02108         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02109         
                      (    forth6809.asm):02110         ; ============================================================
                      (    forth6809.asm):02111         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02112         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02113         ; ============================================================
                      (    forth6809.asm):02114         ; ------------------------------------------------------------
                      (    forth6809.asm):02115         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02116         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02117         ; LIT   ( -- x )
                      (    forth6809.asm):02118         ;    Inputs:
                      (    forth6809.asm):02119         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02120         ;    Outputs:
                      (    forth6809.asm):02121         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02122         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02123         ; ------------------------------------------------------------
DF67 3510             (    forth6809.asm):02124         LIT:        PULS  X
DF69 EC81             (    forth6809.asm):02125                     LDD   ,X++
DF6B 3606             (    forth6809.asm):02126                     PSHU  D                 ; x
DF6D 3410             (    forth6809.asm):02127                     PSHS  X
DF6F 39               (    forth6809.asm):02128                     RTS
                      (    forth6809.asm):02129         
                      (    forth6809.asm):02130         ; ------------------------------------------------------------
                      (    forth6809.asm):02131         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02132         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02133         ; address.
                      (    forth6809.asm):02134         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02135         ;    Inputs:
                      (    forth6809.asm):02136         ;        flag on the data stack
                      (    forth6809.asm):02137         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02138         ;    Outputs:
                      (    forth6809.asm):02139         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02140         ;        the offset
                      (    forth6809.asm):02141         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02142         ; ------------------------------------------------------------
DF70 3706             (    forth6809.asm):02143         ZBRANCH:    PULU  D                 ; flag
DF72 3510             (    forth6809.asm):02144                     PULS  X
DF74 10830000         (    forth6809.asm):02145                     CMPD  #0
DF78 2607             (    forth6809.asm):02146                     BNE   ZSKIP
DF7A EC84             (    forth6809.asm):02147                     LDD   ,X
DF7C 308B             (    forth6809.asm):02148                     LEAX  D,X
DF7E 3410             (    forth6809.asm):02149                     PSHS  X
DF80 39               (    forth6809.asm):02150                     RTS
DF81 3002             (    forth6809.asm):02151         ZSKIP:      LEAX  2,X
DF83 3410             (    forth6809.asm):02152                     PSHS  X
DF85 39               (    forth6809.asm):02153                     RTS
                      (    forth6809.asm):02154         
                      (    forth6809.asm):02155         ; ------------------------------------------------------------
                      (    forth6809.asm):02156         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02157         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02158         ; BRANCH
                      (    forth6809.asm):02159         ;    Inputs:
                      (    forth6809.asm):02160         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02161         ;    Outputs:
                      (    forth6809.asm):02162         ;        return address set to the branch target
                      (    forth6809.asm):02163         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02164         ; ------------------------------------------------------------
DF86 3510             (    forth6809.asm):02165         BRANCH:     PULS  X
DF88 EC84             (    forth6809.asm):02166                     LDD   ,X
DF8A 308B             (    forth6809.asm):02167                     LEAX  D,X
DF8C 3410             (    forth6809.asm):02168                     PSHS  X
DF8E 39               (    forth6809.asm):02169                     RTS
                      (    forth6809.asm):02170         
                      (    forth6809.asm):02171         ; ------------------------------------------------------------
                      (    forth6809.asm):02172         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02173         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02174         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02175         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02176         ;    Inputs:
                      (    forth6809.asm):02177         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02178         ;        trampoline
                      (    forth6809.asm):02179         ;    Outputs:
                      (    forth6809.asm):02180         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02181         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02182         ; ------------------------------------------------------------
DF8F 3510             (    forth6809.asm):02183         DODOES:     PULS  X
DF91 10AE81           (    forth6809.asm):02184                     LDY   ,X++
DF94 EC84             (    forth6809.asm):02185                     LDD   ,X
DF96 3606             (    forth6809.asm):02186                     PSHU  D                 ; pfa
DF98 6EA4             (    forth6809.asm):02187                     JMP   ,Y
                      (    forth6809.asm):02188         
                      (    forth6809.asm):02189         ; ------------------------------------------------------------
                      (    forth6809.asm):02190         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02191         ; field address on the stack.
                      (    forth6809.asm):02192         ; DOESRT0
                      (    forth6809.asm):02193         ;    Inputs:
                      (    forth6809.asm):02194         ;        none
                      (    forth6809.asm):02195         ;    Outputs:
                      (    forth6809.asm):02196         ;        none
                      (    forth6809.asm):02197         ;    Registers: none.
                      (    forth6809.asm):02198         ; ------------------------------------------------------------
DF9A 39               (    forth6809.asm):02199         DOESRT0:    RTS
                      (    forth6809.asm):02200         
                      (    forth6809.asm):02201         ; ------------------------------------------------------------
                      (    forth6809.asm):02202         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02203         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02204         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02205         ; SETDOES
                      (    forth6809.asm):02206         ;    Inputs:
                      (    forth6809.asm):02207         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02208         ;        BEHAVIOR)
                      (    forth6809.asm):02209         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02210         ;        address
                      (    forth6809.asm):02211         ;    Outputs:
                      (    forth6809.asm):02212         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02213         ;        defining word's caller
                      (    forth6809.asm):02214         ;    Registers: RegD, RegX, RegY, CC and HDRFLAGS changed.
                      (    forth6809.asm):02215         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):02216         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF9D 1F12             (    forth6809.asm):02217                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02218         
DF9F 9E04             (    forth6809.asm):02219                     LDX   LATEST
DFA1 A684             (    forth6809.asm):02220                     LDA   ,X
DFA3 971E             (    forth6809.asm):02221                     STA   HDRFLAGS
DFA5 3001             (    forth6809.asm):02222                     LEAX  1,X
DFA7 D61E             (    forth6809.asm):02223                     LDB   HDRFLAGS
DFA9 C41F             (    forth6809.asm):02224                     ANDB  #$1F
DFAB 4F               (    forth6809.asm):02225                     CLRA
DFAC 308B             (    forth6809.asm):02226                     LEAX  D,X               ; skip name -> LINK field
DFAE 3002             (    forth6809.asm):02227                     LEAX  2,X               ; skip LINK -> CFA field
DFB0 EC84             (    forth6809.asm):02228                     LDD   ,X                ; D = CFA (trampoline address)
DFB2 C30003           (    forth6809.asm):02229                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFB5 1F01             (    forth6809.asm):02230                     TFR   D,X
                      (    forth6809.asm):02231         
DFB7 10AF84           (    forth6809.asm):02232                     STY   ,X                ; patch it
                      (    forth6809.asm):02233         
DFBA 3510             (    forth6809.asm):02234                     PULS  X                 ; X = the OUTER defining word's own return addr
DFBC 6E84             (    forth6809.asm):02235                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02236         
                      (    forth6809.asm):02237         ; ------------------------------------------------------------
                      (    forth6809.asm):02238         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02239         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02240         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02241         ;    Inputs:
                      (    forth6809.asm):02242         ;        pfa on the data stack
                      (    forth6809.asm):02243         ;    Outputs:
                      (    forth6809.asm):02244         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02245         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02246         ; ------------------------------------------------------------
DFBE 3710             (    forth6809.asm):02247         DODEFER:    PULU  X                 ; pfa
DFC0 EC84             (    forth6809.asm):02248                     LDD   ,X
DFC2 1F01             (    forth6809.asm):02249                     TFR   D,X
DFC4 6E84             (    forth6809.asm):02250                     JMP   ,X
                      (    forth6809.asm):02251         
                      (    forth6809.asm):02252         ; ------------------------------------------------------------
                      (    forth6809.asm):02253         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02254         ; DOABORTUNDEF
                      (    forth6809.asm):02255         ;    Inputs:
                      (    forth6809.asm):02256         ;        none
                      (    forth6809.asm):02257         ;    Outputs:
                      (    forth6809.asm):02258         ;        none (does not return)
                      (    forth6809.asm):02259         ;    Registers: RegD changed.
                      (    forth6809.asm):02260         ; ------------------------------------------------------------
DFC6                  (    forth6809.asm):02261         DOABORTUNDEF:
DFC6 CCFFEB           (    forth6809.asm):02262                     LDD   #-21
DFC9 3606             (    forth6809.asm):02263                     PSHU  D                 ; throw code (-21)
DFCB 7EE642           (    forth6809.asm):02264                     JMP   THROWW
                      (    forth6809.asm):02265         
                      (    forth6809.asm):02266         ; ------------------------------------------------------------
                      (    forth6809.asm):02267         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02268         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02269         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02270         ;    Inputs:
                      (    forth6809.asm):02271         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02272         ;    Outputs:
                      (    forth6809.asm):02273         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02274         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02275         ; ------------------------------------------------------------
DFCE 3710             (    forth6809.asm):02276         DOMARKER:   PULU  X                 ; pfa
DFD0 EC84             (    forth6809.asm):02277                     LDD   ,X
DFD2 DD06             (    forth6809.asm):02278                     STD   DPHERE
DFD4 EC02             (    forth6809.asm):02279                     LDD   2,X
DFD6 DD08             (    forth6809.asm):02280                     STD   CODEHERE
DFD8 EC04             (    forth6809.asm):02281                     LDD   4,X
DFDA DD0A             (    forth6809.asm):02282                     STD   VARHERE
DFDC EC06             (    forth6809.asm):02283                     LDD   6,X
DFDE DD04             (    forth6809.asm):02284                     STD   LATEST
DFE0 39               (    forth6809.asm):02285                     RTS
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287         ; ------------------------------------------------------------
                      (    forth6809.asm):02288         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02289         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02290         ; ------------------------------------------------------------
DFE1 3710             (    forth6809.asm):02291         EXECUTEW:   PULU  X                 ; xt
DFE3 AD84             (    forth6809.asm):02292                     JSR   ,X
DFE5 39               (    forth6809.asm):02293                     RTS
                      (    forth6809.asm):02294         
                      (    forth6809.asm):02295         ; ============================================================
                      (    forth6809.asm):02296         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02297         ; ============================================================
                      (    forth6809.asm):02298         ; ------------------------------------------------------------
                      (    forth6809.asm):02299         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02300         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02301         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02302         ;    Inputs:
                      (    forth6809.asm):02303         ;        RegX = address of the here pointer
                      (    forth6809.asm):02304         ;        x on the data stack
                      (    forth6809.asm):02305         ;    Outputs:
                      (    forth6809.asm):02306         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02307         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02308         ; ------------------------------------------------------------
DFE6 3706             (    forth6809.asm):02309         APPENDCELL: PULU  D                 ; x
DFE8 10AE84           (    forth6809.asm):02310                     LDY   ,X
DFEB EDA1             (    forth6809.asm):02311                     STD   ,Y++
DFED 10AF84           (    forth6809.asm):02312                     STY   ,X
DFF0 39               (    forth6809.asm):02313                     RTS
                      (    forth6809.asm):02314         
                      (    forth6809.asm):02315         ; ------------------------------------------------------------
                      (    forth6809.asm):02316         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02317         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02318         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02319         ;    Inputs:
                      (    forth6809.asm):02320         ;        RegX = address of the here pointer
                      (    forth6809.asm):02321         ;        char on the data stack
                      (    forth6809.asm):02322         ;    Outputs:
                      (    forth6809.asm):02323         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02324         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02325         ; ------------------------------------------------------------
DFF1 3706             (    forth6809.asm):02326         APPENDBYTE: PULU  D                 ; char
DFF3 10AE84           (    forth6809.asm):02327                     LDY   ,X
DFF6 E7A0             (    forth6809.asm):02328                     STB   ,Y+
DFF8 10AF84           (    forth6809.asm):02329                     STY   ,X
DFFB 39               (    forth6809.asm):02330                     RTS
                      (    forth6809.asm):02331         
                      (    forth6809.asm):02332         ; ------------------------------------------------------------
                      (    forth6809.asm):02333         ; ,  ( x -- )
                      (    forth6809.asm):02334         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02335         ; ------------------------------------------------------------
DFFC 8E0008           (    forth6809.asm):02336         COMMAW:     LDX   #CODEHERE
DFFF 7EDFE6           (    forth6809.asm):02337                     JMP   APPENDCELL
                      (    forth6809.asm):02338         
                      (    forth6809.asm):02339         ; ------------------------------------------------------------
                      (    forth6809.asm):02340         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02341         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02342         ; ------------------------------------------------------------
E002 8E0008           (    forth6809.asm):02343         CODECOMMA:  LDX   #CODEHERE
E005 7EDFE6           (    forth6809.asm):02344                     JMP   APPENDCELL
                      (    forth6809.asm):02345         
                      (    forth6809.asm):02346         ; ------------------------------------------------------------
                      (    forth6809.asm):02347         ; C,  ( char -- )
                      (    forth6809.asm):02348         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02349         ; ------------------------------------------------------------
E008 8E0008           (    forth6809.asm):02350         CCOMMAW:    LDX   #CODEHERE
E00B 7EDFF1           (    forth6809.asm):02351                     JMP   APPENDBYTE
                      (    forth6809.asm):02352         
                      (    forth6809.asm):02353         ; ------------------------------------------------------------
                      (    forth6809.asm):02354         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02355         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02356         ; ------------------------------------------------------------
E00E 8E0008           (    forth6809.asm):02357         CCOMMA1:    LDX   #CODEHERE
E011 7EDFF1           (    forth6809.asm):02358                     JMP   APPENDBYTE
                      (    forth6809.asm):02359         
                      (    forth6809.asm):02360         ; ------------------------------------------------------------
                      (    forth6809.asm):02361         ; V,  ( x -- )
                      (    forth6809.asm):02362         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02363         ; ------------------------------------------------------------
E014 8E000A           (    forth6809.asm):02364         VCOMMAW:    LDX   #VARHERE
E017 7EDFE6           (    forth6809.asm):02365                     JMP   APPENDCELL
                      (    forth6809.asm):02366         
                      (    forth6809.asm):02367         ; ------------------------------------------------------------
                      (    forth6809.asm):02368         ; VC,  ( char -- )
                      (    forth6809.asm):02369         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02370         ; ------------------------------------------------------------
E01A 8E000A           (    forth6809.asm):02371         VCCOMMAW:   LDX   #VARHERE
E01D 7EDFF1           (    forth6809.asm):02372                     JMP   APPENDBYTE
                      (    forth6809.asm):02373         
                      (    forth6809.asm):02374         ; ------------------------------------------------------------
                      (    forth6809.asm):02375         ; ALLOT  ( n -- )
                      (    forth6809.asm):02376         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02377         ; ------------------------------------------------------------
E020 3706             (    forth6809.asm):02378         ALLOTW:     PULU  D                 ; n
E022 9E08             (    forth6809.asm):02379                     LDX   CODEHERE
E024 308B             (    forth6809.asm):02380                     LEAX  D,X
E026 9F08             (    forth6809.asm):02381                     STX   CODEHERE
E028 39               (    forth6809.asm):02382                     RTS
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; VALLOT  ( n -- )
                      (    forth6809.asm):02386         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02387         ; ------------------------------------------------------------
E029 3706             (    forth6809.asm):02388         VALLOTW:    PULU  D                 ; n
E02B 9E0A             (    forth6809.asm):02389                     LDX   VARHERE
E02D 308B             (    forth6809.asm):02390                     LEAX  D,X
E02F 9F0A             (    forth6809.asm):02391                     STX   VARHERE
E031 39               (    forth6809.asm):02392                     RTS
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
                      (    forth6809.asm):02395         ; HERE  ( -- addr )
                      (    forth6809.asm):02396         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02397         ; ------------------------------------------------------------
E032 DC08             (    forth6809.asm):02398         HEREW:      LDD   CODEHERE
E034 3606             (    forth6809.asm):02399                     PSHU  D                 ; addr
E036 39               (    forth6809.asm):02400                     RTS
                      (    forth6809.asm):02401         
                      (    forth6809.asm):02402         ; ------------------------------------------------------------
                      (    forth6809.asm):02403         ; VHERE  ( -- addr )
                      (    forth6809.asm):02404         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02405         ; ------------------------------------------------------------
E037 DC0A             (    forth6809.asm):02406         VHEREW:     LDD   VARHERE
E039 3606             (    forth6809.asm):02407                     PSHU  D                 ; addr
E03B 39               (    forth6809.asm):02408                     RTS
                      (    forth6809.asm):02409         
                      (    forth6809.asm):02410         ; ------------------------------------------------------------
                      (    forth6809.asm):02411         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02412         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02413         ; ------------------------------------------------------------
E03C DC08             (    forth6809.asm):02414         PADW:       LDD   CODEHERE
E03E C30080           (    forth6809.asm):02415                     ADDD  #PADOFFSET
E041 3606             (    forth6809.asm):02416                     PSHU  D                 ; c-addr
E043 39               (    forth6809.asm):02417                     RTS
                      (    forth6809.asm):02418         
                      (    forth6809.asm):02419         ; ------------------------------------------------------------
                      (    forth6809.asm):02420         ; UNUSED  ( -- u )
                      (    forth6809.asm):02421         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02422         ; ------------------------------------------------------------
E044 CCB900           (    forth6809.asm):02423         UNUSEDW:    LDD   #CODETOP
E047 9308             (    forth6809.asm):02424                     SUBD  CODEHERE
E049 3606             (    forth6809.asm):02425                     PSHU  D                 ; u
E04B 39               (    forth6809.asm):02426                     RTS
                      (    forth6809.asm):02427         
                      (    forth6809.asm):02428         ; ------------------------------------------------------------
                      (    forth6809.asm):02429         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02430         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02431         ; ------------------------------------------------------------
E04C CC1FFF           (    forth6809.asm):02432         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E04F 930A             (    forth6809.asm):02433                     SUBD  VARHERE
E051 3606             (    forth6809.asm):02434                     PSHU  D                 ; u
E053 39               (    forth6809.asm):02435                     RTS
                      (    forth6809.asm):02436         
                      (    forth6809.asm):02437         ; ============================================================
                      (    forth6809.asm):02438         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02439         ; ============================================================
                      (    forth6809.asm):02440         ; ------------------------------------------------------------
                      (    forth6809.asm):02441         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02442         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02443         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02444         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02445         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02446         ;    Inputs:
                      (    forth6809.asm):02447         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02448         ;        name parsed from the input stream
                      (    forth6809.asm):02449         ;    Outputs:
                      (    forth6809.asm):02450         ;        header built at DPHERE; LATEST and NEWHDR = address of the
                      (    forth6809.asm):02451         ;        new header
                      (    forth6809.asm):02452         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02453         ; ------------------------------------------------------------
E054 CC0020           (    forth6809.asm):02454         HEADER:     LDD   #32
E057 3606             (    forth6809.asm):02455                     PSHU  D
E059 BDE34F           (    forth6809.asm):02456                     JSR   WORDW
E05C 3710             (    forth6809.asm):02457                     PULU  X                 ; c-addr of the name
E05E A684             (    forth6809.asm):02458                     LDA   ,X
E060 9738             (    forth6809.asm):02459                     STA   NAMELEN
E062 3001             (    forth6809.asm):02460                     LEAX  1,X
E064 9F36             (    forth6809.asm):02461                     STX   NAMEP
                      (    forth6809.asm):02462         
E066 3706             (    forth6809.asm):02463                     PULU  D                 ; smudge flag
E068 3404             (    forth6809.asm):02464                     PSHS  B
                      (    forth6809.asm):02465         
E06A DC06             (    forth6809.asm):02466                     LDD   DPHERE
E06C DD34             (    forth6809.asm):02467                     STD   NEWHDR
E06E 9E06             (    forth6809.asm):02468                     LDX   DPHERE
E070 9638             (    forth6809.asm):02469                     LDA   NAMELEN
E072 6DE0             (    forth6809.asm):02470                     TST   ,S+               ; smudge flag
E074 2702             (    forth6809.asm):02471                     BEQ   HDNOSM
E076 8A40             (    forth6809.asm):02472                     ORA   #$40
E078 A780             (    forth6809.asm):02473         HDNOSM:     STA   ,X+
E07A 109E36           (    forth6809.asm):02474                     LDY   NAMEP
E07D D638             (    forth6809.asm):02475                     LDB   NAMELEN
E07F 2707             (    forth6809.asm):02476                     BEQ   HDNONM
E081 A6A0             (    forth6809.asm):02477         HDCPY:      LDA   ,Y+
E083 A780             (    forth6809.asm):02478                     STA   ,X+
E085 5A               (    forth6809.asm):02479                     DECB
E086 26F9             (    forth6809.asm):02480                     BNE   HDCPY
E088 DC04             (    forth6809.asm):02481         HDNONM:     LDD   LATEST
E08A ED81             (    forth6809.asm):02482                     STD   ,X++
E08C DC08             (    forth6809.asm):02483                     LDD   CODEHERE
E08E ED81             (    forth6809.asm):02484                     STD   ,X++
E090 9F06             (    forth6809.asm):02485                     STX   DPHERE
E092 DC34             (    forth6809.asm):02486                     LDD   NEWHDR
E094 DD04             (    forth6809.asm):02487                     STD   LATEST
E096 39               (    forth6809.asm):02488                     RTS
                      (    forth6809.asm):02489         
                      (    forth6809.asm):02490         ; ============================================================
                      (    forth6809.asm):02491         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02492         ; ============================================================
                      (    forth6809.asm):02493         ; ------------------------------------------------------------
                      (    forth6809.asm):02494         ; :  ( "name" -- )
                      (    forth6809.asm):02495         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02496         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02497         ; CSP and enter compile state.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
E097 CCFFFF           (    forth6809.asm):02499         COLONW:     LDD   #TRUEV
E09A 3606             (    forth6809.asm):02500                     PSHU  D
E09C BDE054           (    forth6809.asm):02501                     JSR   HEADER
E09F DC08             (    forth6809.asm):02502                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E0A1 DD34             (    forth6809.asm):02503                     STD   CURXT             ; See bugfix: COLONW.1
E0A3 1F30             (    forth6809.asm):02504                     TFR   U,D
E0A5 DD3D             (    forth6809.asm):02505                     STD   CSP
E0A7 CCFFFF           (    forth6809.asm):02506                     LDD   #-1
E0AA DD00             (    forth6809.asm):02507                     STD   STATE
E0AC 39               (    forth6809.asm):02508                     RTS
                      (    forth6809.asm):02509         
                      (    forth6809.asm):02510         ; ------------------------------------------------------------
                      (    forth6809.asm):02511         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02512         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02513         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02514         ; new word and return to interpret state.
                      (    forth6809.asm):02515         ; ------------------------------------------------------------
E0AD CC0039           (    forth6809.asm):02516         SEMIW:      LDD   #RTSOPC
E0B0 3606             (    forth6809.asm):02517                     PSHU  D
E0B2 BDE00E           (    forth6809.asm):02518                     JSR   CCOMMA1
E0B5 1F30             (    forth6809.asm):02519                     TFR   U,D
E0B7 10933D           (    forth6809.asm):02520                     CMPD  CSP
E0BA 2703             (    forth6809.asm):02521                     BEQ   SEMIOK
E0BC BDE60D           (    forth6809.asm):02522                     JSR   CFERR
E0BF 9E04             (    forth6809.asm):02523         SEMIOK:     LDX   LATEST
E0C1 A684             (    forth6809.asm):02524                     LDA   ,X
E0C3 84BF             (    forth6809.asm):02525                     ANDA  #$BF
E0C5 A784             (    forth6809.asm):02526                     STA   ,X
E0C7 CC0000           (    forth6809.asm):02527                     LDD   #0
E0CA DD00             (    forth6809.asm):02528                     STD   STATE
E0CC 39               (    forth6809.asm):02529                     RTS
                      (    forth6809.asm):02530         
                      (    forth6809.asm):02531         ; ------------------------------------------------------------
                      (    forth6809.asm):02532         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02533         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02534         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02535         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02536         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02537         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02538         ; ------------------------------------------------------------
E0CD DC08             (    forth6809.asm):02539         NONAMEW:    LDD   CODEHERE
E0CF 3606             (    forth6809.asm):02540                     PSHU  D                 ; xt
E0D1 DD34             (    forth6809.asm):02541                     STD   CURXT             ; See bugfix: NONAMEW.1
E0D3 1F30             (    forth6809.asm):02542                     TFR   U,D
E0D5 DD3D             (    forth6809.asm):02543                     STD   CSP
E0D7 CCFFFF           (    forth6809.asm):02544                     LDD   #-1
E0DA DD00             (    forth6809.asm):02545                     STD   STATE
E0DC 39               (    forth6809.asm):02546                     RTS
                      (    forth6809.asm):02547         
                      (    forth6809.asm):02548         ; ------------------------------------------------------------
                      (    forth6809.asm):02549         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02550         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02551         ; BLDDOES
                      (    forth6809.asm):02552         ;    Inputs:
                      (    forth6809.asm):02553         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02554         ;    Outputs:
                      (    forth6809.asm):02555         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02556         ;    Registers: all changed.
                      (    forth6809.asm):02557         ; BLDSELF
                      (    forth6809.asm):02558         ;    Inputs:
                      (    forth6809.asm):02559         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02560         ;    Outputs:
                      (    forth6809.asm):02561         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02562         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02563         ;    Registers: all changed.
                      (    forth6809.asm):02564         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02565         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02566         ; ------------------------------------------------------------
E0DD 3406             (    forth6809.asm):02567         BLDDOES:    PSHS  D                 ; behaviour address
E0DF CC0000           (    forth6809.asm):02568                     LDD   #0
E0E2 3606             (    forth6809.asm):02569                     PSHU  D
E0E4 BDE054           (    forth6809.asm):02570                     JSR   HEADER
E0E7 CCDF8F           (    forth6809.asm):02571                     LDD   #DODOES
E0EA 3606             (    forth6809.asm):02572                     PSHU  D
E0EC BDEAB7           (    forth6809.asm):02573                     JSR   CCALL
E0EF 3506             (    forth6809.asm):02574                     PULS  D
E0F1 3606             (    forth6809.asm):02575                     PSHU  D                 ; behaviour address
E0F3 BDE002           (    forth6809.asm):02576                     JSR   CODECOMMA
E0F6 39               (    forth6809.asm):02577                     RTS
                      (    forth6809.asm):02578         
E0F7 BDE0DD           (    forth6809.asm):02579         BLDSELF:    JSR   BLDDOES
E0FA DC08             (    forth6809.asm):02580                     LDD   CODEHERE          ; PFA = the cell after this one
E0FC C30002           (    forth6809.asm):02581                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0FF 3606             (    forth6809.asm):02582                     PSHU  D
E101 BDE002           (    forth6809.asm):02583                     JSR   CODECOMMA
E104 39               (    forth6809.asm):02584                     RTS
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586         ; ------------------------------------------------------------
                      (    forth6809.asm):02587         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02588         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02589         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02590         ; address in the code area, on the stack.
                      (    forth6809.asm):02591         ; ------------------------------------------------------------
E105 CCDF9A           (    forth6809.asm):02592         CREATEW:    LDD   #DOESRT0
E108 BDE0F7           (    forth6809.asm):02593                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E10B 39               (    forth6809.asm):02594                     RTS
                      (    forth6809.asm):02595         
                      (    forth6809.asm):02596         ; ------------------------------------------------------------
                      (    forth6809.asm):02597         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02598         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02599         ; of the word being defined.
                      (    forth6809.asm):02600         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02601         ; ------------------------------------------------------------
E10C CCDF9B           (    forth6809.asm):02602         DOESGTW:    LDD   #SETDOES
E10F 3606             (    forth6809.asm):02603                     PSHU  D
E111 BDEAB7           (    forth6809.asm):02604                     JSR   CCALL
E114 39               (    forth6809.asm):02605                     RTS
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02609         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02610         ; area, initialised to zero.
                      (    forth6809.asm):02611         ; ------------------------------------------------------------
E115 CC0000           (    forth6809.asm):02612         VARIABLEW:  LDD   #0
E118 3606             (    forth6809.asm):02613                     PSHU  D
E11A BDE054           (    forth6809.asm):02614                     JSR   HEADER
E11D CCDF8F           (    forth6809.asm):02615                     LDD   #DODOES
E120 3606             (    forth6809.asm):02616                     PSHU  D
E122 BDEAB7           (    forth6809.asm):02617                     JSR   CCALL
E125 CCDF9A           (    forth6809.asm):02618                     LDD   #DOESRT0
E128 3606             (    forth6809.asm):02619                     PSHU  D
E12A BDE002           (    forth6809.asm):02620                     JSR   CODECOMMA
E12D DC0A             (    forth6809.asm):02621                     LDD   VARHERE
E12F 3606             (    forth6809.asm):02622                     PSHU  D
E131 BDE002           (    forth6809.asm):02623                     JSR   CODECOMMA
E134 CC0000           (    forth6809.asm):02624                     LDD   #0
E137 9E0A             (    forth6809.asm):02625                     LDX   VARHERE
E139 ED81             (    forth6809.asm):02626                     STD   ,X++
E13B 9F0A             (    forth6809.asm):02627                     STX   VARHERE
E13D 39               (    forth6809.asm):02628                     RTS
                      (    forth6809.asm):02629         
                      (    forth6809.asm):02630         ; ------------------------------------------------------------
                      (    forth6809.asm):02631         ; @  ( a-addr -- x )
                      (    forth6809.asm):02632         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
E13E 3710             (    forth6809.asm):02634         FETCHW:     PULU  X                 ; a-addr
E140 EC84             (    forth6809.asm):02635                     LDD   ,X
E142 3606             (    forth6809.asm):02636                     PSHU  D                 ; x
E144 39               (    forth6809.asm):02637                     RTS
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ------------------------------------------------------------
                      (    forth6809.asm):02640         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02641         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02642         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
E145 CCE13E           (    forth6809.asm):02644         CONSTANTW:  LDD   #FETCHW
E148 BDE0F7           (    forth6809.asm):02645                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E14B BDDFFC           (    forth6809.asm):02646                     JSR   COMMAW
E14E 39               (    forth6809.asm):02647                     RTS
                      (    forth6809.asm):02648         
                      (    forth6809.asm):02649         ; ------------------------------------------------------------
                      (    forth6809.asm):02650         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02651         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02652         ;    Inputs:
                      (    forth6809.asm):02653         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02654         ;    Outputs:
                      (    forth6809.asm):02655         ;        pfa replaced by the value
                      (    forth6809.asm):02656         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02657         ; ------------------------------------------------------------
E14F 3710             (    forth6809.asm):02658         DOVALUE:    PULU  X                 ; pfa
E151 EC84             (    forth6809.asm):02659                     LDD   ,X
E153 3606             (    forth6809.asm):02660                     PSHU  D                 ; x
E155 39               (    forth6809.asm):02661                     RTS
                      (    forth6809.asm):02662         
                      (    forth6809.asm):02663         ; ------------------------------------------------------------
                      (    forth6809.asm):02664         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02665         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02666         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02667         ; ------------------------------------------------------------
E156 CCE14F           (    forth6809.asm):02668         VALUEW:     LDD   #DOVALUE
E159 BDE0DD           (    forth6809.asm):02669                     JSR   BLDDOES
E15C DC0A             (    forth6809.asm):02670                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E15E 3606             (    forth6809.asm):02671                     PSHU  D                 ; See bugfix: VALUEW.1
E160 BDE002           (    forth6809.asm):02672                     JSR   CODECOMMA
E163 BDE014           (    forth6809.asm):02673                     JSR   VCOMMAW           ; store x in the variable area
E166 39               (    forth6809.asm):02674                     RTS
                      (    forth6809.asm):02675         
                      (    forth6809.asm):02676         ; ------------------------------------------------------------
                      (    forth6809.asm):02677         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02678         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02679         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02680         ; ------------------------------------------------------------
E167 CC0020           (    forth6809.asm):02681         TOW:        LDD   #32
E16A 3606             (    forth6809.asm):02682                     PSHU  D
E16C BDE34F           (    forth6809.asm):02683                     JSR   WORDW
E16F BDE3BB           (    forth6809.asm):02684                     JSR   FINDW
E172 3706             (    forth6809.asm):02685                     PULU  D
E174 10830000         (    forth6809.asm):02686                     CMPD  #0
E178 260A             (    forth6809.asm):02687                     BNE   TOFOUND
E17A 3706             (    forth6809.asm):02688                     PULU  D
E17C CCFFF3           (    forth6809.asm):02689                     LDD   #-13
E17F 3606             (    forth6809.asm):02690                     PSHU  D
E181 BDE642           (    forth6809.asm):02691                     JSR   THROWW
E184 BDEB69           (    forth6809.asm):02692         TOFOUND:    JSR   TOBODYW
E187 DC00             (    forth6809.asm):02693                     LDD   STATE
E189 270C             (    forth6809.asm):02694                     BEQ   TOIMMED
E18B BDEAC4           (    forth6809.asm):02695                     JSR   LITERALW
E18E CCF3AC           (    forth6809.asm):02696                     LDD   #STOREW
E191 3606             (    forth6809.asm):02697                     PSHU  D
E193 BDEAB7           (    forth6809.asm):02698                     JSR   CCALL
E196 39               (    forth6809.asm):02699                     RTS
E197 3710             (    forth6809.asm):02700         TOIMMED:    PULU  X                 ; a-addr of the value cell
E199 3706             (    forth6809.asm):02701                     PULU  D                 ; x
E19B ED84             (    forth6809.asm):02702                     STD   ,X
E19D 39               (    forth6809.asm):02703                     RTS
                      (    forth6809.asm):02704         
                      (    forth6809.asm):02705         ; ------------------------------------------------------------
                      (    forth6809.asm):02706         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02707         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02708         ; the variable area, initialised to zero.
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
E19E                  (    forth6809.asm):02710         TWOVARIABLEW:
E19E CC0000           (    forth6809.asm):02711                     LDD   #0
E1A1 3606             (    forth6809.asm):02712                     PSHU  D
E1A3 BDE054           (    forth6809.asm):02713                     JSR   HEADER
E1A6 CCDF8F           (    forth6809.asm):02714                     LDD   #DODOES
E1A9 3606             (    forth6809.asm):02715                     PSHU  D
E1AB BDEAB7           (    forth6809.asm):02716                     JSR   CCALL
E1AE CCDF9A           (    forth6809.asm):02717                     LDD   #DOESRT0
E1B1 3606             (    forth6809.asm):02718                     PSHU  D
E1B3 BDE002           (    forth6809.asm):02719                     JSR   CODECOMMA
E1B6 DC0A             (    forth6809.asm):02720                     LDD   VARHERE
E1B8 3606             (    forth6809.asm):02721                     PSHU  D
E1BA BDE002           (    forth6809.asm):02722                     JSR   CODECOMMA
E1BD CC0000           (    forth6809.asm):02723                     LDD   #0
E1C0 9E0A             (    forth6809.asm):02724                     LDX   VARHERE
E1C2 ED81             (    forth6809.asm):02725                     STD   ,X++
E1C4 ED81             (    forth6809.asm):02726                     STD   ,X++
E1C6 9F0A             (    forth6809.asm):02727                     STX   VARHERE
E1C8 39               (    forth6809.asm):02728                     RTS
                      (    forth6809.asm):02729         
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
                      (    forth6809.asm):02731         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02732         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02733         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02734         ; ------------------------------------------------------------
E1C9                  (    forth6809.asm):02735         TWOCONSTANTW:
E1C9 CCF3CB           (    forth6809.asm):02736                     LDD   #TWOFETCHW
E1CC BDE0F7           (    forth6809.asm):02737                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1CF 3706             (    forth6809.asm):02738                     PULU  D                 ; x2
E1D1 DD29             (    forth6809.asm):02739                     STD   MSCR
E1D3 DC29             (    forth6809.asm):02740                     LDD   MSCR
E1D5 3606             (    forth6809.asm):02741                     PSHU  D
E1D7 BDDFFC           (    forth6809.asm):02742                     JSR   COMMAW            ; x2 -> lower address
E1DA BDDFFC           (    forth6809.asm):02743                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1
E1DD 39               (    forth6809.asm):02744                     RTS
                      (    forth6809.asm):02745         
                      (    forth6809.asm):02746         ; ------------------------------------------------------------
                      (    forth6809.asm):02747         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02748         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):02749         ; the variable area.
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
E1DE                  (    forth6809.asm):02751         BUFFERCOLONW:
E1DE 3706             (    forth6809.asm):02752                     PULU  D                 ; u
E1E0 DD2B             (    forth6809.asm):02753                     STD   MSCR2
E1E2 CC0000           (    forth6809.asm):02754                     LDD   #0
E1E5 3606             (    forth6809.asm):02755                     PSHU  D
E1E7 BDE054           (    forth6809.asm):02756                     JSR   HEADER
E1EA CCDF8F           (    forth6809.asm):02757                     LDD   #DODOES
E1ED 3606             (    forth6809.asm):02758                     PSHU  D
E1EF BDEAB7           (    forth6809.asm):02759                     JSR   CCALL
E1F2 CCDF9A           (    forth6809.asm):02760                     LDD   #DOESRT0
E1F5 3606             (    forth6809.asm):02761                     PSHU  D
E1F7 BDE002           (    forth6809.asm):02762                     JSR   CODECOMMA
E1FA DC0A             (    forth6809.asm):02763                     LDD   VARHERE
E1FC 3606             (    forth6809.asm):02764                     PSHU  D
E1FE BDE002           (    forth6809.asm):02765                     JSR   CODECOMMA
E201 DC2B             (    forth6809.asm):02766                     LDD   MSCR2
E203 3606             (    forth6809.asm):02767                     PSHU  D
E205 BDE029           (    forth6809.asm):02768                     JSR   VALLOTW
E208 39               (    forth6809.asm):02769                     RTS
                      (    forth6809.asm):02770         
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
                      (    forth6809.asm):02772         ; DEFER  ( "name" -- )
                      (    forth6809.asm):02773         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):02774         ; throws -21.
                      (    forth6809.asm):02775         ; ------------------------------------------------------------
E209 CCDFBE           (    forth6809.asm):02776         DEFERW:     LDD   #DODEFER
E20C BDE0F7           (    forth6809.asm):02777                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E20F CCDFC6           (    forth6809.asm):02778                     LDD   #DOABORTUNDEF
E212 3606             (    forth6809.asm):02779                     PSHU  D
E214 BDDFFC           (    forth6809.asm):02780                     JSR   COMMAW
E217 39               (    forth6809.asm):02781                     RTS

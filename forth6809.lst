                      (    forth6809.asm):01991         
     DD27             (    forth6809.asm):01992         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01993                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01994                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01995                                   ; were chained on after it; before that,
                      (    forth6809.asm):01996                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01997                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01998                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01999                                   ; before this one.
                      (    forth6809.asm):02000         
                      (    forth6809.asm):02001         ; Verify no collision with base code.
                      (    forth6809.asm):02002         ; Value should match ORG BASECODE
     DD2E             (    forth6809.asm):02003         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):02004         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):02005         
                      (    forth6809.asm):02006         ; ============================================================
                      (    forth6809.asm):02007         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02008         ; ============================================================
                      (    forth6809.asm):02009                     ORG   BASECODE  ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):02010                                     ; entirely - every routine from here through
                      (    forth6809.asm):02011                                     ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):02012                                     ; every primitive) would otherwise have
                      (    forth6809.asm):02013                                     ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):02014                                     ; WARM message left the location counter,
                      (    forth6809.asm):02015                                     ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02016                                     ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02017                                     ; instead of landing in BASECODE at all
                      (    forth6809.asm):02018         
                      (    forth6809.asm):02019         ; ------------------------------------------------------------
                      (    forth6809.asm):02020         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02021         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02022         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02023         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02024         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02025         ; ------------------------------------------------------------
                      (    forth6809.asm):02026         ; ------------------------------------------------------------
                      (    forth6809.asm):02027         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02028         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02029         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02030         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02031         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02032         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02033         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02034         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02035         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02036         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02037         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02038         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02039         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02040         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02041         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02042         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02043         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02044         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02045         ; not duplicated logic in either place.
                      (    forth6809.asm):02046         ; ------------------------------------------------------------
                      (    forth6809.asm):02047         
DD2E 7F0176           (    forth6809.asm):02048         SERBUFCLR:  CLR  INHEAD
DD31 7F0177           (    forth6809.asm):02049                     CLR  INTAIL
DD34 7F0178           (    forth6809.asm):02050                     CLR  INREQUEST    ; $00 = RTS Low (Clear)
DD37 7F0179           (    forth6809.asm):02051                     CLR  OUTHEAD

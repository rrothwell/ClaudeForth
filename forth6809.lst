DED1 31               (    forth6809.asm):14834                  FCC   "1"
DED2 DEC7             (    forth6809.asm):14835                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):14836                  FDB   ONEBODY
                      (    forth6809.asm):14837         
DED6 02               (    forth6809.asm):14838         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):14839                  FCC   "-1"
DED9 DED0             (    forth6809.asm):14840                  FDB   H_1
DEDB FF49             (    forth6809.asm):14841                  FDB   MONEBODY
                      (    forth6809.asm):14842         
DEDD 01               (    forth6809.asm):14843         H_2:     FCB   1
DEDE 32               (    forth6809.asm):14844                  FCC   "2"
DEDF DED6             (    forth6809.asm):14845                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):14846                  FDB   TWOBODY
                      (    forth6809.asm):14847         

DC14 B7C008           (    forth6809.asm):01615                     STA   ACIACR
DC17 12               (    forth6809.asm):01616                     NOP                     ; Settling Delay
DC18 12               (    forth6809.asm):01617                     NOP
                      (    forth6809.asm):01618         
                      (    forth6809.asm):01619                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
DC19 8695             (    forth6809.asm):01620                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on

                      (    forth6809.asm):01686         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):01687         ; Covers every word in that section, with representative
                      (    forth6809.asm):01688         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):01689         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):01690         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):01691         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):01692         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):01693         ; cases chosen.
                      (    forth6809.asm):01694         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01695         TSTSARITH: JSR   CRW
                      (    forth6809.asm):01696                    LDX   #TSTSARITHMSG
                      (    forth6809.asm):01697                    PSHU  X
                      (    forth6809.asm):01698                    LDD   #11
                      (    forth6809.asm):01699                    PSHU  D
                      (    forth6809.asm):01700                    JSR   TYPE
                      (    forth6809.asm):01701                    JSR   CRW
                      (    forth6809.asm):01702         
                      (    forth6809.asm):01703                    IFEQ TSTSELECTOR-1  ; >>>>
                      (    forth6809.asm):01704         
                      (    forth6809.asm):01705                    JSR   TSTPLUS
                      (    forth6809.asm):01706                    JSR   TSTMINUS
                      (    forth6809.asm):01707                    JSR   TSTSTAR1
                      (    forth6809.asm):01708                    JSR   TSTSTAR2
                      (    forth6809.asm):01709                    JSR   TSTSLASH1
                      (    forth6809.asm):01710                    JSR   TSTSLASH2
                      (    forth6809.asm):01711                    JSR   TSTSLASHZ
                      (    forth6809.asm):01712                    JSR   TSTMODW
                      (    forth6809.asm):01713                    JSR   TSTMODZ
                      (    forth6809.asm):01714                    JSR   TSTSLMOD
                      (    forth6809.asm):01715                    JSR   TSTSLMODZ
                      (    forth6809.asm):01716                    JSR   TSTNEGATE
                      (    forth6809.asm):01717                    JSR   TSTABS1
                      (    forth6809.asm):01718                    JSR   TSTABS2
                      (    forth6809.asm):01719                    JSR   TSTMIN1
                      (    forth6809.asm):01720                    JSR   TSTMIN2
                      (    forth6809.asm):01721                    JSR   TSTMAX1
                      (    forth6809.asm):01722                    JSR   TSTMAX2
                      (    forth6809.asm):01723                    JSR   TSTONEP
                      (    forth6809.asm):01724                    JSR   TSTONEM
                      (    forth6809.asm):01725                    JSR   TSTTWOP
                      (    forth6809.asm):01726                    JSR   TSTTWOS
                      (    forth6809.asm):01727                    JSR   TSTTWOD1
                      (    forth6809.asm):01728                    JSR   TSTTWOD2
                      (    forth6809.asm):01729                    JSR   TSTSTSL
                      (    forth6809.asm):01730                    JSR   TSTSTSLZ
                      (    forth6809.asm):01731                    JSR   TSTSTSM
                      (    forth6809.asm):01732                    JSR   TSTSTSMZ
                      (    forth6809.asm):01733         
                      (    forth6809.asm):01734                    ENDC ; <<<<
                      (    forth6809.asm):01735         
                      (    forth6809.asm):01736                    RTS
                      (    forth6809.asm):01737         
C100                  (    forth6809.asm):01738         TSTSARITHMSG: FCC "SArithmetic"

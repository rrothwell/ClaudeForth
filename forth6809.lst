                      (    forth6809.asm):15277         ; TSTTHROWZERO - unit test for THROW(0). Confirmed via its own
                      (    forth6809.asm):15278         ; code that N=0 is a genuine, unconditional no-op (BEQ THDONE
                      (    forth6809.asm):15279         ; skips everything, never touching HANDLER or ABORT), so this
                      (    forth6809.asm):15280         ; is the one THROW call in this section safe to make directly,
                      (    forth6809.asm):15281         ; without any CATCH wrapping it. Verifies it consumes its
                      (    forth6809.asm):15282         ; argument and does nothing else - no non-local exit, no stack
                      (    forth6809.asm):15283         ; disturbance beyond popping the 0 itself.
                      (    forth6809.asm):15284         ; ------------------------------------------------------------
C308                  (    forth6809.asm):15285         TSTTHROWZERO: STU  TSTU0
                      (    forth6809.asm):15286         
                      (    forth6809.asm):15287                       LDD  #TSTGUARD
                      (    forth6809.asm):15288                       PSHU D

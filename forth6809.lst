                      (    forth6809.asm):07763         ; TSTDEFWORDS - defining-words tests (glossary section 3.9, 17
                      (    forth6809.asm):07764         ; words, 12 tests since VALUE/TO and IS/ACTION-OF are each
                      (    forth6809.asm):07765         ; combined into one test). Every defining word parses a name
                      (    forth6809.asm):07766         ; from the input source via WORD (HEADER's own mechanism,
                      (    forth6809.asm):07767         ; shared by :/CREATE) - a complexity nothing in section 3.8 had.
                      (    forth6809.asm):07768         ; Each test redirects CODEHERE, DPHERE, VARHERE, and
                      (    forth6809.asm):07769         ; SRCADDR/SRCLEN/TOIN together (a fake name, "TESTWD", reused
                      (    forth6809.asm):07770         ; safely across every test here since each redirect/restore
                      (    forth6809.asm):07771         ; cycle is fully isolated), calls the real defining word
                      (    forth6809.asm):07772         ; directly, saves the newly-defined word's own CFA (= CODEHERE
                      (    forth6809.asm):07773         ; at the moment the defining word was called), restores
                      (    forth6809.asm):07774         ; everything, then executes that CFA directly to verify runtime
                      (    forth6809.asm):07775         ; behavior.
                      (    forth6809.asm):07776         ;
                      (    forth6809.asm):07777         ; A real, structurally important finding from this section:
                      (    forth6809.asm):07778         ; HEADER writes to the real LATEST variable unconditionally, not
                      (    forth6809.asm):07779         ; a redirectable copy like CODEHERE/DPHERE/VARHERE - every test
                      (    forth6809.asm):07780         ; here explicitly saves and restores it, confirmed necessary by
                      (    forth6809.asm):07781         ; reading HEADER's own code directly, not assumed safe by analogy
                      (    forth6809.asm):07782         ; with the other three pointers.
                      (    forth6809.asm):07783         ;
                      (    forth6809.asm):07784         ; MARKER's own test is the one exception to the general
                      (    forth6809.asm):07785         ; redirect-then-restore-then-execute order: DOMARKER (confirmed
                      (    forth6809.asm):07786         ; by reading it directly) writes to the real DPHERE/CODEHERE/
                      (    forth6809.asm):07787         ; VARHERE/LATEST unconditionally too, so that test executes the
                      (    forth6809.asm):07788         ; marker word while still redirected, only restoring the real
                      (    forth6809.asm):07789         ; environment afterward - getting this order backwards would
                      (    forth6809.asm):07790         ; have corrupted the real dictionary pointers with scratch
                      (    forth6809.asm):07791         ; addresses.
                      (    forth6809.asm):07792         ;
                      (    forth6809.asm):07793         ; Bare CREATE (never followed by DOES>) is deliberately not
                      (    forth6809.asm):07794         ; tested on its own - traced its placeholder "behavior field"
                      (    forth6809.asm):07795         ; (a genuine compiled JSR DOESRT0 instruction) and confirmed
                      (    forth6809.asm):07796         ; DODOES reads that field as raw data, not as code to execute -
                      (    forth6809.asm):07797         ; which only produces a valid jump target for the raw-address
                      (    forth6809.asm):07798         ; form every other defining word uses (VARIABLE, CONSTANT, etc,
                      (    forth6809.asm):07799         ; via CODECOMMA), not CREATE's own placeholder JSR instruction.
                      (    forth6809.asm):07800         ; Bare CREATE's own direct-execution behavior isn't meant to be
                      (    forth6809.asm):07801         ; relied upon before a DOES> patches it.
                      (    forth6809.asm):07802         ; ------------------------------------------------------------
C23F BDFC2B           (    forth6809.asm):07803         TSTDEFWORDS: JSR CRW
C242 8EC253           (    forth6809.asm):07804                    LDX   #TSTDEFMSG
C245 3610             (    forth6809.asm):07805                    PSHU  X
C247 CC0008           (    forth6809.asm):07806                    LDD   #8
C24A 3606             (    forth6809.asm):07807                    PSHU  D
C24C BDF60B           (    forth6809.asm):07808                    JSR   TYPE
C24F BDFC2B           (    forth6809.asm):07809                    JSR   CRW
                      (    forth6809.asm):07810         
                      (    forth6809.asm):07811                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07812         
                      (    forth6809.asm):07813                    JSR   TSTVAR
                      (    forth6809.asm):07814                    JSR   TSTCONST
                      (    forth6809.asm):07815                    JSR   TSTCOLON
                      (    forth6809.asm):07816                    JSR   TSTCRDOES
                      (    forth6809.asm):07817                    JSR   TST2VAR
                      (    forth6809.asm):07818                    JSR   TST2CONST
                      (    forth6809.asm):07819                    JSR   TSTBUFC
                      (    forth6809.asm):07820                    JSR   TSTVALTO
                      (    forth6809.asm):07821                    JSR   TSTDEFER1
                      (    forth6809.asm):07822                    JSR   TSTDEFER2
                      (    forth6809.asm):07823                    JSR   TSTISOF
                      (    forth6809.asm):07824                    JSR   TSTMARKER
                      (    forth6809.asm):07825         
                      (    forth6809.asm):07826                    ENDC ; <<<<
                      (    forth6809.asm):07827         
C252 39               (    forth6809.asm):07828                    RTS
                      (    forth6809.asm):07829         
C253 446566576F726473 (    forth6809.asm):07830         TSTDEFMSG: FCC "DefWords"
                      (    forth6809.asm):07831         
                      (    forth6809.asm):07832                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07833         
                      (    forth6809.asm):07834         ; ------------------------------------------------------------
                      (    forth6809.asm):07835         ; Defining-words test harness (glossary section 3.9). Every
                      (    forth6809.asm):07836         ; defining word parses a name from the input source via WORD -
                      (    forth6809.asm):07837         ; unlike anything in section 3.8's control-flow tests - so each
                      (    forth6809.asm):07838         ; test redirects CODEHERE, DPHERE, VARHERE, and SRCADDR/SRCLEN/
                      (    forth6809.asm):07839         ; TOIN together (a fake name text, "TESTWD", reused safely
                      (    forth6809.asm):07840         ; across every test here since each redirect/restore cycle is
                      (    forth6809.asm):07841         ; fully isolated), calls the real defining word directly, saves
                      (    forth6809.asm):07842         ; the newly-defined word's own CFA (= CODEHERE at the moment the
                      (    forth6809.asm):07843         ; defining word was called), restores everything, then executes
                      (    forth6809.asm):07844         ; that CFA directly to verify runtime behavior. Traced by hand:
                      (    forth6809.asm):07845         ; CREATE/VARIABLE/CONSTANT/etc all use HEADER (shared header-
                      (    forth6809.asm):07846         ; building) then compile a fixed 5-byte trampoline (3-byte
                      (    forth6809.asm):07847         ; "JSR DODOES" + a 2-byte "behavior field") before their own
                      (    forth6809.asm):07848         ; PFA - confirmed the behavior field holds a genuine compiled
                      (    forth6809.asm):07849         ; JSR instruction only for CREATE's own bare placeholder
                      (    forth6809.asm):07850         ; (DOESRT0, later patched by DOES>); every other defining word
                      (    forth6809.asm):07851         ; (VARIABLE, CONSTANT, DEFER, MARKER, VALUE) instead compiles a
                      (    forth6809.asm):07852         ; raw 2-byte address there directly (via CODECOMMA, not CCALL) -
                      (    forth6809.asm):07853         ; DODOES reads this field as data either way, which only works
                      (    forth6809.asm):07854         ; correctly for the raw-address form. This is why bare CREATE,
                      (    forth6809.asm):07855         ; executed before any DOES>, isn't tested here - its own
                      (    forth6809.asm):07856         ; placeholder behavior field isn't meant to be read as data,
                      (    forth6809.asm):07857         ; only ever overwritten by DOES> before first use.
                      (    forth6809.asm):07858         ; ------------------------------------------------------------
                      (    forth6809.asm):07859         
                      (    forth6809.asm):07860         ; ------------------------------------------------------------
                      (    forth6809.asm):07861         ; TSTVAR - unit test for VARIABLE. Compiles "VARIABLE TESTWD"
                      (    forth6809.asm):07862         ; into scratch, then executes the result. Verifies it pushes
                      (    forth6809.asm):07863         ; its own PFA address (TSTVBUF, since VARHERE was redirected
                      (    forth6809.asm):07864         ; there) and that the cell there was correctly initialized to
                      (    forth6809.asm):07865         ; zero - VARIABLE's own documented behavior, not assumed.
                      (    forth6809.asm):07866         ; ------------------------------------------------------------
C25B                  (    forth6809.asm):07867         TSTVAR:  LDD   CODEHERE
                      (    forth6809.asm):07868                  STD   TSTCSAV
                      (    forth6809.asm):07869                  LDD   DPHERE
                      (    forth6809.asm):07870                  STD   TSTDSAV
                      (    forth6809.asm):07871                  LDD   VARHERE
                      (    forth6809.asm):07872                  STD   TSTVSAV
                      (    forth6809.asm):07873                  LDD   SRCADDR
                      (    forth6809.asm):07874                  STD   TSTSASAV
                      (    forth6809.asm):07875                  LDD   SRCLEN
                      (    forth6809.asm):07876                  STD   TSTSLSAV
                      (    forth6809.asm):07877                  LDD   TOIN
                      (    forth6809.asm):07878                  STD   TSTTISAV
                      (    forth6809.asm):07879                  LDD   LATEST
                      (    forth6809.asm):07880                  STD   TSTLSAV
                      (    forth6809.asm):07881         
                      (    forth6809.asm):07882                  LDA   #'T'
                      (    forth6809.asm):07883                  STA   TSTNAMEB
                      (    forth6809.asm):07884                  LDA   #'E'
                      (    forth6809.asm):07885                  STA   TSTNAMEB+1

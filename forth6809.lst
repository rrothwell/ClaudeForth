     E003             (    forth6809.asm):01905         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01906                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01907                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01908                                   ; were chained on after it; before that,
                      (    forth6809.asm):01909                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01910                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01911                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01912                                   ; before this one.
                      (    forth6809.asm):01913         
                      (    forth6809.asm):01914         ; Verify no collision with base code.
                      (    forth6809.asm):01915         ; Value should match ORG BASECODE
     E00A             (    forth6809.asm):01916         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01917         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01918         
                      (    forth6809.asm):01919         ; ============================================================
                      (    forth6809.asm):01920         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01921         ; ============================================================
                      (    forth6809.asm):01922                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01923                                        ; entirely - every routine from here through
                      (    forth6809.asm):01924                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01925                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01926                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01927                                        ; WARM message left the location counter,
                      (    forth6809.asm):01928                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01929                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01930                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01931         
                      (    forth6809.asm):01932         ; ------------------------------------------------------------
                      (    forth6809.asm):01933         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01934         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01935         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01936         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01937         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01938         ; ------------------------------------------------------------
E00A 8603             (    forth6809.asm):01939         INITSERIAL: LDA   #$03
E00C B7C008           (    forth6809.asm):01940                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01941                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01942                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01943                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01944                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01945                  ELSE  ; <<<<<>>>>>
E00F 8615             (    forth6809.asm):01946                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01947                  ENDC  ; <<<<<<<<<<
E011 B7C008           (    forth6809.asm):01948                  STA   ACIACR         ; was "STA ACIA" - same fix
E014 39               (    forth6809.asm):01949                  RTS
                      (    forth6809.asm):01950         
                      (    forth6809.asm):01951                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01952         ; ------------------------------------------------------------
                      (    forth6809.asm):01953         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01954         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01955         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01956         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01957         ; ------------------------------------------------------------
E015                  (    forth6809.asm):01958         INFILL:  LDA   INHEAD
                      (    forth6809.asm):01959                  SUBA  INTAIL
                      (    forth6809.asm):01960                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):01961                  RTS
                      (    forth6809.asm):01962         
                      (    forth6809.asm):01963         ; ------------------------------------------------------------
                      (    forth6809.asm):01964         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01965         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01966         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01967         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01968         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01969         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01970         ; flow control, not a chip feature.
                      (    forth6809.asm):01971         ; ------------------------------------------------------------
E015                  (    forth6809.asm):01972         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):01973                     CMPA #INHIWATER
                      (    forth6809.asm):01974                     BLO  RTSCHIDONE
                      (    forth6809.asm):01975                     TST  RTSSTATE
                      (    forth6809.asm):01976                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):01977                     LDA  #CR_RTSHI
                      (    forth6809.asm):01978                     STA  ACIACR
                      (    forth6809.asm):01979                     LDA  #1
                      (    forth6809.asm):01980                     STA  RTSSTATE
E015                  (    forth6809.asm):01981         RTSCHIDONE: RTS
                      (    forth6809.asm):01982         
                      (    forth6809.asm):01983         ; ------------------------------------------------------------
                      (    forth6809.asm):01984         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):01985         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):01986         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):01987         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):01988         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):01989         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):01990         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01991         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01992         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):01993         ; ------------------------------------------------------------
E015                  (    forth6809.asm):01994         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):01995                     CMPA #INLOWATER
                      (    forth6809.asm):01996                     BHI  RTSCLODONE
                      (    forth6809.asm):01997                     TST  RTSSTATE
                      (    forth6809.asm):01998                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):01999                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02000                     CLR  RTSSTATE
                      (    forth6809.asm):02001                     LDB  OUTTAIL
                      (    forth6809.asm):02002                     CMPB OUTHEAD
                      (    forth6809.asm):02003                     BEQ  RTSCLONOTX
                      (    forth6809.asm):02004                     LDA  #CR_RXTX
                      (    forth6809.asm):02005                     STA  ACIACR
                      (    forth6809.asm):02006                     BRA  RTSCLOUNMASK
E015                  (    forth6809.asm):02007         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):02008                     STA  ACIACR
E015                  (    forth6809.asm):02009         RTSCLOUNMASK: ANDCC #$EF
E015                  (    forth6809.asm):02010         RTSCLODONE: RTS
                      (    forth6809.asm):02011         
E015                  (    forth6809.asm):02012         IRQH:    LDA   ACIASR
                      (    forth6809.asm):02013                  BITA  #SR_IRQ
                      (    forth6809.asm):02014                  BEQ   IRQDONE
                      (    forth6809.asm):02015         
                      (    forth6809.asm):02016                  BITA  #SR_RDRF
                      (    forth6809.asm):02017                  BEQ   TXCHK
                      (    forth6809.asm):02018         
                      (    forth6809.asm):02019                  LDB   INHEAD
                      (    forth6809.asm):02020                  LDA   ACIADR
                      (    forth6809.asm):02021                  LDX   #INBUF
                      (    forth6809.asm):02022                  STA   B,X
                      (    forth6809.asm):02023                  INCB
                      (    forth6809.asm):02024                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02025                  CMPB  INTAIL
                      (    forth6809.asm):02026                  BEQ   IRQDONE
                      (    forth6809.asm):02027                  STB   INHEAD
                      (    forth6809.asm):02028                  JSR   RTSCHECKHI
                      (    forth6809.asm):02029                  BRA   IRQDONE
                      (    forth6809.asm):02030         
E015                  (    forth6809.asm):02031         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):02032                  CMPB  OUTHEAD
                      (    forth6809.asm):02033                  BEQ   TXOFF
                      (    forth6809.asm):02034                  LDX   #OUTBUF
                      (    forth6809.asm):02035                  LDA   B,X
                      (    forth6809.asm):02036                  STA   ACIADR
                      (    forth6809.asm):02037                  INCB
                      (    forth6809.asm):02038                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02039                  STB   OUTTAIL
                      (    forth6809.asm):02040                  BRA   IRQDONE
                      (    forth6809.asm):02041         
E015                  (    forth6809.asm):02042         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):02043                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02044                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):02045                  LDA   #CR_RXON
                      (    forth6809.asm):02046                  STA   ACIACR
                      (    forth6809.asm):02047         
E015                  (    forth6809.asm):02048         IRQDONE: RTI
                      (    forth6809.asm):02049         
                      (    forth6809.asm):02050                  ELSE  ; <<<<<>>>>>
E015 3B               (    forth6809.asm):02051         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02052                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02053                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02054                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02055                                       ; the other unused vectors below
                      (    forth6809.asm):02056                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02057         
E016 3B               (    forth6809.asm):02058         SWI3H:   RTI
E017 3B               (    forth6809.asm):02059         SWI2H:   RTI
E018 3B               (    forth6809.asm):02060         FIRQH:   RTI
E019 3B               (    forth6809.asm):02061         NMIH:    RTI                   ; unused now that NMI -> WARM
E01A CCFF9D           (    forth6809.asm):02062         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
E01D 3606             (    forth6809.asm):02063                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
E01F 7EE7B4           (    forth6809.asm):02064                  JMP   THROW
                      (    forth6809.asm):02065         
                      (    forth6809.asm):02066         ; ============================================================
                      (    forth6809.asm):02067         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)

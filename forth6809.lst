                      (    forth6809.asm):10552                     BNE  XQFAIL
                      (    forth6809.asm):10553                     PULU D
                      (    forth6809.asm):10554                     CMPD #TSTGUARD
                      (    forth6809.asm):10555                     BNE  XQFAIL
                      (    forth6809.asm):10556         
                      (    forth6809.asm):10557                     LDD  TSTUB4
                      (    forth6809.asm):10558                     SUBD TSTUAF
                      (    forth6809.asm):10559                     CMPD #0
                      (    forth6809.asm):10560                     BNE  XQFAIL
                      (    forth6809.asm):10561         
                      (    forth6809.asm):10562                     LDD  #TRUEV

                      (    forth6809.asm):09433         ; DISASM: 6809 disassembler (hexadecimal, lwasm style).
                      (    forth6809.asm):09434         ;
                      (    forth6809.asm):09435         ; DASM  ( addr -- addr' )   Send one instruction as text, for example
                      (    forth6809.asm):09436         ;       LDA #$A5  or  LDX <$7B  or  STA $0A,X  or  BRA $4010, and return
                      (    forth6809.asm):09437         ;       the address of the next instruction. Branch and PC-relative
                      (    forth6809.asm):09438         ;       operands show the absolute target address. A byte that is not
                      (    forth6809.asm):09439         ;       a legal instruction shows as FCB $xx and is one byte long.
                      (    forth6809.asm):09440         ; DIS   ( addr u -- )       List the instructions that start in
                      (    forth6809.asm):09441         ;       addr .. addr+u-1, one per line: address, bytes, text.
                      (    forth6809.asm):09442         ;
                      (    forth6809.asm):09443         ; The decoder is table driven: the name pool and the tables follow the
                      (    forth6809.asm):09444         ; code. Every character goes out through DCH, which is silenced while
                      (    forth6809.asm):09445         ; DISMUTE is non-zero so that DIS can measure an instruction first.
                      (    forth6809.asm):09446         ; ------------------------------------------------------------

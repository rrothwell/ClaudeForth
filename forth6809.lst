E0D1 3606             (    forth6809.asm):02782                     PSHU  D
E0D3 BDEA85           (    forth6809.asm):02783                     JSR   CCALL
E0D6 CCDE9F           (    forth6809.asm):02784                     LDD   #DOESRT0
E0D9 3606             (    forth6809.asm):02785                     PSHU  D
E0DB BDDF08           (    forth6809.asm):02786                     JSR   CODECOMMA
E0DE DC0A             (    forth6809.asm):02787                     LDD   VARHERE
E0E0 3606             (    forth6809.asm):02788                     PSHU  D
E0E2 BDDF08           (    forth6809.asm):02789                     JSR   CODECOMMA
E0E5 CC0000           (    forth6809.asm):02790                     LDD   #0
E0E8 9E0A             (    forth6809.asm):02791                     LDX   VARHERE
E0EA ED81             (    forth6809.asm):02792                     STD   ,X++
E0EC ED81             (    forth6809.asm):02793                     STD   ,X++
E0EE 9F0A             (    forth6809.asm):02794                     STX   VARHERE
E0F0 39               (    forth6809.asm):02795                     RTS
                      (    forth6809.asm):02796         
                      (    forth6809.asm):02797         ; ------------------------------------------------------------
                      (    forth6809.asm):02798         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02799         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02800         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02801         ; ------------------------------------------------------------
E0F1                  (    forth6809.asm):02802         TWOCONSTANTW:
E0F1 CC0000           (    forth6809.asm):02803                     LDD   #0
E0F4 3606             (    forth6809.asm):02804                     PSHU  D
E0F6 BDDF5A           (    forth6809.asm):02805                     JSR   HEADER
E0F9 CCDE94           (    forth6809.asm):02806                     LDD   #DODOES
E0FC 3606             (    forth6809.asm):02807                     PSHU  D
E0FE BDEA85           (    forth6809.asm):02808                     JSR   CCALL
E101 CCF3F9           (    forth6809.asm):02809                     LDD   #DFETCHW
E104 3606             (    forth6809.asm):02810                     PSHU  D
E106 BDDF08           (    forth6809.asm):02811                     JSR   CODECOMMA
E109 DC08             (    forth6809.asm):02812                     LDD   CODEHERE          ; PFA = the cell after this one
E10B C30002           (    forth6809.asm):02813                     ADDD  #2                ; See bugfix: CONSTANTW.1
E10E 3606             (    forth6809.asm):02814                     PSHU  D
E110 BDDF08           (    forth6809.asm):02815                     JSR   CODECOMMA
E113 3706             (    forth6809.asm):02816                     PULU  D                 ; x2
E115 DD29             (    forth6809.asm):02817                     STD   MSCR
E117 DC29             (    forth6809.asm):02818                     LDD   MSCR
E119 3606             (    forth6809.asm):02819                     PSHU  D
E11B BDDF02           (    forth6809.asm):02820                     JSR   COMMAW            ; x2 -> lower address

                      (    forth6809.asm):04578         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):04579         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):04580         ; the string.
                      (    forth6809.asm):04581         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):04582         ;    Inputs:
                      (    forth6809.asm):04583         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):04584         ;        count byte
                      (    forth6809.asm):04585         ;    Outputs:
                      (    forth6809.asm):04586         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):04587         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):04588         ; ------------------------------------------------------------

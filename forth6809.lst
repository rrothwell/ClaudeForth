F42A 3606             (    forth6809.asm):06367                     PSHU  D
F42C 3085             (    forth6809.asm):06368                     LEAX  B,X
F42E 3410             (    forth6809.asm):06369                     PSHS  X
F430 7EF43C           (    forth6809.asm):06370                     JMP   TYPEW
                      (    forth6809.asm):06371         
                      (    forth6809.asm):06372         ; ------------------------------------------------------------
                      (    forth6809.asm):06373         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06374         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06375         ; counted string.
                      (    forth6809.asm):06376         ; ------------------------------------------------------------

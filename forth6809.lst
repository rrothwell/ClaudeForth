F592                  (    forth6809.asm):05477         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):05478                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):05479                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):05480                                   ; characters and (worse) shared identically
                      (    forth6809.asm):05481                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):05482                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):05483                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):05484                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):05485                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):05486                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):05487                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):05488                                   ; testing/design decision: rather than give
                      (    forth6809.asm):05489                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):05490                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):05491                                   ; definition for stable storage instead - but
                      (    forth6809.asm):05492                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):05493                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):05494                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):05495                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):05496                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):05497                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):05498                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):05499                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):05500                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):05501                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):05502                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):05503                   JSR  PADW

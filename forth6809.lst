E318 20B5             (    forth6809.asm):02955                     BRA   ILOOP
                      (    forth6809.asm):02956         
E31A                  (    forth6809.asm):02957         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):02958                                             ; ANS's (ud1) stack order directly.
E31A DC00             (    forth6809.asm):02959                     LDD   STATE
E31C 27B1             (    forth6809.asm):02960                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):02961                                             ; nothing more to do
                      (    forth6809.asm):02962                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):02963                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):02964                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):02965                     ; pop it aside first, freeing UDLO to be compiled first.
E31E 3706             (    forth6809.asm):02966                     PULU  D
E320 DD2F             (    forth6809.asm):02967                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):02968                                             ; untouched by CCALL/CODECOMMA
E322 CCDF67           (    forth6809.asm):02969                     LDD   #LIT
E325 3606             (    forth6809.asm):02970                     PSHU  D
E327 BDEABB           (    forth6809.asm):02971                     JSR   CCALL

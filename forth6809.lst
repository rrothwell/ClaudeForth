DEEC DDFB             (    forth6809.asm):02108                     STD   QTHROWCODE
DEEE 10830000         (    forth6809.asm):02109                     CMPD  #0
DEF2 273B             (    forth6809.asm):02110                     BEQ   QOK
                      (    forth6809.asm):02111         
DEF4 DCF3             (    forth6809.asm):02112                     LDD   QSAVEDP

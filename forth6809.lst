                      (   unit_tests.asm):05644         ; Control-flow test harness (glossary section 3.8). Each test
                      (   unit_tests.asm):05645         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (   unit_tests.asm):05646         ; real compile-time control-flow words directly (JSR IF, JSR
                      (   unit_tests.asm):05647         ; THEN, etc - the same routines the compiler itself calls when
                      (   unit_tests.asm):05648         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (   unit_tests.asm):05649         ; then restores CODEHERE and executes the compiled snippet
                      (   unit_tests.asm):05650         ; directly. This tests the actual interaction between compile-
                      (   unit_tests.asm):05651         ; time correctness (right bytes, right patched offsets) and
                      (   unit_tests.asm):05652         ; runtime correctness (right control flow) in one coherent
                      (   unit_tests.asm):05653         ; test, without needing the outer interpreter, FIND, or a
                      (   unit_tests.asm):05654         ; dictionary entry - matching the ANS test suite's own planned
                      (   unit_tests.asm):05655         ; role for broader standards-compliance coverage; these tests
                      (   unit_tests.asm):05656         ; specifically verify this system's own compile/patch mechanism
                      (   unit_tests.asm):05657         ; works correctly, not full end-to-end parsing.
                      (   unit_tests.asm):05658         ; ------------------------------------------------------------
                      (   unit_tests.asm):05659         
                      (   unit_tests.asm):05660         ; ------------------------------------------------------------
                      (   unit_tests.asm):05661         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (   unit_tests.asm):05662         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (   unit_tests.asm):05663         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (   unit_tests.asm):05664         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (   unit_tests.asm):05665         ; offset comes out to 7 (from the placeholder field to just
                      (   unit_tests.asm):05666         ; past the compiled LIT+111), correctly skipping nothing when
                      (   unit_tests.asm):05667         ; the flag is true and falling through into the literal.
                      (   unit_tests.asm):05668         ; ------------------------------------------------------------

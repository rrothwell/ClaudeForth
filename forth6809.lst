                      (    forth6809.asm):05804         ; TSTIET1 - unit test for IF/ELSE/THEN, true case. Compiles
                      (    forth6809.asm):05805         ; "IF <lit 111> ELSE <lit 222> THEN" into scratch. True flag
                      (    forth6809.asm):05806         ; should take the IF-body (111) and skip the ELSE-body (222)
                      (    forth6809.asm):05807         ; via ELSE's own unconditional branch. Verified by hand-trace:
                      (    forth6809.asm):05808         ; IF's patched offset (12) lands exactly at the ELSE-body's
                      (    forth6809.asm):05809         ; start; ELSE's own patched offset (7) lands exactly past it.
                      (    forth6809.asm):05810         ; ------------------------------------------------------------

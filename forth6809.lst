                      (    forth6809.asm):04030         
                      (    forth6809.asm):04031         ; ------------------------------------------------------------
                      (    forth6809.asm):04032         ; Replace the first wordlist of the search order with the WID in RegX,
                      (    forth6809.asm):04033         ; or make it the only one if the order is empty.
                      (    forth6809.asm):04034         ; SETTOP
                      (    forth6809.asm):04035         ;    Inputs:
                      (    forth6809.asm):04036         ;        RegX = WID
                      (    forth6809.asm):04037         ;    Outputs:
                      (    forth6809.asm):04038         ;        ORDER(0) = WID; ORDEND at least ORDER+2
                      (    forth6809.asm):04039         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):04040         ; ------------------------------------------------------------
D6E2 9F4B             (    forth6809.asm):04041         SETTOP:     STX   ORDER
D6E4 DC49             (    forth6809.asm):04042                     LDD   ORDEND
D6E6 1083004D         (    forth6809.asm):04043                     CMPD  #ORDER+2

                      (    forth6809.asm):03382         ; ------------------------------------------------------------
                      (    forth6809.asm):03383         ; ECHOEMIT - non-blocking echo variant of EMIT, used only by
                      (    forth6809.asm):03384         ; ACCEPT's own echo path (below, shared/unconditional code).
                      (    forth6809.asm):03385         ; BUG FIX: ACCEPT previously used the real EMIT to echo received
                      (    forth6809.asm):03386         ; characters back out - EMIT's own spin-wait (EMITWT, above) can
                      (    forth6809.asm):03387         ; block forever if OUTBUF is full while RTS is asserted high,
                      (    forth6809.asm):03388         ; since only IRQH's own TX path ever advances OUTTAIL, and that
                      (    forth6809.asm):03389         ; path requires TX-interrupt to be enabled - which CR_RTSHI
                      (    forth6809.asm):03390         ; (RTSCHECKHI, above) unconditionally disables. Traced precisely:
                      (    forth6809.asm):03391         ; ACCEPT's own ALOOP only calls KEY again after EMIT returns, and
                      (    forth6809.asm):03392         ; RTSCHECKLO (the only thing that ever clears RTSSTATE and
                      (    forth6809.asm):03393         ; restores TX-interrupt-enable) is only ever called from within
                      (    forth6809.asm):03394         ; KEY - so a blocked echo call permanently prevents the one thing
                      (    forth6809.asm):03395         ; that could unblock it, a genuine deadlock, not just a slow
                      (    forth6809.asm):03396         ; path. ECHOEMIT is identical to EMIT except it silently drops
                      (    forth6809.asm):03397         ; the character instead of spinning when OUTBUF is full - the
                      (    forth6809.asm):03398         ; character itself was already correctly received and stored in
                      (    forth6809.asm):03399         ; the input buffer; only its own visual echo is skipped, and only
                      (    forth6809.asm):03400         ; under the kind of sustained overload where this would otherwise
                      (    forth6809.asm):03401         ; deadlock the whole system. A fixed-retry-count compromise was
                      (    forth6809.asm):03402         ; considered and deliberately deferred - not worth the added
                      (    forth6809.asm):03403         ; complexity unless a real problem with dropped echoes actually
                      (    forth6809.asm):03404         ; shows up in practice.
                      (    forth6809.asm):03405         ;
                      (    forth6809.asm):03406         ; Deliberately defined here, inside the SERIALPOLL=0 branch only
                      (    forth6809.asm):03407         ; (with a separate, trivial pass-through defined in the
                      (    forth6809.asm):03408         ; SERIALPOLL=1 branch below) - not as a single, unconditional
                      (    forth6809.asm):03409         ; definition. This code directly manipulates OUTHEAD/OUTTAIL/
                      (    forth6809.asm):03410         ; RTSSTATE and writes CR_RXTX to ACIACR; under SERIALPOLL=1,
                      (    forth6809.asm):03411         ; where IRQH is just an RTI stub, writing CR_RXTX (RX+TX
                      (    forth6809.asm):03412         ; interrupt enabled) would start the ACIA generating real
                      (    forth6809.asm):03413         ; interrupts that nothing ever services or clears - an interrupt
                      (    forth6809.asm):03414         ; storm, not merely a wasted write. ACCEPT's own call site stays
                      (    forth6809.asm):03415         ; simple, unconditional code either way, since both branches
                      (    forth6809.asm):03416         ; provide a same-named, same-signature routine.
                      (    forth6809.asm):03417         ; ------------------------------------------------------------
E65B 3706             (    forth6809.asm):03418         ECHOEMIT: PULU  D
E65D D73C             (    forth6809.asm):03419                   STB   EMITCH
E65F F60108           (    forth6809.asm):03420                   LDB   OUTHEAD
E662 5C               (    forth6809.asm):03421                   INCB
E663 C43F             (    forth6809.asm):03422                   ANDB  #OUTBUFSZ-1
E665 F10109           (    forth6809.asm):03423                   CMPB  OUTTAIL
E668 2719             (    forth6809.asm):03424                   BEQ   ECHOSKIP        ; OUTBUF full - drop this echo
                      (    forth6809.asm):03425                                         ; character rather than spin
E66A 8E014A           (    forth6809.asm):03426                   LDX   #OUTBUF
E66D F60108           (    forth6809.asm):03427                   LDB   OUTHEAD
E670 963C             (    forth6809.asm):03428                   LDA   EMITCH
E672 A785             (    forth6809.asm):03429                   STA   B,X
E674 5C               (    forth6809.asm):03430                   INCB
E675 C43F             (    forth6809.asm):03431                   ANDB  #OUTBUFSZ-1
E677 F70108           (    forth6809.asm):03432                   STB   OUTHEAD
E67A 0DFF             (    forth6809.asm):03433                   TST   RTSSTATE
E67C 2605             (    forth6809.asm):03434                   BNE   ECHOSKIP
E67E 86B5             (    forth6809.asm):03435                   LDA   #CR_RXTX
E680 B7C008           (    forth6809.asm):03436                   STA   ACIACR
E683 39               (    forth6809.asm):03437         ECHOSKIP: RTS
                      (    forth6809.asm):03438         

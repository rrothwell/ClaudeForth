                      (    forth6809.asm):02089                     ENDC                    ; <<<<<<<<<<
CEEB B7C008           (    forth6809.asm):02090                     STA   ACIACR            ; See bugfix: INITSERIAL.1
CEEE 39               (    forth6809.asm):02091                     RTS
                      (    forth6809.asm):02092         
                      (    forth6809.asm):02093                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02094         ; ------------------------------------------------------------
                      (    forth6809.asm):02095         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02096         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02097         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02098         ; INFILL
                      (    forth6809.asm):02099         ;    Inputs:
                      (    forth6809.asm):02100         ;        none
                      (    forth6809.asm):02101         ;    Outputs:
                      (    forth6809.asm):02102         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02103         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02104         ; ------------------------------------------------------------
CEEF B60176           (    forth6809.asm):02105         INFILL:     LDA   INHEAD
CEF2 B00177           (    forth6809.asm):02106                     SUBA  INTAIL
CEF5 843F             (    forth6809.asm):02107                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
CEF7 39               (    forth6809.asm):02108                     RTS
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
                      (    forth6809.asm):02110         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02111         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02112         ; receive path with interrupts already masked.
                      (    forth6809.asm):02113         ; RTSCHECKHI
                      (    forth6809.asm):02114         ;    Inputs:
                      (    forth6809.asm):02115         ;        none
                      (    forth6809.asm):02116         ;    Outputs:
                      (    forth6809.asm):02117         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02118         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02119         ; ------------------------------------------------------------
CEF8 BDCEEF           (    forth6809.asm):02120         RTSCHECKHI: JSR   INFILL
CEFB 8130             (    forth6809.asm):02121                     CMPA  #INHIWATER
CEFD 250F             (    forth6809.asm):02122                     BLO   RTSCHIDONE
CEFF 7D0178           (    forth6809.asm):02123                     TST   RTSSTATE
CF02 260A             (    forth6809.asm):02124                     BNE   RTSCHIDONE        ; already high - nothing to do
CF04 86D5             (    forth6809.asm):02125                     LDA   #CR_RTSHI
CF06 B7C008           (    forth6809.asm):02126                     STA   ACIACR
CF09 8601             (    forth6809.asm):02127                     LDA   #1
CF0B B70178           (    forth6809.asm):02128                     STA   RTSSTATE
CF0E 39               (    forth6809.asm):02129         RTSCHIDONE: RTS
                      (    forth6809.asm):02130         ; ------------------------------------------------------------
                      (    forth6809.asm):02131         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02132         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02133         ; enables it only while output is pending.
                      (    forth6809.asm):02134         ; UPDATE_RTS
                      (    forth6809.asm):02135         ;    Inputs:
                      (    forth6809.asm):02136         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02137         ;    Outputs:
                      (    forth6809.asm):02138         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02139         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02140         ; ------------------------------------------------------------
CF0F                  (    forth6809.asm):02141         UPDATE_RTS:
CF0F 7D0178           (    forth6809.asm):02142                     TST   RTSSTATE
CF12 260D             (    forth6809.asm):02143                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02144         
CF14 7D017B           (    forth6809.asm):02145                     TST   OUTACTIVITY       ; Is active?
CF17 2704             (    forth6809.asm):02146                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02147         
                      (    forth6809.asm):02148                                             ; $B5/%1011_0101
CF19 86B5             (    forth6809.asm):02149                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
CF1B 2009             (    forth6809.asm):02150                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02151         
CF1D                  (    forth6809.asm):02152         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
CF1D 8695             (    forth6809.asm):02153                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
CF1F 2005             (    forth6809.asm):02154                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02155         
CF21                  (    forth6809.asm):02156         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
CF21 86D5             (    forth6809.asm):02157                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
CF23 7F017B           (    forth6809.asm):02158                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CF26                  (    forth6809.asm):02159         WRITE_CR:
CF26 B7C008           (    forth6809.asm):02160                     STA   ACIACR
CF29 39               (    forth6809.asm):02161                     RTS
                      (    forth6809.asm):02162         ; ------------------------------------------------------------
                      (    forth6809.asm):02163         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02164         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02165         ; Called after a character is added to the ring.
                      (    forth6809.asm):02166         ; CHKHI
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        RegB = input ring fill level
                      (    forth6809.asm):02169         ;    Outputs:
                      (    forth6809.asm):02170         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02171         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02172         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02173         ; ------------------------------------------------------------
CF2A                  (    forth6809.asm):02174         CHKHI:
CF2A C130             (    forth6809.asm):02175                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
CF2C 250D             (    forth6809.asm):02176                     BLO   CHKHIDONE         ; No! Do nothing.
CF2E 7D0178           (    forth6809.asm):02177                     TST   RTSSTATE
CF31 2608             (    forth6809.asm):02178                     BNE   CHKHIDONE         ; already high - nothing to do
CF33 86FF             (    forth6809.asm):02179                     LDA   #INREJECT         ; Yes! De-assert RTS.
CF35 B70178           (    forth6809.asm):02180                     STA   RTSSTATE
CF38 BDCF0F           (    forth6809.asm):02181                     JSR   UPDATE_RTS
CF3B 39               (    forth6809.asm):02182         CHKHIDONE:  RTS
                      (    forth6809.asm):02183         
                      (    forth6809.asm):02184         ; ------------------------------------------------------------
                      (    forth6809.asm):02185         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02186         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02187         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02188         ; CHKLO
                      (    forth6809.asm):02189         ;    Inputs:
                      (    forth6809.asm):02190         ;        RegB = input ring fill level
                      (    forth6809.asm):02191         ;    Outputs:
                      (    forth6809.asm):02192         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02193         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
CF3C                  (    forth6809.asm):02195         CHKLO:
CF3C C110             (    forth6809.asm):02196                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
CF3E 240D             (    forth6809.asm):02197                     BHS   CHKLODONE         ; No! Do nothing.
CF40 7D0178           (    forth6809.asm):02198                     TST   RTSSTATE
CF43 2708             (    forth6809.asm):02199                     BEQ   CHKLODONE         ; already low - nothing to do
CF45 8600             (    forth6809.asm):02200                     LDA   #INACCEPT         ; Yes! Assert RTS.
CF47 B70178           (    forth6809.asm):02201                     STA   RTSSTATE
CF4A BDCF0F           (    forth6809.asm):02202                     JSR   UPDATE_RTS
CF4D 39               (    forth6809.asm):02203         CHKLODONE:  RTS
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02206         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02207         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02208         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02209         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        none
                      (    forth6809.asm):02212         ;    Outputs:
                      (    forth6809.asm):02213         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02214         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02215         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02216         ; ------------------------------------------------------------
CF4E                  (    forth6809.asm):02217         FLUSHOUTBUFFER:
CF4E F6017A           (    forth6809.asm):02218                     LDB   OUTTAIL
CF51 F10179           (    forth6809.asm):02219                     CMPB  OUTHEAD           ; Is transmit buffer empty?
CF54 2719             (    forth6809.asm):02220                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02221         
CF56 B6C008           (    forth6809.asm):02222                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
CF59 8508             (    forth6809.asm):02223                     BITA  #SR_CTS
CF5B 2612             (    forth6809.asm):02224                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02225         
CF5D 8502             (    forth6809.asm):02226                     BITA  #SR_TDRE          ; Is transmit register empty?
CF5F 270E             (    forth6809.asm):02227                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02228                                             ; than spin-wait here.
                      (    forth6809.asm):02229         
CF61 8E01C0           (    forth6809.asm):02230                     LDX   #OUTBUF           ; The out buffer is occupied.
CF64 A685             (    forth6809.asm):02231                     LDA   B,X               ; Get the character from the out buffer.
CF66 B7C009           (    forth6809.asm):02232                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02233         
CF69 5C               (    forth6809.asm):02234                     INCB                    ; Update tail pointer to next character slot.
CF6A C43F             (    forth6809.asm):02235                     ANDB  #OUTBUFSZ-1
CF6C F7017A           (    forth6809.asm):02236                     STB   OUTTAIL
                      (    forth6809.asm):02237                                             ; One character sent - return rather than
                      (    forth6809.asm):02238                                             ; loop back for more (see header comment).
CF6F                  (    forth6809.asm):02239         FLUSHED:
CF6F 39               (    forth6809.asm):02240                     RTS
                      (    forth6809.asm):02241         ; ------------------------------------------------------------
                      (    forth6809.asm):02242         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02243         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02244         ; PUTCHAR
                      (    forth6809.asm):02245         ;    Inputs:
                      (    forth6809.asm):02246         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02247         ;    Outputs:
                      (    forth6809.asm):02248         ;        none
                      (    forth6809.asm):02249         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
CF70                  (    forth6809.asm):02251         PUTCHAR:
CF70 3411             (    forth6809.asm):02252                     PSHS  CC,X
CF72 1A50             (    forth6809.asm):02253                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02254         
CF74 F60179           (    forth6809.asm):02255                     LDB   OUTHEAD           ; Is buffer full?
CF77 5C               (    forth6809.asm):02256                     INCB
CF78 C43F             (    forth6809.asm):02257                     ANDB  #OUTBUFSZ-1
CF7A F1017A           (    forth6809.asm):02258                     CMPB  OUTTAIL
CF7D 273A             (    forth6809.asm):02259                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02260         
CF7F 8E01C0           (    forth6809.asm):02261                     LDX   #OUTBUF           ; Put character into character slot.
CF82 F60179           (    forth6809.asm):02262                     LDB   OUTHEAD
CF85 A785             (    forth6809.asm):02263                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02264         
CF87 5C               (    forth6809.asm):02265                     INCB                    ; Update tail pointer to next character slot.
CF88 C43F             (    forth6809.asm):02266                     ANDB  #OUTBUFSZ-1
CF8A F70179           (    forth6809.asm):02267                     STB   OUTHEAD
                      (    forth6809.asm):02268         
CF8D 7D0178           (    forth6809.asm):02269                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
CF90 2709             (    forth6809.asm):02270                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02271         
                      (    forth6809.asm):02272                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02273                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
CF92 1CAF             (    forth6809.asm):02274                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
CF94 BDCF4E           (    forth6809.asm):02275                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
CF97 1A50             (    forth6809.asm):02276                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02277                                             ; expects the critical section active
                      (    forth6809.asm):02278         
CF99 201E             (    forth6809.asm):02279                     BRA   PUT_EXIT
                      (    forth6809.asm):02280         
                      (    forth6809.asm):02281         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02282         ; priming the pump by transmitting a character.
CF9B                  (    forth6809.asm):02283         CHK_INT_PATH:
CF9B 7D017B           (    forth6809.asm):02284                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
CF9E 2619             (    forth6809.asm):02285                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287                                             ; No! Restart.
CFA0 8E01C0           (    forth6809.asm):02288                     LDX   #OUTBUF           ; Pull character from the out buffer.
CFA3 F6017A           (    forth6809.asm):02289                     LDB   OUTTAIL
CFA6 A685             (    forth6809.asm):02290                     LDA   B,X
CFA8 B7C009           (    forth6809.asm):02291                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02292         
CFAB 5C               (    forth6809.asm):02293                     INCB                    ; Update the tail pointer
CFAC C43F             (    forth6809.asm):02294                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
CFAE F7017A           (    forth6809.asm):02295                     STB   OUTTAIL
                      (    forth6809.asm):02296         
CFB1 86FF             (    forth6809.asm):02297                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
CFB3 B7017B           (    forth6809.asm):02298                     STA   OUTACTIVITY
CFB6 BDCF0F           (    forth6809.asm):02299                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02300         
CFB9                  (    forth6809.asm):02301         PUT_EXIT:
CFB9 3591             (    forth6809.asm):02302                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02303                                             ; by restoring the CC.
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
                      (    forth6809.asm):02305         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02306         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02307         ; GETCHAR
                      (    forth6809.asm):02308         ;    Inputs:
                      (    forth6809.asm):02309         ;        none
                      (    forth6809.asm):02310         ;    Outputs:
                      (    forth6809.asm):02311         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02312         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02313         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02314         ; ------------------------------------------------------------
CFBB                  (    forth6809.asm):02315         GETCHAR:
CFBB F60177           (    forth6809.asm):02316                     LDB   INTAIL            ; Is the out buffer populated?
CFBE F10176           (    forth6809.asm):02317                     CMPB  INHEAD
CFC1 271D             (    forth6809.asm):02318                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02319         
CFC3 8E0180           (    forth6809.asm):02320                     LDX   #INBUF            ; Pull character from the out buffer.
CFC6 A685             (    forth6809.asm):02321                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02322         
CFC8 5C               (    forth6809.asm):02323                     INCB                    ; Update the tail pointer
CFC9 C43F             (    forth6809.asm):02324                     ANDB  #INBUFSZ-1        ; to point to the next character.
CFCB F70177           (    forth6809.asm):02325                     STB   INTAIL
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02328                     ; receive interrupt. See bugfix: GETCHAR.1
CFCE 1A10             (    forth6809.asm):02329                     ORCC  #$10
CFD0 F60176           (    forth6809.asm):02330                     LDB   INHEAD            ; Calculate current fill level fresh -
CFD3 F00177           (    forth6809.asm):02331                     SUBB  INTAIL            ; both pointers may have moved since
CFD6 C43F             (    forth6809.asm):02332                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02333                                             ; there's no already-loaded value here
                      (    forth6809.asm):02334                                             ; worth reusing.
CFD8 BDCF3C           (    forth6809.asm):02335                     JSR   CHKLO
CFDB 1CEF             (    forth6809.asm):02336                     ANDCC #$EF
                      (    forth6809.asm):02337         
CFDD 1CFE             (    forth6809.asm):02338                     ANDCC #$FE              ; Carry flag %0 = valid character
CFDF 39               (    forth6809.asm):02339                     RTS
                      (    forth6809.asm):02340         
CFE0                  (    forth6809.asm):02341         GET_NO_CHAR:
CFE0 1A01             (    forth6809.asm):02342                     ORCC  #$01              ; Carry flag %1 = no valid character.
CFE2 39               (    forth6809.asm):02343                     RTS
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02346         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02347         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02348         ; RTSCHECKLO
                      (    forth6809.asm):02349         ;    Inputs:
                      (    forth6809.asm):02350         ;        none
                      (    forth6809.asm):02351         ;    Outputs:
                      (    forth6809.asm):02352         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02353         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02354         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02355         ; ------------------------------------------------------------
CFE3                  (    forth6809.asm):02356         RTSCHECKLO:
CFE3 1A10             (    forth6809.asm):02357                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02358         
CFE5 BDCEEF           (    forth6809.asm):02359                     JSR   INFILL
CFE8 8110             (    forth6809.asm):02360                     CMPA  #INLOWATER
CFEA 221E             (    forth6809.asm):02361                     BHI   RTSCLODONE
CFEC 7D0178           (    forth6809.asm):02362                     TST   RTSSTATE
CFEF 2719             (    forth6809.asm):02363                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         
CFF1 7F0178           (    forth6809.asm):02366                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02367         
CFF4 F6017A           (    forth6809.asm):02368                     LDB   OUTTAIL           ; Check if chars are available.
CFF7 F10179           (    forth6809.asm):02369                     CMPB  OUTHEAD
CFFA 2707             (    forth6809.asm):02370                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02371         
CFFC 86B5             (    forth6809.asm):02372                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
CFFE B7C008           (    forth6809.asm):02373                     STA   ACIACR            ; & to generate transmit slot available interrupts.
D001 2005             (    forth6809.asm):02374                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02375         
D003 8695             (    forth6809.asm):02376         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
D005 B7C008           (    forth6809.asm):02377                     STA   ACIACR
                      (    forth6809.asm):02378         
D008                  (    forth6809.asm):02379         RTSCLOUNMASK:
D008 1CEF             (    forth6809.asm):02380                     ANDCC #$EF
                      (    forth6809.asm):02381         
D00A 39               (    forth6809.asm):02382         RTSCLODONE: RTS
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02386         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02387         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02388         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02389         ; IRQH
                      (    forth6809.asm):02390         ;    Inputs:
                      (    forth6809.asm):02391         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02392         ;    Outputs:
                      (    forth6809.asm):02393         ;        none (returns with RTI)
                      (    forth6809.asm):02394         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02395         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
D00B B6C008           (    forth6809.asm):02397         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02398         
D00E 8580             (    forth6809.asm):02399                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
D010 2708             (    forth6809.asm):02400                     BEQ   IRQDONE0          ; No! Just exit.
D012 8501             (    forth6809.asm):02401                     BITA  #SR_RDRF          ; Is an incoming character available?
D014 2605             (    forth6809.asm):02402                     BNE   INCHAR
D016 8502             (    forth6809.asm):02403                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
D018 263C             (    forth6809.asm):02404                     BNE   OUTCHAR
                      (    forth6809.asm):02405                                             ; Ignore all other interrupts such as DCD change.
D01A 3B               (    forth6809.asm):02406         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02407                                             ; & restores state.
                      (    forth6809.asm):02408         
D01B                  (    forth6809.asm):02409         INCHAR:
D01B F6C009           (    forth6809.asm):02410                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
D01E 8570             (    forth6809.asm):02411                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02412                                             ; Any receiver error flagged?
D020 2716             (    forth6809.asm):02413                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02414         
D022 8510             (    forth6809.asm):02415                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
D024 2703             (    forth6809.asm):02416                     BEQ   INXFE             ; Tally each flagged error independently -
D026 7C017C           (    forth6809.asm):02417                     INC   FECOUNT           ; more than one bit can be set at once.
D029 8520             (    forth6809.asm):02418         INXFE:      BITA  #SR_OVRN
D02B 2703             (    forth6809.asm):02419                     BEQ   INXOVRN
D02D 7C017D           (    forth6809.asm):02420                     INC   OVRNCOUNT
D030 8540             (    forth6809.asm):02421         INXOVRN:    BITA  #SR_PE
D032 2703             (    forth6809.asm):02422                     BEQ   INXPE
D034 7C017E           (    forth6809.asm):02423                     INC   PECOUNT
D037 3B               (    forth6809.asm):02424         INXPE:      RTI
                      (    forth6809.asm):02425         
D038 1F98             (    forth6809.asm):02426         INOK:       TFR   B,A               ; Transfer good character from the receiver.
D03A 8E0180           (    forth6809.asm):02427                     LDX   #INBUF            ; Store it in the empty in buffer slot.
D03D F60176           (    forth6809.asm):02428                     LDB   INHEAD
D040 A785             (    forth6809.asm):02429                     STA   B,X
D042 5C               (    forth6809.asm):02430                     INCB                    ; Figure out the new head,
D043 C43F             (    forth6809.asm):02431                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
D045 F10177           (    forth6809.asm):02432                     CMPB  INTAIL            ; Would the new head slot meet the tail?
D048 270B             (    forth6809.asm):02433                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
D04A F70176           (    forth6809.asm):02434                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02435                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02436                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02437                     ; See shadow: INCHAR.1
D04D F00177           (    forth6809.asm):02438                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
D050 C43F             (    forth6809.asm):02439                     ANDB  #INBUFSZ-1
D052 BDCF2A           (    forth6809.asm):02440                     JSR   CHKHI             ; Protect the in buffer from overflow.
D055 3B               (    forth6809.asm):02441         IRQDONE1:   RTI
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02444         
D056 F6017A           (    forth6809.asm):02445         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
D059 F10179           (    forth6809.asm):02446                     CMPB  OUTHEAD
D05C 270F             (    forth6809.asm):02447                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02448         
D05E 8E01C0           (    forth6809.asm):02449                     LDX   #OUTBUF           ; No! The out buffer is occupied.
D061 A685             (    forth6809.asm):02450                     LDA   B,X               ; Get the character from the out buffer.
D063 B7C009           (    forth6809.asm):02451                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02452         
D066 5C               (    forth6809.asm):02453                     INCB                    ; Update the tail pointer pointing to the next char.
D067 C43F             (    forth6809.asm):02454                     ANDB  #OUTBUFSZ-1
D069 F7017A           (    forth6809.asm):02455                     STB   OUTTAIL
D06C 3B               (    forth6809.asm):02456         IRQDONE2    RTI
                      (    forth6809.asm):02457         
D06D                  (    forth6809.asm):02458         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02459                     ; Commented-out code moved to shadow: TXOFF.1
D06D 7F017B           (    forth6809.asm):02460                     CLR   OUTACTIVITY
D070 BDCF0F           (    forth6809.asm):02461                     JSR   UPDATE_RTS
D073 3B               (    forth6809.asm):02462         IRQDONE3    RTI
                      (    forth6809.asm):02463         

                      (    forth6809.asm):04120         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04121         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04122         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04123         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04124         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04125         ;    Inputs:
                      (    forth6809.asm):04126         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04127         ;    Outputs:
                      (    forth6809.asm):04128         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04129         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04130         ;        scratch.
                      (    forth6809.asm):04131         ; ------------------------------------------------------------
E790 3706             (    forth6809.asm):04132         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E792 DD14             (    forth6809.asm):04133                     STD   MSCR              ; MSCR = step
E794 EC66             (    forth6809.asm):04134                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E796 262D             (    forth6809.asm):04135                     BNE   DPTEXIT           ; set: exit
E798 EC62             (    forth6809.asm):04136                     LDD   2,S               ; old index
E79A A364             (    forth6809.asm):04137                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E79C DD16             (    forth6809.asm):04138                     STD   MSCR2
E79E EC62             (    forth6809.asm):04139                     LDD   2,S
E7A0 D314             (    forth6809.asm):04140                     ADDD  MSCR              ; new_index = old_index + step
E7A2 ED62             (    forth6809.asm):04141                     STD   2,S
E7A4 A364             (    forth6809.asm):04142                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E7A6 DD18             (    forth6809.asm):04143                     STD   MSCR3
                      (    forth6809.asm):04144                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04145                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04146                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

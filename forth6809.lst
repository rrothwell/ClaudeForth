                      (    forth6809.asm):03874         ; ------------------------------------------------------------
E72F 3706             (    forth6809.asm):03875         AGAINW:     PULU  D
E731 10830002         (    forth6809.asm):03876                     CMPD  #TAGBACK
E735 2703             (    forth6809.asm):03877                     BEQ   AGOK
E737 BDE609           (    forth6809.asm):03878                     JSR   CFERR
E73A 3706             (    forth6809.asm):03879         AGOK:       PULU  D                 ; dest
E73C 3606             (    forth6809.asm):03880                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E73E CCDF7F           (    forth6809.asm):03881                     LDD   #BRANCH
E741 3606             (    forth6809.asm):03882                     PSHU  D
E743 BDEAB9           (    forth6809.asm):03883                     JSR   CCALL
E746 CC0000           (    forth6809.asm):03884                     LDD   #0
E749 3606             (    forth6809.asm):03885                     PSHU  D

                      (    forth6809.asm):01758                     LDA  #1
                      (    forth6809.asm):01759                     STA  RTSSTATE
E035                  (    forth6809.asm):01760         RTSCHIDONE: RTS
                      (    forth6809.asm):01761         
                      (    forth6809.asm):01762         ; ------------------------------------------------------------
                      (    forth6809.asm):01763         ; RTSCHECKLO - called from mainline code (KEY), NOT from the

FB66 3606             (    forth6809.asm):07756                     PSHU  D
FB68 EC02             (    forth6809.asm):07757                     LDD   2,X
FB6A 3606             (    forth6809.asm):07758                     PSHU  D
FB6C DCF1             (    forth6809.asm):07759                     LDD   ENVADDR
FB6E 3606             (    forth6809.asm):07760                     PSHU  D
FB70 DCEF             (    forth6809.asm):07761                     LDD   ENVLEN
FB72 3606             (    forth6809.asm):07762                     PSHU  D
FB74 BDF5D4           (    forth6809.asm):07763                     JSR   COMPAREW
FB77 3510             (    forth6809.asm):07764                     PULS  X                 ; restore X before using it again
FB79 3706             (    forth6809.asm):07765                     PULU  D
FB7B 10830000         (    forth6809.asm):07766                     CMPD  #0
FB7F 2704             (    forth6809.asm):07767                     BEQ   ENVFOUND
FB81 3006             (    forth6809.asm):07768                     LEAX  6,X

                      (    forth6809.asm):02337         
                      (    forth6809.asm):02338                     LDX   #INBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02339                                 LDA   B,X 
                      (    forth6809.asm):02340         
                      (    forth6809.asm):02341                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02342                     ANDB  #INBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02343                     STB   INTAIL
                      (    forth6809.asm):02344         
                      (    forth6809.asm):02345                     ; BUG FIX: CHKLO reads-then-writes RTSSTATE/OUTACTIVITY and

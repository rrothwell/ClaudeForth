                      (    forth6809.asm):02250                    LDD   #2
                      (    forth6809.asm):02251                    PSHU  D
                      (    forth6809.asm):02252                    STU   TSTUB4
                      (    forth6809.asm):02253         
                      (    forth6809.asm):02254                    JSR   ROLL
                      (    forth6809.asm):02255         
                      (    forth6809.asm):02256                    STU   TSTUAF
                      (    forth6809.asm):02257         
                      (    forth6809.asm):02258                    PULU  D
                      (    forth6809.asm):02259                    CMPD  #TSTVAL1
                      (    forth6809.asm):02260                    BNE   RLFAIL
                      (    forth6809.asm):02261                    PULU  D
                      (    forth6809.asm):02262                    CMPD  #TSTVAL3
                      (    forth6809.asm):02263                    BNE   RLFAIL
                      (    forth6809.asm):02264                    PULU  D
                      (    forth6809.asm):02265                    CMPD  #TSTVAL2
                      (    forth6809.asm):02266                    BNE   RLFAIL
                      (    forth6809.asm):02267                    PULU  D
                      (    forth6809.asm):02268                    CMPD  #TSTGUARD
                      (    forth6809.asm):02269                    BNE   RLFAIL
                      (    forth6809.asm):02270         
                      (    forth6809.asm):02271                    LDD   TSTUB4
                      (    forth6809.asm):02272                    SUBD  TSTUAF
                      (    forth6809.asm):02273                    CMPD  #-2
                      (    forth6809.asm):02274                    BNE   RLFAIL
                      (    forth6809.asm):02275         
                      (    forth6809.asm):02276                    LDD   #TRUEV
                      (    forth6809.asm):02277                    BRA   RLDONE
C192                  (    forth6809.asm):02278         RLFAIL:    LDD   #FALSEV
C192                  (    forth6809.asm):02279         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):02280                    PSHU  X
                      (    forth6809.asm):02281                    PSHU  D

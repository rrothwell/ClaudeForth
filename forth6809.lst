                      (    forth6809.asm):05445         ;    Outputs:
                      (    forth6809.asm):05446         ;        PRODLO = quotient, DIVREM = remainder (data stack popped)
                      (    forth6809.asm):05447         ;    Registers: RegA, RegB and RegD changed; many scratch cells used.
                      (    forth6809.asm):05448         ; ------------------------------------------------------------

DF41 DD00             (    forth6809.asm):17694                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):17695                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):17696                                   ; that spans more than one line of input.
                      (    forth6809.asm):17697                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):17698                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):17699                                   ; correct, sole places STATE should change
                      (    forth6809.asm):17700                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):17701                                   ; reset was a third, redundant one that
                      (    forth6809.asm):17702                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):17703                                   ; every time QUERY read a new line,
                      (    forth6809.asm):17704                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):17705                                   ; been reached. A colon definition split
                      (    forth6809.asm):17706                                   ; across multiple lines would have every
                      (    forth6809.asm):17707                                   ; word on every line after the first
                      (    forth6809.asm):17708                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):17709                                   ; stack effect, executed) instead of
                      (    forth6809.asm):17710                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):17711                                   ; data stack instead of being compiled,
                      (    forth6809.asm):17712                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):17713                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):17714                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):17715                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):17716                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):17717                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):17718                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):17719                                   ; so this still correctly forces interpret
                      (    forth6809.asm):17720                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):17721                                   ; semantics call for it - just not on every
                      (    forth6809.asm):17722                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):17723                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):17724         

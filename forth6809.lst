                      (    forth6809.asm):12513                       STA  TSTNAMEB
                      (    forth6809.asm):12514                       LDA  #32
                      (    forth6809.asm):12515                       STA  TSTNAMEB+1
                      (    forth6809.asm):12516                       LDA  #'A'
                      (    forth6809.asm):12517                       STA  TSTNAMEB+2
                      (    forth6809.asm):12518                       LDA  #'B'
                      (    forth6809.asm):12519                       STA  TSTNAMEB+3
                      (    forth6809.asm):12520                       LDA  #32
                      (    forth6809.asm):12521                       STA  TSTNAMEB+4
                      (    forth6809.asm):12522                       LDA  #'C'
                      (    forth6809.asm):12523                       STA  TSTNAMEB+5
                      (    forth6809.asm):12524                       LDA  #'D'
                      (    forth6809.asm):12525                       STA  TSTNAMEB+6
                      (    forth6809.asm):12526         
                      (    forth6809.asm):12527                       LDD  #TSTNAMEB
                      (    forth6809.asm):12528                       STD  SRCADDR
                      (    forth6809.asm):12529                       LDD  #7
                      (    forth6809.asm):12530                       STD  SRCLEN
                      (    forth6809.asm):12531                       LDD  #0
                      (    forth6809.asm):12532                       STD  TOIN
                      (    forth6809.asm):12533         
                      (    forth6809.asm):12534                       STU  TSTU0
                      (    forth6809.asm):12535         
                      (    forth6809.asm):12536                       LDD  #TSTGUARD
                      (    forth6809.asm):12537                       PSHU D
                      (    forth6809.asm):12538                       STU  TSTUB4
                      (    forth6809.asm):12539         
                      (    forth6809.asm):12540                       JSR  PARSENAME
                      (    forth6809.asm):12541         
                      (    forth6809.asm):12542                       STU  TSTUAF
                      (    forth6809.asm):12543         
                      (    forth6809.asm):12544                       LDD  TSTSASAV
                      (    forth6809.asm):12545                       STD  SRCADDR
                      (    forth6809.asm):12546                       LDD  TSTSLSAV
                      (    forth6809.asm):12547                       STD  SRCLEN
                      (    forth6809.asm):12548                       LDD  TSTTISAV
                      (    forth6809.asm):12549                       STD  TOIN
                      (    forth6809.asm):12550         
                      (    forth6809.asm):12551                       PULU D
                      (    forth6809.asm):12552                       CMPD #2
                      (    forth6809.asm):12553                       BNE  PZFAIL
                      (    forth6809.asm):12554                       PULU D
                      (    forth6809.asm):12555                       CMPD #TSTNAMEB+2
                      (    forth6809.asm):12556                       BNE  PZFAIL
                      (    forth6809.asm):12557                       PULU D
                      (    forth6809.asm):12558                       CMPD #TSTGUARD
                      (    forth6809.asm):12559                       BNE  PZFAIL
                      (    forth6809.asm):12560         
                      (    forth6809.asm):12561                       LDD  TSTUB4
                      (    forth6809.asm):12562                       SUBD TSTUAF
                      (    forth6809.asm):12563                       CMPD #4
                      (    forth6809.asm):12564                       BNE  PZFAIL
                      (    forth6809.asm):12565         

                      (    forth6809.asm):08979                    STA  TSTNAMEB+4
                      (    forth6809.asm):08980                    LDA  #'D'
                      (    forth6809.asm):08981                    STA  TSTNAMEB+5
                      (    forth6809.asm):08982         
                      (    forth6809.asm):08983                    LDD  #TSTCBUF

                      (    forth6809.asm):19770                                      ; actually earmarked for WORD's own
                      (    forth6809.asm):19771                                      ; parsing - reporting it here would
                      (    forth6809.asm):19772                                      ; overstate what HOLD can safely use
                      (    forth6809.asm):19773                                      ; without risking collision with whatever

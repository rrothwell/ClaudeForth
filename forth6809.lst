E43A 3001             (    forth6809.asm):03711                  LEAX  1,X
                      (    forth6809.asm):03712         
                      (    forth6809.asm):03713                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03714                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03715                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03716                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03717                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03718                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03719                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03720                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03721                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03722                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03723                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03724                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03725                  ; for it.
E43C D621             (    forth6809.asm):03726                  LDB   CNTREM
E43E 5A               (    forth6809.asm):03727                  DECB
E43F A685             (    forth6809.asm):03728                  LDA   B,X
E441 812E             (    forth6809.asm):03729                  CMPA  #'.'
E443 2604             (    forth6809.asm):03730                  BNE   NQNOSIGN
E445 0A21             (    forth6809.asm):03731                  DEC   CNTREM
E447 2766             (    forth6809.asm):03732                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03733         
E449 0F22             (    forth6809.asm):03734         NQNOSIGN: CLR   NUMNEG
E44B A684             (    forth6809.asm):03735                  LDA   ,X
E44D 812D             (    forth6809.asm):03736                  CMPA  #'-'
E44F 2608             (    forth6809.asm):03737                  BNE   NQNOSIGN2
E451 0322             (    forth6809.asm):03738                  COM   NUMNEG
E453 3001             (    forth6809.asm):03739                  LEAX  1,X
E455 0A21             (    forth6809.asm):03740                  DEC   CNTREM
E457 2756             (    forth6809.asm):03741                  BEQ   NQBAD
                      (    forth6809.asm):03742         
E459 9F23             (    forth6809.asm):03743         NQNOSIGN2: STX  NADDR
E45B 4F               (    forth6809.asm):03744                   CLRA
E45C D621             (    forth6809.asm):03745                   LDB   CNTREM
E45E DD25             (    forth6809.asm):03746                   STD   NCNT
E460 CC0000           (    forth6809.asm):03747                   LDD   #0
E463 DD74             (    forth6809.asm):03748                   STD   UDHI
E465 DD76             (    forth6809.asm):03749                   STD   UDLO
                      (    forth6809.asm):03750         
E467 BDE3D3           (    forth6809.asm):03751                   JSR   NUMLOOP
                      (    forth6809.asm):03752         
E46A DC25             (    forth6809.asm):03753                   LDD   NCNT
E46C 2641             (    forth6809.asm):03754                   BNE   NQBAD
                      (    forth6809.asm):03755         
                      (    forth6809.asm):03756                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03757                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03758                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03759                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03760                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03761                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03762                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03763                   ; high cell.
E46E 0D22             (    forth6809.asm):03764                   TST   NUMNEG
E470 2718             (    forth6809.asm):03765                   BEQ   NQPOS32
E472 DC76             (    forth6809.asm):03766                   LDD   UDLO
E474 43               (    forth6809.asm):03767                   COMA
E475 53               (    forth6809.asm):03768                   COMB
E476 C30001           (    forth6809.asm):03769                   ADDD  #1
E479 DD76             (    forth6809.asm):03770                   STD   UDLO
E47B 3401             (    forth6809.asm):03771                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03772                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03773                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03774                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03775                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03776                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03777                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03778                                      ; making the high-cell increment run
                      (    forth6809.asm):03779                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03780                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03781                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03782                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03783                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03784                                      ; matching "always increment" rather than
                      (    forth6809.asm):03785                                      ; "increment only on genuine carry".
E47D DC74             (    forth6809.asm):03786                   LDD   UDHI
E47F 43               (    forth6809.asm):03787                   COMA
E480 53               (    forth6809.asm):03788                   COMB
E481 3501             (    forth6809.asm):03789                   PULS  CC          ; restore the TRUE carry
E483 2403             (    forth6809.asm):03790                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03791                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03792                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03793                                      ; value was computed in D but never
                      (    forth6809.asm):03794                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03795                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03796                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03797                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03798                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03799                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03800                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03801                                      ; alone would have made this second,
                      (    forth6809.asm):03802                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03803                                      ; only past the "+1", never past the
                      (    forth6809.asm):03804                                      ; store itself - the store always runs,
                      (    forth6809.asm):03805                                      ; either way.
E485 C30001           (    forth6809.asm):03806                   ADDD  #1
E488 DD74             (    forth6809.asm):03807         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03808         
E48A                  (    forth6809.asm):03809         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03810                   ; was '.' - determines which return convention to use
E48A 9E1F             (    forth6809.asm):03811                   LDX   CADDR
E48C E684             (    forth6809.asm):03812                   LDB   ,X
E48E 5A               (    forth6809.asm):03813                   DECB
E48F 3001             (    forth6809.asm):03814                   LEAX  1,X
E491 A685             (    forth6809.asm):03815                   LDA   B,X
E493 812E             (    forth6809.asm):03816                   CMPA  #'.'
E495 260E             (    forth6809.asm):03817                   BNE   NQSINGLE
                      (    forth6809.asm):03818         
                      (    forth6809.asm):03819                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03820                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03821                   ; apart without needing a separate flag of its own either
E497 DC76             (    forth6809.asm):03822                   LDD   UDLO
E499 3606             (    forth6809.asm):03823                   PSHU  D
E49B DC74             (    forth6809.asm):03824                   LDD   UDHI
E49D 3606             (    forth6809.asm):03825                   PSHU  D
E49F CC0001           (    forth6809.asm):03826                   LDD   #1
E4A2 3606             (    forth6809.asm):03827                   PSHU  D
E4A4 39               (    forth6809.asm):03828                   RTS
                      (    forth6809.asm):03829         
E4A5                  (    forth6809.asm):03830         NQSINGLE: ; SINGLE success - unchanged from the original convention
E4A5 DC76             (    forth6809.asm):03831                   LDD   UDLO
E4A7 3606             (    forth6809.asm):03832                   PSHU  D
E4A9 CCFFFF           (    forth6809.asm):03833                   LDD   #-1
E4AC 3606             (    forth6809.asm):03834                   PSHU  D
E4AE 39               (    forth6809.asm):03835                   RTS
                      (    forth6809.asm):03836         
E4AF 9E1F             (    forth6809.asm):03837         NQBAD:    LDX   CADDR
E4B1 3610             (    forth6809.asm):03838                   PSHU  X
E4B3 CC0000           (    forth6809.asm):03839                   LDD   #0
E4B6 3606             (    forth6809.asm):03840                   PSHU  D
E4B8 39               (    forth6809.asm):03841                   RTS
                      (    forth6809.asm):03842         
                      (    forth6809.asm):03843         ; ============================================================
                      (    forth6809.asm):03844         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03845         ; ============================================================
                      (    forth6809.asm):03846                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E4B9                  (    forth6809.asm):03847         X_KEY:     LDA   INHEAD
                      (    forth6809.asm):03848                  CMPA  INTAIL
                      (    forth6809.asm):03849                  BEQ   KEY
                      (    forth6809.asm):03850                  LDX   #INBUF
                      (    forth6809.asm):03851                  LDB   INTAIL
                      (    forth6809.asm):03852                  LDA   B,X
                      (    forth6809.asm):03853                  INCB
                      (    forth6809.asm):03854                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):03855                  STB   INTAIL
                      (    forth6809.asm):03856                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03857                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03858                                         ; this needs no dedicated scratch global
                      (    forth6809.asm):03859                  JSR   RTSCHECKLO
                      (    forth6809.asm):03860                  PULS  A
                      (    forth6809.asm):03861                  TFR   A,B
                      (    forth6809.asm):03862                  CLRA
                      (    forth6809.asm):03863                  PSHU  D
                      (    forth6809.asm):03864                  RTS
                      (    forth6809.asm):03865         
                      (    forth6809.asm):03866         ; ------------------------------------------------------------
                      (    forth6809.asm):03867         ; KEY ( -- char )
                      (    forth6809.asm):03868         ; ------------------------------------------------------------
E4B9                  (    forth6809.asm):03869         KEY:
                      (    forth6809.asm):03870         
                      (    forth6809.asm):03871                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03872                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03873         
                      (    forth6809.asm):03874                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03875                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03876                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03877                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03878                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03879                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03880                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03881                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03882                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03883                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03884                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03885                                             ; by transmitting all chars.
                      (    forth6809.asm):03886         
E4B9                  (    forth6809.asm):03887         TRY_READ:
                      (    forth6809.asm):03888                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03889                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03890                                             ; while still transmitting!
                      (    forth6809.asm):03891                 
                      (    forth6809.asm):03892                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03893                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03894                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03895         
                      (    forth6809.asm):03896                     RTS                     
                      (    forth6809.asm):03897         
                      (    forth6809.asm):03898         ; ------------------------------------------------------------
                      (    forth6809.asm):03899         ; KEY? ( -- flag )
                      (    forth6809.asm):03900         ; ------------------------------------------------------------
E4B9                  (    forth6809.asm):03901         KEYQ:  
                      (    forth6809.asm):03902                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03903         
                      (    forth6809.asm):03904                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03905                     CMPA  INTAIL
                      (    forth6809.asm):03906         
                      (    forth6809.asm):03907                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03908         
                      (    forth6809.asm):03909                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03910         
                      (    forth6809.asm):03911                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03912                     PSHU  D
                      (    forth6809.asm):03913         
                      (    forth6809.asm):03914                     RTS
                      (    forth6809.asm):03915         
E4B9                  (    forth6809.asm):03916         KQTRUE:     
                      (    forth6809.asm):03917                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03918                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03919                     RTS
                      (    forth6809.asm):03920         ; ------------------------------------------------------------
                      (    forth6809.asm):03921         ; EMIT  ( char -- )
                      (    forth6809.asm):03922         ; ------------------------------------------------------------
                      (    forth6809.asm):03923         
E4B9                  (    forth6809.asm):03924         X_EMIT:    PULU  D
                      (    forth6809.asm):03925                  STB   EMITCH
E4B9                  (    forth6809.asm):03926         EMITWT:  LDB   OUTHEAD
                      (    forth6809.asm):03927                  INCB
                      (    forth6809.asm):03928                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03929                  CMPB  OUTTAIL
                      (    forth6809.asm):03930                  BEQ   EMITWT
                      (    forth6809.asm):03931                  LDX   #OUTBUF
                      (    forth6809.asm):03932                  LDB   OUTHEAD
                      (    forth6809.asm):03933                  LDA   EMITCH
                      (    forth6809.asm):03934                  STA   B,X
                      (    forth6809.asm):03935                  INCB
                      (    forth6809.asm):03936                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03937                  STB   OUTHEAD
                      (    forth6809.asm):03938                  TST   RTSSTATE
                      (    forth6809.asm):03939                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03940                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03941                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03942                                         ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03943                  LDA   #CR_RXTX
                      (    forth6809.asm):03944                  STA   ACIACR
E4B9                  (    forth6809.asm):03945         EMITNORTS: RTS
                      (    forth6809.asm):03946         
E4B9                  (    forth6809.asm):03947         EMIT:
                      (    forth6809.asm):03948                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03949                     TFR   B,A               
                      (    forth6809.asm):03950                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03951                     RTS                     
                      (    forth6809.asm):03952         
                      (    forth6809.asm):03953                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):03954         ; ------------------------------------------------------------
                      (    forth6809.asm):03955         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03956         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03957         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03958         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03959         ; directly against ACIASR.
                      (    forth6809.asm):03960         ;
                      (    forth6809.asm):03961         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03962         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03963         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03964         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03965         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03966         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03967         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03968         ; ------------------------------------------------------------
E4B9                  (    forth6809.asm):03969         KEY:
E4B9 B6C008           (    forth6809.asm):03970                  LDA   ACIASR
E4BC 8501             (    forth6809.asm):03971                  BITA  #SR_RDRF
E4BE 2705             (    forth6809.asm):03972                  BEQ   KWAIT
E4C0 7C017F           (    forth6809.asm):03973                  INC   POLLREADYCNT   ; character was already queued when we
E4C3 2007             (    forth6809.asm):03974                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E4C5                  (    forth6809.asm):03975         KWAIT:
E4C5 B6C008           (    forth6809.asm):03976         KSPIN:   LDA   ACIASR
E4C8 8501             (    forth6809.asm):03977                  BITA  #SR_RDRF
E4CA 27F9             (    forth6809.asm):03978                  BEQ   KSPIN
E4CC                  (    forth6809.asm):03979         KGOTSTAT:                     ; A holds the status byte exactly as it was
                      (    forth6809.asm):03980                                        ; when RDRF first went true - check the
                      (    forth6809.asm):03981                                        ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03982                                        ; read, since reading ACIADR below clears
                      (    forth6809.asm):03983                                        ; RDRF and the latched error bits together
E4CC 8570             (    forth6809.asm):03984                  BITA  #SR_FE+SR_OVRN+SR_PE
E4CE 2715             (    forth6809.asm):03985                  BEQ   KGETCH
E4D0 8510             (    forth6809.asm):03986                  BITA  #SR_FE
E4D2 2703             (    forth6809.asm):03987                  BEQ   KXFE
E4D4 7C017C           (    forth6809.asm):03988                  INC   FECOUNT
E4D7 8520             (    forth6809.asm):03989         KXFE:    BITA  #SR_OVRN
E4D9 2703             (    forth6809.asm):03990                  BEQ   KXOVRN
E4DB 7C017D           (    forth6809.asm):03991                  INC   OVRNCOUNT
E4DE 8540             (    forth6809.asm):03992         KXOVRN:  BITA  #SR_PE

                      (    forth6809.asm):08057                     ORG   INITCODE          ; init code block
                      (    forth6809.asm):08058         
                      (    forth6809.asm):08059         ; ------------------------------------------------------------
                      (    forth6809.asm):08060         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08061         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08062         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08063         ; enter COLD.
                      (    forth6809.asm):08064         ; COLDSTRT
                      (    forth6809.asm):08065         ;    Inputs:
                      (    forth6809.asm):08066         ;        hardware reset
                      (    forth6809.asm):08067         ;    Outputs:
                      (    forth6809.asm):08068         ;        does not return
                      (    forth6809.asm):08069         ;    Registers: all registers initialised.
                      (    forth6809.asm):08070         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08071         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08072                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08073                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08074                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08075                     CLRA
FFAE 1F8B             (    forth6809.asm):08076                     TFR   A,DP
                      (    forth6809.asm):08077         
FFB0 8E0000           (    forth6809.asm):08078                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08079                     LDB   #0
FFB5 6F80             (    forth6809.asm):08080         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):08081                     DECB
FFB8 26FB             (    forth6809.asm):08082                     BNE   CLRGLOB
                      (    forth6809.asm):08083         
FFBA BDDCE3           (    forth6809.asm):08084                     JSR   INITSERIAL
                      (    forth6809.asm):08085         
FFBD 1CAF             (    forth6809.asm):08086                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08087         
                      (    forth6809.asm):08088                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08089         
                      (    forth6809.asm):08090                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08091                     JSR   TSTRUNNER
                      (    forth6809.asm):08092                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08093                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08094                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):08095                     NOP
                      (    forth6809.asm):08096                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08097         
FFC2 7EDE84           (    forth6809.asm):08098                     JMP   COLD
                      (    forth6809.asm):08099         
                      (    forth6809.asm):08100         ; ------------------------------------------------------------
                      (    forth6809.asm):08101         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08102         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08103         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08104         ; WARM
                      (    forth6809.asm):08105         ;    Inputs:
                      (    forth6809.asm):08106         ;        NMI
                      (    forth6809.asm):08107         ;    Outputs:
                      (    forth6809.asm):08108         ;        does not return
                      (    forth6809.asm):08109         ;    Registers: all registers initialised.
                      (    forth6809.asm):08110         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):08111         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08112                     CLRA
FFC8 1F8B             (    forth6809.asm):08113                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08114                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08115                     LDS   #RP0
                      (    forth6809.asm):08116         
FFD1 BDDCE3           (    forth6809.asm):08117                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):08118         
FFD4 8EFFE6           (    forth6809.asm):08119                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08120                     PSHU  X
FFD9 CC0006           (    forth6809.asm):08121                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08122                     PSHU  D
FFDE BDF55B           (    forth6809.asm):08123                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):08124                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE3 7EDEC3           (    forth6809.asm):08125                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):08126         
FFE6 20207761726D     (    forth6809.asm):08127         WARMMSG:    FCC   "  warm"

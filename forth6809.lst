                      (    forth6809.asm):03862         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03863         ; ============================================================
                      (    forth6809.asm):03864                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
E4CD                  (    forth6809.asm):03865         X_KEY:      LDA   INHEAD
                      (    forth6809.asm):03866                     CMPA  INTAIL
                      (    forth6809.asm):03867                     BEQ   KEY
                      (    forth6809.asm):03868                     LDX   #INBUF
                      (    forth6809.asm):03869                     LDB   INTAIL
                      (    forth6809.asm):03870                     LDA   B,X
                      (    forth6809.asm):03871                     INCB
                      (    forth6809.asm):03872                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):03873                     STB   INTAIL
                      (    forth6809.asm):03874                     PSHS  A                 ; stash the char on the return stack across
                      (    forth6809.asm):03875                                             ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03876                                             ; this needs no dedicated scratch global
                      (    forth6809.asm):03877                     JSR   RTSCHECKLO
                      (    forth6809.asm):03878                     PULS  A
                      (    forth6809.asm):03879                     TFR   A,B
                      (    forth6809.asm):03880                     CLRA
                      (    forth6809.asm):03881                     PSHU  D
                      (    forth6809.asm):03882                     RTS
                      (    forth6809.asm):03883         
                      (    forth6809.asm):03884         ; ------------------------------------------------------------
                      (    forth6809.asm):03885         ; KEY ( -- char )
                      (    forth6809.asm):03886         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03887         KEY:
                      (    forth6809.asm):03888         
                      (    forth6809.asm):03889                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03890                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03891         
                      (    forth6809.asm):03892                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03893                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03894                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03895                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03896                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03897                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03898                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03899                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03900                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03901                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03902                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03903                                             ; by transmitting all chars.
                      (    forth6809.asm):03904         
E4CD                  (    forth6809.asm):03905         TRY_READ:
                      (    forth6809.asm):03906                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03907                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03908                                             ; while still transmitting!
                      (    forth6809.asm):03909         
                      (    forth6809.asm):03910                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03911                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03912                     PSHU  D                 ; Return result on data stack.
                      (    forth6809.asm):03913         
                      (    forth6809.asm):03914                     RTS
                      (    forth6809.asm):03915         
                      (    forth6809.asm):03916         ; ------------------------------------------------------------
                      (    forth6809.asm):03917         ; KEY? ( -- flag )
                      (    forth6809.asm):03918         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03919         KEYQ:
                      (    forth6809.asm):03920                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03921         
                      (    forth6809.asm):03922                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03923                     CMPA  INTAIL
                      (    forth6809.asm):03924         
                      (    forth6809.asm):03925                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03926         
                      (    forth6809.asm):03927                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03928         
                      (    forth6809.asm):03929                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03930                     PSHU  D
                      (    forth6809.asm):03931         
                      (    forth6809.asm):03932                     RTS
                      (    forth6809.asm):03933         
E4CD                  (    forth6809.asm):03934         KQTRUE:
                      (    forth6809.asm):03935                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03936                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03937                     RTS
                      (    forth6809.asm):03938         ; ------------------------------------------------------------
                      (    forth6809.asm):03939         ; EMIT  ( char -- )
                      (    forth6809.asm):03940         ; ------------------------------------------------------------
                      (    forth6809.asm):03941         
E4CD                  (    forth6809.asm):03942         X_EMIT:     PULU  D
                      (    forth6809.asm):03943                     STB   EMITCH
E4CD                  (    forth6809.asm):03944         EMITWT:     LDB   OUTHEAD
                      (    forth6809.asm):03945                     INCB
                      (    forth6809.asm):03946                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03947                     CMPB  OUTTAIL
                      (    forth6809.asm):03948                     BEQ   EMITWT
                      (    forth6809.asm):03949                     LDX   #OUTBUF
                      (    forth6809.asm):03950                     LDB   OUTHEAD
                      (    forth6809.asm):03951                     LDA   EMITCH
                      (    forth6809.asm):03952                     STA   B,X
                      (    forth6809.asm):03953                     INCB
                      (    forth6809.asm):03954                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03955                     STB   OUTHEAD
                      (    forth6809.asm):03956                     TST   RTSSTATE
                      (    forth6809.asm):03957                     BNE   EMITNORTS         ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03958                                             ; output stays queued until RTS drops low,
                      (    forth6809.asm):03959                                             ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03960                                             ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03961                     LDA   #CR_RXTX
                      (    forth6809.asm):03962                     STA   ACIACR
E4CD                  (    forth6809.asm):03963         EMITNORTS:  RTS
                      (    forth6809.asm):03964         
E4CD                  (    forth6809.asm):03965         EMIT:
                      (    forth6809.asm):03966                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03967                     TFR   B,A
                      (    forth6809.asm):03968                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03969                     RTS
                      (    forth6809.asm):03970         
                      (    forth6809.asm):03971                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03972         ; ------------------------------------------------------------
                      (    forth6809.asm):03973         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03974         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03975         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03976         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03977         ; directly against ACIASR.
                      (    forth6809.asm):03978         ;
                      (    forth6809.asm):03979         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03980         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03981         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03982         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03983         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03984         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03985         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03986         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03987         KEY:
E4CD B6C008           (    forth6809.asm):03988                     LDA   ACIASR
E4D0 8501             (    forth6809.asm):03989                     BITA  #SR_RDRF
E4D2 2705             (    forth6809.asm):03990                     BEQ   KWAIT
E4D4 7C017F           (    forth6809.asm):03991                     INC   POLLREADYCNT      ; character was already queued when we
E4D7 2007             (    forth6809.asm):03992                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E4D9                  (    forth6809.asm):03993         KWAIT:
E4D9 B6C008           (    forth6809.asm):03994         KSPIN:      LDA   ACIASR
E4DC 8501             (    forth6809.asm):03995                     BITA  #SR_RDRF
E4DE 27F9             (    forth6809.asm):03996                     BEQ   KSPIN
E4E0                  (    forth6809.asm):03997         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03998                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03999                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04000                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04001                                             ; RDRF and the latched error bits together
E4E0 8570             (    forth6809.asm):04002                     BITA  #SR_FE+SR_OVRN+SR_PE
E4E2 2715             (    forth6809.asm):04003                     BEQ   KGETCH
E4E4 8510             (    forth6809.asm):04004                     BITA  #SR_FE
E4E6 2703             (    forth6809.asm):04005                     BEQ   KXFE
E4E8 7C017C           (    forth6809.asm):04006                     INC   FECOUNT
E4EB 8520             (    forth6809.asm):04007         KXFE:       BITA  #SR_OVRN
E4ED 2703             (    forth6809.asm):04008                     BEQ   KXOVRN
E4EF 7C017D           (    forth6809.asm):04009                     INC   OVRNCOUNT
E4F2 8540             (    forth6809.asm):04010         KXOVRN:     BITA  #SR_PE
E4F4 2703             (    forth6809.asm):04011                     BEQ   KGETCH
E4F6 7C017E           (    forth6809.asm):04012                     INC   PECOUNT
E4F9 B6C009           (    forth6809.asm):04013         KGETCH:     LDA   ACIADR
E4FC 1F89             (    forth6809.asm):04014                     TFR   A,B
E4FE 4F               (    forth6809.asm):04015                     CLRA
E4FF 3606             (    forth6809.asm):04016                     PSHU  D
E501 39               (    forth6809.asm):04017                     RTS
                      (    forth6809.asm):04018         
                      (    forth6809.asm):04019         ; ------------------------------------------------------------
                      (    forth6809.asm):04020         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):04021         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):04022         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):04023         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):04024         ; either is safe to call from ACCEPT at any point without
                      (    forth6809.asm):04025         ; disturbing whatever's on U. See ACCEPT for where these are
                      (    forth6809.asm):04026         ; called: XON at the start of every line (the host may stream
                      (    forth6809.asm):04027         ; characters continuously while ACCEPT's own tight loop is
                      (    forth6809.asm):04028         ; polling), XOFF the instant a line is complete (CR seen), before
                      (    forth6809.asm):04029         ; handing off to INTERPRET/compilation - which does arbitrary,
                      (    forth6809.asm):04030         ; variable-length work with KEY never polled at all, exactly the
                      (    forth6809.asm):04031         ; window where a host that kept sending would build up a backlog
                      (    forth6809.asm):04032         ; this polling build (with no ring buffer to hold it) has no way
                      (    forth6809.asm):04033         ; to recover from correctly.
                      (    forth6809.asm):04034         ; ------------------------------------------------------------
E502 8613             (    forth6809.asm):04035         PUTXOFF:    LDA   #XOFFCH
E504 2002             (    forth6809.asm):04036                     BRA   PUTXCH
E506 8611             (    forth6809.asm):04037         PUTXON:     LDA   #XONCH
E508 3402             (    forth6809.asm):04038         PUTXCH:     PSHS  A
E50A F6C008           (    forth6809.asm):04039         PXWT:       LDB   ACIASR
E50D C502             (    forth6809.asm):04040                     BITB  #SR_TDRE
E50F 27F9             (    forth6809.asm):04041                     BEQ   PXWT

                      (    forth6809.asm):09458         ; ------------------------------------------------------------
                      (    forth6809.asm):09459         ; TRUE  ( -- flag )
                      (    forth6809.asm):09460         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09461         ; DODOES trampoline and no value cell.

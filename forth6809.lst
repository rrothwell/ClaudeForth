                      (    forth6809.asm):21961         ; ============================================================
                      (    forth6809.asm):21962         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):21963         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):21964         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):21965         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):21966         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):21967         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):21968         ; ============================================================
                      (    forth6809.asm):21969         ; ------------------------------------------------------------
                      (    forth6809.asm):21970         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):21971         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):21972         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):21973         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):21974         ; - no indirection, no value cell.
                      (    forth6809.asm):21975         ;
                      (    forth6809.asm):21976         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):21977         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):21978         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):21979         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):21980         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):21981         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):21982         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):21983         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):21984         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):21985         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):21986         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):21987         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):21988                    PSHU  D
FF3C 39               (    forth6809.asm):21989                    RTS
                      (    forth6809.asm):21990         
FF3D CC0000           (    forth6809.asm):21991         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):21992                    PSHU  D
FF42 39               (    forth6809.asm):21993                    RTS
                      (    forth6809.asm):21994         

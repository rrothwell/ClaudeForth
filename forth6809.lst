                      (    forth6809.asm):03898         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03899         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03900         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03901         ; ------------------------------------------------------------
E761 CCDF69           (    forth6809.asm):03902         WHILEW:     LDD   #ZBRANCH
E764 3606             (    forth6809.asm):03903                     PSHU  D
E766 BDEAB9           (    forth6809.asm):03904                     JSR   CCALL
E769 CC0000           (    forth6809.asm):03905                     LDD   #0
E76C 3606             (    forth6809.asm):03906                     PSHU  D
E76E BDDFFC           (    forth6809.asm):03907                     JSR   CODECOMMA
E771 DC08             (    forth6809.asm):03908                     LDD   CODEHERE
E773 830002           (    forth6809.asm):03909                     SUBD  #2
E776 3606             (    forth6809.asm):03910                     PSHU  D                 ; orig
E778 CC0001           (    forth6809.asm):03911                     LDD   #TAGFWD
E77B 3606             (    forth6809.asm):03912                     PSHU  D
E77D 39               (    forth6809.asm):03913                     RTS
                      (    forth6809.asm):03914         
                      (    forth6809.asm):03915         ; ------------------------------------------------------------
                      (    forth6809.asm):03916         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03917         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03918         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03919         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03920         ; ------------------------------------------------------------
E77E 3706             (    forth6809.asm):03921         REPEATW:    PULU  D
E780 10830001         (    forth6809.asm):03922                     CMPD  #TAGFWD
E784 2703             (    forth6809.asm):03923                     BEQ   RPOK1
E786 BDE609           (    forth6809.asm):03924                     JSR   CFERR
E789 3710             (    forth6809.asm):03925         RPOK1:      PULU  X                 ; orig
E78B 9F46             (    forth6809.asm):03926                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03927         
                      (    forth6809.asm):03928                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03929                     ; See bugfix: REPEATW.1
E78D 3040             (    forth6809.asm):03930                     LEAX  0,U               ; scan from top of control stack
E78F 9F2B             (    forth6809.asm):03931                     STX   MSCR2             ; MSCR2 = base of scan region
E791 9F2F             (    forth6809.asm):03932                     STX   MSCR4             ; MSCR4 = scan pointer
E793 DC2F             (    forth6809.asm):03933         RPSCAN:     LDD   MSCR4
E795 109348           (    forth6809.asm):03934                     CMPD  CSP
E798 2603             (    forth6809.asm):03935                     BNE   RPSCANOK
E79A BDE609           (    forth6809.asm):03936                     JSR   CFERR             ; no matching BEGIN
E79D 9E2F             (    forth6809.asm):03937         RPSCANOK:   LDX   MSCR4
E79F EC84             (    forth6809.asm):03938                     LDD   ,X
E7A1 10830002         (    forth6809.asm):03939                     CMPD  #TAGBACK
E7A5 2712             (    forth6809.asm):03940                     BEQ   RPFOUND
E7A7 10830001         (    forth6809.asm):03941                     CMPD  #TAGFWD
E7AB 2703             (    forth6809.asm):03942                     BEQ   RPSKIP
E7AD BDE609           (    forth6809.asm):03943                     JSR   CFERR             ; anything else is a genuine mismatch
E7B0 DC2F             (    forth6809.asm):03944         RPSKIP:     LDD   MSCR4
E7B2 C30004           (    forth6809.asm):03945                     ADDD  #4
E7B5 DD2F             (    forth6809.asm):03946                     STD   MSCR4
E7B7 20DA             (    forth6809.asm):03947                     BRA   RPSCAN
E7B9 9E2F             (    forth6809.asm):03948         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E7BB EC02             (    forth6809.asm):03949                     LDD   2,X               ; dest = BEGIN's address
E7BD DD44             (    forth6809.asm):03950                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):03951         
                      (    forth6809.asm):03952                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03953                     ; bytes, highest word first.
E7BF DC2F             (    forth6809.asm):03954                     LDD   MSCR4
E7C1 932B             (    forth6809.asm):03955                     SUBD  MSCR2
E7C3 DD2D             (    forth6809.asm):03956                     STD   MSCR3             ; MSCR3 = bytes to shift
E7C5 2715             (    forth6809.asm):03957                     BEQ   RPSHIFTDONE
E7C7 DC2D             (    forth6809.asm):03958         RPSHIFT:    LDD   MSCR3
E7C9 830002           (    forth6809.asm):03959                     SUBD  #2
E7CC DD2D             (    forth6809.asm):03960                     STD   MSCR3
E7CE 9E2B             (    forth6809.asm):03961                     LDX   MSCR2
E7D0 308B             (    forth6809.asm):03962                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E7D2 EC84             (    forth6809.asm):03963                     LDD   ,X
E7D4 3004             (    forth6809.asm):03964                     LEAX  4,X
E7D6 ED84             (    forth6809.asm):03965                     STD   ,X                ; copy one word 4 bytes higher
E7D8 DC2D             (    forth6809.asm):03966                     LDD   MSCR3
E7DA 26EB             (    forth6809.asm):03967                     BNE   RPSHIFT
E7DC                  (    forth6809.asm):03968         RPSHIFTDONE:
E7DC 9E2B             (    forth6809.asm):03969                     LDX   MSCR2
E7DE 3004             (    forth6809.asm):03970                     LEAX  4,X
E7E0 1F13             (    forth6809.asm):03971                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03972         
E7E2 CCDF7F           (    forth6809.asm):03973                     LDD   #BRANCH
E7E5 3606             (    forth6809.asm):03974                     PSHU  D
E7E7 BDEAB9           (    forth6809.asm):03975                     JSR   CCALL
E7EA CC0000           (    forth6809.asm):03976                     LDD   #0
E7ED 3606             (    forth6809.asm):03977                     PSHU  D
E7EF BDDFFC           (    forth6809.asm):03978                     JSR   CODECOMMA
E7F2 DC08             (    forth6809.asm):03979                     LDD   CODEHERE
E7F4 830002           (    forth6809.asm):03980                     SUBD  #2
E7F7 DD2D             (    forth6809.asm):03981                     STD   MSCR3             ; MSCR3 = branch operand address
E7F9 DC44             (    forth6809.asm):03982                     LDD   PFIELD            ; target = BEGIN's address
E7FB 3606             (    forth6809.asm):03983                     PSHU  D
E7FD DC2D             (    forth6809.asm):03984                     LDD   MSCR3             ; location = the operand just compiled
E7FF 3606             (    forth6809.asm):03985                     PSHU  D
E801 BDE673           (    forth6809.asm):03986                     JSR   PATCH
E804 DC08             (    forth6809.asm):03987                     LDD   CODEHERE
E806 3606             (    forth6809.asm):03988                     PSHU  D
E808 DC46             (    forth6809.asm):03989                     LDD   NEWFLD
E80A 3606             (    forth6809.asm):03990                     PSHU  D
E80C BDE673           (    forth6809.asm):03991                     JSR   PATCH
E80F 39               (    forth6809.asm):03992                     RTS
                      (    forth6809.asm):03993         
                      (    forth6809.asm):03994         ; ------------------------------------------------------------
                      (    forth6809.asm):03995         ; RECURSE  ( -- )
                      (    forth6809.asm):03996         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03997         ; the xt held in CURXT.
                      (    forth6809.asm):03998         ; ------------------------------------------------------------
E810 DC3D             (    forth6809.asm):03999         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E812 3606             (    forth6809.asm):04000                     PSHU  D                 ; See bugfix: RECURSEW.1
E814 BDEAB9           (    forth6809.asm):04001                     JSR   CCALL
E817 39               (    forth6809.asm):04002                     RTS
                      (    forth6809.asm):04003         
                      (    forth6809.asm):04004         ; ------------------------------------------------------------
                      (    forth6809.asm):04005         ; DO  ( C: -- dest )
                      (    forth6809.asm):04006         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04007         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04008         ; ------------------------------------------------------------
E818 CCE82A           (    forth6809.asm):04009         DOW:        LDD   #DOSETUP
E81B 3606             (    forth6809.asm):04010                     PSHU  D
E81D BDEAB9           (    forth6809.asm):04011                     JSR   CCALL
E820 DC08             (    forth6809.asm):04012                     LDD   CODEHERE
E822 3606             (    forth6809.asm):04013                     PSHU  D                 ; dest
E824 CC0003           (    forth6809.asm):04014                     LDD   #TAGDO
E827 3606             (    forth6809.asm):04015                     PSHU  D
E829 39               (    forth6809.asm):04016                     RTS
                      (    forth6809.asm):04017         
                      (    forth6809.asm):04018         ; ------------------------------------------------------------
                      (    forth6809.asm):04019         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04020         ; return address.
                      (    forth6809.asm):04021         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04022         ;    Inputs:
                      (    forth6809.asm):04023         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04024         ;    Outputs:
                      (    forth6809.asm):04025         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04026         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04027         ; ------------------------------------------------------------
E82A 3706             (    forth6809.asm):04028         DOSETUP:    PULU  D                 ; index
E82C DD29             (    forth6809.asm):04029                     STD   MSCR
E82E 3706             (    forth6809.asm):04030                     PULU  D                 ; limit
E830 DD2B             (    forth6809.asm):04031                     STD   MSCR2
E832 3510             (    forth6809.asm):04032                     PULS  X
E834 CC0000           (    forth6809.asm):04033                     LDD   #0
E837 3406             (    forth6809.asm):04034                     PSHS  D
E839 DC2B             (    forth6809.asm):04035                     LDD   MSCR2
E83B 3406             (    forth6809.asm):04036                     PSHS  D
E83D DC29             (    forth6809.asm):04037                     LDD   MSCR
E83F 3406             (    forth6809.asm):04038                     PSHS  D
E841 3410             (    forth6809.asm):04039                     PSHS  X
E843 39               (    forth6809.asm):04040                     RTS
                      (    forth6809.asm):04041         
                      (    forth6809.asm):04042         ; ------------------------------------------------------------
                      (    forth6809.asm):04043         ; I  ( -- n )
                      (    forth6809.asm):04044         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04045         ; address).
                      (    forth6809.asm):04046         ; ------------------------------------------------------------
E844 EC62             (    forth6809.asm):04047         IW:         LDD   2,S               ; n. See bugfix: IW.1
E846 3606             (    forth6809.asm):04048                     PSHU  D
E848 39               (    forth6809.asm):04049                     RTS
                      (    forth6809.asm):04050         
                      (    forth6809.asm):04051         ; ------------------------------------------------------------
                      (    forth6809.asm):04052         ; J  ( -- n )
                      (    forth6809.asm):04053         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04054         ; address and the inner loop frame).
                      (    forth6809.asm):04055         ; ------------------------------------------------------------
E849 EC68             (    forth6809.asm):04056         JW:         LDD   8,S               ; n. See bugfix: JW.1
E84B 3606             (    forth6809.asm):04057                     PSHU  D
E84D 39               (    forth6809.asm):04058                     RTS
                      (    forth6809.asm):04059         
                      (    forth6809.asm):04060         ; ------------------------------------------------------------
                      (    forth6809.asm):04061         ; LEAVE  ( -- )
                      (    forth6809.asm):04062         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04063         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04064         ; ------------------------------------------------------------
E84E CCFFFF           (    forth6809.asm):04065         LEAVEW:     LDD   #TRUEV            ; true
E851 ED66             (    forth6809.asm):04066                     STD   6,S               ; See bugfix: LEAVEW.1
E853 39               (    forth6809.asm):04067                     RTS
                      (    forth6809.asm):04068         
                      (    forth6809.asm):04069         ; ------------------------------------------------------------
                      (    forth6809.asm):04070         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04071         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04072         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04073         ; ------------------------------------------------------------
E854 3706             (    forth6809.asm):04074         LOOPW:      PULU  D
E856 10830003         (    forth6809.asm):04075                     CMPD  #TAGDO
E85A 2703             (    forth6809.asm):04076                     BEQ   LOOPOK
E85C BDE609           (    forth6809.asm):04077                     JSR   CFERR
E85F 3706             (    forth6809.asm):04078         LOOPOK:     PULU  D                 ; dest
E861 3606             (    forth6809.asm):04079                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E863 CCE89B           (    forth6809.asm):04080                     LDD   #DOTEST
E866 3606             (    forth6809.asm):04081                     PSHU  D
E868 BDEAB9           (    forth6809.asm):04082                     JSR   CCALL
E86B CC0000           (    forth6809.asm):04083                     LDD   #0
E86E 3606             (    forth6809.asm):04084                     PSHU  D
E870 BDDFFC           (    forth6809.asm):04085                     JSR   CODECOMMA
E873 DC08             (    forth6809.asm):04086                     LDD   CODEHERE
E875 830002           (    forth6809.asm):04087                     SUBD  #2
E878 DD44             (    forth6809.asm):04088                     STD   PFIELD
E87A 3706             (    forth6809.asm):04089                     PULU  D
E87C 3606             (    forth6809.asm):04090                     PSHU  D
E87E DC44             (    forth6809.asm):04091                     LDD   PFIELD
E880 3606             (    forth6809.asm):04092                     PSHU  D
E882 BDE673           (    forth6809.asm):04093                     JSR   PATCH
                      (    forth6809.asm):04094         
E885 ECC4             (    forth6809.asm):04095                     LDD   ,U
E887 10830007         (    forth6809.asm):04096                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E88B 260D             (    forth6809.asm):04097                     BNE   LOOPDONE
E88D 3706             (    forth6809.asm):04098                     PULU  D
E88F 3710             (    forth6809.asm):04099                     PULU  X                 ; ?DO skip operand
E891 DC08             (    forth6809.asm):04100                     LDD   CODEHERE
E893 3606             (    forth6809.asm):04101                     PSHU  D
E895 3610             (    forth6809.asm):04102                     PSHU  X
E897 BDE673           (    forth6809.asm):04103                     JSR   PATCH
E89A 39               (    forth6809.asm):04104         LOOPDONE:   RTS
                      (    forth6809.asm):04105         
                      (    forth6809.asm):04106         ; ------------------------------------------------------------
                      (    forth6809.asm):04107         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04108         ; the back-branch operand. Add 1 to the index. If the leave flag is

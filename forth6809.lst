                      (    forth6809.asm):03609                                   ; those clobber X internally (CCALL's own LDX
                      (    forth6809.asm):03610                                   ; CODEHERE, CODECOMMA's LDX #CODEHERE via
                      (    forth6809.asm):03611                                   ; APPENDCELL), so X no longer held the target
                      (    forth6809.asm):03612                                   ; by the time TFR X,D ran - it held the address
                      (    forth6809.asm):03613                                   ; of the CODEHERE variable itself, corrupting

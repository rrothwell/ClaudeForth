                      (    forth6809.asm):17734                                  ; own flags from the PULU above - and PULU
                      (    forth6809.asm):17735                                  ; doesn't set flags on genuine 6809 anyway
                      (    forth6809.asm):17736                                  ; (same class as TRYNUM/STOD/SIGN's own fixes

                      (    forth6809.asm):13690         ; ------------------------------------------------------------
                      (    forth6809.asm):13691         ; TSTNUMOUT - numeric output tests (glossary section 3.13, 14
                      (    forth6809.asm):13692         ; words, 13 tests since #S and #> are combined into one test,
                      (    forth6809.asm):13693         ; matching how they're naturally used together as the tail of
                      (    forth6809.asm):13694         ; the standard pictured-output idiom "<# ... #S #>").
                      (    forth6809.asm):13695         ;
                      (    forth6809.asm):13696         ; The pictured-numeric-output core (<# # #S #> HOLD HOLDS) is
                      (    forth6809.asm):13697         ; pure string-building with no I/O, tested directly. SIGN
                      (    forth6809.asm):13698         ; carries real bug-fix history - a prior bare BPL right after
                      (    forth6809.asm):13699         ; PULU didn't affect condition codes on real 6809 hardware, and
                      (    forth6809.asm):13700         ; the bug was masked for every internal caller by caller-side
                      (    forth6809.asm):13701         ; luck (each ran a flag-setting LDD right before calling SIGN).
                      (    forth6809.asm):13702         ; This section's own SIGN test deliberately poisons the flags
                      (    forth6809.asm):13703         ; with an unrelated CMPX immediately before each direct call,
                      (    forth6809.asm):13704         ; so it exercises the exact previously-broken scenario rather
                      (    forth6809.asm):13705         ; than repeating the same kind of luck that hid the bug.
                      (    forth6809.asm):13706         ;
                      (    forth6809.asm):13707         ; The high-level printing words (./U./.R/U.R/?/D./D.R) all
                      (    forth6809.asm):13708         ; produce real output via TYPE/EMIT internally, so each applies
                      (    forth6809.asm):13709         ; the SERIALPOLL-conditional split established in section 3.1 -
                      (    forth6809.asm):13710         ; full OUTHEAD/OUTBUF verification under SERIALPOLL=0, an
                      (    forth6809.asm):13711         ; EMITCH-based last-character check under SERIALPOLL=1. .R/U.R/
                      (    forth6809.asm):13712         ; D.R specifically test the padding path (a width wider than the
                      (    forth6809.asm):13713         ; actual digits), not just a no-padding sanity case. D./D.R use
                      (    forth6809.asm):13714         ; a genuine double-cell value (-100000, computed and verified
                      (    forth6809.asm):13715         ; independently in Python before writing the tests) to exercise
                      (    forth6809.asm):13716         ; the 32-bit negation path, not a value that happens to fit in
                      (    forth6809.asm):13717         ; one cell.
                      (    forth6809.asm):13718         ;
                      (    forth6809.asm):13719         ; Note: this section's own COMPARE-adjacent naming risk doesn't
                      (    forth6809.asm):13720         ; apply here, but every group wrapper name (TSTNUMOUT) and every
                      (    forth6809.asm):13721         ; internal FAIL/DONE prefix was still checked against the whole
                      (    forth6809.asm):13722         ; file before insertion, per the standard practice that caught
                      (    forth6809.asm):13723         ; the TSTCOMPARE collision in the prior section.
                      (    forth6809.asm):13724         ; ------------------------------------------------------------
C2AB BDFC2B           (    forth6809.asm):13725         TSTNUMOUT: JSR CRW
C2AE 8EC2BF           (    forth6809.asm):13726                    LDX   #TSTNUMOUTMSG
C2B1 3610             (    forth6809.asm):13727                    PSHU  X
C2B3 CC0006           (    forth6809.asm):13728                    LDD   #6
C2B6 3606             (    forth6809.asm):13729                    PSHU  D
C2B8 BDF60B           (    forth6809.asm):13730                    JSR   TYPE
C2BB BDFC2B           (    forth6809.asm):13731                    JSR   CRW
                      (    forth6809.asm):13732         
                      (    forth6809.asm):13733                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13734         
                      (    forth6809.asm):13735                    JSR   TSTLTNUM
                      (    forth6809.asm):13736                    JSR   TSTHOLD
                      (    forth6809.asm):13737                    JSR   TSTHOLDS
                      (    forth6809.asm):13738                    JSR   TSTSIGN
                      (    forth6809.asm):13739                    JSR   TSTNUMSIGN
                      (    forth6809.asm):13740                    JSR   TSTNUMSIGNSGT
                      (    forth6809.asm):13741                    JSR   TSTDOT
                      (    forth6809.asm):13742                    JSR   TSTUDOT
                      (    forth6809.asm):13743                    JSR   TSTDOTR
                      (    forth6809.asm):13744                    JSR   TSTUDOTR
                      (    forth6809.asm):13745                    JSR   TSTQMARK
                      (    forth6809.asm):13746                    JSR   TSTDDOT
                      (    forth6809.asm):13747                    JSR   TSTDDOTR
                      (    forth6809.asm):13748         
                      (    forth6809.asm):13749                    ENDC ; <<<<
                      (    forth6809.asm):13750         
C2BE 39               (    forth6809.asm):13751                    RTS
                      (    forth6809.asm):13752         
C2BF 4E756D4F7574     (    forth6809.asm):13753         TSTNUMOUTMSG: FCC "NumOut"
                      (    forth6809.asm):13754         
                      (    forth6809.asm):13755                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13756         
                      (    forth6809.asm):13757         ; ------------------------------------------------------------
                      (    forth6809.asm):13758         ; Numeric Output test harness (glossary section 3.13). The
                      (    forth6809.asm):13759         ; pictured-numeric-output core (<# # #S #> HOLD HOLDS SIGN) is
                      (    forth6809.asm):13760         ; pure string-building with no I/O, tested directly. The
                      (    forth6809.asm):13761         ; high-level printing words (./U./.R/U.R/?/D./D.R) all produce
                      (    forth6809.asm):13762         ; real output via TYPE and/or EMIT internally, so per section
                      (    forth6809.asm):13763         ; 3.1's own already-debugged finding, each applies the
                      (    forth6809.asm):13764         ; SERIALPOLL-conditional split established there: full OUTHEAD/
                      (    forth6809.asm):13765         ; OUTBUF verification under SERIALPOLL=0, an EMITCH-based check
                      (    forth6809.asm):13766         ; of the last character under SERIALPOLL=1 - accepted as a
                      (    forth6809.asm):13767         ; known, honest limitation for words ending in a trailing space
                      (    forth6809.asm):13768         ; (./U./D. all print a fixed final space character, so the
                      (    forth6809.asm):13769         ; polling-mode check there confirms less than for the
                      (    forth6809.asm):13770         ; no-trailing-space words, but is still correct and consistent
                      (    forth6809.asm):13771         ; with the same trade-off already established for TSTCR/
                      (    forth6809.asm):13772         ; TSTSPACES/TSTTYPE/TSTDOTQUOTE in earlier sections).
                      (    forth6809.asm):13773         ;
                      (    forth6809.asm):13774         ; SIGN itself carries real bug-fix history: a prior version used
                      (    forth6809.asm):13775         ; a bare BPL immediately after PULU, which doesn't affect
                      (    forth6809.asm):13776         ; condition codes on real 6809 hardware - the bug was masked for
                      (    forth6809.asm):13777         ; every internal caller by "caller-side luck" (each happened to
                      (    forth6809.asm):13778         ; run a flag-setting LDD right before calling SIGN). This
                      (    forth6809.asm):13779         ; section's own SIGN test deliberately poisons the flags with an
                      (    forth6809.asm):13780         ; unrelated, known-positive value immediately before the actual
                      (    forth6809.asm):13781         ; PSHU/JSR SIGN sequence specifically so a standalone call - the
                      (    forth6809.asm):13782         ; exact scenario the bug-fix comment says was previously broken
                      (    forth6809.asm):13783         ; - is what gets tested, not a scenario that happens to work via
                      (    forth6809.asm):13784         ; the same kind of caller-side luck that hid the original bug.
                      (    forth6809.asm):13785         ; ------------------------------------------------------------
                      (    forth6809.asm):13786         
                      (    forth6809.asm):13787         ; ------------------------------------------------------------
                      (    forth6809.asm):13788         ; TSTLTNUM - unit test for <#. No stack effect of its own -
                      (    forth6809.asm):13789         ; verifies it sets HLD to PAD's current (redirected) address.
                      (    forth6809.asm):13790         ; ------------------------------------------------------------
C2C5                  (    forth6809.asm):13791         TSTLTNUM: LDD  CODEHERE
                      (    forth6809.asm):13792                   STD  TSTCSAV
                      (    forth6809.asm):13793         
                      (    forth6809.asm):13794                   LDD  #TSTCBUF
                      (    forth6809.asm):13795                   STD  CODEHERE
                      (    forth6809.asm):13796         
                      (    forth6809.asm):13797                   STU  TSTU0
                      (    forth6809.asm):13798         
                      (    forth6809.asm):13799                   LDD  #TSTGUARD
                      (    forth6809.asm):13800                   PSHU D
                      (    forth6809.asm):13801                   STU  TSTUB4
                      (    forth6809.asm):13802         
                      (    forth6809.asm):13803                   JSR  LTNUM
                      (    forth6809.asm):13804         
                      (    forth6809.asm):13805                   STU  TSTUAF
                      (    forth6809.asm):13806         
                      (    forth6809.asm):13807                   LDD  HLD
                      (    forth6809.asm):13808                   CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):13809                   BNE  LNFAIL
                      (    forth6809.asm):13810         
                      (    forth6809.asm):13811                   PULU D
                      (    forth6809.asm):13812                   CMPD #TSTGUARD
                      (    forth6809.asm):13813                   BNE  LNFAIL
                      (    forth6809.asm):13814         
                      (    forth6809.asm):13815                   LDD  TSTUB4
                      (    forth6809.asm):13816                   SUBD TSTUAF
                      (    forth6809.asm):13817                   CMPD #0
                      (    forth6809.asm):13818                   BNE  LNFAIL
                      (    forth6809.asm):13819         
                      (    forth6809.asm):13820                   LDD  #TRUEV
                      (    forth6809.asm):13821                   BRA  LNDONE
C2C5                  (    forth6809.asm):13822         LNFAIL:   LDD  #FALSEV
C2C5                  (    forth6809.asm):13823         LNDONE:   LDX  #TSTLNNAME
                      (    forth6809.asm):13824                   PSHU X
                      (    forth6809.asm):13825                   PSHU D
                      (    forth6809.asm):13826                   JSR  TSTREPORT
                      (    forth6809.asm):13827         
                      (    forth6809.asm):13828                   LDD  TSTCSAV
                      (    forth6809.asm):13829                   STD  CODEHERE
                      (    forth6809.asm):13830         
                      (    forth6809.asm):13831                   LDU  TSTU0
                      (    forth6809.asm):13832                   RTS
                      (    forth6809.asm):13833         
C2C5                  (    forth6809.asm):13834         TSTLNNAME: FCB  8
                      (    forth6809.asm):13835                    FCC  "TSTLTNUM"
                      (    forth6809.asm):13836         

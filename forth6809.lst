                      (    forth6809.asm):18086                  LDA   B,X
                      (    forth6809.asm):18087                  STA   ACIADR
                      (    forth6809.asm):18088                  INCB
                      (    forth6809.asm):18089                  ANDB  #OUTBUFSZ-1

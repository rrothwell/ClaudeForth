                      (    forth6809.asm):09070         ; TSTISOF - unit test for IS and ACTION-OF together. Compiles
                      (    forth6809.asm):09071         ; "DEFER TESTWD", interprets "DUP IS TESTWD" directly (IS parses
                      (    forth6809.asm):09072         ; "TESTWD" via WORD+FIND, needing LATEST still pointed at it -
                      (    forth6809.asm):09073         ; not restored until this whole test finishes), executes TESTWD
                      (    forth6809.asm):09074         ; (should now behave like DUP), then interprets "ACTION-OF
                      (    forth6809.asm):09075         ; TESTWD" to fetch the current target by name and confirms it
                      (    forth6809.asm):09076         ; matches DUP's own xt. Explicitly forces STATE=0 before both IS
                      (    forth6809.asm):09077         ; and ACTION-OF, since both are documented to behave differently
                      (    forth6809.asm):09078         ; by STATE, same reasoning as TSTVALTO's own TO test.
                      (    forth6809.asm):09079         ; ------------------------------------------------------------
C48E                  (    forth6809.asm):09080         TSTISOF: LDD   CODEHERE
                      (    forth6809.asm):09081                  STD   TSTCSAV
                      (    forth6809.asm):09082                  LDD   DPHERE
                      (    forth6809.asm):09083                  STD   TSTDSAV
                      (    forth6809.asm):09084                  LDD   VARHERE
                      (    forth6809.asm):09085                  STD   TSTVSAV
                      (    forth6809.asm):09086                  LDD   SRCADDR
                      (    forth6809.asm):09087                  STD   TSTSASAV
                      (    forth6809.asm):09088                  LDD   SRCLEN
                      (    forth6809.asm):09089                  STD   TSTSLSAV
                      (    forth6809.asm):09090                  LDD   TOIN
                      (    forth6809.asm):09091                  STD   TSTTISAV
                      (    forth6809.asm):09092                  LDD   STATE
                      (    forth6809.asm):09093                  STD   TSTSTSAV
                      (    forth6809.asm):09094                  LDD   LATEST
                      (    forth6809.asm):09095                  STD   TSTLSAV
                      (    forth6809.asm):09096         
                      (    forth6809.asm):09097                  LDA   #'T'
                      (    forth6809.asm):09098                  STA   TSTNAMEB
                      (    forth6809.asm):09099                  LDA   #'E'
                      (    forth6809.asm):09100                  STA   TSTNAMEB+1
                      (    forth6809.asm):09101                  LDA   #'S'
                      (    forth6809.asm):09102                  STA   TSTNAMEB+2
                      (    forth6809.asm):09103                  LDA   #'T'
                      (    forth6809.asm):09104                  STA   TSTNAMEB+3
                      (    forth6809.asm):09105                  LDA   #'W'
                      (    forth6809.asm):09106                  STA   TSTNAMEB+4
                      (    forth6809.asm):09107                  LDA   #'D'
                      (    forth6809.asm):09108                  STA   TSTNAMEB+5
                      (    forth6809.asm):09109         
                      (    forth6809.asm):09110                  LDD   #TSTCBUF
                      (    forth6809.asm):09111                  STD   CODEHERE
                      (    forth6809.asm):09112                  LDD   #TSTDBUF
                      (    forth6809.asm):09113                  STD   DPHERE
                      (    forth6809.asm):09114                  LDD   #TSTVBUF
                      (    forth6809.asm):09115                  STD   VARHERE
                      (    forth6809.asm):09116                  LDD   #TSTNAMEB
                      (    forth6809.asm):09117                  STD   SRCADDR
                      (    forth6809.asm):09118                  LDD   #6
                      (    forth6809.asm):09119                  STD   SRCLEN
                      (    forth6809.asm):09120                  LDD   #0
                      (    forth6809.asm):09121                  STD   TOIN
                      (    forth6809.asm):09122         
                      (    forth6809.asm):09123                  LDD   CODEHERE
                      (    forth6809.asm):09124                  STD   TSTWCFA
                      (    forth6809.asm):09125         
                      (    forth6809.asm):09126                  JSR   DEFERW
                      (    forth6809.asm):09127         
                      (    forth6809.asm):09128                  LDD   TSTCSAV
                      (    forth6809.asm):09129                  STD   CODEHERE
                      (    forth6809.asm):09130         
                      (    forth6809.asm):09131                  LDA   #'T'
                      (    forth6809.asm):09132                  STA   TSTNAMEB
                      (    forth6809.asm):09133                  LDA   #'E'
                      (    forth6809.asm):09134                  STA   TSTNAMEB+1
                      (    forth6809.asm):09135                  LDA   #'S'
                      (    forth6809.asm):09136                  STA   TSTNAMEB+2
                      (    forth6809.asm):09137                  LDA   #'T'
                      (    forth6809.asm):09138                  STA   TSTNAMEB+3
                      (    forth6809.asm):09139                  LDA   #'W'
                      (    forth6809.asm):09140                  STA   TSTNAMEB+4
                      (    forth6809.asm):09141                  LDA   #'D'
                      (    forth6809.asm):09142                  STA   TSTNAMEB+5
                      (    forth6809.asm):09143                  LDD   #TSTNAMEB
                      (    forth6809.asm):09144                  STD   SRCADDR
                      (    forth6809.asm):09145                  LDD   #6
                      (    forth6809.asm):09146                  STD   SRCLEN
                      (    forth6809.asm):09147                  LDD   #0
                      (    forth6809.asm):09148                  STD   TOIN
                      (    forth6809.asm):09149                  LDD   #0
                      (    forth6809.asm):09150                  STD   STATE
                      (    forth6809.asm):09151         
                      (    forth6809.asm):09152                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):09153                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):09154                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):09155                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09156                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09157                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09158                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09159                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09160                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09161                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09162                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09163                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09164                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09165                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):09166                  STD   CODEHERE
                      (    forth6809.asm):09167         
                      (    forth6809.asm):09168                  LDD   #DUP
                      (    forth6809.asm):09169                  PSHU  D
                      (    forth6809.asm):09170                  JSR   ISW
                      (    forth6809.asm):09171         

                      (    forth6809.asm):07114         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):07115         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):07116         ; each %name% that matches the name registered by REPLACES with its
                      (    forth6809.asm):07117         ; text. "%%" becomes a single "%"; a %name% that does not match, and
                      (    forth6809.asm):07118         ; an unpaired "%", are copied unchanged. u3 is the output length and n
                      (    forth6809.asm):07119         ; the number of substitutions. THROW -1 if the output does not fit.
                      (    forth6809.asm):07120         ; Scratch: MSCR = read position, MSCR2 = substitution count, MSCR3 and
                      (    forth6809.asm):07121         ; MSCR4 = temporaries for each %-pair. Original comment: shadow
                      (    forth6809.asm):07122         ; SUBSTITUTEW.1.
                      (    forth6809.asm):07123         ; ------------------------------------------------------------

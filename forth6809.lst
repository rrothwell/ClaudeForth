                      (    forth6809.asm):10453         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (    forth6809.asm):10454         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (    forth6809.asm):10455         ; IS tests, but gets its own dedicated test here too.
                      (    forth6809.asm):10456         ;
                      (    forth6809.asm):10457         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (    forth6809.asm):10458         ; itself (a pure address computation) - wrong, confirmed via
                      (    forth6809.asm):10459         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (    forth6809.asm):10460         ; returning the VALUE stored there, not the address itself. This
                      (    forth6809.asm):10461         ; is genuinely correct behavior for this system's own trampoline
                      (    forth6809.asm):10462         ; design, not a bug in TOBODY - reconciled directly against why
                      (    forth6809.asm):10463         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (    forth6809.asm):10464         ; same TOBODY and passed on real hardware, never surfaced this:
                      (    forth6809.asm):10465         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (    forth6809.asm):10466         ; own compile-time code stores a genuinely meaningful value at
                      (    forth6809.asm):10467         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (    forth6809.asm):10468         ; value) - "the body" for this system's own design IS the value
                      (    forth6809.asm):10469         ; at xt+5, not xt+5's own address. This test never initialized
                      (    forth6809.asm):10470         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (    forth6809.asm):10471         ; whatever garbage happened to already be there - now sets a
                      (    forth6809.asm):10472         ; known value there first and verifies TOBODY returns exactly
                      (    forth6809.asm):10473         ; that.
                      (    forth6809.asm):10474         ; ------------------------------------------------------------
C275                  (    forth6809.asm):10475         TSTTOBODY: LDD  #TSTVAL1
                      (    forth6809.asm):10476                    STD  TSTCBUF+5
                      (    forth6809.asm):10477         
                      (    forth6809.asm):10478                    STU  TSTU0
                      (    forth6809.asm):10479         
                      (    forth6809.asm):10480                    LDD  #TSTGUARD
                      (    forth6809.asm):10481                    PSHU D
                      (    forth6809.asm):10482                    LDD  #TSTCBUF
                      (    forth6809.asm):10483                    PSHU D
                      (    forth6809.asm):10484                    STU  TSTUB4
                      (    forth6809.asm):10485         
                      (    forth6809.asm):10486                    JSR  TOBODY
                      (    forth6809.asm):10487         
                      (    forth6809.asm):10488                    STU  TSTUAF
                      (    forth6809.asm):10489         
                      (    forth6809.asm):10490                    PULU D
                      (    forth6809.asm):10491                    CMPD #TSTVAL1
                      (    forth6809.asm):10492                    BNE  TBFAIL
                      (    forth6809.asm):10493                    PULU D
                      (    forth6809.asm):10494                    CMPD #TSTGUARD
                      (    forth6809.asm):10495                    BNE  TBFAIL
                      (    forth6809.asm):10496         
                      (    forth6809.asm):10497                    LDD  TSTUB4
                      (    forth6809.asm):10498                    SUBD TSTUAF
                      (    forth6809.asm):10499                    CMPD #0
                      (    forth6809.asm):10500                    BNE  TBFAIL
                      (    forth6809.asm):10501         
                      (    forth6809.asm):10502                    LDD  #TRUEV
                      (    forth6809.asm):10503                    BRA  TBDONE
C275                  (    forth6809.asm):10504         TBFAIL:    LDD  #FALSEV
C275                  (    forth6809.asm):10505         TBDONE:    LDX  #TSTTBNAME
                      (    forth6809.asm):10506                    PSHU X
                      (    forth6809.asm):10507                    PSHU D

                      (    forth6809.asm):03568                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):03569         
E8BF EC68             (    forth6809.asm):03570         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E8C1 3606             (    forth6809.asm):03571                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E8C3 39               (    forth6809.asm):03572                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):03573                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):03574                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):03575                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):03576                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):03577                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):03578                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):03579                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):03580                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):03581                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):03582                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):03583                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):03584                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):03585                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):03586                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):03587                                   ; limit, never progressing). Confirmed via a
                      (    forth6809.asm):03588                                   ; real MULT-TABLE test on MAME.
                      (    forth6809.asm):03589         

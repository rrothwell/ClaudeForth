                      (    forth6809.asm):08126         ; ------------------------------------------------------------
                      (    forth6809.asm):08127         ; TRUE  ( -- flag )
                      (    forth6809.asm):08128         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08129         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08130         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08131         ; ------------------------------------------------------------
FD96 CCFFFF           (    forth6809.asm):08132         TRUEW:      LDD   #$FFFF
FD99 3606             (    forth6809.asm):08133                     PSHU  D
FD9B 39               (    forth6809.asm):08134                     RTS
                      (    forth6809.asm):08135         
                      (    forth6809.asm):08136         ; ------------------------------------------------------------
                      (    forth6809.asm):08137         ; FALSE  ( -- flag )
                      (    forth6809.asm):08138         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08139         ; ------------------------------------------------------------
FD9C CC0000           (    forth6809.asm):08140         FALSEW:     LDD   #$0000
FD9F 3606             (    forth6809.asm):08141                     PSHU  D
FDA1 39               (    forth6809.asm):08142                     RTS
                      (    forth6809.asm):08143         
                      (    forth6809.asm):08144         ; ------------------------------------------------------------
                      (    forth6809.asm):08145         ; 1  ( -- 1 )
                      (    forth6809.asm):08146         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08147         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08148         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):08149         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):08150         ; ------------------------------------------------------------
FDA2 CC0001           (    forth6809.asm):08151         POSONEW:    LDD   #1
FDA5 3606             (    forth6809.asm):08152                     PSHU  D
FDA7 39               (    forth6809.asm):08153                     RTS
                      (    forth6809.asm):08154         
                      (    forth6809.asm):08155         ; ------------------------------------------------------------
                      (    forth6809.asm):08156         ; -1  ( -- -1 )
                      (    forth6809.asm):08157         ; Push the constant -1.
                      (    forth6809.asm):08158         ; ------------------------------------------------------------
FDA8 CCFFFF           (    forth6809.asm):08159         NEGONEW:    LDD   #-1
FDAB 3606             (    forth6809.asm):08160                     PSHU  D
FDAD 39               (    forth6809.asm):08161                     RTS
                      (    forth6809.asm):08162         
                      (    forth6809.asm):08163         ; ------------------------------------------------------------
                      (    forth6809.asm):08164         ; 2  ( -- 2 )
                      (    forth6809.asm):08165         ; Push the constant 2.
                      (    forth6809.asm):08166         ; ------------------------------------------------------------
FDAE CC0002           (    forth6809.asm):08167         POSTWOW:    LDD   #2
FDB1 3606             (    forth6809.asm):08168                     PSHU  D
FDB3 39               (    forth6809.asm):08169                     RTS
                      (    forth6809.asm):08170         
                      (    forth6809.asm):08171         ; ------------------------------------------------------------
                      (    forth6809.asm):08172         ; -2  ( -- -2 )
                      (    forth6809.asm):08173         ; Push the constant -2.
                      (    forth6809.asm):08174         ; ------------------------------------------------------------
FDB4 CCFFFE           (    forth6809.asm):08175         NEGTWOW:    LDD   #-2
FDB7 3606             (    forth6809.asm):08176                     PSHU  D
FDB9 39               (    forth6809.asm):08177                     RTS
                      (    forth6809.asm):08178         

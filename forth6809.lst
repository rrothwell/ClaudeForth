D6F2 8E005B           (    forth6809.asm):04053         FORTHW:     LDX   #WLHEADS
D6F5 20EB             (    forth6809.asm):04054                     BRA   SETTOP
                      (    forth6809.asm):04055         
                      (    forth6809.asm):04056         ; ------------------------------------------------------------
                      (    forth6809.asm):04057         ; ROOT  ( -- )

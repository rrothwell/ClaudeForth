                      (    forth6809.asm):13625         ; TSTUNESCAPE - unit test for UNESCAPE. Source "A%B" (3 chars,
                      (    forth6809.asm):13626         ; one '%' in the middle) doubles the '%' to produce "A%%B" (4
                      (    forth6809.asm):13627         ; chars) - confirmed via its own code and a prior session's
                      (    forth6809.asm):13628         ; already-corrected design comment that this is genuinely a
                      (    forth6809.asm):13629         ; doubling operation, not backslash-sequence decoding. Verifies
                      (    forth6809.asm):13630         ; every output character individually and the grown length,
                      (    forth6809.asm):13631         ; not just that some output was produced.
                      (    forth6809.asm):13632         ; ------------------------------------------------------------
C2B1                  (    forth6809.asm):13633         TSTUNESCAPE: LDA  #'A'
                      (    forth6809.asm):13634                      STA  TSTCBUF
                      (    forth6809.asm):13635                      LDA  #'%'
                      (    forth6809.asm):13636                      STA  TSTCBUF+1
                      (    forth6809.asm):13637                      LDA  #'B'
                      (    forth6809.asm):13638                      STA  TSTCBUF+2
                      (    forth6809.asm):13639         
                      (    forth6809.asm):13640                      STU  TSTU0
                      (    forth6809.asm):13641         
                      (    forth6809.asm):13642                      LDD  #TSTGUARD
                      (    forth6809.asm):13643                      PSHU D
                      (    forth6809.asm):13644                      LDD  #TSTCBUF
                      (    forth6809.asm):13645                      PSHU D
                      (    forth6809.asm):13646                      LDD  #3
                      (    forth6809.asm):13647                      PSHU D
                      (    forth6809.asm):13648                      LDD  #TSTCBUF+10
                      (    forth6809.asm):13649                      PSHU D
                      (    forth6809.asm):13650                      STU  TSTUB4
                      (    forth6809.asm):13651         
                      (    forth6809.asm):13652                      JSR  UNESCAPEW
                      (    forth6809.asm):13653         
                      (    forth6809.asm):13654                      STU  TSTUAF
                      (    forth6809.asm):13655         
                      (    forth6809.asm):13656                      PULU D
                      (    forth6809.asm):13657                      CMPD #4
                      (    forth6809.asm):13658                      BNE  UXFAIL
                      (    forth6809.asm):13659                      PULU D
                      (    forth6809.asm):13660                      CMPD #TSTCBUF+10
                      (    forth6809.asm):13661                      BNE  UXFAIL
                      (    forth6809.asm):13662         
                      (    forth6809.asm):13663                      TFR  D,X
                      (    forth6809.asm):13664                      LDA  ,X
                      (    forth6809.asm):13665                      CMPA #'A'
                      (    forth6809.asm):13666                      BNE  UXFAIL
                      (    forth6809.asm):13667                      LDA  1,X
                      (    forth6809.asm):13668                      CMPA #'%'
                      (    forth6809.asm):13669                      BNE  UXFAIL
                      (    forth6809.asm):13670                      LDA  2,X
                      (    forth6809.asm):13671                      CMPA #'%'
                      (    forth6809.asm):13672                      BNE  UXFAIL
                      (    forth6809.asm):13673                      LDA  3,X
                      (    forth6809.asm):13674                      CMPA #'B'
                      (    forth6809.asm):13675                      BNE  UXFAIL
                      (    forth6809.asm):13676         
                      (    forth6809.asm):13677                      PULU D
                      (    forth6809.asm):13678                      CMPD #TSTGUARD
                      (    forth6809.asm):13679                      BNE  UXFAIL
                      (    forth6809.asm):13680         
                      (    forth6809.asm):13681                      LDD  TSTUB4
                      (    forth6809.asm):13682                      SUBD TSTUAF
                      (    forth6809.asm):13683                      CMPD #-2
                      (    forth6809.asm):13684                      BNE  UXFAIL
                      (    forth6809.asm):13685         
                      (    forth6809.asm):13686                      LDD  #TRUEV
                      (    forth6809.asm):13687                      BRA  UXDONE
C2B1                  (    forth6809.asm):13688         UXFAIL:      LDD  #FALSEV
C2B1                  (    forth6809.asm):13689         UXDONE:      LDX  #TSTUENAME
                      (    forth6809.asm):13690                      PSHU X
                      (    forth6809.asm):13691                      PSHU D
                      (    forth6809.asm):13692                      JSR  TSTREPORT
                      (    forth6809.asm):13693         
                      (    forth6809.asm):13694                      LDU  TSTU0
                      (    forth6809.asm):13695                      RTS
                      (    forth6809.asm):13696         
C2B1                  (    forth6809.asm):13697         TSTUENAME: FCB  11
                      (    forth6809.asm):13698                    FCC  "TSTUNESCAPE"
                      (    forth6809.asm):13699         
                      (    forth6809.asm):13700                    ENDC ; <<<<
                      (    forth6809.asm):13701         
                      (    forth6809.asm):13702         ; ------------------------------------------------------------
                      (    forth6809.asm):13703         ; TSTNUMOUT - numeric output tests (glossary section 3.13, 14
                      (    forth6809.asm):13704         ; words, 13 tests since #S and #> are combined into one test,
                      (    forth6809.asm):13705         ; matching how they're naturally used together as the tail of
                      (    forth6809.asm):13706         ; the standard pictured-output idiom "<# ... #S #>").
                      (    forth6809.asm):13707         ;
                      (    forth6809.asm):13708         ; The pictured-numeric-output core (<# # #S #> HOLD HOLDS) is
                      (    forth6809.asm):13709         ; pure string-building with no I/O, tested directly. SIGN
                      (    forth6809.asm):13710         ; carries real bug-fix history - a prior bare BPL right after
                      (    forth6809.asm):13711         ; PULU didn't affect condition codes on real 6809 hardware, and
                      (    forth6809.asm):13712         ; the bug was masked for every internal caller by caller-side
                      (    forth6809.asm):13713         ; luck (each ran a flag-setting LDD right before calling SIGN).
                      (    forth6809.asm):13714         ; This section's own SIGN test deliberately poisons the flags
                      (    forth6809.asm):13715         ; with an unrelated CMPX immediately before each direct call,
                      (    forth6809.asm):13716         ; so it exercises the exact previously-broken scenario rather
                      (    forth6809.asm):13717         ; than repeating the same kind of luck that hid the bug.
                      (    forth6809.asm):13718         ;
                      (    forth6809.asm):13719         ; The high-level printing words (./U./.R/U.R/?/D./D.R) all
                      (    forth6809.asm):13720         ; produce real output via TYPE/EMIT internally, so each applies
                      (    forth6809.asm):13721         ; the SERIALPOLL-conditional split established in section 3.1 -
                      (    forth6809.asm):13722         ; full OUTHEAD/OUTBUF verification under SERIALPOLL=0, an
                      (    forth6809.asm):13723         ; EMITCH-based last-character check under SERIALPOLL=1. .R/U.R/
                      (    forth6809.asm):13724         ; D.R specifically test the padding path (a width wider than the
                      (    forth6809.asm):13725         ; actual digits), not just a no-padding sanity case. D./D.R use
                      (    forth6809.asm):13726         ; a genuine double-cell value (-100000, computed and verified
                      (    forth6809.asm):13727         ; independently in Python before writing the tests) to exercise
                      (    forth6809.asm):13728         ; the 32-bit negation path, not a value that happens to fit in
                      (    forth6809.asm):13729         ; one cell.
                      (    forth6809.asm):13730         ;
                      (    forth6809.asm):13731         ; Note: this section's own COMPARE-adjacent naming risk doesn't
                      (    forth6809.asm):13732         ; apply here, but every group wrapper name (TSTNUMOUT) and every
                      (    forth6809.asm):13733         ; internal FAIL/DONE prefix was still checked against the whole
                      (    forth6809.asm):13734         ; file before insertion, per the standard practice that caught
                      (    forth6809.asm):13735         ; the TSTCOMPARE collision in the prior section.
                      (    forth6809.asm):13736         ; ------------------------------------------------------------
C2B1 BDFC2B           (    forth6809.asm):13737         TSTNUMOUT: JSR CRW
C2B4 8EC2C5           (    forth6809.asm):13738                    LDX   #TSTNUMOUTMSG
C2B7 3610             (    forth6809.asm):13739                    PSHU  X
C2B9 CC0006           (    forth6809.asm):13740                    LDD   #6
C2BC 3606             (    forth6809.asm):13741                    PSHU  D
C2BE BDF60B           (    forth6809.asm):13742                    JSR   TYPE
C2C1 BDFC2B           (    forth6809.asm):13743                    JSR   CRW
                      (    forth6809.asm):13744         
                      (    forth6809.asm):13745                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13746         
                      (    forth6809.asm):13747                    JSR   TSTLTNUM
                      (    forth6809.asm):13748                    JSR   TSTHOLD
                      (    forth6809.asm):13749                    JSR   TSTHOLDS
                      (    forth6809.asm):13750                    JSR   TSTSIGN
                      (    forth6809.asm):13751                    JSR   TSTNUMSIGN
                      (    forth6809.asm):13752                    JSR   TSTNUMSIGNSGT
                      (    forth6809.asm):13753                    JSR   TSTDOT
                      (    forth6809.asm):13754                    JSR   TSTUDOT
                      (    forth6809.asm):13755                    JSR   TSTDOTR
                      (    forth6809.asm):13756                    JSR   TSTUDOTR
                      (    forth6809.asm):13757                    JSR   TSTQMARK
                      (    forth6809.asm):13758                    JSR   TSTDDOT
                      (    forth6809.asm):13759                    JSR   TSTDDOTR
                      (    forth6809.asm):13760         
                      (    forth6809.asm):13761                    ENDC ; <<<<
                      (    forth6809.asm):13762         
C2C4 39               (    forth6809.asm):13763                    RTS
                      (    forth6809.asm):13764         
C2C5 4E756D4F7574     (    forth6809.asm):13765         TSTNUMOUTMSG: FCC "NumOut"
                      (    forth6809.asm):13766         
                      (    forth6809.asm):13767                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13768         
                      (    forth6809.asm):13769         ; ------------------------------------------------------------
                      (    forth6809.asm):13770         ; Numeric Output test harness (glossary section 3.13). The
                      (    forth6809.asm):13771         ; pictured-numeric-output core (<# # #S #> HOLD HOLDS SIGN) is
                      (    forth6809.asm):13772         ; pure string-building with no I/O, tested directly. The
                      (    forth6809.asm):13773         ; high-level printing words (./U./.R/U.R/?/D./D.R) all produce
                      (    forth6809.asm):13774         ; real output via TYPE and/or EMIT internally, so per section
                      (    forth6809.asm):13775         ; 3.1's own already-debugged finding, each applies the
                      (    forth6809.asm):13776         ; SERIALPOLL-conditional split established there: full OUTHEAD/
                      (    forth6809.asm):13777         ; OUTBUF verification under SERIALPOLL=0, an EMITCH-based check
                      (    forth6809.asm):13778         ; of the last character under SERIALPOLL=1 - accepted as a
                      (    forth6809.asm):13779         ; known, honest limitation for words ending in a trailing space
                      (    forth6809.asm):13780         ; (./U./D. all print a fixed final space character, so the
                      (    forth6809.asm):13781         ; polling-mode check there confirms less than for the
                      (    forth6809.asm):13782         ; no-trailing-space words, but is still correct and consistent
                      (    forth6809.asm):13783         ; with the same trade-off already established for TSTCR/
                      (    forth6809.asm):13784         ; TSTSPACES/TSTTYPE/TSTDOTQUOTE in earlier sections).
                      (    forth6809.asm):13785         ;
                      (    forth6809.asm):13786         ; SIGN itself carries real bug-fix history: a prior version used
                      (    forth6809.asm):13787         ; a bare BPL immediately after PULU, which doesn't affect
                      (    forth6809.asm):13788         ; condition codes on real 6809 hardware - the bug was masked for
                      (    forth6809.asm):13789         ; every internal caller by "caller-side luck" (each happened to
                      (    forth6809.asm):13790         ; run a flag-setting LDD right before calling SIGN). This
                      (    forth6809.asm):13791         ; section's own SIGN test deliberately poisons the flags with an
                      (    forth6809.asm):13792         ; unrelated, known-positive value immediately before the actual
                      (    forth6809.asm):13793         ; PSHU/JSR SIGN sequence specifically so a standalone call - the
                      (    forth6809.asm):13794         ; exact scenario the bug-fix comment says was previously broken
                      (    forth6809.asm):13795         ; - is what gets tested, not a scenario that happens to work via
                      (    forth6809.asm):13796         ; the same kind of caller-side luck that hid the original bug.
                      (    forth6809.asm):13797         ; ------------------------------------------------------------
                      (    forth6809.asm):13798         
                      (    forth6809.asm):13799         ; ------------------------------------------------------------
                      (    forth6809.asm):13800         ; TSTLTNUM - unit test for <#. No stack effect of its own -
                      (    forth6809.asm):13801         ; verifies it sets HLD to PAD's current (redirected) address.
                      (    forth6809.asm):13802         ; ------------------------------------------------------------
C2CB                  (    forth6809.asm):13803         TSTLTNUM: LDD  CODEHERE
                      (    forth6809.asm):13804                   STD  TSTCSAV
                      (    forth6809.asm):13805         
                      (    forth6809.asm):13806                   LDD  #TSTCBUF
                      (    forth6809.asm):13807                   STD  CODEHERE
                      (    forth6809.asm):13808         
                      (    forth6809.asm):13809                   STU  TSTU0
                      (    forth6809.asm):13810         
                      (    forth6809.asm):13811                   LDD  #TSTGUARD
                      (    forth6809.asm):13812                   PSHU D
                      (    forth6809.asm):13813                   STU  TSTUB4
                      (    forth6809.asm):13814         
                      (    forth6809.asm):13815                   JSR  LTNUM
                      (    forth6809.asm):13816         
                      (    forth6809.asm):13817                   STU  TSTUAF
                      (    forth6809.asm):13818         
                      (    forth6809.asm):13819                   LDD  HLD
                      (    forth6809.asm):13820                   CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):13821                   BNE  LNFAIL
                      (    forth6809.asm):13822         
                      (    forth6809.asm):13823                   PULU D
                      (    forth6809.asm):13824                   CMPD #TSTGUARD
                      (    forth6809.asm):13825                   BNE  LNFAIL
                      (    forth6809.asm):13826         
                      (    forth6809.asm):13827                   LDD  TSTUB4
                      (    forth6809.asm):13828                   SUBD TSTUAF
                      (    forth6809.asm):13829                   CMPD #0
                      (    forth6809.asm):13830                   BNE  LNFAIL
                      (    forth6809.asm):13831         
                      (    forth6809.asm):13832                   LDD  #TRUEV
                      (    forth6809.asm):13833                   BRA  LNDONE
C2CB                  (    forth6809.asm):13834         LNFAIL:   LDD  #FALSEV
C2CB                  (    forth6809.asm):13835         LNDONE:   LDX  #TSTLNNAME
                      (    forth6809.asm):13836                   PSHU X
                      (    forth6809.asm):13837                   PSHU D
                      (    forth6809.asm):13838                   JSR  TSTREPORT
                      (    forth6809.asm):13839         
                      (    forth6809.asm):13840                   LDD  TSTCSAV
                      (    forth6809.asm):13841                   STD  CODEHERE
                      (    forth6809.asm):13842         
                      (    forth6809.asm):13843                   LDU  TSTU0
                      (    forth6809.asm):13844                   RTS
                      (    forth6809.asm):13845         
C2CB                  (    forth6809.asm):13846         TSTLNNAME: FCB  8
                      (    forth6809.asm):13847                    FCC  "TSTLTNUM"
                      (    forth6809.asm):13848         
                      (    forth6809.asm):13849         ; ------------------------------------------------------------
                      (    forth6809.asm):13850         ; TSTHOLD - unit test for HOLD. Holds 'A' then 'B' - since HOLD
                      (    forth6809.asm):13851         ; grows the buffer downward and prepends (decrements HLD first,
                      (    forth6809.asm):13852         ; then writes at the new, lower position), the second-held
                      (    forth6809.asm):13853         ; character ends up at the lower address, so reading forward
                      (    forth6809.asm):13854         ; from the final HLD should give "BA", not "AB".
                      (    forth6809.asm):13855         ; ------------------------------------------------------------
C2CB                  (    forth6809.asm):13856         TSTHOLD: LDD  CODEHERE
                      (    forth6809.asm):13857                  STD  TSTCSAV
                      (    forth6809.asm):13858         
                      (    forth6809.asm):13859                  LDD  #TSTCBUF
                      (    forth6809.asm):13860                  STD  CODEHERE
                      (    forth6809.asm):13861         
                      (    forth6809.asm):13862                  STU  TSTU0
                      (    forth6809.asm):13863         
                      (    forth6809.asm):13864                  LDD  #TSTGUARD
                      (    forth6809.asm):13865                  PSHU D
                      (    forth6809.asm):13866                  STU  TSTUB4
                      (    forth6809.asm):13867         
                      (    forth6809.asm):13868                  JSR  LTNUM
                      (    forth6809.asm):13869         
                      (    forth6809.asm):13870                  LDD  #'A'
                      (    forth6809.asm):13871                  PSHU D
                      (    forth6809.asm):13872                  JSR  HOLD
                      (    forth6809.asm):13873         
                      (    forth6809.asm):13874                  LDD  #'B'
                      (    forth6809.asm):13875                  PSHU D
                      (    forth6809.asm):13876                  JSR  HOLD
                      (    forth6809.asm):13877         
                      (    forth6809.asm):13878                  STU  TSTUAF
                      (    forth6809.asm):13879         
                      (    forth6809.asm):13880                  LDX  HLD
                      (    forth6809.asm):13881                  LDA  ,X
                      (    forth6809.asm):13882                  CMPA #'B'
                      (    forth6809.asm):13883                  BNE  HDFAIL
                      (    forth6809.asm):13884                  LDA  1,X
                      (    forth6809.asm):13885                  CMPA #'A'
                      (    forth6809.asm):13886                  BNE  HDFAIL
                      (    forth6809.asm):13887         
                      (    forth6809.asm):13888                  PULU D
                      (    forth6809.asm):13889                  CMPD #TSTGUARD
                      (    forth6809.asm):13890                  BNE  HDFAIL
                      (    forth6809.asm):13891         
                      (    forth6809.asm):13892                  LDD  TSTUB4
                      (    forth6809.asm):13893                  SUBD TSTUAF
                      (    forth6809.asm):13894                  CMPD #0
                      (    forth6809.asm):13895                  BNE  HDFAIL
                      (    forth6809.asm):13896         
                      (    forth6809.asm):13897                  LDD  #TRUEV
                      (    forth6809.asm):13898                  BRA  HDDONE
C2CB                  (    forth6809.asm):13899         HDFAIL:  LDD  #FALSEV
C2CB                  (    forth6809.asm):13900         HDDONE:  LDX  #TSTHDNAME
                      (    forth6809.asm):13901                  PSHU X
                      (    forth6809.asm):13902                  PSHU D
                      (    forth6809.asm):13903                  JSR  TSTREPORT
                      (    forth6809.asm):13904         
                      (    forth6809.asm):13905                  LDD  TSTCSAV
                      (    forth6809.asm):13906                  STD  CODEHERE
                      (    forth6809.asm):13907         
                      (    forth6809.asm):13908                  LDU  TSTU0
                      (    forth6809.asm):13909                  RTS
                      (    forth6809.asm):13910         
C2CB                  (    forth6809.asm):13911         TSTHDNAME: FCB  7
                      (    forth6809.asm):13912                    FCC  "TSTHOLD"
                      (    forth6809.asm):13913         
                      (    forth6809.asm):13914         ; ------------------------------------------------------------
                      (    forth6809.asm):13915         ; TSTHOLDS - unit test for HOLDS. Holds the string "XY" - since
                      (    forth6809.asm):13916         ; HOLDS iterates its source backward (last character first) and
                      (    forth6809.asm):13917         ; HOLD itself prepends, the two behaviors combine to preserve
                      (    forth6809.asm):13918         ; the original forward order in the pictured buffer, matching
                      (    forth6809.asm):13919         ; its own documented "depends on HOLD's exact decrement-by-one
                      (    forth6809.asm):13920         ; behavior".
                      (    forth6809.asm):13921         ; ------------------------------------------------------------
C2CB                  (    forth6809.asm):13922         TSTHOLDS: LDD  CODEHERE
                      (    forth6809.asm):13923                   STD  TSTCSAV
                      (    forth6809.asm):13924         
                      (    forth6809.asm):13925                   LDD  #TSTCBUF
                      (    forth6809.asm):13926                   STD  CODEHERE
                      (    forth6809.asm):13927         
                      (    forth6809.asm):13928                   LDA  #'X'
                      (    forth6809.asm):13929                   STA  TSTNAMEB
                      (    forth6809.asm):13930                   LDA  #'Y'
                      (    forth6809.asm):13931                   STA  TSTNAMEB+1
                      (    forth6809.asm):13932         
                      (    forth6809.asm):13933                   STU  TSTU0
                      (    forth6809.asm):13934         
                      (    forth6809.asm):13935                   LDD  #TSTGUARD
                      (    forth6809.asm):13936                   PSHU D
                      (    forth6809.asm):13937                   STU  TSTUB4
                      (    forth6809.asm):13938         
                      (    forth6809.asm):13939                   JSR  LTNUM
                      (    forth6809.asm):13940         
                      (    forth6809.asm):13941                   LDD  #TSTNAMEB
                      (    forth6809.asm):13942                   PSHU D
                      (    forth6809.asm):13943                   LDD  #2
                      (    forth6809.asm):13944                   PSHU D
                      (    forth6809.asm):13945                   JSR  HOLDS
                      (    forth6809.asm):13946         
                      (    forth6809.asm):13947                   STU  TSTUAF
                      (    forth6809.asm):13948         
                      (    forth6809.asm):13949                   LDX  HLD
                      (    forth6809.asm):13950                   LDA  ,X
                      (    forth6809.asm):13951                   CMPA #'X'
                      (    forth6809.asm):13952                   BNE  HOFAIL
                      (    forth6809.asm):13953                   LDA  1,X
                      (    forth6809.asm):13954                   CMPA #'Y'
                      (    forth6809.asm):13955                   BNE  HOFAIL
                      (    forth6809.asm):13956         
                      (    forth6809.asm):13957                   PULU D
                      (    forth6809.asm):13958                   CMPD #TSTGUARD
                      (    forth6809.asm):13959                   BNE  HOFAIL
                      (    forth6809.asm):13960         
                      (    forth6809.asm):13961                   LDD  TSTUB4
                      (    forth6809.asm):13962                   SUBD TSTUAF
                      (    forth6809.asm):13963                   CMPD #0
                      (    forth6809.asm):13964                   BNE  HOFAIL
                      (    forth6809.asm):13965         
                      (    forth6809.asm):13966                   LDD  #TRUEV
                      (    forth6809.asm):13967                   BRA  HODONE
C2CB                  (    forth6809.asm):13968         HOFAIL:   LDD  #FALSEV
C2CB                  (    forth6809.asm):13969         HODONE:   LDX  #TSTHSNAME
                      (    forth6809.asm):13970                   PSHU X
                      (    forth6809.asm):13971                   PSHU D
                      (    forth6809.asm):13972                   JSR  TSTREPORT
                      (    forth6809.asm):13973         
                      (    forth6809.asm):13974                   LDD  TSTCSAV
                      (    forth6809.asm):13975                   STD  CODEHERE
                      (    forth6809.asm):13976         
                      (    forth6809.asm):13977                   LDU  TSTU0
                      (    forth6809.asm):13978                   RTS
                      (    forth6809.asm):13979         
C2CB                  (    forth6809.asm):13980         TSTHSNAME: FCB  8
                      (    forth6809.asm):13981                    FCC  "TSTHOLDS"
                      (    forth6809.asm):13982         
                      (    forth6809.asm):13983         ; ------------------------------------------------------------
                      (    forth6809.asm):13984         ; TSTSIGN - unit test for SIGN. Deliberately poisons the CPU
                      (    forth6809.asm):13985         ; flags with an unrelated CMPX (setting them to reflect a
                      (    forth6809.asm):13986         ; positive comparison result, without touching D or the value
                      (    forth6809.asm):13987         ; about to be pushed) immediately before each PSHU/JSR SIGN
                      (    forth6809.asm):13988         ; call - specifically so this test exercises the exact scenario
                      (    forth6809.asm):13989         ; the word's own bug-fix comment says was previously broken (a
                      (    forth6809.asm):13990         ; direct, standalone call not preceded by a flag-setting LDD of
                      (    forth6809.asm):13991         ; the true value), rather than relying on the same kind of
                      (    forth6809.asm):13992         ; caller-side luck that hid the original bug. Two sub-cases:
                      (    forth6809.asm):13993         ; negative (with flags poisoned toward positive, confirming the
                      (    forth6809.asm):13994         ; minus sign still gets added - would fail if SIGN reverted to
                      (    forth6809.asm):13995         ; testing stale flags instead of the value it just popped) and
                      (    forth6809.asm):13996         ; positive (with flags poisoned toward negative, confirming no
                      (    forth6809.asm):13997         ; minus sign gets added incorrectly).
                      (    forth6809.asm):13998         ; ------------------------------------------------------------

                      (    forth6809.asm):14014                  LDX  #1
                      (    forth6809.asm):14015                  CMPX #0
                      (    forth6809.asm):14016                  PSHU D
                      (    forth6809.asm):14017                  JSR  SIGN
                      (    forth6809.asm):14018         
                      (    forth6809.asm):14019                  LDX  HLD
                      (    forth6809.asm):14020                  LDA  ,X
                      (    forth6809.asm):14021                  CMPA #'-'

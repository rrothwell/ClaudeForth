E8A3 26FA             (    forth6809.asm):07505                     BNE   FILLOOP
E8A5 3346             (    forth6809.asm):07506         FDONE:      LEAU  6,U               ; drop the three parameters
E8A7 39               (    forth6809.asm):07507                     RTS

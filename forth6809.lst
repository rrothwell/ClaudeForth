                      (    forth6809.asm):06749         ; ------------------------------------------------------------
                      (    forth6809.asm):06750         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06751         ; Compile DOTSTR followed by the string up to the closing quote as a

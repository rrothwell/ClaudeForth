                      (   unit_tests.asm):07031         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (   unit_tests.asm):07032         ; clause. Compiles
                      (   unit_tests.asm):07033         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (   unit_tests.asm):07034         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (   unit_tests.asm):07035         ; with selector=2, matching the second clause. Traced by hand:
                      (   unit_tests.asm):07036         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (   unit_tests.asm):07037         ; runs on a match, consuming the selector; ENDOF compiles an
                      (   unit_tests.asm):07038         ; unconditional branch past the remaining clauses AND patches
                      (   unit_tests.asm):07039         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (   unit_tests.asm):07040         ; patches every pending ENDOF branch to the true end and
                      (   unit_tests.asm):07041         ; compiles a final fallback DROP for the no-match case.

E58F C108             (    forth6809.asm):03499                     CMPB  #8
E591 2724             (    forth6809.asm):03500                     BEQ   ABKSP
E593 C17F             (    forth6809.asm):03501                     CMPB  #127
E595 2720             (    forth6809.asm):03502                     BEQ   ABKSP
                      (    forth6809.asm):03503         
E597 ECC4             (    forth6809.asm):03504                     LDD   ,U
E599 10A342           (    forth6809.asm):03505                     CMPD  2,U
E59C 27E2             (    forth6809.asm):03506                     BEQ   ALOOP
                      (    forth6809.asm):03507         
E59E AE44             (    forth6809.asm):03508                     LDX   4,U
E5A0 308B             (    forth6809.asm):03509                     LEAX  D,X
E5A2 1F20             (    forth6809.asm):03510                     TFR   Y,D
E5A4 E784             (    forth6809.asm):03511                     STB   ,X
E5A6 ECC4             (    forth6809.asm):03512                     LDD   ,U
E5A8 C30001           (    forth6809.asm):03513                     ADDD  #1
E5AB EDC4             (    forth6809.asm):03514                     STD   ,U
                      (    forth6809.asm):03515         
E5AD 1F20             (    forth6809.asm):03516                     TFR   Y,D
E5AF 4F               (    forth6809.asm):03517                     CLRA
E5B0 3606             (    forth6809.asm):03518                     PSHU  D
E5B2 BDE571           (    forth6809.asm):03519                     JSR   EMITW

                      (    forth6809.asm):02259                    LDD   #TSTVAL3
                      (    forth6809.asm):02260                    PSHU  D
                      (    forth6809.asm):02261                    LDD   #2
                      (    forth6809.asm):02262                    PSHU  D
                      (    forth6809.asm):02263                    STU   TSTUB4
                      (    forth6809.asm):02264         
                      (    forth6809.asm):02265                    JSR   ROLL
                      (    forth6809.asm):02266         
                      (    forth6809.asm):02267                    STU   TSTUAF
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269                    PULU  D
                      (    forth6809.asm):02270                    CMPD  #TSTVAL1
                      (    forth6809.asm):02271                    BNE   RLFAIL
                      (    forth6809.asm):02272                    PULU  D
                      (    forth6809.asm):02273                    CMPD  #TSTVAL3
                      (    forth6809.asm):02274                    BNE   RLFAIL
                      (    forth6809.asm):02275                    PULU  D
                      (    forth6809.asm):02276                    CMPD  #TSTVAL2
                      (    forth6809.asm):02277                    BNE   RLFAIL
                      (    forth6809.asm):02278                    PULU  D
                      (    forth6809.asm):02279                    CMPD  #TSTGUARD
                      (    forth6809.asm):02280                    BNE   RLFAIL
                      (    forth6809.asm):02281         
                      (    forth6809.asm):02282                    LDD   TSTUB4
                      (    forth6809.asm):02283                    SUBD  TSTUAF
                      (    forth6809.asm):02284                    CMPD  #-2
                      (    forth6809.asm):02285                    BNE   RLFAIL
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287                    LDD   #TRUEV
                      (    forth6809.asm):02288                    BRA   RLDONE
C195                  (    forth6809.asm):02289         RLFAIL:    LDD   #FALSEV
C195                  (    forth6809.asm):02290         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):02291                    PSHU  X
                      (    forth6809.asm):02292                    PSHU  D
                      (    forth6809.asm):02293                    JSR   TSTREPORT
                      (    forth6809.asm):02294         
                      (    forth6809.asm):02295                    LDU   TSTU0
                      (    forth6809.asm):02296                    RTS
                      (    forth6809.asm):02297         
C195                  (    forth6809.asm):02298         TSTROLLNAME: FCB  7
                      (    forth6809.asm):02299                      FCC  "TSTROLL"

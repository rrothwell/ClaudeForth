                      (    forth6809.asm):01765         
                      (    forth6809.asm):01766         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):01767         ; priming the pump by transmitting a character.
DD9F                  (    forth6809.asm):01768         CHK_INT_PATH:
DD9F 7D017B           (    forth6809.asm):01769                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
DDA2 2619             (    forth6809.asm):01770                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):01771         
                      (    forth6809.asm):01772                                             ; No! Restart.
DDA4 8E01C0           (    forth6809.asm):01773                     LDX   #OUTBUF           ; Pull character from the out buffer.
DDA7 F6017A           (    forth6809.asm):01774                     LDB   OUTTAIL
DDAA A685             (    forth6809.asm):01775                     LDA   B,X
DDAC B7C009           (    forth6809.asm):01776                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):01777         
DDAF 5C               (    forth6809.asm):01778                     INCB                    ; Update the tail pointer
DDB0 C43F             (    forth6809.asm):01779                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
DDB2 F7017A           (    forth6809.asm):01780                     STB   OUTTAIL
                      (    forth6809.asm):01781         
DDB5 86FF             (    forth6809.asm):01782                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
DDB7 B7017B           (    forth6809.asm):01783                     STA   OUTACTIVITY
DDBA BDDD13           (    forth6809.asm):01784                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):01785         

                      (    forth6809.asm):07571         ; SECTION 2: INIT CODE (COLDSTRT / WARM)
                      (    forth6809.asm):07572         ; ============================================================
                      (    forth6809.asm):07573                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):07574         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07575                  ORCC  #$50        ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):07576                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07577                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07578                  CLRA
FFAE 1F8B             (    forth6809.asm):07579                  TFR   A,DP
                      (    forth6809.asm):07580         
FFB0 8E0000           (    forth6809.asm):07581                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07582                  LDB   #0
FFB5 6F80             (    forth6809.asm):07583         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07584                  DECB
FFB8 26FB             (    forth6809.asm):07585                  BNE   CLRGLOB
                      (    forth6809.asm):07586         
FFBA BDDD4A           (    forth6809.asm):07587                  JSR   INITSERIAL
                      (    forth6809.asm):07588         
FFBD 1CAF             (    forth6809.asm):07589                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):07590         
                      (    forth6809.asm):07591                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07592                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07593                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07594                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07595                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07596                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07597                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07598                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07599                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07600                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07601                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07602                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07603                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07604                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07605                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07606                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07607                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07608                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07609                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07610                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07611                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07612                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07613                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07614                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07615                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07616                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07617                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07618                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07619                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07620                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07621                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07622                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07623                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07624                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07625                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07626                                  ; unused vectors).
                      (    forth6809.asm):07627         
                      (    forth6809.asm):07628                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07629                  JSR   TSTRUNNER
                      (    forth6809.asm):07630                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07631                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07632                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07633                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07634                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07635                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07636                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07637                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07638                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07639                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07640                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07641                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07642                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07643                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07644                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07645                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07646                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07647         
FFC2 7EDEE4           (    forth6809.asm):07648                  JMP   COLD
                      (    forth6809.asm):07649         
FFC5 1A50             (    forth6809.asm):07650         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):07651                  CLRA
FFC8 1F8B             (    forth6809.asm):07652                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07653                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07654                  LDS   #RP0
                      (    forth6809.asm):07655         
FFD1 BDDD4A           (    forth6809.asm):07656                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07657                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07658                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07659                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07660                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07661                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07662                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07663                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07664                                         ; reported separately) left either side
                      (    forth6809.asm):07665                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07666                                         ; would previously have inherited it
                      (    forth6809.asm):07667                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07668                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07669                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07670                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07671                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07672                                         ; only once setup is complete.
                      (    forth6809.asm):07673         
FFD4 8EFFE6           (    forth6809.asm):07674                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):07675                  PSHU  X
FFD9 CC0006           (    forth6809.asm):07676                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):07677                  PSHU  D
FFDE BDF635           (    forth6809.asm):07678                  JSR   TYPE
FFE1 1CAF             (    forth6809.asm):07679                  ANDCC #$AF
FFE3 7EDF19           (    forth6809.asm):07680                  JMP   ABORT      ; Enable IRQ & FIRQ
                      (    forth6809.asm):07681         
FFE6 20207761726D     (    forth6809.asm):07682         WARMMSG: FCC   "  warm"
     0006             (    forth6809.asm):07683         WARMMSGL EQU   *-WARMMSG
                      (    forth6809.asm):07684         
     FFEC             (    forth6809.asm):07685         INITEND  EQU   *          ; Verify no collision with vectors, value should match vector ORG
     0048             (    forth6809.asm):07686         INITSIZE EQU   INITEND-INITCODE
                      (    forth6809.asm):07687         
                      (    forth6809.asm):07688         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07689         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):07690         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):07691                  FILL $FF,VECTORS-INITEND
                      (    forth6809.asm):07692         
                      (    forth6809.asm):07693         ; ============================================================
                      (    forth6809.asm):07694         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):07695         ; ============================================================
                      (    forth6809.asm):07696                  ORG   VECTORS       ; VECTORS is $FFF0
FFF0 0000             (    forth6809.asm):07697         VRESV    FDB   $0000
FFF2 DED8             (    forth6809.asm):07698         VSWI3    FDB   SWI3H
FFF4 DED9             (    forth6809.asm):07699         VSWI2    FDB   SWI2H
FFF6 DEDA             (    forth6809.asm):07700         VFIRQ    FDB   FIRQH
FFF8 DE74             (    forth6809.asm):07701         VIRQ     FDB   IRQH
FFFA DEDC             (    forth6809.asm):07702         VSWI     FDB   SWIH
FFFC FFC5             (    forth6809.asm):07703         VNMI     FDB   WARM            ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):07704         VRESET   FDB   COLDSTRT
                      (    forth6809.asm):07705         
     0000             (    forth6809.asm):07706         VECTOREND  EQU   *          ; Verify vectors size, value should match $10.
     0010             (    forth6809.asm):07707         VECTORSIZE EQU   VECTOREND-VECTORS
                      (    forth6809.asm):07708         

                      (    forth6809.asm):01413         
                      (    forth6809.asm):01414                    RTS
                      (    forth6809.asm):01415         
C100                  (    forth6809.asm):01416         TSTSTACKMSG: FCC "Stack"
                      (    forth6809.asm):01417         
                      (    forth6809.asm):01418                    IFEQ TSTSELECTOR-1  ; >>>>

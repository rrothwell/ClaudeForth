EEC1 2A08             (    forth6809.asm):08645                     BPL   SIGNDONE
EEC3 CC002D           (    forth6809.asm):08646                     LDD   #'-'
EEC6 3606             (    forth6809.asm):08647                     PSHU  D
EEC8 BDEE60           (    forth6809.asm):08648                     JSR   HOLDW
EECB 39               (    forth6809.asm):08649         SIGNDONE:   RTS
                      (    forth6809.asm):08650         
                      (    forth6809.asm):08651         ; ------------------------------------------------------------
                      (    forth6809.asm):08652         ; #>  ( xd -- c-addr u )
                      (    forth6809.asm):08653         ; Drop xd and return the pictured numeric output string.
                      (    forth6809.asm):08654         ; ------------------------------------------------------------
EECC 3706             (    forth6809.asm):08655         NUMGTW:     PULU  D                 ; xd high
EECE 3706             (    forth6809.asm):08656                     PULU  D                 ; xd low
EED0 9E1C             (    forth6809.asm):08657                     LDX   HLD
EED2 3610             (    forth6809.asm):08658                     PSHU  X
EED4 BDD124           (    forth6809.asm):08659                     JSR   PADW

EBF1 39               (    forth6809.asm):04881                     RTS
                      (    forth6809.asm):04882         
                      (    forth6809.asm):04883         ; ------------------------------------------------------------
                      (    forth6809.asm):04884         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):04885         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):04886         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):04887         ; back around the transfer.
                      (    forth6809.asm):04888         ; ------------------------------------------------------------

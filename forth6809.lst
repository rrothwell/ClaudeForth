                      (    forth6809.asm):02437         ; ------------------------------------------------------------
                      (    forth6809.asm):02438         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02439         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02440         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02441         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02442         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02443         ; not assumed from the name.
                      (    forth6809.asm):02444         ; ------------------------------------------------------------
C3E4                  (    forth6809.asm):02445         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02446         
                      (    forth6809.asm):02447                    LDD  #TSTGUARD
                      (    forth6809.asm):02448                    PSHU D
                      (    forth6809.asm):02449                    LDD  #TSTVAL1
                      (    forth6809.asm):02450                    PSHU D
                      (    forth6809.asm):02451                    STU  TSTUB4
                      (    forth6809.asm):02452         
                      (    forth6809.asm):02453                    JSR  TOR
                      (    forth6809.asm):02454                    JSR  RFETCH
                      (    forth6809.asm):02455                    JSR  FROMR
                      (    forth6809.asm):02456         
                      (    forth6809.asm):02457                    STU  TSTUAF
                      (    forth6809.asm):02458         
                      (    forth6809.asm):02459                    PULU D
                      (    forth6809.asm):02460                    CMPD #TSTVAL1
                      (    forth6809.asm):02461                    BNE  RFFAIL
                      (    forth6809.asm):02462                    PULU D
                      (    forth6809.asm):02463                    CMPD #TSTVAL1
                      (    forth6809.asm):02464                    BNE  RFFAIL
                      (    forth6809.asm):02465                    PULU D
                      (    forth6809.asm):02466                    CMPD #TSTGUARD
                      (    forth6809.asm):02467                    BNE  RFFAIL
                      (    forth6809.asm):02468         
                      (    forth6809.asm):02469                    LDD  TSTUB4
                      (    forth6809.asm):02470                    SUBD TSTUAF
                      (    forth6809.asm):02471                    CMPD #2
                      (    forth6809.asm):02472                    BNE  RFFAIL
                      (    forth6809.asm):02473         
                      (    forth6809.asm):02474                    LDD  #TRUEV
                      (    forth6809.asm):02475                    BRA  RFDONE
C3E4                  (    forth6809.asm):02476         RFFAIL:    LDD  #FALSEV
C3E4                  (    forth6809.asm):02477         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02478                    PSHU X
                      (    forth6809.asm):02479                    PSHU D
                      (    forth6809.asm):02480                    JSR  TSTREPORT
                      (    forth6809.asm):02481         
                      (    forth6809.asm):02482                    LDU  TSTU0
                      (    forth6809.asm):02483                    RTS
                      (    forth6809.asm):02484         
C3E4                  (    forth6809.asm):02485         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02486                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02487         
                      (    forth6809.asm):02488         ; ------------------------------------------------------------
                      (    forth6809.asm):02489         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02490         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02491         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02492         ; verifying the round trip.
                      (    forth6809.asm):02493         ; ------------------------------------------------------------

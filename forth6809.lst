                      (    forth6809.asm):12702         ; interpreting S" stages the string and returns immediately) and
                      (    forth6809.asm):12703         ; verifies the returned (addr len) content, plus that addr
                      (    forth6809.asm):12704         ; genuinely landed at PAD's current, redirected address.
                      (    forth6809.asm):12705         ; ------------------------------------------------------------

                      (    forth6809.asm):10011                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):10012                                      ; against this system's own SM/REM and
                      (    forth6809.asm):10013                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):10014                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):10015                                      ; dividend's own original sign) after
                      (    forth6809.asm):10016                                      ; dividing absolute values - exactly
                      (    forth6809.asm):10017                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):10018                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):10019                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):10020                                      ; adjustment step (correcting the

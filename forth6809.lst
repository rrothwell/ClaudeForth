                      (    forth6809.asm):02066         ; SERBUFCLR
                      (    forth6809.asm):02067         ;    Inputs:
                      (    forth6809.asm):02068         ;        none
                      (    forth6809.asm):02069         ;    Outputs:
                      (    forth6809.asm):02070         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02071         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02072         ;    Registers: only CC changed.
                      (    forth6809.asm):02073         ; Original comment: shadow SERBUFCLR.0.

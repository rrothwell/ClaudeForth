                      (    forth6809.asm):07836         ; ENVTABLE2
                      (    forth6809.asm):07837         ; Double-cell ENVIRONMENT? entries: name address, name length, low
                      (    forth6809.asm):07838         ; cell, high cell. A zero ends the table.
                      (    forth6809.asm):07839         ; ------------------------------------------------------------

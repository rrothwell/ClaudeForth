                      (    forth6809.asm):08237         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08238         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08239         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08240         ; WARM
                      (    forth6809.asm):08241         ;    Inputs:
                      (    forth6809.asm):08242         ;        NMI
                      (    forth6809.asm):08243         ;    Outputs:
                      (    forth6809.asm):08244         ;        does not return
                      (    forth6809.asm):08245         ;    Registers: all registers initialised.
                      (    forth6809.asm):08246         ; ------------------------------------------------------------

F962 3706             (    forth6809.asm):05935         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F964 DDAB             (    forth6809.asm):05936                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):05937                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):05938                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):05939                                   ; real source length was misread as an
                      (    forth6809.asm):05940                                   ; address, the real source address was never
                      (    forth6809.asm):05941                                   ; popped at all, and the true destination
                      (    forth6809.asm):05942                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):05943                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):05944                                   ; c-addr2 (dest) is on top, popped first.
F966 3706             (    forth6809.asm):05945                    PULU D         ; next: u1 (source length)
F968 DDA9             (    forth6809.asm):05946                    STD  UESRCLEN
F96A 3706             (    forth6809.asm):05947                    PULU D         ; next: c-addr1 (source address)
F96C DDA7             (    forth6809.asm):05948                    STD  UEADDR

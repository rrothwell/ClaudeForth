                      (    forth6809.asm):07440         ; SECTION 20: NUMERIC OUTPUT (pictured + direct)
                      (    forth6809.asm):07441         ; ============================================================
                      (    forth6809.asm):07442         ; ------------------------------------------------------------
                      (    forth6809.asm):07443         ; <#  ( -- )
                      (    forth6809.asm):07444         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):07445         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):07446         ; ------------------------------------------------------------
FA09 BDDFB4           (    forth6809.asm):07447         LTNUMW:     JSR   PADW
FA0C 3706             (    forth6809.asm):07448                     PULU  D
FA0E DD1C             (    forth6809.asm):07449                     STD   HLD
FA10 39               (    forth6809.asm):07450                     RTS
                      (    forth6809.asm):07451         
                      (    forth6809.asm):07452         ; ------------------------------------------------------------
                      (    forth6809.asm):07453         ; HOLD  ( char -- )
                      (    forth6809.asm):07454         ; Add char to the front of the pictured numeric output string.
                      (    forth6809.asm):07455         ; ------------------------------------------------------------
FA11 3706             (    forth6809.asm):07456         HOLDW:      PULU  D                 ; char
FA13 9E1C             (    forth6809.asm):07457                     LDX   HLD

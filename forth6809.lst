                      (    forth6809.asm):03016         ; ------------------------------------------------------------
                      (    forth6809.asm):03017         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03018         ; Look up the counted string in the dictionary, newest first, ignoring
                      (    forth6809.asm):03019         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03020         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03021         ; Holds no scratch cells; see shadow FINDW.1.
                      (    forth6809.asm):03022         ; ------------------------------------------------------------
E3AF 9E04             (    forth6809.asm):03023         FINDW:      LDX   LATEST            ; c-addr stays at ,U until the result
E3B1 8C0000           (    forth6809.asm):03024         FFLOOP:     CMPX  #0                ; (5l: no scratch cells)
E3B4 2751             (    forth6809.asm):03025                     BEQ   NOTFOUND

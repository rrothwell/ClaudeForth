C1D9 8EC1EA           (    forth6809.asm):03958                    LDX   #TSTDARITHMSG
C1DC 3610             (    forth6809.asm):03959                    PSHU  X
C1DE CC000B           (    forth6809.asm):03960                    LDD   #11
C1E1 3606             (    forth6809.asm):03961                    PSHU  D

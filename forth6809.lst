                      (    forth6809.asm):06698                   LDD  TSTLSAV
                      (    forth6809.asm):06699                   STD  LATEST
                      (    forth6809.asm):06700         
                      (    forth6809.asm):06701                   STU  TSTU0
                      (    forth6809.asm):06702         
                      (    forth6809.asm):06703                   LDD  #TSTGUARD

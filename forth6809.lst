                      (    forth6809.asm):03260         ; ============================================================
                      (    forth6809.asm):03261         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03262         ; ============================================================
                      (    forth6809.asm):03263                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03264         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03265         
                      (    forth6809.asm):03266         ; ------------------------------------------------------------
                      (    forth6809.asm):03267         ; KEY  ( -- char )
                      (    forth6809.asm):03268         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03269         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03270         ; ------------------------------------------------------------
E50A                  (    forth6809.asm):03271         KEYW:
                      (    forth6809.asm):03272         
E50A 7D0178           (    forth6809.asm):03273                     TST   RTSSTATE          ; Is throttling?
E50D 2703             (    forth6809.asm):03274                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03275         
                      (    forth6809.asm):03276                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E50F BDDD52           (    forth6809.asm):03277                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03278                                             ; by transmitting all chars.
                      (    forth6809.asm):03279         
E512                  (    forth6809.asm):03280         TRY_READ:
E512 BDDDBF           (    forth6809.asm):03281                     JSR   GETCHAR           ; Is char available in input buffer.
E515 25F3             (    forth6809.asm):03282                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03283                                             ; while still transmitting!
                      (    forth6809.asm):03284         
E517 1F89             (    forth6809.asm):03285                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E519 4F               (    forth6809.asm):03286                     CLRA                    ; Clear MSB.
E51A 3606             (    forth6809.asm):03287                     PSHU  D                 ; char
                      (    forth6809.asm):03288         
E51C 39               (    forth6809.asm):03289                     RTS
                      (    forth6809.asm):03290         
                      (    forth6809.asm):03291         ; ------------------------------------------------------------
                      (    forth6809.asm):03292         ; KEY?  ( -- flag )
                      (    forth6809.asm):03293         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03294         ; ------------------------------------------------------------
E51D                  (    forth6809.asm):03295         KEYQW:
                      (    forth6809.asm):03296                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03297         
E51D B60176           (    forth6809.asm):03298                     LDA   INHEAD            ; Characters received?
E520 B10177           (    forth6809.asm):03299                     CMPA  INTAIL
                      (    forth6809.asm):03300         
                      (    forth6809.asm):03301                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03302         
E523 2606             (    forth6809.asm):03303                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03304         
E525 CC0000           (    forth6809.asm):03305                     LDD   #FALSEV           ; No! Return false result.
E528 3606             (    forth6809.asm):03306                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03307         
E52A 39               (    forth6809.asm):03308                     RTS
                      (    forth6809.asm):03309         
E52B                  (    forth6809.asm):03310         KQTRUE:
E52B CCFFFF           (    forth6809.asm):03311                     LDD   #TRUEV            ; Yes! Return true result.
E52E 3606             (    forth6809.asm):03312                     PSHU  D                 ; flag = true
E530 39               (    forth6809.asm):03313                     RTS
                      (    forth6809.asm):03314         
                      (    forth6809.asm):03315         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03316         
                      (    forth6809.asm):03317         ; ------------------------------------------------------------
                      (    forth6809.asm):03318         ; EMIT  ( char -- )
                      (    forth6809.asm):03319         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03320         ; discarded if the ring is full.
                      (    forth6809.asm):03321         ; ------------------------------------------------------------
E531                  (    forth6809.asm):03322         EMITW:
E531 3706             (    forth6809.asm):03323                     PULU  D                 ; char
E533 1F98             (    forth6809.asm):03324                     TFR   B,A
E535 BDDD74           (    forth6809.asm):03325                     JSR   PUTCHAR           ; Transmit char.
E538 39               (    forth6809.asm):03326                     RTS
                      (    forth6809.asm):03327         
                      (    forth6809.asm):03328                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03329         ; ------------------------------------------------------------
                      (    forth6809.asm):03330         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03331         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03332         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03333         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03334         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03335         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03336         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03337         ; follow.
                      (    forth6809.asm):03338         ; ------------------------------------------------------------
E539                  (    forth6809.asm):03339         KEYW:
                      (    forth6809.asm):03340                     LDA   ACIASR
                      (    forth6809.asm):03341                     BITA  #SR_RDRF
                      (    forth6809.asm):03342                     BEQ   KWAIT
                      (    forth6809.asm):03343                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03344                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E539                  (    forth6809.asm):03345         KWAIT:
E539                  (    forth6809.asm):03346         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03347                     BITA  #SR_RDRF
                      (    forth6809.asm):03348                     BEQ   KSPIN
E539                  (    forth6809.asm):03349         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03350                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03351                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03352                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03353                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03354                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03355                     BEQ   KGETCH
                      (    forth6809.asm):03356                     BITA  #SR_FE
                      (    forth6809.asm):03357                     BEQ   KXFE
                      (    forth6809.asm):03358                     INC   FECOUNT
E539                  (    forth6809.asm):03359         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03360                     BEQ   KXOVRN
                      (    forth6809.asm):03361                     INC   OVRNCOUNT
E539                  (    forth6809.asm):03362         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03363                     BEQ   KGETCH
                      (    forth6809.asm):03364                     INC   PECOUNT
E539                  (    forth6809.asm):03365         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03366                     TFR   A,B
                      (    forth6809.asm):03367                     CLRA
                      (    forth6809.asm):03368                     PSHU  D                 ; char
                      (    forth6809.asm):03369                     RTS
                      (    forth6809.asm):03370         
                      (    forth6809.asm):03371         ; ------------------------------------------------------------
                      (    forth6809.asm):03372         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03373         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03374         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03375         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03376         ;    Inputs:
                      (    forth6809.asm):03377         ;        none
                      (    forth6809.asm):03378         ;    Outputs:
                      (    forth6809.asm):03379         ;        XON or XOFF transmitted
                      (    forth6809.asm):03380         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03381         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03382         ; ------------------------------------------------------------
E539                  (    forth6809.asm):03383         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03384                     BRA   PUTXCH
E539                  (    forth6809.asm):03385         PUTXON:     LDA   #XONCH
E539                  (    forth6809.asm):03386         PUTXCH:     PSHS  A
E539                  (    forth6809.asm):03387         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03388                     BITB  #SR_TDRE
                      (    forth6809.asm):03389                     BEQ   PXWT
                      (    forth6809.asm):03390                     PULS  A
                      (    forth6809.asm):03391                     STA   ACIADR
                      (    forth6809.asm):03392                     RTS
                      (    forth6809.asm):03393         
                      (    forth6809.asm):03394         ; ------------------------------------------------------------
                      (    forth6809.asm):03395         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03396         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03397         ; ------------------------------------------------------------
E539                  (    forth6809.asm):03398         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03399                     BITA  #SR_RDRF
                      (    forth6809.asm):03400                     BEQ   KQFALSE
                      (    forth6809.asm):03401                     LDD   #TRUEV
                      (    forth6809.asm):03402                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03403                     RTS
E539                  (    forth6809.asm):03404         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03405                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03406                     RTS
                      (    forth6809.asm):03407         
                      (    forth6809.asm):03408         ; ------------------------------------------------------------
                      (    forth6809.asm):03409         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03410         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03411         ; ------------------------------------------------------------
E539                  (    forth6809.asm):03412         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03413                     STB   EMITCH
E539                  (    forth6809.asm):03414         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03415                     BITA  #SR_TDRE
                      (    forth6809.asm):03416                     BEQ   EMITWT
                      (    forth6809.asm):03417                     LDA   EMITCH
                      (    forth6809.asm):03418                     STA   ACIADR
                      (    forth6809.asm):03419                     RTS
                      (    forth6809.asm):03420         
                      (    forth6809.asm):03421                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03422         
                      (    forth6809.asm):03423         ; ------------------------------------------------------------
                      (    forth6809.asm):03424         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03425         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03426         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03427         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03428         ; ------------------------------------------------------------
E539 335E             (    forth6809.asm):03429         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E53B CC0000           (    forth6809.asm):03430                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E53E EDC4             (    forth6809.asm):03431                     STD   ,U
                      (    forth6809.asm):03432         
                      (    forth6809.asm):03433                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03434                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03435                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03436                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03437                                             ; stream this line's characters
                      (    forth6809.asm):03438                     JSR   PUTXON
                      (    forth6809.asm):03439                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03440         
E540 BDE50A           (    forth6809.asm):03441         ALOOP:      JSR   KEYW
E543 3706             (    forth6809.asm):03442                     PULU  D
E545 1F02             (    forth6809.asm):03443                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03444         
E547 C10D             (    forth6809.asm):03445                     CMPB  #13
E549 274F             (    forth6809.asm):03446                     BEQ   ADONE
E54B C10A             (    forth6809.asm):03447                     CMPB  #10
E54D 27F1             (    forth6809.asm):03448                     BEQ   ALOOP

                      (    forth6809.asm):02675                    JSR   TSTMIN1
                      (    forth6809.asm):02676                    JSR   TSTMIN2
                      (    forth6809.asm):02677                    JSR   TSTMAX1
                      (    forth6809.asm):02678                    JSR   TSTMAX2
                      (    forth6809.asm):02679                    JSR   TSTONEP

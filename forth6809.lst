                      (    forth6809.asm):02468         
D417 CC000A           (    forth6809.asm):02469                     LDD   #10
D41A DD02             (    forth6809.asm):02470                     STD   BASE
                      (    forth6809.asm):02471         
D41C CC0106           (    forth6809.asm):02472                     LDD   #TIBBUF
D41F DD39             (    forth6809.asm):02473                     STD   SRCADDR
D421 CC0000           (    forth6809.asm):02474                     LDD   #0
D424 DD3B             (    forth6809.asm):02475                     STD   SRCLEN
D426 DD3D             (    forth6809.asm):02476                     STD   SRCID
                      (    forth6809.asm):02477         
D428 8ED4CE           (    forth6809.asm):02478                     LDX   #SIGNON
D42B 3610             (    forth6809.asm):02479                     PSHU  X                 ; c-addr
D42D CC000F           (    forth6809.asm):02480                     LDD   #SIGNONL
D430 3606             (    forth6809.asm):02481                     PSHU  D                 ; u
D432 BDEE24           (    forth6809.asm):02482                     JSR   TYPEW
D435 BDF44D           (    forth6809.asm):02483                     JSR   CRW
D438 2008             (    forth6809.asm):02484                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486         ; ------------------------------------------------------------
                      (    forth6809.asm):02487         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02488         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02489         ; ------------------------------------------------------------
D43A CCFFFF           (    forth6809.asm):02490         ABORTW:     LDD   #-1
D43D 3606             (    forth6809.asm):02491                     PSHU  D                 ; throw code (-1)
D43F 7EDE2F           (    forth6809.asm):02492                     JMP   THROWW
                      (    forth6809.asm):02493         
                      (    forth6809.asm):02494         ; ------------------------------------------------------------
                      (    forth6809.asm):02495         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02496         ; ABORT
                      (    forth6809.asm):02497         ;    Inputs:
                      (    forth6809.asm):02498         ;        none
                      (    forth6809.asm):02499         ;    Outputs:
                      (    forth6809.asm):02500         ;        none (does not return)
                      (    forth6809.asm):02501         ;    Registers: RegU changed.
                      (    forth6809.asm):02502         ; ------------------------------------------------------------
D442 CEBD00           (    forth6809.asm):02503         ABORT:      LDU   #SP0
                      (    forth6809.asm):02504                     ; falls through into QUIT
                      (    forth6809.asm):02505         
                      (    forth6809.asm):02506         ; ------------------------------------------------------------
                      (    forth6809.asm):02507         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02508         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02509         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02510         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02511         ; ------------------------------------------------------------
D445 10CEC000         (    forth6809.asm):02512         QUITW:      LDS   #RP0
D449 CC0000           (    forth6809.asm):02513                     LDD   #0
D44C DD00             (    forth6809.asm):02514                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02515         
D44E BDDDDA           (    forth6809.asm):02516         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02517         
D451 DC06             (    forth6809.asm):02518                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
D453 3406             (    forth6809.asm):02519                     PSHS  D                 ; and THROW restore S, so the frame is
D455 DC08             (    forth6809.asm):02520                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
D457 3406             (    forth6809.asm):02521                     PSHS  D                 ; See shadow QLOOP.2
D459 DC0A             (    forth6809.asm):02522                     LDD   VARHERE
D45B 3406             (    forth6809.asm):02523                     PSHS  D
D45D DC04             (    forth6809.asm):02524                     LDD   LATEST
D45F 3406             (    forth6809.asm):02525                     PSHS  D
                      (    forth6809.asm):02526         
D461 CCD8A7           (    forth6809.asm):02527                     LDD   #INTERPRET
D464 3606             (    forth6809.asm):02528                     PSHU  D                 ; xt
D466 BDDE03           (    forth6809.asm):02529                     JSR   CATCHW
D469 3706             (    forth6809.asm):02530                     PULU  D                 ; throw code (0 = no error)
D46B 3406             (    forth6809.asm):02531                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
D46D 10830000         (    forth6809.asm):02532                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
D471 2743             (    forth6809.asm):02533                     BEQ   QOK
                      (    forth6809.asm):02534         
D473 EC68             (    forth6809.asm):02535                     LDD   8,S
D475 DD06             (    forth6809.asm):02536                     STD   DPHERE
D477 BDDA9E           (    forth6809.asm):02537                     JSR   PRUNE             ; unlink headers newer than DPHERE
D47A EC66             (    forth6809.asm):02538                     LDD   6,S
D47C DD08             (    forth6809.asm):02539                     STD   CODEHERE
D47E EC64             (    forth6809.asm):02540                     LDD   4,S
D480 DD0A             (    forth6809.asm):02541                     STD   VARHERE
D482 EC62             (    forth6809.asm):02542                     LDD   2,S
D484 DD04             (    forth6809.asm):02543                     STD   LATEST
D486 CEBD00           (    forth6809.asm):02544                     LDU   #SP0
                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02547                     ; See bugfix: QLOOP.1
D489 CC0000           (    forth6809.asm):02548                     LDD   #0
D48C DD00             (    forth6809.asm):02549                     STD   STATE
                      (    forth6809.asm):02550         
D48E ECE4             (    forth6809.asm):02551                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
D490 1083FFFF         (    forth6809.asm):02552                     CMPD  #-1
D494 2605             (    forth6809.asm):02553                     BNE   QSHOWERR

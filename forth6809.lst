                      (    forth6809.asm):07766                    JSR   TSTVAR
                      (    forth6809.asm):07767                    JSR   TSTCONST
                      (    forth6809.asm):07768                    JSR   TSTCOLON
                      (    forth6809.asm):07769                    JSR   TSTCRDOES
                      (    forth6809.asm):07770                    JSR   TST2VAR
                      (    forth6809.asm):07771                    JSR   TST2CONST
                      (    forth6809.asm):07772                    JSR   TSTBUFC
                      (    forth6809.asm):07773                    JSR   TSTVALTO
                      (    forth6809.asm):07774                    JSR   TSTDEFER1
                      (    forth6809.asm):07775                    JSR   TSTDEFER2
                      (    forth6809.asm):07776                    JSR   TSTISOF

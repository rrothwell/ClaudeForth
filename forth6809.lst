D432 BDDE2C           (    forth6809.asm):03544                     JSR   CCALL
D435 20DC             (    forth6809.asm):03545                     BRA   ILOOP
                      (    forth6809.asm):03546         
D437 BDD0C9           (    forth6809.asm):03547         DOEXEC:     JSR   EXECUTEW
D43A 20D7             (    forth6809.asm):03548                     BRA   ILOOP
                      (    forth6809.asm):03549         
D43C BDD824           (    forth6809.asm):03550         TRYNUM:     JSR   NUMBERQ
D43F 3706             (    forth6809.asm):03551                     PULU  D
D441 10830000         (    forth6809.asm):03552                     CMPD  #0                ; flag (PULU does not set CC)
D445 273B             (    forth6809.asm):03553                     BEQ   BADWORD
                      (    forth6809.asm):03554         
D447 10830001         (    forth6809.asm):03555                     CMPD  #1                ; 1 = double-number result
D44B 2711             (    forth6809.asm):03556                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03557         
D44D DC00             (    forth6809.asm):03558                     LDD   STATE
D44F 27C2             (    forth6809.asm):03559                     BEQ   ILOOP
D451 CCD044           (    forth6809.asm):03560                     LDD   #LIT
D454 3606             (    forth6809.asm):03561                     PSHU  D
D456 BDDE2C           (    forth6809.asm):03562                     JSR   CCALL
D459 BDD0EA           (    forth6809.asm):03563                     JSR   CODECOMMA
D45C 20B5             (    forth6809.asm):03564                     BRA   ILOOP
                      (    forth6809.asm):03565         
D45E                  (    forth6809.asm):03566         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03567                                             ; ANS's (ud1) stack order directly.
D45E DC00             (    forth6809.asm):03568                     LDD   STATE
D460 27B1             (    forth6809.asm):03569                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03570                                             ; nothing more to do
                      (    forth6809.asm):03571                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03572                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03573                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03574                     ; pop it aside first, freeing UDLO to be compiled first.
D462 3706             (    forth6809.asm):03575                     PULU  D
D464 DD1A             (    forth6809.asm):03576                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03577                                             ; untouched by CCALL/CODECOMMA
D466 CCD044           (    forth6809.asm):03578                     LDD   #LIT
D469 3606             (    forth6809.asm):03579                     PSHU  D
D46B BDDE2C           (    forth6809.asm):03580                     JSR   CCALL
D46E BDD0EA           (    forth6809.asm):03581                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
D471 CCD044           (    forth6809.asm):03582                     LDD   #LIT
D474 3606             (    forth6809.asm):03583                     PSHU  D
D476 BDDE2C           (    forth6809.asm):03584                     JSR   CCALL
D479 DC1A             (    forth6809.asm):03585                     LDD   MSCR4
D47B 3606             (    forth6809.asm):03586                     PSHU  D
D47D BDD0EA           (    forth6809.asm):03587                     JSR   CODECOMMA         ; compiles UDHI
D480 2091             (    forth6809.asm):03588                     BRA   ILOOP
                      (    forth6809.asm):03589         

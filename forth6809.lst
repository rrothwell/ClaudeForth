                      (    forth6809.asm):03963                    JSR   TSTUMSZ
                      (    forth6809.asm):03964                    JSR   TSTMSTAR
                      (    forth6809.asm):03965                    JSR   TSTFMSM
                      (    forth6809.asm):03966                    JSR   TSTFMSZ
                      (    forth6809.asm):03967                    JSR   TSTSMRM
                      (    forth6809.asm):03968                    JSR   TSTSMRZ
                      (    forth6809.asm):03969                    JSR   TSTDPLUS
                      (    forth6809.asm):03970                    JSR   TSTDMIN2
                      (    forth6809.asm):03971                    JSR   TSTDNEG
                      (    forth6809.asm):03972                    JSR   TSTDABS1
                      (    forth6809.asm):03973                    JSR   TSTDABS2
                      (    forth6809.asm):03974                    JSR   TSTMPLUS
                      (    forth6809.asm):03975                    JSR   TSTSTOD
                      (    forth6809.asm):03976                    JSR   TSTDTOS
                      (    forth6809.asm):03977                    JSR   TSTDMAX
                      (    forth6809.asm):03978                    JSR   TSTDMIN
                      (    forth6809.asm):03979         
                      (    forth6809.asm):03980                    ENDC ; <<<<

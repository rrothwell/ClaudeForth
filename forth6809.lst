                      (    forth6809.asm):08014         ; ------------------------------------------------------------
FE89 CC0001           (    forth6809.asm):08015         POSONEW:    LDD   #1
FE8C 3606             (    forth6809.asm):08016                     PSHU  D
FE8E 39               (    forth6809.asm):08017                     RTS

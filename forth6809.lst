                      (    forth6809.asm):12914         ; TSTSCOMPARE - unit test for COMPARE. Four sequential sub-cases
                      (    forth6809.asm):12915         ; within one test body, each popping and verifying its own
                      (    forth6809.asm):12916         ; result immediately: less-than, equal, greater-than, and the
                      (    forth6809.asm):12917         ; prefix tie-break case specifically (a shorter string that's a
                      (    forth6809.asm):12918         ; true prefix of a longer one compares less, per the standard
                      (    forth6809.asm):12919         ; three-way convention) - not just LT/EQ/GT on same-length
                      (    forth6809.asm):12920         ; strings, which alone wouldn't exercise the tie-break path at
                      (    forth6809.asm):12921         ; all.
                      (    forth6809.asm):12922         ; ------------------------------------------------------------

                      (    forth6809.asm):02143         
                      (    forth6809.asm):02144         ; ------------------------------------------------------------
                      (    forth6809.asm):02145         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02146         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02147         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02148         ; CHKLO
                      (    forth6809.asm):02149         ;    Inputs:
                      (    forth6809.asm):02150         ;        RegB = input ring fill level
                      (    forth6809.asm):02151         ;    Outputs:

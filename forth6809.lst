                      (    forth6809.asm):01195                   SUBD TSTUAF
                      (    forth6809.asm):01196                   CMPD #0
                      (    forth6809.asm):01197                   BNE  SCFAIL
                      (    forth6809.asm):01198         
                      (    forth6809.asm):01199                   LDD  #TRUEV
                      (    forth6809.asm):01200                   BRA  SCDONE
C185                  (    forth6809.asm):01201         SCFAIL:   LDD  #FALSEV
C185                  (    forth6809.asm):01202         SCDONE:  LDX  #TSTSPACENAME

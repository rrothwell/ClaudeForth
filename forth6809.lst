                      (    forth6809.asm):09382         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09383         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09384         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09385         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09386         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09387         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09388         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09389         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09390         ; available the skip ends.
                      (    forth6809.asm):09391         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09392         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09393         ; ------------------------------------------------------------
F2F4 3706             (    forth6809.asm):09394         BRIFW:      PULU  D
F2F6 10830000         (    forth6809.asm):09395                     CMPD  #0
F2FA 266D             (    forth6809.asm):09396                     BNE   BRTHENW           ; true: nothing to skip
F2FC CC0001           (    forth6809.asm):09397         BRELSEW:    LDD   #1
F2FF 3406             (    forth6809.asm):09398                     PSHS  D                 ; level
F301 BDE99D           (    forth6809.asm):09399         BRNEXT:     JSR   PARSENAMEW
F304 3706             (    forth6809.asm):09400                     PULU  D                 ; length
F306 3710             (    forth6809.asm):09401                     PULU  X                 ; address
F308 10830000         (    forth6809.asm):09402                     CMPD  #0
F30C 274E             (    forth6809.asm):09403                     BEQ   BRREFILL
F30E 10830004         (    forth6809.asm):09404                     CMPD  #4
F312 2734             (    forth6809.asm):09405                     BEQ   BR4
F314 10830006         (    forth6809.asm):09406                     CMPD  #6
F318 26E7             (    forth6809.asm):09407                     BNE   BRNEXT
F31A C606             (    forth6809.asm):09408                     LDB   #6
F31C 108EF378         (    forth6809.asm):09409                     LDY   #BRSELSE
F320 3410             (    forth6809.asm):09410                     PSHS  X
F322 BDF36A           (    forth6809.asm):09411                     JSR   BRCMP

                      (    forth6809.asm):03921                    JSR   TSTFMSZ
                      (    forth6809.asm):03922                    JSR   TSTSMRM
                      (    forth6809.asm):03923                    JSR   TSTSMRZ
                      (    forth6809.asm):03924                    JSR   TSTDPLUS
                      (    forth6809.asm):03925                    JSR   TSTDMIN2
                      (    forth6809.asm):03926                    JSR   TSTDNEG
                      (    forth6809.asm):03927                    JSR   TSTDABS1
                      (    forth6809.asm):03928                    JSR   TSTDABS2
                      (    forth6809.asm):03929                    JSR   TSTMPLUS

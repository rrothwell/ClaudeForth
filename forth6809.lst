                      (    forth6809.asm):07912         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):07913         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):07914         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):07915         ; WARM
                      (    forth6809.asm):07916         ;    Inputs:
                      (    forth6809.asm):07917         ;        NMI
                      (    forth6809.asm):07918         ;    Outputs:
                      (    forth6809.asm):07919         ;        does not return
                      (    forth6809.asm):07920         ;    Registers: all registers initialised.
                      (    forth6809.asm):07921         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):07922         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):07923                     CLRA
FFC8 1F8B             (    forth6809.asm):07924                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07925                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07926                     LDS   #RP0
                      (    forth6809.asm):07927         
FFD1 BDDCE3           (    forth6809.asm):07928                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):07929         
FFD4 8EFFE6           (    forth6809.asm):07930                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):07931                     PSHU  X
FFD9 CC0006           (    forth6809.asm):07932                     LDD   #WARMMSGL

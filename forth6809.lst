                      (    forth6809.asm):05163         ; /  ( n1 n2 -- n3 )
                      (    forth6809.asm):05164         ; Quotient of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05165         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05166         ; zero.
                      (    forth6809.asm):05167         ; ------------------------------------------------------------

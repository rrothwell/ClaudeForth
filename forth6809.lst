                      (    forth6809.asm):07423         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (    forth6809.asm):07424         ; clause. Compiles
                      (    forth6809.asm):07425         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (    forth6809.asm):07426         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (    forth6809.asm):07427         ; with selector=2, matching the second clause. Traced by hand:
                      (    forth6809.asm):07428         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (    forth6809.asm):07429         ; runs on a match, consuming the selector; ENDOF compiles an
                      (    forth6809.asm):07430         ; unconditional branch past the remaining clauses AND patches
                      (    forth6809.asm):07431         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (    forth6809.asm):07432         ; patches every pending ENDOF branch to the true end and
                      (    forth6809.asm):07433         ; compiles a final fallback DROP for the no-match case.
                      (    forth6809.asm):07434         ; ------------------------------------------------------------

                      (    forth6809.asm):02897         ; NONAME (":NONAME", CORE EXT): like COLON, but deliberately skips
                      (    forth6809.asm):02898         ; HEADER entirely - no WORD call (consumes no name from the input),
                      (    forth6809.asm):02899         ; no new header written at DPHERE, and LATEST is left completely
                      (    forth6809.asm):02900         ; untouched. That's the ANS-required "no-name" definition: never
                      (    forth6809.asm):02901         ; findable by FIND, never linked into the dictionary chain at all.
                      (    forth6809.asm):02902         ; In this subroutine-threaded system the execution token IS the code
                      (    forth6809.asm):02903         ; address (no separate CFA indirection, unlike CREATE's DODOES
                      (    forth6809.asm):02904         ; trampoline), so the xt ANS requires :NONAME to leave on the stack
                      (    forth6809.asm):02905         ; is simply CODEHERE at this instant - identical to what HEREW
                      (    forth6809.asm):02906         ; returns - pushed BEFORE compilation of the body begins, matching
                      (    forth6809.asm):02907         ; where ANS says :NONAME produces it. CSP is snapshotted AFTER that
                      (    forth6809.asm):02908         ; push (mirroring COLON's own CSP snapshot, taken after HEADER's
                      (    forth6809.asm):02909         ; transient pushes/pops have already netted back to baseline) so
                      (    forth6809.asm):02910         ; SEMI's control-flow consistency check at ";" only catches a
                      (    forth6809.asm):02911         ; genuinely unbalanced IF/DO etc. left over from the body, not the
                      (    forth6809.asm):02912         ; xt itself, which is meant to still be there when ";" returns.
                      (    forth6809.asm):02913         ; SEMI itself needs no changes: its unsmudge-the-word-at-LATEST step
                      (    forth6809.asm):02914         ; still targets whatever LATEST already was (the previous NAMED
                      (    forth6809.asm):02915         ; word, untouched by this routine) - a harmless no-op there, since a
                      (    forth6809.asm):02916         ; normal definition is already unsmudged by the time any later
                      (    forth6809.asm):02917         ; definition's SEMI runs.
DF9C DC08             (    forth6809.asm):02918         NONAME:  LDD   CODEHERE
DF9E 3606             (    forth6809.asm):02919                  PSHU  D
DFA0 1F30             (    forth6809.asm):02920                  TFR   U,D
DFA2 DD48             (    forth6809.asm):02921                  STD   CSP
DFA4 CCFFFF           (    forth6809.asm):02922                  LDD   #-1
DFA7 DD00             (    forth6809.asm):02923                  STD   STATE
DFA9 39               (    forth6809.asm):02924                  RTS
                      (    forth6809.asm):02925         
DFAA CC0000           (    forth6809.asm):02926         CREATE:  LDD   #0
DFAD 3606             (    forth6809.asm):02927                  PSHU  D
DFAF BDDF27           (    forth6809.asm):02928                  JSR   HEADER
DFB2 CCDE61           (    forth6809.asm):02929                  LDD   #DODOES
DFB5 3606             (    forth6809.asm):02930                  PSHU  D
DFB7 BDE9EE           (    forth6809.asm):02931                  JSR   CCALL
DFBA CCDE6C           (    forth6809.asm):02932                  LDD   #DOESRT0
DFBD 3606             (    forth6809.asm):02933                  PSHU  D
DFBF BDDED5           (    forth6809.asm):02934                  JSR   CODECOMMA
DFC2 DC08             (    forth6809.asm):02935                  LDD   CODEHERE  ; BUG FIX: same self-referential PFA bug as
DFC4 C30002           (    forth6809.asm):02936                  ADDD  #2        ; CONSTANT/DEFER/2CONSTANT/MARKER (CONSTANT's
DFC7 3606             (    forth6809.asm):02937                  PSHU  D         ; instance confirmed via MAME debugger) -
DFC9 BDDED5           (    forth6809.asm):02938                  JSR   CODECOMMA ; without +2 this pointed at itself instead
                      (    forth6809.asm):02939                                   ; of the value cell that "," appends next.
                      (    forth6809.asm):02940                                   ; Never on the previously-flagged list (only
                      (    forth6809.asm):02941                                   ; DEFER/2CONSTANT/MARKER were), so it went
                      (    forth6809.asm):02942                                   ; unfixed until confirmed by inspection here.
                      (    forth6809.asm):02943                                   ; Confirmed via MAME: ": ENUM CREATE , DOES>
                      (    forth6809.asm):02944                                   ; @ ;" returned the PFA-pointer field's own
                      (    forth6809.asm):02945                                   ; address instead of the value COMMA stored
                      (    forth6809.asm):02946                                   ; one cell further on - exactly "the address
                      (    forth6809.asm):02947                                   ; before the 16-bit constant" instead of the
                      (    forth6809.asm):02948                                   ; address 1 cell further on, matching a
                      (    forth6809.asm):02949                                   ; user-reported MAME trace precisely.
DFCC 39               (    forth6809.asm):02950                  RTS
                      (    forth6809.asm):02951         

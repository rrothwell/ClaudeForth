                      (    forth6809.asm):02484         ; ------------------------------------------------------------
                      (    forth6809.asm):02485         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02486         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02487         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02488         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02489         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02490         ; not assumed from the name.
                      (    forth6809.asm):02491         ; ------------------------------------------------------------
C1B1                  (    forth6809.asm):02492         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02493         
                      (    forth6809.asm):02494                    LDD  #TSTGUARD
                      (    forth6809.asm):02495                    PSHU D
                      (    forth6809.asm):02496                    LDD  #TSTVAL1
                      (    forth6809.asm):02497                    PSHU D
                      (    forth6809.asm):02498                    STU  TSTUB4
                      (    forth6809.asm):02499         
                      (    forth6809.asm):02500                    JSR  TOR
                      (    forth6809.asm):02501                    JSR  RFETCH
                      (    forth6809.asm):02502                    JSR  FROMR
                      (    forth6809.asm):02503         
                      (    forth6809.asm):02504                    STU  TSTUAF
                      (    forth6809.asm):02505         
                      (    forth6809.asm):02506                    PULU D
                      (    forth6809.asm):02507                    CMPD #TSTVAL1
                      (    forth6809.asm):02508                    BNE  RFFAIL
                      (    forth6809.asm):02509                    PULU D
                      (    forth6809.asm):02510                    CMPD #TSTVAL1
                      (    forth6809.asm):02511                    BNE  RFFAIL
                      (    forth6809.asm):02512                    PULU D
                      (    forth6809.asm):02513                    CMPD #TSTGUARD
                      (    forth6809.asm):02514                    BNE  RFFAIL
                      (    forth6809.asm):02515         
                      (    forth6809.asm):02516                    LDD  TSTUB4
                      (    forth6809.asm):02517                    SUBD TSTUAF
                      (    forth6809.asm):02518                    CMPD #2
                      (    forth6809.asm):02519                    BNE  RFFAIL
                      (    forth6809.asm):02520         
                      (    forth6809.asm):02521                    LDD  #TRUEV
                      (    forth6809.asm):02522                    BRA  RFDONE
C1B1                  (    forth6809.asm):02523         RFFAIL:    LDD  #FALSEV
C1B1                  (    forth6809.asm):02524         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02525                    PSHU X
                      (    forth6809.asm):02526                    PSHU D
                      (    forth6809.asm):02527                    JSR  TSTREPORT
                      (    forth6809.asm):02528         
                      (    forth6809.asm):02529                    LDU  TSTU0
                      (    forth6809.asm):02530                    RTS
                      (    forth6809.asm):02531         
C1B1                  (    forth6809.asm):02532         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02533                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02534         
                      (    forth6809.asm):02535         ; ------------------------------------------------------------
                      (    forth6809.asm):02536         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02537         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02538         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02539         ; verifying the round trip.
                      (    forth6809.asm):02540         ; ------------------------------------------------------------

EB30 EC46             (    forth6809.asm):04795         DOVERW:     LDD   6,U               ; x1
EB32 AE44             (    forth6809.asm):04796                     LDX   4,U               ; x2
EB34 3606             (    forth6809.asm):04797                     PSHU  D
EB36 3610             (    forth6809.asm):04798                     PSHU  X
EB38 39               (    forth6809.asm):04799                     RTS
                      (    forth6809.asm):04800         
                      (    forth6809.asm):04801         ; ------------------------------------------------------------

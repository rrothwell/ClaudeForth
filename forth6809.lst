                      (    forth6809.asm):12718                     STD  CODEHERE
                      (    forth6809.asm):12719                     LDD  #TSTNAMEB
                      (    forth6809.asm):12720                     STD  SRCADDR
                      (    forth6809.asm):12721                     LDD  #3
                      (    forth6809.asm):12722                     STD  SRCLEN
                      (    forth6809.asm):12723                     LDD  #0
                      (    forth6809.asm):12724                     STD  TOIN
                      (    forth6809.asm):12725                     LDD  #0
                      (    forth6809.asm):12726                     STD  STATE
                      (    forth6809.asm):12727         
                      (    forth6809.asm):12728                     STU  TSTU0
                      (    forth6809.asm):12729         
                      (    forth6809.asm):12730                     LDD  #TSTGUARD
                      (    forth6809.asm):12731                     PSHU D
                      (    forth6809.asm):12732                     STU  TSTUB4
                      (    forth6809.asm):12733         
                      (    forth6809.asm):12734                     JSR  SQUOTE
                      (    forth6809.asm):12735         
                      (    forth6809.asm):12736                     STU  TSTUAF
                      (    forth6809.asm):12737         
                      (    forth6809.asm):12738                     LDD  TSTCSAV

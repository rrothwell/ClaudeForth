                      (    forth6809.asm):08193                    STD  TSTVSAV
                      (    forth6809.asm):08194                    LDD  SRCADDR
                      (    forth6809.asm):08195                    STD  TSTSASAV
                      (    forth6809.asm):08196                    LDD  SRCLEN
                      (    forth6809.asm):08197                    STD  TSTSLSAV
                      (    forth6809.asm):08198                    LDD  TOIN
                      (    forth6809.asm):08199                    STD  TSTTISAV
                      (    forth6809.asm):08200                    LDD  LATEST
                      (    forth6809.asm):08201                    STD  TSTLSAV

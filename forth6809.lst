E1CE 3706             (    forth6809.asm):02934                     PULU  D
E1D0 10830000         (    forth6809.asm):02935                     CMPD  #0
E1D4 260A             (    forth6809.asm):02936                     BNE   AOFOUND
E1D6 3706             (    forth6809.asm):02937                     PULU  D
E1D8 CCFFF3           (    forth6809.asm):02938                     LDD   #-13
E1DB 3606             (    forth6809.asm):02939                     PSHU  D
E1DD BDE60A           (    forth6809.asm):02940                     JSR   THROW
E1E0 3710             (    forth6809.asm):02941         AOFOUND:    PULU  X
E1E2 DC00             (    forth6809.asm):02942                     LDD   STATE
E1E4 270E             (    forth6809.asm):02943                     BEQ   AOIMMED
E1E6 3610             (    forth6809.asm):02944                     PSHU  X
E1E8 BDEA92           (    forth6809.asm):02945                     JSR   LITERALW
E1EB CCE178           (    forth6809.asm):02946                     LDD   #DEFERFETCHW
E1EE 3606             (    forth6809.asm):02947                     PSHU  D
E1F0 BDEA85           (    forth6809.asm):02948                     JSR   CCALL
E1F3 39               (    forth6809.asm):02949                     RTS
E1F4 3610             (    forth6809.asm):02950         AOIMMED:    PSHU  X
E1F6 BDE178           (    forth6809.asm):02951                     JSR   DEFERFETCHW
E1F9 39               (    forth6809.asm):02952                     RTS
                      (    forth6809.asm):02953         

                      (    forth6809.asm):01892         ; ------------------------------------------------------------
                      (    forth6809.asm):01893         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):01894         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):01895         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):01896         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):01897         ; IRQH
                      (    forth6809.asm):01898         ;    Inputs:
                      (    forth6809.asm):01899         ;        none (hardware interrupt entry)
                      (    forth6809.asm):01900         ;    Outputs:
                      (    forth6809.asm):01901         ;        none (returns with RTI)
                      (    forth6809.asm):01902         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):01903         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):01904         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01905         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):01906         
                      (    forth6809.asm):01907                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):01908                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):01909                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):01910                     BNE   INCHAR
                      (    forth6809.asm):01911                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?

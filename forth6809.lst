                      (    forth6809.asm):00519                               ; fully packed: 256 of 256 bytes used, 0 free.
                      (    forth6809.asm):00520         
     0100             (    forth6809.asm):00521         GLOBALS_USED EQU 256  ; total bytes used, of 256 available - fully packed
                      (    forth6809.asm):00522         
                      (    forth6809.asm):00523         ; ------------------------------------------------------------
                      (    forth6809.asm):00524         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00525         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00526         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00527         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00528         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00529         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00530         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00531         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00532         ;
                      (    forth6809.asm):00533         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00534         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00535         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00536         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00537         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00538         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00539         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00540         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00541         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00542         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00543         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00544         ; ------------------------------------------------------------
                      (    forth6809.asm):00545                  ORG   $0100
0100                  (    forth6809.asm):00546         MVCNT      RMB   2
0102                  (    forth6809.asm):00547         MVDST      RMB   2
0104                  (    forth6809.asm):00548         MVSRC      RMB   2
     0100             (    forth6809.asm):00549         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00550         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00551         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00552         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00553         
                      (    forth6809.asm):00554         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00555         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00556                  ORG USROMSTRT
                      (    forth6809.asm):00557         
                      (    forth6809.asm):00558         ; ============================================================
                      (    forth6809.asm):00559         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00560         ;
                      (    forth6809.asm):00561         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00562         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00563         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00564         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00565         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00566         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00567         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00568         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00569         ; this existed - UNITTESTS=1 removes it entirely and this block
                      (    forth6809.asm):00570         ; reverts to exactly that padding, computed automatically below
                      (    forth6809.asm):00571         ; via the ROM label rather than a fixed byte count, so it's
                      (    forth6809.asm):00572         ; correct either way without needing to be hand-adjusted.
                      (    forth6809.asm):00573         ;
                      (    forth6809.asm):00574         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00575         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00576         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00577         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00578         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00579         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00580         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00581         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00582         ;
                      (    forth6809.asm):00583         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00584         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00585         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00586         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00587         ; ============================================================
     0001             (    forth6809.asm):00588         UNITTESTS EQU 1   ; was 0 (included) - set to 1 (excluded) per explicit
                      (    forth6809.asm):00589                           ; request: unit tests don't work yet and resolution
                      (    forth6809.asm):00590                           ; has been postponed. 0 = included (matches this
                      (    forth6809.asm):00591                           ; file's established IFEQ convention, e.g.
                      (    forth6809.asm):00592                           ; SERIALPOLL); 1 = excluded entirely, reverting to
                      (    forth6809.asm):00593                           ; plain FILL padding.
                      (    forth6809.asm):00594         
                      (    forth6809.asm):00595                  IFEQ  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00596         
C100                  (    forth6809.asm):00597         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
C100                  (    forth6809.asm):00598         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
C100                  (    forth6809.asm):00599         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
C100                  (    forth6809.asm):00600         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00601         
C100                  (    forth6809.asm):00602         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00603                                       ; under test, to prove an operation
                      (    forth6809.asm):00604                                       ; doesn't disturb what's beneath it
C100                  (    forth6809.asm):00605         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00606                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00607                                       ; that only appears to pass due to a
                      (    forth6809.asm):00608                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00609                                       ; caught rather than masked
                      (    forth6809.asm):00610         
                      (    forth6809.asm):00611         ; ------------------------------------------------------------
                      (    forth6809.asm):00612         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00613         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00614         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00615         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00616         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00617         TSTREPORT: PULU  D
                      (    forth6809.asm):00618                    STD   TSTFLAG
                      (    forth6809.asm):00619                    JSR   COUNT
                      (    forth6809.asm):00620                    JSR   TYPE
                      (    forth6809.asm):00621                    LDD   TSTFLAG
                      (    forth6809.asm):00622                    BEQ   TSTFAILR
                      (    forth6809.asm):00623                    LDD   #TSTOKMSG
                      (    forth6809.asm):00624                    PSHU  D
                      (    forth6809.asm):00625                    LDD   #TSTOKMSGL
                      (    forth6809.asm):00626                    PSHU  D
                      (    forth6809.asm):00627                    BRA   TSTPRINT
C100                  (    forth6809.asm):00628         TSTFAILR:  LDD   #TSTFAILMSG
                      (    forth6809.asm):00629                    PSHU  D
                      (    forth6809.asm):00630                    LDD   #TSTFAILMSGL
                      (    forth6809.asm):00631                    PSHU  D
C100                  (    forth6809.asm):00632         TSTPRINT:  JSR   TYPE
                      (    forth6809.asm):00633                    JSR   CRW
                      (    forth6809.asm):00634                    RTS
                      (    forth6809.asm):00635         
C100                  (    forth6809.asm):00636         TSTOKMSG:    FCC " OK"
C100                  (    forth6809.asm):00637         TSTOKMSGL    EQU  *-TSTOKMSG
C100                  (    forth6809.asm):00638         TSTFAILMSG:  FCC " FAIL"
C100                  (    forth6809.asm):00639         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00640         
                      (    forth6809.asm):00641         ; ------------------------------------------------------------
                      (    forth6809.asm):00642         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00643         ; here as they're written.
                      (    forth6809.asm):00644         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00645         TSTRUNNER: JSR   TSTSTACK
                      (    forth6809.asm):00646                    RTS
                      (    forth6809.asm):00647         
                      (    forth6809.asm):00648         ; ------------------------------------------------------------
                      (    forth6809.asm):00649         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):00650         ; they're written.
                      (    forth6809.asm):00651         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00652         TSTSTACK:  JSR   TSTDUP
                      (    forth6809.asm):00653                    RTS
                      (    forth6809.asm):00654         
                      (    forth6809.asm):00655         ; ------------------------------------------------------------
                      (    forth6809.asm):00656         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00657         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00658         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00659         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00660         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00661         ; pushes that set the test up).
                      (    forth6809.asm):00662         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00663         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00664         
                      (    forth6809.asm):00665                    LDD   #TSTGUARD
                      (    forth6809.asm):00666                    PSHU  D
                      (    forth6809.asm):00667                    LDD   #TSTVAL1
                      (    forth6809.asm):00668                    PSHU  D
                      (    forth6809.asm):00669                    STU   TSTUB4
                      (    forth6809.asm):00670         
                      (    forth6809.asm):00671                    JSR   DUP
                      (    forth6809.asm):00672         
                      (    forth6809.asm):00673                    STU   TSTUAF
                      (    forth6809.asm):00674         
                      (    forth6809.asm):00675                    PULU  D
                      (    forth6809.asm):00676                    CMPD  #TSTVAL1
                      (    forth6809.asm):00677                    BNE   TDFAIL
                      (    forth6809.asm):00678                    PULU  D
                      (    forth6809.asm):00679                    CMPD  #TSTVAL1
                      (    forth6809.asm):00680                    BNE   TDFAIL
                      (    forth6809.asm):00681                    PULU  D
                      (    forth6809.asm):00682                    CMPD  #TSTGUARD
                      (    forth6809.asm):00683                    BNE   TDFAIL
                      (    forth6809.asm):00684         
                      (    forth6809.asm):00685                    LDD   TSTUB4
                      (    forth6809.asm):00686                    SUBD  TSTUAF
                      (    forth6809.asm):00687                    CMPD  #2
                      (    forth6809.asm):00688                    BNE   TDFAIL
                      (    forth6809.asm):00689         
                      (    forth6809.asm):00690                    LDD   #TRUEV
                      (    forth6809.asm):00691                    BRA   TDDONE
C100                  (    forth6809.asm):00692         TDFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):00693         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00694                    PSHU  X
                      (    forth6809.asm):00695                    PSHU  D
                      (    forth6809.asm):00696                    JSR   TSTREPORT
                      (    forth6809.asm):00697         
                      (    forth6809.asm):00698                    LDU   TSTU0
                      (    forth6809.asm):00699                    RTS
                      (    forth6809.asm):00700         
C100                  (    forth6809.asm):00701         TSTDUPNAME: FCB  6
                      (    forth6809.asm):00702                     FCC  "TSTDUP"
                      (    forth6809.asm):00703         
                      (    forth6809.asm):00704                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00705         
C100                  (    forth6809.asm):00706         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00707                  FILL $FF,BASEDICT-ROM

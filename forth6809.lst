                      (    forth6809.asm):08235                    LDA  #'T'
                      (    forth6809.asm):08236                    STA  TSTNAMEB
                      (    forth6809.asm):08237                    LDA  #'E'
                      (    forth6809.asm):08238                    STA  TSTNAMEB+1

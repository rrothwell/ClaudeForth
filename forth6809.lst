                      (    forth6809.asm):15073         
                      (    forth6809.asm):15074         ; ------------------------------------------------------------
                      (    forth6809.asm):15075         ; TSTEXCEPTION - exception handling tests (glossary section
                      (    forth6809.asm):15076         ; 3.15, 2 words, 4 tests since CATCH/THROW can only be
                      (    forth6809.asm):15077         ; meaningfully tested together - THROW's own effect is only
                      (    forth6809.asm):15078         ; observable through a CATCH that traps it). Already used
                      (    forth6809.asm):15079         ; extensively as this whole session's own error-testing
                      (    forth6809.asm):15080         ; mechanism throughout sections 3.8-3.14, so their correctness
                      (    forth6809.asm):15081         ; has substantial indirect evidence already; this section still
                      (    forth6809.asm):15082         ; gets its own, direct, dedicated tests.
                      (    forth6809.asm):15083         ;
                      (    forth6809.asm):15084         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15085         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15086         ; ABORT (unsafe to trigger directly - it resets the return
                      (    forth6809.asm):15087         ; stack, destroying this whole test framework's own call chain,
                      (    forth6809.asm):15088         ; per section 3.1's own established reasoning). Every THROW in
                      (    forth6809.asm):15089         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15090         ; active CATCH (via a dedicated internal helper, TSTTHROWHLP,
                      (    forth6809.asm):15091         ; that only ever gets invoked that way), or is a THROW(0) call -
                      (    forth6809.asm):15092         ; confirmed via THROW's own code to be a pure, unconditional
                      (    forth6809.asm):15093         ; no-op that never touches HANDLER or ABORT at all, so that one
                      (    forth6809.asm):15094         ; specific case is safe to call directly.
                      (    forth6809.asm):15095         ;
                      (    forth6809.asm):15096         ; TSTCATCHTHROW specifically verifies the two dummy values
                      (    forth6809.asm):15097         ; TSTTHROWHLP pushes before throwing are genuinely gone
                      (    forth6809.asm):15098         ; afterward, confirming CATCH's own documented "restores data
                      (    forth6809.asm):15099         ; stack depth... on either path" for real. TSTHANDLERSAVE
                      (    forth6809.asm):15100         ; verifies the HANDLER half of that same documented guarantee
                      (    forth6809.asm):15101         ; directly, by reading HANDLER itself before and after CATCH
                      (    forth6809.asm):15102         ; calls on both the success and throw paths, rather than only
                      (    forth6809.asm):15103         ; inferring it from stack-level behavior.
                      (    forth6809.asm):15104         ; ------------------------------------------------------------
C2E8 BDFC2B           (    forth6809.asm):15105         TSTEXCEPTION: JSR CRW
C2EB 8EC2FC           (    forth6809.asm):15106                    LDX   #TSTEXCMSG
C2EE 3610             (    forth6809.asm):15107                    PSHU  X
C2F0 CC0006           (    forth6809.asm):15108                    LDD   #6
C2F3 3606             (    forth6809.asm):15109                    PSHU  D
C2F5 BDF60B           (    forth6809.asm):15110                    JSR   TYPE
C2F8 BDFC2B           (    forth6809.asm):15111                    JSR   CRW
                      (    forth6809.asm):15112         
                      (    forth6809.asm):15113                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15114         
                      (    forth6809.asm):15115                    JSR   TSTCATCHOK
                      (    forth6809.asm):15116                    JSR   TSTCATCHTHROW
                      (    forth6809.asm):15117                    JSR   TSTTHROWZERO
                      (    forth6809.asm):15118                    JSR   TSTHANDLERSAVE
                      (    forth6809.asm):15119         
                      (    forth6809.asm):15120                    ENDC ; <<<<
                      (    forth6809.asm):15121         
C2FB 39               (    forth6809.asm):15122                    RTS
                      (    forth6809.asm):15123         
C2FC 457863657074     (    forth6809.asm):15124         TSTEXCMSG: FCC "Except"
                      (    forth6809.asm):15125         
                      (    forth6809.asm):15126                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15127         
                      (    forth6809.asm):15128         ; ------------------------------------------------------------
                      (    forth6809.asm):15129         ; Exception Handling test harness (glossary section 3.15).
                      (    forth6809.asm):15130         ; CATCH/THROW have already been used extensively as this whole
                      (    forth6809.asm):15131         ; session's own error-testing mechanism throughout sections
                      (    forth6809.asm):15132         ; 3.8-3.14, so their correctness has substantial indirect
                      (    forth6809.asm):15133         ; evidence already - this section still gets its own, direct
                      (    forth6809.asm):15134         ; tests, matching the established practice of every section
                      (    forth6809.asm):15135         ; getting dedicated coverage rather than relying on incidental
                      (    forth6809.asm):15136         ; use elsewhere.
                      (    forth6809.asm):15137         ;
                      (    forth6809.asm):15138         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15139         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15140         ; ABORT (already established elsewhere in this session as unsafe
                      (    forth6809.asm):15141         ; to trigger directly - it resets the return stack, destroying
                      (    forth6809.asm):15142         ; this whole test framework's own call chain). Every THROW in
                      (    forth6809.asm):15143         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15144         ; active CATCH, or is a THROW(0) call - confirmed via CATCH's own
                      (    forth6809.asm):15145         ; code to be a pure no-op that never touches HANDLER or ABORT at
                      (    forth6809.asm):15146         ; all, so that specific case is safe to call directly.
                      (    forth6809.asm):15147         ; ------------------------------------------------------------
                      (    forth6809.asm):15148         
                      (    forth6809.asm):15149         ; ------------------------------------------------------------
                      (    forth6809.asm):15150         ; TSTCATCHOK - unit test for CATCH, success path. Wraps DUP (a
                      (    forth6809.asm):15151         ; genuine, real dictionary word, not a synthetic stand-in) and
                      (    forth6809.asm):15152         ; verifies both that DUP's own effect genuinely happened (the
                      (    forth6809.asm):15153         ; value really was duplicated) and that CATCH itself returns 0.
                      (    forth6809.asm):15154         ; ------------------------------------------------------------
C302                  (    forth6809.asm):15155         TSTCATCHOK: STU  TSTU0
                      (    forth6809.asm):15156         
                      (    forth6809.asm):15157                     LDD  #TSTGUARD
                      (    forth6809.asm):15158                     PSHU D
                      (    forth6809.asm):15159                     LDD  #TSTVAL1
                      (    forth6809.asm):15160                     PSHU D
                      (    forth6809.asm):15161                     LDX  #DUP
                      (    forth6809.asm):15162                     PSHU X
                      (    forth6809.asm):15163                     STU  TSTUB4
                      (    forth6809.asm):15164         
                      (    forth6809.asm):15165                     JSR  CATCH
                      (    forth6809.asm):15166         
                      (    forth6809.asm):15167                     STU  TSTUAF
                      (    forth6809.asm):15168         
                      (    forth6809.asm):15169                     PULU D
                      (    forth6809.asm):15170                     CMPD #0
                      (    forth6809.asm):15171                     BNE  COFAIL
                      (    forth6809.asm):15172                     PULU D
                      (    forth6809.asm):15173                     CMPD #TSTVAL1
                      (    forth6809.asm):15174                     BNE  COFAIL
                      (    forth6809.asm):15175                     PULU D
                      (    forth6809.asm):15176                     CMPD #TSTVAL1
                      (    forth6809.asm):15177                     BNE  COFAIL
                      (    forth6809.asm):15178                     PULU D
                      (    forth6809.asm):15179                     CMPD #TSTGUARD
                      (    forth6809.asm):15180                     BNE  COFAIL
                      (    forth6809.asm):15181         
                      (    forth6809.asm):15182                     LDD  TSTUB4
                      (    forth6809.asm):15183                     SUBD TSTUAF
                      (    forth6809.asm):15184                     CMPD #2
                      (    forth6809.asm):15185                     BNE  COFAIL
                      (    forth6809.asm):15186         
                      (    forth6809.asm):15187                     LDD  #TRUEV
                      (    forth6809.asm):15188                     BRA  CODONE
C302                  (    forth6809.asm):15189         COFAIL:     LDD  #FALSEV
C302                  (    forth6809.asm):15190         CODONE:     LDX  #TSTCONAME
                      (    forth6809.asm):15191                     PSHU X

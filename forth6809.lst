                      (    forth6809.asm):02218                    BNE   PKFAIL
                      (    forth6809.asm):02219                    PULU  D
                      (    forth6809.asm):02220                    CMPD  #TSTVAL2
                      (    forth6809.asm):02221                    BNE   PKFAIL
                      (    forth6809.asm):02222                    PULU  D

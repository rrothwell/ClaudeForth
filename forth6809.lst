DEF5 3B               (    forth6809.asm):05818         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):05819                                       ; interrupts are never enabled (see
                      (    forth6809.asm):05820                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):05821                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):05822                                       ; the other unused vectors below
                      (    forth6809.asm):05823                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):05824         
DEF6 3B               (    forth6809.asm):05825         SWI3H:   RTI

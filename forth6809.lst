C29E 8EC2AF           (    forth6809.asm):12078                    LDX   #TSTSTRPMSG
C2A1 3610             (    forth6809.asm):12079                    PSHU  X
C2A3 CC0008           (    forth6809.asm):12080                    LDD   #8
C2A6 3606             (    forth6809.asm):12081                    PSHU  D
C2A8 BDF60B           (    forth6809.asm):12082                    JSR   TYPE
C2AB BDFC2B           (    forth6809.asm):12083                    JSR   CRW
                      (    forth6809.asm):12084         

C154 3610             (    forth6809.asm):00840                    PSHU  X
C156 CC0005           (    forth6809.asm):00841                    LDD   #5
C159 3606             (    forth6809.asm):00842                    PSHU  D
C15B BDF60B           (    forth6809.asm):00843                    JSR   TYPE
C15E BDFC2B           (    forth6809.asm):00844                    JSR   CRW
                      (    forth6809.asm):00845         
                      (    forth6809.asm):00846                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00847         

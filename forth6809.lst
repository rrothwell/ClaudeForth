                      (    forth6809.asm):10846                     STD  CODEHERE
                      (    forth6809.asm):10847                     LDD  #TSTNAMEB
                      (    forth6809.asm):10848                     STD  SRCADDR
                      (    forth6809.asm):10849                     LDD  #3

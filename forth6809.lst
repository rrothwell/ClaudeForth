                      (    forth6809.asm):13603                    BNE  SN2FAIL
                      (    forth6809.asm):13604         
                      (    forth6809.asm):13605                    LDD  TSTUB4
                      (    forth6809.asm):13606                    SUBD TSTUAF
                      (    forth6809.asm):13607                    CMPD #2
                      (    forth6809.asm):13608                    BNE  SN2FAIL
                      (    forth6809.asm):13609         
                      (    forth6809.asm):13610                    LDD  #TRUEV
                      (    forth6809.asm):13611                    BRA  SN2DONE
C2B1                  (    forth6809.asm):13612         SN2FAIL:   LDD  #FALSEV
C2B1                  (    forth6809.asm):13613         SN2DONE:   LDX  #TSTSN2NAME
                      (    forth6809.asm):13614                    PSHU X
                      (    forth6809.asm):13615                    PSHU D
                      (    forth6809.asm):13616                    JSR  TSTREPORT
                      (    forth6809.asm):13617         

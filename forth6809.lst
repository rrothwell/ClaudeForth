                      (    forth6809.asm):02559                       LDD  #TSTVAL2
                      (    forth6809.asm):02560                       PSHU D
                      (    forth6809.asm):02561                       STU  TSTUB4
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563                       JSR  TWOTOR
                      (    forth6809.asm):02564                       JSR  TWORFETCH
                      (    forth6809.asm):02565                       JSR  TWOFROMR
                      (    forth6809.asm):02566         
                      (    forth6809.asm):02567                       STU  TSTUAF
                      (    forth6809.asm):02568         
                      (    forth6809.asm):02569                       PULU D
                      (    forth6809.asm):02570                       CMPD #TSTVAL2
                      (    forth6809.asm):02571                       BNE  T2FFAIL
                      (    forth6809.asm):02572                       PULU D
                      (    forth6809.asm):02573                       CMPD #TSTVAL1
                      (    forth6809.asm):02574                       BNE  T2FFAIL
                      (    forth6809.asm):02575                       PULU D
                      (    forth6809.asm):02576                       CMPD #TSTVAL2
                      (    forth6809.asm):02577                       BNE  T2FFAIL
                      (    forth6809.asm):02578                       PULU D
                      (    forth6809.asm):02579                       CMPD #TSTVAL1
                      (    forth6809.asm):02580                       BNE  T2FFAIL
                      (    forth6809.asm):02581                       PULU D
                      (    forth6809.asm):02582                       CMPD #TSTGUARD
                      (    forth6809.asm):02583                       BNE  T2FFAIL
                      (    forth6809.asm):02584         
                      (    forth6809.asm):02585                       LDD  TSTUB4
                      (    forth6809.asm):02586                       SUBD TSTUAF
                      (    forth6809.asm):02587                       CMPD #4
                      (    forth6809.asm):02588                       BNE  T2FFAIL
                      (    forth6809.asm):02589         
                      (    forth6809.asm):02590                       LDD  #TRUEV
                      (    forth6809.asm):02591                       BRA  T2FDONE
C3E4                  (    forth6809.asm):02592         T2FFAIL:       LDD  #FALSEV
C3E4                  (    forth6809.asm):02593         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02594                       PSHU X
                      (    forth6809.asm):02595                       PSHU D
                      (    forth6809.asm):02596                       JSR  TSTREPORT
                      (    forth6809.asm):02597         
                      (    forth6809.asm):02598                       LDU  TSTU0
                      (    forth6809.asm):02599                       RTS
                      (    forth6809.asm):02600         
C3E4                  (    forth6809.asm):02601         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02602                           FCC  "TSTTWORFETCH"

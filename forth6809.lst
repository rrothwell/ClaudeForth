FC67 EC84             (    forth6809.asm):07694         ENVLOOP:    LDD   ,X
FC69 10830000         (    forth6809.asm):07695                     CMPD  #0
FC6D 272B             (    forth6809.asm):07696                     BEQ   ENV2START         ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):07697                                             ; the double-cell table (below) before
                      (    forth6809.asm):07698                                             ; giving up entirely. See ENV2START/
                      (    forth6809.asm):07699                                             ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):07700                                             ; turn - both are double-cell values per
                      (    forth6809.asm):07701                                             ; their own ANS data type, which this
                      (    forth6809.asm):07702                                             ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):07703                                             ; exactly one value before TRUE) can't
                      (    forth6809.asm):07704                                             ; represent correctly.
FC6F 3410             (    forth6809.asm):07705                     PSHS  X                 ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):07706                                             ; internal scratch (LDX CMPA1, then LDA
                      (    forth6809.asm):07707                                             ; ,X+ advancing through the comparison),
                      (    forth6809.asm):07708                                             ; clobbering whatever the caller had there.
                      (    forth6809.asm):07709                                             ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):07710                                             ; current table entry after COMPAREW
                      (    forth6809.asm):07711                                             ; returns, both for ENVFOUND's own LDD 4,X
                      (    forth6809.asm):07712                                             ; and for advancing to the next entry -
                      (    forth6809.asm):07713                                             ; without saving it first, a successful
                      (    forth6809.asm):07714                                             ; match left X sitting just past the
                      (    forth6809.asm):07715                                             ; matched string's own text (for
                      (    forth6809.asm):07716                                             ; "/COUNTED-STRING", 15 characters, that
                      (    forth6809.asm):07717                                             ; lands exactly at the start of the next
                      (    forth6809.asm):07718                                             ; entry's string, "MAX-N") - so ENVFOUND
                      (    forth6809.asm):07719                                             ; read the "value" field from inside the
                      (    forth6809.asm):07720                                             ; NEXT entry's own string text instead of
                      (    forth6809.asm):07721                                             ; the real value. Confirmed via MAME: this
                      (    forth6809.asm):07722                                             ; exact mechanism produces $4E4D precisely
                      (    forth6809.asm):07723                                             ; - the bytes 'N' ($4E) and 'M' ($4D, the
                      (    forth6809.asm):07724                                             ; start of "MAX-U") sitting 4 bytes into
                      (    forth6809.asm):07725                                             ; "MAX-N", read as one cell.

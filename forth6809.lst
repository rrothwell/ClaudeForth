                      (    forth6809.asm):02324         
                      (    forth6809.asm):02325         ; ------------------------------------------------------------
                      (    forth6809.asm):02326         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02327         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02328         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02329         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02330         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02331         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02332         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02333         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02334         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02335         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02336         ;
                      (    forth6809.asm):02337         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02338         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02339         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02340         ; right value once.
                      (    forth6809.asm):02341         ; ------------------------------------------------------------
C3C8 BDFC2B           (    forth6809.asm):02342         TSTRETSTACK: JSR CRW
C3CB 8EC3DC           (    forth6809.asm):02343                    LDX   #TSTRETMSG
C3CE 3610             (    forth6809.asm):02344                    PSHU  X
C3D0 CC0008           (    forth6809.asm):02345                    LDD   #8
C3D3 3606             (    forth6809.asm):02346                    PSHU  D
C3D5 BDF60B           (    forth6809.asm):02347                    JSR   TYPE
C3D8 BDFC2B           (    forth6809.asm):02348                    JSR   CRW
                      (    forth6809.asm):02349         
                      (    forth6809.asm):02350                    IFEQ TSTSELECTOR-7  ; >>>>
                      (    forth6809.asm):02351         
                      (    forth6809.asm):02352                    JSR   TSTTOR
                      (    forth6809.asm):02353                    JSR   TSTRFETCH
                      (    forth6809.asm):02354                    JSR   TSTTWOTOR
                      (    forth6809.asm):02355                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02356         
                      (    forth6809.asm):02357                    ENDC ; <<<<
                      (    forth6809.asm):02358         
C3DB 39               (    forth6809.asm):02359                    RTS
                      (    forth6809.asm):02360         
C3DC 526574537461636B (    forth6809.asm):02361         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02362         
                      (    forth6809.asm):02363                    IFEQ TSTSELECTOR-7  ; >>>>
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         ; ------------------------------------------------------------
                      (    forth6809.asm):02366         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02367         ; every other test group in this file, these words operate
                      (    forth6809.asm):02368         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02369         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02370         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02371         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02372         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02373         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02374         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02375         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02376         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02377         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02378         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02379         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02380         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02381         ; ------------------------------------------------------------
                      (    forth6809.asm):02382         
                      (    forth6809.asm):02383         ; ------------------------------------------------------------
                      (    forth6809.asm):02384         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02385         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02386         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02387         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02388         ; value would never actually have left.
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
C3E4                  (    forth6809.asm):02390         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02391         
                      (    forth6809.asm):02392                  LDD   #TSTGUARD
                      (    forth6809.asm):02393                  PSHU  D
                      (    forth6809.asm):02394                  LDD   #TSTVAL1

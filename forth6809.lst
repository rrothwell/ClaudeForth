D922 25F3             (    forth6809.asm):04401                     BCS   KEYACIA           ; No? Try again to receive a char,
                      (    forth6809.asm):04402                                             ; while still transmitting!
                      (    forth6809.asm):04403         
D924 1F89             (    forth6809.asm):04404                     TFR   A,B               ; Move char result to Reg B (LSB of D)
D926 4F               (    forth6809.asm):04405                     CLRA                    ; Clear MSB.
D927 3606             (    forth6809.asm):04406                     PSHU  D                 ; char
                      (    forth6809.asm):04407         
D929 39               (    forth6809.asm):04408                     RTS
                      (    forth6809.asm):04409         
                      (    forth6809.asm):04410         ; ------------------------------------------------------------

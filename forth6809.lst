                      (    forth6809.asm):05298         ; ------------------------------------------------------------
                      (    forth6809.asm):05299         ; TSTCTRLFLOW - control-flow tests (glossary section 3.8, 22
                      (    forth6809.asm):05300         ; words - all except UNLOOP, which is a genuine runtime no-op
                      (    forth6809.asm):05301         ; and tested directly like ALIGN's own test, needing none of
                      (    forth6809.asm):05302         ; this section's compile-time harness). Every other test
                      (    forth6809.asm):05303         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):05304         ; real compile-time words directly (JSR IF, JSR THEN, JSR DO,
                      (    forth6809.asm):05305         ; etc - the actual routines the compiler itself calls, not a
                      (    forth6809.asm):05306         ; hand-simulated imitation), restores CODEHERE, then executes
                      (    forth6809.asm):05307         ; the compiled snippet directly. Tests the real interaction
                      (    forth6809.asm):05308         ; between compile-time correctness (right bytes, right patched
                      (    forth6809.asm):05309         ; offsets) and runtime correctness (right control flow) in one
                      (    forth6809.asm):05310         ; coherent check, without needing the outer interpreter, FIND,
                      (    forth6809.asm):05311         ; or a real dictionary entry.
                      (    forth6809.asm):05312         ;
                      (    forth6809.asm):05313         ; Given the planned future application of the ANS test suite for
                      (    forth6809.asm):05314         ; broader standards-compliance coverage, these tests focus on
                      (    forth6809.asm):05315         ; this system's own compile/patch mechanism working correctly -
                      (    forth6809.asm):05316         ; not full end-to-end parsing, which the ANS suite will cover.
                      (    forth6809.asm):05317         ;
                      (    forth6809.asm):05318         ; One case is deliberately NOT tested: DO with limit=index.
                      (    forth6809.asm):05319         ; Traced precisely (simulated the real DOTEST increment-and-
                      (    forth6809.asm):05320         ; compare-equal logic) and confirmed it takes a full 65536-
                      (    forth6809.asm):05321         ; iteration wraparound to naturally reconverge on equality, not
                      (    forth6809.asm):05322         ; one - true to the letter of "runs at least once" but
                      (    forth6809.asm):05323         ; impractical for a boot-time self-check. ?DO's own equivalent
                      (    forth6809.asm):05324         ; case IS tested (TSTQDOLPEQ) - its own skip check happens
                      (    forth6809.asm):05325         ; before the loop is entered at all, confirmed fast and safe by
                      (    forth6809.asm):05326         ; the same kind of trace.
                      (    forth6809.asm):05327         ; ------------------------------------------------------------
C1D6 BDFC2B           (    forth6809.asm):05328         TSTCTRLFLOW: JSR CRW
C1D9 8EC1EA           (    forth6809.asm):05329                    LDX   #TSTCTRLMSG
C1DC 3610             (    forth6809.asm):05330                    PSHU  X
C1DE CC0008           (    forth6809.asm):05331                    LDD   #8
C1E1 3606             (    forth6809.asm):05332                    PSHU  D
C1E3 BDF60B           (    forth6809.asm):05333                    JSR   TYPE
C1E6 BDFC2B           (    forth6809.asm):05334                    JSR   CRW
                      (    forth6809.asm):05335         
                      (    forth6809.asm):05336                    IFEQ TSTSELECTOR-5  ; >>>>
                      (    forth6809.asm):05337         
                      (    forth6809.asm):05338                    JSR   TSTIFT1
                      (    forth6809.asm):05339                    JSR   TSTIFT2
                      (    forth6809.asm):05340                    JSR   TSTIET1
                      (    forth6809.asm):05341                    JSR   TSTIET2
                      (    forth6809.asm):05342                    JSR   TSTBGU
                      (    forth6809.asm):05343                    JSR   TSTBWR
                      (    forth6809.asm):05344                    JSR   TSTRECUR
                      (    forth6809.asm):05345                    JSR   TSTDOLP
                      (    forth6809.asm):05346                    JSR   TSTQDOLP
                      (    forth6809.asm):05347                    JSR   TSTQDOLPEQ
                      (    forth6809.asm):05348                    JSR   TSTPLOOP
                      (    forth6809.asm):05349                    JSR   TSTJIDX
                      (    forth6809.asm):05350                    JSR   TSTLEAVE
                      (    forth6809.asm):05351                    JSR   TSTEXIT
                      (    forth6809.asm):05352                    JSR   TSTUNLOOP
                      (    forth6809.asm):05353                    JSR   TSTCASE1
                      (    forth6809.asm):05354                    JSR   TSTCASE2
                      (    forth6809.asm):05355                    JSR   TSTTHENZ
                      (    forth6809.asm):05356                    JSR   TSTUNTILZ
                      (    forth6809.asm):05357                    JSR   TSTENDOFZ
                      (    forth6809.asm):05358         
                      (    forth6809.asm):05359                    ENDC ; <<<<

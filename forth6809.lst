                      (    forth6809.asm):06466         ; ------------------------------------------------------------
F3C1 EC42             (    forth6809.asm):06467         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F3C3 270F             (    forth6809.asm):06468                     BEQ   FDONE
F3C5 AE44             (    forth6809.asm):06469                     LDX   4,U
F3C7 318B             (    forth6809.asm):06470                     LEAY  D,X               ; end address
F3C9 10AF42           (    forth6809.asm):06471                     STY   2,U               ; keep it in u's slot as the loop limit
F3CC A641             (    forth6809.asm):06472                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
F3CE A780             (    forth6809.asm):06473         FILLOOP:    STA   ,X+
F3D0 AC42             (    forth6809.asm):06474                     CMPX  2,U
F3D2 26FA             (    forth6809.asm):06475                     BNE   FILLOOP
F3D4 3346             (    forth6809.asm):06476         FDONE:      LEAU  6,U               ; drop the three parameters
F3D6 39               (    forth6809.asm):06477                     RTS
                      (    forth6809.asm):06478         
                      (    forth6809.asm):06479         ; ------------------------------------------------------------
                      (    forth6809.asm):06480         ; ERASE  ( c-addr u -- )

D7E4 CCFFFF           (    forth6809.asm):04520                     LDD   #TRUEV
D7E7 3606             (    forth6809.asm):04521                     PSHU  D                 ; flag = true
D7E9 39               (    forth6809.asm):04522                     RTS
D7EA CC0000           (    forth6809.asm):04523         KQFALSE:    LDD   #FALSEV
D7ED 3606             (    forth6809.asm):04524                     PSHU  D                 ; flag = false
D7EF 39               (    forth6809.asm):04525                     RTS
                      (    forth6809.asm):04526         
                      (    forth6809.asm):04527         ; ------------------------------------------------------------
                      (    forth6809.asm):04528         ; EMIT  ( char -- )  [polling build]

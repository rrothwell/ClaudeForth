                      (    forth6809.asm):14986         ; ------------------------------------------------------------
                      (    forth6809.asm):14987         ; Base/Radix Control test harness (glossary section 3.14). All
                      (    forth6809.asm):14988         ; four words are pure state-setting/reading with no I/O
                      (    forth6809.asm):14989         ; involved, so none of this section's tests need the
                      (    forth6809.asm):14990         ; SERIALPOLL-conditional complexity used throughout the printing
                      (    forth6809.asm):14991         ; sections. Combined into one test, given each word's own
                      (    forth6809.asm):14992         ; effect is trivially verified by reading BASE directly - four
                      (    forth6809.asm):14993         ; separate tests would just repeat the same save/set/verify/
                      (    forth6809.asm):14994         ; restore shape four times over. TSTBASAV (added in section
                      (    forth6809.asm):14995         ; 3.13, when the real, pre-COLD BASE=0 bug was found and fixed)
                      (    forth6809.asm):14996         ; is reused here to save/restore the real BASE across this test
                      (    forth6809.asm):14997         ; too, per the same established reasoning.
                      (    forth6809.asm):14998         ; ------------------------------------------------------------
                      (    forth6809.asm):14999         
                      (    forth6809.asm):15000         ; ------------------------------------------------------------
                      (    forth6809.asm):15001         ; TSTBASE - combined unit test for BASE, DECIMAL, HEX, and
                      (    forth6809.asm):15002         ; BINARY. Sets BASE via each of HEX/BINARY/DECIMAL in turn,
                      (    forth6809.asm):15003         ; verifying the correct value lands each time, then calls BASE
                      (    forth6809.asm):15004         ; itself and verifies both that it returns the variable's own
                      (    forth6809.asm):15005         ; address (not its value, per "( -- addr )") and that reading
                      (    forth6809.asm):15006         ; through that address reflects DECIMAL's own, most recent
                      (    forth6809.asm):15007         ; setting (10).
                      (    forth6809.asm):15008         ; ------------------------------------------------------------
C2E8                  (    forth6809.asm):15009         TSTBASE: LDD  BASE
                      (    forth6809.asm):15010                  STD  TSTBASAV
                      (    forth6809.asm):15011         
                      (    forth6809.asm):15012                  STU  TSTU0
                      (    forth6809.asm):15013         
                      (    forth6809.asm):15014                  JSR  HEXW
                      (    forth6809.asm):15015                  LDD  BASE
                      (    forth6809.asm):15016                  CMPD #16
                      (    forth6809.asm):15017                  BNE  BSFAIL
                      (    forth6809.asm):15018         
                      (    forth6809.asm):15019                  JSR  BINARYW
                      (    forth6809.asm):15020                  LDD  BASE
                      (    forth6809.asm):15021                  CMPD #2
                      (    forth6809.asm):15022                  BNE  BSFAIL
                      (    forth6809.asm):15023         
                      (    forth6809.asm):15024                  JSR  DECIMAL
                      (    forth6809.asm):15025                  LDD  BASE
                      (    forth6809.asm):15026                  CMPD #10
                      (    forth6809.asm):15027                  BNE  BSFAIL
                      (    forth6809.asm):15028         
                      (    forth6809.asm):15029                  LDD  #TSTGUARD
                      (    forth6809.asm):15030                  PSHU D
                      (    forth6809.asm):15031                  STU  TSTUB4
                      (    forth6809.asm):15032         
                      (    forth6809.asm):15033                  JSR  BASEW
                      (    forth6809.asm):15034         
                      (    forth6809.asm):15035                  STU  TSTUAF
                      (    forth6809.asm):15036         
                      (    forth6809.asm):15037                  PULU D
                      (    forth6809.asm):15038                  CMPD #BASE
                      (    forth6809.asm):15039                  BNE  BSFAIL
                      (    forth6809.asm):15040         
                      (    forth6809.asm):15041                  TFR  D,X
                      (    forth6809.asm):15042                  LDD  ,X
                      (    forth6809.asm):15043                  CMPD #10
                      (    forth6809.asm):15044                  BNE  BSFAIL
                      (    forth6809.asm):15045         
                      (    forth6809.asm):15046                  PULU D
                      (    forth6809.asm):15047                  CMPD #TSTGUARD
                      (    forth6809.asm):15048                  BNE  BSFAIL
                      (    forth6809.asm):15049         
                      (    forth6809.asm):15050                  LDD  TSTUB4
                      (    forth6809.asm):15051                  SUBD TSTUAF
                      (    forth6809.asm):15052                  CMPD #2
                      (    forth6809.asm):15053                  BNE  BSFAIL
                      (    forth6809.asm):15054         
                      (    forth6809.asm):15055                  LDD  #TRUEV
                      (    forth6809.asm):15056                  BRA  BSDONE
C2E8                  (    forth6809.asm):15057         BSFAIL:  LDD  #FALSEV
C2E8                  (    forth6809.asm):15058         BSDONE:  LDX  #TSTBSNAME
                      (    forth6809.asm):15059                  PSHU X
                      (    forth6809.asm):15060                  PSHU D
                      (    forth6809.asm):15061                  JSR  TSTREPORT
                      (    forth6809.asm):15062         
                      (    forth6809.asm):15063                  LDD  TSTBASAV
                      (    forth6809.asm):15064                  STD  BASE
                      (    forth6809.asm):15065         
                      (    forth6809.asm):15066                  LDU  TSTU0
                      (    forth6809.asm):15067                  RTS
                      (    forth6809.asm):15068         
C2E8                  (    forth6809.asm):15069         TSTBSNAME: FCB  7
                      (    forth6809.asm):15070                    FCC  "TSTBASE"

FB5C EC84             (    forth6809.asm):07752         ENVLOOP:    LDD   ,X
FB5E 10830000         (    forth6809.asm):07753                     CMPD  #0
FB62 272B             (    forth6809.asm):07754                     BEQ   ENV2START         ; end of table: try ENVTABLE2

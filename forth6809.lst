                      (    forth6809.asm):15054                  LDD  #TRUEV
                      (    forth6809.asm):15055                  BRA  BSDONE
C2E5                  (    forth6809.asm):15056         BSFAIL:  LDD  #FALSEV
C2E5                  (    forth6809.asm):15057         BSDONE:  LDX  #TSTBSNAME
                      (    forth6809.asm):15058                  PSHU X
                      (    forth6809.asm):15059                  PSHU D
                      (    forth6809.asm):15060                  JSR  TSTREPORT
                      (    forth6809.asm):15061         

                      (    forth6809.asm):08607         
                      (    forth6809.asm):08608                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):08609                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):08610                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):08611                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):08612                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):08613                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):08614                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):08615                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):08616                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):08617                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):08618                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):08619                                   ; but using the same dedicated buffer
                      (    forth6809.asm):08620                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):08621                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):08622                  STD   CODEHERE
                      (    forth6809.asm):08623         
                      (    forth6809.asm):08624                  LDD   #DUP
                      (    forth6809.asm):08625                  PSHU  D
                      (    forth6809.asm):08626                  JSR   ISW
                      (    forth6809.asm):08627         
                      (    forth6809.asm):08628                  STU   TSTU0
                      (    forth6809.asm):08629         
                      (    forth6809.asm):08630                  LDD   #TSTGUARD
                      (    forth6809.asm):08631                  PSHU  D
                      (    forth6809.asm):08632                  LDD   #TSTVAL1
                      (    forth6809.asm):08633                  PSHU  D
                      (    forth6809.asm):08634                  STU   TSTUB4
                      (    forth6809.asm):08635         
                      (    forth6809.asm):08636                  LDX   TSTWCFA
                      (    forth6809.asm):08637                  JSR   ,X
                      (    forth6809.asm):08638         
                      (    forth6809.asm):08639                  STU   TSTUAF
                      (    forth6809.asm):08640         

                      (    forth6809.asm):11127                         BNE  DFFAIL
                      (    forth6809.asm):11128                         PULU D
                      (    forth6809.asm):11129                         CMPD #TSTVAL1
                      (    forth6809.asm):11130                         BNE  DFFAIL
                      (    forth6809.asm):11131                         PULU D
                      (    forth6809.asm):11132                         CMPD #TSTGUARD
                      (    forth6809.asm):11133                         BNE  DFFAIL
                      (    forth6809.asm):11134         
                      (    forth6809.asm):11135                         LDD  TSTUB4
                      (    forth6809.asm):11136                         SUBD TSTUAF
                      (    forth6809.asm):11137                         CMPD #-2
                      (    forth6809.asm):11138                         BNE  DFFAIL
                      (    forth6809.asm):11139         
                      (    forth6809.asm):11140                         LDD  TSTCBUF
                      (    forth6809.asm):11141                         CMPD #TSTVAL1
                      (    forth6809.asm):11142                         BNE  DFFAIL

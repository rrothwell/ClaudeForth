                      (    forth6809.asm):15283                       PSHU D
                      (    forth6809.asm):15284                       STU  TSTUB4
                      (    forth6809.asm):15285         
                      (    forth6809.asm):15286                       JSR  THROW
                      (    forth6809.asm):15287         
                      (    forth6809.asm):15288                       STU  TSTUAF
                      (    forth6809.asm):15289         

                      (    forth6809.asm):07121                  JSR   CCALL
                      (    forth6809.asm):07122         
                      (    forth6809.asm):07123                  LDD   #10
                      (    forth6809.asm):07124                  PSHU  D
                      (    forth6809.asm):07125                  JSR   LITERALW
                      (    forth6809.asm):07126         

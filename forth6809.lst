DCE8 B7C008           (    forth6809.asm):01578                     STA   ACIACR
DCEB 12               (    forth6809.asm):01579                     NOP                     ; Settling Delay
DCEC 12               (    forth6809.asm):01580                     NOP
                      (    forth6809.asm):01581         
                      (    forth6809.asm):01582                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
DCED 8695             (    forth6809.asm):01583                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on

                      (    forth6809.asm):07896                  STD   CODEHERE
                      (    forth6809.asm):07897                  LDD   #TSTDBUF
                      (    forth6809.asm):07898                  STD   DPHERE
                      (    forth6809.asm):07899                  LDD   #TSTVBUF
                      (    forth6809.asm):07900                  STD   VARHERE
                      (    forth6809.asm):07901                  LDD   #TSTNAMEB
                      (    forth6809.asm):07902                  STD   SRCADDR
                      (    forth6809.asm):07903                  LDD   #6
                      (    forth6809.asm):07904                  STD   SRCLEN
                      (    forth6809.asm):07905                  LDD   #0
                      (    forth6809.asm):07906                  STD   TOIN
                      (    forth6809.asm):07907         

                      (    forth6809.asm):09815         ; ============================================================
                      (    forth6809.asm):09816         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):09817         ; ============================================================
                      (    forth6809.asm):09818                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):09819                                        ; entirely - every routine from here through
                      (    forth6809.asm):09820                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):09821                                        ; every primitive) would otherwise have
                      (    forth6809.asm):09822                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):09823                                        ; WARM message left the location counter,
                      (    forth6809.asm):09824                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):09825                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):09826                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):09827         
                      (    forth6809.asm):09828         ; ------------------------------------------------------------
                      (    forth6809.asm):09829         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):09830         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):09831         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):09832         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):09833         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):09834         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):09835         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):09836                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):09837                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):09838                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):09839                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):09840                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):09841                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):09842                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):09843                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):09844                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):09845                  RTS
                      (    forth6809.asm):09846         
                      (    forth6809.asm):09847                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):09848         ; ------------------------------------------------------------
                      (    forth6809.asm):09849         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):09850         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):09851         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):09852         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):09853         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):09854         INFILL:  LDA   INHEAD
                      (    forth6809.asm):09855                  SUBA  INTAIL
                      (    forth6809.asm):09856                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):09857                  RTS
                      (    forth6809.asm):09858         
                      (    forth6809.asm):09859         ; ------------------------------------------------------------
                      (    forth6809.asm):09860         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):09861         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):09862         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):09863         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):09864         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):09865         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):09866         ; flow control, not a chip feature.
                      (    forth6809.asm):09867         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):09868         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):09869                     CMPA #INHIWATER
                      (    forth6809.asm):09870                     BLO  RTSCHIDONE
                      (    forth6809.asm):09871                     TST  RTSSTATE
                      (    forth6809.asm):09872                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):09873                     LDA  #CR_RTSHI
                      (    forth6809.asm):09874                     STA  ACIACR
                      (    forth6809.asm):09875                     LDA  #1
                      (    forth6809.asm):09876                     STA  RTSSTATE
DEF5                  (    forth6809.asm):09877         RTSCHIDONE: RTS
                      (    forth6809.asm):09878         
                      (    forth6809.asm):09879         ; ------------------------------------------------------------
                      (    forth6809.asm):09880         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):09881         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):09882         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):09883         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):09884         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):09885         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):09886         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):09887         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):09888         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):09889         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):09890         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):09891                     CMPA #INLOWATER
                      (    forth6809.asm):09892                     BHI  RTSCLODONE
                      (    forth6809.asm):09893                     TST  RTSSTATE
                      (    forth6809.asm):09894                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):09895                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):09896                     CLR  RTSSTATE
                      (    forth6809.asm):09897                     LDB  OUTTAIL
                      (    forth6809.asm):09898                     CMPB OUTHEAD
                      (    forth6809.asm):09899                     BEQ  RTSCLONOTX
                      (    forth6809.asm):09900                     LDA  #CR_RXTX
                      (    forth6809.asm):09901                     STA  ACIACR
                      (    forth6809.asm):09902                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):09903         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):09904                     STA  ACIACR
DEF5                  (    forth6809.asm):09905         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):09906         RTSCLODONE: RTS
                      (    forth6809.asm):09907         
DEF5                  (    forth6809.asm):09908         IRQH:    LDA   ACIASR
                      (    forth6809.asm):09909                  BITA  #SR_IRQ
                      (    forth6809.asm):09910                  BEQ   IRQDONE
                      (    forth6809.asm):09911         
                      (    forth6809.asm):09912                  BITA  #SR_RDRF
                      (    forth6809.asm):09913                  BEQ   TXCHK
                      (    forth6809.asm):09914         
                      (    forth6809.asm):09915                  LDB   INHEAD
                      (    forth6809.asm):09916                  LDA   ACIADR
                      (    forth6809.asm):09917                  LDX   #INBUF
                      (    forth6809.asm):09918                  STA   B,X
                      (    forth6809.asm):09919                  INCB
                      (    forth6809.asm):09920                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):09921                  CMPB  INTAIL
                      (    forth6809.asm):09922                  BEQ   IRQDONE
                      (    forth6809.asm):09923                  STB   INHEAD
                      (    forth6809.asm):09924                  JSR   RTSCHECKHI
                      (    forth6809.asm):09925                  BRA   IRQDONE
                      (    forth6809.asm):09926         
DEF5                  (    forth6809.asm):09927         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):09928                  CMPB  OUTHEAD
                      (    forth6809.asm):09929                  BEQ   TXOFF
                      (    forth6809.asm):09930                  LDX   #OUTBUF
                      (    forth6809.asm):09931                  LDA   B,X
                      (    forth6809.asm):09932                  STA   ACIADR
                      (    forth6809.asm):09933                  INCB
                      (    forth6809.asm):09934                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):09935                  STB   OUTTAIL
                      (    forth6809.asm):09936                  BRA   IRQDONE
                      (    forth6809.asm):09937         
DEF5                  (    forth6809.asm):09938         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):09939                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):09940                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):09941                  LDA   #CR_RXON
                      (    forth6809.asm):09942                  STA   ACIACR
                      (    forth6809.asm):09943         
DEF5                  (    forth6809.asm):09944         IRQDONE: RTI
                      (    forth6809.asm):09945         
                      (    forth6809.asm):09946                  ELSE  ; <<<<<>>>>>

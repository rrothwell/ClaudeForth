                      (    forth6809.asm):03796                                             ; making the high-cell increment run
                      (    forth6809.asm):03797                                             ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03798                                             ; low-cell addition actually overflowed.
                      (    forth6809.asm):03799                                             ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03800                                             ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03801                                             ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03802                                             ; matching "always increment" rather than
                      (    forth6809.asm):03803                                             ; "increment only on genuine carry".

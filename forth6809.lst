E5E0 3706             (    forth6809.asm):03802         ELOK:       PULU  D                 ; orig1
E5E2 3406             (    forth6809.asm):03803                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E5E4 CCDEB2           (    forth6809.asm):03804                     LDD   #BRANCH
E5E7 3606             (    forth6809.asm):03805                     PSHU  D
E5E9 BDE99C           (    forth6809.asm):03806                     JSR   CCALL
E5EC CC0000           (    forth6809.asm):03807                     LDD   #0
E5EF 3606             (    forth6809.asm):03808                     PSHU  D
E5F1 BDDF26           (    forth6809.asm):03809                     JSR   CODECOMMA
E5F4 DC08             (    forth6809.asm):03810                     LDD   CODEHERE
E5F6 3606             (    forth6809.asm):03811                     PSHU  D
E5F8 3506             (    forth6809.asm):03812                     PULS  D                 ; orig1
E5FA 3606             (    forth6809.asm):03813                     PSHU  D
E5FC BDE596           (    forth6809.asm):03814                     JSR   PATCH
E5FF DC08             (    forth6809.asm):03815                     LDD   CODEHERE
E601 830002           (    forth6809.asm):03816                     SUBD  #2
E604 3606             (    forth6809.asm):03817                     PSHU  D                 ; orig2
E606 CC0001           (    forth6809.asm):03818                     LDD   #TAGFWD
E609 3606             (    forth6809.asm):03819                     PSHU  D
E60B 39               (    forth6809.asm):03820                     RTS
                      (    forth6809.asm):03821         
                      (    forth6809.asm):03822         ; ------------------------------------------------------------
                      (    forth6809.asm):03823         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03824         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03825         ; stack.
                      (    forth6809.asm):03826         ; ------------------------------------------------------------
E60C DC08             (    forth6809.asm):03827         BEGINW:     LDD   CODEHERE
E60E 3606             (    forth6809.asm):03828                     PSHU  D                 ; dest
E610 CC0002           (    forth6809.asm):03829                     LDD   #TAGBACK
E613 3606             (    forth6809.asm):03830                     PSHU  D
E615 39               (    forth6809.asm):03831                     RTS
                      (    forth6809.asm):03832         
                      (    forth6809.asm):03833         ; ------------------------------------------------------------
                      (    forth6809.asm):03834         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03835         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03836         ; ------------------------------------------------------------
E616 3706             (    forth6809.asm):03837         UNTILW:     PULU  D
E618 10830002         (    forth6809.asm):03838                     CMPD  #TAGBACK
E61C 2703             (    forth6809.asm):03839                     BEQ   UNOK
E61E BDE52C           (    forth6809.asm):03840                     JSR   CFERR
E621 3706             (    forth6809.asm):03841         UNOK:       PULU  D                 ; dest
E623 3606             (    forth6809.asm):03842                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E625 CCDE9C           (    forth6809.asm):03843                     LDD   #ZBRANCH
E628 3606             (    forth6809.asm):03844                     PSHU  D
E62A BDE99C           (    forth6809.asm):03845                     JSR   CCALL
E62D CC0000           (    forth6809.asm):03846                     LDD   #0
E630 3606             (    forth6809.asm):03847                     PSHU  D
E632 BDDF26           (    forth6809.asm):03848                     JSR   CODECOMMA
E635 DC08             (    forth6809.asm):03849                     LDD   CODEHERE
E637 830002           (    forth6809.asm):03850                     SUBD  #2
E63A 3606             (    forth6809.asm):03851                     PSHU  D                 ; location; the parked dest is beneath
E63C BDE596           (    forth6809.asm):03852                     JSR   PATCH
E63F 39               (    forth6809.asm):03853                     RTS
                      (    forth6809.asm):03854         
                      (    forth6809.asm):03855         ; ------------------------------------------------------------
                      (    forth6809.asm):03856         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03857         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03858         ; ------------------------------------------------------------
E640 3706             (    forth6809.asm):03859         AGAINW:     PULU  D
E642 10830002         (    forth6809.asm):03860                     CMPD  #TAGBACK
E646 2703             (    forth6809.asm):03861                     BEQ   AGOK
E648 BDE52C           (    forth6809.asm):03862                     JSR   CFERR
E64B 3706             (    forth6809.asm):03863         AGOK:       PULU  D                 ; dest
E64D 3606             (    forth6809.asm):03864                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E64F CCDEB2           (    forth6809.asm):03865                     LDD   #BRANCH
E652 3606             (    forth6809.asm):03866                     PSHU  D
E654 BDE99C           (    forth6809.asm):03867                     JSR   CCALL
E657 CC0000           (    forth6809.asm):03868                     LDD   #0
E65A 3606             (    forth6809.asm):03869                     PSHU  D
E65C BDDF26           (    forth6809.asm):03870                     JSR   CODECOMMA
E65F DC08             (    forth6809.asm):03871                     LDD   CODEHERE
E661 830002           (    forth6809.asm):03872                     SUBD  #2
E664 3606             (    forth6809.asm):03873                     PSHU  D                 ; location; the parked dest is beneath
E666 BDE596           (    forth6809.asm):03874                     JSR   PATCH
E669 39               (    forth6809.asm):03875                     RTS
                      (    forth6809.asm):03876         
                      (    forth6809.asm):03877         ; ------------------------------------------------------------
                      (    forth6809.asm):03878         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03879         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03880         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03881         ; ------------------------------------------------------------
E66A CCDE9C           (    forth6809.asm):03882         WHILEW:     LDD   #ZBRANCH
E66D 3606             (    forth6809.asm):03883                     PSHU  D
E66F BDE99C           (    forth6809.asm):03884                     JSR   CCALL
E672 CC0000           (    forth6809.asm):03885                     LDD   #0
E675 3606             (    forth6809.asm):03886                     PSHU  D
E677 BDDF26           (    forth6809.asm):03887                     JSR   CODECOMMA
E67A DC08             (    forth6809.asm):03888                     LDD   CODEHERE
E67C 830002           (    forth6809.asm):03889                     SUBD  #2
E67F 3606             (    forth6809.asm):03890                     PSHU  D                 ; orig
E681 CC0001           (    forth6809.asm):03891                     LDD   #TAGFWD
E684 3606             (    forth6809.asm):03892                     PSHU  D
E686 39               (    forth6809.asm):03893                     RTS
                      (    forth6809.asm):03894         
                      (    forth6809.asm):03895         ; ------------------------------------------------------------
                      (    forth6809.asm):03896         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03897         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03898         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03899         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03900         ; ------------------------------------------------------------
E687 3706             (    forth6809.asm):03901         REPEATW:    PULU  D
E689 10830001         (    forth6809.asm):03902                     CMPD  #TAGFWD
E68D 2703             (    forth6809.asm):03903                     BEQ   RPOK1
E68F BDE52C           (    forth6809.asm):03904                     JSR   CFERR
E692 3710             (    forth6809.asm):03905         RPOK1:      PULU  X                 ; orig
E694 3410             (    forth6809.asm):03906                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03907         
                      (    forth6809.asm):03908                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03909                     ; See bugfix: REPEATW.1
E696 3040             (    forth6809.asm):03910                     LEAX  0,U               ; scan from top of control stack
E698 9F16             (    forth6809.asm):03911                     STX   MSCR2             ; MSCR2 = base of scan region
E69A 9F1A             (    forth6809.asm):03912                     STX   MSCR4             ; MSCR4 = scan pointer
E69C DC1A             (    forth6809.asm):03913         RPSCAN:     LDD   MSCR4
E69E 109321           (    forth6809.asm):03914                     CMPD  CSP
E6A1 2603             (    forth6809.asm):03915                     BNE   RPSCANOK
E6A3 BDE52C           (    forth6809.asm):03916                     JSR   CFERR             ; no matching BEGIN
E6A6 9E1A             (    forth6809.asm):03917         RPSCANOK:   LDX   MSCR4
E6A8 EC84             (    forth6809.asm):03918                     LDD   ,X
E6AA 10830002         (    forth6809.asm):03919                     CMPD  #TAGBACK
E6AE 2712             (    forth6809.asm):03920                     BEQ   RPFOUND
E6B0 10830001         (    forth6809.asm):03921                     CMPD  #TAGFWD
E6B4 2703             (    forth6809.asm):03922                     BEQ   RPSKIP
E6B6 BDE52C           (    forth6809.asm):03923                     JSR   CFERR             ; anything else is a genuine mismatch
E6B9 DC1A             (    forth6809.asm):03924         RPSKIP:     LDD   MSCR4
E6BB C30004           (    forth6809.asm):03925                     ADDD  #4
E6BE DD1A             (    forth6809.asm):03926                     STD   MSCR4
E6C0 20DA             (    forth6809.asm):03927                     BRA   RPSCAN
E6C2 9E1A             (    forth6809.asm):03928         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E6C4 EC02             (    forth6809.asm):03929                     LDD   2,X               ; dest = BEGIN's address
E6C6 3406             (    forth6809.asm):03930                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03931         
                      (    forth6809.asm):03932                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03933                     ; bytes, highest word first.
E6C8 DC1A             (    forth6809.asm):03934                     LDD   MSCR4
E6CA 9316             (    forth6809.asm):03935                     SUBD  MSCR2
E6CC DD18             (    forth6809.asm):03936                     STD   MSCR3             ; MSCR3 = bytes to shift
E6CE 2715             (    forth6809.asm):03937                     BEQ   RPSHIFTDONE
E6D0 DC18             (    forth6809.asm):03938         RPSHIFT:    LDD   MSCR3
E6D2 830002           (    forth6809.asm):03939                     SUBD  #2
E6D5 DD18             (    forth6809.asm):03940                     STD   MSCR3
E6D7 9E16             (    forth6809.asm):03941                     LDX   MSCR2
E6D9 308B             (    forth6809.asm):03942                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E6DB EC84             (    forth6809.asm):03943                     LDD   ,X
E6DD 3004             (    forth6809.asm):03944                     LEAX  4,X
E6DF ED84             (    forth6809.asm):03945                     STD   ,X                ; copy one word 4 bytes higher
E6E1 DC18             (    forth6809.asm):03946                     LDD   MSCR3
E6E3 26EB             (    forth6809.asm):03947                     BNE   RPSHIFT
E6E5                  (    forth6809.asm):03948         RPSHIFTDONE:
E6E5 9E16             (    forth6809.asm):03949                     LDX   MSCR2
E6E7 3004             (    forth6809.asm):03950                     LEAX  4,X
E6E9 1F13             (    forth6809.asm):03951                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03952         
E6EB CCDEB2           (    forth6809.asm):03953                     LDD   #BRANCH
E6EE 3606             (    forth6809.asm):03954                     PSHU  D
E6F0 BDE99C           (    forth6809.asm):03955                     JSR   CCALL
E6F3 CC0000           (    forth6809.asm):03956                     LDD   #0
E6F6 3606             (    forth6809.asm):03957                     PSHU  D
E6F8 BDDF26           (    forth6809.asm):03958                     JSR   CODECOMMA
E6FB EC60             (    forth6809.asm):03959                     LDD   0,S               ; target = BEGIN's address
E6FD 3606             (    forth6809.asm):03960                     PSHU  D
E6FF DC08             (    forth6809.asm):03961                     LDD   CODEHERE
E701 830002           (    forth6809.asm):03962                     SUBD  #2                ; location = the operand just compiled
E704 3606             (    forth6809.asm):03963                     PSHU  D
E706 BDE596           (    forth6809.asm):03964                     JSR   PATCH
E709 DC08             (    forth6809.asm):03965                     LDD   CODEHERE
E70B 3606             (    forth6809.asm):03966                     PSHU  D
E70D EC62             (    forth6809.asm):03967                     LDD   2,S               ; orig
E70F 3606             (    forth6809.asm):03968                     PSHU  D
E711 BDE596           (    forth6809.asm):03969                     JSR   PATCH
E714 3264             (    forth6809.asm):03970                     LEAS  4,S               ; drop the frame
E716 39               (    forth6809.asm):03971                     RTS
                      (    forth6809.asm):03972         
                      (    forth6809.asm):03973         ; ------------------------------------------------------------
                      (    forth6809.asm):03974         ; RECURSE  ( -- )
                      (    forth6809.asm):03975         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03976         ; the xt held in CURXT.
                      (    forth6809.asm):03977         ; ------------------------------------------------------------
E717 DC1F             (    forth6809.asm):03978         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E719 3606             (    forth6809.asm):03979                     PSHU  D                 ; See bugfix: RECURSEW.1
E71B BDE99C           (    forth6809.asm):03980                     JSR   CCALL
E71E 39               (    forth6809.asm):03981                     RTS
                      (    forth6809.asm):03982         
                      (    forth6809.asm):03983         ; ------------------------------------------------------------
                      (    forth6809.asm):03984         ; DO  ( C: -- dest )
                      (    forth6809.asm):03985         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03986         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03987         ; ------------------------------------------------------------
E71F CCE731           (    forth6809.asm):03988         DOW:        LDD   #DOSETUP
E722 3606             (    forth6809.asm):03989                     PSHU  D
E724 BDE99C           (    forth6809.asm):03990                     JSR   CCALL
E727 DC08             (    forth6809.asm):03991                     LDD   CODEHERE
E729 3606             (    forth6809.asm):03992                     PSHU  D                 ; dest
E72B CC0003           (    forth6809.asm):03993                     LDD   #TAGDO
E72E 3606             (    forth6809.asm):03994                     PSHU  D
E730 39               (    forth6809.asm):03995                     RTS
                      (    forth6809.asm):03996         
                      (    forth6809.asm):03997         ; ------------------------------------------------------------
                      (    forth6809.asm):03998         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03999         ; return address.
                      (    forth6809.asm):04000         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04001         ;    Inputs:
                      (    forth6809.asm):04002         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04003         ;    Outputs:
                      (    forth6809.asm):04004         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04005         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04006         ; ------------------------------------------------------------
E731 3706             (    forth6809.asm):04007         DOSETUP:    PULU  D                 ; index
E733 DD14             (    forth6809.asm):04008                     STD   MSCR
E735 3706             (    forth6809.asm):04009                     PULU  D                 ; limit
E737 DD16             (    forth6809.asm):04010                     STD   MSCR2
E739 3510             (    forth6809.asm):04011                     PULS  X
E73B CC0000           (    forth6809.asm):04012                     LDD   #0
E73E 3406             (    forth6809.asm):04013                     PSHS  D
E740 DC16             (    forth6809.asm):04014                     LDD   MSCR2
E742 3406             (    forth6809.asm):04015                     PSHS  D
E744 DC14             (    forth6809.asm):04016                     LDD   MSCR
E746 3406             (    forth6809.asm):04017                     PSHS  D
E748 3410             (    forth6809.asm):04018                     PSHS  X
E74A 39               (    forth6809.asm):04019                     RTS
                      (    forth6809.asm):04020         
                      (    forth6809.asm):04021         ; ------------------------------------------------------------
                      (    forth6809.asm):04022         ; I  ( -- n )
                      (    forth6809.asm):04023         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04024         ; address).
                      (    forth6809.asm):04025         ; ------------------------------------------------------------
E74B EC62             (    forth6809.asm):04026         IW:         LDD   2,S               ; n. See bugfix: IW.1
E74D 3606             (    forth6809.asm):04027                     PSHU  D
E74F 39               (    forth6809.asm):04028                     RTS
                      (    forth6809.asm):04029         
                      (    forth6809.asm):04030         ; ------------------------------------------------------------
                      (    forth6809.asm):04031         ; J  ( -- n )
                      (    forth6809.asm):04032         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04033         ; address and the inner loop frame).
                      (    forth6809.asm):04034         ; ------------------------------------------------------------
E750 EC68             (    forth6809.asm):04035         JW:         LDD   8,S               ; n. See bugfix: JW.1
E752 3606             (    forth6809.asm):04036                     PSHU  D
E754 39               (    forth6809.asm):04037                     RTS
                      (    forth6809.asm):04038         
                      (    forth6809.asm):04039         ; ------------------------------------------------------------
                      (    forth6809.asm):04040         ; LEAVE  ( -- )
                      (    forth6809.asm):04041         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04042         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04043         ; ------------------------------------------------------------
E755 CCFFFF           (    forth6809.asm):04044         LEAVEW:     LDD   #TRUEV            ; true
E758 ED66             (    forth6809.asm):04045                     STD   6,S               ; See bugfix: LEAVEW.1
E75A 39               (    forth6809.asm):04046                     RTS
                      (    forth6809.asm):04047         
                      (    forth6809.asm):04048         ; ------------------------------------------------------------
                      (    forth6809.asm):04049         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04050         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04051         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04052         ; ------------------------------------------------------------
E75B 3706             (    forth6809.asm):04053         LOOPW:      PULU  D
E75D 10830003         (    forth6809.asm):04054                     CMPD  #TAGDO
E761 2703             (    forth6809.asm):04055                     BEQ   LOOPOK
E763 BDE52C           (    forth6809.asm):04056                     JSR   CFERR
E766 3706             (    forth6809.asm):04057         LOOPOK:     PULU  D                 ; dest
E768 3606             (    forth6809.asm):04058                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E76A CCE79A           (    forth6809.asm):04059                     LDD   #DOTEST
E76D 3606             (    forth6809.asm):04060                     PSHU  D
E76F BDE99C           (    forth6809.asm):04061                     JSR   CCALL
E772 CC0000           (    forth6809.asm):04062                     LDD   #0
E775 3606             (    forth6809.asm):04063                     PSHU  D
E777 BDDF26           (    forth6809.asm):04064                     JSR   CODECOMMA
E77A DC08             (    forth6809.asm):04065                     LDD   CODEHERE
E77C 830002           (    forth6809.asm):04066                     SUBD  #2
E77F 3606             (    forth6809.asm):04067                     PSHU  D                 ; location; the parked dest is beneath
E781 BDE596           (    forth6809.asm):04068                     JSR   PATCH
                      (    forth6809.asm):04069         
E784 ECC4             (    forth6809.asm):04070                     LDD   ,U
E786 10830007         (    forth6809.asm):04071                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E78A 260D             (    forth6809.asm):04072                     BNE   LOOPDONE
E78C 3706             (    forth6809.asm):04073                     PULU  D
E78E 3710             (    forth6809.asm):04074                     PULU  X                 ; ?DO skip operand
E790 DC08             (    forth6809.asm):04075                     LDD   CODEHERE
E792 3606             (    forth6809.asm):04076                     PSHU  D
E794 3610             (    forth6809.asm):04077                     PSHU  X
E796 BDE596           (    forth6809.asm):04078                     JSR   PATCH
E799 39               (    forth6809.asm):04079         LOOPDONE:   RTS
                      (    forth6809.asm):04080         
                      (    forth6809.asm):04081         ; ------------------------------------------------------------
                      (    forth6809.asm):04082         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04083         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04084         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04085         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04086         ; DOTEST
                      (    forth6809.asm):04087         ;    Inputs:
                      (    forth6809.asm):04088         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04089         ;        first)
                      (    forth6809.asm):04090         ;    Outputs:
                      (    forth6809.asm):04091         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04092         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04093         ; ------------------------------------------------------------
E79A EC66             (    forth6809.asm):04094         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E79C 2615             (    forth6809.asm):04095                     BNE   DTEXIT            ; set: exit
E79E EC62             (    forth6809.asm):04096                     LDD   2,S               ; index
E7A0 C30001           (    forth6809.asm):04097                     ADDD  #1
E7A3 ED62             (    forth6809.asm):04098                     STD   2,S
E7A5 10A364           (    forth6809.asm):04099                     CMPD  4,S               ; limit
E7A8 2709             (    forth6809.asm):04100                     BEQ   DTEXIT
E7AA 3510             (    forth6809.asm):04101                     PULS  X                 ; X = branch operand address
E7AC EC84             (    forth6809.asm):04102                     LDD   ,X
E7AE 308B             (    forth6809.asm):04103                     LEAX  D,X
E7B0 3410             (    forth6809.asm):04104                     PSHS  X                 ; return to loop start
E7B2 39               (    forth6809.asm):04105                     RTS
E7B3 3510             (    forth6809.asm):04106         DTEXIT:     PULS  X
E7B5 3002             (    forth6809.asm):04107                     LEAX  2,X               ; skip the branch operand
E7B7 3266             (    forth6809.asm):04108                     LEAS  6,S               ; discard the loop frame
E7B9 3410             (    forth6809.asm):04109                     PSHS  X

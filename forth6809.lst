                      (    forth6809.asm):08266                    STD  VARHERE
                      (    forth6809.asm):08267                    LDD  #TSTNAMEB
                      (    forth6809.asm):08268                    STD  SRCADDR
                      (    forth6809.asm):08269                    LDD  #6
                      (    forth6809.asm):08270                    STD  SRCLEN
                      (    forth6809.asm):08271                    LDD  #0
                      (    forth6809.asm):08272                    STD  TOIN

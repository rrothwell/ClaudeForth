                      (    forth6809.asm):04910         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):04911         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):04912         ; return address of this call is on top of S, so it is lifted off and

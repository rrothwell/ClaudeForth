                      (    forth6809.asm):03939         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03940         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03941         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03942         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03943         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03944         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03945         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03946         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03947         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03948         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03949         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03950         ; ------------------------------------------------------------
C1D3 BDFC2B           (    forth6809.asm):03951         TSTDARITH: JSR   CRW
C1D6 8EC1E7           (    forth6809.asm):03952                    LDX   #TSTDARITHMSG
C1D9 3610             (    forth6809.asm):03953                    PSHU  X
C1DB CC000B           (    forth6809.asm):03954                    LDD   #11
C1DE 3606             (    forth6809.asm):03955                    PSHU  D
C1E0 BDF60B           (    forth6809.asm):03956                    JSR   TYPE
C1E3 BDFC2B           (    forth6809.asm):03957                    JSR   CRW
                      (    forth6809.asm):03958         
                      (    forth6809.asm):03959                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03960         
                      (    forth6809.asm):03961                    JSR   TSTUMST

                      (    forth6809.asm):03781                  INCB
                      (    forth6809.asm):03782                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03783                  STB   OUTHEAD
                      (    forth6809.asm):03784                  TST   RTSSTATE

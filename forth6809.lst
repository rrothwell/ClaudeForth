                      (    forth6809.asm):05471         
                      (    forth6809.asm):05472         ; ------------------------------------------------------------
                      (    forth6809.asm):05473         ; [  ( -- )
                      (    forth6809.asm):05474         ; Enter interpretation state: STATE = 0.
                      (    forth6809.asm):05475         ; ------------------------------------------------------------
DDFF CC0000           (    forth6809.asm):05476         LBRACKETW:  LDD   #0
DE02 DD00             (    forth6809.asm):05477                     STD   STATE
DE04 39               (    forth6809.asm):05478                     RTS
                      (    forth6809.asm):05479         
                      (    forth6809.asm):05480         ; ------------------------------------------------------------
                      (    forth6809.asm):05481         ; ]  ( -- )
                      (    forth6809.asm):05482         ; Enter compilation state: STATE = -1.
                      (    forth6809.asm):05483         ; ------------------------------------------------------------
DE05 CCFFFF           (    forth6809.asm):05484         RBRACKETW:  LDD   #-1
DE08 DD00             (    forth6809.asm):05485                     STD   STATE
DE0A 39               (    forth6809.asm):05486                     RTS

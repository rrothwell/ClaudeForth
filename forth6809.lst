                      (    forth6809.asm):04582         ; ------------------------------------------------------------
                      (    forth6809.asm):04583         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04584         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04585         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04586         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04587         ; ------------------------------------------------------------
D97F 335E             (    forth6809.asm):04588         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
D981 CC0000           (    forth6809.asm):04589                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5

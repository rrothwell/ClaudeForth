                      (    forth6809.asm):07336         
FBAC 8EFBEC           (    forth6809.asm):07337         ENV2START: LDX  #ENVTABLE2  ; NEW: double-cell query table - kept
                      (    forth6809.asm):07338                                     ; entirely separate from ENVTABLE above
                      (    forth6809.asm):07339                                     ; rather than trying to unify both cases
                      (    forth6809.asm):07340                                     ; into one mechanism, since the two
                      (    forth6809.asm):07341                                     ; genuinely differ in entry size (8 bytes

                      (    forth6809.asm):03458                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03459                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03460                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03461                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03462                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03463                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03464                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03465                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03466                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03467                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03468                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03469                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03470                  ; for it.
E573 D621             (    forth6809.asm):03471                  LDB   CNTREM
E575 5A               (    forth6809.asm):03472                  DECB
E576 A685             (    forth6809.asm):03473                  LDA   B,X
E578 812E             (    forth6809.asm):03474                  CMPA  #'.'
E57A 2604             (    forth6809.asm):03475                  BNE   NQNOSIGN
E57C 0A21             (    forth6809.asm):03476                  DEC   CNTREM
E57E 2766             (    forth6809.asm):03477                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03478         
E580 0F22             (    forth6809.asm):03479         NQNOSIGN: CLR   NUMNEG
E582 A684             (    forth6809.asm):03480                  LDA   ,X
E584 812D             (    forth6809.asm):03481                  CMPA  #'-'
E586 2608             (    forth6809.asm):03482                  BNE   NQNOSIGN2
E588 0322             (    forth6809.asm):03483                  COM   NUMNEG
E58A 3001             (    forth6809.asm):03484                  LEAX  1,X
E58C 0A21             (    forth6809.asm):03485                  DEC   CNTREM
E58E 2756             (    forth6809.asm):03486                  BEQ   NQBAD
                      (    forth6809.asm):03487         
E590 9F23             (    forth6809.asm):03488         NQNOSIGN2: STX  NADDR

                      (    forth6809.asm):04146         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04147         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04148         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04149         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04150         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04151         ;    Inputs:
                      (    forth6809.asm):04152         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04153         ;    Outputs:
                      (    forth6809.asm):04154         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04155         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04156         ;        scratch.
                      (    forth6809.asm):04157         ; ------------------------------------------------------------

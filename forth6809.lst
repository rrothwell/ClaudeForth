E688 CC0000           (    forth6809.asm):03930                     LDD   #0
E68B 3606             (    forth6809.asm):03931                     PSHU  D
E68D BDDE76           (    forth6809.asm):03932                     JSR   CODECOMMA
E690 EC60             (    forth6809.asm):03933                     LDD   0,S               ; target = BEGIN's address
E692 3606             (    forth6809.asm):03934                     PSHU  D
E694 DC08             (    forth6809.asm):03935                     LDD   CODEHERE
E696 830002           (    forth6809.asm):03936                     SUBD  #2                ; location = the operand just compiled
E699 3606             (    forth6809.asm):03937                     PSHU  D
E69B BDE52B           (    forth6809.asm):03938                     JSR   PATCH
E69E DC08             (    forth6809.asm):03939                     LDD   CODEHERE
E6A0 3606             (    forth6809.asm):03940                     PSHU  D
E6A2 EC62             (    forth6809.asm):03941                     LDD   2,S               ; orig
E6A4 3606             (    forth6809.asm):03942                     PSHU  D
E6A6 BDE52B           (    forth6809.asm):03943                     JSR   PATCH

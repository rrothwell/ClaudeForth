                      (    forth6809.asm):03612         ; KEY ( -- char )
                      (    forth6809.asm):03613         ; ------------------------------------------------------------
E613                  (    forth6809.asm):03614         KEY:
                      (    forth6809.asm):03615         
E613 7D0178           (    forth6809.asm):03616                     TST   RTSSTATE         ; Is throttling?
E616 2703             (    forth6809.asm):03617                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03618         
                      (    forth6809.asm):03619                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03620                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03621                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03622                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03623                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03624                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03625                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03626                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03627                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03628                     ; the receiver interrupt here at all.
E618 BDDDBD           (    forth6809.asm):03629                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03630                                             ; by transmitting all chars.
                      (    forth6809.asm):03631         
E61B                  (    forth6809.asm):03632         TRY_READ:
E61B BDDE2C           (    forth6809.asm):03633                     JSR   GETCHAR           ; Is char available in input buffer.
E61E 25F3             (    forth6809.asm):03634                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03635                                             ; while still transmitting!
                      (    forth6809.asm):03636                 
E620 1F89             (    forth6809.asm):03637                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E622 4F               (    forth6809.asm):03638                     CLRA                    ; Clear MSB.
E623 3606             (    forth6809.asm):03639                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03640         
E625 39               (    forth6809.asm):03641                     RTS                     
                      (    forth6809.asm):03642         
                      (    forth6809.asm):03643         ; ------------------------------------------------------------
                      (    forth6809.asm):03644         ; KEY? ( -- flag )
                      (    forth6809.asm):03645         ; ------------------------------------------------------------
E626                  (    forth6809.asm):03646         KEYQ:  
                      (    forth6809.asm):03647                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03648         
E626 B60176           (    forth6809.asm):03649                     LDA   INHEAD            ; Characters received?
E629 B10177           (    forth6809.asm):03650                     CMPA  INTAIL
                      (    forth6809.asm):03651         

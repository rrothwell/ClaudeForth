                      (    forth6809.asm):05952         ; value should match ORG INITCODE.
     FECD             (    forth6809.asm):05953         BASECODEEND  EQU   *
     1ED9             (    forth6809.asm):05954         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):05955         
                      (    forth6809.asm):05956         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):05957         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):05958         ; .bin file.
FECD                  (    forth6809.asm):05959         BASEND:

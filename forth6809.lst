                      (    forth6809.asm):08256                    LDA  #'W'
                      (    forth6809.asm):08257                    STA  TSTNAMEB+4
                      (    forth6809.asm):08258                    LDA  #'D'
                      (    forth6809.asm):08259                    STA  TSTNAMEB+5
                      (    forth6809.asm):08260         

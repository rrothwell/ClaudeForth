                      (    forth6809.asm):14071         ; TSTNUMSIGN - unit test for #. Converts one digit of 25 (base
                      (    forth6809.asm):14072         ; 10, ud1 = (25, 0)) - verifies the held character is '5' (the
                      (    forth6809.asm):14073         ; least-significant digit, processed first per the standard
                      (    forth6809.asm):14074         ; pictured-output convention) and the returned ud2 is the
                      (    forth6809.asm):14075         ; quotient (2, 0).
                      (    forth6809.asm):14076         ; ------------------------------------------------------------
C2CE                  (    forth6809.asm):14077         TSTNUMSIGN: LDD  CODEHERE
                      (    forth6809.asm):14078                     STD  TSTCSAV
                      (    forth6809.asm):14079                     LDD  BASE

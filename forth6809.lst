                      (    forth6809.asm):00332         ; Ring buffers for serial communications.
                      (    forth6809.asm):00333         ; One for input, one for output.
                      (    forth6809.asm):00334         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00335         ; The tricks are not used.
                      (    forth6809.asm):00336         ; ------------------------------------------------------------
                      (    forth6809.asm):00337                     ORG   SERBUFCTL         ; $176.
                      (    forth6809.asm):00338         
0176                  (    forth6809.asm):00339         INHEAD      RMB   1
0177                  (    forth6809.asm):00340         INTAIL      RMB   1
                      (    forth6809.asm):00341         ; Open question moved to shadow: RTSSTATE.1
0178                  (    forth6809.asm):00342         RTSSTATE    RMB   1                 ; $00 = RTS low, $FF = RTS high
                      (    forth6809.asm):00343         
0179                  (    forth6809.asm):00344         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00345         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00346         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00347         
017C                  (    forth6809.asm):00348         FECOUNT     RMB   1                 ; framing errors
017D                  (    forth6809.asm):00349         OVRNCOUNT   RMB   1                 ; overrun count, same as above
017E                  (    forth6809.asm):00350         PECOUNT     RMB   1                 ; parity-error count, same as above
017F                  (    forth6809.asm):00351         POLLREADYCNT
017F                  (    forth6809.asm):00352                     RMB   1                 ; polling build; see shadow POLLREADYCNT.1
                      (    forth6809.asm):00353         
                      (    forth6809.asm):00354                     ORG   SERBUF            ; $180, a 64 byte boundary.
                      (    forth6809.asm):00355         
                      (    forth6809.asm):00356                     ALIGN 64                ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00357         INBUF       RMB   INBUFSZ           ; Receive circular queue buffer
                      (    forth6809.asm):00358         
                      (    forth6809.asm):00359                     ALIGN 64                ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00360         OUTBUF      RMB   OUTBUFSZ          ; Transmit circular queue buffer
                      (    forth6809.asm):00361         
                      (    forth6809.asm):00362         ; ------------------------------------------------------------
                      (    forth6809.asm):00363         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00364         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00365         ; ------------------------------------------------------------
                      (    forth6809.asm):00366                     ORG   USROMSTRT
                      (    forth6809.asm):00367         
                      (    forth6809.asm):00368         ; ------------------------------------------------------------
                      (    forth6809.asm):00369         ; Optional word sets, to recover ROM when the board does not need
                      (    forth6809.asm):00370         ; them. Each switch removes both the dictionary headers and the code
                      (    forth6809.asm):00371         ; of its words; the headers and code are two contiguous blocks.
                      (    forth6809.asm):00372         ; STRINGSET: String word set: /STRING -TRAILING SEARCH BLANK SLITERAL
                      (    forth6809.asm):00373         ;            and the headers of CMOVE CMOVE> COMPARE (their code is
                      (    forth6809.asm):00374         ;            always kept because MOVE and ENVIRONMENT? use it).
                      (    forth6809.asm):00375         ; STRINGEXT: String extension: UNESCAPE REPLACES CLR-REPLACES
                      (    forth6809.asm):00376         ;            SUBSTITUTE. Set with lwasm -DSTRINGSET=0 -DSTRINGEXT=0.
                      (    forth6809.asm):00377         ; SNAME (xt to name, all wordlists) is not a string word; it is
                      (    forth6809.asm):00378         ; always kept for the disassembler/decompiler.
                      (    forth6809.asm):00379         ; DISASM:    Disassembler words DASM and DIS (about 1.8 KB of ROM). The
                      (    forth6809.asm):00380         ;            constants BASECODE and BASEDICT above depend on it. Set
                      (    forth6809.asm):00381         ;            with lwasm -DDISASM=0. The larger unit test groups do
                      (    forth6809.asm):00382         ;            not fit below the dictionary when DISASM is 1.
                      (    forth6809.asm):00383         ; DECOMP:    Decompiler word SEE (about 0.9 KB more; needs DISASM=1).
                      (    forth6809.asm):00384         ;            Set with lwasm -DDECOMP=0. See SECTION 28.
                      (    forth6809.asm):00385         ; The unit tests need both set to 1.
                      (    forth6809.asm):00386         ; ------------------------------------------------------------
                      (    forth6809.asm):00387                     IFNDEF STRINGSET
     0001             (    forth6809.asm):00388         STRINGSET   SET   1                 ; default if -D not passed
                      (    forth6809.asm):00389                     ENDC
                      (    forth6809.asm):00390                     IFNDEF STRINGEXT
     0001             (    forth6809.asm):00391         STRINGEXT   SET   1                 ; default if -D not passed
                      (    forth6809.asm):00392                     ENDC
                      (    forth6809.asm):00393         
                      (    forth6809.asm):00394                     IFNDEF UNITTESTS
C100                  (    forth6809.asm):00395         UNITTESTS   SET   0                 ; default if -D not passed
                      (    forth6809.asm):00396                     ; Default 0: unit tests excluded; -DUNITTESTS=1 includes them.
                      (    forth6809.asm):00397                     ; Original comment: shadow UNITTESTS.1.
                      (    forth6809.asm):00398                     ENDC
                      (    forth6809.asm):00399         
                      (    forth6809.asm):00400                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00401         TSTSELECTOR SET   2                 ; default if -D not passed
                      (    forth6809.asm):00402                     ENDC
                      (    forth6809.asm):00403         
                      (    forth6809.asm):00404                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):00405         
                      (    forth6809.asm):00406         ; ------------------------------------------------------------
                      (    forth6809.asm):00407         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00408         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00409         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00410         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00411         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00412         ; ------------------------------------------------------------
                      (    forth6809.asm):00413                     IFEQ  STRINGSET*STRINGEXT
                      (    forth6809.asm):00414                     ERROR "UNITTESTS=1 needs STRINGSET=1 and STRINGEXT=1"
                      (    forth6809.asm):00415                     ENDC
                      (    forth6809.asm):00416                     INCLUDE unit_tests.asm
                      (    forth6809.asm):00417         
                      (    forth6809.asm):00418                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):00419         
     C100             (    forth6809.asm):00420         TSTEND     EQU *                   ; Mark where tests end to size spare space.
                      (    forth6809.asm):00421         

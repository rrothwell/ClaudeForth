                      (    forth6809.asm):17639                  LDA   #CR_RXON
                      (    forth6809.asm):17640                  STA   ACIACR
                      (    forth6809.asm):17641         
DEF5                  (    forth6809.asm):17642         IRQDONE: RTI
                      (    forth6809.asm):17643         
                      (    forth6809.asm):17644                  ELSE  ; <<<<<>>>>>

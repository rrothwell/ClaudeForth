                      (    forth6809.asm):03248         ; ------------------------------------------------------------
                      (    forth6809.asm):03249         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03250         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03251         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03252         ;    Inputs:
                      (    forth6809.asm):03253         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03254         ;    Outputs:
                      (    forth6809.asm):03255         ;        single number: n and -1
                      (    forth6809.asm):03256         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03257         ;        not a number: c-addr and 0
                      (    forth6809.asm):03258         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03259         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03260         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03261         ; NUMBERQ.6.
                      (    forth6809.asm):03262         ; ------------------------------------------------------------
E33A 3710             (    forth6809.asm):03263         NUMBERQ:    PULU  X                 ; c-addr
E33C 327D             (    forth6809.asm):03264                     LEAS  -3,S
E33E AFE4             (    forth6809.asm):03265                     STX   ,S
E340 E684             (    forth6809.asm):03266                     LDB   ,X
E342 276D             (    forth6809.asm):03267                     BEQ   NQBAD
E344 3001             (    forth6809.asm):03268                     LEAX  1,X
                      (    forth6809.asm):03269         
                      (    forth6809.asm):03270                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03271                     ; digit count. See shadow: NUMBERQ.1
E346 5A               (    forth6809.asm):03272                     DECB
E347 A685             (    forth6809.asm):03273                     LDA   B,X
E349 5C               (    forth6809.asm):03274                     INCB
E34A 812E             (    forth6809.asm):03275                     CMPA  #'.'
E34C 2603             (    forth6809.asm):03276                     BNE   NQNOSIGN
E34E 5A               (    forth6809.asm):03277                     DECB
E34F 2760             (    forth6809.asm):03278                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03279         

                      (    forth6809.asm):13010         ; TSTSEARCH1 - unit test for SEARCH, found case. Haystack
                      (    forth6809.asm):13011         ; "HELLOWORLD", needle "WOR" - verifies the returned addr3 lands
                      (    forth6809.asm):13012         ; exactly at the match position (not just that flag is true),
                      (    forth6809.asm):13013         ; len3 equals the needle's own length, and flag is true.
                      (    forth6809.asm):13014         ; ------------------------------------------------------------

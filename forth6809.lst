                      (   unit_tests.asm):08892         ; TSTMARKER - unit test for MARKER. Compiles "MARKER TESTWD"
                      (   unit_tests.asm):08893         ; (CODEHERE/DPHERE/VARHERE redirected to scratch, as with every
                      (   unit_tests.asm):08894         ; other test in this section), then simulates "something was
                      (   unit_tests.asm):08895         ; defined after the marker" by manually advancing the redirected
                      (   unit_tests.asm):08896         ; pointers further and pointing the real LATEST elsewhere,
                      (   unit_tests.asm):08897         ; executes the marker word, and verifies everything was restored
                      (   unit_tests.asm):08898         ; to TSTCBUF/TSTDBUF/TSTVBUF directly - the state BEFORE the
                      (   unit_tests.asm):08899         ; marker word itself was created, not the state right after.
                      (   unit_tests.asm):08900         ; MARKER's own documented behavior is "forgets itself too" -
                      (   unit_tests.asm):08901         ; traced MARKERW's own code and confirmed its internal snapshot
                      (   unit_tests.asm):08902         ; is taken at its very start, before HEADER or any compiling
                      (   unit_tests.asm):08903         ; runs at all, so that's genuinely the correct restore target,
                      (   unit_tests.asm):08904         ; not assumed.
                      (   unit_tests.asm):08905         ;
                      (   unit_tests.asm):08906         ; DOMARKER (confirmed by reading it directly) writes to the
                      (   unit_tests.asm):08907         ; real DPHERE/CODEHERE/VARHERE/LATEST unconditionally, not to
                      (   unit_tests.asm):08908         ; any redirected copy - so this test must execute the marker
                      (   unit_tests.asm):08909         ; word while CODEHERE/DPHERE/VARHERE are still redirected (their
                      (   unit_tests.asm):08910         ; real values are restored only afterward), unlike every other
                      (   unit_tests.asm):08911         ; test in this section, which restores first and executes
                      (   unit_tests.asm):08912         ; second. Getting this order backwards would have corrupted the
                      (   unit_tests.asm):08913         ; real dictionary pointers with scratch addresses.
                      (   unit_tests.asm):08914         ; ------------------------------------------------------------

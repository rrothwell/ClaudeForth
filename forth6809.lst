                      (    forth6809.asm):12796         ; TSTDOTQUOTE - unit test for .". No STATE check at all in its
                      (    forth6809.asm):12797         ; own code (confirmed by reading it directly - matches "no
                      (    forth6809.asm):12798         ; interpretation semantics, per ANS" without a specific -14
                      (    forth6809.asm):12799         ; throw, unlike [CHAR]/S"), so only the compiling case is
                      (    forth6809.asm):12800         ; tested, matching how it's actually meant to be used. Its own
                      (    forth6809.asm):12801         ; runtime (DOTSTR) calls TYPE internally, which has two entirely
                      (    forth6809.asm):12802         ; different implementations gated by SERIALPOLL (the same real
                      (    forth6809.asm):12803         ; finding from section 3.1) - applying that lesson from the
                      (    forth6809.asm):12804         ; start here rather than re-discovering it: EMITCH works
                      (    forth6809.asm):12805         ; universally for a single-character check, but this outputs
                      (    forth6809.asm):12806         ; multiple characters, so - matching TSTCR's own established
                      (    forth6809.asm):12807         ; fix - the full OUTHEAD/OUTBUF check only applies under
                      (    forth6809.asm):12808         ; SERIALPOLL=0, with a narrower EMITCH-based check (last
                      (    forth6809.asm):12809         ; character only, plus the stack-depth check) for SERIALPOLL=1.
                      (    forth6809.asm):12810         ; ------------------------------------------------------------
C2B4                  (    forth6809.asm):12811         TSTDOTQUOTE: LDD  CODEHERE
                      (    forth6809.asm):12812                      STD  TSTCSAV
                      (    forth6809.asm):12813                      LDD  SRCADDR
                      (    forth6809.asm):12814                      STD  TSTSASAV
                      (    forth6809.asm):12815                      LDD  SRCLEN
                      (    forth6809.asm):12816                      STD  TSTSLSAV
                      (    forth6809.asm):12817                      LDD  TOIN
                      (    forth6809.asm):12818                      STD  TSTTISAV
                      (    forth6809.asm):12819         
                      (    forth6809.asm):12820                      LDA  #'H'
                      (    forth6809.asm):12821                      STA  TSTNAMEB
                      (    forth6809.asm):12822                      LDA  #'I'
                      (    forth6809.asm):12823                      STA  TSTNAMEB+1
                      (    forth6809.asm):12824                      LDA  #34
                      (    forth6809.asm):12825                      STA  TSTNAMEB+2
                      (    forth6809.asm):12826         

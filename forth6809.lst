                      (    forth6809.asm):02097                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):02098                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):02099                                   ; were chained on after it; before that,
                      (    forth6809.asm):02100                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):02101                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):02102                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):02103                                   ; before this one.
                      (    forth6809.asm):02104         
                      (    forth6809.asm):02105         ; Verify no collision with base code.
                      (    forth6809.asm):02106         ; Value should match ORG BASECODE
     DD54             (    forth6809.asm):02107         BASEDICTEND  EQU   *

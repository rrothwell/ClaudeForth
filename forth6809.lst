                      (    forth6809.asm):02227         
                      (    forth6809.asm):02228                     LDA   ACIASR           ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02229                     BITA  #SR_CTS
                      (    forth6809.asm):02230                     BNE   FLUSHED          ; Yes! Exit.
                      (    forth6809.asm):02231         
                      (    forth6809.asm):02232                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02233                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02234                                              ; than spin-wait here.
                      (    forth6809.asm):02235         

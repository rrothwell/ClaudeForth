                      (    forth6809.asm):06720         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06721         ; address and length and skip over it.
                      (    forth6809.asm):06722         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06723         ;    Inputs:
                      (    forth6809.asm):06724         ;        return address on S points at the count byte
                      (    forth6809.asm):06725         ;    Outputs:
                      (    forth6809.asm):06726         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06727         ;        string

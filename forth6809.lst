                      (    forth6809.asm):07618         ; TSTTHENZ - unit test for THEN, tag-mismatch case. Pushes a
                      (    forth6809.asm):07619         ; wrong value (0, matching none of TAGFWD/TAGBACK/TAGDO/TAGOF)
                      (    forth6809.asm):07620         ; in place of the expected TAGFWD, then calls THEN via CATCH.
                      (    forth6809.asm):07621         ; CFERR (confirmed by reading it directly) throws -22
                      (    forth6809.asm):07622         ; immediately without ever touching CODEHERE - the error path
                      (    forth6809.asm):07623         ; never reaches any compiling code - so this needs no CODEHERE
                      (    forth6809.asm):07624         ; redirect, unlike every other test in this section. Same
                      (    forth6809.asm):07625         ; CATCH-based pattern as the divide-by-zero tests in earlier
                      (    forth6809.asm):07626         ; sections: verify the thrown code and CATCH's own depth-
                      (    forth6809.asm):07627         ; restoration contract, not the unspecified i*x values.
                      (    forth6809.asm):07628         ; ------------------------------------------------------------
C239                  (    forth6809.asm):07629         TSTTHENZ: STU  TSTU0
                      (    forth6809.asm):07630         
                      (    forth6809.asm):07631                   LDD  #0

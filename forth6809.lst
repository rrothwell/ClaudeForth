                      (    forth6809.asm):07231         ; ------------------------------------------------------------
                      (    forth6809.asm):07232         ; Divide the unsigned double UDHI:UDLO by BASE (restoring division, 32
                      (    forth6809.asm):07233         ; iterations). Only the low byte of BASE is used.
                      (    forth6809.asm):07234         ; UDDIGIT
                      (    forth6809.asm):07235         ;    Inputs:
                      (    forth6809.asm):07236         ;        UDHI:UDLO = dividend
                      (    forth6809.asm):07237         ;    Outputs:
                      (    forth6809.asm):07238         ;        UDHI:UDLO = quotient, REM = remainder
                      (    forth6809.asm):07239         ;    Registers: RegA and RegB changed; DCNT used as the loop counter.
                      (    forth6809.asm):07240         ; ------------------------------------------------------------

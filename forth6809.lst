                      (    forth6809.asm):07585         ; TSTTHENZ - unit test for THEN, tag-mismatch case. Pushes a
                      (    forth6809.asm):07586         ; wrong value (0, matching none of TAGFWD/TAGBACK/TAGDO/TAGOF)
                      (    forth6809.asm):07587         ; in place of the expected TAGFWD, then calls THEN via CATCH.
                      (    forth6809.asm):07588         ; CFERR (confirmed by reading it directly) throws -22
                      (    forth6809.asm):07589         ; immediately without ever touching CODEHERE - the error path
                      (    forth6809.asm):07590         ; never reaches any compiling code - so this needs no CODEHERE
                      (    forth6809.asm):07591         ; redirect, unlike every other test in this section. Same
                      (    forth6809.asm):07592         ; CATCH-based pattern as the divide-by-zero tests in earlier
                      (    forth6809.asm):07593         ; sections: verify the thrown code and CATCH's own depth-
                      (    forth6809.asm):07594         ; restoration contract, not the unspecified i*x values.
                      (    forth6809.asm):07595         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07596         TSTTHENZ: STU  TSTU0
                      (    forth6809.asm):07597         
                      (    forth6809.asm):07598                   LDD  #0
                      (    forth6809.asm):07599                   PSHU D
                      (    forth6809.asm):07600                   LDD  #0
                      (    forth6809.asm):07601                   PSHU D
                      (    forth6809.asm):07602                   LDX  #THEN
                      (    forth6809.asm):07603                   PSHU X
                      (    forth6809.asm):07604                   STU  TSTUB4
                      (    forth6809.asm):07605         
                      (    forth6809.asm):07606                   JSR  CATCH
                      (    forth6809.asm):07607         
                      (    forth6809.asm):07608                   STU  TSTUAF
                      (    forth6809.asm):07609         
                      (    forth6809.asm):07610                   PULU D
                      (    forth6809.asm):07611                   CMPD #-22
                      (    forth6809.asm):07612                   BNE  T3FAIL
                      (    forth6809.asm):07613         
                      (    forth6809.asm):07614                   LDD  TSTUB4
                      (    forth6809.asm):07615                   SUBD TSTUAF
                      (    forth6809.asm):07616                   CMPD #0
                      (    forth6809.asm):07617                   BNE  T3FAIL
                      (    forth6809.asm):07618         
                      (    forth6809.asm):07619                   LDD  #TRUEV
                      (    forth6809.asm):07620                   BRA  T3DONE
C100                  (    forth6809.asm):07621         T3FAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):07622         T3DONE:   LDX  #TSTTHENZNAME
                      (    forth6809.asm):07623                   PSHU X
                      (    forth6809.asm):07624                   PSHU D
                      (    forth6809.asm):07625                   JSR  TSTREPORT
                      (    forth6809.asm):07626         
                      (    forth6809.asm):07627                   LDU  TSTU0
                      (    forth6809.asm):07628                   RTS
                      (    forth6809.asm):07629         
C100                  (    forth6809.asm):07630         TSTTHENZNAME: FCB  8
                      (    forth6809.asm):07631                       FCC  "TSTTHENZ"
                      (    forth6809.asm):07632         
                      (    forth6809.asm):07633         ; ------------------------------------------------------------

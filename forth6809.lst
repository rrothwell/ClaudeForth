                      (    forth6809.asm):07638         ; per their own ANS data type, which the original single-cell
                      (    forth6809.asm):07639         ; ENVFOUND (pushing exactly one value before TRUE) couldn't
                      (    forth6809.asm):07640         ; represent. Added a second table (ENVTABLE2) and matching loop
                      (    forth6809.asm):07641         ; (ENV2START/ENV2LOOP/ENV2FOUND, below) specifically for double-cell
                      (    forth6809.asm):07642         ; entries, rather than reworking the single-cell path to handle both

                      (    forth6809.asm):00326         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00327         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00328         ; ------------------------------------------------------------

DDEA DD06             (    forth6809.asm):02649                  STD   DPHERE
DDEC DCF5             (    forth6809.asm):02650                  LDD   QSAVECODE
DDEE DD08             (    forth6809.asm):02651                  STD   CODEHERE
DDF0 DCF7             (    forth6809.asm):02652                  LDD   QSAVEVAR
DDF2 DD0A             (    forth6809.asm):02653                  STD   VARHERE
DDF4 DCF9             (    forth6809.asm):02654                  LDD   QSAVELATEST
DDF6 DD04             (    forth6809.asm):02655                  STD   LATEST
DDF8 CEBD00           (    forth6809.asm):02656                  LDU   #SP0
                      (    forth6809.asm):02657         
                      (    forth6809.asm):02658                  ; BUG FIX: an error caught here can happen mid-colon-definition
                      (    forth6809.asm):02659                  ; (STATE=-1) - e.g. a bad REPEAT/control-flow mismatch thrown
                      (    forth6809.asm):02660                  ; while compiling GI5 in 12_control_flow's Annex F tests. The
                      (    forth6809.asm):02661                  ; dictionary/HERE pointers above get rolled back (the half-
                      (    forth6809.asm):02662                  ; built word is erased) but STATE itself was NOT among them,
                      (    forth6809.asm):02663                  ; so it stayed at -1 even though there was no longer any
                      (    forth6809.asm):02664                  ; in-progress definition to be compiling. Every word on every

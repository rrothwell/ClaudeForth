                      (    forth6809.asm):05671         
     DEE3             (    forth6809.asm):05672         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):05673                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):05674                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):05675                                   ; were chained on after it; before that,
                      (    forth6809.asm):05676                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):05677                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):05678                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):05679                                   ; before this one.
                      (    forth6809.asm):05680         
                      (    forth6809.asm):05681         ; Verify no collision with base code.
                      (    forth6809.asm):05682         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):05683         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):05684         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):05685         
                      (    forth6809.asm):05686         ; ============================================================
                      (    forth6809.asm):05687         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):05688         ; ============================================================
                      (    forth6809.asm):05689                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):05690                                        ; entirely - every routine from here through
                      (    forth6809.asm):05691                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):05692                                        ; every primitive) would otherwise have
                      (    forth6809.asm):05693                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):05694                                        ; WARM message left the location counter,
                      (    forth6809.asm):05695                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):05696                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):05697                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):05698         
                      (    forth6809.asm):05699         ; ------------------------------------------------------------
                      (    forth6809.asm):05700         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):05701         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):05702         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):05703         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):05704         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):05705         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):05706         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):05707                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):05708                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):05709                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):05710                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):05711                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):05712                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):05713                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):05714                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):05715                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):05716                  RTS
                      (    forth6809.asm):05717         
                      (    forth6809.asm):05718                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):05719         ; ------------------------------------------------------------
                      (    forth6809.asm):05720         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):05721         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):05722         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):05723         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):05724         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):05725         INFILL:  LDA   INHEAD
                      (    forth6809.asm):05726                  SUBA  INTAIL
                      (    forth6809.asm):05727                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):05728                  RTS
                      (    forth6809.asm):05729         
                      (    forth6809.asm):05730         ; ------------------------------------------------------------
                      (    forth6809.asm):05731         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):05732         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):05733         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):05734         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):05735         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):05736         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):05737         ; flow control, not a chip feature.
                      (    forth6809.asm):05738         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):05739         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):05740                     CMPA #INHIWATER
                      (    forth6809.asm):05741                     BLO  RTSCHIDONE
                      (    forth6809.asm):05742                     TST  RTSSTATE
                      (    forth6809.asm):05743                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):05744                     LDA  #CR_RTSHI
                      (    forth6809.asm):05745                     STA  ACIACR
                      (    forth6809.asm):05746                     LDA  #1
                      (    forth6809.asm):05747                     STA  RTSSTATE
DEF5                  (    forth6809.asm):05748         RTSCHIDONE: RTS
                      (    forth6809.asm):05749         
                      (    forth6809.asm):05750         ; ------------------------------------------------------------
                      (    forth6809.asm):05751         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):05752         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):05753         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):05754         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):05755         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):05756         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):05757         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):05758         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):05759         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):05760         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):05761         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):05762                     CMPA #INLOWATER
                      (    forth6809.asm):05763                     BHI  RTSCLODONE
                      (    forth6809.asm):05764                     TST  RTSSTATE
                      (    forth6809.asm):05765                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):05766                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):05767                     CLR  RTSSTATE
                      (    forth6809.asm):05768                     LDB  OUTTAIL
                      (    forth6809.asm):05769                     CMPB OUTHEAD
                      (    forth6809.asm):05770                     BEQ  RTSCLONOTX
                      (    forth6809.asm):05771                     LDA  #CR_RXTX
                      (    forth6809.asm):05772                     STA  ACIACR
                      (    forth6809.asm):05773                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):05774         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):05775                     STA  ACIACR
DEF5                  (    forth6809.asm):05776         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):05777         RTSCLODONE: RTS
                      (    forth6809.asm):05778         
DEF5                  (    forth6809.asm):05779         IRQH:    LDA   ACIASR
                      (    forth6809.asm):05780                  BITA  #SR_IRQ
                      (    forth6809.asm):05781                  BEQ   IRQDONE
                      (    forth6809.asm):05782         
                      (    forth6809.asm):05783                  BITA  #SR_RDRF
                      (    forth6809.asm):05784                  BEQ   TXCHK
                      (    forth6809.asm):05785         
                      (    forth6809.asm):05786                  LDB   INHEAD
                      (    forth6809.asm):05787                  LDA   ACIADR
                      (    forth6809.asm):05788                  LDX   #INBUF
                      (    forth6809.asm):05789                  STA   B,X
                      (    forth6809.asm):05790                  INCB
                      (    forth6809.asm):05791                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):05792                  CMPB  INTAIL
                      (    forth6809.asm):05793                  BEQ   IRQDONE
                      (    forth6809.asm):05794                  STB   INHEAD
                      (    forth6809.asm):05795                  JSR   RTSCHECKHI
                      (    forth6809.asm):05796                  BRA   IRQDONE
                      (    forth6809.asm):05797         
DEF5                  (    forth6809.asm):05798         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):05799                  CMPB  OUTHEAD
                      (    forth6809.asm):05800                  BEQ   TXOFF
                      (    forth6809.asm):05801                  LDX   #OUTBUF
                      (    forth6809.asm):05802                  LDA   B,X
                      (    forth6809.asm):05803                  STA   ACIADR
                      (    forth6809.asm):05804                  INCB
                      (    forth6809.asm):05805                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):05806                  STB   OUTTAIL
                      (    forth6809.asm):05807                  BRA   IRQDONE
                      (    forth6809.asm):05808         
DEF5                  (    forth6809.asm):05809         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):05810                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):05811                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):05812                  LDA   #CR_RXON
                      (    forth6809.asm):05813                  STA   ACIACR
                      (    forth6809.asm):05814         
DEF5                  (    forth6809.asm):05815         IRQDONE: RTI
                      (    forth6809.asm):05816         

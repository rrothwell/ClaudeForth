                      (    forth6809.asm):03926         ; ------------------------------------------------------------
                      (    forth6809.asm):03927         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03928         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03929         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03930         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03931         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03932         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03933         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03934         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03935         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03936         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03937         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03938         ; ------------------------------------------------------------
C1CD BDFC2B           (    forth6809.asm):03939         TSTDARITH: JSR   CRW
C1D0 8EC1E1           (    forth6809.asm):03940                    LDX   #TSTDARITHMSG
C1D3 3610             (    forth6809.asm):03941                    PSHU  X
C1D5 CC000B           (    forth6809.asm):03942                    LDD   #11
C1D8 3606             (    forth6809.asm):03943                    PSHU  D
C1DA BDF60B           (    forth6809.asm):03944                    JSR   TYPE
C1DD BDFC2B           (    forth6809.asm):03945                    JSR   CRW
                      (    forth6809.asm):03946         
                      (    forth6809.asm):03947                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03948         
                      (    forth6809.asm):03949                    JSR   TSTUMST
                      (    forth6809.asm):03950                    JSR   TSTUMSM
                      (    forth6809.asm):03951                    JSR   TSTUMSZ
                      (    forth6809.asm):03952                    JSR   TSTMSTAR
                      (    forth6809.asm):03953                    JSR   TSTFMSM
                      (    forth6809.asm):03954                    JSR   TSTFMSZ
                      (    forth6809.asm):03955                    JSR   TSTSMRM
                      (    forth6809.asm):03956                    JSR   TSTSMRZ
                      (    forth6809.asm):03957                    JSR   TSTDPLUS
                      (    forth6809.asm):03958                    JSR   TSTDMIN2
                      (    forth6809.asm):03959                    JSR   TSTDNEG
                      (    forth6809.asm):03960                    JSR   TSTDABS1
                      (    forth6809.asm):03961                    JSR   TSTDABS2
                      (    forth6809.asm):03962                    JSR   TSTMPLUS
                      (    forth6809.asm):03963                    JSR   TSTSTOD
                      (    forth6809.asm):03964                    JSR   TSTDTOS
                      (    forth6809.asm):03965                    JSR   TSTDMAX
                      (    forth6809.asm):03966                    JSR   TSTDMIN
                      (    forth6809.asm):03967         
                      (    forth6809.asm):03968                    ENDC ; <<<<

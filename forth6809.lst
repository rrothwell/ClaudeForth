                      (    forth6809.asm):11824         ; delegates to CMOVE> (high-to-low) whenever dst > src,
                      (    forth6809.asm):11825         ; specifically to avoid the corruption a naive low-to-high copy
                      (    forth6809.asm):11826         ; would cause here (byte 2 would get overwritten by the copy
                      (    forth6809.asm):11827         ; before ever being read as a source byte). Expected result
                      (    forth6809.asm):11828         ; hand-derived and independently simulated in Python before
                      (    forth6809.asm):11829         ; writing this test, not guessed: "ABABCDE" across bytes 0-6.
                      (    forth6809.asm):11830         ; ------------------------------------------------------------

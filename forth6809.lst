                      (    forth6809.asm):00807         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00808         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00809         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00810         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00811         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00812         ; pushes that set the test up).
                      (    forth6809.asm):00813         ; ------------------------------------------------------------
C161                  (    forth6809.asm):00814         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00815         
                      (    forth6809.asm):00816                    LDD   #TSTGUARD
                      (    forth6809.asm):00817                    PSHU  D
                      (    forth6809.asm):00818                    LDD   #TSTVAL1
                      (    forth6809.asm):00819                    PSHU  D
                      (    forth6809.asm):00820                    STU   TSTUB4
                      (    forth6809.asm):00821         
                      (    forth6809.asm):00822                    JSR   DUP
                      (    forth6809.asm):00823         
                      (    forth6809.asm):00824                    STU   TSTUAF
                      (    forth6809.asm):00825         
                      (    forth6809.asm):00826                    PULU  D
                      (    forth6809.asm):00827                    CMPD  #TSTVAL1
                      (    forth6809.asm):00828                    BNE   TDFAIL
                      (    forth6809.asm):00829                    PULU  D
                      (    forth6809.asm):00830                    CMPD  #TSTVAL1
                      (    forth6809.asm):00831                    BNE   TDFAIL
                      (    forth6809.asm):00832                    PULU  D
                      (    forth6809.asm):00833                    CMPD  #TSTGUARD
                      (    forth6809.asm):00834                    BNE   TDFAIL
                      (    forth6809.asm):00835         
                      (    forth6809.asm):00836                    LDD   TSTUB4
                      (    forth6809.asm):00837                    SUBD  TSTUAF
                      (    forth6809.asm):00838                    CMPD  #2
                      (    forth6809.asm):00839                    BNE   TDFAIL
                      (    forth6809.asm):00840         
                      (    forth6809.asm):00841                    LDD   #TRUEV
                      (    forth6809.asm):00842                    BRA   TDDONE
C161                  (    forth6809.asm):00843         TDFAIL:    LDD   #FALSEV
C161                  (    forth6809.asm):00844         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00845                    PSHU  X
                      (    forth6809.asm):00846                    PSHU  D
                      (    forth6809.asm):00847                    JSR   TSTREPORT
                      (    forth6809.asm):00848         
                      (    forth6809.asm):00849                    LDU   TSTU0
                      (    forth6809.asm):00850                    RTS
                      (    forth6809.asm):00851         
C161                  (    forth6809.asm):00852         TSTDUPNAME: FCB  6
                      (    forth6809.asm):00853                     FCC  "TSTDUP"
                      (    forth6809.asm):00854         

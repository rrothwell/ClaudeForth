F592                  (    forth6809.asm):20243         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):20244                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):20245                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):20246                                   ; characters and (worse) shared identically
                      (    forth6809.asm):20247                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):20248                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):20249                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):20250                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):20251                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):20252                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):20253                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):20254                                   ; testing/design decision: rather than give
                      (    forth6809.asm):20255                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):20256                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):20257                                   ; definition for stable storage instead - but
                      (    forth6809.asm):20258                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):20259                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):20260                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):20261                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):20262                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):20263                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):20264                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):20265                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):20266                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):20267                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):20268                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):20269                   JSR  PADW
F595 3710             (    forth6809.asm):20270                   PULU X

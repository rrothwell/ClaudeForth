                      (    forth6809.asm):16848         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16849         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):16850                     CMPA #INHIWATER
                      (    forth6809.asm):16851                     BLO  RTSCHIDONE

                      (    forth6809.asm):09929         ; TSTLITERAL - unit test for LITERAL. Already used extensively
                      (    forth6809.asm):09930         ; as an internal helper throughout sections 3.8/3.9's own tests,
                      (    forth6809.asm):09931         ; but gets its own dedicated, direct test here too, per this
                      (    forth6809.asm):09932         ; section's own coverage. Compiles a known value as a literal,
                      (    forth6809.asm):09933         ; then executes the result to confirm it genuinely pushes it.
                      (    forth6809.asm):09934         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):09935         TSTLITERAL: LDD  CODEHERE
                      (    forth6809.asm):09936                     STD  TSTCSAV

                      (    forth6809.asm):06655         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):06656         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):06657         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):06658         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):06659         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):06660         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):06661         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):06662         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):06663         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):06664         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):06665         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):06666         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):06667         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06668         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):06669                   STD  TSTLSAV
                      (    forth6809.asm):06670                   LDD  CODEHERE
                      (    forth6809.asm):06671                   STD  TSTCSAV
                      (    forth6809.asm):06672         
                      (    forth6809.asm):06673                   LDA  #3
                      (    forth6809.asm):06674                   STA  TSTFHDR
                      (    forth6809.asm):06675                   LDA  #'F'
                      (    forth6809.asm):06676                   STA  TSTFHDR+1
                      (    forth6809.asm):06677                   LDA  #'O'
                      (    forth6809.asm):06678                   STA  TSTFHDR+2
                      (    forth6809.asm):06679                   LDA  #'O'
                      (    forth6809.asm):06680                   STA  TSTFHDR+3
                      (    forth6809.asm):06681                   LDD  #0
                      (    forth6809.asm):06682                   STD  TSTFHDR+4
                      (    forth6809.asm):06683                   LDD  #DUP
                      (    forth6809.asm):06684                   STD  TSTFHDR+6
                      (    forth6809.asm):06685         
                      (    forth6809.asm):06686                   LDD  #TSTFHDR
                      (    forth6809.asm):06687                   STD  LATEST
                      (    forth6809.asm):06688         
                      (    forth6809.asm):06689                   LDD  #TSTCBUF
                      (    forth6809.asm):06690                   STD  CODEHERE
                      (    forth6809.asm):06691         
                      (    forth6809.asm):06692                   JSR  RECURSE
                      (    forth6809.asm):06693         

                      (    forth6809.asm):03241         ; Convert digits at NADDR into UDHI:UDLO, in BASE, until NCNT
                      (    forth6809.asm):03242         ; characters are used or a non-digit is reached.
                      (    forth6809.asm):03243         ; NUMLOOP
                      (    forth6809.asm):03244         ;    Inputs:
                      (    forth6809.asm):03245         ;        NADDR = address of the first character
                      (    forth6809.asm):03246         ;        NCNT = number of characters
                      (    forth6809.asm):03247         ;        UDHI:UDLO = initial value
                      (    forth6809.asm):03248         ;    Outputs:
                      (    forth6809.asm):03249         ;        UDHI:UDLO = accumulated value
                      (    forth6809.asm):03250         ;        NADDR, NCNT = first unconverted character and the count
                      (    forth6809.asm):03251         ;        remaining

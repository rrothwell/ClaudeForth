                      (    forth6809.asm):01602         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01603         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01604         ; INITSERIAL
                      (    forth6809.asm):01605         ;    Inputs:
                      (    forth6809.asm):01606         ;        none
                      (    forth6809.asm):01607         ;    Outputs:
                      (    forth6809.asm):01608         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01609         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01610         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01611         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01612         ; ------------------------------------------------------------
DC0F BDDBF0           (    forth6809.asm):01613         INITSERIAL: JSR   SERBUFCLR

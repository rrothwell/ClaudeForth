F46A 3606             (    forth6809.asm):06392                     PSHU  D
F46C 7EE642           (    forth6809.asm):06393                     JMP   THROWW
                      (    forth6809.asm):06394         
                      (    forth6809.asm):06395         ; ------------------------------------------------------------

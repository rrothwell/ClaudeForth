                      (    forth6809.asm):03621                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03622                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03623                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03624                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).

                      (    forth6809.asm):03669         ; ------------------------------------------------------------
                      (    forth6809.asm):03670         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03671         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03672         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03673         ; FDSEARCH
                      (    forth6809.asm):03674         ;    Inputs:
                      (    forth6809.asm):03675         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03676         ;        RegY = address of the name text
                      (    forth6809.asm):03677         ;        RegB = name length
                      (    forth6809.asm):03678         ;    Outputs:
                      (    forth6809.asm):03679         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03680         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03681         ; ------------------------------------------------------------
D575 3424             (    forth6809.asm):03682         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D577 8C0000           (    forth6809.asm):03683         FDLOOP:     CMPX  #0
D57A 2733             (    forth6809.asm):03684                     BEQ   FDRET
D57C A684             (    forth6809.asm):03685                     LDA   ,X
D57E 8540             (    forth6809.asm):03686                     BITA  #$40
D580 2620             (    forth6809.asm):03687                     BNE   FDNEXT            ; smudged
D582 841F             (    forth6809.asm):03688                     ANDA  #$1F
D584 A1E4             (    forth6809.asm):03689                     CMPA  ,S
D586 261A             (    forth6809.asm):03690                     BNE   FDNEXT
D588 3410             (    forth6809.asm):03691                     PSHS  X                 ; header, kept across the compare
D58A 3001             (    forth6809.asm):03692                     LEAX  1,X
D58C 10AE63           (    forth6809.asm):03693                     LDY   3,S               ; name text
D58F E662             (    forth6809.asm):03694                     LDB   2,S               ; length
D591 2709             (    forth6809.asm):03695                     BEQ   FDHIT
D593 A680             (    forth6809.asm):03696         FDCMP:      LDA   ,X+
D595 A1A0             (    forth6809.asm):03697                     CMPA  ,Y+
D597 2607             (    forth6809.asm):03698                     BNE   FDMISS
D599 5A               (    forth6809.asm):03699                     DECB
D59A 26F7             (    forth6809.asm):03700                     BNE   FDCMP
D59C 3510             (    forth6809.asm):03701         FDHIT:      PULS  X                 ; header
D59E 200F             (    forth6809.asm):03702                     BRA   FDRET
D5A0 3510             (    forth6809.asm):03703         FDMISS:     PULS  X
D5A2 E684             (    forth6809.asm):03704         FDNEXT:     LDB   ,X
D5A4 C41F             (    forth6809.asm):03705                     ANDB  #$1F
D5A6 4F               (    forth6809.asm):03706                     CLRA
D5A7 3001             (    forth6809.asm):03707                     LEAX  1,X
D5A9 308B             (    forth6809.asm):03708                     LEAX  D,X
D5AB AE84             (    forth6809.asm):03709                     LDX   ,X                ; LINK field
D5AD 20C8             (    forth6809.asm):03710                     BRA   FDLOOP
D5AF 3263             (    forth6809.asm):03711         FDRET:      LEAS  3,S
D5B1 39               (    forth6809.asm):03712                     RTS
                      (    forth6809.asm):03713         
                      (    forth6809.asm):03714         ; ------------------------------------------------------------
                      (    forth6809.asm):03715         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03716         ; ROOT, for a name.
                      (    forth6809.asm):03717         ; SRCHORD
                      (    forth6809.asm):03718         ;    Inputs:
                      (    forth6809.asm):03719         ;        RegY = address of the name text
                      (    forth6809.asm):03720         ;        RegB = name length
                      (    forth6809.asm):03721         ;    Outputs:
                      (    forth6809.asm):03722         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03723         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03724         ; ------------------------------------------------------------
D5B2 3424             (    forth6809.asm):03725         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D5B4 8E004B           (    forth6809.asm):03726                     LDX   #ORDER
D5B7 3410             (    forth6809.asm):03727                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D5B9 AEE4             (    forth6809.asm):03728         SOLOOP:     LDX   ,S
D5BB 9C49             (    forth6809.asm):03729                     CMPX  ORDEND
D5BD 2415             (    forth6809.asm):03730                     BHS   SOROOT
D5BF 10AE81           (    forth6809.asm):03731                     LDY   ,X++              ; WID
D5C2 AFE4             (    forth6809.asm):03732                     STX   ,S
D5C4 AEA4             (    forth6809.asm):03733                     LDX   ,Y                ; newest header of that wordlist
D5C6 10AE63           (    forth6809.asm):03734                     LDY   3,S
D5C9 E662             (    forth6809.asm):03735                     LDB   2,S
D5CB 8DA8             (    forth6809.asm):03736                     BSR   FDSEARCH
D5CD 8C0000           (    forth6809.asm):03737                     CMPX  #0
D5D0 27E7             (    forth6809.asm):03738                     BEQ   SOLOOP
D5D2 2009             (    forth6809.asm):03739                     BRA   SORDONE
D5D4 9E5D             (    forth6809.asm):03740         SOROOT:     LDX   WLHEADS+2         ; ROOT
D5D6 10AE63           (    forth6809.asm):03741                     LDY   3,S
D5D9 E662             (    forth6809.asm):03742                     LDB   2,S
D5DB 8D98             (    forth6809.asm):03743                     BSR   FDSEARCH
D5DD 3265             (    forth6809.asm):03744         SORDONE:    LEAS  5,S
D5DF 39               (    forth6809.asm):03745                     RTS
                      (    forth6809.asm):03746         
                      (    forth6809.asm):03747         ; ------------------------------------------------------------
                      (    forth6809.asm):03748         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03749         ; HDRXT
                      (    forth6809.asm):03750         ;    Inputs:
                      (    forth6809.asm):03751         ;        RegX = header
                      (    forth6809.asm):03752         ;    Outputs:
                      (    forth6809.asm):03753         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03754         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03755         ; ------------------------------------------------------------
D5E0 A684             (    forth6809.asm):03756         HDRXT:      LDA   ,X
D5E2 1F89             (    forth6809.asm):03757                     TFR   A,B
D5E4 C41F             (    forth6809.asm):03758                     ANDB  #$1F
D5E6 3001             (    forth6809.asm):03759                     LEAX  1,X
D5E8 3A               (    forth6809.asm):03760                     ABX
D5E9 AE02             (    forth6809.asm):03761                     LDX   2,X               ; CFA field
D5EB 39               (    forth6809.asm):03762                     RTS
                      (    forth6809.asm):03763         
                      (    forth6809.asm):03764         ; ------------------------------------------------------------
                      (    forth6809.asm):03765         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03766         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03767         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03768         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03769         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03770         ; ------------------------------------------------------------
D5EC 10AEC4           (    forth6809.asm):03771         FINDW:      LDY   ,U                ; counted string
D5EF E6A0             (    forth6809.asm):03772                     LDB   ,Y+
D5F1 8DBF             (    forth6809.asm):03773                     BSR   SRCHORD
D5F3 8C0000           (    forth6809.asm):03774                     CMPX  #0
D5F6 2712             (    forth6809.asm):03775                     BEQ   NOTFOUND
D5F8 8DE6             (    forth6809.asm):03776                     BSR   HDRXT
D5FA AFC4             (    forth6809.asm):03777                     STX   ,U                ; xt replaces c-addr
D5FC 4D               (    forth6809.asm):03778                     TSTA
D5FD 2A05             (    forth6809.asm):03779                     BPL   FISNORM
D5FF CC0001           (    forth6809.asm):03780                     LDD   #1
D602 2003             (    forth6809.asm):03781                     BRA   FPUSH
D604 CCFFFF           (    forth6809.asm):03782         FISNORM:    LDD   #-1
D607 3606             (    forth6809.asm):03783         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D609 39               (    forth6809.asm):03784                     RTS
                      (    forth6809.asm):03785         
D60A CC0000           (    forth6809.asm):03786         NOTFOUND:   LDD   #0
D60D 3606             (    forth6809.asm):03787                     PSHU  D                 ; 0 = not found, c-addr still beneath
D60F 39               (    forth6809.asm):03788                     RTS
                      (    forth6809.asm):03789         
                      (    forth6809.asm):03790         ; ------------------------------------------------------------
                      (    forth6809.asm):03791         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03792         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03793         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03794         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03795         ; ------------------------------------------------------------
D610 3710             (    forth6809.asm):03796         SEARCHWLW:  PULU  X                 ; wid
D612 8D2D             (    forth6809.asm):03797                     BSR   WIDCHK
D614 AE84             (    forth6809.asm):03798                     LDX   ,X                ; newest header of the wordlist
D616 3706             (    forth6809.asm):03799                     PULU  D                 ; u
D618 3720             (    forth6809.asm):03800                     PULU  Y                 ; c-addr
D61A 4D               (    forth6809.asm):03801                     TSTA
D61B 261E             (    forth6809.asm):03802                     BNE   SWNOT             ; longer than any name
D61D C11F             (    forth6809.asm):03803                     CMPB  #31
D61F 221A             (    forth6809.asm):03804                     BHI   SWNOT
D621 BDD575           (    forth6809.asm):03805                     JSR   FDSEARCH
D624 8C0000           (    forth6809.asm):03806                     CMPX  #0
D627 2712             (    forth6809.asm):03807                     BEQ   SWNOT
D629 8DB5             (    forth6809.asm):03808                     BSR   HDRXT
D62B 3610             (    forth6809.asm):03809                     PSHU  X                 ; xt
D62D 4D               (    forth6809.asm):03810                     TSTA
D62E 2A05             (    forth6809.asm):03811                     BPL   SWNORM
D630 CC0001           (    forth6809.asm):03812                     LDD   #1
D633 2003             (    forth6809.asm):03813                     BRA   SWPUSH
D635 CCFFFF           (    forth6809.asm):03814         SWNORM:     LDD   #-1
D638 3606             (    forth6809.asm):03815         SWPUSH:     PSHU  D
D63A 39               (    forth6809.asm):03816                     RTS
D63B CC0000           (    forth6809.asm):03817         SWNOT:      LDD   #0
D63E 3606             (    forth6809.asm):03818                     PSHU  D
D640 39               (    forth6809.asm):03819                     RTS
                      (    forth6809.asm):03820         
                      (    forth6809.asm):03821         ; ------------------------------------------------------------
                      (    forth6809.asm):03822         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03823         ; WIDCHK
                      (    forth6809.asm):03824         ;    Inputs:
                      (    forth6809.asm):03825         ;        RegX = candidate WID
                      (    forth6809.asm):03826         ;    Outputs:
                      (    forth6809.asm):03827         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03828         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
D641 1F10             (    forth6809.asm):03830         WIDCHK:     TFR   X,D
D643 83005B           (    forth6809.asm):03831                     SUBD  #WLHEADS
D646 2509             (    forth6809.asm):03832                     BCS   WIDBAD
D648 C501             (    forth6809.asm):03833                     BITB  #1
D64A 2605             (    forth6809.asm):03834                     BNE   WIDBAD
D64C 9C45             (    forth6809.asm):03835                     CMPX  WLEND
D64E 2401             (    forth6809.asm):03836                     BHS   WIDBAD
D650 39               (    forth6809.asm):03837                     RTS
D651 CCFFF5           (    forth6809.asm):03838         WIDBAD:     LDD   #-11
D654 3606             (    forth6809.asm):03839                     PSHU  D
D656 7EDA44           (    forth6809.asm):03840                     JMP   THROWW
                      (    forth6809.asm):03841         
                      (    forth6809.asm):03842         ; ------------------------------------------------------------
                      (    forth6809.asm):03843         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03844         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03845         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03846         ; WLINIT
                      (    forth6809.asm):03847         ;    Inputs:
                      (    forth6809.asm):03848         ;        none
                      (    forth6809.asm):03849         ;    Outputs:
                      (    forth6809.asm):03850         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03851         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03852         ; ------------------------------------------------------------
D659 CCCDFA           (    forth6809.asm):03853         WLINIT:     LDD   #BASELATEST
D65C DD5B             (    forth6809.asm):03854                     STD   WLHEADS
D65E CCC4CB           (    forth6809.asm):03855                     LDD   #BASEROOTLATEST
D661 DD5D             (    forth6809.asm):03856                     STD   WLHEADS+2
D663 CCC4CB           (    forth6809.asm):03857                     LDD   #H_FORTH
D666 DD6F             (    forth6809.asm):03858                     STD   WLNAMES
D668 CCC4C2           (    forth6809.asm):03859                     LDD   #H_ROOT
D66B DD71             (    forth6809.asm):03860                     STD   WLNAMES+2
D66D CC005F           (    forth6809.asm):03861                     LDD   #WLHEADS+4
D670 DD45             (    forth6809.asm):03862                     STD   WLEND
D672 CC005B           (    forth6809.asm):03863                     LDD   #WLHEADS
D675 DD47             (    forth6809.asm):03864                     STD   CURRENT
D677 7ED747           (    forth6809.asm):03865                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03866         
                      (    forth6809.asm):03867         ; ------------------------------------------------------------
                      (    forth6809.asm):03868         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03869         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03870         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03871         ; PRUNE
                      (    forth6809.asm):03872         ;    Inputs:
                      (    forth6809.asm):03873         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03874         ;    Outputs:
                      (    forth6809.asm):03875         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03876         ;        into ROM
                      (    forth6809.asm):03877         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03878         ; ------------------------------------------------------------
D67A 3406             (    forth6809.asm):03879         PRUNE:      PSHS  D                 ; 0,S = mark
D67C 8E005B           (    forth6809.asm):03880                     LDX   #WLHEADS
D67F 9C45             (    forth6809.asm):03881         PRLOOP:     CMPX  WLEND
D681 2421             (    forth6809.asm):03882                     BHS   PRNDONE
D683 10AE84           (    forth6809.asm):03883                     LDY   ,X                ; newest header of this wordlist
D686 108CC000         (    forth6809.asm):03884         PRWALK:     CMPY  #ROMSTRT
D68A 2413             (    forth6809.asm):03885                     BHS   PRSTORE           ; ROM header: keep
D68C 10ACE4           (    forth6809.asm):03886                     CMPY  ,S
D68F 250E             (    forth6809.asm):03887                     BLO   PRSTORE           ; below the mark (or empty): keep
D691 E6A4             (    forth6809.asm):03888                     LDB   ,Y
D693 C41F             (    forth6809.asm):03889                     ANDB  #$1F
D695 4F               (    forth6809.asm):03890                     CLRA
D696 3121             (    forth6809.asm):03891                     LEAY  1,Y
D698 31AB             (    forth6809.asm):03892                     LEAY  D,Y
D69A 10AEA4           (    forth6809.asm):03893                     LDY   ,Y                ; follow the LINK
D69D 20E7             (    forth6809.asm):03894                     BRA   PRWALK
D69F 10AF81           (    forth6809.asm):03895         PRSTORE:    STY   ,X++
D6A2 20DB             (    forth6809.asm):03896                     BRA   PRLOOP
D6A4 3262             (    forth6809.asm):03897         PRNDONE:     LEAS  2,S
D6A6 39               (    forth6809.asm):03898                     RTS
                      (    forth6809.asm):03899         
                      (    forth6809.asm):03900         ; ============================================================
                      (    forth6809.asm):03901         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03902         ; ============================================================
                      (    forth6809.asm):03903         ; ------------------------------------------------------------
                      (    forth6809.asm):03904         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03905         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03906         ; ------------------------------------------------------------
D6A7 9E45             (    forth6809.asm):03907         WORDLISTW:  LDX   WLEND
D6A9 8C006F           (    forth6809.asm):03908                     CMPX  #WLHEADS+2*WLCELLS
D6AC 240F             (    forth6809.asm):03909                     BHS   WLFULL
D6AE CC0000           (    forth6809.asm):03910                     LDD   #0
D6B1 ED84             (    forth6809.asm):03911                     STD   ,X
D6B3 ED8814           (    forth6809.asm):03912                     STD   WLNOFF,X
D6B6 3610             (    forth6809.asm):03913                     PSHU  X
D6B8 3002             (    forth6809.asm):03914                     LEAX  2,X
D6BA 9F45             (    forth6809.asm):03915                     STX   WLEND
D6BC 39               (    forth6809.asm):03916                     RTS
D6BD CCFFF8           (    forth6809.asm):03917         WLFULL:     LDD   #-8
D6C0 3606             (    forth6809.asm):03918                     PSHU  D
D6C2 7EDA44           (    forth6809.asm):03919                     JMP   THROWW
                      (    forth6809.asm):03920         
                      (    forth6809.asm):03921         ; ------------------------------------------------------------
                      (    forth6809.asm):03922         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03923         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03924         ; ------------------------------------------------------------
D6C5 CC005B           (    forth6809.asm):03925         FORTHWLW:   LDD   #WLHEADS
D6C8 3606             (    forth6809.asm):03926                     PSHU  D
D6CA 39               (    forth6809.asm):03927                     RTS
                      (    forth6809.asm):03928         
                      (    forth6809.asm):03929         ; ------------------------------------------------------------
                      (    forth6809.asm):03930         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03931         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03932         ; it, as it is always searched last.
                      (    forth6809.asm):03933         ; ------------------------------------------------------------
D6CB 9E49             (    forth6809.asm):03934         GETORDERW:  LDX   ORDEND

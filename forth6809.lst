CE24 B7C008           (    forth6809.asm):02105                     STA   ACIACR
CE27 12               (    forth6809.asm):02106                     NOP                     ; Settling Delay
CE28 12               (    forth6809.asm):02107                     NOP
                      (    forth6809.asm):02108         
                      (    forth6809.asm):02109                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
CE29 8695             (    forth6809.asm):02110                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02111                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02112                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low

                      (    forth6809.asm):05879                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):05880                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):05881                                   ; c-addr2 (dest) is on top, popped first.

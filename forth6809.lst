                      (    forth6809.asm):05343         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05344         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05345         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05346         ; ------------------------------------------------------------

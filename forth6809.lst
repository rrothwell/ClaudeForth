                      (    forth6809.asm):04293                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):04294                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):04295                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):04296                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):04297                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):04298                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):04299                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):04300                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):04301                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):04302                                   ; matching the observed bug (J stuck at the

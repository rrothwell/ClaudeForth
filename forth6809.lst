                      (    forth6809.asm):00381         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00382         ;
                      (    forth6809.asm):00383         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00384         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00385         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00386         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00387         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00388         ; hand-built at the end of the section.
                      (    forth6809.asm):00389         ;
                      (    forth6809.asm):00390         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00391         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00392         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00393         ; ============================================================

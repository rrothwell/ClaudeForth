E8BA EC62             (    forth6809.asm):17881         IWORD:   LDD   2,S        ; BUG FIX: PULS X/PSHS X used to bracket this
E8BC 3606             (    forth6809.asm):17882                  PSHU  D          ; read, shifting S by 2 first - so "2,S" landed
E8BE 39               (    forth6809.asm):17883                  RTS              ; on the limit (what's really at 4,S unshifted)
                      (    forth6809.asm):17884                                   ; instead of the index. The pair served no
                      (    forth6809.asm):17885                                   ; purpose (nothing needed offset 0 for anything
                      (    forth6809.asm):17886                                   ; here) - removed, so 2,S directly and
                      (    forth6809.asm):17887                                   ; correctly targets the index DOSETUP pushed
                      (    forth6809.asm):17888                                   ; there. Confirmed via MAME debugger: "I"
                      (    forth6809.asm):17889                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):17890         
E8BF EC68             (    forth6809.asm):17891         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E8C1 3606             (    forth6809.asm):17892                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E8C3 39               (    forth6809.asm):17893                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):17894                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):17895                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):17896                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):17897                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):17898                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):17899                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):17900                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):17901                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):17902                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):17903                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):17904                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):17905                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):17906                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):17907                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):17908                                   ; limit, never progressing). Confirmed via a

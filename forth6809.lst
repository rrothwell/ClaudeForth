                      (    forth6809.asm):09552                   PSHU D
                      (    forth6809.asm):09553                   STU  TSTUB4
                      (    forth6809.asm):09554         
                      (    forth6809.asm):09555                   JSR  IMMEDIATE
                      (    forth6809.asm):09556         

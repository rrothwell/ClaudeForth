                      (    forth6809.asm):06290         ; ------------------------------------------------------------
F402 ECC4             (    forth6809.asm):06291         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F404 2713             (    forth6809.asm):06292                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F406 AE44             (    forth6809.asm):06293                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F408 308B             (    forth6809.asm):06294                     LEAX  D,X               ; end address = c-addr1 + u
F40A AFC4             (    forth6809.asm):06295                     STX   ,U                ; keep it in u's old slot as the loop limit

                      (    forth6809.asm):07688                    JSR  CATCH
                      (    forth6809.asm):07689         
                      (    forth6809.asm):07690                    STU  TSTUAF
                      (    forth6809.asm):07691         
                      (    forth6809.asm):07692                    PULU D
                      (    forth6809.asm):07693                    CMPD #-22
                      (    forth6809.asm):07694                    BNE  EOFAIL
                      (    forth6809.asm):07695         
                      (    forth6809.asm):07696                    LDD  TSTUB4
                      (    forth6809.asm):07697                    SUBD TSTUAF
                      (    forth6809.asm):07698                    CMPD #0
                      (    forth6809.asm):07699                    BNE  EOFAIL
                      (    forth6809.asm):07700         
                      (    forth6809.asm):07701                    LDD  #TRUEV
                      (    forth6809.asm):07702                    BRA  EODONE
C100                  (    forth6809.asm):07703         EOFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):07704         EODONE:    LDX  #TSTENDFZNAME
                      (    forth6809.asm):07705                    PSHU X
                      (    forth6809.asm):07706                    PSHU D
                      (    forth6809.asm):07707                    JSR  TSTREPORT
                      (    forth6809.asm):07708         
                      (    forth6809.asm):07709                    LDU  TSTU0
                      (    forth6809.asm):07710                    RTS
                      (    forth6809.asm):07711         
C100                  (    forth6809.asm):07712         TSTENDFZNAME: FCB  9
                      (    forth6809.asm):07713                       FCC  "TSTENDOFZ"
                      (    forth6809.asm):07714         
                      (    forth6809.asm):07715                    ENDC ; <<<<
                      (    forth6809.asm):07716         
                      (    forth6809.asm):07717         ; ------------------------------------------------------------
                      (    forth6809.asm):07718         ; TSTDEFWORDS - defining-words tests (glossary section 3.9, 17
                      (    forth6809.asm):07719         ; words, 12 tests since VALUE/TO and IS/ACTION-OF are each
                      (    forth6809.asm):07720         ; combined into one test). Every defining word parses a name
                      (    forth6809.asm):07721         ; from the input source via WORD (HEADER's own mechanism,
                      (    forth6809.asm):07722         ; shared by :/CREATE) - a complexity nothing in section 3.8 had.
                      (    forth6809.asm):07723         ; Each test redirects CODEHERE, DPHERE, VARHERE, and
                      (    forth6809.asm):07724         ; SRCADDR/SRCLEN/TOIN together (a fake name, "TESTWD", reused
                      (    forth6809.asm):07725         ; safely across every test here since each redirect/restore
                      (    forth6809.asm):07726         ; cycle is fully isolated), calls the real defining word
                      (    forth6809.asm):07727         ; directly, saves the newly-defined word's own CFA (= CODEHERE
                      (    forth6809.asm):07728         ; at the moment the defining word was called), restores
                      (    forth6809.asm):07729         ; everything, then executes that CFA directly to verify runtime
                      (    forth6809.asm):07730         ; behavior.
                      (    forth6809.asm):07731         ;
                      (    forth6809.asm):07732         ; A real, structurally important finding from this section:
                      (    forth6809.asm):07733         ; HEADER writes to the real LATEST variable unconditionally, not
                      (    forth6809.asm):07734         ; a redirectable copy like CODEHERE/DPHERE/VARHERE - every test
                      (    forth6809.asm):07735         ; here explicitly saves and restores it, confirmed necessary by
                      (    forth6809.asm):07736         ; reading HEADER's own code directly, not assumed safe by analogy
                      (    forth6809.asm):07737         ; with the other three pointers.
                      (    forth6809.asm):07738         ;
                      (    forth6809.asm):07739         ; MARKER's own test is the one exception to the general
                      (    forth6809.asm):07740         ; redirect-then-restore-then-execute order: DOMARKER (confirmed
                      (    forth6809.asm):07741         ; by reading it directly) writes to the real DPHERE/CODEHERE/
                      (    forth6809.asm):07742         ; VARHERE/LATEST unconditionally too, so that test executes the
                      (    forth6809.asm):07743         ; marker word while still redirected, only restoring the real
                      (    forth6809.asm):07744         ; environment afterward - getting this order backwards would
                      (    forth6809.asm):07745         ; have corrupted the real dictionary pointers with scratch
                      (    forth6809.asm):07746         ; addresses.
                      (    forth6809.asm):07747         ;
                      (    forth6809.asm):07748         ; Bare CREATE (never followed by DOES>) is deliberately not
                      (    forth6809.asm):07749         ; tested on its own - traced its placeholder "behavior field"
                      (    forth6809.asm):07750         ; (a genuine compiled JSR DOESRT0 instruction) and confirmed
                      (    forth6809.asm):07751         ; DODOES reads that field as raw data, not as code to execute -
                      (    forth6809.asm):07752         ; which only produces a valid jump target for the raw-address
                      (    forth6809.asm):07753         ; form every other defining word uses (VARIABLE, CONSTANT, etc,
                      (    forth6809.asm):07754         ; via CODECOMMA), not CREATE's own placeholder JSR instruction.
                      (    forth6809.asm):07755         ; Bare CREATE's own direct-execution behavior isn't meant to be
                      (    forth6809.asm):07756         ; relied upon before a DOES> patches it.
                      (    forth6809.asm):07757         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07758         TSTDEFWORDS: JSR CRW
                      (    forth6809.asm):07759                    LDX   #TSTDEFMSG
                      (    forth6809.asm):07760                    PSHU  X
                      (    forth6809.asm):07761                    LDD   #8
                      (    forth6809.asm):07762                    PSHU  D
                      (    forth6809.asm):07763                    JSR   TYPE
                      (    forth6809.asm):07764                    JSR   CRW
                      (    forth6809.asm):07765         
                      (    forth6809.asm):07766                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07767         
                      (    forth6809.asm):07768                    JSR   TSTVAR
                      (    forth6809.asm):07769                    JSR   TSTCONST
                      (    forth6809.asm):07770                    JSR   TSTCOLON
                      (    forth6809.asm):07771                    JSR   TSTCRDOES
                      (    forth6809.asm):07772                    JSR   TST2VAR
                      (    forth6809.asm):07773                    JSR   TST2CONST
                      (    forth6809.asm):07774                    JSR   TSTBUFC
                      (    forth6809.asm):07775                    JSR   TSTVALTO
                      (    forth6809.asm):07776                    JSR   TSTDEFER1
                      (    forth6809.asm):07777                    JSR   TSTDEFER2
                      (    forth6809.asm):07778                    JSR   TSTISOF
                      (    forth6809.asm):07779                    JSR   TSTMARKER
                      (    forth6809.asm):07780         
                      (    forth6809.asm):07781                    ENDC ; <<<<
                      (    forth6809.asm):07782         
                      (    forth6809.asm):07783                    RTS
                      (    forth6809.asm):07784         
C100                  (    forth6809.asm):07785         TSTDEFMSG: FCC "DefWords"
                      (    forth6809.asm):07786         
                      (    forth6809.asm):07787                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07788         
                      (    forth6809.asm):07789         ; ------------------------------------------------------------
                      (    forth6809.asm):07790         ; Defining-words test harness (glossary section 3.9). Every
                      (    forth6809.asm):07791         ; defining word parses a name from the input source via WORD -
                      (    forth6809.asm):07792         ; unlike anything in section 3.8's control-flow tests - so each
                      (    forth6809.asm):07793         ; test redirects CODEHERE, DPHERE, VARHERE, and SRCADDR/SRCLEN/
                      (    forth6809.asm):07794         ; TOIN together (a fake name text, "TESTWD", reused safely
                      (    forth6809.asm):07795         ; across every test here since each redirect/restore cycle is
                      (    forth6809.asm):07796         ; fully isolated), calls the real defining word directly, saves
                      (    forth6809.asm):07797         ; the newly-defined word's own CFA (= CODEHERE at the moment the
                      (    forth6809.asm):07798         ; defining word was called), restores everything, then executes
                      (    forth6809.asm):07799         ; that CFA directly to verify runtime behavior. Traced by hand:
                      (    forth6809.asm):07800         ; CREATE/VARIABLE/CONSTANT/etc all use HEADER (shared header-
                      (    forth6809.asm):07801         ; building) then compile a fixed 5-byte trampoline (3-byte
                      (    forth6809.asm):07802         ; "JSR DODOES" + a 2-byte "behavior field") before their own
                      (    forth6809.asm):07803         ; PFA - confirmed the behavior field holds a genuine compiled
                      (    forth6809.asm):07804         ; JSR instruction only for CREATE's own bare placeholder
                      (    forth6809.asm):07805         ; (DOESRT0, later patched by DOES>); every other defining word
                      (    forth6809.asm):07806         ; (VARIABLE, CONSTANT, DEFER, MARKER, VALUE) instead compiles a
                      (    forth6809.asm):07807         ; raw 2-byte address there directly (via CODECOMMA, not CCALL) -
                      (    forth6809.asm):07808         ; DODOES reads this field as data either way, which only works
                      (    forth6809.asm):07809         ; correctly for the raw-address form. This is why bare CREATE,
                      (    forth6809.asm):07810         ; executed before any DOES>, isn't tested here - its own
                      (    forth6809.asm):07811         ; placeholder behavior field isn't meant to be read as data,
                      (    forth6809.asm):07812         ; only ever overwritten by DOES> before first use.
                      (    forth6809.asm):07813         ; ------------------------------------------------------------
                      (    forth6809.asm):07814         
                      (    forth6809.asm):07815         ; ------------------------------------------------------------
                      (    forth6809.asm):07816         ; TSTVAR - unit test for VARIABLE. Compiles "VARIABLE TESTWD"
                      (    forth6809.asm):07817         ; into scratch, then executes the result. Verifies it pushes
                      (    forth6809.asm):07818         ; its own PFA address (TSTVBUF, since VARHERE was redirected
                      (    forth6809.asm):07819         ; there) and that the cell there was correctly initialized to
                      (    forth6809.asm):07820         ; zero - VARIABLE's own documented behavior, not assumed.
                      (    forth6809.asm):07821         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07822         TSTVAR:  LDD   CODEHERE
                      (    forth6809.asm):07823                  STD   TSTCSAV
                      (    forth6809.asm):07824                  LDD   DPHERE
                      (    forth6809.asm):07825                  STD   TSTDSAV
                      (    forth6809.asm):07826                  LDD   VARHERE
                      (    forth6809.asm):07827                  STD   TSTVSAV
                      (    forth6809.asm):07828                  LDD   SRCADDR
                      (    forth6809.asm):07829                  STD   TSTSASAV
                      (    forth6809.asm):07830                  LDD   SRCLEN
                      (    forth6809.asm):07831                  STD   TSTSLSAV
                      (    forth6809.asm):07832                  LDD   TOIN
                      (    forth6809.asm):07833                  STD   TSTTISAV
                      (    forth6809.asm):07834                  LDD   LATEST
                      (    forth6809.asm):07835                  STD   TSTLSAV
                      (    forth6809.asm):07836         
                      (    forth6809.asm):07837                  LDA   #'T'
                      (    forth6809.asm):07838                  STA   TSTNAMEB
                      (    forth6809.asm):07839                  LDA   #'E'
                      (    forth6809.asm):07840                  STA   TSTNAMEB+1
                      (    forth6809.asm):07841                  LDA   #'S'
                      (    forth6809.asm):07842                  STA   TSTNAMEB+2
                      (    forth6809.asm):07843                  LDA   #'T'
                      (    forth6809.asm):07844                  STA   TSTNAMEB+3
                      (    forth6809.asm):07845                  LDA   #'W'
                      (    forth6809.asm):07846                  STA   TSTNAMEB+4
                      (    forth6809.asm):07847                  LDA   #'D'
                      (    forth6809.asm):07848                  STA   TSTNAMEB+5
                      (    forth6809.asm):07849         
                      (    forth6809.asm):07850                  LDD   #TSTCBUF
                      (    forth6809.asm):07851                  STD   CODEHERE
                      (    forth6809.asm):07852                  LDD   #TSTDBUF
                      (    forth6809.asm):07853                  STD   DPHERE
                      (    forth6809.asm):07854                  LDD   #TSTVBUF
                      (    forth6809.asm):07855                  STD   VARHERE
                      (    forth6809.asm):07856                  LDD   #TSTNAMEB
                      (    forth6809.asm):07857                  STD   SRCADDR
                      (    forth6809.asm):07858                  LDD   #6
                      (    forth6809.asm):07859                  STD   SRCLEN
                      (    forth6809.asm):07860                  LDD   #0
                      (    forth6809.asm):07861                  STD   TOIN
                      (    forth6809.asm):07862         
                      (    forth6809.asm):07863                  LDD   CODEHERE
                      (    forth6809.asm):07864                  STD   TSTWCFA
                      (    forth6809.asm):07865         
                      (    forth6809.asm):07866                  JSR   VARIABLE
                      (    forth6809.asm):07867         
                      (    forth6809.asm):07868                  LDD   TSTCSAV
                      (    forth6809.asm):07869                  STD   CODEHERE
                      (    forth6809.asm):07870                  LDD   TSTDSAV
                      (    forth6809.asm):07871                  STD   DPHERE
                      (    forth6809.asm):07872                  LDD   TSTVSAV
                      (    forth6809.asm):07873                  STD   VARHERE
                      (    forth6809.asm):07874                  LDD   TSTSASAV
                      (    forth6809.asm):07875                  STD   SRCADDR
                      (    forth6809.asm):07876                  LDD   TSTSLSAV
                      (    forth6809.asm):07877                  STD   SRCLEN
                      (    forth6809.asm):07878                  LDD   TSTTISAV
                      (    forth6809.asm):07879                  STD   TOIN
                      (    forth6809.asm):07880                  LDD   TSTLSAV
                      (    forth6809.asm):07881                  STD   LATEST
                      (    forth6809.asm):07882         
                      (    forth6809.asm):07883                  STU   TSTU0
                      (    forth6809.asm):07884         
                      (    forth6809.asm):07885                  LDD   #TSTGUARD
                      (    forth6809.asm):07886                  PSHU  D
                      (    forth6809.asm):07887                  STU   TSTUB4
                      (    forth6809.asm):07888         
                      (    forth6809.asm):07889                  LDX   TSTWCFA
                      (    forth6809.asm):07890                  JSR   ,X
                      (    forth6809.asm):07891         
                      (    forth6809.asm):07892                  STU   TSTUAF
                      (    forth6809.asm):07893         
                      (    forth6809.asm):07894                  PULU  D
                      (    forth6809.asm):07895                  CMPD  #TSTVBUF
                      (    forth6809.asm):07896                  BNE   VRFAIL
                      (    forth6809.asm):07897         
                      (    forth6809.asm):07898                  LDX   TSTVBUF
                      (    forth6809.asm):07899                  LDD   ,X
                      (    forth6809.asm):07900                  CMPD  #0
                      (    forth6809.asm):07901                  BNE   VRFAIL
                      (    forth6809.asm):07902         
                      (    forth6809.asm):07903                  PULU  D
                      (    forth6809.asm):07904                  CMPD  #TSTGUARD
                      (    forth6809.asm):07905                  BNE   VRFAIL
                      (    forth6809.asm):07906         
                      (    forth6809.asm):07907                  LDD   TSTUB4
                      (    forth6809.asm):07908                  SUBD  TSTUAF
                      (    forth6809.asm):07909                  CMPD  #2
                      (    forth6809.asm):07910                  BNE   VRFAIL
                      (    forth6809.asm):07911         
                      (    forth6809.asm):07912                  LDD   #TRUEV
                      (    forth6809.asm):07913                  BRA   VRDONE
C100                  (    forth6809.asm):07914         VRFAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):07915         VRDONE:  LDX   #TSTVARNAME
                      (    forth6809.asm):07916                  PSHU  X
                      (    forth6809.asm):07917                  PSHU  D
                      (    forth6809.asm):07918                  JSR   TSTREPORT
                      (    forth6809.asm):07919         
                      (    forth6809.asm):07920                  LDU   TSTU0
                      (    forth6809.asm):07921                  RTS
                      (    forth6809.asm):07922         
C100                  (    forth6809.asm):07923         TSTVARNAME: FCB  6
                      (    forth6809.asm):07924                     FCC  "TSTVAR"
                      (    forth6809.asm):07925         
                      (    forth6809.asm):07926         ; ------------------------------------------------------------
                      (    forth6809.asm):07927         ; TSTCONST - unit test for CONSTANT. Compiles "5 CONSTANT
                      (    forth6809.asm):07928         ; TESTWD" (5 already pushed before CONSTANT runs, matching its
                      (    forth6809.asm):07929         ; own "x name --" signature) into scratch, then executes the
                      (    forth6809.asm):07930         ; result. Verifies it pushes the stored value (5), not its own
                      (    forth6809.asm):07931         ; address - confirmed by tracing CONSTANT's own behavior field:
                      (    forth6809.asm):07932         ; it compiles a raw address to ATSIGN (@) there directly via
                      (    forth6809.asm):07933         ; CODECOMMA, not CREATE's own placeholder mechanism.
                      (    forth6809.asm):07934         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07935         TSTCONST: LDD  CODEHERE
                      (    forth6809.asm):07936                   STD  TSTCSAV
                      (    forth6809.asm):07937                   LDD  DPHERE
                      (    forth6809.asm):07938                   STD  TSTDSAV
                      (    forth6809.asm):07939                   LDD  VARHERE
                      (    forth6809.asm):07940                   STD  TSTVSAV
                      (    forth6809.asm):07941                   LDD  SRCADDR
                      (    forth6809.asm):07942                   STD  TSTSASAV
                      (    forth6809.asm):07943                   LDD  SRCLEN
                      (    forth6809.asm):07944                   STD  TSTSLSAV
                      (    forth6809.asm):07945                   LDD  TOIN
                      (    forth6809.asm):07946                   STD  TSTTISAV
                      (    forth6809.asm):07947                   LDD  LATEST
                      (    forth6809.asm):07948                   STD  TSTLSAV
                      (    forth6809.asm):07949         
                      (    forth6809.asm):07950                   LDA  #'T'
                      (    forth6809.asm):07951                   STA  TSTNAMEB
                      (    forth6809.asm):07952                   LDA  #'E'
                      (    forth6809.asm):07953                   STA  TSTNAMEB+1
                      (    forth6809.asm):07954                   LDA  #'S'
                      (    forth6809.asm):07955                   STA  TSTNAMEB+2
                      (    forth6809.asm):07956                   LDA  #'T'
                      (    forth6809.asm):07957                   STA  TSTNAMEB+3
                      (    forth6809.asm):07958                   LDA  #'W'
                      (    forth6809.asm):07959                   STA  TSTNAMEB+4
                      (    forth6809.asm):07960                   LDA  #'D'
                      (    forth6809.asm):07961                   STA  TSTNAMEB+5
                      (    forth6809.asm):07962         
                      (    forth6809.asm):07963                   LDD  #TSTCBUF
                      (    forth6809.asm):07964                   STD  CODEHERE
                      (    forth6809.asm):07965                   LDD  #TSTDBUF
                      (    forth6809.asm):07966                   STD  DPHERE
                      (    forth6809.asm):07967                   LDD  #TSTVBUF
                      (    forth6809.asm):07968                   STD  VARHERE
                      (    forth6809.asm):07969                   LDD  #TSTNAMEB
                      (    forth6809.asm):07970                   STD  SRCADDR
                      (    forth6809.asm):07971                   LDD  #6
                      (    forth6809.asm):07972                   STD  SRCLEN
                      (    forth6809.asm):07973                   LDD  #0
                      (    forth6809.asm):07974                   STD  TOIN
                      (    forth6809.asm):07975         

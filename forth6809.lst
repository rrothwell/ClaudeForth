                      (    forth6809.asm):06066         ; ============================================================
                      (    forth6809.asm):06067         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06068         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06069         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06070         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06071         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06072         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06073         ; ============================================================
                      (    forth6809.asm):06074         ; ------------------------------------------------------------
                      (    forth6809.asm):06075         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06076         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06077         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06078         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06079         ; - no indirection, no value cell.
                      (    forth6809.asm):06080         ;
                      (    forth6809.asm):06081         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06082         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06083         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06084         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06085         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06086         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06087         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06088         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06089         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06090         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06091         ; ------------------------------------------------------------
FEFB CCFFFF           (    forth6809.asm):06092         TRUEBODY:  LDD   #$FFFF
FEFE 3606             (    forth6809.asm):06093                    PSHU  D
FF00 39               (    forth6809.asm):06094                    RTS
                      (    forth6809.asm):06095         
FF01 CC0000           (    forth6809.asm):06096         FALSEBODY: LDD   #$0000
FF04 3606             (    forth6809.asm):06097                    PSHU  D
FF06 39               (    forth6809.asm):06098                    RTS
                      (    forth6809.asm):06099         
                      (    forth6809.asm):06100         ; ------------------------------------------------------------
                      (    forth6809.asm):06101         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):06102         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):06103         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):06104         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):06105         ; ------------------------------------------------------------
FF07 CC0001           (    forth6809.asm):06106         ONEBODY:   LDD   #1
FF0A 3606             (    forth6809.asm):06107                    PSHU  D
FF0C 39               (    forth6809.asm):06108                    RTS
                      (    forth6809.asm):06109         
FF0D CCFFFF           (    forth6809.asm):06110         MONEBODY:  LDD   #-1
FF10 3606             (    forth6809.asm):06111                    PSHU  D
FF12 39               (    forth6809.asm):06112                    RTS
                      (    forth6809.asm):06113         
FF13 CC0002           (    forth6809.asm):06114         TWOBODY:   LDD   #2
FF16 3606             (    forth6809.asm):06115                    PSHU  D
FF18 39               (    forth6809.asm):06116                    RTS
                      (    forth6809.asm):06117         
FF19 CCFFFE           (    forth6809.asm):06118         MTWOBODY:  LDD   #-2
FF1C 3606             (    forth6809.asm):06119                    PSHU  D
FF1E 39               (    forth6809.asm):06120                    RTS
                      (    forth6809.asm):06121         
                      (    forth6809.asm):06122         ; Verify no collision with init code,
                      (    forth6809.asm):06123         ; value should match ORG INITCODE.
     FF1F             (    forth6809.asm):06124         BASECODEEND  EQU   *
     1EF5             (    forth6809.asm):06125         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):06126         
                      (    forth6809.asm):06127         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):06128         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):06129         ; .bin file.
FF1F                  (    forth6809.asm):06130         BASEND:
FF1F FFFFFFFFFFFFFFFF (    forth6809.asm):06131                  FILL $FF,INITCODE-BASEND

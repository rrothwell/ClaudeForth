                      (    forth6809.asm):02373                     ; INCHAR path also reads and writes, by calling CHKHI too
                      (    forth6809.asm):02374                     ; (safely, from ISR context, where interrupts are already
                      (    forth6809.asm):02375                     ; hardware-masked). GETCHAR is only ever called from
                      (    forth6809.asm):02376                     ; mainline code (KEY), unmasked, so without masking here an
                      (    forth6809.asm):02377                     ; interrupt landing mid-call could race this call against
                      (    forth6809.asm):02378                     ; IRQH's own concurrent one, leaving RTSSTATE corrupted or
                      (    forth6809.asm):02379                     ; ACIACR written twice with conflicting values. Masked here
                      (    forth6809.asm):02380                     ; (IRQ only, matching RTSCHECKLO's own existing discipline
                      (    forth6809.asm):02381                     ; below) rather than inside CHKLO itself, since CHKHI's
                      (    forth6809.asm):02382                     ; ISR-context caller must NOT unmask IRQ before its own RTI.
                      (    forth6809.asm):02383                     ; The fill-level read is inside the same masked span, for
                      (    forth6809.asm):02384                     ; the same reason: INHEAD could be mid-update by the ISR.
                      (    forth6809.asm):02385                     ORCC  #$10
                      (    forth6809.asm):02386                     LDB   INHEAD           ; Calculate current fill level fresh -
                      (    forth6809.asm):02387                     SUBB  INTAIL           ; both pointers may have moved since
                      (    forth6809.asm):02388                     ANDB  #INBUFSZ-1       ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02389                                             ; there's no already-loaded value here
                      (    forth6809.asm):02390                                             ; worth reusing.
                      (    forth6809.asm):02391                     JSR   CHKLO
                      (    forth6809.asm):02392                     ANDCC #$EF
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394                     ANDCC #$FE               ; Carry flag %0 = valid character
                      (    forth6809.asm):02395                     RTS
                      (    forth6809.asm):02396         
DD75                  (    forth6809.asm):02397         GET_NO_CHAR:
                      (    forth6809.asm):02398                     ORCC  #$01               ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02399                     RTS
                      (    forth6809.asm):02400         ; ------------------------------------------------------------
                      (    forth6809.asm):02401         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):02402         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):02403         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):02404         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):02405         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):02406         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):02407         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):02408         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):02409         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02410         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02411         RTSCHECKLO: 
                      (    forth6809.asm):02412                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02413         
                      (    forth6809.asm):02414                                 JSR  INFILL
                      (    forth6809.asm):02415                     CMPA #INLOWATER
                      (    forth6809.asm):02416                     BHI  RTSCLODONE
                      (    forth6809.asm):02417                     TST  RTSSTATE
                      (    forth6809.asm):02418                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):02419         
                      (    forth6809.asm):02420         
                      (    forth6809.asm):02421                     CLR  RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02422         
                      (    forth6809.asm):02423                     LDB  OUTTAIL           ; Check if chars are available.  
                      (    forth6809.asm):02424                     CMPB OUTHEAD
                      (    forth6809.asm):02425                     BEQ  RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02426         
                      (    forth6809.asm):02427                     LDA  #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02428                     STA  ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02429                     BRA  RTSCLOUNMASK
                      (    forth6809.asm):02430         
DD75                  (    forth6809.asm):02431         RTSCLONOTX: LDA  #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02432                     STA  ACIACR
                      (    forth6809.asm):02433         
DD75                  (    forth6809.asm):02434         RTSCLOUNMASK: ANDCC #$EF
                      (    forth6809.asm):02435         
DD75                  (    forth6809.asm):02436         RTSCLODONE: RTS
                      (    forth6809.asm):02437         
                      (    forth6809.asm):02438         ; ------------------------------------------------------------
                      (    forth6809.asm):02439         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02440         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02441         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02442         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02443         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02444         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02445         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02446         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02447         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02448         ;
                      (    forth6809.asm):02449         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02450         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02451         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02452         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02453         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02454         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02455         ;
                      (    forth6809.asm):02456         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02457         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02458         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02459         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02460         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02461         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02462         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02463         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02464         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02465         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02466         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02467         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02468         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02469         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02470         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02471         
                      (    forth6809.asm):02472                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02473                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02474                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02475                     BNE   INCHAR
                      (    forth6809.asm):02476                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02477                     BNE   OUTCHAR
                      (    forth6809.asm):02478                                             ; Ignore all other interrupts such as DCD change.
DD75                  (    forth6809.asm):02479         IRQDONE0:  RTI                      ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02480                                             ; & restores state.
                      (    forth6809.asm):02481         
DD75                  (    forth6809.asm):02482         INCHAR:
                      (    forth6809.asm):02483                     LDB   ACIADR               ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02484                     BITA  #SR_FE+SR_OVRN+SR_PE ; Any receiver error flagged?
                      (    forth6809.asm):02485                     BEQ   INOK                 ; No! - character is good, keep it.
                      (    forth6809.asm):02486                                              
                      (    forth6809.asm):02487                     BITA  #SR_FE               ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02488                     BEQ   INXFE                ; Tally each flagged error independently -
                      (    forth6809.asm):02489                     INC   FECOUNT              ; more than one bit can be set at once.
DD75                  (    forth6809.asm):02490         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02491                     BEQ   INXOVRN
                      (    forth6809.asm):02492                     INC   OVRNCOUNT
DD75                  (    forth6809.asm):02493         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02494                     BEQ   INXPE
                      (    forth6809.asm):02495                     INC   PECOUNT 
DD75                  (    forth6809.asm):02496         INXPE:      RTI         
                      (    forth6809.asm):02497         
DD75                  (    forth6809.asm):02498         INOK:    TFR   B,A                  ; Transfer good character from the receiver.
                      (    forth6809.asm):02499                  LDX   #INBUF               ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02500                  LDB   INHEAD
                      (    forth6809.asm):02501                  STA   B,X
                      (    forth6809.asm):02502                  INCB                  ; Figure out the new head,
                      (    forth6809.asm):02503                  ANDB  #INBUFSZ-1      ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02504                  CMPB  INTAIL          ; Would the new head slot meet the tail?
                      (    forth6809.asm):02505                  BEQ   IRQDONE1        ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02506                  STB   INHEAD          ; New head pointer is OK so store it.
                      (    forth6809.asm):02507                  ;JSR   RTSCHECKHI     ; Protect the in buffer from overflow.
                      (    forth6809.asm):02508                                        ; OPTIMIZATION: RegB still holds the new head
                      (    forth6809.asm):02509                                        ; value STB just stored (STB doesn't clobber
                      (    forth6809.asm):02510                                        ; it) - reuse it directly to get the fill
                      (    forth6809.asm):02511                                        ; level, rather than have CHKHI reload INHEAD
                      (    forth6809.asm):02512                                        ; from memory. This is the single hottest
                      (    forth6809.asm):02513                                        ; per-character path in the system (it runs
                      (    forth6809.asm):02514                                        ; on every byte received), so a redundant
                      (    forth6809.asm):02515                                        ; 4-cycle load here is worth avoiding.
                      (    forth6809.asm):02516                  SUBB  INTAIL          ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02517                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02518                  JSR   CHKHI           ; Protect the in buffer from overflow.
DD75                  (    forth6809.asm):02519         IRQDONE1: RTI
                      (    forth6809.asm):02520         
                      (    forth6809.asm):02521                  ; LDA   ACIASR          ; Recheck if the transmitter is ready.
                      (    forth6809.asm):02522                  ; BITA  #SR_TDRE        ; after handling the received character.
                      (    forth6809.asm):02523                  ; BEQ IRQDONE2          ; Yes! Process the char.
                      (    forth6809.asm):02524         
DD75                  (    forth6809.asm):02525         OUTCHAR: LDB   OUTTAIL         ; Is the out buffer empty?
                      (    forth6809.asm):02526                  CMPB  OUTHEAD
                      (    forth6809.asm):02527                  BEQ   TXOFF           ; Yes! Stop transmitting.
                      (    forth6809.asm):02528         
                      (    forth6809.asm):02529                  LDX   #OUTBUF         ; No! The out buffer is occupied.
                      (    forth6809.asm):02530                  LDA   B,X             ; Get the character from the out buffer.
                      (    forth6809.asm):02531                  STA   ACIADR          ; Transmit the char.
                      (    forth6809.asm):02532         
                      (    forth6809.asm):02533                  INCB                  ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02534                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02535                  STB   OUTTAIL
DD75                  (    forth6809.asm):02536         IRQDONE2  RTI
                      (    forth6809.asm):02537         
DD75                  (    forth6809.asm):02538         TXOFF:   ; TST   RTSSTATE        ; The buffer is empty.
                      (    forth6809.asm):02539                  ; BNE   IRQDONE3         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02540                                        ; or this would incorrectly drop it back low
                      (    forth6809.asm):02541                  ; LDA   #CR_RXON
                      (    forth6809.asm):02542                  ; STA   ACIACR
                      (    forth6809.asm):02543                  CLR   OUTACTIVITY         
                      (    forth6809.asm):02544                  JSR   UPDATE_RTS         
DD75                  (    forth6809.asm):02545         IRQDONE3 RTI
                      (    forth6809.asm):02546         
                      (    forth6809.asm):02547                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):02548         
DD75 3B               (    forth6809.asm):02549         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02550                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02551                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02552                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02553                                       ; the other unused vectors below
                      (    forth6809.asm):02554                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02555         
DD76 3B               (    forth6809.asm):02556         SWI3H:   RTI
DD77 3B               (    forth6809.asm):02557         SWI2H:   RTI
DD78 3B               (    forth6809.asm):02558         FIRQH:   RTI
DD79 3B               (    forth6809.asm):02559         NMIH:    RTI                   ; unused now that NMI -> WARM
DD7A CCFF9D           (    forth6809.asm):02560         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DD7D 3606             (    forth6809.asm):02561                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DD7F 7EE5C7           (    forth6809.asm):02562                  JMP   THROW
                      (    forth6809.asm):02563         

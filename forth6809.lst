                      (    forth6809.asm):01822                    BNE   DHFAIL
                      (    forth6809.asm):01823         
                      (    forth6809.asm):01824                    LDD   TSTUB4
                      (    forth6809.asm):01825                    SUBD  TSTUAF
                      (    forth6809.asm):01826                    CMPD  #2
                      (    forth6809.asm):01827                    BNE   DHFAIL
                      (    forth6809.asm):01828         

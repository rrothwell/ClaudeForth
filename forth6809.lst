                      (    forth6809.asm):13609                    BNE  SN2FAIL
                      (    forth6809.asm):13610         
                      (    forth6809.asm):13611                    LDD  TSTUB4
                      (    forth6809.asm):13612                    SUBD TSTUAF
                      (    forth6809.asm):13613                    CMPD #2
                      (    forth6809.asm):13614                    BNE  SN2FAIL
                      (    forth6809.asm):13615         
                      (    forth6809.asm):13616                    LDD  #TRUEV
                      (    forth6809.asm):13617                    BRA  SN2DONE
C2B4                  (    forth6809.asm):13618         SN2FAIL:   LDD  #FALSEV
C2B4                  (    forth6809.asm):13619         SN2DONE:   LDX  #TSTSN2NAME
                      (    forth6809.asm):13620                    PSHU X
                      (    forth6809.asm):13621                    PSHU D
                      (    forth6809.asm):13622                    JSR  TSTREPORT
                      (    forth6809.asm):13623         

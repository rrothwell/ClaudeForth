                      (    forth6809.asm):07482         ; ------------------------------------------------------------
                      (    forth6809.asm):07483         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):07484         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):07485         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):07486         ; ------------------------------------------------------------
FA36 BDFA4B           (    forth6809.asm):07487         NUMW:       JSR   UDDIGIT           ; ud1 is divided in place on the data stack
FA39 810A             (    forth6809.asm):07488                     CMPA  #10
FA3B 2504             (    forth6809.asm):07489                     BLO   NDIGIT
FA3D 8B37             (    forth6809.asm):07490                     ADDA  #'A'-10
FA3F 2002             (    forth6809.asm):07491                     BRA   NHOLD
FA41 8B30             (    forth6809.asm):07492         NDIGIT:     ADDA  #'0'
FA43 1F89             (    forth6809.asm):07493         NHOLD:      TFR   A,B
FA45 4F               (    forth6809.asm):07494                     CLRA
FA46 3606             (    forth6809.asm):07495                     PSHU  D
FA48 7EFA11           (    forth6809.asm):07496                     JMP   HOLDW
                      (    forth6809.asm):07497         
                      (    forth6809.asm):07498         ; ------------------------------------------------------------
                      (    forth6809.asm):07499         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):07500         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):07501         ; low byte of BASE is used.
                      (    forth6809.asm):07502         ; UDDIGIT
                      (    forth6809.asm):07503         ;    Inputs:
                      (    forth6809.asm):07504         ;        ud on the data stack
                      (    forth6809.asm):07505         ;    Outputs:
                      (    forth6809.asm):07506         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):07507         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):07508         ; ------------------------------------------------------------
FA4B 4F               (    forth6809.asm):07509         UDDIGIT:    CLRA                    ; A = remainder
FA4C C620             (    forth6809.asm):07510                     LDB   #32
FA4E 6843             (    forth6809.asm):07511         UDDLOOP:    ASL   3,U
FA50 6942             (    forth6809.asm):07512                     ROL   2,U
FA52 6941             (    forth6809.asm):07513                     ROL   1,U
FA54 69C4             (    forth6809.asm):07514                     ROL   ,U
FA56 49               (    forth6809.asm):07515                     ROLA
FA57 9103             (    forth6809.asm):07516                     CMPA  BASE+1
FA59 2504             (    forth6809.asm):07517                     BLO   UDNEXT
FA5B 9003             (    forth6809.asm):07518                     SUBA  BASE+1
FA5D 6C43             (    forth6809.asm):07519                     INC   3,U
FA5F 5A               (    forth6809.asm):07520         UDNEXT:     DECB
FA60 26EC             (    forth6809.asm):07521                     BNE   UDDLOOP
FA62 39               (    forth6809.asm):07522                     RTS
                      (    forth6809.asm):07523         
                      (    forth6809.asm):07524         ; ------------------------------------------------------------
                      (    forth6809.asm):07525         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):07526         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):07527         ; is produced).
                      (    forth6809.asm):07528         ; ------------------------------------------------------------

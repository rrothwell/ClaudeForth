                      (    forth6809.asm):13292         ; TSTREPLSUBS1 - unit test for REPLACES and SUBSTITUTE together
                      (    forth6809.asm):13293         ; (can only be meaningfully tested together - SUBSTITUTE depends
                      (    forth6809.asm):13294         ; on a prior REPLACES registration). Registers "X"->"Z", then
                      (    forth6809.asm):13295         ; runs the template "%%A%X%B%Y%" through SUBSTITUTE - covering
                      (    forth6809.asm):13296         ; three of the four documented cases in one pass: "%%" collapses
                      (    forth6809.asm):13297         ; to a single '%', "%X%" (a registered name) gets replaced
                      (    forth6809.asm):13298         ; (count incremented), and "%Y%" (not registered) passes through
                      (    forth6809.asm):13299         ; unchanged, delimiters included. Expected result ("%AZB%Y%",
                      (    forth6809.asm):13300         ; count=1) independently simulated in Python against the actual
                      (    forth6809.asm):13301         ; traced algorithm before writing this test, not hand-derived
                      (    forth6809.asm):13302         ; and hoped correct - see TSTREPLSUBS2 for the fourth case
                      (    forth6809.asm):13303         ; (unpaired trailing '%'), tested separately for clearer failure
                      (    forth6809.asm):13304         ; diagnosis.
                      (    forth6809.asm):13305         ; ------------------------------------------------------------

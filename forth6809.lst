                      (    forth6809.asm):09214                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):09215                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):09216                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):09217                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):09218                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):09219                  ; for it.
E591 D621             (    forth6809.asm):09220                  LDB   CNTREM
E593 5A               (    forth6809.asm):09221                  DECB
E594 A685             (    forth6809.asm):09222                  LDA   B,X
E596 812E             (    forth6809.asm):09223                  CMPA  #'.'

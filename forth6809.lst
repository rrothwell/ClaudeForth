E9BA EC62             (    forth6809.asm):03639         IWORD:   LDD   2,S        ; BUG FIX: PULS X/PSHS X used to bracket this
E9BC 3606             (    forth6809.asm):03640                  PSHU  D          ; read, shifting S by 2 first - so "2,S" landed
E9BE 39               (    forth6809.asm):03641                  RTS              ; on the limit (what's really at 4,S unshifted)
                      (    forth6809.asm):03642                                   ; instead of the index. The pair served no
                      (    forth6809.asm):03643                                   ; purpose (nothing needed offset 0 for anything
                      (    forth6809.asm):03644                                   ; here) - removed, so 2,S directly and
                      (    forth6809.asm):03645                                   ; correctly targets the index DOSETUP pushed
                      (    forth6809.asm):03646                                   ; there. Confirmed via MAME debugger: "I"
                      (    forth6809.asm):03647                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):03648         
E9BF EC68             (    forth6809.asm):03649         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E9C1 3606             (    forth6809.asm):03650                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E9C3 39               (    forth6809.asm):03651                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):03652                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):03653                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):03654                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):03655                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):03656                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):03657                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):03658                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):03659                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):03660                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):03661                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):03662                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):03663                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):03664                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):03665                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):03666                                   ; limit, never progressing). Confirmed via a
                      (    forth6809.asm):03667                                   ; real MULT-TABLE test on MAME.
                      (    forth6809.asm):03668         
E9C4 CCFFFF           (    forth6809.asm):03669         LEAVE:   LDD   #TRUEV    ; BUG FIX (earlier): was PULS X first, shifting
E9C7 ED66             (    forth6809.asm):03670                  STD   6,S       ; S by 2 before this write, landing 2 bytes
E9C9 39               (    forth6809.asm):03671                  RTS             ; past the LEAVE flag DOSETUP actually pushed.
                      (    forth6809.asm):03672                                   ; Fixed by deferring PULS X to after the
                      (    forth6809.asm):03673                                   ; write - but that left a PULS X/PSHS X pair
                      (    forth6809.asm):03674                                   ; that had become a genuine no-op (nothing
                      (    forth6809.asm):03675                                   ; between them touches S or X, and this
                      (    forth6809.asm):03676                                   ; routine never uses X's value for anything,
                      (    forth6809.asm):03677                                   ; unlike DOTEST's own deferred PULS X, which
                      (    forth6809.asm):03678                                   ; feeds LDD ,X/LEAX D,X afterward). Removed,
                      (    forth6809.asm):03679                                   ; per the parallel 68000 port's observation,
                      (    forth6809.asm):03680                                   ; confirmed by inspection.
                      (    forth6809.asm):03681         
E9CA 3706             (    forth6809.asm):03682         LOOP:    PULU  D

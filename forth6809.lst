F568 1F02             (    forth6809.asm):05428                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):05429                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):05430                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):05431                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):05432                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):05433                                   ; The high byte took on the fill character's
                      (    forth6809.asm):05434                                   ; value instead of the count's real high
                      (    forth6809.asm):05435                                   ; byte, so the count almost never reached
                      (    forth6809.asm):05436                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):05437                                   ; past the requested length. Keeping the
                      (    forth6809.asm):05438                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):05439                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):05440                                   ; fill character into A) and removes the
                      (    forth6809.asm):05441                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):05442                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):05443                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):05444                                   ; MAME debugger.

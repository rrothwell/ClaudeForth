                      (    forth6809.asm):12863                      JSR  ,X
                      (    forth6809.asm):12864         
                      (    forth6809.asm):12865                      STU  TSTUAF
                      (    forth6809.asm):12866         
                      (    forth6809.asm):12867                      IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):12868                      LDA  TSTOHSAV
                      (    forth6809.asm):12869                      ADDA #2
                      (    forth6809.asm):12870                      ANDA #OUTBUFSZ-1
                      (    forth6809.asm):12871                      CMPA OUTHEAD
                      (    forth6809.asm):12872                      BNE  DXFAIL
                      (    forth6809.asm):12873         
                      (    forth6809.asm):12874                      LDX  #OUTBUF
                      (    forth6809.asm):12875                      LDB  TSTOHSAV
                      (    forth6809.asm):12876                      LDA  B,X
                      (    forth6809.asm):12877                      CMPA #'H'
                      (    forth6809.asm):12878                      BNE  DXFAIL
                      (    forth6809.asm):12879                      INCB
                      (    forth6809.asm):12880                      ANDB #OUTBUFSZ-1
                      (    forth6809.asm):12881                      LDA  B,X
                      (    forth6809.asm):12882                      CMPA #'I'
                      (    forth6809.asm):12883                      BNE  DXFAIL
                      (    forth6809.asm):12884                      ELSE  ; <<<<>>>>
                      (    forth6809.asm):12885                      LDA  EMITCH
                      (    forth6809.asm):12886                      CMPA #'I'
                      (    forth6809.asm):12887                      BNE  DXFAIL
                      (    forth6809.asm):12888                      ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):12889         
                      (    forth6809.asm):12890                      PULU D
                      (    forth6809.asm):12891                      CMPD #TSTGUARD
                      (    forth6809.asm):12892                      BNE  DXFAIL
                      (    forth6809.asm):12893         
                      (    forth6809.asm):12894                      LDD  TSTUB4
                      (    forth6809.asm):12895                      SUBD TSTUAF
                      (    forth6809.asm):12896                      CMPD #0
                      (    forth6809.asm):12897                      BNE  DXFAIL

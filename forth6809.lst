                      (    forth6809.asm):06246         ; ------------------------------------------------------------
F3B5 CC0020           (    forth6809.asm):06247         BLANKW:     LDD   #32
F3B8 3606             (    forth6809.asm):06248                     PSHU  D
F3BA 7EF397           (    forth6809.asm):06249                     JMP   FILLW
                      (    forth6809.asm):06250         

                      (    forth6809.asm):02408         ; ------------------------------------------------------------
                      (    forth6809.asm):02409         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02410         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02411         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02412         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02413         ; IRQH
                      (    forth6809.asm):02414         ;    Inputs:
                      (    forth6809.asm):02415         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02416         ;    Outputs:
                      (    forth6809.asm):02417         ;        none (returns with RTI)
                      (    forth6809.asm):02418         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02419         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02420         ; ------------------------------------------------------------
CF4B B6C008           (    forth6809.asm):02421         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02422         
CF4E 8580             (    forth6809.asm):02423                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
CF50 2709             (    forth6809.asm):02424                     BEQ   IRQCHN            ; No! Pass it down the chain.
CF52 8501             (    forth6809.asm):02425                     BITA  #SR_RDRF          ; Is an incoming character available?
CF54 2609             (    forth6809.asm):02426                     BNE   INCHAR
CF56 8502             (    forth6809.asm):02427                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
CF58 2640             (    forth6809.asm):02428                     BNE   OUTCHAR
                      (    forth6809.asm):02429                                             ; Ignore all other interrupts such as DCD change.
CF5A 3B               (    forth6809.asm):02430         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02431                                             ; & restores state.
     CF5A             (    forth6809.asm):02432         IRQRTI      EQU   IRQDONE0          ; IRQCHAIN initially points here
CF5B 6E9F0083         (    forth6809.asm):02433         IRQCHN:     JMP   [IRQCHAIN]        ; not the ACIA: next handler in the chain.
                      (    forth6809.asm):02434                                             ; See shadow IRQH.1
                      (    forth6809.asm):02435         
CF5F                  (    forth6809.asm):02436         INCHAR:

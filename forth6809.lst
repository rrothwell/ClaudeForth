                      (    forth6809.asm):02668                    JSR   TSTMODW
                      (    forth6809.asm):02669                    JSR   TSTMODZ
                      (    forth6809.asm):02670                    JSR   TSTSLMOD
                      (    forth6809.asm):02671                    JSR   TSTSLMODZ
                      (    forth6809.asm):02672                    JSR   TSTNEGATE
                      (    forth6809.asm):02673                    JSR   TSTABS1

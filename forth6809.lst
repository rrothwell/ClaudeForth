                      (    forth6809.asm):11145                       RTS
                      (    forth6809.asm):11146         
C29B                  (    forth6809.asm):11147         TSTPSNAME: FCB  12
                      (    forth6809.asm):11148                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11149         
                      (    forth6809.asm):11150         ; ------------------------------------------------------------
                      (    forth6809.asm):11151         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11152         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11153         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11154         ; the documented convention on both ends).
                      (    forth6809.asm):11155         ; ------------------------------------------------------------

                      (    forth6809.asm):02325         ; ------------------------------------------------------------
                      (    forth6809.asm):02326         ; GETCHAR
                      (    forth6809.asm):02327         ;    Inputs: 
                      (    forth6809.asm):02328         ;        none
                      (    forth6809.asm):02329         ;    Outputs: 
                      (    forth6809.asm):02330         ;         RegA  = next character retrieved from receive buffer.
                      (    forth6809.asm):02331         ;         RegCC(carry) = valid?.
                      (    forth6809.asm):02332         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02333         GETCHAR:
                      (    forth6809.asm):02334                     LDB   INTAIL           ; Is the out buffer populated?
                      (    forth6809.asm):02335                     CMPB  INHEAD           

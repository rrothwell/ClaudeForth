                      (    forth6809.asm):09373         ; ------------------------------------------------------------
                      (    forth6809.asm):09374         ; TRUE  ( -- flag )
                      (    forth6809.asm):09375         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09376         ; DODOES trampoline and no value cell.

                      (    forth6809.asm):07507         ; TSTCASE2 - unit test for CASE/OF/ENDOF/ENDCASE, no-match
                      (    forth6809.asm):07508         ; case. Same compiled snippet as TSTCASE1, run with a selector
                      (    forth6809.asm):07509         ; (99) matching neither clause - should fall through both OF
                      (    forth6809.asm):07510         ; checks (selector preserved across each non-match, per the
                      (    forth6809.asm):07511         ; documented "( x n -- | x )" effect) and reach ENDCASE's own
                      (    forth6809.asm):07512         ; fallback DROP, consuming the selector with nothing pushed in
                      (    forth6809.asm):07513         ; its place.
                      (    forth6809.asm):07514         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07515         TSTCASE2: LDD  CODEHERE
                      (    forth6809.asm):07516                   STD  TSTCSAV
                      (    forth6809.asm):07517                   LDD  #TSTCBUF
                      (    forth6809.asm):07518                   STD  CODEHERE
                      (    forth6809.asm):07519         
                      (    forth6809.asm):07520                   JSR  CASEW
                      (    forth6809.asm):07521         
                      (    forth6809.asm):07522                   LDD  #1
                      (    forth6809.asm):07523                   PSHU D
                      (    forth6809.asm):07524                   JSR  LITERALW
                      (    forth6809.asm):07525                   JSR  OF
                      (    forth6809.asm):07526                   LDD  #111
                      (    forth6809.asm):07527                   PSHU D
                      (    forth6809.asm):07528                   JSR  LITERALW
                      (    forth6809.asm):07529                   JSR  ENDOF
                      (    forth6809.asm):07530         
                      (    forth6809.asm):07531                   LDD  #2
                      (    forth6809.asm):07532                   PSHU D
                      (    forth6809.asm):07533                   JSR  LITERALW
                      (    forth6809.asm):07534                   JSR  OF
                      (    forth6809.asm):07535                   LDD  #222
                      (    forth6809.asm):07536                   PSHU D
                      (    forth6809.asm):07537                   JSR  LITERALW
                      (    forth6809.asm):07538                   JSR  ENDOF
                      (    forth6809.asm):07539         
                      (    forth6809.asm):07540                   JSR  ENDCASE
                      (    forth6809.asm):07541         
                      (    forth6809.asm):07542                   LDD  #OPRTS
                      (    forth6809.asm):07543                   PSHU D
                      (    forth6809.asm):07544                   JSR  CCOMMA
                      (    forth6809.asm):07545         
                      (    forth6809.asm):07546                   LDD  TSTCSAV
                      (    forth6809.asm):07547                   STD  CODEHERE
                      (    forth6809.asm):07548         
                      (    forth6809.asm):07549                   STU  TSTU0
                      (    forth6809.asm):07550         
                      (    forth6809.asm):07551                   LDD  #TSTGUARD
                      (    forth6809.asm):07552                   PSHU D
                      (    forth6809.asm):07553                   LDD  #99
                      (    forth6809.asm):07554                   PSHU D
                      (    forth6809.asm):07555                   STU  TSTUB4
                      (    forth6809.asm):07556         
                      (    forth6809.asm):07557                   JSR  TSTCBUF
                      (    forth6809.asm):07558         
                      (    forth6809.asm):07559                   STU  TSTUAF
                      (    forth6809.asm):07560         
                      (    forth6809.asm):07561                   PULU D
                      (    forth6809.asm):07562                   CMPD #TSTGUARD
                      (    forth6809.asm):07563                   BNE  C2FAIL
                      (    forth6809.asm):07564         
                      (    forth6809.asm):07565                   LDD  TSTUB4
                      (    forth6809.asm):07566                   SUBD TSTUAF
                      (    forth6809.asm):07567                   CMPD #-2
                      (    forth6809.asm):07568                   BNE  C2FAIL
                      (    forth6809.asm):07569         
                      (    forth6809.asm):07570                   LDD  #TRUEV
                      (    forth6809.asm):07571                   BRA  C2DONE
C100                  (    forth6809.asm):07572         C2FAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):07573         C2DONE:   LDX  #TSTCASE2NAME
                      (    forth6809.asm):07574                   PSHU X
                      (    forth6809.asm):07575                   PSHU D
                      (    forth6809.asm):07576                   JSR  TSTREPORT
                      (    forth6809.asm):07577         
                      (    forth6809.asm):07578                   LDU  TSTU0
                      (    forth6809.asm):07579                   RTS
                      (    forth6809.asm):07580         
C100                  (    forth6809.asm):07581         TSTCASE2NAME: FCB  9
                      (    forth6809.asm):07582                       FCC  "TSTCASE2"
                      (    forth6809.asm):07583         

                      (    forth6809.asm):08243                    LDA  #'W'
                      (    forth6809.asm):08244                    STA  TSTNAMEB+4
                      (    forth6809.asm):08245                    LDA  #'D'
                      (    forth6809.asm):08246                    STA  TSTNAMEB+5
                      (    forth6809.asm):08247         

                      (    forth6809.asm):08174         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08175         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08176         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08177         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):08178         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):08179         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08180         ; division.
                      (    forth6809.asm):08181         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08182         ; ------------------------------------------------------------
FC41 3706             (    forth6809.asm):08183         ENVQW:      PULU  D                 ; u
FC43 3406             (    forth6809.asm):08184                     PSHS  D                 ; frame: 2,S = u, 0,S = c-addr (5k)
FC45 3706             (    forth6809.asm):08185                     PULU  D                 ; c-addr
FC47 3406             (    forth6809.asm):08186                     PSHS  D
FC49 8EFCE2           (    forth6809.asm):08187                     LDX   #ENVTABLE
FC4C EC84             (    forth6809.asm):08188         ENVLOOP:    LDD   ,X

                      (    forth6809.asm):01982         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01983         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01984         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01985         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01986         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01987         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01988         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01989         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01990         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01991         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01992         ; were chained on after H_QUIT in a later turn.
DD04 05               (    forth6809.asm):01993         H_ABORT: FCB   5
DD05 41424F5254       (    forth6809.asm):01994                  FCC   "ABORT"
DD0A DCFA             (    forth6809.asm):01995                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01996                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01997                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01998                                        ; now H_FALSE, the chain's newest entry
DD0C DDAB             (    forth6809.asm):01999                  FDB   ABORT
                      (    forth6809.asm):02000         
DD0E 04               (    forth6809.asm):02001         H_QUIT:  FCB   4
DD0F 51554954         (    forth6809.asm):02002                  FCC   "QUIT"
DD13 DD04             (    forth6809.asm):02003                  FDB   H_ABORT
DD15 DDAE             (    forth6809.asm):02004                  FDB   QUIT
                      (    forth6809.asm):02005         
                      (    forth6809.asm):02006         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):02007         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):02008         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):02009         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):02010         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):02011         ; reconstructs and pushes the original c-addr, then 0.
DD17 04               (    forth6809.asm):02012         H_FIND:  FCB   4
DD18 46494E44         (    forth6809.asm):02013                  FCC   "FIND"
DD1C DD0E             (    forth6809.asm):02014                  FDB   H_QUIT

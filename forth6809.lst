                      (    forth6809.asm):03590         ; ============================================================
                      (    forth6809.asm):03591                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E5F0 B60176           (    forth6809.asm):03592         X_KEY:     LDA   INHEAD
E5F3 B10177           (    forth6809.asm):03593                  CMPA  INTAIL
E5F6 271B             (    forth6809.asm):03594                  BEQ   KEY
E5F8 8E0180           (    forth6809.asm):03595                  LDX   #INBUF

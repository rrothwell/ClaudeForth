                      (   unit_tests.asm):01900         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (   unit_tests.asm):01901         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (   unit_tests.asm):01902         ; then retrieves the original via R> (verifying R@ genuinely
                      (   unit_tests.asm):01903         ; left it there undisturbed, not just that R@ itself returned
                      (   unit_tests.asm):01904         ; the right value once) - confirming "non-destructive" for real,
                      (   unit_tests.asm):01905         ; not assumed from the name.
                      (   unit_tests.asm):01906         ; ------------------------------------------------------------

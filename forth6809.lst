                      (    forth6809.asm):06942         ; Find the REPLACES entry for a name, newest first.
                      (    forth6809.asm):06943         ; SUBFIND
                      (    forth6809.asm):06944         ;    Inputs:
                      (    forth6809.asm):06945         ;        RegD = name length, RegX = name address
                      (    forth6809.asm):06946         ;    Outputs:
                      (    forth6809.asm):06947         ;        RegX = entry address, or 0 if there is none. An entry is: 0 link,
                      (    forth6809.asm):06948         ;        2 name length, 3 text length, 4 text capacity, 5 name, then text.
                      (    forth6809.asm):06949         ;    Registers: RegA, RegB, RegX and RegY changed. A length over 255 is
                      (    forth6809.asm):06950         ;        never found.
                      (    forth6809.asm):06951         ; ------------------------------------------------------------

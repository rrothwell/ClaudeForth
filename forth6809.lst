                      (    forth6809.asm):07977                   STD  TSTWCFA
                      (    forth6809.asm):07978         
                      (    forth6809.asm):07979                   LDD  #5
                      (    forth6809.asm):07980                   PSHU D
                      (    forth6809.asm):07981                   JSR  CONSTANT
                      (    forth6809.asm):07982         
                      (    forth6809.asm):07983                   LDD  TSTCSAV
                      (    forth6809.asm):07984                   STD  CODEHERE

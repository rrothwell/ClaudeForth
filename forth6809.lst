E912 D329             (    forth6809.asm):04140                     ADDD  MSCR              ; new_index = old_index + step
E914 ED62             (    forth6809.asm):04141                     STD   2,S
E916 A364             (    forth6809.asm):04142                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E918 DD2D             (    forth6809.asm):04143                     STD   MSCR3
                      (    forth6809.asm):04144                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04145                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04146                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

F437 CC0000           (    forth6809.asm):06511         ERASEW:     LDD   #0
F43A 3606             (    forth6809.asm):06512                     PSHU  D
F43C 7EF41A           (    forth6809.asm):06513                     JMP   FILLW
                      (    forth6809.asm):06514         
                      (    forth6809.asm):06515         ; ============================================================
                      (    forth6809.asm):06516         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06517         ; ============================================================
                      (    forth6809.asm):06518         ; ------------------------------------------------------------
                      (    forth6809.asm):06519         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06520         ; address and length and skip over it.
                      (    forth6809.asm):06521         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06522         ;    Inputs:
                      (    forth6809.asm):06523         ;        return address on S points at the count byte
                      (    forth6809.asm):06524         ;    Outputs:
                      (    forth6809.asm):06525         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06526         ;        string
                      (    forth6809.asm):06527         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06528         ; ------------------------------------------------------------
F43F 3510             (    forth6809.asm):06529         DOSTR:      PULS  X
F441 E684             (    forth6809.asm):06530                     LDB   ,X
F443 3001             (    forth6809.asm):06531                     LEAX  1,X
F445 3610             (    forth6809.asm):06532                     PSHU  X
F447 4F               (    forth6809.asm):06533                     CLRA
F448 3606             (    forth6809.asm):06534                     PSHU  D
F44A 3085             (    forth6809.asm):06535                     LEAX  B,X
F44C 3410             (    forth6809.asm):06536                     PSHS  X
F44E 39               (    forth6809.asm):06537                     RTS
                      (    forth6809.asm):06538         
                      (    forth6809.asm):06539         ; ------------------------------------------------------------
                      (    forth6809.asm):06540         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06541         ; Parse up to the closing quote. When compiling, compile DOSTR
                      (    forth6809.asm):06542         ; followed by the counted string. When interpreting, copy the string
                      (    forth6809.asm):06543         ; to PAD and return its address and length.
                      (    forth6809.asm):06544         ; A 3-byte gap is reserved at CODEHERE while WORD parses, so that the
                      (    forth6809.asm):06545         ; compiled JSR DOSTR does not overwrite the text being staged.
                      (    forth6809.asm):06546         ; ------------------------------------------------------------
F44F CC0022           (    forth6809.asm):06547         SQUOTEW:    LDD   #34
F452 3606             (    forth6809.asm):06548                     PSHU  D
F454 DC08             (    forth6809.asm):06549                     LDD   CODEHERE          ; reserve 3 bytes
F456 C30003           (    forth6809.asm):06550                     ADDD  #3                ; See bugfix: SQUOTEW.1
F459 DD08             (    forth6809.asm):06551                     STD   CODEHERE
F45B BDE239           (    forth6809.asm):06552                     JSR   WORDW
F45E 3710             (    forth6809.asm):06553                     PULU  X
F460 A684             (    forth6809.asm):06554                     LDA   ,X
F462 974F             (    forth6809.asm):06555                     STA   SCNT
F464 3001             (    forth6809.asm):06556                     LEAX  1,X
F466 9F51             (    forth6809.asm):06557                     STX   SPTR
F468 DC08             (    forth6809.asm):06558                     LDD   CODEHERE          ; restore - undo the temporary reserve
F46A 830003           (    forth6809.asm):06559                     SUBD  #3
F46D DD08             (    forth6809.asm):06560                     STD   CODEHERE
F46F DC00             (    forth6809.asm):06561                     LDD   STATE
F471 271F             (    forth6809.asm):06562                     BEQ   SQINTERP
                      (    forth6809.asm):06563         
F473 CCF43F           (    forth6809.asm):06564                     LDD   #DOSTR
F476 3606             (    forth6809.asm):06565                     PSHU  D
F478 BDE9F5           (    forth6809.asm):06566                     JSR   CCALL
F47B 9E08             (    forth6809.asm):06567                     LDX   CODEHERE
F47D 964F             (    forth6809.asm):06568                     LDA   SCNT
F47F A780             (    forth6809.asm):06569                     STA   ,X+
F481 109E51           (    forth6809.asm):06570                     LDY   SPTR
F484 D64F             (    forth6809.asm):06571                     LDB   SCNT
F486 2707             (    forth6809.asm):06572                     BEQ   SQEND
F488 A6A0             (    forth6809.asm):06573         SQCPY:      LDA   ,Y+
F48A A780             (    forth6809.asm):06574                     STA   ,X+
F48C 5A               (    forth6809.asm):06575                     DECB
F48D 26F9             (    forth6809.asm):06576                     BNE   SQCPY
F48F 9F08             (    forth6809.asm):06577         SQEND:      STX   CODEHERE
F491 39               (    forth6809.asm):06578                     RTS
                      (    forth6809.asm):06579         
                      (    forth6809.asm):06580                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06581                     ; SQUOTEW.2.
F492                  (    forth6809.asm):06582         SQINTERP:
F492 BDDEB2           (    forth6809.asm):06583                     JSR   PADW
F495 3710             (    forth6809.asm):06584                     PULU  X
F497 9F2F             (    forth6809.asm):06585                     STX   MSCR4             ; save PAD address
F499 109E51           (    forth6809.asm):06586                     LDY   SPTR
F49C D64F             (    forth6809.asm):06587                     LDB   SCNT
F49E 2707             (    forth6809.asm):06588                     BEQ   SQIEND
F4A0 A6A0             (    forth6809.asm):06589         SQICPY:     LDA   ,Y+
F4A2 A780             (    forth6809.asm):06590                     STA   ,X+
F4A4 5A               (    forth6809.asm):06591                     DECB
F4A5 26F9             (    forth6809.asm):06592                     BNE   SQICPY
F4A7 9E2F             (    forth6809.asm):06593         SQIEND:     LDX   MSCR4
F4A9 3610             (    forth6809.asm):06594                     PSHU  X
F4AB 4F               (    forth6809.asm):06595                     CLRA
F4AC D64F             (    forth6809.asm):06596                     LDB   SCNT
F4AE 3606             (    forth6809.asm):06597                     PSHU  D
F4B0 39               (    forth6809.asm):06598                     RTS
                      (    forth6809.asm):06599         
                      (    forth6809.asm):06600         ; ------------------------------------------------------------
                      (    forth6809.asm):06601         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06602         ; and skip over it.
                      (    forth6809.asm):06603         ; DOTSTR
                      (    forth6809.asm):06604         ;    Inputs:
                      (    forth6809.asm):06605         ;        return address on S points at the count byte
                      (    forth6809.asm):06606         ;    Outputs:
                      (    forth6809.asm):06607         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06608         ;    Registers: RegB, RegD and RegX changed; SPTR and SCNT used as
                      (    forth6809.asm):06609         ;        scratch.
                      (    forth6809.asm):06610         ; ------------------------------------------------------------
F4B1 3510             (    forth6809.asm):06611         DOTSTR:     PULS  X
F4B3 E684             (    forth6809.asm):06612                     LDB   ,X
F4B5 3001             (    forth6809.asm):06613                     LEAX  1,X
F4B7 9F51             (    forth6809.asm):06614                     STX   SPTR
F4B9 4F               (    forth6809.asm):06615                     CLRA
F4BA DD4F             (    forth6809.asm):06616                     STD   SCNT
F4BC 3085             (    forth6809.asm):06617                     LEAX  B,X
F4BE 3410             (    forth6809.asm):06618                     PSHS  X
F4C0 9E51             (    forth6809.asm):06619                     LDX   SPTR
F4C2 3610             (    forth6809.asm):06620                     PSHU  X

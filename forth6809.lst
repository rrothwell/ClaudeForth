                      (    forth6809.asm):00402         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00403         ;
                      (    forth6809.asm):00404         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00405         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00406         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00407         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00408         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00409         ; hand-built at the end of the section.
                      (    forth6809.asm):00410         ;
                      (    forth6809.asm):00411         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00412         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00413         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00414         ; ============================================================
                      (    forth6809.asm):00415         

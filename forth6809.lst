                      (    forth6809.asm):01521         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):01522         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):01523         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):01524         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):01525         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):01526         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):01527         ; one copy pushed).
                      (    forth6809.asm):01528         ; ------------------------------------------------------------
C161                  (    forth6809.asm):01529         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):01530         
                      (    forth6809.asm):01531                    LDD   #TSTGUARD
                      (    forth6809.asm):01532                    PSHU  D

                      (   unit_tests.asm):13201         ; Numeric Output test harness (glossary section 3.13). The
                      (   unit_tests.asm):13202         ; pictured-numeric-output core (<# # #S #> HOLD HOLDS SIGN) is
                      (   unit_tests.asm):13203         ; pure string-building with no I/O, tested directly. The
                      (   unit_tests.asm):13204         ; high-level printing words (./U./.R/U.R/?/D./D.R) all produce
                      (   unit_tests.asm):13205         ; real output via TYPE and/or EMIT internally, so per section
                      (   unit_tests.asm):13206         ; 3.1's own already-debugged finding, each applies the
                      (   unit_tests.asm):13207         ; SERIALPOLL-conditional split established there: full OUTHEAD/
                      (   unit_tests.asm):13208         ; OUTBUF verification under SERIALPOLL=0, an EMITCH-based check
                      (   unit_tests.asm):13209         ; of the last character under SERIALPOLL=1 - accepted as a
                      (   unit_tests.asm):13210         ; known, honest limitation for words ending in a trailing space
                      (   unit_tests.asm):13211         ; (./U./D. all print a fixed final space character, so the
                      (   unit_tests.asm):13212         ; polling-mode check there confirms less than for the
                      (   unit_tests.asm):13213         ; no-trailing-space words, but is still correct and consistent
                      (   unit_tests.asm):13214         ; with the same trade-off already established for TSTCR/
                      (   unit_tests.asm):13215         ; TSTSPACES/TSTTYPE/TSTDOTQUOTE in earlier sections).
                      (   unit_tests.asm):13216         ;
                      (   unit_tests.asm):13217         ; SIGN itself carries real bug-fix history: a prior version used
                      (   unit_tests.asm):13218         ; a bare BPL immediately after PULU, which doesn't affect
                      (   unit_tests.asm):13219         ; condition codes on real 6809 hardware - the bug was masked for
                      (   unit_tests.asm):13220         ; every internal caller by "caller-side luck" (each happened to
                      (   unit_tests.asm):13221         ; run a flag-setting LDD right before calling SIGN). This
                      (   unit_tests.asm):13222         ; section's own SIGN test deliberately poisons the flags with an
                      (   unit_tests.asm):13223         ; unrelated, known-positive value immediately before the actual
                      (   unit_tests.asm):13224         ; PSHU/JSR SIGN sequence specifically so a standalone call - the
                      (   unit_tests.asm):13225         ; exact scenario the bug-fix comment says was previously broken
                      (   unit_tests.asm):13226         ; - is what gets tested, not a scenario that happens to work via
                      (   unit_tests.asm):13227         ; the same kind of caller-side luck that hid the original bug.
                      (   unit_tests.asm):13228         ; ------------------------------------------------------------
                      (   unit_tests.asm):13229         
                      (   unit_tests.asm):13230         ; ------------------------------------------------------------

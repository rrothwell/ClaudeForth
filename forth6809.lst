                      (    forth6809.asm):04839         
                      (    forth6809.asm):04840         ; ------------------------------------------------------------
                      (    forth6809.asm):04841         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):04842         ; Rotate the third cell pair to the top. X and Y hold the pair

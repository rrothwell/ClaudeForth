                      (    forth6809.asm):03550         ; ------------------------------------------------------------
                      (    forth6809.asm):03551         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03552         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03553         ; ------------------------------------------------------------
E5E1 BDE579           (    forth6809.asm):03554         EXPECTW:    JSR   ACCEPTW
E5E4 3706             (    forth6809.asm):03555                     PULU  D

                      (    forth6809.asm):03196                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03197                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03198                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03199                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03200                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03201                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03202                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03203                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03204                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03205                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03206                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03207                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03208                  ; for it.

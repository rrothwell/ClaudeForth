                      (    forth6809.asm):00318         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00319         ;
                      (    forth6809.asm):00320         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00321         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00322         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00323         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00324         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00325         ; hand-built at the end of the section.
                      (    forth6809.asm):00326         ;
                      (    forth6809.asm):00327         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00328         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00329         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00330         ; ============================================================

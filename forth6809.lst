C298 3610             (    forth6809.asm):12071                    PSHU  X
C29A CC0008           (    forth6809.asm):12072                    LDD   #8
C29D 3606             (    forth6809.asm):12073                    PSHU  D
C29F BDF60B           (    forth6809.asm):12074                    JSR   TYPE

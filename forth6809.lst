                      (    forth6809.asm):03446         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03447         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03448         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03449         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03450         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03451         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03452         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03453         ; follow.
                      (    forth6809.asm):03454         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03455         KEYW:
                      (    forth6809.asm):03456                     LDA   ACIASR
                      (    forth6809.asm):03457                     BITA  #SR_RDRF
                      (    forth6809.asm):03458                     BEQ   KWAIT
                      (    forth6809.asm):03459                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03460                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E49C                  (    forth6809.asm):03461         KWAIT:
E49C                  (    forth6809.asm):03462         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03463                     BITA  #SR_RDRF
                      (    forth6809.asm):03464                     BEQ   KSPIN
E49C                  (    forth6809.asm):03465         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03466                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03467                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03468                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03469                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03470                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03471                     BEQ   KGETCH
                      (    forth6809.asm):03472                     BITA  #SR_FE
                      (    forth6809.asm):03473                     BEQ   KXFE
                      (    forth6809.asm):03474                     INC   FECOUNT
E49C                  (    forth6809.asm):03475         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03476                     BEQ   KXOVRN
                      (    forth6809.asm):03477                     INC   OVRNCOUNT
E49C                  (    forth6809.asm):03478         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03479                     BEQ   KGETCH
                      (    forth6809.asm):03480                     INC   PECOUNT
E49C                  (    forth6809.asm):03481         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03482                     TFR   A,B
                      (    forth6809.asm):03483                     CLRA
                      (    forth6809.asm):03484                     PSHU  D                 ; char
                      (    forth6809.asm):03485                     RTS
                      (    forth6809.asm):03486         
                      (    forth6809.asm):03487         ; ------------------------------------------------------------
                      (    forth6809.asm):03488         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03489         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03490         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03491         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03492         ;    Inputs:
                      (    forth6809.asm):03493         ;        none
                      (    forth6809.asm):03494         ;    Outputs:
                      (    forth6809.asm):03495         ;        XON or XOFF transmitted
                      (    forth6809.asm):03496         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03497         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03498         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03499         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03500                     BRA   PUTXCH
E49C                  (    forth6809.asm):03501         PUTXON:     LDA   #XONCH
E49C                  (    forth6809.asm):03502         PUTXCH:     PSHS  A
E49C                  (    forth6809.asm):03503         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03504                     BITB  #SR_TDRE
                      (    forth6809.asm):03505                     BEQ   PXWT
                      (    forth6809.asm):03506                     PULS  A
                      (    forth6809.asm):03507                     STA   ACIADR
                      (    forth6809.asm):03508                     RTS
                      (    forth6809.asm):03509         
                      (    forth6809.asm):03510         ; ------------------------------------------------------------
                      (    forth6809.asm):03511         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03512         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03513         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03514         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03515                     BITA  #SR_RDRF
                      (    forth6809.asm):03516                     BEQ   KQFALSE
                      (    forth6809.asm):03517                     LDD   #TRUEV
                      (    forth6809.asm):03518                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03519                     RTS
E49C                  (    forth6809.asm):03520         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03521                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03522                     RTS
                      (    forth6809.asm):03523         
                      (    forth6809.asm):03524         ; ------------------------------------------------------------
                      (    forth6809.asm):03525         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03526         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03527         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03528         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03529                     STB   EMITCH
E49C                  (    forth6809.asm):03530         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03531                     BITA  #SR_TDRE
                      (    forth6809.asm):03532                     BEQ   EMITWT
                      (    forth6809.asm):03533                     LDA   EMITCH
                      (    forth6809.asm):03534                     STA   ACIADR
                      (    forth6809.asm):03535                     RTS
                      (    forth6809.asm):03536         
                      (    forth6809.asm):03537                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03538         
                      (    forth6809.asm):03539         ; ------------------------------------------------------------
                      (    forth6809.asm):03540         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03541         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03542         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03543         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03544         ; ------------------------------------------------------------
E49C 335E             (    forth6809.asm):03545         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E49E CC0000           (    forth6809.asm):03546                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E4A1 EDC4             (    forth6809.asm):03547                     STD   ,U
                      (    forth6809.asm):03548         
                      (    forth6809.asm):03549                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03550                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03551                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03552                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03553                                             ; stream this line's characters
                      (    forth6809.asm):03554                     JSR   PUTXON
                      (    forth6809.asm):03555                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03556         
E4A3 BDE46D           (    forth6809.asm):03557         ALOOP:      JSR   KEYW
E4A6 3706             (    forth6809.asm):03558                     PULU  D
E4A8 1F02             (    forth6809.asm):03559                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03560         
E4AA C10D             (    forth6809.asm):03561                     CMPB  #13
E4AC 274F             (    forth6809.asm):03562                     BEQ   ADONE
E4AE C10A             (    forth6809.asm):03563                     CMPB  #10
E4B0 27F1             (    forth6809.asm):03564                     BEQ   ALOOP
E4B2 C108             (    forth6809.asm):03565                     CMPB  #8
E4B4 2724             (    forth6809.asm):03566                     BEQ   ABKSP
E4B6 C17F             (    forth6809.asm):03567                     CMPB  #127
E4B8 2720             (    forth6809.asm):03568                     BEQ   ABKSP
                      (    forth6809.asm):03569         
E4BA ECC4             (    forth6809.asm):03570                     LDD   ,U
E4BC 10A342           (    forth6809.asm):03571                     CMPD  2,U
E4BF 27E2             (    forth6809.asm):03572                     BEQ   ALOOP
                      (    forth6809.asm):03573         
E4C1 AE44             (    forth6809.asm):03574                     LDX   4,U
E4C3 308B             (    forth6809.asm):03575                     LEAX  D,X
E4C5 1F20             (    forth6809.asm):03576                     TFR   Y,D
E4C7 E784             (    forth6809.asm):03577                     STB   ,X
E4C9 ECC4             (    forth6809.asm):03578                     LDD   ,U
E4CB C30001           (    forth6809.asm):03579                     ADDD  #1
E4CE EDC4             (    forth6809.asm):03580                     STD   ,U
                      (    forth6809.asm):03581         
E4D0 1F20             (    forth6809.asm):03582                     TFR   Y,D
E4D2 4F               (    forth6809.asm):03583                     CLRA
E4D3 3606             (    forth6809.asm):03584                     PSHU  D
E4D5 BDE494           (    forth6809.asm):03585                     JSR   EMITW
E4D8 20C9             (    forth6809.asm):03586                     BRA   ALOOP
                      (    forth6809.asm):03587         
E4DA ECC4             (    forth6809.asm):03588         ABKSP:      LDD   ,U
E4DC 27C5             (    forth6809.asm):03589                     BEQ   ALOOP
E4DE 830001           (    forth6809.asm):03590                     SUBD  #1
E4E1 EDC4             (    forth6809.asm):03591                     STD   ,U
E4E3 CC0008           (    forth6809.asm):03592                     LDD   #8
E4E6 3606             (    forth6809.asm):03593                     PSHU  D
E4E8 BDE494           (    forth6809.asm):03594                     JSR   EMITW
E4EB CC0020           (    forth6809.asm):03595                     LDD   #32
E4EE 3606             (    forth6809.asm):03596                     PSHU  D
E4F0 BDE494           (    forth6809.asm):03597                     JSR   EMITW
E4F3 CC0008           (    forth6809.asm):03598                     LDD   #8
E4F6 3606             (    forth6809.asm):03599                     PSHU  D
E4F8 BDE494           (    forth6809.asm):03600                     JSR   EMITW
E4FB 20A6             (    forth6809.asm):03601                     BRA   ALOOP
                      (    forth6809.asm):03602         
E4FD                  (    forth6809.asm):03603         ADONE:
                      (    forth6809.asm):03604                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03605                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03606                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03607                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03608                                             ; with KEY never polled at all
                      (    forth6809.asm):03609                     JSR   PUTXOFF
                      (    forth6809.asm):03610                     ENDC                    ; <<<<<<<<<<
E4FD ECC4             (    forth6809.asm):03611                     LDD   ,U
E4FF ED44             (    forth6809.asm):03612                     STD   4,U               ; +n2
E501 3344             (    forth6809.asm):03613                     LEAU  4,U
E503 39               (    forth6809.asm):03614                     RTS
                      (    forth6809.asm):03615         
                      (    forth6809.asm):03616         ; ------------------------------------------------------------
                      (    forth6809.asm):03617         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03618         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03619         ; ------------------------------------------------------------
E504 BDE49C           (    forth6809.asm):03620         EXPECTW:    JSR   ACCEPTW
E507 3706             (    forth6809.asm):03621                     PULU  D
E509 DD3F             (    forth6809.asm):03622                     STD   SPAN
E50B 39               (    forth6809.asm):03623                     RTS
                      (    forth6809.asm):03624         
                      (    forth6809.asm):03625         ; ------------------------------------------------------------
                      (    forth6809.asm):03626         ; QUERY  ( -- )
                      (    forth6809.asm):03627         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03628         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03629         ; to 0 and >IN to 0.
                      (    forth6809.asm):03630         ; ------------------------------------------------------------
E50C 8E0106           (    forth6809.asm):03631         QUERYW:     LDX   #TIBBUF
E50F 3610             (    forth6809.asm):03632                     PSHU  X
E511 CC0050           (    forth6809.asm):03633                     LDD   #TIBBUFL
E514 3606             (    forth6809.asm):03634                     PSHU  D
E516 BDE49C           (    forth6809.asm):03635                     JSR   ACCEPTW
E519 3706             (    forth6809.asm):03636                     PULU  D
E51B DD12             (    forth6809.asm):03637                     STD   NTIB
E51D DD3B             (    forth6809.asm):03638                     STD   SRCLEN
E51F CC0106           (    forth6809.asm):03639                     LDD   #TIBBUF
E522 DD39             (    forth6809.asm):03640                     STD   SRCADDR
E524 CC0000           (    forth6809.asm):03641                     LDD   #0
E527 DD3D             (    forth6809.asm):03642                     STD   SRCID
E529 DD10             (    forth6809.asm):03643                     STD   TOIN
E52B 39               (    forth6809.asm):03644                     RTS
                      (    forth6809.asm):03645         
                      (    forth6809.asm):03646         ; ============================================================
                      (    forth6809.asm):03647         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03648         ; ============================================================
                      (    forth6809.asm):03649         ; ------------------------------------------------------------
                      (    forth6809.asm):03650         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03651         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03652         ; one expected.
                      (    forth6809.asm):03653         ; CFERR
                      (    forth6809.asm):03654         ;    Inputs:
                      (    forth6809.asm):03655         ;        none
                      (    forth6809.asm):03656         ;    Outputs:
                      (    forth6809.asm):03657         ;        does not return (THROW -22)
                      (    forth6809.asm):03658         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03659         ; ------------------------------------------------------------
E52C CCFFEA           (    forth6809.asm):03660         CFERR:      LDD   #-22
E52F 3606             (    forth6809.asm):03661                     PSHU  D                 ; -22
E531 BDE561           (    forth6809.asm):03662                     JSR   THROWW
E534 39               (    forth6809.asm):03663                     RTS
                      (    forth6809.asm):03664         
                      (    forth6809.asm):03665         ; ------------------------------------------------------------
                      (    forth6809.asm):03666         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03667         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03668         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03669         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03670         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03671         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03672         ; ------------------------------------------------------------
E535 3710             (    forth6809.asm):03673         CATCHW:     PULU  X                 ; xt
E537 DC0C             (    forth6809.asm):03674                     LDD   HANDLER
E539 3406             (    forth6809.asm):03675                     PSHS  D
E53B 3440             (    forth6809.asm):03676                     PSHS  U
                      (    forth6809.asm):03677                     ; Save the input source specification.
                      (    forth6809.asm):03678                     ; See bugfix: CATCHW.1
E53D DC39             (    forth6809.asm):03679                     LDD   SRCADDR
E53F 3406             (    forth6809.asm):03680                     PSHS  D
E541 DC3B             (    forth6809.asm):03681                     LDD   SRCLEN
E543 3406             (    forth6809.asm):03682                     PSHS  D
E545 DC3D             (    forth6809.asm):03683                     LDD   SRCID
E547 3406             (    forth6809.asm):03684                     PSHS  D
E549 DC10             (    forth6809.asm):03685                     LDD   TOIN
E54B 3406             (    forth6809.asm):03686                     PSHS  D
E54D 1F40             (    forth6809.asm):03687                     TFR   S,D
E54F DD0C             (    forth6809.asm):03688                     STD   HANDLER
                      (    forth6809.asm):03689         
E551 AD84             (    forth6809.asm):03690                     JSR   ,X
                      (    forth6809.asm):03691         
E553 3268             (    forth6809.asm):03692                     LEAS  8,S               ; drop saved input source
E555 3262             (    forth6809.asm):03693                     LEAS  2,S               ; saved U
E557 3506             (    forth6809.asm):03694                     PULS  D
E559 DD0C             (    forth6809.asm):03695                     STD   HANDLER
E55B CC0000           (    forth6809.asm):03696                     LDD   #0
E55E 3606             (    forth6809.asm):03697                     PSHU  D                 ; 0 = no exception
E560 39               (    forth6809.asm):03698                     RTS
                      (    forth6809.asm):03699         
                      (    forth6809.asm):03700         ; ------------------------------------------------------------
                      (    forth6809.asm):03701         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03702         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03703         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03704         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03705         ; ------------------------------------------------------------
E561 3706             (    forth6809.asm):03706         THROWW:     PULU  D                 ; n
E563 10830000         (    forth6809.asm):03707                     CMPD  #0
E567 2725             (    forth6809.asm):03708                     BEQ   THDONE
                      (    forth6809.asm):03709         
E569 DD0E             (    forth6809.asm):03710                     STD   THROWN
E56B 9E0C             (    forth6809.asm):03711                     LDX   HANDLER
E56D 2720             (    forth6809.asm):03712                     BEQ   THUNCAU
                      (    forth6809.asm):03713         
E56F 1F14             (    forth6809.asm):03714                     TFR   X,S
E571 3506             (    forth6809.asm):03715                     PULS  D                 ; restore input source saved by CATCH
E573 DD10             (    forth6809.asm):03716                     STD   TOIN
E575 3506             (    forth6809.asm):03717                     PULS  D
E577 DD3D             (    forth6809.asm):03718                     STD   SRCID
E579 3506             (    forth6809.asm):03719                     PULS  D
E57B DD3B             (    forth6809.asm):03720                     STD   SRCLEN
E57D 3506             (    forth6809.asm):03721                     PULS  D
E57F DD39             (    forth6809.asm):03722                     STD   SRCADDR
E581 3506             (    forth6809.asm):03723                     PULS  D
E583 1F03             (    forth6809.asm):03724                     TFR   D,U
E585 3506             (    forth6809.asm):03725                     PULS  D
E587 DD0C             (    forth6809.asm):03726                     STD   HANDLER
                      (    forth6809.asm):03727         
E589 DC0E             (    forth6809.asm):03728                     LDD   THROWN
E58B 3606             (    forth6809.asm):03729                     PSHU  D
E58D 39               (    forth6809.asm):03730                     RTS
E58E 39               (    forth6809.asm):03731         THDONE:     RTS
                      (    forth6809.asm):03732         
                      (    forth6809.asm):03733                     ; No CATCH is active: leave n on the stack and ABORT.
E58F DC0E             (    forth6809.asm):03734         THUNCAU:    LDD   THROWN
E591 3606             (    forth6809.asm):03735                     PSHU  D
E593 7EDDEF           (    forth6809.asm):03736                     JMP   ABORT
                      (    forth6809.asm):03737         
                      (    forth6809.asm):03738         ; ============================================================
                      (    forth6809.asm):03739         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03740         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03741         ; ============================================================
                      (    forth6809.asm):03742         ; ------------------------------------------------------------
                      (    forth6809.asm):03743         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03744         ; location.
                      (    forth6809.asm):03745         ; PATCH   ( target location -- )
                      (    forth6809.asm):03746         ;    Inputs:
                      (    forth6809.asm):03747         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03748         ;    Outputs:
                      (    forth6809.asm):03749         ;        the cell at location holds target - location
                      (    forth6809.asm):03750         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03751         ; ------------------------------------------------------------
E596 3710             (    forth6809.asm):03752         PATCH:      PULU  X                 ; location
E598 3706             (    forth6809.asm):03753                     PULU  D                 ; target
E59A 3410             (    forth6809.asm):03754                     PSHS  X
E59C A3E1             (    forth6809.asm):03755                     SUBD  ,S++              ; target - location
E59E ED84             (    forth6809.asm):03756                     STD   ,X
E5A0 39               (    forth6809.asm):03757                     RTS
                      (    forth6809.asm):03758         
                      (    forth6809.asm):03759         ; ------------------------------------------------------------
                      (    forth6809.asm):03760         ; IF  ( C: -- orig )
                      (    forth6809.asm):03761         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03762         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03763         ; ------------------------------------------------------------
E5A1 CCDE9C           (    forth6809.asm):03764         IFW:        LDD   #ZBRANCH
E5A4 3606             (    forth6809.asm):03765                     PSHU  D
E5A6 BDE99C           (    forth6809.asm):03766                     JSR   CCALL
E5A9 CC0000           (    forth6809.asm):03767                     LDD   #0
E5AC 3606             (    forth6809.asm):03768                     PSHU  D
E5AE BDDF26           (    forth6809.asm):03769                     JSR   CODECOMMA
E5B1 DC08             (    forth6809.asm):03770                     LDD   CODEHERE
E5B3 830002           (    forth6809.asm):03771                     SUBD  #2
E5B6 3606             (    forth6809.asm):03772                     PSHU  D                 ; orig
E5B8 CC0001           (    forth6809.asm):03773                     LDD   #TAGFWD
E5BB 3606             (    forth6809.asm):03774                     PSHU  D
E5BD 39               (    forth6809.asm):03775                     RTS
                      (    forth6809.asm):03776         
                      (    forth6809.asm):03777         ; ------------------------------------------------------------
                      (    forth6809.asm):03778         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03779         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03780         ; operand to jump to the current code address.
                      (    forth6809.asm):03781         ; ------------------------------------------------------------
E5BE 3706             (    forth6809.asm):03782         THENW:      PULU  D
E5C0 10830001         (    forth6809.asm):03783                     CMPD  #TAGFWD
E5C4 2703             (    forth6809.asm):03784                     BEQ   THOK
E5C6 BDE52C           (    forth6809.asm):03785                     JSR   CFERR
E5C9 3710             (    forth6809.asm):03786         THOK:       PULU  X                 ; orig
E5CB DC08             (    forth6809.asm):03787                     LDD   CODEHERE
E5CD 3606             (    forth6809.asm):03788                     PSHU  D
E5CF 3610             (    forth6809.asm):03789                     PSHU  X
E5D1 BDE596           (    forth6809.asm):03790                     JSR   PATCH
E5D4 39               (    forth6809.asm):03791                     RTS
                      (    forth6809.asm):03792         
                      (    forth6809.asm):03793         ; ------------------------------------------------------------
                      (    forth6809.asm):03794         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03795         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03796         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
E5D5 3706             (    forth6809.asm):03798         ELSEW:      PULU  D
E5D7 10830001         (    forth6809.asm):03799                     CMPD  #TAGFWD
E5DB 2703             (    forth6809.asm):03800                     BEQ   ELOK

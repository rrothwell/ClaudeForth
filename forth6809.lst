                      (    forth6809.asm):08157         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08158         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08159         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08160         ; enter COLD.
                      (    forth6809.asm):08161         ; COLDSTRT
                      (    forth6809.asm):08162         ;    Inputs:
                      (    forth6809.asm):08163         ;        hardware reset
                      (    forth6809.asm):08164         ;    Outputs:
                      (    forth6809.asm):08165         ;        does not return
                      (    forth6809.asm):08166         ;    Registers: all registers initialised.
                      (    forth6809.asm):08167         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08168         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08169                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08170                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08171                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08172                     CLRA
FFAE 1F8B             (    forth6809.asm):08173                     TFR   A,DP
                      (    forth6809.asm):08174         
FFB0 8E0000           (    forth6809.asm):08175                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08176                     LDB   #0
FFB5 6F80             (    forth6809.asm):08177         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):08178                     DECB
FFB8 26FB             (    forth6809.asm):08179                     BNE   CLRGLOB
                      (    forth6809.asm):08180         
FFBA BDDCE3           (    forth6809.asm):08181                     JSR   INITSERIAL
                      (    forth6809.asm):08182         
FFBD 1CAF             (    forth6809.asm):08183                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08184         
                      (    forth6809.asm):08185                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08186         
                      (    forth6809.asm):08187                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08188                     JSR   TSTRUNNER
                      (    forth6809.asm):08189                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08190                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08191                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):08192                     NOP
                      (    forth6809.asm):08193                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08194         
FFC2 7EDD00           (    forth6809.asm):08195                     JMP   COLD
                      (    forth6809.asm):08196         
                      (    forth6809.asm):08197         ; ------------------------------------------------------------
                      (    forth6809.asm):08198         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08199         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08200         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08201         ; WARM
                      (    forth6809.asm):08202         ;    Inputs:
                      (    forth6809.asm):08203         ;        NMI
                      (    forth6809.asm):08204         ;    Outputs:
                      (    forth6809.asm):08205         ;        does not return
                      (    forth6809.asm):08206         ;    Registers: all registers initialised.
                      (    forth6809.asm):08207         ; ------------------------------------------------------------
FFC5 1A50             (    forth6809.asm):08208         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08209                     CLRA
FFC8 1F8B             (    forth6809.asm):08210                     TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08211                     LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08212                     LDS   #RP0
                      (    forth6809.asm):08213         
FFD1 BDDCE3           (    forth6809.asm):08214                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):08215         
FFD4 8EFFE6           (    forth6809.asm):08216                     LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08217                     PSHU  X
FFD9 CC0006           (    forth6809.asm):08218                     LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08219                     PSHU  D
FFDE BDF50B           (    forth6809.asm):08220                     JSR   TYPEW
FFE1 1CAF             (    forth6809.asm):08221                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE3 7EDD3F           (    forth6809.asm):08222                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):08223         
FFE6 20207761726D     (    forth6809.asm):08224         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):08225         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):08226         
                      (    forth6809.asm):08227                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEC             (    forth6809.asm):08228         INITEND     EQU   *
     0048             (    forth6809.asm):08229         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08230         
                      (    forth6809.asm):08231         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08232         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08233         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):08234                     FILL  $FF,VECTORS-INITEND
                      (    forth6809.asm):08235         
                      (    forth6809.asm):08236         ; ============================================================
                      (    forth6809.asm):08237         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):08238         ; ============================================================
                      (    forth6809.asm):08239                     ORG   VECTORS           ; hardware vector table
FFF0 0000             (    forth6809.asm):08240         VRESV       FDB   $0000
FFF2 DCF4             (    forth6809.asm):08241         VSWI3       FDB   SWI3H             ; SWI3
FFF4 DCF5             (    forth6809.asm):08242         VSWI2       FDB   SWI2H             ; SWI2
FFF6 DCF6             (    forth6809.asm):08243         VFIRQ       FDB   FIRQH             ; FIRQ
FFF8 DCF3             (    forth6809.asm):08244         VIRQ        FDB   IRQH              ; IRQ
FFFA DCF8             (    forth6809.asm):08245         VSWI        FDB   SWIH              ; SWI
FFFC FFC5             (    forth6809.asm):08246         VNMI        FDB   WARM              ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):08247         VRESET      FDB   COLDSTRT          ; reset
                      (    forth6809.asm):08248         
     0000             (    forth6809.asm):08249         VECTOREND   EQU   *                 ; vectors size, should be $10
     0010             (    forth6809.asm):08250         VECTORSIZE  EQU   VECTOREND-VECTORS
                      (    forth6809.asm):08251         
                      (    forth6809.asm):08252         ; ============================================================
                      (    forth6809.asm):08253         ; END OF CONSOLIDATED SOURCE
                      (    forth6809.asm):08254         ; ============================================================

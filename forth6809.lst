                      (    forth6809.asm):03948         ; RECURSE  ( -- )
                      (    forth6809.asm):03949         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03950         ; the xt held in CURXT.
                      (    forth6809.asm):03951         ; ------------------------------------------------------------
E6AC DC1F             (    forth6809.asm):03952         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E6AE 3606             (    forth6809.asm):03953                     PSHU  D                 ; See bugfix: RECURSEW.1
E6B0 BDE931           (    forth6809.asm):03954                     JSR   CCALL
E6B3 39               (    forth6809.asm):03955                     RTS

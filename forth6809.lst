                      (    forth6809.asm):04831         
                      (    forth6809.asm):04832         ; ------------------------------------------------------------
                      (    forth6809.asm):04833         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):04834         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):04835         ; cells above it down one place. RDST holds the byte offset and RVAL

                      (    forth6809.asm):13860                  JSR  HOLD
                      (    forth6809.asm):13861         
                      (    forth6809.asm):13862                  LDD  #'B'
                      (    forth6809.asm):13863                  PSHU D
                      (    forth6809.asm):13864                  JSR  HOLD
                      (    forth6809.asm):13865         
                      (    forth6809.asm):13866                  STU  TSTUAF
                      (    forth6809.asm):13867         
                      (    forth6809.asm):13868                  LDX  HLD
                      (    forth6809.asm):13869                  LDA  ,X
                      (    forth6809.asm):13870                  CMPA #'B'
                      (    forth6809.asm):13871                  BNE  HDFAIL
                      (    forth6809.asm):13872                  LDA  1,X
                      (    forth6809.asm):13873                  CMPA #'A'
                      (    forth6809.asm):13874                  BNE  HDFAIL
                      (    forth6809.asm):13875         
                      (    forth6809.asm):13876                  PULU D
                      (    forth6809.asm):13877                  CMPD #TSTGUARD
                      (    forth6809.asm):13878                  BNE  HDFAIL
                      (    forth6809.asm):13879         
                      (    forth6809.asm):13880                  LDD  TSTUB4
                      (    forth6809.asm):13881                  SUBD TSTUAF
                      (    forth6809.asm):13882                  CMPD #0
                      (    forth6809.asm):13883                  BNE  HDFAIL
                      (    forth6809.asm):13884         
                      (    forth6809.asm):13885                  LDD  #TRUEV
                      (    forth6809.asm):13886                  BRA  HDDONE
C2C5                  (    forth6809.asm):13887         HDFAIL:  LDD  #FALSEV
C2C5                  (    forth6809.asm):13888         HDDONE:  LDX  #TSTHDNAME
                      (    forth6809.asm):13889                  PSHU X
                      (    forth6809.asm):13890                  PSHU D
                      (    forth6809.asm):13891                  JSR  TSTREPORT
                      (    forth6809.asm):13892         
                      (    forth6809.asm):13893                  LDD  TSTCSAV
                      (    forth6809.asm):13894                  STD  CODEHERE
                      (    forth6809.asm):13895         
                      (    forth6809.asm):13896                  LDU  TSTU0
                      (    forth6809.asm):13897                  RTS
                      (    forth6809.asm):13898         
C2C5                  (    forth6809.asm):13899         TSTHDNAME: FCB  7
                      (    forth6809.asm):13900                    FCC  "TSTHOLD"

                      (    forth6809.asm):01687         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):01688         ; Covers every word in that section, with representative
                      (    forth6809.asm):01689         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):01690         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):01691         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):01692         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):01693         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):01694         ; cases chosen.
                      (    forth6809.asm):01695         ; ------------------------------------------------------------
C15E BDFC2B           (    forth6809.asm):01696         TSTSARITH: JSR   CRW
C161 8EC172           (    forth6809.asm):01697                    LDX   #TSTSARITHMSG
C164 3610             (    forth6809.asm):01698                    PSHU  X
C166 CC000B           (    forth6809.asm):01699                    LDD   #11
C169 3606             (    forth6809.asm):01700                    PSHU  D
C16B BDF60B           (    forth6809.asm):01701                    JSR   TYPE
C16E BDFC2B           (    forth6809.asm):01702                    JSR   CRW
                      (    forth6809.asm):01703         
                      (    forth6809.asm):01704                    IFEQ TSTSELECTOR-1  ; >>>>
                      (    forth6809.asm):01705         
                      (    forth6809.asm):01706                    JSR   TSTPLUS
                      (    forth6809.asm):01707                    JSR   TSTMINUS
                      (    forth6809.asm):01708                    JSR   TSTSTAR1
                      (    forth6809.asm):01709                    JSR   TSTSTAR2
                      (    forth6809.asm):01710                    JSR   TSTSLASH1
                      (    forth6809.asm):01711                    JSR   TSTSLASH2
                      (    forth6809.asm):01712                    JSR   TSTSLASHZ
                      (    forth6809.asm):01713                    JSR   TSTMODW
                      (    forth6809.asm):01714                    JSR   TSTMODZ
                      (    forth6809.asm):01715                    JSR   TSTSLMOD
                      (    forth6809.asm):01716                    JSR   TSTSLMODZ
                      (    forth6809.asm):01717                    JSR   TSTNEGATE
                      (    forth6809.asm):01718                    JSR   TSTABS1
                      (    forth6809.asm):01719                    JSR   TSTABS2
                      (    forth6809.asm):01720                    JSR   TSTMIN1
                      (    forth6809.asm):01721                    JSR   TSTMIN2
                      (    forth6809.asm):01722                    JSR   TSTMAX1
                      (    forth6809.asm):01723                    JSR   TSTMAX2

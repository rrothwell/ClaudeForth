                      (    forth6809.asm):17490                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):17491                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):17492                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):17493                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):17494                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):17495                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):17496                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):17497                   ; high cell.
E5C3 0D22             (    forth6809.asm):17498                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):17499                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):17500                   LDD   UDLO
E5C9 43               (    forth6809.asm):17501                   COMA
E5CA 53               (    forth6809.asm):17502                   COMB
E5CB C30001           (    forth6809.asm):17503                   ADDD  #1
E5CE DD76             (    forth6809.asm):17504                   STD   UDLO
E5D0 3401             (    forth6809.asm):17505                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):17506                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):17507                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):17508                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):17509                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):17510                                      ; silently overwrote the real carry here
                      (    forth6809.asm):17511                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):17512                                      ; making the high-cell increment run
                      (    forth6809.asm):17513                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):17514                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):17515                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):17516                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):17517                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):17518                                      ; matching "always increment" rather than
                      (    forth6809.asm):17519                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):17520                   LDD   UDHI
E5D4 43               (    forth6809.asm):17521                   COMA
E5D5 53               (    forth6809.asm):17522                   COMB
E5D6 3501             (    forth6809.asm):17523                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):17524                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):17525                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):17526                                      ; when there's no carry - the complemented
                      (    forth6809.asm):17527                                      ; value was computed in D but never
                      (    forth6809.asm):17528                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):17529                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):17530                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):17531                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):17532                                      ; was always seen as set, so this branch
                      (    forth6809.asm):17533                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):17534                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):17535                                      ; alone would have made this second,
                      (    forth6809.asm):17536                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):17537                                      ; only past the "+1", never past the
                      (    forth6809.asm):17538                                      ; store itself - the store always runs,
                      (    forth6809.asm):17539                                      ; either way.
E5DA C30001           (    forth6809.asm):17540                   ADDD  #1
E5DD DD74             (    forth6809.asm):17541         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):17542         
E5DF                  (    forth6809.asm):17543         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):17544                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):17545                   LDX   CADDR
E5E1 E684             (    forth6809.asm):17546                   LDB   ,X
E5E3 5A               (    forth6809.asm):17547                   DECB
E5E4 3001             (    forth6809.asm):17548                   LEAX  1,X
E5E6 A685             (    forth6809.asm):17549                   LDA   B,X
E5E8 812E             (    forth6809.asm):17550                   CMPA  #'.'
E5EA 260E             (    forth6809.asm):17551                   BNE   NQSINGLE
                      (    forth6809.asm):17552         
                      (    forth6809.asm):17553                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):17554                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):17555                   ; apart without needing a separate flag of its own either
E5EC DC76             (    forth6809.asm):17556                   LDD   UDLO

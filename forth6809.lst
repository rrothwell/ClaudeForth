                      (    forth6809.asm):06453                  PSHU  D
                      (    forth6809.asm):06454                  JSR   CCALL
                      (    forth6809.asm):06455         
                      (    forth6809.asm):06456                  LDD   #DUP
                      (    forth6809.asm):06457                  PSHU  D
                      (    forth6809.asm):06458                  JSR   CCALL
                      (    forth6809.asm):06459         
                      (    forth6809.asm):06460                  LDD   #3
                      (    forth6809.asm):06461                  PSHU  D
                      (    forth6809.asm):06462                  JSR   LITERALW
                      (    forth6809.asm):06463         
                      (    forth6809.asm):06464                  LDD   #EQUALW
                      (    forth6809.asm):06465                  PSHU  D

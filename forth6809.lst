E7E8 2007             (    forth6809.asm):04233                     BRA   DPCONT
E7EA DC2D             (    forth6809.asm):04234         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E7EC 10932B           (    forth6809.asm):04235                     CMPD  MSCR2
E7EF 2209             (    forth6809.asm):04236                     BHI   DPTEXIT
E7F1 3510             (    forth6809.asm):04237         DPCONT:     PULS  X                 ; X = branch operand address
E7F3 EC84             (    forth6809.asm):04238                     LDD   ,X

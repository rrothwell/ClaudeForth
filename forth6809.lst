                      (    forth6809.asm):09338                    STD  TSTDSAV
                      (    forth6809.asm):09339                    LDD  VARHERE
                      (    forth6809.asm):09340                    STD  TSTVSAV
                      (    forth6809.asm):09341                    LDD  SRCADDR

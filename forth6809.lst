DFD1 31               (    forth6809.asm):01881                  FCC   "1"
DFD2 DFC7             (    forth6809.asm):01882                  FDB   H_FIND
DFD4 FF8E             (    forth6809.asm):01883                  FDB   ONEBODY
                      (    forth6809.asm):01884         
DFD6 02               (    forth6809.asm):01885         H_M1:    FCB   2
DFD7 2D31             (    forth6809.asm):01886                  FCC   "-1"
DFD9 DFD0             (    forth6809.asm):01887                  FDB   H_1
DFDB FF94             (    forth6809.asm):01888                  FDB   MONEBODY
                      (    forth6809.asm):01889         
DFDD 01               (    forth6809.asm):01890         H_2:     FCB   1
DFDE 32               (    forth6809.asm):01891                  FCC   "2"
DFDF DFD6             (    forth6809.asm):01892                  FDB   H_M1
DFE1 FF9A             (    forth6809.asm):01893                  FDB   TWOBODY
                      (    forth6809.asm):01894         
DFE3 02               (    forth6809.asm):01895         H_M2:    FCB   2
DFE4 2D32             (    forth6809.asm):01896                  FCC   "-2"
DFE6 DFDD             (    forth6809.asm):01897                  FDB   H_2
DFE8 FFA0             (    forth6809.asm):01898                  FDB   MTWOBODY
                      (    forth6809.asm):01899         
     DFE3             (    forth6809.asm):01900         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01901                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01902                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01903                                   ; were chained on after it; before that,
                      (    forth6809.asm):01904                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01905                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01906                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01907                                   ; before this one.
                      (    forth6809.asm):01908         
                      (    forth6809.asm):01909         ; Verify no collision with base code.
                      (    forth6809.asm):01910         ; Value should match ORG BASECODE
     DFEA             (    forth6809.asm):01911         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01912         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01913         
                      (    forth6809.asm):01914         ; ============================================================
                      (    forth6809.asm):01915         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01916         ; ============================================================
                      (    forth6809.asm):01917                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01918                                        ; entirely - every routine from here through
                      (    forth6809.asm):01919                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01920                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01921                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01922                                        ; WARM message left the location counter,
                      (    forth6809.asm):01923                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01924                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01925                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01926         
                      (    forth6809.asm):01927         ; ------------------------------------------------------------
                      (    forth6809.asm):01928         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01929         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01930         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01931         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01932         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01933         ; ------------------------------------------------------------
DFEA 8603             (    forth6809.asm):01934         INITSERIAL: LDA   #$03
DFEC B7C008           (    forth6809.asm):01935                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01936                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01937                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01938                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01939                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01940                  ELSE  ; <<<<<>>>>>
DFEF 8615             (    forth6809.asm):01941                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01942                  ENDC  ; <<<<<<<<<<
DFF1 B7C008           (    forth6809.asm):01943                  STA   ACIACR         ; was "STA ACIA" - same fix
DFF4 39               (    forth6809.asm):01944                  RTS
                      (    forth6809.asm):01945         
                      (    forth6809.asm):01946                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01947         ; ------------------------------------------------------------
                      (    forth6809.asm):01948         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01949         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01950         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01951         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01952         ; ------------------------------------------------------------
DFF5                  (    forth6809.asm):01953         INFILL:  LDA   INHEAD
                      (    forth6809.asm):01954                  SUBA  INTAIL
                      (    forth6809.asm):01955                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):01956                  RTS
                      (    forth6809.asm):01957         
                      (    forth6809.asm):01958         ; ------------------------------------------------------------
                      (    forth6809.asm):01959         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01960         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01961         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01962         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01963         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01964         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01965         ; flow control, not a chip feature.
                      (    forth6809.asm):01966         ; ------------------------------------------------------------
DFF5                  (    forth6809.asm):01967         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):01968                     CMPA #INHIWATER
                      (    forth6809.asm):01969                     BLO  RTSCHIDONE
                      (    forth6809.asm):01970                     TST  RTSSTATE
                      (    forth6809.asm):01971                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):01972                     LDA  #CR_RTSHI
                      (    forth6809.asm):01973                     STA  ACIACR
                      (    forth6809.asm):01974                     LDA  #1
                      (    forth6809.asm):01975                     STA  RTSSTATE
DFF5                  (    forth6809.asm):01976         RTSCHIDONE: RTS
                      (    forth6809.asm):01977         
                      (    forth6809.asm):01978         ; ------------------------------------------------------------
                      (    forth6809.asm):01979         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):01980         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):01981         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):01982         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):01983         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):01984         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):01985         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01986         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01987         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):01988         ; ------------------------------------------------------------
DFF5                  (    forth6809.asm):01989         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):01990                     CMPA #INLOWATER
                      (    forth6809.asm):01991                     BHI  RTSCLODONE
                      (    forth6809.asm):01992                     TST  RTSSTATE
                      (    forth6809.asm):01993                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):01994                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):01995                     CLR  RTSSTATE
                      (    forth6809.asm):01996                     LDB  OUTTAIL
                      (    forth6809.asm):01997                     CMPB OUTHEAD
                      (    forth6809.asm):01998                     BEQ  RTSCLONOTX
                      (    forth6809.asm):01999                     LDA  #CR_RXTX
                      (    forth6809.asm):02000                     STA  ACIACR
                      (    forth6809.asm):02001                     BRA  RTSCLOUNMASK
DFF5                  (    forth6809.asm):02002         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):02003                     STA  ACIACR
DFF5                  (    forth6809.asm):02004         RTSCLOUNMASK: ANDCC #$EF
DFF5                  (    forth6809.asm):02005         RTSCLODONE: RTS
                      (    forth6809.asm):02006         
DFF5                  (    forth6809.asm):02007         IRQH:    LDA   ACIASR
                      (    forth6809.asm):02008                  BITA  #SR_IRQ
                      (    forth6809.asm):02009                  BEQ   IRQDONE
                      (    forth6809.asm):02010         
                      (    forth6809.asm):02011                  BITA  #SR_RDRF
                      (    forth6809.asm):02012                  BEQ   TXCHK
                      (    forth6809.asm):02013         
                      (    forth6809.asm):02014                  LDB   INHEAD
                      (    forth6809.asm):02015                  LDA   ACIADR
                      (    forth6809.asm):02016                  LDX   #INBUF
                      (    forth6809.asm):02017                  STA   B,X
                      (    forth6809.asm):02018                  INCB
                      (    forth6809.asm):02019                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02020                  CMPB  INTAIL
                      (    forth6809.asm):02021                  BEQ   IRQDONE
                      (    forth6809.asm):02022                  STB   INHEAD
                      (    forth6809.asm):02023                  JSR   RTSCHECKHI
                      (    forth6809.asm):02024                  BRA   IRQDONE
                      (    forth6809.asm):02025         
DFF5                  (    forth6809.asm):02026         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):02027                  CMPB  OUTHEAD
                      (    forth6809.asm):02028                  BEQ   TXOFF
                      (    forth6809.asm):02029                  LDX   #OUTBUF
                      (    forth6809.asm):02030                  LDA   B,X
                      (    forth6809.asm):02031                  STA   ACIADR
                      (    forth6809.asm):02032                  INCB
                      (    forth6809.asm):02033                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02034                  STB   OUTTAIL
                      (    forth6809.asm):02035                  BRA   IRQDONE
                      (    forth6809.asm):02036         
DFF5                  (    forth6809.asm):02037         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):02038                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02039                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):02040                  LDA   #CR_RXON
                      (    forth6809.asm):02041                  STA   ACIACR
                      (    forth6809.asm):02042         
DFF5                  (    forth6809.asm):02043         IRQDONE: RTI
                      (    forth6809.asm):02044         
                      (    forth6809.asm):02045                  ELSE  ; <<<<<>>>>>
DFF5 3B               (    forth6809.asm):02046         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02047                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02048                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02049                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02050                                       ; the other unused vectors below
                      (    forth6809.asm):02051                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02052         
DFF6 3B               (    forth6809.asm):02053         SWI3H:   RTI
DFF7 3B               (    forth6809.asm):02054         SWI2H:   RTI
DFF8 3B               (    forth6809.asm):02055         FIRQH:   RTI
DFF9 3B               (    forth6809.asm):02056         NMIH:    RTI                   ; unused now that NMI -> WARM
DFFA CCFF9D           (    forth6809.asm):02057         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DFFD 3606             (    forth6809.asm):02058                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DFFF 7EE7F9           (    forth6809.asm):02059                  JMP   THROW
                      (    forth6809.asm):02060         
                      (    forth6809.asm):02061         ; ============================================================
                      (    forth6809.asm):02062         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02063         ; ============================================================
E002 CC021B           (    forth6809.asm):02064         COLD:    LDD   #APPVARS
E005 DD0A             (    forth6809.asm):02065                  STD   VARHERE
E007 CC7000           (    forth6809.asm):02066                  LDD   #APPCODE
E00A DD08             (    forth6809.asm):02067                  STD   CODEHERE
E00C CC2000           (    forth6809.asm):02068                  LDD   #APPDICT
E00F DD06             (    forth6809.asm):02069                  STD   DPHERE
E011 CCDFE3           (    forth6809.asm):02070                  LDD   #BASELATEST
E014 DD04             (    forth6809.asm):02071                  STD   LATEST
                      (    forth6809.asm):02072         

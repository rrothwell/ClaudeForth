E3C9 0A21             (    forth6809.asm):03358                     DEC   CNTREM
E3CB 2766             (    forth6809.asm):03359                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03360         
E3CD 0F22             (    forth6809.asm):03361         NQNOSIGN:   CLR   NUMNEG
E3CF A684             (    forth6809.asm):03362                     LDA   ,X
E3D1 812D             (    forth6809.asm):03363                     CMPA  #'-'

E5C6 DDDD             (    forth6809.asm):03698                     STD   SRCLEN
E5C8 CC0106           (    forth6809.asm):03699                     LDD   #TIBBUF
E5CB DDDB             (    forth6809.asm):03700                     STD   SRCADDR
E5CD CC0000           (    forth6809.asm):03701                     LDD   #0
E5D0 DDDF             (    forth6809.asm):03702                     STD   SRCID
E5D2 DD10             (    forth6809.asm):03703                     STD   TOIN
E5D4 39               (    forth6809.asm):03704                     RTS
                      (    forth6809.asm):03705         
                      (    forth6809.asm):03706         ; ============================================================
                      (    forth6809.asm):03707         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03708         ; ============================================================
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
                      (    forth6809.asm):03710         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03711         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03712         ; one expected.
                      (    forth6809.asm):03713         ; CFERR
                      (    forth6809.asm):03714         ;    Inputs:
                      (    forth6809.asm):03715         ;        none
                      (    forth6809.asm):03716         ;    Outputs:
                      (    forth6809.asm):03717         ;        does not return (THROW -22)
                      (    forth6809.asm):03718         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03719         ; ------------------------------------------------------------
E5D5 CCFFEA           (    forth6809.asm):03720         CFERR:      LDD   #-22
E5D8 3606             (    forth6809.asm):03721                     PSHU  D                 ; -22
E5DA BDE60A           (    forth6809.asm):03722                     JSR   THROW
E5DD 39               (    forth6809.asm):03723                     RTS
                      (    forth6809.asm):03724         
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
                      (    forth6809.asm):03726         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03727         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03728         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03729         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03730         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03731         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
E5DE 3710             (    forth6809.asm):03733         CATCHW:     PULU  X                 ; xt
E5E0 DC0C             (    forth6809.asm):03734                     LDD   HANDLER
E5E2 3406             (    forth6809.asm):03735                     PSHS  D
E5E4 3440             (    forth6809.asm):03736                     PSHS  U
                      (    forth6809.asm):03737                     ; Save the input source specification.
                      (    forth6809.asm):03738                     ; See bugfix: CATCHW.1
E5E6 DCDB             (    forth6809.asm):03739                     LDD   SRCADDR
E5E8 3406             (    forth6809.asm):03740                     PSHS  D
E5EA DCDD             (    forth6809.asm):03741                     LDD   SRCLEN
E5EC 3406             (    forth6809.asm):03742                     PSHS  D
E5EE DCDF             (    forth6809.asm):03743                     LDD   SRCID
E5F0 3406             (    forth6809.asm):03744                     PSHS  D
E5F2 DC10             (    forth6809.asm):03745                     LDD   TOIN
E5F4 3406             (    forth6809.asm):03746                     PSHS  D
E5F6 1F40             (    forth6809.asm):03747                     TFR   S,D
E5F8 DD0C             (    forth6809.asm):03748                     STD   HANDLER
                      (    forth6809.asm):03749         
E5FA AD84             (    forth6809.asm):03750                     JSR   ,X
                      (    forth6809.asm):03751         
E5FC 3268             (    forth6809.asm):03752                     LEAS  8,S               ; drop saved input source
E5FE 3262             (    forth6809.asm):03753                     LEAS  2,S               ; saved U
E600 3506             (    forth6809.asm):03754                     PULS  D
E602 DD0C             (    forth6809.asm):03755                     STD   HANDLER
E604 CC0000           (    forth6809.asm):03756                     LDD   #0
E607 3606             (    forth6809.asm):03757                     PSHU  D                 ; 0 = no exception
E609 39               (    forth6809.asm):03758                     RTS
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03762         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03763         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03764         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
E60A 3706             (    forth6809.asm):03766         THROW:      PULU  D                 ; n
E60C 10830000         (    forth6809.asm):03767                     CMPD  #0
E610 2725             (    forth6809.asm):03768                     BEQ   THDONE
                      (    forth6809.asm):03769         
E612 DD0E             (    forth6809.asm):03770                     STD   THROWN
E614 9E0C             (    forth6809.asm):03771                     LDX   HANDLER
E616 2720             (    forth6809.asm):03772                     BEQ   THUNCAU
                      (    forth6809.asm):03773         
E618 1F14             (    forth6809.asm):03774                     TFR   X,S
E61A 3506             (    forth6809.asm):03775                     PULS  D                 ; restore input source saved by CATCH
E61C DD10             (    forth6809.asm):03776                     STD   TOIN
E61E 3506             (    forth6809.asm):03777                     PULS  D
E620 DDDF             (    forth6809.asm):03778                     STD   SRCID
E622 3506             (    forth6809.asm):03779                     PULS  D
E624 DDDD             (    forth6809.asm):03780                     STD   SRCLEN
E626 3506             (    forth6809.asm):03781                     PULS  D
E628 DDDB             (    forth6809.asm):03782                     STD   SRCADDR
E62A 3506             (    forth6809.asm):03783                     PULS  D
E62C 1F03             (    forth6809.asm):03784                     TFR   D,U
E62E 3506             (    forth6809.asm):03785                     PULS  D
E630 DD0C             (    forth6809.asm):03786                     STD   HANDLER
                      (    forth6809.asm):03787         
E632 DC0E             (    forth6809.asm):03788                     LDD   THROWN
E634 3606             (    forth6809.asm):03789                     PSHU  D
E636 39               (    forth6809.asm):03790                     RTS
E637 39               (    forth6809.asm):03791         THDONE:     RTS
                      (    forth6809.asm):03792         
                      (    forth6809.asm):03793                     ; No CATCH is active: leave n on the stack and ABORT.
E638 DC0E             (    forth6809.asm):03794         THUNCAU:    LDD   THROWN
E63A 3606             (    forth6809.asm):03795                     PSHU  D
E63C 7EDDCF           (    forth6809.asm):03796                     JMP   ABORT

                      (    forth6809.asm):03308         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):03309         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):03310         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):03311         ; remaining string.
                      (    forth6809.asm):03312         ; ------------------------------------------------------------
E420 3706             (    forth6809.asm):03313         TONUMBERW:  PULU  D                 ; u1
E422 DD25             (    forth6809.asm):03314                     STD   NCNT
E424 3706             (    forth6809.asm):03315                     PULU  D                 ; c-addr1
E426 DD23             (    forth6809.asm):03316                     STD   NADDR
E428 3706             (    forth6809.asm):03317                     PULU  D                 ; ud1 high
E42A DD74             (    forth6809.asm):03318                     STD   UDHI
E42C 3706             (    forth6809.asm):03319                     PULU  D                 ; ud1 low
E42E DD76             (    forth6809.asm):03320                     STD   UDLO
E430 BDE3E7           (    forth6809.asm):03321                     JSR   NUMLOOP
E433 DC76             (    forth6809.asm):03322                     LDD   UDLO
E435 3606             (    forth6809.asm):03323                     PSHU  D                 ; ud2 low
E437 DC74             (    forth6809.asm):03324                     LDD   UDHI
E439 3606             (    forth6809.asm):03325                     PSHU  D                 ; ud2 high
E43B 9E23             (    forth6809.asm):03326                     LDX   NADDR
E43D 3610             (    forth6809.asm):03327                     PSHU  X                 ; c-addr2
E43F DC25             (    forth6809.asm):03328                     LDD   NCNT
E441 3606             (    forth6809.asm):03329                     PSHU  D                 ; u2
E443 39               (    forth6809.asm):03330                     RTS
                      (    forth6809.asm):03331         
                      (    forth6809.asm):03332         ; ------------------------------------------------------------
                      (    forth6809.asm):03333         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03334         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03335         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03336         ;    Inputs:
                      (    forth6809.asm):03337         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03338         ;    Outputs:
                      (    forth6809.asm):03339         ;        single number: n and -1
                      (    forth6809.asm):03340         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03341         ;        not a number: c-addr and 0
                      (    forth6809.asm):03342         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03343         ; ------------------------------------------------------------
E444 3710             (    forth6809.asm):03344         NUMBERQ:    PULU  X                 ; c-addr
E446 9F1F             (    forth6809.asm):03345                     STX   CADDR
E448 A684             (    forth6809.asm):03346                     LDA   ,X
E44A 2777             (    forth6809.asm):03347                     BEQ   NQBAD
E44C 9721             (    forth6809.asm):03348                     STA   CNTREM
E44E 3001             (    forth6809.asm):03349                     LEAX  1,X
                      (    forth6809.asm):03350         
                      (    forth6809.asm):03351                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03352                     ; digit count. See shadow: NUMBERQ.1
E450 D621             (    forth6809.asm):03353                     LDB   CNTREM
E452 5A               (    forth6809.asm):03354                     DECB
E453 A685             (    forth6809.asm):03355                     LDA   B,X
E455 812E             (    forth6809.asm):03356                     CMPA  #'.'
E457 2604             (    forth6809.asm):03357                     BNE   NQNOSIGN
E459 0A21             (    forth6809.asm):03358                     DEC   CNTREM
E45B 2766             (    forth6809.asm):03359                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03360         
E45D 0F22             (    forth6809.asm):03361         NQNOSIGN:   CLR   NUMNEG
E45F A684             (    forth6809.asm):03362                     LDA   ,X
E461 812D             (    forth6809.asm):03363                     CMPA  #'-'
E463 2608             (    forth6809.asm):03364                     BNE   NQNOSIGN2
E465 0322             (    forth6809.asm):03365                     COM   NUMNEG
E467 3001             (    forth6809.asm):03366                     LEAX  1,X
E469 0A21             (    forth6809.asm):03367                     DEC   CNTREM
E46B 2756             (    forth6809.asm):03368                     BEQ   NQBAD
                      (    forth6809.asm):03369         
E46D 9F23             (    forth6809.asm):03370         NQNOSIGN2:  STX   NADDR
E46F 4F               (    forth6809.asm):03371                     CLRA
E470 D621             (    forth6809.asm):03372                     LDB   CNTREM
E472 DD25             (    forth6809.asm):03373                     STD   NCNT
E474 CC0000           (    forth6809.asm):03374                     LDD   #0
E477 DD74             (    forth6809.asm):03375                     STD   UDHI
E479 DD76             (    forth6809.asm):03376                     STD   UDLO
                      (    forth6809.asm):03377         
E47B BDE3E7           (    forth6809.asm):03378                     JSR   NUMLOOP
                      (    forth6809.asm):03379         
E47E DC25             (    forth6809.asm):03380                     LDD   NCNT
E480 2641             (    forth6809.asm):03381                     BNE   NQBAD
                      (    forth6809.asm):03382         
                      (    forth6809.asm):03383                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E482 0D22             (    forth6809.asm):03384                     TST   NUMNEG
E484 2718             (    forth6809.asm):03385                     BEQ   NQPOS32
E486 DC76             (    forth6809.asm):03386                     LDD   UDLO
E488 43               (    forth6809.asm):03387                     COMA
E489 53               (    forth6809.asm):03388                     COMB
E48A C30001           (    forth6809.asm):03389                     ADDD  #1
E48D DD76             (    forth6809.asm):03390                     STD   UDLO
E48F 3401             (    forth6809.asm):03391                     PSHS  CC                ; Save the carry. See bugfix: NUMBERQ.3
E491 DC74             (    forth6809.asm):03392                     LDD   UDHI
E493 43               (    forth6809.asm):03393                     COMA
E494 53               (    forth6809.asm):03394                     COMB
E495 3501             (    forth6809.asm):03395                     PULS  CC                ; restore the TRUE carry
E497 2403             (    forth6809.asm):03396                     BCC   NQSTOREHI         ; See bugfix: NUMBERQ.4
E499 C30001           (    forth6809.asm):03397                     ADDD  #1
E49C DD74             (    forth6809.asm):03398         NQSTOREHI:  STD   UDHI
                      (    forth6809.asm):03399         
E49E                  (    forth6809.asm):03400         NQPOS32:                            ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03401                     ; was '.' - determines which return convention to use
E49E 9E1F             (    forth6809.asm):03402                     LDX   CADDR
E4A0 E684             (    forth6809.asm):03403                     LDB   ,X
E4A2 5A               (    forth6809.asm):03404                     DECB
E4A3 3001             (    forth6809.asm):03405                     LEAX  1,X
E4A5 A685             (    forth6809.asm):03406                     LDA   B,X
E4A7 812E             (    forth6809.asm):03407                     CMPA  #'.'
E4A9 260E             (    forth6809.asm):03408                     BNE   NQSINGLE
                      (    forth6809.asm):03409         
                      (    forth6809.asm):03410                     ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03411                     ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03412                     ; apart without needing a separate flag of its own either
E4AB DC76             (    forth6809.asm):03413                     LDD   UDLO
E4AD 3606             (    forth6809.asm):03414                     PSHU  D
E4AF DC74             (    forth6809.asm):03415                     LDD   UDHI
E4B1 3606             (    forth6809.asm):03416                     PSHU  D
E4B3 CC0001           (    forth6809.asm):03417                     LDD   #1
E4B6 3606             (    forth6809.asm):03418                     PSHU  D
E4B8 39               (    forth6809.asm):03419                     RTS
                      (    forth6809.asm):03420         
E4B9                  (    forth6809.asm):03421         NQSINGLE:                           ; SINGLE success - unchanged from the original convention
E4B9 DC76             (    forth6809.asm):03422                     LDD   UDLO
E4BB 3606             (    forth6809.asm):03423                     PSHU  D
E4BD CCFFFF           (    forth6809.asm):03424                     LDD   #-1
E4C0 3606             (    forth6809.asm):03425                     PSHU  D
E4C2 39               (    forth6809.asm):03426                     RTS
                      (    forth6809.asm):03427         
E4C3 9E1F             (    forth6809.asm):03428         NQBAD:      LDX   CADDR
E4C5 3610             (    forth6809.asm):03429                     PSHU  X
E4C7 CC0000           (    forth6809.asm):03430                     LDD   #0
E4CA 3606             (    forth6809.asm):03431                     PSHU  D
E4CC 39               (    forth6809.asm):03432                     RTS
                      (    forth6809.asm):03433         
                      (    forth6809.asm):03434         ; ============================================================
                      (    forth6809.asm):03435         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03436         ; ============================================================
                      (    forth6809.asm):03437                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03438         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03439         
                      (    forth6809.asm):03440         ; ------------------------------------------------------------
                      (    forth6809.asm):03441         ; KEY  ( -- char )
                      (    forth6809.asm):03442         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03443         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03444         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03445         KEYW:
                      (    forth6809.asm):03446         
                      (    forth6809.asm):03447                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03448                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03449         
                      (    forth6809.asm):03450                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):03451                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03452                                             ; by transmitting all chars.
                      (    forth6809.asm):03453         
E4CD                  (    forth6809.asm):03454         TRY_READ:
                      (    forth6809.asm):03455                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03456                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03457                                             ; while still transmitting!
                      (    forth6809.asm):03458         
                      (    forth6809.asm):03459                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03460                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03461                     PSHU  D                 ; char
                      (    forth6809.asm):03462         
                      (    forth6809.asm):03463                     RTS
                      (    forth6809.asm):03464         
                      (    forth6809.asm):03465         ; ------------------------------------------------------------
                      (    forth6809.asm):03466         ; KEY?  ( -- flag )
                      (    forth6809.asm):03467         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03468         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03469         KEYQW:
                      (    forth6809.asm):03470                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03471         
                      (    forth6809.asm):03472                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03473                     CMPA  INTAIL
                      (    forth6809.asm):03474         
                      (    forth6809.asm):03475                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03476         
                      (    forth6809.asm):03477                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03478         
                      (    forth6809.asm):03479                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03480                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03481         
                      (    forth6809.asm):03482                     RTS
                      (    forth6809.asm):03483         
E4CD                  (    forth6809.asm):03484         KQTRUE:
                      (    forth6809.asm):03485                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03486                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03487                     RTS
                      (    forth6809.asm):03488         
                      (    forth6809.asm):03489         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03490         
                      (    forth6809.asm):03491         ; ------------------------------------------------------------
                      (    forth6809.asm):03492         ; EMIT  ( char -- )
                      (    forth6809.asm):03493         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03494         ; discarded if the ring is full.
                      (    forth6809.asm):03495         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03496         EMITW:
                      (    forth6809.asm):03497                     PULU  D                 ; char
                      (    forth6809.asm):03498                     TFR   B,A
                      (    forth6809.asm):03499                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03500                     RTS
                      (    forth6809.asm):03501         
                      (    forth6809.asm):03502                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03503         ; ------------------------------------------------------------
                      (    forth6809.asm):03504         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03505         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03506         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03507         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03508         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03509         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03510         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03511         ; follow.
                      (    forth6809.asm):03512         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03513         KEYW:
E4CD B6C008           (    forth6809.asm):03514                     LDA   ACIASR
E4D0 8501             (    forth6809.asm):03515                     BITA  #SR_RDRF
E4D2 2705             (    forth6809.asm):03516                     BEQ   KWAIT
E4D4 7C017F           (    forth6809.asm):03517                     INC   POLLREADYCNT      ; character was already queued when we
E4D7 2007             (    forth6809.asm):03518                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E4D9                  (    forth6809.asm):03519         KWAIT:
E4D9 B6C008           (    forth6809.asm):03520         KSPIN:      LDA   ACIASR
E4DC 8501             (    forth6809.asm):03521                     BITA  #SR_RDRF
E4DE 27F9             (    forth6809.asm):03522                     BEQ   KSPIN
E4E0                  (    forth6809.asm):03523         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03524                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03525                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03526                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03527                                             ; RDRF and the latched error bits together
E4E0 8570             (    forth6809.asm):03528                     BITA  #SR_FE+SR_OVRN+SR_PE
E4E2 2715             (    forth6809.asm):03529                     BEQ   KGETCH
E4E4 8510             (    forth6809.asm):03530                     BITA  #SR_FE
E4E6 2703             (    forth6809.asm):03531                     BEQ   KXFE
E4E8 7C017C           (    forth6809.asm):03532                     INC   FECOUNT
E4EB 8520             (    forth6809.asm):03533         KXFE:       BITA  #SR_OVRN
E4ED 2703             (    forth6809.asm):03534                     BEQ   KXOVRN
E4EF 7C017D           (    forth6809.asm):03535                     INC   OVRNCOUNT
E4F2 8540             (    forth6809.asm):03536         KXOVRN:     BITA  #SR_PE
E4F4 2703             (    forth6809.asm):03537                     BEQ   KGETCH
E4F6 7C017E           (    forth6809.asm):03538                     INC   PECOUNT
E4F9 B6C009           (    forth6809.asm):03539         KGETCH:     LDA   ACIADR
E4FC 1F89             (    forth6809.asm):03540                     TFR   A,B
E4FE 4F               (    forth6809.asm):03541                     CLRA
E4FF 3606             (    forth6809.asm):03542                     PSHU  D                 ; char
E501 39               (    forth6809.asm):03543                     RTS
                      (    forth6809.asm):03544         
                      (    forth6809.asm):03545         ; ------------------------------------------------------------
                      (    forth6809.asm):03546         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03547         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03548         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03549         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03550         ;    Inputs:
                      (    forth6809.asm):03551         ;        none
                      (    forth6809.asm):03552         ;    Outputs:
                      (    forth6809.asm):03553         ;        XON or XOFF transmitted
                      (    forth6809.asm):03554         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03555         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03556         ; ------------------------------------------------------------
E502 8613             (    forth6809.asm):03557         PUTXOFF:    LDA   #XOFFCH
E504 2002             (    forth6809.asm):03558                     BRA   PUTXCH
E506 8611             (    forth6809.asm):03559         PUTXON:     LDA   #XONCH
E508 3402             (    forth6809.asm):03560         PUTXCH:     PSHS  A
E50A F6C008           (    forth6809.asm):03561         PXWT:       LDB   ACIASR
E50D C502             (    forth6809.asm):03562                     BITB  #SR_TDRE
E50F 27F9             (    forth6809.asm):03563                     BEQ   PXWT
E511 3502             (    forth6809.asm):03564                     PULS  A
E513 B7C009           (    forth6809.asm):03565                     STA   ACIADR
E516 39               (    forth6809.asm):03566                     RTS
                      (    forth6809.asm):03567         
                      (    forth6809.asm):03568         ; ------------------------------------------------------------
                      (    forth6809.asm):03569         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03570         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03571         ; ------------------------------------------------------------
E517 B6C008           (    forth6809.asm):03572         KEYQW:      LDA   ACIASR
E51A 8501             (    forth6809.asm):03573                     BITA  #SR_RDRF
E51C 2706             (    forth6809.asm):03574                     BEQ   KQFALSE
E51E CCFFFF           (    forth6809.asm):03575                     LDD   #TRUEV
E521 3606             (    forth6809.asm):03576                     PSHU  D                 ; flag = true
E523 39               (    forth6809.asm):03577                     RTS
E524 CC0000           (    forth6809.asm):03578         KQFALSE:    LDD   #FALSEV
E527 3606             (    forth6809.asm):03579                     PSHU  D                 ; flag = false
E529 39               (    forth6809.asm):03580                     RTS
                      (    forth6809.asm):03581         
                      (    forth6809.asm):03582         ; ------------------------------------------------------------
                      (    forth6809.asm):03583         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03584         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03585         ; ------------------------------------------------------------
E52A 3706             (    forth6809.asm):03586         EMITW:      PULU  D                 ; char
E52C D73C             (    forth6809.asm):03587                     STB   EMITCH
E52E B6C008           (    forth6809.asm):03588         EMITWT:     LDA   ACIASR
E531 8502             (    forth6809.asm):03589                     BITA  #SR_TDRE
E533 27F9             (    forth6809.asm):03590                     BEQ   EMITWT
E535 963C             (    forth6809.asm):03591                     LDA   EMITCH
E537 B7C009           (    forth6809.asm):03592                     STA   ACIADR
E53A 39               (    forth6809.asm):03593                     RTS
                      (    forth6809.asm):03594         
                      (    forth6809.asm):03595                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03596         
                      (    forth6809.asm):03597         ; ------------------------------------------------------------
                      (    forth6809.asm):03598         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03599         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03600         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03601         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03602         ; ------------------------------------------------------------
E53B 3706             (    forth6809.asm):03603         ACCEPTW:    PULU  D                 ; +n1
E53D DD35             (    forth6809.asm):03604                     STD   AMAX
E53F 3706             (    forth6809.asm):03605                     PULU  D                 ; c-addr
E541 DD37             (    forth6809.asm):03606                     STD   ABUFP
E543 CC0000           (    forth6809.asm):03607                     LDD   #0
E546 DD39             (    forth6809.asm):03608                     STD   ACNT
                      (    forth6809.asm):03609         
                      (    forth6809.asm):03610                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03611                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03612                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03613                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03614                                             ; stream this line's characters
E548 BDE506           (    forth6809.asm):03615                     JSR   PUTXON
                      (    forth6809.asm):03616                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03617         

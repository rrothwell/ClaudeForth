                      (    forth6809.asm):01214         ; TSTSPACES - unit test for SPACES, normal (n=3) case. Verifies
                      (    forth6809.asm):01215         ; all three queued bytes are genuinely spaces (32), not just
                      (    forth6809.asm):01216         ; that OUTHEAD advanced by the right count.
                      (    forth6809.asm):01217         ; ------------------------------------------------------------
C185                  (    forth6809.asm):01218         TSTSPACES: STU  TSTU0

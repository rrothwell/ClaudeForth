                      (    forth6809.asm):06254                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):06255                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):06256                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):06257                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):06258                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):06259                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):06260                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):06261                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):06262                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):06263                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):06264                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):06265                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):06266                  ; for it.
E591 D621             (    forth6809.asm):06267                  LDB   CNTREM
E593 5A               (    forth6809.asm):06268                  DECB
E594 A685             (    forth6809.asm):06269                  LDA   B,X
E596 812E             (    forth6809.asm):06270                  CMPA  #'.'
E598 2604             (    forth6809.asm):06271                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):06272                  DEC   CNTREM
E59C 2766             (    forth6809.asm):06273                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):06274         
E59E 0F22             (    forth6809.asm):06275         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):06276                  LDA   ,X
E5A2 812D             (    forth6809.asm):06277                  CMPA  #'-'

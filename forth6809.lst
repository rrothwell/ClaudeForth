                      (    forth6809.asm):09473         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):09474         ; ============================================================
                      (    forth6809.asm):09475         ; ------------------------------------------------------------
                      (    forth6809.asm):09476         ; TRUE  ( -- flag )
                      (    forth6809.asm):09477         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09478         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):09479         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):09480         ; ------------------------------------------------------------
F470 CCFFFF           (    forth6809.asm):09481         TRUEW:      LDD   #$FFFF

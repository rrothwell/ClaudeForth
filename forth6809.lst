                      (    forth6809.asm):05885                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):05886                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):05887                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):05888                                   ; only re-entered on cold boot or an

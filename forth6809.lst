                      (    forth6809.asm):13838         ; TSTHOLD - unit test for HOLD. Holds 'A' then 'B' - since HOLD
                      (    forth6809.asm):13839         ; grows the buffer downward and prepends (decrements HLD first,
                      (    forth6809.asm):13840         ; then writes at the new, lower position), the second-held
                      (    forth6809.asm):13841         ; character ends up at the lower address, so reading forward
                      (    forth6809.asm):13842         ; from the final HLD should give "BA", not "AB".
                      (    forth6809.asm):13843         ; ------------------------------------------------------------
C2C5                  (    forth6809.asm):13844         TSTHOLD: LDD  CODEHERE
                      (    forth6809.asm):13845                  STD  TSTCSAV
                      (    forth6809.asm):13846         
                      (    forth6809.asm):13847                  LDD  #TSTCBUF
                      (    forth6809.asm):13848                  STD  CODEHERE
                      (    forth6809.asm):13849         
                      (    forth6809.asm):13850                  STU  TSTU0
                      (    forth6809.asm):13851         
                      (    forth6809.asm):13852                  LDD  #TSTGUARD
                      (    forth6809.asm):13853                  PSHU D
                      (    forth6809.asm):13854                  STU  TSTUB4
                      (    forth6809.asm):13855         
                      (    forth6809.asm):13856                  JSR  LTNUM
                      (    forth6809.asm):13857         
                      (    forth6809.asm):13858                  LDD  #'A'

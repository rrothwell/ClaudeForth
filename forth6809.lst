                      (    forth6809.asm):07504         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07505         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07506         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07507         ; stands for itself. An unterminated string ends at the end of the line.

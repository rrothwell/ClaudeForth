                      (    forth6809.asm):01658         ; ------------------------------------------------------------
DD2E                  (    forth6809.asm):01659         CHKHI:
DD2E C130             (    forth6809.asm):01660                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DD30 250D             (    forth6809.asm):01661                     BLO   CHKHIDONE         ; No! Do nothing.
DD32 7D0178           (    forth6809.asm):01662                     TST   RTSSTATE
DD35 2608             (    forth6809.asm):01663                     BNE   CHKHIDONE         ; already high - nothing to do
DD37 86FF             (    forth6809.asm):01664                     LDA   #INREJECT         ; Yes! De-assert RTS.
DD39 B70178           (    forth6809.asm):01665                     STA   RTSSTATE
DD3C BDDD13           (    forth6809.asm):01666                     JSR   UPDATE_RTS
DD3F 39               (    forth6809.asm):01667         CHKHIDONE:  RTS
                      (    forth6809.asm):01668         
                      (    forth6809.asm):01669         ; ------------------------------------------------------------
                      (    forth6809.asm):01670         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01671         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01672         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01673         ; CHKLO
                      (    forth6809.asm):01674         ;    Inputs:
                      (    forth6809.asm):01675         ;        RegB = input ring fill level
                      (    forth6809.asm):01676         ;    Outputs:
                      (    forth6809.asm):01677         ;        RTSSTATE and ACIACR updated if the low-water mark was reached

                      (    forth6809.asm):03590         ; ------------------------------------------------------------
                      (    forth6809.asm):03591         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03592         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03593         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03594         ; FDSEARCH
                      (    forth6809.asm):03595         ;    Inputs:
                      (    forth6809.asm):03596         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03597         ;        RegY = address of the name text
                      (    forth6809.asm):03598         ;        RegB = name length
                      (    forth6809.asm):03599         ;    Outputs:
                      (    forth6809.asm):03600         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03601         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03602         ; ------------------------------------------------------------
D999 3424             (    forth6809.asm):03603         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D99B 8C0000           (    forth6809.asm):03604         FDLOOP:     CMPX  #0
D99E 2733             (    forth6809.asm):03605                     BEQ   FDRET
D9A0 A684             (    forth6809.asm):03606                     LDA   ,X
D9A2 8540             (    forth6809.asm):03607                     BITA  #$40
D9A4 2620             (    forth6809.asm):03608                     BNE   FDNEXT            ; smudged
D9A6 841F             (    forth6809.asm):03609                     ANDA  #$1F
D9A8 A1E4             (    forth6809.asm):03610                     CMPA  ,S
D9AA 261A             (    forth6809.asm):03611                     BNE   FDNEXT
D9AC 3410             (    forth6809.asm):03612                     PSHS  X                 ; header, kept across the compare
D9AE 3001             (    forth6809.asm):03613                     LEAX  1,X
D9B0 10AE63           (    forth6809.asm):03614                     LDY   3,S               ; name text
D9B3 E662             (    forth6809.asm):03615                     LDB   2,S               ; length
D9B5 2709             (    forth6809.asm):03616                     BEQ   FDHIT
D9B7 A680             (    forth6809.asm):03617         FDCMP:      LDA   ,X+
D9B9 A1A0             (    forth6809.asm):03618                     CMPA  ,Y+
D9BB 2607             (    forth6809.asm):03619                     BNE   FDMISS
D9BD 5A               (    forth6809.asm):03620                     DECB
D9BE 26F7             (    forth6809.asm):03621                     BNE   FDCMP
D9C0 3510             (    forth6809.asm):03622         FDHIT:      PULS  X                 ; header
D9C2 200F             (    forth6809.asm):03623                     BRA   FDRET
D9C4 3510             (    forth6809.asm):03624         FDMISS:     PULS  X
D9C6 E684             (    forth6809.asm):03625         FDNEXT:     LDB   ,X
D9C8 C41F             (    forth6809.asm):03626                     ANDB  #$1F
D9CA 4F               (    forth6809.asm):03627                     CLRA
D9CB 3001             (    forth6809.asm):03628                     LEAX  1,X
D9CD 308B             (    forth6809.asm):03629                     LEAX  D,X
D9CF AE84             (    forth6809.asm):03630                     LDX   ,X                ; LINK field
D9D1 20C8             (    forth6809.asm):03631                     BRA   FDLOOP
D9D3 3263             (    forth6809.asm):03632         FDRET:      LEAS  3,S
D9D5 39               (    forth6809.asm):03633                     RTS
                      (    forth6809.asm):03634         
                      (    forth6809.asm):03635         ; ------------------------------------------------------------
                      (    forth6809.asm):03636         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03637         ; ROOT, for a name.
                      (    forth6809.asm):03638         ; SRCHORD
                      (    forth6809.asm):03639         ;    Inputs:
                      (    forth6809.asm):03640         ;        RegY = address of the name text
                      (    forth6809.asm):03641         ;        RegB = name length
                      (    forth6809.asm):03642         ;    Outputs:
                      (    forth6809.asm):03643         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03644         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03645         ; ------------------------------------------------------------
D9D6 3424             (    forth6809.asm):03646         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D9D8 8E004B           (    forth6809.asm):03647                     LDX   #ORDER
D9DB 3410             (    forth6809.asm):03648                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D9DD AEE4             (    forth6809.asm):03649         SOLOOP:     LDX   ,S
D9DF 9C49             (    forth6809.asm):03650                     CMPX  ORDEND
D9E1 2415             (    forth6809.asm):03651                     BHS   SOROOT
D9E3 10AE81           (    forth6809.asm):03652                     LDY   ,X++              ; WID
D9E6 AFE4             (    forth6809.asm):03653                     STX   ,S
D9E8 AEA4             (    forth6809.asm):03654                     LDX   ,Y                ; newest header of that wordlist
D9EA 10AE63           (    forth6809.asm):03655                     LDY   3,S
D9ED E662             (    forth6809.asm):03656                     LDB   2,S
D9EF 8DA8             (    forth6809.asm):03657                     BSR   FDSEARCH
D9F1 8C0000           (    forth6809.asm):03658                     CMPX  #0
D9F4 27E7             (    forth6809.asm):03659                     BEQ   SOLOOP
D9F6 2009             (    forth6809.asm):03660                     BRA   SORDONE
D9F8 9E5D             (    forth6809.asm):03661         SOROOT:     LDX   WLHEADS+2         ; ROOT
D9FA 10AE63           (    forth6809.asm):03662                     LDY   3,S
D9FD E662             (    forth6809.asm):03663                     LDB   2,S
D9FF 8D98             (    forth6809.asm):03664                     BSR   FDSEARCH
DA01 3265             (    forth6809.asm):03665         SORDONE:    LEAS  5,S
DA03 39               (    forth6809.asm):03666                     RTS
                      (    forth6809.asm):03667         
                      (    forth6809.asm):03668         ; ------------------------------------------------------------
                      (    forth6809.asm):03669         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03670         ; HDRXT
                      (    forth6809.asm):03671         ;    Inputs:
                      (    forth6809.asm):03672         ;        RegX = header
                      (    forth6809.asm):03673         ;    Outputs:
                      (    forth6809.asm):03674         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03675         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03676         ; ------------------------------------------------------------
DA04 A684             (    forth6809.asm):03677         HDRXT:      LDA   ,X
DA06 1F89             (    forth6809.asm):03678                     TFR   A,B
DA08 C41F             (    forth6809.asm):03679                     ANDB  #$1F
DA0A 3001             (    forth6809.asm):03680                     LEAX  1,X
DA0C 3A               (    forth6809.asm):03681                     ABX
DA0D AE02             (    forth6809.asm):03682                     LDX   2,X               ; CFA field
DA0F 39               (    forth6809.asm):03683                     RTS
                      (    forth6809.asm):03684         
                      (    forth6809.asm):03685         ; ------------------------------------------------------------
                      (    forth6809.asm):03686         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03687         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03688         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03689         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03690         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03691         ; ------------------------------------------------------------
DA10 10AEC4           (    forth6809.asm):03692         FINDW:      LDY   ,U                ; counted string
DA13 E6A0             (    forth6809.asm):03693                     LDB   ,Y+
DA15 8DBF             (    forth6809.asm):03694                     BSR   SRCHORD
DA17 8C0000           (    forth6809.asm):03695                     CMPX  #0
DA1A 2712             (    forth6809.asm):03696                     BEQ   NOTFOUND
DA1C 8DE6             (    forth6809.asm):03697                     BSR   HDRXT
DA1E AFC4             (    forth6809.asm):03698                     STX   ,U                ; xt replaces c-addr
DA20 4D               (    forth6809.asm):03699                     TSTA
DA21 2A05             (    forth6809.asm):03700                     BPL   FISNORM
DA23 CC0001           (    forth6809.asm):03701                     LDD   #1
DA26 2003             (    forth6809.asm):03702                     BRA   FPUSH
DA28 CCFFFF           (    forth6809.asm):03703         FISNORM:    LDD   #-1
DA2B 3606             (    forth6809.asm):03704         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
DA2D 39               (    forth6809.asm):03705                     RTS
                      (    forth6809.asm):03706         
DA2E CC0000           (    forth6809.asm):03707         NOTFOUND:   LDD   #0
DA31 3606             (    forth6809.asm):03708                     PSHU  D                 ; 0 = not found, c-addr still beneath
DA33 39               (    forth6809.asm):03709                     RTS
                      (    forth6809.asm):03710         
                      (    forth6809.asm):03711         ; ------------------------------------------------------------
                      (    forth6809.asm):03712         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03713         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03714         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03715         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03716         ; ------------------------------------------------------------
DA34 3710             (    forth6809.asm):03717         SEARCHWLW:  PULU  X                 ; wid
DA36 8D2D             (    forth6809.asm):03718                     BSR   WIDCHK
DA38 AE84             (    forth6809.asm):03719                     LDX   ,X                ; newest header of the wordlist
DA3A 3706             (    forth6809.asm):03720                     PULU  D                 ; u
DA3C 3720             (    forth6809.asm):03721                     PULU  Y                 ; c-addr
DA3E 4D               (    forth6809.asm):03722                     TSTA
DA3F 261E             (    forth6809.asm):03723                     BNE   SWNOT             ; longer than any name
DA41 C11F             (    forth6809.asm):03724                     CMPB  #31
DA43 221A             (    forth6809.asm):03725                     BHI   SWNOT
DA45 BDD999           (    forth6809.asm):03726                     JSR   FDSEARCH
DA48 8C0000           (    forth6809.asm):03727                     CMPX  #0
DA4B 2712             (    forth6809.asm):03728                     BEQ   SWNOT
DA4D 8DB5             (    forth6809.asm):03729                     BSR   HDRXT
DA4F 3610             (    forth6809.asm):03730                     PSHU  X                 ; xt
DA51 4D               (    forth6809.asm):03731                     TSTA
DA52 2A05             (    forth6809.asm):03732                     BPL   SWNORM
DA54 CC0001           (    forth6809.asm):03733                     LDD   #1
DA57 2003             (    forth6809.asm):03734                     BRA   SWPUSH
DA59 CCFFFF           (    forth6809.asm):03735         SWNORM:     LDD   #-1
DA5C 3606             (    forth6809.asm):03736         SWPUSH:     PSHU  D
DA5E 39               (    forth6809.asm):03737                     RTS
DA5F CC0000           (    forth6809.asm):03738         SWNOT:      LDD   #0
DA62 3606             (    forth6809.asm):03739                     PSHU  D
DA64 39               (    forth6809.asm):03740                     RTS
                      (    forth6809.asm):03741         
                      (    forth6809.asm):03742         ; ------------------------------------------------------------
                      (    forth6809.asm):03743         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03744         ; WIDCHK
                      (    forth6809.asm):03745         ;    Inputs:
                      (    forth6809.asm):03746         ;        RegX = candidate WID
                      (    forth6809.asm):03747         ;    Outputs:
                      (    forth6809.asm):03748         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03749         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03750         ; ------------------------------------------------------------
DA65 1F10             (    forth6809.asm):03751         WIDCHK:     TFR   X,D
DA67 83005B           (    forth6809.asm):03752                     SUBD  #WLHEADS
DA6A 2509             (    forth6809.asm):03753                     BCS   WIDBAD
DA6C C501             (    forth6809.asm):03754                     BITB  #1
DA6E 2605             (    forth6809.asm):03755                     BNE   WIDBAD
DA70 9C45             (    forth6809.asm):03756                     CMPX  WLEND
DA72 2401             (    forth6809.asm):03757                     BHS   WIDBAD
DA74 39               (    forth6809.asm):03758                     RTS
DA75 CCFFF5           (    forth6809.asm):03759         WIDBAD:     LDD   #-11
DA78 3606             (    forth6809.asm):03760                     PSHU  D
DA7A 7EDE2F           (    forth6809.asm):03761                     JMP   THROWW
                      (    forth6809.asm):03762         
                      (    forth6809.asm):03763         ; ------------------------------------------------------------
                      (    forth6809.asm):03764         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03765         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03766         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03767         ; WLINIT
                      (    forth6809.asm):03768         ;    Inputs:
                      (    forth6809.asm):03769         ;        none
                      (    forth6809.asm):03770         ;    Outputs:
                      (    forth6809.asm):03771         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03772         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03773         ; ------------------------------------------------------------
DA7D CCD23A           (    forth6809.asm):03774         WLINIT:     LDD   #BASELATEST
DA80 DD5B             (    forth6809.asm):03775                     STD   WLHEADS
DA82 CCC941           (    forth6809.asm):03776                     LDD   #BASEROOTLATEST
DA85 DD5D             (    forth6809.asm):03777                     STD   WLHEADS+2
DA87 CCC941           (    forth6809.asm):03778                     LDD   #H_FORTH
DA8A DD6F             (    forth6809.asm):03779                     STD   WLNAMES
DA8C CCC938           (    forth6809.asm):03780                     LDD   #H_ROOT
DA8F DD71             (    forth6809.asm):03781                     STD   WLNAMES+2
DA91 CC005F           (    forth6809.asm):03782                     LDD   #WLHEADS+4
DA94 DD45             (    forth6809.asm):03783                     STD   WLEND
DA96 CC005B           (    forth6809.asm):03784                     LDD   #WLHEADS
DA99 DD47             (    forth6809.asm):03785                     STD   CURRENT
DA9B 7EDB6B           (    forth6809.asm):03786                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03787         
                      (    forth6809.asm):03788         ; ------------------------------------------------------------
                      (    forth6809.asm):03789         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03790         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03791         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03792         ; PRUNE
                      (    forth6809.asm):03793         ;    Inputs:
                      (    forth6809.asm):03794         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03795         ;    Outputs:
                      (    forth6809.asm):03796         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03797         ;        into ROM
                      (    forth6809.asm):03798         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03799         ; ------------------------------------------------------------
DA9E 3406             (    forth6809.asm):03800         PRUNE:      PSHS  D                 ; 0,S = mark
DAA0 8E005B           (    forth6809.asm):03801                     LDX   #WLHEADS
DAA3 9C45             (    forth6809.asm):03802         PRLOOP:     CMPX  WLEND
DAA5 2421             (    forth6809.asm):03803                     BHS   PRNDONE
DAA7 10AE84           (    forth6809.asm):03804                     LDY   ,X                ; newest header of this wordlist
DAAA 108CC000         (    forth6809.asm):03805         PRWALK:     CMPY  #ROMSTRT
DAAE 2413             (    forth6809.asm):03806                     BHS   PRSTORE           ; ROM header: keep
DAB0 10ACE4           (    forth6809.asm):03807                     CMPY  ,S
DAB3 250E             (    forth6809.asm):03808                     BLO   PRSTORE           ; below the mark (or empty): keep
DAB5 E6A4             (    forth6809.asm):03809                     LDB   ,Y
DAB7 C41F             (    forth6809.asm):03810                     ANDB  #$1F
DAB9 4F               (    forth6809.asm):03811                     CLRA
DABA 3121             (    forth6809.asm):03812                     LEAY  1,Y
DABC 31AB             (    forth6809.asm):03813                     LEAY  D,Y
DABE 10AEA4           (    forth6809.asm):03814                     LDY   ,Y                ; follow the LINK
DAC1 20E7             (    forth6809.asm):03815                     BRA   PRWALK
DAC3 10AF81           (    forth6809.asm):03816         PRSTORE:    STY   ,X++
DAC6 20DB             (    forth6809.asm):03817                     BRA   PRLOOP
DAC8 3262             (    forth6809.asm):03818         PRNDONE:     LEAS  2,S
DACA 39               (    forth6809.asm):03819                     RTS
                      (    forth6809.asm):03820         
                      (    forth6809.asm):03821         ; ============================================================
                      (    forth6809.asm):03822         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03823         ; ============================================================
                      (    forth6809.asm):03824         ; ------------------------------------------------------------
                      (    forth6809.asm):03825         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03826         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03827         ; ------------------------------------------------------------
DACB 9E45             (    forth6809.asm):03828         WORDLISTW:  LDX   WLEND
DACD 8C006F           (    forth6809.asm):03829                     CMPX  #WLHEADS+2*WLCELLS
DAD0 240F             (    forth6809.asm):03830                     BHS   WLFULL
DAD2 CC0000           (    forth6809.asm):03831                     LDD   #0
DAD5 ED84             (    forth6809.asm):03832                     STD   ,X
DAD7 ED8814           (    forth6809.asm):03833                     STD   WLNOFF,X
DADA 3610             (    forth6809.asm):03834                     PSHU  X
DADC 3002             (    forth6809.asm):03835                     LEAX  2,X
DADE 9F45             (    forth6809.asm):03836                     STX   WLEND
DAE0 39               (    forth6809.asm):03837                     RTS
DAE1 CCFFF8           (    forth6809.asm):03838         WLFULL:     LDD   #-8
DAE4 3606             (    forth6809.asm):03839                     PSHU  D
DAE6 7EDE2F           (    forth6809.asm):03840                     JMP   THROWW
                      (    forth6809.asm):03841         
                      (    forth6809.asm):03842         ; ------------------------------------------------------------
                      (    forth6809.asm):03843         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03844         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03845         ; ------------------------------------------------------------
DAE9 CC005B           (    forth6809.asm):03846         FORTHWLW:   LDD   #WLHEADS
DAEC 3606             (    forth6809.asm):03847                     PSHU  D
DAEE 39               (    forth6809.asm):03848                     RTS
                      (    forth6809.asm):03849         
                      (    forth6809.asm):03850         ; ------------------------------------------------------------
                      (    forth6809.asm):03851         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03852         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03853         ; it, as it is always searched last.
                      (    forth6809.asm):03854         ; ------------------------------------------------------------
DAEF 9E49             (    forth6809.asm):03855         GETORDERW:  LDX   ORDEND
DAF1 8C004B           (    forth6809.asm):03856         GOLOOP:     CMPX  #ORDER
DAF4 2306             (    forth6809.asm):03857                     BLS   GODONE
DAF6 EC83             (    forth6809.asm):03858                     LDD   ,--X
DAF8 3606             (    forth6809.asm):03859                     PSHU  D
DAFA 20F5             (    forth6809.asm):03860                     BRA   GOLOOP
DAFC DC49             (    forth6809.asm):03861         GODONE:     LDD   ORDEND
DAFE 83004B           (    forth6809.asm):03862                     SUBD  #ORDER
DB01 44               (    forth6809.asm):03863                     LSRA
DB02 56               (    forth6809.asm):03864                     RORB
DB03 3606             (    forth6809.asm):03865                     PSHU  D                 ; n
DB05 39               (    forth6809.asm):03866                     RTS
                      (    forth6809.asm):03867         
                      (    forth6809.asm):03868         ; ------------------------------------------------------------
                      (    forth6809.asm):03869         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03870         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03871         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03872         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03873         ; ------------------------------------------------------------
DB06 3706             (    forth6809.asm):03874         SETORDERW:  PULU  D                 ; n
DB08 1083FFFF         (    forth6809.asm):03875                     CMPD  #-1
DB0C 275D             (    forth6809.asm):03876                     BEQ   ONLYW             ; the minimum order
DB0E 4D               (    forth6809.asm):03877         SO1:        TSTA
DB0F 2B31             (    forth6809.asm):03878                     BMI   SOUNDER
DB11 262A             (    forth6809.asm):03879                     BNE   SOOVER
DB13 C108             (    forth6809.asm):03880                     CMPB  #WLMAX
DB15 2226             (    forth6809.asm):03881                     BHI   SOOVER
DB17 3404             (    forth6809.asm):03882                     PSHS  B                 ; 1,S = n
DB19 3404             (    forth6809.asm):03883                     PSHS  B                 ; 0,S = count down
DB1B 1F32             (    forth6809.asm):03884                     TFR   U,Y
DB1D 6DE4             (    forth6809.asm):03885         SOCHK:      TST   ,S
DB1F 2709             (    forth6809.asm):03886                     BEQ   SOCOPY
DB21 AEA1             (    forth6809.asm):03887                     LDX   ,Y++
DB23 BDDA65           (    forth6809.asm):03888                     JSR   WIDCHK            ; keeps Y
DB26 6AE4             (    forth6809.asm):03889                     DEC   ,S
DB28 20F3             (    forth6809.asm):03890                     BRA   SOCHK
DB2A 3506             (    forth6809.asm):03891         SOCOPY:     PULS  A,B               ; B = n
DB2C 8E004B           (    forth6809.asm):03892                     LDX   #ORDER
DB2F 5D               (    forth6809.asm):03893         SOCP2:      TSTB
DB30 2708             (    forth6809.asm):03894                     BEQ   SOCPEND
DB32 3720             (    forth6809.asm):03895                     PULU  Y
DB34 10AF81           (    forth6809.asm):03896                     STY   ,X++
DB37 5A               (    forth6809.asm):03897                     DECB
DB38 20F5             (    forth6809.asm):03898                     BRA   SOCP2
DB3A 9F49             (    forth6809.asm):03899         SOCPEND:    STX   ORDEND
DB3C 39               (    forth6809.asm):03900                     RTS
DB3D CCFFCF           (    forth6809.asm):03901         SOOVER:     LDD   #-49
DB40 2003             (    forth6809.asm):03902                     BRA   SOTHROW
DB42 CCFFCE           (    forth6809.asm):03903         SOUNDER:    LDD   #-50
DB45 3606             (    forth6809.asm):03904         SOTHROW:    PSHU  D
DB47 7EDE2F           (    forth6809.asm):03905                     JMP   THROWW
                      (    forth6809.asm):03906         
                      (    forth6809.asm):03907         ; ------------------------------------------------------------
                      (    forth6809.asm):03908         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03909         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03910         ; ------------------------------------------------------------
DB4A DC47             (    forth6809.asm):03911         GETCURW:    LDD   CURRENT

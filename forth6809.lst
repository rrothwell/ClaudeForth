FD2A 3606             (    forth6809.asm):06672                   PSHU D
FD2C DCEF             (    forth6809.asm):06673                   LDD  ENVLEN
FD2E 3606             (    forth6809.asm):06674                   PSHU D
FD30 BDF790           (    forth6809.asm):06675                   JSR  COMPAREW
FD33 3510             (    forth6809.asm):06676                   PULS X          ; restore X before using it again
FD35 3706             (    forth6809.asm):06677                   PULU D
FD37 10830000         (    forth6809.asm):06678                   CMPD #0
FD3B 2704             (    forth6809.asm):06679                   BEQ  ENVFOUND
FD3D 3006             (    forth6809.asm):06680                   LEAX 6,X
FD3F 20D7             (    forth6809.asm):06681                   BRA  ENVLOOP
FD41 EC04             (    forth6809.asm):06682         ENVFOUND: LDD  4,X
FD43 3606             (    forth6809.asm):06683                   PSHU D
FD45 CCFFFF           (    forth6809.asm):06684                   LDD  #TRUEV
FD48 3606             (    forth6809.asm):06685                   PSHU D
FD4A 39               (    forth6809.asm):06686                   RTS
                      (    forth6809.asm):06687         
FD4B 8EFD8B           (    forth6809.asm):06688         ENV2START: LDX  #ENVTABLE2  ; NEW: double-cell query table - kept
                      (    forth6809.asm):06689                                     ; entirely separate from ENVTABLE above
                      (    forth6809.asm):06690                                     ; rather than trying to unify both cases
                      (    forth6809.asm):06691                                     ; into one mechanism, since the two
                      (    forth6809.asm):06692                                     ; genuinely differ in entry size (8 bytes

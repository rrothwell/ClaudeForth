                      (    forth6809.asm):03188         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):03189         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):03190         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):03191         ; remaining string.

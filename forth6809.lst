                      (    forth6809.asm):10361         ; TSTPOSTPONE2 - unit test for POSTPONE, immediate word case.
                      (    forth6809.asm):10362         ; Confirmed via FIND's own code that it pushes 1 for immediate
                      (    forth6809.asm):10363         ; words, -1 otherwise - POSTPONEW branches on exactly that. For
                      (    forth6809.asm):10364         ; an immediate word, its own "compilation semantics" IS
                      (    forth6809.asm):10365         ; "execute it now" (that's what immediate means), so POSTPONE
                      (    forth6809.asm):10366         ; compiles a direct call to it - simpler to verify than the
                      (    forth6809.asm):10367         ; normal-word case, no second level involved.
                      (    forth6809.asm):10368         ; ------------------------------------------------------------
C27E                  (    forth6809.asm):10369         TSTPOSTPONE2: LDD  CODEHERE
                      (    forth6809.asm):10370                       STD  TSTCSAV
                      (    forth6809.asm):10371                       LDD  LATEST

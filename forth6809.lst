                      (    forth6809.asm):07963         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):07964         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):07965         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):07966         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):07967         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):07968         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):07969         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):07970         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):07971         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):07972         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):07973         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):07974         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):07975                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):07976                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):07977                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):07978                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):07979                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):07980                  FDB   ABORT
                      (    forth6809.asm):07981         

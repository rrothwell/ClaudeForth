     DEE3             (    forth6809.asm):01906         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01907                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01908                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01909                                   ; were chained on after it; before that,
                      (    forth6809.asm):01910                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01911                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01912                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01913                                   ; before this one.
                      (    forth6809.asm):01914         
                      (    forth6809.asm):01915         ; Verify no collision with base code.
                      (    forth6809.asm):01916         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):01917         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01918         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01919         
                      (    forth6809.asm):01920         ; ============================================================
                      (    forth6809.asm):01921         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01922         ; ============================================================
                      (    forth6809.asm):01923                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01924                                        ; entirely - every routine from here through
                      (    forth6809.asm):01925                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01926                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01927                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01928                                        ; WARM message left the location counter,
                      (    forth6809.asm):01929                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01930                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01931                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01932         
                      (    forth6809.asm):01933         ; ------------------------------------------------------------
                      (    forth6809.asm):01934         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01935         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01936         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01937         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01938         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01939         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):01940         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):01941                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01942                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01943                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01944                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01945                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01946                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):01947                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01948                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):01949                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):01950                  RTS
                      (    forth6809.asm):01951         
                      (    forth6809.asm):01952                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01953         ; ------------------------------------------------------------
                      (    forth6809.asm):01954         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01955         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01956         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01957         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01958         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):01959         INFILL:  LDA   INHEAD
                      (    forth6809.asm):01960                  SUBA  INTAIL
                      (    forth6809.asm):01961                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):01962                  RTS
                      (    forth6809.asm):01963         
                      (    forth6809.asm):01964         ; ------------------------------------------------------------
                      (    forth6809.asm):01965         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01966         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01967         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01968         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01969         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01970         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01971         ; flow control, not a chip feature.
                      (    forth6809.asm):01972         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):01973         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):01974                     CMPA #INHIWATER
                      (    forth6809.asm):01975                     BLO  RTSCHIDONE
                      (    forth6809.asm):01976                     TST  RTSSTATE
                      (    forth6809.asm):01977                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):01978                     LDA  #CR_RTSHI
                      (    forth6809.asm):01979                     STA  ACIACR
                      (    forth6809.asm):01980                     LDA  #1
                      (    forth6809.asm):01981                     STA  RTSSTATE
DEF5                  (    forth6809.asm):01982         RTSCHIDONE: RTS
                      (    forth6809.asm):01983         
                      (    forth6809.asm):01984         ; ------------------------------------------------------------
                      (    forth6809.asm):01985         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):01986         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):01987         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):01988         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):01989         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):01990         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):01991         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01992         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01993         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):01994         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):01995         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):01996                     CMPA #INLOWATER
                      (    forth6809.asm):01997                     BHI  RTSCLODONE
                      (    forth6809.asm):01998                     TST  RTSSTATE
                      (    forth6809.asm):01999                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):02000                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02001                     CLR  RTSSTATE
                      (    forth6809.asm):02002                     LDB  OUTTAIL
                      (    forth6809.asm):02003                     CMPB OUTHEAD
                      (    forth6809.asm):02004                     BEQ  RTSCLONOTX
                      (    forth6809.asm):02005                     LDA  #CR_RXTX
                      (    forth6809.asm):02006                     STA  ACIACR
                      (    forth6809.asm):02007                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):02008         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):02009                     STA  ACIACR
DEF5                  (    forth6809.asm):02010         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):02011         RTSCLODONE: RTS
                      (    forth6809.asm):02012         
DEF5                  (    forth6809.asm):02013         IRQH:    LDA   ACIASR
                      (    forth6809.asm):02014                  BITA  #SR_IRQ
                      (    forth6809.asm):02015                  BEQ   IRQDONE
                      (    forth6809.asm):02016         
                      (    forth6809.asm):02017                  BITA  #SR_RDRF
                      (    forth6809.asm):02018                  BEQ   TXCHK
                      (    forth6809.asm):02019         
                      (    forth6809.asm):02020                  LDB   INHEAD
                      (    forth6809.asm):02021                  LDA   ACIADR
                      (    forth6809.asm):02022                  LDX   #INBUF
                      (    forth6809.asm):02023                  STA   B,X
                      (    forth6809.asm):02024                  INCB
                      (    forth6809.asm):02025                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02026                  CMPB  INTAIL
                      (    forth6809.asm):02027                  BEQ   IRQDONE
                      (    forth6809.asm):02028                  STB   INHEAD
                      (    forth6809.asm):02029                  JSR   RTSCHECKHI
                      (    forth6809.asm):02030                  BRA   IRQDONE
                      (    forth6809.asm):02031         
DEF5                  (    forth6809.asm):02032         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):02033                  CMPB  OUTHEAD
                      (    forth6809.asm):02034                  BEQ   TXOFF
                      (    forth6809.asm):02035                  LDX   #OUTBUF
                      (    forth6809.asm):02036                  LDA   B,X
                      (    forth6809.asm):02037                  STA   ACIADR
                      (    forth6809.asm):02038                  INCB
                      (    forth6809.asm):02039                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02040                  STB   OUTTAIL
                      (    forth6809.asm):02041                  BRA   IRQDONE
                      (    forth6809.asm):02042         
DEF5                  (    forth6809.asm):02043         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):02044                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02045                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):02046                  LDA   #CR_RXON
                      (    forth6809.asm):02047                  STA   ACIACR
                      (    forth6809.asm):02048         
DEF5                  (    forth6809.asm):02049         IRQDONE: RTI
                      (    forth6809.asm):02050         
                      (    forth6809.asm):02051                  ELSE  ; <<<<<>>>>>
DEF5 3B               (    forth6809.asm):02052         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02053                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02054                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02055                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02056                                       ; the other unused vectors below
                      (    forth6809.asm):02057                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02058         
DEF6 3B               (    forth6809.asm):02059         SWI3H:   RTI
DEF7 3B               (    forth6809.asm):02060         SWI2H:   RTI
DEF8 3B               (    forth6809.asm):02061         FIRQH:   RTI
DEF9 3B               (    forth6809.asm):02062         NMIH:    RTI                   ; unused now that NMI -> WARM
DEFA CCFF9D           (    forth6809.asm):02063         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DEFD 3606             (    forth6809.asm):02064                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DEFF 7EE6F9           (    forth6809.asm):02065                  JMP   THROW

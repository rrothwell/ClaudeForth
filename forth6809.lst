                      (    forth6809.asm):02319                    CMPD  #TSTVAL2
                      (    forth6809.asm):02320                    BNE   RO2FAIL
                      (    forth6809.asm):02321                    PULU  D
                      (    forth6809.asm):02322                    CMPD  #TSTVAL1
                      (    forth6809.asm):02323                    BNE   RO2FAIL
                      (    forth6809.asm):02324                    PULU  D
                      (    forth6809.asm):02325                    CMPD  #TSTVAL6

                      (    forth6809.asm):01604         ; ============================================================
                      (    forth6809.asm):01605         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01606         ; ============================================================
                      (    forth6809.asm):01607                  ORG   BASECODE       ; BASECODE is $DFF4. This ORG was missing
                      (    forth6809.asm):01608                                        ; entirely - every routine from here through
                      (    forth6809.asm):01609                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01610                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01611                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01612                                        ; WARM message left the location counter,
                      (    forth6809.asm):01613                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01614                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01615                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01616         
                      (    forth6809.asm):01617                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01618         ; ------------------------------------------------------------
                      (    forth6809.asm):01619         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01620         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01621         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01622         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01623         ; ------------------------------------------------------------
DFF4                  (    forth6809.asm):01624         INFILL:  LDA   INHEAD
                      (    forth6809.asm):01625                  SUBA  INTAIL
                      (    forth6809.asm):01626                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):01627                  RTS
                      (    forth6809.asm):01628         
                      (    forth6809.asm):01629         ; ------------------------------------------------------------
                      (    forth6809.asm):01630         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01631         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01632         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01633         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01634         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01635         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01636         ; flow control, not a chip feature.
                      (    forth6809.asm):01637         ; ------------------------------------------------------------
DFF4                  (    forth6809.asm):01638         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):01639                     CMPA #INHIWATER
                      (    forth6809.asm):01640                     BLO  RTSCHIDONE
                      (    forth6809.asm):01641                     TST  RTSSTATE
                      (    forth6809.asm):01642                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):01643                     LDA  #CR_RTSHI
                      (    forth6809.asm):01644                     STA  ACIACR
                      (    forth6809.asm):01645                     LDA  #1
                      (    forth6809.asm):01646                     STA  RTSSTATE
DFF4                  (    forth6809.asm):01647         RTSCHIDONE: RTS
                      (    forth6809.asm):01648         
                      (    forth6809.asm):01649         ; ------------------------------------------------------------
                      (    forth6809.asm):01650         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):01651         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):01652         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):01653         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):01654         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):01655         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):01656         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01657         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01658         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):01659         ; ------------------------------------------------------------
DFF4                  (    forth6809.asm):01660         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):01661                     CMPA #INLOWATER
                      (    forth6809.asm):01662                     BHI  RTSCLODONE
                      (    forth6809.asm):01663                     TST  RTSSTATE
                      (    forth6809.asm):01664                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):01665                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):01666                     CLR  RTSSTATE
                      (    forth6809.asm):01667                     LDB  OUTTAIL
                      (    forth6809.asm):01668                     CMPB OUTHEAD
                      (    forth6809.asm):01669                     BEQ  RTSCLONOTX
                      (    forth6809.asm):01670                     LDA  #CR_RXTX
                      (    forth6809.asm):01671                     STA  ACIACR
                      (    forth6809.asm):01672                     BRA  RTSCLOUNMASK
DFF4                  (    forth6809.asm):01673         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):01674                     STA  ACIACR
DFF4                  (    forth6809.asm):01675         RTSCLOUNMASK: ANDCC #$EF
DFF4                  (    forth6809.asm):01676         RTSCLODONE: RTS
                      (    forth6809.asm):01677         
DFF4                  (    forth6809.asm):01678         IRQH:    LDA   ACIASR
                      (    forth6809.asm):01679                  BITA  #SR_IRQ
                      (    forth6809.asm):01680                  BEQ   IRQDONE
                      (    forth6809.asm):01681         
                      (    forth6809.asm):01682                  BITA  #SR_RDRF
                      (    forth6809.asm):01683                  BEQ   TXCHK
                      (    forth6809.asm):01684         
                      (    forth6809.asm):01685                  LDB   INHEAD
                      (    forth6809.asm):01686                  LDA   ACIADR
                      (    forth6809.asm):01687                  LDX   #INBUF
                      (    forth6809.asm):01688                  STA   B,X
                      (    forth6809.asm):01689                  INCB
                      (    forth6809.asm):01690                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):01691                  CMPB  INTAIL
                      (    forth6809.asm):01692                  BEQ   IRQDONE
                      (    forth6809.asm):01693                  STB   INHEAD
                      (    forth6809.asm):01694                  JSR   RTSCHECKHI
                      (    forth6809.asm):01695                  BRA   IRQDONE
                      (    forth6809.asm):01696         
DFF4                  (    forth6809.asm):01697         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):01698                  CMPB  OUTHEAD
                      (    forth6809.asm):01699                  BEQ   TXOFF
                      (    forth6809.asm):01700                  LDX   #OUTBUF
                      (    forth6809.asm):01701                  LDA   B,X
                      (    forth6809.asm):01702                  STA   ACIADR
                      (    forth6809.asm):01703                  INCB
                      (    forth6809.asm):01704                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01705                  STB   OUTTAIL
                      (    forth6809.asm):01706                  BRA   IRQDONE
                      (    forth6809.asm):01707         
DFF4                  (    forth6809.asm):01708         TXOFF:   TST   RTSSTATE

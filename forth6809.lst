                      (    forth6809.asm):09631         ; TSTBRACKETS - unit test for [ and ] together. Verifies ]
                      (    forth6809.asm):09632         ; sets STATE to -1 (compiling) and [ sets it back to 0
                      (    forth6809.asm):09633         ; (interpreting) - both memory-only operations, no data-stack
                      (    forth6809.asm):09634         ; effect.
                      (    forth6809.asm):09635         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):09636         TSTBRACKETS: LDD  STATE
                      (    forth6809.asm):09637                      STD  TSTSTSAV
                      (    forth6809.asm):09638         
                      (    forth6809.asm):09639                      STU  TSTU0
                      (    forth6809.asm):09640         
                      (    forth6809.asm):09641                      LDD  #TSTGUARD
                      (    forth6809.asm):09642                      PSHU D
                      (    forth6809.asm):09643                      STU  TSTUB4
                      (    forth6809.asm):09644         
                      (    forth6809.asm):09645                      JSR  RBRACKET
                      (    forth6809.asm):09646         
                      (    forth6809.asm):09647                      LDD  STATE
                      (    forth6809.asm):09648                      CMPD #-1
                      (    forth6809.asm):09649                      BNE  BKFAIL
                      (    forth6809.asm):09650         
                      (    forth6809.asm):09651                      JSR  LBRACKET
                      (    forth6809.asm):09652         
                      (    forth6809.asm):09653                      STU  TSTUAF
                      (    forth6809.asm):09654         
                      (    forth6809.asm):09655                      LDD  STATE
                      (    forth6809.asm):09656                      CMPD #0
                      (    forth6809.asm):09657                      BNE  BKFAIL
                      (    forth6809.asm):09658         
                      (    forth6809.asm):09659                      PULU D
                      (    forth6809.asm):09660                      CMPD #TSTGUARD
                      (    forth6809.asm):09661                      BNE  BKFAIL
                      (    forth6809.asm):09662         
                      (    forth6809.asm):09663                      LDD  TSTUB4
                      (    forth6809.asm):09664                      SUBD TSTUAF
                      (    forth6809.asm):09665                      CMPD #0
                      (    forth6809.asm):09666                      BNE  BKFAIL
                      (    forth6809.asm):09667         
                      (    forth6809.asm):09668                      LDD  #TRUEV
                      (    forth6809.asm):09669                      BRA  BKDONE
C26F                  (    forth6809.asm):09670         BKFAIL:      LDD  #FALSEV
C26F                  (    forth6809.asm):09671         BKDONE:      LDX  #TSTBRACKETSNAME
                      (    forth6809.asm):09672                      PSHU X
                      (    forth6809.asm):09673                      PSHU D

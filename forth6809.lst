                      (    forth6809.asm):04596                                             ; stream this line's characters
                      (    forth6809.asm):04597                     JSR   PUTXON
                      (    forth6809.asm):04598                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04599         

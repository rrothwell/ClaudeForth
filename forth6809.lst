DF6D 3410             (    forth6809.asm):02106                     PSHS  X
DF6F 39               (    forth6809.asm):02107                     RTS
                      (    forth6809.asm):02108         
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
                      (    forth6809.asm):02110         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02111         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02112         ; address.
                      (    forth6809.asm):02113         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02114         ;    Inputs:
                      (    forth6809.asm):02115         ;        flag on the data stack
                      (    forth6809.asm):02116         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02117         ;    Outputs:
                      (    forth6809.asm):02118         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02119         ;        the offset
                      (    forth6809.asm):02120         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02121         ; ------------------------------------------------------------
DF70 3706             (    forth6809.asm):02122         ZBRANCH:    PULU  D                 ; flag
DF72 3510             (    forth6809.asm):02123                     PULS  X
DF74 10830000         (    forth6809.asm):02124                     CMPD  #0
DF78 2607             (    forth6809.asm):02125                     BNE   ZSKIP
DF7A EC84             (    forth6809.asm):02126                     LDD   ,X
DF7C 308B             (    forth6809.asm):02127                     LEAX  D,X
DF7E 3410             (    forth6809.asm):02128                     PSHS  X
DF80 39               (    forth6809.asm):02129                     RTS
DF81 3002             (    forth6809.asm):02130         ZSKIP:      LEAX  2,X
DF83 3410             (    forth6809.asm):02131                     PSHS  X
DF85 39               (    forth6809.asm):02132                     RTS
                      (    forth6809.asm):02133         
                      (    forth6809.asm):02134         ; ------------------------------------------------------------
                      (    forth6809.asm):02135         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02136         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02137         ; BRANCH
                      (    forth6809.asm):02138         ;    Inputs:
                      (    forth6809.asm):02139         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02140         ;    Outputs:
                      (    forth6809.asm):02141         ;        return address set to the branch target
                      (    forth6809.asm):02142         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02143         ; ------------------------------------------------------------
DF86 3510             (    forth6809.asm):02144         BRANCH:     PULS  X
DF88 EC84             (    forth6809.asm):02145                     LDD   ,X
DF8A 308B             (    forth6809.asm):02146                     LEAX  D,X
DF8C 3410             (    forth6809.asm):02147                     PSHS  X
DF8E 39               (    forth6809.asm):02148                     RTS
                      (    forth6809.asm):02149         
                      (    forth6809.asm):02150         ; ------------------------------------------------------------
                      (    forth6809.asm):02151         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02152         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02153         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02154         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02155         ;    Inputs:
                      (    forth6809.asm):02156         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02157         ;        trampoline
                      (    forth6809.asm):02158         ;    Outputs:
                      (    forth6809.asm):02159         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02160         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02161         ; ------------------------------------------------------------
DF8F 3510             (    forth6809.asm):02162         DODOES:     PULS  X
DF91 10AE81           (    forth6809.asm):02163                     LDY   ,X++
DF94 EC84             (    forth6809.asm):02164                     LDD   ,X
DF96 3606             (    forth6809.asm):02165                     PSHU  D                 ; pfa
DF98 6EA4             (    forth6809.asm):02166                     JMP   ,Y
                      (    forth6809.asm):02167         
                      (    forth6809.asm):02168         ; ------------------------------------------------------------
                      (    forth6809.asm):02169         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02170         ; field address on the stack.
                      (    forth6809.asm):02171         ; DOESRT0
                      (    forth6809.asm):02172         ;    Inputs:
                      (    forth6809.asm):02173         ;        none
                      (    forth6809.asm):02174         ;    Outputs:
                      (    forth6809.asm):02175         ;        none
                      (    forth6809.asm):02176         ;    Registers: none.
                      (    forth6809.asm):02177         ; ------------------------------------------------------------
DF9A 39               (    forth6809.asm):02178         DOESRT0:    RTS
                      (    forth6809.asm):02179         
                      (    forth6809.asm):02180         ; ------------------------------------------------------------
                      (    forth6809.asm):02181         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02182         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02183         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02184         ; SETDOES
                      (    forth6809.asm):02185         ;    Inputs:
                      (    forth6809.asm):02186         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02187         ;        BEHAVIOR)
                      (    forth6809.asm):02188         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02189         ;        address
                      (    forth6809.asm):02190         ;    Outputs:
                      (    forth6809.asm):02191         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02192         ;        defining word's caller
                      (    forth6809.asm):02193         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):02195         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF9D 1F12             (    forth6809.asm):02196                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02197         
DF9F 9E04             (    forth6809.asm):02198                     LDX   LATEST
DFA1 E684             (    forth6809.asm):02199                     LDB   ,X
DFA3 C41F             (    forth6809.asm):02200                     ANDB  #$1F
DFA5 4F               (    forth6809.asm):02201                     CLRA
DFA6 308B             (    forth6809.asm):02202                     LEAX  D,X               ; header + name length
DFA8 EC03             (    forth6809.asm):02203                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DFAA C30003           (    forth6809.asm):02204                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFAD 1F01             (    forth6809.asm):02205                     TFR   D,X
                      (    forth6809.asm):02206         
DFAF 10AF84           (    forth6809.asm):02207                     STY   ,X                ; patch it
                      (    forth6809.asm):02208         
DFB2 3510             (    forth6809.asm):02209                     PULS  X                 ; X = the OUTER defining word's own return addr
DFB4 6E84             (    forth6809.asm):02210                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02211         
                      (    forth6809.asm):02212         ; ------------------------------------------------------------
                      (    forth6809.asm):02213         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02214         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02215         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02216         ;    Inputs:
                      (    forth6809.asm):02217         ;        pfa on the data stack
                      (    forth6809.asm):02218         ;    Outputs:
                      (    forth6809.asm):02219         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02220         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02221         ; ------------------------------------------------------------
DFB6 3710             (    forth6809.asm):02222         DODEFER:    PULU  X                 ; pfa
DFB8 EC84             (    forth6809.asm):02223                     LDD   ,X
DFBA 1F01             (    forth6809.asm):02224                     TFR   D,X
DFBC 6E84             (    forth6809.asm):02225                     JMP   ,X
                      (    forth6809.asm):02226         
                      (    forth6809.asm):02227         ; ------------------------------------------------------------
                      (    forth6809.asm):02228         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02229         ; DOABORTUNDEF
                      (    forth6809.asm):02230         ;    Inputs:
                      (    forth6809.asm):02231         ;        none
                      (    forth6809.asm):02232         ;    Outputs:
                      (    forth6809.asm):02233         ;        none (does not return)
                      (    forth6809.asm):02234         ;    Registers: RegD changed.
                      (    forth6809.asm):02235         ; ------------------------------------------------------------
DFBE                  (    forth6809.asm):02236         DOABORTUNDEF:
DFBE CCFFEB           (    forth6809.asm):02237                     LDD   #-21
DFC1 3606             (    forth6809.asm):02238                     PSHU  D                 ; throw code (-21)
DFC3 7EE61F           (    forth6809.asm):02239                     JMP   THROWW
                      (    forth6809.asm):02240         
                      (    forth6809.asm):02241         ; ------------------------------------------------------------
                      (    forth6809.asm):02242         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02243         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02244         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02245         ;    Inputs:
                      (    forth6809.asm):02246         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02247         ;    Outputs:
                      (    forth6809.asm):02248         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02249         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
DFC6 3710             (    forth6809.asm):02251         DOMARKER:   PULU  X                 ; pfa
DFC8 EC84             (    forth6809.asm):02252                     LDD   ,X
DFCA DD06             (    forth6809.asm):02253                     STD   DPHERE
DFCC EC02             (    forth6809.asm):02254                     LDD   2,X
DFCE DD08             (    forth6809.asm):02255                     STD   CODEHERE
DFD0 EC04             (    forth6809.asm):02256                     LDD   4,X
DFD2 DD0A             (    forth6809.asm):02257                     STD   VARHERE
DFD4 EC06             (    forth6809.asm):02258                     LDD   6,X
DFD6 DD04             (    forth6809.asm):02259                     STD   LATEST
DFD8 39               (    forth6809.asm):02260                     RTS
                      (    forth6809.asm):02261         
                      (    forth6809.asm):02262         ; ------------------------------------------------------------
                      (    forth6809.asm):02263         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02264         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02265         ; ------------------------------------------------------------
DFD9 3710             (    forth6809.asm):02266         EXECUTEW:   PULU  X                 ; xt
DFDB AD84             (    forth6809.asm):02267                     JSR   ,X
DFDD 39               (    forth6809.asm):02268                     RTS
                      (    forth6809.asm):02269         
                      (    forth6809.asm):02270         ; ============================================================
                      (    forth6809.asm):02271         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02272         ; ============================================================
                      (    forth6809.asm):02273         ; ------------------------------------------------------------
                      (    forth6809.asm):02274         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02275         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02276         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02277         ;    Inputs:
                      (    forth6809.asm):02278         ;        RegX = address of the here pointer
                      (    forth6809.asm):02279         ;        x on the data stack
                      (    forth6809.asm):02280         ;    Outputs:
                      (    forth6809.asm):02281         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02282         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02283         ; ------------------------------------------------------------
DFDE 3706             (    forth6809.asm):02284         APPENDCELL: PULU  D                 ; x
DFE0 10AE84           (    forth6809.asm):02285                     LDY   ,X
DFE3 EDA1             (    forth6809.asm):02286                     STD   ,Y++
DFE5 10AF84           (    forth6809.asm):02287                     STY   ,X
DFE8 39               (    forth6809.asm):02288                     RTS
                      (    forth6809.asm):02289         
                      (    forth6809.asm):02290         ; ------------------------------------------------------------
                      (    forth6809.asm):02291         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02292         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02293         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02294         ;    Inputs:
                      (    forth6809.asm):02295         ;        RegX = address of the here pointer
                      (    forth6809.asm):02296         ;        char on the data stack
                      (    forth6809.asm):02297         ;    Outputs:
                      (    forth6809.asm):02298         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02299         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02300         ; ------------------------------------------------------------
DFE9 3706             (    forth6809.asm):02301         APPENDBYTE: PULU  D                 ; char
DFEB 10AE84           (    forth6809.asm):02302                     LDY   ,X
DFEE E7A0             (    forth6809.asm):02303                     STB   ,Y+
DFF0 10AF84           (    forth6809.asm):02304                     STY   ,X
DFF3 39               (    forth6809.asm):02305                     RTS
                      (    forth6809.asm):02306         
                      (    forth6809.asm):02307         ; ------------------------------------------------------------
                      (    forth6809.asm):02308         ; ,  ( x -- )
                      (    forth6809.asm):02309         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02310         ; ------------------------------------------------------------
DFF4 8E0008           (    forth6809.asm):02311         COMMAW:     LDX   #CODEHERE
DFF7 7EDFDE           (    forth6809.asm):02312                     JMP   APPENDCELL
                      (    forth6809.asm):02313         
                      (    forth6809.asm):02314         ; ------------------------------------------------------------
                      (    forth6809.asm):02315         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02316         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02317         ; ------------------------------------------------------------
DFFA 8E0008           (    forth6809.asm):02318         CODECOMMA:  LDX   #CODEHERE
DFFD 7EDFDE           (    forth6809.asm):02319                     JMP   APPENDCELL
                      (    forth6809.asm):02320         
                      (    forth6809.asm):02321         ; ------------------------------------------------------------
                      (    forth6809.asm):02322         ; C,  ( char -- )
                      (    forth6809.asm):02323         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02324         ; ------------------------------------------------------------
E000 8E0008           (    forth6809.asm):02325         CCOMMAW:    LDX   #CODEHERE
E003 7EDFE9           (    forth6809.asm):02326                     JMP   APPENDBYTE
                      (    forth6809.asm):02327         
                      (    forth6809.asm):02328         ; ------------------------------------------------------------
                      (    forth6809.asm):02329         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02330         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02331         ; ------------------------------------------------------------
E006 8E0008           (    forth6809.asm):02332         CCOMMA1:    LDX   #CODEHERE
E009 7EDFE9           (    forth6809.asm):02333                     JMP   APPENDBYTE
                      (    forth6809.asm):02334         
                      (    forth6809.asm):02335         ; ------------------------------------------------------------
                      (    forth6809.asm):02336         ; V,  ( x -- )
                      (    forth6809.asm):02337         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02338         ; ------------------------------------------------------------
E00C 8E000A           (    forth6809.asm):02339         VCOMMAW:    LDX   #VARHERE
E00F 7EDFDE           (    forth6809.asm):02340                     JMP   APPENDCELL
                      (    forth6809.asm):02341         
                      (    forth6809.asm):02342         ; ------------------------------------------------------------
                      (    forth6809.asm):02343         ; VC,  ( char -- )
                      (    forth6809.asm):02344         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02345         ; ------------------------------------------------------------
E012 8E000A           (    forth6809.asm):02346         VCCOMMAW:   LDX   #VARHERE
E015 7EDFE9           (    forth6809.asm):02347                     JMP   APPENDBYTE
                      (    forth6809.asm):02348         
                      (    forth6809.asm):02349         ; ------------------------------------------------------------
                      (    forth6809.asm):02350         ; ALLOT  ( n -- )
                      (    forth6809.asm):02351         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02352         ; ------------------------------------------------------------
E018 3706             (    forth6809.asm):02353         ALLOTW:     PULU  D                 ; n
E01A 9E08             (    forth6809.asm):02354                     LDX   CODEHERE
E01C 308B             (    forth6809.asm):02355                     LEAX  D,X
E01E 9F08             (    forth6809.asm):02356                     STX   CODEHERE
E020 39               (    forth6809.asm):02357                     RTS
                      (    forth6809.asm):02358         
                      (    forth6809.asm):02359         ; ------------------------------------------------------------
                      (    forth6809.asm):02360         ; VALLOT  ( n -- )
                      (    forth6809.asm):02361         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02362         ; ------------------------------------------------------------
E021 3706             (    forth6809.asm):02363         VALLOTW:    PULU  D                 ; n
E023 9E0A             (    forth6809.asm):02364                     LDX   VARHERE
E025 308B             (    forth6809.asm):02365                     LEAX  D,X
E027 9F0A             (    forth6809.asm):02366                     STX   VARHERE
E029 39               (    forth6809.asm):02367                     RTS
                      (    forth6809.asm):02368         
                      (    forth6809.asm):02369         ; ------------------------------------------------------------
                      (    forth6809.asm):02370         ; HERE  ( -- addr )
                      (    forth6809.asm):02371         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02372         ; ------------------------------------------------------------
E02A DC08             (    forth6809.asm):02373         HEREW:      LDD   CODEHERE
E02C 3606             (    forth6809.asm):02374                     PSHU  D                 ; addr
E02E 39               (    forth6809.asm):02375                     RTS
                      (    forth6809.asm):02376         
                      (    forth6809.asm):02377         ; ------------------------------------------------------------
                      (    forth6809.asm):02378         ; VHERE  ( -- addr )
                      (    forth6809.asm):02379         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02380         ; ------------------------------------------------------------
E02F DC0A             (    forth6809.asm):02381         VHEREW:     LDD   VARHERE
E031 3606             (    forth6809.asm):02382                     PSHU  D                 ; addr
E033 39               (    forth6809.asm):02383                     RTS
                      (    forth6809.asm):02384         
                      (    forth6809.asm):02385         ; ------------------------------------------------------------
                      (    forth6809.asm):02386         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02387         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02388         ; ------------------------------------------------------------
E034 DC08             (    forth6809.asm):02389         PADW:       LDD   CODEHERE
E036 C30080           (    forth6809.asm):02390                     ADDD  #PADOFFSET
E039 3606             (    forth6809.asm):02391                     PSHU  D                 ; c-addr
E03B 39               (    forth6809.asm):02392                     RTS
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
                      (    forth6809.asm):02395         ; UNUSED  ( -- u )
                      (    forth6809.asm):02396         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02397         ; ------------------------------------------------------------
E03C CCB900           (    forth6809.asm):02398         UNUSEDW:    LDD   #CODETOP
E03F 9308             (    forth6809.asm):02399                     SUBD  CODEHERE
E041 3606             (    forth6809.asm):02400                     PSHU  D                 ; u
E043 39               (    forth6809.asm):02401                     RTS
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403         ; ------------------------------------------------------------
                      (    forth6809.asm):02404         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02405         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
E044 CC1FFF           (    forth6809.asm):02407         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E047 930A             (    forth6809.asm):02408                     SUBD  VARHERE
E049 3606             (    forth6809.asm):02409                     PSHU  D                 ; u
E04B 39               (    forth6809.asm):02410                     RTS
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412         ; ============================================================
                      (    forth6809.asm):02413         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02414         ; ============================================================
                      (    forth6809.asm):02415         ; ------------------------------------------------------------
                      (    forth6809.asm):02416         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02417         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02418         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02419         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02420         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02421         ;    Inputs:
                      (    forth6809.asm):02422         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02423         ;        name parsed from the input stream
                      (    forth6809.asm):02424         ;    Outputs:
                      (    forth6809.asm):02425         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02426         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02427         ; ------------------------------------------------------------
E04C CC0020           (    forth6809.asm):02428         HEADER:     LDD   #32
E04F 3606             (    forth6809.asm):02429                     PSHU  D
E051 BDE33D           (    forth6809.asm):02430                     JSR   WORDW
E054 3710             (    forth6809.asm):02431                     PULU  X                 ; c-addr of the name
E056 3706             (    forth6809.asm):02432                     PULU  D                 ; smudge flag in B
E058 A680             (    forth6809.asm):02433                     LDA   ,X+               ; name length, X = name text
E05A 3402             (    forth6809.asm):02434                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
E05C 5D               (    forth6809.asm):02435                     TSTB
E05D 2702             (    forth6809.asm):02436                     BEQ   HDNOSM
E05F 8A40             (    forth6809.asm):02437                     ORA   #$40
E061 109E06           (    forth6809.asm):02438         HDNOSM:     LDY   DPHERE
E064 3420             (    forth6809.asm):02439                     PSHS  Y                 ; 0,S = address of the new header
E066 A7A0             (    forth6809.asm):02440                     STA   ,Y+
E068 E662             (    forth6809.asm):02441                     LDB   2,S
E06A 2707             (    forth6809.asm):02442                     BEQ   HDNONM
E06C A680             (    forth6809.asm):02443         HDCPY:      LDA   ,X+
E06E A7A0             (    forth6809.asm):02444                     STA   ,Y+
E070 5A               (    forth6809.asm):02445                     DECB
E071 26F9             (    forth6809.asm):02446                     BNE   HDCPY
E073 DC04             (    forth6809.asm):02447         HDNONM:     LDD   LATEST
E075 EDA1             (    forth6809.asm):02448                     STD   ,Y++
E077 DC08             (    forth6809.asm):02449                     LDD   CODEHERE
E079 EDA1             (    forth6809.asm):02450                     STD   ,Y++
E07B 109F06           (    forth6809.asm):02451                     STY   DPHERE
E07E 3506             (    forth6809.asm):02452                     PULS  D
E080 DD04             (    forth6809.asm):02453                     STD   LATEST
E082 3261             (    forth6809.asm):02454                     LEAS  1,S
E084 39               (    forth6809.asm):02455                     RTS
                      (    forth6809.asm):02456         
                      (    forth6809.asm):02457         ; ============================================================
                      (    forth6809.asm):02458         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02459         ; ============================================================
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
                      (    forth6809.asm):02461         ; :  ( "name" -- )
                      (    forth6809.asm):02462         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02463         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02464         ; CSP and enter compile state.
                      (    forth6809.asm):02465         ; ------------------------------------------------------------
E085 CCFFFF           (    forth6809.asm):02466         COLONW:     LDD   #TRUEV
E088 3606             (    forth6809.asm):02467                     PSHU  D
E08A BDE04C           (    forth6809.asm):02468                     JSR   HEADER
E08D DC08             (    forth6809.asm):02469                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E08F DD29             (    forth6809.asm):02470                     STD   CURXT             ; See bugfix: COLONW.1
E091 1F30             (    forth6809.asm):02471                     TFR   U,D
E093 DD2B             (    forth6809.asm):02472                     STD   CSP
E095 CCFFFF           (    forth6809.asm):02473                     LDD   #-1
E098 DD00             (    forth6809.asm):02474                     STD   STATE
E09A 39               (    forth6809.asm):02475                     RTS
                      (    forth6809.asm):02476         
                      (    forth6809.asm):02477         ; ------------------------------------------------------------
                      (    forth6809.asm):02478         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02479         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02480         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02481         ; new word and return to interpret state.
                      (    forth6809.asm):02482         ; ------------------------------------------------------------
E09B CC0039           (    forth6809.asm):02483         SEMIW:      LDD   #RTSOPC
E09E 3606             (    forth6809.asm):02484                     PSHU  D
E0A0 BDE006           (    forth6809.asm):02485                     JSR   CCOMMA1
E0A3 1F30             (    forth6809.asm):02486                     TFR   U,D
E0A5 10932B           (    forth6809.asm):02487                     CMPD  CSP
E0A8 2703             (    forth6809.asm):02488                     BEQ   SEMIOK
E0AA BDE5EA           (    forth6809.asm):02489                     JSR   CFERR
E0AD 9E04             (    forth6809.asm):02490         SEMIOK:     LDX   LATEST
E0AF A684             (    forth6809.asm):02491                     LDA   ,X
E0B1 84BF             (    forth6809.asm):02492                     ANDA  #$BF
E0B3 A784             (    forth6809.asm):02493                     STA   ,X
E0B5 CC0000           (    forth6809.asm):02494                     LDD   #0
E0B8 DD00             (    forth6809.asm):02495                     STD   STATE
E0BA 39               (    forth6809.asm):02496                     RTS
                      (    forth6809.asm):02497         
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
                      (    forth6809.asm):02499         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02500         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02501         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02502         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02503         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02504         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02505         ; ------------------------------------------------------------
E0BB DC08             (    forth6809.asm):02506         NONAMEW:    LDD   CODEHERE
E0BD 3606             (    forth6809.asm):02507                     PSHU  D                 ; xt
E0BF DD29             (    forth6809.asm):02508                     STD   CURXT             ; See bugfix: NONAMEW.1
E0C1 1F30             (    forth6809.asm):02509                     TFR   U,D
E0C3 DD2B             (    forth6809.asm):02510                     STD   CSP
E0C5 CCFFFF           (    forth6809.asm):02511                     LDD   #-1
E0C8 DD00             (    forth6809.asm):02512                     STD   STATE
E0CA 39               (    forth6809.asm):02513                     RTS
                      (    forth6809.asm):02514         
                      (    forth6809.asm):02515         ; ------------------------------------------------------------
                      (    forth6809.asm):02516         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02517         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02518         ; BLDDOES
                      (    forth6809.asm):02519         ;    Inputs:
                      (    forth6809.asm):02520         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02521         ;    Outputs:
                      (    forth6809.asm):02522         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02523         ;    Registers: all changed.
                      (    forth6809.asm):02524         ; BLDSELF
                      (    forth6809.asm):02525         ;    Inputs:
                      (    forth6809.asm):02526         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02527         ;    Outputs:
                      (    forth6809.asm):02528         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02529         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02530         ;    Registers: all changed.
                      (    forth6809.asm):02531         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02532         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02533         ; ------------------------------------------------------------
E0CB 3406             (    forth6809.asm):02534         BLDDOES:    PSHS  D                 ; behaviour address
E0CD CC0000           (    forth6809.asm):02535                     LDD   #0
E0D0 3606             (    forth6809.asm):02536                     PSHU  D
E0D2 BDE04C           (    forth6809.asm):02537                     JSR   HEADER
E0D5 CCDF8F           (    forth6809.asm):02538                     LDD   #DODOES
E0D8 3606             (    forth6809.asm):02539                     PSHU  D
E0DA BDEA5A           (    forth6809.asm):02540                     JSR   CCALL
E0DD 3506             (    forth6809.asm):02541                     PULS  D
E0DF 3606             (    forth6809.asm):02542                     PSHU  D                 ; behaviour address
E0E1 BDDFFA           (    forth6809.asm):02543                     JSR   CODECOMMA
E0E4 39               (    forth6809.asm):02544                     RTS
                      (    forth6809.asm):02545         
E0E5 BDE0CB           (    forth6809.asm):02546         BLDSELF:    JSR   BLDDOES
E0E8 DC08             (    forth6809.asm):02547                     LDD   CODEHERE          ; PFA = the cell after this one
E0EA C30002           (    forth6809.asm):02548                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0ED 3606             (    forth6809.asm):02549                     PSHU  D
E0EF BDDFFA           (    forth6809.asm):02550                     JSR   CODECOMMA
E0F2 39               (    forth6809.asm):02551                     RTS
                      (    forth6809.asm):02552         
                      (    forth6809.asm):02553         ; ------------------------------------------------------------
                      (    forth6809.asm):02554         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02555         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02556         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02557         ; address in the code area, on the stack.
                      (    forth6809.asm):02558         ; ------------------------------------------------------------
E0F3 CCDF9A           (    forth6809.asm):02559         CREATEW:    LDD   #DOESRT0
E0F6 BDE0E5           (    forth6809.asm):02560                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E0F9 39               (    forth6809.asm):02561                     RTS
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563         ; ------------------------------------------------------------
                      (    forth6809.asm):02564         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02565         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02566         ; of the word being defined.
                      (    forth6809.asm):02567         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02568         ; ------------------------------------------------------------
E0FA CCDF9B           (    forth6809.asm):02569         DOESGTW:    LDD   #SETDOES
E0FD 3606             (    forth6809.asm):02570                     PSHU  D
E0FF BDEA5A           (    forth6809.asm):02571                     JSR   CCALL
E102 39               (    forth6809.asm):02572                     RTS
                      (    forth6809.asm):02573         
                      (    forth6809.asm):02574         ; ------------------------------------------------------------
                      (    forth6809.asm):02575         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02576         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02577         ; area, initialised to zero.
                      (    forth6809.asm):02578         ; ------------------------------------------------------------
E103 CC0000           (    forth6809.asm):02579         VARIABLEW:  LDD   #0
E106 3606             (    forth6809.asm):02580                     PSHU  D
E108 BDE04C           (    forth6809.asm):02581                     JSR   HEADER
E10B CCDF8F           (    forth6809.asm):02582                     LDD   #DODOES
E10E 3606             (    forth6809.asm):02583                     PSHU  D
E110 BDEA5A           (    forth6809.asm):02584                     JSR   CCALL
E113 CCDF9A           (    forth6809.asm):02585                     LDD   #DOESRT0
E116 3606             (    forth6809.asm):02586                     PSHU  D
E118 BDDFFA           (    forth6809.asm):02587                     JSR   CODECOMMA
E11B DC0A             (    forth6809.asm):02588                     LDD   VARHERE
E11D 3606             (    forth6809.asm):02589                     PSHU  D
E11F BDDFFA           (    forth6809.asm):02590                     JSR   CODECOMMA
E122 CC0000           (    forth6809.asm):02591                     LDD   #0
E125 9E0A             (    forth6809.asm):02592                     LDX   VARHERE
E127 ED81             (    forth6809.asm):02593                     STD   ,X++
E129 9F0A             (    forth6809.asm):02594                     STX   VARHERE
E12B 39               (    forth6809.asm):02595                     RTS
                      (    forth6809.asm):02596         
                      (    forth6809.asm):02597         ; ------------------------------------------------------------
                      (    forth6809.asm):02598         ; @  ( a-addr -- x )
                      (    forth6809.asm):02599         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02600         ; ------------------------------------------------------------
E12C 3710             (    forth6809.asm):02601         FETCHW:     PULU  X                 ; a-addr
E12E EC84             (    forth6809.asm):02602                     LDD   ,X
E130 3606             (    forth6809.asm):02603                     PSHU  D                 ; x
E132 39               (    forth6809.asm):02604                     RTS
                      (    forth6809.asm):02605         
                      (    forth6809.asm):02606         ; ------------------------------------------------------------
                      (    forth6809.asm):02607         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02608         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02609         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02610         ; ------------------------------------------------------------
E133 CCE12C           (    forth6809.asm):02611         CONSTANTW:  LDD   #FETCHW
E136 BDE0E5           (    forth6809.asm):02612                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E139 BDDFF4           (    forth6809.asm):02613                     JSR   COMMAW
E13C 39               (    forth6809.asm):02614                     RTS
                      (    forth6809.asm):02615         
                      (    forth6809.asm):02616         ; ------------------------------------------------------------
                      (    forth6809.asm):02617         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02618         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02619         ;    Inputs:
                      (    forth6809.asm):02620         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02621         ;    Outputs:
                      (    forth6809.asm):02622         ;        pfa replaced by the value
                      (    forth6809.asm):02623         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02624         ; ------------------------------------------------------------
E13D 3710             (    forth6809.asm):02625         DOVALUE:    PULU  X                 ; pfa
E13F EC84             (    forth6809.asm):02626                     LDD   ,X
E141 3606             (    forth6809.asm):02627                     PSHU  D                 ; x
E143 39               (    forth6809.asm):02628                     RTS
                      (    forth6809.asm):02629         
                      (    forth6809.asm):02630         ; ------------------------------------------------------------
                      (    forth6809.asm):02631         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02632         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02633         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02634         ; ------------------------------------------------------------
E144 CCE13D           (    forth6809.asm):02635         VALUEW:     LDD   #DOVALUE
E147 BDE0CB           (    forth6809.asm):02636                     JSR   BLDDOES
E14A DC0A             (    forth6809.asm):02637                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E14C 3606             (    forth6809.asm):02638                     PSHU  D                 ; See bugfix: VALUEW.1
E14E BDDFFA           (    forth6809.asm):02639                     JSR   CODECOMMA
E151 BDE00C           (    forth6809.asm):02640                     JSR   VCOMMAW           ; store x in the variable area
E154 39               (    forth6809.asm):02641                     RTS
                      (    forth6809.asm):02642         
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
                      (    forth6809.asm):02644         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02645         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02646         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02647         ; ------------------------------------------------------------
E155 CC0020           (    forth6809.asm):02648         TOW:        LDD   #32
E158 3606             (    forth6809.asm):02649                     PSHU  D
E15A BDE33D           (    forth6809.asm):02650                     JSR   WORDW
E15D BDE3AF           (    forth6809.asm):02651                     JSR   FINDW
E160 3706             (    forth6809.asm):02652                     PULU  D
E162 10830000         (    forth6809.asm):02653                     CMPD  #0
E166 260A             (    forth6809.asm):02654                     BNE   TOFOUND
E168 3706             (    forth6809.asm):02655                     PULU  D
E16A CCFFF3           (    forth6809.asm):02656                     LDD   #-13
E16D 3606             (    forth6809.asm):02657                     PSHU  D
E16F BDE61F           (    forth6809.asm):02658                     JSR   THROWW
E172 BDEB0C           (    forth6809.asm):02659         TOFOUND:    JSR   TOBODYW
E175 DC00             (    forth6809.asm):02660                     LDD   STATE
E177 270C             (    forth6809.asm):02661                     BEQ   TOIMMED
E179 BDEA67           (    forth6809.asm):02662                     JSR   LITERALW
E17C CCF307           (    forth6809.asm):02663                     LDD   #STOREW
E17F 3606             (    forth6809.asm):02664                     PSHU  D
E181 BDEA5A           (    forth6809.asm):02665                     JSR   CCALL
E184 39               (    forth6809.asm):02666                     RTS
E185 3710             (    forth6809.asm):02667         TOIMMED:    PULU  X                 ; a-addr of the value cell
E187 3706             (    forth6809.asm):02668                     PULU  D                 ; x
E189 ED84             (    forth6809.asm):02669                     STD   ,X
E18B 39               (    forth6809.asm):02670                     RTS
                      (    forth6809.asm):02671         
                      (    forth6809.asm):02672         ; ------------------------------------------------------------
                      (    forth6809.asm):02673         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02674         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02675         ; the variable area, initialised to zero.
                      (    forth6809.asm):02676         ; ------------------------------------------------------------
E18C                  (    forth6809.asm):02677         TWOVARIABLEW:
E18C CC0000           (    forth6809.asm):02678                     LDD   #0
E18F 3606             (    forth6809.asm):02679                     PSHU  D
E191 BDE04C           (    forth6809.asm):02680                     JSR   HEADER
E194 CCDF8F           (    forth6809.asm):02681                     LDD   #DODOES
E197 3606             (    forth6809.asm):02682                     PSHU  D
E199 BDEA5A           (    forth6809.asm):02683                     JSR   CCALL
E19C CCDF9A           (    forth6809.asm):02684                     LDD   #DOESRT0
E19F 3606             (    forth6809.asm):02685                     PSHU  D
E1A1 BDDFFA           (    forth6809.asm):02686                     JSR   CODECOMMA
E1A4 DC0A             (    forth6809.asm):02687                     LDD   VARHERE
E1A6 3606             (    forth6809.asm):02688                     PSHU  D
E1A8 BDDFFA           (    forth6809.asm):02689                     JSR   CODECOMMA
E1AB CC0000           (    forth6809.asm):02690                     LDD   #0
E1AE 9E0A             (    forth6809.asm):02691                     LDX   VARHERE
E1B0 ED81             (    forth6809.asm):02692                     STD   ,X++
E1B2 ED81             (    forth6809.asm):02693                     STD   ,X++
E1B4 9F0A             (    forth6809.asm):02694                     STX   VARHERE
E1B6 39               (    forth6809.asm):02695                     RTS
                      (    forth6809.asm):02696         
                      (    forth6809.asm):02697         ; ------------------------------------------------------------
                      (    forth6809.asm):02698         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02699         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02700         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02701         ; ------------------------------------------------------------
E1B7                  (    forth6809.asm):02702         TWOCONSTANTW:
E1B7 CCF326           (    forth6809.asm):02703                     LDD   #TWOFETCHW
E1BA BDE0E5           (    forth6809.asm):02704                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1BD 3706             (    forth6809.asm):02705                     PULU  D                 ; x2
E1BF DD1E             (    forth6809.asm):02706                     STD   MSCR
E1C1 DC1E             (    forth6809.asm):02707                     LDD   MSCR
E1C3 3606             (    forth6809.asm):02708                     PSHU  D
E1C5 BDDFF4           (    forth6809.asm):02709                     JSR   COMMAW            ; x2 -> lower address
E1C8 BDDFF4           (    forth6809.asm):02710                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1
E1CB 39               (    forth6809.asm):02711                     RTS
                      (    forth6809.asm):02712         
                      (    forth6809.asm):02713         ; ------------------------------------------------------------
                      (    forth6809.asm):02714         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02715         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):02716         ; the variable area.
                      (    forth6809.asm):02717         ; ------------------------------------------------------------
E1CC                  (    forth6809.asm):02718         BUFFERCOLONW:
E1CC 3706             (    forth6809.asm):02719                     PULU  D                 ; u
E1CE DD20             (    forth6809.asm):02720                     STD   MSCR2
E1D0 CC0000           (    forth6809.asm):02721                     LDD   #0
E1D3 3606             (    forth6809.asm):02722                     PSHU  D
E1D5 BDE04C           (    forth6809.asm):02723                     JSR   HEADER
E1D8 CCDF8F           (    forth6809.asm):02724                     LDD   #DODOES
E1DB 3606             (    forth6809.asm):02725                     PSHU  D
E1DD BDEA5A           (    forth6809.asm):02726                     JSR   CCALL
E1E0 CCDF9A           (    forth6809.asm):02727                     LDD   #DOESRT0
E1E3 3606             (    forth6809.asm):02728                     PSHU  D
E1E5 BDDFFA           (    forth6809.asm):02729                     JSR   CODECOMMA
E1E8 DC0A             (    forth6809.asm):02730                     LDD   VARHERE
E1EA 3606             (    forth6809.asm):02731                     PSHU  D
E1EC BDDFFA           (    forth6809.asm):02732                     JSR   CODECOMMA
E1EF DC20             (    forth6809.asm):02733                     LDD   MSCR2
E1F1 3606             (    forth6809.asm):02734                     PSHU  D
E1F3 BDE021           (    forth6809.asm):02735                     JSR   VALLOTW
E1F6 39               (    forth6809.asm):02736                     RTS
                      (    forth6809.asm):02737         
                      (    forth6809.asm):02738         ; ------------------------------------------------------------
                      (    forth6809.asm):02739         ; DEFER  ( "name" -- )
                      (    forth6809.asm):02740         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):02741         ; throws -21.
                      (    forth6809.asm):02742         ; ------------------------------------------------------------
E1F7 CCDFB6           (    forth6809.asm):02743         DEFERW:     LDD   #DODEFER
E1FA BDE0E5           (    forth6809.asm):02744                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1FD CCDFBE           (    forth6809.asm):02745                     LDD   #DOABORTUNDEF
E200 3606             (    forth6809.asm):02746                     PSHU  D
E202 BDDFF4           (    forth6809.asm):02747                     JSR   COMMAW
E205 39               (    forth6809.asm):02748                     RTS
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):02752         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):02753         ; ------------------------------------------------------------
E206                  (    forth6809.asm):02754         DEFERFETCHW:
E206 BDEB0C           (    forth6809.asm):02755                     JSR   TOBODYW
E209 3710             (    forth6809.asm):02756                     PULU  X                 ; body address
E20B EC84             (    forth6809.asm):02757                     LDD   ,X
E20D 3606             (    forth6809.asm):02758                     PSHU  D                 ; xt2
E20F 39               (    forth6809.asm):02759                     RTS
                      (    forth6809.asm):02760         
                      (    forth6809.asm):02761         ; ------------------------------------------------------------
                      (    forth6809.asm):02762         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):02763         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):02764         ; ------------------------------------------------------------
E210                  (    forth6809.asm):02765         DEFERSTOREW:
E210 BDEB0C           (    forth6809.asm):02766                     JSR   TOBODYW
E213 3710             (    forth6809.asm):02767                     PULU  X                 ; body address of xt1
E215 3706             (    forth6809.asm):02768                     PULU  D                 ; xt2
E217 ED84             (    forth6809.asm):02769                     STD   ,X
E219 39               (    forth6809.asm):02770                     RTS
                      (    forth6809.asm):02771         
                      (    forth6809.asm):02772         ; ------------------------------------------------------------
                      (    forth6809.asm):02773         ; IS  ( xt "name" -- )  IMMEDIATE
                      (    forth6809.asm):02774         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):02775         ; compile code to do so at run time. Error -13 if the name is not
                      (    forth6809.asm):02776         ; found.
                      (    forth6809.asm):02777         ; ------------------------------------------------------------
E21A CC0020           (    forth6809.asm):02778         ISW:        LDD   #32
E21D 3606             (    forth6809.asm):02779                     PSHU  D
E21F BDE33D           (    forth6809.asm):02780                     JSR   WORDW
E222 BDE3AF           (    forth6809.asm):02781                     JSR   FINDW
E225 3706             (    forth6809.asm):02782                     PULU  D
E227 10830000         (    forth6809.asm):02783                     CMPD  #0

E353 0A21             (    forth6809.asm):03334                     DEC   CNTREM
E355 2761             (    forth6809.asm):03335                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03336         
E357 0F22             (    forth6809.asm):03337         NQNOSIGN:   CLR   NUMNEG
E359 A684             (    forth6809.asm):03338                     LDA   ,X

                      (    forth6809.asm):03288         ; ============================================================
                      (    forth6809.asm):03289         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03290         ; ============================================================
                      (    forth6809.asm):03291                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03292         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03293         
                      (    forth6809.asm):03294         ; ------------------------------------------------------------
                      (    forth6809.asm):03295         ; KEY  ( -- char )
                      (    forth6809.asm):03296         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03297         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03298         ; ------------------------------------------------------------
E52B                  (    forth6809.asm):03299         KEYW:
                      (    forth6809.asm):03300         
E52B 7D0178           (    forth6809.asm):03301                     TST   RTSSTATE          ; Is throttling?
E52E 2703             (    forth6809.asm):03302                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03303         
                      (    forth6809.asm):03304                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E530 BDDD52           (    forth6809.asm):03305                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03306                                             ; by transmitting all chars.
                      (    forth6809.asm):03307         
E533                  (    forth6809.asm):03308         TRY_READ:
E533 BDDDBF           (    forth6809.asm):03309                     JSR   GETCHAR           ; Is char available in input buffer.
E536 25F3             (    forth6809.asm):03310                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03311                                             ; while still transmitting!
                      (    forth6809.asm):03312         
E538 1F89             (    forth6809.asm):03313                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E53A 4F               (    forth6809.asm):03314                     CLRA                    ; Clear MSB.
E53B 3606             (    forth6809.asm):03315                     PSHU  D                 ; char
                      (    forth6809.asm):03316         
E53D 39               (    forth6809.asm):03317                     RTS
                      (    forth6809.asm):03318         
                      (    forth6809.asm):03319         ; ------------------------------------------------------------
                      (    forth6809.asm):03320         ; KEY?  ( -- flag )
                      (    forth6809.asm):03321         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03322         ; ------------------------------------------------------------
E53E                  (    forth6809.asm):03323         KEYQW:
                      (    forth6809.asm):03324                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03325         
E53E B60176           (    forth6809.asm):03326                     LDA   INHEAD            ; Characters received?
E541 B10177           (    forth6809.asm):03327                     CMPA  INTAIL
                      (    forth6809.asm):03328         
                      (    forth6809.asm):03329                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03330         
E544 2606             (    forth6809.asm):03331                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03332         
E546 CC0000           (    forth6809.asm):03333                     LDD   #FALSEV           ; No! Return false result.
E549 3606             (    forth6809.asm):03334                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03335         
E54B 39               (    forth6809.asm):03336                     RTS
                      (    forth6809.asm):03337         
E54C                  (    forth6809.asm):03338         KQTRUE:
E54C CCFFFF           (    forth6809.asm):03339                     LDD   #TRUEV            ; Yes! Return true result.
E54F 3606             (    forth6809.asm):03340                     PSHU  D                 ; flag = true
E551 39               (    forth6809.asm):03341                     RTS
                      (    forth6809.asm):03342         
                      (    forth6809.asm):03343         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03344         
                      (    forth6809.asm):03345         ; ------------------------------------------------------------
                      (    forth6809.asm):03346         ; EMIT  ( char -- )
                      (    forth6809.asm):03347         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03348         ; discarded if the ring is full.
                      (    forth6809.asm):03349         ; ------------------------------------------------------------
E552                  (    forth6809.asm):03350         EMITW:
E552 3706             (    forth6809.asm):03351                     PULU  D                 ; char
E554 1F98             (    forth6809.asm):03352                     TFR   B,A
E556 BDDD74           (    forth6809.asm):03353                     JSR   PUTCHAR           ; Transmit char.
E559 39               (    forth6809.asm):03354                     RTS
                      (    forth6809.asm):03355         
                      (    forth6809.asm):03356                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03357         ; ------------------------------------------------------------
                      (    forth6809.asm):03358         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03359         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03360         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03361         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03362         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03363         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03364         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03365         ; follow.
                      (    forth6809.asm):03366         ; ------------------------------------------------------------
E55A                  (    forth6809.asm):03367         KEYW:
                      (    forth6809.asm):03368                     LDA   ACIASR
                      (    forth6809.asm):03369                     BITA  #SR_RDRF
                      (    forth6809.asm):03370                     BEQ   KWAIT
                      (    forth6809.asm):03371                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03372                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E55A                  (    forth6809.asm):03373         KWAIT:
E55A                  (    forth6809.asm):03374         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03375                     BITA  #SR_RDRF
                      (    forth6809.asm):03376                     BEQ   KSPIN
E55A                  (    forth6809.asm):03377         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03378                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03379                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03380                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03381                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03382                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03383                     BEQ   KGETCH
                      (    forth6809.asm):03384                     BITA  #SR_FE
                      (    forth6809.asm):03385                     BEQ   KXFE
                      (    forth6809.asm):03386                     INC   FECOUNT
E55A                  (    forth6809.asm):03387         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03388                     BEQ   KXOVRN
                      (    forth6809.asm):03389                     INC   OVRNCOUNT
E55A                  (    forth6809.asm):03390         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03391                     BEQ   KGETCH
                      (    forth6809.asm):03392                     INC   PECOUNT
E55A                  (    forth6809.asm):03393         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03394                     TFR   A,B
                      (    forth6809.asm):03395                     CLRA
                      (    forth6809.asm):03396                     PSHU  D                 ; char
                      (    forth6809.asm):03397                     RTS
                      (    forth6809.asm):03398         
                      (    forth6809.asm):03399         ; ------------------------------------------------------------
                      (    forth6809.asm):03400         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03401         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03402         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03403         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03404         ;    Inputs:
                      (    forth6809.asm):03405         ;        none
                      (    forth6809.asm):03406         ;    Outputs:
                      (    forth6809.asm):03407         ;        XON or XOFF transmitted
                      (    forth6809.asm):03408         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03409         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03410         ; ------------------------------------------------------------
E55A                  (    forth6809.asm):03411         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03412                     BRA   PUTXCH
E55A                  (    forth6809.asm):03413         PUTXON:     LDA   #XONCH
E55A                  (    forth6809.asm):03414         PUTXCH:     PSHS  A
E55A                  (    forth6809.asm):03415         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03416                     BITB  #SR_TDRE
                      (    forth6809.asm):03417                     BEQ   PXWT
                      (    forth6809.asm):03418                     PULS  A
                      (    forth6809.asm):03419                     STA   ACIADR
                      (    forth6809.asm):03420                     RTS
                      (    forth6809.asm):03421         
                      (    forth6809.asm):03422         ; ------------------------------------------------------------
                      (    forth6809.asm):03423         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03424         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03425         ; ------------------------------------------------------------
E55A                  (    forth6809.asm):03426         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03427                     BITA  #SR_RDRF
                      (    forth6809.asm):03428                     BEQ   KQFALSE
                      (    forth6809.asm):03429                     LDD   #TRUEV
                      (    forth6809.asm):03430                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03431                     RTS
E55A                  (    forth6809.asm):03432         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03433                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03434                     RTS
                      (    forth6809.asm):03435         
                      (    forth6809.asm):03436         ; ------------------------------------------------------------
                      (    forth6809.asm):03437         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03438         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03439         ; ------------------------------------------------------------
E55A                  (    forth6809.asm):03440         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03441                     STB   EMITCH
E55A                  (    forth6809.asm):03442         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03443                     BITA  #SR_TDRE
                      (    forth6809.asm):03444                     BEQ   EMITWT
                      (    forth6809.asm):03445                     LDA   EMITCH
                      (    forth6809.asm):03446                     STA   ACIADR
                      (    forth6809.asm):03447                     RTS
                      (    forth6809.asm):03448         
                      (    forth6809.asm):03449                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03450         
                      (    forth6809.asm):03451         ; ------------------------------------------------------------
                      (    forth6809.asm):03452         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03453         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03454         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03455         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03456         ; ------------------------------------------------------------
E55A 335E             (    forth6809.asm):03457         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E55C CC0000           (    forth6809.asm):03458                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E55F EDC4             (    forth6809.asm):03459                     STD   ,U
                      (    forth6809.asm):03460         
                      (    forth6809.asm):03461                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03462                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03463                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03464                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03465                                             ; stream this line's characters
                      (    forth6809.asm):03466                     JSR   PUTXON
                      (    forth6809.asm):03467                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03468         
E561 BDE52B           (    forth6809.asm):03469         ALOOP:      JSR   KEYW
E564 3706             (    forth6809.asm):03470                     PULU  D
E566 1F02             (    forth6809.asm):03471                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03472         
E568 C10D             (    forth6809.asm):03473                     CMPB  #13
E56A 274F             (    forth6809.asm):03474                     BEQ   ADONE
E56C C10A             (    forth6809.asm):03475                     CMPB  #10
E56E 27F1             (    forth6809.asm):03476                     BEQ   ALOOP
E570 C108             (    forth6809.asm):03477                     CMPB  #8
E572 2724             (    forth6809.asm):03478                     BEQ   ABKSP
E574 C17F             (    forth6809.asm):03479                     CMPB  #127
E576 2720             (    forth6809.asm):03480                     BEQ   ABKSP
                      (    forth6809.asm):03481         
E578 ECC4             (    forth6809.asm):03482                     LDD   ,U
E57A 10A342           (    forth6809.asm):03483                     CMPD  2,U
E57D 27E2             (    forth6809.asm):03484                     BEQ   ALOOP
                      (    forth6809.asm):03485         
E57F AE44             (    forth6809.asm):03486                     LDX   4,U
E581 308B             (    forth6809.asm):03487                     LEAX  D,X
E583 1F20             (    forth6809.asm):03488                     TFR   Y,D
E585 E784             (    forth6809.asm):03489                     STB   ,X
E587 ECC4             (    forth6809.asm):03490                     LDD   ,U
E589 C30001           (    forth6809.asm):03491                     ADDD  #1
E58C EDC4             (    forth6809.asm):03492                     STD   ,U
                      (    forth6809.asm):03493         
E58E 1F20             (    forth6809.asm):03494                     TFR   Y,D
E590 4F               (    forth6809.asm):03495                     CLRA
E591 3606             (    forth6809.asm):03496                     PSHU  D
E593 BDE552           (    forth6809.asm):03497                     JSR   EMITW
E596 20C9             (    forth6809.asm):03498                     BRA   ALOOP
                      (    forth6809.asm):03499         
E598 ECC4             (    forth6809.asm):03500         ABKSP:      LDD   ,U
E59A 27C5             (    forth6809.asm):03501                     BEQ   ALOOP
E59C 830001           (    forth6809.asm):03502                     SUBD  #1
E59F EDC4             (    forth6809.asm):03503                     STD   ,U
E5A1 CC0008           (    forth6809.asm):03504                     LDD   #8
E5A4 3606             (    forth6809.asm):03505                     PSHU  D
E5A6 BDE552           (    forth6809.asm):03506                     JSR   EMITW
E5A9 CC0020           (    forth6809.asm):03507                     LDD   #32
E5AC 3606             (    forth6809.asm):03508                     PSHU  D
E5AE BDE552           (    forth6809.asm):03509                     JSR   EMITW
E5B1 CC0008           (    forth6809.asm):03510                     LDD   #8
E5B4 3606             (    forth6809.asm):03511                     PSHU  D
E5B6 BDE552           (    forth6809.asm):03512                     JSR   EMITW
E5B9 20A6             (    forth6809.asm):03513                     BRA   ALOOP
                      (    forth6809.asm):03514         
E5BB                  (    forth6809.asm):03515         ADONE:
                      (    forth6809.asm):03516                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03517                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03518                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03519                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03520                                             ; with KEY never polled at all
                      (    forth6809.asm):03521                     JSR   PUTXOFF
                      (    forth6809.asm):03522                     ENDC                    ; <<<<<<<<<<
E5BB ECC4             (    forth6809.asm):03523                     LDD   ,U
E5BD ED44             (    forth6809.asm):03524                     STD   4,U               ; +n2
E5BF 3344             (    forth6809.asm):03525                     LEAU  4,U
E5C1 39               (    forth6809.asm):03526                     RTS
                      (    forth6809.asm):03527         
                      (    forth6809.asm):03528         ; ------------------------------------------------------------
                      (    forth6809.asm):03529         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03530         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03531         ; ------------------------------------------------------------
E5C2 BDE55A           (    forth6809.asm):03532         EXPECTW:    JSR   ACCEPTW
E5C5 3706             (    forth6809.asm):03533                     PULU  D
E5C7 DD52             (    forth6809.asm):03534                     STD   SPAN
E5C9 39               (    forth6809.asm):03535                     RTS
                      (    forth6809.asm):03536         
                      (    forth6809.asm):03537         ; ------------------------------------------------------------
                      (    forth6809.asm):03538         ; QUERY  ( -- )
                      (    forth6809.asm):03539         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03540         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03541         ; to 0 and >IN to 0.
                      (    forth6809.asm):03542         ; ------------------------------------------------------------
E5CA 8E0106           (    forth6809.asm):03543         QUERYW:     LDX   #TIBBUF
E5CD 3610             (    forth6809.asm):03544                     PSHU  X
E5CF CC0050           (    forth6809.asm):03545                     LDD   #TIBBUFL
E5D2 3606             (    forth6809.asm):03546                     PSHU  D
E5D4 BDE55A           (    forth6809.asm):03547                     JSR   ACCEPTW
E5D7 3706             (    forth6809.asm):03548                     PULU  D
E5D9 DD12             (    forth6809.asm):03549                     STD   NTIB
E5DB DD4E             (    forth6809.asm):03550                     STD   SRCLEN
E5DD CC0106           (    forth6809.asm):03551                     LDD   #TIBBUF
E5E0 DD4C             (    forth6809.asm):03552                     STD   SRCADDR
E5E2 CC0000           (    forth6809.asm):03553                     LDD   #0
E5E5 DD50             (    forth6809.asm):03554                     STD   SRCID
E5E7 DD10             (    forth6809.asm):03555                     STD   TOIN
E5E9 39               (    forth6809.asm):03556                     RTS
                      (    forth6809.asm):03557         
                      (    forth6809.asm):03558         ; ============================================================
                      (    forth6809.asm):03559         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03560         ; ============================================================
                      (    forth6809.asm):03561         ; ------------------------------------------------------------
                      (    forth6809.asm):03562         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03563         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03564         ; one expected.
                      (    forth6809.asm):03565         ; CFERR
                      (    forth6809.asm):03566         ;    Inputs:
                      (    forth6809.asm):03567         ;        none
                      (    forth6809.asm):03568         ;    Outputs:
                      (    forth6809.asm):03569         ;        does not return (THROW -22)
                      (    forth6809.asm):03570         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03571         ; ------------------------------------------------------------
E5EA CCFFEA           (    forth6809.asm):03572         CFERR:      LDD   #-22
E5ED 3606             (    forth6809.asm):03573                     PSHU  D                 ; -22
E5EF BDE61F           (    forth6809.asm):03574                     JSR   THROWW
E5F2 39               (    forth6809.asm):03575                     RTS
                      (    forth6809.asm):03576         
                      (    forth6809.asm):03577         ; ------------------------------------------------------------
                      (    forth6809.asm):03578         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03579         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03580         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03581         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03582         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03583         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03584         ; ------------------------------------------------------------
E5F3 3710             (    forth6809.asm):03585         CATCHW:     PULU  X                 ; xt
E5F5 DC0C             (    forth6809.asm):03586                     LDD   HANDLER
E5F7 3406             (    forth6809.asm):03587                     PSHS  D
E5F9 3440             (    forth6809.asm):03588                     PSHS  U
                      (    forth6809.asm):03589                     ; Save the input source specification.
                      (    forth6809.asm):03590                     ; See bugfix: CATCHW.1
E5FB DC4C             (    forth6809.asm):03591                     LDD   SRCADDR
E5FD 3406             (    forth6809.asm):03592                     PSHS  D
E5FF DC4E             (    forth6809.asm):03593                     LDD   SRCLEN
E601 3406             (    forth6809.asm):03594                     PSHS  D
E603 DC50             (    forth6809.asm):03595                     LDD   SRCID
E605 3406             (    forth6809.asm):03596                     PSHS  D
E607 DC10             (    forth6809.asm):03597                     LDD   TOIN
E609 3406             (    forth6809.asm):03598                     PSHS  D
E60B 1F40             (    forth6809.asm):03599                     TFR   S,D
E60D DD0C             (    forth6809.asm):03600                     STD   HANDLER
                      (    forth6809.asm):03601         
E60F AD84             (    forth6809.asm):03602                     JSR   ,X
                      (    forth6809.asm):03603         
E611 3268             (    forth6809.asm):03604                     LEAS  8,S               ; drop saved input source
E613 3262             (    forth6809.asm):03605                     LEAS  2,S               ; saved U
E615 3506             (    forth6809.asm):03606                     PULS  D
E617 DD0C             (    forth6809.asm):03607                     STD   HANDLER
E619 CC0000           (    forth6809.asm):03608                     LDD   #0
E61C 3606             (    forth6809.asm):03609                     PSHU  D                 ; 0 = no exception
E61E 39               (    forth6809.asm):03610                     RTS
                      (    forth6809.asm):03611         
                      (    forth6809.asm):03612         ; ------------------------------------------------------------
                      (    forth6809.asm):03613         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03614         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03615         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03616         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03617         ; ------------------------------------------------------------
E61F 3706             (    forth6809.asm):03618         THROWW:     PULU  D                 ; n
E621 10830000         (    forth6809.asm):03619                     CMPD  #0
E625 2725             (    forth6809.asm):03620                     BEQ   THDONE
                      (    forth6809.asm):03621         
E627 DD0E             (    forth6809.asm):03622                     STD   THROWN
E629 9E0C             (    forth6809.asm):03623                     LDX   HANDLER
E62B 2720             (    forth6809.asm):03624                     BEQ   THUNCAU
                      (    forth6809.asm):03625         
E62D 1F14             (    forth6809.asm):03626                     TFR   X,S
E62F 3506             (    forth6809.asm):03627                     PULS  D                 ; restore input source saved by CATCH
E631 DD10             (    forth6809.asm):03628                     STD   TOIN
E633 3506             (    forth6809.asm):03629                     PULS  D
E635 DD50             (    forth6809.asm):03630                     STD   SRCID
E637 3506             (    forth6809.asm):03631                     PULS  D
E639 DD4E             (    forth6809.asm):03632                     STD   SRCLEN
E63B 3506             (    forth6809.asm):03633                     PULS  D
E63D DD4C             (    forth6809.asm):03634                     STD   SRCADDR
E63F 3506             (    forth6809.asm):03635                     PULS  D
E641 1F03             (    forth6809.asm):03636                     TFR   D,U
E643 3506             (    forth6809.asm):03637                     PULS  D
E645 DD0C             (    forth6809.asm):03638                     STD   HANDLER
                      (    forth6809.asm):03639         
E647 DC0E             (    forth6809.asm):03640                     LDD   THROWN
E649 3606             (    forth6809.asm):03641                     PSHU  D
E64B 39               (    forth6809.asm):03642                     RTS
E64C 39               (    forth6809.asm):03643         THDONE:     RTS
                      (    forth6809.asm):03644         
                      (    forth6809.asm):03645                     ; No CATCH is active: leave n on the stack and ABORT.
E64D DC0E             (    forth6809.asm):03646         THUNCAU:    LDD   THROWN
E64F 3606             (    forth6809.asm):03647                     PSHU  D
E651 7EDEC3           (    forth6809.asm):03648                     JMP   ABORT
                      (    forth6809.asm):03649         
                      (    forth6809.asm):03650         ; ============================================================
                      (    forth6809.asm):03651         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03652         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03653         ; ============================================================
                      (    forth6809.asm):03654         ; ------------------------------------------------------------
                      (    forth6809.asm):03655         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03656         ; location.
                      (    forth6809.asm):03657         ; PATCH   ( target location -- )
                      (    forth6809.asm):03658         ;    Inputs:
                      (    forth6809.asm):03659         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03660         ;    Outputs:
                      (    forth6809.asm):03661         ;        the cell at location holds target - location
                      (    forth6809.asm):03662         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03663         ; ------------------------------------------------------------
E654 3710             (    forth6809.asm):03664         PATCH:      PULU  X                 ; location
E656 3706             (    forth6809.asm):03665                     PULU  D                 ; target
E658 3410             (    forth6809.asm):03666                     PSHS  X
E65A A3E1             (    forth6809.asm):03667                     SUBD  ,S++              ; target - location
E65C ED84             (    forth6809.asm):03668                     STD   ,X
E65E 39               (    forth6809.asm):03669                     RTS
                      (    forth6809.asm):03670         
                      (    forth6809.asm):03671         ; ------------------------------------------------------------
                      (    forth6809.asm):03672         ; IF  ( C: -- orig )
                      (    forth6809.asm):03673         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03674         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03675         ; ------------------------------------------------------------
E65F CCDF70           (    forth6809.asm):03676         IFW:        LDD   #ZBRANCH
E662 3606             (    forth6809.asm):03677                     PSHU  D
E664 BDEA5A           (    forth6809.asm):03678                     JSR   CCALL
E667 CC0000           (    forth6809.asm):03679                     LDD   #0
E66A 3606             (    forth6809.asm):03680                     PSHU  D
E66C BDDFFA           (    forth6809.asm):03681                     JSR   CODECOMMA
E66F DC08             (    forth6809.asm):03682                     LDD   CODEHERE
E671 830002           (    forth6809.asm):03683                     SUBD  #2
E674 3606             (    forth6809.asm):03684                     PSHU  D                 ; orig
E676 CC0001           (    forth6809.asm):03685                     LDD   #TAGFWD
E679 3606             (    forth6809.asm):03686                     PSHU  D
E67B 39               (    forth6809.asm):03687                     RTS
                      (    forth6809.asm):03688         
                      (    forth6809.asm):03689         ; ------------------------------------------------------------
                      (    forth6809.asm):03690         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03691         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03692         ; operand to jump to the current code address.
                      (    forth6809.asm):03693         ; ------------------------------------------------------------
E67C 3706             (    forth6809.asm):03694         THENW:      PULU  D
E67E 10830001         (    forth6809.asm):03695                     CMPD  #TAGFWD
E682 2703             (    forth6809.asm):03696                     BEQ   THOK
E684 BDE5EA           (    forth6809.asm):03697                     JSR   CFERR
E687 3710             (    forth6809.asm):03698         THOK:       PULU  X                 ; orig
E689 DC08             (    forth6809.asm):03699                     LDD   CODEHERE
E68B 3606             (    forth6809.asm):03700                     PSHU  D
E68D 3610             (    forth6809.asm):03701                     PSHU  X
E68F BDE654           (    forth6809.asm):03702                     JSR   PATCH
E692 39               (    forth6809.asm):03703                     RTS
                      (    forth6809.asm):03704         
                      (    forth6809.asm):03705         ; ------------------------------------------------------------
                      (    forth6809.asm):03706         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03707         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03708         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
E693 3706             (    forth6809.asm):03710         ELSEW:      PULU  D
E695 10830001         (    forth6809.asm):03711                     CMPD  #TAGFWD
E699 2703             (    forth6809.asm):03712                     BEQ   ELOK
E69B BDE5EA           (    forth6809.asm):03713                     JSR   CFERR
E69E 3706             (    forth6809.asm):03714         ELOK:       PULU  D                 ; orig1
E6A0 3406             (    forth6809.asm):03715                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E6A2 CCDF86           (    forth6809.asm):03716                     LDD   #BRANCH
E6A5 3606             (    forth6809.asm):03717                     PSHU  D
E6A7 BDEA5A           (    forth6809.asm):03718                     JSR   CCALL
E6AA CC0000           (    forth6809.asm):03719                     LDD   #0
E6AD 3606             (    forth6809.asm):03720                     PSHU  D
E6AF BDDFFA           (    forth6809.asm):03721                     JSR   CODECOMMA
E6B2 DC08             (    forth6809.asm):03722                     LDD   CODEHERE
E6B4 3606             (    forth6809.asm):03723                     PSHU  D
E6B6 3506             (    forth6809.asm):03724                     PULS  D                 ; orig1
E6B8 3606             (    forth6809.asm):03725                     PSHU  D
E6BA BDE654           (    forth6809.asm):03726                     JSR   PATCH
E6BD DC08             (    forth6809.asm):03727                     LDD   CODEHERE
E6BF 830002           (    forth6809.asm):03728                     SUBD  #2
E6C2 3606             (    forth6809.asm):03729                     PSHU  D                 ; orig2
E6C4 CC0001           (    forth6809.asm):03730                     LDD   #TAGFWD
E6C7 3606             (    forth6809.asm):03731                     PSHU  D
E6C9 39               (    forth6809.asm):03732                     RTS
                      (    forth6809.asm):03733         
                      (    forth6809.asm):03734         ; ------------------------------------------------------------
                      (    forth6809.asm):03735         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03736         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03737         ; stack.
                      (    forth6809.asm):03738         ; ------------------------------------------------------------
E6CA DC08             (    forth6809.asm):03739         BEGINW:     LDD   CODEHERE
E6CC 3606             (    forth6809.asm):03740                     PSHU  D                 ; dest
E6CE CC0002           (    forth6809.asm):03741                     LDD   #TAGBACK
E6D1 3606             (    forth6809.asm):03742                     PSHU  D
E6D3 39               (    forth6809.asm):03743                     RTS
                      (    forth6809.asm):03744         
                      (    forth6809.asm):03745         ; ------------------------------------------------------------
                      (    forth6809.asm):03746         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03747         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
E6D4 3706             (    forth6809.asm):03749         UNTILW:     PULU  D
E6D6 10830002         (    forth6809.asm):03750                     CMPD  #TAGBACK
E6DA 2703             (    forth6809.asm):03751                     BEQ   UNOK
E6DC BDE5EA           (    forth6809.asm):03752                     JSR   CFERR
E6DF 3706             (    forth6809.asm):03753         UNOK:       PULU  D                 ; dest
E6E1 3606             (    forth6809.asm):03754                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E6E3 CCDF70           (    forth6809.asm):03755                     LDD   #ZBRANCH
E6E6 3606             (    forth6809.asm):03756                     PSHU  D
E6E8 BDEA5A           (    forth6809.asm):03757                     JSR   CCALL
E6EB CC0000           (    forth6809.asm):03758                     LDD   #0
E6EE 3606             (    forth6809.asm):03759                     PSHU  D
E6F0 BDDFFA           (    forth6809.asm):03760                     JSR   CODECOMMA
E6F3 DC08             (    forth6809.asm):03761                     LDD   CODEHERE
E6F5 830002           (    forth6809.asm):03762                     SUBD  #2
E6F8 3606             (    forth6809.asm):03763                     PSHU  D                 ; location; the parked dest is beneath
E6FA BDE654           (    forth6809.asm):03764                     JSR   PATCH
E6FD 39               (    forth6809.asm):03765                     RTS
                      (    forth6809.asm):03766         
                      (    forth6809.asm):03767         ; ------------------------------------------------------------
                      (    forth6809.asm):03768         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03769         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03770         ; ------------------------------------------------------------
E6FE 3706             (    forth6809.asm):03771         AGAINW:     PULU  D
E700 10830002         (    forth6809.asm):03772                     CMPD  #TAGBACK
E704 2703             (    forth6809.asm):03773                     BEQ   AGOK
E706 BDE5EA           (    forth6809.asm):03774                     JSR   CFERR
E709 3706             (    forth6809.asm):03775         AGOK:       PULU  D                 ; dest
E70B 3606             (    forth6809.asm):03776                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E70D CCDF86           (    forth6809.asm):03777                     LDD   #BRANCH
E710 3606             (    forth6809.asm):03778                     PSHU  D
E712 BDEA5A           (    forth6809.asm):03779                     JSR   CCALL
E715 CC0000           (    forth6809.asm):03780                     LDD   #0
E718 3606             (    forth6809.asm):03781                     PSHU  D
E71A BDDFFA           (    forth6809.asm):03782                     JSR   CODECOMMA
E71D DC08             (    forth6809.asm):03783                     LDD   CODEHERE
E71F 830002           (    forth6809.asm):03784                     SUBD  #2
E722 3606             (    forth6809.asm):03785                     PSHU  D                 ; location; the parked dest is beneath
E724 BDE654           (    forth6809.asm):03786                     JSR   PATCH
E727 39               (    forth6809.asm):03787                     RTS
                      (    forth6809.asm):03788         
                      (    forth6809.asm):03789         ; ------------------------------------------------------------
                      (    forth6809.asm):03790         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03791         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03792         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03793         ; ------------------------------------------------------------
E728 CCDF70           (    forth6809.asm):03794         WHILEW:     LDD   #ZBRANCH
E72B 3606             (    forth6809.asm):03795                     PSHU  D
E72D BDEA5A           (    forth6809.asm):03796                     JSR   CCALL
E730 CC0000           (    forth6809.asm):03797                     LDD   #0
E733 3606             (    forth6809.asm):03798                     PSHU  D
E735 BDDFFA           (    forth6809.asm):03799                     JSR   CODECOMMA
E738 DC08             (    forth6809.asm):03800                     LDD   CODEHERE
E73A 830002           (    forth6809.asm):03801                     SUBD  #2
E73D 3606             (    forth6809.asm):03802                     PSHU  D                 ; orig
E73F CC0001           (    forth6809.asm):03803                     LDD   #TAGFWD
E742 3606             (    forth6809.asm):03804                     PSHU  D
E744 39               (    forth6809.asm):03805                     RTS
                      (    forth6809.asm):03806         
                      (    forth6809.asm):03807         ; ------------------------------------------------------------
                      (    forth6809.asm):03808         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03809         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03810         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03811         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03812         ; ------------------------------------------------------------
E745 3706             (    forth6809.asm):03813         REPEATW:    PULU  D
E747 10830001         (    forth6809.asm):03814                     CMPD  #TAGFWD
E74B 2703             (    forth6809.asm):03815                     BEQ   RPOK1
E74D BDE5EA           (    forth6809.asm):03816                     JSR   CFERR
E750 3710             (    forth6809.asm):03817         RPOK1:      PULU  X                 ; orig
E752 3410             (    forth6809.asm):03818                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03819         
                      (    forth6809.asm):03820                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03821                     ; See bugfix: REPEATW.1
E754 3040             (    forth6809.asm):03822                     LEAX  0,U               ; scan from top of control stack
E756 9F20             (    forth6809.asm):03823                     STX   MSCR2             ; MSCR2 = base of scan region
E758 9F24             (    forth6809.asm):03824                     STX   MSCR4             ; MSCR4 = scan pointer
E75A DC24             (    forth6809.asm):03825         RPSCAN:     LDD   MSCR4
E75C 10932B           (    forth6809.asm):03826                     CMPD  CSP
E75F 2603             (    forth6809.asm):03827                     BNE   RPSCANOK
E761 BDE5EA           (    forth6809.asm):03828                     JSR   CFERR             ; no matching BEGIN
E764 9E24             (    forth6809.asm):03829         RPSCANOK:   LDX   MSCR4
E766 EC84             (    forth6809.asm):03830                     LDD   ,X
E768 10830002         (    forth6809.asm):03831                     CMPD  #TAGBACK
E76C 2712             (    forth6809.asm):03832                     BEQ   RPFOUND
E76E 10830001         (    forth6809.asm):03833                     CMPD  #TAGFWD
E772 2703             (    forth6809.asm):03834                     BEQ   RPSKIP
E774 BDE5EA           (    forth6809.asm):03835                     JSR   CFERR             ; anything else is a genuine mismatch
E777 DC24             (    forth6809.asm):03836         RPSKIP:     LDD   MSCR4
E779 C30004           (    forth6809.asm):03837                     ADDD  #4
E77C DD24             (    forth6809.asm):03838                     STD   MSCR4
E77E 20DA             (    forth6809.asm):03839                     BRA   RPSCAN
E780 9E24             (    forth6809.asm):03840         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E782 EC02             (    forth6809.asm):03841                     LDD   2,X               ; dest = BEGIN's address
E784 3406             (    forth6809.asm):03842                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03843         
                      (    forth6809.asm):03844                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03845                     ; bytes, highest word first.
E786 DC24             (    forth6809.asm):03846                     LDD   MSCR4
E788 9320             (    forth6809.asm):03847                     SUBD  MSCR2
E78A DD22             (    forth6809.asm):03848                     STD   MSCR3             ; MSCR3 = bytes to shift
E78C 2715             (    forth6809.asm):03849                     BEQ   RPSHIFTDONE
E78E DC22             (    forth6809.asm):03850         RPSHIFT:    LDD   MSCR3
E790 830002           (    forth6809.asm):03851                     SUBD  #2
E793 DD22             (    forth6809.asm):03852                     STD   MSCR3
E795 9E20             (    forth6809.asm):03853                     LDX   MSCR2
E797 308B             (    forth6809.asm):03854                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E799 EC84             (    forth6809.asm):03855                     LDD   ,X
E79B 3004             (    forth6809.asm):03856                     LEAX  4,X
E79D ED84             (    forth6809.asm):03857                     STD   ,X                ; copy one word 4 bytes higher
E79F DC22             (    forth6809.asm):03858                     LDD   MSCR3
E7A1 26EB             (    forth6809.asm):03859                     BNE   RPSHIFT
E7A3                  (    forth6809.asm):03860         RPSHIFTDONE:
E7A3 9E20             (    forth6809.asm):03861                     LDX   MSCR2
E7A5 3004             (    forth6809.asm):03862                     LEAX  4,X
E7A7 1F13             (    forth6809.asm):03863                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03864         
E7A9 CCDF86           (    forth6809.asm):03865                     LDD   #BRANCH
E7AC 3606             (    forth6809.asm):03866                     PSHU  D
E7AE BDEA5A           (    forth6809.asm):03867                     JSR   CCALL
E7B1 CC0000           (    forth6809.asm):03868                     LDD   #0
E7B4 3606             (    forth6809.asm):03869                     PSHU  D
E7B6 BDDFFA           (    forth6809.asm):03870                     JSR   CODECOMMA
E7B9 EC60             (    forth6809.asm):03871                     LDD   0,S               ; target = BEGIN's address
E7BB 3606             (    forth6809.asm):03872                     PSHU  D
E7BD DC08             (    forth6809.asm):03873                     LDD   CODEHERE
E7BF 830002           (    forth6809.asm):03874                     SUBD  #2                ; location = the operand just compiled
E7C2 3606             (    forth6809.asm):03875                     PSHU  D
E7C4 BDE654           (    forth6809.asm):03876                     JSR   PATCH
E7C7 DC08             (    forth6809.asm):03877                     LDD   CODEHERE
E7C9 3606             (    forth6809.asm):03878                     PSHU  D
E7CB EC62             (    forth6809.asm):03879                     LDD   2,S               ; orig
E7CD 3606             (    forth6809.asm):03880                     PSHU  D
E7CF BDE654           (    forth6809.asm):03881                     JSR   PATCH
E7D2 3264             (    forth6809.asm):03882                     LEAS  4,S               ; drop the frame
E7D4 39               (    forth6809.asm):03883                     RTS
                      (    forth6809.asm):03884         
                      (    forth6809.asm):03885         ; ------------------------------------------------------------
                      (    forth6809.asm):03886         ; RECURSE  ( -- )
                      (    forth6809.asm):03887         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03888         ; the xt held in CURXT.
                      (    forth6809.asm):03889         ; ------------------------------------------------------------
E7D5 DC29             (    forth6809.asm):03890         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E7D7 3606             (    forth6809.asm):03891                     PSHU  D                 ; See bugfix: RECURSEW.1
E7D9 BDEA5A           (    forth6809.asm):03892                     JSR   CCALL
E7DC 39               (    forth6809.asm):03893                     RTS
                      (    forth6809.asm):03894         
                      (    forth6809.asm):03895         ; ------------------------------------------------------------
                      (    forth6809.asm):03896         ; DO  ( C: -- dest )
                      (    forth6809.asm):03897         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03898         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03899         ; ------------------------------------------------------------
E7DD CCE7EF           (    forth6809.asm):03900         DOW:        LDD   #DOSETUP
E7E0 3606             (    forth6809.asm):03901                     PSHU  D
E7E2 BDEA5A           (    forth6809.asm):03902                     JSR   CCALL
E7E5 DC08             (    forth6809.asm):03903                     LDD   CODEHERE
E7E7 3606             (    forth6809.asm):03904                     PSHU  D                 ; dest
E7E9 CC0003           (    forth6809.asm):03905                     LDD   #TAGDO
E7EC 3606             (    forth6809.asm):03906                     PSHU  D
E7EE 39               (    forth6809.asm):03907                     RTS
                      (    forth6809.asm):03908         
                      (    forth6809.asm):03909         ; ------------------------------------------------------------
                      (    forth6809.asm):03910         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03911         ; return address.
                      (    forth6809.asm):03912         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03913         ;    Inputs:
                      (    forth6809.asm):03914         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03915         ;    Outputs:
                      (    forth6809.asm):03916         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03917         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03918         ; ------------------------------------------------------------
E7EF 3706             (    forth6809.asm):03919         DOSETUP:    PULU  D                 ; index
E7F1 DD1E             (    forth6809.asm):03920                     STD   MSCR
E7F3 3706             (    forth6809.asm):03921                     PULU  D                 ; limit
E7F5 DD20             (    forth6809.asm):03922                     STD   MSCR2
E7F7 3510             (    forth6809.asm):03923                     PULS  X
E7F9 CC0000           (    forth6809.asm):03924                     LDD   #0
E7FC 3406             (    forth6809.asm):03925                     PSHS  D
E7FE DC20             (    forth6809.asm):03926                     LDD   MSCR2
E800 3406             (    forth6809.asm):03927                     PSHS  D
E802 DC1E             (    forth6809.asm):03928                     LDD   MSCR
E804 3406             (    forth6809.asm):03929                     PSHS  D
E806 3410             (    forth6809.asm):03930                     PSHS  X
E808 39               (    forth6809.asm):03931                     RTS
                      (    forth6809.asm):03932         
                      (    forth6809.asm):03933         ; ------------------------------------------------------------
                      (    forth6809.asm):03934         ; I  ( -- n )
                      (    forth6809.asm):03935         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):03936         ; address).
                      (    forth6809.asm):03937         ; ------------------------------------------------------------
E809 EC62             (    forth6809.asm):03938         IW:         LDD   2,S               ; n. See bugfix: IW.1
E80B 3606             (    forth6809.asm):03939                     PSHU  D
E80D 39               (    forth6809.asm):03940                     RTS
                      (    forth6809.asm):03941         
                      (    forth6809.asm):03942         ; ------------------------------------------------------------
                      (    forth6809.asm):03943         ; J  ( -- n )
                      (    forth6809.asm):03944         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):03945         ; address and the inner loop frame).
                      (    forth6809.asm):03946         ; ------------------------------------------------------------
E80E EC68             (    forth6809.asm):03947         JW:         LDD   8,S               ; n. See bugfix: JW.1
E810 3606             (    forth6809.asm):03948                     PSHU  D
E812 39               (    forth6809.asm):03949                     RTS
                      (    forth6809.asm):03950         
                      (    forth6809.asm):03951         ; ------------------------------------------------------------
                      (    forth6809.asm):03952         ; LEAVE  ( -- )
                      (    forth6809.asm):03953         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):03954         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):03955         ; ------------------------------------------------------------
E813 CCFFFF           (    forth6809.asm):03956         LEAVEW:     LDD   #TRUEV            ; true
E816 ED66             (    forth6809.asm):03957                     STD   6,S               ; See bugfix: LEAVEW.1
E818 39               (    forth6809.asm):03958                     RTS
                      (    forth6809.asm):03959         
                      (    forth6809.asm):03960         ; ------------------------------------------------------------
                      (    forth6809.asm):03961         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):03962         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):03963         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):03964         ; ------------------------------------------------------------
E819 3706             (    forth6809.asm):03965         LOOPW:      PULU  D
E81B 10830003         (    forth6809.asm):03966                     CMPD  #TAGDO
E81F 2703             (    forth6809.asm):03967                     BEQ   LOOPOK
E821 BDE5EA           (    forth6809.asm):03968                     JSR   CFERR
E824 3706             (    forth6809.asm):03969         LOOPOK:     PULU  D                 ; dest
E826 3606             (    forth6809.asm):03970                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E828 CCE858           (    forth6809.asm):03971                     LDD   #DOTEST
E82B 3606             (    forth6809.asm):03972                     PSHU  D
E82D BDEA5A           (    forth6809.asm):03973                     JSR   CCALL
E830 CC0000           (    forth6809.asm):03974                     LDD   #0
E833 3606             (    forth6809.asm):03975                     PSHU  D
E835 BDDFFA           (    forth6809.asm):03976                     JSR   CODECOMMA
E838 DC08             (    forth6809.asm):03977                     LDD   CODEHERE
E83A 830002           (    forth6809.asm):03978                     SUBD  #2
E83D 3606             (    forth6809.asm):03979                     PSHU  D                 ; location; the parked dest is beneath
E83F BDE654           (    forth6809.asm):03980                     JSR   PATCH
                      (    forth6809.asm):03981         
E842 ECC4             (    forth6809.asm):03982                     LDD   ,U
E844 10830007         (    forth6809.asm):03983                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E848 260D             (    forth6809.asm):03984                     BNE   LOOPDONE
E84A 3706             (    forth6809.asm):03985                     PULU  D
E84C 3710             (    forth6809.asm):03986                     PULU  X                 ; ?DO skip operand
E84E DC08             (    forth6809.asm):03987                     LDD   CODEHERE
E850 3606             (    forth6809.asm):03988                     PSHU  D
E852 3610             (    forth6809.asm):03989                     PSHU  X
E854 BDE654           (    forth6809.asm):03990                     JSR   PATCH
E857 39               (    forth6809.asm):03991         LOOPDONE:   RTS
                      (    forth6809.asm):03992         
                      (    forth6809.asm):03993         ; ------------------------------------------------------------
                      (    forth6809.asm):03994         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):03995         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):03996         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):03997         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):03998         ; DOTEST
                      (    forth6809.asm):03999         ;    Inputs:
                      (    forth6809.asm):04000         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04001         ;        first)
                      (    forth6809.asm):04002         ;    Outputs:
                      (    forth6809.asm):04003         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04004         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04005         ; ------------------------------------------------------------
E858 EC66             (    forth6809.asm):04006         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E85A 2615             (    forth6809.asm):04007                     BNE   DTEXIT            ; set: exit
E85C EC62             (    forth6809.asm):04008                     LDD   2,S               ; index
E85E C30001           (    forth6809.asm):04009                     ADDD  #1
E861 ED62             (    forth6809.asm):04010                     STD   2,S
E863 10A364           (    forth6809.asm):04011                     CMPD  4,S               ; limit
E866 2709             (    forth6809.asm):04012                     BEQ   DTEXIT
E868 3510             (    forth6809.asm):04013                     PULS  X                 ; X = branch operand address
E86A EC84             (    forth6809.asm):04014                     LDD   ,X
E86C 308B             (    forth6809.asm):04015                     LEAX  D,X
E86E 3410             (    forth6809.asm):04016                     PSHS  X                 ; return to loop start
E870 39               (    forth6809.asm):04017                     RTS
E871 3510             (    forth6809.asm):04018         DTEXIT:     PULS  X
E873 3002             (    forth6809.asm):04019                     LEAX  2,X               ; skip the branch operand
E875 3266             (    forth6809.asm):04020                     LEAS  6,S               ; discard the loop frame
E877 3410             (    forth6809.asm):04021                     PSHS  X
E879 39               (    forth6809.asm):04022                     RTS
                      (    forth6809.asm):04023         
                      (    forth6809.asm):04024         ; ------------------------------------------------------------
                      (    forth6809.asm):04025         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):04026         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):04027         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04028         ; ------------------------------------------------------------
E87A 3706             (    forth6809.asm):04029         PLUSLOOPW:  PULU  D
E87C 10830003         (    forth6809.asm):04030                     CMPD  #TAGDO
E880 2703             (    forth6809.asm):04031                     BEQ   PLOOPOK
E882 BDE5EA           (    forth6809.asm):04032                     JSR   CFERR
E885 3706             (    forth6809.asm):04033         PLOOPOK:    PULU  D                 ; dest
E887 3606             (    forth6809.asm):04034                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E889 CCE8B9           (    forth6809.asm):04035                     LDD   #DOPLUSTEST
E88C 3606             (    forth6809.asm):04036                     PSHU  D
E88E BDEA5A           (    forth6809.asm):04037                     JSR   CCALL
E891 CC0000           (    forth6809.asm):04038                     LDD   #0
E894 3606             (    forth6809.asm):04039                     PSHU  D
E896 BDDFFA           (    forth6809.asm):04040                     JSR   CODECOMMA
E899 DC08             (    forth6809.asm):04041                     LDD   CODEHERE
E89B 830002           (    forth6809.asm):04042                     SUBD  #2
E89E 3606             (    forth6809.asm):04043                     PSHU  D                 ; location; the parked dest is beneath
E8A0 BDE654           (    forth6809.asm):04044                     JSR   PATCH
                      (    forth6809.asm):04045         
E8A3 ECC4             (    forth6809.asm):04046                     LDD   ,U
E8A5 10830007         (    forth6809.asm):04047                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
E8A9 260D             (    forth6809.asm):04048                     BNE   PLOOPDONE
E8AB 3706             (    forth6809.asm):04049                     PULU  D
E8AD 3710             (    forth6809.asm):04050                     PULU  X                 ; ?DO skip operand
E8AF DC08             (    forth6809.asm):04051                     LDD   CODEHERE
E8B1 3606             (    forth6809.asm):04052                     PSHU  D
E8B3 3610             (    forth6809.asm):04053                     PSHU  X
E8B5 BDE654           (    forth6809.asm):04054                     JSR   PATCH
E8B8 39               (    forth6809.asm):04055         PLOOPDONE:  RTS
                      (    forth6809.asm):04056         
                      (    forth6809.asm):04057         ; ------------------------------------------------------------
                      (    forth6809.asm):04058         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04059         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04060         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04061         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04062         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04063         ;    Inputs:
                      (    forth6809.asm):04064         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04065         ;    Outputs:
                      (    forth6809.asm):04066         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04067         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04068         ;        scratch.
                      (    forth6809.asm):04069         ; ------------------------------------------------------------
E8B9 3706             (    forth6809.asm):04070         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E8BB DD1E             (    forth6809.asm):04071                     STD   MSCR              ; MSCR = step
E8BD EC66             (    forth6809.asm):04072                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E8BF 262D             (    forth6809.asm):04073                     BNE   DPTEXIT           ; set: exit
E8C1 EC62             (    forth6809.asm):04074                     LDD   2,S               ; old index
E8C3 A364             (    forth6809.asm):04075                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E8C5 DD20             (    forth6809.asm):04076                     STD   MSCR2
E8C7 EC62             (    forth6809.asm):04077                     LDD   2,S
E8C9 D31E             (    forth6809.asm):04078                     ADDD  MSCR              ; new_index = old_index + step
E8CB ED62             (    forth6809.asm):04079                     STD   2,S
E8CD A364             (    forth6809.asm):04080                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E8CF DD22             (    forth6809.asm):04081                     STD   MSCR3
                      (    forth6809.asm):04082                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04083                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04084                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E8D1 DC1E             (    forth6809.asm):04085                     LDD   MSCR              ; reload the step to test its sign
E8D3 2B09             (    forth6809.asm):04086                     BMI   DPNEG
E8D5 DC22             (    forth6809.asm):04087         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E8D7 109320           (    forth6809.asm):04088                     CMPD  MSCR2
E8DA 2512             (    forth6809.asm):04089                     BLO   DPTEXIT
E8DC 2007             (    forth6809.asm):04090                     BRA   DPCONT
E8DE DC22             (    forth6809.asm):04091         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E8E0 109320           (    forth6809.asm):04092                     CMPD  MSCR2
E8E3 2209             (    forth6809.asm):04093                     BHI   DPTEXIT
E8E5 3510             (    forth6809.asm):04094         DPCONT:     PULS  X                 ; X = branch operand address
E8E7 EC84             (    forth6809.asm):04095                     LDD   ,X
E8E9 308B             (    forth6809.asm):04096                     LEAX  D,X
E8EB 3410             (    forth6809.asm):04097                     PSHS  X

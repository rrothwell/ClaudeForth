                      (    forth6809.asm):00530         
                      (    forth6809.asm):00531         ; ------------------------------------------------------------
                      (    forth6809.asm):00532         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00533         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00534         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00535         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00536         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00537         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00538         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00539         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00540         ;
                      (    forth6809.asm):00541         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00542         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00543         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00544         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00545         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00546         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00547         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00548         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00549         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00550         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00551         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00552         ; ------------------------------------------------------------
                      (    forth6809.asm):00553                  ORG   $0100
0100                  (    forth6809.asm):00554         MVCNT      RMB   2
0102                  (    forth6809.asm):00555         MVDST      RMB   2
0104                  (    forth6809.asm):00556         MVSRC      RMB   2
     0100             (    forth6809.asm):00557         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00558         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00559         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00560         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00561         
                      (    forth6809.asm):00562         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00563         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00564                  ORG USROMSTRT
                      (    forth6809.asm):00565         
                      (    forth6809.asm):00566         ; ============================================================
                      (    forth6809.asm):00567         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00568         ;
                      (    forth6809.asm):00569         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00570         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00571         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00572         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00573         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00574         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00575         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00576         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00577         ; this existed - UNITTESTS=1 removes it entirely and this block
                      (    forth6809.asm):00578         ; reverts to exactly that padding, computed automatically below
                      (    forth6809.asm):00579         ; via the ROM label rather than a fixed byte count, so it's
                      (    forth6809.asm):00580         ; correct either way without needing to be hand-adjusted.
                      (    forth6809.asm):00581         ;
                      (    forth6809.asm):00582         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00583         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00584         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00585         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00586         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00587         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00588         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00589         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00590         ;
                      (    forth6809.asm):00591         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00592         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00593         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00594         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00595         ; ============================================================
     0001             (    forth6809.asm):00596         UNITTESTS EQU 1   ; 0 = included (matches this file's established
                      (    forth6809.asm):00597                           ; IFEQ convention, e.g. SERIALPOLL); 1 = excluded
                      (    forth6809.asm):00598                           ; entirely, reverting to plain FILL padding.
                      (    forth6809.asm):00599         
                      (    forth6809.asm):00600                  IFEQ  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00601         
C100                  (    forth6809.asm):00602         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
C100                  (    forth6809.asm):00603         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
C100                  (    forth6809.asm):00604         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
C100                  (    forth6809.asm):00605         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00606         
C100                  (    forth6809.asm):00607         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00608                                       ; under test, to prove an operation
                      (    forth6809.asm):00609                                       ; doesn't disturb what's beneath it
C100                  (    forth6809.asm):00610         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00611                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00612                                       ; that only appears to pass due to a
                      (    forth6809.asm):00613                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00614                                       ; caught rather than masked
                      (    forth6809.asm):00615         
                      (    forth6809.asm):00616         ; ------------------------------------------------------------
                      (    forth6809.asm):00617         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00618         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00619         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00620         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00621         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00622         TSTREPORT: PULU  D
                      (    forth6809.asm):00623                    STD   TSTFLAG
                      (    forth6809.asm):00624                    JSR   COUNT
                      (    forth6809.asm):00625                    JSR   TYPE
                      (    forth6809.asm):00626                    LDD   TSTFLAG
                      (    forth6809.asm):00627                    BEQ   TSTFAILR
                      (    forth6809.asm):00628                    LDD   #TSTOKMSG
                      (    forth6809.asm):00629                    PSHU  D
                      (    forth6809.asm):00630                    LDD   #TSTOKMSGL
                      (    forth6809.asm):00631                    PSHU  D
                      (    forth6809.asm):00632                    BRA   TSTPRINT
C100                  (    forth6809.asm):00633         TSTFAILR:  LDD   #TSTFAILMSG
                      (    forth6809.asm):00634                    PSHU  D
                      (    forth6809.asm):00635                    LDD   #TSTFAILMSGL
                      (    forth6809.asm):00636                    PSHU  D
C100                  (    forth6809.asm):00637         TSTPRINT:  JSR   TYPE
                      (    forth6809.asm):00638                    JSR   CRW
                      (    forth6809.asm):00639                    RTS
                      (    forth6809.asm):00640         
C100                  (    forth6809.asm):00641         TSTOKMSG:    FCC " OK"
C100                  (    forth6809.asm):00642         TSTOKMSGL    EQU  *-TSTOKMSG
C100                  (    forth6809.asm):00643         TSTFAILMSG:  FCC " FAIL"
C100                  (    forth6809.asm):00644         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00645         
                      (    forth6809.asm):00646         ; ------------------------------------------------------------
                      (    forth6809.asm):00647         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00648         ; here as they're written.
                      (    forth6809.asm):00649         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00650         TSTRUNNER: JSR   TSTSTACK
                      (    forth6809.asm):00651                    RTS
                      (    forth6809.asm):00652         
                      (    forth6809.asm):00653         ; ------------------------------------------------------------
                      (    forth6809.asm):00654         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):00655         ; they're written.
                      (    forth6809.asm):00656         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00657         TSTSTACK:  JSR   TSTDUP
                      (    forth6809.asm):00658                    RTS
                      (    forth6809.asm):00659         
                      (    forth6809.asm):00660         ; ------------------------------------------------------------
                      (    forth6809.asm):00661         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00662         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00663         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00664         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00665         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00666         ; pushes that set the test up).
                      (    forth6809.asm):00667         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00668         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00669         
                      (    forth6809.asm):00670                    LDD   #TSTGUARD
                      (    forth6809.asm):00671                    PSHU  D
                      (    forth6809.asm):00672                    LDD   #TSTVAL1
                      (    forth6809.asm):00673                    PSHU  D
                      (    forth6809.asm):00674                    STU   TSTUB4
                      (    forth6809.asm):00675         
                      (    forth6809.asm):00676                    JSR   DUP
                      (    forth6809.asm):00677         
                      (    forth6809.asm):00678                    STU   TSTUAF
                      (    forth6809.asm):00679         
                      (    forth6809.asm):00680                    PULU  D
                      (    forth6809.asm):00681                    CMPD  #TSTVAL1
                      (    forth6809.asm):00682                    BNE   TDFAIL
                      (    forth6809.asm):00683                    PULU  D
                      (    forth6809.asm):00684                    CMPD  #TSTVAL1
                      (    forth6809.asm):00685                    BNE   TDFAIL
                      (    forth6809.asm):00686                    PULU  D
                      (    forth6809.asm):00687                    CMPD  #TSTGUARD
                      (    forth6809.asm):00688                    BNE   TDFAIL
                      (    forth6809.asm):00689         
                      (    forth6809.asm):00690                    LDD   TSTUB4
                      (    forth6809.asm):00691                    SUBD  TSTUAF
                      (    forth6809.asm):00692                    CMPD  #2
                      (    forth6809.asm):00693                    BNE   TDFAIL
                      (    forth6809.asm):00694         
                      (    forth6809.asm):00695                    LDD   #TRUEV
                      (    forth6809.asm):00696                    BRA   TDDONE
C100                  (    forth6809.asm):00697         TDFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):00698         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00699                    PSHU  X
                      (    forth6809.asm):00700                    PSHU  D
                      (    forth6809.asm):00701                    JSR   TSTREPORT
                      (    forth6809.asm):00702         
                      (    forth6809.asm):00703                    LDU   TSTU0
                      (    forth6809.asm):00704                    RTS
                      (    forth6809.asm):00705         
C100                  (    forth6809.asm):00706         TSTDUPNAME: FCB  6
                      (    forth6809.asm):00707                     FCC  "TSTDUP"
                      (    forth6809.asm):00708         
                      (    forth6809.asm):00709                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00710         
C100                  (    forth6809.asm):00711         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00712                  FILL $FF,BASEDICT-ROM

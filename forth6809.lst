                      (    forth6809.asm):00722                              ; GLOBALS page is now
                      (    forth6809.asm):00723                              ; fully packed bar 1: 255 of 256 bytes used, 1 free.
                      (    forth6809.asm):00724         
     00FF             (    forth6809.asm):00725         GLOBALS_USED EQU 255  ; total bytes used, of 256 available - nearly fully packed
                      (    forth6809.asm):00726         
                      (    forth6809.asm):00727         ; ------------------------------------------------------------
                      (    forth6809.asm):00728         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00729         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00730         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00731         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00732         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00733         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00734         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00735         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00736         ;
                      (    forth6809.asm):00737         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00738         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00739         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00740         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00741         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00742         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00743         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00744         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00745         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00746         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00747         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00748         ; ------------------------------------------------------------
                      (    forth6809.asm):00749                  ORG   $0100
0100                  (    forth6809.asm):00750         MVCNT    RMB   2
0102                  (    forth6809.asm):00751         MVDST    RMB   2
0104                  (    forth6809.asm):00752         MVSRC    RMB   2
     0100             (    forth6809.asm):00753         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00754         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00755         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00756         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00757         
                      (    forth6809.asm):00758         ; ------------------------------------------------------------
                      (    forth6809.asm):00759         ; Ring buffers for serial communications.
                      (    forth6809.asm):00760         ; One for input, one for output.
                      (    forth6809.asm):00761         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00762         ; The tricks are not used.
                      (    forth6809.asm):00763         ; ------------------------------------------------------------
                      (    forth6809.asm):00764                     ORG   SERBUFCTL    ; $176.
                      (    forth6809.asm):00765         
0176                  (    forth6809.asm):00766         INHEAD      RMB  1
0177                  (    forth6809.asm):00767         INTAIL      RMB  1
                      (    forth6809.asm):00768         ; RTSSTATE -> INREQUEST ?
0178                  (    forth6809.asm):00769         RTSSTATE   RMB  1  ; $00 = RTS Low (Clear), $FF = RTS High (Throttle) 
                      (    forth6809.asm):00770         
0179                  (    forth6809.asm):00771         OUTHEAD     RMB  1
017A                  (    forth6809.asm):00772         OUTTAIL     RMB  1
017B                  (    forth6809.asm):00773         OUTACTIVITY RMB  1  ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00774         
017C                  (    forth6809.asm):00775         FECOUNT     RMB  1  ; framing-error count, incremented by IRQH (interrupt
                      (    forth6809.asm):00776                             ; build) or by polling KEY (polling build - see below)
017D                  (    forth6809.asm):00777         OVRNCOUNT   RMB  1  ; overrun count, same as above
017E                  (    forth6809.asm):00778         PECOUNT     RMB  1  ; parity-error count, same as above
017F                  (    forth6809.asm):00779         POLLREADYCNT RMB 1  ; polling build only: counts every KEY call that found
                      (    forth6809.asm):00780                             ; RDRF already set on its very first check, before
                      (    forth6809.asm):00781                             ; spinning at all - i.e. a character was already
                      (    forth6809.asm):00782                             ; sitting queued when we came back to poll for it.
                      (    forth6809.asm):00783                             ; A high count relative to total characters received
                      (    forth6809.asm):00784                             ; is evidence the host is running ahead of what the
                      (    forth6809.asm):00785                             ; 6809 has actually consumed (a transport-buffered
                      (    forth6809.asm):00786                             ; backlog), distinct from a genuine ACIA overrun
                      (    forth6809.asm):00787                             ; (which OVRNCOUNT would show instead) - last free
                      (    forth6809.asm):00788                             ; byte in this block, right before SERBUF's 64-byte
                      (    forth6809.asm):00789                             ; alignment at $0180.
                      (    forth6809.asm):00790         
                      (    forth6809.asm):00791                     ORG   SERBUF    ; $180, a 64 byte boundary.
                      (    forth6809.asm):00792         
                      (    forth6809.asm):00793                     ALIGN 64       ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00794         INBUF       RMB INBUFSZ     ; Receive circular queue buffer
                      (    forth6809.asm):00795         
                      (    forth6809.asm):00796                     ALIGN 64       ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00797         OUTBUF      RMB OUTBUFSZ    ; Transmit circular queue buffer
                      (    forth6809.asm):00798         
                      (    forth6809.asm):00799         ; ------------------------------------------------------------
                      (    forth6809.asm):00800         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00801         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00802         ; ------------------------------------------------------------
                      (    forth6809.asm):00803                  ORG USROMSTRT
                      (    forth6809.asm):00804         
                      (    forth6809.asm):00805                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00806         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00807                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00808                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00809                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00810                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00811                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00812                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00813                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00814                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00815                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00816                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00817                           ; choice is made, not what including it does.
                      (    forth6809.asm):00818                    ENDC
                      (    forth6809.asm):00819         
                      (    forth6809.asm):00820                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00821         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00822                    ENDC
                      (    forth6809.asm):00823         
                      (    forth6809.asm):00824                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00825         
                      (    forth6809.asm):00826         ; ------------------------------------------------------------
                      (    forth6809.asm):00827         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00828         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00829         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00830         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00831         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00832         ; ------------------------------------------------------------
                      (    forth6809.asm):00833                  INCLUDE unit_tests.asm
                      (    forth6809.asm):00834         
                      (    forth6809.asm):00835                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00836         
C100                  (    forth6809.asm):00837         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00838                  FILL $FF,BASEDICT-ROM

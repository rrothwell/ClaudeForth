                      (    forth6809.asm):01819         
DDF8 F6017A           (    forth6809.asm):01820                     LDB   OUTTAIL           ; Check if chars are available.
DDFB F10179           (    forth6809.asm):01821                     CMPB  OUTHEAD
DDFE 2707             (    forth6809.asm):01822                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):01823         
DE00 86B5             (    forth6809.asm):01824                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.

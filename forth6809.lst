                      (    forth6809.asm):08104         ; ============================================================
                      (    forth6809.asm):08105         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):08106         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):08107         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):08108         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):08109         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):08110         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):08111         ; ============================================================
                      (    forth6809.asm):08112         ; ------------------------------------------------------------
                      (    forth6809.asm):08113         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):08114         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):08115         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):08116         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):08117         ; - no indirection, no value cell.
                      (    forth6809.asm):08118         ;
                      (    forth6809.asm):08119         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):08120         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):08121         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):08122         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):08123         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):08124         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):08125         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):08126         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):08127         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):08128         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):08129         ; ------------------------------------------------------------
FED7 CCFFFF           (    forth6809.asm):08130         TRUEBODY:  LDD   #$FFFF
FEDA 3606             (    forth6809.asm):08131                    PSHU  D
FEDC 39               (    forth6809.asm):08132                    RTS
                      (    forth6809.asm):08133         
FEDD CC0000           (    forth6809.asm):08134         FALSEBODY: LDD   #$0000
FEE0 3606             (    forth6809.asm):08135                    PSHU  D
FEE2 39               (    forth6809.asm):08136                    RTS
                      (    forth6809.asm):08137         
                      (    forth6809.asm):08138         ; ------------------------------------------------------------
                      (    forth6809.asm):08139         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):08140         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):08141         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):08142         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):08143         ; ------------------------------------------------------------
FEE3 CC0001           (    forth6809.asm):08144         ONEBODY:   LDD   #1
FEE6 3606             (    forth6809.asm):08145                    PSHU  D
FEE8 39               (    forth6809.asm):08146                    RTS
                      (    forth6809.asm):08147         
FEE9 CCFFFF           (    forth6809.asm):08148         MONEBODY:  LDD   #-1
FEEC 3606             (    forth6809.asm):08149                    PSHU  D
FEEE 39               (    forth6809.asm):08150                    RTS
                      (    forth6809.asm):08151         
FEEF CC0002           (    forth6809.asm):08152         TWOBODY:   LDD   #2
FEF2 3606             (    forth6809.asm):08153                    PSHU  D
FEF4 39               (    forth6809.asm):08154                    RTS
                      (    forth6809.asm):08155         
FEF5 CCFFFE           (    forth6809.asm):08156         MTWOBODY:  LDD   #-2
FEF8 3606             (    forth6809.asm):08157                    PSHU  D
FEFA 39               (    forth6809.asm):08158                    RTS
                      (    forth6809.asm):08159         
                      (    forth6809.asm):08160         ; Verify no collision with init code,
                      (    forth6809.asm):08161         ; value should match ORG INITCODE.

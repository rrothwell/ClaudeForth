                      (    forth6809.asm):03655         
E62E CC0000           (    forth6809.asm):03656                     LDD   #FALSEV           ; No! Return false result.
E631 3606             (    forth6809.asm):03657                     PSHU  D
                      (    forth6809.asm):03658         
E633 39               (    forth6809.asm):03659                     RTS
                      (    forth6809.asm):03660         
E634                  (    forth6809.asm):03661         KQTRUE:     
E634 CCFFFF           (    forth6809.asm):03662                     LDD   #TRUEV            ; Yes! Return true result.
E637 3606             (    forth6809.asm):03663                     PSHU  D                 ; Push 16-bit cell to Stack (U)
E639 39               (    forth6809.asm):03664                     RTS
                      (    forth6809.asm):03665         ; ------------------------------------------------------------

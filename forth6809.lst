FB72 3706             (    forth6809.asm):07282                   PULU D
FB74 DDF1             (    forth6809.asm):07283                   STD  ENVADDR
FB76 8EFC09           (    forth6809.asm):07284                   LDX  #ENVTABLE
FB79 EC84             (    forth6809.asm):07285         ENVLOOP:  LDD  ,X
FB7B 10830000         (    forth6809.asm):07286                   CMPD #0
FB7F 272B             (    forth6809.asm):07287                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):07288                                     ; the double-cell table (below) before
                      (    forth6809.asm):07289                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):07290                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):07291                                     ; turn - both are double-cell values per
                      (    forth6809.asm):07292                                     ; their own ANS data type, which this
                      (    forth6809.asm):07293                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):07294                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):07295                                     ; represent correctly.
FB81 3410             (    forth6809.asm):07296                   PSHS X          ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):07297                                     ; internal scratch (LDX CMPA1, then LDA
                      (    forth6809.asm):07298                                     ; ,X+ advancing through the comparison),
                      (    forth6809.asm):07299                                     ; clobbering whatever the caller had there.
                      (    forth6809.asm):07300                                     ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):07301                                     ; current table entry after COMPAREW
                      (    forth6809.asm):07302                                     ; returns, both for ENVFOUND's own LDD 4,X
                      (    forth6809.asm):07303                                     ; and for advancing to the next entry -
                      (    forth6809.asm):07304                                     ; without saving it first, a successful
                      (    forth6809.asm):07305                                     ; match left X sitting just past the
                      (    forth6809.asm):07306                                     ; matched string's own text (for
                      (    forth6809.asm):07307                                     ; "/COUNTED-STRING", 15 characters, that
                      (    forth6809.asm):07308                                     ; lands exactly at the start of the next
                      (    forth6809.asm):07309                                     ; entry's string, "MAX-N") - so ENVFOUND
                      (    forth6809.asm):07310                                     ; read the "value" field from inside the
                      (    forth6809.asm):07311                                     ; NEXT entry's own string text instead of
                      (    forth6809.asm):07312                                     ; the real value. Confirmed via MAME: this
                      (    forth6809.asm):07313                                     ; exact mechanism produces $4E4D precisely
                      (    forth6809.asm):07314                                     ; - the bytes 'N' ($4E) and 'M' ($4D, the
                      (    forth6809.asm):07315                                     ; start of "MAX-U") sitting 4 bytes into
                      (    forth6809.asm):07316                                     ; "MAX-N", read as one cell.

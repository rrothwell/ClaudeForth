                      (    forth6809.asm):13286         ; TSTREPLSUBS1 - unit test for REPLACES and SUBSTITUTE together
                      (    forth6809.asm):13287         ; (can only be meaningfully tested together - SUBSTITUTE depends
                      (    forth6809.asm):13288         ; on a prior REPLACES registration). Registers "X"->"Z", then
                      (    forth6809.asm):13289         ; runs the template "%%A%X%B%Y%" through SUBSTITUTE - covering
                      (    forth6809.asm):13290         ; three of the four documented cases in one pass: "%%" collapses
                      (    forth6809.asm):13291         ; to a single '%', "%X%" (a registered name) gets replaced
                      (    forth6809.asm):13292         ; (count incremented), and "%Y%" (not registered) passes through
                      (    forth6809.asm):13293         ; unchanged, delimiters included. Expected result ("%AZB%Y%",
                      (    forth6809.asm):13294         ; count=1) independently simulated in Python against the actual
                      (    forth6809.asm):13295         ; traced algorithm before writing this test, not hand-derived
                      (    forth6809.asm):13296         ; and hoped correct - see TSTREPLSUBS2 for the fourth case
                      (    forth6809.asm):13297         ; (unpaired trailing '%'), tested separately for clearer failure
                      (    forth6809.asm):13298         ; diagnosis.
                      (    forth6809.asm):13299         ; ------------------------------------------------------------

                      (    forth6809.asm):16085                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):16086                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):16087                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):16088                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):16089                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):16090                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):16091                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):16092                   ; high cell.
E5C3 0D22             (    forth6809.asm):16093                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):16094                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):16095                   LDD   UDLO
E5C9 43               (    forth6809.asm):16096                   COMA
E5CA 53               (    forth6809.asm):16097                   COMB
E5CB C30001           (    forth6809.asm):16098                   ADDD  #1
E5CE DD76             (    forth6809.asm):16099                   STD   UDLO
E5D0 3401             (    forth6809.asm):16100                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):16101                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):16102                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):16103                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):16104                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):16105                                      ; silently overwrote the real carry here
                      (    forth6809.asm):16106                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):16107                                      ; making the high-cell increment run
                      (    forth6809.asm):16108                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):16109                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):16110                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):16111                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):16112                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):16113                                      ; matching "always increment" rather than
                      (    forth6809.asm):16114                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):16115                   LDD   UDHI
E5D4 43               (    forth6809.asm):16116                   COMA
E5D5 53               (    forth6809.asm):16117                   COMB
E5D6 3501             (    forth6809.asm):16118                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):16119                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):16120                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):16121                                      ; when there's no carry - the complemented
                      (    forth6809.asm):16122                                      ; value was computed in D but never
                      (    forth6809.asm):16123                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):16124                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):16125                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):16126                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):16127                                      ; was always seen as set, so this branch
                      (    forth6809.asm):16128                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):16129                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):16130                                      ; alone would have made this second,
                      (    forth6809.asm):16131                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):16132                                      ; only past the "+1", never past the
                      (    forth6809.asm):16133                                      ; store itself - the store always runs,
                      (    forth6809.asm):16134                                      ; either way.
E5DA C30001           (    forth6809.asm):16135                   ADDD  #1
E5DD DD74             (    forth6809.asm):16136         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):16137         
E5DF                  (    forth6809.asm):16138         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):16139                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):16140                   LDX   CADDR
E5E1 E684             (    forth6809.asm):16141                   LDB   ,X
E5E3 5A               (    forth6809.asm):16142                   DECB
E5E4 3001             (    forth6809.asm):16143                   LEAX  1,X
E5E6 A685             (    forth6809.asm):16144                   LDA   B,X
E5E8 812E             (    forth6809.asm):16145                   CMPA  #'.'

                      (    forth6809.asm):12087         
                      (    forth6809.asm):12088                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):12089                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):12090                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):12091                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):12092                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):12093                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):12094                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):12095                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):12096                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):12097                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):12098                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):12099                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):12100                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):12101                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):12102                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):12103                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):12104                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):12105                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):12106                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):12107         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):12108                    BEQ  UEDONE
F87D A680             (    forth6809.asm):12109                    LDA  ,X+
F87F 8125             (    forth6809.asm):12110                    CMPA #'%'
F881 2604             (    forth6809.asm):12111                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):12112                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):12113                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):12114                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):12115                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):12116                                   ; the same string correctly, since this runs
                      (    forth6809.asm):12117                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):12118         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):12119                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):12120                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):12121                    SUBD #1
F88E DDA9             (    forth6809.asm):12122                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):12123                    BRA  UELOOP
F892 1F20             (    forth6809.asm):12124         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):12125                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):12126                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):12127                                   ; required return values, and separately,
                      (    forth6809.asm):12128                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):12129                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):12130                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):12131                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):12132                                   ; characters. Now computed directly as the
                      (    forth6809.asm):12133                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):12134                                   ; original destination address (UEDST) -
                      (    forth6809.asm):12135                                   ; correct regardless of how many characters
                      (    forth6809.asm):12136                                   ; were doubled, since it's derived from
                      (    forth6809.asm):12137                                   ; where writing actually stopped rather than
                      (    forth6809.asm):12138                                   ; incremented alongside it.
F898 DCAB             (    forth6809.asm):12139                    LDD  UEDST
F89A 3606             (    forth6809.asm):12140                    PSHU D         ; push c-addr2 (destination address)
F89C DCAD             (    forth6809.asm):12141                    LDD  UEOUTLEN
F89E 3606             (    forth6809.asm):12142                    PSHU D         ; push u2 (actual unescaped length)
F8A0 39               (    forth6809.asm):12143                    RTS
                      (    forth6809.asm):12144         

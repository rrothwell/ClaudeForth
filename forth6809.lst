                      (    forth6809.asm):15021                  JSR  HEXW
                      (    forth6809.asm):15022                  LDD  BASE
                      (    forth6809.asm):15023                  CMPD #16
                      (    forth6809.asm):15024                  BNE  BSFAIL
                      (    forth6809.asm):15025         

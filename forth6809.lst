DD78 DCF7             (    forth6809.asm):02142                     LDD   QSAVEVAR
DD7A DD0A             (    forth6809.asm):02143                     STD   VARHERE
DD7C DCF9             (    forth6809.asm):02144                     LDD   QSAVELATEST
DD7E DD04             (    forth6809.asm):02145                     STD   LATEST
DD80 CEBD00           (    forth6809.asm):02146                     LDU   #SP0
                      (    forth6809.asm):02147         
                      (    forth6809.asm):02148                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02149                     ; See bugfix: QLOOP.1
DD83 CC0000           (    forth6809.asm):02150                     LDD   #0
DD86 DD00             (    forth6809.asm):02151                     STD   STATE
                      (    forth6809.asm):02152         
DD88 DCFB             (    forth6809.asm):02153                     LDD   QTHROWCODE        ; -1 is ABORT: reset silently, no "ERROR -1"
DD8A 1083FFFF         (    forth6809.asm):02154                     CMPD  #-1

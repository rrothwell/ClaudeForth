                      (    forth6809.asm):09752                   STA  TSTNAMEB
                      (    forth6809.asm):09753                   LDA  #'O'
                      (    forth6809.asm):09754                   STA  TSTNAMEB+1
                      (    forth6809.asm):09755                   LDA  #'O'

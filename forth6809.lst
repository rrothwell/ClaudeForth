                      (    forth6809.asm):17447                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):17448                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):17449                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):17450                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):17451                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):17452                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):17453                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):17454                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):17455                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):17456                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):17457                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):17458                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):17459                  ; for it.
E591 D621             (    forth6809.asm):17460                  LDB   CNTREM
E593 5A               (    forth6809.asm):17461                  DECB
E594 A685             (    forth6809.asm):17462                  LDA   B,X
E596 812E             (    forth6809.asm):17463                  CMPA  #'.'
E598 2604             (    forth6809.asm):17464                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):17465                  DEC   CNTREM
E59C 2766             (    forth6809.asm):17466                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):17467         
E59E 0F22             (    forth6809.asm):17468         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):17469                  LDA   ,X
E5A2 812D             (    forth6809.asm):17470                  CMPA  #'-'

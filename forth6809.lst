     0048             (    forth6809.asm):08105         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08106         
                      (    forth6809.asm):08107         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08108         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08109         ; .bin file.

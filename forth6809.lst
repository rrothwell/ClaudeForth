                      (    forth6809.asm):05264         ; Unsigned 16-bit division by shift and subtract. The divisor is not
                      (    forth6809.asm):05265         ; checked for zero.
                      (    forth6809.asm):05266         ; UDIV16
                      (    forth6809.asm):05267         ;    Inputs:
                      (    forth6809.asm):05268         ;        DIVNUM = dividend, DIVDEN = divisor (unsigned)
                      (    forth6809.asm):05269         ;    Outputs:
                      (    forth6809.asm):05270         ;        DIVNUM = quotient, DIVREM = remainder
                      (    forth6809.asm):05271         ;    Registers: RegD changed; DIVCNT used as the loop counter.
                      (    forth6809.asm):05272         ; ------------------------------------------------------------
EDF9 0F66             (    forth6809.asm):05273         UDIV16:     CLR   DIVREM
EDFB 0F67             (    forth6809.asm):05274                     CLR   DIVREM+1
EDFD C610             (    forth6809.asm):05275                     LDB   #16
EDFF D768             (    forth6809.asm):05276                     STB   DIVCNT

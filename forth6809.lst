F726 CC0000           (    forth6809.asm):07068                     LDD   #FALSEV           ; c-addr1 and u1 are already in place
F729 ED48             (    forth6809.asm):07069         SRCHOUT:    STD   8,U               ; flag
F72B 3348             (    forth6809.asm):07070                     LEAU  8,U               ; drop the locals and u2
F72D 39               (    forth6809.asm):07071                     RTS
F72E AEC4             (    forth6809.asm):07072         SNOMATCH:   LDX   ,U
F730 3001             (    forth6809.asm):07073                     LEAX  1,X
F732 AFC4             (    forth6809.asm):07074                     STX   ,U
F734 EC42             (    forth6809.asm):07075                     LDD   2,U

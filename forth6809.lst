                      (    forth6809.asm):03834                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):03835                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):03836                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):03837                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):03838                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):03839                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):03840                                   ; landing outer-index at 8, not 10. Offset 10

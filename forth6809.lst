E916 D329             (    forth6809.asm):04174                     ADDD  MSCR              ; new_index = old_index + step
E918 ED62             (    forth6809.asm):04175                     STD   2,S
E91A A364             (    forth6809.asm):04176                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E91C DD2D             (    forth6809.asm):04177                     STD   MSCR3

                      (    forth6809.asm):07809         ; ENVTABLE2
                      (    forth6809.asm):07810         ; Double-cell ENVIRONMENT? entries: name address, name length, low
                      (    forth6809.asm):07811         ; cell, high cell. A zero ends the table.
                      (    forth6809.asm):07812         ; ------------------------------------------------------------
FBCF                  (    forth6809.asm):07813         ENVTABLE2:

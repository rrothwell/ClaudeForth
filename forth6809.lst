                      (    forth6809.asm):06153         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):06154         ; ------------------------------------------------------------
F33C ECC4             (    forth6809.asm):06155         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F33E 2713             (    forth6809.asm):06156                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F340 AE44             (    forth6809.asm):06157                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F342 308B             (    forth6809.asm):06158                     LEAX  D,X               ; end address = c-addr1 + u
F344 AFC4             (    forth6809.asm):06159                     STX   ,U                ; keep it in u's old slot as the loop limit
F346 AE44             (    forth6809.asm):06160                     LDX   4,U               ; X = source
F348 10AE42           (    forth6809.asm):06161                     LDY   2,U               ; Y = destination
F34B A680             (    forth6809.asm):06162         CMVLOOP:    LDA   ,X+
F34D A7A0             (    forth6809.asm):06163                     STA   ,Y+
F34F ACC4             (    forth6809.asm):06164                     CMPX  ,U                ; reached the end address?
F351 26F8             (    forth6809.asm):06165                     BNE   CMVLOOP
F353 3346             (    forth6809.asm):06166         CMDONE:     LEAU  6,U               ; drop the three parameters
F355 39               (    forth6809.asm):06167                     RTS
                      (    forth6809.asm):06168         
                      (    forth6809.asm):06169         ; ------------------------------------------------------------
                      (    forth6809.asm):06170         ; CMOVE>  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06171         ; Copy u bytes from c-addr1 to c-addr2, starting at the high
                      (    forth6809.asm):06172         ; addresses.
                      (    forth6809.asm):06173         ; ------------------------------------------------------------
F356 ECC4             (    forth6809.asm):06174         CMOVEGTW:   LDD   ,U                ; u. Parameters stay on the data stack:
F358 2711             (    forth6809.asm):06175                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
F35A AE44             (    forth6809.asm):06176                     LDX   4,U
F35C 308B             (    forth6809.asm):06177                     LEAX  D,X               ; X = one past the end of the source
F35E 10AE42           (    forth6809.asm):06178                     LDY   2,U
F361 31AB             (    forth6809.asm):06179                     LEAY  D,Y               ; Y = one past the end of the destination
F363 A682             (    forth6809.asm):06180         CGLOOP:     LDA   ,-X
F365 A7A2             (    forth6809.asm):06181                     STA   ,-Y
F367 AC44             (    forth6809.asm):06182                     CMPX  4,U               ; back at the start of the source?
F369 26F8             (    forth6809.asm):06183                     BNE   CGLOOP
F36B 3346             (    forth6809.asm):06184         CGDONE:     LEAU  6,U               ; drop the three parameters
F36D 39               (    forth6809.asm):06185                     RTS
                      (    forth6809.asm):06186         
                      (    forth6809.asm):06187         ; ------------------------------------------------------------
                      (    forth6809.asm):06188         ; MOVE  ( addr1 addr2 u -- )
                      (    forth6809.asm):06189         ; Copy u bytes from addr1 to addr2, choosing CMOVE or CMOVE> so that
                      (    forth6809.asm):06190         ; overlapping regions are handled correctly.
                      (    forth6809.asm):06191         ; ------------------------------------------------------------
F36E EC42             (    forth6809.asm):06192         MOVEW:      LDD   2,U               ; addr2
F370 10A344           (    forth6809.asm):06193                     CMPD  4,U               ; addr1
F373 22E1             (    forth6809.asm):06194                     BHI   CMOVEGTW          ; addr2 above addr1: copy from the top
F375 7EF33C           (    forth6809.asm):06195                     JMP   CMOVEW
                      (    forth6809.asm):06196         
                      (    forth6809.asm):06197         ; ------------------------------------------------------------
                      (    forth6809.asm):06198         ; FILL  ( c-addr u char -- )
                      (    forth6809.asm):06199         ; Store char in each of u bytes starting at c-addr.
                      (    forth6809.asm):06200         ; ------------------------------------------------------------
F378 EC42             (    forth6809.asm):06201         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F37A 270F             (    forth6809.asm):06202                     BEQ   FDONE
F37C AE44             (    forth6809.asm):06203                     LDX   4,U
F37E 318B             (    forth6809.asm):06204                     LEAY  D,X               ; end address
F380 10AF42           (    forth6809.asm):06205                     STY   2,U               ; keep it in u's slot as the loop limit
F383 A641             (    forth6809.asm):06206                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
F385 A780             (    forth6809.asm):06207         FILLOOP:    STA   ,X+
F387 AC42             (    forth6809.asm):06208                     CMPX  2,U
F389 26FA             (    forth6809.asm):06209                     BNE   FILLOOP
F38B 3346             (    forth6809.asm):06210         FDONE:      LEAU  6,U               ; drop the three parameters
F38D 39               (    forth6809.asm):06211                     RTS
                      (    forth6809.asm):06212         
                      (    forth6809.asm):06213         ; ------------------------------------------------------------
                      (    forth6809.asm):06214         ; ERASE  ( c-addr u -- )
                      (    forth6809.asm):06215         ; Fill u bytes starting at c-addr with zero.
                      (    forth6809.asm):06216         ; ------------------------------------------------------------
F38E CC0000           (    forth6809.asm):06217         ERASEW:     LDD   #0
F391 3606             (    forth6809.asm):06218                     PSHU  D
F393 7EF378           (    forth6809.asm):06219                     JMP   FILLW
                      (    forth6809.asm):06220         
                      (    forth6809.asm):06221         ; ------------------------------------------------------------
                      (    forth6809.asm):06222         ; BLANK  ( c-addr u -- )
                      (    forth6809.asm):06223         ; Store a space in each of u bytes starting at c-addr.
                      (    forth6809.asm):06224         ; ------------------------------------------------------------
F396 CC0020           (    forth6809.asm):06225         BLANKW:     LDD   #32
F399 3606             (    forth6809.asm):06226                     PSHU  D
F39B 7EF378           (    forth6809.asm):06227                     JMP   FILLW
                      (    forth6809.asm):06228         
                      (    forth6809.asm):06229         ; ============================================================
                      (    forth6809.asm):06230         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06231         ; ============================================================
                      (    forth6809.asm):06232         ; ------------------------------------------------------------
                      (    forth6809.asm):06233         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06234         ; address and length and skip over it.
                      (    forth6809.asm):06235         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06236         ;    Inputs:
                      (    forth6809.asm):06237         ;        return address on S points at the count byte
                      (    forth6809.asm):06238         ;    Outputs:
                      (    forth6809.asm):06239         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06240         ;        string
                      (    forth6809.asm):06241         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06242         ; ------------------------------------------------------------
F39E 3510             (    forth6809.asm):06243         DOSTR:      PULS  X
F3A0 E684             (    forth6809.asm):06244                     LDB   ,X
F3A2 3001             (    forth6809.asm):06245                     LEAX  1,X
F3A4 3610             (    forth6809.asm):06246                     PSHU  X
F3A6 4F               (    forth6809.asm):06247                     CLRA
F3A7 3606             (    forth6809.asm):06248                     PSHU  D
F3A9 3085             (    forth6809.asm):06249                     LEAX  B,X
F3AB 3410             (    forth6809.asm):06250                     PSHS  X
F3AD 39               (    forth6809.asm):06251                     RTS
                      (    forth6809.asm):06252         
                      (    forth6809.asm):06253         ; ------------------------------------------------------------
                      (    forth6809.asm):06254         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06255         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06256         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06257         ; PARSEQUOTE
                      (    forth6809.asm):06258         ;    Inputs:
                      (    forth6809.asm):06259         ;        none (parses from >IN)
                      (    forth6809.asm):06260         ;    Outputs:
                      (    forth6809.asm):06261         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06262         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06263         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06264         ; ------------------------------------------------------------
F3AE CC0022           (    forth6809.asm):06265         PARSEQUOTE: LDD   #34
F3B1 3606             (    forth6809.asm):06266                     PSHU  D
F3B3 BDF47A           (    forth6809.asm):06267                     JSR   PARSEW
F3B6 6DC4             (    forth6809.asm):06268                     TST   ,U                ; high byte of the length
F3B8 2601             (    forth6809.asm):06269                     BNE   PQLONG
F3BA 39               (    forth6809.asm):06270                     RTS
F3BB CCFFEE           (    forth6809.asm):06271         PQLONG:     LDD   #-18
F3BE 3606             (    forth6809.asm):06272                     PSHU  D
F3C0 7EE61F           (    forth6809.asm):06273                     JMP   THROWW
                      (    forth6809.asm):06274         
                      (    forth6809.asm):06275         ; ------------------------------------------------------------
                      (    forth6809.asm):06276         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06277         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06278         ;    Inputs:
                      (    forth6809.asm):06279         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06280         ;        c-addr u on the data stack
                      (    forth6809.asm):06281         ;    Outputs:
                      (    forth6809.asm):06282         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06283         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06284         ; ------------------------------------------------------------
F3C3 3606             (    forth6809.asm):06285         CSTRCOMP:   PSHU  D
F3C5 BDEA5A           (    forth6809.asm):06286                     JSR   CCALL
F3C8 3706             (    forth6809.asm):06287                     PULU  D                 ; u
F3CA 3720             (    forth6809.asm):06288                     PULU  Y                 ; c-addr
F3CC 9E08             (    forth6809.asm):06289                     LDX   CODEHERE
F3CE E780             (    forth6809.asm):06290                     STB   ,X+
F3D0 5D               (    forth6809.asm):06291                     TSTB
F3D1 2707             (    forth6809.asm):06292                     BEQ   CSEND
F3D3 A6A0             (    forth6809.asm):06293         CSCPY:      LDA   ,Y+
F3D5 A780             (    forth6809.asm):06294                     STA   ,X+
F3D7 5A               (    forth6809.asm):06295                     DECB
F3D8 26F9             (    forth6809.asm):06296                     BNE   CSCPY
F3DA 9F08             (    forth6809.asm):06297         CSEND:      STX   CODEHERE
F3DC 39               (    forth6809.asm):06298                     RTS
                      (    forth6809.asm):06299         
                      (    forth6809.asm):06300         ; ------------------------------------------------------------
                      (    forth6809.asm):06301         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06302         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06303         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06304         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06305         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06306         ; ------------------------------------------------------------
F3DD BDF3AE           (    forth6809.asm):06307         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F3E0 DC00             (    forth6809.asm):06308                     LDD   STATE
F3E2 2706             (    forth6809.asm):06309                     BEQ   SQINTERP
F3E4 CCF39E           (    forth6809.asm):06310                     LDD   #DOSTR
F3E7 7EF3C3           (    forth6809.asm):06311                     JMP   CSTRCOMP
                      (    forth6809.asm):06312         
                      (    forth6809.asm):06313                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06314                     ; SQUOTEW.2.
F3EA                  (    forth6809.asm):06315         SQINTERP:
F3EA BDE034           (    forth6809.asm):06316                     JSR   PADW
F3ED 3710             (    forth6809.asm):06317                     PULU  X                 ; PAD
F3EF 3706             (    forth6809.asm):06318                     PULU  D                 ; u
F3F1 3720             (    forth6809.asm):06319                     PULU  Y                 ; c-addr
F3F3 3610             (    forth6809.asm):06320                     PSHU  X                 ; result c-addr
F3F5 3606             (    forth6809.asm):06321                     PSHU  D                 ; result u
F3F7 5D               (    forth6809.asm):06322                     TSTB
F3F8 2707             (    forth6809.asm):06323                     BEQ   SQIEND
F3FA A6A0             (    forth6809.asm):06324         SQICPY:     LDA   ,Y+
F3FC A780             (    forth6809.asm):06325                     STA   ,X+
F3FE 5A               (    forth6809.asm):06326                     DECB
F3FF 26F9             (    forth6809.asm):06327                     BNE   SQICPY
F401 39               (    forth6809.asm):06328         SQIEND:     RTS
                      (    forth6809.asm):06329         
                      (    forth6809.asm):06330         ; ------------------------------------------------------------
                      (    forth6809.asm):06331         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06332         ; and skip over it.
                      (    forth6809.asm):06333         ; DOTSTR
                      (    forth6809.asm):06334         ;    Inputs:
                      (    forth6809.asm):06335         ;        return address on S points at the count byte
                      (    forth6809.asm):06336         ;    Outputs:
                      (    forth6809.asm):06337         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06338         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06339         ; ------------------------------------------------------------
F402 3510             (    forth6809.asm):06340         DOTSTR:     PULS  X
F404 E684             (    forth6809.asm):06341                     LDB   ,X
F406 3001             (    forth6809.asm):06342                     LEAX  1,X
F408 3610             (    forth6809.asm):06343                     PSHU  X
F40A 4F               (    forth6809.asm):06344                     CLRA
F40B 3606             (    forth6809.asm):06345                     PSHU  D
F40D 3085             (    forth6809.asm):06346                     LEAX  B,X
F40F 3410             (    forth6809.asm):06347                     PSHS  X
F411 7EF41D           (    forth6809.asm):06348                     JMP   TYPEW
                      (    forth6809.asm):06349         
                      (    forth6809.asm):06350         ; ------------------------------------------------------------
                      (    forth6809.asm):06351         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06352         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06353         ; counted string.
                      (    forth6809.asm):06354         ; ------------------------------------------------------------
F414 BDF3AE           (    forth6809.asm):06355         DOTQUOTEW:  JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F417 CCF402           (    forth6809.asm):06356                     LDD   #DOTSTR
F41A 7EF3C3           (    forth6809.asm):06357                     JMP   CSTRCOMP
                      (    forth6809.asm):06358         
                      (    forth6809.asm):06359         ; ------------------------------------------------------------
                      (    forth6809.asm):06360         ; TYPE  ( c-addr u -- )
                      (    forth6809.asm):06361         ; Display u characters starting at c-addr, through EMIT.
                      (    forth6809.asm):06362         ; ------------------------------------------------------------
F41D ECC4             (    forth6809.asm):06363         TYPEW:      LDD   ,U                ; u. Parameters stay on the data stack:
F41F 2717             (    forth6809.asm):06364                     BEQ   TYDONE            ; u at 0, c-addr at 2
F421 AE42             (    forth6809.asm):06365         TYLOOP:     LDX   2,U
F423 A680             (    forth6809.asm):06366                     LDA   ,X+
F425 AF42             (    forth6809.asm):06367                     STX   2,U
F427 1F89             (    forth6809.asm):06368                     TFR   A,B
F429 4F               (    forth6809.asm):06369                     CLRA
F42A 3606             (    forth6809.asm):06370                     PSHU  D
F42C BDE552           (    forth6809.asm):06371                     JSR   EMITW
F42F ECC4             (    forth6809.asm):06372                     LDD   ,U
F431 830001           (    forth6809.asm):06373                     SUBD  #1
F434 EDC4             (    forth6809.asm):06374                     STD   ,U
F436 26E9             (    forth6809.asm):06375                     BNE   TYLOOP
F438 3344             (    forth6809.asm):06376         TYDONE:     LEAU  4,U               ; drop the two parameters
F43A 39               (    forth6809.asm):06377                     RTS
                      (    forth6809.asm):06378         
                      (    forth6809.asm):06379         ; ------------------------------------------------------------
                      (    forth6809.asm):06380         ; COUNT  ( c-addr1 -- c-addr2 u )
                      (    forth6809.asm):06381         ; Convert a counted string to its address and length.
                      (    forth6809.asm):06382         ; ------------------------------------------------------------
F43B 3710             (    forth6809.asm):06383         COUNTW:     PULU  X                 ; c-addr1
F43D E684             (    forth6809.asm):06384                     LDB   ,X
F43F 4F               (    forth6809.asm):06385                     CLRA
F440 DD1E             (    forth6809.asm):06386                     STD   MSCR
F442 3001             (    forth6809.asm):06387                     LEAX  1,X
F444 3610             (    forth6809.asm):06388                     PSHU  X
F446 DC1E             (    forth6809.asm):06389                     LDD   MSCR
F448 3606             (    forth6809.asm):06390                     PSHU  D
F44A 39               (    forth6809.asm):06391                     RTS
                      (    forth6809.asm):06392         
                      (    forth6809.asm):06393         ; ------------------------------------------------------------
                      (    forth6809.asm):06394         ; CHAR  ( "name" -- char )
                      (    forth6809.asm):06395         ; Parse the next blank-delimited name and return its first character.
                      (    forth6809.asm):06396         ; ------------------------------------------------------------
F44B CC0020           (    forth6809.asm):06397         CHARW:      LDD   #32
F44E 3606             (    forth6809.asm):06398                     PSHU  D
F450 BDE33D           (    forth6809.asm):06399                     JSR   WORDW
F453 3710             (    forth6809.asm):06400                     PULU  X
F455 E601             (    forth6809.asm):06401                     LDB   1,X
F457 4F               (    forth6809.asm):06402                     CLRA
F458 3606             (    forth6809.asm):06403                     PSHU  D
F45A 39               (    forth6809.asm):06404                     RTS
                      (    forth6809.asm):06405         
                      (    forth6809.asm):06406         ; ------------------------------------------------------------
                      (    forth6809.asm):06407         ; [CHAR]  ( "name" -- )
                      (    forth6809.asm):06408         ; Compile the first character of the next name as a literal. THROW -14
                      (    forth6809.asm):06409         ; if not compiling.

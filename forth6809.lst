                      (    forth6809.asm):02820         ; TSTSTSLZ - unit test for STARSLASH, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):02821         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02822         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02823         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02824         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02825         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02826         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02827         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02828         ; there are.
                      (    forth6809.asm):02829         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02830         TSTSTSLZ:   STU   TSTU0
                      (    forth6809.asm):02831         
                      (    forth6809.asm):02832                    LDD   #TSTVAL1
                      (    forth6809.asm):02833                    PSHU  D
                      (    forth6809.asm):02834                    LDD   #TSTVAL2
                      (    forth6809.asm):02835                    PSHU  D
                      (    forth6809.asm):02836                    LDD   #$0000
                      (    forth6809.asm):02837                    PSHU  D
                      (    forth6809.asm):02838                    LDX   #STARSLASH
                      (    forth6809.asm):02839                    PSHU  X
                      (    forth6809.asm):02840                    STU   TSTUB4
                      (    forth6809.asm):02841         
                      (    forth6809.asm):02842                    JSR   CATCH
                      (    forth6809.asm):02843         
                      (    forth6809.asm):02844                    STU   TSTUAF
                      (    forth6809.asm):02845         
                      (    forth6809.asm):02846                    PULU  D
                      (    forth6809.asm):02847                    CMPD  #-10
                      (    forth6809.asm):02848                    BNE   TZFAIL
                      (    forth6809.asm):02849         
                      (    forth6809.asm):02850                    LDD   TSTUB4
                      (    forth6809.asm):02851                    SUBD  TSTUAF
                      (    forth6809.asm):02852                    CMPD  #0
                      (    forth6809.asm):02853                    BNE   TZFAIL
                      (    forth6809.asm):02854         
                      (    forth6809.asm):02855                    LDD   #TRUEV
                      (    forth6809.asm):02856                    BRA   TZDONE
C100                  (    forth6809.asm):02857         TZFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02858         TZDONE:     LDX   #TSTSTSLZNAME
                      (    forth6809.asm):02859                    PSHU  X
                      (    forth6809.asm):02860                    PSHU  D
                      (    forth6809.asm):02861                    JSR   TSTREPORT
                      (    forth6809.asm):02862         
                      (    forth6809.asm):02863                    LDU   TSTU0
                      (    forth6809.asm):02864                    RTS
                      (    forth6809.asm):02865         

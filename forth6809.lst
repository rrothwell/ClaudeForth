F863 3706             (    forth6809.asm):20638         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F865 DDAB             (    forth6809.asm):20639                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):20640                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):20641                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):20642                                   ; real source length was misread as an
                      (    forth6809.asm):20643                                   ; address, the real source address was never
                      (    forth6809.asm):20644                                   ; popped at all, and the true destination
                      (    forth6809.asm):20645                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):20646                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):20647                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):20648                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):20649                    STD  UESRCLEN
F86B 3706             (    forth6809.asm):20650                    PULU D         ; next: c-addr1 (source address)
F86D DDA7             (    forth6809.asm):20651                    STD  UEADDR
F86F CC0000           (    forth6809.asm):20652                    LDD  #0
F872 DDAD             (    forth6809.asm):20653                    STD  UEOUTLEN
F874 9EA7             (    forth6809.asm):20654                    LDX  UEADDR
F876 109EAB           (    forth6809.asm):20655                    LDY  UEDST
                      (    forth6809.asm):20656         
                      (    forth6809.asm):20657                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):20658                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):20659                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):20660                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):20661                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):20662                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):20663                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):20664                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):20665                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):20666                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):20667                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):20668                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):20669                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):20670                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):20671                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):20672                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):20673                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):20674                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):20675                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):20676         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):20677                    BEQ  UEDONE
F87D A680             (    forth6809.asm):20678                    LDA  ,X+
F87F 8125             (    forth6809.asm):20679                    CMPA #'%'
F881 2604             (    forth6809.asm):20680                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):20681                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):20682                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):20683                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):20684                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):20685                                   ; the same string correctly, since this runs
                      (    forth6809.asm):20686                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):20687         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):20688                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):20689                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):20690                    SUBD #1
F88E DDA9             (    forth6809.asm):20691                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):20692                    BRA  UELOOP
F892 1F20             (    forth6809.asm):20693         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -

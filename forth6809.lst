                      (    forth6809.asm):09442         ; ------------------------------------------------------------
                      (    forth6809.asm):09443         ; TSTCOMPWORDS - compiling-words tests (glossary section 3.10,
                      (    forth6809.asm):09444         ; 13 words, 17 tests since several get separate cases: TICK
                      (    forth6809.asm):09445         ; found/not-found, ['] compiling/interpreting state, POSTPONE
                      (    forth6809.asm):09446         ; normal/immediate word, SLITERAL compiling/interpreting state,
                      (    forth6809.asm):09447         ; ABORT" false/true flag). Reuses the scratch infrastructure
                      (    forth6809.asm):09448         ; established for sections 3.8/3.9 throughout.
                      (    forth6809.asm):09449         ;
                      (    forth6809.asm):09450         ; POSTPONE is this section's hardest case: a genuine two-level
                      (    forth6809.asm):09451         ; compile-time mechanism. Traced its own code first - for a
                      (    forth6809.asm):09452         ; normal word, it compiles code that ITSELF compiles a call to
                      (    forth6809.asm):09453         ; that word later, when the current definition eventually runs,
                      (    forth6809.asm):09454         ; not immediately (standard ANS semantics: POSTPONE appends a
                      (    forth6809.asm):09455         ; word's own compilation semantics to the current definition,
                      (    forth6809.asm):09456         ; and for an ordinary word that semantics IS "compile a call to
                      (    forth6809.asm):09457         ; it", so appending it only makes sense if the current
                      (    forth6809.asm):09458         ; definition later performs that compiling action itself,
                      (    forth6809.asm):09459         ; against whatever's being compiled at that later point).
                      (    forth6809.asm):09460         ; Verified via the compiled byte sequence directly rather than
                      (    forth6809.asm):09461         ; fully executing a triple-nested compile chain.
                      (    forth6809.asm):09462         ;
                      (    forth6809.asm):09463         ; ABORT" is safely testable for both its flag cases - confirmed
                      (    forth6809.asm):09464         ; by reading its own runtime code that it uses THROW -2
                      (    forth6809.asm):09465         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09466         ; ABORT itself uses (still deliberately untested, per section
                      (    forth6809.asm):09467         ; 3.1's own reasoning).
                      (    forth6809.asm):09468         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09469         TSTCOMPWORDS: JSR CRW
                      (    forth6809.asm):09470                    LDX   #TSTCWMSG
                      (    forth6809.asm):09471                    PSHU  X
                      (    forth6809.asm):09472                    LDD   #9
                      (    forth6809.asm):09473                    PSHU  D
                      (    forth6809.asm):09474                    JSR   TYPE
                      (    forth6809.asm):09475                    JSR   CRW
                      (    forth6809.asm):09476         
                      (    forth6809.asm):09477                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09478         
                      (    forth6809.asm):09479                    JSR   TSTIMMED
                      (    forth6809.asm):09480                    JSR   TSTSTATE
                      (    forth6809.asm):09481                    JSR   TSTBRACKETS
                      (    forth6809.asm):09482                    JSR   TSTTICK1
                      (    forth6809.asm):09483                    JSR   TSTTICK2
                      (    forth6809.asm):09484                    JSR   TSTCOMPCOMMA
                      (    forth6809.asm):09485                    JSR   TSTLITERAL
                      (    forth6809.asm):09486                    JSR   TSTBRACKTICK1
                      (    forth6809.asm):09487                    JSR   TSTBRACKTICK2
                      (    forth6809.asm):09488                    JSR   TSTPOSTPONE1
                      (    forth6809.asm):09489                    JSR   TSTPOSTPONE2
                      (    forth6809.asm):09490                    JSR   TSTTOBODY
                      (    forth6809.asm):09491                    JSR   TSTEXECUTE
                      (    forth6809.asm):09492                    JSR   TSTSLITERAL1
                      (    forth6809.asm):09493                    JSR   TSTSLITERAL2
                      (    forth6809.asm):09494                    JSR   TSTABORTQ1
                      (    forth6809.asm):09495                    JSR   TSTABORTQ2
                      (    forth6809.asm):09496         
                      (    forth6809.asm):09497                    ENDC ; <<<<
                      (    forth6809.asm):09498         
                      (    forth6809.asm):09499                    RTS
                      (    forth6809.asm):09500         
C100                  (    forth6809.asm):09501         TSTCWMSG: FCC "CompWords"
                      (    forth6809.asm):09502         
                      (    forth6809.asm):09503                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09504         
                      (    forth6809.asm):09505         ; ------------------------------------------------------------
                      (    forth6809.asm):09506         ; Compiling-words test harness (glossary section 3.10). Reuses
                      (    forth6809.asm):09507         ; the scratch infrastructure established for sections 3.8/3.9
                      (    forth6809.asm):09508         ; (TSTCBUF/TSTCBUF2 for CODEHERE redirects, TSTFHDR for a fake
                      (    forth6809.asm):09509         ; dictionary header, TSTNAMEB for a fake source name). POSTPONE
                      (    forth6809.asm):09510         ; is this section's own hardest case: a genuine two-level
                      (    forth6809.asm):09511         ; compile-time mechanism (compiling code that, for a normal
                      (    forth6809.asm):09512         ; word, itself compiles a call to that word later, when the
                      (    forth6809.asm):09513         ; current definition eventually runs - not immediately, unlike
                      (    forth6809.asm):09514         ; every other compile-time word tested so far). ABORT" is safely
                      (    forth6809.asm):09515         ; testable for both its true and false flag cases - traced its
                      (    forth6809.asm):09516         ; own runtime behavior directly and confirmed it uses THROW -2
                      (    forth6809.asm):09517         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09518         ; ABORT itself uses (which remains untested, per section 3.1's
                      (    forth6809.asm):09519         ; own reasoning).
                      (    forth6809.asm):09520         ; ------------------------------------------------------------
                      (    forth6809.asm):09521         
                      (    forth6809.asm):09522         ; ------------------------------------------------------------
                      (    forth6809.asm):09523         ; TSTIMMED - unit test for IMMEDIATE. Builds a fake header (LEN/
                      (    forth6809.asm):09524         ; FL=3, no flags), points LATEST at it, calls IMMEDIATE, and
                      (    forth6809.asm):09525         ; verifies the header's own LEN/FL byte now has bit 7 set -
                      (    forth6809.asm):09526         ; confirmed a memory-only operation with no data-stack effect,
                      (    forth6809.asm):09527         ; so the guard check is the whole verification beyond that.
                      (    forth6809.asm):09528         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09529         TSTIMMED: LDD  LATEST
                      (    forth6809.asm):09530                   STD  TSTLSAV
                      (    forth6809.asm):09531         
                      (    forth6809.asm):09532                   LDA  #3
                      (    forth6809.asm):09533                   STA  TSTFHDR
                      (    forth6809.asm):09534                   LDA  #'F'
                      (    forth6809.asm):09535                   STA  TSTFHDR+1
                      (    forth6809.asm):09536                   LDA  #'O'
                      (    forth6809.asm):09537                   STA  TSTFHDR+2
                      (    forth6809.asm):09538                   LDA  #'O'
                      (    forth6809.asm):09539                   STA  TSTFHDR+3
                      (    forth6809.asm):09540                   LDD  #0
                      (    forth6809.asm):09541                   STD  TSTFHDR+4
                      (    forth6809.asm):09542                   LDD  #DUP
                      (    forth6809.asm):09543                   STD  TSTFHDR+6
                      (    forth6809.asm):09544         
                      (    forth6809.asm):09545                   LDD  #TSTFHDR
                      (    forth6809.asm):09546                   STD  LATEST
                      (    forth6809.asm):09547         
                      (    forth6809.asm):09548                   STU  TSTU0
                      (    forth6809.asm):09549         
                      (    forth6809.asm):09550                   LDD  #TSTGUARD
                      (    forth6809.asm):09551                   PSHU D
                      (    forth6809.asm):09552                   STU  TSTUB4
                      (    forth6809.asm):09553         
                      (    forth6809.asm):09554                   JSR  IMMEDIATE
                      (    forth6809.asm):09555         
                      (    forth6809.asm):09556                   STU  TSTUAF
                      (    forth6809.asm):09557         
                      (    forth6809.asm):09558                   LDA  TSTFHDR
                      (    forth6809.asm):09559                   CMPA #$83
                      (    forth6809.asm):09560                   BNE  IMFAIL
                      (    forth6809.asm):09561         
                      (    forth6809.asm):09562                   PULU D
                      (    forth6809.asm):09563                   CMPD #TSTGUARD
                      (    forth6809.asm):09564                   BNE  IMFAIL
                      (    forth6809.asm):09565         
                      (    forth6809.asm):09566                   LDD  TSTUB4
                      (    forth6809.asm):09567                   SUBD TSTUAF
                      (    forth6809.asm):09568                   CMPD #0
                      (    forth6809.asm):09569                   BNE  IMFAIL
                      (    forth6809.asm):09570         
                      (    forth6809.asm):09571                   LDD  #TRUEV
                      (    forth6809.asm):09572                   BRA  IMDONE
C100                  (    forth6809.asm):09573         IMFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):09574         IMDONE:   LDX  #TSTIMMEDNAME
                      (    forth6809.asm):09575                   PSHU X
                      (    forth6809.asm):09576                   PSHU D
                      (    forth6809.asm):09577                   JSR  TSTREPORT
                      (    forth6809.asm):09578         
                      (    forth6809.asm):09579                   LDD  TSTLSAV
                      (    forth6809.asm):09580                   STD  LATEST
                      (    forth6809.asm):09581         
                      (    forth6809.asm):09582                   LDU  TSTU0
                      (    forth6809.asm):09583                   RTS
                      (    forth6809.asm):09584         
C100                  (    forth6809.asm):09585         TSTIMMEDNAME: FCB  8
                      (    forth6809.asm):09586                       FCC  "TSTIMMED"
                      (    forth6809.asm):09587         
                      (    forth6809.asm):09588         ; ------------------------------------------------------------
                      (    forth6809.asm):09589         ; TSTSTATE - unit test for STATE. Verifies it pushes the address
                      (    forth6809.asm):09590         ; of the real STATE variable (a plain variable, per its own
                      (    forth6809.asm):09591         ; documented "( -- addr )" effect - not its current value).
                      (    forth6809.asm):09592         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09593         TSTSTATE: STU  TSTU0
                      (    forth6809.asm):09594         
                      (    forth6809.asm):09595                   LDD  #TSTGUARD
                      (    forth6809.asm):09596                   PSHU D
                      (    forth6809.asm):09597                   STU  TSTUB4
                      (    forth6809.asm):09598         
                      (    forth6809.asm):09599                   JSR  STATEW
                      (    forth6809.asm):09600         
                      (    forth6809.asm):09601                   STU  TSTUAF
                      (    forth6809.asm):09602         
                      (    forth6809.asm):09603                   PULU D
                      (    forth6809.asm):09604                   CMPD #STATE
                      (    forth6809.asm):09605                   BNE  STFAIL2
                      (    forth6809.asm):09606                   PULU D
                      (    forth6809.asm):09607                   CMPD #TSTGUARD
                      (    forth6809.asm):09608                   BNE  STFAIL2
                      (    forth6809.asm):09609         
                      (    forth6809.asm):09610                   LDD  TSTUB4
                      (    forth6809.asm):09611                   SUBD TSTUAF
                      (    forth6809.asm):09612                   CMPD #2
                      (    forth6809.asm):09613                   BNE  STFAIL2
                      (    forth6809.asm):09614         
                      (    forth6809.asm):09615                   LDD  #TRUEV
                      (    forth6809.asm):09616                   BRA  STDONE2
C100                  (    forth6809.asm):09617         STFAIL2:  LDD  #FALSEV
C100                  (    forth6809.asm):09618         STDONE2:  LDX  #TSTSTATENAME
                      (    forth6809.asm):09619                   PSHU X
                      (    forth6809.asm):09620                   PSHU D
                      (    forth6809.asm):09621                   JSR  TSTREPORT
                      (    forth6809.asm):09622         
                      (    forth6809.asm):09623                   LDU  TSTU0
                      (    forth6809.asm):09624                   RTS
                      (    forth6809.asm):09625         
C100                  (    forth6809.asm):09626         TSTSTATENAME: FCB  8
                      (    forth6809.asm):09627                       FCC  "TSTSTATE"
                      (    forth6809.asm):09628         
                      (    forth6809.asm):09629         ; ------------------------------------------------------------
                      (    forth6809.asm):09630         ; TSTBRACKETS - unit test for [ and ] together. Verifies ]
                      (    forth6809.asm):09631         ; sets STATE to -1 (compiling) and [ sets it back to 0
                      (    forth6809.asm):09632         ; (interpreting) - both memory-only operations, no data-stack
                      (    forth6809.asm):09633         ; effect.
                      (    forth6809.asm):09634         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09635         TSTBRACKETS: LDD  STATE
                      (    forth6809.asm):09636                      STD  TSTSTSAV
                      (    forth6809.asm):09637         
                      (    forth6809.asm):09638                      STU  TSTU0
                      (    forth6809.asm):09639         
                      (    forth6809.asm):09640                      LDD  #TSTGUARD
                      (    forth6809.asm):09641                      PSHU D
                      (    forth6809.asm):09642                      STU  TSTUB4
                      (    forth6809.asm):09643         
                      (    forth6809.asm):09644                      JSR  RBRACKET
                      (    forth6809.asm):09645         
                      (    forth6809.asm):09646                      LDD  STATE
                      (    forth6809.asm):09647                      CMPD #-1
                      (    forth6809.asm):09648                      BNE  BKFAIL
                      (    forth6809.asm):09649         
                      (    forth6809.asm):09650                      JSR  LBRACKET
                      (    forth6809.asm):09651         
                      (    forth6809.asm):09652                      STU  TSTUAF
                      (    forth6809.asm):09653         
                      (    forth6809.asm):09654                      LDD  STATE
                      (    forth6809.asm):09655                      CMPD #0
                      (    forth6809.asm):09656                      BNE  BKFAIL
                      (    forth6809.asm):09657         
                      (    forth6809.asm):09658                      PULU D
                      (    forth6809.asm):09659                      CMPD #TSTGUARD
                      (    forth6809.asm):09660                      BNE  BKFAIL
                      (    forth6809.asm):09661         
                      (    forth6809.asm):09662                      LDD  TSTUB4
                      (    forth6809.asm):09663                      SUBD TSTUAF
                      (    forth6809.asm):09664                      CMPD #0

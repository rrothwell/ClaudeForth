                      (    forth6809.asm):03666                  TFR   A,B
                      (    forth6809.asm):03667                  CLRA
                      (    forth6809.asm):03668                  PSHU  D
                      (    forth6809.asm):03669                  RTS
                      (    forth6809.asm):03670         
E66F                  (    forth6809.asm):03671         KEYQ:    LDA   ACIASR
                      (    forth6809.asm):03672                  BITA  #SR_RDRF
                      (    forth6809.asm):03673                  BEQ   KQFALSE

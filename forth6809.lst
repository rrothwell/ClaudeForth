DDEA DD06             (    forth6809.asm):02649                  STD   DPHERE
DDEC DCF5             (    forth6809.asm):02650                  LDD   QSAVECODE
DDEE DD08             (    forth6809.asm):02651                  STD   CODEHERE
DDF0 DCF7             (    forth6809.asm):02652                  LDD   QSAVEVAR
DDF2 DD0A             (    forth6809.asm):02653                  STD   VARHERE
DDF4 DCF9             (    forth6809.asm):02654                  LDD   QSAVELATEST
DDF6 DD04             (    forth6809.asm):02655                  STD   LATEST
DDF8 CEBD00           (    forth6809.asm):02656                  LDU   #SP0
                      (    forth6809.asm):02657         
DDFB BDFB00           (    forth6809.asm):02658                  JSR   CRW
DDFE 8EDE3D           (    forth6809.asm):02659                  LDX   #ERRMSG
DE01 3610             (    forth6809.asm):02660                  PSHU  X
DE03 CC0008           (    forth6809.asm):02661                  LDD   #ERRMSGL
DE06 3606             (    forth6809.asm):02662                  PSHU  D
DE08 BDF4E0           (    forth6809.asm):02663                  JSR   TYPE
DE0B DCFB             (    forth6809.asm):02664                  LDD   QTHROWCODE
DE0D 3606             (    forth6809.asm):02665                  PSHU  D
DE0F BDF96F           (    forth6809.asm):02666                  JSR   DOT

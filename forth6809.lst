                      (   unit_tests.asm):10858         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (   unit_tests.asm):10859         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (   unit_tests.asm):10860         ; direct write (not through C!/C@ themselves), then confirms C!
                      (   unit_tests.asm):10861         ; genuinely only touches the single byte at the exact address
                      (   unit_tests.asm):10862         ; given - not the "other half" of a 2-byte cell in some assumed
                      (   unit_tests.asm):10863         ; sense - and that C@ genuinely zero-extends (not just returns
                      (   unit_tests.asm):10864         ; whatever was there).
                      (   unit_tests.asm):10865         ;
                      (   unit_tests.asm):10866         ; BUG FIX: this test's own expected value after C! was wrong,
                      (   unit_tests.asm):10867         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (   unit_tests.asm):10868         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (   unit_tests.asm):10869         ; the high byte of the word), but CSTOREW writes directly at
                      (   unit_tests.asm):10870         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (   unit_tests.asm):10871         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (   unit_tests.asm):10872         ; LDD on this big-endian 6809 reads the high byte of the word
                      (   unit_tests.asm):10873         ; from the lower address first, that's $34FF, not $FF34. The
                      (   unit_tests.asm):10874         ; single-byte write and the zero-extending fetch were both
                      (   unit_tests.asm):10875         ; already correct; only this test's own arithmetic about which
                      (   unit_tests.asm):10876         ; byte ends up where was wrong.
                      (   unit_tests.asm):10877         ; ------------------------------------------------------------

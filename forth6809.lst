F858 830001           (    forth6809.asm):07017                     SUBD  #1
F85B EDC4             (    forth6809.asm):07018                     STD   ,U                ; remaining count
F85D AE42             (    forth6809.asm):07019                     LDX   2,U
F85F A68B             (    forth6809.asm):07020                     LDA   D,X               ; the last remaining character
F861 1F89             (    forth6809.asm):07021                     TFR   A,B

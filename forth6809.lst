                      (    forth6809.asm):01801         ; ------------------------------------------------------------
                      (    forth6809.asm):01802         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):01803         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):01804         ; GETCHAR
                      (    forth6809.asm):01805         ;    Inputs:
                      (    forth6809.asm):01806         ;        none
                      (    forth6809.asm):01807         ;    Outputs:
                      (    forth6809.asm):01808         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):01809         ;        Carry clear = character returned, set = ring empty

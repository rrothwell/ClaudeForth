                      (    forth6809.asm):02292         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):02293         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):02294         ; ------------------------------------------------------------
C18F                  (    forth6809.asm):02295         TSTDROT:   STU   TSTU0

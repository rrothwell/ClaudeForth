                      (    forth6809.asm):07757         ; ============================================================
                      (    forth6809.asm):07758                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):07759         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07760                  ORCC  #$50        ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):07761                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07762                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07763                  CLRA
FFAE 1F8B             (    forth6809.asm):07764                  TFR   A,DP
                      (    forth6809.asm):07765         
FFB0 8E0000           (    forth6809.asm):07766                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07767                  LDB   #0
FFB5 6F80             (    forth6809.asm):07768         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07769                  DECB
FFB8 26FB             (    forth6809.asm):07770                  BNE   CLRGLOB
                      (    forth6809.asm):07771         
FFBA BDDD4D           (    forth6809.asm):07772                  JSR   INITSERIAL
                      (    forth6809.asm):07773         
FFBD 1CAF             (    forth6809.asm):07774                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):07775         
                      (    forth6809.asm):07776                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07777                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07778                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07779                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07780                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07781                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07782                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07783                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07784                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07785                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07786                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07787                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07788                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07789                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07790                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07791                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07792                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07793                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07794                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07795                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07796                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07797                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07798                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07799                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07800                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07801                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07802                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07803                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07804                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07805                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07806                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07807                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07808                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07809                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07810                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07811                                  ; unused vectors).
                      (    forth6809.asm):07812         
                      (    forth6809.asm):07813                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07814                  JSR   TSTRUNNER
                      (    forth6809.asm):07815                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07816                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07817                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07818                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07819                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07820                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07821                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07822                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07823                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07824                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07825                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07826                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07827                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07828                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07829                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07830                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07831                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07832         
FFC2 7EDD6A           (    forth6809.asm):07833                  JMP   COLD
                      (    forth6809.asm):07834         
FFC5 1A50             (    forth6809.asm):07835         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):07836                  CLRA
FFC8 1F8B             (    forth6809.asm):07837                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07838                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07839                  LDS   #RP0
                      (    forth6809.asm):07840         
FFD1 BDDD4D           (    forth6809.asm):07841                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07842                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07843                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07844                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07845                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07846                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07847                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07848                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07849                                         ; reported separately) left either side
                      (    forth6809.asm):07850                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07851                                         ; would previously have inherited it
                      (    forth6809.asm):07852                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07853                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07854                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07855                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07856                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07857                                         ; only once setup is complete.
                      (    forth6809.asm):07858         
FFD4 8EFFE6           (    forth6809.asm):07859                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):07860                  PSHU  X
FFD9 CC0006           (    forth6809.asm):07861                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):07862                  PSHU  D
FFDE BDF4B3           (    forth6809.asm):07863                  JSR   TYPE
FFE1 1CAF             (    forth6809.asm):07864                  ANDCC #$AF
FFE3 7EDD9F           (    forth6809.asm):07865                  JMP   ABORT      ; Enable IRQ & FIRQ
                      (    forth6809.asm):07866         
FFE6 20207761726D     (    forth6809.asm):07867         WARMMSG: FCC   "  warm"
     0006             (    forth6809.asm):07868         WARMMSGL EQU   *-WARMMSG
                      (    forth6809.asm):07869         
     FFEC             (    forth6809.asm):07870         INITEND  EQU   *          ; Verify no collision with vectors, value should match vector ORG
     0048             (    forth6809.asm):07871         INITSIZE EQU   INITEND-INITCODE
                      (    forth6809.asm):07872         

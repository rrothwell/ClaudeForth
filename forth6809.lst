E856 ECC4             (    forth6809.asm):07451         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
E858 2713             (    forth6809.asm):07452                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
E85A AE44             (    forth6809.asm):07453                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
E85C 308B             (    forth6809.asm):07454                     LEAX  D,X               ; end address = c-addr1 + u

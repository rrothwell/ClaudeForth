                      (    forth6809.asm):02062         
                      (    forth6809.asm):02063         ; ------------------------------------------------------------
                      (    forth6809.asm):02064         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):02065         ; receiver-error counters to zero.
                      (    forth6809.asm):02066         ; SERBUFCLR
                      (    forth6809.asm):02067         ;    Inputs:
                      (    forth6809.asm):02068         ;        none
                      (    forth6809.asm):02069         ;    Outputs:
                      (    forth6809.asm):02070         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02071         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02072         ;    Registers: only CC changed.
                      (    forth6809.asm):02073         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):02074         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):02075         ; ------------------------------------------------------------
                      (    forth6809.asm):02076         
CE00 7F0176           (    forth6809.asm):02077         SERBUFCLR:  CLR   INHEAD
CE03 7F0177           (    forth6809.asm):02078                     CLR   INTAIL
CE06 7F0178           (    forth6809.asm):02079                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
CE09 7F0179           (    forth6809.asm):02080                     CLR   OUTHEAD
CE0C 7F017A           (    forth6809.asm):02081                     CLR   OUTTAIL
CE0F 7F017B           (    forth6809.asm):02082                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):02083         
                      (    forth6809.asm):02084         
CE12 7F017C           (    forth6809.asm):02085                     CLR   FECOUNT
CE15 7F017D           (    forth6809.asm):02086                     CLR   OVRNCOUNT
CE18 7F017E           (    forth6809.asm):02087                     CLR   PECOUNT
CE1B 7F017F           (    forth6809.asm):02088                     CLR   POLLREADYCNT
CE1E 39               (    forth6809.asm):02089                     RTS
                      (    forth6809.asm):02090         
                      (    forth6809.asm):02091         ; ------------------------------------------------------------
                      (    forth6809.asm):02092         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):02093         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):02094         ; INITSERIAL
                      (    forth6809.asm):02095         ;    Inputs:
                      (    forth6809.asm):02096         ;        none
                      (    forth6809.asm):02097         ;    Outputs:
                      (    forth6809.asm):02098         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):02099         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02100         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):02101         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):02102         ; ------------------------------------------------------------
CE1F BDCE00           (    forth6809.asm):02103         INITSERIAL: JSR   SERBUFCLR
CE22 8603             (    forth6809.asm):02104                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
CE24 B7C008           (    forth6809.asm):02105                     STA   ACIACR
CE27 12               (    forth6809.asm):02106                     NOP                     ; Settling Delay
CE28 12               (    forth6809.asm):02107                     NOP
                      (    forth6809.asm):02108         
                      (    forth6809.asm):02109                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02110                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02111                     ELSE                    ; <<<<<>>>>>
CE29 8615             (    forth6809.asm):02112                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02113                     ENDC                    ; <<<<<<<<<<
CE2B B7C008           (    forth6809.asm):02114                     STA   ACIACR            ; See bugfix: INITSERIAL.1
CE2E 39               (    forth6809.asm):02115                     RTS
                      (    forth6809.asm):02116         
                      (    forth6809.asm):02117                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02118         ; ------------------------------------------------------------
                      (    forth6809.asm):02119         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02120         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02121         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02122         ; INFILL
                      (    forth6809.asm):02123         ;    Inputs:
                      (    forth6809.asm):02124         ;        none
                      (    forth6809.asm):02125         ;    Outputs:
                      (    forth6809.asm):02126         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02127         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02128         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02129         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02130                     SUBA  INTAIL
                      (    forth6809.asm):02131                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):02132                     RTS
                      (    forth6809.asm):02133         ; ------------------------------------------------------------
                      (    forth6809.asm):02134         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02135         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02136         ; receive path with interrupts already masked.
                      (    forth6809.asm):02137         ; RTSCHECKHI
                      (    forth6809.asm):02138         ;    Inputs:
                      (    forth6809.asm):02139         ;        none
                      (    forth6809.asm):02140         ;    Outputs:
                      (    forth6809.asm):02141         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02142         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02143         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02144         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):02145                     CMPA  #INHIWATER
                      (    forth6809.asm):02146                     BLO   RTSCHIDONE
                      (    forth6809.asm):02147                     TST   RTSSTATE
                      (    forth6809.asm):02148                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):02149                     LDA   #CR_RTSHI
                      (    forth6809.asm):02150                     STA   ACIACR
                      (    forth6809.asm):02151                     LDA   #1
                      (    forth6809.asm):02152                     STA   RTSSTATE
CE2F                  (    forth6809.asm):02153         RTSCHIDONE: RTS
                      (    forth6809.asm):02154         ; ------------------------------------------------------------
                      (    forth6809.asm):02155         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02156         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02157         ; enables it only while output is pending.
                      (    forth6809.asm):02158         ; UPDATE_RTS
                      (    forth6809.asm):02159         ;    Inputs:
                      (    forth6809.asm):02160         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02161         ;    Outputs:
                      (    forth6809.asm):02162         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02163         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02164         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02165         UPDATE_RTS:
                      (    forth6809.asm):02166                     TST   RTSSTATE
                      (    forth6809.asm):02167                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02168         
                      (    forth6809.asm):02169                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02170                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02171         
                      (    forth6809.asm):02172                                             ; $B5/%1011_0101
                      (    forth6809.asm):02173                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02174                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02175         
CE2F                  (    forth6809.asm):02176         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02177                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02178                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02179         
CE2F                  (    forth6809.asm):02180         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02181                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02182                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CE2F                  (    forth6809.asm):02183         WRITE_CR:
                      (    forth6809.asm):02184                     STA   ACIACR
                      (    forth6809.asm):02185                     RTS
                      (    forth6809.asm):02186         ; ------------------------------------------------------------
                      (    forth6809.asm):02187         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02188         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02189         ; Called after a character is added to the ring.
                      (    forth6809.asm):02190         ; CHKHI
                      (    forth6809.asm):02191         ;    Inputs:
                      (    forth6809.asm):02192         ;        RegB = input ring fill level
                      (    forth6809.asm):02193         ;    Outputs:
                      (    forth6809.asm):02194         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02195         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02196         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02197         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02198         CHKHI:
                      (    forth6809.asm):02199                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02200                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02201                     TST   RTSSTATE
                      (    forth6809.asm):02202                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02203                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02204                     STA   RTSSTATE
                      (    forth6809.asm):02205                     JSR   UPDATE_RTS
CE2F                  (    forth6809.asm):02206         CHKHIDONE:  RTS
                      (    forth6809.asm):02207         
                      (    forth6809.asm):02208         ; ------------------------------------------------------------
                      (    forth6809.asm):02209         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02210         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02211         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02212         ; CHKLO
                      (    forth6809.asm):02213         ;    Inputs:
                      (    forth6809.asm):02214         ;        RegB = input ring fill level
                      (    forth6809.asm):02215         ;    Outputs:
                      (    forth6809.asm):02216         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02217         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02218         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02219         CHKLO:
                      (    forth6809.asm):02220                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02221                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02222                     TST   RTSSTATE
                      (    forth6809.asm):02223                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02224                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02225                     STA   RTSSTATE
                      (    forth6809.asm):02226                     JSR   UPDATE_RTS
CE2F                  (    forth6809.asm):02227         CHKLODONE:  RTS
                      (    forth6809.asm):02228         ; ------------------------------------------------------------
                      (    forth6809.asm):02229         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02230         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02231         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02232         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02233         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02234         ;    Inputs:
                      (    forth6809.asm):02235         ;        none
                      (    forth6809.asm):02236         ;    Outputs:
                      (    forth6809.asm):02237         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02238         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02239         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02240         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02241         FLUSHOUTBUFFER:
                      (    forth6809.asm):02242                     LDB   OUTTAIL
                      (    forth6809.asm):02243                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02244                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02245         
                      (    forth6809.asm):02246                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02247                     BITA  #SR_CTS
                      (    forth6809.asm):02248                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02249         
                      (    forth6809.asm):02250                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02251                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02252                                             ; than spin-wait here.
                      (    forth6809.asm):02253         
                      (    forth6809.asm):02254                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02255                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02256                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02257         
                      (    forth6809.asm):02258                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02259                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02260                     STB   OUTTAIL
                      (    forth6809.asm):02261                                             ; One character sent - return rather than
                      (    forth6809.asm):02262                                             ; loop back for more (see header comment).
CE2F                  (    forth6809.asm):02263         FLUSHED:
                      (    forth6809.asm):02264                     RTS
                      (    forth6809.asm):02265         ; ------------------------------------------------------------
                      (    forth6809.asm):02266         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02267         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02268         ; PUTCHAR
                      (    forth6809.asm):02269         ;    Inputs:
                      (    forth6809.asm):02270         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02271         ;    Outputs:
                      (    forth6809.asm):02272         ;        none
                      (    forth6809.asm):02273         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02274         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02275         PUTCHAR:
                      (    forth6809.asm):02276                     PSHS  CC,X
                      (    forth6809.asm):02277                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02280                     INCB
                      (    forth6809.asm):02281                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02282                     CMPB  OUTTAIL
                      (    forth6809.asm):02283                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02284         
                      (    forth6809.asm):02285                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02286                     LDB   OUTHEAD
                      (    forth6809.asm):02287                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02288         
                      (    forth6809.asm):02289                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02290                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02291                     STB   OUTHEAD
                      (    forth6809.asm):02292         
                      (    forth6809.asm):02293                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02294                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02295         
                      (    forth6809.asm):02296                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02297                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02298                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02299                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02300                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02301                                             ; expects the critical section active
                      (    forth6809.asm):02302         
                      (    forth6809.asm):02303                     BRA   PUT_EXIT
                      (    forth6809.asm):02304         
                      (    forth6809.asm):02305         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02306         ; priming the pump by transmitting a character.
CE2F                  (    forth6809.asm):02307         CHK_INT_PATH:
                      (    forth6809.asm):02308                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02309                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02310         
                      (    forth6809.asm):02311                                             ; No! Restart.
                      (    forth6809.asm):02312                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02313                     LDB   OUTTAIL
                      (    forth6809.asm):02314                     LDA   B,X
                      (    forth6809.asm):02315                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02316         
                      (    forth6809.asm):02317                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02318                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02319                     STB   OUTTAIL
                      (    forth6809.asm):02320         
                      (    forth6809.asm):02321                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02322                     STA   OUTACTIVITY
                      (    forth6809.asm):02323                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02324         
CE2F                  (    forth6809.asm):02325         PUT_EXIT:
                      (    forth6809.asm):02326                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02327                                             ; by restoring the CC.
                      (    forth6809.asm):02328         ; ------------------------------------------------------------
                      (    forth6809.asm):02329         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02330         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02331         ; GETCHAR
                      (    forth6809.asm):02332         ;    Inputs:
                      (    forth6809.asm):02333         ;        none
                      (    forth6809.asm):02334         ;    Outputs:
                      (    forth6809.asm):02335         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02336         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02337         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02338         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02339         GETCHAR:
                      (    forth6809.asm):02340                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02341                     CMPB  INHEAD
                      (    forth6809.asm):02342                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02343         
                      (    forth6809.asm):02344                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02345                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02346         
                      (    forth6809.asm):02347                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02348                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02349                     STB   INTAIL
                      (    forth6809.asm):02350         
                      (    forth6809.asm):02351                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02352                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02353                     ORCC  #$10
                      (    forth6809.asm):02354                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02355                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02356                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02357                                             ; there's no already-loaded value here
                      (    forth6809.asm):02358                                             ; worth reusing.
                      (    forth6809.asm):02359                     JSR   CHKLO
                      (    forth6809.asm):02360                     ANDCC #$EF
                      (    forth6809.asm):02361         
                      (    forth6809.asm):02362                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02363                     RTS
                      (    forth6809.asm):02364         
CE2F                  (    forth6809.asm):02365         GET_NO_CHAR:
                      (    forth6809.asm):02366                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02367                     RTS
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
                      (    forth6809.asm):02369         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02370         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02371         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02372         ; RTSCHECKLO
                      (    forth6809.asm):02373         ;    Inputs:
                      (    forth6809.asm):02374         ;        none
                      (    forth6809.asm):02375         ;    Outputs:
                      (    forth6809.asm):02376         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02377         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02378         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02379         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02380         RTSCHECKLO:
                      (    forth6809.asm):02381                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02382         
                      (    forth6809.asm):02383                     JSR   INFILL
                      (    forth6809.asm):02384                     CMPA  #INLOWATER
                      (    forth6809.asm):02385                     BHI   RTSCLODONE
                      (    forth6809.asm):02386                     TST   RTSSTATE
                      (    forth6809.asm):02387                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02388         
                      (    forth6809.asm):02389         
                      (    forth6809.asm):02390                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02391         
                      (    forth6809.asm):02392                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02393                     CMPB  OUTHEAD
                      (    forth6809.asm):02394                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02395         
                      (    forth6809.asm):02396                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02397                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02398                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02399         
CE2F                  (    forth6809.asm):02400         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02401                     STA   ACIACR
                      (    forth6809.asm):02402         
CE2F                  (    forth6809.asm):02403         RTSCLOUNMASK:
                      (    forth6809.asm):02404                     ANDCC #$EF
                      (    forth6809.asm):02405         
CE2F                  (    forth6809.asm):02406         RTSCLODONE: RTS
                      (    forth6809.asm):02407         
                      (    forth6809.asm):02408         ; ------------------------------------------------------------
                      (    forth6809.asm):02409         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02410         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02411         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02412         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02413         ; IRQH
                      (    forth6809.asm):02414         ;    Inputs:
                      (    forth6809.asm):02415         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02416         ;    Outputs:
                      (    forth6809.asm):02417         ;        none (returns with RTI)
                      (    forth6809.asm):02418         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02419         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02420         ; ------------------------------------------------------------
CE2F                  (    forth6809.asm):02421         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02422         
                      (    forth6809.asm):02423                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02424                     BEQ   IRQCHN            ; No! Pass it down the chain.
                      (    forth6809.asm):02425                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02426                     BNE   INCHAR
                      (    forth6809.asm):02427                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02428                     BNE   OUTCHAR
                      (    forth6809.asm):02429                                             ; Ignore all other interrupts such as DCD change.
CE2F                  (    forth6809.asm):02430         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02431                                             ; & restores state.
CE2F                  (    forth6809.asm):02432         IRQRTI      EQU   IRQDONE0          ; IRQCHAIN initially points here
CE2F                  (    forth6809.asm):02433         IRQCHN:     JMP   [IRQCHAIN]        ; not the ACIA: next handler in the chain.
                      (    forth6809.asm):02434                                             ; See shadow IRQH.1
                      (    forth6809.asm):02435         
CE2F                  (    forth6809.asm):02436         INCHAR:
                      (    forth6809.asm):02437                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02438                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02439                                             ; Any receiver error flagged?
                      (    forth6809.asm):02440                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02441         
                      (    forth6809.asm):02442                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02443                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02444                     INC   FECOUNT           ; more than one bit can be set at once.
CE2F                  (    forth6809.asm):02445         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02446                     BEQ   INXOVRN
                      (    forth6809.asm):02447                     INC   OVRNCOUNT
CE2F                  (    forth6809.asm):02448         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02449                     BEQ   INXPE
                      (    forth6809.asm):02450                     INC   PECOUNT
CE2F                  (    forth6809.asm):02451         INXPE:      RTI
                      (    forth6809.asm):02452         
CE2F                  (    forth6809.asm):02453         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02454                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02455                     LDB   INHEAD
                      (    forth6809.asm):02456                     STA   B,X
                      (    forth6809.asm):02457                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02458                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02459                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02460                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02461                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02462                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02463                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02464                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02465                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02466                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02467                     JSR   CHKHI             ; Protect the in buffer from overflow.
CE2F                  (    forth6809.asm):02468         IRQDONE1:   RTI
                      (    forth6809.asm):02469         
                      (    forth6809.asm):02470                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02471         
CE2F                  (    forth6809.asm):02472         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02473                     CMPB  OUTHEAD
                      (    forth6809.asm):02474                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02475         
                      (    forth6809.asm):02476                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02477                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02478                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02479         
                      (    forth6809.asm):02480                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02481                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02482                     STB   OUTTAIL
CE2F                  (    forth6809.asm):02483         IRQDONE2    RTI
                      (    forth6809.asm):02484         
CE2F                  (    forth6809.asm):02485         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02486                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02487                     CLR   OUTACTIVITY
                      (    forth6809.asm):02488                     JSR   UPDATE_RTS
CE2F                  (    forth6809.asm):02489         IRQDONE3    RTI
                      (    forth6809.asm):02490         
                      (    forth6809.asm):02491                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02492         
CE2F 6E9F0083         (    forth6809.asm):02493         IRQH:       JMP   [IRQCHAIN]        ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02494                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02495                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02496                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02497                                             ; the other unused vectors below
CE33 3B               (    forth6809.asm):02498         IRQRTI:     RTI                     ; IRQCHAIN initially points here
                      (    forth6809.asm):02499                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02500         
                      (    forth6809.asm):02501         ; ------------------------------------------------------------
                      (    forth6809.asm):02502         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02503         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02504         ; ------------------------------------------------------------
CE34 3B               (    forth6809.asm):02505         SWI3H:      RTI
CE35 3B               (    forth6809.asm):02506         SWI2H:      RTI
CE36 3B               (    forth6809.asm):02507         FIRQH:      RTI
CE37 3B               (    forth6809.asm):02508         NMIH:       RTI                     ; unused now that NMI -> WARM
CE38 CCFF9D           (    forth6809.asm):02509         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
CE3B 3606             (    forth6809.asm):02510                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
CE3D 7ED905           (    forth6809.asm):02511                     JMP   THROWW
                      (    forth6809.asm):02512         
                      (    forth6809.asm):02513         ; ============================================================
                      (    forth6809.asm):02514         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02515         ; ============================================================
                      (    forth6809.asm):02516         ; ------------------------------------------------------------
                      (    forth6809.asm):02517         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02518         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02519         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02520         ; COLD
                      (    forth6809.asm):02521         ;    Inputs:
                      (    forth6809.asm):02522         ;        none (entered at reset)
                      (    forth6809.asm):02523         ;    Outputs:
                      (    forth6809.asm):02524         ;        none (does not return)
                      (    forth6809.asm):02525         ;    Registers: all changed.
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
CE40 CC0240           (    forth6809.asm):02527         COLD:       LDD   #APPVARS
CE43 DD0A             (    forth6809.asm):02528                     STD   VARHERE
CE45 CC7000           (    forth6809.asm):02529                     LDD   #APPCODE
CE48 DD08             (    forth6809.asm):02530                     STD   CODEHERE
CE4A CC2000           (    forth6809.asm):02531                     LDD   #APPDICT
CE4D DD06             (    forth6809.asm):02532                     STD   DPHERE
CE4F CCCDFA           (    forth6809.asm):02533                     LDD   #BASELATEST
CE52 DD04             (    forth6809.asm):02534                     STD   LATEST
CE54 BDD4D5           (    forth6809.asm):02535                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02536         
CE57 CC000A           (    forth6809.asm):02537                     LDD   #10
CE5A DD02             (    forth6809.asm):02538                     STD   BASE
                      (    forth6809.asm):02539         
CE5C CC0106           (    forth6809.asm):02540                     LDD   #TIBBUF
CE5F DD39             (    forth6809.asm):02541                     STD   SRCADDR
CE61 CC0000           (    forth6809.asm):02542                     LDD   #0
CE64 DD3B             (    forth6809.asm):02543                     STD   SRCLEN
CE66 DD3D             (    forth6809.asm):02544                     STD   SRCID
                      (    forth6809.asm):02545         
CE68 8ECF15           (    forth6809.asm):02546                     LDX   #SIGNON
CE6B 3610             (    forth6809.asm):02547                     PSHU  X                 ; c-addr
CE6D CC000F           (    forth6809.asm):02548                     LDD   #SIGNONL
CE70 3606             (    forth6809.asm):02549                     PSHU  D                 ; u

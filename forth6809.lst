E301 273B             (    forth6809.asm):02964                     BEQ   BADWORD
                      (    forth6809.asm):02965         
E303 10830001         (    forth6809.asm):02966                     CMPD  #1                ; 1 = double-number result
E307 2711             (    forth6809.asm):02967                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):02968         
E309 DC00             (    forth6809.asm):02969                     LDD   STATE
E30B 27C2             (    forth6809.asm):02970                     BEQ   ILOOP
E30D CCDF67           (    forth6809.asm):02971                     LDD   #LIT
E310 3606             (    forth6809.asm):02972                     PSHU  D
E312 BDEABB           (    forth6809.asm):02973                     JSR   CCALL
E315 BDE002           (    forth6809.asm):02974                     JSR   CODECOMMA
E318 20B5             (    forth6809.asm):02975                     BRA   ILOOP
                      (    forth6809.asm):02976         
E31A                  (    forth6809.asm):02977         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):02978                                             ; ANS's (ud1) stack order directly.
E31A DC00             (    forth6809.asm):02979                     LDD   STATE
E31C 27B1             (    forth6809.asm):02980                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):02981                                             ; nothing more to do
                      (    forth6809.asm):02982                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):02983                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):02984                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):02985                     ; pop it aside first, freeing UDLO to be compiled first.
E31E 3706             (    forth6809.asm):02986                     PULU  D
E320 DD2F             (    forth6809.asm):02987                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):02988                                             ; untouched by CCALL/CODECOMMA
E322 CCDF67           (    forth6809.asm):02989                     LDD   #LIT
E325 3606             (    forth6809.asm):02990                     PSHU  D
E327 BDEABB           (    forth6809.asm):02991                     JSR   CCALL
E32A BDE002           (    forth6809.asm):02992                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
E32D CCDF67           (    forth6809.asm):02993                     LDD   #LIT
E330 3606             (    forth6809.asm):02994                     PSHU  D
E332 BDEABB           (    forth6809.asm):02995                     JSR   CCALL

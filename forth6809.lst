                      (    forth6809.asm):04201         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04202         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04203         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04204         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04205         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04206         ;    Inputs:
                      (    forth6809.asm):04207         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04208         ;    Outputs:
                      (    forth6809.asm):04209         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04210         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04211         ;        scratch.
                      (    forth6809.asm):04212         ; ------------------------------------------------------------
E7C5 3706             (    forth6809.asm):04213         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E7C7 DD29             (    forth6809.asm):04214                     STD   MSCR              ; MSCR = step
E7C9 EC66             (    forth6809.asm):04215                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E7CB 262D             (    forth6809.asm):04216                     BNE   DPTEXIT           ; set: exit
E7CD EC62             (    forth6809.asm):04217                     LDD   2,S               ; old index
E7CF A364             (    forth6809.asm):04218                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E7D1 DD2B             (    forth6809.asm):04219                     STD   MSCR2
E7D3 EC62             (    forth6809.asm):04220                     LDD   2,S
E7D5 D329             (    forth6809.asm):04221                     ADDD  MSCR              ; new_index = old_index + step
E7D7 ED62             (    forth6809.asm):04222                     STD   2,S
E7D9 A364             (    forth6809.asm):04223                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E7DB DD2D             (    forth6809.asm):04224                     STD   MSCR3
                      (    forth6809.asm):04225                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04226                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04227                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E7DD DC29             (    forth6809.asm):04228                     LDD   MSCR              ; reload the step to test its sign
E7DF 2B09             (    forth6809.asm):04229                     BMI   DPNEG
E7E1 DC2D             (    forth6809.asm):04230         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E7E3 10932B           (    forth6809.asm):04231                     CMPD  MSCR2

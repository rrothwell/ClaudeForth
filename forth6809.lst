D915 8141             (    forth6809.asm):04220                     CMPA  #'A'
D917 251E             (    forth6809.asm):04221                     BLO   NLDONE
D919 815A             (    forth6809.asm):04222                     CMPA  #'Z'
D91B 221A             (    forth6809.asm):04223                     BHI   NLDONE
D91D 8037             (    forth6809.asm):04224                     SUBA  #'A'-10
D91F 9103             (    forth6809.asm):04225         NLGOT:      CMPA  BASE+1
D921 2414             (    forth6809.asm):04226                     BHS   NLDONE
D923 1F89             (    forth6809.asm):04227                     TFR   A,B

                      (    forth6809.asm):04962         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04963         ; return address.
                      (    forth6809.asm):04964         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04965         ;    Inputs:
                      (    forth6809.asm):04966         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04967         ;    Outputs:
                      (    forth6809.asm):04968         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04969         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04970         ; ------------------------------------------------------------
DC7F 3706             (    forth6809.asm):04971         DOSETUP:    PULU  D                 ; index
DC81 DD14             (    forth6809.asm):04972                     STD   MSCR
DC83 3706             (    forth6809.asm):04973                     PULU  D                 ; limit
DC85 DD16             (    forth6809.asm):04974                     STD   MSCR2
DC87 3510             (    forth6809.asm):04975                     PULS  X
DC89 CC0000           (    forth6809.asm):04976                     LDD   #0
DC8C 3406             (    forth6809.asm):04977                     PSHS  D

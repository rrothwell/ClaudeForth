                      (    forth6809.asm):00890         ; ------------------------------------------------------------
                      (    forth6809.asm):00891         ; TSTSYSIO - System/Console I/O tests (glossary section 3.1, 12
                      (    forth6809.asm):00892         ; words, 7 tests). Six words are deliberately NOT tested here -
                      (    forth6809.asm):00893         ; KEY, ACCEPT, EXPECT, and QUERY all genuinely block on real
                      (    forth6809.asm):00894         ; input during automated, headless boot-time testing (confirmed
                      (    forth6809.asm):00895         ; by reading their own implementations: KEY spins on itself,
                      (    forth6809.asm):00896         ; ACCEPT calls KEY directly, EXPECT/QUERY both call ACCEPT); and
                      (    forth6809.asm):00897         ; ABORT/QUIT are both designed to never return (ABORT falls
                      (    forth6809.asm):00898         ; through into QUIT, which resets the return stack, discarding
                      (    forth6809.asm):00899         ; this entire call chain and hijacking the boot sequence into
                      (    forth6809.asm):00900         ; the interpreter's own top-level loop). See this group's own
                      (    forth6809.asm):00901         ; leading comment block, right before TSTKEYQ, for the full
                      (    forth6809.asm):00902         ; reasoning.
                      (    forth6809.asm):00903         ;
                      (    forth6809.asm):00904         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00905         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00906         ; thousands of times already across every prior test group.
                      (    forth6809.asm):00907         ; Each test here verifies the real queuing mechanism (OUTHEAD/
                      (    forth6809.asm):00908         ; OUTBUF), reading the actual character(s) back out of the
                      (    forth6809.asm):00909         ; output ring buffer to confirm they were genuinely queued, not
                      (    forth6809.asm):00910         ; just that the call returned without crashing.
                      (    forth6809.asm):00911         ; ------------------------------------------------------------
C163 BDFC2B           (    forth6809.asm):00912         TSTSYSIO: JSR   CRW
C166 8EC177           (    forth6809.asm):00913                    LDX   #TSTSYSIOMSG
C169 3610             (    forth6809.asm):00914                    PSHU  X
C16B CC0005           (    forth6809.asm):00915                    LDD   #5
C16E 3606             (    forth6809.asm):00916                    PSHU  D
C170 BDF60B           (    forth6809.asm):00917                    JSR   TYPE
C173 BDFC2B           (    forth6809.asm):00918                    JSR   CRW
                      (    forth6809.asm):00919         
                      (    forth6809.asm):00920                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00921         
                      (    forth6809.asm):00922                    JSR   TSTKEYQ
                      (    forth6809.asm):00923                    JSR   TSTEMIT
                      (    forth6809.asm):00924                    JSR   TSTCR
                      (    forth6809.asm):00925                    JSR   TSTSPACE
                      (    forth6809.asm):00926                    JSR   TSTSPACES
                      (    forth6809.asm):00927                    JSR   TSTSPACESZ
                      (    forth6809.asm):00928                    JSR   TSTTYPE
                      (    forth6809.asm):00929         
                      (    forth6809.asm):00930                    ENDC ; <<<<
                      (    forth6809.asm):00931         
C176 39               (    forth6809.asm):00932                    RTS
                      (    forth6809.asm):00933         
C177 537973494F       (    forth6809.asm):00934         TSTSYSIOMSG: FCC "SysIO"
                      (    forth6809.asm):00935         
                      (    forth6809.asm):00936                    IFEQ TSTSELECTOR-0  ; >>>>

                      (    forth6809.asm):08643                  LBNE   ISFAIL  ; was BNE - out of short-branch range, since
                      (    forth6809.asm):08644                                 ; ISFAIL sits past this test's entire second
                      (    forth6809.asm):08645                                 ; phase (the ACTION-OF lookup and re-check)
                      (    forth6809.asm):08646                  PULU  D
                      (    forth6809.asm):08647                  CMPD  #TSTVAL1
                      (    forth6809.asm):08648                  BNE   ISFAIL
                      (    forth6809.asm):08649                  PULU  D
                      (    forth6809.asm):08650                  CMPD  #TSTGUARD
                      (    forth6809.asm):08651                  BNE   ISFAIL
                      (    forth6809.asm):08652         
                      (    forth6809.asm):08653                  LDD   TSTUB4
                      (    forth6809.asm):08654                  SUBD  TSTUAF
                      (    forth6809.asm):08655                  CMPD  #2
                      (    forth6809.asm):08656                  BNE   ISFAIL
                      (    forth6809.asm):08657         
                      (    forth6809.asm):08658                  LDA   #'T'
                      (    forth6809.asm):08659                  STA   TSTNAMEB
                      (    forth6809.asm):08660                  LDA   #'E'
                      (    forth6809.asm):08661                  STA   TSTNAMEB+1
                      (    forth6809.asm):08662                  LDA   #'S'
                      (    forth6809.asm):08663                  STA   TSTNAMEB+2
                      (    forth6809.asm):08664                  LDA   #'T'
                      (    forth6809.asm):08665                  STA   TSTNAMEB+3
                      (    forth6809.asm):08666                  LDA   #'W'
                      (    forth6809.asm):08667                  STA   TSTNAMEB+4
                      (    forth6809.asm):08668                  LDA   #'D'
                      (    forth6809.asm):08669                  STA   TSTNAMEB+5
                      (    forth6809.asm):08670                  LDD   #TSTNAMEB
                      (    forth6809.asm):08671                  STD   SRCADDR
                      (    forth6809.asm):08672                  LDD   #6
                      (    forth6809.asm):08673                  STD   SRCLEN
                      (    forth6809.asm):08674                  LDD   #0
                      (    forth6809.asm):08675                  STD   TOIN
                      (    forth6809.asm):08676         
                      (    forth6809.asm):08677                  LDD   #TSTCBUF2  ; BUG FIX: same missing redirect as before
                      (    forth6809.asm):08678                                   ; ISW above - ACTIONOF's own internal WORD
                      (    forth6809.asm):08679                                   ; call needs somewhere safe to write its
                      (    forth6809.asm):08680                                   ; parsed-token output too.
                      (    forth6809.asm):08681                  STD   CODEHERE
                      (    forth6809.asm):08682         

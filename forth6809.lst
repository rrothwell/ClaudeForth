CFC9 CC7000           (    forth6809.asm):02529                     LDD   #APPCODE
CFCC DD08             (    forth6809.asm):02530                     STD   CODEHERE
CFCE CC2000           (    forth6809.asm):02531                     LDD   #APPDICT
CFD1 DD06             (    forth6809.asm):02532                     STD   DPHERE
CFD3 CCCDFA           (    forth6809.asm):02533                     LDD   #BASELATEST
CFD6 DD04             (    forth6809.asm):02534                     STD   LATEST

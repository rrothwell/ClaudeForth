DE96 3440             (    forth6809.asm):05781                     PSHS  U
DE98 A3E1             (    forth6809.asm):05782                     SUBD  ,S++
DE9A 44               (    forth6809.asm):05783                     LSRA
DE9B 56               (    forth6809.asm):05784                     RORB
DE9C 3606             (    forth6809.asm):05785                     PSHU  D                 ; +n
DE9E 39               (    forth6809.asm):05786                     RTS
                      (    forth6809.asm):05787         
                      (    forth6809.asm):05788         ; ------------------------------------------------------------
                      (    forth6809.asm):05789         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )
                      (    forth6809.asm):05790         ; Duplicate the top cell pair.
                      (    forth6809.asm):05791         ; ------------------------------------------------------------
DE9F EC42             (    forth6809.asm):05792         DDUPW:      LDD   2,U               ; x1
DEA1 AEC4             (    forth6809.asm):05793                     LDX   ,U                ; x2
DEA3 3606             (    forth6809.asm):05794                     PSHU  D
DEA5 3610             (    forth6809.asm):05795                     PSHU  X
DEA7 39               (    forth6809.asm):05796                     RTS
                      (    forth6809.asm):05797         
                      (    forth6809.asm):05798         ; ------------------------------------------------------------
                      (    forth6809.asm):05799         ; 2DROP  ( x1 x2 -- )

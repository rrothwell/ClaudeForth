                      (    forth6809.asm):05760         
                      (    forth6809.asm):05761                  LDD   #OPRTS
                      (    forth6809.asm):05762                  PSHU  D
                      (    forth6809.asm):05763                  JSR   CCOMMA
                      (    forth6809.asm):05764         
                      (    forth6809.asm):05765                  LDD   TSTCSAV
                      (    forth6809.asm):05766                  STD   CODEHERE
                      (    forth6809.asm):05767         
                      (    forth6809.asm):05768                  STU   TSTU0
                      (    forth6809.asm):05769         
                      (    forth6809.asm):05770                  LDD   #TSTGUARD
                      (    forth6809.asm):05771                  PSHU  D
                      (    forth6809.asm):05772                  LDD   #FALSEV
                      (    forth6809.asm):05773                  PSHU  D
                      (    forth6809.asm):05774                  STU   TSTUB4
                      (    forth6809.asm):05775         
                      (    forth6809.asm):05776                  JSR   TSTCBUF
                      (    forth6809.asm):05777         
                      (    forth6809.asm):05778                  STU   TSTUAF
                      (    forth6809.asm):05779         
                      (    forth6809.asm):05780                  PULU  D
                      (    forth6809.asm):05781                  CMPD  #TSTGUARD
                      (    forth6809.asm):05782                  BNE   T2FAIL
                      (    forth6809.asm):05783         
                      (    forth6809.asm):05784                  LDD   TSTUB4
                      (    forth6809.asm):05785                  SUBD  TSTUAF
                      (    forth6809.asm):05786                  CMPD  #-2
                      (    forth6809.asm):05787                  BNE   T2FAIL
                      (    forth6809.asm):05788         
                      (    forth6809.asm):05789                  LDD   #TRUEV
                      (    forth6809.asm):05790                  BRA   T2DONE
C3C7                  (    forth6809.asm):05791         T2FAIL:  LDD   #FALSEV
C3C7                  (    forth6809.asm):05792         T2DONE:  LDX   #TSTIFT2NAME
                      (    forth6809.asm):05793                  PSHU  X
                      (    forth6809.asm):05794                  PSHU  D
                      (    forth6809.asm):05795                  JSR   TSTREPORT
                      (    forth6809.asm):05796         
                      (    forth6809.asm):05797                  LDU   TSTU0
                      (    forth6809.asm):05798                  RTS
                      (    forth6809.asm):05799         
C3C7                  (    forth6809.asm):05800         TSTIFT2NAME: FCB  7
                      (    forth6809.asm):05801                      FCC  "TSTIFT2"

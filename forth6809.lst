                      (    forth6809.asm):01850         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01851         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01852         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01853         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01854         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01855         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01856         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01857         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01858         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01859         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01860         ; were chained on after H_QUIT in a later turn.
DFD4 05               (    forth6809.asm):01861         H_ABORT: FCB   5
DFD5 41424F5254       (    forth6809.asm):01862                  FCC   "ABORT"
DFDA DFCA             (    forth6809.asm):01863                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01864                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01865                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01866                                        ; now H_FALSE, the chain's newest entry
DFDC E057             (    forth6809.asm):01867                  FDB   ABORT
                      (    forth6809.asm):01868         

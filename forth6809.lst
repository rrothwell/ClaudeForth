                      (    forth6809.asm):07688         ; ============================================================
                      (    forth6809.asm):07689         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07690         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07691         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07692         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07693         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07694         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07695         ; ============================================================
                      (    forth6809.asm):07696         ; ------------------------------------------------------------
                      (    forth6809.asm):07697         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07698         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07699         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07700         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07701         ; - no indirection, no value cell.
                      (    forth6809.asm):07702         ;
                      (    forth6809.asm):07703         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07704         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07705         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07706         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07707         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07708         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07709         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07710         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07711         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07712         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07713         ; ------------------------------------------------------------
FDDF CCFFFF           (    forth6809.asm):07714         TRUEBODY:  LDD   #$FFFF
FDE2 3606             (    forth6809.asm):07715                    PSHU  D
FDE4 39               (    forth6809.asm):07716                    RTS
                      (    forth6809.asm):07717         
FDE5 CC0000           (    forth6809.asm):07718         FALSEBODY: LDD   #$0000
FDE8 3606             (    forth6809.asm):07719                    PSHU  D
FDEA 39               (    forth6809.asm):07720                    RTS
                      (    forth6809.asm):07721         
                      (    forth6809.asm):07722         ; ------------------------------------------------------------
                      (    forth6809.asm):07723         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07724         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07725         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07726         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07727         ; ------------------------------------------------------------
FDEB CC0001           (    forth6809.asm):07728         ONEBODY:   LDD   #1
FDEE 3606             (    forth6809.asm):07729                    PSHU  D
FDF0 39               (    forth6809.asm):07730                    RTS
                      (    forth6809.asm):07731         
FDF1 CCFFFF           (    forth6809.asm):07732         MONEBODY:  LDD   #-1
FDF4 3606             (    forth6809.asm):07733                    PSHU  D
FDF6 39               (    forth6809.asm):07734                    RTS
                      (    forth6809.asm):07735         
FDF7 CC0002           (    forth6809.asm):07736         TWOBODY:   LDD   #2
FDFA 3606             (    forth6809.asm):07737                    PSHU  D
FDFC 39               (    forth6809.asm):07738                    RTS
                      (    forth6809.asm):07739         
FDFD CCFFFE           (    forth6809.asm):07740         MTWOBODY:  LDD   #-2
FE00 3606             (    forth6809.asm):07741                    PSHU  D
FE02 39               (    forth6809.asm):07742                    RTS
                      (    forth6809.asm):07743         
                      (    forth6809.asm):07744         ; Verify no collision with init code,
                      (    forth6809.asm):07745         ; value should match ORG INITCODE.
     FE03             (    forth6809.asm):07746         BASECODEEND  EQU   *
     20D5             (    forth6809.asm):07747         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07748         
                      (    forth6809.asm):07749         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07750         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07751         ; .bin file.
FE03                  (    forth6809.asm):07752         BASEND:
FE03 FFFFFFFFFFFFFFFF (    forth6809.asm):07753                  FILL $FF,INITCODE-BASEND

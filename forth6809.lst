                      (    forth6809.asm):12691         ; TSTSQUOTE2 - unit test for S", interpreting-state case.
                      (    forth6809.asm):12692         ; Redirects CODEHERE first so PAD's own computed address (which
                      (    forth6809.asm):12693         ; SQUOTE's own interpreting branch writes to) is predictable,
                      (    forth6809.asm):12694         ; then calls S" directly (no compile/execute step needed, since
                      (    forth6809.asm):12695         ; interpreting S" stages the string and returns immediately) and
                      (    forth6809.asm):12696         ; verifies the returned (addr len) content, plus that addr
                      (    forth6809.asm):12697         ; genuinely landed at PAD's current, redirected address.
                      (    forth6809.asm):12698         ; ------------------------------------------------------------
C2AE                  (    forth6809.asm):12699         TSTSQUOTE2: LDD  CODEHERE
                      (    forth6809.asm):12700                     STD  TSTCSAV

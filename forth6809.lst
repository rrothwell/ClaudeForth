DD32 46494E44         (    forth6809.asm):02070                  FCC   "FIND"
DD36 DD28             (    forth6809.asm):02071                  FDB   H_QUIT
DD38 E321             (    forth6809.asm):02072                  FDB   FIND
                      (    forth6809.asm):02073         
DD3A 01               (    forth6809.asm):02074         H_1:     FCB   1
DD3B 31               (    forth6809.asm):02075                  FCC   "1"
DD3C DD31             (    forth6809.asm):02076                  FDB   H_FIND
DD3E FEAD             (    forth6809.asm):02077                  FDB   ONEBODY
                      (    forth6809.asm):02078         

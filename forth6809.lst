                      (    forth6809.asm):05960                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):05961                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):05962                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):05963                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):05964                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):05965                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):05966                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):05967                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):05968                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):05969                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):05970                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):05971                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):05972                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):05973                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):05974                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):05975                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):05976                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):05977                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):05978                    ; wrong algorithm entirely, not a smaller bug within it.
F878 DCA9             (    forth6809.asm):05979         UELOOP:    LDD  UESRCLEN
F87A 2715             (    forth6809.asm):05980                    BEQ  UEDONE
F87C A680             (    forth6809.asm):05981                    LDA  ,X+
F87E 8125             (    forth6809.asm):05982                    CMPA #'%'
F880 2604             (    forth6809.asm):05983                    BNE  UENOTPCT
F882 C625             (    forth6809.asm):05984                    LDB  #'%'      ; write the extra '%' first - the character
F884 E7A0             (    forth6809.asm):05985                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):05986                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):05987                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):05988                                   ; the same string correctly, since this runs
                      (    forth6809.asm):05989                                   ; independently for each one the loop visits.
F886 A7A0             (    forth6809.asm):05990         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):05991                                   ; every character, '%' or not
F888 DCA9             (    forth6809.asm):05992                    LDD  UESRCLEN
F88A 830001           (    forth6809.asm):05993                    SUBD #1
F88D DDA9             (    forth6809.asm):05994                    STD  UESRCLEN
F88F 20E7             (    forth6809.asm):05995                    BRA  UELOOP
F891 1F20             (    forth6809.asm):05996         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F893 93AB             (    forth6809.asm):05997                    SUBD UEDST     ; overwriting whatever was left on top of
F895 DDAD             (    forth6809.asm):05998                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):05999                                   ; required return values, and separately,
                      (    forth6809.asm):06000                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06001                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06002                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06003                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06004                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06005                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06006                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06007                                   ; correct regardless of how many characters
                      (    forth6809.asm):06008                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06009                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06010                                   ; incremented alongside it.
F897 DCAB             (    forth6809.asm):06011                    LDD  UEDST
F899 3606             (    forth6809.asm):06012                    PSHU D         ; push c-addr2 (destination address)
F89B DCAD             (    forth6809.asm):06013                    LDD  UEOUTLEN
F89D 3606             (    forth6809.asm):06014                    PSHU D         ; push u2 (actual unescaped length)
F89F 39               (    forth6809.asm):06015                    RTS

D4AA 20D7             (    forth6809.asm):03547                     BRA   ILOOP
                      (    forth6809.asm):03548         
D4AC BDD894           (    forth6809.asm):03549         TRYNUM:     JSR   NUMBERQ
D4AF 3706             (    forth6809.asm):03550                     PULU  D
D4B1 10830000         (    forth6809.asm):03551                     CMPD  #0                ; flag (PULU does not set CC)
D4B5 273B             (    forth6809.asm):03552                     BEQ   BADWORD
                      (    forth6809.asm):03553         
D4B7 10830001         (    forth6809.asm):03554                     CMPD  #1                ; 1 = double-number result
D4BB 2711             (    forth6809.asm):03555                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03556         
D4BD DC00             (    forth6809.asm):03557                     LDD   STATE
D4BF 27C2             (    forth6809.asm):03558                     BEQ   ILOOP
D4C1 CCD0B4           (    forth6809.asm):03559                     LDD   #LIT
D4C4 3606             (    forth6809.asm):03560                     PSHU  D

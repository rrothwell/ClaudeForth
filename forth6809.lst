                      (    forth6809.asm):02607                       LDD  #TSTVAL2
                      (    forth6809.asm):02608                       PSHU D
                      (    forth6809.asm):02609                       STU  TSTUB4
                      (    forth6809.asm):02610         
                      (    forth6809.asm):02611                       JSR  TWOTOR
                      (    forth6809.asm):02612                       JSR  TWORFETCH
                      (    forth6809.asm):02613                       JSR  TWOFROMR
                      (    forth6809.asm):02614         
                      (    forth6809.asm):02615                       STU  TSTUAF
                      (    forth6809.asm):02616         
                      (    forth6809.asm):02617                       PULU D
                      (    forth6809.asm):02618                       CMPD #TSTVAL2
                      (    forth6809.asm):02619                       BNE  T2FFAIL
                      (    forth6809.asm):02620                       PULU D
                      (    forth6809.asm):02621                       CMPD #TSTVAL1
                      (    forth6809.asm):02622                       BNE  T2FFAIL
                      (    forth6809.asm):02623                       PULU D
                      (    forth6809.asm):02624                       CMPD #TSTVAL2
                      (    forth6809.asm):02625                       BNE  T2FFAIL
                      (    forth6809.asm):02626                       PULU D
                      (    forth6809.asm):02627                       CMPD #TSTVAL1
                      (    forth6809.asm):02628                       BNE  T2FFAIL
                      (    forth6809.asm):02629                       PULU D
                      (    forth6809.asm):02630                       CMPD #TSTGUARD
                      (    forth6809.asm):02631                       BNE  T2FFAIL
                      (    forth6809.asm):02632         
                      (    forth6809.asm):02633                       LDD  TSTUB4
                      (    forth6809.asm):02634                       SUBD TSTUAF
                      (    forth6809.asm):02635                       CMPD #4
                      (    forth6809.asm):02636                       BNE  T2FFAIL
                      (    forth6809.asm):02637         
                      (    forth6809.asm):02638                       LDD  #TRUEV
                      (    forth6809.asm):02639                       BRA  T2FDONE
C1B4                  (    forth6809.asm):02640         T2FFAIL:       LDD  #FALSEV
C1B4                  (    forth6809.asm):02641         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02642                       PSHU X
                      (    forth6809.asm):02643                       PSHU D
                      (    forth6809.asm):02644                       JSR  TSTREPORT
                      (    forth6809.asm):02645         
                      (    forth6809.asm):02646                       LDU  TSTU0
                      (    forth6809.asm):02647                       RTS
                      (    forth6809.asm):02648         
C1B4                  (    forth6809.asm):02649         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02650                           FCC  "TSTTWORFETCH"

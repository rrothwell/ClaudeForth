E96E 3720             (    forth6809.asm):07528                     PULU  Y                 ; c-addr
E970 3610             (    forth6809.asm):07529                     PSHU  X                 ; result c-addr
E972 3606             (    forth6809.asm):07530                     PSHU  D                 ; result u
E974 5D               (    forth6809.asm):07531                     TSTB
E975 2707             (    forth6809.asm):07532                     BEQ   SQIEND
E977 A6A0             (    forth6809.asm):07533         SQICPY:     LDA   ,Y+
E979 A780             (    forth6809.asm):07534                     STA   ,X+
E97B 5A               (    forth6809.asm):07535                     DECB

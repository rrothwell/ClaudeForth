                      (    forth6809.asm):01555         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):01556         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):01557         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):01558         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):01559         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):01560         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):01561         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):01562         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):01563         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01564         TSTROLL:   STU   TSTU0
                      (    forth6809.asm):01565         
                      (    forth6809.asm):01566                    LDD   #TSTGUARD
                      (    forth6809.asm):01567                    PSHU  D

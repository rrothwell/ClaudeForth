                      (    forth6809.asm):08340         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08341         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08342         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08343         ; enter COLD.
                      (    forth6809.asm):08344         ; COLDSTRT
                      (    forth6809.asm):08345         ;    Inputs:
                      (    forth6809.asm):08346         ;        hardware reset
                      (    forth6809.asm):08347         ;    Outputs:
                      (    forth6809.asm):08348         ;        does not return
                      (    forth6809.asm):08349         ;    Registers: all registers initialised.
                      (    forth6809.asm):08350         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08351         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08352                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08353                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08354                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08355                     CLRA
FFAE 1F8B             (    forth6809.asm):08356                     TFR   A,DP
                      (    forth6809.asm):08357         
FFB0 8E0000           (    forth6809.asm):08358                     LDX   #GLOBALS

                      (    forth6809.asm):03515         ; ============================================================
                      (    forth6809.asm):03516         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):03517         ; ============================================================
                      (    forth6809.asm):03518         ; ------------------------------------------------------------
                      (    forth6809.asm):03519         ; INTERPRET  ( -- )
                      (    forth6809.asm):03520         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03521         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03522         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03523         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03524         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03525         ; ------------------------------------------------------------
D483                  (    forth6809.asm):03526         INTERPRET:
D483 CC0020           (    forth6809.asm):03527         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
D486 3606             (    forth6809.asm):03528                     PSHU  D                 ; char
D488 BDD503           (    forth6809.asm):03529                     JSR   WORDW
D48B AEC4             (    forth6809.asm):03530                     LDX   ,U

FCD3 10830000         (    forth6809.asm):21559                   CMPD #0
FCD7 272B             (    forth6809.asm):21560                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):21561                                     ; the double-cell table (below) before
                      (    forth6809.asm):21562                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):21563                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):21564                                     ; turn - both are double-cell values per
                      (    forth6809.asm):21565                                     ; their own ANS data type, which this
                      (    forth6809.asm):21566                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):21567                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):21568                                     ; represent correctly.
FCD9 3410             (    forth6809.asm):21569                   PSHS X          ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):21570                                     ; internal scratch (LDX CMPA1, then LDA

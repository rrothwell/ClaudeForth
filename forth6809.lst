                      (    forth6809.asm):02160                    CMPD  #TSTVAL1
                      (    forth6809.asm):02161                    BNE   PKFAIL
                      (    forth6809.asm):02162                    PULU  D
                      (    forth6809.asm):02163                    CMPD  #TSTVAL3
                      (    forth6809.asm):02164                    BNE   PKFAIL
                      (    forth6809.asm):02165                    PULU  D
                      (    forth6809.asm):02166                    CMPD  #TSTVAL2
                      (    forth6809.asm):02167                    BNE   PKFAIL
                      (    forth6809.asm):02168                    PULU  D
                      (    forth6809.asm):02169                    CMPD  #TSTVAL1
                      (    forth6809.asm):02170                    BNE   PKFAIL
                      (    forth6809.asm):02171                    PULU  D
                      (    forth6809.asm):02172                    CMPD  #TSTGUARD
                      (    forth6809.asm):02173                    BNE   PKFAIL
                      (    forth6809.asm):02174         
                      (    forth6809.asm):02175                    LDD   TSTUB4
                      (    forth6809.asm):02176                    SUBD  TSTUAF
                      (    forth6809.asm):02177                    CMPD  #0

F591                  (    forth6809.asm):05546         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):05547                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):05548                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):05549                                   ; characters and (worse) shared identically
                      (    forth6809.asm):05550                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):05551                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):05552                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):05553                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):05554                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):05555                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):05556                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):05557                                   ; testing/design decision: rather than give
                      (    forth6809.asm):05558                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):05559                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):05560                                   ; definition for stable storage instead - but
                      (    forth6809.asm):05561                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):05562                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):05563                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):05564                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):05565                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):05566                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):05567                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):05568                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):05569                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):05570                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):05571                                   ; the GLOBALS layout notes above).
F591 BDE09B           (    forth6809.asm):05572                   JSR  PADW
F594 3710             (    forth6809.asm):05573                   PULU X

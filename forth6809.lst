F863 3706             (    forth6809.asm):20309         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F865 DDAB             (    forth6809.asm):20310                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):20311                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):20312                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):20313                                   ; real source length was misread as an
                      (    forth6809.asm):20314                                   ; address, the real source address was never
                      (    forth6809.asm):20315                                   ; popped at all, and the true destination
                      (    forth6809.asm):20316                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):20317                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):20318                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):20319                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):20320                    STD  UESRCLEN
F86B 3706             (    forth6809.asm):20321                    PULU D         ; next: c-addr1 (source address)
F86D DDA7             (    forth6809.asm):20322                    STD  UEADDR
F86F CC0000           (    forth6809.asm):20323                    LDD  #0
F872 DDAD             (    forth6809.asm):20324                    STD  UEOUTLEN
F874 9EA7             (    forth6809.asm):20325                    LDX  UEADDR
F876 109EAB           (    forth6809.asm):20326                    LDY  UEDST
                      (    forth6809.asm):20327         
                      (    forth6809.asm):20328                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):20329                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):20330                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):20331                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):20332                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):20333                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):20334                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):20335                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):20336                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):20337                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):20338                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):20339                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):20340                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):20341                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):20342                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):20343                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):20344                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):20345                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):20346                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):20347         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):20348                    BEQ  UEDONE
F87D A680             (    forth6809.asm):20349                    LDA  ,X+
F87F 8125             (    forth6809.asm):20350                    CMPA #'%'
F881 2604             (    forth6809.asm):20351                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):20352                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):20353                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):20354                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):20355                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):20356                                   ; the same string correctly, since this runs
                      (    forth6809.asm):20357                                   ; independently for each one the loop visits.

                      (    forth6809.asm):04182         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):04183         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):04184         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):04185         ; UDMULADD
                      (    forth6809.asm):04186         ;    Inputs:
                      (    forth6809.asm):04187         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):04188         ;        frame ( ud c-addr u )
                      (    forth6809.asm):04189         ;        RegB = digit value to add
                      (    forth6809.asm):04190         ;        BASE
                      (    forth6809.asm):04191         ;    Outputs:
                      (    forth6809.asm):04192         ;        ud = ud * BASE + digit
                      (    forth6809.asm):04193         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04194         ; ------------------------------------------------------------
D81A 327E             (    forth6809.asm):04195         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
D81C E7E4             (    forth6809.asm):04196                     STB   ,S
D81E 9603             (    forth6809.asm):04197                     LDA   BASE+1
D820 A761             (    forth6809.asm):04198                     STA   1,S

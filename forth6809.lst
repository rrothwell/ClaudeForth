                      (    forth6809.asm):00557         ; ------------------------------------------------------------
                      (    forth6809.asm):00558         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00559         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00560         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00561         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00562         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00563         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00564         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00565         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00566         ;
                      (    forth6809.asm):00567         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00568         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00569         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00570         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00571         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00572         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00573         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00574         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00575         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00576         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00577         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00578         ; ------------------------------------------------------------
                      (    forth6809.asm):00579                  ORG   $0100
0100                  (    forth6809.asm):00580         MVCNT      RMB   2
0102                  (    forth6809.asm):00581         MVDST      RMB   2
0104                  (    forth6809.asm):00582         MVSRC      RMB   2
     0100             (    forth6809.asm):00583         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00584         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00585         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00586         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00587         
                      (    forth6809.asm):00588         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00589         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00590                  ORG USROMSTRT
                      (    forth6809.asm):00591         
                      (    forth6809.asm):00592         ; ============================================================
                      (    forth6809.asm):00593         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00594         ;
                      (    forth6809.asm):00595         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00596         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00597         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00598         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00599         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00600         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00601         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00602         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00603         ; this existed - the default build (UNITTESTS undefined, or
                      (    forth6809.asm):00604         ; defined as 0) removes it entirely and this block reverts to
                      (    forth6809.asm):00605         ; exactly that padding, computed automatically below via the ROM
                      (    forth6809.asm):00606         ; label rather than a fixed byte count, so it's correct either
                      (    forth6809.asm):00607         ; way without needing to be hand-adjusted. Pass
                      (    forth6809.asm):00608         ; --define=UNITTESTS on the lwasm command line (see the example
                      (    forth6809.asm):00609         ; at the end of this comment) to include it.
                      (    forth6809.asm):00610         ;
                      (    forth6809.asm):00611         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00612         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00613         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00614         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00615         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00616         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00617         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00618         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00619         ;
                      (    forth6809.asm):00620         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00621         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00622         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00623         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00624         ;
                      (    forth6809.asm):00625         ; Test groups are further gated by TSTSELECTOR (see below), one
                      (    forth6809.asm):00626         ; group at a time, since assembling every group together exhausts
                      (    forth6809.asm):00627         ; the available unused ROM space. Example command line, testing
                      (    forth6809.asm):00628         ; group 2 with tests included:
                      (    forth6809.asm):00629         ;
                      (    forth6809.asm):00630         ;   lwasm --6809 --format=raw \
                      (    forth6809.asm):00631         ;   --output=forth6809.bin --list=forth6809.lst \
                      (    forth6809.asm):00632         ;   --define=UNITTESTS --define=TSTSELECTOR=2 \
                      (    forth6809.asm):00633         ;   forth6809.asm
                      (    forth6809.asm):00634         ; ============================================================
                      (    forth6809.asm):00635                    IFNDEF UNITTESTS
     0000             (    forth6809.asm):00636         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00637                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00638                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00639                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00640                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00641                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00642                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00643                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00644                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00645                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00646                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00647                           ; choice is made, not what including it does.
                      (    forth6809.asm):00648                    ENDC
                      (    forth6809.asm):00649         
                      (    forth6809.asm):00650                    IFNDEF TSTSELECTOR
     0002             (    forth6809.asm):00651         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00652                    ENDC
                      (    forth6809.asm):00653         
                      (    forth6809.asm):00654                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00655         
C100                  (    forth6809.asm):00656         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
C100                  (    forth6809.asm):00657         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
C100                  (    forth6809.asm):00658         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
C100                  (    forth6809.asm):00659         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00660         
C100                  (    forth6809.asm):00661         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00662                                       ; under test, to prove an operation
                      (    forth6809.asm):00663                                       ; doesn't disturb what's beneath it
C100                  (    forth6809.asm):00664         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00665                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00666                                       ; that only appears to pass due to a
                      (    forth6809.asm):00667                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00668                                       ; caught rather than masked
C100                  (    forth6809.asm):00669         TSTVAL2  EQU   $2468         ; additional distinct, non-trivial
C100                  (    forth6809.asm):00670         TSTVAL3  EQU   $7B3D         ; values for multi-item tests (SWAP,
C100                  (    forth6809.asm):00671         TSTVAL4  EQU   $4E2C         ; OVER, ROT, 2DUP, 2ROT, etc) - none are
C100                  (    forth6809.asm):00672         TSTVAL5  EQU   $19A7         ; 0, 1, -1, TSTGUARD, or any of each
C100                  (    forth6809.asm):00673         TSTVAL6  EQU   $6D95         ; other
                      (    forth6809.asm):00674         
C100                  (    forth6809.asm):00675         TSTSCR   EQU   APPVARS+8     ; extra scratch cell - for tests (DEPTH)
                      (    forth6809.asm):00676                                       ; that need to compute an expected value
                      (    forth6809.asm):00677                                       ; independently before comparing
                      (    forth6809.asm):00678         
C100                  (    forth6809.asm):00679         TSTNEG1  EQU   $CFC7         ; -12345 - distinct, non-trivial negative
                      (    forth6809.asm):00680                                       ; test values, needed for arithmetic
                      (    forth6809.asm):00681                                       ; tests (ABS, NEGATE, MIN/MAX, signed
                      (    forth6809.asm):00682                                       ; division, 2/) whose logic genuinely
                      (    forth6809.asm):00683                                       ; branches on sign - TSTVAL1-6 above are
                      (    forth6809.asm):00684                                       ; all positive, which wouldn't exercise
                      (    forth6809.asm):00685                                       ; those branches
C100                  (    forth6809.asm):00686         TSTNEG2  EQU   $FEBF         ; -321
                      (    forth6809.asm):00687         
C100                  (    forth6809.asm):00688         TSTD1HI  EQU   $0001         ; TSTDBL1 = 70000 (positive, exceeds 16
C100                  (    forth6809.asm):00689         TSTD1LO  EQU   $1170         ; bits - exercises real double-cell width,
                      (    forth6809.asm):00690                                       ; not just a sign-extended single)
C100                  (    forth6809.asm):00691         TSTD2HI  EQU   $FFFE         ; TSTDBL2 = -70000
C100                  (    forth6809.asm):00692         TSTD2LO  EQU   $EE90
C100                  (    forth6809.asm):00693         TSTD3HI  EQU   $00BC         ; TSTDBL3 = 12345678
C100                  (    forth6809.asm):00694         TSTD3LO  EQU   $614E
C100                  (    forth6809.asm):00695         TSTDSHI  EQU   $0000         ; TSTDBLSMALL = 500 - small enough to fit
C100                  (    forth6809.asm):00696         TSTDSLO  EQU   $01F4         ; in a single cell, for D>S
                      (    forth6809.asm):00697         
                      (    forth6809.asm):00698         ; ------------------------------------------------------------
                      (    forth6809.asm):00699         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00700         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00701         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00702         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00703         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00704         TSTREPORT: PULU  D
                      (    forth6809.asm):00705                    STD   TSTFLAG
                      (    forth6809.asm):00706                    JSR   COUNT
                      (    forth6809.asm):00707                    JSR   TYPE
                      (    forth6809.asm):00708                    LDD   TSTFLAG
                      (    forth6809.asm):00709                    BEQ   TSTFAILR
                      (    forth6809.asm):00710                    LDD   #TSTOKMSG
                      (    forth6809.asm):00711                    PSHU  D
                      (    forth6809.asm):00712                    LDD   #TSTOKMSGL
                      (    forth6809.asm):00713                    PSHU  D
                      (    forth6809.asm):00714                    BRA   TSTPRINT
C100                  (    forth6809.asm):00715         TSTFAILR:  LDD   #TSTFAILMSG
                      (    forth6809.asm):00716                    PSHU  D
                      (    forth6809.asm):00717                    LDD   #TSTFAILMSGL
                      (    forth6809.asm):00718                    PSHU  D
C100                  (    forth6809.asm):00719         TSTPRINT:  JSR   TYPE
                      (    forth6809.asm):00720                    JSR   CRW
                      (    forth6809.asm):00721                    RTS
                      (    forth6809.asm):00722         
C100                  (    forth6809.asm):00723         TSTOKMSG:    FCC " OK"
C100                  (    forth6809.asm):00724         TSTOKMSGL    EQU  *-TSTOKMSG
C100                  (    forth6809.asm):00725         TSTFAILMSG:  FCC " FAIL"
C100                  (    forth6809.asm):00726         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00727         
                      (    forth6809.asm):00728         ; ------------------------------------------------------------
                      (    forth6809.asm):00729         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00730         ; here as they're written.
                      (    forth6809.asm):00731         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00732         TSTRUNNER: JSR   TSTSTACK
                      (    forth6809.asm):00733                    JSR   TSTSARITH
                      (    forth6809.asm):00734                    JSR   TSTDARITH
                      (    forth6809.asm):00735                    JSR   TSTLOGIC
                      (    forth6809.asm):00736                    RTS
                      (    forth6809.asm):00737         
                      (    forth6809.asm):00738         ; ------------------------------------------------------------
                      (    forth6809.asm):00739         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):00740         ; they're written.
                      (    forth6809.asm):00741         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00742         TSTSTACK:  JSR   CRW
                      (    forth6809.asm):00743                    LDX   #TSTSTACKMSG
                      (    forth6809.asm):00744                    PSHU  X
                      (    forth6809.asm):00745                    LDD   #5
                      (    forth6809.asm):00746                    PSHU  D
                      (    forth6809.asm):00747                    JSR   TYPE
                      (    forth6809.asm):00748                    JSR   CRW
                      (    forth6809.asm):00749         
                      (    forth6809.asm):00750                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00751         
                      (    forth6809.asm):00752                    JSR   TSTDUP
                      (    forth6809.asm):00753                    JSR   TSTDROP
                      (    forth6809.asm):00754                    JSR   TSTSWAP
                      (    forth6809.asm):00755                    JSR   TSTOVER
                      (    forth6809.asm):00756                    JSR   TSTROT
                      (    forth6809.asm):00757                    JSR   TSTQDUPNZ
                      (    forth6809.asm):00758                    JSR   TSTQDUPZ
                      (    forth6809.asm):00759                    JSR   TSTDEPTH
                      (    forth6809.asm):00760                    JSR   TSTDDUP
                      (    forth6809.asm):00761                    JSR   TSTDDROP
                      (    forth6809.asm):00762                    JSR   TSTDSWAP
                      (    forth6809.asm):00763                    JSR   TSTDOVER
                      (    forth6809.asm):00764                    JSR   TSTNIP
                      (    forth6809.asm):00765                    JSR   TSTTUCK
                      (    forth6809.asm):00766                    JSR   TSTPICK
                      (    forth6809.asm):00767                    JSR   TSTROLL
                      (    forth6809.asm):00768                    JSR   TSTDROT
                      (    forth6809.asm):00769         
                      (    forth6809.asm):00770                    ENDC ; <<<<
                      (    forth6809.asm):00771         
                      (    forth6809.asm):00772                    RTS
                      (    forth6809.asm):00773         
C100                  (    forth6809.asm):00774         TSTSTACKMSG: FCC "Stack"
                      (    forth6809.asm):00775         
                      (    forth6809.asm):00776                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00777         
                      (    forth6809.asm):00778         ; ------------------------------------------------------------
                      (    forth6809.asm):00779         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00780         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00781         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00782         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00783         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00784         ; pushes that set the test up).
                      (    forth6809.asm):00785         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00786         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00787         
                      (    forth6809.asm):00788                    LDD   #TSTGUARD
                      (    forth6809.asm):00789                    PSHU  D
                      (    forth6809.asm):00790                    LDD   #TSTVAL1
                      (    forth6809.asm):00791                    PSHU  D
                      (    forth6809.asm):00792                    STU   TSTUB4
                      (    forth6809.asm):00793         
                      (    forth6809.asm):00794                    JSR   DUP
                      (    forth6809.asm):00795         
                      (    forth6809.asm):00796                    STU   TSTUAF
                      (    forth6809.asm):00797         
                      (    forth6809.asm):00798                    PULU  D
                      (    forth6809.asm):00799                    CMPD  #TSTVAL1
                      (    forth6809.asm):00800                    BNE   TDFAIL
                      (    forth6809.asm):00801                    PULU  D
                      (    forth6809.asm):00802                    CMPD  #TSTVAL1
                      (    forth6809.asm):00803                    BNE   TDFAIL
                      (    forth6809.asm):00804                    PULU  D
                      (    forth6809.asm):00805                    CMPD  #TSTGUARD
                      (    forth6809.asm):00806                    BNE   TDFAIL
                      (    forth6809.asm):00807         
                      (    forth6809.asm):00808                    LDD   TSTUB4
                      (    forth6809.asm):00809                    SUBD  TSTUAF
                      (    forth6809.asm):00810                    CMPD  #2
                      (    forth6809.asm):00811                    BNE   TDFAIL
                      (    forth6809.asm):00812         
                      (    forth6809.asm):00813                    LDD   #TRUEV
                      (    forth6809.asm):00814                    BRA   TDDONE
C100                  (    forth6809.asm):00815         TDFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):00816         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00817                    PSHU  X
                      (    forth6809.asm):00818                    PSHU  D
                      (    forth6809.asm):00819                    JSR   TSTREPORT
                      (    forth6809.asm):00820         
                      (    forth6809.asm):00821                    LDU   TSTU0
                      (    forth6809.asm):00822                    RTS
                      (    forth6809.asm):00823         
C100                  (    forth6809.asm):00824         TSTDUPNAME: FCB  6
                      (    forth6809.asm):00825                     FCC  "TSTDUP"
                      (    forth6809.asm):00826         
                      (    forth6809.asm):00827         ; ------------------------------------------------------------
                      (    forth6809.asm):00828         ; TSTDROP - unit test for DROP ( x -- ). Verifies both the
                      (    forth6809.asm):00829         ; stack's contents (the guard beneath the dropped value is left
                      (    forth6809.asm):00830         ; undisturbed, and is now the new top) and the data stack
                      (    forth6809.asm):00831         ; pointer's movement (exactly one cell, 2 bytes, freed - DROP's
                      (    forth6809.asm):00832         ; own net effect, not conflated with the two pushes that set the
                      (    forth6809.asm):00833         ; test up).
                      (    forth6809.asm):00834         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00835         TSTDROP:   STU   TSTU0
                      (    forth6809.asm):00836         
                      (    forth6809.asm):00837                    LDD   #TSTGUARD
                      (    forth6809.asm):00838                    PSHU  D
                      (    forth6809.asm):00839                    LDD   #TSTVAL1
                      (    forth6809.asm):00840                    PSHU  D
                      (    forth6809.asm):00841                    STU   TSTUB4
                      (    forth6809.asm):00842         
                      (    forth6809.asm):00843                    JSR   DROP
                      (    forth6809.asm):00844         
                      (    forth6809.asm):00845                    STU   TSTUAF
                      (    forth6809.asm):00846         
                      (    forth6809.asm):00847                    PULU  D
                      (    forth6809.asm):00848                    CMPD  #TSTGUARD
                      (    forth6809.asm):00849                    BNE   DPFAIL
                      (    forth6809.asm):00850         
                      (    forth6809.asm):00851                    LDD   TSTUB4
                      (    forth6809.asm):00852                    SUBD  TSTUAF
                      (    forth6809.asm):00853                    CMPD  #-2
                      (    forth6809.asm):00854                    BNE   DPFAIL
                      (    forth6809.asm):00855         
                      (    forth6809.asm):00856                    LDD   #TRUEV
                      (    forth6809.asm):00857                    BRA   DPDONE
C100                  (    forth6809.asm):00858         DPFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):00859         DPDONE:    LDX   #TSTDROPNAME
                      (    forth6809.asm):00860                    PSHU  X
                      (    forth6809.asm):00861                    PSHU  D
                      (    forth6809.asm):00862                    JSR   TSTREPORT
                      (    forth6809.asm):00863         
                      (    forth6809.asm):00864                    LDU   TSTU0
                      (    forth6809.asm):00865                    RTS
                      (    forth6809.asm):00866         
C100                  (    forth6809.asm):00867         TSTDROPNAME: FCB  7
                      (    forth6809.asm):00868                      FCC  "TSTDROP"
                      (    forth6809.asm):00869         
                      (    forth6809.asm):00870         ; ------------------------------------------------------------
                      (    forth6809.asm):00871         ; TSTSWAP - unit test for SWAP ( n1 n2 -- n2 n1 ). Verifies the
                      (    forth6809.asm):00872         ; two items exchange places, the guard beneath is undisturbed,
                      (    forth6809.asm):00873         ; and the net stack depth is unchanged.
                      (    forth6809.asm):00874         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00875         TSTSWAP:   STU   TSTU0
                      (    forth6809.asm):00876         
                      (    forth6809.asm):00877                    LDD   #TSTGUARD
                      (    forth6809.asm):00878                    PSHU  D
                      (    forth6809.asm):00879                    LDD   #TSTVAL1
                      (    forth6809.asm):00880                    PSHU  D
                      (    forth6809.asm):00881                    LDD   #TSTVAL2
                      (    forth6809.asm):00882                    PSHU  D
                      (    forth6809.asm):00883                    STU   TSTUB4
                      (    forth6809.asm):00884         
                      (    forth6809.asm):00885                    JSR   SWAP
                      (    forth6809.asm):00886         
                      (    forth6809.asm):00887                    STU   TSTUAF
                      (    forth6809.asm):00888         
                      (    forth6809.asm):00889                    PULU  D
                      (    forth6809.asm):00890                    CMPD  #TSTVAL1
                      (    forth6809.asm):00891                    BNE   SWFAIL
                      (    forth6809.asm):00892                    PULU  D
                      (    forth6809.asm):00893                    CMPD  #TSTVAL2
                      (    forth6809.asm):00894                    BNE   SWFAIL
                      (    forth6809.asm):00895                    PULU  D
                      (    forth6809.asm):00896                    CMPD  #TSTGUARD
                      (    forth6809.asm):00897                    BNE   SWFAIL
                      (    forth6809.asm):00898         
                      (    forth6809.asm):00899                    LDD   TSTUB4
                      (    forth6809.asm):00900                    SUBD  TSTUAF
                      (    forth6809.asm):00901                    CMPD  #0
                      (    forth6809.asm):00902                    BNE   SWFAIL
                      (    forth6809.asm):00903         
                      (    forth6809.asm):00904                    LDD   #TRUEV
                      (    forth6809.asm):00905                    BRA   SWDONE
C100                  (    forth6809.asm):00906         SWFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):00907         SWDONE:    LDX   #TSTSWAPNAME
                      (    forth6809.asm):00908                    PSHU  X
                      (    forth6809.asm):00909                    PSHU  D
                      (    forth6809.asm):00910                    JSR   TSTREPORT
                      (    forth6809.asm):00911         
                      (    forth6809.asm):00912                    LDU   TSTU0
                      (    forth6809.asm):00913                    RTS
                      (    forth6809.asm):00914         
C100                  (    forth6809.asm):00915         TSTSWAPNAME: FCB  7
                      (    forth6809.asm):00916                      FCC  "TSTSWAP"
                      (    forth6809.asm):00917         
                      (    forth6809.asm):00918         ; ------------------------------------------------------------
                      (    forth6809.asm):00919         ; TSTOVER - unit test for OVER ( n1 n2 -- n1 n2 n1 ). Verifies
                      (    forth6809.asm):00920         ; the copy of n1 is correct, the originals and guard are
                      (    forth6809.asm):00921         ; undisturbed, and exactly one cell was added.
                      (    forth6809.asm):00922         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00923         TSTOVER:   STU   TSTU0
                      (    forth6809.asm):00924         
                      (    forth6809.asm):00925                    LDD   #TSTGUARD
                      (    forth6809.asm):00926                    PSHU  D
                      (    forth6809.asm):00927                    LDD   #TSTVAL1
                      (    forth6809.asm):00928                    PSHU  D
                      (    forth6809.asm):00929                    LDD   #TSTVAL2
                      (    forth6809.asm):00930                    PSHU  D
                      (    forth6809.asm):00931                    STU   TSTUB4
                      (    forth6809.asm):00932         
                      (    forth6809.asm):00933                    JSR   OVER
                      (    forth6809.asm):00934         
                      (    forth6809.asm):00935                    STU   TSTUAF
                      (    forth6809.asm):00936         
                      (    forth6809.asm):00937                    PULU  D
                      (    forth6809.asm):00938                    CMPD  #TSTVAL1
                      (    forth6809.asm):00939                    BNE   OVFAIL
                      (    forth6809.asm):00940                    PULU  D
                      (    forth6809.asm):00941                    CMPD  #TSTVAL2

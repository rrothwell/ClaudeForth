                      (    forth6809.asm):06903         
                      (    forth6809.asm):06904                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):06905                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):06906                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):06907                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):06908                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):06909                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):06910                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):06911                   ; high cell.
E5C3 0D22             (    forth6809.asm):06912                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):06913                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):06914                   LDD   UDLO
E5C9 43               (    forth6809.asm):06915                   COMA
E5CA 53               (    forth6809.asm):06916                   COMB
E5CB C30001           (    forth6809.asm):06917                   ADDD  #1
E5CE DD76             (    forth6809.asm):06918                   STD   UDLO
E5D0 3401             (    forth6809.asm):06919                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):06920                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):06921                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):06922                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):06923                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):06924                                      ; silently overwrote the real carry here
                      (    forth6809.asm):06925                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):06926                                      ; making the high-cell increment run
                      (    forth6809.asm):06927                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):06928                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):06929                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):06930                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):06931                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):06932                                      ; matching "always increment" rather than
                      (    forth6809.asm):06933                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):06934                   LDD   UDHI
E5D4 43               (    forth6809.asm):06935                   COMA
E5D5 53               (    forth6809.asm):06936                   COMB
E5D6 3501             (    forth6809.asm):06937                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):06938                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):06939                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):06940                                      ; when there's no carry - the complemented
                      (    forth6809.asm):06941                                      ; value was computed in D but never
                      (    forth6809.asm):06942                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):06943                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):06944                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):06945                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):06946                                      ; was always seen as set, so this branch
                      (    forth6809.asm):06947                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):06948                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):06949                                      ; alone would have made this second,
                      (    forth6809.asm):06950                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):06951                                      ; only past the "+1", never past the
                      (    forth6809.asm):06952                                      ; store itself - the store always runs,
                      (    forth6809.asm):06953                                      ; either way.
E5DA C30001           (    forth6809.asm):06954                   ADDD  #1
E5DD DD74             (    forth6809.asm):06955         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):06956         
E5DF                  (    forth6809.asm):06957         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):06958                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):06959                   LDX   CADDR
E5E1 E684             (    forth6809.asm):06960                   LDB   ,X
E5E3 5A               (    forth6809.asm):06961                   DECB
E5E4 3001             (    forth6809.asm):06962                   LEAX  1,X
E5E6 A685             (    forth6809.asm):06963                   LDA   B,X
E5E8 812E             (    forth6809.asm):06964                   CMPA  #'.'
E5EA 260E             (    forth6809.asm):06965                   BNE   NQSINGLE
                      (    forth6809.asm):06966         
                      (    forth6809.asm):06967                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):06968                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):06969                   ; apart without needing a separate flag of its own either
E5EC DC76             (    forth6809.asm):06970                   LDD   UDLO
E5EE 3606             (    forth6809.asm):06971                   PSHU  D

CF84 A785             (    forth6809.asm):02456                     STA   B,X
CF86 5C               (    forth6809.asm):02457                     INCB                    ; Figure out the new head,
CF87 C43F             (    forth6809.asm):02458                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
CF89 F10177           (    forth6809.asm):02459                     CMPB  INTAIL            ; Would the new head slot meet the tail?
CF8C 270B             (    forth6809.asm):02460                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.

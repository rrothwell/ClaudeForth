                      (    forth6809.asm):11958                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E60E                  (    forth6809.asm):11959         KEY:     LDA   INHEAD
                      (    forth6809.asm):11960                  CMPA  INTAIL

                      (    forth6809.asm):01747         ; TSTQDUPZ - unit test for ?DUP ( n -- n n | 0 ), zero case.
                      (    forth6809.asm):01748         ; Verifies zero is left alone - no duplicate is pushed - the
                      (    forth6809.asm):01749         ; guard beneath is undisturbed, and the net stack depth is
                      (    forth6809.asm):01750         ; unchanged.
                      (    forth6809.asm):01751         ; ------------------------------------------------------------

                      (    forth6809.asm):08430         ; TSTMARKER - unit test for MARKER. Compiles "MARKER TESTWD"
                      (    forth6809.asm):08431         ; (CODEHERE/DPHERE/VARHERE redirected to scratch, as with every
                      (    forth6809.asm):08432         ; other test in this section), then simulates "something was
                      (    forth6809.asm):08433         ; defined after the marker" by manually advancing the redirected
                      (    forth6809.asm):08434         ; pointers further and pointing the real LATEST elsewhere,
                      (    forth6809.asm):08435         ; executes the marker word, and verifies everything was restored
                      (    forth6809.asm):08436         ; to TSTCBUF/TSTDBUF/TSTVBUF directly - the state BEFORE the
                      (    forth6809.asm):08437         ; marker word itself was created, not the state right after.
                      (    forth6809.asm):08438         ; MARKER's own documented behavior is "forgets itself too" -
                      (    forth6809.asm):08439         ; traced MARKERW's own code and confirmed its internal snapshot
                      (    forth6809.asm):08440         ; is taken at its very start, before HEADER or any compiling
                      (    forth6809.asm):08441         ; runs at all, so that's genuinely the correct restore target,
                      (    forth6809.asm):08442         ; not assumed.
                      (    forth6809.asm):08443         ;
                      (    forth6809.asm):08444         ; DOMARKER (confirmed by reading it directly) writes to the
                      (    forth6809.asm):08445         ; real DPHERE/CODEHERE/VARHERE/LATEST unconditionally, not to
                      (    forth6809.asm):08446         ; any redirected copy - so this test must execute the marker
                      (    forth6809.asm):08447         ; word while CODEHERE/DPHERE/VARHERE are still redirected (their
                      (    forth6809.asm):08448         ; real values are restored only afterward), unlike every other
                      (    forth6809.asm):08449         ; test in this section, which restores first and executes
                      (    forth6809.asm):08450         ; second. Getting this order backwards would have corrupted the
                      (    forth6809.asm):08451         ; real dictionary pointers with scratch addresses.
                      (    forth6809.asm):08452         ; ------------------------------------------------------------

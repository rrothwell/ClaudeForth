                      (    forth6809.asm):01857         ;    Inputs:
                      (    forth6809.asm):01858         ;        none
                      (    forth6809.asm):01859         ;    Outputs:
                      (    forth6809.asm):01860         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):01861         ;    Registers: RegA, RegB and CC changed.

                      (    forth6809.asm):12788         ; ------------------------------------------------------------
                      (    forth6809.asm):12789         ; TSTDOTQUOTE - unit test for .". No STATE check at all in its
                      (    forth6809.asm):12790         ; own code (confirmed by reading it directly - matches "no
                      (    forth6809.asm):12791         ; interpretation semantics, per ANS" without a specific -14
                      (    forth6809.asm):12792         ; throw, unlike [CHAR]/S"), so only the compiling case is
                      (    forth6809.asm):12793         ; tested, matching how it's actually meant to be used. Its own
                      (    forth6809.asm):12794         ; runtime (DOTSTR) calls TYPE internally, which has two entirely
                      (    forth6809.asm):12795         ; different implementations gated by SERIALPOLL (the same real
                      (    forth6809.asm):12796         ; finding from section 3.1) - applying that lesson from the
                      (    forth6809.asm):12797         ; start here rather than re-discovering it: EMITCH works
                      (    forth6809.asm):12798         ; universally for a single-character check, but this outputs
                      (    forth6809.asm):12799         ; multiple characters, so - matching TSTCR's own established
                      (    forth6809.asm):12800         ; fix - the full OUTHEAD/OUTBUF check only applies under
                      (    forth6809.asm):12801         ; SERIALPOLL=0, with a narrower EMITCH-based check (last
                      (    forth6809.asm):12802         ; character only, plus the stack-depth check) for SERIALPOLL=1.
                      (    forth6809.asm):12803         ; ------------------------------------------------------------
C2AE                  (    forth6809.asm):12804         TSTDOTQUOTE: LDD  CODEHERE
                      (    forth6809.asm):12805                      STD  TSTCSAV
                      (    forth6809.asm):12806                      LDD  SRCADDR
                      (    forth6809.asm):12807                      STD  TSTSASAV
                      (    forth6809.asm):12808                      LDD  SRCLEN

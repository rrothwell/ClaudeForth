C1F9 BDFC2B           (    forth6809.asm):04874                    JSR   CRW
                      (    forth6809.asm):04875         
                      (    forth6809.asm):04876                    IFEQ TSTSELECTOR-5  ; >>>>
                      (    forth6809.asm):04877         
                      (    forth6809.asm):04878                    JSR   TSTAND
                      (    forth6809.asm):04879                    JSR   TSTOR
                      (    forth6809.asm):04880                    JSR   TSTXOR
                      (    forth6809.asm):04881                    JSR   TSTINV
                      (    forth6809.asm):04882                    JSR   TSTLSH
                      (    forth6809.asm):04883                    JSR   TSTRSH
                      (    forth6809.asm):04884                    JSR   TSTCELS
                      (    forth6809.asm):04885                    JSR   TSTCELP
                      (    forth6809.asm):04886                    JSR   TSTCHRS
                      (    forth6809.asm):04887                    JSR   TSTCHRP
                      (    forth6809.asm):04888                    JSR   TSTALGD
                      (    forth6809.asm):04889                    JSR   TSTALGN
                      (    forth6809.asm):04890         
                      (    forth6809.asm):04891                    ENDC ; <<<<

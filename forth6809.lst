                      (    forth6809.asm):06598         ; ENVIRONMENT? - dispatcher complete; table has entries derived
                      (    forth6809.asm):06599         ; without fabricating unfixed capacities. /HOLD and /PAD were both
                      (    forth6809.asm):06600         ; added this session, answering HOLDMINSIZE and PADMINSIZE
                      (    forth6809.asm):06601         ; respectively (see each entry itself, below, for why each uses its
                      (    forth6809.asm):06602         ; own, conceptually correct constant rather than the numerically-
                      (    forth6809.asm):06603         ; equal PADOFFSET).
                      (    forth6809.asm):06604         ;
                      (    forth6809.asm):06605         ; WORDLISTS (16.3.2, Search-Order word set) is deliberately absent
                      (    forth6809.asm):06606         ; from ENVTABLE, not an oversight - this system doesn't implement
                      (    forth6809.asm):06607         ; the Search-Order word set, so WORDLISTS is genuinely an unknown
                      (    forth6809.asm):06608         ; attribute here. Per ENVIRONMENT?'s own spec (6.1.1345): "If the
                      (    forth6809.asm):06609         ; system treats the attribute as unknown, the returned flag is
                      (    forth6809.asm):06610         ; false" - falling through to ENVNOTFOUND already produces exactly
                      (    forth6809.asm):06611         ; that, correctly and completely, with no dispatcher work needed.
                      (    forth6809.asm):06612         ; Confirmed via MAME testing.
                      (    forth6809.asm):06613         ;
                      (    forth6809.asm):06614         ; MAX-D/MAX-UD were resolved this session via a genuine dispatcher
                      (    forth6809.asm):06615         ; extension, not just a table entry - both are double-cell values
                      (    forth6809.asm):06616         ; per their own ANS data type, which the original single-cell
                      (    forth6809.asm):06617         ; ENVFOUND (pushing exactly one value before TRUE) couldn't
                      (    forth6809.asm):06618         ; represent. Added a second table (ENVTABLE2) and matching loop
                      (    forth6809.asm):06619         ; (ENV2START/ENV2LOOP/ENV2FOUND, below) specifically for double-cell
                      (    forth6809.asm):06620         ; entries, rather than reworking the single-cell path to handle both
                      (    forth6809.asm):06621         ; shapes - see those labels for the full design.
                      (    forth6809.asm):06622         ;
                      (    forth6809.asm):06623         ; FLOORED was the third, separate open item flagged previously -
                      (    forth6809.asm):06624         ; investigated this session by tracing DIVCOMMON (shared by /, MOD,
                      (    forth6809.asm):06625         ; /MOD) against this system's own SM/REM and FM/MOD. Confirmed
                      (    forth6809.asm):06626         ; DIVCOMMON matches SM/REM's convention exactly (remainder sign
                      (    forth6809.asm):06627         ; restored from the dividend's own original sign, not the quotient's)
                      (    forth6809.asm):06628         ; - this system's primary division words use symmetric division, not
                      (    forth6809.asm):06629         ; floored. FLOORED now answers 0 (false) - see the entry itself,
                      (    forth6809.asm):06630         ; below, for the full trace.
FD0D 3706             (    forth6809.asm):06631         ENVQUERY: PULU D
FD0F DDEF             (    forth6809.asm):06632                   STD  ENVLEN
FD11 3706             (    forth6809.asm):06633                   PULU D
FD13 DDF1             (    forth6809.asm):06634                   STD  ENVADDR
FD15 8EFDA8           (    forth6809.asm):06635                   LDX  #ENVTABLE
FD18 EC84             (    forth6809.asm):06636         ENVLOOP:  LDD  ,X
FD1A 10830000         (    forth6809.asm):06637                   CMPD #0
FD1E 272B             (    forth6809.asm):06638                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):06639                                     ; the double-cell table (below) before
                      (    forth6809.asm):06640                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):06641                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):06642                                     ; turn - both are double-cell values per
                      (    forth6809.asm):06643                                     ; their own ANS data type, which this
                      (    forth6809.asm):06644                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):06645                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):06646                                     ; represent correctly.
FD20 3410             (    forth6809.asm):06647                   PSHS X          ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):06648                                     ; internal scratch (LDX CMPA1, then LDA
                      (    forth6809.asm):06649                                     ; ,X+ advancing through the comparison),
                      (    forth6809.asm):06650                                     ; clobbering whatever the caller had there.
                      (    forth6809.asm):06651                                     ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):06652                                     ; current table entry after COMPAREW
                      (    forth6809.asm):06653                                     ; returns, both for ENVFOUND's own LDD 4,X
                      (    forth6809.asm):06654                                     ; and for advancing to the next entry -
                      (    forth6809.asm):06655                                     ; without saving it first, a successful
                      (    forth6809.asm):06656                                     ; match left X sitting just past the
                      (    forth6809.asm):06657                                     ; matched string's own text (for
                      (    forth6809.asm):06658                                     ; "/COUNTED-STRING", 15 characters, that
                      (    forth6809.asm):06659                                     ; lands exactly at the start of the next
                      (    forth6809.asm):06660                                     ; entry's string, "MAX-N") - so ENVFOUND
                      (    forth6809.asm):06661                                     ; read the "value" field from inside the
                      (    forth6809.asm):06662                                     ; NEXT entry's own string text instead of
                      (    forth6809.asm):06663                                     ; the real value. Confirmed via MAME: this
                      (    forth6809.asm):06664                                     ; exact mechanism produces $4E4D precisely
                      (    forth6809.asm):06665                                     ; - the bytes 'N' ($4E) and 'M' ($4D, the
                      (    forth6809.asm):06666                                     ; start of "MAX-U") sitting 4 bytes into
                      (    forth6809.asm):06667                                     ; "MAX-N", read as one cell.
FD22 3606             (    forth6809.asm):06668                   PSHU D
FD24 EC02             (    forth6809.asm):06669                   LDD  2,X
FD26 3606             (    forth6809.asm):06670                   PSHU D

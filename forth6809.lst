E041 DD00             (    forth6809.asm):02095                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02096                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02097                                   ; that spans more than one line of input.
                      (    forth6809.asm):02098                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02099                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02100                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02101                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02102                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02103                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02104                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02105                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02106                                   ; been reached. A colon definition split
                      (    forth6809.asm):02107                                   ; across multiple lines would have every
                      (    forth6809.asm):02108                                   ; word on every line after the first
                      (    forth6809.asm):02109                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02110                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02111                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02112                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02113                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02114                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02115                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02116                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02117                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):02118                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):02119                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):02120                                   ; so this still correctly forces interpret
                      (    forth6809.asm):02121                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):02122                                   ; semantics call for it - just not on every
                      (    forth6809.asm):02123                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):02124                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):02125         

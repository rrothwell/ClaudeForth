                      (    forth6809.asm):21529                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):21530                  NOP             ; BUG FIX (see the historical note above this
                      (    forth6809.asm):21531                  NOP             ; call site's own comment, describing the
                      (    forth6809.asm):21532                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):21533                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):21534                                  ; excluded the test framework, meaning
                      (    forth6809.asm):21535                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):21536                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):21537                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):21538                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):21539                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):21540                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):21541                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):21542                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):21543                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):21544                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):21545                  ENDC  ; <<<<<<<<<<

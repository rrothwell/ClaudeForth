D7B9 2401             (    forth6809.asm):04204                     BCC   UM0
D7BB 4C               (    forth6809.asm):04205                     INCA
D7BC E747             (    forth6809.asm):04206         UM0:        STB   7,U
D7BE A7E4             (    forth6809.asm):04207                     STA   ,S
D7C0 A646             (    forth6809.asm):04208                     LDA   6,U
D7C2 E661             (    forth6809.asm):04209                     LDB   1,S
D7C4 3D               (    forth6809.asm):04210                     MUL
D7C5 EBE4             (    forth6809.asm):04211                     ADDB  ,S
D7C7 2401             (    forth6809.asm):04212                     BCC   UM1
D7C9 4C               (    forth6809.asm):04213                     INCA
D7CA E746             (    forth6809.asm):04214         UM1:        STB   6,U
D7CC A7E4             (    forth6809.asm):04215                     STA   ,S
D7CE A645             (    forth6809.asm):04216                     LDA   5,U
D7D0 E661             (    forth6809.asm):04217                     LDB   1,S
D7D2 3D               (    forth6809.asm):04218                     MUL

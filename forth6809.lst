                      (    forth6809.asm):02681                    JSR   TSTTWOP
                      (    forth6809.asm):02682                    JSR   TSTTWOS
                      (    forth6809.asm):02683                    JSR   TSTTWOD1
                      (    forth6809.asm):02684                    JSR   TSTTWOD2

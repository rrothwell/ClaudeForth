E5A6 0322             (    forth6809.asm):16067                  COM   NUMNEG
E5A8 3001             (    forth6809.asm):16068                  LEAX  1,X
E5AA 0A21             (    forth6809.asm):16069                  DEC   CNTREM
E5AC 2756             (    forth6809.asm):16070                  BEQ   NQBAD
                      (    forth6809.asm):16071         

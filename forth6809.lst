F6A0 AE46             (    forth6809.asm):06998         COMPAREW:   LDX   6,U                ; Parameters stay on the data stack: u2 at 0,
F6A2 10AE42           (    forth6809.asm):06999                     LDY   2,U               ; c-addr2 at 2, u1 at 4, c-addr1 at 6
F6A5 EC44             (    forth6809.asm):07000                     LDD   4,U

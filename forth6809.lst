FFC6 12               (    forth6809.asm):10944                  NOP             ; BUG FIX (see the historical note above this
FFC7 12               (    forth6809.asm):10945                  NOP             ; call site's own comment, describing the
FFC8 12               (    forth6809.asm):10946                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):10947                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):10948                                  ; excluded the test framework, meaning
                      (    forth6809.asm):10949                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):10950                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):10951                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):10952                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):10953                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):10954                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):10955                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):10956                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):10957                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):10958                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):10959                  ENDC  ; <<<<<<<<<<

                      (    forth6809.asm):02352                     ; around the call - FLUSHOUTBUFFER only touches OUTHEAD/
                      (    forth6809.asm):02353                     ; OUTTAIL/ACIACR, none of which IRQH's RX path (INHEAD/
                      (    forth6809.asm):02354                     ; INTAIL) touches, so there is no correctness reason to
                      (    forth6809.asm):02355                     ; keep the receiver blind while this runs.
                      (    forth6809.asm):02356                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02357                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02358                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02359                                             ; expects the critical section active
                      (    forth6809.asm):02360         
                      (    forth6809.asm):02361                     BRA   PUT_EXIT
                      (    forth6809.asm):02362         
                      (    forth6809.asm):02363         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02364         ; priming the pump by transmitting a character.
DD83                  (    forth6809.asm):02365         CHK_INT_PATH:
                      (    forth6809.asm):02366                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02367                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02368         
                      (    forth6809.asm):02369                                             ; No! Restart.
                      (    forth6809.asm):02370                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02371                     LDB   OUTTAIL
                      (    forth6809.asm):02372                     LDA   B,X
                      (    forth6809.asm):02373                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02374         
                      (    forth6809.asm):02375                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02376                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02377                     STB   OUTTAIL
                      (    forth6809.asm):02378         
                      (    forth6809.asm):02379                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02380                     STA   OUTACTIVITY
                      (    forth6809.asm):02381                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02382         
DD83                  (    forth6809.asm):02383         PUT_EXIT:
                      (    forth6809.asm):02384                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02385                                             ; by restoring the CC.
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; GETCHAR
                      (    forth6809.asm):02388         ;    Inputs:
                      (    forth6809.asm):02389         ;        none
                      (    forth6809.asm):02390         ;    Outputs:
                      (    forth6809.asm):02391         ;         RegA  = next character retrieved from receive buffer.
                      (    forth6809.asm):02392         ;         RegCC(carry) = valid?.
                      (    forth6809.asm):02393         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02394         GETCHAR:
                      (    forth6809.asm):02395                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02396                     CMPB  INHEAD
                      (    forth6809.asm):02397                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02400                     LDA   B,X
                      (    forth6809.asm):02401         
                      (    forth6809.asm):02402                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02403                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02404                     STB   INTAIL
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406                     ; BUG FIX: CHKLO reads-then-writes RTSSTATE/OUTACTIVITY and
                      (    forth6809.asm):02407                     ; can write ACIACR (via UPDATE_RTS) - state IRQH's own
                      (    forth6809.asm):02408                     ; INCHAR path also reads and writes, by calling CHKHI too
                      (    forth6809.asm):02409                     ; (safely, from ISR context, where interrupts are already
                      (    forth6809.asm):02410                     ; hardware-masked). GETCHAR is only ever called from
                      (    forth6809.asm):02411                     ; mainline code (KEY), unmasked, so without masking here an
                      (    forth6809.asm):02412                     ; interrupt landing mid-call could race this call against
                      (    forth6809.asm):02413                     ; IRQH's own concurrent one, leaving RTSSTATE corrupted or
                      (    forth6809.asm):02414                     ; ACIACR written twice with conflicting values. Masked here
                      (    forth6809.asm):02415                     ; (IRQ only, matching RTSCHECKLO's own existing discipline
                      (    forth6809.asm):02416                     ; below) rather than inside CHKLO itself, since CHKHI's
                      (    forth6809.asm):02417                     ; ISR-context caller must NOT unmask IRQ before its own RTI.
                      (    forth6809.asm):02418                     ; The fill-level read is inside the same masked span, for
                      (    forth6809.asm):02419                     ; the same reason: INHEAD could be mid-update by the ISR.
                      (    forth6809.asm):02420                     ORCC  #$10
                      (    forth6809.asm):02421                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02422                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02423                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02424                                             ; there's no already-loaded value here
                      (    forth6809.asm):02425                                             ; worth reusing.
                      (    forth6809.asm):02426                     JSR   CHKLO
                      (    forth6809.asm):02427                     ANDCC #$EF
                      (    forth6809.asm):02428         
                      (    forth6809.asm):02429                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02430                     RTS
                      (    forth6809.asm):02431         
DD83                  (    forth6809.asm):02432         GET_NO_CHAR:
                      (    forth6809.asm):02433                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02434                     RTS
                      (    forth6809.asm):02435         ; ------------------------------------------------------------
                      (    forth6809.asm):02436         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):02437         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):02438         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):02439         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):02440         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):02441         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):02442         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):02443         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):02444         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02445         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02446         RTSCHECKLO:
                      (    forth6809.asm):02447                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02448         
                      (    forth6809.asm):02449                     JSR   INFILL
                      (    forth6809.asm):02450                     CMPA  #INLOWATER
                      (    forth6809.asm):02451                     BHI   RTSCLODONE
                      (    forth6809.asm):02452                     TST   RTSSTATE
                      (    forth6809.asm):02453                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02454         
                      (    forth6809.asm):02455         
                      (    forth6809.asm):02456                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02457         
                      (    forth6809.asm):02458                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02459                     CMPB  OUTHEAD
                      (    forth6809.asm):02460                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02461         
                      (    forth6809.asm):02462                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02463                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02464                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02465         
DD83                  (    forth6809.asm):02466         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02467                     STA   ACIACR
                      (    forth6809.asm):02468         
DD83                  (    forth6809.asm):02469         RTSCLOUNMASK:
                      (    forth6809.asm):02470                     ANDCC #$EF
                      (    forth6809.asm):02471         
DD83                  (    forth6809.asm):02472         RTSCLODONE: RTS
                      (    forth6809.asm):02473         
                      (    forth6809.asm):02474         ; ------------------------------------------------------------
                      (    forth6809.asm):02475         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02476         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02477         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02478         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02479         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02480         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02481         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02482         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02483         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02484         ;
                      (    forth6809.asm):02485         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02486         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02487         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02488         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02489         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02490         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02491         ;
                      (    forth6809.asm):02492         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02493         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02494         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02495         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02496         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02497         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02498         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02499         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02500         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02501         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02502         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02503         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02504         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02505         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02506         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02507         
                      (    forth6809.asm):02508                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02509                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02510                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02511                     BNE   INCHAR
                      (    forth6809.asm):02512                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02513                     BNE   OUTCHAR
                      (    forth6809.asm):02514                                             ; Ignore all other interrupts such as DCD change.
DD83                  (    forth6809.asm):02515         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02516                                             ; & restores state.
                      (    forth6809.asm):02517         
DD83                  (    forth6809.asm):02518         INCHAR:
                      (    forth6809.asm):02519                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02520                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02521                                             ; Any receiver error flagged?
                      (    forth6809.asm):02522                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02523         
                      (    forth6809.asm):02524                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02525                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02526                     INC   FECOUNT           ; more than one bit can be set at once.
DD83                  (    forth6809.asm):02527         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02528                     BEQ   INXOVRN
                      (    forth6809.asm):02529                     INC   OVRNCOUNT
DD83                  (    forth6809.asm):02530         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02531                     BEQ   INXPE
                      (    forth6809.asm):02532                     INC   PECOUNT
DD83                  (    forth6809.asm):02533         INXPE:      RTI
                      (    forth6809.asm):02534         
DD83                  (    forth6809.asm):02535         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02536                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02537                     LDB   INHEAD
                      (    forth6809.asm):02538                     STA   B,X
                      (    forth6809.asm):02539                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02540                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02541                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02542                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02543                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02544                     ;JSR   RTSCHECKHI     ; Protect the in buffer from overflow.
                      (    forth6809.asm):02545                                             ; OPTIMIZATION: RegB still holds the new head
                      (    forth6809.asm):02546                                             ; value STB just stored (STB doesn't clobber
                      (    forth6809.asm):02547                                             ; it) - reuse it directly to get the fill
                      (    forth6809.asm):02548                                             ; level, rather than have CHKHI reload INHEAD

                      (    forth6809.asm):01657         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01658         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01659         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01660         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01661         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01662         ;    Inputs:
                      (    forth6809.asm):01663         ;        none
                      (    forth6809.asm):01664         ;    Outputs:
                      (    forth6809.asm):01665         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01666         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01667         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01668         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01669         FLUSHOUTBUFFER:

D9E9 39               (    forth6809.asm):04406                     RTS
                      (    forth6809.asm):04407         
                      (    forth6809.asm):04408                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04409         ; ------------------------------------------------------------
                      (    forth6809.asm):04410         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04411         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04412         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04413         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04414         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04415         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04416         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04417         ; follow.
                      (    forth6809.asm):04418         ; ------------------------------------------------------------
D9EA                  (    forth6809.asm):04419         KEYW:
                      (    forth6809.asm):04420                     LDA   ACIASR
                      (    forth6809.asm):04421                     BITA  #SR_RDRF
                      (    forth6809.asm):04422                     BEQ   KWAIT
                      (    forth6809.asm):04423                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04424                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D9EA                  (    forth6809.asm):04425         KWAIT:
D9EA                  (    forth6809.asm):04426         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04427                     BITA  #SR_RDRF
                      (    forth6809.asm):04428                     BEQ   KSPIN
D9EA                  (    forth6809.asm):04429         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04430                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04431                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04432                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04433                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04434                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04435                     BEQ   KGETCH
                      (    forth6809.asm):04436                     BITA  #SR_FE
                      (    forth6809.asm):04437                     BEQ   KXFE
                      (    forth6809.asm):04438                     INC   FECOUNT
D9EA                  (    forth6809.asm):04439         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04440                     BEQ   KXOVRN
                      (    forth6809.asm):04441                     INC   OVRNCOUNT
D9EA                  (    forth6809.asm):04442         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04443                     BEQ   KGETCH
                      (    forth6809.asm):04444                     INC   PECOUNT
D9EA                  (    forth6809.asm):04445         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04446                     TFR   A,B
                      (    forth6809.asm):04447                     CLRA
                      (    forth6809.asm):04448                     PSHU  D                 ; char
                      (    forth6809.asm):04449                     RTS
                      (    forth6809.asm):04450         
                      (    forth6809.asm):04451         ; ------------------------------------------------------------
                      (    forth6809.asm):04452         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04453         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04454         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04455         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04456         ;    Inputs:
                      (    forth6809.asm):04457         ;        none
                      (    forth6809.asm):04458         ;    Outputs:
                      (    forth6809.asm):04459         ;        XON or XOFF transmitted
                      (    forth6809.asm):04460         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04461         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04462         ; ------------------------------------------------------------
D9EA                  (    forth6809.asm):04463         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04464                     BRA   PUTXCH
D9EA                  (    forth6809.asm):04465         PUTXON:     LDA   #XONCH
D9EA                  (    forth6809.asm):04466         PUTXCH:     PSHS  A
D9EA                  (    forth6809.asm):04467         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04468                     BITB  #SR_TDRE
                      (    forth6809.asm):04469                     BEQ   PXWT
                      (    forth6809.asm):04470                     PULS  A
                      (    forth6809.asm):04471                     STA   ACIADR
                      (    forth6809.asm):04472                     RTS
                      (    forth6809.asm):04473         
                      (    forth6809.asm):04474         ; ------------------------------------------------------------
                      (    forth6809.asm):04475         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04476         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04477         ; ------------------------------------------------------------
D9EA                  (    forth6809.asm):04478         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):04479                     BITA  #SR_RDRF
                      (    forth6809.asm):04480                     BEQ   KQFALSE
                      (    forth6809.asm):04481                     LDD   #TRUEV
                      (    forth6809.asm):04482                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04483                     RTS
D9EA                  (    forth6809.asm):04484         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04485                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04486                     RTS
                      (    forth6809.asm):04487         
                      (    forth6809.asm):04488         ; ------------------------------------------------------------
                      (    forth6809.asm):04489         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04490         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04491         ; ------------------------------------------------------------
D9EA                  (    forth6809.asm):04492         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):04493                     STB   EMITCH
D9EA                  (    forth6809.asm):04494         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):04495                     BITA  #SR_TDRE
                      (    forth6809.asm):04496                     BEQ   EMITWT
                      (    forth6809.asm):04497                     LDA   EMITCH
                      (    forth6809.asm):04498                     STA   ACIADR
                      (    forth6809.asm):04499                     RTS
                      (    forth6809.asm):04500         
                      (    forth6809.asm):04501                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04502         
                      (    forth6809.asm):04503         ; ------------------------------------------------------------
                      (    forth6809.asm):04504         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04505         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04506         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04507         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04508         ; ------------------------------------------------------------

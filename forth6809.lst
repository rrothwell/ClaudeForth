                      (    forth6809.asm):00774         ; ------------------------------------------------------------
                      (    forth6809.asm):00775         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00776         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00777         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00778         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00779         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00780         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00781         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00782         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00783         ;
                      (    forth6809.asm):00784         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00785         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00786         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00787         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00788         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00789         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00790         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00791         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00792         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00793         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00794         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00795         ; ------------------------------------------------------------
                      (    forth6809.asm):00796                     ORG   $0100
0100                  (    forth6809.asm):00797         MVCNT       RMB   2
0102                  (    forth6809.asm):00798         MVDST       RMB   2
0104                  (    forth6809.asm):00799         MVSRC       RMB   2
     0100             (    forth6809.asm):00800         HSLEN       EQU   MVCNT
     0102             (    forth6809.asm):00801         HSADDR      EQU   MVDST
     0104             (    forth6809.asm):00802         MRESULT     EQU   MVSRC
     0104             (    forth6809.asm):00803         FILLCHR     EQU   MVSRC
                      (    forth6809.asm):00804         
                      (    forth6809.asm):00805         ; ------------------------------------------------------------
                      (    forth6809.asm):00806         ; Ring buffers for serial communications.
                      (    forth6809.asm):00807         ; One for input, one for output.
                      (    forth6809.asm):00808         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00809         ; The tricks are not used.
                      (    forth6809.asm):00810         ; ------------------------------------------------------------
                      (    forth6809.asm):00811                     ORG   SERBUFCTL         ; $176.
                      (    forth6809.asm):00812         
0176                  (    forth6809.asm):00813         INHEAD      RMB   1
0177                  (    forth6809.asm):00814         INTAIL      RMB   1
                      (    forth6809.asm):00815         ; RTSSTATE -> INREQUEST ?
0178                  (    forth6809.asm):00816         RTSSTATE    RMB   1                 ; $00 = RTS Low (Clear), $FF = RTS High (Throttle)
                      (    forth6809.asm):00817         
0179                  (    forth6809.asm):00818         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00819         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00820         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00821         
017C                  (    forth6809.asm):00822         FECOUNT     RMB   1                 ; framing-error count, incremented by IRQH (interrupt
                      (    forth6809.asm):00823                                             ; build) or by polling KEY (polling build - see below)
017D                  (    forth6809.asm):00824         OVRNCOUNT   RMB   1                 ; overrun count, same as above
017E                  (    forth6809.asm):00825         PECOUNT     RMB   1                 ; parity-error count, same as above
017F                  (    forth6809.asm):00826         POLLREADYCNT
017F                  (    forth6809.asm):00827                     RMB   1                 ; polling build only: counts every KEY call that found
                      (    forth6809.asm):00828                                             ; RDRF already set on its very first check, before
                      (    forth6809.asm):00829                                             ; spinning at all - i.e. a character was already
                      (    forth6809.asm):00830                                             ; sitting queued when we came back to poll for it.
                      (    forth6809.asm):00831                                             ; A high count relative to total characters received
                      (    forth6809.asm):00832                                             ; is evidence the host is running ahead of what the
                      (    forth6809.asm):00833                                             ; 6809 has actually consumed (a transport-buffered
                      (    forth6809.asm):00834                                             ; backlog), distinct from a genuine ACIA overrun
                      (    forth6809.asm):00835                                             ; (which OVRNCOUNT would show instead) - last free
                      (    forth6809.asm):00836                                             ; byte in this block, right before SERBUF's 64-byte
                      (    forth6809.asm):00837                                             ; alignment at $0180.
                      (    forth6809.asm):00838         
                      (    forth6809.asm):00839                     ORG   SERBUF            ; $180, a 64 byte boundary.
                      (    forth6809.asm):00840         
                      (    forth6809.asm):00841                     ALIGN 64                ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00842         INBUF       RMB   INBUFSZ           ; Receive circular queue buffer
                      (    forth6809.asm):00843         
                      (    forth6809.asm):00844                     ALIGN 64                ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00845         OUTBUF      RMB   OUTBUFSZ          ; Transmit circular queue buffer
                      (    forth6809.asm):00846         
                      (    forth6809.asm):00847         ; ------------------------------------------------------------
                      (    forth6809.asm):00848         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00849         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00850         ; ------------------------------------------------------------
                      (    forth6809.asm):00851                     ORG   USROMSTRT
                      (    forth6809.asm):00852         
                      (    forth6809.asm):00853                     IFNDEF UNITTESTS
C100                  (    forth6809.asm):00854         UNITTESTS   SET   0                 ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00855                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00856                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00857                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00858                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00859                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00860                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00861                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00862                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00863                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00864                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00865                           ; choice is made, not what including it does.
                      (    forth6809.asm):00866                     ENDC
                      (    forth6809.asm):00867         
                      (    forth6809.asm):00868                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00869         TSTSELECTOR SET   2                 ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00870                     ENDC
                      (    forth6809.asm):00871         
                      (    forth6809.asm):00872                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):00873         
                      (    forth6809.asm):00874         ; ------------------------------------------------------------
                      (    forth6809.asm):00875         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00876         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00877         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00878         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00879         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00880         ; ------------------------------------------------------------
                      (    forth6809.asm):00881                     INCLUDE unit_tests.asm
                      (   unit_tests.asm):00001         ; ============================================================
                      (   unit_tests.asm):00002         ; UNIT TEST FRAMEWORK
                      (   unit_tests.asm):00003         ;
                      (   unit_tests.asm):00004         ; Self-checking assembly-level tests for this ROM's own
                      (   unit_tests.asm):00005         ; primitives, gated by UNITTESTS below and run once at cold
                      (   unit_tests.asm):00006         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (   unit_tests.asm):00007         ; already valid - COLDSTRT sets them at its very start - but
                      (   unit_tests.asm):00008         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (   unit_tests.asm):00009         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (   unit_tests.asm):00010         ; set them to). Lives here, in previously-unused ROM space right
                      (   unit_tests.asm):00011         ; after INOUT's shadow, since this was pure FILL padding before
                      (   unit_tests.asm):00012         ; this existed - the default build (UNITTESTS undefined, or
                      (   unit_tests.asm):00013         ; defined as 0) removes it entirely and this block reverts to
                      (   unit_tests.asm):00014         ; exactly that padding, computed automatically below via the ROM
                      (   unit_tests.asm):00015         ; label rather than a fixed byte count, so it's correct either
                      (   unit_tests.asm):00016         ; way without needing to be hand-adjusted. Pass
                      (   unit_tests.asm):00017         ; --define=UNITTESTS on the lwasm command line (see the example
                      (   unit_tests.asm):00018         ; at the end of this comment) to include it.
                      (   unit_tests.asm):00019         ;
                      (   unit_tests.asm):00020         ; Each test is independent by construction: it saves the data
                      (   unit_tests.asm):00021         ; stack pointer (U) before touching anything, and unconditionally
                      (   unit_tests.asm):00022         ; restores it at the end regardless of pass or fail - so one
                      (   unit_tests.asm):00023         ; test's assertions failing can never leave stack residue for the
                      (   unit_tests.asm):00024         ; next test to inherit. Test scratch variables live in the very
                      (   unit_tests.asm):00025         ; start of APPVARS - safe only because tests run strictly before
                      (   unit_tests.asm):00026         ; COLD initializes VARHERE to that same address; COLD immediately
                      (   unit_tests.asm):00027         ; and correctly re-purposes that space afterward.
                      (   unit_tests.asm):00028         ;
                      (   unit_tests.asm):00029         ; Reporting: each test's name (a counted string, matching how
                      (   unit_tests.asm):00030         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (   unit_tests.asm):00031         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (   unit_tests.asm):00032         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (   unit_tests.asm):00033         ;
                      (   unit_tests.asm):00034         ; Test groups are further gated by TSTSELECTOR (see below), one
                      (   unit_tests.asm):00035         ; group at a time, since assembling every group together exhausts
                      (   unit_tests.asm):00036         ; the available unused ROM space. Example command line, testing
                      (   unit_tests.asm):00037         ; group 2 with tests included:
                      (   unit_tests.asm):00038         ;
                      (   unit_tests.asm):00039         ;   lwasm --6809 --format=raw \
                      (   unit_tests.asm):00040         ;   --output=forth6809.bin --list=forth6809.lst \
                      (   unit_tests.asm):00041         ;   --define=UNITTESTS --define=TSTSELECTOR=2 \
                      (   unit_tests.asm):00042         ;   forth6809.asm
                      (   unit_tests.asm):00043         ; ============================================================
                      (   unit_tests.asm):00044         
     021B             (   unit_tests.asm):00045         TSTU0       EQU   APPVARS           ; saved U, before a test touches it
     021D             (   unit_tests.asm):00046         TSTUB4      EQU   APPVARS+2         ; U immediately before the op under test
     021F             (   unit_tests.asm):00047         TSTUAF      EQU   APPVARS+4         ; U immediately after the op under test
     0221             (   unit_tests.asm):00048         TSTFLAG     EQU   APPVARS+6         ; scratch for TSTREPORT's pass/fail arg
                      (   unit_tests.asm):00049         
     3C7A             (   unit_tests.asm):00050         TSTGUARD    EQU   $3C7A             ; sentinel value, pushed below the value
                      (   unit_tests.asm):00051                                             ; under test, to prove an operation
                      (   unit_tests.asm):00052                                             ; doesn't disturb what's beneath it
     59E1             (   unit_tests.asm):00053         TSTVAL1     EQU   $59E1             ; the value under test itself - neither
                      (   unit_tests.asm):00054                                             ; constant is 0, 1, or -1, so a test
                      (   unit_tests.asm):00055                                             ; that only appears to pass due to a
                      (   unit_tests.asm):00056                                             ; trivial/special-cased value would be
                      (   unit_tests.asm):00057                                             ; caught rather than masked
     2468             (   unit_tests.asm):00058         TSTVAL2     EQU   $2468             ; additional distinct, non-trivial
     7B3D             (   unit_tests.asm):00059         TSTVAL3     EQU   $7B3D             ; values for multi-item tests (SWAP,
     4E2C             (   unit_tests.asm):00060         TSTVAL4     EQU   $4E2C             ; OVER, ROT, 2DUP, 2ROT, etc) - none are
     19A7             (   unit_tests.asm):00061         TSTVAL5     EQU   $19A7             ; 0, 1, -1, TSTGUARD, or any of each
     6D95             (   unit_tests.asm):00062         TSTVAL6     EQU   $6D95             ; other
                      (   unit_tests.asm):00063         
     0223             (   unit_tests.asm):00064         TSTSCR      EQU   APPVARS+8         ; extra scratch cell - for tests (DEPTH)
                      (   unit_tests.asm):00065                                             ; that need to compute an expected value
                      (   unit_tests.asm):00066                                             ; independently before comparing
                      (   unit_tests.asm):00067         
     0225             (   unit_tests.asm):00068         TSTCBUF     EQU   APPVARS+10        ; compile-time test harness (section 3.8,
                      (   unit_tests.asm):00069                                             ; control flow): scratch buffer real
                      (   unit_tests.asm):00070                                             ; compile-time words (IF/THEN/DO/LOOP/
                      (   unit_tests.asm):00071                                             ; etc) actually compile into - CODEHERE
                      (   unit_tests.asm):00072                                             ; is redirected here for the duration of
                      (   unit_tests.asm):00073                                             ; each compile, then restored, so the
                      (   unit_tests.asm):00074                                             ; real ROM/dictionary is never touched.
                      (   unit_tests.asm):00075                                             ; 80 bytes - generous headroom for the
                      (   unit_tests.asm):00076                                             ; small test snippets planned (the
                      (   unit_tests.asm):00077                                             ; largest, CASE with two OF clauses,
                      (   unit_tests.asm):00078                                             ; comes nowhere close)
     0275             (   unit_tests.asm):00079         TSTCSAV     EQU   APPVARS+90        ; saved CODEHERE, across a redirected
                      (   unit_tests.asm):00080                                             ; compile
     0277             (   unit_tests.asm):00081         TSTCSPS     EQU   APPVARS+92        ; saved CSP, across a redirected compile -
                      (   unit_tests.asm):00082                                             ; EXIT's own frame-counting scan depends
                      (   unit_tests.asm):00083                                             ; on CSP marking the right baseline
     0279             (   unit_tests.asm):00084         TSTLSAV     EQU   APPVARS+94        ; saved LATEST, across a RECURSE test
                      (   unit_tests.asm):00085                                             ; (which reads LATEST directly)
     027B             (   unit_tests.asm):00086         TSTFHDR     EQU   APPVARS+96        ; fake dictionary header, for RECURSE to
                      (   unit_tests.asm):00087                                             ; read via a redirected LATEST - 16
                      (   unit_tests.asm):00088                                             ; bytes (LEN/FL + name + LINK + CFA,
                      (   unit_tests.asm):00089                                             ; comfortably fits any short test name)
                      (   unit_tests.asm):00090         
     028B             (   unit_tests.asm):00091         TSTDBUF     EQU   APPVARS+112       ; defining-words test harness (section
                      (   unit_tests.asm):00092                                             ; 3.9): scratch dictionary buffer -
                      (   unit_tests.asm):00093                                             ; DPHERE is redirected here for the
                      (   unit_tests.asm):00094                                             ; duration of each defining-word call,
                      (   unit_tests.asm):00095                                             ; so a real header never lands in the
                      (   unit_tests.asm):00096                                             ; real dictionary. 40 bytes.
     02B3             (   unit_tests.asm):00097         TSTDSAV     EQU   APPVARS+152       ; saved DPHERE
     02B5             (   unit_tests.asm):00098         TSTVBUF     EQU   APPVARS+154       ; scratch VARHERE buffer, for VARIABLE/
                      (   unit_tests.asm):00099                                             ; VALUE/2VARIABLE/BUFFER: to reserve
                      (   unit_tests.asm):00100                                             ; their own mutable space into. 20
                      (   unit_tests.asm):00101                                             ; bytes.
     02C9             (   unit_tests.asm):00102         TSTVSAV     EQU   APPVARS+174       ; saved VARHERE
     02CB             (   unit_tests.asm):00103         TSTNAMEB    EQU   APPVARS+176       ; scratch fake source text, for HEADER's
                      (   unit_tests.asm):00104                                             ; own WORD-based name parsing (every
                      (   unit_tests.asm):00105                                             ; defining word reads a name from the
                      (   unit_tests.asm):00106                                             ; input source - unlike anything in
                      (   unit_tests.asm):00107                                             ; section 3.8) - 16 bytes
     02DB             (   unit_tests.asm):00108         TSTSASAV    EQU   APPVARS+192       ; saved SRCADDR
     02DD             (   unit_tests.asm):00109         TSTSLSAV    EQU   APPVARS+194       ; saved SRCLEN
     02DF             (   unit_tests.asm):00110         TSTTISAV    EQU   APPVARS+196       ; saved TOIN
     02E1             (   unit_tests.asm):00111         TSTWCFA     EQU   APPVARS+198       ; the newly-defined test word's own CFA -
                      (   unit_tests.asm):00112                                             ; equal to CODEHERE (redirected) at the
                      (   unit_tests.asm):00113                                             ; moment the defining word is called,
                      (   unit_tests.asm):00114                                             ; saved so the compiled trampoline can
                      (   unit_tests.asm):00115                                             ; be executed afterward to verify its
                      (   unit_tests.asm):00116                                             ; runtime behavior
     02E3             (   unit_tests.asm):00117         TSTSTSAV    EQU   APPVARS+200       ; saved STATE, across a :/; test
     02E5             (   unit_tests.asm):00118         TSTSMFLG    EQU   APPVARS+202       ; scratch: header SMUDGE-bit check result
     02E7             (   unit_tests.asm):00119         TSTDOESA    EQU   APPVARS+204       ; address of a compiled "JSR SETDOES" -
                      (   unit_tests.asm):00120                                             ; JSR'd directly to simulate an outer
                      (   unit_tests.asm):00121                                             ; defining word reaching that point,
                      (   unit_tests.asm):00122                                             ; without needing to actually build one
     02EF             (   unit_tests.asm):00123         TSTCSAV2    EQU   APPVARS+212       ; MARKER test: CODEHERE right after
                      (   unit_tests.asm):00124                                             ; executing the marker word (before it's
                      (   unit_tests.asm):00125                                             ; overwritten by this test's own restore)
     02F1             (   unit_tests.asm):00126         TSTDSAV2    EQU   APPVARS+214       ; same, DPHERE
     02F3             (   unit_tests.asm):00127         TSTVSAV2    EQU   APPVARS+216       ; same, VARHERE
     02F5             (   unit_tests.asm):00128         TSTLSAV2    EQU   APPVARS+218       ; same, LATEST
     02F7             (   unit_tests.asm):00129         TSTCBUF2    EQU   APPVARS+220       ; a SECOND, separate CODEHERE-redirect
                      (   unit_tests.asm):00130                                             ; target - real bug found via MAME: WORD
                      (   unit_tests.asm):00131                                             ; writes its parsed-token output directly
                      (   unit_tests.asm):00132                                             ; at CODEHERE (by its own documented
                      (   unit_tests.asm):00133                                             ; design, matching the ANS transient-
                      (   unit_tests.asm):00134                                             ; region contract - confirmed by reading
                      (   unit_tests.asm):00135                                             ; WORD's own code, not assumed). Any test
                      (   unit_tests.asm):00136                                             ; that parses a SECOND name later (TO,
                      (   unit_tests.asm):00137                                             ; IS, ACTION-OF) must NOT redirect
                      (   unit_tests.asm):00138                                             ; CODEHERE back to TSTCBUF for that
                      (   unit_tests.asm):00139                                             ; second parse, since TSTCBUF still holds
                      (   unit_tests.asm):00140                                             ; the FIRST word's already-compiled
                      (   unit_tests.asm):00141                                             ; trampoline at that point - WORD would
                      (   unit_tests.asm):00142                                             ; silently overwrite it, corrupting the
                      (   unit_tests.asm):00143                                             ; CFA that TSTWCFA still points to before
                      (   unit_tests.asm):00144                                             ; it gets a second chance to execute. 20
                      (   unit_tests.asm):00145                                             ; bytes - comfortably fits any short
                      (   unit_tests.asm):00146                                             ; parsed name plus its length byte.
     030B             (   unit_tests.asm):00147         TSTUMID     EQU   APPVARS+240       ; intermediate U capture (section 3.3,
                      (   unit_tests.asm):00148                                             ; return stack): >R/2>R tests capture U
                      (   unit_tests.asm):00149                                             ; right after moving a value to the
                      (   unit_tests.asm):00150                                             ; return stack, before moving it back -
                      (   unit_tests.asm):00151                                             ; a round-trip-only check could pass even
                      (   unit_tests.asm):00152                                             ; if both the move-out and move-back were
                      (   unit_tests.asm):00153                                             ; broken no-ops, since the value would
                      (   unit_tests.asm):00154                                             ; never have actually left; this catches
                      (   unit_tests.asm):00155                                             ; that specifically.
                      (   unit_tests.asm):00156         
     030D             (   unit_tests.asm):00157         TSTOHSAV    EQU   APPVARS+242       ; section 3.1 (System/Console I/O):
                      (   unit_tests.asm):00158                                             ; saves OUTHEAD (the output ring buffer's
                      (   unit_tests.asm):00159                                             ; write index) before an EMIT-family call,
                      (   unit_tests.asm):00160                                             ; so the test can confirm the character(s)
                      (   unit_tests.asm):00161                                             ; were genuinely queued into OUTBUF - not
                      (   unit_tests.asm):00162                                             ; just that the call returned without
                      (   unit_tests.asm):00163                                             ; crashing.
                      (   unit_tests.asm):00164         
     030E             (   unit_tests.asm):00165         TSTBASAV    EQU   APPVARS+243       ; section 3.13 (Numeric Output): saves the
                      (   unit_tests.asm):00166                                             ; real BASE across tests that do digit
                      (   unit_tests.asm):00167                                             ; conversion. Real bug found via MAME:
                      (   unit_tests.asm):00168                                             ; this whole test framework runs before
                      (   unit_tests.asm):00169                                             ; COLD (confirmed by tracing the boot
                      (   unit_tests.asm):00170                                             ; sequence directly - COLDSTRT clears all
                      (   unit_tests.asm):00171                                             ; of GLOBALS, including BASE, to zero,
                      (   unit_tests.asm):00172                                             ; then calls TSTRUNNER, with COLD's own
                      (   unit_tests.asm):00173                                             ; "BASE=10" initialization not running
                      (   unit_tests.asm):00174                                             ; until later) - so BASE reads as zero at
                      (   unit_tests.asm):00175                                             ; test time, not 10. With BASE=0,
                      (   unit_tests.asm):00176                                             ; UDDIGIT's own restoring-division
                      (   unit_tests.asm):00177                                             ; algorithm degrades into an unconditional
                      (   unit_tests.asm):00178                                             ; shift (the "subtract and check" step
                      (   unit_tests.asm):00179                                             ; never actually subtracts, since nothing
                      (   unit_tests.asm):00180                                             ; can compare below zero), so the value
                      (   unit_tests.asm):00181                                             ; being converted never genuinely
                      (   unit_tests.asm):00182                                             ; decreases - NUMSIGNS' own loop-until-
                      (   unit_tests.asm):00183                                             ; zero condition then never becomes true.
                      (   unit_tests.asm):00184                                             ; Every test in this section doing digit
                      (   unit_tests.asm):00185                                             ; conversion now explicitly saves BASE,
                      (   unit_tests.asm):00186                                             ; sets it to 10, and restores it
                      (   unit_tests.asm):00187                                             ; afterward - the same save/set/restore
                      (   unit_tests.asm):00188                                             ; pattern already established for
                      (   unit_tests.asm):00189                                             ; CODEHERE/STATE/SRCADDR etc throughout
                      (   unit_tests.asm):00190                                             ; this whole session, just not initially
                      (   unit_tests.asm):00191                                             ; applied to BASE since it was assumed
                      (   unit_tests.asm):00192                                             ; (incorrectly, for this specific,
                      (   unit_tests.asm):00193                                             ; pre-COLD execution context) to already
                      (   unit_tests.asm):00194                                             ; hold a valid value.
                      (   unit_tests.asm):00195         
     0310             (   unit_tests.asm):00196         TSTHANDSAV  EQU   APPVARS+245       ; section 3.15 (Exception Handling): saves
                      (   unit_tests.asm):00197                                             ; the real HANDLER across a test verifying
                      (   unit_tests.asm):00198                                             ; CATCH correctly restores it afterward,
                      (   unit_tests.asm):00199                                             ; on both the success and throw paths -
                      (   unit_tests.asm):00200                                             ; confirmed via CATCH's own code that it
                      (   unit_tests.asm):00201                                             ; saves/restores HANDLER around every
                      (   unit_tests.asm):00202                                             ; call regardless of outcome, matching its
                      (   unit_tests.asm):00203                                             ; own documented "restores... HANDLER on
                      (   unit_tests.asm):00204                                             ; either path".
                      (   unit_tests.asm):00205         
     0312             (   unit_tests.asm):00206         TSTSISAV    EQU   APPVARS+247       ; section 3.17 (Environmental & System
                      (   unit_tests.asm):00207                                             ; Queries): saves the real SRCID across
                      (   unit_tests.asm):00208                                             ; TSTSOURCEID's and TSTREFILL's own tests,
                      (   unit_tests.asm):00209                                             ; both of which redirect SRCID directly.
                      (   unit_tests.asm):00210         
     CFC7             (   unit_tests.asm):00211         TSTNEG1     EQU   $CFC7             ; -12345 - distinct, non-trivial negative
                      (   unit_tests.asm):00212                                             ; test values, needed for arithmetic
                      (   unit_tests.asm):00213                                             ; tests (ABS, NEGATE, MIN/MAX, signed
                      (   unit_tests.asm):00214                                             ; division, 2/) whose logic genuinely
                      (   unit_tests.asm):00215                                             ; branches on sign - TSTVAL1-6 above are
                      (   unit_tests.asm):00216                                             ; all positive, which wouldn't exercise
                      (   unit_tests.asm):00217                                             ; those branches
     FEBF             (   unit_tests.asm):00218         TSTNEG2     EQU   $FEBF             ; -321
                      (   unit_tests.asm):00219         
     0001             (   unit_tests.asm):00220         TSTD1HI     EQU   $0001             ; TSTDBL1 = 70000 (positive, exceeds 16
     1170             (   unit_tests.asm):00221         TSTD1LO     EQU   $1170             ; bits - exercises real double-cell width,
                      (   unit_tests.asm):00222                                             ; not just a sign-extended single)
     FFFE             (   unit_tests.asm):00223         TSTD2HI     EQU   $FFFE             ; TSTDBL2 = -70000
     EE90             (   unit_tests.asm):00224         TSTD2LO     EQU   $EE90
     00BC             (   unit_tests.asm):00225         TSTD3HI     EQU   $00BC             ; TSTDBL3 = 12345678
     614E             (   unit_tests.asm):00226         TSTD3LO     EQU   $614E
     0000             (   unit_tests.asm):00227         TSTDSHI     EQU   $0000             ; TSTDBLSMALL = 500 - small enough to fit
     01F4             (   unit_tests.asm):00228         TSTDSLO     EQU   $01F4             ; in a single cell, for D>S
                      (   unit_tests.asm):00229         
                      (   unit_tests.asm):00230         ; ------------------------------------------------------------
                      (   unit_tests.asm):00231         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (   unit_tests.asm):00232         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (   unit_tests.asm):00233         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (   unit_tests.asm):00234         ; then a CR, readying the terminal for the next test's line.
                      (   unit_tests.asm):00235         ; ------------------------------------------------------------
C100 3706             (   unit_tests.asm):00236         TSTREPORT:  PULU  D
C102 FD0221           (   unit_tests.asm):00237                     STD   TSTFLAG
C105 BDF5BF           (   unit_tests.asm):00238                     JSR   COUNT
C108 BDF59B           (   unit_tests.asm):00239                     JSR   TYPE
C10B FC0221           (   unit_tests.asm):00240                     LDD   TSTFLAG
C10E 270C             (   unit_tests.asm):00241                     BEQ   TSTFAILR
C110 CCC12D           (   unit_tests.asm):00242                     LDD   #TSTOKMSG
C113 3606             (   unit_tests.asm):00243                     PSHU  D
C115 CC0003           (   unit_tests.asm):00244                     LDD   #TSTOKMSGL
C118 3606             (   unit_tests.asm):00245                     PSHU  D
C11A 200A             (   unit_tests.asm):00246                     BRA   TSTPRINT
C11C CCC130           (   unit_tests.asm):00247         TSTFAILR:   LDD   #TSTFAILMSG
C11F 3606             (   unit_tests.asm):00248                     PSHU  D
C121 CC0005           (   unit_tests.asm):00249                     LDD   #TSTFAILMSGL
C124 3606             (   unit_tests.asm):00250                     PSHU  D
C126 BDF59B           (   unit_tests.asm):00251         TSTPRINT:   JSR   TYPE

                      (    forth6809.asm):06299                  JSR   IF
                      (    forth6809.asm):06300         
                      (    forth6809.asm):06301                  LDD   #111
                      (    forth6809.asm):06302                  PSHU  D
                      (    forth6809.asm):06303                  JSR   LITERALW
                      (    forth6809.asm):06304         
                      (    forth6809.asm):06305                  JSR   THEN
                      (    forth6809.asm):06306         
                      (    forth6809.asm):06307                  LDD   #OPRTS
                      (    forth6809.asm):06308                  PSHU  D
                      (    forth6809.asm):06309                  JSR   CCOMMA
                      (    forth6809.asm):06310         
                      (    forth6809.asm):06311                  LDD   TSTCSAV
                      (    forth6809.asm):06312                  STD   CODEHERE
                      (    forth6809.asm):06313         
                      (    forth6809.asm):06314                  STU   TSTU0
                      (    forth6809.asm):06315         
                      (    forth6809.asm):06316                  LDD   #TSTGUARD
                      (    forth6809.asm):06317                  PSHU  D
                      (    forth6809.asm):06318                  LDD   #FALSEV
                      (    forth6809.asm):06319                  PSHU  D
                      (    forth6809.asm):06320                  STU   TSTUB4
                      (    forth6809.asm):06321         
                      (    forth6809.asm):06322                  JSR   TSTCBUF
                      (    forth6809.asm):06323         
                      (    forth6809.asm):06324                  STU   TSTUAF
                      (    forth6809.asm):06325         
                      (    forth6809.asm):06326                  PULU  D
                      (    forth6809.asm):06327                  CMPD  #TSTGUARD
                      (    forth6809.asm):06328                  BNE   T2FAIL
                      (    forth6809.asm):06329         
                      (    forth6809.asm):06330                  LDD   TSTUB4
                      (    forth6809.asm):06331                  SUBD  TSTUAF
                      (    forth6809.asm):06332                  CMPD  #-2
                      (    forth6809.asm):06333                  BNE   T2FAIL
                      (    forth6809.asm):06334         
                      (    forth6809.asm):06335                  LDD   #TRUEV
                      (    forth6809.asm):06336                  BRA   T2DONE
C100                  (    forth6809.asm):06337         T2FAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):06338         T2DONE:  LDX   #TSTIFT2NAME
                      (    forth6809.asm):06339                  PSHU  X
                      (    forth6809.asm):06340                  PSHU  D
                      (    forth6809.asm):06341                  JSR   TSTREPORT
                      (    forth6809.asm):06342         
                      (    forth6809.asm):06343                  LDU   TSTU0
                      (    forth6809.asm):06344                  RTS
                      (    forth6809.asm):06345         
C100                  (    forth6809.asm):06346         TSTIFT2NAME: FCB  7
                      (    forth6809.asm):06347                      FCC  "TSTIFT2"
                      (    forth6809.asm):06348         
                      (    forth6809.asm):06349         ; ------------------------------------------------------------
                      (    forth6809.asm):06350         ; TSTIET1 - unit test for IF/ELSE/THEN, true case. Compiles
                      (    forth6809.asm):06351         ; "IF <lit 111> ELSE <lit 222> THEN" into scratch. True flag
                      (    forth6809.asm):06352         ; should take the IF-body (111) and skip the ELSE-body (222)
                      (    forth6809.asm):06353         ; via ELSE's own unconditional branch. Verified by hand-trace:
                      (    forth6809.asm):06354         ; IF's patched offset (12) lands exactly at the ELSE-body's
                      (    forth6809.asm):06355         ; start; ELSE's own patched offset (7) lands exactly past it.
                      (    forth6809.asm):06356         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06357         TSTIET1: LDD   CODEHERE
                      (    forth6809.asm):06358                  STD   TSTCSAV
                      (    forth6809.asm):06359                  LDD   #TSTCBUF

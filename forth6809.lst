                      (    forth6809.asm):02272                    BNE   RLFAIL
                      (    forth6809.asm):02273                    PULU  D
                      (    forth6809.asm):02274                    CMPD  #TSTVAL3
                      (    forth6809.asm):02275                    BNE   RLFAIL
                      (    forth6809.asm):02276                    PULU  D

                      (    forth6809.asm):01766         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01767         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01768         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01769         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01770         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01771         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01772         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01773         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01774         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01775         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01776         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):01777         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):01778                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):01779                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01780                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01781                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01782                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):01783                  FDB   ABORT
                      (    forth6809.asm):01784         
DEBE 04               (    forth6809.asm):01785         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):01786                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):01787                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):01788                  FDB   QUIT
                      (    forth6809.asm):01789         
                      (    forth6809.asm):01790         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):01791         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):01792         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):01793         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):01794         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):01795         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):01796         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):01797                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):01798                  FDB   H_QUIT
DECE E476             (    forth6809.asm):01799                  FDB   FIND
                      (    forth6809.asm):01800         
DED0 01               (    forth6809.asm):01801         H_1:     FCB   1
DED1 31               (    forth6809.asm):01802                  FCC   "1"
DED2 DEC7             (    forth6809.asm):01803                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):01804                  FDB   ONEBODY
                      (    forth6809.asm):01805         
DED6 02               (    forth6809.asm):01806         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):01807                  FCC   "-1"
DED9 DED0             (    forth6809.asm):01808                  FDB   H_1
DEDB FF49             (    forth6809.asm):01809                  FDB   MONEBODY
                      (    forth6809.asm):01810         
DEDD 01               (    forth6809.asm):01811         H_2:     FCB   1
DEDE 32               (    forth6809.asm):01812                  FCC   "2"
DEDF DED6             (    forth6809.asm):01813                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):01814                  FDB   TWOBODY
                      (    forth6809.asm):01815         
DEE3 02               (    forth6809.asm):01816         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):01817                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):01818                  FDB   H_2
DEE8 FF55             (    forth6809.asm):01819                  FDB   MTWOBODY
                      (    forth6809.asm):01820         
     DEE3             (    forth6809.asm):01821         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01822                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01823                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01824                                   ; were chained on after it; before that,
                      (    forth6809.asm):01825                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01826                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01827                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01828                                   ; before this one.
                      (    forth6809.asm):01829         
                      (    forth6809.asm):01830         ; Verify no collision with base code.
                      (    forth6809.asm):01831         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):01832         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01833         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01834         
                      (    forth6809.asm):01835         ; ============================================================
                      (    forth6809.asm):01836         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01837         ; ============================================================
                      (    forth6809.asm):01838                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01839                                        ; entirely - every routine from here through
                      (    forth6809.asm):01840                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01841                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01842                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01843                                        ; WARM message left the location counter,
                      (    forth6809.asm):01844                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01845                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01846                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01847         
                      (    forth6809.asm):01848         ; ------------------------------------------------------------
                      (    forth6809.asm):01849         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01850         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01851         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01852         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01853         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01854         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):01855         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):01856                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01857                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01858                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01859                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01860                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01861                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):01862                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01863                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):01864                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):01865                  RTS
                      (    forth6809.asm):01866         
                      (    forth6809.asm):01867                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01868         ; ------------------------------------------------------------
                      (    forth6809.asm):01869         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01870         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01871         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01872         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01873         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):01874         INFILL:  LDA   INHEAD
                      (    forth6809.asm):01875                  SUBA  INTAIL
                      (    forth6809.asm):01876                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):01877                  RTS
                      (    forth6809.asm):01878         
                      (    forth6809.asm):01879         ; ------------------------------------------------------------
                      (    forth6809.asm):01880         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01881         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01882         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01883         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01884         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01885         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01886         ; flow control, not a chip feature.
                      (    forth6809.asm):01887         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):01888         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):01889                     CMPA #INHIWATER
                      (    forth6809.asm):01890                     BLO  RTSCHIDONE
                      (    forth6809.asm):01891                     TST  RTSSTATE
                      (    forth6809.asm):01892                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):01893                     LDA  #CR_RTSHI
                      (    forth6809.asm):01894                     STA  ACIACR
                      (    forth6809.asm):01895                     LDA  #1
                      (    forth6809.asm):01896                     STA  RTSSTATE
DEF5                  (    forth6809.asm):01897         RTSCHIDONE: RTS
                      (    forth6809.asm):01898         
                      (    forth6809.asm):01899         ; ------------------------------------------------------------
                      (    forth6809.asm):01900         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):01901         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):01902         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):01903         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):01904         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):01905         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):01906         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01907         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01908         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):01909         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):01910         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):01911                     CMPA #INLOWATER
                      (    forth6809.asm):01912                     BHI  RTSCLODONE
                      (    forth6809.asm):01913                     TST  RTSSTATE
                      (    forth6809.asm):01914                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):01915                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):01916                     CLR  RTSSTATE
                      (    forth6809.asm):01917                     LDB  OUTTAIL
                      (    forth6809.asm):01918                     CMPB OUTHEAD
                      (    forth6809.asm):01919                     BEQ  RTSCLONOTX
                      (    forth6809.asm):01920                     LDA  #CR_RXTX
                      (    forth6809.asm):01921                     STA  ACIACR
                      (    forth6809.asm):01922                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):01923         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):01924                     STA  ACIACR
DEF5                  (    forth6809.asm):01925         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):01926         RTSCLODONE: RTS
                      (    forth6809.asm):01927         
DEF5                  (    forth6809.asm):01928         IRQH:    LDA   ACIASR
                      (    forth6809.asm):01929                  BITA  #SR_IRQ
                      (    forth6809.asm):01930                  BEQ   IRQDONE
                      (    forth6809.asm):01931         
                      (    forth6809.asm):01932                  BITA  #SR_RDRF
                      (    forth6809.asm):01933                  BEQ   TXCHK
                      (    forth6809.asm):01934         
                      (    forth6809.asm):01935                  LDB   INHEAD
                      (    forth6809.asm):01936                  LDA   ACIADR
                      (    forth6809.asm):01937                  LDX   #INBUF
                      (    forth6809.asm):01938                  STA   B,X
                      (    forth6809.asm):01939                  INCB
                      (    forth6809.asm):01940                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):01941                  CMPB  INTAIL
                      (    forth6809.asm):01942                  BEQ   IRQDONE
                      (    forth6809.asm):01943                  STB   INHEAD
                      (    forth6809.asm):01944                  JSR   RTSCHECKHI
                      (    forth6809.asm):01945                  BRA   IRQDONE
                      (    forth6809.asm):01946         
DEF5                  (    forth6809.asm):01947         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):01948                  CMPB  OUTHEAD
                      (    forth6809.asm):01949                  BEQ   TXOFF
                      (    forth6809.asm):01950                  LDX   #OUTBUF
                      (    forth6809.asm):01951                  LDA   B,X
                      (    forth6809.asm):01952                  STA   ACIADR
                      (    forth6809.asm):01953                  INCB
                      (    forth6809.asm):01954                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01955                  STB   OUTTAIL
                      (    forth6809.asm):01956                  BRA   IRQDONE
                      (    forth6809.asm):01957         
DEF5                  (    forth6809.asm):01958         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):01959                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):01960                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):01961                  LDA   #CR_RXON
                      (    forth6809.asm):01962                  STA   ACIACR
                      (    forth6809.asm):01963         
DEF5                  (    forth6809.asm):01964         IRQDONE: RTI
                      (    forth6809.asm):01965         
                      (    forth6809.asm):01966                  ELSE  ; <<<<<>>>>>
DEF5 3B               (    forth6809.asm):01967         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):01968                                       ; interrupts are never enabled (see
                      (    forth6809.asm):01969                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):01970                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):01971                                       ; the other unused vectors below
                      (    forth6809.asm):01972                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01973         
DEF6 3B               (    forth6809.asm):01974         SWI3H:   RTI
DEF7 3B               (    forth6809.asm):01975         SWI2H:   RTI
DEF8 3B               (    forth6809.asm):01976         FIRQH:   RTI
DEF9 3B               (    forth6809.asm):01977         NMIH:    RTI                   ; unused now that NMI -> WARM
DEFA CCFF9D           (    forth6809.asm):01978         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DEFD 3606             (    forth6809.asm):01979                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DEFF 7EE6F9           (    forth6809.asm):01980                  JMP   THROW
                      (    forth6809.asm):01981         
                      (    forth6809.asm):01982         ; ============================================================
                      (    forth6809.asm):01983         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):01984         ; ============================================================
DF02 CC021B           (    forth6809.asm):01985         COLD:    LDD   #APPVARS
DF05 DD0A             (    forth6809.asm):01986                  STD   VARHERE
DF07 CC7000           (    forth6809.asm):01987                  LDD   #APPCODE
DF0A DD08             (    forth6809.asm):01988                  STD   CODEHERE
DF0C CC2000           (    forth6809.asm):01989                  LDD   #APPDICT
DF0F DD06             (    forth6809.asm):01990                  STD   DPHERE
DF11 CCDEE3           (    forth6809.asm):01991                  LDD   #BASELATEST
DF14 DD04             (    forth6809.asm):01992                  STD   LATEST
                      (    forth6809.asm):01993         
DF16 CC000A           (    forth6809.asm):01994                  LDD   #10
DF19 DD02             (    forth6809.asm):01995                  STD   BASE
                      (    forth6809.asm):01996         
DF1B CC018A           (    forth6809.asm):01997                  LDD   #TIBBUF
DF1E DDDB             (    forth6809.asm):01998                  STD   SRCADDR
DF20 CC0000           (    forth6809.asm):01999                  LDD   #0
DF23 DDDD             (    forth6809.asm):02000                  STD   SRCLEN
DF25 DDDF             (    forth6809.asm):02001                  STD   SRCID
                      (    forth6809.asm):02002         
DF27 8EDFAA           (    forth6809.asm):02003                  LDX   #SIGNON
DF2A 3610             (    forth6809.asm):02004                  PSHU  X
DF2C CC000F           (    forth6809.asm):02005                  LDD   #SIGNONL
DF2F 3606             (    forth6809.asm):02006                  PSHU  D
DF31 BDF60B           (    forth6809.asm):02007                  JSR   TYPE
DF34 BDFC2B           (    forth6809.asm):02008                  JSR   CRW
                      (    forth6809.asm):02009                  ; falls through into ABORT
                      (    forth6809.asm):02010         
DF37 CEBD00           (    forth6809.asm):02011         ABORT:   LDU   #SP0
                      (    forth6809.asm):02012                  ; falls through into QUIT
                      (    forth6809.asm):02013         
DF3A 10CEC000         (    forth6809.asm):02014         QUIT:    LDS   #RP0
DF3E CC0000           (    forth6809.asm):02015                  LDD   #0        ; BUG FIX: this reset used to live at QLOOP
DF41 DD00             (    forth6809.asm):02016                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02017                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02018                                   ; that spans more than one line of input.
                      (    forth6809.asm):02019                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02020                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02021                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02022                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02023                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02024                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02025                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02026                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02027                                   ; been reached. A colon definition split
                      (    forth6809.asm):02028                                   ; across multiple lines would have every
                      (    forth6809.asm):02029                                   ; word on every line after the first
                      (    forth6809.asm):02030                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02031                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02032                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02033                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02034                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02035                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02036                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02037                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02038                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):02039                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):02040                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):02041                                   ; so this still correctly forces interpret
                      (    forth6809.asm):02042                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):02043                                   ; semantics call for it - just not on every
                      (    forth6809.asm):02044                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):02045                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):02046         
DF43 BDE6B6           (    forth6809.asm):02047         QLOOP:   JSR   QUERY
                      (    forth6809.asm):02048         
DF46 DC06             (    forth6809.asm):02049                  LDD   DPHERE

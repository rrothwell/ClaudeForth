                      (    forth6809.asm):06435         
                      (    forth6809.asm):06436         ; ------------------------------------------------------------
                      (    forth6809.asm):06437         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06438         ; and skip over it.
                      (    forth6809.asm):06439         ; DOTSTR
                      (    forth6809.asm):06440         ;    Inputs:
                      (    forth6809.asm):06441         ;        return address on S points at the count byte
                      (    forth6809.asm):06442         ;    Outputs:

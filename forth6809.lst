F87B 2715             (    forth6809.asm):09762                    BEQ  UEDONE
F87D A680             (    forth6809.asm):09763                    LDA  ,X+
F87F 8125             (    forth6809.asm):09764                    CMPA #'%'
F881 2604             (    forth6809.asm):09765                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):09766                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):09767                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):09768                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):09769                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):09770                                   ; the same string correctly, since this runs
                      (    forth6809.asm):09771                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):09772         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):09773                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):09774                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):09775                    SUBD #1
F88E DDA9             (    forth6809.asm):09776                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):09777                    BRA  UELOOP
F892 1F20             (    forth6809.asm):09778         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):09779                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):09780                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):09781                                   ; required return values, and separately,
                      (    forth6809.asm):09782                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):09783                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):09784                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):09785                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):09786                                   ; characters. Now computed directly as the
                      (    forth6809.asm):09787                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):09788                                   ; original destination address (UEDST) -
                      (    forth6809.asm):09789                                   ; correct regardless of how many characters
                      (    forth6809.asm):09790                                   ; were doubled, since it's derived from
                      (    forth6809.asm):09791                                   ; where writing actually stopped rather than
                      (    forth6809.asm):09792                                   ; incremented alongside it.

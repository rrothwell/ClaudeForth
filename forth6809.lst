                      (    forth6809.asm):03123         ; Convert digits at NADDR into UDHI:UDLO, in BASE, until NCNT
                      (    forth6809.asm):03124         ; characters are used or a non-digit is reached.
                      (    forth6809.asm):03125         ; NUMLOOP
                      (    forth6809.asm):03126         ;    Inputs:
                      (    forth6809.asm):03127         ;        NADDR = address of the first character
                      (    forth6809.asm):03128         ;        NCNT = number of characters
                      (    forth6809.asm):03129         ;        UDHI:UDLO = initial value
                      (    forth6809.asm):03130         ;    Outputs:
                      (    forth6809.asm):03131         ;        UDHI:UDLO = accumulated value
                      (    forth6809.asm):03132         ;        NADDR, NCNT = first unconverted character and the count
                      (    forth6809.asm):03133         ;        remaining
                      (    forth6809.asm):03134         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03135         ; ------------------------------------------------------------

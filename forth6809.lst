E5FA DC76             (    forth6809.asm):06979                   LDD   UDLO
E5FC 3606             (    forth6809.asm):06980                   PSHU  D
E5FE CCFFFF           (    forth6809.asm):06981                   LDD   #-1
E601 3606             (    forth6809.asm):06982                   PSHU  D
E603 39               (    forth6809.asm):06983                   RTS
                      (    forth6809.asm):06984         

                      (    forth6809.asm):10280                       LDA  #'O'
                      (    forth6809.asm):10281                       STA  TSTNAMEB+2
                      (    forth6809.asm):10282         
                      (    forth6809.asm):10283                       LDD  #TSTCBUF
                      (    forth6809.asm):10284                       STD  CODEHERE
                      (    forth6809.asm):10285                       LDD  #TSTFHDR
                      (    forth6809.asm):10286                       STD  LATEST
                      (    forth6809.asm):10287                       LDD  #TSTNAMEB
                      (    forth6809.asm):10288                       STD  SRCADDR
                      (    forth6809.asm):10289                       LDD  #3
                      (    forth6809.asm):10290                       STD  SRCLEN
                      (    forth6809.asm):10291                       LDD  #0
                      (    forth6809.asm):10292                       STD  TOIN
                      (    forth6809.asm):10293                       LDD  #-1
                      (    forth6809.asm):10294                       STD  STATE

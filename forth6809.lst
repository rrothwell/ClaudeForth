                      (    forth6809.asm):03598         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03599         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03600         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03601         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03602         ; ------------------------------------------------------------
E4AB 3706             (    forth6809.asm):03603         ACCEPTW:    PULU  D                 ; +n1
E4AD DD35             (    forth6809.asm):03604                     STD   AMAX

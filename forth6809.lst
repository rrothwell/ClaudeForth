E4B9 DC4E             (    forth6809.asm):03204                     LDD   UDHI
E4BB 3606             (    forth6809.asm):03205                     PSHU  D                 ; ud2 high
E4BD 9E20             (    forth6809.asm):03206                     LDX   NADDR
E4BF 3610             (    forth6809.asm):03207                     PSHU  X                 ; c-addr2
E4C1 DC22             (    forth6809.asm):03208                     LDD   NCNT
E4C3 3606             (    forth6809.asm):03209                     PSHU  D                 ; u2
E4C5 39               (    forth6809.asm):03210                     RTS

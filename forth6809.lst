                      (    forth6809.asm):01598         ; ============================================================
                      (    forth6809.asm):01599         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01600         ; ============================================================
                      (    forth6809.asm):01601                     ORG   BASECODE          ; See bugfix: BASECODE.1
                      (    forth6809.asm):01602         
                      (    forth6809.asm):01603         ; ------------------------------------------------------------
                      (    forth6809.asm):01604         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01605         ; receiver-error counters to zero.
                      (    forth6809.asm):01606         ; SERBUFCLR
                      (    forth6809.asm):01607         ;    Inputs:
                      (    forth6809.asm):01608         ;        none
                      (    forth6809.asm):01609         ;    Outputs:
                      (    forth6809.asm):01610         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01611         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01612         ;    Registers: only CC changed.
                      (    forth6809.asm):01613         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01614         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01615         ; ------------------------------------------------------------
                      (    forth6809.asm):01616         
DCC4 7F0176           (    forth6809.asm):01617         SERBUFCLR:  CLR   INHEAD
DCC7 7F0177           (    forth6809.asm):01618                     CLR   INTAIL
DCCA 7F0178           (    forth6809.asm):01619                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
DCCD 7F0179           (    forth6809.asm):01620                     CLR   OUTHEAD
DCD0 7F017A           (    forth6809.asm):01621                     CLR   OUTTAIL
DCD3 7F017B           (    forth6809.asm):01622                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01623         
                      (    forth6809.asm):01624         
DCD6 7F017C           (    forth6809.asm):01625                     CLR   FECOUNT
DCD9 7F017D           (    forth6809.asm):01626                     CLR   OVRNCOUNT
DCDC 7F017E           (    forth6809.asm):01627                     CLR   PECOUNT
DCDF 7F017F           (    forth6809.asm):01628                     CLR   POLLREADYCNT
DCE2 39               (    forth6809.asm):01629                     RTS
                      (    forth6809.asm):01630         
                      (    forth6809.asm):01631         ; ------------------------------------------------------------
                      (    forth6809.asm):01632         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01633         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01634         ; INITSERIAL
                      (    forth6809.asm):01635         ;    Inputs:
                      (    forth6809.asm):01636         ;        none
                      (    forth6809.asm):01637         ;    Outputs:
                      (    forth6809.asm):01638         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01639         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01640         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01641         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01642         ; ------------------------------------------------------------
DCE3 BDDCC4           (    forth6809.asm):01643         INITSERIAL: JSR   SERBUFCLR
DCE6 9603             (    forth6809.asm):01644                     LDA   CR_RESET          ; Master Software Reset command to 6850
DCE8 B7C008           (    forth6809.asm):01645                     STA   ACIACR
DCEB 12               (    forth6809.asm):01646                     NOP                     ; Settling Delay
DCEC 12               (    forth6809.asm):01647                     NOP
                      (    forth6809.asm):01648         
                      (    forth6809.asm):01649                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01650                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01651                     ELSE                    ; <<<<<>>>>>
DCED 8615             (    forth6809.asm):01652                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01653                     ENDC                    ; <<<<<<<<<<
DCEF B7C008           (    forth6809.asm):01654                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DCF2 39               (    forth6809.asm):01655                     RTS
                      (    forth6809.asm):01656         
                      (    forth6809.asm):01657                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01658         ; ------------------------------------------------------------
                      (    forth6809.asm):01659         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01660         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01661         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01662         ; INFILL
                      (    forth6809.asm):01663         ;    Inputs:
                      (    forth6809.asm):01664         ;        none
                      (    forth6809.asm):01665         ;    Outputs:
                      (    forth6809.asm):01666         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01667         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01668         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01669         INFILL:     LDA   INHEAD
                      (    forth6809.asm):01670                     SUBA  INTAIL
                      (    forth6809.asm):01671                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):01672                     RTS
                      (    forth6809.asm):01673         ; ------------------------------------------------------------
                      (    forth6809.asm):01674         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01675         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01676         ; receive path with interrupts already masked.
                      (    forth6809.asm):01677         ; RTSCHECKHI
                      (    forth6809.asm):01678         ;    Inputs:
                      (    forth6809.asm):01679         ;        none
                      (    forth6809.asm):01680         ;    Outputs:
                      (    forth6809.asm):01681         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01682         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01683         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01684         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):01685                     CMPA  #INHIWATER
                      (    forth6809.asm):01686                     BLO   RTSCHIDONE
                      (    forth6809.asm):01687                     TST   RTSSTATE
                      (    forth6809.asm):01688                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):01689                     LDA   #CR_RTSHI
                      (    forth6809.asm):01690                     STA   ACIACR
                      (    forth6809.asm):01691                     LDA   #1
                      (    forth6809.asm):01692                     STA   RTSSTATE
DCF3                  (    forth6809.asm):01693         RTSCHIDONE: RTS
                      (    forth6809.asm):01694         ; ------------------------------------------------------------
                      (    forth6809.asm):01695         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01696         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01697         ; enables it only while output is pending.
                      (    forth6809.asm):01698         ; UPDATE_RTS
                      (    forth6809.asm):01699         ;    Inputs:
                      (    forth6809.asm):01700         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01701         ;    Outputs:
                      (    forth6809.asm):01702         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01703         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01704         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01705         UPDATE_RTS:
                      (    forth6809.asm):01706                     TST   RTSSTATE
                      (    forth6809.asm):01707                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01708         
                      (    forth6809.asm):01709                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):01710                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01711         
                      (    forth6809.asm):01712                                             ; $B5/%1011_0101
                      (    forth6809.asm):01713                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):01714                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01715         
DCF3                  (    forth6809.asm):01716         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):01717                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):01718                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01719         
DCF3                  (    forth6809.asm):01720         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):01721                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):01722                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DCF3                  (    forth6809.asm):01723         WRITE_CR:
                      (    forth6809.asm):01724                     STA   ACIACR
                      (    forth6809.asm):01725                     RTS
                      (    forth6809.asm):01726         ; ------------------------------------------------------------
                      (    forth6809.asm):01727         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01728         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01729         ; Called after a character is added to the ring.
                      (    forth6809.asm):01730         ; CHKHI
                      (    forth6809.asm):01731         ;    Inputs:
                      (    forth6809.asm):01732         ;        RegB = input ring fill level
                      (    forth6809.asm):01733         ;    Outputs:
                      (    forth6809.asm):01734         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01735         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01736         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01737         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01738         CHKHI:
                      (    forth6809.asm):01739                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):01740                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):01741                     TST   RTSSTATE
                      (    forth6809.asm):01742                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):01743                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):01744                     STA   RTSSTATE
                      (    forth6809.asm):01745                     JSR   UPDATE_RTS
DCF3                  (    forth6809.asm):01746         CHKHIDONE:  RTS
                      (    forth6809.asm):01747         
                      (    forth6809.asm):01748         ; ------------------------------------------------------------
                      (    forth6809.asm):01749         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01750         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01751         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01752         ; CHKLO
                      (    forth6809.asm):01753         ;    Inputs:
                      (    forth6809.asm):01754         ;        RegB = input ring fill level
                      (    forth6809.asm):01755         ;    Outputs:
                      (    forth6809.asm):01756         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01757         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01758         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01759         CHKLO:
                      (    forth6809.asm):01760                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):01761                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):01762                     TST   RTSSTATE
                      (    forth6809.asm):01763                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):01764                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):01765                     STA   RTSSTATE
                      (    forth6809.asm):01766                     JSR   UPDATE_RTS
DCF3                  (    forth6809.asm):01767         CHKLODONE:  RTS
                      (    forth6809.asm):01768         ; ------------------------------------------------------------
                      (    forth6809.asm):01769         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01770         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01771         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01772         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01773         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01774         ;    Inputs:
                      (    forth6809.asm):01775         ;        none
                      (    forth6809.asm):01776         ;    Outputs:
                      (    forth6809.asm):01777         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01778         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01779         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01780         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01781         FLUSHOUTBUFFER:
                      (    forth6809.asm):01782                     LDB   OUTTAIL
                      (    forth6809.asm):01783                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):01784                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01785         
                      (    forth6809.asm):01786                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):01787                     BITA  #SR_CTS
                      (    forth6809.asm):01788                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01789         
                      (    forth6809.asm):01790                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):01791                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01792                                             ; than spin-wait here.
                      (    forth6809.asm):01793         
                      (    forth6809.asm):01794                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):01795                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):01796                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01797         
                      (    forth6809.asm):01798                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):01799                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01800                     STB   OUTTAIL
                      (    forth6809.asm):01801                                             ; One character sent - return rather than
                      (    forth6809.asm):01802                                             ; loop back for more (see header comment).
DCF3                  (    forth6809.asm):01803         FLUSHED:
                      (    forth6809.asm):01804                     RTS
                      (    forth6809.asm):01805         ; ------------------------------------------------------------
                      (    forth6809.asm):01806         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01807         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01808         ; PUTCHAR
                      (    forth6809.asm):01809         ;    Inputs:
                      (    forth6809.asm):01810         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01811         ;    Outputs:
                      (    forth6809.asm):01812         ;        none
                      (    forth6809.asm):01813         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01814         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01815         PUTCHAR:
                      (    forth6809.asm):01816                     PSHS  CC,X
                      (    forth6809.asm):01817                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01818         
                      (    forth6809.asm):01819                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):01820                     INCB
                      (    forth6809.asm):01821                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01822                     CMPB  OUTTAIL
                      (    forth6809.asm):01823                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01824         
                      (    forth6809.asm):01825                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):01826                     LDB   OUTHEAD
                      (    forth6809.asm):01827                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01828         
                      (    forth6809.asm):01829                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):01830                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01831                     STB   OUTHEAD
                      (    forth6809.asm):01832         
                      (    forth6809.asm):01833                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):01834                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):01835         
                      (    forth6809.asm):01836                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):01837                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):01838                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):01839                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):01840                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):01841                                             ; expects the critical section active
                      (    forth6809.asm):01842         
                      (    forth6809.asm):01843                     BRA   PUT_EXIT
                      (    forth6809.asm):01844         
                      (    forth6809.asm):01845         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):01846         ; priming the pump by transmitting a character.
DCF3                  (    forth6809.asm):01847         CHK_INT_PATH:
                      (    forth6809.asm):01848                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):01849                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):01850         
                      (    forth6809.asm):01851                                             ; No! Restart.
                      (    forth6809.asm):01852                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):01853                     LDB   OUTTAIL
                      (    forth6809.asm):01854                     LDA   B,X
                      (    forth6809.asm):01855                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):01856         
                      (    forth6809.asm):01857                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):01858                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):01859                     STB   OUTTAIL
                      (    forth6809.asm):01860         
                      (    forth6809.asm):01861                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):01862                     STA   OUTACTIVITY
                      (    forth6809.asm):01863                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):01864         
DCF3                  (    forth6809.asm):01865         PUT_EXIT:
                      (    forth6809.asm):01866                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):01867                                             ; by restoring the CC.
                      (    forth6809.asm):01868         ; ------------------------------------------------------------
                      (    forth6809.asm):01869         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):01870         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):01871         ; GETCHAR
                      (    forth6809.asm):01872         ;    Inputs:
                      (    forth6809.asm):01873         ;        none
                      (    forth6809.asm):01874         ;    Outputs:
                      (    forth6809.asm):01875         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):01876         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):01877         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01878         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01879         GETCHAR:
                      (    forth6809.asm):01880                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):01881                     CMPB  INHEAD
                      (    forth6809.asm):01882                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):01883         
                      (    forth6809.asm):01884                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):01885                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):01886         
                      (    forth6809.asm):01887                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):01888                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):01889                     STB   INTAIL
                      (    forth6809.asm):01890         
                      (    forth6809.asm):01891                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):01892                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):01893                     ORCC  #$10
                      (    forth6809.asm):01894                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):01895                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):01896                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):01897                                             ; there's no already-loaded value here
                      (    forth6809.asm):01898                                             ; worth reusing.
                      (    forth6809.asm):01899                     JSR   CHKLO
                      (    forth6809.asm):01900                     ANDCC #$EF
                      (    forth6809.asm):01901         
                      (    forth6809.asm):01902                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):01903                     RTS
                      (    forth6809.asm):01904         
DCF3                  (    forth6809.asm):01905         GET_NO_CHAR:
                      (    forth6809.asm):01906                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):01907                     RTS
                      (    forth6809.asm):01908         ; ------------------------------------------------------------
                      (    forth6809.asm):01909         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):01910         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):01911         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):01912         ; RTSCHECKLO
                      (    forth6809.asm):01913         ;    Inputs:
                      (    forth6809.asm):01914         ;        none
                      (    forth6809.asm):01915         ;    Outputs:
                      (    forth6809.asm):01916         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):01917         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):01918         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):01919         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01920         RTSCHECKLO:
                      (    forth6809.asm):01921                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):01922         
                      (    forth6809.asm):01923                     JSR   INFILL
                      (    forth6809.asm):01924                     CMPA  #INLOWATER
                      (    forth6809.asm):01925                     BHI   RTSCLODONE
                      (    forth6809.asm):01926                     TST   RTSSTATE
                      (    forth6809.asm):01927                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):01928         
                      (    forth6809.asm):01929         
                      (    forth6809.asm):01930                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):01931         
                      (    forth6809.asm):01932                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):01933                     CMPB  OUTHEAD
                      (    forth6809.asm):01934                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):01935         
                      (    forth6809.asm):01936                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):01937                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):01938                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):01939         
DCF3                  (    forth6809.asm):01940         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):01941                     STA   ACIACR
                      (    forth6809.asm):01942         
DCF3                  (    forth6809.asm):01943         RTSCLOUNMASK:
                      (    forth6809.asm):01944                     ANDCC #$EF
                      (    forth6809.asm):01945         
DCF3                  (    forth6809.asm):01946         RTSCLODONE: RTS
                      (    forth6809.asm):01947         
                      (    forth6809.asm):01948         ; ------------------------------------------------------------
                      (    forth6809.asm):01949         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):01950         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):01951         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):01952         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):01953         ; IRQH
                      (    forth6809.asm):01954         ;    Inputs:
                      (    forth6809.asm):01955         ;        none (hardware interrupt entry)
                      (    forth6809.asm):01956         ;    Outputs:
                      (    forth6809.asm):01957         ;        none (returns with RTI)
                      (    forth6809.asm):01958         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):01959         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):01960         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01961         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):01962         
                      (    forth6809.asm):01963                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):01964                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):01965                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):01966                     BNE   INCHAR
                      (    forth6809.asm):01967                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):01968                     BNE   OUTCHAR
                      (    forth6809.asm):01969                                             ; Ignore all other interrupts such as DCD change.
DCF3                  (    forth6809.asm):01970         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):01971                                             ; & restores state.
                      (    forth6809.asm):01972         
DCF3                  (    forth6809.asm):01973         INCHAR:
                      (    forth6809.asm):01974                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):01975                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):01976                                             ; Any receiver error flagged?
                      (    forth6809.asm):01977                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):01978         
                      (    forth6809.asm):01979                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):01980                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):01981                     INC   FECOUNT           ; more than one bit can be set at once.
DCF3                  (    forth6809.asm):01982         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):01983                     BEQ   INXOVRN
                      (    forth6809.asm):01984                     INC   OVRNCOUNT
DCF3                  (    forth6809.asm):01985         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):01986                     BEQ   INXPE
                      (    forth6809.asm):01987                     INC   PECOUNT
DCF3                  (    forth6809.asm):01988         INXPE:      RTI
                      (    forth6809.asm):01989         
DCF3                  (    forth6809.asm):01990         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):01991                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):01992                     LDB   INHEAD
                      (    forth6809.asm):01993                     STA   B,X
                      (    forth6809.asm):01994                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):01995                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):01996                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):01997                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):01998                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):01999                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02000                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02001                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02002                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02003                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02004                     JSR   CHKHI             ; Protect the in buffer from overflow.
DCF3                  (    forth6809.asm):02005         IRQDONE1:   RTI
                      (    forth6809.asm):02006         
                      (    forth6809.asm):02007                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02008         
DCF3                  (    forth6809.asm):02009         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02010                     CMPB  OUTHEAD
                      (    forth6809.asm):02011                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02012         
                      (    forth6809.asm):02013                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02014                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02015                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02016         
                      (    forth6809.asm):02017                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02018                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02019                     STB   OUTTAIL
DCF3                  (    forth6809.asm):02020         IRQDONE2    RTI
                      (    forth6809.asm):02021         
DCF3                  (    forth6809.asm):02022         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02023                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02024                     CLR   OUTACTIVITY
                      (    forth6809.asm):02025                     JSR   UPDATE_RTS
DCF3                  (    forth6809.asm):02026         IRQDONE3    RTI
                      (    forth6809.asm):02027         
                      (    forth6809.asm):02028                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02029         
DCF3 3B               (    forth6809.asm):02030         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02031                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02032                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02033                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02034                                             ; the other unused vectors below
                      (    forth6809.asm):02035                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02036         
                      (    forth6809.asm):02037         ; ------------------------------------------------------------
                      (    forth6809.asm):02038         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02039         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02040         ; ------------------------------------------------------------
DCF4 3B               (    forth6809.asm):02041         SWI3H:      RTI
DCF5 3B               (    forth6809.asm):02042         SWI2H:      RTI
DCF6 3B               (    forth6809.asm):02043         FIRQH:      RTI
DCF7 3B               (    forth6809.asm):02044         NMIH:       RTI                     ; unused now that NMI -> WARM
DCF8 CCFF9D           (    forth6809.asm):02045         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DCFB 3606             (    forth6809.asm):02046                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DCFD 7EE57A           (    forth6809.asm):02047                     JMP   THROW

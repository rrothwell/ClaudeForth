                      (    forth6809.asm):07869         ; ============================================================
                      (    forth6809.asm):07870         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07871         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07872         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07873         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07874         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07875         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07876         ; ============================================================
                      (    forth6809.asm):07877         ; ------------------------------------------------------------
                      (    forth6809.asm):07878         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07879         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07880         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07881         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07882         ; - no indirection, no value cell.
                      (    forth6809.asm):07883         ;
                      (    forth6809.asm):07884         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07885         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07886         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07887         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07888         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07889         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07890         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07891         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07892         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07893         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07894         ; ------------------------------------------------------------
FE57 CCFFFF           (    forth6809.asm):07895         TRUEBODY:  LDD   #$FFFF
FE5A 3606             (    forth6809.asm):07896                    PSHU  D
FE5C 39               (    forth6809.asm):07897                    RTS
                      (    forth6809.asm):07898         
FE5D CC0000           (    forth6809.asm):07899         FALSEBODY: LDD   #$0000
FE60 3606             (    forth6809.asm):07900                    PSHU  D
FE62 39               (    forth6809.asm):07901                    RTS
                      (    forth6809.asm):07902         
                      (    forth6809.asm):07903         ; ------------------------------------------------------------
                      (    forth6809.asm):07904         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07905         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07906         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07907         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07908         ; ------------------------------------------------------------
FE63 CC0001           (    forth6809.asm):07909         ONEBODY:   LDD   #1
FE66 3606             (    forth6809.asm):07910                    PSHU  D
FE68 39               (    forth6809.asm):07911                    RTS
                      (    forth6809.asm):07912         
FE69 CCFFFF           (    forth6809.asm):07913         MONEBODY:  LDD   #-1
FE6C 3606             (    forth6809.asm):07914                    PSHU  D
FE6E 39               (    forth6809.asm):07915                    RTS
                      (    forth6809.asm):07916         
FE6F CC0002           (    forth6809.asm):07917         TWOBODY:   LDD   #2
FE72 3606             (    forth6809.asm):07918                    PSHU  D
FE74 39               (    forth6809.asm):07919                    RTS
                      (    forth6809.asm):07920         

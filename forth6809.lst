                      (    forth6809.asm):07881                  LDD   SRCADDR
                      (    forth6809.asm):07882                  STD   TSTSASAV
                      (    forth6809.asm):07883                  LDD   SRCLEN
                      (    forth6809.asm):07884                  STD   TSTSLSAV
                      (    forth6809.asm):07885                  LDD   TOIN
                      (    forth6809.asm):07886                  STD   TSTTISAV

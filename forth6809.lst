                      (    forth6809.asm):07462         
                      (    forth6809.asm):07463         ; ------------------------------------------------------------
                      (    forth6809.asm):07464         ; HOLDS  ( c-addr u -- )
                      (    forth6809.asm):07465         ; Add the string c-addr u to the front of the pictured numeric output
                      (    forth6809.asm):07466         ; string.
                      (    forth6809.asm):07467         ; ------------------------------------------------------------
FA1C ECC4             (    forth6809.asm):07468         HOLDSW:     LDD   ,U                ; u at 0, c-addr at 2
FA1E 2713             (    forth6809.asm):07469                     BEQ   HSDONE
FA20 830001           (    forth6809.asm):07470                     SUBD  #1
FA23 EDC4             (    forth6809.asm):07471                     STD   ,U                ; remaining count
FA25 AE42             (    forth6809.asm):07472                     LDX   2,U
FA27 A68B             (    forth6809.asm):07473                     LDA   D,X               ; the last remaining character
FA29 1F89             (    forth6809.asm):07474                     TFR   A,B
FA2B 4F               (    forth6809.asm):07475                     CLRA
FA2C 3606             (    forth6809.asm):07476                     PSHU  D

                      (    forth6809.asm):14994         ; Base/Radix Control test harness (glossary section 3.14). All
                      (    forth6809.asm):14995         ; four words are pure state-setting/reading with no I/O
                      (    forth6809.asm):14996         ; involved, so none of this section's tests need the
                      (    forth6809.asm):14997         ; SERIALPOLL-conditional complexity used throughout the printing
                      (    forth6809.asm):14998         ; sections. Combined into one test, given each word's own
                      (    forth6809.asm):14999         ; effect is trivially verified by reading BASE directly - four
                      (    forth6809.asm):15000         ; separate tests would just repeat the same save/set/verify/
                      (    forth6809.asm):15001         ; restore shape four times over. TSTBASAV (added in section
                      (    forth6809.asm):15002         ; 3.13, when the real, pre-COLD BASE=0 bug was found and fixed)
                      (    forth6809.asm):15003         ; is reused here to save/restore the real BASE across this test
                      (    forth6809.asm):15004         ; too, per the same established reasoning.
                      (    forth6809.asm):15005         ; ------------------------------------------------------------
                      (    forth6809.asm):15006         
                      (    forth6809.asm):15007         ; ------------------------------------------------------------
                      (    forth6809.asm):15008         ; TSTBASE - combined unit test for BASE, DECIMAL, HEX, and
                      (    forth6809.asm):15009         ; BINARY. Sets BASE via each of HEX/BINARY/DECIMAL in turn,
                      (    forth6809.asm):15010         ; verifying the correct value lands each time, then calls BASE
                      (    forth6809.asm):15011         ; itself and verifies both that it returns the variable's own
                      (    forth6809.asm):15012         ; address (not its value, per "( -- addr )") and that reading
                      (    forth6809.asm):15013         ; through that address reflects DECIMAL's own, most recent
                      (    forth6809.asm):15014         ; setting (10).
                      (    forth6809.asm):15015         ; ------------------------------------------------------------
C2EE                  (    forth6809.asm):15016         TSTBASE: LDD  BASE
                      (    forth6809.asm):15017                  STD  TSTBASAV

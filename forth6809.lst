                      (    forth6809.asm):02332                                 LDA   B,X 
                      (    forth6809.asm):02333         
                      (    forth6809.asm):02334                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02335                     ANDB  #INBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02336                     STB   INTAIL
                      (    forth6809.asm):02337         
                      (    forth6809.asm):02338                     ; BUG FIX: CHKLO reads-then-writes RTSSTATE/OUTACTIVITY and

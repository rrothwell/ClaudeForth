                      (    forth6809.asm):03333         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03334         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03335         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03336         ;    Inputs:
                      (    forth6809.asm):03337         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03338         ;    Outputs:
                      (    forth6809.asm):03339         ;        single number: n and -1
                      (    forth6809.asm):03340         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03341         ;        not a number: c-addr and 0
                      (    forth6809.asm):03342         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03343         ; ------------------------------------------------------------
E3B4 3710             (    forth6809.asm):03344         NUMBERQ:    PULU  X                 ; c-addr
E3B6 9F1F             (    forth6809.asm):03345                     STX   CADDR
E3B8 A684             (    forth6809.asm):03346                     LDA   ,X
E3BA 2777             (    forth6809.asm):03347                     BEQ   NQBAD
E3BC 9721             (    forth6809.asm):03348                     STA   CNTREM
E3BE 3001             (    forth6809.asm):03349                     LEAX  1,X
                      (    forth6809.asm):03350         
                      (    forth6809.asm):03351                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03352                     ; digit count. See shadow: NUMBERQ.1
E3C0 D621             (    forth6809.asm):03353                     LDB   CNTREM
E3C2 5A               (    forth6809.asm):03354                     DECB
E3C3 A685             (    forth6809.asm):03355                     LDA   B,X

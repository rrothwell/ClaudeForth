                      (    forth6809.asm):09780                   STD  TOIN
                      (    forth6809.asm):09781         
                      (    forth6809.asm):09782                   STU  TSTU0
                      (    forth6809.asm):09783         
                      (    forth6809.asm):09784                   LDD  #TSTGUARD
                      (    forth6809.asm):09785                   PSHU D
                      (    forth6809.asm):09786                   STU  TSTUB4
                      (    forth6809.asm):09787         
                      (    forth6809.asm):09788                   JSR  TICK
                      (    forth6809.asm):09789         
                      (    forth6809.asm):09790                   STU  TSTUAF
                      (    forth6809.asm):09791         

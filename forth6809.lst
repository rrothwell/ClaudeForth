                      (    forth6809.asm):14379                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):14380                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):14381                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):14382                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):14383                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):14384                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):14385                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):14386                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):14387                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):14388                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):14389                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):14390                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):14391                  ; for it.
E591 D621             (    forth6809.asm):14392                  LDB   CNTREM
E593 5A               (    forth6809.asm):14393                  DECB
E594 A685             (    forth6809.asm):14394                  LDA   B,X
E596 812E             (    forth6809.asm):14395                  CMPA  #'.'

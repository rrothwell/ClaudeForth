                      (    forth6809.asm):04478         ; TSTCOMPARE - comparison tests (glossary section 3.7). Covers
                      (    forth6809.asm):04479         ; every word in that section. Like several words in the previous
                      (    forth6809.asm):04480         ; group, most of these modify the top of stack in place rather
                      (    forth6809.asm):04481         ; than PULU/PSHU - the tests verify what's observable via the
                      (    forth6809.asm):04482         ; stack either way. Signed vs unsigned comparisons (</U<, >/U>)
                      (    forth6809.asm):04483         ; each tested with a case that would give the opposite answer
                      (    forth6809.asm):04484         ; under the other convention, confirming genuine sign-awareness
                      (    forth6809.asm):04485         ; rather than an accidentally-shared implementation. WITHIN
                      (    forth6809.asm):04486         ; tested against a wraparound range specifically (n2 near $FFFF,
                      (    forth6809.asm):04487         ; n3 wrapped past $0000), both inside and outside cases - the
                      (    forth6809.asm):04488         ; documented special case its own unsigned-offset implementation
                      (    forth6809.asm):04489         ; exists to handle, not just an ordinary non-wrapping range. D</
                      (    forth6809.asm):04490         ; DU< both tested with equal high cells and different low cells -
                      (    forth6809.asm):04491         ; the documented tie-break case a naive high-cell-only comparison
                      (    forth6809.asm):04492         ; would get wrong.
                      (    forth6809.asm):04493         ; ------------------------------------------------------------
C1B5 BDFC2B           (    forth6809.asm):04494         TSTCOMPARE: JSR   CRW
C1B8 8EC1F6           (    forth6809.asm):04495                    LDX   #TSTCOMPMSG
C1BB 3610             (    forth6809.asm):04496                    PSHU  X
C1BD CC0007           (    forth6809.asm):04497                    LDD   #7
C1C0 3606             (    forth6809.asm):04498                    PSHU  D
C1C2 BDF60B           (    forth6809.asm):04499                    JSR   TYPE
C1C5 BDFC2B           (    forth6809.asm):04500                    JSR   CRW
                      (    forth6809.asm):04501         
                      (    forth6809.asm):04502                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):04503         
C1C8 BDC1FD           (    forth6809.asm):04504                    JSR   TSTEQ
C1CB BDC250           (    forth6809.asm):04505                    JSR   TSTLT

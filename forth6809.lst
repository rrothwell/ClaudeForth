                      (   unit_tests.asm):06702         ; TSTEXIT - unit test for EXIT. Compiles
                      (   unit_tests.asm):06703         ; "DO I DUP 3 LITERAL = IF EXIT THEN I + LOOP", limit=10,
                      (   unit_tests.asm):06704         ; start=0 - EXIT fires when I=3, discarding the one open DO
                      (   unit_tests.asm):06705         ; frame and returning immediately. Sets the real CSP to U's
                      (   unit_tests.asm):06706         ; value right before the first control-flow marker is pushed
                      (   unit_tests.asm):06707         ; (matching what ":" does at the start of a real definition),
                      (   unit_tests.asm):06708         ; since EXIT's own compile-time frame count depends on it -
                      (   unit_tests.asm):06709         ; confirmed by hand-trace: at the point EXIT is compiled, U
                      (   unit_tests.asm):06710         ; holds IF's own pending (addr,TAGFWD) on top of DO's
                      (   unit_tests.asm):06711         ; (addr,TAGDO), and EXIT's scan correctly counts exactly one
                      (   unit_tests.asm):06712         ; TAGDO between U and CSP. Unlike TSTLEAVE, EXIT fires
                      (   unit_tests.asm):06713         ; immediately when reached - the following + never runs for
                      (   unit_tests.asm):06714         ; I=3, so sum=0+1+2=3, not 6.
                      (   unit_tests.asm):06715         ; ------------------------------------------------------------

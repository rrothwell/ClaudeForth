                      (    forth6809.asm):04689         ; ============================================================
                      (    forth6809.asm):04690         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04691         ; ============================================================
                      (    forth6809.asm):04692         ; ------------------------------------------------------------
                      (    forth6809.asm):04693         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04694         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04695         ; one expected.
                      (    forth6809.asm):04696         ; CFERR
                      (    forth6809.asm):04697         ;    Inputs:
                      (    forth6809.asm):04698         ;        none
                      (    forth6809.asm):04699         ;    Outputs:
                      (    forth6809.asm):04700         ;        does not return (THROW -22)
                      (    forth6809.asm):04701         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04702         ; ------------------------------------------------------------
DA0F CCFFEA           (    forth6809.asm):04703         CFERR:      LDD   #-22
DA12 3606             (    forth6809.asm):04704                     PSHU  D                 ; -22
DA14 BDDA44           (    forth6809.asm):04705                     JSR   THROWW
DA17 39               (    forth6809.asm):04706                     RTS
                      (    forth6809.asm):04707         
                      (    forth6809.asm):04708         ; ------------------------------------------------------------
                      (    forth6809.asm):04709         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04710         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04711         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04712         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04713         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04714         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04715         ; ------------------------------------------------------------
DA18 3710             (    forth6809.asm):04716         CATCHW:     PULU  X                 ; xt
DA1A DC0C             (    forth6809.asm):04717                     LDD   HANDLER
DA1C 3406             (    forth6809.asm):04718                     PSHS  D
DA1E 3440             (    forth6809.asm):04719                     PSHS  U
                      (    forth6809.asm):04720                     ; Save the input source specification.
                      (    forth6809.asm):04721                     ; See bugfix: CATCHW.1
DA20 DC39             (    forth6809.asm):04722                     LDD   SRCADDR
DA22 3406             (    forth6809.asm):04723                     PSHS  D
DA24 DC3B             (    forth6809.asm):04724                     LDD   SRCLEN
DA26 3406             (    forth6809.asm):04725                     PSHS  D
DA28 DC3D             (    forth6809.asm):04726                     LDD   SRCID
DA2A 3406             (    forth6809.asm):04727                     PSHS  D
DA2C DC10             (    forth6809.asm):04728                     LDD   TOIN
DA2E 3406             (    forth6809.asm):04729                     PSHS  D
DA30 1F40             (    forth6809.asm):04730                     TFR   S,D
DA32 DD0C             (    forth6809.asm):04731                     STD   HANDLER
                      (    forth6809.asm):04732         
DA34 AD84             (    forth6809.asm):04733                     JSR   ,X
                      (    forth6809.asm):04734         
DA36 3268             (    forth6809.asm):04735                     LEAS  8,S               ; drop saved input source
DA38 3262             (    forth6809.asm):04736                     LEAS  2,S               ; saved U
DA3A 3506             (    forth6809.asm):04737                     PULS  D
DA3C DD0C             (    forth6809.asm):04738                     STD   HANDLER
DA3E CC0000           (    forth6809.asm):04739                     LDD   #0
DA41 3606             (    forth6809.asm):04740                     PSHU  D                 ; 0 = no exception
DA43 39               (    forth6809.asm):04741                     RTS
                      (    forth6809.asm):04742         
                      (    forth6809.asm):04743         ; ------------------------------------------------------------
                      (    forth6809.asm):04744         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04745         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04746         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04747         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04748         ; ------------------------------------------------------------
DA44 3706             (    forth6809.asm):04749         THROWW:     PULU  D                 ; n
DA46 10830000         (    forth6809.asm):04750                     CMPD  #0
DA4A 2725             (    forth6809.asm):04751                     BEQ   THDONE
                      (    forth6809.asm):04752         
DA4C DD0E             (    forth6809.asm):04753                     STD   THROWN
DA4E 9E0C             (    forth6809.asm):04754                     LDX   HANDLER
DA50 2720             (    forth6809.asm):04755                     BEQ   THUNCAU
                      (    forth6809.asm):04756         
DA52 1F14             (    forth6809.asm):04757                     TFR   X,S
DA54 3506             (    forth6809.asm):04758                     PULS  D                 ; restore input source saved by CATCH
DA56 DD10             (    forth6809.asm):04759                     STD   TOIN
DA58 3506             (    forth6809.asm):04760                     PULS  D
DA5A DD3D             (    forth6809.asm):04761                     STD   SRCID
DA5C 3506             (    forth6809.asm):04762                     PULS  D
DA5E DD3B             (    forth6809.asm):04763                     STD   SRCLEN
DA60 3506             (    forth6809.asm):04764                     PULS  D
DA62 DD39             (    forth6809.asm):04765                     STD   SRCADDR
DA64 3506             (    forth6809.asm):04766                     PULS  D
DA66 1F03             (    forth6809.asm):04767                     TFR   D,U
DA68 3506             (    forth6809.asm):04768                     PULS  D
DA6A DD0C             (    forth6809.asm):04769                     STD   HANDLER
                      (    forth6809.asm):04770         

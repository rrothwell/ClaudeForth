                      (    forth6809.asm):00553         ; ------------------------------------------------------------
                      (    forth6809.asm):00554         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00555         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00556         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00557         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00558         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00559         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00560         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00561         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00562         ;
                      (    forth6809.asm):00563         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00564         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00565         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00566         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00567         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00568         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00569         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00570         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00571         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00572         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00573         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00574         ; ------------------------------------------------------------
                      (    forth6809.asm):00575                  ORG   $0100
0100                  (    forth6809.asm):00576         MVCNT      RMB   2
0102                  (    forth6809.asm):00577         MVDST      RMB   2
0104                  (    forth6809.asm):00578         MVSRC      RMB   2
     0100             (    forth6809.asm):00579         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00580         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00581         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00582         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00583         
                      (    forth6809.asm):00584         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00585         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00586                  ORG USROMSTRT
                      (    forth6809.asm):00587         
                      (    forth6809.asm):00588         ; ============================================================
                      (    forth6809.asm):00589         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00590         ;
                      (    forth6809.asm):00591         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00592         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00593         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00594         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00595         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00596         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00597         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00598         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00599         ; this existed - UNITTESTS=1 removes it entirely and this block
                      (    forth6809.asm):00600         ; reverts to exactly that padding, computed automatically below
                      (    forth6809.asm):00601         ; via the ROM label rather than a fixed byte count, so it's
                      (    forth6809.asm):00602         ; correct either way without needing to be hand-adjusted.
                      (    forth6809.asm):00603         ;
                      (    forth6809.asm):00604         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00605         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00606         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00607         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00608         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00609         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00610         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00611         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00612         ;
                      (    forth6809.asm):00613         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00614         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00615         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00616         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00617         ; ============================================================
     0000             (    forth6809.asm):00618         UNITTESTS EQU 0   ; was 1 (excluded) - reactivated: confirmed working
                      (    forth6809.asm):00619                           ; on real MAME hardware (TSTDUP runs successfully
                      (    forth6809.asm):00620                           ; and reports the correct message to the terminal) -
                      (    forth6809.asm):00621                           ; whatever earlier concern prompted excluding it was
                      (    forth6809.asm):00622                           ; resolved by other, unrelated fixes since. 0 =
                      (    forth6809.asm):00623                           ; included (matches this file's established IFEQ
                      (    forth6809.asm):00624                           ; convention, e.g. SERIALPOLL); 1 = excluded
                      (    forth6809.asm):00625                           ; entirely, reverting to plain FILL padding.
                      (    forth6809.asm):00626         
     0002             (    forth6809.asm):00627         TSTSELECTOR EQU 2
                      (    forth6809.asm):00628         
                      (    forth6809.asm):00629                  IFEQ  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00630         
     021B             (    forth6809.asm):00631         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
     021D             (    forth6809.asm):00632         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
     021F             (    forth6809.asm):00633         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
     0221             (    forth6809.asm):00634         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00635         
     3C7A             (    forth6809.asm):00636         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00637                                       ; under test, to prove an operation
                      (    forth6809.asm):00638                                       ; doesn't disturb what's beneath it
     59E1             (    forth6809.asm):00639         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00640                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00641                                       ; that only appears to pass due to a
                      (    forth6809.asm):00642                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00643                                       ; caught rather than masked
     2468             (    forth6809.asm):00644         TSTVAL2  EQU   $2468         ; additional distinct, non-trivial
     7B3D             (    forth6809.asm):00645         TSTVAL3  EQU   $7B3D         ; values for multi-item tests (SWAP,
     4E2C             (    forth6809.asm):00646         TSTVAL4  EQU   $4E2C         ; OVER, ROT, 2DUP, 2ROT, etc) - none are
     19A7             (    forth6809.asm):00647         TSTVAL5  EQU   $19A7         ; 0, 1, -1, TSTGUARD, or any of each
     6D95             (    forth6809.asm):00648         TSTVAL6  EQU   $6D95         ; other
                      (    forth6809.asm):00649         
     0223             (    forth6809.asm):00650         TSTSCR   EQU   APPVARS+8     ; extra scratch cell - for tests (DEPTH)
                      (    forth6809.asm):00651                                       ; that need to compute an expected value
                      (    forth6809.asm):00652                                       ; independently before comparing
                      (    forth6809.asm):00653         
     CFC7             (    forth6809.asm):00654         TSTNEG1  EQU   $CFC7         ; -12345 - distinct, non-trivial negative
                      (    forth6809.asm):00655                                       ; test values, needed for arithmetic
                      (    forth6809.asm):00656                                       ; tests (ABS, NEGATE, MIN/MAX, signed
                      (    forth6809.asm):00657                                       ; division, 2/) whose logic genuinely
                      (    forth6809.asm):00658                                       ; branches on sign - TSTVAL1-6 above are
                      (    forth6809.asm):00659                                       ; all positive, which wouldn't exercise
                      (    forth6809.asm):00660                                       ; those branches
     FEBF             (    forth6809.asm):00661         TSTNEG2  EQU   $FEBF         ; -321
                      (    forth6809.asm):00662         
     0001             (    forth6809.asm):00663         TSTD1HI  EQU   $0001         ; TSTDBL1 = 70000 (positive, exceeds 16
     1170             (    forth6809.asm):00664         TSTD1LO  EQU   $1170         ; bits - exercises real double-cell width,
                      (    forth6809.asm):00665                                       ; not just a sign-extended single)
     FFFE             (    forth6809.asm):00666         TSTD2HI  EQU   $FFFE         ; TSTDBL2 = -70000
     EE90             (    forth6809.asm):00667         TSTD2LO  EQU   $EE90
     00BC             (    forth6809.asm):00668         TSTD3HI  EQU   $00BC         ; TSTDBL3 = 12345678
     614E             (    forth6809.asm):00669         TSTD3LO  EQU   $614E
     0000             (    forth6809.asm):00670         TSTDSHI  EQU   $0000         ; TSTDBLSMALL = 500 - small enough to fit
     01F4             (    forth6809.asm):00671         TSTDSLO  EQU   $01F4         ; in a single cell, for D>S
                      (    forth6809.asm):00672         
                      (    forth6809.asm):00673         ; ------------------------------------------------------------
                      (    forth6809.asm):00674         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00675         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00676         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00677         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00678         ; ------------------------------------------------------------
C100 3706             (    forth6809.asm):00679         TSTREPORT: PULU  D
C102 FD0221           (    forth6809.asm):00680                    STD   TSTFLAG
C105 BDF62F           (    forth6809.asm):00681                    JSR   COUNT
C108 BDF60B           (    forth6809.asm):00682                    JSR   TYPE
C10B FC0221           (    forth6809.asm):00683                    LDD   TSTFLAG
C10E 270C             (    forth6809.asm):00684                    BEQ   TSTFAILR
C110 CCC12D           (    forth6809.asm):00685                    LDD   #TSTOKMSG
C113 3606             (    forth6809.asm):00686                    PSHU  D
C115 CC0003           (    forth6809.asm):00687                    LDD   #TSTOKMSGL
C118 3606             (    forth6809.asm):00688                    PSHU  D
C11A 200A             (    forth6809.asm):00689                    BRA   TSTPRINT
C11C CCC130           (    forth6809.asm):00690         TSTFAILR:  LDD   #TSTFAILMSG
C11F 3606             (    forth6809.asm):00691                    PSHU  D
C121 CC0005           (    forth6809.asm):00692                    LDD   #TSTFAILMSGL
C124 3606             (    forth6809.asm):00693                    PSHU  D
C126 BDF60B           (    forth6809.asm):00694         TSTPRINT:  JSR   TYPE
C129 BDFC2B           (    forth6809.asm):00695                    JSR   CRW
C12C 39               (    forth6809.asm):00696                    RTS
                      (    forth6809.asm):00697         
C12D 204F4B           (    forth6809.asm):00698         TSTOKMSG:    FCC " OK"
     0003             (    forth6809.asm):00699         TSTOKMSGL    EQU  *-TSTOKMSG
C130 204641494C       (    forth6809.asm):00700         TSTFAILMSG:  FCC " FAIL"
     0005             (    forth6809.asm):00701         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00702         
                      (    forth6809.asm):00703         ; ------------------------------------------------------------
                      (    forth6809.asm):00704         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00705         ; here as they're written.
                      (    forth6809.asm):00706         ; ------------------------------------------------------------
C135 BDC13F           (    forth6809.asm):00707         TSTRUNNER: JSR   TSTSTACK
C138 BDC158           (    forth6809.asm):00708                    JSR   TSTSARITH
C13B BDC177           (    forth6809.asm):00709                    JSR   TSTDARITH
C13E 39               (    forth6809.asm):00710                    RTS
                      (    forth6809.asm):00711         
                      (    forth6809.asm):00712         ; ------------------------------------------------------------
                      (    forth6809.asm):00713         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):00714         ; they're written.
                      (    forth6809.asm):00715         ; ------------------------------------------------------------
C13F BDFC2B           (    forth6809.asm):00716         TSTSTACK:  JSR   CRW
C142 8EC153           (    forth6809.asm):00717                    LDX   #TSTSTACKMSG
C145 3610             (    forth6809.asm):00718                    PSHU  X
C147 CC0005           (    forth6809.asm):00719                    LDD   #5
C14A 3606             (    forth6809.asm):00720                    PSHU  D
C14C BDF60B           (    forth6809.asm):00721                    JSR   TYPE
C14F BDFC2B           (    forth6809.asm):00722                    JSR   CRW
                      (    forth6809.asm):00723         
                      (    forth6809.asm):00724                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00725         
                      (    forth6809.asm):00726                    JSR   TSTDUP
                      (    forth6809.asm):00727                    JSR   TSTDROP
                      (    forth6809.asm):00728                    JSR   TSTSWAP
                      (    forth6809.asm):00729                    JSR   TSTOVER
                      (    forth6809.asm):00730                    JSR   TSTROT
                      (    forth6809.asm):00731                    JSR   TSTQDUPNZ
                      (    forth6809.asm):00732                    JSR   TSTQDUPZ
                      (    forth6809.asm):00733                    JSR   TSTDEPTH
                      (    forth6809.asm):00734                    JSR   TSTDDUP
                      (    forth6809.asm):00735                    JSR   TSTDDROP
                      (    forth6809.asm):00736                    JSR   TSTDSWAP
                      (    forth6809.asm):00737                    JSR   TSTDOVER
                      (    forth6809.asm):00738                    JSR   TSTNIP
                      (    forth6809.asm):00739                    JSR   TSTTUCK
                      (    forth6809.asm):00740                    JSR   TSTPICK
                      (    forth6809.asm):00741                    JSR   TSTROLL
                      (    forth6809.asm):00742                    JSR   TSTDROT
                      (    forth6809.asm):00743         
                      (    forth6809.asm):00744                    ENDC ; <<<<
                      (    forth6809.asm):00745         

                      (    forth6809.asm):07981         
FFBD 1CAF             (    forth6809.asm):07982                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):07983         
                      (    forth6809.asm):07984                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):07985         
                      (    forth6809.asm):07986                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):07987                     JSR   TSTRUNNER

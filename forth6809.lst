                      (    forth6809.asm):02144         ; ============================================================
                      (    forth6809.asm):02145         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02146         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02147         ; ============================================================
                      (    forth6809.asm):02148         ; ------------------------------------------------------------
                      (    forth6809.asm):02149         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02150         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02151         ; LIT   ( -- x )
                      (    forth6809.asm):02152         ;    Inputs:
                      (    forth6809.asm):02153         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02154         ;    Outputs:
                      (    forth6809.asm):02155         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02156         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02157         ; ------------------------------------------------------------
DEE7 3510             (    forth6809.asm):02158         LIT:        PULS  X
DEE9 EC81             (    forth6809.asm):02159                     LDD   ,X++
DEEB 3606             (    forth6809.asm):02160                     PSHU  D                 ; x
DEED 3410             (    forth6809.asm):02161                     PSHS  X
DEEF 39               (    forth6809.asm):02162                     RTS
                      (    forth6809.asm):02163         
                      (    forth6809.asm):02164         ; ------------------------------------------------------------
                      (    forth6809.asm):02165         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02166         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02167         ; address.
                      (    forth6809.asm):02168         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02169         ;    Inputs:
                      (    forth6809.asm):02170         ;        flag on the data stack
                      (    forth6809.asm):02171         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02172         ;    Outputs:
                      (    forth6809.asm):02173         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02174         ;        the offset
                      (    forth6809.asm):02175         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02176         ; ------------------------------------------------------------
DEF0 3706             (    forth6809.asm):02177         ZBRANCH:    PULU  D                 ; flag
DEF2 3510             (    forth6809.asm):02178                     PULS  X
DEF4 10830000         (    forth6809.asm):02179                     CMPD  #0
DEF8 2607             (    forth6809.asm):02180                     BNE   ZSKIP
DEFA EC84             (    forth6809.asm):02181                     LDD   ,X
DEFC 308B             (    forth6809.asm):02182                     LEAX  D,X
DEFE 3410             (    forth6809.asm):02183                     PSHS  X
DF00 39               (    forth6809.asm):02184                     RTS
DF01 3002             (    forth6809.asm):02185         ZSKIP:      LEAX  2,X
DF03 3410             (    forth6809.asm):02186                     PSHS  X
DF05 39               (    forth6809.asm):02187                     RTS
                      (    forth6809.asm):02188         
                      (    forth6809.asm):02189         ; ------------------------------------------------------------
                      (    forth6809.asm):02190         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02191         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02192         ; BRANCH
                      (    forth6809.asm):02193         ;    Inputs:
                      (    forth6809.asm):02194         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02195         ;    Outputs:
                      (    forth6809.asm):02196         ;        return address set to the branch target
                      (    forth6809.asm):02197         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02198         ; ------------------------------------------------------------
DF06 3510             (    forth6809.asm):02199         BRANCH:     PULS  X
DF08 EC84             (    forth6809.asm):02200                     LDD   ,X
DF0A 308B             (    forth6809.asm):02201                     LEAX  D,X
DF0C 3410             (    forth6809.asm):02202                     PSHS  X
DF0E 39               (    forth6809.asm):02203                     RTS
                      (    forth6809.asm):02204         
                      (    forth6809.asm):02205         ; ------------------------------------------------------------
                      (    forth6809.asm):02206         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02207         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02208         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02209         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02212         ;        trampoline
                      (    forth6809.asm):02213         ;    Outputs:
                      (    forth6809.asm):02214         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02215         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02216         ; ------------------------------------------------------------
DF0F 3510             (    forth6809.asm):02217         DODOES:     PULS  X
DF11 10AE81           (    forth6809.asm):02218                     LDY   ,X++
DF14 EC84             (    forth6809.asm):02219                     LDD   ,X
DF16 3606             (    forth6809.asm):02220                     PSHU  D                 ; pfa
DF18 6EA4             (    forth6809.asm):02221                     JMP   ,Y
                      (    forth6809.asm):02222         
                      (    forth6809.asm):02223         ; ------------------------------------------------------------
                      (    forth6809.asm):02224         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02225         ; field address on the stack.
                      (    forth6809.asm):02226         ; DOESRT0
                      (    forth6809.asm):02227         ;    Inputs:
                      (    forth6809.asm):02228         ;        none
                      (    forth6809.asm):02229         ;    Outputs:
                      (    forth6809.asm):02230         ;        none
                      (    forth6809.asm):02231         ;    Registers: none.
                      (    forth6809.asm):02232         ; ------------------------------------------------------------
DF1A 39               (    forth6809.asm):02233         DOESRT0:    RTS
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235         ; ------------------------------------------------------------
                      (    forth6809.asm):02236         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02237         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02238         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02239         ; SETDOES
                      (    forth6809.asm):02240         ;    Inputs:
                      (    forth6809.asm):02241         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02242         ;        BEHAVIOR)
                      (    forth6809.asm):02243         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02244         ;        address
                      (    forth6809.asm):02245         ;    Outputs:
                      (    forth6809.asm):02246         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02247         ;        defining word's caller
                      (    forth6809.asm):02248         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02249         ; ------------------------------------------------------------
DF1B 3510             (    forth6809.asm):02250         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF1D 1F12             (    forth6809.asm):02251                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02252         
DF1F 9E04             (    forth6809.asm):02253                     LDX   LATEST
DF21 E684             (    forth6809.asm):02254                     LDB   ,X
DF23 C41F             (    forth6809.asm):02255                     ANDB  #$1F
DF25 4F               (    forth6809.asm):02256                     CLRA
DF26 308B             (    forth6809.asm):02257                     LEAX  D,X               ; header + name length
DF28 EC03             (    forth6809.asm):02258                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DF2A C30003           (    forth6809.asm):02259                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DF2D 1F01             (    forth6809.asm):02260                     TFR   D,X
                      (    forth6809.asm):02261         
DF2F 10AF84           (    forth6809.asm):02262                     STY   ,X                ; patch it
                      (    forth6809.asm):02263         
DF32 3510             (    forth6809.asm):02264                     PULS  X                 ; X = the OUTER defining word's own return addr
DF34 6E84             (    forth6809.asm):02265                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02266         
                      (    forth6809.asm):02267         ; ------------------------------------------------------------
                      (    forth6809.asm):02268         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02269         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02270         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02271         ;    Inputs:
                      (    forth6809.asm):02272         ;        pfa on the data stack
                      (    forth6809.asm):02273         ;    Outputs:
                      (    forth6809.asm):02274         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02275         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02276         ; ------------------------------------------------------------
DF36 3710             (    forth6809.asm):02277         DODEFER:    PULU  X                 ; pfa
DF38 EC84             (    forth6809.asm):02278                     LDD   ,X
DF3A 1F01             (    forth6809.asm):02279                     TFR   D,X
DF3C 6E84             (    forth6809.asm):02280                     JMP   ,X
                      (    forth6809.asm):02281         
                      (    forth6809.asm):02282         ; ------------------------------------------------------------
                      (    forth6809.asm):02283         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02284         ; DOABORTUNDEF
                      (    forth6809.asm):02285         ;    Inputs:
                      (    forth6809.asm):02286         ;        none
                      (    forth6809.asm):02287         ;    Outputs:
                      (    forth6809.asm):02288         ;        none (does not return)
                      (    forth6809.asm):02289         ;    Registers: RegD changed.
                      (    forth6809.asm):02290         ; ------------------------------------------------------------
DF3E                  (    forth6809.asm):02291         DOABORTUNDEF:
DF3E CCFFEB           (    forth6809.asm):02292                     LDD   #-21
DF41 3606             (    forth6809.asm):02293                     PSHU  D                 ; throw code (-21)
DF43 7EE5B5           (    forth6809.asm):02294                     JMP   THROWW
                      (    forth6809.asm):02295         
                      (    forth6809.asm):02296         ; ------------------------------------------------------------
                      (    forth6809.asm):02297         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02298         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02299         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02300         ;    Inputs:
                      (    forth6809.asm):02301         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02302         ;    Outputs:
                      (    forth6809.asm):02303         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02304         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02305         ; ------------------------------------------------------------
DF46 3710             (    forth6809.asm):02306         DOMARKER:   PULU  X                 ; pfa
DF48 EC84             (    forth6809.asm):02307                     LDD   ,X
DF4A DD06             (    forth6809.asm):02308                     STD   DPHERE
DF4C EC02             (    forth6809.asm):02309                     LDD   2,X
DF4E DD08             (    forth6809.asm):02310                     STD   CODEHERE
DF50 EC04             (    forth6809.asm):02311                     LDD   4,X
DF52 DD0A             (    forth6809.asm):02312                     STD   VARHERE
DF54 EC06             (    forth6809.asm):02313                     LDD   6,X
DF56 DD04             (    forth6809.asm):02314                     STD   LATEST
DF58 39               (    forth6809.asm):02315                     RTS
                      (    forth6809.asm):02316         
                      (    forth6809.asm):02317         ; ------------------------------------------------------------
                      (    forth6809.asm):02318         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02319         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02320         ; ------------------------------------------------------------
DF59 3710             (    forth6809.asm):02321         EXECUTEW:   PULU  X                 ; xt
DF5B AD84             (    forth6809.asm):02322                     JSR   ,X
DF5D 39               (    forth6809.asm):02323                     RTS
                      (    forth6809.asm):02324         
                      (    forth6809.asm):02325         ; ============================================================
                      (    forth6809.asm):02326         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02327         ; ============================================================
                      (    forth6809.asm):02328         ; ------------------------------------------------------------
                      (    forth6809.asm):02329         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02330         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02331         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02332         ;    Inputs:
                      (    forth6809.asm):02333         ;        RegX = address of the here pointer
                      (    forth6809.asm):02334         ;        x on the data stack
                      (    forth6809.asm):02335         ;    Outputs:
                      (    forth6809.asm):02336         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02337         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02338         ; ------------------------------------------------------------
DF5E 3706             (    forth6809.asm):02339         APPENDCELL: PULU  D                 ; x
DF60 10AE84           (    forth6809.asm):02340                     LDY   ,X
DF63 EDA1             (    forth6809.asm):02341                     STD   ,Y++
DF65 10AF84           (    forth6809.asm):02342                     STY   ,X
DF68 39               (    forth6809.asm):02343                     RTS
                      (    forth6809.asm):02344         
                      (    forth6809.asm):02345         ; ------------------------------------------------------------
                      (    forth6809.asm):02346         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02347         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02348         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02349         ;    Inputs:
                      (    forth6809.asm):02350         ;        RegX = address of the here pointer
                      (    forth6809.asm):02351         ;        char on the data stack
                      (    forth6809.asm):02352         ;    Outputs:
                      (    forth6809.asm):02353         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02354         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02355         ; ------------------------------------------------------------
DF69 3706             (    forth6809.asm):02356         APPENDBYTE: PULU  D                 ; char
DF6B 10AE84           (    forth6809.asm):02357                     LDY   ,X
DF6E E7A0             (    forth6809.asm):02358                     STB   ,Y+
DF70 10AF84           (    forth6809.asm):02359                     STY   ,X
DF73 39               (    forth6809.asm):02360                     RTS
                      (    forth6809.asm):02361         
                      (    forth6809.asm):02362         ; ------------------------------------------------------------
                      (    forth6809.asm):02363         ; ,  ( x -- )
                      (    forth6809.asm):02364         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02365         ; ------------------------------------------------------------
DF74 8E0008           (    forth6809.asm):02366         COMMAW:     LDX   #CODEHERE
DF77 7EDF5E           (    forth6809.asm):02367                     JMP   APPENDCELL
                      (    forth6809.asm):02368         
                      (    forth6809.asm):02369         ; ------------------------------------------------------------
                      (    forth6809.asm):02370         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02371         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02372         ; ------------------------------------------------------------
DF7A 8E0008           (    forth6809.asm):02373         CODECOMMA:  LDX   #CODEHERE
DF7D 7EDF5E           (    forth6809.asm):02374                     JMP   APPENDCELL
                      (    forth6809.asm):02375         
                      (    forth6809.asm):02376         ; ------------------------------------------------------------
                      (    forth6809.asm):02377         ; C,  ( char -- )
                      (    forth6809.asm):02378         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02379         ; ------------------------------------------------------------
DF80 8E0008           (    forth6809.asm):02380         CCOMMAW:    LDX   #CODEHERE
DF83 7EDF69           (    forth6809.asm):02381                     JMP   APPENDBYTE
                      (    forth6809.asm):02382         
                      (    forth6809.asm):02383         ; ------------------------------------------------------------
                      (    forth6809.asm):02384         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02385         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
DF86 8E0008           (    forth6809.asm):02387         CCOMMA1:    LDX   #CODEHERE
DF89 7EDF69           (    forth6809.asm):02388                     JMP   APPENDBYTE
                      (    forth6809.asm):02389         
                      (    forth6809.asm):02390         ; ------------------------------------------------------------
                      (    forth6809.asm):02391         ; V,  ( x -- )
                      (    forth6809.asm):02392         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02393         ; ------------------------------------------------------------
DF8C 8E000A           (    forth6809.asm):02394         VCOMMAW:    LDX   #VARHERE
DF8F 7EDF5E           (    forth6809.asm):02395                     JMP   APPENDCELL
                      (    forth6809.asm):02396         
                      (    forth6809.asm):02397         ; ------------------------------------------------------------
                      (    forth6809.asm):02398         ; VC,  ( char -- )
                      (    forth6809.asm):02399         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02400         ; ------------------------------------------------------------
DF92 8E000A           (    forth6809.asm):02401         VCCOMMAW:   LDX   #VARHERE
DF95 7EDF69           (    forth6809.asm):02402                     JMP   APPENDBYTE
                      (    forth6809.asm):02403         
                      (    forth6809.asm):02404         ; ------------------------------------------------------------
                      (    forth6809.asm):02405         ; ALLOT  ( n -- )
                      (    forth6809.asm):02406         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02407         ; ------------------------------------------------------------
DF98 3706             (    forth6809.asm):02408         ALLOTW:     PULU  D                 ; n
DF9A 9E08             (    forth6809.asm):02409                     LDX   CODEHERE
DF9C 308B             (    forth6809.asm):02410                     LEAX  D,X
DF9E 9F08             (    forth6809.asm):02411                     STX   CODEHERE
DFA0 39               (    forth6809.asm):02412                     RTS
                      (    forth6809.asm):02413         
                      (    forth6809.asm):02414         ; ------------------------------------------------------------
                      (    forth6809.asm):02415         ; VALLOT  ( n -- )
                      (    forth6809.asm):02416         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02417         ; ------------------------------------------------------------
DFA1 3706             (    forth6809.asm):02418         VALLOTW:    PULU  D                 ; n
DFA3 9E0A             (    forth6809.asm):02419                     LDX   VARHERE
DFA5 308B             (    forth6809.asm):02420                     LEAX  D,X
DFA7 9F0A             (    forth6809.asm):02421                     STX   VARHERE
DFA9 39               (    forth6809.asm):02422                     RTS
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424         ; ------------------------------------------------------------
                      (    forth6809.asm):02425         ; HERE  ( -- addr )
                      (    forth6809.asm):02426         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02427         ; ------------------------------------------------------------
DFAA DC08             (    forth6809.asm):02428         HEREW:      LDD   CODEHERE
DFAC 3606             (    forth6809.asm):02429                     PSHU  D                 ; addr
DFAE 39               (    forth6809.asm):02430                     RTS
                      (    forth6809.asm):02431         
                      (    forth6809.asm):02432         ; ------------------------------------------------------------
                      (    forth6809.asm):02433         ; VHERE  ( -- addr )
                      (    forth6809.asm):02434         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02435         ; ------------------------------------------------------------
DFAF DC0A             (    forth6809.asm):02436         VHEREW:     LDD   VARHERE
DFB1 3606             (    forth6809.asm):02437                     PSHU  D                 ; addr
DFB3 39               (    forth6809.asm):02438                     RTS
                      (    forth6809.asm):02439         
                      (    forth6809.asm):02440         ; ------------------------------------------------------------
                      (    forth6809.asm):02441         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02442         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02443         ; ------------------------------------------------------------
DFB4 DC08             (    forth6809.asm):02444         PADW:       LDD   CODEHERE
DFB6 C30080           (    forth6809.asm):02445                     ADDD  #PADOFFSET
DFB9 3606             (    forth6809.asm):02446                     PSHU  D                 ; c-addr
DFBB 39               (    forth6809.asm):02447                     RTS
                      (    forth6809.asm):02448         
                      (    forth6809.asm):02449         ; ------------------------------------------------------------
                      (    forth6809.asm):02450         ; UNUSED  ( -- u )
                      (    forth6809.asm):02451         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02452         ; ------------------------------------------------------------
DFBC CCB900           (    forth6809.asm):02453         UNUSEDW:    LDD   #CODETOP
DFBF 9308             (    forth6809.asm):02454                     SUBD  CODEHERE
DFC1 3606             (    forth6809.asm):02455                     PSHU  D                 ; u
DFC3 39               (    forth6809.asm):02456                     RTS
                      (    forth6809.asm):02457         
                      (    forth6809.asm):02458         ; ------------------------------------------------------------
                      (    forth6809.asm):02459         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02460         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02461         ; ------------------------------------------------------------
DFC4 CC1FFF           (    forth6809.asm):02462         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DFC7 930A             (    forth6809.asm):02463                     SUBD  VARHERE
DFC9 3606             (    forth6809.asm):02464                     PSHU  D                 ; u
DFCB 39               (    forth6809.asm):02465                     RTS
                      (    forth6809.asm):02466         
                      (    forth6809.asm):02467         ; ============================================================
                      (    forth6809.asm):02468         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02469         ; ============================================================
                      (    forth6809.asm):02470         ; ------------------------------------------------------------
                      (    forth6809.asm):02471         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02472         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02473         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02474         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02475         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02476         ;    Inputs:
                      (    forth6809.asm):02477         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02478         ;        name parsed from the input stream
                      (    forth6809.asm):02479         ;    Outputs:
                      (    forth6809.asm):02480         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02481         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02482         ; ------------------------------------------------------------
DFCC CC0020           (    forth6809.asm):02483         HEADER:     LDD   #32
DFCF 3606             (    forth6809.asm):02484                     PSHU  D
DFD1 BDE2F4           (    forth6809.asm):02485                     JSR   WORDW
DFD4 3710             (    forth6809.asm):02486                     PULU  X                 ; c-addr of the name
DFD6 3706             (    forth6809.asm):02487                     PULU  D                 ; smudge flag in B
DFD8 A680             (    forth6809.asm):02488                     LDA   ,X+               ; name length, X = name text
DFDA 3402             (    forth6809.asm):02489                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DFDC 5D               (    forth6809.asm):02490                     TSTB
DFDD 2702             (    forth6809.asm):02491                     BEQ   HDNOSM
DFDF 8A40             (    forth6809.asm):02492                     ORA   #$40
DFE1 109E06           (    forth6809.asm):02493         HDNOSM:     LDY   DPHERE
DFE4 3420             (    forth6809.asm):02494                     PSHS  Y                 ; 0,S = address of the new header
DFE6 A7A0             (    forth6809.asm):02495                     STA   ,Y+
DFE8 E662             (    forth6809.asm):02496                     LDB   2,S
DFEA 2707             (    forth6809.asm):02497                     BEQ   HDNONM
DFEC A680             (    forth6809.asm):02498         HDCPY:      LDA   ,X+
DFEE A7A0             (    forth6809.asm):02499                     STA   ,Y+
DFF0 5A               (    forth6809.asm):02500                     DECB
DFF1 26F9             (    forth6809.asm):02501                     BNE   HDCPY
DFF3 DC04             (    forth6809.asm):02502         HDNONM:     LDD   LATEST
DFF5 EDA1             (    forth6809.asm):02503                     STD   ,Y++
DFF7 DC08             (    forth6809.asm):02504                     LDD   CODEHERE
DFF9 EDA1             (    forth6809.asm):02505                     STD   ,Y++
DFFB 109F06           (    forth6809.asm):02506                     STY   DPHERE
DFFE 3506             (    forth6809.asm):02507                     PULS  D
E000 DD04             (    forth6809.asm):02508                     STD   LATEST
E002 3261             (    forth6809.asm):02509                     LEAS  1,S
E004 39               (    forth6809.asm):02510                     RTS
                      (    forth6809.asm):02511         
                      (    forth6809.asm):02512         ; ============================================================
                      (    forth6809.asm):02513         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02514         ; ============================================================
                      (    forth6809.asm):02515         ; ------------------------------------------------------------
                      (    forth6809.asm):02516         ; :  ( "name" -- )
                      (    forth6809.asm):02517         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02518         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02519         ; CSP and enter compile state.
                      (    forth6809.asm):02520         ; ------------------------------------------------------------
E005 CCFFFF           (    forth6809.asm):02521         COLONW:     LDD   #TRUEV
E008 3606             (    forth6809.asm):02522                     PSHU  D
E00A BDDFCC           (    forth6809.asm):02523                     JSR   HEADER
E00D DC08             (    forth6809.asm):02524                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E00F DD1F             (    forth6809.asm):02525                     STD   CURXT             ; See bugfix: COLONW.1
E011 1F30             (    forth6809.asm):02526                     TFR   U,D
E013 DD21             (    forth6809.asm):02527                     STD   CSP
E015 CCFFFF           (    forth6809.asm):02528                     LDD   #-1
E018 DD00             (    forth6809.asm):02529                     STD   STATE
E01A 39               (    forth6809.asm):02530                     RTS
                      (    forth6809.asm):02531         
                      (    forth6809.asm):02532         ; ------------------------------------------------------------
                      (    forth6809.asm):02533         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02534         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02535         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02536         ; new word and return to interpret state.
                      (    forth6809.asm):02537         ; ------------------------------------------------------------
E01B CC0039           (    forth6809.asm):02538         SEMIW:      LDD   #RTSOPC
E01E 3606             (    forth6809.asm):02539                     PSHU  D
E020 BDDF86           (    forth6809.asm):02540                     JSR   CCOMMA1
E023 1F30             (    forth6809.asm):02541                     TFR   U,D
E025 109321           (    forth6809.asm):02542                     CMPD  CSP
E028 2703             (    forth6809.asm):02543                     BEQ   SEMIOK
E02A BDE580           (    forth6809.asm):02544                     JSR   CFERR
E02D 9E04             (    forth6809.asm):02545         SEMIOK:     LDX   LATEST
E02F A684             (    forth6809.asm):02546                     LDA   ,X
E031 84BF             (    forth6809.asm):02547                     ANDA  #$BF
E033 A784             (    forth6809.asm):02548                     STA   ,X
E035 CC0000           (    forth6809.asm):02549                     LDD   #0
E038 DD00             (    forth6809.asm):02550                     STD   STATE
E03A 39               (    forth6809.asm):02551                     RTS
                      (    forth6809.asm):02552         
                      (    forth6809.asm):02553         ; ------------------------------------------------------------
                      (    forth6809.asm):02554         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02555         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02556         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02557         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02558         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02559         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02560         ; ------------------------------------------------------------
E03B DC08             (    forth6809.asm):02561         NONAMEW:    LDD   CODEHERE
E03D 3606             (    forth6809.asm):02562                     PSHU  D                 ; xt
E03F DD1F             (    forth6809.asm):02563                     STD   CURXT             ; See bugfix: NONAMEW.1
E041 1F30             (    forth6809.asm):02564                     TFR   U,D
E043 DD21             (    forth6809.asm):02565                     STD   CSP
E045 CCFFFF           (    forth6809.asm):02566                     LDD   #-1
E048 DD00             (    forth6809.asm):02567                     STD   STATE
E04A 39               (    forth6809.asm):02568                     RTS
                      (    forth6809.asm):02569         
                      (    forth6809.asm):02570         ; ------------------------------------------------------------
                      (    forth6809.asm):02571         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02572         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02573         ; BLDDOES
                      (    forth6809.asm):02574         ;    Inputs:
                      (    forth6809.asm):02575         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02576         ;    Outputs:
                      (    forth6809.asm):02577         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02578         ;    Registers: all changed.
                      (    forth6809.asm):02579         ; BLDSELF
                      (    forth6809.asm):02580         ;    Inputs:
                      (    forth6809.asm):02581         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02582         ;    Outputs:
                      (    forth6809.asm):02583         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02584         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02585         ;    Registers: all changed.
                      (    forth6809.asm):02586         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02587         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02588         ; ------------------------------------------------------------
E04B 3406             (    forth6809.asm):02589         BLDDOES:    PSHS  D                 ; behaviour address
E04D CC0000           (    forth6809.asm):02590                     LDD   #0
E050 3606             (    forth6809.asm):02591                     PSHU  D
E052 BDDFCC           (    forth6809.asm):02592                     JSR   HEADER
E055 CCDF0F           (    forth6809.asm):02593                     LDD   #DODOES
E058 3606             (    forth6809.asm):02594                     PSHU  D
E05A BDE9F0           (    forth6809.asm):02595                     JSR   CCALL
E05D 3506             (    forth6809.asm):02596                     PULS  D
E05F 3606             (    forth6809.asm):02597                     PSHU  D                 ; behaviour address
E061 BDDF7A           (    forth6809.asm):02598                     JSR   CODECOMMA
E064 39               (    forth6809.asm):02599                     RTS
                      (    forth6809.asm):02600         
E065 BDE04B           (    forth6809.asm):02601         BLDSELF:    JSR   BLDDOES
E068 DC08             (    forth6809.asm):02602                     LDD   CODEHERE          ; PFA = the cell after this one
E06A C30002           (    forth6809.asm):02603                     ADDD  #2                ; See bugfix: CONSTANTW.1
E06D 3606             (    forth6809.asm):02604                     PSHU  D
E06F BDDF7A           (    forth6809.asm):02605                     JSR   CODECOMMA
E072 39               (    forth6809.asm):02606                     RTS
                      (    forth6809.asm):02607         
                      (    forth6809.asm):02608         ; ------------------------------------------------------------
                      (    forth6809.asm):02609         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02610         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02611         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02612         ; address in the code area, on the stack.
                      (    forth6809.asm):02613         ; ------------------------------------------------------------
E073 CCDF1A           (    forth6809.asm):02614         CREATEW:    LDD   #DOESRT0
E076 BDE065           (    forth6809.asm):02615                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E079 39               (    forth6809.asm):02616                     RTS
                      (    forth6809.asm):02617         
                      (    forth6809.asm):02618         ; ------------------------------------------------------------
                      (    forth6809.asm):02619         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02620         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02621         ; of the word being defined.
                      (    forth6809.asm):02622         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02623         ; ------------------------------------------------------------
E07A CCDF1B           (    forth6809.asm):02624         DOESGTW:    LDD   #SETDOES
E07D 3606             (    forth6809.asm):02625                     PSHU  D
E07F BDE9F0           (    forth6809.asm):02626                     JSR   CCALL
E082 39               (    forth6809.asm):02627                     RTS
                      (    forth6809.asm):02628         
                      (    forth6809.asm):02629         ; ------------------------------------------------------------
                      (    forth6809.asm):02630         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02631         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02632         ; area, initialised to zero.
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
E083 CC0000           (    forth6809.asm):02634         VARIABLEW:  LDD   #0
E086 3606             (    forth6809.asm):02635                     PSHU  D
E088 BDDFCC           (    forth6809.asm):02636                     JSR   HEADER
E08B CCDF0F           (    forth6809.asm):02637                     LDD   #DODOES
E08E 3606             (    forth6809.asm):02638                     PSHU  D
E090 BDE9F0           (    forth6809.asm):02639                     JSR   CCALL
E093 CCDF1A           (    forth6809.asm):02640                     LDD   #DOESRT0
E096 3606             (    forth6809.asm):02641                     PSHU  D
E098 BDDF7A           (    forth6809.asm):02642                     JSR   CODECOMMA
E09B DC0A             (    forth6809.asm):02643                     LDD   VARHERE
E09D 3606             (    forth6809.asm):02644                     PSHU  D
E09F BDDF7A           (    forth6809.asm):02645                     JSR   CODECOMMA
E0A2 CC0000           (    forth6809.asm):02646                     LDD   #0
E0A5 9E0A             (    forth6809.asm):02647                     LDX   VARHERE
E0A7 ED81             (    forth6809.asm):02648                     STD   ,X++
E0A9 9F0A             (    forth6809.asm):02649                     STX   VARHERE
E0AB 39               (    forth6809.asm):02650                     RTS
                      (    forth6809.asm):02651         
                      (    forth6809.asm):02652         ; ------------------------------------------------------------
                      (    forth6809.asm):02653         ; @  ( a-addr -- x )
                      (    forth6809.asm):02654         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02655         ; ------------------------------------------------------------
E0AC 3710             (    forth6809.asm):02656         FETCHW:     PULU  X                 ; a-addr
E0AE EC84             (    forth6809.asm):02657                     LDD   ,X
E0B0 3606             (    forth6809.asm):02658                     PSHU  D                 ; x
E0B2 39               (    forth6809.asm):02659                     RTS
                      (    forth6809.asm):02660         
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
                      (    forth6809.asm):02662         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02663         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02664         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02665         ; ------------------------------------------------------------
E0B3 CCE0AC           (    forth6809.asm):02666         CONSTANTW:  LDD   #FETCHW
E0B6 BDE065           (    forth6809.asm):02667                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E0B9 BDDF74           (    forth6809.asm):02668                     JSR   COMMAW
E0BC 39               (    forth6809.asm):02669                     RTS
                      (    forth6809.asm):02670         
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
                      (    forth6809.asm):02672         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02673         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02674         ;    Inputs:
                      (    forth6809.asm):02675         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02676         ;    Outputs:
                      (    forth6809.asm):02677         ;        pfa replaced by the value
                      (    forth6809.asm):02678         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02679         ; ------------------------------------------------------------
E0BD 3710             (    forth6809.asm):02680         DOVALUE:    PULU  X                 ; pfa
E0BF EC84             (    forth6809.asm):02681                     LDD   ,X
E0C1 3606             (    forth6809.asm):02682                     PSHU  D                 ; x
E0C3 39               (    forth6809.asm):02683                     RTS
                      (    forth6809.asm):02684         
                      (    forth6809.asm):02685         ; ------------------------------------------------------------
                      (    forth6809.asm):02686         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02687         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02688         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02689         ; ------------------------------------------------------------
E0C4 CCE0BD           (    forth6809.asm):02690         VALUEW:     LDD   #DOVALUE
E0C7 BDE04B           (    forth6809.asm):02691                     JSR   BLDDOES
E0CA DC0A             (    forth6809.asm):02692                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E0CC 3606             (    forth6809.asm):02693                     PSHU  D                 ; See bugfix: VALUEW.1
E0CE BDDF7A           (    forth6809.asm):02694                     JSR   CODECOMMA
E0D1 BDDF8C           (    forth6809.asm):02695                     JSR   VCOMMAW           ; store x in the variable area
E0D4 39               (    forth6809.asm):02696                     RTS
                      (    forth6809.asm):02697         
                      (    forth6809.asm):02698         ; ------------------------------------------------------------
                      (    forth6809.asm):02699         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):02700         ; lower address as 2@ expects.
                      (    forth6809.asm):02701         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):02702         ; ------------------------------------------------------------
E0D5 7EF3C3           (    forth6809.asm):02703         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):02704         
                      (    forth6809.asm):02705         ; ------------------------------------------------------------
                      (    forth6809.asm):02706         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):02707         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):02708         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
E0D8 CCE0D5           (    forth6809.asm):02710         TWOVALUEW:  LDD   #DO2VALUE
E0DB BDE04B           (    forth6809.asm):02711                     JSR   BLDDOES
E0DE DC0A             (    forth6809.asm):02712                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E0E0 3606             (    forth6809.asm):02713                     PSHU  D
E0E2 BDDF7A           (    forth6809.asm):02714                     JSR   CODECOMMA
E0E5 BDDF8C           (    forth6809.asm):02715                     JSR   VCOMMAW           ; x2 at the lower address
E0E8 BDDF8C           (    forth6809.asm):02716                     JSR   VCOMMAW           ; then x1
E0EB 39               (    forth6809.asm):02717                     RTS
                      (    forth6809.asm):02718         
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
                      (    forth6809.asm):02720         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02721         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02722         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02723         ; ------------------------------------------------------------
E0EC CC0020           (    forth6809.asm):02724         TOW:        LDD   #32
E0EF 3606             (    forth6809.asm):02725                     PSHU  D
E0F1 BDE2F4           (    forth6809.asm):02726                     JSR   WORDW
E0F4 BDE366           (    forth6809.asm):02727                     JSR   FINDW
E0F7 3706             (    forth6809.asm):02728                     PULU  D
E0F9 10830000         (    forth6809.asm):02729                     CMPD  #0
E0FD 260A             (    forth6809.asm):02730                     BNE   TOFOUND
E0FF 3706             (    forth6809.asm):02731                     PULU  D
E101 CCFFF3           (    forth6809.asm):02732                     LDD   #-13
E104 3606             (    forth6809.asm):02733                     PSHU  D
E106 BDE5B5           (    forth6809.asm):02734                     JSR   THROWW
E109 AEC4             (    forth6809.asm):02735         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
E10B EC03             (    forth6809.asm):02736                     LDD   3,X
E10D 1083E0D5         (    forth6809.asm):02737                     CMPD  #DO2VALUE
E111 271A             (    forth6809.asm):02738                     BEQ   TOTWO
E113 BDEAB1           (    forth6809.asm):02739                     JSR   TOBODYW
E116 DC00             (    forth6809.asm):02740                     LDD   STATE
E118 270C             (    forth6809.asm):02741                     BEQ   TOIMMED
E11A BDE9FD           (    forth6809.asm):02742                     JSR   LITERALW
E11D CCF3A4           (    forth6809.asm):02743                     LDD   #STOREW
E120 3606             (    forth6809.asm):02744                     PSHU  D
E122 BDE9F0           (    forth6809.asm):02745                     JSR   CCALL
E125 39               (    forth6809.asm):02746                     RTS
E126 3710             (    forth6809.asm):02747         TOIMMED:    PULU  X                 ; a-addr of the value cell
E128 3706             (    forth6809.asm):02748                     PULU  D                 ; x
E12A ED84             (    forth6809.asm):02749                     STD   ,X
E12C 39               (    forth6809.asm):02750                     RTS
E12D BDEAB1           (    forth6809.asm):02751         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
E130 DC00             (    forth6809.asm):02752                     LDD   STATE
E132 270C             (    forth6809.asm):02753                     BEQ   TOTWOIMM
E134 BDE9FD           (    forth6809.asm):02754                     JSR   LITERALW
E137 CCF3CE           (    forth6809.asm):02755                     LDD   #TWOSTOREW
E13A 3606             (    forth6809.asm):02756                     PSHU  D
E13C BDE9F0           (    forth6809.asm):02757                     JSR   CCALL
E13F 39               (    forth6809.asm):02758                     RTS
E140 7EF3CE           (    forth6809.asm):02759         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):02760         
                      (    forth6809.asm):02761         ; ------------------------------------------------------------
                      (    forth6809.asm):02762         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02763         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02764         ; the variable area, initialised to zero.
                      (    forth6809.asm):02765         ; ------------------------------------------------------------
E143                  (    forth6809.asm):02766         TWOVARIABLEW:
E143 CC0000           (    forth6809.asm):02767                     LDD   #0
E146 3606             (    forth6809.asm):02768                     PSHU  D
E148 BDDFCC           (    forth6809.asm):02769                     JSR   HEADER
E14B CCDF0F           (    forth6809.asm):02770                     LDD   #DODOES
E14E 3606             (    forth6809.asm):02771                     PSHU  D
E150 BDE9F0           (    forth6809.asm):02772                     JSR   CCALL
E153 CCDF1A           (    forth6809.asm):02773                     LDD   #DOESRT0
E156 3606             (    forth6809.asm):02774                     PSHU  D
E158 BDDF7A           (    forth6809.asm):02775                     JSR   CODECOMMA
E15B DC0A             (    forth6809.asm):02776                     LDD   VARHERE
E15D 3606             (    forth6809.asm):02777                     PSHU  D
E15F BDDF7A           (    forth6809.asm):02778                     JSR   CODECOMMA
E162 CC0000           (    forth6809.asm):02779                     LDD   #0
E165 9E0A             (    forth6809.asm):02780                     LDX   VARHERE
E167 ED81             (    forth6809.asm):02781                     STD   ,X++
E169 ED81             (    forth6809.asm):02782                     STD   ,X++
E16B 9F0A             (    forth6809.asm):02783                     STX   VARHERE
E16D 39               (    forth6809.asm):02784                     RTS
                      (    forth6809.asm):02785         
                      (    forth6809.asm):02786         ; ------------------------------------------------------------

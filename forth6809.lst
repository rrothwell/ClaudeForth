E731 3706             (    forth6809.asm):03834         AGAINW:     PULU  D
E733 10830002         (    forth6809.asm):03835                     CMPD  #TAGBACK
E737 2703             (    forth6809.asm):03836                     BEQ   AGOK
E739 BDE611           (    forth6809.asm):03837                     JSR   CFERR
E73C 3706             (    forth6809.asm):03838         AGOK:       PULU  D                 ; dest
E73E 3606             (    forth6809.asm):03839                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E740 CCDF86           (    forth6809.asm):03840                     LDD   #BRANCH
E743 3606             (    forth6809.asm):03841                     PSHU  D

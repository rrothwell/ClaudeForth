D32B 3706             (    forth6809.asm):03550                     PULU  D
D32D 10830000         (    forth6809.asm):03551                     CMPD  #0                ; flag (PULU does not set CC)
D331 273B             (    forth6809.asm):03552                     BEQ   BADWORD
                      (    forth6809.asm):03553         
D333 10830001         (    forth6809.asm):03554                     CMPD  #1                ; 1 = double-number result
D337 2711             (    forth6809.asm):03555                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03556         
D339 DC00             (    forth6809.asm):03557                     LDD   STATE

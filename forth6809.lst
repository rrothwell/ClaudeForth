                      (    forth6809.asm):10262                       STD  TSTSTSAV
                      (    forth6809.asm):10263         
                      (    forth6809.asm):10264                       LDA  #3
                      (    forth6809.asm):10265                       STA  TSTFHDR
                      (    forth6809.asm):10266                       LDA  #'F'

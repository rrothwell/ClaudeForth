                      (    forth6809.asm):07802         
FC0A 8EFC4A           (    forth6809.asm):07803         ENV2START:  LDX   #ENVTABLE2        ; double-cell table
FC0D EC84             (    forth6809.asm):07804         ENV2LOOP:   LDD   ,X
FC0F 10830000         (    forth6809.asm):07805                     CMPD  #0
FC13 272F             (    forth6809.asm):07806                     BEQ   ENVNOTFOUND
FC15 3410             (    forth6809.asm):07807                     PSHS  X                 ; See bugfix: ENVQUERYW.2
FC17 3606             (    forth6809.asm):07808                     PSHU  D
FC19 EC02             (    forth6809.asm):07809                     LDD   2,X
FC1B 3606             (    forth6809.asm):07810                     PSHU  D
FC1D DCF1             (    forth6809.asm):07811                     LDD   ENVADDR
FC1F 3606             (    forth6809.asm):07812                     PSHU  D
FC21 DCEF             (    forth6809.asm):07813                     LDD   ENVLEN
FC23 3606             (    forth6809.asm):07814                     PSHU  D
FC25 BDF64F           (    forth6809.asm):07815                     JSR   COMPAREW
FC28 3510             (    forth6809.asm):07816                     PULS  X
FC2A 3706             (    forth6809.asm):07817                     PULU  D
FC2C 10830000         (    forth6809.asm):07818                     CMPD  #0
FC30 2704             (    forth6809.asm):07819                     BEQ   ENV2FOUND
FC32 3008             (    forth6809.asm):07820                     LEAX  8,X               ; 8-byte entries
FC34 20D7             (    forth6809.asm):07821                     BRA   ENV2LOOP
FC36 EC04             (    forth6809.asm):07822         ENV2FOUND:  LDD   4,X               ; low cell, pushed first
FC38 3606             (    forth6809.asm):07823                     PSHU  D
FC3A EC06             (    forth6809.asm):07824                     LDD   6,X               ; high cell - pushed second/top
FC3C 3606             (    forth6809.asm):07825                     PSHU  D
FC3E CCFFFF           (    forth6809.asm):07826                     LDD   #TRUEV
FC41 3606             (    forth6809.asm):07827                     PSHU  D

E7AA EC62             (    forth6809.asm):03851                     LDD   2,S               ; orig
E7AC 3606             (    forth6809.asm):03852                     PSHU  D
E7AE BDE633           (    forth6809.asm):03853                     JSR   PATCH
E7B1 3264             (    forth6809.asm):03854                     LEAS  4,S               ; drop the frame

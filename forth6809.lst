F521 1F02             (    forth6809.asm):13660                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):13661                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):13662                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):13663                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):13664                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):13665                                   ; The high byte took on the fill character's
                      (    forth6809.asm):13666                                   ; value instead of the count's real high
                      (    forth6809.asm):13667                                   ; byte, so the count almost never reached
                      (    forth6809.asm):13668                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):13669                                   ; past the requested length. Keeping the
                      (    forth6809.asm):13670                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):13671                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):13672                                   ; fill character into A) and removes the
                      (    forth6809.asm):13673                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):13674                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):13675                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):13676                                   ; MAME debugger.

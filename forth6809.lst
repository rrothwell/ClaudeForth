                      (    forth6809.asm):02955         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):02956         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):02957         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):02958         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):02959         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):02960         ; ------------------------------------------------------------

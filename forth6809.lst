                      (    forth6809.asm):01582         ; RTSCHECKHI
                      (    forth6809.asm):01583         ;    Inputs:
                      (    forth6809.asm):01584         ;        none
                      (    forth6809.asm):01585         ;    Outputs:
                      (    forth6809.asm):01586         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached

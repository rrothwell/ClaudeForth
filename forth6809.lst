                      (    forth6809.asm):03657         ; ------------------------------------------------------------
                      (    forth6809.asm):03658         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03659         ; buffers, no interrupts, no RTS/CTS handshaking. Each blocks
                      (    forth6809.asm):03660         ; (KEY, EMIT) or checks once (KEYQ) directly against ACIASR.
                      (    forth6809.asm):03661         ; ------------------------------------------------------------
E66F                  (    forth6809.asm):03662         KEY:     LDA   ACIASR
                      (    forth6809.asm):03663                  BITA  #SR_RDRF
                      (    forth6809.asm):03664                  BEQ   KEY

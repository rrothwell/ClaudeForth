                      (    forth6809.asm):08033         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):08034         ; ============================================================
                      (    forth6809.asm):08035                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):08036                                        ; entirely - every routine from here through
                      (    forth6809.asm):08037                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):08038                                        ; every primitive) would otherwise have
                      (    forth6809.asm):08039                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):08040                                        ; WARM message left the location counter,
                      (    forth6809.asm):08041                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):08042                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):08043                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):08044         
                      (    forth6809.asm):08045         ; ------------------------------------------------------------
                      (    forth6809.asm):08046         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):08047         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):08048         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):08049         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):08050         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):08051         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):08052         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):08053                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):08054                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):08055                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):08056                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):08057                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):08058                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):08059                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):08060                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):08061                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):08062                  RTS
                      (    forth6809.asm):08063         
                      (    forth6809.asm):08064                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):08065         ; ------------------------------------------------------------
                      (    forth6809.asm):08066         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):08067         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):08068         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):08069         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):08070         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):08071         INFILL:  LDA   INHEAD
                      (    forth6809.asm):08072                  SUBA  INTAIL
                      (    forth6809.asm):08073                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):08074                  RTS
                      (    forth6809.asm):08075         
                      (    forth6809.asm):08076         ; ------------------------------------------------------------
                      (    forth6809.asm):08077         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):08078         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):08079         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):08080         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):08081         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):08082         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):08083         ; flow control, not a chip feature.
                      (    forth6809.asm):08084         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):08085         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):08086                     CMPA #INHIWATER
                      (    forth6809.asm):08087                     BLO  RTSCHIDONE
                      (    forth6809.asm):08088                     TST  RTSSTATE
                      (    forth6809.asm):08089                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):08090                     LDA  #CR_RTSHI
                      (    forth6809.asm):08091                     STA  ACIACR
                      (    forth6809.asm):08092                     LDA  #1
                      (    forth6809.asm):08093                     STA  RTSSTATE
DEF5                  (    forth6809.asm):08094         RTSCHIDONE: RTS
                      (    forth6809.asm):08095         
                      (    forth6809.asm):08096         ; ------------------------------------------------------------
                      (    forth6809.asm):08097         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):08098         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):08099         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):08100         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):08101         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):08102         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):08103         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):08104         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):08105         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):08106         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):08107         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):08108                     CMPA #INLOWATER
                      (    forth6809.asm):08109                     BHI  RTSCLODONE
                      (    forth6809.asm):08110                     TST  RTSSTATE
                      (    forth6809.asm):08111                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):08112                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):08113                     CLR  RTSSTATE
                      (    forth6809.asm):08114                     LDB  OUTTAIL
                      (    forth6809.asm):08115                     CMPB OUTHEAD
                      (    forth6809.asm):08116                     BEQ  RTSCLONOTX
                      (    forth6809.asm):08117                     LDA  #CR_RXTX
                      (    forth6809.asm):08118                     STA  ACIACR
                      (    forth6809.asm):08119                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):08120         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):08121                     STA  ACIACR
DEF5                  (    forth6809.asm):08122         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):08123         RTSCLODONE: RTS
                      (    forth6809.asm):08124         
DEF5                  (    forth6809.asm):08125         IRQH:    LDA   ACIASR
                      (    forth6809.asm):08126                  BITA  #SR_IRQ
                      (    forth6809.asm):08127                  BEQ   IRQDONE
                      (    forth6809.asm):08128         
                      (    forth6809.asm):08129                  BITA  #SR_RDRF
                      (    forth6809.asm):08130                  BEQ   TXCHK
                      (    forth6809.asm):08131         
                      (    forth6809.asm):08132                  LDB   INHEAD
                      (    forth6809.asm):08133                  LDA   ACIADR
                      (    forth6809.asm):08134                  LDX   #INBUF
                      (    forth6809.asm):08135                  STA   B,X
                      (    forth6809.asm):08136                  INCB
                      (    forth6809.asm):08137                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):08138                  CMPB  INTAIL
                      (    forth6809.asm):08139                  BEQ   IRQDONE
                      (    forth6809.asm):08140                  STB   INHEAD
                      (    forth6809.asm):08141                  JSR   RTSCHECKHI
                      (    forth6809.asm):08142                  BRA   IRQDONE
                      (    forth6809.asm):08143         
DEF5                  (    forth6809.asm):08144         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):08145                  CMPB  OUTHEAD
                      (    forth6809.asm):08146                  BEQ   TXOFF
                      (    forth6809.asm):08147                  LDX   #OUTBUF
                      (    forth6809.asm):08148                  LDA   B,X
                      (    forth6809.asm):08149                  STA   ACIADR
                      (    forth6809.asm):08150                  INCB
                      (    forth6809.asm):08151                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):08152                  STB   OUTTAIL
                      (    forth6809.asm):08153                  BRA   IRQDONE
                      (    forth6809.asm):08154         
DEF5                  (    forth6809.asm):08155         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):08156                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,

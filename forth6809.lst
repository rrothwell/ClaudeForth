                      (    forth6809.asm):05658         ; ------------------------------------------------------------
                      (    forth6809.asm):05659         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):05660         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):05661         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):05662         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):05663         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):05664         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):05665         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):05666         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):05667         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):05668         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):05669         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):05670         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):05671         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):05672         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):05673         ; ------------------------------------------------------------
                      (    forth6809.asm):05674         
                      (    forth6809.asm):05675         ; ------------------------------------------------------------
                      (    forth6809.asm):05676         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):05677         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):05678         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):05679         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):05680         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):05681         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):05682         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):05683         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):05684         TSTIFT1: LDD   CODEHERE
                      (    forth6809.asm):05685                  STD   TSTCSAV
                      (    forth6809.asm):05686                  LDD   #TSTCBUF
                      (    forth6809.asm):05687                  STD   CODEHERE
                      (    forth6809.asm):05688         
                      (    forth6809.asm):05689                  JSR   IF
                      (    forth6809.asm):05690         
                      (    forth6809.asm):05691                  LDD   #111
                      (    forth6809.asm):05692                  PSHU  D
                      (    forth6809.asm):05693                  JSR   LITERALW
                      (    forth6809.asm):05694         
                      (    forth6809.asm):05695                  JSR   THEN
                      (    forth6809.asm):05696         
                      (    forth6809.asm):05697                  LDD   #OPRTS
                      (    forth6809.asm):05698                  PSHU  D
                      (    forth6809.asm):05699                  JSR   CCOMMA
                      (    forth6809.asm):05700         
                      (    forth6809.asm):05701                  LDD   TSTCSAV
                      (    forth6809.asm):05702                  STD   CODEHERE
                      (    forth6809.asm):05703         
                      (    forth6809.asm):05704                  STU   TSTU0
                      (    forth6809.asm):05705         
                      (    forth6809.asm):05706                  LDD   #TSTGUARD
                      (    forth6809.asm):05707                  PSHU  D
                      (    forth6809.asm):05708                  LDD   #TRUEV
                      (    forth6809.asm):05709                  PSHU  D
                      (    forth6809.asm):05710                  STU   TSTUB4
                      (    forth6809.asm):05711         
                      (    forth6809.asm):05712                  JSR   TSTCBUF
                      (    forth6809.asm):05713         
                      (    forth6809.asm):05714                  STU   TSTUAF
                      (    forth6809.asm):05715         
                      (    forth6809.asm):05716                  PULU  D
                      (    forth6809.asm):05717                  CMPD  #111
                      (    forth6809.asm):05718                  BNE   T1FAIL
                      (    forth6809.asm):05719                  PULU  D
                      (    forth6809.asm):05720                  CMPD  #TSTGUARD
                      (    forth6809.asm):05721                  BNE   T1FAIL
                      (    forth6809.asm):05722         
                      (    forth6809.asm):05723                  LDD   TSTUB4
                      (    forth6809.asm):05724                  SUBD  TSTUAF
                      (    forth6809.asm):05725                  CMPD  #0
                      (    forth6809.asm):05726                  BNE   T1FAIL
                      (    forth6809.asm):05727         
                      (    forth6809.asm):05728                  LDD   #TRUEV
                      (    forth6809.asm):05729                  BRA   T1DONE
C3C7                  (    forth6809.asm):05730         T1FAIL:  LDD   #FALSEV
C3C7                  (    forth6809.asm):05731         T1DONE:  LDX   #TSTIFT1NAME
                      (    forth6809.asm):05732                  PSHU  X
                      (    forth6809.asm):05733                  PSHU  D
                      (    forth6809.asm):05734                  JSR   TSTREPORT
                      (    forth6809.asm):05735         
                      (    forth6809.asm):05736                  LDU   TSTU0
                      (    forth6809.asm):05737                  RTS
                      (    forth6809.asm):05738         
C3C7                  (    forth6809.asm):05739         TSTIFT1NAME: FCB  7
                      (    forth6809.asm):05740                      FCC  "TSTIFT1"
                      (    forth6809.asm):05741         
                      (    forth6809.asm):05742         ; ------------------------------------------------------------
                      (    forth6809.asm):05743         ; TSTIFT2 - unit test for IF/THEN, false case. Same compiled
                      (    forth6809.asm):05744         ; snippet as TSTIFT1, run with a false flag instead - the
                      (    forth6809.asm):05745         ; branch IS taken, jumping straight past the LIT+111, so 111
                      (    forth6809.asm):05746         ; should NOT appear; only the guard remains.
                      (    forth6809.asm):05747         ; ------------------------------------------------------------
C3C7                  (    forth6809.asm):05748         TSTIFT2: LDD   CODEHERE
                      (    forth6809.asm):05749                  STD   TSTCSAV
                      (    forth6809.asm):05750                  LDD   #TSTCBUF
                      (    forth6809.asm):05751                  STD   CODEHERE

F068 4D               (    forth6809.asm):12971                  TSTA            ; BUG FIX: CLR MSIGN unconditionally sets N=0
                      (    forth6809.asm):12972                                  ; (CLR always clears to 0), overwriting D's
                      (    forth6809.asm):12973                                  ; own flags from the PULU above - and PULU
                      (    forth6809.asm):12974                                  ; doesn't set flags on genuine 6809 anyway
                      (    forth6809.asm):12975                                  ; (same class as TRYNUM/STOD/SIGN's own fixes
                      (    forth6809.asm):12976                                  ; elsewhere in this file), so BPL was always
                      (    forth6809.asm):12977                                  ; testing CLR's result, not n1's actual sign.
                      (    forth6809.asm):12978                                  ; BPL always branched, meaning n1 was NEVER
                      (    forth6809.asm):12979                                  ; negated even when genuinely negative - found
                      (    forth6809.asm):12980                                  ; via MAME: TSTMSTAR's two returned values
                      (    forth6809.asm):12981                                  ; came back wrong, which turned out to be
                      (    forth6809.asm):12982                                  ; this, not a push-order swap in the test
                      (    forth6809.asm):12983                                  ; itself. FMSLASHMOD/SMSLASHREM already do

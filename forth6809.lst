                      (    forth6809.asm):02285         ;        none 
                      (    forth6809.asm):02286         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02287         PUTCHAR:
                      (    forth6809.asm):02288                     PSHS  CC,X              

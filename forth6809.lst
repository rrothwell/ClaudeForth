                      (    forth6809.asm):21572                                     ; clobbering whatever the caller had there.
                      (    forth6809.asm):21573                                     ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):21574                                     ; current table entry after COMPAREW
                      (    forth6809.asm):21575                                     ; returns, both for ENVFOUND's own LDD 4,X

                      (    forth6809.asm):09488         ; ------------------------------------------------------------
                      (    forth6809.asm):09489         ; TSTCOMPWORDS - compiling-words tests (glossary section 3.10,
                      (    forth6809.asm):09490         ; 13 words, 17 tests since several get separate cases: TICK
                      (    forth6809.asm):09491         ; found/not-found, ['] compiling/interpreting state, POSTPONE
                      (    forth6809.asm):09492         ; normal/immediate word, SLITERAL compiling/interpreting state,
                      (    forth6809.asm):09493         ; ABORT" false/true flag). Reuses the scratch infrastructure
                      (    forth6809.asm):09494         ; established for sections 3.8/3.9 throughout.
                      (    forth6809.asm):09495         ;
                      (    forth6809.asm):09496         ; POSTPONE is this section's hardest case: a genuine two-level
                      (    forth6809.asm):09497         ; compile-time mechanism. Traced its own code first - for a
                      (    forth6809.asm):09498         ; normal word, it compiles code that ITSELF compiles a call to
                      (    forth6809.asm):09499         ; that word later, when the current definition eventually runs,
                      (    forth6809.asm):09500         ; not immediately (standard ANS semantics: POSTPONE appends a
                      (    forth6809.asm):09501         ; word's own compilation semantics to the current definition,
                      (    forth6809.asm):09502         ; and for an ordinary word that semantics IS "compile a call to
                      (    forth6809.asm):09503         ; it", so appending it only makes sense if the current
                      (    forth6809.asm):09504         ; definition later performs that compiling action itself,
                      (    forth6809.asm):09505         ; against whatever's being compiled at that later point).
                      (    forth6809.asm):09506         ; Verified via the compiled byte sequence directly rather than
                      (    forth6809.asm):09507         ; fully executing a triple-nested compile chain.
                      (    forth6809.asm):09508         ;
                      (    forth6809.asm):09509         ; ABORT" is safely testable for both its flag cases - confirmed
                      (    forth6809.asm):09510         ; by reading its own runtime code that it uses THROW -2
                      (    forth6809.asm):09511         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09512         ; ABORT itself uses (still deliberately untested, per section
                      (    forth6809.asm):09513         ; 3.1's own reasoning).
                      (    forth6809.asm):09514         ; ------------------------------------------------------------
C25E BDFC2B           (    forth6809.asm):09515         TSTCOMPWORDS: JSR CRW
C261 8EC272           (    forth6809.asm):09516                    LDX   #TSTCWMSG
C264 3610             (    forth6809.asm):09517                    PSHU  X
C266 CC0009           (    forth6809.asm):09518                    LDD   #9
C269 3606             (    forth6809.asm):09519                    PSHU  D
C26B BDF60B           (    forth6809.asm):09520                    JSR   TYPE
C26E BDFC2B           (    forth6809.asm):09521                    JSR   CRW
                      (    forth6809.asm):09522         
                      (    forth6809.asm):09523                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09524         
                      (    forth6809.asm):09525                    JSR   TSTIMMED
                      (    forth6809.asm):09526                    JSR   TSTSTATE
                      (    forth6809.asm):09527                    JSR   TSTBRACKETS
                      (    forth6809.asm):09528                    JSR   TSTTICK1
                      (    forth6809.asm):09529                    JSR   TSTTICK2
                      (    forth6809.asm):09530                    JSR   TSTCOMPCOMMA
                      (    forth6809.asm):09531                    JSR   TSTLITERAL
                      (    forth6809.asm):09532                    JSR   TSTBRACKTICK1
                      (    forth6809.asm):09533                    JSR   TSTBRACKTICK2
                      (    forth6809.asm):09534                    JSR   TSTPOSTPONE1
                      (    forth6809.asm):09535                    JSR   TSTPOSTPONE2
                      (    forth6809.asm):09536                    JSR   TSTTOBODY
                      (    forth6809.asm):09537                    JSR   TSTEXECUTE
                      (    forth6809.asm):09538                    JSR   TSTSLITERAL1
                      (    forth6809.asm):09539                    JSR   TSTSLITERAL2
                      (    forth6809.asm):09540                    JSR   TSTABORTQ1
                      (    forth6809.asm):09541                    JSR   TSTABORTQ2
                      (    forth6809.asm):09542         
                      (    forth6809.asm):09543                    ENDC ; <<<<
                      (    forth6809.asm):09544         
C271 39               (    forth6809.asm):09545                    RTS
                      (    forth6809.asm):09546         
C272 436F6D70576F7264 (    forth6809.asm):09547         TSTCWMSG: FCC "CompWords"
     73
                      (    forth6809.asm):09548         
                      (    forth6809.asm):09549                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09550         
                      (    forth6809.asm):09551         ; ------------------------------------------------------------
                      (    forth6809.asm):09552         ; Compiling-words test harness (glossary section 3.10). Reuses
                      (    forth6809.asm):09553         ; the scratch infrastructure established for sections 3.8/3.9
                      (    forth6809.asm):09554         ; (TSTCBUF/TSTCBUF2 for CODEHERE redirects, TSTFHDR for a fake
                      (    forth6809.asm):09555         ; dictionary header, TSTNAMEB for a fake source name). POSTPONE
                      (    forth6809.asm):09556         ; is this section's own hardest case: a genuine two-level
                      (    forth6809.asm):09557         ; compile-time mechanism (compiling code that, for a normal
                      (    forth6809.asm):09558         ; word, itself compiles a call to that word later, when the
                      (    forth6809.asm):09559         ; current definition eventually runs - not immediately, unlike
                      (    forth6809.asm):09560         ; every other compile-time word tested so far). ABORT" is safely
                      (    forth6809.asm):09561         ; testable for both its true and false flag cases - traced its
                      (    forth6809.asm):09562         ; own runtime behavior directly and confirmed it uses THROW -2
                      (    forth6809.asm):09563         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09564         ; ABORT itself uses (which remains untested, per section 3.1's
                      (    forth6809.asm):09565         ; own reasoning).
                      (    forth6809.asm):09566         ; ------------------------------------------------------------
                      (    forth6809.asm):09567         
                      (    forth6809.asm):09568         ; ------------------------------------------------------------
                      (    forth6809.asm):09569         ; TSTIMMED - unit test for IMMEDIATE. Builds a fake header (LEN/
                      (    forth6809.asm):09570         ; FL=3, no flags), points LATEST at it, calls IMMEDIATE, and
                      (    forth6809.asm):09571         ; verifies the header's own LEN/FL byte now has bit 7 set -
                      (    forth6809.asm):09572         ; confirmed a memory-only operation with no data-stack effect,
                      (    forth6809.asm):09573         ; so the guard check is the whole verification beyond that.
                      (    forth6809.asm):09574         ; ------------------------------------------------------------
C27B                  (    forth6809.asm):09575         TSTIMMED: LDD  LATEST
                      (    forth6809.asm):09576                   STD  TSTLSAV
                      (    forth6809.asm):09577         
                      (    forth6809.asm):09578                   LDA  #3

                      (    forth6809.asm):03053                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03054                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03055                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03056                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03057                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03058                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03059                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03060                   ; high cell.
E5C3 0D22             (    forth6809.asm):03061                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):03062                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):03063                   LDD   UDLO
E5C9 43               (    forth6809.asm):03064                   COMA
E5CA 53               (    forth6809.asm):03065                   COMB
E5CB C30001           (    forth6809.asm):03066                   ADDD  #1
E5CE DD76             (    forth6809.asm):03067                   STD   UDLO
E5D0 3401             (    forth6809.asm):03068                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03069                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03070                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03071                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03072                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03073                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03074                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03075                                      ; making the high-cell increment run
                      (    forth6809.asm):03076                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03077                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03078                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03079                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03080                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03081                                      ; matching "always increment" rather than
                      (    forth6809.asm):03082                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):03083                   LDD   UDHI
E5D4 43               (    forth6809.asm):03084                   COMA
E5D5 53               (    forth6809.asm):03085                   COMB
E5D6 3501             (    forth6809.asm):03086                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):03087                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03088                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03089                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03090                                      ; value was computed in D but never
                      (    forth6809.asm):03091                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03092                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03093                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03094                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03095                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03096                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03097                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03098                                      ; alone would have made this second,
                      (    forth6809.asm):03099                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03100                                      ; only past the "+1", never past the
                      (    forth6809.asm):03101                                      ; store itself - the store always runs,
                      (    forth6809.asm):03102                                      ; either way.
E5DA C30001           (    forth6809.asm):03103                   ADDD  #1
E5DD DD74             (    forth6809.asm):03104         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03105         
E5DF                  (    forth6809.asm):03106         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03107                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):03108                   LDX   CADDR
E5E1 E684             (    forth6809.asm):03109                   LDB   ,X
E5E3 5A               (    forth6809.asm):03110                   DECB
E5E4 3001             (    forth6809.asm):03111                   LEAX  1,X
E5E6 A685             (    forth6809.asm):03112                   LDA   B,X
E5E8 812E             (    forth6809.asm):03113                   CMPA  #'.'
E5EA 260E             (    forth6809.asm):03114                   BNE   NQSINGLE
                      (    forth6809.asm):03115         
                      (    forth6809.asm):03116                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03117                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03118                   ; apart without needing a separate flag of its own either
E5EC DC76             (    forth6809.asm):03119                   LDD   UDLO
E5EE 3606             (    forth6809.asm):03120                   PSHU  D
E5F0 DC74             (    forth6809.asm):03121                   LDD   UDHI
E5F2 3606             (    forth6809.asm):03122                   PSHU  D

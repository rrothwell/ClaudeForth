                      (    forth6809.asm):15465                    STA  TSTNAMEB
                      (    forth6809.asm):15466                    LDA  #'i'
                      (    forth6809.asm):15467                    STA  TSTNAMEB+1
                      (    forth6809.asm):15468                    LDA  #')'
                      (    forth6809.asm):15469                    STA  TSTNAMEB+2
                      (    forth6809.asm):15470                    LDA  #'m'

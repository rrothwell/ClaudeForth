                      (    forth6809.asm):03702         
                      (    forth6809.asm):03703                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03704                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03705                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03706                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03707                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03708                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03709                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03710                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03711                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03712                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03713                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03714                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03715                  ; for it.
E438 D621             (    forth6809.asm):03716                  LDB   CNTREM
E43A 5A               (    forth6809.asm):03717                  DECB
E43B A685             (    forth6809.asm):03718                  LDA   B,X
E43D 812E             (    forth6809.asm):03719                  CMPA  #'.'
E43F 2604             (    forth6809.asm):03720                  BNE   NQNOSIGN
E441 0A21             (    forth6809.asm):03721                  DEC   CNTREM
E443 2766             (    forth6809.asm):03722                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03723         
E445 0F22             (    forth6809.asm):03724         NQNOSIGN: CLR   NUMNEG
E447 A684             (    forth6809.asm):03725                  LDA   ,X
E449 812D             (    forth6809.asm):03726                  CMPA  #'-'

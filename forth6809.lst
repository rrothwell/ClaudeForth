                      (    forth6809.asm):02169         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02170         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02171         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02172         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02173         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02174         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02175         ; one copy pushed).
                      (    forth6809.asm):02176         ; ------------------------------------------------------------
C192                  (    forth6809.asm):02177         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):02178         
                      (    forth6809.asm):02179                    LDD   #TSTGUARD
                      (    forth6809.asm):02180                    PSHU  D
                      (    forth6809.asm):02181                    LDD   #TSTVAL1
                      (    forth6809.asm):02182                    PSHU  D
                      (    forth6809.asm):02183                    LDD   #TSTVAL2
                      (    forth6809.asm):02184                    PSHU  D
                      (    forth6809.asm):02185                    LDD   #TSTVAL3
                      (    forth6809.asm):02186                    PSHU  D
                      (    forth6809.asm):02187                    LDD   #2
                      (    forth6809.asm):02188                    PSHU  D
                      (    forth6809.asm):02189                    STU   TSTUB4
                      (    forth6809.asm):02190         
                      (    forth6809.asm):02191                    JSR   PICK
                      (    forth6809.asm):02192         
                      (    forth6809.asm):02193                    STU   TSTUAF
                      (    forth6809.asm):02194         
                      (    forth6809.asm):02195                    PULU  D
                      (    forth6809.asm):02196                    CMPD  #TSTVAL1
                      (    forth6809.asm):02197                    BNE   PKFAIL
                      (    forth6809.asm):02198                    PULU  D
                      (    forth6809.asm):02199                    CMPD  #TSTVAL3
                      (    forth6809.asm):02200                    BNE   PKFAIL
                      (    forth6809.asm):02201                    PULU  D
                      (    forth6809.asm):02202                    CMPD  #TSTVAL2
                      (    forth6809.asm):02203                    BNE   PKFAIL
                      (    forth6809.asm):02204                    PULU  D
                      (    forth6809.asm):02205                    CMPD  #TSTVAL1
                      (    forth6809.asm):02206                    BNE   PKFAIL
                      (    forth6809.asm):02207                    PULU  D
                      (    forth6809.asm):02208                    CMPD  #TSTGUARD
                      (    forth6809.asm):02209                    BNE   PKFAIL
                      (    forth6809.asm):02210         
                      (    forth6809.asm):02211                    LDD   TSTUB4
                      (    forth6809.asm):02212                    SUBD  TSTUAF
                      (    forth6809.asm):02213                    CMPD  #0
                      (    forth6809.asm):02214                    BNE   PKFAIL
                      (    forth6809.asm):02215         
                      (    forth6809.asm):02216                    LDD   #TRUEV
                      (    forth6809.asm):02217                    BRA   PKDONE
C192                  (    forth6809.asm):02218         PKFAIL:    LDD   #FALSEV
C192                  (    forth6809.asm):02219         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):02220                    PSHU  X
                      (    forth6809.asm):02221                    PSHU  D
                      (    forth6809.asm):02222                    JSR   TSTREPORT
                      (    forth6809.asm):02223         
                      (    forth6809.asm):02224                    LDU   TSTU0
                      (    forth6809.asm):02225                    RTS

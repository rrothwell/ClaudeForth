                      (    forth6809.asm):05009         
                      (    forth6809.asm):05010         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):05011         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):05012         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):05013         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):05014         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):05015         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):05016         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):05017         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):05018         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):05019         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):05020         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):05021         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):05022                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):05023                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):05024                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):05025                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):05026                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):05027                  FDB   ABORT
                      (    forth6809.asm):05028         
DEBE 04               (    forth6809.asm):05029         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):05030                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):05031                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):05032                  FDB   QUIT
                      (    forth6809.asm):05033         
                      (    forth6809.asm):05034         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):05035         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):05036         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):05037         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):05038         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):05039         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):05040         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):05041                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):05042                  FDB   H_QUIT
DECE E476             (    forth6809.asm):05043                  FDB   FIND
                      (    forth6809.asm):05044         
DED0 01               (    forth6809.asm):05045         H_1:     FCB   1
DED1 31               (    forth6809.asm):05046                  FCC   "1"
DED2 DEC7             (    forth6809.asm):05047                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):05048                  FDB   ONEBODY
                      (    forth6809.asm):05049         
DED6 02               (    forth6809.asm):05050         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):05051                  FCC   "-1"
DED9 DED0             (    forth6809.asm):05052                  FDB   H_1
DEDB FF49             (    forth6809.asm):05053                  FDB   MONEBODY
                      (    forth6809.asm):05054         
DEDD 01               (    forth6809.asm):05055         H_2:     FCB   1
DEDE 32               (    forth6809.asm):05056                  FCC   "2"
DEDF DED6             (    forth6809.asm):05057                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):05058                  FDB   TWOBODY
                      (    forth6809.asm):05059         
DEE3 02               (    forth6809.asm):05060         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):05061                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):05062                  FDB   H_2
DEE8 FF55             (    forth6809.asm):05063                  FDB   MTWOBODY
                      (    forth6809.asm):05064         
     DEE3             (    forth6809.asm):05065         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):05066                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):05067                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):05068                                   ; were chained on after it; before that,
                      (    forth6809.asm):05069                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):05070                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):05071                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):05072                                   ; before this one.
                      (    forth6809.asm):05073         
                      (    forth6809.asm):05074         ; Verify no collision with base code.
                      (    forth6809.asm):05075         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):05076         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):05077         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):05078         
                      (    forth6809.asm):05079         ; ============================================================
                      (    forth6809.asm):05080         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):05081         ; ============================================================
                      (    forth6809.asm):05082                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):05083                                        ; entirely - every routine from here through
                      (    forth6809.asm):05084                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):05085                                        ; every primitive) would otherwise have
                      (    forth6809.asm):05086                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):05087                                        ; WARM message left the location counter,
                      (    forth6809.asm):05088                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):05089                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):05090                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):05091         
                      (    forth6809.asm):05092         ; ------------------------------------------------------------
                      (    forth6809.asm):05093         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):05094         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):05095         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):05096         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):05097         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):05098         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):05099         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):05100                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):05101                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):05102                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):05103                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):05104                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):05105                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):05106                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):05107                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):05108                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):05109                  RTS
                      (    forth6809.asm):05110         
                      (    forth6809.asm):05111                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):05112         ; ------------------------------------------------------------
                      (    forth6809.asm):05113         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):05114         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):05115         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):05116         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):05117         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):05118         INFILL:  LDA   INHEAD
                      (    forth6809.asm):05119                  SUBA  INTAIL
                      (    forth6809.asm):05120                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):05121                  RTS
                      (    forth6809.asm):05122         
                      (    forth6809.asm):05123         ; ------------------------------------------------------------
                      (    forth6809.asm):05124         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):05125         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):05126         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):05127         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):05128         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):05129         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):05130         ; flow control, not a chip feature.
                      (    forth6809.asm):05131         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):05132         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):05133                     CMPA #INHIWATER
                      (    forth6809.asm):05134                     BLO  RTSCHIDONE
                      (    forth6809.asm):05135                     TST  RTSSTATE
                      (    forth6809.asm):05136                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):05137                     LDA  #CR_RTSHI
                      (    forth6809.asm):05138                     STA  ACIACR
                      (    forth6809.asm):05139                     LDA  #1
                      (    forth6809.asm):05140                     STA  RTSSTATE
DEF5                  (    forth6809.asm):05141         RTSCHIDONE: RTS
                      (    forth6809.asm):05142         
                      (    forth6809.asm):05143         ; ------------------------------------------------------------
                      (    forth6809.asm):05144         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):05145         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):05146         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):05147         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):05148         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):05149         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):05150         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):05151         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):05152         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):05153         ; ------------------------------------------------------------

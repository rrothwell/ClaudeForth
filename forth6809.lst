                      (    forth6809.asm):07422         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (    forth6809.asm):07423         ; clause. Compiles
                      (    forth6809.asm):07424         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (    forth6809.asm):07425         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (    forth6809.asm):07426         ; with selector=2, matching the second clause. Traced by hand:
                      (    forth6809.asm):07427         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (    forth6809.asm):07428         ; runs on a match, consuming the selector; ENDOF compiles an
                      (    forth6809.asm):07429         ; unconditional branch past the remaining clauses AND patches
                      (    forth6809.asm):07430         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (    forth6809.asm):07431         ; patches every pending ENDOF branch to the true end and
                      (    forth6809.asm):07432         ; compiles a final fallback DROP for the no-match case.
                      (    forth6809.asm):07433         ; ------------------------------------------------------------
C100                  (    forth6809.asm):07434         TSTCASE1: LDD  CODEHERE
                      (    forth6809.asm):07435                   STD  TSTCSAV
                      (    forth6809.asm):07436                   LDD  #TSTCBUF
                      (    forth6809.asm):07437                   STD  CODEHERE
                      (    forth6809.asm):07438         
                      (    forth6809.asm):07439                   JSR  CASEW
                      (    forth6809.asm):07440         
                      (    forth6809.asm):07441                   LDD  #1
                      (    forth6809.asm):07442                   PSHU D
                      (    forth6809.asm):07443                   JSR  LITERALW
                      (    forth6809.asm):07444                   JSR  OF
                      (    forth6809.asm):07445                   LDD  #111
                      (    forth6809.asm):07446                   PSHU D
                      (    forth6809.asm):07447                   JSR  LITERALW
                      (    forth6809.asm):07448                   JSR  ENDOF
                      (    forth6809.asm):07449         
                      (    forth6809.asm):07450                   LDD  #2
                      (    forth6809.asm):07451                   PSHU D
                      (    forth6809.asm):07452                   JSR  LITERALW
                      (    forth6809.asm):07453                   JSR  OF
                      (    forth6809.asm):07454                   LDD  #222
                      (    forth6809.asm):07455                   PSHU D
                      (    forth6809.asm):07456                   JSR  LITERALW
                      (    forth6809.asm):07457                   JSR  ENDOF
                      (    forth6809.asm):07458         
                      (    forth6809.asm):07459                   JSR  ENDCASE
                      (    forth6809.asm):07460         
                      (    forth6809.asm):07461                   LDD  #OPRTS
                      (    forth6809.asm):07462                   PSHU D
                      (    forth6809.asm):07463                   JSR  CCOMMA
                      (    forth6809.asm):07464         
                      (    forth6809.asm):07465                   LDD  TSTCSAV
                      (    forth6809.asm):07466                   STD  CODEHERE
                      (    forth6809.asm):07467         
                      (    forth6809.asm):07468                   STU  TSTU0
                      (    forth6809.asm):07469         
                      (    forth6809.asm):07470                   LDD  #TSTGUARD
                      (    forth6809.asm):07471                   PSHU D
                      (    forth6809.asm):07472                   LDD  #2
                      (    forth6809.asm):07473                   PSHU D
                      (    forth6809.asm):07474                   STU  TSTUB4
                      (    forth6809.asm):07475         
                      (    forth6809.asm):07476                   JSR  TSTCBUF
                      (    forth6809.asm):07477         
                      (    forth6809.asm):07478                   STU  TSTUAF
                      (    forth6809.asm):07479         
                      (    forth6809.asm):07480                   PULU D
                      (    forth6809.asm):07481                   CMPD #222
                      (    forth6809.asm):07482                   BNE  C1FAIL
                      (    forth6809.asm):07483                   PULU D
                      (    forth6809.asm):07484                   CMPD #TSTGUARD
                      (    forth6809.asm):07485                   BNE  C1FAIL
                      (    forth6809.asm):07486         
                      (    forth6809.asm):07487                   LDD  TSTUB4
                      (    forth6809.asm):07488                   SUBD TSTUAF
                      (    forth6809.asm):07489                   CMPD #0
                      (    forth6809.asm):07490                   BNE  C1FAIL
                      (    forth6809.asm):07491         
                      (    forth6809.asm):07492                   LDD  #TRUEV
                      (    forth6809.asm):07493                   BRA  C1DONE
C100                  (    forth6809.asm):07494         C1FAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):07495         C1DONE:   LDX  #TSTCASE1NAME
                      (    forth6809.asm):07496                   PSHU X
                      (    forth6809.asm):07497                   PSHU D
                      (    forth6809.asm):07498                   JSR  TSTREPORT
                      (    forth6809.asm):07499         
                      (    forth6809.asm):07500                   LDU  TSTU0
                      (    forth6809.asm):07501                   RTS
                      (    forth6809.asm):07502         
C100                  (    forth6809.asm):07503         TSTCASE1NAME: FCB  9
                      (    forth6809.asm):07504                       FCC  "TSTCASE1"

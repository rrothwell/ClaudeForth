                      (    forth6809.asm):00300         
                      (    forth6809.asm):00301         ; ------------------------------------------------------------
                      (    forth6809.asm):00302         ; SERIALPOLL - conditional-assembly switch for serial I/O.
                      (    forth6809.asm):00303         ; 1 (default): KEY/KEYQ/EMIT poll ACIASR directly, no interrupts,
                      (    forth6809.asm):00304         ; no ring buffers, no RTS/CTS handshaking - IRQH is a harmless RTI
                      (    forth6809.asm):00305         ; stub, matching the other unused vectors (NMIH/FIRQH/SWI2H/
                      (    forth6809.asm):00306         ; SWI3H). 0: the original interrupt-driven implementation, with
                      (    forth6809.asm):00307         ; INBUF/OUTBUF ring buffers serviced by IRQH and RTS-based flow
                      (    forth6809.asm):00308         ; control via INFILL/RTSCHECKHI/RTSCHECKLO. Uses LWASM's IFEQ/
                      (    forth6809.asm):00309         ; ELSE/ENDC (a numeric-expression test, not IFDEF/IFNDEF, since
                      (    forth6809.asm):00310         ; this is a value to compare, not a symbol's mere presence).
                      (    forth6809.asm):00311         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00312         SERIALPOLL EQU 1
                      (    forth6809.asm):00313         
                      (    forth6809.asm):00314         ; ------------------------------------------------------------
                      (    forth6809.asm):00315         ; ACIA (6850) constants - the chip sits at INOUT+8, not at the
                      (    forth6809.asm):00316         ; base of the I/O block, leaving INOUT+0..INOUT+7 free for other
                      (    forth6809.asm):00317         ; memory-mapped devices sharing this 256-byte region
                      (    forth6809.asm):00318         ; ------------------------------------------------------------
     C008             (    forth6809.asm):00319         ACIA     EQU  INOUT+8
     C008             (    forth6809.asm):00320         ACIACR   EQU  ACIA
     C008             (    forth6809.asm):00321         ACIASR   EQU  ACIA
     C009             (    forth6809.asm):00322         ACIADR   EQU  ACIA+1
     0001             (    forth6809.asm):00323         SR_RDRF  EQU  $01
     0002             (    forth6809.asm):00324         SR_TDRE  EQU  $02
     0080             (    forth6809.asm):00325         SR_IRQ   EQU  $80
     0003             (    forth6809.asm):00326         CR_RESET EQU  $03
     0095             (    forth6809.asm):00327         CR_RXON  EQU  $95
     00B5             (    forth6809.asm):00328         CR_RXTX  EQU  $B5
     0015             (    forth6809.asm):00329         CR_POLL  EQU  $15     ; bit7=0 (RX interrupt disabled), bits6-5=00 (RTS
                      (    forth6809.asm):00330                                ; low, TX interrupt disabled) - CR_RXON ($95) with
                      (    forth6809.asm):00331                                ; only the RX-interrupt-enable bit cleared. Used
                      (    forth6809.asm):00332                                ; only when SERIALPOLL=1; RTS stays permanently
                      (    forth6809.asm):00333                                ; low (asserted), since polling mode has no ring
                      (    forth6809.asm):00334                                ; buffer to overflow and so needs no flow control
     00D5             (    forth6809.asm):00335         CR_RTSHI EQU  $D5     ; bits6-5=10: RTS high, TX int disabled, RX int enabled -
                      (    forth6809.asm):00336                                ; derived from CR_RXON ($95) with bits6-5 changed from
                      (    forth6809.asm):00337                                ; 00 to 10; the ACIA has no combination offering RTS
                      (    forth6809.asm):00338                                ; high AND TX interrupt enabled simultaneously (bits6-5
                      (    forth6809.asm):00339                                ; only has 00/01/10/11, and only 01 enables TX interrupt,
                      (    forth6809.asm):00340                                ; which always ties RTS low) - EMIT/IRQH's TXCHK must
                      (    forth6809.asm):00341                                ; respect this and defer transmission while RTS is high
                      (    forth6809.asm):00342         
     0030             (    forth6809.asm):00343         INHIWATER EQU 48       ; input ring fill level (of 64) at/above which RTS is
                      (    forth6809.asm):00344                                 ; asserted high, telling the remote device to pause
     0010             (    forth6809.asm):00345         INLOWATER EQU 16        ; fill level at/below which RTS is reasserted low;
                      (    forth6809.asm):00346                                  ; deliberately well below INHIWATER (hysteresis) so
                      (    forth6809.asm):00347                                  ; RTS doesn't chatter right at a single threshold
                      (    forth6809.asm):00348         
                      (    forth6809.asm):00349         ; ------------------------------------------------------------
                      (    forth6809.asm):00350         ; Flag / opcode constants
                      (    forth6809.asm):00351         ; ------------------------------------------------------------
     FFFF             (    forth6809.asm):00352         TRUEV    EQU  $FFFF
     0000             (    forth6809.asm):00353         FALSEV   EQU  $0000
     00BD             (    forth6809.asm):00354         OPJSR    EQU  $BD
     0039             (    forth6809.asm):00355         RTSOPC   EQU  $39
                      (    forth6809.asm):00356         
                      (    forth6809.asm):00357         ; ------------------------------------------------------------
                      (    forth6809.asm):00358         ; Control-flow compile-time tags
                      (    forth6809.asm):00359         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00360         TAGFWD   EQU  1
     0002             (    forth6809.asm):00361         TAGBACK  EQU  2
     0003             (    forth6809.asm):00362         TAGDO    EQU  3
     0004             (    forth6809.asm):00363         TAGCASE  EQU  4
     0005             (    forth6809.asm):00364         TAGOF    EQU  5
     0006             (    forth6809.asm):00365         TAGENDOF EQU  6
                      (    forth6809.asm):00366         

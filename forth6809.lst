E4F5 4F               (    forth6809.asm):03304                     CLRA
E4F6 D621             (    forth6809.asm):03305                     LDB   CNTREM
E4F8 DD25             (    forth6809.asm):03306                     STD   NCNT
E4FA CC0000           (    forth6809.asm):03307                     LDD   #0
E4FD DD6E             (    forth6809.asm):03308                     STD   UDHI
E4FF DD70             (    forth6809.asm):03309                     STD   UDLO
                      (    forth6809.asm):03310         

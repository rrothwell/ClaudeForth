                      (    forth6809.asm):06061         ; ============================================================
                      (    forth6809.asm):06062         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06063         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06064         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06065         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06066         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06067         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06068         ; ============================================================
                      (    forth6809.asm):06069         ; ------------------------------------------------------------
                      (    forth6809.asm):06070         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06071         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06072         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06073         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06074         ; - no indirection, no value cell.
                      (    forth6809.asm):06075         ;
                      (    forth6809.asm):06076         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06077         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06078         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06079         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06080         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06081         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06082         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06083         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06084         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06085         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06086         ; ------------------------------------------------------------
FEF7 CCFFFF           (    forth6809.asm):06087         TRUEBODY:  LDD   #$FFFF
FEFA 3606             (    forth6809.asm):06088                    PSHU  D
FEFC 39               (    forth6809.asm):06089                    RTS
                      (    forth6809.asm):06090         
FEFD CC0000           (    forth6809.asm):06091         FALSEBODY: LDD   #$0000
FF00 3606             (    forth6809.asm):06092                    PSHU  D
FF02 39               (    forth6809.asm):06093                    RTS
                      (    forth6809.asm):06094         
                      (    forth6809.asm):06095         ; ------------------------------------------------------------
                      (    forth6809.asm):06096         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):06097         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):06098         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):06099         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):06100         ; ------------------------------------------------------------
FF03 CC0001           (    forth6809.asm):06101         ONEBODY:   LDD   #1
FF06 3606             (    forth6809.asm):06102                    PSHU  D
FF08 39               (    forth6809.asm):06103                    RTS
                      (    forth6809.asm):06104         
FF09 CCFFFF           (    forth6809.asm):06105         MONEBODY:  LDD   #-1
FF0C 3606             (    forth6809.asm):06106                    PSHU  D
FF0E 39               (    forth6809.asm):06107                    RTS
                      (    forth6809.asm):06108         
FF0F CC0002           (    forth6809.asm):06109         TWOBODY:   LDD   #2
FF12 3606             (    forth6809.asm):06110                    PSHU  D
FF14 39               (    forth6809.asm):06111                    RTS
                      (    forth6809.asm):06112         
FF15 CCFFFE           (    forth6809.asm):06113         MTWOBODY:  LDD   #-2
FF18 3606             (    forth6809.asm):06114                    PSHU  D
FF1A 39               (    forth6809.asm):06115                    RTS
                      (    forth6809.asm):06116         
                      (    forth6809.asm):06117         ; Verify no collision with init code,
                      (    forth6809.asm):06118         ; value should match ORG INITCODE.
     FF1B             (    forth6809.asm):06119         BASECODEEND  EQU   *
     1EF1             (    forth6809.asm):06120         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):06121         
                      (    forth6809.asm):06122         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):06123         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):06124         ; .bin file.
FF1B                  (    forth6809.asm):06125         BASEND:
FF1B FFFFFFFFFFFFFFFF (    forth6809.asm):06126                  FILL $FF,INITCODE-BASEND

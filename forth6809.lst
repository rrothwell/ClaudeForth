                      (    forth6809.asm):06418         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06419         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):06420         ; ------------------------------------------------------------
F385 ECC4             (    forth6809.asm):06421         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F387 2713             (    forth6809.asm):06422                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F389 AE44             (    forth6809.asm):06423                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F38B 308B             (    forth6809.asm):06424                     LEAX  D,X               ; end address = c-addr1 + u
F38D AFC4             (    forth6809.asm):06425                     STX   ,U                ; keep it in u's old slot as the loop limit
F38F AE44             (    forth6809.asm):06426                     LDX   4,U               ; X = source
F391 10AE42           (    forth6809.asm):06427                     LDY   2,U               ; Y = destination
F394 A680             (    forth6809.asm):06428         CMVLOOP:    LDA   ,X+
F396 A7A0             (    forth6809.asm):06429                     STA   ,Y+
F398 ACC4             (    forth6809.asm):06430                     CMPX  ,U                ; reached the end address?
F39A 26F8             (    forth6809.asm):06431                     BNE   CMVLOOP
F39C 3346             (    forth6809.asm):06432         CMDONE:     LEAU  6,U               ; drop the three parameters
F39E 39               (    forth6809.asm):06433                     RTS
                      (    forth6809.asm):06434         
                      (    forth6809.asm):06435         ; ------------------------------------------------------------
                      (    forth6809.asm):06436         ; CMOVE>  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06437         ; Copy u bytes from c-addr1 to c-addr2, starting at the high
                      (    forth6809.asm):06438         ; addresses.
                      (    forth6809.asm):06439         ; ------------------------------------------------------------
F39F ECC4             (    forth6809.asm):06440         CMOVEGTW:   LDD   ,U                ; u. Parameters stay on the data stack:
F3A1 2711             (    forth6809.asm):06441                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
F3A3 AE44             (    forth6809.asm):06442                     LDX   4,U
F3A5 308B             (    forth6809.asm):06443                     LEAX  D,X               ; X = one past the end of the source
F3A7 10AE42           (    forth6809.asm):06444                     LDY   2,U
F3AA 31AB             (    forth6809.asm):06445                     LEAY  D,Y               ; Y = one past the end of the destination
F3AC A682             (    forth6809.asm):06446         CGLOOP:     LDA   ,-X
F3AE A7A2             (    forth6809.asm):06447                     STA   ,-Y
F3B0 AC44             (    forth6809.asm):06448                     CMPX  4,U               ; back at the start of the source?
F3B2 26F8             (    forth6809.asm):06449                     BNE   CGLOOP
F3B4 3346             (    forth6809.asm):06450         CGDONE:     LEAU  6,U               ; drop the three parameters
F3B6 39               (    forth6809.asm):06451                     RTS
                      (    forth6809.asm):06452         
                      (    forth6809.asm):06453         ; ------------------------------------------------------------
                      (    forth6809.asm):06454         ; MOVE  ( addr1 addr2 u -- )
                      (    forth6809.asm):06455         ; Copy u bytes from addr1 to addr2, choosing CMOVE or CMOVE> so that
                      (    forth6809.asm):06456         ; overlapping regions are handled correctly.
                      (    forth6809.asm):06457         ; ------------------------------------------------------------
F3B7 EC42             (    forth6809.asm):06458         MOVEW:      LDD   2,U               ; addr2
F3B9 10A344           (    forth6809.asm):06459                     CMPD  4,U               ; addr1
F3BC 22E1             (    forth6809.asm):06460                     BHI   CMOVEGTW          ; addr2 above addr1: copy from the top
F3BE 7EF385           (    forth6809.asm):06461                     JMP   CMOVEW
                      (    forth6809.asm):06462         
                      (    forth6809.asm):06463         ; ------------------------------------------------------------
                      (    forth6809.asm):06464         ; FILL  ( c-addr u char -- )

                      (    forth6809.asm):01924         
     DE07             (    forth6809.asm):01925         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01926                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01927                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01928                                   ; were chained on after it; before that,
                      (    forth6809.asm):01929                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01930                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01931                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01932                                   ; before this one.
                      (    forth6809.asm):01933         
                      (    forth6809.asm):01934         ; Verify no collision with base code.
                      (    forth6809.asm):01935         ; Value should match ORG BASECODE
     DE0E             (    forth6809.asm):01936         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01937         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01938         
                      (    forth6809.asm):01939         ; ============================================================
                      (    forth6809.asm):01940         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01941         ; ============================================================
                      (    forth6809.asm):01942                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01943                                        ; entirely - every routine from here through
                      (    forth6809.asm):01944                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01945                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01946                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01947                                        ; WARM message left the location counter,
                      (    forth6809.asm):01948                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01949                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01950                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01951         
                      (    forth6809.asm):01952         ; ------------------------------------------------------------
                      (    forth6809.asm):01953         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01954         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01955         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01956         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01957         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01958         ; ------------------------------------------------------------
                      (    forth6809.asm):01959         ; ------------------------------------------------------------
                      (    forth6809.asm):01960         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):01961         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):01962         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):01963         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):01964         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):01965         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):01966         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):01967         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):01968         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):01969         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):01970         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):01971         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):01972         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):01973         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):01974         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):01975         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):01976         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):01977         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):01978         ; not duplicated logic in either place.
                      (    forth6809.asm):01979         ; ------------------------------------------------------------
DE0E 8E0106           (    forth6809.asm):01980         SERBUFCLR: LDX  #SERBUF
DE11 6F80             (    forth6809.asm):01981                    CLR  ,X+
DE13 6F80             (    forth6809.asm):01982                    CLR  ,X+
DE15 6F80             (    forth6809.asm):01983                    CLR  ,X+
DE17 6F84             (    forth6809.asm):01984                    CLR  ,X
DE19 0FFF             (    forth6809.asm):01985                    CLR  RTSSTATE
DE1B 7F01DA           (    forth6809.asm):01986                    CLR  FECOUNT
DE1E 7F01DB           (    forth6809.asm):01987                    CLR  OVRNCOUNT
DE21 7F01DC           (    forth6809.asm):01988                    CLR  PECOUNT
DE24 39               (    forth6809.asm):01989                    RTS
                      (    forth6809.asm):01990         
DE25 BDDE0E           (    forth6809.asm):01991         INITSERIAL: JSR  SERBUFCLR
DE28 8603             (    forth6809.asm):01992                  LDA   #$03
DE2A B7C008           (    forth6809.asm):01993                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01994                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01995                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01996                  IFEQ SERIALPOLL  ; >>>>>>>>>>
DE2D 8695             (    forth6809.asm):01997                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01998                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):01999                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02000                  ENDC  ; <<<<<<<<<<
DE2F B7C008           (    forth6809.asm):02001                  STA   ACIACR         ; was "STA ACIA" - same fix
DE32 39               (    forth6809.asm):02002                  RTS
                      (    forth6809.asm):02003         
                      (    forth6809.asm):02004                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02005         ; ------------------------------------------------------------
                      (    forth6809.asm):02006         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):02007         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):02008         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):02009         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):02010         ; ------------------------------------------------------------
DE33 B60106           (    forth6809.asm):02011         INFILL:  LDA   INHEAD
DE36 B00107           (    forth6809.asm):02012                  SUBA  INTAIL
DE39 843F             (    forth6809.asm):02013                  ANDA  #INBUFSZ-1
DE3B 39               (    forth6809.asm):02014                  RTS
                      (    forth6809.asm):02015         
                      (    forth6809.asm):02016         ; ------------------------------------------------------------
                      (    forth6809.asm):02017         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):02018         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):02019         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):02020         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):02021         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):02022         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):02023         ; flow control, not a chip feature.
                      (    forth6809.asm):02024         ; ------------------------------------------------------------
DE3C BDDE33           (    forth6809.asm):02025         RTSCHECKHI: JSR  INFILL
DE3F 8130             (    forth6809.asm):02026                     CMPA #INHIWATER
DE41 250D             (    forth6809.asm):02027                     BLO  RTSCHIDONE
DE43 0DFF             (    forth6809.asm):02028                     TST  RTSSTATE
DE45 2609             (    forth6809.asm):02029                     BNE  RTSCHIDONE       ; already high - nothing to do
DE47 86D5             (    forth6809.asm):02030                     LDA  #CR_RTSHI
DE49 B7C008           (    forth6809.asm):02031                     STA  ACIACR
DE4C 8601             (    forth6809.asm):02032                     LDA  #1
DE4E 97FF             (    forth6809.asm):02033                     STA  RTSSTATE
DE50 39               (    forth6809.asm):02034         RTSCHIDONE: RTS
                      (    forth6809.asm):02035         
                      (    forth6809.asm):02036         ; ------------------------------------------------------------
                      (    forth6809.asm):02037         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):02038         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):02039         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):02040         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):02041         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):02042         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):02043         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):02044         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):02045         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02046         ; ------------------------------------------------------------
DE51 BDDE33           (    forth6809.asm):02047         RTSCHECKLO: JSR  INFILL
DE54 8110             (    forth6809.asm):02048                     CMPA #INLOWATER
DE56 221E             (    forth6809.asm):02049                     BHI  RTSCLODONE
DE58 0DFF             (    forth6809.asm):02050                     TST  RTSSTATE
DE5A 271A             (    forth6809.asm):02051                     BEQ  RTSCLODONE       ; already low - nothing to do
DE5C 1A10             (    forth6809.asm):02052                     ORCC #$10              ; mask IRQ for the critical section
DE5E 0FFF             (    forth6809.asm):02053                     CLR  RTSSTATE
DE60 F60109           (    forth6809.asm):02054                     LDB  OUTTAIL
DE63 F10108           (    forth6809.asm):02055                     CMPB OUTHEAD
DE66 2707             (    forth6809.asm):02056                     BEQ  RTSCLONOTX
DE68 86B5             (    forth6809.asm):02057                     LDA  #CR_RXTX
DE6A B7C008           (    forth6809.asm):02058                     STA  ACIACR
DE6D 2005             (    forth6809.asm):02059                     BRA  RTSCLOUNMASK
DE6F 8695             (    forth6809.asm):02060         RTSCLONOTX: LDA  #CR_RXON
DE71 B7C008           (    forth6809.asm):02061                     STA  ACIACR

                      (    forth6809.asm):05044         ; DO  ( C: -- dest )
                      (    forth6809.asm):05045         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):05046         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):05047         ; ------------------------------------------------------------
DBAF CCDBC1           (    forth6809.asm):05048         DOW:        LDD   #DOSETUP
DBB2 3606             (    forth6809.asm):05049                     PSHU  D
DBB4 BDDE2C           (    forth6809.asm):05050                     JSR   CCALL
DBB7 DC08             (    forth6809.asm):05051                     LDD   CODEHERE
DBB9 3606             (    forth6809.asm):05052                     PSHU  D                 ; dest
DBBB CC0003           (    forth6809.asm):05053                     LDD   #TAGDO
DBBE 3606             (    forth6809.asm):05054                     PSHU  D
DBC0 39               (    forth6809.asm):05055                     RTS
                      (    forth6809.asm):05056         
                      (    forth6809.asm):05057         ; ------------------------------------------------------------
                      (    forth6809.asm):05058         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):05059         ; return address.
                      (    forth6809.asm):05060         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):05061         ;    Inputs:
                      (    forth6809.asm):05062         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05063         ;    Outputs:
                      (    forth6809.asm):05064         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):05065         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05066         ; ------------------------------------------------------------
DBC1 3706             (    forth6809.asm):05067         DOSETUP:    PULU  D                 ; index
DBC3 DD14             (    forth6809.asm):05068                     STD   MSCR
DBC5 3706             (    forth6809.asm):05069                     PULU  D                 ; limit
DBC7 DD16             (    forth6809.asm):05070                     STD   MSCR2
DBC9 3510             (    forth6809.asm):05071                     PULS  X
DBCB CC0000           (    forth6809.asm):05072                     LDD   #0
DBCE 3406             (    forth6809.asm):05073                     PSHS  D
DBD0 DC16             (    forth6809.asm):05074                     LDD   MSCR2
DBD2 3406             (    forth6809.asm):05075                     PSHS  D
DBD4 DC14             (    forth6809.asm):05076                     LDD   MSCR
DBD6 3406             (    forth6809.asm):05077                     PSHS  D
DBD8 3410             (    forth6809.asm):05078                     PSHS  X
DBDA 39               (    forth6809.asm):05079                     RTS
                      (    forth6809.asm):05080         
                      (    forth6809.asm):05081         ; ------------------------------------------------------------
                      (    forth6809.asm):05082         ; I  ( -- n )
                      (    forth6809.asm):05083         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):05084         ; address).
                      (    forth6809.asm):05085         ; ------------------------------------------------------------
DBDB EC62             (    forth6809.asm):05086         IW:         LDD   2,S               ; n. See bugfix: IW.1
DBDD 3606             (    forth6809.asm):05087                     PSHU  D
DBDF 39               (    forth6809.asm):05088                     RTS
                      (    forth6809.asm):05089         
                      (    forth6809.asm):05090         ; ------------------------------------------------------------
                      (    forth6809.asm):05091         ; J  ( -- n )
                      (    forth6809.asm):05092         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05093         ; address and the inner loop frame).
                      (    forth6809.asm):05094         ; ------------------------------------------------------------
DBE0 EC68             (    forth6809.asm):05095         JW:         LDD   8,S               ; n. See bugfix: JW.1
DBE2 3606             (    forth6809.asm):05096                     PSHU  D
DBE4 39               (    forth6809.asm):05097                     RTS
                      (    forth6809.asm):05098         
                      (    forth6809.asm):05099         ; ------------------------------------------------------------
                      (    forth6809.asm):05100         ; LEAVE  ( -- )
                      (    forth6809.asm):05101         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05102         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05103         ; ------------------------------------------------------------
DBE5 CCFFFF           (    forth6809.asm):05104         LEAVEW:     LDD   #TRUEV            ; true
DBE8 ED66             (    forth6809.asm):05105                     STD   6,S               ; See bugfix: LEAVEW.1
DBEA 39               (    forth6809.asm):05106                     RTS
                      (    forth6809.asm):05107         
                      (    forth6809.asm):05108         ; ------------------------------------------------------------
                      (    forth6809.asm):05109         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05110         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05111         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05112         ; ------------------------------------------------------------
DBEB 3706             (    forth6809.asm):05113         LOOPW:      PULU  D
DBED 10830003         (    forth6809.asm):05114                     CMPD  #TAGDO
DBF1 2703             (    forth6809.asm):05115                     BEQ   LOOPOK
DBF3 BDD9BC           (    forth6809.asm):05116                     JSR   CFERR
DBF6 3706             (    forth6809.asm):05117         LOOPOK:     PULU  D                 ; dest
DBF8 3606             (    forth6809.asm):05118                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DBFA CCDC2A           (    forth6809.asm):05119                     LDD   #DOTEST
DBFD 3606             (    forth6809.asm):05120                     PSHU  D
DBFF BDDE2C           (    forth6809.asm):05121                     JSR   CCALL
DC02 CC0000           (    forth6809.asm):05122                     LDD   #0
DC05 3606             (    forth6809.asm):05123                     PSHU  D
DC07 BDD0EA           (    forth6809.asm):05124                     JSR   CODECOMMA
DC0A DC08             (    forth6809.asm):05125                     LDD   CODEHERE
DC0C 830002           (    forth6809.asm):05126                     SUBD  #2
DC0F 3606             (    forth6809.asm):05127                     PSHU  D                 ; location; the parked dest is beneath
DC11 BDDA26           (    forth6809.asm):05128                     JSR   PATCH
                      (    forth6809.asm):05129         
DC14 ECC4             (    forth6809.asm):05130                     LDD   ,U
DC16 10830007         (    forth6809.asm):05131                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DC1A 260D             (    forth6809.asm):05132                     BNE   LOOPDONE
DC1C 3706             (    forth6809.asm):05133                     PULU  D
DC1E 3710             (    forth6809.asm):05134                     PULU  X                 ; ?DO skip operand
DC20 DC08             (    forth6809.asm):05135                     LDD   CODEHERE
DC22 3606             (    forth6809.asm):05136                     PSHU  D
DC24 3610             (    forth6809.asm):05137                     PSHU  X
DC26 BDDA26           (    forth6809.asm):05138                     JSR   PATCH
DC29 39               (    forth6809.asm):05139         LOOPDONE:   RTS
                      (    forth6809.asm):05140         
                      (    forth6809.asm):05141         ; ------------------------------------------------------------
                      (    forth6809.asm):05142         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05143         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05144         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05145         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05146         ; DOTEST
                      (    forth6809.asm):05147         ;    Inputs:
                      (    forth6809.asm):05148         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05149         ;        first)
                      (    forth6809.asm):05150         ;    Outputs:
                      (    forth6809.asm):05151         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05152         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05153         ; ------------------------------------------------------------
DC2A EC66             (    forth6809.asm):05154         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DC2C 2615             (    forth6809.asm):05155                     BNE   DTEXIT            ; set: exit
DC2E EC62             (    forth6809.asm):05156                     LDD   2,S               ; index
DC30 C30001           (    forth6809.asm):05157                     ADDD  #1
DC33 ED62             (    forth6809.asm):05158                     STD   2,S
DC35 10A364           (    forth6809.asm):05159                     CMPD  4,S               ; limit
DC38 2709             (    forth6809.asm):05160                     BEQ   DTEXIT
DC3A 3510             (    forth6809.asm):05161                     PULS  X                 ; X = branch operand address
DC3C EC84             (    forth6809.asm):05162                     LDD   ,X
DC3E 308B             (    forth6809.asm):05163                     LEAX  D,X
DC40 3410             (    forth6809.asm):05164                     PSHS  X                 ; return to loop start
DC42 39               (    forth6809.asm):05165                     RTS
DC43 3510             (    forth6809.asm):05166         DTEXIT:     PULS  X
DC45 3002             (    forth6809.asm):05167                     LEAX  2,X               ; skip the branch operand
DC47 3266             (    forth6809.asm):05168                     LEAS  6,S               ; discard the loop frame
DC49 3410             (    forth6809.asm):05169                     PSHS  X
DC4B 39               (    forth6809.asm):05170                     RTS
                      (    forth6809.asm):05171         
                      (    forth6809.asm):05172         ; ------------------------------------------------------------
                      (    forth6809.asm):05173         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05174         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05175         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05176         ; ------------------------------------------------------------
DC4C 3706             (    forth6809.asm):05177         PLUSLOOPW:  PULU  D
DC4E 10830003         (    forth6809.asm):05178                     CMPD  #TAGDO
DC52 2703             (    forth6809.asm):05179                     BEQ   PLOOPOK
DC54 BDD9BC           (    forth6809.asm):05180                     JSR   CFERR
DC57 3706             (    forth6809.asm):05181         PLOOPOK:    PULU  D                 ; dest
DC59 3606             (    forth6809.asm):05182                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DC5B CCDC8B           (    forth6809.asm):05183                     LDD   #DOPLUSTEST
DC5E 3606             (    forth6809.asm):05184                     PSHU  D
DC60 BDDE2C           (    forth6809.asm):05185                     JSR   CCALL
DC63 CC0000           (    forth6809.asm):05186                     LDD   #0
DC66 3606             (    forth6809.asm):05187                     PSHU  D
DC68 BDD0EA           (    forth6809.asm):05188                     JSR   CODECOMMA
DC6B DC08             (    forth6809.asm):05189                     LDD   CODEHERE
DC6D 830002           (    forth6809.asm):05190                     SUBD  #2
DC70 3606             (    forth6809.asm):05191                     PSHU  D                 ; location; the parked dest is beneath
DC72 BDDA26           (    forth6809.asm):05192                     JSR   PATCH
                      (    forth6809.asm):05193         
DC75 ECC4             (    forth6809.asm):05194                     LDD   ,U
DC77 10830007         (    forth6809.asm):05195                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DC7B 260D             (    forth6809.asm):05196                     BNE   PLOOPDONE
DC7D 3706             (    forth6809.asm):05197                     PULU  D
DC7F 3710             (    forth6809.asm):05198                     PULU  X                 ; ?DO skip operand
DC81 DC08             (    forth6809.asm):05199                     LDD   CODEHERE
DC83 3606             (    forth6809.asm):05200                     PSHU  D
DC85 3610             (    forth6809.asm):05201                     PSHU  X
DC87 BDDA26           (    forth6809.asm):05202                     JSR   PATCH
DC8A 39               (    forth6809.asm):05203         PLOOPDONE:  RTS
                      (    forth6809.asm):05204         
                      (    forth6809.asm):05205         ; ------------------------------------------------------------
                      (    forth6809.asm):05206         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05207         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05208         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05209         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05210         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05211         ;    Inputs:
                      (    forth6809.asm):05212         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05213         ;    Outputs:
                      (    forth6809.asm):05214         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05215         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05216         ;        scratch.
                      (    forth6809.asm):05217         ; ------------------------------------------------------------
DC8B 3706             (    forth6809.asm):05218         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DC8D DD14             (    forth6809.asm):05219                     STD   MSCR              ; MSCR = step
DC8F EC66             (    forth6809.asm):05220                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DC91 262D             (    forth6809.asm):05221                     BNE   DPTEXIT           ; set: exit
DC93 EC62             (    forth6809.asm):05222                     LDD   2,S               ; old index
DC95 A364             (    forth6809.asm):05223                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DC97 DD16             (    forth6809.asm):05224                     STD   MSCR2
DC99 EC62             (    forth6809.asm):05225                     LDD   2,S
DC9B D314             (    forth6809.asm):05226                     ADDD  MSCR              ; new_index = old_index + step
DC9D ED62             (    forth6809.asm):05227                     STD   2,S
DC9F A364             (    forth6809.asm):05228                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DCA1 DD18             (    forth6809.asm):05229                     STD   MSCR3
                      (    forth6809.asm):05230                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05231                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05232                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DCA3 DC14             (    forth6809.asm):05233                     LDD   MSCR              ; reload the step to test its sign
DCA5 2B09             (    forth6809.asm):05234                     BMI   DPNEG
DCA7 DC18             (    forth6809.asm):05235         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DCA9 109316           (    forth6809.asm):05236                     CMPD  MSCR2
DCAC 2512             (    forth6809.asm):05237                     BLO   DPTEXIT
DCAE 2007             (    forth6809.asm):05238                     BRA   DPCONT
DCB0 DC18             (    forth6809.asm):05239         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DCB2 109316           (    forth6809.asm):05240                     CMPD  MSCR2
DCB5 2209             (    forth6809.asm):05241                     BHI   DPTEXIT
DCB7 3510             (    forth6809.asm):05242         DPCONT:     PULS  X                 ; X = branch operand address
DCB9 EC84             (    forth6809.asm):05243                     LDD   ,X
DCBB 308B             (    forth6809.asm):05244                     LEAX  D,X
DCBD 3410             (    forth6809.asm):05245                     PSHS  X
DCBF 39               (    forth6809.asm):05246                     RTS
DCC0 3510             (    forth6809.asm):05247         DPTEXIT:    PULS  X
DCC2 3002             (    forth6809.asm):05248                     LEAX  2,X               ; skip the branch operand
DCC4 3266             (    forth6809.asm):05249                     LEAS  6,S               ; discard the loop frame
DCC6 3410             (    forth6809.asm):05250                     PSHS  X
DCC8 39               (    forth6809.asm):05251                     RTS

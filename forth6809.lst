E55E CC0008           (    forth6809.asm):03987                  LDD   #8
E561 3606             (    forth6809.asm):03988                  PSHU  D
E563 BDE4ED           (    forth6809.asm):03989                  JSR   EMIT
E566 20A6             (    forth6809.asm):03990                  BRA   ALOOP
                      (    forth6809.asm):03991         

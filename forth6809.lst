                      (    forth6809.asm):01937         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01938         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01939         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01940         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01941         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01942         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01943         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01944         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01945         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01946         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01947         ; were chained on after H_QUIT in a later turn.
DCF8 05               (    forth6809.asm):01948         H_ABORT: FCB   5
DCF9 41424F5254       (    forth6809.asm):01949                  FCC   "ABORT"
DCFE DCEE             (    forth6809.asm):01950                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01951                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01952                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01953                                        ; now H_FALSE, the chain's newest entry
DD00 DF18             (    forth6809.asm):01954                  FDB   ABORT
                      (    forth6809.asm):01955         
DD02 04               (    forth6809.asm):01956         H_QUIT:  FCB   4
DD03 51554954         (    forth6809.asm):01957                  FCC   "QUIT"
DD07 DCF8             (    forth6809.asm):01958                  FDB   H_ABORT
DD09 DF1B             (    forth6809.asm):01959                  FDB   QUIT
                      (    forth6809.asm):01960         
                      (    forth6809.asm):01961         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):01962         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):01963         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):01964         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):01965         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):01966         ; reconstructs and pushes the original c-addr, then 0.
DD0B 04               (    forth6809.asm):01967         H_FIND:  FCB   4
DD0C 46494E44         (    forth6809.asm):01968                  FCC   "FIND"
DD10 DD02             (    forth6809.asm):01969                  FDB   H_QUIT
DD12 E457             (    forth6809.asm):01970                  FDB   FIND
                      (    forth6809.asm):01971         

                      (    forth6809.asm):09809                   STD  CODEHERE
                      (    forth6809.asm):09810                   LDD  #0
                      (    forth6809.asm):09811                   STD  LATEST
                      (    forth6809.asm):09812                   LDD  #TSTNAMEB
                      (    forth6809.asm):09813                   STD  SRCADDR
                      (    forth6809.asm):09814                   LDD  #3
                      (    forth6809.asm):09815                   STD  SRCLEN
                      (    forth6809.asm):09816                   LDD  #0
                      (    forth6809.asm):09817                   STD  TOIN
                      (    forth6809.asm):09818         
                      (    forth6809.asm):09819                   STU  TSTU0
                      (    forth6809.asm):09820         
                      (    forth6809.asm):09821                   LDX  #TICK
                      (    forth6809.asm):09822                   PSHU X
                      (    forth6809.asm):09823                   STU  TSTUB4
                      (    forth6809.asm):09824         
                      (    forth6809.asm):09825                   JSR  CATCH
                      (    forth6809.asm):09826         
                      (    forth6809.asm):09827                   STU  TSTUAF
                      (    forth6809.asm):09828         
                      (    forth6809.asm):09829                   LDD  TSTCSAV
                      (    forth6809.asm):09830                   STD  CODEHERE
                      (    forth6809.asm):09831                   LDD  TSTLSAV
                      (    forth6809.asm):09832                   STD  LATEST
                      (    forth6809.asm):09833                   LDD  TSTSASAV
                      (    forth6809.asm):09834                   STD  SRCADDR
                      (    forth6809.asm):09835                   LDD  TSTSLSAV
                      (    forth6809.asm):09836                   STD  SRCLEN
                      (    forth6809.asm):09837                   LDD  TSTTISAV
                      (    forth6809.asm):09838                   STD  TOIN
                      (    forth6809.asm):09839         
                      (    forth6809.asm):09840                   PULU D
                      (    forth6809.asm):09841                   CMPD #-13
                      (    forth6809.asm):09842                   BNE  TK2FAIL
                      (    forth6809.asm):09843         
                      (    forth6809.asm):09844                   LDD  TSTUB4
                      (    forth6809.asm):09845                   SUBD TSTUAF
                      (    forth6809.asm):09846                   CMPD #0
                      (    forth6809.asm):09847                   BNE  TK2FAIL
                      (    forth6809.asm):09848         

                      (   unit_tests.asm):15336         ; TSTEVALUATE - unit test for EVALUATE. Evaluates the string
                      (   unit_tests.asm):15337         ; "1 2 +" (confirmed safe via INTERPRET's own code: it simply
                      (   unit_tests.asm):15338         ; stops and returns when input is exhausted, no automatic
                      (   unit_tests.asm):15339         ; REFILL, so no blocking risk) - verifies the result (3) lands
                      (   unit_tests.asm):15340         ; on the data stack, and that the whole input-source state
                      (   unit_tests.asm):15341         ; (SRCADDR/SRCLEN/SRCID/TOIN) is genuinely restored to what it
                      (   unit_tests.asm):15342         ; was before the call, not left pointing at the evaluated
                      (   unit_tests.asm):15343         ; string. BASE is explicitly saved/set/restored too, per section
                      (   unit_tests.asm):15344         ; 3.13's own established lesson, so "1"/"2" parse as decimal
                      (   unit_tests.asm):15345         ; regardless of what BASE happened to hold at test time.
                      (   unit_tests.asm):15346         ; ------------------------------------------------------------
C33E                  (   unit_tests.asm):15347         TSTEVALUATE: LDD  SRCADDR
                      (   unit_tests.asm):15348                      STD  TSTSASAV
                      (   unit_tests.asm):15349                      LDD  SRCLEN
                      (   unit_tests.asm):15350                      STD  TSTSLSAV
                      (   unit_tests.asm):15351                      LDD  SRCID
                      (   unit_tests.asm):15352                      STD  TSTSISAV
                      (   unit_tests.asm):15353                      LDD  TOIN
                      (   unit_tests.asm):15354                      STD  TSTTISAV
                      (   unit_tests.asm):15355                      LDD  BASE
                      (   unit_tests.asm):15356                      STD  TSTBASAV
                      (   unit_tests.asm):15357                      LDD  LATEST
                      (   unit_tests.asm):15358                      STD  TSTLSAV
                      (   unit_tests.asm):15359                      LDD  CODEHERE
                      (   unit_tests.asm):15360                      STD  TSTCSAV
                      (   unit_tests.asm):15361         
                      (   unit_tests.asm):15362                      LDD  #10
                      (   unit_tests.asm):15363                      STD  BASE
                      (   unit_tests.asm):15364                      LDD  #BASELATEST  ; BUG FIX: confirmed via MAME - LATEST,
                      (   unit_tests.asm):15365                      STD  LATEST       ; like BASE, is only set by COLD (right
                      (   unit_tests.asm):15366                                         ; alongside "BASE=10", in the very same
                      (   unit_tests.asm):15367                                         ; init block), which hasn't run yet at
                      (   unit_tests.asm):15368                                         ; this whole test framework's own,
                      (   unit_tests.asm):15369                                         ; pre-COLD execution point. With
                      (   unit_tests.asm):15370                                         ; LATEST=0, FIND reports every word,
                      (   unit_tests.asm):15371                                         ; including the real "+" this test
                      (   unit_tests.asm):15372                                         ; evaluates, as not found - INTERPRET
                      (   unit_tests.asm):15373                                         ; then falls through trying to parse
                      (   unit_tests.asm):15374                                         ; "+" as a number, fails that too, and
                      (   unit_tests.asm):15375                                         ; throws an error this test never
                      (   unit_tests.asm):15376                                         ; catches, landing at THUNCAU's own
                      (   unit_tests.asm):15377                                         ; JMP ABORT - which resets the return
                      (   unit_tests.asm):15378                                         ; stack, explaining exactly why the
                      (   unit_tests.asm):15379                                         ; user's own test run terminated
                      (   unit_tests.asm):15380                                         ; without ever reaching TSTENVQUERY1/2/
                      (   unit_tests.asm):15381                                         ; 3. The same class of gap as section
                      (   unit_tests.asm):15382                                         ; 3.13's own BASE=0 finding, just for a
                      (   unit_tests.asm):15383                                         ; different variable this section's
                      (   unit_tests.asm):15384                                         ; own EVALUATE test was the first to
                      (   unit_tests.asm):15385                                         ; genuinely depend on.
                      (   unit_tests.asm):15386         
                      (   unit_tests.asm):15387                      LDD  #TSTCBUF2  ; SECOND BUG FIX: the LATEST fix above
                      (   unit_tests.asm):15388                      STD  CODEHERE   ; alone didn't resolve this - confirmed
                      (   unit_tests.asm):15389                                         ; via a second MAME run (the failure
                      (   unit_tests.asm):15390                                         ; persisted, with the terminal output
                      (   unit_tests.asm):15391                                         ; varying between runs, a strong sign
                      (   unit_tests.asm):15392                                         ; of memory corruption rather than a
                      (   unit_tests.asm):15393                                         ; single deterministic missing-value
                      (   unit_tests.asm):15394                                         ; problem). Root cause: CODEHERE, like
                      (   unit_tests.asm):15395                                         ; BASE and LATEST, is only set by COLD
                      (   unit_tests.asm):15396                                         ; and was never redirected by this
                      (   unit_tests.asm):15397                                         ; test at all - unlike every other
                      (   unit_tests.asm):15398                                         ; test in this whole session involving
                      (   unit_tests.asm):15399                                         ; WORD (which EVALUATE's own internal
                      (   unit_tests.asm):15400                                         ; JSR INTERPRET calls repeatedly, once
                      (   unit_tests.asm):15401                                         ; per token). With CODEHERE=0
                      (   unit_tests.asm):15402                                         ; (unredirected), WORD's own write of
                      (   unit_tests.asm):15403                                         ; each parsed token's [len][text]
                      (   unit_tests.asm):15404                                         ; landed straight at address $0000 -
                      (   unit_tests.asm):15405                                         ; which is STATE's own address (offset
                      (   unit_tests.asm):15406                                         ; $00, the very first bytes of
                      (   unit_tests.asm):15407                                         ; GLOBALS, confirmed by re-reading its
                      (   unit_tests.asm):15408                                         ; own RMB declaration directly). Even
                      (   unit_tests.asm):15409                                         ; a single-character token like "1"
                      (   unit_tests.asm):15410                                         ; overwrites STATE with a nonzero
                      (   unit_tests.asm):15411                                         ; value, flipping INTERPRET into
                      (   unit_tests.asm):15412                                         ; thinking it's compiling rather than
                      (   unit_tests.asm):15413                                         ; interpreting mid-parse - explaining
                      (   unit_tests.asm):15414                                         ; both the sequence's own termination
                      (   unit_tests.asm):15415                                         ; and why the visible output varied
                      (   unit_tests.asm):15416                                         ; between runs (the exact corruption
                      (   unit_tests.asm):15417                                         ; pattern depends on residual memory
                      (   unit_tests.asm):15418                                         ; state from whatever ran immediately
                      (   unit_tests.asm):15419                                         ; before). Redirected to TSTCBUF2, not
                      (   unit_tests.asm):15420                                         ; TSTCBUF, specifically because TSTCBUF
                      (   unit_tests.asm):15421                                         ; already holds this test's own source
                      (   unit_tests.asm):15422                                         ; string ("1 2 +") - redirecting to the
                      (   unit_tests.asm):15423                                         ; same buffer would let WORD overwrite
                      (   unit_tests.asm):15424                                         ; the very source text still being
                      (   unit_tests.asm):15425                                         ; parsed.

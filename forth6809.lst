DE6B 10830000         (    forth6809.asm):05481                     CMPD  #0
DE6F 260A             (    forth6809.asm):05482                     BNE   TICKOK
DE71 3706             (    forth6809.asm):05483                     PULU  D                 ; drop the name
DE73 CCFFF3           (    forth6809.asm):05484                     LDD   #-13              ; -13
DE76 3606             (    forth6809.asm):05485                     PSHU  D

D27F 7D0178           (    forth6809.asm):02083                     TST   RTSSTATE
D282 260A             (    forth6809.asm):02084                     BNE   RTSCHIDONE        ; already high - nothing to do
D284 86D5             (    forth6809.asm):02085                     LDA   #CR_RTSHI
D286 B7C008           (    forth6809.asm):02086                     STA   ACIACR
D289 8601             (    forth6809.asm):02087                     LDA   #1
D28B B70178           (    forth6809.asm):02088                     STA   RTSSTATE

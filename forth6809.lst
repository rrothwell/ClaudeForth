                      (    forth6809.asm):10786                     STA  TSTNAMEB
                      (    forth6809.asm):10787                     LDA  #'I'
                      (    forth6809.asm):10788                     STA  TSTNAMEB+1
                      (    forth6809.asm):10789                     LDA  #34
                      (    forth6809.asm):10790                     STA  TSTNAMEB+2
                      (    forth6809.asm):10791         
                      (    forth6809.asm):10792                     LDD  #TSTCBUF
                      (    forth6809.asm):10793                     STD  CODEHERE
                      (    forth6809.asm):10794                     LDD  #TSTNAMEB
                      (    forth6809.asm):10795                     STD  SRCADDR
                      (    forth6809.asm):10796                     LDD  #3
                      (    forth6809.asm):10797                     STD  SRCLEN
                      (    forth6809.asm):10798                     LDD  #0
                      (    forth6809.asm):10799                     STD  TOIN
                      (    forth6809.asm):10800                     LDD  #-1
                      (    forth6809.asm):10801                     STD  STATE
                      (    forth6809.asm):10802         
                      (    forth6809.asm):10803                     JSR  ABORTQUOTE
                      (    forth6809.asm):10804         
                      (    forth6809.asm):10805                     LDD  #OPRTS
                      (    forth6809.asm):10806                     PSHU D
                      (    forth6809.asm):10807                     JSR  CCOMMA
                      (    forth6809.asm):10808         
                      (    forth6809.asm):10809                     LDD  TSTCSAV
                      (    forth6809.asm):10810                     STD  CODEHERE
                      (    forth6809.asm):10811                     LDD  TSTSASAV
                      (    forth6809.asm):10812                     STD  SRCADDR
                      (    forth6809.asm):10813                     LDD  TSTSLSAV
                      (    forth6809.asm):10814                     STD  SRCLEN
                      (    forth6809.asm):10815                     LDD  TSTTISAV
                      (    forth6809.asm):10816                     STD  TOIN
                      (    forth6809.asm):10817                     LDD  TSTSTSAV
                      (    forth6809.asm):10818                     STD  STATE
                      (    forth6809.asm):10819         
                      (    forth6809.asm):10820                     STU  TSTU0
                      (    forth6809.asm):10821         
                      (    forth6809.asm):10822                     LDD  #TRUEV
                      (    forth6809.asm):10823                     PSHU D
                      (    forth6809.asm):10824                     LDX  #TSTCBUF
                      (    forth6809.asm):10825                     PSHU X
                      (    forth6809.asm):10826                     STU  TSTUB4
                      (    forth6809.asm):10827         

                      (    forth6809.asm):02199                    PSHU  D
                      (    forth6809.asm):02200                    LDD   #$0000
                      (    forth6809.asm):02201                    PSHU  D
                      (    forth6809.asm):02202                    LDX   #SLASHMOD
                      (    forth6809.asm):02203                    PSHU  X
                      (    forth6809.asm):02204                    STU   TSTUB4
                      (    forth6809.asm):02205         

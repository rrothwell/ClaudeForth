                      (    forth6809.asm):05017         ; RECURSE  ( -- )
                      (    forth6809.asm):05018         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):05019         ; the xt held in CURXT.
                      (    forth6809.asm):05020         ; ------------------------------------------------------------
DABB DC1F             (    forth6809.asm):05021         RECURSEW:   LDD   CURXT             ; xt of word being compiled
DABD 3606             (    forth6809.asm):05022                     PSHU  D                 ; See bugfix: RECURSEW.1
DABF BDDD40           (    forth6809.asm):05023                     JSR   CCALL
DAC2 39               (    forth6809.asm):05024                     RTS
                      (    forth6809.asm):05025         
                      (    forth6809.asm):05026         ; ------------------------------------------------------------
                      (    forth6809.asm):05027         ; DO  ( C: -- dest )
                      (    forth6809.asm):05028         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):05029         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):05030         ; ------------------------------------------------------------
DAC3 CCDAD5           (    forth6809.asm):05031         DOW:        LDD   #DOSETUP
DAC6 3606             (    forth6809.asm):05032                     PSHU  D
DAC8 BDDD40           (    forth6809.asm):05033                     JSR   CCALL
DACB DC08             (    forth6809.asm):05034                     LDD   CODEHERE
DACD 3606             (    forth6809.asm):05035                     PSHU  D                 ; dest
DACF CC0003           (    forth6809.asm):05036                     LDD   #TAGDO
DAD2 3606             (    forth6809.asm):05037                     PSHU  D
DAD4 39               (    forth6809.asm):05038                     RTS
                      (    forth6809.asm):05039         
                      (    forth6809.asm):05040         ; ------------------------------------------------------------
                      (    forth6809.asm):05041         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):05042         ; return address.
                      (    forth6809.asm):05043         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):05044         ;    Inputs:
                      (    forth6809.asm):05045         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05046         ;    Outputs:
                      (    forth6809.asm):05047         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):05048         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05049         ; ------------------------------------------------------------
DAD5 3706             (    forth6809.asm):05050         DOSETUP:    PULU  D                 ; index
DAD7 DD14             (    forth6809.asm):05051                     STD   MSCR
DAD9 3706             (    forth6809.asm):05052                     PULU  D                 ; limit
DADB DD16             (    forth6809.asm):05053                     STD   MSCR2
DADD 3510             (    forth6809.asm):05054                     PULS  X
DADF CC0000           (    forth6809.asm):05055                     LDD   #0
DAE2 3406             (    forth6809.asm):05056                     PSHS  D
DAE4 DC16             (    forth6809.asm):05057                     LDD   MSCR2
DAE6 3406             (    forth6809.asm):05058                     PSHS  D
DAE8 DC14             (    forth6809.asm):05059                     LDD   MSCR
DAEA 3406             (    forth6809.asm):05060                     PSHS  D
DAEC 3410             (    forth6809.asm):05061                     PSHS  X
DAEE 39               (    forth6809.asm):05062                     RTS
                      (    forth6809.asm):05063         
                      (    forth6809.asm):05064         ; ------------------------------------------------------------
                      (    forth6809.asm):05065         ; I  ( -- n )
                      (    forth6809.asm):05066         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):05067         ; address).
                      (    forth6809.asm):05068         ; ------------------------------------------------------------
DAEF EC62             (    forth6809.asm):05069         IW:         LDD   2,S               ; n. See bugfix: IW.1
DAF1 3606             (    forth6809.asm):05070                     PSHU  D
DAF3 39               (    forth6809.asm):05071                     RTS
                      (    forth6809.asm):05072         
                      (    forth6809.asm):05073         ; ------------------------------------------------------------
                      (    forth6809.asm):05074         ; J  ( -- n )
                      (    forth6809.asm):05075         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05076         ; address and the inner loop frame).
                      (    forth6809.asm):05077         ; ------------------------------------------------------------
DAF4 EC68             (    forth6809.asm):05078         JW:         LDD   8,S               ; n. See bugfix: JW.1
DAF6 3606             (    forth6809.asm):05079                     PSHU  D
DAF8 39               (    forth6809.asm):05080                     RTS
                      (    forth6809.asm):05081         
                      (    forth6809.asm):05082         ; ------------------------------------------------------------
                      (    forth6809.asm):05083         ; LEAVE  ( -- )
                      (    forth6809.asm):05084         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05085         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05086         ; ------------------------------------------------------------
DAF9 CCFFFF           (    forth6809.asm):05087         LEAVEW:     LDD   #TRUEV            ; true
DAFC ED66             (    forth6809.asm):05088                     STD   6,S               ; See bugfix: LEAVEW.1
DAFE 39               (    forth6809.asm):05089                     RTS
                      (    forth6809.asm):05090         
                      (    forth6809.asm):05091         ; ------------------------------------------------------------
                      (    forth6809.asm):05092         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05093         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05094         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05095         ; ------------------------------------------------------------
DAFF 3706             (    forth6809.asm):05096         LOOPW:      PULU  D
DB01 10830003         (    forth6809.asm):05097                     CMPD  #TAGDO
DB05 2703             (    forth6809.asm):05098                     BEQ   LOOPOK
DB07 BDD8D0           (    forth6809.asm):05099                     JSR   CFERR
DB0A 3706             (    forth6809.asm):05100         LOOPOK:     PULU  D                 ; dest
DB0C 3606             (    forth6809.asm):05101                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DB0E CCDB3E           (    forth6809.asm):05102                     LDD   #DOTEST
DB11 3606             (    forth6809.asm):05103                     PSHU  D
DB13 BDDD40           (    forth6809.asm):05104                     JSR   CCALL
DB16 CC0000           (    forth6809.asm):05105                     LDD   #0
DB19 3606             (    forth6809.asm):05106                     PSHU  D
DB1B BDCFD6           (    forth6809.asm):05107                     JSR   CODECOMMA
DB1E DC08             (    forth6809.asm):05108                     LDD   CODEHERE
DB20 830002           (    forth6809.asm):05109                     SUBD  #2
DB23 3606             (    forth6809.asm):05110                     PSHU  D                 ; location; the parked dest is beneath
DB25 BDD93A           (    forth6809.asm):05111                     JSR   PATCH
                      (    forth6809.asm):05112         
DB28 ECC4             (    forth6809.asm):05113                     LDD   ,U
DB2A 10830007         (    forth6809.asm):05114                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DB2E 260D             (    forth6809.asm):05115                     BNE   LOOPDONE
DB30 3706             (    forth6809.asm):05116                     PULU  D
DB32 3710             (    forth6809.asm):05117                     PULU  X                 ; ?DO skip operand
DB34 DC08             (    forth6809.asm):05118                     LDD   CODEHERE
DB36 3606             (    forth6809.asm):05119                     PSHU  D
DB38 3610             (    forth6809.asm):05120                     PSHU  X
DB3A BDD93A           (    forth6809.asm):05121                     JSR   PATCH
DB3D 39               (    forth6809.asm):05122         LOOPDONE:   RTS
                      (    forth6809.asm):05123         
                      (    forth6809.asm):05124         ; ------------------------------------------------------------
                      (    forth6809.asm):05125         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05126         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05127         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05128         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05129         ; DOTEST
                      (    forth6809.asm):05130         ;    Inputs:
                      (    forth6809.asm):05131         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05132         ;        first)
                      (    forth6809.asm):05133         ;    Outputs:
                      (    forth6809.asm):05134         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05135         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05136         ; ------------------------------------------------------------
DB3E EC66             (    forth6809.asm):05137         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DB40 2615             (    forth6809.asm):05138                     BNE   DTEXIT            ; set: exit
DB42 EC62             (    forth6809.asm):05139                     LDD   2,S               ; index
DB44 C30001           (    forth6809.asm):05140                     ADDD  #1
DB47 ED62             (    forth6809.asm):05141                     STD   2,S
DB49 10A364           (    forth6809.asm):05142                     CMPD  4,S               ; limit
DB4C 2709             (    forth6809.asm):05143                     BEQ   DTEXIT
DB4E 3510             (    forth6809.asm):05144                     PULS  X                 ; X = branch operand address
DB50 EC84             (    forth6809.asm):05145                     LDD   ,X
DB52 308B             (    forth6809.asm):05146                     LEAX  D,X
DB54 3410             (    forth6809.asm):05147                     PSHS  X                 ; return to loop start
DB56 39               (    forth6809.asm):05148                     RTS
DB57 3510             (    forth6809.asm):05149         DTEXIT:     PULS  X
DB59 3002             (    forth6809.asm):05150                     LEAX  2,X               ; skip the branch operand
DB5B 3266             (    forth6809.asm):05151                     LEAS  6,S               ; discard the loop frame
DB5D 3410             (    forth6809.asm):05152                     PSHS  X
DB5F 39               (    forth6809.asm):05153                     RTS
                      (    forth6809.asm):05154         
                      (    forth6809.asm):05155         ; ------------------------------------------------------------
                      (    forth6809.asm):05156         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05157         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05158         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05159         ; ------------------------------------------------------------
DB60 3706             (    forth6809.asm):05160         PLUSLOOPW:  PULU  D
DB62 10830003         (    forth6809.asm):05161                     CMPD  #TAGDO
DB66 2703             (    forth6809.asm):05162                     BEQ   PLOOPOK
DB68 BDD8D0           (    forth6809.asm):05163                     JSR   CFERR
DB6B 3706             (    forth6809.asm):05164         PLOOPOK:    PULU  D                 ; dest
DB6D 3606             (    forth6809.asm):05165                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DB6F CCDB9F           (    forth6809.asm):05166                     LDD   #DOPLUSTEST
DB72 3606             (    forth6809.asm):05167                     PSHU  D
DB74 BDDD40           (    forth6809.asm):05168                     JSR   CCALL
DB77 CC0000           (    forth6809.asm):05169                     LDD   #0
DB7A 3606             (    forth6809.asm):05170                     PSHU  D
DB7C BDCFD6           (    forth6809.asm):05171                     JSR   CODECOMMA
DB7F DC08             (    forth6809.asm):05172                     LDD   CODEHERE
DB81 830002           (    forth6809.asm):05173                     SUBD  #2
DB84 3606             (    forth6809.asm):05174                     PSHU  D                 ; location; the parked dest is beneath
DB86 BDD93A           (    forth6809.asm):05175                     JSR   PATCH
                      (    forth6809.asm):05176         
DB89 ECC4             (    forth6809.asm):05177                     LDD   ,U
DB8B 10830007         (    forth6809.asm):05178                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DB8F 260D             (    forth6809.asm):05179                     BNE   PLOOPDONE
DB91 3706             (    forth6809.asm):05180                     PULU  D
DB93 3710             (    forth6809.asm):05181                     PULU  X                 ; ?DO skip operand
DB95 DC08             (    forth6809.asm):05182                     LDD   CODEHERE
DB97 3606             (    forth6809.asm):05183                     PSHU  D
DB99 3610             (    forth6809.asm):05184                     PSHU  X
DB9B BDD93A           (    forth6809.asm):05185                     JSR   PATCH
DB9E 39               (    forth6809.asm):05186         PLOOPDONE:  RTS
                      (    forth6809.asm):05187         
                      (    forth6809.asm):05188         ; ------------------------------------------------------------
                      (    forth6809.asm):05189         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05190         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05191         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05192         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05193         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05194         ;    Inputs:
                      (    forth6809.asm):05195         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05196         ;    Outputs:
                      (    forth6809.asm):05197         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05198         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05199         ;        scratch.
                      (    forth6809.asm):05200         ; ------------------------------------------------------------
DB9F 3706             (    forth6809.asm):05201         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DBA1 DD14             (    forth6809.asm):05202                     STD   MSCR              ; MSCR = step
DBA3 EC66             (    forth6809.asm):05203                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DBA5 262D             (    forth6809.asm):05204                     BNE   DPTEXIT           ; set: exit
DBA7 EC62             (    forth6809.asm):05205                     LDD   2,S               ; old index
DBA9 A364             (    forth6809.asm):05206                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DBAB DD16             (    forth6809.asm):05207                     STD   MSCR2
DBAD EC62             (    forth6809.asm):05208                     LDD   2,S
DBAF D314             (    forth6809.asm):05209                     ADDD  MSCR              ; new_index = old_index + step
DBB1 ED62             (    forth6809.asm):05210                     STD   2,S
DBB3 A364             (    forth6809.asm):05211                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DBB5 DD18             (    forth6809.asm):05212                     STD   MSCR3
                      (    forth6809.asm):05213                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05214                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05215                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DBB7 DC14             (    forth6809.asm):05216                     LDD   MSCR              ; reload the step to test its sign
DBB9 2B09             (    forth6809.asm):05217                     BMI   DPNEG
DBBB DC18             (    forth6809.asm):05218         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DBBD 109316           (    forth6809.asm):05219                     CMPD  MSCR2
DBC0 2512             (    forth6809.asm):05220                     BLO   DPTEXIT
DBC2 2007             (    forth6809.asm):05221                     BRA   DPCONT
DBC4 DC18             (    forth6809.asm):05222         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DBC6 109316           (    forth6809.asm):05223                     CMPD  MSCR2
DBC9 2209             (    forth6809.asm):05224                     BHI   DPTEXIT
DBCB 3510             (    forth6809.asm):05225         DPCONT:     PULS  X                 ; X = branch operand address
DBCD EC84             (    forth6809.asm):05226                     LDD   ,X
DBCF 308B             (    forth6809.asm):05227                     LEAX  D,X
DBD1 3410             (    forth6809.asm):05228                     PSHS  X
DBD3 39               (    forth6809.asm):05229                     RTS
DBD4 3510             (    forth6809.asm):05230         DPTEXIT:    PULS  X
DBD6 3002             (    forth6809.asm):05231                     LEAX  2,X               ; skip the branch operand
DBD8 3266             (    forth6809.asm):05232                     LEAS  6,S               ; discard the loop frame
DBDA 3410             (    forth6809.asm):05233                     PSHS  X
DBDC 39               (    forth6809.asm):05234                     RTS
                      (    forth6809.asm):05235         
                      (    forth6809.asm):05236         ; ------------------------------------------------------------
                      (    forth6809.asm):05237         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05238         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05239         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05240         ; ------------------------------------------------------------
DBDD CCDC03           (    forth6809.asm):05241         QDOW:       LDD   #QDOSETUP
DBE0 3606             (    forth6809.asm):05242                     PSHU  D
DBE2 BDDD40           (    forth6809.asm):05243                     JSR   CCALL
DBE5 CC0000           (    forth6809.asm):05244                     LDD   #0
DBE8 3606             (    forth6809.asm):05245                     PSHU  D
DBEA BDCFD6           (    forth6809.asm):05246                     JSR   CODECOMMA
DBED DC08             (    forth6809.asm):05247                     LDD   CODEHERE
DBEF 830002           (    forth6809.asm):05248                     SUBD  #2
DBF2 3606             (    forth6809.asm):05249                     PSHU  D                 ; orig
DBF4 CC0007           (    forth6809.asm):05250                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DBF7 3606             (    forth6809.asm):05251                     PSHU  D
DBF9 DC08             (    forth6809.asm):05252                     LDD   CODEHERE
DBFB 3606             (    forth6809.asm):05253                     PSHU  D                 ; dest
DBFD CC0003           (    forth6809.asm):05254                     LDD   #TAGDO
DC00 3606             (    forth6809.asm):05255                     PSHU  D
DC02 39               (    forth6809.asm):05256                     RTS
                      (    forth6809.asm):05257         
                      (    forth6809.asm):05258         ; ------------------------------------------------------------
                      (    forth6809.asm):05259         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05260         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05261         ; branch operand.
                      (    forth6809.asm):05262         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05263         ;    Inputs:
                      (    forth6809.asm):05264         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05265         ;    Outputs:
                      (    forth6809.asm):05266         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05267         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05268         ; ------------------------------------------------------------
DC03 3706             (    forth6809.asm):05269         QDOSETUP:   PULU  D                 ; index
DC05 DD14             (    forth6809.asm):05270                     STD   MSCR
DC07 3706             (    forth6809.asm):05271                     PULU  D                 ; limit
DC09 DD16             (    forth6809.asm):05272                     STD   MSCR2
DC0B 3510             (    forth6809.asm):05273                     PULS  X
DC0D DC16             (    forth6809.asm):05274                     LDD   MSCR2
DC0F 109314           (    forth6809.asm):05275                     CMPD  MSCR

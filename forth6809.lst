                      (    forth6809.asm):02094         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02095         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02096         ; LIT   ( -- x )
                      (    forth6809.asm):02097         ;    Inputs:
                      (    forth6809.asm):02098         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02099         ;    Outputs:
                      (    forth6809.asm):02100         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02101         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02102         ; ------------------------------------------------------------

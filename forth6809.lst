                      (    forth6809.asm):05208         ; MOD  ( n1 n2 -- n3 )
                      (    forth6809.asm):05209         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05210         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05211         ; zero.
                      (    forth6809.asm):05212         ; ------------------------------------------------------------

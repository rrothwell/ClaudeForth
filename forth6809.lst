                      (    forth6809.asm):10766         ; TSTABORTQ2 - unit test for ABORT", true-flag case. Same
                      (    forth6809.asm):10767         ; compiled snippet as TSTABORTQ1, executed via CATCH with a true
                      (    forth6809.asm):10768         ; flag instead. Confirmed by reading DOABORTQUOTE's own code
                      (    forth6809.asm):10769         ; that it uses THROW -2 internally, not the raw, never-returns
                      (    forth6809.asm):10770         ; ABORT mechanism plain ABORT itself uses (which remains
                      (    forth6809.asm):10771         ; deliberately untested, per section 3.1's own reasoning) - so
                      (    forth6809.asm):10772         ; this case is safe to test directly, unlike plain ABORT would
                      (    forth6809.asm):10773         ; be.
                      (    forth6809.asm):10774         ; ------------------------------------------------------------

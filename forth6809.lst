                      (    forth6809.asm):06263         ; ------------------------------------------------------------
F3E1 ECC4             (    forth6809.asm):06264         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F3E3 2713             (    forth6809.asm):06265                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F3E5 AE44             (    forth6809.asm):06266                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F3E7 308B             (    forth6809.asm):06267                     LEAX  D,X               ; end address = c-addr1 + u
F3E9 AFC4             (    forth6809.asm):06268                     STX   ,U                ; keep it in u's old slot as the loop limit
F3EB AE44             (    forth6809.asm):06269                     LDX   4,U               ; X = source

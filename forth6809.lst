FBF8 FC3E0005FFFF     (    forth6809.asm):07832                     FDB   EN3,EN3L,65535    ; MAX-U
FBFE FC4300110008     (    forth6809.asm):07833                     FDB   EN6,EN6L,8        ; ADDRESS-UNIT-BITS

F535 3410             (    forth6809.asm):06967                     PSHS  X
F537 7EF570           (    forth6809.asm):06968                     JMP   TYPEW
                      (    forth6809.asm):06969         
                      (    forth6809.asm):06970         ; ------------------------------------------------------------
                      (    forth6809.asm):06971         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06972         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06973         ; counted string.
                      (    forth6809.asm):06974         ; ------------------------------------------------------------

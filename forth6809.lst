                      (    forth6809.asm):00385         
                      (    forth6809.asm):00386         ; ============================================================
                      (    forth6809.asm):00387         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00388         ;
                      (    forth6809.asm):00389         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00390         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00391         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00392         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00393         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00394         ; hand-built. Headers are in search order (shadow SECTION27.1).
                      (    forth6809.asm):00395         ;
                      (    forth6809.asm):00396         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00397         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00398         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00399         ; ============================================================
                      (    forth6809.asm):00400         
                      (    forth6809.asm):00401                     ORG   BASEDICT
                      (    forth6809.asm):00402         ; ROOT wordlist: the Search-Order words. It is always searched, last,
                      (    forth6809.asm):00403         ; and FORTH continues into it (the link of the first FORTH header names
                      (    forth6809.asm):00404         ; BASEROOTLATEST), so FORTH-WORDLIST also contains these words.
                      (    forth6809.asm):00405         ; See shadow BASEROOTLATEST.1

                      (    forth6809.asm):07039         ; ============================================================
                      (    forth6809.asm):07040         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07041         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07042         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07043         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07044         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07045         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07046         ; ============================================================
                      (    forth6809.asm):07047         ; ------------------------------------------------------------
                      (    forth6809.asm):07048         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07049         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07050         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07051         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07052         ; - no indirection, no value cell.
                      (    forth6809.asm):07053         ;
                      (    forth6809.asm):07054         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07055         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07056         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07057         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07058         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07059         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07060         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07061         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07062         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07063         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07064         ; ------------------------------------------------------------
FF7E CCFFFF           (    forth6809.asm):07065         TRUEBODY:  LDD   #$FFFF
FF81 3606             (    forth6809.asm):07066                    PSHU  D
FF83 39               (    forth6809.asm):07067                    RTS
                      (    forth6809.asm):07068         
FF84 CC0000           (    forth6809.asm):07069         FALSEBODY: LDD   #$0000
FF87 3606             (    forth6809.asm):07070                    PSHU  D
FF89 39               (    forth6809.asm):07071                    RTS
                      (    forth6809.asm):07072         
                      (    forth6809.asm):07073         ; ------------------------------------------------------------
                      (    forth6809.asm):07074         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07075         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07076         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07077         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07078         ; ------------------------------------------------------------
FF8A CC0001           (    forth6809.asm):07079         ONEBODY:   LDD   #1
FF8D 3606             (    forth6809.asm):07080                    PSHU  D
FF8F 39               (    forth6809.asm):07081                    RTS
                      (    forth6809.asm):07082         
FF90 CCFFFF           (    forth6809.asm):07083         MONEBODY:  LDD   #-1
FF93 3606             (    forth6809.asm):07084                    PSHU  D
FF95 39               (    forth6809.asm):07085                    RTS
                      (    forth6809.asm):07086         
FF96 CC0002           (    forth6809.asm):07087         TWOBODY:   LDD   #2
FF99 3606             (    forth6809.asm):07088                    PSHU  D
FF9B 39               (    forth6809.asm):07089                    RTS
                      (    forth6809.asm):07090         
FF9C CCFFFE           (    forth6809.asm):07091         MTWOBODY:  LDD   #-2
FF9F 3606             (    forth6809.asm):07092                    PSHU  D
FFA1 39               (    forth6809.asm):07093                    RTS
                      (    forth6809.asm):07094         
                      (    forth6809.asm):07095         ; Verify no collision with init code,
                      (    forth6809.asm):07096         ; value should match ORG INITCODE.
     FFA2             (    forth6809.asm):07097         BASECODEEND  EQU   *
     2128             (    forth6809.asm):07098         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07099         
                      (    forth6809.asm):07100         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07101         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07102         ; .bin file.
FFA2                  (    forth6809.asm):07103         BASEND:
FFA2 FFFF             (    forth6809.asm):07104                  FILL $FF,INITCODE-BASEND
                      (    forth6809.asm):07105         

                      (    forth6809.asm):02180         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02181         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02182         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02183         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02184         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02185         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02186         ; one copy pushed).
                      (    forth6809.asm):02187         ; ------------------------------------------------------------
C195                  (    forth6809.asm):02188         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):02189         
                      (    forth6809.asm):02190                    LDD   #TSTGUARD

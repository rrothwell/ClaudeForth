                      (    forth6809.asm):08292                    CMPD #6
                      (    forth6809.asm):08293                    BNE  CDFAIL
                      (    forth6809.asm):08294                    PULU D
                      (    forth6809.asm):08295                    CMPD #TSTGUARD
                      (    forth6809.asm):08296                    BNE  CDFAIL
                      (    forth6809.asm):08297         
                      (    forth6809.asm):08298                    LDD  TSTUB4
                      (    forth6809.asm):08299                    SUBD TSTUAF
                      (    forth6809.asm):08300                    CMPD #2
                      (    forth6809.asm):08301                    BNE  CDFAIL
                      (    forth6809.asm):08302         

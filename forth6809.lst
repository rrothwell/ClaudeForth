                      (    forth6809.asm):06322                  SUBD  TSTUAF
                      (    forth6809.asm):06323                  CMPD  #0
                      (    forth6809.asm):06324                  BNE   T1FAIL
                      (    forth6809.asm):06325         
                      (    forth6809.asm):06326                  LDD   #TRUEV
                      (    forth6809.asm):06327                  BRA   T1DONE
C245                  (    forth6809.asm):06328         T1FAIL:  LDD   #FALSEV

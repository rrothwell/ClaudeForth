F485 A181             (    forth6809.asm):06856                     CMPA  ,X++
F487 26F8             (    forth6809.asm):06857                     BNE   SQEFND
F489 A61F             (    forth6809.asm):06858                     LDA   -1,X
F48B AE64             (    forth6809.asm):06859         SQEPUT:     LDX   4,S
F48D A780             (    forth6809.asm):06860                     STA   ,X+
F48F AF64             (    forth6809.asm):06861                     STX   4,S
F491 20CD             (    forth6809.asm):06862                     BRA   SQEL
F493 AE64             (    forth6809.asm):06863         SQEM:       LDX   4,S
F495 860D             (    forth6809.asm):06864                     LDA   #13
F497 A780             (    forth6809.asm):06865                     STA   ,X+
F499 860A             (    forth6809.asm):06866                     LDA   #10
F49B A780             (    forth6809.asm):06867                     STA   ,X+
F49D AF64             (    forth6809.asm):06868                     STX   4,S
F49F 20BF             (    forth6809.asm):06869                     BRA   SQEL
F4A1 8D1A             (    forth6809.asm):06870         SQEHEX:     BSR   SQEHD             ; first digit
F4A3 25BB             (    forth6809.asm):06871                     BCS   SQEL              ; none: nothing is added
F4A5 3121             (    forth6809.asm):06872                     LEAY  1,Y
F4A7 1F89             (    forth6809.asm):06873                     TFR   A,B
F4A9 8D12             (    forth6809.asm):06874                     BSR   SQEHD             ; second digit
F4AB 2404             (    forth6809.asm):06875                     BCC   SQEH2
F4AD 1F98             (    forth6809.asm):06876                     TFR   B,A               ; one digit only
F4AF 20DA             (    forth6809.asm):06877                     BRA   SQEPUT
F4B1 3121             (    forth6809.asm):06878         SQEH2:      LEAY  1,Y
F4B3 58               (    forth6809.asm):06879                     ASLB
F4B4 58               (    forth6809.asm):06880                     ASLB
F4B5 58               (    forth6809.asm):06881                     ASLB
F4B6 58               (    forth6809.asm):06882                     ASLB
F4B7 3404             (    forth6809.asm):06883                     PSHS  B
F4B9 ABE0             (    forth6809.asm):06884                     ADDA  ,S+

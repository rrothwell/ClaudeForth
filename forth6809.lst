                      (    forth6809.asm):14242         ; TSTDOT - unit test for . (DOT). Prints -42, expecting "-42 "
                      (    forth6809.asm):14243         ; (4 chars: minus, two digits, trailing space). Under SERIALPOLL=0
                      (    forth6809.asm):14244         ; verifies all 4 queued bytes directly; under SERIALPOLL=1 (the
                      (    forth6809.asm):14245         ; polling variant, confirmed the active build), verifies only the
                      (    forth6809.asm):14246         ; last-emitted character via EMITCH - a fixed trailing space in
                      (    forth6809.asm):14247         ; this word's case, a known, accepted, less-discriminating check
                      (    forth6809.asm):14248         ; consistent with the same trade-off already established for
                      (    forth6809.asm):14249         ; TSTCR/TSTSPACES/TSTTYPE/TSTDOTQUOTE.

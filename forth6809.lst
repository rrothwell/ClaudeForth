                      (    forth6809.asm):06257         ; ------------------------------------------------------------
                      (    forth6809.asm):06258         ; /MOD  ( n1 n2 -- n3 n4 )
                      (    forth6809.asm):06259         ; Divide n1 by n2, giving the remainder n3 and the quotient n4.
                      (    forth6809.asm):06260         ; Division truncates toward zero; the remainder has the sign of the
                      (    forth6809.asm):06261         ; dividend. THROW -10 if the divisor is zero.
                      (    forth6809.asm):06262         ; ------------------------------------------------------------
E17C BDE114           (    forth6809.asm):06263         SLASHMODW:  JSR   DIVCOMMON
E17F DC2C             (    forth6809.asm):06264                     LDD   DIVREM

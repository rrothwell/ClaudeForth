D89A E684             (    forth6809.asm):04295                     LDB   ,X
D89C 276D             (    forth6809.asm):04296                     BEQ   NQBAD
D89E 3001             (    forth6809.asm):04297                     LEAX  1,X
                      (    forth6809.asm):04298         
                      (    forth6809.asm):04299                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04300                     ; digit count. See shadow: NUMBERQ.1

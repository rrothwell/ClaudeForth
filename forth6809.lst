                      (    forth6809.asm):03262         
                      (    forth6809.asm):03263                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E504 0D1F             (    forth6809.asm):03264                     TST   NUMNEG
E506 2713             (    forth6809.asm):03265                     BEQ   NQPOS32
E508 DC50             (    forth6809.asm):03266                     LDD   UDLO
E50A DD39             (    forth6809.asm):03267                     STD   PRODLO
E50C DC4E             (    forth6809.asm):03268                     LDD   UDHI
E50E DD37             (    forth6809.asm):03269                     STD   PRODHI
E510 BDEE47           (    forth6809.asm):03270                     JSR   MNEG32            ; shared negate. See bugfix: NUMBERQ.5
E513 DC39             (    forth6809.asm):03271                     LDD   PRODLO
E515 DD50             (    forth6809.asm):03272                     STD   UDLO
E517 DC37             (    forth6809.asm):03273                     LDD   PRODHI
E519 DD4E             (    forth6809.asm):03274                     STD   UDHI
                      (    forth6809.asm):03275         
E51B                  (    forth6809.asm):03276         NQPOS32:                            ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03277                     ; was '.' - determines which return convention to use
E51B 9E1C             (    forth6809.asm):03278                     LDX   CADDR
E51D E684             (    forth6809.asm):03279                     LDB   ,X
E51F 5A               (    forth6809.asm):03280                     DECB
E520 3001             (    forth6809.asm):03281                     LEAX  1,X
E522 A685             (    forth6809.asm):03282                     LDA   B,X
E524 812E             (    forth6809.asm):03283                     CMPA  #'.'

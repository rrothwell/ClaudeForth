                      (    forth6809.asm):02119                     ; See bugfix: QLOOP.1
DE33 CC0000           (    forth6809.asm):02120                     LDD   #0
DE36 DD00             (    forth6809.asm):02121                     STD   STATE
                      (    forth6809.asm):02122         
DE38 ECE4             (    forth6809.asm):02123                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DE3A 1083FFFF         (    forth6809.asm):02124                     CMPD  #-1
DE3E 2605             (    forth6809.asm):02125                     BNE   QSHOWERR
DE40 326A             (    forth6809.asm):02126                     LEAS  10,S              ; drop the frame
DE42 16FFB6           (    forth6809.asm):02127                     LBRA  QLOOP
                      (    forth6809.asm):02128         
DE45 BDFB6C           (    forth6809.asm):02129         QSHOWERR:   JSR   CRW
DE48 8EDE8B           (    forth6809.asm):02130                     LDX   #ERRMSG
DE4B 3610             (    forth6809.asm):02131                     PSHU  X                 ; c-addr
DE4D CC0008           (    forth6809.asm):02132                     LDD   #ERRMSGL
DE50 3606             (    forth6809.asm):02133                     PSHU  D                 ; u
DE52 BDF570           (    forth6809.asm):02134                     JSR   TYPEW
DE55 ECE4             (    forth6809.asm):02135                     LDD   ,S
DE57 3606             (    forth6809.asm):02136                     PSHU  D                 ; n
DE59 BDFA3B           (    forth6809.asm):02137                     JSR   DOTW
DE5C 326A             (    forth6809.asm):02138                     LEAS  10,S              ; drop the frame
DE5E 209B             (    forth6809.asm):02139                     BRA   QLOOP
                      (    forth6809.asm):02140         
DE60 326A             (    forth6809.asm):02141         QOK:        LEAS  10,S              ; drop the frame
DE62 BDFB6C           (    forth6809.asm):02142                     JSR   CRW               ; See bugfix: QOK.1
DE65 DC00             (    forth6809.asm):02143                     LDD   STATE
DE67 2692             (    forth6809.asm):02144                     BNE   QLOOP
DE69 8EDE87           (    forth6809.asm):02145                     LDX   #OKMSG
DE6C 3610             (    forth6809.asm):02146                     PSHU  X                 ; c-addr
DE6E CC0004           (    forth6809.asm):02147                     LDD   #OKMSGL
DE71 3606             (    forth6809.asm):02148                     PSHU  D                 ; u
DE73 BDF570           (    forth6809.asm):02149                     JSR   TYPEW
DE76 2083             (    forth6809.asm):02150                     BRA   QLOOP
                      (    forth6809.asm):02151         
DE78 3638303920464F52 (    forth6809.asm):02152         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02153         SIGNONL     EQU   *-SIGNON
DE87 20206F6B         (    forth6809.asm):02154         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02155         OKMSGL      EQU   *-OKMSG
DE8B 20204552524F5220 (    forth6809.asm):02156         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02157         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02158         
                      (    forth6809.asm):02159         ; ============================================================
                      (    forth6809.asm):02160         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02161         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02162         ; ============================================================
                      (    forth6809.asm):02163         ; ------------------------------------------------------------
                      (    forth6809.asm):02164         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02165         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02166         ; LIT   ( -- x )
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02169         ;    Outputs:
                      (    forth6809.asm):02170         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02171         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02172         ; ------------------------------------------------------------
DE93 3510             (    forth6809.asm):02173         LIT:        PULS  X
DE95 EC81             (    forth6809.asm):02174                     LDD   ,X++
DE97 3606             (    forth6809.asm):02175                     PSHU  D                 ; x
DE99 3410             (    forth6809.asm):02176                     PSHS  X
DE9B 39               (    forth6809.asm):02177                     RTS
                      (    forth6809.asm):02178         
                      (    forth6809.asm):02179         ; ------------------------------------------------------------
                      (    forth6809.asm):02180         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02181         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02182         ; address.
                      (    forth6809.asm):02183         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02184         ;    Inputs:
                      (    forth6809.asm):02185         ;        flag on the data stack
                      (    forth6809.asm):02186         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02187         ;    Outputs:
                      (    forth6809.asm):02188         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02189         ;        the offset
                      (    forth6809.asm):02190         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02191         ; ------------------------------------------------------------
DE9C 3706             (    forth6809.asm):02192         ZBRANCH:    PULU  D                 ; flag
DE9E 3510             (    forth6809.asm):02193                     PULS  X
DEA0 10830000         (    forth6809.asm):02194                     CMPD  #0
DEA4 2607             (    forth6809.asm):02195                     BNE   ZSKIP
DEA6 EC84             (    forth6809.asm):02196                     LDD   ,X
DEA8 308B             (    forth6809.asm):02197                     LEAX  D,X
DEAA 3410             (    forth6809.asm):02198                     PSHS  X
DEAC 39               (    forth6809.asm):02199                     RTS
DEAD 3002             (    forth6809.asm):02200         ZSKIP:      LEAX  2,X
DEAF 3410             (    forth6809.asm):02201                     PSHS  X
DEB1 39               (    forth6809.asm):02202                     RTS
                      (    forth6809.asm):02203         
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02206         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02207         ; BRANCH
                      (    forth6809.asm):02208         ;    Inputs:
                      (    forth6809.asm):02209         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02210         ;    Outputs:
                      (    forth6809.asm):02211         ;        return address set to the branch target
                      (    forth6809.asm):02212         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02213         ; ------------------------------------------------------------
DEB2 3510             (    forth6809.asm):02214         BRANCH:     PULS  X
DEB4 EC84             (    forth6809.asm):02215                     LDD   ,X
DEB6 308B             (    forth6809.asm):02216                     LEAX  D,X
DEB8 3410             (    forth6809.asm):02217                     PSHS  X
DEBA 39               (    forth6809.asm):02218                     RTS
                      (    forth6809.asm):02219         
                      (    forth6809.asm):02220         ; ------------------------------------------------------------
                      (    forth6809.asm):02221         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02222         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02223         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02224         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02225         ;    Inputs:
                      (    forth6809.asm):02226         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02227         ;        trampoline
                      (    forth6809.asm):02228         ;    Outputs:
                      (    forth6809.asm):02229         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02230         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02231         ; ------------------------------------------------------------
DEBB 3510             (    forth6809.asm):02232         DODOES:     PULS  X
DEBD 10AE81           (    forth6809.asm):02233                     LDY   ,X++
DEC0 EC84             (    forth6809.asm):02234                     LDD   ,X
DEC2 3606             (    forth6809.asm):02235                     PSHU  D                 ; pfa
DEC4 6EA4             (    forth6809.asm):02236                     JMP   ,Y
                      (    forth6809.asm):02237         
                      (    forth6809.asm):02238         ; ------------------------------------------------------------
                      (    forth6809.asm):02239         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02240         ; field address on the stack.
                      (    forth6809.asm):02241         ; DOESRT0
                      (    forth6809.asm):02242         ;    Inputs:
                      (    forth6809.asm):02243         ;        none
                      (    forth6809.asm):02244         ;    Outputs:
                      (    forth6809.asm):02245         ;        none
                      (    forth6809.asm):02246         ;    Registers: none.
                      (    forth6809.asm):02247         ; ------------------------------------------------------------
DEC6 39               (    forth6809.asm):02248         DOESRT0:    RTS
                      (    forth6809.asm):02249         
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
                      (    forth6809.asm):02251         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02252         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02253         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02254         ; SETDOES
                      (    forth6809.asm):02255         ;    Inputs:
                      (    forth6809.asm):02256         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02257         ;        BEHAVIOR)
                      (    forth6809.asm):02258         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02259         ;        address
                      (    forth6809.asm):02260         ;    Outputs:
                      (    forth6809.asm):02261         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02262         ;        defining word's caller
                      (    forth6809.asm):02263         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02264         ; ------------------------------------------------------------
DEC7 3510             (    forth6809.asm):02265         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DEC9 1F12             (    forth6809.asm):02266                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02267         
DECB 9E04             (    forth6809.asm):02268                     LDX   LATEST
DECD E684             (    forth6809.asm):02269                     LDB   ,X
DECF C41F             (    forth6809.asm):02270                     ANDB  #$1F
DED1 4F               (    forth6809.asm):02271                     CLRA
DED2 308B             (    forth6809.asm):02272                     LEAX  D,X               ; header + name length
DED4 EC03             (    forth6809.asm):02273                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DED6 C30003           (    forth6809.asm):02274                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DED9 1F01             (    forth6809.asm):02275                     TFR   D,X
                      (    forth6809.asm):02276         
DEDB 10AF84           (    forth6809.asm):02277                     STY   ,X                ; patch it
                      (    forth6809.asm):02278         
DEDE 3510             (    forth6809.asm):02279                     PULS  X                 ; X = the OUTER defining word's own return addr
DEE0 6E84             (    forth6809.asm):02280                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02281         
                      (    forth6809.asm):02282         ; ------------------------------------------------------------
                      (    forth6809.asm):02283         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02284         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02285         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02286         ;    Inputs:
                      (    forth6809.asm):02287         ;        pfa on the data stack
                      (    forth6809.asm):02288         ;    Outputs:
                      (    forth6809.asm):02289         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02290         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02291         ; ------------------------------------------------------------
DEE2 3710             (    forth6809.asm):02292         DODEFER:    PULU  X                 ; pfa
DEE4 EC84             (    forth6809.asm):02293                     LDD   ,X
DEE6 1F01             (    forth6809.asm):02294                     TFR   D,X
DEE8 6E84             (    forth6809.asm):02295                     JMP   ,X
                      (    forth6809.asm):02296         
                      (    forth6809.asm):02297         ; ------------------------------------------------------------
                      (    forth6809.asm):02298         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02299         ; DOABORTUNDEF
                      (    forth6809.asm):02300         ;    Inputs:
                      (    forth6809.asm):02301         ;        none
                      (    forth6809.asm):02302         ;    Outputs:
                      (    forth6809.asm):02303         ;        none (does not return)
                      (    forth6809.asm):02304         ;    Registers: RegD changed.
                      (    forth6809.asm):02305         ; ------------------------------------------------------------
DEEA                  (    forth6809.asm):02306         DOABORTUNDEF:
DEEA CCFFEB           (    forth6809.asm):02307                     LDD   #-21
DEED 3606             (    forth6809.asm):02308                     PSHU  D                 ; throw code (-21)
DEEF 7EE561           (    forth6809.asm):02309                     JMP   THROWW
                      (    forth6809.asm):02310         
                      (    forth6809.asm):02311         ; ------------------------------------------------------------
                      (    forth6809.asm):02312         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02313         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02314         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02315         ;    Inputs:
                      (    forth6809.asm):02316         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02317         ;    Outputs:
                      (    forth6809.asm):02318         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02319         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02320         ; ------------------------------------------------------------
DEF2 3710             (    forth6809.asm):02321         DOMARKER:   PULU  X                 ; pfa
DEF4 EC84             (    forth6809.asm):02322                     LDD   ,X
DEF6 DD06             (    forth6809.asm):02323                     STD   DPHERE
DEF8 EC02             (    forth6809.asm):02324                     LDD   2,X
DEFA DD08             (    forth6809.asm):02325                     STD   CODEHERE
DEFC EC04             (    forth6809.asm):02326                     LDD   4,X
DEFE DD0A             (    forth6809.asm):02327                     STD   VARHERE
DF00 EC06             (    forth6809.asm):02328                     LDD   6,X
DF02 DD04             (    forth6809.asm):02329                     STD   LATEST
DF04 39               (    forth6809.asm):02330                     RTS
                      (    forth6809.asm):02331         
                      (    forth6809.asm):02332         ; ------------------------------------------------------------
                      (    forth6809.asm):02333         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02334         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02335         ; ------------------------------------------------------------
DF05 3710             (    forth6809.asm):02336         EXECUTEW:   PULU  X                 ; xt
DF07 AD84             (    forth6809.asm):02337                     JSR   ,X
DF09 39               (    forth6809.asm):02338                     RTS
                      (    forth6809.asm):02339         
                      (    forth6809.asm):02340         ; ============================================================
                      (    forth6809.asm):02341         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02342         ; ============================================================
                      (    forth6809.asm):02343         ; ------------------------------------------------------------
                      (    forth6809.asm):02344         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02345         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02346         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02347         ;    Inputs:
                      (    forth6809.asm):02348         ;        RegX = address of the here pointer
                      (    forth6809.asm):02349         ;        x on the data stack
                      (    forth6809.asm):02350         ;    Outputs:
                      (    forth6809.asm):02351         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02352         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02353         ; ------------------------------------------------------------
DF0A 3706             (    forth6809.asm):02354         APPENDCELL: PULU  D                 ; x
DF0C 10AE84           (    forth6809.asm):02355                     LDY   ,X
DF0F EDA1             (    forth6809.asm):02356                     STD   ,Y++
DF11 10AF84           (    forth6809.asm):02357                     STY   ,X
DF14 39               (    forth6809.asm):02358                     RTS
                      (    forth6809.asm):02359         
                      (    forth6809.asm):02360         ; ------------------------------------------------------------
                      (    forth6809.asm):02361         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02362         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02363         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02364         ;    Inputs:
                      (    forth6809.asm):02365         ;        RegX = address of the here pointer
                      (    forth6809.asm):02366         ;        char on the data stack
                      (    forth6809.asm):02367         ;    Outputs:
                      (    forth6809.asm):02368         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02369         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02370         ; ------------------------------------------------------------
DF15 3706             (    forth6809.asm):02371         APPENDBYTE: PULU  D                 ; char
DF17 10AE84           (    forth6809.asm):02372                     LDY   ,X
DF1A E7A0             (    forth6809.asm):02373                     STB   ,Y+
DF1C 10AF84           (    forth6809.asm):02374                     STY   ,X
DF1F 39               (    forth6809.asm):02375                     RTS
                      (    forth6809.asm):02376         
                      (    forth6809.asm):02377         ; ------------------------------------------------------------
                      (    forth6809.asm):02378         ; ,  ( x -- )
                      (    forth6809.asm):02379         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02380         ; ------------------------------------------------------------
DF20 8E0008           (    forth6809.asm):02381         COMMAW:     LDX   #CODEHERE
DF23 7EDF0A           (    forth6809.asm):02382                     JMP   APPENDCELL
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02386         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02387         ; ------------------------------------------------------------
DF26 8E0008           (    forth6809.asm):02388         CODECOMMA:  LDX   #CODEHERE
DF29 7EDF0A           (    forth6809.asm):02389                     JMP   APPENDCELL
                      (    forth6809.asm):02390         
                      (    forth6809.asm):02391         ; ------------------------------------------------------------
                      (    forth6809.asm):02392         ; C,  ( char -- )
                      (    forth6809.asm):02393         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
DF2C 8E0008           (    forth6809.asm):02395         CCOMMAW:    LDX   #CODEHERE
DF2F 7EDF15           (    forth6809.asm):02396                     JMP   APPENDBYTE
                      (    forth6809.asm):02397         
                      (    forth6809.asm):02398         ; ------------------------------------------------------------
                      (    forth6809.asm):02399         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02400         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02401         ; ------------------------------------------------------------
DF32 8E0008           (    forth6809.asm):02402         CCOMMA1:    LDX   #CODEHERE
DF35 7EDF15           (    forth6809.asm):02403                     JMP   APPENDBYTE
                      (    forth6809.asm):02404         
                      (    forth6809.asm):02405         ; ------------------------------------------------------------
                      (    forth6809.asm):02406         ; V,  ( x -- )
                      (    forth6809.asm):02407         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02408         ; ------------------------------------------------------------
DF38 8E000A           (    forth6809.asm):02409         VCOMMAW:    LDX   #VARHERE
DF3B 7EDF0A           (    forth6809.asm):02410                     JMP   APPENDCELL
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
                      (    forth6809.asm):02413         ; VC,  ( char -- )
                      (    forth6809.asm):02414         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02415         ; ------------------------------------------------------------
DF3E 8E000A           (    forth6809.asm):02416         VCCOMMAW:   LDX   #VARHERE
DF41 7EDF15           (    forth6809.asm):02417                     JMP   APPENDBYTE
                      (    forth6809.asm):02418         
                      (    forth6809.asm):02419         ; ------------------------------------------------------------
                      (    forth6809.asm):02420         ; ALLOT  ( n -- )
                      (    forth6809.asm):02421         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02422         ; ------------------------------------------------------------
DF44 3706             (    forth6809.asm):02423         ALLOTW:     PULU  D                 ; n
DF46 9E08             (    forth6809.asm):02424                     LDX   CODEHERE
DF48 308B             (    forth6809.asm):02425                     LEAX  D,X
DF4A 9F08             (    forth6809.asm):02426                     STX   CODEHERE
DF4C 39               (    forth6809.asm):02427                     RTS
                      (    forth6809.asm):02428         
                      (    forth6809.asm):02429         ; ------------------------------------------------------------
                      (    forth6809.asm):02430         ; VALLOT  ( n -- )
                      (    forth6809.asm):02431         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02432         ; ------------------------------------------------------------
DF4D 3706             (    forth6809.asm):02433         VALLOTW:    PULU  D                 ; n
DF4F 9E0A             (    forth6809.asm):02434                     LDX   VARHERE
DF51 308B             (    forth6809.asm):02435                     LEAX  D,X
DF53 9F0A             (    forth6809.asm):02436                     STX   VARHERE
DF55 39               (    forth6809.asm):02437                     RTS
                      (    forth6809.asm):02438         
                      (    forth6809.asm):02439         ; ------------------------------------------------------------
                      (    forth6809.asm):02440         ; HERE  ( -- addr )
                      (    forth6809.asm):02441         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02442         ; ------------------------------------------------------------
DF56 DC08             (    forth6809.asm):02443         HEREW:      LDD   CODEHERE
DF58 3606             (    forth6809.asm):02444                     PSHU  D                 ; addr
DF5A 39               (    forth6809.asm):02445                     RTS
                      (    forth6809.asm):02446         
                      (    forth6809.asm):02447         ; ------------------------------------------------------------
                      (    forth6809.asm):02448         ; VHERE  ( -- addr )
                      (    forth6809.asm):02449         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02450         ; ------------------------------------------------------------
DF5B DC0A             (    forth6809.asm):02451         VHEREW:     LDD   VARHERE
DF5D 3606             (    forth6809.asm):02452                     PSHU  D                 ; addr
DF5F 39               (    forth6809.asm):02453                     RTS
                      (    forth6809.asm):02454         
                      (    forth6809.asm):02455         ; ------------------------------------------------------------
                      (    forth6809.asm):02456         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02457         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02458         ; ------------------------------------------------------------
DF60 DC08             (    forth6809.asm):02459         PADW:       LDD   CODEHERE
DF62 C30080           (    forth6809.asm):02460                     ADDD  #PADOFFSET
DF65 3606             (    forth6809.asm):02461                     PSHU  D                 ; c-addr
DF67 39               (    forth6809.asm):02462                     RTS
                      (    forth6809.asm):02463         
                      (    forth6809.asm):02464         ; ------------------------------------------------------------
                      (    forth6809.asm):02465         ; UNUSED  ( -- u )
                      (    forth6809.asm):02466         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02467         ; ------------------------------------------------------------
DF68 CCB900           (    forth6809.asm):02468         UNUSEDW:    LDD   #CODETOP
DF6B 9308             (    forth6809.asm):02469                     SUBD  CODEHERE
DF6D 3606             (    forth6809.asm):02470                     PSHU  D                 ; u
DF6F 39               (    forth6809.asm):02471                     RTS
                      (    forth6809.asm):02472         
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
                      (    forth6809.asm):02474         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02475         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02476         ; ------------------------------------------------------------
DF70 CC1FFF           (    forth6809.asm):02477         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DF73 930A             (    forth6809.asm):02478                     SUBD  VARHERE
DF75 3606             (    forth6809.asm):02479                     PSHU  D                 ; u
DF77 39               (    forth6809.asm):02480                     RTS
                      (    forth6809.asm):02481         
                      (    forth6809.asm):02482         ; ============================================================
                      (    forth6809.asm):02483         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02484         ; ============================================================
                      (    forth6809.asm):02485         ; ------------------------------------------------------------
                      (    forth6809.asm):02486         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02487         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02488         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02489         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02490         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02491         ;    Inputs:
                      (    forth6809.asm):02492         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02493         ;        name parsed from the input stream
                      (    forth6809.asm):02494         ;    Outputs:
                      (    forth6809.asm):02495         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02496         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02497         ; ------------------------------------------------------------
DF78 CC0020           (    forth6809.asm):02498         HEADER:     LDD   #32
DF7B 3606             (    forth6809.asm):02499                     PSHU  D
DF7D BDE2A0           (    forth6809.asm):02500                     JSR   WORDW
DF80 3710             (    forth6809.asm):02501                     PULU  X                 ; c-addr of the name
DF82 3706             (    forth6809.asm):02502                     PULU  D                 ; smudge flag in B
DF84 A680             (    forth6809.asm):02503                     LDA   ,X+               ; name length, X = name text
DF86 3402             (    forth6809.asm):02504                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DF88 5D               (    forth6809.asm):02505                     TSTB
DF89 2702             (    forth6809.asm):02506                     BEQ   HDNOSM
DF8B 8A40             (    forth6809.asm):02507                     ORA   #$40
DF8D 109E06           (    forth6809.asm):02508         HDNOSM:     LDY   DPHERE
DF90 3420             (    forth6809.asm):02509                     PSHS  Y                 ; 0,S = address of the new header
DF92 A7A0             (    forth6809.asm):02510                     STA   ,Y+
DF94 E662             (    forth6809.asm):02511                     LDB   2,S
DF96 2707             (    forth6809.asm):02512                     BEQ   HDNONM
DF98 A680             (    forth6809.asm):02513         HDCPY:      LDA   ,X+
DF9A A7A0             (    forth6809.asm):02514                     STA   ,Y+
DF9C 5A               (    forth6809.asm):02515                     DECB
DF9D 26F9             (    forth6809.asm):02516                     BNE   HDCPY
DF9F DC04             (    forth6809.asm):02517         HDNONM:     LDD   LATEST
DFA1 EDA1             (    forth6809.asm):02518                     STD   ,Y++
DFA3 DC08             (    forth6809.asm):02519                     LDD   CODEHERE
DFA5 EDA1             (    forth6809.asm):02520                     STD   ,Y++
DFA7 109F06           (    forth6809.asm):02521                     STY   DPHERE
DFAA 3506             (    forth6809.asm):02522                     PULS  D
DFAC DD04             (    forth6809.asm):02523                     STD   LATEST
DFAE 3261             (    forth6809.asm):02524                     LEAS  1,S
DFB0 39               (    forth6809.asm):02525                     RTS
                      (    forth6809.asm):02526         
                      (    forth6809.asm):02527         ; ============================================================
                      (    forth6809.asm):02528         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02529         ; ============================================================
                      (    forth6809.asm):02530         ; ------------------------------------------------------------
                      (    forth6809.asm):02531         ; :  ( "name" -- )
                      (    forth6809.asm):02532         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02533         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02534         ; CSP and enter compile state.
                      (    forth6809.asm):02535         ; ------------------------------------------------------------
DFB1 CCFFFF           (    forth6809.asm):02536         COLONW:     LDD   #TRUEV
DFB4 3606             (    forth6809.asm):02537                     PSHU  D
DFB6 BDDF78           (    forth6809.asm):02538                     JSR   HEADER
DFB9 DC08             (    forth6809.asm):02539                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DFBB DD1F             (    forth6809.asm):02540                     STD   CURXT             ; See bugfix: COLONW.1
DFBD 1F30             (    forth6809.asm):02541                     TFR   U,D
DFBF DD21             (    forth6809.asm):02542                     STD   CSP
DFC1 CCFFFF           (    forth6809.asm):02543                     LDD   #-1
DFC4 DD00             (    forth6809.asm):02544                     STD   STATE
DFC6 39               (    forth6809.asm):02545                     RTS
                      (    forth6809.asm):02546         
                      (    forth6809.asm):02547         ; ------------------------------------------------------------
                      (    forth6809.asm):02548         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02549         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02550         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02551         ; new word and return to interpret state.
                      (    forth6809.asm):02552         ; ------------------------------------------------------------
DFC7 CC0039           (    forth6809.asm):02553         SEMIW:      LDD   #RTSOPC
DFCA 3606             (    forth6809.asm):02554                     PSHU  D
DFCC BDDF32           (    forth6809.asm):02555                     JSR   CCOMMA1
DFCF 1F30             (    forth6809.asm):02556                     TFR   U,D
DFD1 109321           (    forth6809.asm):02557                     CMPD  CSP
DFD4 2703             (    forth6809.asm):02558                     BEQ   SEMIOK
DFD6 BDE52C           (    forth6809.asm):02559                     JSR   CFERR
DFD9 9E04             (    forth6809.asm):02560         SEMIOK:     LDX   LATEST
DFDB A684             (    forth6809.asm):02561                     LDA   ,X
DFDD 84BF             (    forth6809.asm):02562                     ANDA  #$BF
DFDF A784             (    forth6809.asm):02563                     STA   ,X
DFE1 CC0000           (    forth6809.asm):02564                     LDD   #0
DFE4 DD00             (    forth6809.asm):02565                     STD   STATE
DFE6 39               (    forth6809.asm):02566                     RTS
                      (    forth6809.asm):02567         
                      (    forth6809.asm):02568         ; ------------------------------------------------------------
                      (    forth6809.asm):02569         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02570         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02571         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02572         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02573         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02574         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02575         ; ------------------------------------------------------------
DFE7 DC08             (    forth6809.asm):02576         NONAMEW:    LDD   CODEHERE
DFE9 3606             (    forth6809.asm):02577                     PSHU  D                 ; xt
DFEB DD1F             (    forth6809.asm):02578                     STD   CURXT             ; See bugfix: NONAMEW.1
DFED 1F30             (    forth6809.asm):02579                     TFR   U,D
DFEF DD21             (    forth6809.asm):02580                     STD   CSP
DFF1 CCFFFF           (    forth6809.asm):02581                     LDD   #-1
DFF4 DD00             (    forth6809.asm):02582                     STD   STATE
DFF6 39               (    forth6809.asm):02583                     RTS
                      (    forth6809.asm):02584         
                      (    forth6809.asm):02585         ; ------------------------------------------------------------
                      (    forth6809.asm):02586         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02587         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02588         ; BLDDOES
                      (    forth6809.asm):02589         ;    Inputs:
                      (    forth6809.asm):02590         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02591         ;    Outputs:
                      (    forth6809.asm):02592         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02593         ;    Registers: all changed.
                      (    forth6809.asm):02594         ; BLDSELF
                      (    forth6809.asm):02595         ;    Inputs:
                      (    forth6809.asm):02596         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02597         ;    Outputs:
                      (    forth6809.asm):02598         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02599         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02600         ;    Registers: all changed.
                      (    forth6809.asm):02601         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02602         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02603         ; ------------------------------------------------------------
DFF7 3406             (    forth6809.asm):02604         BLDDOES:    PSHS  D                 ; behaviour address
DFF9 CC0000           (    forth6809.asm):02605                     LDD   #0
DFFC 3606             (    forth6809.asm):02606                     PSHU  D
DFFE BDDF78           (    forth6809.asm):02607                     JSR   HEADER
E001 CCDEBB           (    forth6809.asm):02608                     LDD   #DODOES
E004 3606             (    forth6809.asm):02609                     PSHU  D
E006 BDE99C           (    forth6809.asm):02610                     JSR   CCALL
E009 3506             (    forth6809.asm):02611                     PULS  D
E00B 3606             (    forth6809.asm):02612                     PSHU  D                 ; behaviour address
E00D BDDF26           (    forth6809.asm):02613                     JSR   CODECOMMA
E010 39               (    forth6809.asm):02614                     RTS
                      (    forth6809.asm):02615         
E011 BDDFF7           (    forth6809.asm):02616         BLDSELF:    JSR   BLDDOES
E014 DC08             (    forth6809.asm):02617                     LDD   CODEHERE          ; PFA = the cell after this one
E016 C30002           (    forth6809.asm):02618                     ADDD  #2                ; See bugfix: CONSTANTW.1
E019 3606             (    forth6809.asm):02619                     PSHU  D
E01B BDDF26           (    forth6809.asm):02620                     JSR   CODECOMMA
E01E 39               (    forth6809.asm):02621                     RTS
                      (    forth6809.asm):02622         
                      (    forth6809.asm):02623         ; ------------------------------------------------------------
                      (    forth6809.asm):02624         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02625         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02626         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02627         ; address in the code area, on the stack.
                      (    forth6809.asm):02628         ; ------------------------------------------------------------
E01F CCDEC6           (    forth6809.asm):02629         CREATEW:    LDD   #DOESRT0
E022 BDE011           (    forth6809.asm):02630                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E025 39               (    forth6809.asm):02631                     RTS
                      (    forth6809.asm):02632         
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
                      (    forth6809.asm):02634         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02635         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02636         ; of the word being defined.
                      (    forth6809.asm):02637         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02638         ; ------------------------------------------------------------
E026 CCDEC7           (    forth6809.asm):02639         DOESGTW:    LDD   #SETDOES
E029 3606             (    forth6809.asm):02640                     PSHU  D
E02B BDE99C           (    forth6809.asm):02641                     JSR   CCALL
E02E 39               (    forth6809.asm):02642                     RTS
                      (    forth6809.asm):02643         
                      (    forth6809.asm):02644         ; ------------------------------------------------------------
                      (    forth6809.asm):02645         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02646         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02647         ; area, initialised to zero.
                      (    forth6809.asm):02648         ; ------------------------------------------------------------
E02F CC0000           (    forth6809.asm):02649         VARIABLEW:  LDD   #0
E032 3606             (    forth6809.asm):02650                     PSHU  D
E034 BDDF78           (    forth6809.asm):02651                     JSR   HEADER
E037 CCDEBB           (    forth6809.asm):02652                     LDD   #DODOES
E03A 3606             (    forth6809.asm):02653                     PSHU  D
E03C BDE99C           (    forth6809.asm):02654                     JSR   CCALL
E03F CCDEC6           (    forth6809.asm):02655                     LDD   #DOESRT0
E042 3606             (    forth6809.asm):02656                     PSHU  D
E044 BDDF26           (    forth6809.asm):02657                     JSR   CODECOMMA
E047 DC0A             (    forth6809.asm):02658                     LDD   VARHERE
E049 3606             (    forth6809.asm):02659                     PSHU  D
E04B BDDF26           (    forth6809.asm):02660                     JSR   CODECOMMA
E04E CC0000           (    forth6809.asm):02661                     LDD   #0
E051 9E0A             (    forth6809.asm):02662                     LDX   VARHERE
E053 ED81             (    forth6809.asm):02663                     STD   ,X++
E055 9F0A             (    forth6809.asm):02664                     STX   VARHERE
E057 39               (    forth6809.asm):02665                     RTS
                      (    forth6809.asm):02666         
                      (    forth6809.asm):02667         ; ------------------------------------------------------------
                      (    forth6809.asm):02668         ; @  ( a-addr -- x )
                      (    forth6809.asm):02669         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02670         ; ------------------------------------------------------------
E058 3710             (    forth6809.asm):02671         FETCHW:     PULU  X                 ; a-addr
E05A EC84             (    forth6809.asm):02672                     LDD   ,X
E05C 3606             (    forth6809.asm):02673                     PSHU  D                 ; x
E05E 39               (    forth6809.asm):02674                     RTS
                      (    forth6809.asm):02675         
                      (    forth6809.asm):02676         ; ------------------------------------------------------------
                      (    forth6809.asm):02677         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02678         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02679         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02680         ; ------------------------------------------------------------
E05F CCE058           (    forth6809.asm):02681         CONSTANTW:  LDD   #FETCHW
E062 BDE011           (    forth6809.asm):02682                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E065 BDDF20           (    forth6809.asm):02683                     JSR   COMMAW
E068 39               (    forth6809.asm):02684                     RTS
                      (    forth6809.asm):02685         
                      (    forth6809.asm):02686         ; ------------------------------------------------------------
                      (    forth6809.asm):02687         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02688         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02689         ;    Inputs:
                      (    forth6809.asm):02690         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02691         ;    Outputs:
                      (    forth6809.asm):02692         ;        pfa replaced by the value
                      (    forth6809.asm):02693         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02694         ; ------------------------------------------------------------
E069 3710             (    forth6809.asm):02695         DOVALUE:    PULU  X                 ; pfa
E06B EC84             (    forth6809.asm):02696                     LDD   ,X
E06D 3606             (    forth6809.asm):02697                     PSHU  D                 ; x
E06F 39               (    forth6809.asm):02698                     RTS
                      (    forth6809.asm):02699         
                      (    forth6809.asm):02700         ; ------------------------------------------------------------
                      (    forth6809.asm):02701         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02702         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02703         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02704         ; ------------------------------------------------------------
E070 CCE069           (    forth6809.asm):02705         VALUEW:     LDD   #DOVALUE
E073 BDDFF7           (    forth6809.asm):02706                     JSR   BLDDOES
E076 DC0A             (    forth6809.asm):02707                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E078 3606             (    forth6809.asm):02708                     PSHU  D                 ; See bugfix: VALUEW.1
E07A BDDF26           (    forth6809.asm):02709                     JSR   CODECOMMA
E07D BDDF38           (    forth6809.asm):02710                     JSR   VCOMMAW           ; store x in the variable area
E080 39               (    forth6809.asm):02711                     RTS
                      (    forth6809.asm):02712         
                      (    forth6809.asm):02713         ; ------------------------------------------------------------
                      (    forth6809.asm):02714         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):02715         ; lower address as 2@ expects.
                      (    forth6809.asm):02716         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):02717         ; ------------------------------------------------------------
E081 7EF36F           (    forth6809.asm):02718         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):02719         
                      (    forth6809.asm):02720         ; ------------------------------------------------------------
                      (    forth6809.asm):02721         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):02722         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):02723         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):02724         ; ------------------------------------------------------------
E084 CCE081           (    forth6809.asm):02725         TWOVALUEW:  LDD   #DO2VALUE
E087 BDDFF7           (    forth6809.asm):02726                     JSR   BLDDOES
E08A DC0A             (    forth6809.asm):02727                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E08C 3606             (    forth6809.asm):02728                     PSHU  D
E08E BDDF26           (    forth6809.asm):02729                     JSR   CODECOMMA
E091 BDDF38           (    forth6809.asm):02730                     JSR   VCOMMAW           ; x2 at the lower address
E094 BDDF38           (    forth6809.asm):02731                     JSR   VCOMMAW           ; then x1
E097 39               (    forth6809.asm):02732                     RTS
                      (    forth6809.asm):02733         
                      (    forth6809.asm):02734         ; ------------------------------------------------------------
                      (    forth6809.asm):02735         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02736         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02737         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02738         ; ------------------------------------------------------------
E098 CC0020           (    forth6809.asm):02739         TOW:        LDD   #32
E09B 3606             (    forth6809.asm):02740                     PSHU  D
E09D BDE2A0           (    forth6809.asm):02741                     JSR   WORDW
E0A0 BDE312           (    forth6809.asm):02742                     JSR   FINDW
E0A3 3706             (    forth6809.asm):02743                     PULU  D
E0A5 10830000         (    forth6809.asm):02744                     CMPD  #0
E0A9 260A             (    forth6809.asm):02745                     BNE   TOFOUND
E0AB 3706             (    forth6809.asm):02746                     PULU  D
E0AD CCFFF3           (    forth6809.asm):02747                     LDD   #-13
E0B0 3606             (    forth6809.asm):02748                     PSHU  D
E0B2 BDE561           (    forth6809.asm):02749                     JSR   THROWW
E0B5 AEC4             (    forth6809.asm):02750         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
E0B7 EC03             (    forth6809.asm):02751                     LDD   3,X
E0B9 1083E081         (    forth6809.asm):02752                     CMPD  #DO2VALUE
E0BD 271A             (    forth6809.asm):02753                     BEQ   TOTWO
E0BF BDEA5D           (    forth6809.asm):02754                     JSR   TOBODYW
E0C2 DC00             (    forth6809.asm):02755                     LDD   STATE
E0C4 270C             (    forth6809.asm):02756                     BEQ   TOIMMED
E0C6 BDE9A9           (    forth6809.asm):02757                     JSR   LITERALW
E0C9 CCF350           (    forth6809.asm):02758                     LDD   #STOREW
E0CC 3606             (    forth6809.asm):02759                     PSHU  D
E0CE BDE99C           (    forth6809.asm):02760                     JSR   CCALL
E0D1 39               (    forth6809.asm):02761                     RTS
E0D2 3710             (    forth6809.asm):02762         TOIMMED:    PULU  X                 ; a-addr of the value cell
E0D4 3706             (    forth6809.asm):02763                     PULU  D                 ; x
E0D6 ED84             (    forth6809.asm):02764                     STD   ,X
E0D8 39               (    forth6809.asm):02765                     RTS
E0D9 BDEA5D           (    forth6809.asm):02766         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
E0DC DC00             (    forth6809.asm):02767                     LDD   STATE
E0DE 270C             (    forth6809.asm):02768                     BEQ   TOTWOIMM
E0E0 BDE9A9           (    forth6809.asm):02769                     JSR   LITERALW
E0E3 CCF37A           (    forth6809.asm):02770                     LDD   #TWOSTOREW
E0E6 3606             (    forth6809.asm):02771                     PSHU  D
E0E8 BDE99C           (    forth6809.asm):02772                     JSR   CCALL
E0EB 39               (    forth6809.asm):02773                     RTS
E0EC 7EF37A           (    forth6809.asm):02774         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):02775         
                      (    forth6809.asm):02776         ; ------------------------------------------------------------
                      (    forth6809.asm):02777         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02778         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02779         ; the variable area, initialised to zero.
                      (    forth6809.asm):02780         ; ------------------------------------------------------------
E0EF                  (    forth6809.asm):02781         TWOVARIABLEW:
E0EF CC0000           (    forth6809.asm):02782                     LDD   #0
E0F2 3606             (    forth6809.asm):02783                     PSHU  D
E0F4 BDDF78           (    forth6809.asm):02784                     JSR   HEADER
E0F7 CCDEBB           (    forth6809.asm):02785                     LDD   #DODOES
E0FA 3606             (    forth6809.asm):02786                     PSHU  D
E0FC BDE99C           (    forth6809.asm):02787                     JSR   CCALL
E0FF CCDEC6           (    forth6809.asm):02788                     LDD   #DOESRT0
E102 3606             (    forth6809.asm):02789                     PSHU  D
E104 BDDF26           (    forth6809.asm):02790                     JSR   CODECOMMA
E107 DC0A             (    forth6809.asm):02791                     LDD   VARHERE

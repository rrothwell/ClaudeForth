                      (    forth6809.asm):03970         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03971         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03972         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03973         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03974         ; ------------------------------------------------------------
E74A 3706             (    forth6809.asm):03975         REPEATW:    PULU  D
E74C 10830001         (    forth6809.asm):03976                     CMPD  #TAGFWD
E750 2703             (    forth6809.asm):03977                     BEQ   RPOK1
E752 BDE5D5           (    forth6809.asm):03978                     JSR   CFERR
E755 3710             (    forth6809.asm):03979         RPOK1:      PULU  X                 ; orig
E757 9F46             (    forth6809.asm):03980                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03981         
                      (    forth6809.asm):03982                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03983                     ; See bugfix: REPEATW.1
E759 3040             (    forth6809.asm):03984                     LEAX  0,U               ; scan from top of control stack
E75B 9F2B             (    forth6809.asm):03985                     STX   MSCR2             ; MSCR2 = base of scan region
E75D 9F2F             (    forth6809.asm):03986                     STX   MSCR4             ; MSCR4 = scan pointer
E75F DC2F             (    forth6809.asm):03987         RPSCAN:     LDD   MSCR4
E761 109348           (    forth6809.asm):03988                     CMPD  CSP
E764 2603             (    forth6809.asm):03989                     BNE   RPSCANOK
E766 BDE5D5           (    forth6809.asm):03990                     JSR   CFERR             ; no matching BEGIN
E769 9E2F             (    forth6809.asm):03991         RPSCANOK:   LDX   MSCR4
E76B EC84             (    forth6809.asm):03992                     LDD   ,X
E76D 10830002         (    forth6809.asm):03993                     CMPD  #TAGBACK
E771 2712             (    forth6809.asm):03994                     BEQ   RPFOUND
E773 10830001         (    forth6809.asm):03995                     CMPD  #TAGFWD
E777 2703             (    forth6809.asm):03996                     BEQ   RPSKIP
E779 BDE5D5           (    forth6809.asm):03997                     JSR   CFERR             ; anything else is a genuine mismatch
E77C DC2F             (    forth6809.asm):03998         RPSKIP:     LDD   MSCR4
E77E C30004           (    forth6809.asm):03999                     ADDD  #4
E781 DD2F             (    forth6809.asm):04000                     STD   MSCR4
E783 20DA             (    forth6809.asm):04001                     BRA   RPSCAN
E785 9E2F             (    forth6809.asm):04002         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E787 EC02             (    forth6809.asm):04003                     LDD   2,X               ; dest = BEGIN's address
E789 DD44             (    forth6809.asm):04004                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):04005         
                      (    forth6809.asm):04006                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04007                     ; bytes, highest word first.
E78B DC2F             (    forth6809.asm):04008                     LDD   MSCR4
E78D 932B             (    forth6809.asm):04009                     SUBD  MSCR2
E78F DD2D             (    forth6809.asm):04010                     STD   MSCR3             ; MSCR3 = bytes to shift
E791 2715             (    forth6809.asm):04011                     BEQ   RPSHIFTDONE
E793 DC2D             (    forth6809.asm):04012         RPSHIFT:    LDD   MSCR3
E795 830002           (    forth6809.asm):04013                     SUBD  #2
E798 DD2D             (    forth6809.asm):04014                     STD   MSCR3
E79A 9E2B             (    forth6809.asm):04015                     LDX   MSCR2
E79C 308B             (    forth6809.asm):04016                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E79E EC84             (    forth6809.asm):04017                     LDD   ,X
E7A0 3004             (    forth6809.asm):04018                     LEAX  4,X
E7A2 ED84             (    forth6809.asm):04019                     STD   ,X                ; copy one word 4 bytes higher
E7A4 DC2D             (    forth6809.asm):04020                     LDD   MSCR3
E7A6 26EB             (    forth6809.asm):04021                     BNE   RPSHIFT
E7A8                  (    forth6809.asm):04022         RPSHIFTDONE:
E7A8 9E2B             (    forth6809.asm):04023                     LDX   MSCR2
E7AA 3004             (    forth6809.asm):04024                     LEAX  4,X
E7AC 1F13             (    forth6809.asm):04025                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04026         
E7AE CCDE8B           (    forth6809.asm):04027                     LDD   #BRANCH
E7B1 3606             (    forth6809.asm):04028                     PSHU  D
E7B3 BDEA85           (    forth6809.asm):04029                     JSR   CCALL
E7B6 CC0000           (    forth6809.asm):04030                     LDD   #0
E7B9 3606             (    forth6809.asm):04031                     PSHU  D
E7BB BDDF08           (    forth6809.asm):04032                     JSR   CODECOMMA
E7BE DC08             (    forth6809.asm):04033                     LDD   CODEHERE
E7C0 830002           (    forth6809.asm):04034                     SUBD  #2
E7C3 DD2D             (    forth6809.asm):04035                     STD   MSCR3             ; MSCR3 = branch operand address
E7C5 DC44             (    forth6809.asm):04036                     LDD   PFIELD            ; target = BEGIN's address
E7C7 3606             (    forth6809.asm):04037                     PSHU  D
E7C9 DC2D             (    forth6809.asm):04038                     LDD   MSCR3             ; location = the operand just compiled
E7CB 3606             (    forth6809.asm):04039                     PSHU  D

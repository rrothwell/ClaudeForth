                      (    forth6809.asm):13971         ; ------------------------------------------------------------
                      (    forth6809.asm):13972         ; TSTSIGN - unit test for SIGN. Deliberately poisons the CPU
                      (    forth6809.asm):13973         ; flags with an unrelated CMPX (setting them to reflect a
                      (    forth6809.asm):13974         ; positive comparison result, without touching D or the value
                      (    forth6809.asm):13975         ; about to be pushed) immediately before each PSHU/JSR SIGN
                      (    forth6809.asm):13976         ; call - specifically so this test exercises the exact scenario
                      (    forth6809.asm):13977         ; the word's own bug-fix comment says was previously broken (a
                      (    forth6809.asm):13978         ; direct, standalone call not preceded by a flag-setting LDD of
                      (    forth6809.asm):13979         ; the true value), rather than relying on the same kind of
                      (    forth6809.asm):13980         ; caller-side luck that hid the original bug. Two sub-cases:
                      (    forth6809.asm):13981         ; negative (with flags poisoned toward positive, confirming the
                      (    forth6809.asm):13982         ; minus sign still gets added - would fail if SIGN reverted to
                      (    forth6809.asm):13983         ; testing stale flags instead of the value it just popped) and
                      (    forth6809.asm):13984         ; positive (with flags poisoned toward negative, confirming no
                      (    forth6809.asm):13985         ; minus sign gets added incorrectly).
                      (    forth6809.asm):13986         ; ------------------------------------------------------------
C2C5                  (    forth6809.asm):13987         TSTSIGN: LDD  CODEHERE
                      (    forth6809.asm):13988                  STD  TSTCSAV
                      (    forth6809.asm):13989         
                      (    forth6809.asm):13990                  LDD  #TSTCBUF
                      (    forth6809.asm):13991                  STD  CODEHERE
                      (    forth6809.asm):13992         
                      (    forth6809.asm):13993                  STU  TSTU0
                      (    forth6809.asm):13994         
                      (    forth6809.asm):13995                  LDD  #TSTGUARD
                      (    forth6809.asm):13996                  PSHU D
                      (    forth6809.asm):13997                  STU  TSTUB4
                      (    forth6809.asm):13998         
                      (    forth6809.asm):13999                  JSR  LTNUM
                      (    forth6809.asm):14000         
                      (    forth6809.asm):14001                  LDD  #-5
                      (    forth6809.asm):14002                  LDX  #1
                      (    forth6809.asm):14003                  CMPX #0
                      (    forth6809.asm):14004                  PSHU D
                      (    forth6809.asm):14005                  JSR  SIGN
                      (    forth6809.asm):14006         
                      (    forth6809.asm):14007                  LDX  HLD
                      (    forth6809.asm):14008                  LDA  ,X
                      (    forth6809.asm):14009                  CMPA #'-'
                      (    forth6809.asm):14010                  BNE  SGFAIL
                      (    forth6809.asm):14011         
                      (    forth6809.asm):14012                  JSR  LTNUM
                      (    forth6809.asm):14013         
                      (    forth6809.asm):14014                  LDD  #5
                      (    forth6809.asm):14015                  LDX  #-1
                      (    forth6809.asm):14016                  CMPX #0
                      (    forth6809.asm):14017                  PSHU D

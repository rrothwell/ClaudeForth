                      (    forth6809.asm):03449                  TFR   A,B
                      (    forth6809.asm):03450                  CLRA
                      (    forth6809.asm):03451                  PSHU  D
                      (    forth6809.asm):03452                  RTS
                      (    forth6809.asm):03453         
E684                  (    forth6809.asm):03454         KEYQ:    LDA   ACIASR
                      (    forth6809.asm):03455                  BITA  #SR_RDRF
                      (    forth6809.asm):03456                  BEQ   KQFALSE
                      (    forth6809.asm):03457                  LDD   #TRUEV
                      (    forth6809.asm):03458                  PSHU  D
                      (    forth6809.asm):03459                  RTS
E684                  (    forth6809.asm):03460         KQFALSE: LDD   #FALSEV
                      (    forth6809.asm):03461                  PSHU  D
                      (    forth6809.asm):03462                  RTS
                      (    forth6809.asm):03463         
E684                  (    forth6809.asm):03464         EMIT:    PULU  D
                      (    forth6809.asm):03465                  STB   EMITCH
E684                  (    forth6809.asm):03466         EMITWT:  LDA   ACIASR
                      (    forth6809.asm):03467                  BITA  #SR_TDRE
                      (    forth6809.asm):03468                  BEQ   EMITWT
                      (    forth6809.asm):03469                  LDA   EMITCH
                      (    forth6809.asm):03470                  STA   ACIADR
                      (    forth6809.asm):03471                  RTS
                      (    forth6809.asm):03472         
                      (    forth6809.asm):03473         ; ------------------------------------------------------------
                      (    forth6809.asm):03474         ; ECHOEMIT - trivial pass-through to EMIT under polling mode.
                      (    forth6809.asm):03475         ; The deadlock ECHOEMIT (above, SERIALPOLL=0 branch) guards
                      (    forth6809.asm):03476         ; against is specific to interrupt-driven RTS/CTS handshaking,
                      (    forth6809.asm):03477         ; which does not exist under SERIALPOLL=1 at all (per this
                      (    forth6809.asm):03478         ; flag's own header comment: "no interrupts, no ring buffers, no
                      (    forth6809.asm):03479         ; RTS/CTS handshaking") - polling-mode EMIT already cannot
                      (    forth6809.asm):03480         ; deadlock this way, so ACCEPT's own call to ECHOEMIT can safely
                      (    forth6809.asm):03481         ; just be the real EMIT here.
                      (    forth6809.asm):03482         ; ------------------------------------------------------------
E684                  (    forth6809.asm):03483         ECHOEMIT: JSR   EMIT
                      (    forth6809.asm):03484                   RTS
                      (    forth6809.asm):03485         

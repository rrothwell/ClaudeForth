                      (    forth6809.asm):16532         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):16533         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):16534         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):16535         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):16536         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):16537         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):16538         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):16539         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):16540         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):16541         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):16542         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):16543         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):16544                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):16545                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):16546                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):16547                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):16548                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):16549                  FDB   ABORT
                      (    forth6809.asm):16550         
DEBE 04               (    forth6809.asm):16551         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):16552                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):16553                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):16554                  FDB   QUIT
                      (    forth6809.asm):16555         
                      (    forth6809.asm):16556         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):16557         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):16558         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):16559         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):16560         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):16561         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):16562         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):16563                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):16564                  FDB   H_QUIT
DECE E476             (    forth6809.asm):16565                  FDB   FIND
                      (    forth6809.asm):16566         
DED0 01               (    forth6809.asm):16567         H_1:     FCB   1
DED1 31               (    forth6809.asm):16568                  FCC   "1"
DED2 DEC7             (    forth6809.asm):16569                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):16570                  FDB   ONEBODY
                      (    forth6809.asm):16571         
DED6 02               (    forth6809.asm):16572         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):16573                  FCC   "-1"
DED9 DED0             (    forth6809.asm):16574                  FDB   H_1
DEDB FF49             (    forth6809.asm):16575                  FDB   MONEBODY
                      (    forth6809.asm):16576         
DEDD 01               (    forth6809.asm):16577         H_2:     FCB   1
DEDE 32               (    forth6809.asm):16578                  FCC   "2"
DEDF DED6             (    forth6809.asm):16579                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):16580                  FDB   TWOBODY
                      (    forth6809.asm):16581         
DEE3 02               (    forth6809.asm):16582         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):16583                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):16584                  FDB   H_2
DEE8 FF55             (    forth6809.asm):16585                  FDB   MTWOBODY
                      (    forth6809.asm):16586         
     DEE3             (    forth6809.asm):16587         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):16588                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):16589                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):16590                                   ; were chained on after it; before that,
                      (    forth6809.asm):16591                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):16592                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):16593                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):16594                                   ; before this one.
                      (    forth6809.asm):16595         
                      (    forth6809.asm):16596         ; Verify no collision with base code.
                      (    forth6809.asm):16597         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):16598         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):16599         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):16600         
                      (    forth6809.asm):16601         ; ============================================================
                      (    forth6809.asm):16602         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):16603         ; ============================================================
                      (    forth6809.asm):16604                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):16605                                        ; entirely - every routine from here through
                      (    forth6809.asm):16606                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):16607                                        ; every primitive) would otherwise have
                      (    forth6809.asm):16608                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):16609                                        ; WARM message left the location counter,
                      (    forth6809.asm):16610                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):16611                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):16612                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):16613         
                      (    forth6809.asm):16614         ; ------------------------------------------------------------
                      (    forth6809.asm):16615         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):16616         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):16617         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):16618         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):16619         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):16620         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):16621         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):16622                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):16623                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):16624                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):16625                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):16626                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):16627                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):16628                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):16629                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):16630                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):16631                  RTS
                      (    forth6809.asm):16632         
                      (    forth6809.asm):16633                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):16634         ; ------------------------------------------------------------
                      (    forth6809.asm):16635         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):16636         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):16637         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):16638         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):16639         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16640         INFILL:  LDA   INHEAD
                      (    forth6809.asm):16641                  SUBA  INTAIL
                      (    forth6809.asm):16642                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):16643                  RTS
                      (    forth6809.asm):16644         
                      (    forth6809.asm):16645         ; ------------------------------------------------------------
                      (    forth6809.asm):16646         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):16647         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):16648         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):16649         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):16650         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):16651         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):16652         ; flow control, not a chip feature.
                      (    forth6809.asm):16653         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16654         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):16655                     CMPA #INHIWATER
                      (    forth6809.asm):16656                     BLO  RTSCHIDONE
                      (    forth6809.asm):16657                     TST  RTSSTATE
                      (    forth6809.asm):16658                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):16659                     LDA  #CR_RTSHI
                      (    forth6809.asm):16660                     STA  ACIACR
                      (    forth6809.asm):16661                     LDA  #1
                      (    forth6809.asm):16662                     STA  RTSSTATE
DEF5                  (    forth6809.asm):16663         RTSCHIDONE: RTS
                      (    forth6809.asm):16664         
                      (    forth6809.asm):16665         ; ------------------------------------------------------------
                      (    forth6809.asm):16666         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):16667         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):16668         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):16669         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):16670         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):16671         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):16672         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):16673         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):16674         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):16675         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16676         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):16677                     CMPA #INLOWATER
                      (    forth6809.asm):16678                     BHI  RTSCLODONE
                      (    forth6809.asm):16679                     TST  RTSSTATE
                      (    forth6809.asm):16680                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):16681                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):16682                     CLR  RTSSTATE
                      (    forth6809.asm):16683                     LDB  OUTTAIL
                      (    forth6809.asm):16684                     CMPB OUTHEAD
                      (    forth6809.asm):16685                     BEQ  RTSCLONOTX
                      (    forth6809.asm):16686                     LDA  #CR_RXTX
                      (    forth6809.asm):16687                     STA  ACIACR
                      (    forth6809.asm):16688                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):16689         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):16690                     STA  ACIACR
DEF5                  (    forth6809.asm):16691         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):16692         RTSCLODONE: RTS
                      (    forth6809.asm):16693         
DEF5                  (    forth6809.asm):16694         IRQH:    LDA   ACIASR
                      (    forth6809.asm):16695                  BITA  #SR_IRQ
                      (    forth6809.asm):16696                  BEQ   IRQDONE
                      (    forth6809.asm):16697         
                      (    forth6809.asm):16698                  BITA  #SR_RDRF
                      (    forth6809.asm):16699                  BEQ   TXCHK
                      (    forth6809.asm):16700         
                      (    forth6809.asm):16701                  LDB   INHEAD
                      (    forth6809.asm):16702                  LDA   ACIADR
                      (    forth6809.asm):16703                  LDX   #INBUF
                      (    forth6809.asm):16704                  STA   B,X

DA5F C30004           (    forth6809.asm):04968                     ADDD  #4
DA62 DD1A             (    forth6809.asm):04969                     STD   MSCR4
DA64 20DA             (    forth6809.asm):04970                     BRA   RPSCAN
DA66 9E1A             (    forth6809.asm):04971         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
DA68 EC02             (    forth6809.asm):04972                     LDD   2,X               ; dest = BEGIN's address
DA6A 3406             (    forth6809.asm):04973                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04974         
                      (    forth6809.asm):04975                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04976                     ; bytes, highest word first.
DA6C DC1A             (    forth6809.asm):04977                     LDD   MSCR4
DA6E 9316             (    forth6809.asm):04978                     SUBD  MSCR2
DA70 DD18             (    forth6809.asm):04979                     STD   MSCR3             ; MSCR3 = bytes to shift
DA72 2715             (    forth6809.asm):04980                     BEQ   RPSHIFTDONE
DA74 DC18             (    forth6809.asm):04981         RPSHIFT:    LDD   MSCR3
DA76 830002           (    forth6809.asm):04982                     SUBD  #2
DA79 DD18             (    forth6809.asm):04983                     STD   MSCR3
DA7B 9E16             (    forth6809.asm):04984                     LDX   MSCR2
DA7D 308B             (    forth6809.asm):04985                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DA7F EC84             (    forth6809.asm):04986                     LDD   ,X
DA81 3004             (    forth6809.asm):04987                     LEAX  4,X
DA83 ED84             (    forth6809.asm):04988                     STD   ,X                ; copy one word 4 bytes higher
DA85 DC18             (    forth6809.asm):04989                     LDD   MSCR3
DA87 26EB             (    forth6809.asm):04990                     BNE   RPSHIFT
DA89                  (    forth6809.asm):04991         RPSHIFTDONE:
DA89 9E16             (    forth6809.asm):04992                     LDX   MSCR2
DA8B 3004             (    forth6809.asm):04993                     LEAX  4,X
DA8D 1F13             (    forth6809.asm):04994                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04995         
DA8F CCCF4F           (    forth6809.asm):04996                     LDD   #BRANCH
DA92 3606             (    forth6809.asm):04997                     PSHU  D
DA94 BDDD40           (    forth6809.asm):04998                     JSR   CCALL
DA97 CC0000           (    forth6809.asm):04999                     LDD   #0
DA9A 3606             (    forth6809.asm):05000                     PSHU  D
DA9C BDCFD6           (    forth6809.asm):05001                     JSR   CODECOMMA
DA9F EC60             (    forth6809.asm):05002                     LDD   0,S               ; target = BEGIN's address
DAA1 3606             (    forth6809.asm):05003                     PSHU  D
DAA3 DC08             (    forth6809.asm):05004                     LDD   CODEHERE
DAA5 830002           (    forth6809.asm):05005                     SUBD  #2                ; location = the operand just compiled
DAA8 3606             (    forth6809.asm):05006                     PSHU  D
DAAA BDD93A           (    forth6809.asm):05007                     JSR   PATCH
DAAD DC08             (    forth6809.asm):05008                     LDD   CODEHERE
DAAF 3606             (    forth6809.asm):05009                     PSHU  D
DAB1 EC62             (    forth6809.asm):05010                     LDD   2,S               ; orig
DAB3 3606             (    forth6809.asm):05011                     PSHU  D
DAB5 BDD93A           (    forth6809.asm):05012                     JSR   PATCH
DAB8 3264             (    forth6809.asm):05013                     LEAS  4,S               ; drop the frame
DABA 39               (    forth6809.asm):05014                     RTS
                      (    forth6809.asm):05015         

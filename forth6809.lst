E042 AE4A             (    forth6809.asm):05890         DROTW:      LDX   10,U              ; x1
E044 10AE48           (    forth6809.asm):05891                     LDY   8,U               ; x2
E047 EC46             (    forth6809.asm):05892                     LDD   6,U
E049 ED4A             (    forth6809.asm):05893                     STD   10,U
E04B EC44             (    forth6809.asm):05894                     LDD   4,U
E04D ED48             (    forth6809.asm):05895                     STD   8,U

                      (    forth6809.asm):03246         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03247         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03248         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03249         ;    Inputs:
                      (    forth6809.asm):03250         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03251         ;    Outputs:
                      (    forth6809.asm):03252         ;        single number: n and -1
                      (    forth6809.asm):03253         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03254         ;        not a number: c-addr and 0
                      (    forth6809.asm):03255         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03256         ; ------------------------------------------------------------

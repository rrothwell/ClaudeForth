                      (    forth6809.asm):07961         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):07962         ; ============================================================
                      (    forth6809.asm):07963         ; ------------------------------------------------------------
                      (    forth6809.asm):07964         ; TRUE  ( -- flag )
                      (    forth6809.asm):07965         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):07966         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):07967         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):07968         ; ------------------------------------------------------------

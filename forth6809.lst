                      (    forth6809.asm):02071                    BRA   NPDONE
C18C                  (    forth6809.asm):02072         NPFAIL:    LDD   #FALSEV
C18C                  (    forth6809.asm):02073         NPDONE:    LDX   #TSTNIPNAME
                      (    forth6809.asm):02074                    PSHU  X
                      (    forth6809.asm):02075                    PSHU  D
                      (    forth6809.asm):02076                    JSR   TSTREPORT
                      (    forth6809.asm):02077         

                      (    forth6809.asm):02946         ; NONAME (":NONAME", CORE EXT): like COLON, but deliberately skips
                      (    forth6809.asm):02947         ; HEADER entirely - no WORD call (consumes no name from the input),
                      (    forth6809.asm):02948         ; no new header written at DPHERE, and LATEST is left completely
                      (    forth6809.asm):02949         ; untouched. That's the ANS-required "no-name" definition: never
                      (    forth6809.asm):02950         ; findable by FIND, never linked into the dictionary chain at all.
                      (    forth6809.asm):02951         ; In this subroutine-threaded system the execution token IS the code
                      (    forth6809.asm):02952         ; address (no separate CFA indirection, unlike CREATE's DODOES
                      (    forth6809.asm):02953         ; trampoline), so the xt ANS requires :NONAME to leave on the stack
                      (    forth6809.asm):02954         ; is simply CODEHERE at this instant - identical to what HEREW
                      (    forth6809.asm):02955         ; returns - pushed BEFORE compilation of the body begins, matching
                      (    forth6809.asm):02956         ; where ANS says :NONAME produces it. CSP is snapshotted AFTER that
                      (    forth6809.asm):02957         ; push (mirroring COLON's own CSP snapshot, taken after HEADER's
                      (    forth6809.asm):02958         ; transient pushes/pops have already netted back to baseline) so
                      (    forth6809.asm):02959         ; SEMI's control-flow consistency check at ";" only catches a
                      (    forth6809.asm):02960         ; genuinely unbalanced IF/DO etc. left over from the body, not the
                      (    forth6809.asm):02961         ; xt itself, which is meant to still be there when ";" returns.
                      (    forth6809.asm):02962         ; SEMI itself needs no changes: its unsmudge-the-word-at-LATEST step
                      (    forth6809.asm):02963         ; still targets whatever LATEST already was (the previous NAMED
                      (    forth6809.asm):02964         ; word, untouched by this routine) - a harmless no-op there, since a
                      (    forth6809.asm):02965         ; normal definition is already unsmudged by the time any later
                      (    forth6809.asm):02966         ; definition's SEMI runs.
DFAD DC08             (    forth6809.asm):02967         NONAME:  LDD   CODEHERE
DFAF 3606             (    forth6809.asm):02968                  PSHU  D
DFB1 1F30             (    forth6809.asm):02969                  TFR   U,D
DFB3 DD48             (    forth6809.asm):02970                  STD   CSP
DFB5 CCFFFF           (    forth6809.asm):02971                  LDD   #-1
DFB8 DD00             (    forth6809.asm):02972                  STD   STATE
DFBA 39               (    forth6809.asm):02973                  RTS
                      (    forth6809.asm):02974         
DFBB CC0000           (    forth6809.asm):02975         CREATE:  LDD   #0
DFBE 3606             (    forth6809.asm):02976                  PSHU  D

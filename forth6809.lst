E912 EC62             (    forth6809.asm):04194                     LDD   2,S
E914 D329             (    forth6809.asm):04195                     ADDD  MSCR              ; new_index = old_index + step
E916 ED62             (    forth6809.asm):04196                     STD   2,S
E918 A364             (    forth6809.asm):04197                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E91A DD2D             (    forth6809.asm):04198                     STD   MSCR3
                      (    forth6809.asm):04199                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04200                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04201                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

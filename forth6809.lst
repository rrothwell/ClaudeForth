                      (    forth6809.asm):02288         ; ------------------------------------------------------------
                      (    forth6809.asm):02289         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02290         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02291         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02292         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02293         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02294         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02295         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02296         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02297         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02298         ;
                      (    forth6809.asm):02299         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02300         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02301         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02302         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02303         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02304         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02305         ;
                      (    forth6809.asm):02306         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02307         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02308         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02309         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02310         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02311         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02312         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02313         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02314         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02315         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02316         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02317         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02318         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02319         ; ------------------------------------------------------------
DE6F B6C008           (    forth6809.asm):02320         IRQH:    LDA   ACIASR          ; Get the status.
                      (    forth6809.asm):02321         
DE72 8580             (    forth6809.asm):02322                  BITA  #SR_IRQ         ; Is the ACIA the interrupt source?
DE74 2708             (    forth6809.asm):02323                  BEQ   IRQDONE
DE76 8501             (    forth6809.asm):02324                  BITA  #SR_RDRF        ; Is an incoming character available?
DE78 2605             (    forth6809.asm):02325                  BNE   INCHAR
DE7A 8502             (    forth6809.asm):02326                  BITA  #SR_TDRE        ; Is the slot for an outgoing character available?
DE7C 2639             (    forth6809.asm):02327                  BNE   OUTCHAR
                      (    forth6809.asm):02328                                        ; Ignore all other interrupts such as DCD change.
DE7E 3B               (    forth6809.asm):02329         IRQDONE: RTI                   ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02330                                         ; & restores state.
                      (    forth6809.asm):02331         
DE7F                  (    forth6809.asm):02332         INCHAR:
DE7F F6C009           (    forth6809.asm):02333                  LDB   ACIADR                ; Clear RDRF with any error flag.
DE82 8570             (    forth6809.asm):02334                  BITA  #SR_FE+SR_OVRN+SR_PE  ; Any receiver error flagged?
DE84 2717             (    forth6809.asm):02335                  BEQ   INOK                  ; No! - character is good, keep it.
                      (    forth6809.asm):02336                                              
DE86 8510             (    forth6809.asm):02337                  BITA  #SR_FE                ; Yes! char is corrupted, discard it.
DE88 2703             (    forth6809.asm):02338                  BEQ   INXFE                 ; Tally each flagged error independently -
DE8A 7C017C           (    forth6809.asm):02339                  INC   FECOUNT               ; more than one bit can be set at once.
DE8D 8520             (    forth6809.asm):02340         INXFE:   BITA  #SR_OVRN
DE8F 2703             (    forth6809.asm):02341                  BEQ   INXOVRN
DE91 7C017D           (    forth6809.asm):02342                  INC   OVRNCOUNT
DE94 8540             (    forth6809.asm):02343         INXOVRN: BITA  #SR_PE
DE96 2703             (    forth6809.asm):02344                  BEQ   INXPE
DE98 7C017E           (    forth6809.asm):02345                  INC   PECOUNT 
DE9B 20E1             (    forth6809.asm):02346         INXPE:   BRA   IRQDONE         
                      (    forth6809.asm):02347         
DE9D 1F98             (    forth6809.asm):02348         INOK:    TFR   B,A             ; Transfer good character from the receiver.
DE9F 8E0180           (    forth6809.asm):02349                  LDX   #INBUF          ; Store it in the empty in buffer slot.
DEA2 F60176           (    forth6809.asm):02350                  LDB   INHEAD
DEA5 A785             (    forth6809.asm):02351                  STA   B,X
DEA7 5C               (    forth6809.asm):02352                  INCB                  ; Figure out the new head,
DEA8 C43F             (    forth6809.asm):02353                  ANDB  #INBUFSZ-1      ; pointing to the next the empty in buffer slot.
DEAA F10177           (    forth6809.asm):02354                  CMPB  INTAIL          ; Would the new head slot meet the tail?
DEAD 27CF             (    forth6809.asm):02355                  BEQ   IRQDONE         ; Don't allow it - buffer full, drop the character.
DEAF F70176           (    forth6809.asm):02356                  STB   INHEAD          ; New head pointer is OK so store it.
                      (    forth6809.asm):02357                  ;JSR   RTSCHECKHI     ; Protect the in buffer from overflow.
DEB2 BDDD98           (    forth6809.asm):02358                  JSR   CHKWATERLEVEL   ; Protect the in buffer from overflow.
DEB5 20C7             (    forth6809.asm):02359                  BRA   IRQDONE
                      (    forth6809.asm):02360         
DEB7                  (    forth6809.asm):02361         OUTCHAR:

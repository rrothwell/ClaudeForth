E514 3606             (    forth6809.asm):03272                     PSHU  D
E516 39               (    forth6809.asm):03273                     RTS
                      (    forth6809.asm):03274         
E517                  (    forth6809.asm):03275         NQSINGLE:                           ; SINGLE success - unchanged from the original convention
E517 DC48             (    forth6809.asm):03276                     LDD   UDLO
E519 3606             (    forth6809.asm):03277                     PSHU  D
E51B CCFFFF           (    forth6809.asm):03278                     LDD   #-1
E51E 3606             (    forth6809.asm):03279                     PSHU  D
E520 39               (    forth6809.asm):03280                     RTS
                      (    forth6809.asm):03281         

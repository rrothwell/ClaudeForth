                      (   unit_tests.asm):06982         ; TSTUNLOOP - unit test for UNLOOP. UNLOOP discards the 3-cell
                      (   unit_tests.asm):06983         ; DO frame (index, limit, LEAVE flag = 6 bytes) that sits on the
                      (   unit_tests.asm):06984         ; return stack directly beneath its own return address, and
                      (   unit_tests.asm):06985         ; leaves the data stack alone. The test pushes a fake 6-byte
                      (   unit_tests.asm):06986         ; frame on S, calls UNLOOP, and checks S rose by exactly 6 and U
                      (   unit_tests.asm):06987         ; did not move. (Rewritten: UNLOOP used to be a bare RTS, and the
                      (   unit_tests.asm):06988         ; old test called it with no frame on S - with the real UNLOOP
                      (   unit_tests.asm):06989         ; that would discard six bytes of the test's own return
                      (   unit_tests.asm):06990         ; addresses and crash the run.) Scratch: TSTUB4/TSTUAF hold the
                      (   unit_tests.asm):06991         ; S values here, TSTSCR holds U.
                      (   unit_tests.asm):06992         ; ------------------------------------------------------------
C248                  (   unit_tests.asm):06993         TSTUNLOOP:  STU   TSTU0
                      (   unit_tests.asm):06994         
                      (   unit_tests.asm):06995                     LDD   #TSTVAL1
                      (   unit_tests.asm):06996                     PSHS  D                 ; fake frame: LEAVE flag
                      (   unit_tests.asm):06997                     LDD   #TSTVAL2
                      (   unit_tests.asm):06998                     PSHS  D                 ;             limit
                      (   unit_tests.asm):06999                     LDD   #TSTVAL1
                      (   unit_tests.asm):07000                     PSHS  D                 ;             index
                      (   unit_tests.asm):07001                     STS   TSTUB4            ; S with the fake frame in place
                      (   unit_tests.asm):07002                     STU   TSTSCR            ; U before
                      (   unit_tests.asm):07003         
                      (   unit_tests.asm):07004                     JSR   UNLOOP
                      (   unit_tests.asm):07005         
                      (   unit_tests.asm):07006                     STS   TSTUAF            ; S after
                      (   unit_tests.asm):07007         
                      (   unit_tests.asm):07008                     LDD   TSTUAF
                      (   unit_tests.asm):07009                     SUBD  TSTUB4
                      (   unit_tests.asm):07010                     CMPD  #6
                      (   unit_tests.asm):07011                     BNE   UOFAIL
                      (   unit_tests.asm):07012                     CMPU  TSTSCR
                      (   unit_tests.asm):07013                     BNE   UOFAIL
                      (   unit_tests.asm):07014         

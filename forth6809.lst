                      (    forth6809.asm):10816         ; ------------------------------------------------------------
                      (    forth6809.asm):10817         ; TSTABORTQ2 - unit test for ABORT", true-flag case. Same
                      (    forth6809.asm):10818         ; compiled snippet as TSTABORTQ1, executed via CATCH with a true
                      (    forth6809.asm):10819         ; flag instead. Confirmed by reading DOABORTQUOTE's own code
                      (    forth6809.asm):10820         ; that it uses THROW -2 internally, not the raw, never-returns
                      (    forth6809.asm):10821         ; ABORT mechanism plain ABORT itself uses (which remains
                      (    forth6809.asm):10822         ; deliberately untested, per section 3.1's own reasoning) - so
                      (    forth6809.asm):10823         ; this case is safe to test directly, unlike plain ABORT would
                      (    forth6809.asm):10824         ; be.
                      (    forth6809.asm):10825         ; ------------------------------------------------------------
C27E                  (    forth6809.asm):10826         TSTABORTQ2: LDD  CODEHERE
                      (    forth6809.asm):10827                     STD  TSTCSAV
                      (    forth6809.asm):10828                     LDD  SRCADDR
                      (    forth6809.asm):10829                     STD  TSTSASAV
                      (    forth6809.asm):10830                     LDD  SRCLEN
                      (    forth6809.asm):10831                     STD  TSTSLSAV
                      (    forth6809.asm):10832                     LDD  TOIN
                      (    forth6809.asm):10833                     STD  TSTTISAV
                      (    forth6809.asm):10834                     LDD  STATE
                      (    forth6809.asm):10835                     STD  TSTSTSAV
                      (    forth6809.asm):10836         
                      (    forth6809.asm):10837                     LDA  #'H'
                      (    forth6809.asm):10838                     STA  TSTNAMEB
                      (    forth6809.asm):10839                     LDA  #'I'
                      (    forth6809.asm):10840                     STA  TSTNAMEB+1
                      (    forth6809.asm):10841                     LDA  #34
                      (    forth6809.asm):10842                     STA  TSTNAMEB+2
                      (    forth6809.asm):10843         
                      (    forth6809.asm):10844                     LDD  #TSTCBUF
                      (    forth6809.asm):10845                     STD  CODEHERE
                      (    forth6809.asm):10846                     LDD  #TSTNAMEB
                      (    forth6809.asm):10847                     STD  SRCADDR
                      (    forth6809.asm):10848                     LDD  #3
                      (    forth6809.asm):10849                     STD  SRCLEN
                      (    forth6809.asm):10850                     LDD  #0
                      (    forth6809.asm):10851                     STD  TOIN
                      (    forth6809.asm):10852                     LDD  #-1
                      (    forth6809.asm):10853                     STD  STATE
                      (    forth6809.asm):10854         
                      (    forth6809.asm):10855                     JSR  ABORTQUOTE
                      (    forth6809.asm):10856         
                      (    forth6809.asm):10857                     LDD  #OPRTS
                      (    forth6809.asm):10858                     PSHU D
                      (    forth6809.asm):10859                     JSR  CCOMMA
                      (    forth6809.asm):10860         
                      (    forth6809.asm):10861                     LDD  TSTCSAV
                      (    forth6809.asm):10862                     STD  CODEHERE
                      (    forth6809.asm):10863                     LDD  TSTSASAV
                      (    forth6809.asm):10864                     STD  SRCADDR
                      (    forth6809.asm):10865                     LDD  TSTSLSAV
                      (    forth6809.asm):10866                     STD  SRCLEN
                      (    forth6809.asm):10867                     LDD  TSTTISAV
                      (    forth6809.asm):10868                     STD  TOIN
                      (    forth6809.asm):10869                     LDD  TSTSTSAV
                      (    forth6809.asm):10870                     STD  STATE
                      (    forth6809.asm):10871         
                      (    forth6809.asm):10872                     STU  TSTU0
                      (    forth6809.asm):10873         
                      (    forth6809.asm):10874                     LDD  #TRUEV
                      (    forth6809.asm):10875                     PSHU D
                      (    forth6809.asm):10876                     LDX  #TSTCBUF
                      (    forth6809.asm):10877                     PSHU X
                      (    forth6809.asm):10878                     STU  TSTUB4
                      (    forth6809.asm):10879         
                      (    forth6809.asm):10880                     JSR  CATCH
                      (    forth6809.asm):10881         
                      (    forth6809.asm):10882                     STU  TSTUAF
                      (    forth6809.asm):10883         

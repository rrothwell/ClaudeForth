                      (    forth6809.asm):06361         
                      (    forth6809.asm):06362         ; ------------------------------------------------------------
                      (    forth6809.asm):06363         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06364         ; Parse up to the closing quote. When compiling, compile DOSTR
                      (    forth6809.asm):06365         ; followed by the counted string. When interpreting, copy the string
                      (    forth6809.asm):06366         ; to PAD and return its address and length.
                      (    forth6809.asm):06367         ; A 3-byte gap is reserved at CODEHERE while WORD parses, so that the
                      (    forth6809.asm):06368         ; compiled JSR DOSTR does not overwrite the text being staged.
                      (    forth6809.asm):06369         ; ------------------------------------------------------------
                      (    forth6809.asm):06370         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06371         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06372         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06373         ; PARSEQUOTE
                      (    forth6809.asm):06374         ;    Inputs:
                      (    forth6809.asm):06375         ;        none (parses from >IN)
                      (    forth6809.asm):06376         ;    Outputs:
                      (    forth6809.asm):06377         ;        SCNT = length, SPTR = address of the text in the input buffer.
                      (    forth6809.asm):06378         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06379         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06380         ; ------------------------------------------------------------
F453 CC0022           (    forth6809.asm):06381         PARSEQUOTE: LDD   #34
F456 3606             (    forth6809.asm):06382                     PSHU  D
F458 BDF54E           (    forth6809.asm):06383                     JSR   PARSEW
F45B 3706             (    forth6809.asm):06384                     PULU  D                 ; length
F45D 4D               (    forth6809.asm):06385                     TSTA
F45E 2607             (    forth6809.asm):06386                     BNE   PQLONG
F460 D743             (    forth6809.asm):06387                     STB   SCNT

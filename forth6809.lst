                      (    forth6809.asm):09456         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):09457         ; ============================================================
                      (    forth6809.asm):09458         ; ------------------------------------------------------------
                      (    forth6809.asm):09459         ; TRUE  ( -- flag )
                      (    forth6809.asm):09460         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):09461         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):09462         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):09463         ; ------------------------------------------------------------
F4C3 CCFFFF           (    forth6809.asm):09464         TRUEW:      LDD   #$FFFF

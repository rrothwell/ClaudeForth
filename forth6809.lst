                      (    forth6809.asm):06726         ; REPLACES  ( c-addr1 u1 c-addr2 u2 -- )
                      (    forth6809.asm):06727         ; Register the substitution text c-addr1 u1 for the name c-addr2 u2.
                      (    forth6809.asm):06728         ; Only one registration is kept (a single slot); a new call replaces
                      (    forth6809.asm):06729         ; the previous one. The strings are not copied.
                      (    forth6809.asm):06730         ; Original comment: shadow REPLACESW.0.
                      (    forth6809.asm):06731         ; ------------------------------------------------------------
F665 ECC4             (    forth6809.asm):06732         REPLACESW:  LDD   ,U                ; Parameters stay on the data stack: u2 at

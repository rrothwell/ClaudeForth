                      (    forth6809.asm):06764         ; Find the REPLACES entry for a name, newest first.
                      (    forth6809.asm):06765         ; SUBFIND
                      (    forth6809.asm):06766         ;    Inputs:
                      (    forth6809.asm):06767         ;        RegD = name length, RegX = name address
                      (    forth6809.asm):06768         ;    Outputs:
                      (    forth6809.asm):06769         ;        RegX = entry address, or 0 if there is none. An entry is: 0 link,
                      (    forth6809.asm):06770         ;        2 name length, 3 text length, 4 text capacity, 5 name, then text.
                      (    forth6809.asm):06771         ;    Registers: RegA, RegB, RegX and RegY changed. A length over 255 is
                      (    forth6809.asm):06772         ;        never found.
                      (    forth6809.asm):06773         ; ------------------------------------------------------------
F6BD 4D               (    forth6809.asm):06774         SUBFIND:    TSTA

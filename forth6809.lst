                      (    forth6809.asm):01881         ; ------------------------------------------------------------
                      (    forth6809.asm):01882         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):01883         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):01884         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):01885         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):01886         ; IRQH
                      (    forth6809.asm):01887         ;    Inputs:
                      (    forth6809.asm):01888         ;        none (hardware interrupt entry)
                      (    forth6809.asm):01889         ;    Outputs:
                      (    forth6809.asm):01890         ;        none (returns with RTI)
                      (    forth6809.asm):01891         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):01892         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):01893         ; ------------------------------------------------------------
DE0F B6C008           (    forth6809.asm):01894         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):01895         
DE12 8580             (    forth6809.asm):01896                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DE14 2708             (    forth6809.asm):01897                     BEQ   IRQDONE0          ; No! Just exit.
DE16 8501             (    forth6809.asm):01898                     BITA  #SR_RDRF          ; Is an incoming character available?
DE18 2605             (    forth6809.asm):01899                     BNE   INCHAR
DE1A 8502             (    forth6809.asm):01900                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DE1C 263C             (    forth6809.asm):01901                     BNE   OUTCHAR
                      (    forth6809.asm):01902                                             ; Ignore all other interrupts such as DCD change.
DE1E 3B               (    forth6809.asm):01903         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):01904                                             ; & restores state.
                      (    forth6809.asm):01905         

                      (    forth6809.asm):09072         ; TSTISOF - unit test for IS and ACTION-OF together. Compiles
                      (    forth6809.asm):09073         ; "DEFER TESTWD", interprets "DUP IS TESTWD" directly (IS parses
                      (    forth6809.asm):09074         ; "TESTWD" via WORD+FIND, needing LATEST still pointed at it -
                      (    forth6809.asm):09075         ; not restored until this whole test finishes), executes TESTWD
                      (    forth6809.asm):09076         ; (should now behave like DUP), then interprets "ACTION-OF
                      (    forth6809.asm):09077         ; TESTWD" to fetch the current target by name and confirms it
                      (    forth6809.asm):09078         ; matches DUP's own xt. Explicitly forces STATE=0 before both IS
                      (    forth6809.asm):09079         ; and ACTION-OF, since both are documented to behave differently
                      (    forth6809.asm):09080         ; by STATE, same reasoning as TSTVALTO's own TO test.
                      (    forth6809.asm):09081         ; ------------------------------------------------------------
C100                  (    forth6809.asm):09082         TSTISOF: LDD   CODEHERE
                      (    forth6809.asm):09083                  STD   TSTCSAV
                      (    forth6809.asm):09084                  LDD   DPHERE
                      (    forth6809.asm):09085                  STD   TSTDSAV
                      (    forth6809.asm):09086                  LDD   VARHERE
                      (    forth6809.asm):09087                  STD   TSTVSAV
                      (    forth6809.asm):09088                  LDD   SRCADDR
                      (    forth6809.asm):09089                  STD   TSTSASAV
                      (    forth6809.asm):09090                  LDD   SRCLEN
                      (    forth6809.asm):09091                  STD   TSTSLSAV
                      (    forth6809.asm):09092                  LDD   TOIN
                      (    forth6809.asm):09093                  STD   TSTTISAV
                      (    forth6809.asm):09094                  LDD   STATE
                      (    forth6809.asm):09095                  STD   TSTSTSAV
                      (    forth6809.asm):09096                  LDD   LATEST
                      (    forth6809.asm):09097                  STD   TSTLSAV
                      (    forth6809.asm):09098         
                      (    forth6809.asm):09099                  LDA   #'T'
                      (    forth6809.asm):09100                  STA   TSTNAMEB
                      (    forth6809.asm):09101                  LDA   #'E'
                      (    forth6809.asm):09102                  STA   TSTNAMEB+1
                      (    forth6809.asm):09103                  LDA   #'S'
                      (    forth6809.asm):09104                  STA   TSTNAMEB+2
                      (    forth6809.asm):09105                  LDA   #'T'
                      (    forth6809.asm):09106                  STA   TSTNAMEB+3
                      (    forth6809.asm):09107                  LDA   #'W'
                      (    forth6809.asm):09108                  STA   TSTNAMEB+4

     DBEA             (    forth6809.asm):01782         BASELATEST  EQU   H_BACKSLASH         ; head of the ROM dictionary (see COLD)
                      (    forth6809.asm):01783         
                      (    forth6809.asm):01784         ; Verify no collision with base code.
                      (    forth6809.asm):01785         ; Value should match ORG BASECODE
     DBF0             (    forth6809.asm):01786         BASEDICTEND EQU   *
     08CE             (    forth6809.asm):01787         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01788         
                      (    forth6809.asm):01789         ; ============================================================
                      (    forth6809.asm):01790         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01791         ; ============================================================
                      (    forth6809.asm):01792                     ORG   BASECODE          ; See bugfix: BASECODE.1
                      (    forth6809.asm):01793         
                      (    forth6809.asm):01794         ; ------------------------------------------------------------
                      (    forth6809.asm):01795         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01796         ; receiver-error counters to zero.
                      (    forth6809.asm):01797         ; SERBUFCLR
                      (    forth6809.asm):01798         ;    Inputs:
                      (    forth6809.asm):01799         ;        none
                      (    forth6809.asm):01800         ;    Outputs:
                      (    forth6809.asm):01801         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01802         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01803         ;    Registers: only CC changed.
                      (    forth6809.asm):01804         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01805         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01806         ; ------------------------------------------------------------
                      (    forth6809.asm):01807         
DBF0 7F0176           (    forth6809.asm):01808         SERBUFCLR:  CLR   INHEAD
DBF3 7F0177           (    forth6809.asm):01809                     CLR   INTAIL
DBF6 7F0178           (    forth6809.asm):01810                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
DBF9 7F0179           (    forth6809.asm):01811                     CLR   OUTHEAD
DBFC 7F017A           (    forth6809.asm):01812                     CLR   OUTTAIL
DBFF 7F017B           (    forth6809.asm):01813                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01814         
                      (    forth6809.asm):01815         
DC02 7F017C           (    forth6809.asm):01816                     CLR   FECOUNT
DC05 7F017D           (    forth6809.asm):01817                     CLR   OVRNCOUNT
DC08 7F017E           (    forth6809.asm):01818                     CLR   PECOUNT
DC0B 7F017F           (    forth6809.asm):01819                     CLR   POLLREADYCNT
DC0E 39               (    forth6809.asm):01820                     RTS
                      (    forth6809.asm):01821         
                      (    forth6809.asm):01822         ; ------------------------------------------------------------
                      (    forth6809.asm):01823         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01824         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01825         ; INITSERIAL
                      (    forth6809.asm):01826         ;    Inputs:
                      (    forth6809.asm):01827         ;        none
                      (    forth6809.asm):01828         ;    Outputs:
                      (    forth6809.asm):01829         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01830         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01831         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01832         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01833         ; ------------------------------------------------------------
DC0F BDDBF0           (    forth6809.asm):01834         INITSERIAL: JSR   SERBUFCLR
DC12 8603             (    forth6809.asm):01835                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
DC14 B7C008           (    forth6809.asm):01836                     STA   ACIACR
DC17 12               (    forth6809.asm):01837                     NOP                     ; Settling Delay
DC18 12               (    forth6809.asm):01838                     NOP
                      (    forth6809.asm):01839         
                      (    forth6809.asm):01840                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
DC19 8695             (    forth6809.asm):01841                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01842                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):01843                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01844                     ENDC                    ; <<<<<<<<<<
DC1B B7C008           (    forth6809.asm):01845                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DC1E 39               (    forth6809.asm):01846                     RTS
                      (    forth6809.asm):01847         
                      (    forth6809.asm):01848                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01849         ; ------------------------------------------------------------
                      (    forth6809.asm):01850         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01851         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01852         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01853         ; INFILL
                      (    forth6809.asm):01854         ;    Inputs:
                      (    forth6809.asm):01855         ;        none
                      (    forth6809.asm):01856         ;    Outputs:
                      (    forth6809.asm):01857         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01858         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01859         ; ------------------------------------------------------------
DC1F B60176           (    forth6809.asm):01860         INFILL:     LDA   INHEAD
DC22 B00177           (    forth6809.asm):01861                     SUBA  INTAIL
DC25 843F             (    forth6809.asm):01862                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DC27 39               (    forth6809.asm):01863                     RTS
                      (    forth6809.asm):01864         ; ------------------------------------------------------------
                      (    forth6809.asm):01865         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01866         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01867         ; receive path with interrupts already masked.
                      (    forth6809.asm):01868         ; RTSCHECKHI
                      (    forth6809.asm):01869         ;    Inputs:
                      (    forth6809.asm):01870         ;        none
                      (    forth6809.asm):01871         ;    Outputs:
                      (    forth6809.asm):01872         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01873         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01874         ; ------------------------------------------------------------
DC28 BDDC1F           (    forth6809.asm):01875         RTSCHECKHI: JSR   INFILL
DC2B 8130             (    forth6809.asm):01876                     CMPA  #INHIWATER
DC2D 250F             (    forth6809.asm):01877                     BLO   RTSCHIDONE
DC2F 7D0178           (    forth6809.asm):01878                     TST   RTSSTATE
DC32 260A             (    forth6809.asm):01879                     BNE   RTSCHIDONE        ; already high - nothing to do
DC34 86D5             (    forth6809.asm):01880                     LDA   #CR_RTSHI
DC36 B7C008           (    forth6809.asm):01881                     STA   ACIACR
DC39 8601             (    forth6809.asm):01882                     LDA   #1
DC3B B70178           (    forth6809.asm):01883                     STA   RTSSTATE
DC3E 39               (    forth6809.asm):01884         RTSCHIDONE: RTS
                      (    forth6809.asm):01885         ; ------------------------------------------------------------
                      (    forth6809.asm):01886         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01887         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01888         ; enables it only while output is pending.
                      (    forth6809.asm):01889         ; UPDATE_RTS
                      (    forth6809.asm):01890         ;    Inputs:
                      (    forth6809.asm):01891         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01892         ;    Outputs:
                      (    forth6809.asm):01893         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01894         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01895         ; ------------------------------------------------------------
DC3F                  (    forth6809.asm):01896         UPDATE_RTS:
DC3F 7D0178           (    forth6809.asm):01897                     TST   RTSSTATE
DC42 260D             (    forth6809.asm):01898                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01899         
DC44 7D017B           (    forth6809.asm):01900                     TST   OUTACTIVITY       ; Is active?
DC47 2704             (    forth6809.asm):01901                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01902         
                      (    forth6809.asm):01903                                             ; $B5/%1011_0101
DC49 86B5             (    forth6809.asm):01904                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DC4B 2009             (    forth6809.asm):01905                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01906         

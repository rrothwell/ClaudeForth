                      (    forth6809.asm):11009                     ORG   INITCODE          ; init code block
                      (    forth6809.asm):11010         
                      (    forth6809.asm):11011         ; ------------------------------------------------------------
                      (    forth6809.asm):11012         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):11013         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):11014         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):11015         ; enter COLD.
                      (    forth6809.asm):11016         ; COLDSTRT
                      (    forth6809.asm):11017         ;    Inputs:
                      (    forth6809.asm):11018         ;        hardware reset
                      (    forth6809.asm):11019         ;    Outputs:
                      (    forth6809.asm):11020         ;        does not return
                      (    forth6809.asm):11021         ;    Registers: all registers initialised.
                      (    forth6809.asm):11022         ; ------------------------------------------------------------
FF9C                  (    forth6809.asm):11023         COLDSTRT:
FF9C 1A50             (    forth6809.asm):11024                     ORCC  #$50              ; Disable IRQ & FIRQ
FF9E 10CEC000         (    forth6809.asm):11025                     LDS   #RSTACK+1
FFA2 CEBD00           (    forth6809.asm):11026                     LDU   #DSTACK+1
FFA5 4F               (    forth6809.asm):11027                     CLRA
FFA6 1F8B             (    forth6809.asm):11028                     TFR   A,DP
                      (    forth6809.asm):11029         
FFA8 8E0000           (    forth6809.asm):11030                     LDX   #GLOBALS
FFAB C600             (    forth6809.asm):11031                     LDB   #0
FFAD 6F80             (    forth6809.asm):11032         CLRGLOB:    CLR   ,X+
FFAF 5A               (    forth6809.asm):11033                     DECB
FFB0 26FB             (    forth6809.asm):11034                     BNE   CLRGLOB
                      (    forth6809.asm):11035         
FFB2 BDD5E9           (    forth6809.asm):11036                     JSR   WLINIT            ; FIND must work for the unit tests too
                      (    forth6809.asm):11037         
FFB5 BDD917           (    forth6809.asm):11038                     JSR   COLDIO            ; no extra IRQ handlers; EMIT, KEY, KEY?
                      (    forth6809.asm):11039                                             ; use the ACIA
                      (    forth6809.asm):11040         
FFB8 BDCDAF           (    forth6809.asm):11041                     JSR   INITSERIAL
                      (    forth6809.asm):11042         
FFBB 1CAF             (    forth6809.asm):11043                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):11044         
                      (    forth6809.asm):11045                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):11046         
                      (    forth6809.asm):11047                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):11048                     JSR   TSTRUNNER
                      (    forth6809.asm):11049                     ELSE                    ; <<<<<>>>>>
FFBD 12               (    forth6809.asm):11050                     NOP                     ; same size as JSR TSTRUNNER
FFBE 12               (    forth6809.asm):11051                     NOP                     ; See bugfix: COLDSTRT.2
FFBF 12               (    forth6809.asm):11052                     NOP
                      (    forth6809.asm):11053                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):11054         
FFC0 7ECF54           (    forth6809.asm):11055                     JMP   COLD
                      (    forth6809.asm):11056         
                      (    forth6809.asm):11057         ; ------------------------------------------------------------
                      (    forth6809.asm):11058         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):11059         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):11060         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):11061         ; WARM
                      (    forth6809.asm):11062         ;    Inputs:
                      (    forth6809.asm):11063         ;        NMI
                      (    forth6809.asm):11064         ;    Outputs:
                      (    forth6809.asm):11065         ;        does not return
                      (    forth6809.asm):11066         ;    Registers: all registers initialised.
                      (    forth6809.asm):11067         ; ------------------------------------------------------------
FFC3 1A50             (    forth6809.asm):11068         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFC5 4F               (    forth6809.asm):11069                     CLRA
FFC6 1F8B             (    forth6809.asm):11070                     TFR   A,DP
FFC8 CEBD00           (    forth6809.asm):11071                     LDU   #SP0
FFCB 10CEC000         (    forth6809.asm):11072                     LDS   #RP0
                      (    forth6809.asm):11073         

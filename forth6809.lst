                      (    forth6809.asm):05514         ; ------------------------------------------------------------
                      (    forth6809.asm):05515         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05516         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05517         ; the string.
                      (    forth6809.asm):05518         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05519         ;    Inputs:
                      (    forth6809.asm):05520         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05521         ;        count byte
                      (    forth6809.asm):05522         ;    Outputs:
                      (    forth6809.asm):05523         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05524         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05525         ; ------------------------------------------------------------
E337                  (    forth6809.asm):05526         DOABORTQUOTE:
E337 3510             (    forth6809.asm):05527                     PULS  X
E339 E684             (    forth6809.asm):05528                     LDB   ,X
E33B 3001             (    forth6809.asm):05529                     LEAX  1,X               ; X = text, B = length
E33D 4F               (    forth6809.asm):05530                     CLRA
E33E 3720             (    forth6809.asm):05531                     PULU  Y                 ; flag
E340 108C0000         (    forth6809.asm):05532                     CMPY  #0
E344 2605             (    forth6809.asm):05533                     BNE   AQTHROW
E346 3085             (    forth6809.asm):05534                     LEAX  B,X
E348 3410             (    forth6809.asm):05535                     PSHS  X
E34A 39               (    forth6809.asm):05536                     RTS
E34B 3610             (    forth6809.asm):05537         AQTHROW:    PSHU  X
E34D 3606             (    forth6809.asm):05538                     PSHU  D
E34F BDEE24           (    forth6809.asm):05539                     JSR   TYPEW
E352 CCFFFE           (    forth6809.asm):05540                     LDD   #-2               ; -2
E355 3606             (    forth6809.asm):05541                     PSHU  D
E357 7EDE2F           (    forth6809.asm):05542                     JMP   THROWW
                      (    forth6809.asm):05543         
                      (    forth6809.asm):05544         ; ------------------------------------------------------------
                      (    forth6809.asm):05545         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05546         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):05547         ; as a counted string. THROW -14 if not compiling.

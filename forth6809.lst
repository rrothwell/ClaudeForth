                      (    forth6809.asm):00802         ; TSTDROP - unit test for DROP ( x -- ). Verifies both the
                      (    forth6809.asm):00803         ; stack's contents (the guard beneath the dropped value is left
                      (    forth6809.asm):00804         ; undisturbed, and is now the new top) and the data stack
                      (    forth6809.asm):00805         ; pointer's movement (exactly one cell, 2 bytes, freed - DROP's
                      (    forth6809.asm):00806         ; own net effect, not conflated with the two pushes that set the
                      (    forth6809.asm):00807         ; test up).
                      (    forth6809.asm):00808         ; ------------------------------------------------------------
C158                  (    forth6809.asm):00809         TSTDROP:   STU   TSTU0
                      (    forth6809.asm):00810         
                      (    forth6809.asm):00811                    LDD   #TSTGUARD

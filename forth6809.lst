                      (    forth6809.asm):02233                     BEQ   FLUSHED          ; Yes! Exit.
                      (    forth6809.asm):02234         
                      (    forth6809.asm):02235                     LDA   ACIASR           ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02236                     BITA  #SR_CTS
                      (    forth6809.asm):02237                     BNE   FLUSHED          ; Yes! Exit.
                      (    forth6809.asm):02238         
                      (    forth6809.asm):02239                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02240                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02241                                              ; than spin-wait here.
                      (    forth6809.asm):02242         
                      (    forth6809.asm):02243                     LDX   #OUTBUF         ; The out buffer is occupied.
                      (    forth6809.asm):02244                     LDA   B,X             ; Get the character from the out buffer.

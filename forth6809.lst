                      (    forth6809.asm):03473         ; ------------------------------------------------------------
                      (    forth6809.asm):03474         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03475         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03476         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03477         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03478         ; ------------------------------------------------------------
E579 335E             (    forth6809.asm):03479         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E57B CC0000           (    forth6809.asm):03480                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E57E EDC4             (    forth6809.asm):03481                     STD   ,U
                      (    forth6809.asm):03482         
                      (    forth6809.asm):03483                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03484                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03485                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03486                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03487                                             ; stream this line's characters
                      (    forth6809.asm):03488                     JSR   PUTXON
                      (    forth6809.asm):03489                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03490         

     54482076312E30
     000F             (    forth6809.asm):02153         SIGNONL     EQU   *-SIGNON
DF54 20206F6B         (    forth6809.asm):02154         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02155         OKMSGL      EQU   *-OKMSG
DF58 20204552524F5220 (    forth6809.asm):02156         ERRMSG:     FCC   "  ERROR "

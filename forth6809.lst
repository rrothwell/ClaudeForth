                      (    forth6809.asm):21322         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):21323         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):21324         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):21325         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):21326         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):21327         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):21328         ; ============================================================
                      (    forth6809.asm):21329         ; ------------------------------------------------------------
                      (    forth6809.asm):21330         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):21331         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):21332         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):21333         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):21334         ; - no indirection, no value cell.
                      (    forth6809.asm):21335         ;
                      (    forth6809.asm):21336         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):21337         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):21338         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):21339         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):21340         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):21341         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):21342         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):21343         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):21344         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):21345         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):21346         ; ------------------------------------------------------------

                      (    forth6809.asm):03560         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03561         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03562         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03563         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03564         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03565         ; ------------------------------------------------------------

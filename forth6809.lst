                      (    forth6809.asm):06791         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):06792         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):06793         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):06794         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):06795         ; (off-by-one, wrong direction, wrong starting value) would
                      (    forth6809.asm):06796         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (    forth6809.asm):06797         ; just "some number of iterations happened."
                      (    forth6809.asm):06798         ;

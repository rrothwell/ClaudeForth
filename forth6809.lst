                      (    forth6809.asm):02946         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):02947         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):02948         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):02949         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):02950         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):02951         ; ------------------------------------------------------------
E33D 3706             (    forth6809.asm):02952         WORDW:      PULU  D                 ; char

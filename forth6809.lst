                      (    forth6809.asm):12775                     FCC  "TSTSQUOTE2"
                      (    forth6809.asm):12776         
                      (    forth6809.asm):12777         ; ------------------------------------------------------------
                      (    forth6809.asm):12778         ; TSTDOTQUOTE - unit test for .". No STATE check at all in its
                      (    forth6809.asm):12779         ; own code (confirmed by reading it directly - matches "no
                      (    forth6809.asm):12780         ; interpretation semantics, per ANS" without a specific -14
                      (    forth6809.asm):12781         ; throw, unlike [CHAR]/S"), so only the compiling case is
                      (    forth6809.asm):12782         ; tested, matching how it's actually meant to be used. Its own
                      (    forth6809.asm):12783         ; runtime (DOTSTR) calls TYPE internally, which has two entirely
                      (    forth6809.asm):12784         ; different implementations gated by SERIALPOLL (the same real
                      (    forth6809.asm):12785         ; finding from section 3.1) - applying that lesson from the
                      (    forth6809.asm):12786         ; start here rather than re-discovering it: EMITCH works
                      (    forth6809.asm):12787         ; universally for a single-character check, but this outputs
                      (    forth6809.asm):12788         ; multiple characters, so - matching TSTCR's own established
                      (    forth6809.asm):12789         ; fix - the full OUTHEAD/OUTBUF check only applies under
                      (    forth6809.asm):12790         ; SERIALPOLL=0, with a narrower EMITCH-based check (last
                      (    forth6809.asm):12791         ; character only, plus the stack-depth check) for SERIALPOLL=1.
                      (    forth6809.asm):12792         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):12793         TSTDOTQUOTE: LDD  CODEHERE
                      (    forth6809.asm):12794                      STD  TSTCSAV
                      (    forth6809.asm):12795                      LDD  SRCADDR
                      (    forth6809.asm):12796                      STD  TSTSASAV
                      (    forth6809.asm):12797                      LDD  SRCLEN
                      (    forth6809.asm):12798                      STD  TSTSLSAV
                      (    forth6809.asm):12799                      LDD  TOIN
                      (    forth6809.asm):12800                      STD  TSTTISAV
                      (    forth6809.asm):12801         
                      (    forth6809.asm):12802                      LDA  #'H'
                      (    forth6809.asm):12803                      STA  TSTNAMEB
                      (    forth6809.asm):12804                      LDA  #'I'
                      (    forth6809.asm):12805                      STA  TSTNAMEB+1
                      (    forth6809.asm):12806                      LDA  #34
                      (    forth6809.asm):12807                      STA  TSTNAMEB+2
                      (    forth6809.asm):12808         
                      (    forth6809.asm):12809                      LDD  #TSTCBUF
                      (    forth6809.asm):12810                      STD  CODEHERE
                      (    forth6809.asm):12811                      LDD  #TSTNAMEB
                      (    forth6809.asm):12812                      STD  SRCADDR
                      (    forth6809.asm):12813                      LDD  #3
                      (    forth6809.asm):12814                      STD  SRCLEN
                      (    forth6809.asm):12815                      LDD  #0
                      (    forth6809.asm):12816                      STD  TOIN
                      (    forth6809.asm):12817         
                      (    forth6809.asm):12818                      JSR  DOTQUOTE
                      (    forth6809.asm):12819         
                      (    forth6809.asm):12820                      LDD  #OPRTS
                      (    forth6809.asm):12821                      PSHU D
                      (    forth6809.asm):12822                      JSR  CCOMMA
                      (    forth6809.asm):12823         
                      (    forth6809.asm):12824                      LDD  TSTCSAV
                      (    forth6809.asm):12825                      STD  CODEHERE
                      (    forth6809.asm):12826                      LDD  TSTSASAV
                      (    forth6809.asm):12827                      STD  SRCADDR
                      (    forth6809.asm):12828                      LDD  TSTSLSAV

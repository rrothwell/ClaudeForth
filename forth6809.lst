                      (    forth6809.asm):05921                                   ; COLD to initialize LATEST, and asserted in the
                      (    forth6809.asm):05922                                   ; SECTION 27 header comment below, but never
                      (    forth6809.asm):05923                                   ; actually defined anywhere until now: an
                      (    forth6809.asm):05924                                   ; undefined-symbol bug, not a placeholder
                      (    forth6809.asm):05925         
                      (    forth6809.asm):05926         ; ------------------------------------------------------------
                      (    forth6809.asm):05927         ; TRUE / FALSE - CONSTANT TRUE -1 / CONSTANT FALSE 0. The first
                      (    forth6809.asm):05928         ; CONSTANT-pattern ROM-resident words in this system: every
                      (    forth6809.asm):05929         ; other ROM word's CFA is a plain code label (a real routine),
                      (    forth6809.asm):05930         ; but a CONSTANT's CFA is the DODOES trampoline pattern (JSR
                      (    forth6809.asm):05931         ; DODOES + FDB ATSIGN + FDB <value-cell-address>), matching
                      (    forth6809.asm):05932         ; exactly what interactive CONSTANT compiles at runtime - the
                      (    forth6809.asm):05933         ; only difference is the value-cell address is a fixed, known-
                      (    forth6809.asm):05934         ; at-assemble-time label here (TRUEVAL/FALSEVAL) rather than a
                      (    forth6809.asm):05935         ; CODEHERE snapshot captured dynamically. DODOES pushes the
                      (    forth6809.asm):05936         ; value stored at the PFA field (the address in TRUEVAL/
                      (    forth6809.asm):05937         ; FALSEVAL); ATSIGN then fetches through that address, yielding
                      (    forth6809.asm):05938         ; the actual -1 / 0 - the same indirection interactive CONSTANT
                      (    forth6809.asm):05939         ; relies on, just with fixed addresses instead of a runtime one.
                      (    forth6809.asm):05940         ; ------------------------------------------------------------
FEBB BDE0EC           (    forth6809.asm):05941         TRUEBODY:  JSR   DODOES
FEBE E279             (    forth6809.asm):05942                    FDB   ATSIGN
FEC0 FEC2             (    forth6809.asm):05943                    FDB   TRUEVAL
FEC2 FFFF             (    forth6809.asm):05944         TRUEVAL:   FDB   -1
                      (    forth6809.asm):05945         
FEC4 BDE0EC           (    forth6809.asm):05946         FALSEBODY: JSR   DODOES
FEC7 E279             (    forth6809.asm):05947                    FDB   ATSIGN
FEC9 FECB             (    forth6809.asm):05948                    FDB   FALSEVAL
FECB 0000             (    forth6809.asm):05949         FALSEVAL:  FDB   0
                      (    forth6809.asm):05950         

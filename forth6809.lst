                      (    forth6809.asm):15912         ; TSTEVALUATE - unit test for EVALUATE. Evaluates the string
                      (    forth6809.asm):15913         ; "1 2 +" (confirmed safe via INTERPRET's own code: it simply
                      (    forth6809.asm):15914         ; stops and returns when input is exhausted, no automatic
                      (    forth6809.asm):15915         ; REFILL, so no blocking risk) - verifies the result (3) lands
                      (    forth6809.asm):15916         ; on the data stack, and that the whole input-source state
                      (    forth6809.asm):15917         ; (SRCADDR/SRCLEN/SRCID/TOIN) is genuinely restored to what it
                      (    forth6809.asm):15918         ; was before the call, not left pointing at the evaluated
                      (    forth6809.asm):15919         ; string. BASE is explicitly saved/set/restored too, per section
                      (    forth6809.asm):15920         ; 3.13's own established lesson, so "1"/"2" parse as decimal
                      (    forth6809.asm):15921         ; regardless of what BASE happened to hold at test time.
                      (    forth6809.asm):15922         ; ------------------------------------------------------------
C33E                  (    forth6809.asm):15923         TSTEVALUATE: LDD  SRCADDR
                      (    forth6809.asm):15924                      STD  TSTSASAV
                      (    forth6809.asm):15925                      LDD  SRCLEN
                      (    forth6809.asm):15926                      STD  TSTSLSAV
                      (    forth6809.asm):15927                      LDD  SRCID
                      (    forth6809.asm):15928                      STD  TSTSISAV
                      (    forth6809.asm):15929                      LDD  TOIN
                      (    forth6809.asm):15930                      STD  TSTTISAV
                      (    forth6809.asm):15931                      LDD  BASE
                      (    forth6809.asm):15932                      STD  TSTBASAV
                      (    forth6809.asm):15933                      LDD  LATEST
                      (    forth6809.asm):15934                      STD  TSTLSAV
                      (    forth6809.asm):15935                      LDD  CODEHERE
                      (    forth6809.asm):15936                      STD  TSTCSAV
                      (    forth6809.asm):15937         
                      (    forth6809.asm):15938                      LDD  #10
                      (    forth6809.asm):15939                      STD  BASE
                      (    forth6809.asm):15940                      LDD  #BASELATEST  ; BUG FIX: confirmed via MAME - LATEST,
                      (    forth6809.asm):15941                      STD  LATEST       ; like BASE, is only set by COLD (right
                      (    forth6809.asm):15942                                         ; alongside "BASE=10", in the very same
                      (    forth6809.asm):15943                                         ; init block), which hasn't run yet at
                      (    forth6809.asm):15944                                         ; this whole test framework's own,
                      (    forth6809.asm):15945                                         ; pre-COLD execution point. With
                      (    forth6809.asm):15946                                         ; LATEST=0, FIND reports every word,
                      (    forth6809.asm):15947                                         ; including the real "+" this test
                      (    forth6809.asm):15948                                         ; evaluates, as not found - INTERPRET
                      (    forth6809.asm):15949                                         ; then falls through trying to parse
                      (    forth6809.asm):15950                                         ; "+" as a number, fails that too, and
                      (    forth6809.asm):15951                                         ; throws an error this test never
                      (    forth6809.asm):15952                                         ; catches, landing at THUNCAU's own
                      (    forth6809.asm):15953                                         ; JMP ABORT - which resets the return
                      (    forth6809.asm):15954                                         ; stack, explaining exactly why the
                      (    forth6809.asm):15955                                         ; user's own test run terminated
                      (    forth6809.asm):15956                                         ; without ever reaching TSTENVQUERY1/2/
                      (    forth6809.asm):15957                                         ; 3. The same class of gap as section
                      (    forth6809.asm):15958                                         ; 3.13's own BASE=0 finding, just for a
                      (    forth6809.asm):15959                                         ; different variable this section's
                      (    forth6809.asm):15960                                         ; own EVALUATE test was the first to
                      (    forth6809.asm):15961                                         ; genuinely depend on.
                      (    forth6809.asm):15962         
                      (    forth6809.asm):15963                      LDD  #TSTCBUF2  ; SECOND BUG FIX: the LATEST fix above
                      (    forth6809.asm):15964                      STD  CODEHERE   ; alone didn't resolve this - confirmed
                      (    forth6809.asm):15965                                         ; via a second MAME run (the failure
                      (    forth6809.asm):15966                                         ; persisted, with the terminal output
                      (    forth6809.asm):15967                                         ; varying between runs, a strong sign
                      (    forth6809.asm):15968                                         ; of memory corruption rather than a
                      (    forth6809.asm):15969                                         ; single deterministic missing-value
                      (    forth6809.asm):15970                                         ; problem). Root cause: CODEHERE, like
                      (    forth6809.asm):15971                                         ; BASE and LATEST, is only set by COLD
                      (    forth6809.asm):15972                                         ; and was never redirected by this
                      (    forth6809.asm):15973                                         ; test at all - unlike every other
                      (    forth6809.asm):15974                                         ; test in this whole session involving
                      (    forth6809.asm):15975                                         ; WORD (which EVALUATE's own internal
                      (    forth6809.asm):15976                                         ; JSR INTERPRET calls repeatedly, once
                      (    forth6809.asm):15977                                         ; per token). With CODEHERE=0
                      (    forth6809.asm):15978                                         ; (unredirected), WORD's own write of
                      (    forth6809.asm):15979                                         ; each parsed token's [len][text]
                      (    forth6809.asm):15980                                         ; landed straight at address $0000 -
                      (    forth6809.asm):15981                                         ; which is STATE's own address (offset
                      (    forth6809.asm):15982                                         ; $00, the very first bytes of
                      (    forth6809.asm):15983                                         ; GLOBALS, confirmed by re-reading its
                      (    forth6809.asm):15984                                         ; own RMB declaration directly). Even
                      (    forth6809.asm):15985                                         ; a single-character token like "1"
                      (    forth6809.asm):15986                                         ; overwrites STATE with a nonzero
                      (    forth6809.asm):15987                                         ; value, flipping INTERPRET into
                      (    forth6809.asm):15988                                         ; thinking it's compiling rather than
                      (    forth6809.asm):15989                                         ; interpreting mid-parse - explaining
                      (    forth6809.asm):15990                                         ; both the sequence's own termination
                      (    forth6809.asm):15991                                         ; and why the visible output varied
                      (    forth6809.asm):15992                                         ; between runs (the exact corruption
                      (    forth6809.asm):15993                                         ; pattern depends on residual memory
                      (    forth6809.asm):15994                                         ; state from whatever ran immediately
                      (    forth6809.asm):15995                                         ; before). Redirected to TSTCBUF2, not
                      (    forth6809.asm):15996                                         ; TSTCBUF, specifically because TSTCBUF
                      (    forth6809.asm):15997                                         ; already holds this test's own source
                      (    forth6809.asm):15998                                         ; string ("1 2 +") - redirecting to the
                      (    forth6809.asm):15999                                         ; same buffer would let WORD overwrite
                      (    forth6809.asm):16000                                         ; the very source text still being
                      (    forth6809.asm):16001                                         ; parsed.
                      (    forth6809.asm):16002         
                      (    forth6809.asm):16003                      LDA  #'1'
                      (    forth6809.asm):16004                      STA  TSTCBUF
                      (    forth6809.asm):16005                      LDA  #32
                      (    forth6809.asm):16006                      STA  TSTCBUF+1
                      (    forth6809.asm):16007                      LDA  #'2'
                      (    forth6809.asm):16008                      STA  TSTCBUF+2
                      (    forth6809.asm):16009                      LDA  #32
                      (    forth6809.asm):16010                      STA  TSTCBUF+3
                      (    forth6809.asm):16011                      LDA  #'+'
                      (    forth6809.asm):16012                      STA  TSTCBUF+4

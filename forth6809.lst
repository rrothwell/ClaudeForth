DE2F BDF59B           (    forth6809.asm):02162                     JSR   TYPEW
DE32 DCFB             (    forth6809.asm):02163                     LDD   QTHROWCODE
DE34 3606             (    forth6809.asm):02164                     PSHU  D                 ; n
DE36 BDFA30           (    forth6809.asm):02165                     JSR   DOTW
DE39 20A0             (    forth6809.asm):02166                     BRA   QLOOP
                      (    forth6809.asm):02167         
DE3B BDFBC1           (    forth6809.asm):02168         QOK:        JSR   CRW               ; See bugfix: QOK.1
DE3E DC00             (    forth6809.asm):02169                     LDD   STATE
DE40 2699             (    forth6809.asm):02170                     BNE   QLOOP
DE42 8EDE60           (    forth6809.asm):02171                     LDX   #OKMSG
DE45 3610             (    forth6809.asm):02172                     PSHU  X                 ; c-addr
DE47 CC0004           (    forth6809.asm):02173                     LDD   #OKMSGL
DE4A 3606             (    forth6809.asm):02174                     PSHU  D                 ; u
DE4C BDF59B           (    forth6809.asm):02175                     JSR   TYPEW
DE4F 208A             (    forth6809.asm):02176                     BRA   QLOOP
                      (    forth6809.asm):02177         
DE51 3638303920464F52 (    forth6809.asm):02178         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02179         SIGNONL     EQU   *-SIGNON
DE60 20206F6B         (    forth6809.asm):02180         OKMSG:      FCC   "  ok"

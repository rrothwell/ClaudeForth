E872 2711             (    forth6809.asm):07471                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
E874 AE44             (    forth6809.asm):07472                     LDX   4,U
E876 308B             (    forth6809.asm):07473                     LEAX  D,X               ; X = one past the end of the source
E878 10AE42           (    forth6809.asm):07474                     LDY   2,U
E87B 31AB             (    forth6809.asm):07475                     LEAY  D,Y               ; Y = one past the end of the destination
E87D A682             (    forth6809.asm):07476         CGLOOP:     LDA   ,-X
E87F A7A2             (    forth6809.asm):07477                     STA   ,-Y
E881 AC44             (    forth6809.asm):07478                     CMPX  4,U               ; back at the start of the source?
E883 26F8             (    forth6809.asm):07479                     BNE   CGLOOP
E885 3346             (    forth6809.asm):07480         CGDONE:     LEAU  6,U               ; drop the three parameters
E887 39               (    forth6809.asm):07481                     RTS

                      (    forth6809.asm):15399         ; TSTCOMMENTS - comments tests (glossary section 3.16, 2 words).
                      (    forth6809.asm):15400         ; Both immediate and parse from source, so both redirect
                      (    forth6809.asm):15401         ; SRCADDR/SRCLEN/TOIN, matching the established pattern from
                      (    forth6809.asm):15402         ; sections 3.8-3.12. ( specifically carries real bug-fix history
                      (    forth6809.asm):15403         ; (a stray value left on the data stack, confirmed and fixed via
                      (    forth6809.asm):15404         ; MAME in a prior session) that this section's own test verifies
                      (    forth6809.asm):15405         ; directly - the data stack is genuinely unchanged after a
                      (    forth6809.asm):15406         ; comment, not just that parsing advanced correctly.
                      (    forth6809.asm):15407         ; ------------------------------------------------------------
C305 BDFC2B           (    forth6809.asm):15408         TSTCOMMENTS: JSR CRW
C308 8EC319           (    forth6809.asm):15409                    LDX   #TSTCOMMSG
C30B 3610             (    forth6809.asm):15410                    PSHU  X
C30D CC0008           (    forth6809.asm):15411                    LDD   #8
C310 3606             (    forth6809.asm):15412                    PSHU  D
C312 BDF60B           (    forth6809.asm):15413                    JSR   TYPE
C315 BDFC2B           (    forth6809.asm):15414                    JSR   CRW
                      (    forth6809.asm):15415         
                      (    forth6809.asm):15416                    IFEQ TSTSELECTOR-15  ; >>>>
                      (    forth6809.asm):15417         
                      (    forth6809.asm):15418                    JSR   TSTLPAREN
                      (    forth6809.asm):15419                    JSR   TSTBACKSLASH
                      (    forth6809.asm):15420         
                      (    forth6809.asm):15421                    ENDC ; <<<<
                      (    forth6809.asm):15422         
C318 39               (    forth6809.asm):15423                    RTS
                      (    forth6809.asm):15424         
C319 436F6D6D656E7473 (    forth6809.asm):15425         TSTCOMMSG: FCC "Comments"
                      (    forth6809.asm):15426         
                      (    forth6809.asm):15427                    IFEQ TSTSELECTOR-15  ; >>>>
                      (    forth6809.asm):15428         
                      (    forth6809.asm):15429         ; ------------------------------------------------------------
                      (    forth6809.asm):15430         ; Comments test harness (glossary section 3.16). Both words
                      (    forth6809.asm):15431         ; parse from source, so both redirect SRCADDR/SRCLEN/TOIN,
                      (    forth6809.asm):15432         ; matching the established pattern from sections 3.8-3.12.
                      (    forth6809.asm):15433         ;
                      (    forth6809.asm):15434         ; ( specifically carries real bug-fix history worth verifying
                      (    forth6809.asm):15435         ; directly, not just noting: a prior version omitted consuming
                      (    forth6809.asm):15436         ; WORD's own returned c-addr, leaving a stray value on the data
                      (    forth6809.asm):15437         ; stack after every "(...)" comment - confirmed via MAME at the
                      (    forth6809.asm):15438         ; time, symptomatic both as a visible stray value in interpret
                      (    forth6809.asm):15439         ; mode and as a -22 CSP mismatch for any colon definition
                      (    forth6809.asm):15440         ; containing one. This section's own test specifically confirms
                      (    forth6809.asm):15441         ; the data stack is genuinely unchanged (net 0), not just that
                      (    forth6809.asm):15442         ; parsing advanced correctly.
                      (    forth6809.asm):15443         ; ------------------------------------------------------------
                      (    forth6809.asm):15444         
                      (    forth6809.asm):15445         ; ------------------------------------------------------------
                      (    forth6809.asm):15446         ; TSTLPAREN - unit test for (. Fake source "hi)m" with TOIN
                      (    forth6809.asm):15447         ; starting at 0 - verifies TOIN lands exactly past the closing
                      (    forth6809.asm):15448         ; paren (at 3, immediately before "m", not consuming it), and
                      (    forth6809.asm):15449         ; that the data stack is genuinely unchanged - the specific
                      (    forth6809.asm):15450         ; behavior the bug-fix comment describes as previously broken.
                      (    forth6809.asm):15451         ; Since ( only ever advances TOIN, never SRCADDR itself, the
                      (    forth6809.asm):15452         ; fake source's own known address (TSTNAMEB) is used directly to
                      (    forth6809.asm):15453         ; verify the character just past the paren, with no need to
                      (    forth6809.asm):15454         ; re-read SRCADDR after the call.
                      (    forth6809.asm):15455         ; ------------------------------------------------------------
C321                  (    forth6809.asm):15456         TSTLPAREN: LDD  SRCADDR
                      (    forth6809.asm):15457                    STD  TSTSASAV
                      (    forth6809.asm):15458                    LDD  SRCLEN
                      (    forth6809.asm):15459                    STD  TSTSLSAV
                      (    forth6809.asm):15460                    LDD  TOIN
                      (    forth6809.asm):15461                    STD  TSTTISAV
                      (    forth6809.asm):15462         
                      (    forth6809.asm):15463                    LDA  #'h'
                      (    forth6809.asm):15464                    STA  TSTNAMEB
                      (    forth6809.asm):15465                    LDA  #'i'
                      (    forth6809.asm):15466                    STA  TSTNAMEB+1
                      (    forth6809.asm):15467                    LDA  #')'
                      (    forth6809.asm):15468                    STA  TSTNAMEB+2
                      (    forth6809.asm):15469                    LDA  #'m'
                      (    forth6809.asm):15470                    STA  TSTNAMEB+3
                      (    forth6809.asm):15471         
                      (    forth6809.asm):15472                    LDD  #TSTNAMEB
                      (    forth6809.asm):15473                    STD  SRCADDR
                      (    forth6809.asm):15474                    LDD  #4
                      (    forth6809.asm):15475                    STD  SRCLEN
                      (    forth6809.asm):15476                    LDD  #0
                      (    forth6809.asm):15477                    STD  TOIN
                      (    forth6809.asm):15478         
                      (    forth6809.asm):15479                    STU  TSTU0
                      (    forth6809.asm):15480         
                      (    forth6809.asm):15481                    LDD  #TSTGUARD
                      (    forth6809.asm):15482                    PSHU D
                      (    forth6809.asm):15483                    STU  TSTUB4
                      (    forth6809.asm):15484         
                      (    forth6809.asm):15485                    JSR  LPAREN
                      (    forth6809.asm):15486         
                      (    forth6809.asm):15487                    STU  TSTUAF
                      (    forth6809.asm):15488         
                      (    forth6809.asm):15489                    LDD  TOIN
                      (    forth6809.asm):15490                    CMPD #3
                      (    forth6809.asm):15491                    BNE  LPFAIL
                      (    forth6809.asm):15492         
                      (    forth6809.asm):15493                    LDA  TSTNAMEB+3
                      (    forth6809.asm):15494                    CMPA #'m'
                      (    forth6809.asm):15495                    BNE  LPFAIL
                      (    forth6809.asm):15496         
                      (    forth6809.asm):15497                    LDD  TSTSASAV
                      (    forth6809.asm):15498                    STD  SRCADDR
                      (    forth6809.asm):15499                    LDD  TSTSLSAV
                      (    forth6809.asm):15500                    STD  SRCLEN
                      (    forth6809.asm):15501                    LDD  TSTTISAV
                      (    forth6809.asm):15502                    STD  TOIN
                      (    forth6809.asm):15503         
                      (    forth6809.asm):15504                    PULU D
                      (    forth6809.asm):15505                    CMPD #TSTGUARD
                      (    forth6809.asm):15506                    BNE  LPFAIL
                      (    forth6809.asm):15507         
                      (    forth6809.asm):15508                    LDD  TSTUB4
                      (    forth6809.asm):15509                    SUBD TSTUAF
                      (    forth6809.asm):15510                    CMPD #0
                      (    forth6809.asm):15511                    BNE  LPFAIL
                      (    forth6809.asm):15512         
                      (    forth6809.asm):15513                    LDD  #TRUEV
                      (    forth6809.asm):15514                    BRA  LPDONE
C321                  (    forth6809.asm):15515         LPFAIL:    LDD  #FALSEV
C321                  (    forth6809.asm):15516         LPDONE:    LDX  #TSTLPNAME
                      (    forth6809.asm):15517                    PSHU X
                      (    forth6809.asm):15518                    PSHU D

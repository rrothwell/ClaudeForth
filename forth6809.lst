E416 3620             (    forth6809.asm):03538                     PSHU  Y                 ; ud high
E418 3610             (    forth6809.asm):03539                     PSHU  X                 ; c-addr
E41A 4F               (    forth6809.asm):03540                     CLRA
E41B 3606             (    forth6809.asm):03541                     PSHU  D                 ; u
                      (    forth6809.asm):03542         

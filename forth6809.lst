E8BC 3606             (    forth6809.asm):18327                  PSHU  D          ; read, shifting S by 2 first - so "2,S" landed
E8BE 39               (    forth6809.asm):18328                  RTS              ; on the limit (what's really at 4,S unshifted)
                      (    forth6809.asm):18329                                   ; instead of the index. The pair served no
                      (    forth6809.asm):18330                                   ; purpose (nothing needed offset 0 for anything
                      (    forth6809.asm):18331                                   ; here) - removed, so 2,S directly and
                      (    forth6809.asm):18332                                   ; correctly targets the index DOSETUP pushed
                      (    forth6809.asm):18333                                   ; there. Confirmed via MAME debugger: "I"
                      (    forth6809.asm):18334                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):18335         
E8BF EC68             (    forth6809.asm):18336         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E8C1 3606             (    forth6809.asm):18337                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E8C3 39               (    forth6809.asm):18338                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):18339                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):18340                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):18341                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):18342                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):18343                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):18344                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):18345                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):18346                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):18347                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):18348                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):18349                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):18350                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):18351                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):18352                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):18353                                   ; limit, never progressing). Confirmed via a
                      (    forth6809.asm):18354                                   ; real MULT-TABLE test on MAME.
                      (    forth6809.asm):18355         
E8C4 CCFFFF           (    forth6809.asm):18356         LEAVE:   LDD   #TRUEV    ; BUG FIX (earlier): was PULS X first, shifting

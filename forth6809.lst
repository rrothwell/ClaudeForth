                      (    forth6809.asm):05654         ; TSTBGU - unit test for BEGIN/UNTIL. Compiles
                      (    forth6809.asm):05655         ; "BEGIN 1+ DUP <lit 5> = UNTIL" into scratch - increments,
                      (    forth6809.asm):05656         ; duplicates, compares to 5, loops back while not equal. Run
                      (    forth6809.asm):05657         ; starting from 0; verified by hand-trace across all 5

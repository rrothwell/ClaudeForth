                      (    forth6809.asm):07659                                      ; 8-bit characters throughout (matching
                      (    forth6809.asm):07660                                      ; ADDRESS-UNIT-BITS=8, already in this
                      (    forth6809.asm):07661                                      ; table) - a single byte's maximum value
                      (    forth6809.asm):07662                                      ; is 255.

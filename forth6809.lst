                      (    forth6809.asm):04143         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):04144         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):04145         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):04146         ; UDMULADD
                      (    forth6809.asm):04147         ;    Inputs:
                      (    forth6809.asm):04148         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):04149         ;        frame ( ud c-addr u )
                      (    forth6809.asm):04150         ;        RegB = digit value to add
                      (    forth6809.asm):04151         ;        BASE
                      (    forth6809.asm):04152         ;    Outputs:
                      (    forth6809.asm):04153         ;        ud = ud * BASE + digit
                      (    forth6809.asm):04154         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04155         ; ------------------------------------------------------------

                      (    forth6809.asm):08129         
                      (    forth6809.asm):08130                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEC             (    forth6809.asm):08131         INITEND     EQU   *
     0048             (    forth6809.asm):08132         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08133         
                      (    forth6809.asm):08134         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08135         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08136         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):08137                     FILL  $FF,VECTORS-INITEND
                      (    forth6809.asm):08138         
                      (    forth6809.asm):08139         ; ============================================================
                      (    forth6809.asm):08140         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):08141         ; ============================================================
                      (    forth6809.asm):08142                     ORG   VECTORS           ; hardware vector table
FFF0 0000             (    forth6809.asm):08143         VRESV       FDB   $0000
FFF2 DE78             (    forth6809.asm):08144         VSWI3       FDB   SWI3H             ; SWI3
FFF4 DE79             (    forth6809.asm):08145         VSWI2       FDB   SWI2H             ; SWI2
FFF6 DE7A             (    forth6809.asm):08146         VFIRQ       FDB   FIRQH             ; FIRQ
FFF8 DE0F             (    forth6809.asm):08147         VIRQ        FDB   IRQH              ; IRQ
FFFA DE7C             (    forth6809.asm):08148         VSWI        FDB   SWIH              ; SWI
FFFC FFC5             (    forth6809.asm):08149         VNMI        FDB   WARM              ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):08150         VRESET      FDB   COLDSTRT          ; reset
                      (    forth6809.asm):08151         
     0000             (    forth6809.asm):08152         VECTOREND   EQU   *                 ; vectors size, should be $10
     0010             (    forth6809.asm):08153         VECTORSIZE  EQU   VECTOREND-VECTORS
                      (    forth6809.asm):08154         

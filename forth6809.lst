                      (    forth6809.asm):01605         ; ------------------------------------------------------------
                      (    forth6809.asm):01606         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01607         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01608         ; INITSERIAL
                      (    forth6809.asm):01609         ;    Inputs:
                      (    forth6809.asm):01610         ;        none
                      (    forth6809.asm):01611         ;    Outputs:
                      (    forth6809.asm):01612         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01613         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01614         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01615         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01616         ; ------------------------------------------------------------
DCE3 BDDCC4           (    forth6809.asm):01617         INITSERIAL: JSR   SERBUFCLR
DCE6 8603             (    forth6809.asm):01618                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
DCE8 B7C008           (    forth6809.asm):01619                     STA   ACIACR
DCEB 12               (    forth6809.asm):01620                     NOP                     ; Settling Delay
DCEC 12               (    forth6809.asm):01621                     NOP
                      (    forth6809.asm):01622         
                      (    forth6809.asm):01623                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
DCED 8695             (    forth6809.asm):01624                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01625                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):01626                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01627                     ENDC                    ; <<<<<<<<<<
DCEF B7C008           (    forth6809.asm):01628                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DCF2 39               (    forth6809.asm):01629                     RTS
                      (    forth6809.asm):01630         
                      (    forth6809.asm):01631                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01632         ; ------------------------------------------------------------
                      (    forth6809.asm):01633         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01634         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01635         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01636         ; INFILL
                      (    forth6809.asm):01637         ;    Inputs:
                      (    forth6809.asm):01638         ;        none
                      (    forth6809.asm):01639         ;    Outputs:
                      (    forth6809.asm):01640         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01641         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01642         ; ------------------------------------------------------------
DCF3 B60176           (    forth6809.asm):01643         INFILL:     LDA   INHEAD
DCF6 B00177           (    forth6809.asm):01644                     SUBA  INTAIL
DCF9 843F             (    forth6809.asm):01645                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DCFB 39               (    forth6809.asm):01646                     RTS
                      (    forth6809.asm):01647         ; ------------------------------------------------------------
                      (    forth6809.asm):01648         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01649         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01650         ; receive path with interrupts already masked.
                      (    forth6809.asm):01651         ; RTSCHECKHI
                      (    forth6809.asm):01652         ;    Inputs:
                      (    forth6809.asm):01653         ;        none
                      (    forth6809.asm):01654         ;    Outputs:
                      (    forth6809.asm):01655         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01656         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01657         ; ------------------------------------------------------------
DCFC BDDCF3           (    forth6809.asm):01658         RTSCHECKHI: JSR   INFILL
DCFF 8130             (    forth6809.asm):01659                     CMPA  #INHIWATER
DD01 250F             (    forth6809.asm):01660                     BLO   RTSCHIDONE
DD03 7D0178           (    forth6809.asm):01661                     TST   RTSSTATE
DD06 260A             (    forth6809.asm):01662                     BNE   RTSCHIDONE        ; already high - nothing to do
DD08 86D5             (    forth6809.asm):01663                     LDA   #CR_RTSHI
DD0A B7C008           (    forth6809.asm):01664                     STA   ACIACR
DD0D 8601             (    forth6809.asm):01665                     LDA   #1
DD0F B70178           (    forth6809.asm):01666                     STA   RTSSTATE
DD12 39               (    forth6809.asm):01667         RTSCHIDONE: RTS
                      (    forth6809.asm):01668         ; ------------------------------------------------------------
                      (    forth6809.asm):01669         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01670         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01671         ; enables it only while output is pending.
                      (    forth6809.asm):01672         ; UPDATE_RTS
                      (    forth6809.asm):01673         ;    Inputs:
                      (    forth6809.asm):01674         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01675         ;    Outputs:
                      (    forth6809.asm):01676         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01677         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01678         ; ------------------------------------------------------------
DD13                  (    forth6809.asm):01679         UPDATE_RTS:
DD13 7D0178           (    forth6809.asm):01680                     TST   RTSSTATE
DD16 260D             (    forth6809.asm):01681                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01682         
DD18 7D017B           (    forth6809.asm):01683                     TST   OUTACTIVITY       ; Is active?
DD1B 2704             (    forth6809.asm):01684                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01685         
                      (    forth6809.asm):01686                                             ; $B5/%1011_0101
DD1D 86B5             (    forth6809.asm):01687                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DD1F 2009             (    forth6809.asm):01688                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01689         
DD21                  (    forth6809.asm):01690         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DD21 8695             (    forth6809.asm):01691                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DD23 2005             (    forth6809.asm):01692                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01693         
DD25                  (    forth6809.asm):01694         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DD25 86D5             (    forth6809.asm):01695                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DD27 7F017B           (    forth6809.asm):01696                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DD2A                  (    forth6809.asm):01697         WRITE_CR:
DD2A B7C008           (    forth6809.asm):01698                     STA   ACIACR
DD2D 39               (    forth6809.asm):01699                     RTS
                      (    forth6809.asm):01700         ; ------------------------------------------------------------
                      (    forth6809.asm):01701         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01702         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01703         ; Called after a character is added to the ring.
                      (    forth6809.asm):01704         ; CHKHI
                      (    forth6809.asm):01705         ;    Inputs:
                      (    forth6809.asm):01706         ;        RegB = input ring fill level
                      (    forth6809.asm):01707         ;    Outputs:
                      (    forth6809.asm):01708         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01709         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01710         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01711         ; ------------------------------------------------------------
DD2E                  (    forth6809.asm):01712         CHKHI:
DD2E C130             (    forth6809.asm):01713                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DD30 250D             (    forth6809.asm):01714                     BLO   CHKHIDONE         ; No! Do nothing.
DD32 7D0178           (    forth6809.asm):01715                     TST   RTSSTATE
DD35 2608             (    forth6809.asm):01716                     BNE   CHKHIDONE         ; already high - nothing to do
DD37 86FF             (    forth6809.asm):01717                     LDA   #INREJECT         ; Yes! De-assert RTS.
DD39 B70178           (    forth6809.asm):01718                     STA   RTSSTATE
DD3C BDDD13           (    forth6809.asm):01719                     JSR   UPDATE_RTS
DD3F 39               (    forth6809.asm):01720         CHKHIDONE:  RTS
                      (    forth6809.asm):01721         
                      (    forth6809.asm):01722         ; ------------------------------------------------------------
                      (    forth6809.asm):01723         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01724         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01725         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01726         ; CHKLO
                      (    forth6809.asm):01727         ;    Inputs:
                      (    forth6809.asm):01728         ;        RegB = input ring fill level
                      (    forth6809.asm):01729         ;    Outputs:
                      (    forth6809.asm):01730         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01731         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01732         ; ------------------------------------------------------------
DD40                  (    forth6809.asm):01733         CHKLO:
DD40 C110             (    forth6809.asm):01734                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DD42 240D             (    forth6809.asm):01735                     BHS   CHKLODONE         ; No! Do nothing.
DD44 7D0178           (    forth6809.asm):01736                     TST   RTSSTATE
DD47 2708             (    forth6809.asm):01737                     BEQ   CHKLODONE         ; already low - nothing to do
DD49 8600             (    forth6809.asm):01738                     LDA   #INACCEPT         ; Yes! Assert RTS.
DD4B B70178           (    forth6809.asm):01739                     STA   RTSSTATE
DD4E BDDD13           (    forth6809.asm):01740                     JSR   UPDATE_RTS
DD51 39               (    forth6809.asm):01741         CHKLODONE:  RTS
                      (    forth6809.asm):01742         ; ------------------------------------------------------------
                      (    forth6809.asm):01743         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01744         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01745         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01746         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01747         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01748         ;    Inputs:
                      (    forth6809.asm):01749         ;        none
                      (    forth6809.asm):01750         ;    Outputs:
                      (    forth6809.asm):01751         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01752         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01753         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01754         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01755         FLUSHOUTBUFFER:
DD52 F6017A           (    forth6809.asm):01756                     LDB   OUTTAIL
DD55 F10179           (    forth6809.asm):01757                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DD58 2719             (    forth6809.asm):01758                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01759         
DD5A B6C008           (    forth6809.asm):01760                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01761                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01762                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01763         
DD61 8502             (    forth6809.asm):01764                     BITA  #SR_TDRE          ; Is transmit register empty?
DD63 270E             (    forth6809.asm):01765                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01766                                             ; than spin-wait here.
                      (    forth6809.asm):01767         
DD65 8E01C0           (    forth6809.asm):01768                     LDX   #OUTBUF           ; The out buffer is occupied.
DD68 A685             (    forth6809.asm):01769                     LDA   B,X               ; Get the character from the out buffer.
DD6A B7C009           (    forth6809.asm):01770                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01771         
DD6D 5C               (    forth6809.asm):01772                     INCB                    ; Update tail pointer to next character slot.
DD6E C43F             (    forth6809.asm):01773                     ANDB  #OUTBUFSZ-1
DD70 F7017A           (    forth6809.asm):01774                     STB   OUTTAIL
                      (    forth6809.asm):01775                                             ; One character sent - return rather than
                      (    forth6809.asm):01776                                             ; loop back for more (see header comment).

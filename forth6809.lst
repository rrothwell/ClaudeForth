                      (    forth6809.asm):03956         ; the xt held in CURXT.
                      (    forth6809.asm):03957         ; ------------------------------------------------------------
E812 DC3A             (    forth6809.asm):03958         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E814 3606             (    forth6809.asm):03959                     PSHU  D                 ; See bugfix: RECURSEW.1
E816 BDEABB           (    forth6809.asm):03960                     JSR   CCALL

F4C6 3606             (    forth6809.asm):06622                     PSHU  D
F4C8 BDF50B           (    forth6809.asm):06623                     JSR   TYPEW
F4CB 39               (    forth6809.asm):06624                     RTS
                      (    forth6809.asm):06625         
                      (    forth6809.asm):06626         ; ------------------------------------------------------------
                      (    forth6809.asm):06627         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06628         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06629         ; counted string.
                      (    forth6809.asm):06630         ; ------------------------------------------------------------
F4CC CC0022           (    forth6809.asm):06631         DOTQUOTEW:  LDD   #34

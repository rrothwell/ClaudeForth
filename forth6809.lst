                      (    forth6809.asm):06286                  JSR   THEN
                      (    forth6809.asm):06287         
                      (    forth6809.asm):06288                  LDD   #OPRTS
                      (    forth6809.asm):06289                  PSHU  D
                      (    forth6809.asm):06290                  JSR   CCOMMA
                      (    forth6809.asm):06291         
                      (    forth6809.asm):06292                  LDD   TSTCSAV
                      (    forth6809.asm):06293                  STD   CODEHERE
                      (    forth6809.asm):06294         
                      (    forth6809.asm):06295                  STU   TSTU0
                      (    forth6809.asm):06296         
                      (    forth6809.asm):06297                  LDD   #TSTGUARD
                      (    forth6809.asm):06298                  PSHU  D
                      (    forth6809.asm):06299                  LDD   #TRUEV
                      (    forth6809.asm):06300                  PSHU  D
                      (    forth6809.asm):06301                  STU   TSTUB4
                      (    forth6809.asm):06302         

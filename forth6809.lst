                      (    forth6809.asm):00891         ; ------------------------------------------------------------
                      (    forth6809.asm):00892         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00893         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00894         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00895         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00896         ;
                      (    forth6809.asm):00897         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00898         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00899         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00900         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00901         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00902         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00903         ; where no real input will ever arrive.
                      (    forth6809.asm):00904         ;
                      (    forth6809.asm):00905         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00906         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00907         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00908         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00909         ; entirely, not just fail one test.
                      (    forth6809.asm):00910         ;
                      (    forth6809.asm):00911         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00912         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00913         ; thousands of times already across every prior test group
                      (    forth6809.asm):00914         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00915         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00916         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00917         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00918         ; returned.
                      (    forth6809.asm):00919         ; ------------------------------------------------------------
                      (    forth6809.asm):00920         
                      (    forth6809.asm):00921         ; ------------------------------------------------------------
                      (    forth6809.asm):00922         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00923         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00924         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00925         ; ------------------------------------------------------------
C17F FF021B           (    forth6809.asm):00926         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00927         
C182 CC3C7A           (    forth6809.asm):00928                  LDD   #TSTGUARD
C185 3606             (    forth6809.asm):00929                  PSHU  D
C187 FF021D           (    forth6809.asm):00930                  STU   TSTUB4
                      (    forth6809.asm):00931         
C18A BDE61E           (    forth6809.asm):00932                  JSR   KEYQ
                      (    forth6809.asm):00933         
C18D FF021F           (    forth6809.asm):00934                  STU   TSTUAF
                      (    forth6809.asm):00935         
C190 3706             (    forth6809.asm):00936                  PULU  D
C192 10830000         (    forth6809.asm):00937                  CMPD  #FALSEV
C196 2619             (    forth6809.asm):00938                  BNE   KYFAIL
C198 3706             (    forth6809.asm):00939                  PULU  D
C19A 10833C7A         (    forth6809.asm):00940                  CMPD  #TSTGUARD
C19E 2611             (    forth6809.asm):00941                  BNE   KYFAIL
                      (    forth6809.asm):00942         
C1A0 FC021D           (    forth6809.asm):00943                  LDD   TSTUB4
C1A3 B3021F           (    forth6809.asm):00944                  SUBD  TSTUAF
C1A6 10830002         (    forth6809.asm):00945                  CMPD  #2
C1AA 2605             (    forth6809.asm):00946                  BNE   KYFAIL
                      (    forth6809.asm):00947         
C1AC CCFFFF           (    forth6809.asm):00948                  LDD   #TRUEV
C1AF 2003             (    forth6809.asm):00949                  BRA   KYDONE
C1B1 CC0000           (    forth6809.asm):00950         KYFAIL: LDD   #FALSEV
C1B4 8EC1C2           (    forth6809.asm):00951         KYDONE: LDX   #TSTKEYQNAME
C1B7 3610             (    forth6809.asm):00952                  PSHU  X
C1B9 3606             (    forth6809.asm):00953                  PSHU  D
C1BB BDC100           (    forth6809.asm):00954                  JSR   TSTREPORT
                      (    forth6809.asm):00955         
C1BE FE021B           (    forth6809.asm):00956                  LDU   TSTU0
C1C1 39               (    forth6809.asm):00957                  RTS
                      (    forth6809.asm):00958         
C1C2 07               (    forth6809.asm):00959         TSTKEYQNAME: FCB  7
C1C3 5453544B455951   (    forth6809.asm):00960                      FCC  "TSTKEYQ"

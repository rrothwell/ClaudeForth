                      (    forth6809.asm):17260                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):17261                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):17262                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):17263                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):17264                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):17265                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):17266                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):17267                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):17268                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):17269                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):17270                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):17271                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):17272                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):17273                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):17274                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):17275                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):17276                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):17277                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):17278                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):17279         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):17280                    BEQ  UEDONE
F87D A680             (    forth6809.asm):17281                    LDA  ,X+
F87F 8125             (    forth6809.asm):17282                    CMPA #'%'
F881 2604             (    forth6809.asm):17283                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):17284                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):17285                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):17286                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):17287                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):17288                                   ; the same string correctly, since this runs
                      (    forth6809.asm):17289                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):17290         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):17291                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):17292                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):17293                    SUBD #1
F88E DDA9             (    forth6809.asm):17294                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):17295                    BRA  UELOOP
F892 1F20             (    forth6809.asm):17296         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):17297                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):17298                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):17299                                   ; required return values, and separately,
                      (    forth6809.asm):17300                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):17301                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):17302                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):17303                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):17304                                   ; characters. Now computed directly as the
                      (    forth6809.asm):17305                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):17306                                   ; original destination address (UEDST) -
                      (    forth6809.asm):17307                                   ; correct regardless of how many characters
                      (    forth6809.asm):17308                                   ; were doubled, since it's derived from
                      (    forth6809.asm):17309                                   ; where writing actually stopped rather than
                      (    forth6809.asm):17310                                   ; incremented alongside it.
F898 DCAB             (    forth6809.asm):17311                    LDD  UEDST
F89A 3606             (    forth6809.asm):17312                    PSHU D         ; push c-addr2 (destination address)
F89C DCAD             (    forth6809.asm):17313                    LDD  UEOUTLEN
F89E 3606             (    forth6809.asm):17314                    PSHU D         ; push u2 (actual unescaped length)

                      (    forth6809.asm):02247         ; ------------------------------------------------------------
                      (    forth6809.asm):02248         ; PUTCHAR
                      (    forth6809.asm):02249         ;    Inputs:
                      (    forth6809.asm):02250         ;        RegA = character to insert into transmit buffer.

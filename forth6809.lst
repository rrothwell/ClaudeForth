                      (    forth6809.asm):06258         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):06259         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):06260         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):06261         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):06262         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):06263         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):06264         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):06265         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):06266         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):06267         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):06268         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):06269         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):06270         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):06271         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):06272         ; ------------------------------------------------------------
                      (    forth6809.asm):06273         
                      (    forth6809.asm):06274         ; ------------------------------------------------------------
                      (    forth6809.asm):06275         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):06276         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):06277         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):06278         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):06279         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):06280         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):06281         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):06282         ; ------------------------------------------------------------
C248                  (    forth6809.asm):06283         TSTIFT1: LDD   CODEHERE
                      (    forth6809.asm):06284                  STD   TSTCSAV
                      (    forth6809.asm):06285                  LDD   #TSTCBUF
                      (    forth6809.asm):06286                  STD   CODEHERE
                      (    forth6809.asm):06287         
                      (    forth6809.asm):06288                  JSR   IF
                      (    forth6809.asm):06289         
                      (    forth6809.asm):06290                  LDD   #111
                      (    forth6809.asm):06291                  PSHU  D
                      (    forth6809.asm):06292                  JSR   LITERALW
                      (    forth6809.asm):06293         
                      (    forth6809.asm):06294                  JSR   THEN
                      (    forth6809.asm):06295         
                      (    forth6809.asm):06296                  LDD   #OPRTS
                      (    forth6809.asm):06297                  PSHU  D
                      (    forth6809.asm):06298                  JSR   CCOMMA
                      (    forth6809.asm):06299         
                      (    forth6809.asm):06300                  LDD   TSTCSAV
                      (    forth6809.asm):06301                  STD   CODEHERE
                      (    forth6809.asm):06302         
                      (    forth6809.asm):06303                  STU   TSTU0
                      (    forth6809.asm):06304         
                      (    forth6809.asm):06305                  LDD   #TSTGUARD
                      (    forth6809.asm):06306                  PSHU  D
                      (    forth6809.asm):06307                  LDD   #TRUEV
                      (    forth6809.asm):06308                  PSHU  D
                      (    forth6809.asm):06309                  STU   TSTUB4
                      (    forth6809.asm):06310         
                      (    forth6809.asm):06311                  JSR   TSTCBUF
                      (    forth6809.asm):06312         
                      (    forth6809.asm):06313                  STU   TSTUAF
                      (    forth6809.asm):06314         
                      (    forth6809.asm):06315                  PULU  D
                      (    forth6809.asm):06316                  CMPD  #111
                      (    forth6809.asm):06317                  BNE   T1FAIL
                      (    forth6809.asm):06318                  PULU  D
                      (    forth6809.asm):06319                  CMPD  #TSTGUARD
                      (    forth6809.asm):06320                  BNE   T1FAIL
                      (    forth6809.asm):06321         
                      (    forth6809.asm):06322                  LDD   TSTUB4
                      (    forth6809.asm):06323                  SUBD  TSTUAF
                      (    forth6809.asm):06324                  CMPD  #0
                      (    forth6809.asm):06325                  BNE   T1FAIL
                      (    forth6809.asm):06326         
                      (    forth6809.asm):06327                  LDD   #TRUEV
                      (    forth6809.asm):06328                  BRA   T1DONE
C248                  (    forth6809.asm):06329         T1FAIL:  LDD   #FALSEV
C248                  (    forth6809.asm):06330         T1DONE:  LDX   #TSTIFT1NAME
                      (    forth6809.asm):06331                  PSHU  X

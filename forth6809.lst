                      (    forth6809.asm):05850         
                      (    forth6809.asm):05851         ; ------------------------------------------------------------
                      (    forth6809.asm):05852         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05853         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05854         ; ------------------------------------------------------------
E01C 3706             (    forth6809.asm):05855         PICKW:      PULU  D                 ; u
E01E 58               (    forth6809.asm):05856                     LSLB
E01F 49               (    forth6809.asm):05857                     ROLA
E020 ECCB             (    forth6809.asm):05858                     LDD   D,U
E022 3606             (    forth6809.asm):05859                     PSHU  D
E024 39               (    forth6809.asm):05860                     RTS
                      (    forth6809.asm):05861         
                      (    forth6809.asm):05862         ; ------------------------------------------------------------
                      (    forth6809.asm):05863         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05864         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05865         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05866         ; the cell being moved.

                      (    forth6809.asm):07871         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):07872         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):07873         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):07874         ; enter COLD.
                      (    forth6809.asm):07875         ; COLDSTRT
                      (    forth6809.asm):07876         ;    Inputs:
                      (    forth6809.asm):07877         ;        hardware reset
                      (    forth6809.asm):07878         ;    Outputs:
                      (    forth6809.asm):07879         ;        does not return
                      (    forth6809.asm):07880         ;    Registers: all registers initialised.
                      (    forth6809.asm):07881         ; ------------------------------------------------------------

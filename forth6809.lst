     59E1             (   unit_tests.asm):00030         TSTVAL1     EQU   $59E1             ; the value under test (non-trivial)
     2468             (   unit_tests.asm):00031         TSTVAL2     EQU   $2468             ; additional distinct, non-trivial
     7B3D             (   unit_tests.asm):00032         TSTVAL3     EQU   $7B3D             ; values for multi-item tests (SWAP,
     4E2C             (   unit_tests.asm):00033         TSTVAL4     EQU   $4E2C             ; OVER, ROT, 2DUP, 2ROT, etc) - none are
     19A7             (   unit_tests.asm):00034         TSTVAL5     EQU   $19A7             ; 0, 1, -1, TSTGUARD, or any of each
     6D95             (   unit_tests.asm):00035         TSTVAL6     EQU   $6D95             ; other
                      (   unit_tests.asm):00036         

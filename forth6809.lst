                      (    forth6809.asm):02644         
                      (    forth6809.asm):02645                       LDU  TSTU0
                      (    forth6809.asm):02646                       RTS
                      (    forth6809.asm):02647         
C1B1                  (    forth6809.asm):02648         TSTTWORFETCHNAME: FCB  12

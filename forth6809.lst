                      (   unit_tests.asm):01787         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (   unit_tests.asm):01788         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (   unit_tests.asm):01789         ; one round-trip test, matching how they can only be meaningfully
                      (   unit_tests.asm):01790         ; tested together - the "must be balanced within the same
                      (   unit_tests.asm):01791         ; definition" constraint each word's own glossary entry
                      (   unit_tests.asm):01792         ; documents). Every >R/2>R in these tests is balanced by a
                      (   unit_tests.asm):01793         ; matching R>/2R> before this group's own RTS - these words
                      (   unit_tests.asm):01794         ; operate directly on the return stack, the same stack holding
                      (   unit_tests.asm):01795         ; real subroutine return addresses, so leaving one unbalanced
                      (   unit_tests.asm):01796         ; would corrupt the path back to whatever called this test.
                      (   unit_tests.asm):01797         ;
                      (   unit_tests.asm):01798         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (   unit_tests.asm):01799         ; peek, then retrieve the original afterward and confirm it's
                      (   unit_tests.asm):01800         ; still correct - not just that the peek itself returned the
                      (   unit_tests.asm):01801         ; right value once.
                      (   unit_tests.asm):01802         ; ------------------------------------------------------------
C19E                  (   unit_tests.asm):01803         TSTRETSTACK:
C19E BDFBC1           (   unit_tests.asm):01804                     JSR   CRW
C1A1 8EC1B2           (   unit_tests.asm):01805                     LDX   #TSTRETMSG
C1A4 3610             (   unit_tests.asm):01806                     PSHU  X
C1A6 CC0008           (   unit_tests.asm):01807                     LDD   #8
C1A9 3606             (   unit_tests.asm):01808                     PSHU  D
C1AB BDF59B           (   unit_tests.asm):01809                     JSR   TYPE
C1AE BDFBC1           (   unit_tests.asm):01810                     JSR   CRW
                      (   unit_tests.asm):01811         
                      (   unit_tests.asm):01812                     IFEQ  TSTSELECTOR-2     ; >>>>
                      (   unit_tests.asm):01813         
                      (   unit_tests.asm):01814                     JSR   TSTTOR
                      (   unit_tests.asm):01815                     JSR   TSTRFETCH
                      (   unit_tests.asm):01816                     JSR   TSTTWOTOR
                      (   unit_tests.asm):01817                     JSR   TSTTWORFETCH
                      (   unit_tests.asm):01818         
                      (   unit_tests.asm):01819                     ENDC                    ; <<<<
                      (   unit_tests.asm):01820         
C1B1 39               (   unit_tests.asm):01821                     RTS
                      (   unit_tests.asm):01822         
C1B2 526574537461636B (   unit_tests.asm):01823         TSTRETMSG:  FCC   "RetStack"
                      (   unit_tests.asm):01824         
                      (   unit_tests.asm):01825                     IFEQ  TSTSELECTOR-2     ; >>>>
                      (   unit_tests.asm):01826         
                      (   unit_tests.asm):01827         ; ------------------------------------------------------------
                      (   unit_tests.asm):01828         ; Return-stack test harness (glossary section 3.3). Unlike
                      (   unit_tests.asm):01829         ; every other test group in this file, these words operate
                      (   unit_tests.asm):01830         ; directly on the return stack (S) - the same stack holding
                      (   unit_tests.asm):01831         ; real subroutine return addresses, including this very test
                      (   unit_tests.asm):01832         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (   unit_tests.asm):01833         ; R>/2R> within the same test body, before this test's own
                      (   unit_tests.asm):01834         ; RTS - leaving one unbalanced would corrupt the return address
                      (   unit_tests.asm):01835         ; needed to get back to TSTRUNNER (or whatever called it).
                      (   unit_tests.asm):01836         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (   unit_tests.asm):01837         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (   unit_tests.asm):01838         ; own return address off S, do the actual move, then restore it
                      (   unit_tests.asm):01839         ; on top - so the moved value ends up correctly nested one level
                      (   unit_tests.asm):01840         ; inside the current subroutine's own return-stack frame,
                      (   unit_tests.asm):01841         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (   unit_tests.asm):01842         ; gone by the time this test's own RTS runs.
                      (   unit_tests.asm):01843         ; ------------------------------------------------------------
                      (   unit_tests.asm):01844         
                      (   unit_tests.asm):01845         ; ------------------------------------------------------------
                      (   unit_tests.asm):01846         ; TSTTOR - unit test for >R and R> together. Includes an
                      (   unit_tests.asm):01847         ; intermediate check (right after >R, before R>) confirming the
                      (   unit_tests.asm):01848         ; value genuinely left the data stack - a pure round-trip check
                      (   unit_tests.asm):01849         ; could pass even if both words were broken no-ops, since the
                      (   unit_tests.asm):01850         ; value would never actually have left.
                      (   unit_tests.asm):01851         ; ------------------------------------------------------------
C1BA                  (   unit_tests.asm):01852         TSTTOR:     STU   TSTU0
                      (   unit_tests.asm):01853         
                      (   unit_tests.asm):01854                     LDD   #TSTGUARD
                      (   unit_tests.asm):01855                     PSHU  D
                      (   unit_tests.asm):01856                     LDD   #TSTVAL1
                      (   unit_tests.asm):01857                     PSHU  D
                      (   unit_tests.asm):01858                     STU   TSTUB4
                      (   unit_tests.asm):01859         
                      (   unit_tests.asm):01860                     JSR   TOR
                      (   unit_tests.asm):01861         
                      (   unit_tests.asm):01862                     STU   TSTUMID
                      (   unit_tests.asm):01863         
                      (   unit_tests.asm):01864                     LDD   TSTUB4
                      (   unit_tests.asm):01865                     SUBD  TSTUMID
                      (   unit_tests.asm):01866                     CMPD  #-2
                      (   unit_tests.asm):01867                     BNE   TRFAIL
                      (   unit_tests.asm):01868         
                      (   unit_tests.asm):01869                     JSR   FROMR
                      (   unit_tests.asm):01870         
                      (   unit_tests.asm):01871                     STU   TSTUAF

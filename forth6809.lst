                      (    forth6809.asm):10644                                      ; is 255.
FD91 FDE100120180     (    forth6809.asm):10645                  FDB   EN13,EN13L,(RSTACK-DSTACK)/2  ; NEW: RETURN-STACK-
                      (    forth6809.asm):10646                                      ; CELLS - computed from this system's own
                      (    forth6809.asm):10647                                      ; stack region boundaries rather than
                      (    forth6809.asm):10648                                      ; hardcoded, so this stays correct if the
                      (    forth6809.asm):10649                                      ; memory map shifts again (it has

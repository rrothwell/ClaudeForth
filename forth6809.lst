                      (    forth6809.asm):09526         ; verifies the header's own LEN/FL byte now has bit 7 set -
                      (    forth6809.asm):09527         ; confirmed a memory-only operation with no data-stack effect,
                      (    forth6809.asm):09528         ; so the guard check is the whole verification beyond that.
                      (    forth6809.asm):09529         ; ------------------------------------------------------------

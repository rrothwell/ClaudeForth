                      (    forth6809.asm):06672         ; ============================================================
                      (    forth6809.asm):06673         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06674         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06675         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06676         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06677         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06678         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06679         ; ============================================================
                      (    forth6809.asm):06680         ; ------------------------------------------------------------
                      (    forth6809.asm):06681         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06682         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06683         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06684         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06685         ; - no indirection, no value cell.
                      (    forth6809.asm):06686         ;
                      (    forth6809.asm):06687         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06688         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06689         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06690         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06691         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06692         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06693         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06694         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06695         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06696         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06697         ; ------------------------------------------------------------
FF39 CCFFFF           (    forth6809.asm):06698         TRUEBODY:  LDD   #$FFFF
FF3C 3606             (    forth6809.asm):06699                    PSHU  D
FF3E 39               (    forth6809.asm):06700                    RTS
                      (    forth6809.asm):06701         
FF3F CC0000           (    forth6809.asm):06702         FALSEBODY: LDD   #$0000
FF42 3606             (    forth6809.asm):06703                    PSHU  D
FF44 39               (    forth6809.asm):06704                    RTS
                      (    forth6809.asm):06705         
                      (    forth6809.asm):06706         ; ------------------------------------------------------------
                      (    forth6809.asm):06707         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):06708         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):06709         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):06710         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):06711         ; ------------------------------------------------------------
FF45 CC0001           (    forth6809.asm):06712         ONEBODY:   LDD   #1
FF48 3606             (    forth6809.asm):06713                    PSHU  D
FF4A 39               (    forth6809.asm):06714                    RTS
                      (    forth6809.asm):06715         

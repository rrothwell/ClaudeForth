                      (    forth6809.asm):02821         ; TSTSTSLZ - unit test for STARSLASH, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):02822         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02823         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02824         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02825         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02826         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02827         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02828         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02829         ; there are.
                      (    forth6809.asm):02830         ; ------------------------------------------------------------
C17D                  (    forth6809.asm):02831         TSTSTSLZ:   STU   TSTU0
                      (    forth6809.asm):02832         
                      (    forth6809.asm):02833                    LDD   #TSTVAL1
                      (    forth6809.asm):02834                    PSHU  D
                      (    forth6809.asm):02835                    LDD   #TSTVAL2
                      (    forth6809.asm):02836                    PSHU  D
                      (    forth6809.asm):02837                    LDD   #$0000
                      (    forth6809.asm):02838                    PSHU  D
                      (    forth6809.asm):02839                    LDX   #STARSLASH
                      (    forth6809.asm):02840                    PSHU  X
                      (    forth6809.asm):02841                    STU   TSTUB4
                      (    forth6809.asm):02842         
                      (    forth6809.asm):02843                    JSR   CATCH
                      (    forth6809.asm):02844         
                      (    forth6809.asm):02845                    STU   TSTUAF
                      (    forth6809.asm):02846         
                      (    forth6809.asm):02847                    PULU  D
                      (    forth6809.asm):02848                    CMPD  #-10
                      (    forth6809.asm):02849                    BNE   TZFAIL
                      (    forth6809.asm):02850         
                      (    forth6809.asm):02851                    LDD   TSTUB4
                      (    forth6809.asm):02852                    SUBD  TSTUAF
                      (    forth6809.asm):02853                    CMPD  #0
                      (    forth6809.asm):02854                    BNE   TZFAIL
                      (    forth6809.asm):02855         
                      (    forth6809.asm):02856                    LDD   #TRUEV
                      (    forth6809.asm):02857                    BRA   TZDONE
C17D                  (    forth6809.asm):02858         TZFAIL:     LDD   #FALSEV
C17D                  (    forth6809.asm):02859         TZDONE:     LDX   #TSTSTSLZNAME
                      (    forth6809.asm):02860                    PSHU  X
                      (    forth6809.asm):02861                    PSHU  D
                      (    forth6809.asm):02862                    JSR   TSTREPORT
                      (    forth6809.asm):02863         
                      (    forth6809.asm):02864                    LDU   TSTU0
                      (    forth6809.asm):02865                    RTS
                      (    forth6809.asm):02866         
C17D                  (    forth6809.asm):02867         TSTSTSLZNAME: FCB  8
                      (    forth6809.asm):02868                         FCC  "TSTSTSLZ"

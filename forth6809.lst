                      (    forth6809.asm):03005                    SUBD  TSTUAF
                      (    forth6809.asm):03006                    CMPD  #0
                      (    forth6809.asm):03007                    BNE   SZFAIL
                      (    forth6809.asm):03008         
                      (    forth6809.asm):03009                    LDD   #TRUEV

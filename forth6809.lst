                      (    forth6809.asm):21700                                      ; parsing - reporting it here would
                      (    forth6809.asm):21701                                      ; overstate what HOLD can safely use
                      (    forth6809.asm):21702                                      ; without risking collision with whatever
                      (    forth6809.asm):21703                                      ; WORD is doing in the same space.
FD7F FDCE00040054     (    forth6809.asm):21704                  FDB   EN8,EN8L,PADMINSIZE  ; NEW: /PAD, the last of the two
                      (    forth6809.asm):21705                                      ; entries the top-of-file note originally
                      (    forth6809.asm):21706                                      ; flagged as absent - now both present.
                      (    forth6809.asm):21707                                      ; Answers PADMINSIZE (84) directly, per
                      (    forth6809.asm):21708                                      ; ANS's own /PAD meaning (3.3.3.6, "the
                      (    forth6809.asm):21709                                      ; size of the scratch area whose address
                      (    forth6809.asm):21710                                      ; is returned by PAD") - PAD's own region,
                      (    forth6809.asm):21711                                      ; growing upward from PAD itself, distinct
                      (    forth6809.asm):21712                                      ; from HOLDMINSIZE above (which answers
                      (    forth6809.asm):21713                                      ; for a different region entirely, the
                      (    forth6809.asm):21714                                      ; downward-growing pictured-numeric buffer
                      (    forth6809.asm):21715                                      ; in the CODEHERE-to-PAD gap). PADOFFSET
                      (    forth6809.asm):21716                                      ; happens to equal PADMINSIZE numerically
                      (    forth6809.asm):21717                                      ; in this implementation (PADOFFSET EQU
                      (    forth6809.asm):21718                                      ; PADMINSIZE), but /PAD is answered with
                      (    forth6809.asm):21719                                      ; the conceptually correct constant, not
                      (    forth6809.asm):21720                                      ; the coincidentally-equal one.
FD85 FDD200070000     (    forth6809.asm):21721                  FDB   EN9,EN9L,0    ; NEW: FLOORED - previously the one item
                      (    forth6809.asm):21722                                      ; in this area explicitly left open
                      (    forth6809.asm):21723                                      ; pending its own investigation (unlike
                      (    forth6809.asm):21724                                      ; WORDLISTS, this is a CORE query, not
                      (    forth6809.asm):21725                                      ; tied to an unimplemented optional word
                      (    forth6809.asm):21726                                      ; set, so "false by omission" wasn't the
                      (    forth6809.asm):21727                                      ; right default). Investigated by tracing
                      (    forth6809.asm):21728                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):21729                                      ; against this system's own SM/REM and
                      (    forth6809.asm):21730                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):21731                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):21732                                      ; dividend's own original sign) after
                      (    forth6809.asm):21733                                      ; dividing absolute values - exactly
                      (    forth6809.asm):21734                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):21735                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):21736                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):21737                                      ; adjustment step (correcting the
                      (    forth6809.asm):21738                                      ; quotient and remainder when the
                      (    forth6809.asm):21739                                      ; quotient would be negative with a
                      (    forth6809.asm):21740                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):21741                                      ; not have. This system's primary
                      (    forth6809.asm):21742                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):21743                                      ; symmetric division, not floored -
                      (    forth6809.asm):21744                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):21745                                      ; answer (recognized query, value false),
                      (    forth6809.asm):21746                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):21747                                      ; WORDLISTS correctly uses.
FD8B FDD9000800FF     (    forth6809.asm):21748                  FDB   EN10,EN10L,255  ; NEW: MAX-CHAR - maximum value of any
                      (    forth6809.asm):21749                                      ; character in this implementation's
                      (    forth6809.asm):21750                                      ; character set (3.2.6). This system uses
                      (    forth6809.asm):21751                                      ; 8-bit characters throughout (matching
                      (    forth6809.asm):21752                                      ; ADDRESS-UNIT-BITS=8, already in this
                      (    forth6809.asm):21753                                      ; table) - a single byte's maximum value
                      (    forth6809.asm):21754                                      ; is 255.
FD91 FDE100120180     (    forth6809.asm):21755                  FDB   EN13,EN13L,(RSTACK-DSTACK)/2  ; NEW: RETURN-STACK-
                      (    forth6809.asm):21756                                      ; CELLS - computed from this system's own
                      (    forth6809.asm):21757                                      ; stack region boundaries rather than
                      (    forth6809.asm):21758                                      ; hardcoded, so this stays correct if the
                      (    forth6809.asm):21759                                      ; memory map shifts again (it has
                      (    forth6809.asm):21760                                      ; repeatedly this session). RSTACK's own
                      (    forth6809.asm):21761                                      ; comment confirms the occupied range is
                      (    forth6809.asm):21762                                      ; $BD00-RSTACK (768 bytes currently) -
                      (    forth6809.asm):21763                                      ; DSTACK+1 is $BD00 exactly (the two
                      (    forth6809.asm):21764                                      ; regions are contiguous, per RSTACK's
                      (    forth6809.asm):21765                                      ; and DSTACK's own comments). Since
                      (    forth6809.asm):21766                                      ; RSTACK-(DSTACK+1)+1 simplifies to
                      (    forth6809.asm):21767                                      ; RSTACK-DSTACK (the +1/-1 cancel), the
                      (    forth6809.asm):21768                                      ; simpler form is used directly: 384
                      (    forth6809.asm):21769                                      ; currently.

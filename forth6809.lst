ECE6 3410             (    forth6809.asm):04891                     PSHS  X
ECE8 39               (    forth6809.asm):04892                     RTS
                      (    forth6809.asm):04893         
                      (    forth6809.asm):04894         ; ------------------------------------------------------------
                      (    forth6809.asm):04895         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):04896         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):04897         ; of this call is on top of S, so it is lifted off and put back around

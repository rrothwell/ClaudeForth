FFB8 26FB             (    forth6809.asm):07893                     BNE   CLRGLOB
                      (    forth6809.asm):07894         
FFBA BDDCE3           (    forth6809.asm):07895                     JSR   INITSERIAL
                      (    forth6809.asm):07896         
FFBD 1CAF             (    forth6809.asm):07897                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):07898         
                      (    forth6809.asm):07899                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):07900         
                      (    forth6809.asm):07901                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):07902                     JSR   TSTRUNNER
                      (    forth6809.asm):07903                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07904                     NOP                     ; same size as JSR TSTRUNNER

                      (    forth6809.asm):04447                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04448         ; ------------------------------------------------------------
                      (    forth6809.asm):04449         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04450         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04451         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04452         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04453         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04454         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04455         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04456         ; follow.
                      (    forth6809.asm):04457         ; ------------------------------------------------------------
D946                  (    forth6809.asm):04458         KEYACIA:
                      (    forth6809.asm):04459                     LDA   ACIASR
                      (    forth6809.asm):04460                     BITA  #SR_RDRF
                      (    forth6809.asm):04461                     BEQ   KWAIT
                      (    forth6809.asm):04462                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04463                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D946                  (    forth6809.asm):04464         KWAIT:
D946                  (    forth6809.asm):04465         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04466                     BITA  #SR_RDRF
                      (    forth6809.asm):04467                     BEQ   KSPIN
D946                  (    forth6809.asm):04468         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04469                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04470                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04471                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04472                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04473                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04474                     BEQ   KGETCH
                      (    forth6809.asm):04475                     BITA  #SR_FE
                      (    forth6809.asm):04476                     BEQ   KXFE
                      (    forth6809.asm):04477                     INC   FECOUNT
D946                  (    forth6809.asm):04478         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04479                     BEQ   KXOVRN
                      (    forth6809.asm):04480                     INC   OVRNCOUNT
D946                  (    forth6809.asm):04481         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04482                     BEQ   KGETCH
                      (    forth6809.asm):04483                     INC   PECOUNT
D946                  (    forth6809.asm):04484         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04485                     TFR   A,B
                      (    forth6809.asm):04486                     CLRA
                      (    forth6809.asm):04487                     PSHU  D                 ; char
                      (    forth6809.asm):04488                     RTS
                      (    forth6809.asm):04489         
                      (    forth6809.asm):04490         ; ------------------------------------------------------------
                      (    forth6809.asm):04491         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04492         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04493         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04494         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04495         ;    Inputs:
                      (    forth6809.asm):04496         ;        none
                      (    forth6809.asm):04497         ;    Outputs:
                      (    forth6809.asm):04498         ;        XON or XOFF transmitted
                      (    forth6809.asm):04499         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04500         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04501         ; ------------------------------------------------------------
D946                  (    forth6809.asm):04502         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04503                     BRA   PUTXCH
D946                  (    forth6809.asm):04504         PUTXON:     LDA   #XONCH
D946                  (    forth6809.asm):04505         PUTXCH:     PSHS  A
D946                  (    forth6809.asm):04506         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04507                     BITB  #SR_TDRE
                      (    forth6809.asm):04508                     BEQ   PXWT
                      (    forth6809.asm):04509                     PULS  A
                      (    forth6809.asm):04510                     STA   ACIADR
                      (    forth6809.asm):04511                     RTS
                      (    forth6809.asm):04512         
                      (    forth6809.asm):04513         ; ------------------------------------------------------------
                      (    forth6809.asm):04514         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04515         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04516         ; ------------------------------------------------------------

F87B 2715             (    forth6809.asm):22046                    BEQ  UEDONE
F87D A680             (    forth6809.asm):22047                    LDA  ,X+
F87F 8125             (    forth6809.asm):22048                    CMPA #'%'
F881 2604             (    forth6809.asm):22049                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):22050                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):22051                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):22052                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):22053                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):22054                                   ; the same string correctly, since this runs
                      (    forth6809.asm):22055                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):22056         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):22057                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):22058                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):22059                    SUBD #1
F88E DDA9             (    forth6809.asm):22060                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):22061                    BRA  UELOOP

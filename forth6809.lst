                      (    forth6809.asm):10532         ; TSTSLITERAL1 - unit test for SLITERAL, compiling-state case.
                      (    forth6809.asm):10533         ; Compile-only (throws -14 otherwise, per its own code). Pushes
                      (    forth6809.asm):10534         ; a known 2-character string, compiles it as a runtime literal,
                      (    forth6809.asm):10535         ; then executes the result to confirm it genuinely pushes the
                      (    forth6809.asm):10536         ; correct (addr len) pair - checking the actual content at the
                      (    forth6809.asm):10537         ; returned address, not just that some address and a length of
                      (    forth6809.asm):10538         ; 2 came back.
                      (    forth6809.asm):10539         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):10540         TSTSLITERAL1: LDD  CODEHERE
                      (    forth6809.asm):10541                       STD  TSTCSAV
                      (    forth6809.asm):10542                       LDD  STATE

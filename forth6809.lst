                      (    forth6809.asm):09382         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09383         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09384         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09385         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09386         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09387         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09388         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09389         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09390         ; available the skip ends.
                      (    forth6809.asm):09391         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09392         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09393         ; ------------------------------------------------------------
F433 3706             (    forth6809.asm):09394         BRIFW:      PULU  D
F435 10830000         (    forth6809.asm):09395                     CMPD  #0
F439 266D             (    forth6809.asm):09396                     BNE   BRTHENW           ; true: nothing to skip
F43B CC0001           (    forth6809.asm):09397         BRELSEW:    LDD   #1
F43E 3406             (    forth6809.asm):09398                     PSHS  D                 ; level
F440 BDEADC           (    forth6809.asm):09399         BRNEXT:     JSR   PARSENAMEW
F443 3706             (    forth6809.asm):09400                     PULU  D                 ; length
F445 3710             (    forth6809.asm):09401                     PULU  X                 ; address
F447 10830000         (    forth6809.asm):09402                     CMPD  #0
F44B 274E             (    forth6809.asm):09403                     BEQ   BRREFILL
F44D 10830004         (    forth6809.asm):09404                     CMPD  #4
F451 2734             (    forth6809.asm):09405                     BEQ   BR4
F453 10830006         (    forth6809.asm):09406                     CMPD  #6
F457 26E7             (    forth6809.asm):09407                     BNE   BRNEXT
F459 C606             (    forth6809.asm):09408                     LDB   #6
F45B 108EF4B7         (    forth6809.asm):09409                     LDY   #BRSELSE
F45F 3410             (    forth6809.asm):09410                     PSHS  X
F461 BDF4A9           (    forth6809.asm):09411                     JSR   BRCMP
F464 3510             (    forth6809.asm):09412                     PULS  X
F466 2609             (    forth6809.asm):09413                     BNE   BR6B
F468 ECE4             (    forth6809.asm):09414                     LDD   ,S                ; [ELSE]: ends the skip at level 1
F46A 830001           (    forth6809.asm):09415                     SUBD  #1

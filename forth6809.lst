                      (    forth6809.asm):06373         
                      (    forth6809.asm):06374                  JSR   THEN
                      (    forth6809.asm):06375         
                      (    forth6809.asm):06376                  LDD   #OPRTS
                      (    forth6809.asm):06377                  PSHU  D
                      (    forth6809.asm):06378                  JSR   CCOMMA
                      (    forth6809.asm):06379         
                      (    forth6809.asm):06380                  LDD   TSTCSAV
                      (    forth6809.asm):06381                  STD   CODEHERE
                      (    forth6809.asm):06382         
                      (    forth6809.asm):06383                  STU   TSTU0
                      (    forth6809.asm):06384         
                      (    forth6809.asm):06385                  LDD   #TSTGUARD
                      (    forth6809.asm):06386                  PSHU  D
                      (    forth6809.asm):06387                  LDD   #TRUEV
                      (    forth6809.asm):06388                  PSHU  D
                      (    forth6809.asm):06389                  STU   TSTUB4
                      (    forth6809.asm):06390         
                      (    forth6809.asm):06391                  JSR   TSTCBUF
                      (    forth6809.asm):06392         
                      (    forth6809.asm):06393                  STU   TSTUAF
                      (    forth6809.asm):06394         
                      (    forth6809.asm):06395                  PULU  D
                      (    forth6809.asm):06396                  CMPD  #111
                      (    forth6809.asm):06397                  BNE   E1FAIL

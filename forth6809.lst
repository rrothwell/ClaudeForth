                      (    forth6809.asm):03295         ; TSTSTSMZ - unit test for STARSLASHMOD, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):03296         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):03297         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):03298         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):03299         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):03300         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):03301         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):03302         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):03303         ; there are.
                      (    forth6809.asm):03304         ; ------------------------------------------------------------
C358                  (    forth6809.asm):03305         TSTSTSMZ:   STU   TSTU0
                      (    forth6809.asm):03306         
                      (    forth6809.asm):03307                    LDD   #TSTVAL1
                      (    forth6809.asm):03308                    PSHU  D
                      (    forth6809.asm):03309                    LDD   #TSTVAL2
                      (    forth6809.asm):03310                    PSHU  D
                      (    forth6809.asm):03311                    LDD   #$0000
                      (    forth6809.asm):03312                    PSHU  D
                      (    forth6809.asm):03313                    LDX   #STARSLASHMOD
                      (    forth6809.asm):03314                    PSHU  X
                      (    forth6809.asm):03315                    STU   TSTUB4
                      (    forth6809.asm):03316         
                      (    forth6809.asm):03317                    JSR   CATCH
                      (    forth6809.asm):03318         
                      (    forth6809.asm):03319                    STU   TSTUAF
                      (    forth6809.asm):03320         
                      (    forth6809.asm):03321                    PULU  D
                      (    forth6809.asm):03322                    CMPD  #-10
                      (    forth6809.asm):03323                    BNE   TXFAIL
                      (    forth6809.asm):03324         
                      (    forth6809.asm):03325                    LDD   TSTUB4
                      (    forth6809.asm):03326                    SUBD  TSTUAF
                      (    forth6809.asm):03327                    CMPD  #0
                      (    forth6809.asm):03328                    BNE   TXFAIL
                      (    forth6809.asm):03329         
                      (    forth6809.asm):03330                    LDD   #TRUEV
                      (    forth6809.asm):03331                    BRA   TXDONE

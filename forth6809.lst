                      (    forth6809.asm):13903         ; TSTHOLDS - unit test for HOLDS. Holds the string "XY" - since
                      (    forth6809.asm):13904         ; HOLDS iterates its source backward (last character first) and
                      (    forth6809.asm):13905         ; HOLD itself prepends, the two behaviors combine to preserve
                      (    forth6809.asm):13906         ; the original forward order in the pictured buffer, matching
                      (    forth6809.asm):13907         ; its own documented "depends on HOLD's exact decrement-by-one
                      (    forth6809.asm):13908         ; behavior".
                      (    forth6809.asm):13909         ; ------------------------------------------------------------

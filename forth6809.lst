                      (    forth6809.asm):21766         ; ============================================================
                      (    forth6809.asm):21767         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):21768         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):21769         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):21770         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):21771         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):21772         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):21773         ; ============================================================
                      (    forth6809.asm):21774         ; ------------------------------------------------------------
                      (    forth6809.asm):21775         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):21776         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):21777         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):21778         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):21779         ; - no indirection, no value cell.
                      (    forth6809.asm):21780         ;
                      (    forth6809.asm):21781         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):21782         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):21783         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):21784         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):21785         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):21786         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):21787         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):21788         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):21789         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):21790         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):21791         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):21792         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):21793                    PSHU  D
FF3C 39               (    forth6809.asm):21794                    RTS
                      (    forth6809.asm):21795         
FF3D CC0000           (    forth6809.asm):21796         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):21797                    PSHU  D
FF42 39               (    forth6809.asm):21798                    RTS
                      (    forth6809.asm):21799         
                      (    forth6809.asm):21800         ; ------------------------------------------------------------
                      (    forth6809.asm):21801         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):21802         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):21803         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):21804         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):21805         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):21806         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):21807                    PSHU  D
FF48 39               (    forth6809.asm):21808                    RTS
                      (    forth6809.asm):21809         
FF49 CCFFFF           (    forth6809.asm):21810         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):21811                    PSHU  D
FF4E 39               (    forth6809.asm):21812                    RTS
                      (    forth6809.asm):21813         
FF4F CC0002           (    forth6809.asm):21814         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):21815                    PSHU  D
FF54 39               (    forth6809.asm):21816                    RTS
                      (    forth6809.asm):21817         
FF55 CCFFFE           (    forth6809.asm):21818         MTWOBODY:  LDD   #-2
FF58 3606             (    forth6809.asm):21819                    PSHU  D
FF5A 39               (    forth6809.asm):21820                    RTS

                      (    forth6809.asm):07457         ; ------------------------------------------------------------
                      (    forth6809.asm):07458         ; <#  ( -- )
                      (    forth6809.asm):07459         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):07460         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):07461         ; ------------------------------------------------------------
F9B5 BDDF60           (    forth6809.asm):07462         LTNUMW:     JSR   PADW
F9B8 3706             (    forth6809.asm):07463                     PULU  D
F9BA DD1C             (    forth6809.asm):07464                     STD   HLD
F9BC 39               (    forth6809.asm):07465                     RTS
                      (    forth6809.asm):07466         
                      (    forth6809.asm):07467         ; ------------------------------------------------------------
                      (    forth6809.asm):07468         ; HOLD  ( char -- )
                      (    forth6809.asm):07469         ; Add char to the front of the pictured numeric output string.
                      (    forth6809.asm):07470         ; ------------------------------------------------------------
F9BD 3706             (    forth6809.asm):07471         HOLDW:      PULU  D                 ; char

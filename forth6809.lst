                      (    forth6809.asm):08321                                   ; to its real value here - but SETDOES
                      (    forth6809.asm):08322                                   ; (confirmed by reading its own code) reads
                      (    forth6809.asm):08323                                   ; LATEST directly to find which header to
                      (    forth6809.asm):08324                                   ; patch, so restoring it first meant SETDOES
                      (    forth6809.asm):08325                                   ; patched the real, wrong word instead of
                      (    forth6809.asm):08326                                   ; TESTWD, leaving TESTWD stuck on its
                      (    forth6809.asm):08327                                   ; original DOESRT0 placeholder. LATEST now
                      (    forth6809.asm):08328                                   ; stays pointed at TESTWD (this test's own
                      (    forth6809.asm):08329                                   ; fake header) until right after this call.
                      (    forth6809.asm):08330                    JSR  ,X
                      (    forth6809.asm):08331         
                      (    forth6809.asm):08332                    LDD  TSTLSAV
                      (    forth6809.asm):08333                    STD  LATEST

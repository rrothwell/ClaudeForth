                      (    forth6809.asm):09482         ; ------------------------------------------------------------
F4CF CC0001           (    forth6809.asm):09483         POSONEW:    LDD   #1
F4D2 3606             (    forth6809.asm):09484                     PSHU  D
F4D4 39               (    forth6809.asm):09485                     RTS

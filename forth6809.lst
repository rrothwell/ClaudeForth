                      (    forth6809.asm):02970         
E194 BDDE55           (    forth6809.asm):02971         DOEXEC:     JSR   EXECUTEW
E197 20D7             (    forth6809.asm):02972                     BRA   ILOOP
                      (    forth6809.asm):02973         
E199 BDE33A           (    forth6809.asm):02974         TRYNUM:     JSR   NUMBERQ
E19C 3706             (    forth6809.asm):02975                     PULU  D

                      (    forth6809.asm):07410         ; ------------------------------------------------------------
                      (    forth6809.asm):07411         ; EVALUATE  ( c-addr u -- )
                      (    forth6809.asm):07412         ; Interpret the string c-addr u as the input source, then restore the

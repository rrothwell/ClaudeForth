                      (    forth6809.asm):15202         ; TSTTHROWHLP - internal helper, not a dictionary word or a
                      (    forth6809.asm):15203         ; test of its own. Pushes two dummy values (to verify CATCH's
                      (    forth6809.asm):15204         ; own stack-depth restoration genuinely discards them, not just
                      (    forth6809.asm):15205         ; that a thrown code arrives correctly) then throws a known,
                      (    forth6809.asm):15206         ; distinctive, non-trivial code. Only ever invoked via CATCH
                      (    forth6809.asm):15207         ; (below), never called directly - calling it any other way
                      (    forth6809.asm):15208         ; would hit THROW's own uncaught path (JMP ABORT), which this
                      (    forth6809.asm):15209         ; whole test framework cannot survive.
                      (    forth6809.asm):15210         ; ------------------------------------------------------------
C302                  (    forth6809.asm):15211         TSTTHROWHLP: LDD  #TSTVAL1
                      (    forth6809.asm):15212                      PSHU D
                      (    forth6809.asm):15213                      LDD  #TSTVAL2
                      (    forth6809.asm):15214                      PSHU D
                      (    forth6809.asm):15215                      LDD  #TSTNEG1
                      (    forth6809.asm):15216                      PSHU D
                      (    forth6809.asm):15217                      JSR  THROW
                      (    forth6809.asm):15218                      RTS
                      (    forth6809.asm):15219         
                      (    forth6809.asm):15220         ; ------------------------------------------------------------
                      (    forth6809.asm):15221         ; TSTCATCHTHROW - unit test for CATCH, exception path, and for
                      (    forth6809.asm):15222         ; THROW's own non-local exit together (the two can only be
                      (    forth6809.asm):15223         ; meaningfully tested as a pair - THROW's own effect is only
                      (    forth6809.asm):15224         ; observable through a CATCH that traps it). Verifies CATCH
                      (    forth6809.asm):15225         ; returns the exact thrown code, and specifically verifies the
                      (    forth6809.asm):15226         ; two dummy values TSTTHROWHLP pushes before throwing are
                      (    forth6809.asm):15227         ; genuinely gone afterward - confirming the documented "restores
                      (    forth6809.asm):15228         ; data stack depth... on either path" for real, not just that
                      (    forth6809.asm):15229         ; the final result happens to look right.
                      (    forth6809.asm):15230         ; ------------------------------------------------------------
C302                  (    forth6809.asm):15231         TSTCATCHTHROW: STU  TSTU0
                      (    forth6809.asm):15232         
                      (    forth6809.asm):15233                        LDD  #TSTGUARD
                      (    forth6809.asm):15234                        PSHU D
                      (    forth6809.asm):15235                        LDX  #TSTTHROWHLP
                      (    forth6809.asm):15236                        PSHU X
                      (    forth6809.asm):15237                        STU  TSTUB4
                      (    forth6809.asm):15238         
                      (    forth6809.asm):15239                        JSR  CATCH
                      (    forth6809.asm):15240         
                      (    forth6809.asm):15241                        STU  TSTUAF
                      (    forth6809.asm):15242         
                      (    forth6809.asm):15243                        PULU D
                      (    forth6809.asm):15244                        CMPD #TSTNEG1
                      (    forth6809.asm):15245                        BNE  CTFAIL2
                      (    forth6809.asm):15246                        PULU D
                      (    forth6809.asm):15247                        CMPD #TSTGUARD
                      (    forth6809.asm):15248                        BNE  CTFAIL2
                      (    forth6809.asm):15249         
                      (    forth6809.asm):15250                        LDD  TSTUB4
                      (    forth6809.asm):15251                        SUBD TSTUAF
                      (    forth6809.asm):15252                        CMPD #0
                      (    forth6809.asm):15253                        BNE  CTFAIL2
                      (    forth6809.asm):15254         
                      (    forth6809.asm):15255                        LDD  #TRUEV
                      (    forth6809.asm):15256                        BRA  CTDONE2
C302                  (    forth6809.asm):15257         CTFAIL2:       LDD  #FALSEV
C302                  (    forth6809.asm):15258         CTDONE2:       LDX  #TSTCTNAME2
                      (    forth6809.asm):15259                        PSHU X
                      (    forth6809.asm):15260                        PSHU D
                      (    forth6809.asm):15261                        JSR  TSTREPORT
                      (    forth6809.asm):15262         
                      (    forth6809.asm):15263                        LDU  TSTU0
                      (    forth6809.asm):15264                        RTS
                      (    forth6809.asm):15265         
C302                  (    forth6809.asm):15266         TSTCTNAME2: FCB  13
                      (    forth6809.asm):15267                     FCC  "TSTCATCHTHROW"

                      (    forth6809.asm):07754         ; DOTSTR
                      (    forth6809.asm):07755         ;    Inputs:
                      (    forth6809.asm):07756         ;        return address on S points at the count byte
                      (    forth6809.asm):07757         ;    Outputs:
                      (    forth6809.asm):07758         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):07759         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07760         ; ------------------------------------------------------------
E8B2 3510             (    forth6809.asm):07761         DOTSTR:     PULS  X

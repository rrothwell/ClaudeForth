F76B 3706             (    forth6809.asm):06678                    PULU D
F76D DDB9             (    forth6809.asm):06679                    STD  REPLVLEN
F76F 3706             (    forth6809.asm):06680                    PULU D
F771 DDB7             (    forth6809.asm):06681                    STD  REPLVAL

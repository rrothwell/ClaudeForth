                      (    forth6809.asm):02264         
                      (    forth6809.asm):02265                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02266                     INCB
                      (    forth6809.asm):02267                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02268                     CMPB  OUTTAIL
                      (    forth6809.asm):02269                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02270         
                      (    forth6809.asm):02271                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02272                     LDB   OUTHEAD
                      (    forth6809.asm):02273                     STA   B,X
                      (    forth6809.asm):02274         
                      (    forth6809.asm):02275                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02276                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02277                     STB   OUTHEAD
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?

                      (    forth6809.asm):11178                         CMPD #TSTVAL2
                      (    forth6809.asm):11179                         BNE  DFFAIL
                      (    forth6809.asm):11180                         PULU D
                      (    forth6809.asm):11181                         CMPD #TSTVAL1
                      (    forth6809.asm):11182                         BNE  DFFAIL
                      (    forth6809.asm):11183                         PULU D
                      (    forth6809.asm):11184                         CMPD #TSTGUARD
                      (    forth6809.asm):11185                         BNE  DFFAIL
                      (    forth6809.asm):11186         

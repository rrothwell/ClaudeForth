                      (    forth6809.asm):05713         ; ------------------------------------------------------------
DE5D CC0012           (    forth6809.asm):05714         NUMTIBW:    LDD   #NTIB
DE60 3606             (    forth6809.asm):05715                     PSHU  D
DE62 39               (    forth6809.asm):05716                     RTS

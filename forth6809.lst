                      (    forth6809.asm):03153         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):03154         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):03155         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):03156         ; UDMULADD
                      (    forth6809.asm):03157         ;    Inputs:
                      (    forth6809.asm):03158         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):03159         ;        frame ( ud c-addr u )
                      (    forth6809.asm):03160         ;        RegB = digit value to add
                      (    forth6809.asm):03161         ;        BASE
                      (    forth6809.asm):03162         ;    Outputs:
                      (    forth6809.asm):03163         ;        ud = ud * BASE + digit
                      (    forth6809.asm):03164         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03165         ; ------------------------------------------------------------

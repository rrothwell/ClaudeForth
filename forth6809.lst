                      (    forth6809.asm):02470                                             ; the other unused vectors below
                      (    forth6809.asm):02471                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02472         
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
                      (    forth6809.asm):02474         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02475         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02476         ; ------------------------------------------------------------
D074 3B               (    forth6809.asm):02477         SWI3H:      RTI
D075 3B               (    forth6809.asm):02478         SWI2H:      RTI
D076 3B               (    forth6809.asm):02479         FIRQH:      RTI
D077 3B               (    forth6809.asm):02480         NMIH:       RTI                     ; unused now that NMI -> WARM
D078 CCFF9D           (    forth6809.asm):02481         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
D07B 3606             (    forth6809.asm):02482                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
D07D 7EDAAF           (    forth6809.asm):02483                     JMP   THROWW
                      (    forth6809.asm):02484         
                      (    forth6809.asm):02485         ; ============================================================
                      (    forth6809.asm):02486         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02487         ; ============================================================
                      (    forth6809.asm):02488         ; ------------------------------------------------------------
                      (    forth6809.asm):02489         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02490         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02491         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02492         ; COLD
                      (    forth6809.asm):02493         ;    Inputs:
                      (    forth6809.asm):02494         ;        none (entered at reset)
                      (    forth6809.asm):02495         ;    Outputs:
                      (    forth6809.asm):02496         ;        none (does not return)
                      (    forth6809.asm):02497         ;    Registers: all changed.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
D080 CC0240           (    forth6809.asm):02499         COLD:       LDD   #APPVARS
D083 DD0A             (    forth6809.asm):02500                     STD   VARHERE
D085 CC7000           (    forth6809.asm):02501                     LDD   #APPCODE
D088 DD08             (    forth6809.asm):02502                     STD   CODEHERE
D08A CC2000           (    forth6809.asm):02503                     LDD   #APPDICT
D08D DD06             (    forth6809.asm):02504                     STD   DPHERE
D08F CCCEBA           (    forth6809.asm):02505                     LDD   #BASELATEST
D092 DD04             (    forth6809.asm):02506                     STD   LATEST
D094 BDD6FD           (    forth6809.asm):02507                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02508         
D097 CC000A           (    forth6809.asm):02509                     LDD   #10
D09A DD02             (    forth6809.asm):02510                     STD   BASE
                      (    forth6809.asm):02511         
D09C CC0106           (    forth6809.asm):02512                     LDD   #TIBBUF
D09F DD39             (    forth6809.asm):02513                     STD   SRCADDR
D0A1 CC0000           (    forth6809.asm):02514                     LDD   #0
D0A4 DD3B             (    forth6809.asm):02515                     STD   SRCLEN
D0A6 DD3D             (    forth6809.asm):02516                     STD   SRCID
                      (    forth6809.asm):02517         
D0A8 8ED14E           (    forth6809.asm):02518                     LDX   #SIGNON
D0AB 3610             (    forth6809.asm):02519                     PSHU  X                 ; c-addr
D0AD CC000F           (    forth6809.asm):02520                     LDD   #SIGNONL
D0B0 3606             (    forth6809.asm):02521                     PSHU  D                 ; u
D0B2 BDEAA4           (    forth6809.asm):02522                     JSR   TYPEW
D0B5 BDF0CD           (    forth6809.asm):02523                     JSR   CRW
D0B8 2008             (    forth6809.asm):02524                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02525         
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
                      (    forth6809.asm):02527         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02528         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
D0BA CCFFFF           (    forth6809.asm):02530         ABORTW:     LDD   #-1
D0BD 3606             (    forth6809.asm):02531                     PSHU  D                 ; throw code (-1)
D0BF 7EDAAF           (    forth6809.asm):02532                     JMP   THROWW
                      (    forth6809.asm):02533         
                      (    forth6809.asm):02534         ; ------------------------------------------------------------
                      (    forth6809.asm):02535         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02536         ; ABORT
                      (    forth6809.asm):02537         ;    Inputs:
                      (    forth6809.asm):02538         ;        none
                      (    forth6809.asm):02539         ;    Outputs:
                      (    forth6809.asm):02540         ;        none (does not return)
                      (    forth6809.asm):02541         ;    Registers: RegU changed.
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
D0C2 CEBD00           (    forth6809.asm):02543         ABORT:      LDU   #SP0
                      (    forth6809.asm):02544                     ; falls through into QUIT
                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546         ; ------------------------------------------------------------
                      (    forth6809.asm):02547         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02548         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02549         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02550         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02551         ; ------------------------------------------------------------
D0C5 10CEC000         (    forth6809.asm):02552         QUITW:      LDS   #RP0
D0C9 CC0000           (    forth6809.asm):02553                     LDD   #0
D0CC DD00             (    forth6809.asm):02554                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02555         
D0CE BDDA5A           (    forth6809.asm):02556         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02557         
D0D1 DC06             (    forth6809.asm):02558                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
D0D3 3406             (    forth6809.asm):02559                     PSHS  D                 ; and THROW restore S, so the frame is
D0D5 DC08             (    forth6809.asm):02560                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
D0D7 3406             (    forth6809.asm):02561                     PSHS  D                 ; See shadow QLOOP.2
D0D9 DC0A             (    forth6809.asm):02562                     LDD   VARHERE
D0DB 3406             (    forth6809.asm):02563                     PSHS  D
D0DD DC04             (    forth6809.asm):02564                     LDD   LATEST
D0DF 3406             (    forth6809.asm):02565                     PSHS  D
                      (    forth6809.asm):02566         
D0E1 CCD527           (    forth6809.asm):02567                     LDD   #INTERPRET
D0E4 3606             (    forth6809.asm):02568                     PSHU  D                 ; xt
D0E6 BDDA83           (    forth6809.asm):02569                     JSR   CATCHW
D0E9 3706             (    forth6809.asm):02570                     PULU  D                 ; throw code (0 = no error)
D0EB 3406             (    forth6809.asm):02571                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
D0ED 10830000         (    forth6809.asm):02572                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
D0F1 2743             (    forth6809.asm):02573                     BEQ   QOK
                      (    forth6809.asm):02574         
D0F3 EC68             (    forth6809.asm):02575                     LDD   8,S
D0F5 DD06             (    forth6809.asm):02576                     STD   DPHERE
D0F7 BDD71E           (    forth6809.asm):02577                     JSR   PRUNE             ; unlink headers newer than DPHERE
D0FA EC66             (    forth6809.asm):02578                     LDD   6,S
D0FC DD08             (    forth6809.asm):02579                     STD   CODEHERE
D0FE EC64             (    forth6809.asm):02580                     LDD   4,S
D100 DD0A             (    forth6809.asm):02581                     STD   VARHERE
D102 EC62             (    forth6809.asm):02582                     LDD   2,S
D104 DD04             (    forth6809.asm):02583                     STD   LATEST
D106 CEBD00           (    forth6809.asm):02584                     LDU   #SP0
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02587                     ; See bugfix: QLOOP.1
D109 CC0000           (    forth6809.asm):02588                     LDD   #0
D10C DD00             (    forth6809.asm):02589                     STD   STATE
                      (    forth6809.asm):02590         
D10E ECE4             (    forth6809.asm):02591                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
D110 1083FFFF         (    forth6809.asm):02592                     CMPD  #-1
D114 2605             (    forth6809.asm):02593                     BNE   QSHOWERR
D116 326A             (    forth6809.asm):02594                     LEAS  10,S              ; drop the frame
D118 16FFB3           (    forth6809.asm):02595                     LBRA  QLOOP
                      (    forth6809.asm):02596         
D11B BDF0CD           (    forth6809.asm):02597         QSHOWERR:   JSR   CRW
D11E 8ED161           (    forth6809.asm):02598                     LDX   #ERRMSG
D121 3610             (    forth6809.asm):02599                     PSHU  X                 ; c-addr
D123 CC0008           (    forth6809.asm):02600                     LDD   #ERRMSGL
D126 3606             (    forth6809.asm):02601                     PSHU  D                 ; u
D128 BDEAA4           (    forth6809.asm):02602                     JSR   TYPEW
D12B ECE4             (    forth6809.asm):02603                     LDD   ,S
D12D 3606             (    forth6809.asm):02604                     PSHU  D                 ; n
D12F BDEF9C           (    forth6809.asm):02605                     JSR   DOTW
D132 326A             (    forth6809.asm):02606                     LEAS  10,S              ; drop the frame
D134 2098             (    forth6809.asm):02607                     BRA   QLOOP
                      (    forth6809.asm):02608         
D136 326A             (    forth6809.asm):02609         QOK:        LEAS  10,S              ; drop the frame
D138 BDF0CD           (    forth6809.asm):02610                     JSR   CRW               ; See bugfix: QOK.1
D13B DC00             (    forth6809.asm):02611                     LDD   STATE
D13D 268F             (    forth6809.asm):02612                     BNE   QLOOP
D13F 8ED15D           (    forth6809.asm):02613                     LDX   #OKMSG
D142 3610             (    forth6809.asm):02614                     PSHU  X                 ; c-addr
D144 CC0004           (    forth6809.asm):02615                     LDD   #OKMSGL
D147 3606             (    forth6809.asm):02616                     PSHU  D                 ; u
D149 BDEAA4           (    forth6809.asm):02617                     JSR   TYPEW
D14C 2080             (    forth6809.asm):02618                     BRA   QLOOP
                      (    forth6809.asm):02619         
D14E 3638303920464F52 (    forth6809.asm):02620         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02621         SIGNONL     EQU   *-SIGNON
D15D 20206F6B         (    forth6809.asm):02622         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02623         OKMSGL      EQU   *-OKMSG
D161 20204552524F5220 (    forth6809.asm):02624         ERRMSG:     FCC   "  ERROR "

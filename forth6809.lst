C100                  (    forth6809.asm):00402         UNITTESTS   SET   0                 ; default if -D not passed
                      (    forth6809.asm):00403                     ; Default 0: unit tests excluded; -DUNITTESTS=1 includes them.
                      (    forth6809.asm):00404                     ; Original comment: shadow UNITTESTS.1.
                      (    forth6809.asm):00405                     ENDC
                      (    forth6809.asm):00406         
                      (    forth6809.asm):00407                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00408         TSTSELECTOR SET   2                 ; default if -D not passed
                      (    forth6809.asm):00409                     ENDC

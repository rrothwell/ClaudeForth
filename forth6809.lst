                      (    forth6809.asm):07477         
                      (    forth6809.asm):07478         ; ------------------------------------------------------------
                      (    forth6809.asm):07479         ; HOLDS  ( c-addr u -- )
                      (    forth6809.asm):07480         ; Add the string c-addr u to the front of the pictured numeric output
                      (    forth6809.asm):07481         ; string.
                      (    forth6809.asm):07482         ; ------------------------------------------------------------
F9C8 ECC4             (    forth6809.asm):07483         HOLDSW:     LDD   ,U                ; u at 0, c-addr at 2
F9CA 2713             (    forth6809.asm):07484                     BEQ   HSDONE
F9CC 830001           (    forth6809.asm):07485                     SUBD  #1
F9CF EDC4             (    forth6809.asm):07486                     STD   ,U                ; remaining count
F9D1 AE42             (    forth6809.asm):07487                     LDX   2,U

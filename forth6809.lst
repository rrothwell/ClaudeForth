                      (    forth6809.asm):06516         ; to PAD and return its address and length.
                      (    forth6809.asm):06517         ; A 3-byte gap is reserved at CODEHERE while WORD parses, so that the
                      (    forth6809.asm):06518         ; compiled JSR DOSTR does not overwrite the text being staged.
                      (    forth6809.asm):06519         ; ------------------------------------------------------------

                      (    forth6809.asm):01643                    CMPD  #TSTVAL2
                      (    forth6809.asm):01644                    BNE   RO2FAIL
                      (    forth6809.asm):01645                    PULU  D
                      (    forth6809.asm):01646                    CMPD  #TSTVAL1
                      (    forth6809.asm):01647                    BNE   RO2FAIL
                      (    forth6809.asm):01648                    PULU  D
                      (    forth6809.asm):01649                    CMPD  #TSTVAL6

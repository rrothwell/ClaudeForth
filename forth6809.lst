                      (    forth6809.asm):03266         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03267         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03268         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03269         ;    Inputs:
                      (    forth6809.asm):03270         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03271         ;    Outputs:
                      (    forth6809.asm):03272         ;        single number: n and -1
                      (    forth6809.asm):03273         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03274         ;        not a number: c-addr and 0
                      (    forth6809.asm):03275         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03276         ; ------------------------------------------------------------
E4CA 3710             (    forth6809.asm):03277         NUMBERQ:    PULU  X                 ; c-addr
E4CC 9F1F             (    forth6809.asm):03278                     STX   CADDR
E4CE A684             (    forth6809.asm):03279                     LDA   ,X
E4D0 2772             (    forth6809.asm):03280                     BEQ   NQBAD
E4D2 9721             (    forth6809.asm):03281                     STA   CNTREM
E4D4 3001             (    forth6809.asm):03282                     LEAX  1,X
                      (    forth6809.asm):03283         
                      (    forth6809.asm):03284                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03285                     ; digit count. See shadow: NUMBERQ.1
E4D6 D621             (    forth6809.asm):03286                     LDB   CNTREM
E4D8 5A               (    forth6809.asm):03287                     DECB
E4D9 A685             (    forth6809.asm):03288                     LDA   B,X
E4DB 812E             (    forth6809.asm):03289                     CMPA  #'.'
E4DD 2604             (    forth6809.asm):03290                     BNE   NQNOSIGN
E4DF 0A21             (    forth6809.asm):03291                     DEC   CNTREM
E4E1 2761             (    forth6809.asm):03292                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03293         
E4E3 0F22             (    forth6809.asm):03294         NQNOSIGN:   CLR   NUMNEG
E4E5 A684             (    forth6809.asm):03295                     LDA   ,X
E4E7 812D             (    forth6809.asm):03296                     CMPA  #'-'
E4E9 2608             (    forth6809.asm):03297                     BNE   NQNOSIGN2
E4EB 0322             (    forth6809.asm):03298                     COM   NUMNEG
E4ED 3001             (    forth6809.asm):03299                     LEAX  1,X
E4EF 0A21             (    forth6809.asm):03300                     DEC   CNTREM
E4F1 2751             (    forth6809.asm):03301                     BEQ   NQBAD
                      (    forth6809.asm):03302         

                      (    forth6809.asm):13632         ; TSTUNESCAPE - unit test for UNESCAPE. Source "A%B" (3 chars,
                      (    forth6809.asm):13633         ; one '%' in the middle) doubles the '%' to produce "A%%B" (4
                      (    forth6809.asm):13634         ; chars) - confirmed via its own code and a prior session's
                      (    forth6809.asm):13635         ; already-corrected design comment that this is genuinely a
                      (    forth6809.asm):13636         ; doubling operation, not backslash-sequence decoding. Verifies
                      (    forth6809.asm):13637         ; every output character individually and the grown length,
                      (    forth6809.asm):13638         ; not just that some output was produced.
                      (    forth6809.asm):13639         ; ------------------------------------------------------------
C2B7                  (    forth6809.asm):13640         TSTUNESCAPE: LDA  #'A'
                      (    forth6809.asm):13641                      STA  TSTCBUF
                      (    forth6809.asm):13642                      LDA  #'%'
                      (    forth6809.asm):13643                      STA  TSTCBUF+1
                      (    forth6809.asm):13644                      LDA  #'B'
                      (    forth6809.asm):13645                      STA  TSTCBUF+2
                      (    forth6809.asm):13646         
                      (    forth6809.asm):13647                      STU  TSTU0
                      (    forth6809.asm):13648         
                      (    forth6809.asm):13649                      LDD  #TSTGUARD
                      (    forth6809.asm):13650                      PSHU D
                      (    forth6809.asm):13651                      LDD  #TSTCBUF
                      (    forth6809.asm):13652                      PSHU D
                      (    forth6809.asm):13653                      LDD  #3
                      (    forth6809.asm):13654                      PSHU D
                      (    forth6809.asm):13655                      LDD  #TSTCBUF+10
                      (    forth6809.asm):13656                      PSHU D
                      (    forth6809.asm):13657                      STU  TSTUB4
                      (    forth6809.asm):13658         
                      (    forth6809.asm):13659                      JSR  UNESCAPEW
                      (    forth6809.asm):13660         
                      (    forth6809.asm):13661                      STU  TSTUAF
                      (    forth6809.asm):13662         
                      (    forth6809.asm):13663                      PULU D
                      (    forth6809.asm):13664                      CMPD #4
                      (    forth6809.asm):13665                      BNE  UXFAIL
                      (    forth6809.asm):13666                      PULU D
                      (    forth6809.asm):13667                      CMPD #TSTCBUF+10
                      (    forth6809.asm):13668                      BNE  UXFAIL
                      (    forth6809.asm):13669         
                      (    forth6809.asm):13670                      TFR  D,X
                      (    forth6809.asm):13671                      LDA  ,X
                      (    forth6809.asm):13672                      CMPA #'A'
                      (    forth6809.asm):13673                      BNE  UXFAIL
                      (    forth6809.asm):13674                      LDA  1,X
                      (    forth6809.asm):13675                      CMPA #'%'
                      (    forth6809.asm):13676                      BNE  UXFAIL
                      (    forth6809.asm):13677                      LDA  2,X
                      (    forth6809.asm):13678                      CMPA #'%'
                      (    forth6809.asm):13679                      BNE  UXFAIL
                      (    forth6809.asm):13680                      LDA  3,X
                      (    forth6809.asm):13681                      CMPA #'B'
                      (    forth6809.asm):13682                      BNE  UXFAIL
                      (    forth6809.asm):13683         
                      (    forth6809.asm):13684                      PULU D
                      (    forth6809.asm):13685                      CMPD #TSTGUARD
                      (    forth6809.asm):13686                      BNE  UXFAIL
                      (    forth6809.asm):13687         
                      (    forth6809.asm):13688                      LDD  TSTUB4
                      (    forth6809.asm):13689                      SUBD TSTUAF
                      (    forth6809.asm):13690                      CMPD #-2
                      (    forth6809.asm):13691                      BNE  UXFAIL
                      (    forth6809.asm):13692         
                      (    forth6809.asm):13693                      LDD  #TRUEV
                      (    forth6809.asm):13694                      BRA  UXDONE
C2B7                  (    forth6809.asm):13695         UXFAIL:      LDD  #FALSEV
C2B7                  (    forth6809.asm):13696         UXDONE:      LDX  #TSTUENAME
                      (    forth6809.asm):13697                      PSHU X
                      (    forth6809.asm):13698                      PSHU D
                      (    forth6809.asm):13699                      JSR  TSTREPORT
                      (    forth6809.asm):13700         
                      (    forth6809.asm):13701                      LDU  TSTU0
                      (    forth6809.asm):13702                      RTS
                      (    forth6809.asm):13703         
C2B7                  (    forth6809.asm):13704         TSTUENAME: FCB  11
                      (    forth6809.asm):13705                    FCC  "TSTUNESCAPE"
                      (    forth6809.asm):13706         
                      (    forth6809.asm):13707                    ENDC ; <<<<
                      (    forth6809.asm):13708         
                      (    forth6809.asm):13709         ; ------------------------------------------------------------
                      (    forth6809.asm):13710         ; TSTNUMOUT - numeric output tests (glossary section 3.13, 14
                      (    forth6809.asm):13711         ; words, 13 tests since #S and #> are combined into one test,
                      (    forth6809.asm):13712         ; matching how they're naturally used together as the tail of
                      (    forth6809.asm):13713         ; the standard pictured-output idiom "<# ... #S #>").
                      (    forth6809.asm):13714         ;
                      (    forth6809.asm):13715         ; The pictured-numeric-output core (<# # #S #> HOLD HOLDS) is
                      (    forth6809.asm):13716         ; pure string-building with no I/O, tested directly. SIGN
                      (    forth6809.asm):13717         ; carries real bug-fix history - a prior bare BPL right after
                      (    forth6809.asm):13718         ; PULU didn't affect condition codes on real 6809 hardware, and
                      (    forth6809.asm):13719         ; the bug was masked for every internal caller by caller-side
                      (    forth6809.asm):13720         ; luck (each ran a flag-setting LDD right before calling SIGN).
                      (    forth6809.asm):13721         ; This section's own SIGN test deliberately poisons the flags
                      (    forth6809.asm):13722         ; with an unrelated CMPX immediately before each direct call,
                      (    forth6809.asm):13723         ; so it exercises the exact previously-broken scenario rather
                      (    forth6809.asm):13724         ; than repeating the same kind of luck that hid the bug.
                      (    forth6809.asm):13725         ;
                      (    forth6809.asm):13726         ; The high-level printing words (./U./.R/U.R/?/D./D.R) all
                      (    forth6809.asm):13727         ; produce real output via TYPE/EMIT internally, so each applies
                      (    forth6809.asm):13728         ; the SERIALPOLL-conditional split established in section 3.1 -
                      (    forth6809.asm):13729         ; full OUTHEAD/OUTBUF verification under SERIALPOLL=0, an
                      (    forth6809.asm):13730         ; EMITCH-based last-character check under SERIALPOLL=1. .R/U.R/
                      (    forth6809.asm):13731         ; D.R specifically test the padding path (a width wider than the
                      (    forth6809.asm):13732         ; actual digits), not just a no-padding sanity case. D./D.R use
                      (    forth6809.asm):13733         ; a genuine double-cell value (-100000, computed and verified
                      (    forth6809.asm):13734         ; independently in Python before writing the tests) to exercise
                      (    forth6809.asm):13735         ; the 32-bit negation path, not a value that happens to fit in
                      (    forth6809.asm):13736         ; one cell.
                      (    forth6809.asm):13737         ;
                      (    forth6809.asm):13738         ; Note: this section's own COMPARE-adjacent naming risk doesn't
                      (    forth6809.asm):13739         ; apply here, but every group wrapper name (TSTNUMOUT) and every
                      (    forth6809.asm):13740         ; internal FAIL/DONE prefix was still checked against the whole
                      (    forth6809.asm):13741         ; file before insertion, per the standard practice that caught
                      (    forth6809.asm):13742         ; the TSTCOMPARE collision in the prior section.
                      (    forth6809.asm):13743         ; ------------------------------------------------------------
C2B7 BDFC2B           (    forth6809.asm):13744         TSTNUMOUT: JSR CRW
C2BA 8EC2CB           (    forth6809.asm):13745                    LDX   #TSTNUMOUTMSG
C2BD 3610             (    forth6809.asm):13746                    PSHU  X
C2BF CC0006           (    forth6809.asm):13747                    LDD   #6
C2C2 3606             (    forth6809.asm):13748                    PSHU  D
C2C4 BDF60B           (    forth6809.asm):13749                    JSR   TYPE
C2C7 BDFC2B           (    forth6809.asm):13750                    JSR   CRW
                      (    forth6809.asm):13751         
                      (    forth6809.asm):13752                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13753         
                      (    forth6809.asm):13754                    JSR   TSTLTNUM
                      (    forth6809.asm):13755                    JSR   TSTHOLD
                      (    forth6809.asm):13756                    JSR   TSTHOLDS
                      (    forth6809.asm):13757                    JSR   TSTSIGN
                      (    forth6809.asm):13758                    JSR   TSTNUMSIGN
                      (    forth6809.asm):13759                    JSR   TSTNUMSIGNSGT
                      (    forth6809.asm):13760                    JSR   TSTDOT
                      (    forth6809.asm):13761                    JSR   TSTUDOT
                      (    forth6809.asm):13762                    JSR   TSTDOTR
                      (    forth6809.asm):13763                    JSR   TSTUDOTR
                      (    forth6809.asm):13764                    JSR   TSTQMARK
                      (    forth6809.asm):13765                    JSR   TSTDDOT
                      (    forth6809.asm):13766                    JSR   TSTDDOTR
                      (    forth6809.asm):13767         
                      (    forth6809.asm):13768                    ENDC ; <<<<
                      (    forth6809.asm):13769         
C2CA 39               (    forth6809.asm):13770                    RTS
                      (    forth6809.asm):13771         
C2CB 4E756D4F7574     (    forth6809.asm):13772         TSTNUMOUTMSG: FCC "NumOut"
                      (    forth6809.asm):13773         
                      (    forth6809.asm):13774                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13775         
                      (    forth6809.asm):13776         ; ------------------------------------------------------------
                      (    forth6809.asm):13777         ; Numeric Output test harness (glossary section 3.13). The
                      (    forth6809.asm):13778         ; pictured-numeric-output core (<# # #S #> HOLD HOLDS SIGN) is
                      (    forth6809.asm):13779         ; pure string-building with no I/O, tested directly. The
                      (    forth6809.asm):13780         ; high-level printing words (./U./.R/U.R/?/D./D.R) all produce
                      (    forth6809.asm):13781         ; real output via TYPE and/or EMIT internally, so per section
                      (    forth6809.asm):13782         ; 3.1's own already-debugged finding, each applies the
                      (    forth6809.asm):13783         ; SERIALPOLL-conditional split established there: full OUTHEAD/
                      (    forth6809.asm):13784         ; OUTBUF verification under SERIALPOLL=0, an EMITCH-based check
                      (    forth6809.asm):13785         ; of the last character under SERIALPOLL=1 - accepted as a
                      (    forth6809.asm):13786         ; known, honest limitation for words ending in a trailing space
                      (    forth6809.asm):13787         ; (./U./D. all print a fixed final space character, so the
                      (    forth6809.asm):13788         ; polling-mode check there confirms less than for the
                      (    forth6809.asm):13789         ; no-trailing-space words, but is still correct and consistent
                      (    forth6809.asm):13790         ; with the same trade-off already established for TSTCR/
                      (    forth6809.asm):13791         ; TSTSPACES/TSTTYPE/TSTDOTQUOTE in earlier sections).
                      (    forth6809.asm):13792         ;
                      (    forth6809.asm):13793         ; SIGN itself carries real bug-fix history: a prior version used
                      (    forth6809.asm):13794         ; a bare BPL immediately after PULU, which doesn't affect
                      (    forth6809.asm):13795         ; condition codes on real 6809 hardware - the bug was masked for
                      (    forth6809.asm):13796         ; every internal caller by "caller-side luck" (each happened to
                      (    forth6809.asm):13797         ; run a flag-setting LDD right before calling SIGN). This
                      (    forth6809.asm):13798         ; section's own SIGN test deliberately poisons the flags with an
                      (    forth6809.asm):13799         ; unrelated, known-positive value immediately before the actual
                      (    forth6809.asm):13800         ; PSHU/JSR SIGN sequence specifically so a standalone call - the
                      (    forth6809.asm):13801         ; exact scenario the bug-fix comment says was previously broken
                      (    forth6809.asm):13802         ; - is what gets tested, not a scenario that happens to work via
                      (    forth6809.asm):13803         ; the same kind of caller-side luck that hid the original bug.
                      (    forth6809.asm):13804         ; ------------------------------------------------------------
                      (    forth6809.asm):13805         
                      (    forth6809.asm):13806         ; ------------------------------------------------------------
                      (    forth6809.asm):13807         ; TSTLTNUM - unit test for <#. No stack effect of its own -
                      (    forth6809.asm):13808         ; verifies it sets HLD to PAD's current (redirected) address.
                      (    forth6809.asm):13809         ; ------------------------------------------------------------
C2D1                  (    forth6809.asm):13810         TSTLTNUM: LDD  CODEHERE
                      (    forth6809.asm):13811                   STD  TSTCSAV
                      (    forth6809.asm):13812         
                      (    forth6809.asm):13813                   LDD  #TSTCBUF
                      (    forth6809.asm):13814                   STD  CODEHERE
                      (    forth6809.asm):13815         
                      (    forth6809.asm):13816                   STU  TSTU0
                      (    forth6809.asm):13817         
                      (    forth6809.asm):13818                   LDD  #TSTGUARD
                      (    forth6809.asm):13819                   PSHU D
                      (    forth6809.asm):13820                   STU  TSTUB4
                      (    forth6809.asm):13821         
                      (    forth6809.asm):13822                   JSR  LTNUM
                      (    forth6809.asm):13823         
                      (    forth6809.asm):13824                   STU  TSTUAF
                      (    forth6809.asm):13825         
                      (    forth6809.asm):13826                   LDD  HLD
                      (    forth6809.asm):13827                   CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):13828                   BNE  LNFAIL
                      (    forth6809.asm):13829         
                      (    forth6809.asm):13830                   PULU D
                      (    forth6809.asm):13831                   CMPD #TSTGUARD
                      (    forth6809.asm):13832                   BNE  LNFAIL
                      (    forth6809.asm):13833         
                      (    forth6809.asm):13834                   LDD  TSTUB4
                      (    forth6809.asm):13835                   SUBD TSTUAF
                      (    forth6809.asm):13836                   CMPD #0
                      (    forth6809.asm):13837                   BNE  LNFAIL
                      (    forth6809.asm):13838         
                      (    forth6809.asm):13839                   LDD  #TRUEV
                      (    forth6809.asm):13840                   BRA  LNDONE
C2D1                  (    forth6809.asm):13841         LNFAIL:   LDD  #FALSEV
C2D1                  (    forth6809.asm):13842         LNDONE:   LDX  #TSTLNNAME
                      (    forth6809.asm):13843                   PSHU X
                      (    forth6809.asm):13844                   PSHU D
                      (    forth6809.asm):13845                   JSR  TSTREPORT
                      (    forth6809.asm):13846         
                      (    forth6809.asm):13847                   LDD  TSTCSAV
                      (    forth6809.asm):13848                   STD  CODEHERE
                      (    forth6809.asm):13849         
                      (    forth6809.asm):13850                   LDU  TSTU0
                      (    forth6809.asm):13851                   RTS
                      (    forth6809.asm):13852         
C2D1                  (    forth6809.asm):13853         TSTLNNAME: FCB  8
                      (    forth6809.asm):13854                    FCC  "TSTLTNUM"
                      (    forth6809.asm):13855         
                      (    forth6809.asm):13856         ; ------------------------------------------------------------
                      (    forth6809.asm):13857         ; TSTHOLD - unit test for HOLD. Holds 'A' then 'B' - since HOLD
                      (    forth6809.asm):13858         ; grows the buffer downward and prepends (decrements HLD first,
                      (    forth6809.asm):13859         ; then writes at the new, lower position), the second-held
                      (    forth6809.asm):13860         ; character ends up at the lower address, so reading forward
                      (    forth6809.asm):13861         ; from the final HLD should give "BA", not "AB".
                      (    forth6809.asm):13862         ; ------------------------------------------------------------
C2D1                  (    forth6809.asm):13863         TSTHOLD: LDD  CODEHERE
                      (    forth6809.asm):13864                  STD  TSTCSAV
                      (    forth6809.asm):13865         
                      (    forth6809.asm):13866                  LDD  #TSTCBUF
                      (    forth6809.asm):13867                  STD  CODEHERE
                      (    forth6809.asm):13868         
                      (    forth6809.asm):13869                  STU  TSTU0
                      (    forth6809.asm):13870         
                      (    forth6809.asm):13871                  LDD  #TSTGUARD
                      (    forth6809.asm):13872                  PSHU D
                      (    forth6809.asm):13873                  STU  TSTUB4
                      (    forth6809.asm):13874         
                      (    forth6809.asm):13875                  JSR  LTNUM
                      (    forth6809.asm):13876         
                      (    forth6809.asm):13877                  LDD  #'A'
                      (    forth6809.asm):13878                  PSHU D
                      (    forth6809.asm):13879                  JSR  HOLD
                      (    forth6809.asm):13880         
                      (    forth6809.asm):13881                  LDD  #'B'
                      (    forth6809.asm):13882                  PSHU D
                      (    forth6809.asm):13883                  JSR  HOLD
                      (    forth6809.asm):13884         
                      (    forth6809.asm):13885                  STU  TSTUAF
                      (    forth6809.asm):13886         
                      (    forth6809.asm):13887                  LDX  HLD
                      (    forth6809.asm):13888                  LDA  ,X
                      (    forth6809.asm):13889                  CMPA #'B'
                      (    forth6809.asm):13890                  BNE  HDFAIL
                      (    forth6809.asm):13891                  LDA  1,X
                      (    forth6809.asm):13892                  CMPA #'A'
                      (    forth6809.asm):13893                  BNE  HDFAIL
                      (    forth6809.asm):13894         
                      (    forth6809.asm):13895                  PULU D
                      (    forth6809.asm):13896                  CMPD #TSTGUARD
                      (    forth6809.asm):13897                  BNE  HDFAIL
                      (    forth6809.asm):13898         
                      (    forth6809.asm):13899                  LDD  TSTUB4
                      (    forth6809.asm):13900                  SUBD TSTUAF
                      (    forth6809.asm):13901                  CMPD #0
                      (    forth6809.asm):13902                  BNE  HDFAIL
                      (    forth6809.asm):13903         
                      (    forth6809.asm):13904                  LDD  #TRUEV
                      (    forth6809.asm):13905                  BRA  HDDONE
C2D1                  (    forth6809.asm):13906         HDFAIL:  LDD  #FALSEV
C2D1                  (    forth6809.asm):13907         HDDONE:  LDX  #TSTHDNAME
                      (    forth6809.asm):13908                  PSHU X
                      (    forth6809.asm):13909                  PSHU D
                      (    forth6809.asm):13910                  JSR  TSTREPORT
                      (    forth6809.asm):13911         
                      (    forth6809.asm):13912                  LDD  TSTCSAV
                      (    forth6809.asm):13913                  STD  CODEHERE
                      (    forth6809.asm):13914         
                      (    forth6809.asm):13915                  LDU  TSTU0
                      (    forth6809.asm):13916                  RTS
                      (    forth6809.asm):13917         
C2D1                  (    forth6809.asm):13918         TSTHDNAME: FCB  7
                      (    forth6809.asm):13919                    FCC  "TSTHOLD"
                      (    forth6809.asm):13920         
                      (    forth6809.asm):13921         ; ------------------------------------------------------------
                      (    forth6809.asm):13922         ; TSTHOLDS - unit test for HOLDS. Holds the string "XY" - since
                      (    forth6809.asm):13923         ; HOLDS iterates its source backward (last character first) and
                      (    forth6809.asm):13924         ; HOLD itself prepends, the two behaviors combine to preserve
                      (    forth6809.asm):13925         ; the original forward order in the pictured buffer, matching
                      (    forth6809.asm):13926         ; its own documented "depends on HOLD's exact decrement-by-one
                      (    forth6809.asm):13927         ; behavior".
                      (    forth6809.asm):13928         ; ------------------------------------------------------------
C2D1                  (    forth6809.asm):13929         TSTHOLDS: LDD  CODEHERE
                      (    forth6809.asm):13930                   STD  TSTCSAV
                      (    forth6809.asm):13931         
                      (    forth6809.asm):13932                   LDD  #TSTCBUF
                      (    forth6809.asm):13933                   STD  CODEHERE
                      (    forth6809.asm):13934         
                      (    forth6809.asm):13935                   LDA  #'X'
                      (    forth6809.asm):13936                   STA  TSTNAMEB
                      (    forth6809.asm):13937                   LDA  #'Y'
                      (    forth6809.asm):13938                   STA  TSTNAMEB+1
                      (    forth6809.asm):13939         
                      (    forth6809.asm):13940                   STU  TSTU0
                      (    forth6809.asm):13941         
                      (    forth6809.asm):13942                   LDD  #TSTGUARD
                      (    forth6809.asm):13943                   PSHU D
                      (    forth6809.asm):13944                   STU  TSTUB4
                      (    forth6809.asm):13945         
                      (    forth6809.asm):13946                   JSR  LTNUM
                      (    forth6809.asm):13947         
                      (    forth6809.asm):13948                   LDD  #TSTNAMEB
                      (    forth6809.asm):13949                   PSHU D
                      (    forth6809.asm):13950                   LDD  #2
                      (    forth6809.asm):13951                   PSHU D
                      (    forth6809.asm):13952                   JSR  HOLDS
                      (    forth6809.asm):13953         
                      (    forth6809.asm):13954                   STU  TSTUAF
                      (    forth6809.asm):13955         
                      (    forth6809.asm):13956                   LDX  HLD
                      (    forth6809.asm):13957                   LDA  ,X
                      (    forth6809.asm):13958                   CMPA #'X'
                      (    forth6809.asm):13959                   BNE  HOFAIL
                      (    forth6809.asm):13960                   LDA  1,X
                      (    forth6809.asm):13961                   CMPA #'Y'
                      (    forth6809.asm):13962                   BNE  HOFAIL
                      (    forth6809.asm):13963         
                      (    forth6809.asm):13964                   PULU D
                      (    forth6809.asm):13965                   CMPD #TSTGUARD
                      (    forth6809.asm):13966                   BNE  HOFAIL
                      (    forth6809.asm):13967         
                      (    forth6809.asm):13968                   LDD  TSTUB4
                      (    forth6809.asm):13969                   SUBD TSTUAF
                      (    forth6809.asm):13970                   CMPD #0
                      (    forth6809.asm):13971                   BNE  HOFAIL
                      (    forth6809.asm):13972         
                      (    forth6809.asm):13973                   LDD  #TRUEV
                      (    forth6809.asm):13974                   BRA  HODONE
C2D1                  (    forth6809.asm):13975         HOFAIL:   LDD  #FALSEV
C2D1                  (    forth6809.asm):13976         HODONE:   LDX  #TSTHSNAME
                      (    forth6809.asm):13977                   PSHU X
                      (    forth6809.asm):13978                   PSHU D
                      (    forth6809.asm):13979                   JSR  TSTREPORT
                      (    forth6809.asm):13980         
                      (    forth6809.asm):13981                   LDD  TSTCSAV
                      (    forth6809.asm):13982                   STD  CODEHERE
                      (    forth6809.asm):13983         
                      (    forth6809.asm):13984                   LDU  TSTU0
                      (    forth6809.asm):13985                   RTS
                      (    forth6809.asm):13986         
C2D1                  (    forth6809.asm):13987         TSTHSNAME: FCB  8
                      (    forth6809.asm):13988                    FCC  "TSTHOLDS"
                      (    forth6809.asm):13989         
                      (    forth6809.asm):13990         ; ------------------------------------------------------------
                      (    forth6809.asm):13991         ; TSTSIGN - unit test for SIGN. Deliberately poisons the CPU
                      (    forth6809.asm):13992         ; flags with an unrelated CMPX (setting them to reflect a
                      (    forth6809.asm):13993         ; positive comparison result, without touching D or the value
                      (    forth6809.asm):13994         ; about to be pushed) immediately before each PSHU/JSR SIGN
                      (    forth6809.asm):13995         ; call - specifically so this test exercises the exact scenario
                      (    forth6809.asm):13996         ; the word's own bug-fix comment says was previously broken (a
                      (    forth6809.asm):13997         ; direct, standalone call not preceded by a flag-setting LDD of
                      (    forth6809.asm):13998         ; the true value), rather than relying on the same kind of
                      (    forth6809.asm):13999         ; caller-side luck that hid the original bug. Two sub-cases:
                      (    forth6809.asm):14000         ; negative (with flags poisoned toward positive, confirming the
                      (    forth6809.asm):14001         ; minus sign still gets added - would fail if SIGN reverted to
                      (    forth6809.asm):14002         ; testing stale flags instead of the value it just popped) and
                      (    forth6809.asm):14003         ; positive (with flags poisoned toward negative, confirming no
                      (    forth6809.asm):14004         ; minus sign gets added incorrectly).

                      (    forth6809.asm):06062         ; TSTQDOLPEQ - unit test for ?DO/LOOP, limit=index case - the
                      (    forth6809.asm):06063         ; documented case that DISTINGUISHES ?DO from plain DO: skips
                      (    forth6809.asm):06064         ; the loop entirely, unlike DO's own limit=index behavior
                      (    forth6809.asm):06065         ; (confirmed separately to take a full 65536-iteration
                      (    forth6809.asm):06066         ; wraparound, not tested here - see TSTDOLP's own notes). This
                      (    forth6809.asm):06067         ; case IS fast and safe to test directly: QDOSETUP's own skip
                      (    forth6809.asm):06068         ; check happens before the loop is entered at all, confirmed by
                      (    forth6809.asm):06069         ; hand-trace of its code. Same "?DO I + LOOP" body, but since
                      (    forth6809.asm):06070         ; the body never runs, the seed should come back completely
                      (    forth6809.asm):06071         ; unchanged (0, not 10).
                      (    forth6809.asm):06072         ; ------------------------------------------------------------

                      (    forth6809.asm):15440         ; TSTLPAREN - unit test for (. Fake source "hi)m" with TOIN
                      (    forth6809.asm):15441         ; starting at 0 - verifies TOIN lands exactly past the closing
                      (    forth6809.asm):15442         ; paren (at 3, immediately before "m", not consuming it), and
                      (    forth6809.asm):15443         ; that the data stack is genuinely unchanged - the specific
                      (    forth6809.asm):15444         ; behavior the bug-fix comment describes as previously broken.
                      (    forth6809.asm):15445         ; Since ( only ever advances TOIN, never SRCADDR itself, the
                      (    forth6809.asm):15446         ; fake source's own known address (TSTNAMEB) is used directly to
                      (    forth6809.asm):15447         ; verify the character just past the paren, with no need to
                      (    forth6809.asm):15448         ; re-read SRCADDR after the call.

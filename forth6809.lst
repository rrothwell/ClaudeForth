                      (    forth6809.asm):03074         ; ------------------------------------------------------------
                      (    forth6809.asm):03075         ; Multiply the unsigned double UDHI:UDLO by BASE and add a digit.
                      (    forth6809.asm):03076         ; UDMULADD
                      (    forth6809.asm):03077         ;    Inputs:
                      (    forth6809.asm):03078         ;        UDHI:UDLO = ud
                      (    forth6809.asm):03079         ;        RegB = digit value to add
                      (    forth6809.asm):03080         ;        BASE
                      (    forth6809.asm):03081         ;    Outputs:
                      (    forth6809.asm):03082         ;        UDHI:UDLO = ud * BASE + digit
                      (    forth6809.asm):03083         ;    Registers: RegA, RegB and CC changed; CARRY and MULBASE used as
                      (    forth6809.asm):03084         ;        scratch.
                      (    forth6809.asm):03085         ; ------------------------------------------------------------
E40D D71D             (    forth6809.asm):03086         UDMULADD:   STB   CARRY
E40F 9603             (    forth6809.asm):03087                     LDA   BASE+1
E411 971C             (    forth6809.asm):03088                     STA   MULBASE
E413 9649             (    forth6809.asm):03089                     LDA   UDLO+1
E415 D61C             (    forth6809.asm):03090                     LDB   MULBASE
E417 3D               (    forth6809.asm):03091                     MUL
E418 DB1D             (    forth6809.asm):03092                     ADDB  CARRY
E41A 2401             (    forth6809.asm):03093                     BCC   UM0
E41C 4C               (    forth6809.asm):03094                     INCA
E41D D749             (    forth6809.asm):03095         UM0:        STB   UDLO+1
E41F 971D             (    forth6809.asm):03096                     STA   CARRY
E421 9648             (    forth6809.asm):03097                     LDA   UDLO
E423 D61C             (    forth6809.asm):03098                     LDB   MULBASE
E425 3D               (    forth6809.asm):03099                     MUL
E426 DB1D             (    forth6809.asm):03100                     ADDB  CARRY
E428 2401             (    forth6809.asm):03101                     BCC   UM1
E42A 4C               (    forth6809.asm):03102                     INCA
E42B D748             (    forth6809.asm):03103         UM1:        STB   UDLO

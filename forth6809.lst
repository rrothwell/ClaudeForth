                      (    forth6809.asm):07517         ; Verify no collision with init code,
                      (    forth6809.asm):07518         ; value should match ORG INITCODE.
     FF88             (    forth6809.asm):07519         BASECODEEND  EQU   *
     225A             (    forth6809.asm):07520         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07521         
                      (    forth6809.asm):07522         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07523         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07524         ; .bin file.
FF88                  (    forth6809.asm):07525         BASEND:
FF88 FFFFFFFFFFFFFFFF (    forth6809.asm):07526                  FILL $FF,INITCODE-BASEND
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFF

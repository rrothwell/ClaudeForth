                      (    forth6809.asm):07539         ; ------------------------------------------------------------
                      (    forth6809.asm):07540         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07541         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07542         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07543         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07544         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07545         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07546         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07547         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07548         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07549         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07550         ; ------------------------------------------------------------
E97F BDD249           (    forth6809.asm):07551         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
E982 ECC4             (    forth6809.asm):07552                     LDD   ,U
E984 3406             (    forth6809.asm):07553                     PSHS  D                 ; output pointer
E986 3406             (    forth6809.asm):07554                     PSHS  D                 ; output start
E988 DC39             (    forth6809.asm):07555                     LDD   SRCADDR
E98A D33B             (    forth6809.asm):07556                     ADDD  SRCLEN
E98C 3406             (    forth6809.asm):07557                     PSHS  D                 ; input end
E98E DC39             (    forth6809.asm):07558                     LDD   SRCADDR
E990 D310             (    forth6809.asm):07559                     ADDD  TOIN
E992 1F02             (    forth6809.asm):07560                     TFR   D,Y               ; input pointer
E994 10AC60           (    forth6809.asm):07561         SQEL:       CMPY  0,S
E997 247E             (    forth6809.asm):07562                     BHS   SQEND
E999 A6A0             (    forth6809.asm):07563                     LDA   ,Y+
E99B 8122             (    forth6809.asm):07564                     CMPA  #34
E99D 2778             (    forth6809.asm):07565                     BEQ   SQEND
E99F 815C             (    forth6809.asm):07566                     CMPA  #92
E9A1 261C             (    forth6809.asm):07567                     BNE   SQEPUT

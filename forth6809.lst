                      (    forth6809.asm):08196         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):08197         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):08198         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):08199         ; enter COLD.
                      (    forth6809.asm):08200         ; COLDSTRT
                      (    forth6809.asm):08201         ;    Inputs:
                      (    forth6809.asm):08202         ;        hardware reset
                      (    forth6809.asm):08203         ;    Outputs:
                      (    forth6809.asm):08204         ;        does not return
                      (    forth6809.asm):08205         ;    Registers: all registers initialised.
                      (    forth6809.asm):08206         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):08207         COLDSTRT:

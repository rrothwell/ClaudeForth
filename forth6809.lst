                      (    forth6809.asm):06469         ; ============================================================
                      (    forth6809.asm):06470         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06471         ; ============================================================
                      (    forth6809.asm):06472         ; ------------------------------------------------------------
                      (    forth6809.asm):06473         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06474         ; address and length and skip over it.
                      (    forth6809.asm):06475         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06476         ;    Inputs:
                      (    forth6809.asm):06477         ;        return address on S points at the count byte
                      (    forth6809.asm):06478         ;    Outputs:
                      (    forth6809.asm):06479         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06480         ;        string
                      (    forth6809.asm):06481         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06482         ; ------------------------------------------------------------
F37C 3510             (    forth6809.asm):06483         DOSTR:      PULS  X
F37E E684             (    forth6809.asm):06484                     LDB   ,X
F380 3001             (    forth6809.asm):06485                     LEAX  1,X
F382 3610             (    forth6809.asm):06486                     PSHU  X
F384 4F               (    forth6809.asm):06487                     CLRA
F385 3606             (    forth6809.asm):06488                     PSHU  D
F387 3085             (    forth6809.asm):06489                     LEAX  B,X
F389 3410             (    forth6809.asm):06490                     PSHS  X
F38B 39               (    forth6809.asm):06491                     RTS
                      (    forth6809.asm):06492         
                      (    forth6809.asm):06493         ; ------------------------------------------------------------
                      (    forth6809.asm):06494         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06495         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06496         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06497         ; PARSEQUOTE
                      (    forth6809.asm):06498         ;    Inputs:
                      (    forth6809.asm):06499         ;        none (parses from >IN)
                      (    forth6809.asm):06500         ;    Outputs:
                      (    forth6809.asm):06501         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06502         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06503         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06504         ; ------------------------------------------------------------
F38C CC0022           (    forth6809.asm):06505         PARSEQUOTE: LDD   #34
F38F 3606             (    forth6809.asm):06506                     PSHU  D
F391 BDF485           (    forth6809.asm):06507                     JSR   PARSEW
F394 6DC4             (    forth6809.asm):06508                     TST   ,U                ; high byte of the length
F396 2601             (    forth6809.asm):06509                     BNE   PQLONG
F398 39               (    forth6809.asm):06510                     RTS
F399 CCFFEE           (    forth6809.asm):06511         PQLONG:     LDD   #-18
F39C 3606             (    forth6809.asm):06512                     PSHU  D
F39E 7EE4F6           (    forth6809.asm):06513                     JMP   THROWW
                      (    forth6809.asm):06514         
                      (    forth6809.asm):06515         ; ------------------------------------------------------------
                      (    forth6809.asm):06516         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06517         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06518         ;    Inputs:
                      (    forth6809.asm):06519         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06520         ;        c-addr u on the data stack
                      (    forth6809.asm):06521         ;    Outputs:
                      (    forth6809.asm):06522         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06523         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06524         ; ------------------------------------------------------------
F3A1 3606             (    forth6809.asm):06525         CSTRCOMP:   PSHU  D
F3A3 BDE931           (    forth6809.asm):06526                     JSR   CCALL
F3A6 3706             (    forth6809.asm):06527                     PULU  D                 ; u
F3A8 3720             (    forth6809.asm):06528                     PULU  Y                 ; c-addr
F3AA 9E08             (    forth6809.asm):06529                     LDX   CODEHERE
F3AC E780             (    forth6809.asm):06530                     STB   ,X+
F3AE 5D               (    forth6809.asm):06531                     TSTB
F3AF 2707             (    forth6809.asm):06532                     BEQ   CSEND
F3B1 A6A0             (    forth6809.asm):06533         CSCPY:      LDA   ,Y+
F3B3 A780             (    forth6809.asm):06534                     STA   ,X+
F3B5 5A               (    forth6809.asm):06535                     DECB
F3B6 26F9             (    forth6809.asm):06536                     BNE   CSCPY
F3B8 9F08             (    forth6809.asm):06537         CSEND:      STX   CODEHERE
F3BA 39               (    forth6809.asm):06538                     RTS
                      (    forth6809.asm):06539         
                      (    forth6809.asm):06540         ; ------------------------------------------------------------
                      (    forth6809.asm):06541         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06542         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06543         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06544         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06545         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06546         ; ------------------------------------------------------------
F3BB BDF38C           (    forth6809.asm):06547         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F3BE DC00             (    forth6809.asm):06548                     LDD   STATE
F3C0 2706             (    forth6809.asm):06549                     BEQ   SQINTERP
F3C2 CCF37C           (    forth6809.asm):06550                     LDD   #DOSTR
F3C5 7EF3A1           (    forth6809.asm):06551                     JMP   CSTRCOMP
                      (    forth6809.asm):06552         
                      (    forth6809.asm):06553                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06554                     ; SQUOTEW.2.
F3C8                  (    forth6809.asm):06555         SQINTERP:
F3C8 BDDEB0           (    forth6809.asm):06556                     JSR   PADW
F3CB 3710             (    forth6809.asm):06557                     PULU  X                 ; PAD
F3CD 3706             (    forth6809.asm):06558                     PULU  D                 ; u
F3CF 3720             (    forth6809.asm):06559                     PULU  Y                 ; c-addr
F3D1 3610             (    forth6809.asm):06560                     PSHU  X                 ; result c-addr
F3D3 3606             (    forth6809.asm):06561                     PSHU  D                 ; result u
F3D5 5D               (    forth6809.asm):06562                     TSTB
F3D6 2707             (    forth6809.asm):06563                     BEQ   SQIEND
F3D8 A6A0             (    forth6809.asm):06564         SQICPY:     LDA   ,Y+
F3DA A780             (    forth6809.asm):06565                     STA   ,X+
F3DC 5A               (    forth6809.asm):06566                     DECB
F3DD 26F9             (    forth6809.asm):06567                     BNE   SQICPY
F3DF 39               (    forth6809.asm):06568         SQIEND:     RTS
                      (    forth6809.asm):06569         
                      (    forth6809.asm):06570         ; ------------------------------------------------------------
                      (    forth6809.asm):06571         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06572         ; and skip over it.
                      (    forth6809.asm):06573         ; DOTSTR
                      (    forth6809.asm):06574         ;    Inputs:
                      (    forth6809.asm):06575         ;        return address on S points at the count byte
                      (    forth6809.asm):06576         ;    Outputs:
                      (    forth6809.asm):06577         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06578         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06579         ; ------------------------------------------------------------
F3E0 3510             (    forth6809.asm):06580         DOTSTR:     PULS  X
F3E2 E684             (    forth6809.asm):06581                     LDB   ,X
F3E4 3001             (    forth6809.asm):06582                     LEAX  1,X
F3E6 3610             (    forth6809.asm):06583                     PSHU  X
F3E8 4F               (    forth6809.asm):06584                     CLRA
F3E9 3606             (    forth6809.asm):06585                     PSHU  D
F3EB 3085             (    forth6809.asm):06586                     LEAX  B,X
F3ED 3410             (    forth6809.asm):06587                     PSHS  X
F3EF 7EF428           (    forth6809.asm):06588                     JMP   TYPEW
                      (    forth6809.asm):06589         
                      (    forth6809.asm):06590         ; ------------------------------------------------------------
                      (    forth6809.asm):06591         ; ."  ( "ccc<quote>" -- )
                      (    forth6809.asm):06592         ; Compile DOTSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06593         ; counted string.
                      (    forth6809.asm):06594         ; ------------------------------------------------------------
F3F2 BDF38C           (    forth6809.asm):06595         DOTQUOTEW:  JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F3F5 CCF3E0           (    forth6809.asm):06596                     LDD   #DOTSTR
F3F8 7EF3A1           (    forth6809.asm):06597                     JMP   CSTRCOMP
                      (    forth6809.asm):06598         
                      (    forth6809.asm):06599         ; ------------------------------------------------------------
                      (    forth6809.asm):06600         ; Run-time part of C"  The counted string follows the call: push its
                      (    forth6809.asm):06601         ; address and skip over it.
                      (    forth6809.asm):06602         ; DOCSTR
                      (    forth6809.asm):06603         ;    Outputs:
                      (    forth6809.asm):06604         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):06605         ;        the string
                      (    forth6809.asm):06606         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06607         ; ------------------------------------------------------------
F3FB 3510             (    forth6809.asm):06608         DOCSTR:     PULS  X
F3FD 3610             (    forth6809.asm):06609                     PSHU  X
F3FF E684             (    forth6809.asm):06610                     LDB   ,X
F401 3001             (    forth6809.asm):06611                     LEAX  1,X
F403 3085             (    forth6809.asm):06612                     LEAX  B,X
F405 3410             (    forth6809.asm):06613                     PSHS  X
F407 39               (    forth6809.asm):06614                     RTS
                      (    forth6809.asm):06615         
                      (    forth6809.asm):06616         ; ------------------------------------------------------------
                      (    forth6809.asm):06617         ; C"  ( "ccc<quote>" -- )  compile: ( -- c-addr ) run-time
                      (    forth6809.asm):06618         ; Compile DOCSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06619         ; counted string. THROW -14 if not compiling.
                      (    forth6809.asm):06620         ; ------------------------------------------------------------
F408 DC00             (    forth6809.asm):06621         CQUOTEW:    LDD   STATE
F40A 2608             (    forth6809.asm):06622                     BNE   CQOK
F40C CCFFF2           (    forth6809.asm):06623                     LDD   #-14
F40F 3606             (    forth6809.asm):06624                     PSHU  D
F411 BDE4F6           (    forth6809.asm):06625                     JSR   THROWW
F414 BDF38C           (    forth6809.asm):06626         CQOK:       JSR   PARSEQUOTE
F417 CCF3FB           (    forth6809.asm):06627                     LDD   #DOCSTR
F41A 7EF3A1           (    forth6809.asm):06628                     JMP   CSTRCOMP
                      (    forth6809.asm):06629         
                      (    forth6809.asm):06630         ; ------------------------------------------------------------
                      (    forth6809.asm):06631         ; .(  ( "ccc<paren>" -- )
                      (    forth6809.asm):06632         ; Immediate. Parse up to the closing parenthesis and display the text
                      (    forth6809.asm):06633         ; at once, even while compiling.
                      (    forth6809.asm):06634         ; ------------------------------------------------------------
F41D CC0029           (    forth6809.asm):06635         DOTPARENW:  LDD   #41
F420 3606             (    forth6809.asm):06636                     PSHU  D
F422 BDF485           (    forth6809.asm):06637                     JSR   PARSEW
F425 7EF428           (    forth6809.asm):06638                     JMP   TYPEW
                      (    forth6809.asm):06639         
                      (    forth6809.asm):06640         ; ------------------------------------------------------------
                      (    forth6809.asm):06641         ; TYPE  ( c-addr u -- )
                      (    forth6809.asm):06642         ; Display u characters starting at c-addr, through EMIT.
                      (    forth6809.asm):06643         ; ------------------------------------------------------------
F428 ECC4             (    forth6809.asm):06644         TYPEW:      LDD   ,U                ; u. Parameters stay on the data stack:
F42A 2717             (    forth6809.asm):06645                     BEQ   TYDONE            ; u at 0, c-addr at 2
F42C AE42             (    forth6809.asm):06646         TYLOOP:     LDX   2,U
F42E A680             (    forth6809.asm):06647                     LDA   ,X+
F430 AF42             (    forth6809.asm):06648                     STX   2,U
F432 1F89             (    forth6809.asm):06649                     TFR   A,B
F434 4F               (    forth6809.asm):06650                     CLRA
F435 3606             (    forth6809.asm):06651                     PSHU  D
F437 BDE41A           (    forth6809.asm):06652                     JSR   EMITW
F43A ECC4             (    forth6809.asm):06653                     LDD   ,U
F43C 830001           (    forth6809.asm):06654                     SUBD  #1
F43F EDC4             (    forth6809.asm):06655                     STD   ,U
F441 26E9             (    forth6809.asm):06656                     BNE   TYLOOP
F443 3344             (    forth6809.asm):06657         TYDONE:     LEAU  4,U               ; drop the two parameters
F445 39               (    forth6809.asm):06658                     RTS
                      (    forth6809.asm):06659         
                      (    forth6809.asm):06660         ; ------------------------------------------------------------
                      (    forth6809.asm):06661         ; COUNT  ( c-addr1 -- c-addr2 u )
                      (    forth6809.asm):06662         ; Convert a counted string to its address and length.
                      (    forth6809.asm):06663         ; ------------------------------------------------------------
F446 3710             (    forth6809.asm):06664         COUNTW:     PULU  X                 ; c-addr1
F448 E684             (    forth6809.asm):06665                     LDB   ,X
F44A 4F               (    forth6809.asm):06666                     CLRA
F44B DD14             (    forth6809.asm):06667                     STD   MSCR
F44D 3001             (    forth6809.asm):06668                     LEAX  1,X
F44F 3610             (    forth6809.asm):06669                     PSHU  X
F451 DC14             (    forth6809.asm):06670                     LDD   MSCR
F453 3606             (    forth6809.asm):06671                     PSHU  D
F455 39               (    forth6809.asm):06672                     RTS
                      (    forth6809.asm):06673         
                      (    forth6809.asm):06674         ; ------------------------------------------------------------
                      (    forth6809.asm):06675         ; CHAR  ( "name" -- char )
                      (    forth6809.asm):06676         ; Parse the next blank-delimited name and return its first character.
                      (    forth6809.asm):06677         ; ------------------------------------------------------------
F456 CC0020           (    forth6809.asm):06678         CHARW:      LDD   #32
F459 3606             (    forth6809.asm):06679                     PSHU  D
F45B BDE1F0           (    forth6809.asm):06680                     JSR   WORDW
F45E 3710             (    forth6809.asm):06681                     PULU  X
F460 E601             (    forth6809.asm):06682                     LDB   1,X
F462 4F               (    forth6809.asm):06683                     CLRA
F463 3606             (    forth6809.asm):06684                     PSHU  D
F465 39               (    forth6809.asm):06685                     RTS
                      (    forth6809.asm):06686         
                      (    forth6809.asm):06687         ; ------------------------------------------------------------
                      (    forth6809.asm):06688         ; [CHAR]  ( "name" -- )
                      (    forth6809.asm):06689         ; Compile the first character of the next name as a literal. THROW -14
                      (    forth6809.asm):06690         ; if not compiling.
                      (    forth6809.asm):06691         ; ------------------------------------------------------------
F466 DC00             (    forth6809.asm):06692         BRACKCHARW: LDD   STATE
F468 2608             (    forth6809.asm):06693                     BNE   BCSTOK
F46A CCFFF2           (    forth6809.asm):06694                     LDD   #-14              ; -14
F46D 3606             (    forth6809.asm):06695                     PSHU  D
F46F BDE4F6           (    forth6809.asm):06696                     JSR   THROWW
F472 CC0020           (    forth6809.asm):06697         BCSTOK:     LDD   #32
F475 3606             (    forth6809.asm):06698                     PSHU  D
F477 BDE1F0           (    forth6809.asm):06699                     JSR   WORDW
F47A 3710             (    forth6809.asm):06700                     PULU  X
F47C E601             (    forth6809.asm):06701                     LDB   1,X
F47E 4F               (    forth6809.asm):06702                     CLRA
F47F 3606             (    forth6809.asm):06703                     PSHU  D
F481 BDE93E           (    forth6809.asm):06704                     JSR   LITERALW
F484 39               (    forth6809.asm):06705                     RTS
                      (    forth6809.asm):06706         
                      (    forth6809.asm):06707         ; ------------------------------------------------------------
                      (    forth6809.asm):06708         ; PARSE  ( char "ccc<char>" -- c-addr u )
                      (    forth6809.asm):06709         ; Parse the input up to the delimiter char (which is consumed) and
                      (    forth6809.asm):06710         ; return the parsed text. A >IN beyond the end of the input is treated
                      (    forth6809.asm):06711         ; as an exhausted input (empty result).
                      (    forth6809.asm):06712         ; ------------------------------------------------------------
F485 3706             (    forth6809.asm):06713         PARSEW:     PULU  D                 ; char
F487 3404             (    forth6809.asm):06714                     PSHS  B                 ; 0,S = delimiter (5k: no scratch cells)
F489 DC3B             (    forth6809.asm):06715                     LDD   SRCLEN
F48B 9310             (    forth6809.asm):06716                     SUBD  TOIN
F48D 10250035         (    forth6809.asm):06717                     LBLO  PEMP              ; See bugfix: PARSEW.1
F491 1F02             (    forth6809.asm):06718                     TFR   D,Y
F493 DC10             (    forth6809.asm):06719                     LDD   TOIN
F495 9E39             (    forth6809.asm):06720                     LDX   SRCADDR
F497 308B             (    forth6809.asm):06721                     LEAX  D,X
F499 3610             (    forth6809.asm):06722                     PSHU  X                 ; c-addr result; u is computed at the end
F49B 108C0000         (    forth6809.asm):06723         PSCAN:      CMPY  #0
F49F 2716             (    forth6809.asm):06724                     BEQ   PDONE
F4A1 A684             (    forth6809.asm):06725                     LDA   ,X
F4A3 A1E4             (    forth6809.asm):06726                     CMPA  ,S
F4A5 2706             (    forth6809.asm):06727                     BEQ   PFOUND
F4A7 3001             (    forth6809.asm):06728                     LEAX  1,X
F4A9 313F             (    forth6809.asm):06729                     LEAY  -1,Y
F4AB 20EE             (    forth6809.asm):06730                     BRA   PSCAN
F4AD 1F10             (    forth6809.asm):06731         PFOUND:     TFR   X,D
F4AF A3C4             (    forth6809.asm):06732                     SUBD  ,U                ; length excludes the delimiter
F4B1 3606             (    forth6809.asm):06733                     PSHU  D
F4B3 3001             (    forth6809.asm):06734                     LEAX  1,X               ; consume the delimiter
F4B5 2006             (    forth6809.asm):06735                     BRA   PFIN
F4B7 1F10             (    forth6809.asm):06736         PDONE:      TFR   X,D
F4B9 A3C4             (    forth6809.asm):06737                     SUBD  ,U
F4BB 3606             (    forth6809.asm):06738                     PSHU  D
F4BD 1F10             (    forth6809.asm):06739         PFIN:       TFR   X,D
F4BF 9339             (    forth6809.asm):06740                     SUBD  SRCADDR
F4C1 DD10             (    forth6809.asm):06741                     STD   TOIN
F4C3 3261             (    forth6809.asm):06742                     LEAS  1,S
F4C5 39               (    forth6809.asm):06743                     RTS
F4C6 3261             (    forth6809.asm):06744         PEMP:       LEAS  1,S
F4C8 16004B           (    forth6809.asm):06745                     LBRA  PNEMPTY
                      (    forth6809.asm):06746         
                      (    forth6809.asm):06747         ; ------------------------------------------------------------
                      (    forth6809.asm):06748         ; PARSE-NAME  ( "<spaces>name<space>" -- c-addr u )
                      (    forth6809.asm):06749         ; Skip leading blanks, then parse a blank-delimited name and return
                      (    forth6809.asm):06750         ; it. An empty result is returned at the end of the input.
                      (    forth6809.asm):06751         ; ------------------------------------------------------------
F4CB DC10             (    forth6809.asm):06752         PARSENAMEW: LDD   TOIN
F4CD 9E39             (    forth6809.asm):06753                     LDX   SRCADDR
F4CF 308B             (    forth6809.asm):06754                     LEAX  D,X
F4D1 DC3B             (    forth6809.asm):06755                     LDD   SRCLEN
F4D3 9310             (    forth6809.asm):06756                     SUBD  TOIN
F4D5 253F             (    forth6809.asm):06757                     BLO   PNEMPTY           ; See bugfix: PARSENAMEW.1
F4D7 1F02             (    forth6809.asm):06758                     TFR   D,Y
F4D9 108C0000         (    forth6809.asm):06759         PNSKIP:     CMPY  #0
F4DD 2737             (    forth6809.asm):06760                     BEQ   PNEMPTY
F4DF A684             (    forth6809.asm):06761                     LDA   ,X
F4E1 8120             (    forth6809.asm):06762                     CMPA  #32
F4E3 2606             (    forth6809.asm):06763                     BNE   PNSTART
F4E5 3001             (    forth6809.asm):06764                     LEAX  1,X
F4E7 313F             (    forth6809.asm):06765                     LEAY  -1,Y
F4E9 20EE             (    forth6809.asm):06766                     BRA   PNSKIP
F4EB 3610             (    forth6809.asm):06767         PNSTART:    PSHU  X                 ; c-addr result
F4ED 108C0000         (    forth6809.asm):06768         PNSCAN:     CMPY  #0
F4F1 2716             (    forth6809.asm):06769                     BEQ   PNDONE
F4F3 A684             (    forth6809.asm):06770                     LDA   ,X
F4F5 8120             (    forth6809.asm):06771                     CMPA  #32
F4F7 2706             (    forth6809.asm):06772                     BEQ   PNFOUND
F4F9 3001             (    forth6809.asm):06773                     LEAX  1,X
F4FB 313F             (    forth6809.asm):06774                     LEAY  -1,Y
F4FD 20EE             (    forth6809.asm):06775                     BRA   PNSCAN
F4FF 1F10             (    forth6809.asm):06776         PNFOUND:    TFR   X,D
F501 A3C4             (    forth6809.asm):06777                     SUBD  ,U
F503 3606             (    forth6809.asm):06778                     PSHU  D
F505 3001             (    forth6809.asm):06779                     LEAX  1,X
F507 2006             (    forth6809.asm):06780                     BRA   PNFIN
F509 1F10             (    forth6809.asm):06781         PNDONE:     TFR   X,D
F50B A3C4             (    forth6809.asm):06782                     SUBD  ,U

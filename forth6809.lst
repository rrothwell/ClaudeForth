FFAA CEBD00           (    forth6809.asm):07943                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07944                  CLRA
FFAE 1F8B             (    forth6809.asm):07945                  TFR   A,DP
                      (    forth6809.asm):07946         
FFB0 8E0000           (    forth6809.asm):07947                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07948                  LDB   #0
FFB5 6F80             (    forth6809.asm):07949         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07950                  DECB
FFB8 26FB             (    forth6809.asm):07951                  BNE   CLRGLOB
                      (    forth6809.asm):07952         
FFBA BDDD65           (    forth6809.asm):07953                  JSR   INITSERIAL
                      (    forth6809.asm):07954         
FFBD 1CAF             (    forth6809.asm):07955                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):07956         
                      (    forth6809.asm):07957                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07958                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07959                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07960                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07961                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07962                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07963                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07964                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07965                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07966                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07967                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07968                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07969                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07970                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07971                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07972                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07973                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07974                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07975                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07976                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07977                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07978                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07979                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07980                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07981                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07982                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07983                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07984                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07985                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07986                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07987                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07988                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07989                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07990                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07991                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07992                                  ; unused vectors).
                      (    forth6809.asm):07993         
                      (    forth6809.asm):07994                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07995                  JSR   TSTRUNNER
                      (    forth6809.asm):07996                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07997                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07998                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07999                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):08000                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):08001                                  ; excluded the test framework, meaning
                      (    forth6809.asm):08002                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):08003                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):08004                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):08005                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):08006                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):08007                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):08008                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):08009                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):08010                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):08011                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):08012                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):08013         
FFC2 7EDD82           (    forth6809.asm):08014                  JMP   COLD
                      (    forth6809.asm):08015         
FFC5 1A50             (    forth6809.asm):08016         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08017                  CLRA
FFC8 1F8B             (    forth6809.asm):08018                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08019                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08020                  LDS   #RP0
                      (    forth6809.asm):08021         
FFD1 BDDD65           (    forth6809.asm):08022                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):08023                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):08024                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):08025                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):08026                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):08027                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):08028                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):08029                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):08030                                         ; reported separately) left either side
                      (    forth6809.asm):08031                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):08032                                         ; would previously have inherited it
                      (    forth6809.asm):08033                                         ; unchanged rather than genuinely
                      (    forth6809.asm):08034                                         ; recovering. Placed here, matching
                      (    forth6809.asm):08035                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):08036                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):08037                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):08038                                         ; only once setup is complete.
                      (    forth6809.asm):08039         
FFD4 8EFFE6           (    forth6809.asm):08040                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08041                  PSHU  X
FFD9 CC0006           (    forth6809.asm):08042                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08043                  PSHU  D
FFDE BDF52B           (    forth6809.asm):08044                  JSR   TYPE
FFE1 1CAF             (    forth6809.asm):08045                  ANDCC #$AF
FFE3 7EDDB7           (    forth6809.asm):08046                  JMP   ABORT      ; Enable IRQ & FIRQ
                      (    forth6809.asm):08047         
FFE6 20207761726D     (    forth6809.asm):08048         WARMMSG: FCC   "  warm"
     0006             (    forth6809.asm):08049         WARMMSGL EQU   *-WARMMSG
                      (    forth6809.asm):08050         
     FFEC             (    forth6809.asm):08051         INITEND  EQU   *          ; Verify no collision with vectors, value should match vector ORG
     0048             (    forth6809.asm):08052         INITSIZE EQU   INITEND-INITCODE
                      (    forth6809.asm):08053         
                      (    forth6809.asm):08054         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08055         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08056         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):08057                  FILL $FF,VECTORS-INITEND
                      (    forth6809.asm):08058         
                      (    forth6809.asm):08059         ; ============================================================
                      (    forth6809.asm):08060         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):08061         ; ============================================================
                      (    forth6809.asm):08062                  ORG   VECTORS       ; VECTORS is $FFF0
FFF0 0000             (    forth6809.asm):08063         VRESV    FDB   $0000
FFF2 DD76             (    forth6809.asm):08064         VSWI3    FDB   SWI3H
FFF4 DD77             (    forth6809.asm):08065         VSWI2    FDB   SWI2H
FFF6 DD78             (    forth6809.asm):08066         VFIRQ    FDB   FIRQH
FFF8 DD75             (    forth6809.asm):08067         VIRQ     FDB   IRQH
FFFA DD7A             (    forth6809.asm):08068         VSWI     FDB   SWIH
FFFC FFC5             (    forth6809.asm):08069         VNMI     FDB   WARM            ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):08070         VRESET   FDB   COLDSTRT
                      (    forth6809.asm):08071         
     0000             (    forth6809.asm):08072         VECTOREND  EQU   *          ; Verify vectors size, value should match $10.
     0010             (    forth6809.asm):08073         VECTORSIZE EQU   VECTOREND-VECTORS
                      (    forth6809.asm):08074         

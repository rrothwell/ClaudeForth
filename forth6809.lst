F865 DDAB             (    forth6809.asm):12070                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):12071                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):12072                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):12073                                   ; real source length was misread as an
                      (    forth6809.asm):12074                                   ; address, the real source address was never
                      (    forth6809.asm):12075                                   ; popped at all, and the true destination
                      (    forth6809.asm):12076                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):12077                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):12078                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):12079                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):12080                    STD  UESRCLEN

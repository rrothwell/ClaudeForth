                      (    forth6809.asm):03930                    JSR   TSTCELP
                      (    forth6809.asm):03931                    JSR   TSTCHRS
                      (    forth6809.asm):03932                    JSR   TSTCHRP
                      (    forth6809.asm):03933                    JSR   TSTALGD

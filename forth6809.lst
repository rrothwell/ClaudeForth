E508 0D22             (    forth6809.asm):03317                     TST   NUMNEG
E50A 2713             (    forth6809.asm):03318                     BEQ   NQPOS32
E50C DC70             (    forth6809.asm):03319                     LDD   UDLO
E50E DD59             (    forth6809.asm):03320                     STD   PRODLO
E510 DC6E             (    forth6809.asm):03321                     LDD   UDHI
E512 DD57             (    forth6809.asm):03322                     STD   PRODHI
E514 BDEF1B           (    forth6809.asm):03323                     JSR   MNEG32            ; shared negate. See bugfix: NUMBERQ.5
E517 DC59             (    forth6809.asm):03324                     LDD   PRODLO
E519 DD70             (    forth6809.asm):03325                     STD   UDLO
E51B DC57             (    forth6809.asm):03326                     LDD   PRODHI
E51D DD6E             (    forth6809.asm):03327                     STD   UDHI
                      (    forth6809.asm):03328         
E51F                  (    forth6809.asm):03329         NQPOS32:                            ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03330                     ; was '.' - determines which return convention to use
E51F 9E1F             (    forth6809.asm):03331                     LDX   CADDR
E521 E684             (    forth6809.asm):03332                     LDB   ,X
E523 5A               (    forth6809.asm):03333                     DECB
E524 3001             (    forth6809.asm):03334                     LEAX  1,X
E526 A685             (    forth6809.asm):03335                     LDA   B,X
E528 812E             (    forth6809.asm):03336                     CMPA  #'.'
E52A 260E             (    forth6809.asm):03337                     BNE   NQSINGLE
                      (    forth6809.asm):03338         

                      (    forth6809.asm):03263         
                      (    forth6809.asm):03264                     ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03265                     ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03266                     ; apart without needing a separate flag of its own either
E509 DC48             (    forth6809.asm):03267                     LDD   UDLO

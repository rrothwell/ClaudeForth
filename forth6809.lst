                      (    forth6809.asm):00874         ; ------------------------------------------------------------
                      (    forth6809.asm):00875         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00876         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00877         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00878         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00879         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00880         ; pushes that set the test up).
                      (    forth6809.asm):00881         ; ------------------------------------------------------------
C167                  (    forth6809.asm):00882         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00883         
                      (    forth6809.asm):00884                    LDD   #TSTGUARD
                      (    forth6809.asm):00885                    PSHU  D
                      (    forth6809.asm):00886                    LDD   #TSTVAL1
                      (    forth6809.asm):00887                    PSHU  D
                      (    forth6809.asm):00888                    STU   TSTUB4
                      (    forth6809.asm):00889         
                      (    forth6809.asm):00890                    JSR   DUP
                      (    forth6809.asm):00891         
                      (    forth6809.asm):00892                    STU   TSTUAF
                      (    forth6809.asm):00893         

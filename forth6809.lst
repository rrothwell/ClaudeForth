                      (    forth6809.asm):05689         ; ------------------------------------------------------------
DE4B CC0010           (    forth6809.asm):05690         TOINW:      LDD   #TOIN
DE4E 3606             (    forth6809.asm):05691                     PSHU  D
DE50 39               (    forth6809.asm):05692                     RTS
                      (    forth6809.asm):05693         
                      (    forth6809.asm):05694         ; ------------------------------------------------------------
                      (    forth6809.asm):05695         ; SPAN  ( -- a-addr )
                      (    forth6809.asm):05696         ; Push the address of the SPAN variable.
                      (    forth6809.asm):05697         ; ------------------------------------------------------------
DE51 CC003F           (    forth6809.asm):05698         SPANW:      LDD   #SPAN
DE54 3606             (    forth6809.asm):05699                     PSHU  D
DE56 39               (    forth6809.asm):05700                     RTS
                      (    forth6809.asm):05701         
                      (    forth6809.asm):05702         ; ------------------------------------------------------------
                      (    forth6809.asm):05703         ; TIB  ( -- c-addr )

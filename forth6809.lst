DF34 326A             (    forth6809.asm):02104         QOK:        LEAS  10,S              ; drop the frame
DF36 BDFAFF           (    forth6809.asm):02105                     JSR   CRW               ; See bugfix: QOK.1
DF39 DC00             (    forth6809.asm):02106                     LDD   STATE
DF3B 2692             (    forth6809.asm):02107                     BNE   QLOOP
DF3D 8EDF5B           (    forth6809.asm):02108                     LDX   #OKMSG
DF40 3610             (    forth6809.asm):02109                     PSHU  X                 ; c-addr
DF42 CC0004           (    forth6809.asm):02110                     LDD   #OKMSGL
DF45 3606             (    forth6809.asm):02111                     PSHU  D                 ; u
DF47 BDF528           (    forth6809.asm):02112                     JSR   TYPEW
DF4A 2083             (    forth6809.asm):02113                     BRA   QLOOP
                      (    forth6809.asm):02114         

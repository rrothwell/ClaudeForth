                      (    forth6809.asm):06689         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):06690         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):06691         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):06692         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):06693         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):06694         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):06695         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):06696         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):06697         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):06698         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):06699         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):06700         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):06701         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):06702         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):06703                   STD  TSTLSAV
                      (    forth6809.asm):06704                   LDD  CODEHERE
                      (    forth6809.asm):06705                   STD  TSTCSAV
                      (    forth6809.asm):06706         
                      (    forth6809.asm):06707                   LDA  #3
                      (    forth6809.asm):06708                   STA  TSTFHDR
                      (    forth6809.asm):06709                   LDA  #'F'
                      (    forth6809.asm):06710                   STA  TSTFHDR+1
                      (    forth6809.asm):06711                   LDA  #'O'
                      (    forth6809.asm):06712                   STA  TSTFHDR+2
                      (    forth6809.asm):06713                   LDA  #'O'
                      (    forth6809.asm):06714                   STA  TSTFHDR+3
                      (    forth6809.asm):06715                   LDD  #0
                      (    forth6809.asm):06716                   STD  TSTFHDR+4
                      (    forth6809.asm):06717                   LDD  #DUP
                      (    forth6809.asm):06718                   STD  TSTFHDR+6
                      (    forth6809.asm):06719         
                      (    forth6809.asm):06720                   LDD  #TSTFHDR
                      (    forth6809.asm):06721                   STD  LATEST
                      (    forth6809.asm):06722         
                      (    forth6809.asm):06723                   LDD  #TSTCBUF
                      (    forth6809.asm):06724                   STD  CODEHERE
                      (    forth6809.asm):06725         
                      (    forth6809.asm):06726                   JSR  RECURSE
                      (    forth6809.asm):06727         
                      (    forth6809.asm):06728                   LDD  #OPRTS
                      (    forth6809.asm):06729                   PSHU D
                      (    forth6809.asm):06730                   JSR  CCOMMA
                      (    forth6809.asm):06731         
                      (    forth6809.asm):06732                   LDD  TSTCSAV
                      (    forth6809.asm):06733                   STD  CODEHERE
                      (    forth6809.asm):06734                   LDD  TSTLSAV
                      (    forth6809.asm):06735                   STD  LATEST
                      (    forth6809.asm):06736         
                      (    forth6809.asm):06737                   STU  TSTU0
                      (    forth6809.asm):06738         
                      (    forth6809.asm):06739                   LDD  #TSTGUARD
                      (    forth6809.asm):06740                   PSHU D
                      (    forth6809.asm):06741                   LDD  #TSTVAL1
                      (    forth6809.asm):06742                   PSHU D
                      (    forth6809.asm):06743                   STU  TSTUB4
                      (    forth6809.asm):06744         

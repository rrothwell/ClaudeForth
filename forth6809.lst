E483 815A             (    forth6809.asm):03171                     CMPA  #'Z'
E485 221A             (    forth6809.asm):03172                     BHI   NLDONE
E487 8037             (    forth6809.asm):03173                     SUBA  #'A'-10
E489 9103             (    forth6809.asm):03174         NLGOT:      CMPA  BASE+1

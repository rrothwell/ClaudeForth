                      (    forth6809.asm):05454         ; STATE  ( -- a-addr )
                      (    forth6809.asm):05455         ; Push the address of the STATE variable.
                      (    forth6809.asm):05456         ; ------------------------------------------------------------
DDF0 CC0000           (    forth6809.asm):05457         STATEW:     LDD   #STATE
DDF3 3606             (    forth6809.asm):05458                     PSHU  D                 ; a-addr
DDF5 39               (    forth6809.asm):05459                     RTS

E7C4 DC08             (    forth6809.asm):03875                     LDD   CODEHERE
E7C6 3606             (    forth6809.asm):03876                     PSHU  D                 ; dest
E7C8 CC0003           (    forth6809.asm):03877                     LDD   #TAGDO
E7CB 3606             (    forth6809.asm):03878                     PSHU  D
E7CD 39               (    forth6809.asm):03879                     RTS
                      (    forth6809.asm):03880         
                      (    forth6809.asm):03881         ; ------------------------------------------------------------
                      (    forth6809.asm):03882         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03883         ; return address.
                      (    forth6809.asm):03884         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03885         ;    Inputs:
                      (    forth6809.asm):03886         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03887         ;    Outputs:
                      (    forth6809.asm):03888         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03889         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03890         ; ------------------------------------------------------------
E7CE 3706             (    forth6809.asm):03891         DOSETUP:    PULU  D                 ; index
E7D0 DD14             (    forth6809.asm):03892                     STD   MSCR
E7D2 3706             (    forth6809.asm):03893                     PULU  D                 ; limit
E7D4 DD16             (    forth6809.asm):03894                     STD   MSCR2
E7D6 3510             (    forth6809.asm):03895                     PULS  X
E7D8 CC0000           (    forth6809.asm):03896                     LDD   #0
E7DB 3406             (    forth6809.asm):03897                     PSHS  D
E7DD DC16             (    forth6809.asm):03898                     LDD   MSCR2
E7DF 3406             (    forth6809.asm):03899                     PSHS  D
E7E1 DC14             (    forth6809.asm):03900                     LDD   MSCR

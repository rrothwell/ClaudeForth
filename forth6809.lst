                      (    forth6809.asm):10234         ; TSTPOSTPONE1 - unit test for POSTPONE, normal (non-immediate)
                      (    forth6809.asm):10235         ; word case. Traced its own code first: for a normal word,
                      (    forth6809.asm):10236         ; POSTPONE compiles "[LIT xt][JSR COMPILE,]" into the current
                      (    forth6809.asm):10237         ; definition - NOT a direct call to the word itself. This is
                      (    forth6809.asm):10238         ; standard ANS semantics (POSTPONE appends a word's own
                      (    forth6809.asm):10239         ; compilation semantics to the current definition; for an
                      (    forth6809.asm):10240         ; ordinary word, that semantics IS "compile a call to it", so
                      (    forth6809.asm):10241         ; the current definition, when it later runs, must itself
                      (    forth6809.asm):10242         ; perform that compiling action against whatever definition is
                      (    forth6809.asm):10243         ; being compiled at that later point - not immediately). Given
                      (    forth6809.asm):10244         ; the genuine complexity of fully executing that second level
                      (    forth6809.asm):10245         ; (which would need a further redirected CODEHERE and a further
                      (    forth6809.asm):10246         ; round of execute-and-verify), this test instead verifies the
                      (    forth6809.asm):10247         ; compiled byte sequence directly - still a meaningful,
                      (    forth6809.asm):10248         ; unambiguous check of POSTPONE's own documented mechanism.
                      (    forth6809.asm):10249         ; ------------------------------------------------------------
C27E                  (    forth6809.asm):10250         TSTPOSTPONE1: LDD  CODEHERE
                      (    forth6809.asm):10251                       STD  TSTCSAV
                      (    forth6809.asm):10252                       LDD  LATEST
                      (    forth6809.asm):10253                       STD  TSTLSAV
                      (    forth6809.asm):10254                       LDD  SRCADDR
                      (    forth6809.asm):10255                       STD  TSTSASAV
                      (    forth6809.asm):10256                       LDD  SRCLEN
                      (    forth6809.asm):10257                       STD  TSTSLSAV
                      (    forth6809.asm):10258                       LDD  TOIN
                      (    forth6809.asm):10259                       STD  TSTTISAV
                      (    forth6809.asm):10260                       LDD  STATE
                      (    forth6809.asm):10261                       STD  TSTSTSAV
                      (    forth6809.asm):10262         
                      (    forth6809.asm):10263                       LDA  #3
                      (    forth6809.asm):10264                       STA  TSTFHDR
                      (    forth6809.asm):10265                       LDA  #'F'
                      (    forth6809.asm):10266                       STA  TSTFHDR+1
                      (    forth6809.asm):10267                       LDA  #'O'
                      (    forth6809.asm):10268                       STA  TSTFHDR+2
                      (    forth6809.asm):10269                       LDA  #'O'
                      (    forth6809.asm):10270                       STA  TSTFHDR+3
                      (    forth6809.asm):10271                       LDD  #0

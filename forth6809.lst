                      (    forth6809.asm):02314         ; ------------------------------------------------------------
                      (    forth6809.asm):02315         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02316         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02317         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02318         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02319         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02320         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02321         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02322         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02323         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02324         ;
                      (    forth6809.asm):02325         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02326         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02327         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02328         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02329         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02330         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02331         ;
                      (    forth6809.asm):02332         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02333         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02334         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02335         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02336         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02337         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02338         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02339         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02340         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02341         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02342         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02343         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02344         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02345         ; ------------------------------------------------------------
DE74 B6C008           (    forth6809.asm):02346         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02347         
DE77 8580             (    forth6809.asm):02348                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DE79 2708             (    forth6809.asm):02349                     BEQ   IRQDONE0          ; No! Just exit.
DE7B 8501             (    forth6809.asm):02350                     BITA  #SR_RDRF          ; Is an incoming character available?
DE7D 2605             (    forth6809.asm):02351                     BNE   INCHAR
DE7F 8502             (    forth6809.asm):02352                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DE81 2637             (    forth6809.asm):02353                     BNE   OUTCHAR
                      (    forth6809.asm):02354                                             ; Ignore all other interrupts such as DCD change.
DE83 3B               (    forth6809.asm):02355         IRQDONE0:  RTI                      ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02356                                             ; & restores state.
                      (    forth6809.asm):02357         
DE84                  (    forth6809.asm):02358         INCHAR:
DE84 F6C009           (    forth6809.asm):02359                     LDB   ACIADR               ; Get the char & clear RDRF & error flags.
DE87 8570             (    forth6809.asm):02360                     BITA  #SR_FE+SR_OVRN+SR_PE ; Any receiver error flagged?
DE89 2716             (    forth6809.asm):02361                     BEQ   INOK                 ; No! - character is good, keep it.
                      (    forth6809.asm):02362                                              
DE8B 8510             (    forth6809.asm):02363                     BITA  #SR_FE               ; Yes! char is corrupted, discard it.

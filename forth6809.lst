                      (    forth6809.asm):00829         ; TSTDROP - unit test for DROP ( x -- ). Verifies both the
                      (    forth6809.asm):00830         ; stack's contents (the guard beneath the dropped value is left
                      (    forth6809.asm):00831         ; undisturbed, and is now the new top) and the data stack
                      (    forth6809.asm):00832         ; pointer's movement (exactly one cell, 2 bytes, freed - DROP's
                      (    forth6809.asm):00833         ; own net effect, not conflated with the two pushes that set the
                      (    forth6809.asm):00834         ; test up).
                      (    forth6809.asm):00835         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):00836         TSTDROP:   STU   TSTU0
                      (    forth6809.asm):00837         
                      (    forth6809.asm):00838                    LDD   #TSTGUARD
                      (    forth6809.asm):00839                    PSHU  D
                      (    forth6809.asm):00840                    LDD   #TSTVAL1
                      (    forth6809.asm):00841                    PSHU  D
                      (    forth6809.asm):00842                    STU   TSTUB4
                      (    forth6809.asm):00843         
                      (    forth6809.asm):00844                    JSR   DROP
                      (    forth6809.asm):00845         
                      (    forth6809.asm):00846                    STU   TSTUAF
                      (    forth6809.asm):00847         
                      (    forth6809.asm):00848                    PULU  D
                      (    forth6809.asm):00849                    CMPD  #TSTGUARD
                      (    forth6809.asm):00850                    BNE   DPFAIL
                      (    forth6809.asm):00851         
                      (    forth6809.asm):00852                    LDD   TSTUB4
                      (    forth6809.asm):00853                    SUBD  TSTUAF
                      (    forth6809.asm):00854                    CMPD  #-2
                      (    forth6809.asm):00855                    BNE   DPFAIL
                      (    forth6809.asm):00856         
                      (    forth6809.asm):00857                    LDD   #TRUEV
                      (    forth6809.asm):00858                    BRA   DPDONE
C15E                  (    forth6809.asm):00859         DPFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):00860         DPDONE:    LDX   #TSTDROPNAME
                      (    forth6809.asm):00861                    PSHU  X
                      (    forth6809.asm):00862                    PSHU  D
                      (    forth6809.asm):00863                    JSR   TSTREPORT
                      (    forth6809.asm):00864         
                      (    forth6809.asm):00865                    LDU   TSTU0
                      (    forth6809.asm):00866                    RTS

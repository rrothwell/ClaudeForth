F3DA 3606             (    forth6809.asm):06484                     PSHU  D
F3DC 7EF3C1           (    forth6809.asm):06485                     JMP   FILLW
                      (    forth6809.asm):06486         
                      (    forth6809.asm):06487         ; ------------------------------------------------------------
                      (    forth6809.asm):06488         ; BLANK  ( c-addr u -- )

                      (    forth6809.asm):07258         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07259         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07260         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07261         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07262         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07263         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07264         ; ============================================================
                      (    forth6809.asm):07265         ; ------------------------------------------------------------
                      (    forth6809.asm):07266         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07267         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07268         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07269         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07270         ; - no indirection, no value cell.
                      (    forth6809.asm):07271         ;
                      (    forth6809.asm):07272         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07273         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07274         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07275         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07276         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07277         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07278         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07279         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07280         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07281         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07282         ; ------------------------------------------------------------
FF79 CCFFFF           (    forth6809.asm):07283         TRUEBODY:  LDD   #$FFFF
FF7C 3606             (    forth6809.asm):07284                    PSHU  D

DF07 CC0000           (    forth6809.asm):02103                     LDD   #0
DF0A DD00             (    forth6809.asm):02104                     STD   STATE
                      (    forth6809.asm):02105         
DF0C ECE4             (    forth6809.asm):02106                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DF0E 1083FFFF         (    forth6809.asm):02107                     CMPD  #-1
DF12 2605             (    forth6809.asm):02108                     BNE   QSHOWERR
DF14 326A             (    forth6809.asm):02109                     LEAS  10,S              ; drop the frame
DF16 16FFB6           (    forth6809.asm):02110                     LBRA  QLOOP
                      (    forth6809.asm):02111         

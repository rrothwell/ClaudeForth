                      (    forth6809.asm):08166                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):08167                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):08168                                       ; the other unused vectors below
                      (    forth6809.asm):08169                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):08170         
DEF6 3B               (    forth6809.asm):08171         SWI3H:   RTI
DEF7 3B               (    forth6809.asm):08172         SWI2H:   RTI
DEF8 3B               (    forth6809.asm):08173         FIRQH:   RTI

                      (    forth6809.asm):00865         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00866         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00867         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00868         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00869         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00870         ; pushes that set the test up).
                      (    forth6809.asm):00871         ; ------------------------------------------------------------
C164                  (    forth6809.asm):00872         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00873         
                      (    forth6809.asm):00874                    LDD   #TSTGUARD

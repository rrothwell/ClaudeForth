F7F9 3706             (    forth6809.asm):06968         UNESCAPEW:  PULU  D                 ; BUG FIX: was PULU D/STD UESRCLEN (storing
F7FB DDAB             (    forth6809.asm):06969                     STD   UEDST             ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):06970                                             ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):06971                                             ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):06972                                             ; real source length was misread as an
                      (    forth6809.asm):06973                                             ; address, the real source address was never
                      (    forth6809.asm):06974                                             ; popped at all, and the true destination
                      (    forth6809.asm):06975                                             ; address never reached UEDST. Correct
                      (    forth6809.asm):06976                                             ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):06977                                             ; c-addr2 (dest) is on top, popped first.
F7FD 3706             (    forth6809.asm):06978                     PULU  D                 ; next: u1 (source length)
F7FF DDA9             (    forth6809.asm):06979                     STD   UESRCLEN
F801 3706             (    forth6809.asm):06980                     PULU  D                 ; next: c-addr1 (source address)
F803 DDA7             (    forth6809.asm):06981                     STD   UEADDR
F805 CC0000           (    forth6809.asm):06982                     LDD   #0
F808 DDAD             (    forth6809.asm):06983                     STD   UEOUTLEN
F80A 9EA7             (    forth6809.asm):06984                     LDX   UEADDR
F80C 109EAB           (    forth6809.asm):06985                     LDY   UEDST
                      (    forth6809.asm):06986         
                      (    forth6809.asm):06987                     ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06988                     ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06989                     ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06990                     ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06991                     ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06992                     ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06993                     ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06994                     ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06995                     ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06996                     ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06997                     ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06998                     ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06999                     ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):07000                     ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):07001                     ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):07002                     ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):07003                     ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):07004                     ; both are direct, expected consequences of this being the
                      (    forth6809.asm):07005                     ; wrong algorithm entirely, not a smaller bug within it.
F80F DCA9             (    forth6809.asm):07006         UELOOP:     LDD   UESRCLEN
F811 2715             (    forth6809.asm):07007                     BEQ   UEDONE
F813 A680             (    forth6809.asm):07008                     LDA   ,X+
F815 8125             (    forth6809.asm):07009                     CMPA  #'%'
F817 2604             (    forth6809.asm):07010                     BNE   UENOTPCT
F819 C625             (    forth6809.asm):07011                     LDB   #'%'              ; write the extra '%' first - the character
F81B E7A0             (    forth6809.asm):07012                     STB   ,Y+               ; itself still gets written once more below,
                      (    forth6809.asm):07013                                             ; giving two '%' total for each one in the
                      (    forth6809.asm):07014                                             ; source. Handles multiple '%' characters in
                      (    forth6809.asm):07015                                             ; the same string correctly, since this runs
                      (    forth6809.asm):07016                                             ; independently for each one the loop visits.
F81D A7A0             (    forth6809.asm):07017         UENOTPCT:   STA   ,Y+               ; write the actual character - always, for
                      (    forth6809.asm):07018                                             ; every character, '%' or not
F81F DCA9             (    forth6809.asm):07019                     LDD   UESRCLEN
F821 830001           (    forth6809.asm):07020                     SUBD  #1
F824 DDA9             (    forth6809.asm):07021                     STD   UESRCLEN
F826 20E7             (    forth6809.asm):07022                     BRA   UELOOP
F828 1F20             (    forth6809.asm):07023         UEDONE:     TFR   Y,D               ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F82A 93AB             (    forth6809.asm):07024                     SUBD  UEDST             ; overwriting whatever was left on top of
F82C DDAD             (    forth6809.asm):07025                     STD   UEOUTLEN          ; the stack rather than pushing both
                      (    forth6809.asm):07026                                             ; required return values, and separately,
                      (    forth6809.asm):07027                                             ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):07028                                             ; tracked by the old backslash-decoding
                      (    forth6809.asm):07029                                             ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):07030                                             ; way that accounted for doubled '%'
                      (    forth6809.asm):07031                                             ; characters. Now computed directly as the
                      (    forth6809.asm):07032                                             ; final write pointer (Y) minus the
                      (    forth6809.asm):07033                                             ; original destination address (UEDST) -
                      (    forth6809.asm):07034                                             ; correct regardless of how many characters
                      (    forth6809.asm):07035                                             ; were doubled, since it's derived from
                      (    forth6809.asm):07036                                             ; where writing actually stopped rather than
                      (    forth6809.asm):07037                                             ; incremented alongside it.
F82E DCAB             (    forth6809.asm):07038                     LDD   UEDST
F830 3606             (    forth6809.asm):07039                     PSHU  D                 ; push c-addr2 (destination address)
F832 DCAD             (    forth6809.asm):07040                     LDD   UEOUTLEN
F834 3606             (    forth6809.asm):07041                     PSHU  D                 ; push u2 (actual unescaped length)
F836 39               (    forth6809.asm):07042                     RTS
                      (    forth6809.asm):07043         
                      (    forth6809.asm):07044         ; REPLACES/SUBSTITUTE - single-slot simplified version, per
                      (    forth6809.asm):07045         ; the explicit scoping-down discussed in the source conversation
F837 3706             (    forth6809.asm):07046         REPLACESW:  PULU  D
F839 DDB5             (    forth6809.asm):07047                     STD   REPLNLEN
F83B 3706             (    forth6809.asm):07048                     PULU  D
F83D DDB3             (    forth6809.asm):07049                     STD   REPLNAME
F83F 3706             (    forth6809.asm):07050                     PULU  D
F841 DDB9             (    forth6809.asm):07051                     STD   REPLVLEN
F843 3706             (    forth6809.asm):07052                     PULU  D
F845 DDB7             (    forth6809.asm):07053                     STD   REPLVAL
F847 39               (    forth6809.asm):07054                     RTS
                      (    forth6809.asm):07055         
F848 DDC7             (    forth6809.asm):07056         SUBCOPY:    STD   SUBCOPYCNT
F84A 9FC9             (    forth6809.asm):07057                     STX   SUBCOPYSRC

C100                  (    forth6809.asm):08023         CNFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):08024         CNDONE:   LDX  #TSTCONSTNAME
                      (    forth6809.asm):08025                   PSHU X
                      (    forth6809.asm):08026                   PSHU D

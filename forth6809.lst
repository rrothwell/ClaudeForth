                      (    forth6809.asm):01975         ; TSTSLASHZ - unit test for SLASH, divide-by-zero case. n2 = 0.
                      (    forth6809.asm):01976         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):01977         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):01978         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):01979         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):01980         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):01981         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):01982         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):01983         ; there are.
                      (    forth6809.asm):01984         ; ------------------------------------------------------------

                      (    forth6809.asm):15073         ; ------------------------------------------------------------
                      (    forth6809.asm):15074         ; TSTEXCEPTION - exception handling tests (glossary section
                      (    forth6809.asm):15075         ; 3.15, 2 words, 4 tests since CATCH/THROW can only be
                      (    forth6809.asm):15076         ; meaningfully tested together - THROW's own effect is only
                      (    forth6809.asm):15077         ; observable through a CATCH that traps it). Already used
                      (    forth6809.asm):15078         ; extensively as this whole session's own error-testing
                      (    forth6809.asm):15079         ; mechanism throughout sections 3.8-3.14, so their correctness
                      (    forth6809.asm):15080         ; has substantial indirect evidence already; this section still
                      (    forth6809.asm):15081         ; gets its own, direct, dedicated tests.
                      (    forth6809.asm):15082         ;
                      (    forth6809.asm):15083         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15084         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15085         ; ABORT (unsafe to trigger directly - it resets the return
                      (    forth6809.asm):15086         ; stack, destroying this whole test framework's own call chain,
                      (    forth6809.asm):15087         ; per section 3.1's own established reasoning). Every THROW in
                      (    forth6809.asm):15088         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15089         ; active CATCH (via a dedicated internal helper, TSTTHROWHLP,
                      (    forth6809.asm):15090         ; that only ever gets invoked that way), or is a THROW(0) call -
                      (    forth6809.asm):15091         ; confirmed via THROW's own code to be a pure, unconditional
                      (    forth6809.asm):15092         ; no-op that never touches HANDLER or ABORT at all, so that one
                      (    forth6809.asm):15093         ; specific case is safe to call directly.
                      (    forth6809.asm):15094         ;
                      (    forth6809.asm):15095         ; TSTCATCHTHROW specifically verifies the two dummy values
                      (    forth6809.asm):15096         ; TSTTHROWHLP pushes before throwing are genuinely gone
                      (    forth6809.asm):15097         ; afterward, confirming CATCH's own documented "restores data
                      (    forth6809.asm):15098         ; stack depth... on either path" for real. TSTHANDLERSAVE
                      (    forth6809.asm):15099         ; verifies the HANDLER half of that same documented guarantee
                      (    forth6809.asm):15100         ; directly, by reading HANDLER itself before and after CATCH
                      (    forth6809.asm):15101         ; calls on both the success and throw paths, rather than only
                      (    forth6809.asm):15102         ; inferring it from stack-level behavior.
                      (    forth6809.asm):15103         ; ------------------------------------------------------------
C2E5 BDFC2B           (    forth6809.asm):15104         TSTEXCEPTION: JSR CRW
C2E8 8EC305           (    forth6809.asm):15105                    LDX   #TSTEXCMSG
C2EB 3610             (    forth6809.asm):15106                    PSHU  X
C2ED CC0006           (    forth6809.asm):15107                    LDD   #6
C2F0 3606             (    forth6809.asm):15108                    PSHU  D
C2F2 BDF60B           (    forth6809.asm):15109                    JSR   TYPE
C2F5 BDFC2B           (    forth6809.asm):15110                    JSR   CRW
                      (    forth6809.asm):15111         
                      (    forth6809.asm):15112                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15113         
C2F8 BDC30B           (    forth6809.asm):15114                    JSR   TSTCATCHOK
C2FB BDC386           (    forth6809.asm):15115                    JSR   TSTCATCHTHROW
C2FE BDC3DC           (    forth6809.asm):15116                    JSR   TSTTHROWZERO
C301 BDC429           (    forth6809.asm):15117                    JSR   TSTHANDLERSAVE
                      (    forth6809.asm):15118         
                      (    forth6809.asm):15119                    ENDC ; <<<<
                      (    forth6809.asm):15120         
C304 39               (    forth6809.asm):15121                    RTS
                      (    forth6809.asm):15122         
C305 457863657074     (    forth6809.asm):15123         TSTEXCMSG: FCC "Except"
                      (    forth6809.asm):15124         
                      (    forth6809.asm):15125                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15126         
                      (    forth6809.asm):15127         ; ------------------------------------------------------------
                      (    forth6809.asm):15128         ; Exception Handling test harness (glossary section 3.15).
                      (    forth6809.asm):15129         ; CATCH/THROW have already been used extensively as this whole
                      (    forth6809.asm):15130         ; session's own error-testing mechanism throughout sections
                      (    forth6809.asm):15131         ; 3.8-3.14, so their correctness has substantial indirect
                      (    forth6809.asm):15132         ; evidence already - this section still gets its own, direct
                      (    forth6809.asm):15133         ; tests, matching the established practice of every section
                      (    forth6809.asm):15134         ; getting dedicated coverage rather than relying on incidental
                      (    forth6809.asm):15135         ; use elsewhere.
                      (    forth6809.asm):15136         ;
                      (    forth6809.asm):15137         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15138         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15139         ; ABORT (already established elsewhere in this session as unsafe
                      (    forth6809.asm):15140         ; to trigger directly - it resets the return stack, destroying
                      (    forth6809.asm):15141         ; this whole test framework's own call chain). Every THROW in
                      (    forth6809.asm):15142         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15143         ; active CATCH, or is a THROW(0) call - confirmed via CATCH's own
                      (    forth6809.asm):15144         ; code to be a pure no-op that never touches HANDLER or ABORT at
                      (    forth6809.asm):15145         ; all, so that specific case is safe to call directly.
                      (    forth6809.asm):15146         ; ------------------------------------------------------------
                      (    forth6809.asm):15147         
                      (    forth6809.asm):15148         ; ------------------------------------------------------------

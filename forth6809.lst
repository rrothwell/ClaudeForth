F068 4D               (    forth6809.asm):04700                  TSTA            ; BUG FIX: CLR MSIGN unconditionally sets N=0
                      (    forth6809.asm):04701                                  ; (CLR always clears to 0), overwriting D's
                      (    forth6809.asm):04702                                  ; own flags from the PULU above - and PULU
                      (    forth6809.asm):04703                                  ; doesn't set flags on genuine 6809 anyway
                      (    forth6809.asm):04704                                  ; (same class as TRYNUM/STOD/SIGN's own fixes
                      (    forth6809.asm):04705                                  ; elsewhere in this file), so BPL was always
                      (    forth6809.asm):04706                                  ; testing CLR's result, not n1's actual sign.
                      (    forth6809.asm):04707                                  ; BPL always branched, meaning n1 was NEVER
                      (    forth6809.asm):04708                                  ; negated even when genuinely negative - found
                      (    forth6809.asm):04709                                  ; via MAME: TSTMSTAR's two returned values

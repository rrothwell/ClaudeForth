                      (    forth6809.asm):03205         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):03206         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):03207         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):03208         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):03209         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):03210         ; NUMLOOP
                      (    forth6809.asm):03211         ;    Inputs:
                      (    forth6809.asm):03212         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):03213         ;    Outputs:
                      (    forth6809.asm):03214         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):03215         ;        the count remaining
                      (    forth6809.asm):03216         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03217         ; ------------------------------------------------------------

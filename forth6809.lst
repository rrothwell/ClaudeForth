                      (    forth6809.asm):08212         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (    forth6809.asm):08213         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (    forth6809.asm):08214         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (    forth6809.asm):08215         ; compiled as the new behavior, terminated with RTS) - executing
                      (    forth6809.asm):08216         ; TESTWD should push 6 (5 fetched, then incremented).
                      (    forth6809.asm):08217         ;
                      (    forth6809.asm):08218         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (    forth6809.asm):08219         ; return": it patches LATEST's behavior field using the return
                      (    forth6809.asm):08220         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (    forth6809.asm):08221         ; SECOND return address and jumps there - designed for the
                      (    forth6809.asm):08222         ; normal case where DOES> is reached from inside an enclosing
                      (    forth6809.asm):08223         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (    forth6809.asm):08224         ; would compile), which itself has its own caller. Traced by
                      (    forth6809.asm):08225         ; hand: calling directly into the compiled "JSR SETDOES"
                      (    forth6809.asm):08226         ; instruction itself (not through an intermediate wrapper)
                      (    forth6809.asm):08227         ; naturally supplies exactly the two stack levels SETDOES
                      (    forth6809.asm):08228         ; expects - its own JSR provides the first (becoming the new
                      (    forth6809.asm):08229         ; behavior field value), and this test's own call provides the
                      (    forth6809.asm):08230         ; second (correctly resuming here afterward) - no extra
                      (    forth6809.asm):08231         ; scaffolding needed, confirmed correct rather than assumed.
                      (    forth6809.asm):08232         ; ------------------------------------------------------------
C25E                  (    forth6809.asm):08233         TSTCRDOES: LDD  CODEHERE
                      (    forth6809.asm):08234                    STD  TSTCSAV
                      (    forth6809.asm):08235                    LDD  DPHERE
                      (    forth6809.asm):08236                    STD  TSTDSAV
                      (    forth6809.asm):08237                    LDD  VARHERE
                      (    forth6809.asm):08238                    STD  TSTVSAV
                      (    forth6809.asm):08239                    LDD  SRCADDR
                      (    forth6809.asm):08240                    STD  TSTSASAV
                      (    forth6809.asm):08241                    LDD  SRCLEN
                      (    forth6809.asm):08242                    STD  TSTSLSAV
                      (    forth6809.asm):08243                    LDD  TOIN
                      (    forth6809.asm):08244                    STD  TSTTISAV
                      (    forth6809.asm):08245                    LDD  LATEST
                      (    forth6809.asm):08246                    STD  TSTLSAV
                      (    forth6809.asm):08247         
                      (    forth6809.asm):08248                    LDA  #'T'
                      (    forth6809.asm):08249                    STA  TSTNAMEB
                      (    forth6809.asm):08250                    LDA  #'E'
                      (    forth6809.asm):08251                    STA  TSTNAMEB+1
                      (    forth6809.asm):08252                    LDA  #'S'

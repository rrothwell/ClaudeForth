E74E DC08             (    forth6809.asm):03887                     LDD   CODEHERE
E750 830002           (    forth6809.asm):03888                     SUBD  #2
E753 DD44             (    forth6809.asm):03889                     STD   PFIELD
E755 3706             (    forth6809.asm):03890                     PULU  D
E757 3606             (    forth6809.asm):03891                     PSHU  D
E759 DC44             (    forth6809.asm):03892                     LDD   PFIELD
E75B 3606             (    forth6809.asm):03893                     PSHU  D
E75D BDE673           (    forth6809.asm):03894                     JSR   PATCH
E760 39               (    forth6809.asm):03895                     RTS

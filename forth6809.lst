                      (    forth6809.asm):08131                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):08132         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08133                  ORCC  #$50        ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08134                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08135                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08136                  CLRA
FFAE 1F8B             (    forth6809.asm):08137                  TFR   A,DP
                      (    forth6809.asm):08138         
FFB0 8E0000           (    forth6809.asm):08139                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08140                  LDB   #0
FFB5 6F80             (    forth6809.asm):08141         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):08142                  DECB
FFB8 26FB             (    forth6809.asm):08143                  BNE   CLRGLOB
                      (    forth6809.asm):08144         
FFBA BDDD73           (    forth6809.asm):08145                  JSR   INITSERIAL
                      (    forth6809.asm):08146         
FFBD 1CAF             (    forth6809.asm):08147                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):08148         
                      (    forth6809.asm):08149                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):08150                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):08151                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):08152                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):08153                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):08154                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):08155                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):08156                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):08157                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):08158                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):08159                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):08160                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):08161                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):08162                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):08163                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):08164                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):08165                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):08166                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):08167                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):08168                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):08169                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):08170                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):08171                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):08172                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):08173                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):08174                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):08175                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):08176                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):08177                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):08178                                  ; too, not just the eventual interactive
                      (    forth6809.asm):08179                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):08180                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):08181                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):08182                                  ; nothing on this system ever drives it
                      (    forth6809.asm):08183                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):08184                                  ; unused vectors).
                      (    forth6809.asm):08185         
                      (    forth6809.asm):08186                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):08187                  JSR   TSTRUNNER
                      (    forth6809.asm):08188                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08189                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):08190                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):08191                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):08192                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):08193                                  ; excluded the test framework, meaning
                      (    forth6809.asm):08194                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):08195                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):08196                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):08197                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):08198                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):08199                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):08200                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):08201                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):08202                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):08203                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):08204                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):08205         
FFC2 7EDD90           (    forth6809.asm):08206                  JMP   COLD
                      (    forth6809.asm):08207         
FFC5 1A50             (    forth6809.asm):08208         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08209                  CLRA
FFC8 1F8B             (    forth6809.asm):08210                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08211                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08212                  LDS   #RP0
                      (    forth6809.asm):08213         
FFD1 BDDD73           (    forth6809.asm):08214                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):08215                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):08216                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):08217                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):08218                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):08219                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):08220                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):08221                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):08222                                         ; reported separately) left either side
                      (    forth6809.asm):08223                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):08224                                         ; would previously have inherited it
                      (    forth6809.asm):08225                                         ; unchanged rather than genuinely
                      (    forth6809.asm):08226                                         ; recovering. Placed here, matching
                      (    forth6809.asm):08227                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):08228                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):08229                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):08230                                         ; only once setup is complete.

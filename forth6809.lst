E363 20EE             (    forth6809.asm):02970                     BRA   SKIPLP
                      (    forth6809.asm):02971         
E365 AF61             (    forth6809.asm):02972         STARTW:     STX   1,S
E367 C600             (    forth6809.asm):02973                     LDB   #0
                      (    forth6809.asm):02974         
E369 108C0000         (    forth6809.asm):02975         SCANLP:     CMPY  #0
E36D 2715             (    forth6809.asm):02976                     BEQ   ENDW

                      (    forth6809.asm):05933         ; ------------------------------------------------------------
                      (    forth6809.asm):05934         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05935         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05936         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05937         ; the transfer.
                      (    forth6809.asm):05938         ; ------------------------------------------------------------
E013 3510             (    forth6809.asm):05939         FROMRW:     PULS  X
E015 3506             (    forth6809.asm):05940                     PULS  D                 ; x
E017 3410             (    forth6809.asm):05941                     PSHS  X
E019 3606             (    forth6809.asm):05942                     PSHU  D
E01B 39               (    forth6809.asm):05943                     RTS
                      (    forth6809.asm):05944         
                      (    forth6809.asm):05945         ; ------------------------------------------------------------
                      (    forth6809.asm):05946         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05947         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05948         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05949         ; back around the transfer.
                      (    forth6809.asm):05950         ; ------------------------------------------------------------
E01C 3510             (    forth6809.asm):05951         RFETCHW:    PULS  X

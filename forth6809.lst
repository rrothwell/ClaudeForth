                      (    forth6809.asm):03922         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03923         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03924         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03925         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03926         ; ------------------------------------------------------------

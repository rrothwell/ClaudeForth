                      (    forth6809.asm):02373         ; ------------------------------------------------------------
                      (    forth6809.asm):02374         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02375         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02376         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02377         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02378         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02379         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02380         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02381         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02382         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02383         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02384         ;
                      (    forth6809.asm):02385         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02386         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02387         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02388         ; right value once.
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
C198 BDFC2B           (    forth6809.asm):02390         TSTRETSTACK: JSR CRW
C19B 8EC1AC           (    forth6809.asm):02391                    LDX   #TSTRETMSG
C19E 3610             (    forth6809.asm):02392                    PSHU  X
C1A0 CC0008           (    forth6809.asm):02393                    LDD   #8
C1A3 3606             (    forth6809.asm):02394                    PSHU  D
C1A5 BDF60B           (    forth6809.asm):02395                    JSR   TYPE
C1A8 BDFC2B           (    forth6809.asm):02396                    JSR   CRW
                      (    forth6809.asm):02397         
                      (    forth6809.asm):02398                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02399         
                      (    forth6809.asm):02400                    JSR   TSTTOR
                      (    forth6809.asm):02401                    JSR   TSTRFETCH
                      (    forth6809.asm):02402                    JSR   TSTTWOTOR
                      (    forth6809.asm):02403                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02404         
                      (    forth6809.asm):02405                    ENDC ; <<<<
                      (    forth6809.asm):02406         
C1AB 39               (    forth6809.asm):02407                    RTS
                      (    forth6809.asm):02408         
C1AC 526574537461636B (    forth6809.asm):02409         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02410         
                      (    forth6809.asm):02411                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02412         
                      (    forth6809.asm):02413         ; ------------------------------------------------------------
                      (    forth6809.asm):02414         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02415         ; every other test group in this file, these words operate
                      (    forth6809.asm):02416         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02417         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02418         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02419         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02420         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02421         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02422         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02423         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02424         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02425         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02426         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02427         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02428         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02429         ; ------------------------------------------------------------
                      (    forth6809.asm):02430         
                      (    forth6809.asm):02431         ; ------------------------------------------------------------
                      (    forth6809.asm):02432         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02433         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02434         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02435         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02436         ; value would never actually have left.
                      (    forth6809.asm):02437         ; ------------------------------------------------------------
C1B4                  (    forth6809.asm):02438         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02439         
                      (    forth6809.asm):02440                  LDD   #TSTGUARD
                      (    forth6809.asm):02441                  PSHU  D
                      (    forth6809.asm):02442                  LDD   #TSTVAL1
                      (    forth6809.asm):02443                  PSHU  D

                      (    forth6809.asm):06448         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06449         ; Parse up to the closing quote. When compiling, compile DOSTR
                      (    forth6809.asm):06450         ; followed by the counted string. When interpreting, copy the string
                      (    forth6809.asm):06451         ; to PAD and return its address and length.
                      (    forth6809.asm):06452         ; A 3-byte gap is reserved at CODEHERE while WORD parses, so that the
                      (    forth6809.asm):06453         ; compiled JSR DOSTR does not overwrite the text being staged.

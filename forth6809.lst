CFEF 16FFB0           (    forth6809.asm):02626                     LBRA  QLOOP
                      (    forth6809.asm):02627         
CFF2 BDF00F           (    forth6809.asm):02628         QSHOWERR:   JSR   CRW
CFF5 8ED03C           (    forth6809.asm):02629                     LDX   #ERRMSG
CFF8 3610             (    forth6809.asm):02630                     PSHU  X                 ; c-addr
CFFA CC0008           (    forth6809.asm):02631                     LDD   #ERRMSGL
CFFD 3606             (    forth6809.asm):02632                     PSHU  D                 ; u
CFFF BDE9E6           (    forth6809.asm):02633                     JSR   TYPEW
D002 ECE4             (    forth6809.asm):02634                     LDD   ,S
D004 3606             (    forth6809.asm):02635                     PSHU  D                 ; n
D006 BDEEDE           (    forth6809.asm):02636                     JSR   DOTW
D009 326A             (    forth6809.asm):02637                     LEAS  10,S              ; drop the frame
D00B 16FF94           (    forth6809.asm):02638                     LBRA  QLOOP
                      (    forth6809.asm):02639         
D00E 326A             (    forth6809.asm):02640         QOK:        LEAS  10,S              ; drop the frame
D010 BDF00F           (    forth6809.asm):02641                     JSR   CRW               ; See bugfix: QOK.1
D013 DC00             (    forth6809.asm):02642                     LDD   STATE
D015 1026FF89         (    forth6809.asm):02643                     LBNE  QLOOP
D019 8ED038           (    forth6809.asm):02644                     LDX   #OKMSG
D01C 3610             (    forth6809.asm):02645                     PSHU  X                 ; c-addr
D01E CC0004           (    forth6809.asm):02646                     LDD   #OKMSGL
D021 3606             (    forth6809.asm):02647                     PSHU  D                 ; u
D023 BDE9E6           (    forth6809.asm):02648                     JSR   TYPEW
D026 16FF79           (    forth6809.asm):02649                     LBRA  QLOOP
                      (    forth6809.asm):02650         
D029 3638303920464F52 (    forth6809.asm):02651         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02652         SIGNONL     EQU   *-SIGNON
D038 20206F6B         (    forth6809.asm):02653         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02654         OKMSGL      EQU   *-OKMSG
D03C 20204552524F5220 (    forth6809.asm):02655         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02656         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02657         
                      (    forth6809.asm):02658         ; ============================================================
                      (    forth6809.asm):02659         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02660         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02661         ; ============================================================
                      (    forth6809.asm):02662         ; ------------------------------------------------------------
                      (    forth6809.asm):02663         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02664         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02665         ; LIT   ( -- x )
                      (    forth6809.asm):02666         ;    Inputs:
                      (    forth6809.asm):02667         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02668         ;    Outputs:
                      (    forth6809.asm):02669         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02670         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
D044 3510             (    forth6809.asm):02672         LIT:        PULS  X
D046 EC81             (    forth6809.asm):02673                     LDD   ,X++
D048 3606             (    forth6809.asm):02674                     PSHU  D                 ; x
D04A 3410             (    forth6809.asm):02675                     PSHS  X
D04C 39               (    forth6809.asm):02676                     RTS
                      (    forth6809.asm):02677         
                      (    forth6809.asm):02678         ; ------------------------------------------------------------
                      (    forth6809.asm):02679         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02680         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02681         ; address.
                      (    forth6809.asm):02682         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02683         ;    Inputs:
                      (    forth6809.asm):02684         ;        flag on the data stack
                      (    forth6809.asm):02685         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02686         ;    Outputs:
                      (    forth6809.asm):02687         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02688         ;        the offset
                      (    forth6809.asm):02689         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02690         ; ------------------------------------------------------------
D04D 3706             (    forth6809.asm):02691         ZBRANCH:    PULU  D                 ; flag
D04F 3510             (    forth6809.asm):02692                     PULS  X
D051 10830000         (    forth6809.asm):02693                     CMPD  #0
D055 2607             (    forth6809.asm):02694                     BNE   ZSKIP
D057 EC84             (    forth6809.asm):02695                     LDD   ,X
D059 308B             (    forth6809.asm):02696                     LEAX  D,X
D05B 3410             (    forth6809.asm):02697                     PSHS  X
D05D 39               (    forth6809.asm):02698                     RTS
D05E 3002             (    forth6809.asm):02699         ZSKIP:      LEAX  2,X
D060 3410             (    forth6809.asm):02700                     PSHS  X
D062 39               (    forth6809.asm):02701                     RTS
                      (    forth6809.asm):02702         
                      (    forth6809.asm):02703         ; ------------------------------------------------------------
                      (    forth6809.asm):02704         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02705         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02706         ; BRANCH
                      (    forth6809.asm):02707         ;    Inputs:
                      (    forth6809.asm):02708         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02709         ;    Outputs:
                      (    forth6809.asm):02710         ;        return address set to the branch target
                      (    forth6809.asm):02711         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02712         ; ------------------------------------------------------------
D063 3510             (    forth6809.asm):02713         BRANCH:     PULS  X
D065 EC84             (    forth6809.asm):02714                     LDD   ,X
D067 308B             (    forth6809.asm):02715                     LEAX  D,X
D069 3410             (    forth6809.asm):02716                     PSHS  X
D06B 39               (    forth6809.asm):02717                     RTS
                      (    forth6809.asm):02718         
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
                      (    forth6809.asm):02720         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02721         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02722         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02723         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02724         ;    Inputs:
                      (    forth6809.asm):02725         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02726         ;        trampoline
                      (    forth6809.asm):02727         ;    Outputs:
                      (    forth6809.asm):02728         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02729         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
D06C 3510             (    forth6809.asm):02731         DODOES:     PULS  X
D06E 10AE81           (    forth6809.asm):02732                     LDY   ,X++
D071 EC84             (    forth6809.asm):02733                     LDD   ,X
D073 3606             (    forth6809.asm):02734                     PSHU  D                 ; pfa
D075 6EA4             (    forth6809.asm):02735                     JMP   ,Y
                      (    forth6809.asm):02736         
                      (    forth6809.asm):02737         ; ------------------------------------------------------------
                      (    forth6809.asm):02738         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02739         ; field address on the stack.
                      (    forth6809.asm):02740         ; DOESRT0
                      (    forth6809.asm):02741         ;    Inputs:
                      (    forth6809.asm):02742         ;        none
                      (    forth6809.asm):02743         ;    Outputs:
                      (    forth6809.asm):02744         ;        none
                      (    forth6809.asm):02745         ;    Registers: none.
                      (    forth6809.asm):02746         ; ------------------------------------------------------------
D077 39               (    forth6809.asm):02747         DOESRT0:    RTS
                      (    forth6809.asm):02748         
                      (    forth6809.asm):02749         ; ------------------------------------------------------------
                      (    forth6809.asm):02750         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02751         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02752         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02753         ; SETDOES
                      (    forth6809.asm):02754         ;    Inputs:
                      (    forth6809.asm):02755         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02756         ;        BEHAVIOR)
                      (    forth6809.asm):02757         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02758         ;        address
                      (    forth6809.asm):02759         ;    Outputs:
                      (    forth6809.asm):02760         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02761         ;        defining word's caller
                      (    forth6809.asm):02762         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02763         ; ------------------------------------------------------------
D078 3510             (    forth6809.asm):02764         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D07A 1F12             (    forth6809.asm):02765                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02766         
D07C 9E04             (    forth6809.asm):02767                     LDX   LATEST
D07E E684             (    forth6809.asm):02768                     LDB   ,X
D080 C41F             (    forth6809.asm):02769                     ANDB  #$1F
D082 4F               (    forth6809.asm):02770                     CLRA
D083 308B             (    forth6809.asm):02771                     LEAX  D,X               ; header + name length
D085 EC03             (    forth6809.asm):02772                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D087 C30003           (    forth6809.asm):02773                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D08A 1F01             (    forth6809.asm):02774                     TFR   D,X
                      (    forth6809.asm):02775         
D08C 10AF84           (    forth6809.asm):02776                     STY   ,X                ; patch it
                      (    forth6809.asm):02777         
D08F 3510             (    forth6809.asm):02778                     PULS  X                 ; X = the OUTER defining word's own return addr
D091 6E84             (    forth6809.asm):02779                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02780         
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
                      (    forth6809.asm):02782         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02783         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02784         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02785         ;    Inputs:
                      (    forth6809.asm):02786         ;        pfa on the data stack
                      (    forth6809.asm):02787         ;    Outputs:
                      (    forth6809.asm):02788         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02789         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02790         ; ------------------------------------------------------------
D093 3710             (    forth6809.asm):02791         DODEFER:    PULU  X                 ; pfa
D095 EC84             (    forth6809.asm):02792                     LDD   ,X
D097 1F01             (    forth6809.asm):02793                     TFR   D,X
D099 6E84             (    forth6809.asm):02794                     JMP   ,X
                      (    forth6809.asm):02795         
                      (    forth6809.asm):02796         ; ------------------------------------------------------------
                      (    forth6809.asm):02797         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02798         ; DOABORTUNDEF
                      (    forth6809.asm):02799         ;    Inputs:
                      (    forth6809.asm):02800         ;        none
                      (    forth6809.asm):02801         ;    Outputs:
                      (    forth6809.asm):02802         ;        none (does not return)
                      (    forth6809.asm):02803         ;    Registers: RegD changed.
                      (    forth6809.asm):02804         ; ------------------------------------------------------------
D09B                  (    forth6809.asm):02805         DOABORTUNDEF:
D09B CCFFEB           (    forth6809.asm):02806                     LDD   #-21
D09E 3606             (    forth6809.asm):02807                     PSHU  D                 ; throw code (-21)
D0A0 7ED9F1           (    forth6809.asm):02808                     JMP   THROWW
                      (    forth6809.asm):02809         
                      (    forth6809.asm):02810         ; ------------------------------------------------------------
                      (    forth6809.asm):02811         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02812         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02813         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02814         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02815         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02816         ;    Inputs:
                      (    forth6809.asm):02817         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02818         ;    Outputs:
                      (    forth6809.asm):02819         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02820         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02821         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
D0A3 3710             (    forth6809.asm):02823         DOMARKER:   PULU  X                 ; pfa
D0A5 EC84             (    forth6809.asm):02824                     LDD   ,X
D0A7 DD06             (    forth6809.asm):02825                     STD   DPHERE
D0A9 EC02             (    forth6809.asm):02826                     LDD   2,X
D0AB DD08             (    forth6809.asm):02827                     STD   CODEHERE
D0AD EC04             (    forth6809.asm):02828                     LDD   4,X
D0AF DD0A             (    forth6809.asm):02829                     STD   VARHERE
D0B1 EC06             (    forth6809.asm):02830                     LDD   6,X
D0B3 DD04             (    forth6809.asm):02831                     STD   LATEST
D0B5 3008             (    forth6809.asm):02832                     LEAX  8,X               ; the saved search-order state follows
D0B7 108E0045         (    forth6809.asm):02833                     LDY   #SRCHSAVE
D0BB C616             (    forth6809.asm):02834                     LDB   #SRCHSAVESZ
D0BD A680             (    forth6809.asm):02835         DMCOPY:     LDA   ,X+
D0BF A7A0             (    forth6809.asm):02836                     STA   ,Y+
D0C1 5A               (    forth6809.asm):02837                     DECB
D0C2 26F9             (    forth6809.asm):02838                     BNE   DMCOPY
D0C4 DC06             (    forth6809.asm):02839                     LDD   DPHERE
D0C6 7ED60A           (    forth6809.asm):02840                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02841         
                      (    forth6809.asm):02842         ; ------------------------------------------------------------
                      (    forth6809.asm):02843         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02844         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02845         ; ------------------------------------------------------------
D0C9 3710             (    forth6809.asm):02846         EXECUTEW:   PULU  X                 ; xt
D0CB AD84             (    forth6809.asm):02847                     JSR   ,X
D0CD 39               (    forth6809.asm):02848                     RTS
                      (    forth6809.asm):02849         
                      (    forth6809.asm):02850         ; ============================================================
                      (    forth6809.asm):02851         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02852         ; ============================================================
                      (    forth6809.asm):02853         ; ------------------------------------------------------------
                      (    forth6809.asm):02854         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02855         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02856         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02857         ;    Inputs:
                      (    forth6809.asm):02858         ;        RegX = address of the here pointer
                      (    forth6809.asm):02859         ;        x on the data stack
                      (    forth6809.asm):02860         ;    Outputs:
                      (    forth6809.asm):02861         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02862         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02863         ; ------------------------------------------------------------
D0CE 3706             (    forth6809.asm):02864         APPENDCELL: PULU  D                 ; x
D0D0 10AE84           (    forth6809.asm):02865                     LDY   ,X
D0D3 EDA1             (    forth6809.asm):02866                     STD   ,Y++
D0D5 10AF84           (    forth6809.asm):02867                     STY   ,X
D0D8 39               (    forth6809.asm):02868                     RTS
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ------------------------------------------------------------
                      (    forth6809.asm):02871         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02872         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02873         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02874         ;    Inputs:
                      (    forth6809.asm):02875         ;        RegX = address of the here pointer
                      (    forth6809.asm):02876         ;        char on the data stack
                      (    forth6809.asm):02877         ;    Outputs:
                      (    forth6809.asm):02878         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02879         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
D0D9 3706             (    forth6809.asm):02881         APPENDBYTE: PULU  D                 ; char
D0DB 10AE84           (    forth6809.asm):02882                     LDY   ,X
D0DE E7A0             (    forth6809.asm):02883                     STB   ,Y+
D0E0 10AF84           (    forth6809.asm):02884                     STY   ,X
D0E3 39               (    forth6809.asm):02885                     RTS
                      (    forth6809.asm):02886         
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
                      (    forth6809.asm):02888         ; ,  ( x -- )
                      (    forth6809.asm):02889         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02890         ; ------------------------------------------------------------
D0E4 8E0008           (    forth6809.asm):02891         COMMAW:     LDX   #CODEHERE
D0E7 7ED0CE           (    forth6809.asm):02892                     JMP   APPENDCELL
                      (    forth6809.asm):02893         
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
                      (    forth6809.asm):02895         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02896         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02897         ; ------------------------------------------------------------
D0EA 8E0008           (    forth6809.asm):02898         CODECOMMA:  LDX   #CODEHERE
D0ED 7ED0CE           (    forth6809.asm):02899                     JMP   APPENDCELL
                      (    forth6809.asm):02900         
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
                      (    forth6809.asm):02902         ; C,  ( char -- )
                      (    forth6809.asm):02903         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02904         ; ------------------------------------------------------------
D0F0 8E0008           (    forth6809.asm):02905         CCOMMAW:    LDX   #CODEHERE
D0F3 7ED0D9           (    forth6809.asm):02906                     JMP   APPENDBYTE
                      (    forth6809.asm):02907         
                      (    forth6809.asm):02908         ; ------------------------------------------------------------
                      (    forth6809.asm):02909         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02910         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
D0F6 8E0008           (    forth6809.asm):02912         CCOMMA1:    LDX   #CODEHERE
D0F9 7ED0D9           (    forth6809.asm):02913                     JMP   APPENDBYTE
                      (    forth6809.asm):02914         
                      (    forth6809.asm):02915         ; ------------------------------------------------------------
                      (    forth6809.asm):02916         ; V,  ( x -- )
                      (    forth6809.asm):02917         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
D0FC 8E000A           (    forth6809.asm):02919         VCOMMAW:    LDX   #VARHERE
D0FF 7ED0CE           (    forth6809.asm):02920                     JMP   APPENDCELL
                      (    forth6809.asm):02921         
                      (    forth6809.asm):02922         ; ------------------------------------------------------------
                      (    forth6809.asm):02923         ; VC,  ( char -- )
                      (    forth6809.asm):02924         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02925         ; ------------------------------------------------------------
D102 8E000A           (    forth6809.asm):02926         VCCOMMAW:   LDX   #VARHERE
D105 7ED0D9           (    forth6809.asm):02927                     JMP   APPENDBYTE
                      (    forth6809.asm):02928         
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
                      (    forth6809.asm):02930         ; ALLOT  ( n -- )
                      (    forth6809.asm):02931         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02932         ; ------------------------------------------------------------
D108 3706             (    forth6809.asm):02933         ALLOTW:     PULU  D                 ; n
D10A 9E08             (    forth6809.asm):02934                     LDX   CODEHERE
D10C 308B             (    forth6809.asm):02935                     LEAX  D,X
D10E 9F08             (    forth6809.asm):02936                     STX   CODEHERE
D110 39               (    forth6809.asm):02937                     RTS
                      (    forth6809.asm):02938         
                      (    forth6809.asm):02939         ; ------------------------------------------------------------
                      (    forth6809.asm):02940         ; VALLOT  ( n -- )
                      (    forth6809.asm):02941         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02942         ; ------------------------------------------------------------
D111 3706             (    forth6809.asm):02943         VALLOTW:    PULU  D                 ; n
D113 9E0A             (    forth6809.asm):02944                     LDX   VARHERE
D115 308B             (    forth6809.asm):02945                     LEAX  D,X
D117 9F0A             (    forth6809.asm):02946                     STX   VARHERE
D119 39               (    forth6809.asm):02947                     RTS
                      (    forth6809.asm):02948         
                      (    forth6809.asm):02949         ; ------------------------------------------------------------
                      (    forth6809.asm):02950         ; HERE  ( -- addr )
                      (    forth6809.asm):02951         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02952         ; ------------------------------------------------------------
D11A DC08             (    forth6809.asm):02953         HEREW:      LDD   CODEHERE
D11C 3606             (    forth6809.asm):02954                     PSHU  D                 ; addr
D11E 39               (    forth6809.asm):02955                     RTS
                      (    forth6809.asm):02956         
                      (    forth6809.asm):02957         ; ------------------------------------------------------------
                      (    forth6809.asm):02958         ; VHERE  ( -- addr )
                      (    forth6809.asm):02959         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02960         ; ------------------------------------------------------------
D11F DC0A             (    forth6809.asm):02961         VHEREW:     LDD   VARHERE
D121 3606             (    forth6809.asm):02962                     PSHU  D                 ; addr
D123 39               (    forth6809.asm):02963                     RTS
                      (    forth6809.asm):02964         
                      (    forth6809.asm):02965         ; ------------------------------------------------------------
                      (    forth6809.asm):02966         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02967         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02968         ; ------------------------------------------------------------
D124 DC08             (    forth6809.asm):02969         PADW:       LDD   CODEHERE
D126 C30080           (    forth6809.asm):02970                     ADDD  #PADOFFSET
D129 3606             (    forth6809.asm):02971                     PSHU  D                 ; c-addr
D12B 39               (    forth6809.asm):02972                     RTS
                      (    forth6809.asm):02973         
                      (    forth6809.asm):02974         ; ------------------------------------------------------------
                      (    forth6809.asm):02975         ; UNUSED  ( -- u )
                      (    forth6809.asm):02976         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02977         ; ------------------------------------------------------------
D12C CCB900           (    forth6809.asm):02978         UNUSEDW:    LDD   #CODETOP
D12F 9308             (    forth6809.asm):02979                     SUBD  CODEHERE
D131 3606             (    forth6809.asm):02980                     PSHU  D                 ; u
D133 39               (    forth6809.asm):02981                     RTS
                      (    forth6809.asm):02982         
                      (    forth6809.asm):02983         ; ------------------------------------------------------------
                      (    forth6809.asm):02984         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02985         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02986         ; ------------------------------------------------------------
D134 CC1FFF           (    forth6809.asm):02987         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D137 930A             (    forth6809.asm):02988                     SUBD  VARHERE
D139 3606             (    forth6809.asm):02989                     PSHU  D                 ; u
D13B 39               (    forth6809.asm):02990                     RTS
                      (    forth6809.asm):02991         
                      (    forth6809.asm):02992         ; ============================================================
                      (    forth6809.asm):02993         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02994         ; ============================================================
                      (    forth6809.asm):02995         ; ------------------------------------------------------------
                      (    forth6809.asm):02996         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02997         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02998         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02999         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):03000         ; wordlist are updated.
                      (    forth6809.asm):03001         ; HEADER   ( smudge-flag "name" -- )   Throws -16 for an empty name and
                      (    forth6809.asm):03002         ;    -19 for a name of more than 31 characters (the length byte holds the
                      (    forth6809.asm):03003         ;    length in bits 0-4 and the flags in bits 5-7).
                      (    forth6809.asm):03004         ;    Inputs:
                      (    forth6809.asm):03005         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):03006         ;        name parsed from the input stream
                      (    forth6809.asm):03007         ;    Outputs:
                      (    forth6809.asm):03008         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):03009         ;        LATEST = address of the new header
                      (    forth6809.asm):03010         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03011         ; ------------------------------------------------------------
D13C CC0020           (    forth6809.asm):03012         HEADER:     LDD   #32
D13F 3606             (    forth6809.asm):03013                     PSHU  D
D141 BDD493           (    forth6809.asm):03014                     JSR   WORDW
D144 3710             (    forth6809.asm):03015                     PULU  X                 ; c-addr of the name
D146 3706             (    forth6809.asm):03016                     PULU  D                 ; smudge flag in B
D148 A680             (    forth6809.asm):03017                     LDA   ,X+               ; name length, X = name text
D14A 2731             (    forth6809.asm):03018                     BEQ   HDZERO            ; no name: throw -16
D14C 811F             (    forth6809.asm):03019                     CMPA  #31
D14E 2232             (    forth6809.asm):03020                     BHI   HDLONG            ; over 31 characters: throw -19
D150 3402             (    forth6809.asm):03021                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D152 5D               (    forth6809.asm):03022                     TSTB
D153 2702             (    forth6809.asm):03023                     BEQ   HDNOSM
D155 8A40             (    forth6809.asm):03024                     ORA   #$40
D157 109E06           (    forth6809.asm):03025         HDNOSM:     LDY   DPHERE
D15A 3420             (    forth6809.asm):03026                     PSHS  Y                 ; 0,S = address of the new header
D15C A7A0             (    forth6809.asm):03027                     STA   ,Y+
D15E E662             (    forth6809.asm):03028                     LDB   2,S               ; length is 1 to 31 here
D160 A680             (    forth6809.asm):03029         HDCPY:      LDA   ,X+
D162 A7A0             (    forth6809.asm):03030                     STA   ,Y+
D164 5A               (    forth6809.asm):03031                     DECB
D165 26F9             (    forth6809.asm):03032                     BNE   HDCPY
D167 9E47             (    forth6809.asm):03033                     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D169 EC84             (    forth6809.asm):03034                     LDD   ,X
D16B EDA1             (    forth6809.asm):03035                     STD   ,Y++              ; LINK = old head of that wordlist
D16D DC08             (    forth6809.asm):03036                     LDD   CODEHERE
D16F EDA1             (    forth6809.asm):03037                     STD   ,Y++
D171 109F06           (    forth6809.asm):03038                     STY   DPHERE
D174 3506             (    forth6809.asm):03039                     PULS  D
D176 DD04             (    forth6809.asm):03040                     STD   LATEST            ; LATEST = newest header of any wordlist
D178 ED84             (    forth6809.asm):03041                     STD   ,X                ; and the new head of the CURRENT wordlist
D17A 3261             (    forth6809.asm):03042                     LEAS  1,S
D17C 39               (    forth6809.asm):03043                     RTS
D17D CCFFF0           (    forth6809.asm):03044         HDZERO:     LDD   #-16              ; attempt to use zero-length string as a name
D180 2003             (    forth6809.asm):03045                     BRA   HDTHROW
D182 CCFFED           (    forth6809.asm):03046         HDLONG:     LDD   #-19              ; definition name too long (flags need bits 5-7)
D185 3606             (    forth6809.asm):03047         HDTHROW:    PSHU  D
D187 7ED9F1           (    forth6809.asm):03048                     JMP   THROWW
                      (    forth6809.asm):03049         
                      (    forth6809.asm):03050         ; ------------------------------------------------------------
                      (    forth6809.asm):03051         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03052         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03053         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03054         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03055         ; SMUDGE   ( -- )
                      (    forth6809.asm):03056         ;    Inputs:
                      (    forth6809.asm):03057         ;        none
                      (    forth6809.asm):03058         ;    Outputs:
                      (    forth6809.asm):03059         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03060         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03061         ; ------------------------------------------------------------
D18A 9E04             (    forth6809.asm):03062         SMUDGEW:    LDX   LATEST
D18C A684             (    forth6809.asm):03063                     LDA   ,X
D18E 8840             (    forth6809.asm):03064                     EORA  #$40
D190 A784             (    forth6809.asm):03065                     STA   ,X
D192 39               (    forth6809.asm):03066                     RTS
                      (    forth6809.asm):03067         
                      (    forth6809.asm):03068         ; ============================================================
                      (    forth6809.asm):03069         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03070         ; ============================================================
                      (    forth6809.asm):03071         ; ------------------------------------------------------------
                      (    forth6809.asm):03072         ; :  ( "name" -- )
                      (    forth6809.asm):03073         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03074         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03075         ; CSP and enter compile state.
                      (    forth6809.asm):03076         ; ------------------------------------------------------------
D193 CCFFFF           (    forth6809.asm):03077         COLONW:     LDD   #TRUEV
D196 3606             (    forth6809.asm):03078                     PSHU  D
D198 BDD13C           (    forth6809.asm):03079                     JSR   HEADER
D19B DC08             (    forth6809.asm):03080                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D19D DD1F             (    forth6809.asm):03081                     STD   CURXT             ; See bugfix: COLONW.1
D19F 1F30             (    forth6809.asm):03082                     TFR   U,D
D1A1 DD21             (    forth6809.asm):03083                     STD   CSP
D1A3 CCFFFF           (    forth6809.asm):03084                     LDD   #-1
D1A6 DD00             (    forth6809.asm):03085                     STD   STATE
D1A8 39               (    forth6809.asm):03086                     RTS
                      (    forth6809.asm):03087         
                      (    forth6809.asm):03088         ; ------------------------------------------------------------
                      (    forth6809.asm):03089         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03090         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03091         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03092         ; new word and return to interpret state.
                      (    forth6809.asm):03093         ; ------------------------------------------------------------
D1A9 CC0039           (    forth6809.asm):03094         SEMIW:      LDD   #RTSOPC
D1AC 3606             (    forth6809.asm):03095                     PSHU  D
D1AE BDD0F6           (    forth6809.asm):03096                     JSR   CCOMMA1
D1B1 1F30             (    forth6809.asm):03097                     TFR   U,D
D1B3 109321           (    forth6809.asm):03098                     CMPD  CSP
D1B6 2703             (    forth6809.asm):03099                     BEQ   SEMIOK
D1B8 BDD9BC           (    forth6809.asm):03100                     JSR   CFERR
D1BB 9E04             (    forth6809.asm):03101         SEMIOK:     LDX   LATEST
D1BD A684             (    forth6809.asm):03102                     LDA   ,X
D1BF 84BF             (    forth6809.asm):03103                     ANDA  #$BF
D1C1 A784             (    forth6809.asm):03104                     STA   ,X
D1C3 CC0000           (    forth6809.asm):03105                     LDD   #0
D1C6 DD00             (    forth6809.asm):03106                     STD   STATE
D1C8 39               (    forth6809.asm):03107                     RTS
                      (    forth6809.asm):03108         
                      (    forth6809.asm):03109         ; ------------------------------------------------------------
                      (    forth6809.asm):03110         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03111         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03112         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03113         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03114         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03115         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03116         ; ------------------------------------------------------------
D1C9 DC08             (    forth6809.asm):03117         NONAMEW:    LDD   CODEHERE
D1CB 3606             (    forth6809.asm):03118                     PSHU  D                 ; xt
D1CD DD1F             (    forth6809.asm):03119                     STD   CURXT             ; See bugfix: NONAMEW.1
D1CF 1F30             (    forth6809.asm):03120                     TFR   U,D
D1D1 DD21             (    forth6809.asm):03121                     STD   CSP
D1D3 CCFFFF           (    forth6809.asm):03122                     LDD   #-1
D1D6 DD00             (    forth6809.asm):03123                     STD   STATE
D1D8 39               (    forth6809.asm):03124                     RTS
                      (    forth6809.asm):03125         
                      (    forth6809.asm):03126         ; ------------------------------------------------------------
                      (    forth6809.asm):03127         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03128         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03129         ; BLDDOES
                      (    forth6809.asm):03130         ;    Inputs:
                      (    forth6809.asm):03131         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03132         ;    Outputs:
                      (    forth6809.asm):03133         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03134         ;    Registers: all changed.
                      (    forth6809.asm):03135         ; BLDSELF
                      (    forth6809.asm):03136         ;    Inputs:
                      (    forth6809.asm):03137         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03138         ;    Outputs:
                      (    forth6809.asm):03139         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03140         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03141         ;    Registers: all changed.
                      (    forth6809.asm):03142         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03143         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03144         ; ------------------------------------------------------------
D1D9 3406             (    forth6809.asm):03145         BLDDOES:    PSHS  D                 ; behaviour address
D1DB CC0000           (    forth6809.asm):03146                     LDD   #0
D1DE 3606             (    forth6809.asm):03147                     PSHU  D
D1E0 BDD13C           (    forth6809.asm):03148                     JSR   HEADER
D1E3 CCD06C           (    forth6809.asm):03149                     LDD   #DODOES
D1E6 3606             (    forth6809.asm):03150                     PSHU  D
D1E8 BDDE2C           (    forth6809.asm):03151                     JSR   CCALL
D1EB 3506             (    forth6809.asm):03152                     PULS  D
D1ED 3606             (    forth6809.asm):03153                     PSHU  D                 ; behaviour address
D1EF BDD0EA           (    forth6809.asm):03154                     JSR   CODECOMMA
D1F2 39               (    forth6809.asm):03155                     RTS
                      (    forth6809.asm):03156         
D1F3 BDD1D9           (    forth6809.asm):03157         BLDSELF:    JSR   BLDDOES
D1F6 DC08             (    forth6809.asm):03158                     LDD   CODEHERE          ; PFA = the cell after this one
D1F8 C30002           (    forth6809.asm):03159                     ADDD  #2                ; See bugfix: CONSTANTW.1
D1FB 3606             (    forth6809.asm):03160                     PSHU  D
D1FD BDD0EA           (    forth6809.asm):03161                     JSR   CODECOMMA
D200 39               (    forth6809.asm):03162                     RTS
                      (    forth6809.asm):03163         
                      (    forth6809.asm):03164         ; ------------------------------------------------------------
                      (    forth6809.asm):03165         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03166         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03167         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03168         ; address in the code area, on the stack.
                      (    forth6809.asm):03169         ; ------------------------------------------------------------
D201 CCD077           (    forth6809.asm):03170         CREATEW:    LDD   #DOESRT0
D204 BDD1F3           (    forth6809.asm):03171                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D207 39               (    forth6809.asm):03172                     RTS
                      (    forth6809.asm):03173         
                      (    forth6809.asm):03174         ; ------------------------------------------------------------
                      (    forth6809.asm):03175         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03176         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03177         ; of the word being defined.
                      (    forth6809.asm):03178         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03179         ; ------------------------------------------------------------
D208 CCD078           (    forth6809.asm):03180         DOESGTW:    LDD   #SETDOES
D20B 3606             (    forth6809.asm):03181                     PSHU  D
D20D BDDE2C           (    forth6809.asm):03182                     JSR   CCALL
D210 39               (    forth6809.asm):03183                     RTS
                      (    forth6809.asm):03184         
                      (    forth6809.asm):03185         ; ------------------------------------------------------------
                      (    forth6809.asm):03186         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03187         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03188         ; area, initialised to zero.
                      (    forth6809.asm):03189         ; ------------------------------------------------------------
D211 CC0000           (    forth6809.asm):03190         VARIABLEW:  LDD   #0
D214 3606             (    forth6809.asm):03191                     PSHU  D
D216 BDD13C           (    forth6809.asm):03192                     JSR   HEADER
D219 CCD06C           (    forth6809.asm):03193                     LDD   #DODOES
D21C 3606             (    forth6809.asm):03194                     PSHU  D
D21E BDDE2C           (    forth6809.asm):03195                     JSR   CCALL
D221 CCD077           (    forth6809.asm):03196                     LDD   #DOESRT0
D224 3606             (    forth6809.asm):03197                     PSHU  D
D226 BDD0EA           (    forth6809.asm):03198                     JSR   CODECOMMA
D229 DC0A             (    forth6809.asm):03199                     LDD   VARHERE
D22B 3606             (    forth6809.asm):03200                     PSHU  D
D22D BDD0EA           (    forth6809.asm):03201                     JSR   CODECOMMA
D230 CC0000           (    forth6809.asm):03202                     LDD   #0
D233 9E0A             (    forth6809.asm):03203                     LDX   VARHERE
D235 ED81             (    forth6809.asm):03204                     STD   ,X++
D237 9F0A             (    forth6809.asm):03205                     STX   VARHERE
D239 39               (    forth6809.asm):03206                     RTS
                      (    forth6809.asm):03207         
                      (    forth6809.asm):03208         ; ------------------------------------------------------------
                      (    forth6809.asm):03209         ; @  ( a-addr -- x )
                      (    forth6809.asm):03210         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03211         ; ------------------------------------------------------------
D23A 3710             (    forth6809.asm):03212         FETCHW:     PULU  X                 ; a-addr
D23C EC84             (    forth6809.asm):03213                     LDD   ,X
D23E 3606             (    forth6809.asm):03214                     PSHU  D                 ; x
D240 39               (    forth6809.asm):03215                     RTS
                      (    forth6809.asm):03216         
                      (    forth6809.asm):03217         ; ------------------------------------------------------------
                      (    forth6809.asm):03218         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03219         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03220         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03221         ; ------------------------------------------------------------
D241 CCD23A           (    forth6809.asm):03222         CONSTANTW:  LDD   #FETCHW
D244 BDD1F3           (    forth6809.asm):03223                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D247 BDD0E4           (    forth6809.asm):03224                     JSR   COMMAW
D24A 39               (    forth6809.asm):03225                     RTS
                      (    forth6809.asm):03226         
                      (    forth6809.asm):03227         ; ------------------------------------------------------------
                      (    forth6809.asm):03228         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03229         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03230         ;    Inputs:
                      (    forth6809.asm):03231         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03232         ;    Outputs:
                      (    forth6809.asm):03233         ;        pfa replaced by the value
                      (    forth6809.asm):03234         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03235         ; ------------------------------------------------------------
D24B 3710             (    forth6809.asm):03236         DOVALUE:    PULU  X                 ; pfa
D24D EC84             (    forth6809.asm):03237                     LDD   ,X
D24F 3606             (    forth6809.asm):03238                     PSHU  D                 ; x
D251 39               (    forth6809.asm):03239                     RTS
                      (    forth6809.asm):03240         
                      (    forth6809.asm):03241         ; ------------------------------------------------------------
                      (    forth6809.asm):03242         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03243         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03244         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03245         ; ------------------------------------------------------------
D252 CCD24B           (    forth6809.asm):03246         VALUEW:     LDD   #DOVALUE
D255 BDD1D9           (    forth6809.asm):03247                     JSR   BLDDOES
D258 DC0A             (    forth6809.asm):03248                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D25A 3606             (    forth6809.asm):03249                     PSHU  D                 ; See bugfix: VALUEW.1
D25C BDD0EA           (    forth6809.asm):03250                     JSR   CODECOMMA
D25F BDD0FC           (    forth6809.asm):03251                     JSR   VCOMMAW           ; store x in the variable area
D262 39               (    forth6809.asm):03252                     RTS
                      (    forth6809.asm):03253         
                      (    forth6809.asm):03254         ; ------------------------------------------------------------
                      (    forth6809.asm):03255         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03256         ; lower address as 2@ expects.
                      (    forth6809.asm):03257         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03258         ; ------------------------------------------------------------
D263 7EE7ED           (    forth6809.asm):03259         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03260         
                      (    forth6809.asm):03261         ; ------------------------------------------------------------
                      (    forth6809.asm):03262         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03263         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03264         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03265         ; ------------------------------------------------------------
D266 CCD263           (    forth6809.asm):03266         TWOVALUEW:  LDD   #DO2VALUE
D269 BDD1D9           (    forth6809.asm):03267                     JSR   BLDDOES
D26C DC0A             (    forth6809.asm):03268                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D26E 3606             (    forth6809.asm):03269                     PSHU  D
D270 BDD0EA           (    forth6809.asm):03270                     JSR   CODECOMMA
D273 BDD0FC           (    forth6809.asm):03271                     JSR   VCOMMAW           ; x2 at the lower address
D276 BDD0FC           (    forth6809.asm):03272                     JSR   VCOMMAW           ; then x1
D279 39               (    forth6809.asm):03273                     RTS
                      (    forth6809.asm):03274         
                      (    forth6809.asm):03275         ; ------------------------------------------------------------
                      (    forth6809.asm):03276         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03277         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03278         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03279         ; ------------------------------------------------------------
D27A CC0020           (    forth6809.asm):03280         TOW:        LDD   #32
D27D 3606             (    forth6809.asm):03281                     PSHU  D
D27F BDD493           (    forth6809.asm):03282                     JSR   WORDW
D282 BDD57C           (    forth6809.asm):03283                     JSR   FINDW
D285 3706             (    forth6809.asm):03284                     PULU  D
D287 10830000         (    forth6809.asm):03285                     CMPD  #0
D28B 260A             (    forth6809.asm):03286                     BNE   TOFOUND
D28D 3706             (    forth6809.asm):03287                     PULU  D
D28F CCFFF3           (    forth6809.asm):03288                     LDD   #-13

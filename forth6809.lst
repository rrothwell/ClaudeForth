                      (    forth6809.asm):02041         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):02042         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):02043         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):02044         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):02045         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):02046         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):02047         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):02048         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):02049         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):02050         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):02051         ; were chained on after H_QUIT in a later turn.
DD1E 05               (    forth6809.asm):02052         H_ABORT:    FCB   5
DD1F 41424F5254       (    forth6809.asm):02053                     FCC   "ABORT"
DD24 DD14             (    forth6809.asm):02054                     FDB   H_FALSE           ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):02055                                             ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):02056                                             ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):02057                                             ; now H_FALSE, the chain's newest entry
DD26 DDC7             (    forth6809.asm):02058                     FDB   ABORTW            ; BUG FIX: the ABORT *word* is -1 THROW so CATCH
                      (    forth6809.asm):02059                                             ; can intercept it (26's t6 c6); the bare ABORT
                      (    forth6809.asm):02060                                             ; label stays the unconditional reset.
                      (    forth6809.asm):02061         
DD28 04               (    forth6809.asm):02062         H_QUIT:     FCB   4
DD29 51554954         (    forth6809.asm):02063                     FCC   "QUIT"
DD2D DD1E             (    forth6809.asm):02064                     FDB   H_ABORT
DD2F DDD2             (    forth6809.asm):02065                     FDB   QUIT
                      (    forth6809.asm):02066         
                      (    forth6809.asm):02067         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):02068         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):02069         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):02070         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):02071         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):02072         ; reconstructs and pushes the original c-addr, then 0.
DD31 04               (    forth6809.asm):02073         H_FIND:     FCB   4

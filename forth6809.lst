                      (    forth6809.asm):10370                       STD  TSTSLSAV
                      (    forth6809.asm):10371                       LDD  TOIN
                      (    forth6809.asm):10372                       STD  TSTTISAV
                      (    forth6809.asm):10373                       LDD  STATE
                      (    forth6809.asm):10374                       STD  TSTSTSAV
                      (    forth6809.asm):10375         
                      (    forth6809.asm):10376                       LDA  #$83
                      (    forth6809.asm):10377                       STA  TSTFHDR
                      (    forth6809.asm):10378                       LDA  #'F'
                      (    forth6809.asm):10379                       STA  TSTFHDR+1
                      (    forth6809.asm):10380                       LDA  #'O'
                      (    forth6809.asm):10381                       STA  TSTFHDR+2
                      (    forth6809.asm):10382                       LDA  #'O'
                      (    forth6809.asm):10383                       STA  TSTFHDR+3
                      (    forth6809.asm):10384                       LDD  #0
                      (    forth6809.asm):10385                       STD  TSTFHDR+4
                      (    forth6809.asm):10386                       LDD  #SPACEW
                      (    forth6809.asm):10387                       STD  TSTFHDR+6
                      (    forth6809.asm):10388         
                      (    forth6809.asm):10389                       LDA  #'F'
                      (    forth6809.asm):10390                       STA  TSTNAMEB
                      (    forth6809.asm):10391                       LDA  #'O'
                      (    forth6809.asm):10392                       STA  TSTNAMEB+1

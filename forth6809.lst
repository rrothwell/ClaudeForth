                      (    forth6809.asm):15276         ; TSTTHROWZERO - unit test for THROW(0). Confirmed via its own
                      (    forth6809.asm):15277         ; code that N=0 is a genuine, unconditional no-op (BEQ THDONE
                      (    forth6809.asm):15278         ; skips everything, never touching HANDLER or ABORT), so this
                      (    forth6809.asm):15279         ; is the one THROW call in this section safe to make directly,
                      (    forth6809.asm):15280         ; without any CATCH wrapping it. Verifies it consumes its
                      (    forth6809.asm):15281         ; argument and does nothing else - no non-local exit, no stack
                      (    forth6809.asm):15282         ; disturbance beyond popping the 0 itself.
                      (    forth6809.asm):15283         ; ------------------------------------------------------------
C305                  (    forth6809.asm):15284         TSTTHROWZERO: STU  TSTU0
                      (    forth6809.asm):15285         
                      (    forth6809.asm):15286                       LDD  #TSTGUARD
                      (    forth6809.asm):15287                       PSHU D
                      (    forth6809.asm):15288                       LDD  #0
                      (    forth6809.asm):15289                       PSHU D
                      (    forth6809.asm):15290                       STU  TSTUB4
                      (    forth6809.asm):15291         
                      (    forth6809.asm):15292                       JSR  THROW
                      (    forth6809.asm):15293         
                      (    forth6809.asm):15294                       STU  TSTUAF
                      (    forth6809.asm):15295         
                      (    forth6809.asm):15296                       PULU D
                      (    forth6809.asm):15297                       CMPD #TSTGUARD
                      (    forth6809.asm):15298                       BNE  TVFAIL
                      (    forth6809.asm):15299         
                      (    forth6809.asm):15300                       LDD  TSTUB4
                      (    forth6809.asm):15301                       SUBD TSTUAF
                      (    forth6809.asm):15302                       CMPD #-2
                      (    forth6809.asm):15303                       BNE  TVFAIL
                      (    forth6809.asm):15304         
                      (    forth6809.asm):15305                       LDD  #TRUEV
                      (    forth6809.asm):15306                       BRA  TVDONE
C305                  (    forth6809.asm):15307         TVFAIL:       LDD  #FALSEV
C305                  (    forth6809.asm):15308         TVDONE:       LDX  #TSTTZNAME
                      (    forth6809.asm):15309                       PSHU X
                      (    forth6809.asm):15310                       PSHU D
                      (    forth6809.asm):15311                       JSR  TSTREPORT
                      (    forth6809.asm):15312         
                      (    forth6809.asm):15313                       LDU  TSTU0
                      (    forth6809.asm):15314                       RTS
                      (    forth6809.asm):15315         
C305                  (    forth6809.asm):15316         TSTTZNAME: FCB  12
                      (    forth6809.asm):15317                    FCC  "TSTTHROWZERO"
                      (    forth6809.asm):15318         

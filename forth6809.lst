                      (    forth6809.asm):03570         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03571         ; ------------------------------------------------------------
E487 B6C008           (    forth6809.asm):03572         KEYQW:      LDA   ACIASR
E48A 8501             (    forth6809.asm):03573                     BITA  #SR_RDRF
E48C 2706             (    forth6809.asm):03574                     BEQ   KQFALSE
E48E CCFFFF           (    forth6809.asm):03575                     LDD   #TRUEV
E491 3606             (    forth6809.asm):03576                     PSHU  D                 ; flag = true
E493 39               (    forth6809.asm):03577                     RTS
E494 CC0000           (    forth6809.asm):03578         KQFALSE:    LDD   #FALSEV
E497 3606             (    forth6809.asm):03579                     PSHU  D                 ; flag = false
E499 39               (    forth6809.asm):03580                     RTS
                      (    forth6809.asm):03581         

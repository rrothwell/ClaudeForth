                      (    forth6809.asm):02304         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):02305         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):02306         ; ------------------------------------------------------------
C195                  (    forth6809.asm):02307         TSTDROT:   STU   TSTU0
                      (    forth6809.asm):02308         

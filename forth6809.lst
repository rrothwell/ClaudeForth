                      (    forth6809.asm):06854         ; REPLACES  ( c-addr1 u1 c-addr2 u2 -- )
                      (    forth6809.asm):06855         ; Register the substitution text c-addr1 u1 for the name c-addr2 u2.
                      (    forth6809.asm):06856         ; Only one registration is kept (a single slot); a new call replaces
                      (    forth6809.asm):06857         ; the previous one. The strings are not copied.

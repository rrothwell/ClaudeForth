                      (    forth6809.asm):05685         
                      (    forth6809.asm):05686         ; ------------------------------------------------------------
                      (    forth6809.asm):05687         ; 2SWAP  ( x1 x2 x3 x4 -- x3 x4 x1 x2 )
                      (    forth6809.asm):05688         ; Exchange the top two cell pairs.
                      (    forth6809.asm):05689         ; ------------------------------------------------------------
E3D5 ECC4             (    forth6809.asm):05690         DSWAPW:     LDD   ,U                ; x4
E3D7 DD14             (    forth6809.asm):05691                     STD   MSCR
E3D9 EC42             (    forth6809.asm):05692                     LDD   2,U               ; x3
E3DB AE44             (    forth6809.asm):05693                     LDX   4,U               ; x2
E3DD 10AE46           (    forth6809.asm):05694                     LDY   6,U               ; x1
E3E0 ED46             (    forth6809.asm):05695                     STD   6,U
E3E2 AFC4             (    forth6809.asm):05696                     STX   ,U
E3E4 10AF42           (    forth6809.asm):05697                     STY   2,U

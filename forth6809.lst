E872 2007             (    forth6809.asm):04163                     BRA   DPCONT
E874 DC18             (    forth6809.asm):04164         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E876 109316           (    forth6809.asm):04165                     CMPD  MSCR2
E879 2209             (    forth6809.asm):04166                     BHI   DPTEXIT
E87B 3510             (    forth6809.asm):04167         DPCONT:     PULS  X                 ; X = branch operand address
E87D EC84             (    forth6809.asm):04168                     LDD   ,X

                      (    forth6809.asm):02022                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):02023                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):02024                                        ; now H_FALSE, the chain's newest entry

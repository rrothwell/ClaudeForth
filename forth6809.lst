DDAA A685             (    forth6809.asm):01759                     LDA   B,X
DDAC B7C009           (    forth6809.asm):01760                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):01761         
DDAF 5C               (    forth6809.asm):01762                     INCB                    ; Update the tail pointer
DDB0 C43F             (    forth6809.asm):01763                     ANDB  #OUTBUFSZ-1       ; to point to the next character.

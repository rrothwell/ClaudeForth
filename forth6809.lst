                      (    forth6809.asm):02242         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):02243         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):02244         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):02245         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):02246         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):02247         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):02248         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):02249         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
C195                  (    forth6809.asm):02251         TSTROLL:   STU   TSTU0
                      (    forth6809.asm):02252         
                      (    forth6809.asm):02253                    LDD   #TSTGUARD

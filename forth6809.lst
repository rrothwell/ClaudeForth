D4D6 CCD0B4           (    forth6809.asm):03577                     LDD   #LIT
D4D9 3606             (    forth6809.asm):03578                     PSHU  D
D4DB BDDE7F           (    forth6809.asm):03579                     JSR   CCALL
D4DE BDD15A           (    forth6809.asm):03580                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
D4E1 CCD0B4           (    forth6809.asm):03581                     LDD   #LIT
D4E4 3606             (    forth6809.asm):03582                     PSHU  D
D4E6 BDDE7F           (    forth6809.asm):03583                     JSR   CCALL

F620 1F02             (    forth6809.asm):05452                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):05453                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):05454                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):05455                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):05456                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):05457                                   ; The high byte took on the fill character's
                      (    forth6809.asm):05458                                   ; value instead of the count's real high
                      (    forth6809.asm):05459                                   ; byte, so the count almost never reached
                      (    forth6809.asm):05460                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):05461                                   ; past the requested length. Keeping the
                      (    forth6809.asm):05462                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):05463                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):05464                                   ; fill character into A) and removes the
                      (    forth6809.asm):05465                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):05466                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):05467                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):05468                                   ; MAME debugger.
F622 3706             (    forth6809.asm):05469                  PULU  D
F624 1F01             (    forth6809.asm):05470                  TFR   D,X        ; address, kept directly in X rather than
                      (    forth6809.asm):05471                                   ; round-tripping through FILLADDR too

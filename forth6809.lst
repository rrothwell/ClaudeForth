                      (    forth6809.asm):02970         ; ============================================================
                      (    forth6809.asm):02971         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02972         ; ============================================================
                      (    forth6809.asm):02973         ; ------------------------------------------------------------
                      (    forth6809.asm):02974         ; INTERPRET  ( -- )
                      (    forth6809.asm):02975         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02976         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02977         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02978         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02979         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02980         ; ------------------------------------------------------------
E143                  (    forth6809.asm):02981         INTERPRET:
E143 CC0020           (    forth6809.asm):02982         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
E146 3606             (    forth6809.asm):02983                     PSHU  D                 ; char
E148 BDE1C3           (    forth6809.asm):02984                     JSR   WORDW
E14B AEC4             (    forth6809.asm):02985                     LDX   ,U
E14D A684             (    forth6809.asm):02986                     LDA   ,X
E14F 276F             (    forth6809.asm):02987                     BEQ   IDONE
                      (    forth6809.asm):02988         
E151 BDE22F           (    forth6809.asm):02989                     JSR   FINDW

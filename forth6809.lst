E38F 3606             (    forth6809.asm):05607                     PSHU  D
E391 39               (    forth6809.asm):05608                     RTS
                      (    forth6809.asm):05609         
                      (    forth6809.asm):05610         ; ------------------------------------------------------------
                      (    forth6809.asm):05611         ; DROP  ( x -- )
                      (    forth6809.asm):05612         ; Discard the top cell.
                      (    forth6809.asm):05613         ; ------------------------------------------------------------
E392 3342             (    forth6809.asm):05614         DROPW:      LEAU  2,U               ; x
E394 39               (    forth6809.asm):05615                     RTS
                      (    forth6809.asm):05616         
                      (    forth6809.asm):05617         ; ------------------------------------------------------------
                      (    forth6809.asm):05618         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05619         ; Exchange the top two cells.
                      (    forth6809.asm):05620         ; ------------------------------------------------------------
E395 ECC4             (    forth6809.asm):05621         SWAPW:      LDD   ,U                ; x2
E397 AE42             (    forth6809.asm):05622                     LDX   2,U               ; x1
E399 AFC4             (    forth6809.asm):05623                     STX   ,U
E39B ED42             (    forth6809.asm):05624                     STD   2,U
E39D 39               (    forth6809.asm):05625                     RTS
                      (    forth6809.asm):05626         
                      (    forth6809.asm):05627         ; ------------------------------------------------------------
                      (    forth6809.asm):05628         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05629         ; Copy the second cell to the top.
                      (    forth6809.asm):05630         ; ------------------------------------------------------------
E39E EC42             (    forth6809.asm):05631         OVERW:      LDD   2,U               ; x1
E3A0 3606             (    forth6809.asm):05632                     PSHU  D
E3A2 39               (    forth6809.asm):05633                     RTS
                      (    forth6809.asm):05634         
                      (    forth6809.asm):05635         ; ------------------------------------------------------------
                      (    forth6809.asm):05636         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05637         ; Rotate the third cell to the top.
                      (    forth6809.asm):05638         ; ------------------------------------------------------------
E3A3 ECC4             (    forth6809.asm):05639         ROTW:       LDD   ,U                ; x3
E3A5 AE42             (    forth6809.asm):05640                     LDX   2,U               ; x2
E3A7 10AE44           (    forth6809.asm):05641                     LDY   4,U               ; x1
E3AA 10AFC4           (    forth6809.asm):05642                     STY   ,U
E3AD ED42             (    forth6809.asm):05643                     STD   2,U
E3AF AF44             (    forth6809.asm):05644                     STX   4,U
E3B1 39               (    forth6809.asm):05645                     RTS
                      (    forth6809.asm):05646         
                      (    forth6809.asm):05647         ; ------------------------------------------------------------
                      (    forth6809.asm):05648         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05649         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05650         ; ------------------------------------------------------------
E3B2 ECC4             (    forth6809.asm):05651         QDUPW:      LDD   ,U                ; x
E3B4 10830000         (    forth6809.asm):05652                     CMPD  #0
E3B8 2702             (    forth6809.asm):05653                     BEQ   QDUPDONE
E3BA 3606             (    forth6809.asm):05654                     PSHU  D
E3BC 39               (    forth6809.asm):05655         QDUPDONE:   RTS
                      (    forth6809.asm):05656         
                      (    forth6809.asm):05657         ; ------------------------------------------------------------
                      (    forth6809.asm):05658         ; DEPTH  ( -- +n )

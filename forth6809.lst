                      (    forth6809.asm):03363         ; ============================================================
                      (    forth6809.asm):03364         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03365         ; ============================================================
                      (    forth6809.asm):03366                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03367         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03368         
                      (    forth6809.asm):03369         ; ------------------------------------------------------------
                      (    forth6809.asm):03370         ; KEY  ( -- char )
                      (    forth6809.asm):03371         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03372         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03373         ; ------------------------------------------------------------
E54E                  (    forth6809.asm):03374         KEYW:
                      (    forth6809.asm):03375         
E54E 7D0178           (    forth6809.asm):03376                     TST   RTSSTATE          ; Is throttling?
E551 2703             (    forth6809.asm):03377                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03378         
                      (    forth6809.asm):03379                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E553 BDDD52           (    forth6809.asm):03380                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03381                                             ; by transmitting all chars.
                      (    forth6809.asm):03382         
E556                  (    forth6809.asm):03383         TRY_READ:
E556 BDDDBF           (    forth6809.asm):03384                     JSR   GETCHAR           ; Is char available in input buffer.
E559 25F3             (    forth6809.asm):03385                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03386                                             ; while still transmitting!
                      (    forth6809.asm):03387         
E55B 1F89             (    forth6809.asm):03388                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E55D 4F               (    forth6809.asm):03389                     CLRA                    ; Clear MSB.
E55E 3606             (    forth6809.asm):03390                     PSHU  D                 ; char
                      (    forth6809.asm):03391         
E560 39               (    forth6809.asm):03392                     RTS
                      (    forth6809.asm):03393         
                      (    forth6809.asm):03394         ; ------------------------------------------------------------
                      (    forth6809.asm):03395         ; KEY?  ( -- flag )
                      (    forth6809.asm):03396         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03397         ; ------------------------------------------------------------
E561                  (    forth6809.asm):03398         KEYQW:
                      (    forth6809.asm):03399                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03400         
E561 B60176           (    forth6809.asm):03401                     LDA   INHEAD            ; Characters received?
E564 B10177           (    forth6809.asm):03402                     CMPA  INTAIL
                      (    forth6809.asm):03403         
                      (    forth6809.asm):03404                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03405         
E567 2606             (    forth6809.asm):03406                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03407         
E569 CC0000           (    forth6809.asm):03408                     LDD   #FALSEV           ; No! Return false result.
E56C 3606             (    forth6809.asm):03409                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03410         
E56E 39               (    forth6809.asm):03411                     RTS
                      (    forth6809.asm):03412         
E56F                  (    forth6809.asm):03413         KQTRUE:
E56F CCFFFF           (    forth6809.asm):03414                     LDD   #TRUEV            ; Yes! Return true result.
E572 3606             (    forth6809.asm):03415                     PSHU  D                 ; flag = true
E574 39               (    forth6809.asm):03416                     RTS
                      (    forth6809.asm):03417         
                      (    forth6809.asm):03418         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03419         
                      (    forth6809.asm):03420         ; ------------------------------------------------------------
                      (    forth6809.asm):03421         ; EMIT  ( char -- )
                      (    forth6809.asm):03422         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03423         ; discarded if the ring is full.
                      (    forth6809.asm):03424         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03425         EMITW:
E575 3706             (    forth6809.asm):03426                     PULU  D                 ; char
E577 1F98             (    forth6809.asm):03427                     TFR   B,A
E579 BDDD74           (    forth6809.asm):03428                     JSR   PUTCHAR           ; Transmit char.
E57C 39               (    forth6809.asm):03429                     RTS
                      (    forth6809.asm):03430         
                      (    forth6809.asm):03431                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03432         ; ------------------------------------------------------------
                      (    forth6809.asm):03433         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03434         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03435         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03436         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03437         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03438         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03439         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03440         ; follow.
                      (    forth6809.asm):03441         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03442         KEYW:
                      (    forth6809.asm):03443                     LDA   ACIASR
                      (    forth6809.asm):03444                     BITA  #SR_RDRF
                      (    forth6809.asm):03445                     BEQ   KWAIT
                      (    forth6809.asm):03446                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03447                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E57D                  (    forth6809.asm):03448         KWAIT:
E57D                  (    forth6809.asm):03449         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03450                     BITA  #SR_RDRF
                      (    forth6809.asm):03451                     BEQ   KSPIN
E57D                  (    forth6809.asm):03452         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03453                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03454                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03455                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03456                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03457                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03458                     BEQ   KGETCH
                      (    forth6809.asm):03459                     BITA  #SR_FE
                      (    forth6809.asm):03460                     BEQ   KXFE
                      (    forth6809.asm):03461                     INC   FECOUNT
E57D                  (    forth6809.asm):03462         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03463                     BEQ   KXOVRN
                      (    forth6809.asm):03464                     INC   OVRNCOUNT
E57D                  (    forth6809.asm):03465         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03466                     BEQ   KGETCH
                      (    forth6809.asm):03467                     INC   PECOUNT
E57D                  (    forth6809.asm):03468         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03469                     TFR   A,B
                      (    forth6809.asm):03470                     CLRA
                      (    forth6809.asm):03471                     PSHU  D                 ; char
                      (    forth6809.asm):03472                     RTS
                      (    forth6809.asm):03473         
                      (    forth6809.asm):03474         ; ------------------------------------------------------------
                      (    forth6809.asm):03475         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03476         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03477         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03478         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03479         ;    Inputs:
                      (    forth6809.asm):03480         ;        none
                      (    forth6809.asm):03481         ;    Outputs:
                      (    forth6809.asm):03482         ;        XON or XOFF transmitted
                      (    forth6809.asm):03483         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03484         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03485         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03486         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03487                     BRA   PUTXCH
E57D                  (    forth6809.asm):03488         PUTXON:     LDA   #XONCH
E57D                  (    forth6809.asm):03489         PUTXCH:     PSHS  A
E57D                  (    forth6809.asm):03490         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03491                     BITB  #SR_TDRE
                      (    forth6809.asm):03492                     BEQ   PXWT
                      (    forth6809.asm):03493                     PULS  A
                      (    forth6809.asm):03494                     STA   ACIADR
                      (    forth6809.asm):03495                     RTS
                      (    forth6809.asm):03496         
                      (    forth6809.asm):03497         ; ------------------------------------------------------------
                      (    forth6809.asm):03498         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03499         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03500         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03501         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03502                     BITA  #SR_RDRF
                      (    forth6809.asm):03503                     BEQ   KQFALSE
                      (    forth6809.asm):03504                     LDD   #TRUEV
                      (    forth6809.asm):03505                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03506                     RTS
E57D                  (    forth6809.asm):03507         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03508                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03509                     RTS
                      (    forth6809.asm):03510         
                      (    forth6809.asm):03511         ; ------------------------------------------------------------
                      (    forth6809.asm):03512         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03513         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03514         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03515         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03516                     STB   EMITCH
E57D                  (    forth6809.asm):03517         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03518                     BITA  #SR_TDRE
                      (    forth6809.asm):03519                     BEQ   EMITWT
                      (    forth6809.asm):03520                     LDA   EMITCH
                      (    forth6809.asm):03521                     STA   ACIADR
                      (    forth6809.asm):03522                     RTS
                      (    forth6809.asm):03523         
                      (    forth6809.asm):03524                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03525         
                      (    forth6809.asm):03526         ; ------------------------------------------------------------
                      (    forth6809.asm):03527         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03528         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03529         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03530         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03531         ; ------------------------------------------------------------
E57D 3706             (    forth6809.asm):03532         ACCEPTW:    PULU  D                 ; +n1
E57F DD33             (    forth6809.asm):03533                     STD   AMAX
E581 3706             (    forth6809.asm):03534                     PULU  D                 ; c-addr
E583 DD35             (    forth6809.asm):03535                     STD   ABUFP
E585 CC0000           (    forth6809.asm):03536                     LDD   #0
E588 DD37             (    forth6809.asm):03537                     STD   ACNT
                      (    forth6809.asm):03538         
                      (    forth6809.asm):03539                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03540                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03541                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03542                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03543                                             ; stream this line's characters
                      (    forth6809.asm):03544                     JSR   PUTXON
                      (    forth6809.asm):03545                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03546         
E58A BDE54E           (    forth6809.asm):03547         ALOOP:      JSR   KEYW
E58D 3706             (    forth6809.asm):03548                     PULU  D
E58F 1F02             (    forth6809.asm):03549                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03550         
E591 C10D             (    forth6809.asm):03551                     CMPB  #13
E593 274F             (    forth6809.asm):03552                     BEQ   ADONE
E595 C10A             (    forth6809.asm):03553                     CMPB  #10
E597 27F1             (    forth6809.asm):03554                     BEQ   ALOOP
E599 C108             (    forth6809.asm):03555                     CMPB  #8
E59B 2724             (    forth6809.asm):03556                     BEQ   ABKSP
E59D C17F             (    forth6809.asm):03557                     CMPB  #127
E59F 2720             (    forth6809.asm):03558                     BEQ   ABKSP
                      (    forth6809.asm):03559         
E5A1 DC37             (    forth6809.asm):03560                     LDD   ACNT
E5A3 109333           (    forth6809.asm):03561                     CMPD  AMAX
E5A6 27E2             (    forth6809.asm):03562                     BEQ   ALOOP
                      (    forth6809.asm):03563         
E5A8 9E35             (    forth6809.asm):03564                     LDX   ABUFP
E5AA 308B             (    forth6809.asm):03565                     LEAX  D,X
E5AC 1F20             (    forth6809.asm):03566                     TFR   Y,D
E5AE E784             (    forth6809.asm):03567                     STB   ,X
E5B0 DC37             (    forth6809.asm):03568                     LDD   ACNT
E5B2 C30001           (    forth6809.asm):03569                     ADDD  #1
E5B5 DD37             (    forth6809.asm):03570                     STD   ACNT
                      (    forth6809.asm):03571         
E5B7 1F20             (    forth6809.asm):03572                     TFR   Y,D
E5B9 4F               (    forth6809.asm):03573                     CLRA
E5BA 3606             (    forth6809.asm):03574                     PSHU  D
E5BC BDE575           (    forth6809.asm):03575                     JSR   EMITW
E5BF 20C9             (    forth6809.asm):03576                     BRA   ALOOP
                      (    forth6809.asm):03577         
E5C1 DC37             (    forth6809.asm):03578         ABKSP:      LDD   ACNT
E5C3 27C5             (    forth6809.asm):03579                     BEQ   ALOOP
E5C5 830001           (    forth6809.asm):03580                     SUBD  #1
E5C8 DD37             (    forth6809.asm):03581                     STD   ACNT
E5CA CC0008           (    forth6809.asm):03582                     LDD   #8
E5CD 3606             (    forth6809.asm):03583                     PSHU  D
E5CF BDE575           (    forth6809.asm):03584                     JSR   EMITW
E5D2 CC0020           (    forth6809.asm):03585                     LDD   #32
E5D5 3606             (    forth6809.asm):03586                     PSHU  D
E5D7 BDE575           (    forth6809.asm):03587                     JSR   EMITW
E5DA CC0008           (    forth6809.asm):03588                     LDD   #8
E5DD 3606             (    forth6809.asm):03589                     PSHU  D
E5DF BDE575           (    forth6809.asm):03590                     JSR   EMITW
E5E2 20A6             (    forth6809.asm):03591                     BRA   ALOOP
                      (    forth6809.asm):03592         
E5E4                  (    forth6809.asm):03593         ADONE:
                      (    forth6809.asm):03594                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03595                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03596                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03597                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03598                                             ; with KEY never polled at all
                      (    forth6809.asm):03599                     JSR   PUTXOFF
                      (    forth6809.asm):03600                     ENDC                    ; <<<<<<<<<<
E5E4 DC37             (    forth6809.asm):03601                     LDD   ACNT
E5E6 3606             (    forth6809.asm):03602                     PSHU  D                 ; +n2
E5E8 39               (    forth6809.asm):03603                     RTS
                      (    forth6809.asm):03604         
                      (    forth6809.asm):03605         ; ------------------------------------------------------------
                      (    forth6809.asm):03606         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03607         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03608         ; ------------------------------------------------------------
E5E9 BDE57D           (    forth6809.asm):03609         EXPECTW:    JSR   ACCEPTW
E5EC 3706             (    forth6809.asm):03610                     PULU  D
E5EE DDC5             (    forth6809.asm):03611                     STD   SPAN
E5F0 39               (    forth6809.asm):03612                     RTS
                      (    forth6809.asm):03613         
                      (    forth6809.asm):03614         ; ------------------------------------------------------------
                      (    forth6809.asm):03615         ; QUERY  ( -- )
                      (    forth6809.asm):03616         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03617         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03618         ; to 0 and >IN to 0.
                      (    forth6809.asm):03619         ; ------------------------------------------------------------
E5F1 8E0106           (    forth6809.asm):03620         QUERYW:     LDX   #TIBBUF
E5F4 3610             (    forth6809.asm):03621                     PSHU  X
E5F6 CC0050           (    forth6809.asm):03622                     LDD   #TIBBUFL
E5F9 3606             (    forth6809.asm):03623                     PSHU  D
E5FB BDE57D           (    forth6809.asm):03624                     JSR   ACCEPTW
E5FE 3706             (    forth6809.asm):03625                     PULU  D
E600 DD12             (    forth6809.asm):03626                     STD   NTIB
E602 DDC1             (    forth6809.asm):03627                     STD   SRCLEN
E604 CC0106           (    forth6809.asm):03628                     LDD   #TIBBUF
E607 DDBF             (    forth6809.asm):03629                     STD   SRCADDR
E609 CC0000           (    forth6809.asm):03630                     LDD   #0
E60C DDC3             (    forth6809.asm):03631                     STD   SRCID
E60E DD10             (    forth6809.asm):03632                     STD   TOIN
E610 39               (    forth6809.asm):03633                     RTS
                      (    forth6809.asm):03634         
                      (    forth6809.asm):03635         ; ============================================================
                      (    forth6809.asm):03636         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03637         ; ============================================================
                      (    forth6809.asm):03638         ; ------------------------------------------------------------
                      (    forth6809.asm):03639         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03640         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03641         ; one expected.
                      (    forth6809.asm):03642         ; CFERR
                      (    forth6809.asm):03643         ;    Inputs:
                      (    forth6809.asm):03644         ;        none
                      (    forth6809.asm):03645         ;    Outputs:
                      (    forth6809.asm):03646         ;        does not return (THROW -22)
                      (    forth6809.asm):03647         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03648         ; ------------------------------------------------------------
E611 CCFFEA           (    forth6809.asm):03649         CFERR:      LDD   #-22
E614 3606             (    forth6809.asm):03650                     PSHU  D                 ; -22
E616 BDE646           (    forth6809.asm):03651                     JSR   THROWW
E619 39               (    forth6809.asm):03652                     RTS
                      (    forth6809.asm):03653         
                      (    forth6809.asm):03654         ; ------------------------------------------------------------
                      (    forth6809.asm):03655         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03656         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03657         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03658         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03659         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03660         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03661         ; ------------------------------------------------------------
E61A 3710             (    forth6809.asm):03662         CATCHW:     PULU  X                 ; xt
E61C DC0C             (    forth6809.asm):03663                     LDD   HANDLER
E61E 3406             (    forth6809.asm):03664                     PSHS  D
E620 3440             (    forth6809.asm):03665                     PSHS  U
                      (    forth6809.asm):03666                     ; Save the input source specification.
                      (    forth6809.asm):03667                     ; See bugfix: CATCHW.1
E622 DCBF             (    forth6809.asm):03668                     LDD   SRCADDR
E624 3406             (    forth6809.asm):03669                     PSHS  D
E626 DCC1             (    forth6809.asm):03670                     LDD   SRCLEN
E628 3406             (    forth6809.asm):03671                     PSHS  D
E62A DCC3             (    forth6809.asm):03672                     LDD   SRCID
E62C 3406             (    forth6809.asm):03673                     PSHS  D
E62E DC10             (    forth6809.asm):03674                     LDD   TOIN
E630 3406             (    forth6809.asm):03675                     PSHS  D
E632 1F40             (    forth6809.asm):03676                     TFR   S,D
E634 DD0C             (    forth6809.asm):03677                     STD   HANDLER
                      (    forth6809.asm):03678         
E636 AD84             (    forth6809.asm):03679                     JSR   ,X
                      (    forth6809.asm):03680         
E638 3268             (    forth6809.asm):03681                     LEAS  8,S               ; drop saved input source
E63A 3262             (    forth6809.asm):03682                     LEAS  2,S               ; saved U
E63C 3506             (    forth6809.asm):03683                     PULS  D
E63E DD0C             (    forth6809.asm):03684                     STD   HANDLER
E640 CC0000           (    forth6809.asm):03685                     LDD   #0
E643 3606             (    forth6809.asm):03686                     PSHU  D                 ; 0 = no exception
E645 39               (    forth6809.asm):03687                     RTS
                      (    forth6809.asm):03688         
                      (    forth6809.asm):03689         ; ------------------------------------------------------------
                      (    forth6809.asm):03690         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03691         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03692         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03693         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03694         ; ------------------------------------------------------------
E646 3706             (    forth6809.asm):03695         THROWW:     PULU  D                 ; n
E648 10830000         (    forth6809.asm):03696                     CMPD  #0
E64C 2725             (    forth6809.asm):03697                     BEQ   THDONE
                      (    forth6809.asm):03698         
E64E DD0E             (    forth6809.asm):03699                     STD   THROWN
E650 9E0C             (    forth6809.asm):03700                     LDX   HANDLER
E652 2720             (    forth6809.asm):03701                     BEQ   THUNCAU
                      (    forth6809.asm):03702         
E654 1F14             (    forth6809.asm):03703                     TFR   X,S
E656 3506             (    forth6809.asm):03704                     PULS  D                 ; restore input source saved by CATCH
E658 DD10             (    forth6809.asm):03705                     STD   TOIN
E65A 3506             (    forth6809.asm):03706                     PULS  D
E65C DDC3             (    forth6809.asm):03707                     STD   SRCID
E65E 3506             (    forth6809.asm):03708                     PULS  D
E660 DDC1             (    forth6809.asm):03709                     STD   SRCLEN
E662 3506             (    forth6809.asm):03710                     PULS  D
E664 DDBF             (    forth6809.asm):03711                     STD   SRCADDR
E666 3506             (    forth6809.asm):03712                     PULS  D
E668 1F03             (    forth6809.asm):03713                     TFR   D,U
E66A 3506             (    forth6809.asm):03714                     PULS  D
E66C DD0C             (    forth6809.asm):03715                     STD   HANDLER
                      (    forth6809.asm):03716         
E66E DC0E             (    forth6809.asm):03717                     LDD   THROWN
E670 3606             (    forth6809.asm):03718                     PSHU  D
E672 39               (    forth6809.asm):03719                     RTS
E673 39               (    forth6809.asm):03720         THDONE:     RTS
                      (    forth6809.asm):03721         
                      (    forth6809.asm):03722                     ; No CATCH is active: leave n on the stack and ABORT.
E674 DC0E             (    forth6809.asm):03723         THUNCAU:    LDD   THROWN
E676 3606             (    forth6809.asm):03724                     PSHU  D
E678 7EDEC3           (    forth6809.asm):03725                     JMP   ABORT
                      (    forth6809.asm):03726         
                      (    forth6809.asm):03727         ; ============================================================
                      (    forth6809.asm):03728         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03729         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03730         ; ============================================================
                      (    forth6809.asm):03731         ; ------------------------------------------------------------
                      (    forth6809.asm):03732         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03733         ; location.
                      (    forth6809.asm):03734         ; PATCH   ( target location -- )
                      (    forth6809.asm):03735         ;    Inputs:
                      (    forth6809.asm):03736         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03737         ;    Outputs:
                      (    forth6809.asm):03738         ;        the cell at location holds target - location
                      (    forth6809.asm):03739         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03740         ; ------------------------------------------------------------
E67B 3710             (    forth6809.asm):03741         PATCH:      PULU  X                 ; location
E67D 3706             (    forth6809.asm):03742                     PULU  D                 ; target
E67F 3410             (    forth6809.asm):03743                     PSHS  X
E681 A3E1             (    forth6809.asm):03744                     SUBD  ,S++              ; target - location
E683 ED84             (    forth6809.asm):03745                     STD   ,X
E685 39               (    forth6809.asm):03746                     RTS
                      (    forth6809.asm):03747         
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
                      (    forth6809.asm):03749         ; IF  ( C: -- orig )
                      (    forth6809.asm):03750         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03751         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03752         ; ------------------------------------------------------------
E686 CCDF70           (    forth6809.asm):03753         IFW:        LDD   #ZBRANCH
E689 3606             (    forth6809.asm):03754                     PSHU  D
E68B BDEABB           (    forth6809.asm):03755                     JSR   CCALL
E68E CC0000           (    forth6809.asm):03756                     LDD   #0
E691 3606             (    forth6809.asm):03757                     PSHU  D
E693 BDE002           (    forth6809.asm):03758                     JSR   CODECOMMA
E696 DC08             (    forth6809.asm):03759                     LDD   CODEHERE
E698 830002           (    forth6809.asm):03760                     SUBD  #2
E69B 3606             (    forth6809.asm):03761                     PSHU  D                 ; orig
E69D CC0001           (    forth6809.asm):03762                     LDD   #TAGFWD
E6A0 3606             (    forth6809.asm):03763                     PSHU  D
E6A2 39               (    forth6809.asm):03764                     RTS
                      (    forth6809.asm):03765         
                      (    forth6809.asm):03766         ; ------------------------------------------------------------
                      (    forth6809.asm):03767         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03768         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03769         ; operand to jump to the current code address.
                      (    forth6809.asm):03770         ; ------------------------------------------------------------
E6A3 3706             (    forth6809.asm):03771         THENW:      PULU  D
E6A5 10830001         (    forth6809.asm):03772                     CMPD  #TAGFWD
E6A9 2703             (    forth6809.asm):03773                     BEQ   THOK
E6AB BDE611           (    forth6809.asm):03774                     JSR   CFERR
E6AE 3710             (    forth6809.asm):03775         THOK:       PULU  X                 ; orig
E6B0 DC08             (    forth6809.asm):03776                     LDD   CODEHERE
E6B2 3606             (    forth6809.asm):03777                     PSHU  D
E6B4 3610             (    forth6809.asm):03778                     PSHU  X
E6B6 BDE67B           (    forth6809.asm):03779                     JSR   PATCH
E6B9 39               (    forth6809.asm):03780                     RTS
                      (    forth6809.asm):03781         
                      (    forth6809.asm):03782         ; ------------------------------------------------------------
                      (    forth6809.asm):03783         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03784         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03785         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03786         ; ------------------------------------------------------------
E6BA 3706             (    forth6809.asm):03787         ELSEW:      PULU  D
E6BC 10830001         (    forth6809.asm):03788                     CMPD  #TAGFWD
E6C0 2703             (    forth6809.asm):03789                     BEQ   ELOK
E6C2 BDE611           (    forth6809.asm):03790                     JSR   CFERR
E6C5 3706             (    forth6809.asm):03791         ELOK:       PULU  D                 ; orig1
E6C7 DD29             (    forth6809.asm):03792                     STD   MSCR              ; See bugfix: ELSEW.1
E6C9 CCDF86           (    forth6809.asm):03793                     LDD   #BRANCH
E6CC 3606             (    forth6809.asm):03794                     PSHU  D
E6CE BDEABB           (    forth6809.asm):03795                     JSR   CCALL
E6D1 CC0000           (    forth6809.asm):03796                     LDD   #0
E6D4 3606             (    forth6809.asm):03797                     PSHU  D
E6D6 BDE002           (    forth6809.asm):03798                     JSR   CODECOMMA
E6D9 DC08             (    forth6809.asm):03799                     LDD   CODEHERE

                      (    forth6809.asm):08582         
                      (    forth6809.asm):08583         ; ------------------------------------------------------------
                      (    forth6809.asm):08584         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08585         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08586         ; low byte of BASE is used.
                      (    forth6809.asm):08587         ; UDDIGIT
                      (    forth6809.asm):08588         ;    Inputs:
                      (    forth6809.asm):08589         ;        ud on the data stack
                      (    forth6809.asm):08590         ;    Outputs:
                      (    forth6809.asm):08591         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):08592         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):08593         ; ------------------------------------------------------------
EEED 4F               (    forth6809.asm):08594         UDDIGIT:    CLRA                    ; A = remainder
EEEE C620             (    forth6809.asm):08595                     LDB   #32
EEF0 6843             (    forth6809.asm):08596         UDDLOOP:    ASL   3,U
EEF2 6942             (    forth6809.asm):08597                     ROL   2,U
EEF4 6941             (    forth6809.asm):08598                     ROL   1,U

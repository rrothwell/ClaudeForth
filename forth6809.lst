                      (    forth6809.asm):02168         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02169         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02170         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02171         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02172         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02173         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02174         ; one copy pushed).
                      (    forth6809.asm):02175         ; ------------------------------------------------------------
C18F                  (    forth6809.asm):02176         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):02177         

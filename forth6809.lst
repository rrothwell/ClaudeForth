E795 BDDFFA           (    forth6809.asm):03842                     JSR   CODECOMMA
E798 EC60             (    forth6809.asm):03843                     LDD   0,S               ; target = BEGIN's address
E79A 3606             (    forth6809.asm):03844                     PSHU  D
E79C DC08             (    forth6809.asm):03845                     LDD   CODEHERE
E79E 830002           (    forth6809.asm):03846                     SUBD  #2                ; location = the operand just compiled
E7A1 3606             (    forth6809.asm):03847                     PSHU  D

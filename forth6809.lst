                      (    forth6809.asm):00001         ; ============================================================
                      (    forth6809.asm):00002         ; 6809 ANS FORTH - subroutine threaded
                      (    forth6809.asm):00003         ;
                      (    forth6809.asm):00004         ; Layout of this file: memory map and constants, GLOBALS (page zero),
                      (    forth6809.asm):00005         ; serial buffers, SECTION 27 (dictionary headers), SECTIONS 3-26 (code),
                      (    forth6809.asm):00006         ; SECTION 2 (init code), SECTION 1 (vectors).
                      (    forth6809.asm):00007         ;
                      (    forth6809.asm):00008         ; Build options (lwasm -D): SERIALPOLL (1 = polled ACIA, 0 = interrupt
                      (    forth6809.asm):00009         ; driven), UNITTESTS (1 = include unit_tests.asm), TSTSELECTOR.
                      (    forth6809.asm):00010         ;
                      (    forth6809.asm):00011         ; Long explanatory and bug-fix comments are kept in the shadow file
                      (    forth6809.asm):00012         ; forth6809.shd, and are referred to here by their NAME.n codes.
                      (    forth6809.asm):00013         ; The original header comment is shadow HEADER.0.
                      (    forth6809.asm):00014         ; ============================================================
                      (    forth6809.asm):00015         
                      (    forth6809.asm):00016         ; ------------------------------------------------------------
                      (    forth6809.asm):00017         ; MEMORY MAP
                      (    forth6809.asm):00018         ; ------------------------------------------------------------
     C000             (    forth6809.asm):00019         ROMSTRT     EQU   $C000             ; physical start of the 16K EPROM
     C100             (    forth6809.asm):00020         USROMSTRT   EQU   $C100             ; usable ROM start (above INOUT)
     FFEF             (    forth6809.asm):00021         USROMEND    EQU   VECTORS-1         ; usable ROM end (VECTORS-1)
     FFF0             (    forth6809.asm):00022         VECTORS     EQU   $FFF0
     FF9C             (    forth6809.asm):00023         INITCODE    EQU   $FF9C             ; start of the init code (COLDSTRT). See shadow MEMMAP.22
                      (    forth6809.asm):00024                     ; Commented-out code moved to shadow: MEMMAP.5
                      (    forth6809.asm):00025                     IFNDEF DISASM
                      (    forth6809.asm):00026                     IFDEF UNITTESTS
                      (    forth6809.asm):00027                     IFNE  UNITTESTS
0000                  (    forth6809.asm):00028         DISASM      SET   0                 ; the unit tests need the room
                      (    forth6809.asm):00029                     ELSE
     0001             (    forth6809.asm):00030         DISASM      SET   1
                      (    forth6809.asm):00031                     ENDC
                      (    forth6809.asm):00032                     ELSE
0000                  (    forth6809.asm):00033         DISASM      SET   1                 ; default if -D not passed
                      (    forth6809.asm):00034                     ENDC
                      (    forth6809.asm):00035                     ENDC
                      (    forth6809.asm):00036                     IFNDEF DECOMP
     0001             (    forth6809.asm):00037         DECOMP      SET   DISASM            ; default: with the disassembler
                      (    forth6809.asm):00038                     ENDC
                      (    forth6809.asm):00039                     IFNE  DECOMP
                      (    forth6809.asm):00040                     IFEQ  DISASM
                      (    forth6809.asm):00041                     ERROR "DECOMP=1 needs DISASM=1"
                      (    forth6809.asm):00042                     ENDC
                      (    forth6809.asm):00043                     ENDC
                      (    forth6809.asm):00044                     IFNE  DISASM
                      (    forth6809.asm):00045                     IFNE  DECOMP
     CE00             (    forth6809.asm):00046         BASECODE    EQU   $CE00             ; base code (DISASM and DECOMP). See shadow MEMMAP.6
     C40A             (    forth6809.asm):00047         BASEDICT    EQU   $C40A             ; base dictionary (DISASM and DECOMP). See shadow MEMMAP.8
                      (    forth6809.asm):00048                     ELSE
0000                  (    forth6809.asm):00049         BASECODE    EQU   $D180             ; base code (with DISASM). See shadow MEMMAP.6
                      (    forth6809.asm):00050                     ; Commented-out code moved to shadow: MEMMAP.7
0000                  (    forth6809.asm):00051         BASEDICT    EQU   $C792             ; base dictionary (with DISASM). See shadow MEMMAP.8
                      (    forth6809.asm):00052                     ENDC
                      (    forth6809.asm):00053                     ELSE
0000                  (    forth6809.asm):00054         BASECODE    EQU   $D876             ; base code (without DISASM)
0000                  (    forth6809.asm):00055         BASEDICT    EQU   $CE99             ; base dictionary (without DISASM)
                      (    forth6809.asm):00056                     ENDC
     C000             (    forth6809.asm):00057         INOUT       EQU   $C000             ; I/O block (ACIA), 256 bytes
     C0FF             (    forth6809.asm):00058         INOUTEND    EQU   INOUT+$FF
     BFFF             (    forth6809.asm):00059         RSTACK      EQU   $BFFF             ; return stack top
     BCFF             (    forth6809.asm):00060         DSTACK      EQU   $BCFF             ; data stack top
     B900             (    forth6809.asm):00061         CODETOP     EQU   $B900             ; code space ceiling
                      (    forth6809.asm):00062         
                      (    forth6809.asm):00063         ; ANS transient-region sizes (ANS 3.3.3.6):
                      (    forth6809.asm):00064         ;   PADMINSIZE  - size of PAD's scratch region, in characters.
                      (    forth6809.asm):00065         ;   WORDMINSIZE - minimum size for WORD's region (33).
                      (    forth6809.asm):00066         ;   HOLDMINSIZE - pictured numeric output buffer, (2 * 16) + 2 = 34;
                      (    forth6809.asm):00067         ;                 it grows downward from PAD into the CODEHERE-to-PAD
                      (    forth6809.asm):00068         ;                 gap.
                      (    forth6809.asm):00069         ; PADOFFSET (the CODEHERE-to-PAD gap) equals PADMINSIZE. Original
                      (    forth6809.asm):00070         ; comment: shadow PADSIZE.0.
     0080             (    forth6809.asm):00071         PADMINSIZE  EQU   128
     0021             (    forth6809.asm):00072         WORDMINSIZE EQU   33
     0022             (    forth6809.asm):00073         HOLDMINSIZE EQU   34
     0080             (    forth6809.asm):00074         PADOFFSET   EQU   PADMINSIZE        ; CODEHERE-to-PAD gap
     005A             (    forth6809.asm):00075         WORDMAXCHARS EQU   PADOFFSET-HOLDMINSIZE-1-3
                      (    forth6809.asm):00076                     ; Maximum characters WORD can scan in the CODEHERE-to-PAD gap:
                      (    forth6809.asm):00077                     ; PADOFFSET - HOLDMINSIZE - 1 (count byte) - 3. The 3 bytes were
                      (    forth6809.asm):00078                     ; once reserved by S", ." and ABORT" (they now use PARSE, stage
                      (    forth6809.asm):00079                     ; 5i). See shadow WORDMAXCHARS.2. Original comment: shadow
                      (    forth6809.asm):00080                     ; WORDMAXCHARS.1.
                      (    forth6809.asm):00081         
     7000             (    forth6809.asm):00082         APPCODE     EQU   $7000             ; application code area
     2000             (    forth6809.asm):00083         APPDICT     EQU   $2000             ; application dictionary
     0200             (    forth6809.asm):00084         SUBPOOL     EQU   $0200             ; REPLACES substitution table. See shadow
     0040             (    forth6809.asm):00085         SUBPOOLSZ   EQU   64                ; REPLACES.1; $0200-$023F
     0240             (    forth6809.asm):00086         APPVARS     EQU   SUBPOOL+SUBPOOLSZ ; application variables ($0240)
     1FFF             (    forth6809.asm):00087         APPVARSEND  EQU   APPDICT-1         ; end of application variables
                      (    forth6809.asm):00088         ; $01DD-$01FF were formerly WORDBUF and SIBUF; $0200 now starts SUBPOOL.
                      (    forth6809.asm):00089         ; Original comment: shadow MEMMAP.17.
                      (    forth6809.asm):00090         
                      (    forth6809.asm):00091         ; Commented-out code moved to shadow: MEMMAP.18
     0106             (    forth6809.asm):00092         TIBBUF      EQU   $0106             ; terminal input buffer
     0050             (    forth6809.asm):00093         TIBBUFL     EQU   80                ; length of TIBBUF
                      (    forth6809.asm):00094         
     0000             (    forth6809.asm):00095         GLOBALS     EQU   $0000
                      (    forth6809.asm):00096         
     BD00             (    forth6809.asm):00097         SP0         EQU   DSTACK+1
     C000             (    forth6809.asm):00098         RP0         EQU   RSTACK+1
                      (    forth6809.asm):00099         
                      (    forth6809.asm):00100         ; ------------------------------------------------------------
                      (    forth6809.asm):00101         ; SERIALPOLL - conditional-assembly switch for serial I/O.
                      (    forth6809.asm):00102         ; 1 (default): KEY/KEYQ/EMIT poll ACIASR directly, no interrupts,
                      (    forth6809.asm):00103         ; no ring buffers, no RTS/CTS handshaking - IRQH is a harmless RTI
                      (    forth6809.asm):00104         ; stub, matching the other unused vectors (NMIH/FIRQH/SWI2H/
                      (    forth6809.asm):00105         ; SWI3H). 0: the original interrupt-driven implementation, with
                      (    forth6809.asm):00106         ; INBUF/OUTBUF ring buffers serviced by IRQH and RTS-based flow
                      (    forth6809.asm):00107         ; control via INFILL/RTSCHECKHI/RTSCHECKLO. Uses LWASM's IFEQ/
                      (    forth6809.asm):00108         ; ELSE/ENDC (a numeric-expression test, not IFDEF/IFNDEF, since
                      (    forth6809.asm):00109         ; this is a value to compare, not a symbol's mere presence).
                      (    forth6809.asm):00110         ;
                      (    forth6809.asm):00111         ; SERIALPOLL can be chosen at build time with lwasm -DSERIALPOLL=0 or
                      (    forth6809.asm):00112         ; -DSERIALPOLL=1 (the default). Original comment: shadow SERIALPOLL.1.
                      (    forth6809.asm):00113         ; ------------------------------------------------------------
                      (    forth6809.asm):00114                     IFNDEF SERIALPOLL
0000                  (    forth6809.asm):00115         SERIALPOLL  SET   1                 ; default if -D not passed
                      (    forth6809.asm):00116                     ENDC
                      (    forth6809.asm):00117         
                      (    forth6809.asm):00118         ; ------------------------------------------------------------
                      (    forth6809.asm):00119         ; ACIA (6850) constants - the chip sits at INOUT+8, not at the
                      (    forth6809.asm):00120         ; base of the I/O block, leaving INOUT+0..INOUT+7 free for other
                      (    forth6809.asm):00121         ; memory-mapped devices sharing this 256-byte region
                      (    forth6809.asm):00122         ; ------------------------------------------------------------
     C008             (    forth6809.asm):00123         ACIA        EQU   INOUT+8
     C008             (    forth6809.asm):00124         ACIACR      EQU   ACIA
     C008             (    forth6809.asm):00125         ACIASR      EQU   ACIA
     C009             (    forth6809.asm):00126         ACIADR      EQU   ACIA+1
                      (    forth6809.asm):00127         
                      (    forth6809.asm):00128         ; ACIA Status Register Bits
                      (    forth6809.asm):00129         
     0080             (    forth6809.asm):00130         SR_IRQ      EQU   %10000000         ; ($80) (Interrupt Request)
     0001             (    forth6809.asm):00131         SR_RDRF     EQU   %00000001         ; ($01) (Receive Data Register Full)
     0002             (    forth6809.asm):00132         SR_TDRE     EQU   %00000010         ; ($02) (Transmit Data Register Empty)
     0008             (    forth6809.asm):00133         SR_CTS      EQU   %00001000         ; ($08) CTS blocks transmit
                      (    forth6809.asm):00134         
                      (    forth6809.asm):00135         ; Errors only meaningful together with RDRF
     0010             (    forth6809.asm):00136         SR_FE       EQU   %00010000         ; ($10) (Framing Error)
     0020             (    forth6809.asm):00137         SR_OVRN     EQU   %00100000         ; ($20) (Overrun Error)
     0040             (    forth6809.asm):00138         SR_PE       EQU   %01000000         ; ($40) (Parity Error)
                      (    forth6809.asm):00139         
                      (    forth6809.asm):00140         ; ACIA Control Register Bits
                      (    forth6809.asm):00141         
     0003             (    forth6809.asm):00142         CR_RESET    EQU   %00000011         ; ($03) (Master Reset mode)
     0095             (    forth6809.asm):00143         CR_BASE     EQU   %10010101         ; ($95) (Rx Int Enabled, 8-N-1, /16 Clock)
     0095             (    forth6809.asm):00144         CR_RXON     EQU   %10010101         ; ($95) (Rx Int Enabled, 8-N-1, /16 Clock)
     00B5             (    forth6809.asm):00145         CR_RXTX     EQU   %10110101         ; ($B5) Rx Int, Tx Int/RTS, 8-N-1
     0015             (    forth6809.asm):00146         CR_POLL     EQU   %00010101         ; ($15) Polling, no ints, 8-N-1
     00D5             (    forth6809.asm):00147         CR_RTSHI    EQU   %11010101         ; ($D5) RTS high, Tx int off, 8-N-1
                      (    forth6809.asm):00148         
                      (    forth6809.asm):00149         ; CR_POLL
                      (    forth6809.asm):00150         
                      (    forth6809.asm):00151         ; bit7=0 (RX interrupt disabled), bits6-5=00 (RTS
                      (    forth6809.asm):00152         ; low, TX interrupt disabled) - CR_RXON ($95) with
                      (    forth6809.asm):00153         ; only the RX-interrupt-enable bit cleared. Used
                      (    forth6809.asm):00154         ; only when SERIALPOLL=1; RTS stays permanently
                      (    forth6809.asm):00155         ; low (asserted), since polling mode has no ring
                      (    forth6809.asm):00156         ; buffer to overflow and so needs no flow control
                      (    forth6809.asm):00157         
                      (    forth6809.asm):00158         ; CR_RTSHI
                      (    forth6809.asm):00159         
                      (    forth6809.asm):00160         ; bits6-5=10: RTS high, TX int disabled, RX int enabled -
                      (    forth6809.asm):00161         ; derived from CR_RXON ($95) with bits6-5 changed from
                      (    forth6809.asm):00162         ; 00 to 10; the ACIA has no combination offering RTS
                      (    forth6809.asm):00163         ; high AND TX interrupt enabled simultaneously (bits6-5
                      (    forth6809.asm):00164         ; only has 00/01/10/11, and only 01 enables TX interrupt,
                      (    forth6809.asm):00165         ; which always ties RTS low) - EMIT/IRQH's OUTCHAR must
                      (    forth6809.asm):00166         ; respect this and defer transmission while RTS is high
                      (    forth6809.asm):00167         
                      (    forth6809.asm):00168         ; Ring buffer control
     0176             (    forth6809.asm):00169         SERBUFCTL   EQU   $0176
     0180             (    forth6809.asm):00170         SERBUF      EQU   $0180             ; ring buffer start, 64-byte aligned
     0040             (    forth6809.asm):00171         INBUFSZ     EQU   64
     0040             (    forth6809.asm):00172         OUTBUFSZ    EQU   64
     0030             (    forth6809.asm):00173         INHIWATER   EQU   48                ; input ring level: RTS high
     0010             (    forth6809.asm):00174         INLOWATER   EQU   16                ; input ring level: RTS low
                      (    forth6809.asm):00175         
                      (    forth6809.asm):00176         ; Input control
                      (    forth6809.asm):00177         ; /RTS flag states
     0000             (    forth6809.asm):00178         INACCEPT    EQU   $00
     00FF             (    forth6809.asm):00179         INREJECT    EQU   $FF
                      (    forth6809.asm):00180         
                      (    forth6809.asm):00181         ; Output control
                      (    forth6809.asm):00182         ; Transmit buffer interrupt active flag states.
     0000             (    forth6809.asm):00183         OUTIDLE     EQU   $00
     00FF             (    forth6809.asm):00184         OUTBUSY     EQU   $FF
                      (    forth6809.asm):00185         
                      (    forth6809.asm):00186         ; Software (in-band) flow control - polling build only. The
                      (    forth6809.asm):00187         ; interrupt-driven build has real RTS/CTS hardware flow control
                      (    forth6809.asm):00188         ; already (CHKHI/CHKLO/UPDATE_RTS); polling mode has no ring
                      (    forth6809.asm):00189         ; buffer and no hardware handshaking at all, so it needs its own
                      (    forth6809.asm):00190         ; substitute - see ACCEPT and PUTXON/PUTXOFF.
     0011             (    forth6809.asm):00191         XONCH       EQU   $11
     0013             (    forth6809.asm):00192         XOFFCH      EQU   $13
                      (    forth6809.asm):00193         
                      (    forth6809.asm):00194         ; ------------------------------------------------------------
                      (    forth6809.asm):00195         ; Flag / opcode constants
                      (    forth6809.asm):00196         ; ------------------------------------------------------------
     FFFF             (    forth6809.asm):00197         TRUEV       EQU   $FFFF
     0000             (    forth6809.asm):00198         FALSEV      EQU   $0000
     00BD             (    forth6809.asm):00199         OPJSR       EQU   $BD
     0039             (    forth6809.asm):00200         OPRTS       EQU   $39               ; used by section 3.8's control-flow test
                      (    forth6809.asm):00201                                             ; harness to terminate each compiled test
                      (    forth6809.asm):00202                                             ; snippet, compiled via CCOMMA
     0039             (    forth6809.asm):00203         RTSOPC      EQU   $39
                      (    forth6809.asm):00204         
                      (    forth6809.asm):00205         ; ------------------------------------------------------------
                      (    forth6809.asm):00206         ; Control-flow compile-time tags
                      (    forth6809.asm):00207         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00208         TAGFWD      EQU   1
     0002             (    forth6809.asm):00209         TAGBACK     EQU   2
     0003             (    forth6809.asm):00210         TAGDO       EQU   3
     0004             (    forth6809.asm):00211         TAGCASE     EQU   4
     0005             (    forth6809.asm):00212         TAGOF       EQU   5
     0006             (    forth6809.asm):00213         TAGENDOF    EQU   6
     0007             (    forth6809.asm):00214         TAGQDO      EQU   7                 ; ?DO marker. See bugfix: TAGQDO.1
                      (    forth6809.asm):00215         
                      (    forth6809.asm):00216         ; ============================================================
                      (    forth6809.asm):00217         ; GLOBALS - scratch and state cells in page zero (DP = $00, set in
                      (    forth6809.asm):00218         ; COLDSTRT), laid out in RMB order. 131 of 256 bytes are used
                      (    forth6809.asm):00219         ; (GLOBALS_USED). Original comment: shadow GLOBALS.0.
                      (    forth6809.asm):00220         ; ============================================================
                      (    forth6809.asm):00221                     ORG   $0000             ; GLOBALS page (DP = $00)
0000                  (    forth6809.asm):00222         STATE       RMB   2                 ; offset $00
0002                  (    forth6809.asm):00223         BASE        RMB   2                 ; offset $02
0004                  (    forth6809.asm):00224         LATEST      RMB   2                 ; offset $04
0006                  (    forth6809.asm):00225         DPHERE      RMB   2                 ; offset $06
0008                  (    forth6809.asm):00226         CODEHERE    RMB   2                 ; offset $08
000A                  (    forth6809.asm):00227         VARHERE     RMB   2                 ; offset $0A
000C                  (    forth6809.asm):00228         HANDLER     RMB   2                 ; offset $0C
000E                  (    forth6809.asm):00229         THROWN      RMB   2                 ; offset $0E
0010                  (    forth6809.asm):00230         TOIN        RMB   2                 ; offset $10
0012                  (    forth6809.asm):00231         NTIB        RMB   2                 ; offset $12
0014                  (    forth6809.asm):00232         MSCR        RMB   2                 ; offset $14 (shared: -, *, WITHIN...)
0016                  (    forth6809.asm):00233         MSCR2       RMB   2                 ; offset $16
0018                  (    forth6809.asm):00234         MSCR3       RMB   2                 ; offset $18
001A                  (    forth6809.asm):00235         MSCR4       RMB   2                 ; offset $1A
001C                  (    forth6809.asm):00236         HLD         RMB   2                 ; offset $1C
001E                  (    forth6809.asm):00237         EMITCH      RMB   1                 ; offset $1E
                      (    forth6809.asm):00238         ; CURXT holds the xt of the word being compiled, for RECURSE.
                      (    forth6809.asm):00239         ; Original comment: shadow CURXT.1.
001F                  (    forth6809.asm):00240         CURXT       RMB   2                 ; offset $1F
0021                  (    forth6809.asm):00241         CSP         RMB   2                 ; offset $21
0023                  (    forth6809.asm):00242         PRODHI      RMB   2                 ; offset $23
0025                  (    forth6809.asm):00243         PRODLO      RMB   2                 ; offset $25
0027                  (    forth6809.asm):00244         PSIGN       RMB   1                 ; offset $27
0028                  (    forth6809.asm):00245         DIVNUM      RMB   2                 ; offset $28
002A                  (    forth6809.asm):00246         DIVDEN      RMB   2                 ; offset $2A
002C                  (    forth6809.asm):00247         DIVREM      RMB   2                 ; offset $2C
002E                  (    forth6809.asm):00248         DIVCNT      RMB   1                 ; offset $2E
002F                  (    forth6809.asm):00249         DNSIGN      RMB   1                 ; offset $2F
0030                  (    forth6809.asm):00250         DVSIGN      RMB   1                 ; offset $30
0031                  (    forth6809.asm):00251         DVOWNSIGN   RMB   1                 ; offset $31
0032                  (    forth6809.asm):00252         MAHI        RMB   1                 ; offset $32
0033                  (    forth6809.asm):00253         MALO        RMB   1                 ; offset $33
0034                  (    forth6809.asm):00254         MBHI        RMB   1                 ; offset $34
0035                  (    forth6809.asm):00255         MBLO        RMB   1                 ; offset $35
0036                  (    forth6809.asm):00256         MSIGN       RMB   1                 ; offset $36
0037                  (    forth6809.asm):00257         PRSIGN      RMB   1                 ; offset $37
0038                  (    forth6809.asm):00258         SHCNT       RMB   1                 ; offset $38
0039                  (    forth6809.asm):00259         SRCADDR     RMB   2                 ; offset $39
003B                  (    forth6809.asm):00260         SRCLEN      RMB   2                 ; offset $3B
003D                  (    forth6809.asm):00261         SRCID       RMB   2                 ; offset $3D
003F                  (    forth6809.asm):00262         SPAN        RMB   2                 ; offset $3F
                      (    forth6809.asm):00263         
0041                  (    forth6809.asm):00264         SUBHEAD     RMB   2                 ; offset $41: newest REPLACES entry, 0 = none
0043                  (    forth6809.asm):00265         SUBFREE     RMB   2                 ; offset $43: next free byte of SUBPOOL, 0 = empty
                      (    forth6809.asm):00266         
                      (    forth6809.asm):00267         ; Search-Order word set. A WID is the address of a cell in WLHEADS that
                      (    forth6809.asm):00268         ; holds the newest header of that wordlist (0 = empty). WLEND is the
                      (    forth6809.asm):00269         ; address just past the last WLHEADS cell in use. ORDER holds the
                      (    forth6809.asm):00270         ; WIDs of the search order, first searched at the lowest address, and
                      (    forth6809.asm):00271         ; ORDEND is the address just past the last one in use. The second
                      (    forth6809.asm):00272         ; wordlist is ROOT, which is also always searched, last. WLEND, CURRENT, ORDEND and
                      (    forth6809.asm):00273         ; ORDER are adjacent because MARKER saves and restores them together
                      (    forth6809.asm):00274         ; (SRCHSAVE, SRCHSAVESZ). See shadow WLHEADS.1
0045                  (    forth6809.asm):00275         SRCHSAVE
0045                  (    forth6809.asm):00276         WLEND       RMB   2                 ; offset $45
0047                  (    forth6809.asm):00277         CURRENT     RMB   2                 ; offset $47: WID that receives new words
0049                  (    forth6809.asm):00278         ORDEND      RMB   2                 ; offset $49
004B                  (    forth6809.asm):00279         ORDER       RMB   16                ; offset $4B-$5A: up to 8 WIDs
     0016             (    forth6809.asm):00280         SRCHSAVESZ  EQU   *-SRCHSAVE
005B                  (    forth6809.asm):00281         WLHEADS     RMB   20                ; offset $5B-$6E: FORTH, ROOT, 8 more
006F                  (    forth6809.asm):00282         WLNAMES     RMB   20                ; offset $6F-$82: for each wordlist the header
                      (    forth6809.asm):00283                                             ; of the word that names it (0 = none)
     0014             (    forth6809.asm):00284         WLNOFF      EQU   WLNAMES-WLHEADS   ; from a WID to its WLNAMES cell
     000A             (    forth6809.asm):00285         WLCELLS     EQU   10                ; wordlists, including FORTH and ROOT
     0008             (    forth6809.asm):00286         WLMAX       EQU   8                 ; WIDs in the search order
                      (    forth6809.asm):00287         
0083                  (    forth6809.asm):00288         IRQCHAIN    RMB   2                 ; head of the chain of extra interrupt
                      (    forth6809.asm):00289                                             ; handlers: IRQH jumps through it when the
                      (    forth6809.asm):00290                                             ; ACIA is not the source
0085                  (    forth6809.asm):00291         EMITV       RMB   2                 ; vector used by EMIT (xt of the routine)
0087                  (    forth6809.asm):00292         KEYV        RMB   2                 ; vector used by KEY
0089                  (    forth6809.asm):00293         KEYQV       RMB   2                 ; vector used by KEY?
                      (    forth6809.asm):00294         
                      (    forth6809.asm):00295                     IFNE  DISASM
008B                  (    forth6809.asm):00296         DISSTART    RMB   2                 ; start of the instruction being decoded
008D                  (    forth6809.asm):00297         DISPC       RMB   2                 ; next byte to fetch
008F                  (    forth6809.asm):00298         DISTMP      RMB   2                 ; scratch
0091                  (    forth6809.asm):00299         DISTMP2     RMB   2                 ; scratch
0093                  (    forth6809.asm):00300         DISEND      RMB   2                 ; DIS: end address
0095                  (    forth6809.asm):00301         DISNXT      RMB   2                 ; DIS: address after this instruction

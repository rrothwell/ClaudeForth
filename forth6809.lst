E6E6 3606             (    forth6809.asm):03805                     PSHU  D
E6E8 BDE67B           (    forth6809.asm):03806                     JSR   PATCH
E6EB DC41             (    forth6809.asm):03807                     LDD   NEWFLD
E6ED 3606             (    forth6809.asm):03808                     PSHU  D                 ; orig2
E6EF CC0001           (    forth6809.asm):03809                     LDD   #TAGFWD
E6F2 3606             (    forth6809.asm):03810                     PSHU  D
E6F4 39               (    forth6809.asm):03811                     RTS
                      (    forth6809.asm):03812         
                      (    forth6809.asm):03813         ; ------------------------------------------------------------
                      (    forth6809.asm):03814         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03815         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03816         ; stack.
                      (    forth6809.asm):03817         ; ------------------------------------------------------------
E6F5 DC08             (    forth6809.asm):03818         BEGINW:     LDD   CODEHERE
E6F7 3606             (    forth6809.asm):03819                     PSHU  D                 ; dest
E6F9 CC0002           (    forth6809.asm):03820                     LDD   #TAGBACK
E6FC 3606             (    forth6809.asm):03821                     PSHU  D
E6FE 39               (    forth6809.asm):03822                     RTS
                      (    forth6809.asm):03823         
                      (    forth6809.asm):03824         ; ------------------------------------------------------------
                      (    forth6809.asm):03825         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03826         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03827         ; ------------------------------------------------------------
E6FF 3706             (    forth6809.asm):03828         UNTILW:     PULU  D
E701 10830002         (    forth6809.asm):03829                     CMPD  #TAGBACK
E705 2703             (    forth6809.asm):03830                     BEQ   UNOK
E707 BDE611           (    forth6809.asm):03831                     JSR   CFERR
E70A 3706             (    forth6809.asm):03832         UNOK:       PULU  D                 ; dest
E70C 3606             (    forth6809.asm):03833                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E70E CCDF70           (    forth6809.asm):03834                     LDD   #ZBRANCH
E711 3606             (    forth6809.asm):03835                     PSHU  D
E713 BDEABB           (    forth6809.asm):03836                     JSR   CCALL
E716 CC0000           (    forth6809.asm):03837                     LDD   #0
E719 3606             (    forth6809.asm):03838                     PSHU  D
E71B BDE002           (    forth6809.asm):03839                     JSR   CODECOMMA
E71E DC08             (    forth6809.asm):03840                     LDD   CODEHERE
E720 830002           (    forth6809.asm):03841                     SUBD  #2
E723 DD3F             (    forth6809.asm):03842                     STD   PFIELD
E725 3706             (    forth6809.asm):03843                     PULU  D
E727 3606             (    forth6809.asm):03844                     PSHU  D
E729 DC3F             (    forth6809.asm):03845                     LDD   PFIELD
E72B 3606             (    forth6809.asm):03846                     PSHU  D
E72D BDE67B           (    forth6809.asm):03847                     JSR   PATCH
E730 39               (    forth6809.asm):03848                     RTS
                      (    forth6809.asm):03849         
                      (    forth6809.asm):03850         ; ------------------------------------------------------------
                      (    forth6809.asm):03851         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03852         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03853         ; ------------------------------------------------------------
E731 3706             (    forth6809.asm):03854         AGAINW:     PULU  D
E733 10830002         (    forth6809.asm):03855                     CMPD  #TAGBACK
E737 2703             (    forth6809.asm):03856                     BEQ   AGOK
E739 BDE611           (    forth6809.asm):03857                     JSR   CFERR
E73C 3706             (    forth6809.asm):03858         AGOK:       PULU  D                 ; dest
E73E 3606             (    forth6809.asm):03859                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E740 CCDF86           (    forth6809.asm):03860                     LDD   #BRANCH
E743 3606             (    forth6809.asm):03861                     PSHU  D
E745 BDEABB           (    forth6809.asm):03862                     JSR   CCALL
E748 CC0000           (    forth6809.asm):03863                     LDD   #0
E74B 3606             (    forth6809.asm):03864                     PSHU  D
E74D BDE002           (    forth6809.asm):03865                     JSR   CODECOMMA
E750 DC08             (    forth6809.asm):03866                     LDD   CODEHERE
E752 830002           (    forth6809.asm):03867                     SUBD  #2
E755 DD3F             (    forth6809.asm):03868                     STD   PFIELD
E757 3706             (    forth6809.asm):03869                     PULU  D
E759 3606             (    forth6809.asm):03870                     PSHU  D
E75B DC3F             (    forth6809.asm):03871                     LDD   PFIELD
E75D 3606             (    forth6809.asm):03872                     PSHU  D
E75F BDE67B           (    forth6809.asm):03873                     JSR   PATCH
E762 39               (    forth6809.asm):03874                     RTS
                      (    forth6809.asm):03875         
                      (    forth6809.asm):03876         ; ------------------------------------------------------------
                      (    forth6809.asm):03877         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03878         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03879         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03880         ; ------------------------------------------------------------
E763 CCDF70           (    forth6809.asm):03881         WHILEW:     LDD   #ZBRANCH
E766 3606             (    forth6809.asm):03882                     PSHU  D
E768 BDEABB           (    forth6809.asm):03883                     JSR   CCALL
E76B CC0000           (    forth6809.asm):03884                     LDD   #0
E76E 3606             (    forth6809.asm):03885                     PSHU  D
E770 BDE002           (    forth6809.asm):03886                     JSR   CODECOMMA
E773 DC08             (    forth6809.asm):03887                     LDD   CODEHERE
E775 830002           (    forth6809.asm):03888                     SUBD  #2
E778 3606             (    forth6809.asm):03889                     PSHU  D                 ; orig
E77A CC0001           (    forth6809.asm):03890                     LDD   #TAGFWD
E77D 3606             (    forth6809.asm):03891                     PSHU  D
E77F 39               (    forth6809.asm):03892                     RTS
                      (    forth6809.asm):03893         
                      (    forth6809.asm):03894         ; ------------------------------------------------------------
                      (    forth6809.asm):03895         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03896         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03897         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03898         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03899         ; ------------------------------------------------------------
E780 3706             (    forth6809.asm):03900         REPEATW:    PULU  D
E782 10830001         (    forth6809.asm):03901                     CMPD  #TAGFWD
E786 2703             (    forth6809.asm):03902                     BEQ   RPOK1
E788 BDE611           (    forth6809.asm):03903                     JSR   CFERR
E78B 3710             (    forth6809.asm):03904         RPOK1:      PULU  X                 ; orig
E78D 9F41             (    forth6809.asm):03905                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03906         
                      (    forth6809.asm):03907                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03908                     ; See bugfix: REPEATW.1
E78F 3040             (    forth6809.asm):03909                     LEAX  0,U               ; scan from top of control stack
E791 9F2B             (    forth6809.asm):03910                     STX   MSCR2             ; MSCR2 = base of scan region
E793 9F2F             (    forth6809.asm):03911                     STX   MSCR4             ; MSCR4 = scan pointer
E795 DC2F             (    forth6809.asm):03912         RPSCAN:     LDD   MSCR4
E797 109343           (    forth6809.asm):03913                     CMPD  CSP
E79A 2603             (    forth6809.asm):03914                     BNE   RPSCANOK
E79C BDE611           (    forth6809.asm):03915                     JSR   CFERR             ; no matching BEGIN
E79F 9E2F             (    forth6809.asm):03916         RPSCANOK:   LDX   MSCR4
E7A1 EC84             (    forth6809.asm):03917                     LDD   ,X
E7A3 10830002         (    forth6809.asm):03918                     CMPD  #TAGBACK
E7A7 2712             (    forth6809.asm):03919                     BEQ   RPFOUND
E7A9 10830001         (    forth6809.asm):03920                     CMPD  #TAGFWD
E7AD 2703             (    forth6809.asm):03921                     BEQ   RPSKIP
E7AF BDE611           (    forth6809.asm):03922                     JSR   CFERR             ; anything else is a genuine mismatch
E7B2 DC2F             (    forth6809.asm):03923         RPSKIP:     LDD   MSCR4
E7B4 C30004           (    forth6809.asm):03924                     ADDD  #4
E7B7 DD2F             (    forth6809.asm):03925                     STD   MSCR4
E7B9 20DA             (    forth6809.asm):03926                     BRA   RPSCAN
E7BB 9E2F             (    forth6809.asm):03927         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E7BD EC02             (    forth6809.asm):03928                     LDD   2,X               ; dest = BEGIN's address
E7BF DD3F             (    forth6809.asm):03929                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):03930         
                      (    forth6809.asm):03931                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03932                     ; bytes, highest word first.
E7C1 DC2F             (    forth6809.asm):03933                     LDD   MSCR4
E7C3 932B             (    forth6809.asm):03934                     SUBD  MSCR2
E7C5 DD2D             (    forth6809.asm):03935                     STD   MSCR3             ; MSCR3 = bytes to shift
E7C7 2715             (    forth6809.asm):03936                     BEQ   RPSHIFTDONE
E7C9 DC2D             (    forth6809.asm):03937         RPSHIFT:    LDD   MSCR3
E7CB 830002           (    forth6809.asm):03938                     SUBD  #2
E7CE DD2D             (    forth6809.asm):03939                     STD   MSCR3
E7D0 9E2B             (    forth6809.asm):03940                     LDX   MSCR2
E7D2 308B             (    forth6809.asm):03941                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E7D4 EC84             (    forth6809.asm):03942                     LDD   ,X
E7D6 3004             (    forth6809.asm):03943                     LEAX  4,X
E7D8 ED84             (    forth6809.asm):03944                     STD   ,X                ; copy one word 4 bytes higher
E7DA DC2D             (    forth6809.asm):03945                     LDD   MSCR3
E7DC 26EB             (    forth6809.asm):03946                     BNE   RPSHIFT
E7DE                  (    forth6809.asm):03947         RPSHIFTDONE:
E7DE 9E2B             (    forth6809.asm):03948                     LDX   MSCR2
E7E0 3004             (    forth6809.asm):03949                     LEAX  4,X
E7E2 1F13             (    forth6809.asm):03950                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03951         
E7E4 CCDF86           (    forth6809.asm):03952                     LDD   #BRANCH
E7E7 3606             (    forth6809.asm):03953                     PSHU  D
E7E9 BDEABB           (    forth6809.asm):03954                     JSR   CCALL
E7EC CC0000           (    forth6809.asm):03955                     LDD   #0
E7EF 3606             (    forth6809.asm):03956                     PSHU  D
E7F1 BDE002           (    forth6809.asm):03957                     JSR   CODECOMMA
E7F4 DC08             (    forth6809.asm):03958                     LDD   CODEHERE
E7F6 830002           (    forth6809.asm):03959                     SUBD  #2
E7F9 DD2D             (    forth6809.asm):03960                     STD   MSCR3             ; MSCR3 = branch operand address
E7FB DC3F             (    forth6809.asm):03961                     LDD   PFIELD            ; target = BEGIN's address
E7FD 3606             (    forth6809.asm):03962                     PSHU  D
E7FF DC2D             (    forth6809.asm):03963                     LDD   MSCR3             ; location = the operand just compiled
E801 3606             (    forth6809.asm):03964                     PSHU  D
E803 BDE67B           (    forth6809.asm):03965                     JSR   PATCH
E806 DC08             (    forth6809.asm):03966                     LDD   CODEHERE
E808 3606             (    forth6809.asm):03967                     PSHU  D
E80A DC41             (    forth6809.asm):03968                     LDD   NEWFLD
E80C 3606             (    forth6809.asm):03969                     PSHU  D
E80E BDE67B           (    forth6809.asm):03970                     JSR   PATCH
E811 39               (    forth6809.asm):03971                     RTS
                      (    forth6809.asm):03972         
                      (    forth6809.asm):03973         ; ------------------------------------------------------------
                      (    forth6809.asm):03974         ; RECURSE  ( -- )
                      (    forth6809.asm):03975         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03976         ; the xt held in CURXT.
                      (    forth6809.asm):03977         ; ------------------------------------------------------------
E812 DC3A             (    forth6809.asm):03978         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E814 3606             (    forth6809.asm):03979                     PSHU  D                 ; See bugfix: RECURSEW.1
E816 BDEABB           (    forth6809.asm):03980                     JSR   CCALL
E819 39               (    forth6809.asm):03981                     RTS
                      (    forth6809.asm):03982         
                      (    forth6809.asm):03983         ; ------------------------------------------------------------
                      (    forth6809.asm):03984         ; DO  ( C: -- dest )
                      (    forth6809.asm):03985         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03986         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03987         ; ------------------------------------------------------------
E81A CCE82C           (    forth6809.asm):03988         DOW:        LDD   #DOSETUP
E81D 3606             (    forth6809.asm):03989                     PSHU  D
E81F BDEABB           (    forth6809.asm):03990                     JSR   CCALL
E822 DC08             (    forth6809.asm):03991                     LDD   CODEHERE
E824 3606             (    forth6809.asm):03992                     PSHU  D                 ; dest
E826 CC0003           (    forth6809.asm):03993                     LDD   #TAGDO
E829 3606             (    forth6809.asm):03994                     PSHU  D
E82B 39               (    forth6809.asm):03995                     RTS
                      (    forth6809.asm):03996         
                      (    forth6809.asm):03997         ; ------------------------------------------------------------
                      (    forth6809.asm):03998         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03999         ; return address.
                      (    forth6809.asm):04000         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04001         ;    Inputs:
                      (    forth6809.asm):04002         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04003         ;    Outputs:
                      (    forth6809.asm):04004         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04005         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04006         ; ------------------------------------------------------------
E82C 3706             (    forth6809.asm):04007         DOSETUP:    PULU  D                 ; index
E82E DD29             (    forth6809.asm):04008                     STD   MSCR
E830 3706             (    forth6809.asm):04009                     PULU  D                 ; limit
E832 DD2B             (    forth6809.asm):04010                     STD   MSCR2
E834 3510             (    forth6809.asm):04011                     PULS  X
E836 CC0000           (    forth6809.asm):04012                     LDD   #0
E839 3406             (    forth6809.asm):04013                     PSHS  D
E83B DC2B             (    forth6809.asm):04014                     LDD   MSCR2
E83D 3406             (    forth6809.asm):04015                     PSHS  D
E83F DC29             (    forth6809.asm):04016                     LDD   MSCR
E841 3406             (    forth6809.asm):04017                     PSHS  D
E843 3410             (    forth6809.asm):04018                     PSHS  X
E845 39               (    forth6809.asm):04019                     RTS
                      (    forth6809.asm):04020         
                      (    forth6809.asm):04021         ; ------------------------------------------------------------
                      (    forth6809.asm):04022         ; I  ( -- n )
                      (    forth6809.asm):04023         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04024         ; address).
                      (    forth6809.asm):04025         ; ------------------------------------------------------------
E846 EC62             (    forth6809.asm):04026         IW:         LDD   2,S               ; n. See bugfix: IW.1
E848 3606             (    forth6809.asm):04027                     PSHU  D
E84A 39               (    forth6809.asm):04028                     RTS
                      (    forth6809.asm):04029         
                      (    forth6809.asm):04030         ; ------------------------------------------------------------
                      (    forth6809.asm):04031         ; J  ( -- n )
                      (    forth6809.asm):04032         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04033         ; address and the inner loop frame).
                      (    forth6809.asm):04034         ; ------------------------------------------------------------
E84B EC68             (    forth6809.asm):04035         JW:         LDD   8,S               ; n. See bugfix: JW.1
E84D 3606             (    forth6809.asm):04036                     PSHU  D
E84F 39               (    forth6809.asm):04037                     RTS
                      (    forth6809.asm):04038         
                      (    forth6809.asm):04039         ; ------------------------------------------------------------
                      (    forth6809.asm):04040         ; LEAVE  ( -- )
                      (    forth6809.asm):04041         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04042         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04043         ; ------------------------------------------------------------
E850 CCFFFF           (    forth6809.asm):04044         LEAVEW:     LDD   #TRUEV            ; true
E853 ED66             (    forth6809.asm):04045                     STD   6,S               ; See bugfix: LEAVEW.1
E855 39               (    forth6809.asm):04046                     RTS
                      (    forth6809.asm):04047         
                      (    forth6809.asm):04048         ; ------------------------------------------------------------
                      (    forth6809.asm):04049         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04050         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04051         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04052         ; ------------------------------------------------------------
E856 3706             (    forth6809.asm):04053         LOOPW:      PULU  D
E858 10830003         (    forth6809.asm):04054                     CMPD  #TAGDO
E85C 2703             (    forth6809.asm):04055                     BEQ   LOOPOK
E85E BDE611           (    forth6809.asm):04056                     JSR   CFERR
E861 3706             (    forth6809.asm):04057         LOOPOK:     PULU  D                 ; dest
E863 3606             (    forth6809.asm):04058                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E865 CCE89D           (    forth6809.asm):04059                     LDD   #DOTEST
E868 3606             (    forth6809.asm):04060                     PSHU  D
E86A BDEABB           (    forth6809.asm):04061                     JSR   CCALL
E86D CC0000           (    forth6809.asm):04062                     LDD   #0
E870 3606             (    forth6809.asm):04063                     PSHU  D
E872 BDE002           (    forth6809.asm):04064                     JSR   CODECOMMA
E875 DC08             (    forth6809.asm):04065                     LDD   CODEHERE
E877 830002           (    forth6809.asm):04066                     SUBD  #2
E87A DD3F             (    forth6809.asm):04067                     STD   PFIELD
E87C 3706             (    forth6809.asm):04068                     PULU  D
E87E 3606             (    forth6809.asm):04069                     PSHU  D
E880 DC3F             (    forth6809.asm):04070                     LDD   PFIELD
E882 3606             (    forth6809.asm):04071                     PSHU  D
E884 BDE67B           (    forth6809.asm):04072                     JSR   PATCH
                      (    forth6809.asm):04073         
E887 ECC4             (    forth6809.asm):04074                     LDD   ,U
E889 10830007         (    forth6809.asm):04075                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E88D 260D             (    forth6809.asm):04076                     BNE   LOOPDONE
E88F 3706             (    forth6809.asm):04077                     PULU  D
E891 3710             (    forth6809.asm):04078                     PULU  X                 ; ?DO skip operand
E893 DC08             (    forth6809.asm):04079                     LDD   CODEHERE
E895 3606             (    forth6809.asm):04080                     PSHU  D
E897 3610             (    forth6809.asm):04081                     PSHU  X
E899 BDE67B           (    forth6809.asm):04082                     JSR   PATCH
E89C 39               (    forth6809.asm):04083         LOOPDONE:   RTS
                      (    forth6809.asm):04084         
                      (    forth6809.asm):04085         ; ------------------------------------------------------------
                      (    forth6809.asm):04086         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04087         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04088         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04089         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04090         ; DOTEST
                      (    forth6809.asm):04091         ;    Inputs:
                      (    forth6809.asm):04092         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04093         ;        first)
                      (    forth6809.asm):04094         ;    Outputs:
                      (    forth6809.asm):04095         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04096         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04097         ; ------------------------------------------------------------
E89D EC66             (    forth6809.asm):04098         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E89F 2615             (    forth6809.asm):04099                     BNE   DTEXIT            ; set: exit
E8A1 EC62             (    forth6809.asm):04100                     LDD   2,S               ; index
E8A3 C30001           (    forth6809.asm):04101                     ADDD  #1
E8A6 ED62             (    forth6809.asm):04102                     STD   2,S
E8A8 10A364           (    forth6809.asm):04103                     CMPD  4,S               ; limit
E8AB 2709             (    forth6809.asm):04104                     BEQ   DTEXIT
E8AD 3510             (    forth6809.asm):04105                     PULS  X                 ; X = branch operand address
E8AF EC84             (    forth6809.asm):04106                     LDD   ,X
E8B1 308B             (    forth6809.asm):04107                     LEAX  D,X

                      (    forth6809.asm):07204         ; ------------------------------------------------------------
                      (    forth6809.asm):07205         ; Divide the unsigned double UDHI:UDLO by BASE (restoring division, 32
                      (    forth6809.asm):07206         ; iterations). Only the low byte of BASE is used.
                      (    forth6809.asm):07207         ; UDDIGIT
                      (    forth6809.asm):07208         ;    Inputs:
                      (    forth6809.asm):07209         ;        UDHI:UDLO = dividend
                      (    forth6809.asm):07210         ;    Outputs:
                      (    forth6809.asm):07211         ;        UDHI:UDLO = quotient, REM = remainder

                      (   unit_tests.asm):13370         ; TSTSNAME1 - unit test for SNAME, found case. Searches the
                      (   unit_tests.asm):13371         ; real, live dictionary (confirmed via its own code that it
                      (   unit_tests.asm):13372         ; walks from the real LATEST, not a redirectable copy - no
                      (   unit_tests.asm):13373         ; redirect needed or possible here) for DUP's own xt, verifying
                      (   unit_tests.asm):13374         ; the returned name content matches "DUP" exactly, not just a
                      (   unit_tests.asm):13375         ; nonzero length.
                      (   unit_tests.asm):13376         ; ------------------------------------------------------------
C2B7                  (   unit_tests.asm):13377         TSTSNAME1:  LDD   LATEST
                      (   unit_tests.asm):13378                     STD   TSTLSAV
                      (   unit_tests.asm):13379         
                      (   unit_tests.asm):13380                     LDD   #BASELATEST       ; BUG FIX: confirmed via a real MAME run -
                      (   unit_tests.asm):13381                     STD   LATEST            ; SNAMEW starts its walk from LATEST
                      (   unit_tests.asm):13382                                             ; (LDD LATEST/STD SNXT), the same real,
                      (   unit_tests.asm):13383                                             ; pre-COLD dependency found and fixed in
                      (   unit_tests.asm):13384                                             ; section 3.17's own TSTEVALUATE. With
                      (   unit_tests.asm):13385                                             ; LATEST=0 (only set by COLD, which
                      (   unit_tests.asm):13386                                             ; hasn't run yet at this whole test
                      (   unit_tests.asm):13387                                             ; framework's own pre-COLD execution
                      (   unit_tests.asm):13388                                             ; point), SNLOOP's own "BEQ SNNOTFOUND"
                      (   unit_tests.asm):13389                                             ; fires immediately, before ever

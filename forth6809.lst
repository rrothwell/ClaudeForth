                      (    forth6809.asm):12922                     LDD  #2
                      (    forth6809.asm):12923                     PSHU D
                      (    forth6809.asm):12924                     LDD  #TSTCBUF+2
                      (    forth6809.asm):12925                     PSHU D
                      (    forth6809.asm):12926                     LDD  #2
                      (    forth6809.asm):12927                     PSHU D
                      (    forth6809.asm):12928                     JSR  COMPAREW
                      (    forth6809.asm):12929                     PULU D
                      (    forth6809.asm):12930                     CMPD #-1
                      (    forth6809.asm):12931                     BNE  CQFAIL
                      (    forth6809.asm):12932         
                      (    forth6809.asm):12933                     LDD  #TSTCBUF
                      (    forth6809.asm):12934                     PSHU D
                      (    forth6809.asm):12935                     LDD  #2
                      (    forth6809.asm):12936                     PSHU D
                      (    forth6809.asm):12937                     LDD  #TSTCBUF
                      (    forth6809.asm):12938                     PSHU D
                      (    forth6809.asm):12939                     LDD  #2
                      (    forth6809.asm):12940                     PSHU D
                      (    forth6809.asm):12941                     JSR  COMPAREW
                      (    forth6809.asm):12942                     PULU D
                      (    forth6809.asm):12943                     CMPD #0
                      (    forth6809.asm):12944                     BNE  CQFAIL
                      (    forth6809.asm):12945         
                      (    forth6809.asm):12946                     LDD  #TSTCBUF+2
                      (    forth6809.asm):12947                     PSHU D
                      (    forth6809.asm):12948                     LDD  #2
                      (    forth6809.asm):12949                     PSHU D
                      (    forth6809.asm):12950                     LDD  #TSTCBUF
                      (    forth6809.asm):12951                     PSHU D
                      (    forth6809.asm):12952                     LDD  #2
                      (    forth6809.asm):12953                     PSHU D
                      (    forth6809.asm):12954                     JSR  COMPAREW
                      (    forth6809.asm):12955                     PULU D
                      (    forth6809.asm):12956                     CMPD #1
                      (    forth6809.asm):12957                     BNE  CQFAIL
                      (    forth6809.asm):12958         
                      (    forth6809.asm):12959                     LDD  #TSTCBUF
                      (    forth6809.asm):12960                     PSHU D
                      (    forth6809.asm):12961                     LDD  #2
                      (    forth6809.asm):12962                     PSHU D
                      (    forth6809.asm):12963                     LDD  #TSTCBUF
                      (    forth6809.asm):12964                     PSHU D
                      (    forth6809.asm):12965                     LDD  #3
                      (    forth6809.asm):12966                     PSHU D

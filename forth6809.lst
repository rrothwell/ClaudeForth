                      (    forth6809.asm):04228         ; ------------------------------------------------------------
                      (    forth6809.asm):04229         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04230         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04231         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04232         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04233         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04234         ;    Inputs:
                      (    forth6809.asm):04235         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04236         ;    Outputs:
                      (    forth6809.asm):04237         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04238         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04239         ;        scratch.
                      (    forth6809.asm):04240         ; ------------------------------------------------------------
E8D0 3706             (    forth6809.asm):04241         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E8D2 DD29             (    forth6809.asm):04242                     STD   MSCR              ; MSCR = step
E8D4 EC66             (    forth6809.asm):04243                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E8D6 262D             (    forth6809.asm):04244                     BNE   DPTEXIT           ; set: exit
E8D8 EC62             (    forth6809.asm):04245                     LDD   2,S               ; old index
E8DA A364             (    forth6809.asm):04246                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E8DC DD2B             (    forth6809.asm):04247                     STD   MSCR2
E8DE EC62             (    forth6809.asm):04248                     LDD   2,S
E8E0 D329             (    forth6809.asm):04249                     ADDD  MSCR              ; new_index = old_index + step
E8E2 ED62             (    forth6809.asm):04250                     STD   2,S
E8E4 A364             (    forth6809.asm):04251                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E8E6 DD2D             (    forth6809.asm):04252                     STD   MSCR3
                      (    forth6809.asm):04253                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04254                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04255                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E8E8 DC29             (    forth6809.asm):04256                     LDD   MSCR              ; reload the step to test its sign
E8EA 2B09             (    forth6809.asm):04257                     BMI   DPNEG
E8EC DC2D             (    forth6809.asm):04258         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E8EE 10932B           (    forth6809.asm):04259                     CMPD  MSCR2
E8F1 2512             (    forth6809.asm):04260                     BLO   DPTEXIT
E8F3 2007             (    forth6809.asm):04261                     BRA   DPCONT
E8F5 DC2D             (    forth6809.asm):04262         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E8F7 10932B           (    forth6809.asm):04263                     CMPD  MSCR2
E8FA 2209             (    forth6809.asm):04264                     BHI   DPTEXIT
E8FC 3510             (    forth6809.asm):04265         DPCONT:     PULS  X                 ; X = branch operand address
E8FE EC84             (    forth6809.asm):04266                     LDD   ,X
E900 308B             (    forth6809.asm):04267                     LEAX  D,X
E902 3410             (    forth6809.asm):04268                     PSHS  X

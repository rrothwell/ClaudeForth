F803 3706             (    forth6809.asm):06976         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F805 DDAB             (    forth6809.asm):06977                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):06978                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):06979                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):06980                                   ; real source length was misread as an
                      (    forth6809.asm):06981                                   ; address, the real source address was never
                      (    forth6809.asm):06982                                   ; popped at all, and the true destination
                      (    forth6809.asm):06983                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):06984                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):06985                                   ; c-addr2 (dest) is on top, popped first.
F807 3706             (    forth6809.asm):06986                    PULU D         ; next: u1 (source length)
F809 DDA9             (    forth6809.asm):06987                    STD  UESRCLEN
F80B 3706             (    forth6809.asm):06988                    PULU D         ; next: c-addr1 (source address)
F80D DDA7             (    forth6809.asm):06989                    STD  UEADDR
F80F CC0000           (    forth6809.asm):06990                    LDD  #0
F812 DDAD             (    forth6809.asm):06991                    STD  UEOUTLEN
F814 9EA7             (    forth6809.asm):06992                    LDX  UEADDR
F816 109EAB           (    forth6809.asm):06993                    LDY  UEDST
                      (    forth6809.asm):06994         
                      (    forth6809.asm):06995                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06996                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06997                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06998                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06999                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):07000                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):07001                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):07002                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):07003                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):07004                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):07005                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):07006                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):07007                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):07008                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):07009                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):07010                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):07011                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):07012                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):07013                    ; wrong algorithm entirely, not a smaller bug within it.
F819 DCA9             (    forth6809.asm):07014         UELOOP:    LDD  UESRCLEN
F81B 2715             (    forth6809.asm):07015                    BEQ  UEDONE
F81D A680             (    forth6809.asm):07016                    LDA  ,X+
F81F 8125             (    forth6809.asm):07017                    CMPA #'%'
F821 2604             (    forth6809.asm):07018                    BNE  UENOTPCT
F823 C625             (    forth6809.asm):07019                    LDB  #'%'      ; write the extra '%' first - the character
F825 E7A0             (    forth6809.asm):07020                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):07021                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):07022                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):07023                                   ; the same string correctly, since this runs
                      (    forth6809.asm):07024                                   ; independently for each one the loop visits.
F827 A7A0             (    forth6809.asm):07025         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):07026                                   ; every character, '%' or not
F829 DCA9             (    forth6809.asm):07027                    LDD  UESRCLEN
F82B 830001           (    forth6809.asm):07028                    SUBD #1
F82E DDA9             (    forth6809.asm):07029                    STD  UESRCLEN
F830 20E7             (    forth6809.asm):07030                    BRA  UELOOP
F832 1F20             (    forth6809.asm):07031         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F834 93AB             (    forth6809.asm):07032                    SUBD UEDST     ; overwriting whatever was left on top of
F836 DDAD             (    forth6809.asm):07033                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):07034                                   ; required return values, and separately,
                      (    forth6809.asm):07035                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):07036                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):07037                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):07038                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):07039                                   ; characters. Now computed directly as the
                      (    forth6809.asm):07040                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):07041                                   ; original destination address (UEDST) -
                      (    forth6809.asm):07042                                   ; correct regardless of how many characters
                      (    forth6809.asm):07043                                   ; were doubled, since it's derived from
                      (    forth6809.asm):07044                                   ; where writing actually stopped rather than
                      (    forth6809.asm):07045                                   ; incremented alongside it.
F838 DCAB             (    forth6809.asm):07046                    LDD  UEDST
F83A 3606             (    forth6809.asm):07047                    PSHU D         ; push c-addr2 (destination address)
F83C DCAD             (    forth6809.asm):07048                    LDD  UEOUTLEN
F83E 3606             (    forth6809.asm):07049                    PSHU D         ; push u2 (actual unescaped length)
F840 39               (    forth6809.asm):07050                    RTS
                      (    forth6809.asm):07051         

                      (    forth6809.asm):00298         ; Ring buffers for serial communications.
                      (    forth6809.asm):00299         ; One for input, one for output.
                      (    forth6809.asm):00300         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00301         ; The tricks are not used.
                      (    forth6809.asm):00302         ; ------------------------------------------------------------
                      (    forth6809.asm):00303                     ORG   SERBUFCTL         ; $176.
                      (    forth6809.asm):00304         
0176                  (    forth6809.asm):00305         INHEAD      RMB   1
0177                  (    forth6809.asm):00306         INTAIL      RMB   1
                      (    forth6809.asm):00307         ; Open question moved to shadow: RTSSTATE.1
0178                  (    forth6809.asm):00308         RTSSTATE    RMB   1                 ; $00 = RTS low, $FF = RTS high
                      (    forth6809.asm):00309         
0179                  (    forth6809.asm):00310         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00311         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00312         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00313         
017C                  (    forth6809.asm):00314         FECOUNT     RMB   1                 ; framing errors
017D                  (    forth6809.asm):00315         OVRNCOUNT   RMB   1                 ; overrun count, same as above
017E                  (    forth6809.asm):00316         PECOUNT     RMB   1                 ; parity-error count, same as above
017F                  (    forth6809.asm):00317         POLLREADYCNT
017F                  (    forth6809.asm):00318                     RMB   1                 ; polling build; see shadow POLLREADYCNT.1
                      (    forth6809.asm):00319         
                      (    forth6809.asm):00320                     ORG   SERBUF            ; $180, a 64 byte boundary.
                      (    forth6809.asm):00321         
                      (    forth6809.asm):00322                     ALIGN 64                ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00323         INBUF       RMB   INBUFSZ           ; Receive circular queue buffer
                      (    forth6809.asm):00324         
                      (    forth6809.asm):00325                     ALIGN 64                ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00326         OUTBUF      RMB   OUTBUFSZ          ; Transmit circular queue buffer
                      (    forth6809.asm):00327         
                      (    forth6809.asm):00328         ; ------------------------------------------------------------
                      (    forth6809.asm):00329         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00330         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00331         ; ------------------------------------------------------------
                      (    forth6809.asm):00332                     ORG   USROMSTRT
                      (    forth6809.asm):00333         
                      (    forth6809.asm):00334                     IFNDEF UNITTESTS
C100                  (    forth6809.asm):00335         UNITTESTS   SET   0                 ; default if -D not passed
                      (    forth6809.asm):00336                     ; Default 0: unit tests excluded; -DUNITTESTS=1 includes them.
                      (    forth6809.asm):00337                     ; Original comment: shadow UNITTESTS.1.
                      (    forth6809.asm):00338                     ENDC
                      (    forth6809.asm):00339         
                      (    forth6809.asm):00340                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00341         TSTSELECTOR SET   2                 ; default if -D not passed
                      (    forth6809.asm):00342                     ENDC
                      (    forth6809.asm):00343         
                      (    forth6809.asm):00344                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):00345         
                      (    forth6809.asm):00346         ; ------------------------------------------------------------
                      (    forth6809.asm):00347         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00348         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00349         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00350         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00351         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00352         ; ------------------------------------------------------------
                      (    forth6809.asm):00353                     INCLUDE unit_tests.asm
                      (    forth6809.asm):00354         
                      (    forth6809.asm):00355                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):00356         
C100                  (    forth6809.asm):00357         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00358                     FILL  $FF,BASEDICT-ROM

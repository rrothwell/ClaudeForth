                      (    forth6809.asm):06238         ; ------------------------------------------------------------
F3AD CC0000           (    forth6809.asm):06239         ERASEW:     LDD   #0
F3B0 3606             (    forth6809.asm):06240                     PSHU  D
F3B2 7EF397           (    forth6809.asm):06241                     JMP   FILLW
                      (    forth6809.asm):06242         
                      (    forth6809.asm):06243         ; ------------------------------------------------------------
                      (    forth6809.asm):06244         ; BLANK  ( c-addr u -- )

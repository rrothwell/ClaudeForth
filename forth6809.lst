                      (    forth6809.asm):15592         
                      (    forth6809.asm):15593         ; ------------------------------------------------------------
                      (    forth6809.asm):15594         ; TSTENVSYS - environmental & system queries tests (glossary
                      (    forth6809.asm):15595         ; section 3.17, 10 words, 8 tests since TIB/#TIB/>IN/SPAN/BL are
                      (    forth6809.asm):15596         ; combined into one test, and ENVIRONMENT? gets three separate
                      (    forth6809.asm):15597         ; tests of its own - single-cell, double-cell, and unsupported-
                      (    forth6809.asm):15598         ; string cases).
                      (    forth6809.asm):15599         ;
                      (    forth6809.asm):15600         ; REFILL genuinely blocks on real input when the source is the
                      (    forth6809.asm):15601         ; terminal (confirmed by reading its own code: the terminal
                      (    forth6809.asm):15602         ; branch calls QUERY, which per section 3.1's own already-
                      (    forth6809.asm):15603         ; established finding calls ACCEPT, which calls KEY, which spins
                      (    forth6809.asm):15604         ; forever without real input) - only its safely-testable path
                      (    forth6809.asm):15605         ; (source is a string) is tested here, matching the same
                      (    forth6809.asm):15606         ; reasoning already applied to KEY/ACCEPT/EXPECT/QUERY
                      (    forth6809.asm):15607         ; themselves. EVALUATE genuinely executes its given string as
                      (    forth6809.asm):15608         ; real Forth source via JSR INTERPRET - confirmed safe via
                      (    forth6809.asm):15609         ; INTERPRET's own code (it simply stops when input is exhausted,
                      (    forth6809.asm):15610         ; no automatic REFILL, so no blocking risk), making a short,
                      (    forth6809.asm):15611         ; deliberately harmless string ("1 2 +") safe to evaluate
                      (    forth6809.asm):15612         ; directly.
                      (    forth6809.asm):15613         ;
                      (    forth6809.asm):15614         ; ENVIRONMENT? carries substantial, already-documented bug-fix
                      (    forth6809.asm):15615         ; history (a COMPAREW-clobbers-X bug, confirmed via MAME with the
                      (    forth6809.asm):15616         ; exact $4E4D symptom). This section's own tests specifically
                      (    forth6809.asm):15617         ; query "/COUNTED-STRING" immediately followed by "MAX-N" - the
                      (    forth6809.asm):15618         ; exact adjacent pair the bug-fix comment describes - so a
                      (    forth6809.asm):15619         ; regression of that specific mechanism would be caught again,
                      (    forth6809.asm):15620         ; not just assumed fixed from the comment alone.
                      (    forth6809.asm):15621         ; ------------------------------------------------------------
C324 BDFC2B           (    forth6809.asm):15622         TSTENVSYS: JSR CRW
C327 8EC338           (    forth6809.asm):15623                    LDX   #TSTENVSYSMSG
C32A 3610             (    forth6809.asm):15624                    PSHU  X
C32C CC0006           (    forth6809.asm):15625                    LDD   #6
C32F 3606             (    forth6809.asm):15626                    PSHU  D
C331 BDF60B           (    forth6809.asm):15627                    JSR   TYPE
C334 BDFC2B           (    forth6809.asm):15628                    JSR   CRW
                      (    forth6809.asm):15629         
                      (    forth6809.asm):15630                    IFEQ TSTSELECTOR-16  ; >>>>
                      (    forth6809.asm):15631         
                      (    forth6809.asm):15632                    JSR   TSTENVVARS
                      (    forth6809.asm):15633                    JSR   TSTSOURCE
                      (    forth6809.asm):15634                    JSR   TSTSOURCEID
                      (    forth6809.asm):15635                    JSR   TSTREFILL
                      (    forth6809.asm):15636                    JSR   TSTEVALUATE
                      (    forth6809.asm):15637                    JSR   TSTENVQUERY1
                      (    forth6809.asm):15638                    JSR   TSTENVQUERY2
                      (    forth6809.asm):15639                    JSR   TSTENVQUERY3
                      (    forth6809.asm):15640         
                      (    forth6809.asm):15641                    ENDC ; <<<<
                      (    forth6809.asm):15642         
C337 39               (    forth6809.asm):15643                    RTS
                      (    forth6809.asm):15644         
C338 456E76537973     (    forth6809.asm):15645         TSTENVSYSMSG: FCC "EnvSys"
                      (    forth6809.asm):15646         
                      (    forth6809.asm):15647                    IFEQ TSTSELECTOR-16  ; >>>>

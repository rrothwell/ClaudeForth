                      (    forth6809.asm):06481         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06482         ; ============================================================
                      (    forth6809.asm):06483         ; ------------------------------------------------------------
                      (    forth6809.asm):06484         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06485         ; address and length and skip over it.
                      (    forth6809.asm):06486         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06487         ;    Inputs:
                      (    forth6809.asm):06488         ;        return address on S points at the count byte
                      (    forth6809.asm):06489         ;    Outputs:
                      (    forth6809.asm):06490         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06491         ;        string
                      (    forth6809.asm):06492         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06493         ; ------------------------------------------------------------
F43B 3510             (    forth6809.asm):06494         DOSTR:      PULS  X
F43D E684             (    forth6809.asm):06495                     LDB   ,X
F43F 3001             (    forth6809.asm):06496                     LEAX  1,X
F441 3610             (    forth6809.asm):06497                     PSHU  X
F443 4F               (    forth6809.asm):06498                     CLRA
F444 3606             (    forth6809.asm):06499                     PSHU  D
F446 3085             (    forth6809.asm):06500                     LEAX  B,X
F448 3410             (    forth6809.asm):06501                     PSHS  X
F44A 39               (    forth6809.asm):06502                     RTS
                      (    forth6809.asm):06503         
                      (    forth6809.asm):06504         ; ------------------------------------------------------------
                      (    forth6809.asm):06505         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06506         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06507         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06508         ; PARSEQUOTE
                      (    forth6809.asm):06509         ;    Inputs:
                      (    forth6809.asm):06510         ;        none (parses from >IN)
                      (    forth6809.asm):06511         ;    Outputs:
                      (    forth6809.asm):06512         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06513         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06514         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06515         ; ------------------------------------------------------------
F44B CC0022           (    forth6809.asm):06516         PARSEQUOTE: LDD   #34
F44E 3606             (    forth6809.asm):06517                     PSHU  D
F450 BDF621           (    forth6809.asm):06518                     JSR   PARSEW
F453 6DC4             (    forth6809.asm):06519                     TST   ,U                ; high byte of the length
F455 2601             (    forth6809.asm):06520                     BNE   PQLONG
F457 39               (    forth6809.asm):06521                     RTS
F458 CCFFEE           (    forth6809.asm):06522         PQLONG:     LDD   #-18
F45B 3606             (    forth6809.asm):06523                     PSHU  D
F45D 7EE5B5           (    forth6809.asm):06524                     JMP   THROWW
                      (    forth6809.asm):06525         
                      (    forth6809.asm):06526         ; ------------------------------------------------------------
                      (    forth6809.asm):06527         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06528         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06529         ;    Inputs:
                      (    forth6809.asm):06530         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06531         ;        c-addr u on the data stack
                      (    forth6809.asm):06532         ;    Outputs:
                      (    forth6809.asm):06533         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06534         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06535         ; ------------------------------------------------------------
F460 3606             (    forth6809.asm):06536         CSTRCOMP:   PSHU  D
F462 BDE9F0           (    forth6809.asm):06537                     JSR   CCALL
F465 3706             (    forth6809.asm):06538                     PULU  D                 ; u
F467 3720             (    forth6809.asm):06539                     PULU  Y                 ; c-addr
F469 9E08             (    forth6809.asm):06540                     LDX   CODEHERE
F46B E780             (    forth6809.asm):06541                     STB   ,X+
F46D 5D               (    forth6809.asm):06542                     TSTB
F46E 2707             (    forth6809.asm):06543                     BEQ   CSEND
F470 A6A0             (    forth6809.asm):06544         CSCPY:      LDA   ,Y+
F472 A780             (    forth6809.asm):06545                     STA   ,X+
F474 5A               (    forth6809.asm):06546                     DECB
F475 26F9             (    forth6809.asm):06547                     BNE   CSCPY
F477 9F08             (    forth6809.asm):06548         CSEND:      STX   CODEHERE
F479 39               (    forth6809.asm):06549                     RTS
                      (    forth6809.asm):06550         
                      (    forth6809.asm):06551         ; ------------------------------------------------------------
                      (    forth6809.asm):06552         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06553         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06554         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06555         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06556         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06557         ; ------------------------------------------------------------
F47A BDF44B           (    forth6809.asm):06558         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F47D DC00             (    forth6809.asm):06559         SQSTATE:    LDD   STATE
F47F 2706             (    forth6809.asm):06560                     BEQ   SQINTERP
F481 CCF43B           (    forth6809.asm):06561                     LDD   #DOSTR
F484 7EF460           (    forth6809.asm):06562                     JMP   CSTRCOMP
                      (    forth6809.asm):06563         
                      (    forth6809.asm):06564                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06565                     ; SQUOTEW.2.
F487                  (    forth6809.asm):06566         SQINTERP:
F487 BDDFB4           (    forth6809.asm):06567                     JSR   PADW
F48A 3710             (    forth6809.asm):06568                     PULU  X                 ; PAD

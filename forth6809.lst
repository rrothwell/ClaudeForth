F521 1F02             (    forth6809.asm):19710                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):19711                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):19712                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):19713                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):19714                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):19715                                   ; The high byte took on the fill character's
                      (    forth6809.asm):19716                                   ; value instead of the count's real high
                      (    forth6809.asm):19717                                   ; byte, so the count almost never reached
                      (    forth6809.asm):19718                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):19719                                   ; past the requested length. Keeping the
                      (    forth6809.asm):19720                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):19721                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):19722                                   ; fill character into A) and removes the
                      (    forth6809.asm):19723                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):19724                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):19725                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):19726                                   ; MAME debugger.

                      (    forth6809.asm):03283         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03284         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03285         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03286         ;    Inputs:
                      (    forth6809.asm):03287         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03288         ;    Outputs:
                      (    forth6809.asm):03289         ;        single number: n and -1
                      (    forth6809.asm):03290         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03291         ;        not a number: c-addr and 0
                      (    forth6809.asm):03292         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03293         ; ------------------------------------------------------------

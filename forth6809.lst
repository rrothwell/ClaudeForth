                      (    forth6809.asm):07028         ; ------------------------------------------------------------
                      (    forth6809.asm):07029         ; SEARCH  ( c-addr1 u1 c-addr2 u2 -- c-addr3 u3 flag )
                      (    forth6809.asm):07030         ; Search the string c-addr1 u1 for the string c-addr2 u2. If found,
                      (    forth6809.asm):07031         ; return the address and remaining length of the match and true;
                      (    forth6809.asm):07032         ; otherwise return the original string and false.
                      (    forth6809.asm):07033         ; ------------------------------------------------------------
F6E0 335A             (    forth6809.asm):07034         SEARCHW:    LEAU  -6,U              ; locals: 0,U candidate address, 2,U positions
F6E2 EC46             (    forth6809.asm):07035                     LDD   6,U               ; left, 4,U end of the needle.  Then u2 at 6,
F6E4 2606             (    forth6809.asm):07036                     BNE   SRCHNZ            ; c-addr2 at 8, u1 at 10, c-addr1 at 12
F6E6 EC4C             (    forth6809.asm):07037                     LDD   12,U              ; an empty needle matches at the start
F6E8 EDC4             (    forth6809.asm):07038                     STD   ,U
F6EA 2029             (    forth6809.asm):07039                     BRA   SFOUND
F6EC EC4A             (    forth6809.asm):07040         SRCHNZ:     LDD   10,U

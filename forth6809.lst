                      (    forth6809.asm):06219         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):06220         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):06221         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):06222         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):06223         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):06224         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):06225         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):06226         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):06227         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):06228         ; M*/W
                      (    forth6809.asm):06229         ;    Inputs:
                      (    forth6809.asm):06230         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):06231         ;    Outputs:
                      (    forth6809.asm):06232         ;        d2 on the data stack
                      (    forth6809.asm):06233         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):06234         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):06235         ; ------------------------------------------------------------

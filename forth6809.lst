                      (    forth6809.asm):01679         ; ------------------------------------------------------------
DD40                  (    forth6809.asm):01680         CHKLO:
DD40 C110             (    forth6809.asm):01681                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DD42 240D             (    forth6809.asm):01682                     BHS   CHKLODONE         ; No! Do nothing.
DD44 7D0178           (    forth6809.asm):01683                     TST   RTSSTATE
DD47 2708             (    forth6809.asm):01684                     BEQ   CHKLODONE         ; already low - nothing to do
DD49 8600             (    forth6809.asm):01685                     LDA   #INACCEPT         ; Yes! Assert RTS.
DD4B B70178           (    forth6809.asm):01686                     STA   RTSSTATE
DD4E BDDD13           (    forth6809.asm):01687                     JSR   UPDATE_RTS
DD51 39               (    forth6809.asm):01688         CHKLODONE:  RTS
                      (    forth6809.asm):01689         ; ------------------------------------------------------------
                      (    forth6809.asm):01690         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01691         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01692         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01693         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01694         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01695         ;    Inputs:
                      (    forth6809.asm):01696         ;        none
                      (    forth6809.asm):01697         ;    Outputs:
                      (    forth6809.asm):01698         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01699         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01700         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01701         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01702         FLUSHOUTBUFFER:
DD52 F6017A           (    forth6809.asm):01703                     LDB   OUTTAIL
DD55 F10179           (    forth6809.asm):01704                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DD58 2719             (    forth6809.asm):01705                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01706         
DD5A B6C008           (    forth6809.asm):01707                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01708                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01709                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01710         
DD61 8502             (    forth6809.asm):01711                     BITA  #SR_TDRE          ; Is transmit register empty?
DD63 270E             (    forth6809.asm):01712                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01713                                             ; than spin-wait here.
                      (    forth6809.asm):01714         
DD65 8E01C0           (    forth6809.asm):01715                     LDX   #OUTBUF           ; The out buffer is occupied.
DD68 A685             (    forth6809.asm):01716                     LDA   B,X               ; Get the character from the out buffer.
DD6A B7C009           (    forth6809.asm):01717                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01718         
DD6D 5C               (    forth6809.asm):01719                     INCB                    ; Update tail pointer to next character slot.
DD6E C43F             (    forth6809.asm):01720                     ANDB  #OUTBUFSZ-1
DD70 F7017A           (    forth6809.asm):01721                     STB   OUTTAIL
                      (    forth6809.asm):01722                                             ; One character sent - return rather than
                      (    forth6809.asm):01723                                             ; loop back for more (see header comment).
DD73                  (    forth6809.asm):01724         FLUSHED:
DD73 39               (    forth6809.asm):01725                     RTS
                      (    forth6809.asm):01726         ; ------------------------------------------------------------
                      (    forth6809.asm):01727         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01728         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01729         ; PUTCHAR
                      (    forth6809.asm):01730         ;    Inputs:
                      (    forth6809.asm):01731         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01732         ;    Outputs:
                      (    forth6809.asm):01733         ;        none
                      (    forth6809.asm):01734         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01735         ; ------------------------------------------------------------
DD74                  (    forth6809.asm):01736         PUTCHAR:
DD74 3411             (    forth6809.asm):01737                     PSHS  CC,X
DD76 1A50             (    forth6809.asm):01738                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01739         
DD78 F60179           (    forth6809.asm):01740                     LDB   OUTHEAD           ; Is buffer full?
DD7B 5C               (    forth6809.asm):01741                     INCB
DD7C C43F             (    forth6809.asm):01742                     ANDB  #OUTBUFSZ-1
DD7E F1017A           (    forth6809.asm):01743                     CMPB  OUTTAIL
DD81 273A             (    forth6809.asm):01744                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01745         
DD83 8E01C0           (    forth6809.asm):01746                     LDX   #OUTBUF           ; Put character into character slot.
DD86 F60179           (    forth6809.asm):01747                     LDB   OUTHEAD
DD89 A785             (    forth6809.asm):01748                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01749         
DD8B 5C               (    forth6809.asm):01750                     INCB                    ; Update tail pointer to next character slot.
DD8C C43F             (    forth6809.asm):01751                     ANDB  #OUTBUFSZ-1
DD8E F70179           (    forth6809.asm):01752                     STB   OUTHEAD
                      (    forth6809.asm):01753         
DD91 7D0178           (    forth6809.asm):01754                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
DD94 2709             (    forth6809.asm):01755                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):01756         
                      (    forth6809.asm):01757                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):01758                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1

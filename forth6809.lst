                      (    forth6809.asm):06729         ; ------------------------------------------------------------
F3E7 3510             (    forth6809.asm):06730         DOSTR:      PULS  X
F3E9 E684             (    forth6809.asm):06731                     LDB   ,X
F3EB 3001             (    forth6809.asm):06732                     LEAX  1,X
F3ED 3610             (    forth6809.asm):06733                     PSHU  X
F3EF 4F               (    forth6809.asm):06734                     CLRA
F3F0 3606             (    forth6809.asm):06735                     PSHU  D
F3F2 3085             (    forth6809.asm):06736                     LEAX  B,X
F3F4 3410             (    forth6809.asm):06737                     PSHS  X
F3F6 39               (    forth6809.asm):06738                     RTS
                      (    forth6809.asm):06739         
                      (    forth6809.asm):06740         ; ------------------------------------------------------------
                      (    forth6809.asm):06741         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06742         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06743         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06744         ; PARSEQUOTE
                      (    forth6809.asm):06745         ;    Inputs:
                      (    forth6809.asm):06746         ;        none (parses from >IN)
                      (    forth6809.asm):06747         ;    Outputs:
                      (    forth6809.asm):06748         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06749         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06750         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06751         ; ------------------------------------------------------------
F3F7 CC0022           (    forth6809.asm):06752         PARSEQUOTE: LDD   #34
F3FA 3606             (    forth6809.asm):06753                     PSHU  D
F3FC BDF5CD           (    forth6809.asm):06754                     JSR   PARSEW
F3FF 6DC4             (    forth6809.asm):06755                     TST   ,U                ; high byte of the length

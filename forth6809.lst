F84E 2727             (    forth6809.asm):07059                     BEQ   SUBCPDONE
F850 DCC3             (    forth6809.asm):07060                     LDD   SUBOUTLEN
F852 1093BB           (    forth6809.asm):07061                     CMPD  SUBDESTCAP
F855 1024011D         (    forth6809.asm):07062                     LBHS  SUBOVERFLOW       ; was BHS - out of short-branch range
F859 9EC9             (    forth6809.asm):07063                     LDX   SUBCOPYSRC
F85B A680             (    forth6809.asm):07064                     LDA   ,X+
F85D 9FC9             (    forth6809.asm):07065                     STX   SUBCOPYSRC
F85F 109EC5           (    forth6809.asm):07066                     LDY   SUBWPTR
F862 A7A0             (    forth6809.asm):07067                     STA   ,Y+
F864 109FC5           (    forth6809.asm):07068                     STY   SUBWPTR
F867 DCC3             (    forth6809.asm):07069                     LDD   SUBOUTLEN
F869 C30001           (    forth6809.asm):07070                     ADDD  #1
F86C DDC3             (    forth6809.asm):07071                     STD   SUBOUTLEN
F86E DCC7             (    forth6809.asm):07072                     LDD   SUBCOPYCNT
F870 830001           (    forth6809.asm):07073                     SUBD  #1
F873 DDC7             (    forth6809.asm):07074                     STD   SUBCOPYCNT
F875 20D5             (    forth6809.asm):07075                     BRA   SUBCPLP
F877 39               (    forth6809.asm):07076         SUBCPDONE:  RTS
                      (    forth6809.asm):07077         
F878                  (    forth6809.asm):07078         SUBSTITUTEW:                        ; REWRITE: was a plain substring search-and-replace on
                      (    forth6809.asm):07079                     ; the bare registered name (via SEARCHW), which found
                      (    forth6809.asm):07080                     ; "girl" and replaced only that span, leaving surrounding
                      (    forth6809.asm):07081                     ; "%...%" delimiters untouched in the output - and never
                      (    forth6809.asm):07082                     ; returned the substitution count ANS requires as a
                      (    forth6809.asm):07083                     ; third stack item. Per the ANS spec (forth-standard.org/
                      (    forth6809.asm):07084                     ; standard/string/SUBSTITUTE), SUBSTITUTE must scan for
                      (    forth6809.asm):07085                     ; text between '%' (ASCII $25) delimiter pairs
                      (    forth6809.asm):07086                     ; specifically: "%%" collapses to a single '%' (count
                      (    forth6809.asm):07087                     ; unchanged); a name matching the REPLACES registration
                      (    forth6809.asm):07088                     ; has the ENTIRE "%name%" span - delimiters included -
                      (    forth6809.asm):07089                     ; replaced by the substitution text (count incremented);
                      (    forth6809.asm):07090                     ; a non-matching name is passed through unchanged,
                      (    forth6809.asm):07091                     ; delimiters and all (count unchanged); an unpaired
                      (    forth6809.asm):07092                     ; trailing '%' with no closing delimiter passes the
                      (    forth6809.asm):07093                     ; residue through unchanged. Confirmed via MAME testing
                      (    forth6809.asm):07094                     ; against a real template. GLOBALS is fully packed
                      (    forth6809.asm):07095                     ; (256/256), so this reuses MSCR/MSCR2/MSCR3/MSCR4
                      (    forth6809.asm):07096                     ; (confirmed untouched by SUBCOPY) rather than adding
                      (    forth6809.asm):07097                     ; dedicated cells: MSCR = current read position, MSCR2 =
                      (    forth6809.asm):07098                     ; running substitution count, MSCR3/MSCR4 = local scratch
                      (    forth6809.asm):07099                     ; per %-pair found. Reuses the existing COMPAREW for name
                      (    forth6809.asm):07100                     ; matching rather than a new comparison loop.

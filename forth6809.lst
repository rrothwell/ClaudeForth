                      (    forth6809.asm):09909         ; TSTCOMPCOMMA - unit test for COMPILE,. Compiles a call to
                      (    forth6809.asm):09910         ; DUP's own xt into scratch, then executes the result with a
                      (    forth6809.asm):09911         ; known value to confirm it genuinely behaves like DUP - not
                      (    forth6809.asm):09912         ; just that some bytes were written.
                      (    forth6809.asm):09913         ; ------------------------------------------------------------
C27B                  (    forth6809.asm):09914         TSTCOMPCOMMA: LDD  CODEHERE
                      (    forth6809.asm):09915                       STD  TSTCSAV
                      (    forth6809.asm):09916         
                      (    forth6809.asm):09917                       LDD  #TSTCBUF
                      (    forth6809.asm):09918                       STD  CODEHERE
                      (    forth6809.asm):09919         
                      (    forth6809.asm):09920                       LDD  #DUP
                      (    forth6809.asm):09921                       PSHU D
                      (    forth6809.asm):09922                       JSR  COMPILECOMMA
                      (    forth6809.asm):09923         
                      (    forth6809.asm):09924                       LDD  #OPRTS
                      (    forth6809.asm):09925                       PSHU D
                      (    forth6809.asm):09926                       JSR  CCOMMA
                      (    forth6809.asm):09927         
                      (    forth6809.asm):09928                       LDD  TSTCSAV
                      (    forth6809.asm):09929                       STD  CODEHERE
                      (    forth6809.asm):09930         
                      (    forth6809.asm):09931                       STU  TSTU0
                      (    forth6809.asm):09932         
                      (    forth6809.asm):09933                       LDD  #TSTGUARD
                      (    forth6809.asm):09934                       PSHU D
                      (    forth6809.asm):09935                       LDD  #TSTVAL1
                      (    forth6809.asm):09936                       PSHU D
                      (    forth6809.asm):09937                       STU  TSTUB4
                      (    forth6809.asm):09938         
                      (    forth6809.asm):09939                       LDX  #TSTCBUF
                      (    forth6809.asm):09940                       JSR  ,X
                      (    forth6809.asm):09941         
                      (    forth6809.asm):09942                       STU  TSTUAF
                      (    forth6809.asm):09943         
                      (    forth6809.asm):09944                       PULU D
                      (    forth6809.asm):09945                       CMPD #TSTVAL1
                      (    forth6809.asm):09946                       BNE  CCFAIL
                      (    forth6809.asm):09947                       PULU D
                      (    forth6809.asm):09948                       CMPD #TSTVAL1
                      (    forth6809.asm):09949                       BNE  CCFAIL
                      (    forth6809.asm):09950                       PULU D
                      (    forth6809.asm):09951                       CMPD #TSTGUARD
                      (    forth6809.asm):09952                       BNE  CCFAIL
                      (    forth6809.asm):09953         
                      (    forth6809.asm):09954                       LDD  TSTUB4
                      (    forth6809.asm):09955                       SUBD TSTUAF
                      (    forth6809.asm):09956                       CMPD #2
                      (    forth6809.asm):09957                       BNE  CCFAIL
                      (    forth6809.asm):09958         
                      (    forth6809.asm):09959                       LDD  #TRUEV
                      (    forth6809.asm):09960                       BRA  CCDONE
C27B                  (    forth6809.asm):09961         CCFAIL:       LDD  #FALSEV
C27B                  (    forth6809.asm):09962         CCDONE:       LDX  #TSTCCNAME
                      (    forth6809.asm):09963                       PSHU X
                      (    forth6809.asm):09964                       PSHU D
                      (    forth6809.asm):09965                       JSR  TSTREPORT
                      (    forth6809.asm):09966         

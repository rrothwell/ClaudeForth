E525 C10A             (    forth6809.asm):03978                  CMPB  #10
E527 27F1             (    forth6809.asm):03979                  BEQ   ALOOP
E529 C108             (    forth6809.asm):03980                  CMPB  #8
E52B 2724             (    forth6809.asm):03981                  BEQ   ABKSP
E52D C17F             (    forth6809.asm):03982                  CMPB  #127
E52F 2720             (    forth6809.asm):03983                  BEQ   ABKSP
                      (    forth6809.asm):03984         
E531 DC39             (    forth6809.asm):03985                  LDD   ACNT
E533 109335           (    forth6809.asm):03986                  CMPD  AMAX
E536 27E2             (    forth6809.asm):03987                  BEQ   ALOOP
                      (    forth6809.asm):03988         
E538 9E37             (    forth6809.asm):03989                  LDX   ABUFP

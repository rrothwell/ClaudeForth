                      (   unit_tests.asm):10348         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (   unit_tests.asm):10349         ; direct memory-access words (no compile-time behavior, no
                      (   unit_tests.asm):10350         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (   unit_tests.asm):10351         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (   unit_tests.asm):10352         ; same redirect-based safety established for sections 3.8/3.9.
                      (   unit_tests.asm):10353         ; TSTCBUF is reused here as general scratch memory for the
                      (   unit_tests.asm):10354         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (   unit_tests.asm):10355         ; runs exclusively of every other.
                      (   unit_tests.asm):10356         ;
                      (   unit_tests.asm):10357         ; MOVE is traced to genuinely choose its copy direction based on
                      (   unit_tests.asm):10358         ; comparing src and dst addresses (delegating to CMOVE or
                      (   unit_tests.asm):10359         ; CMOVE> as appropriate) - so its own tests specifically include
                      (   unit_tests.asm):10360         ; overlapping regions in both directions, not just a trivial
                      (   unit_tests.asm):10361         ; non-overlapping case, to verify that claim for real.
                      (   unit_tests.asm):10362         ; ------------------------------------------------------------
                      (   unit_tests.asm):10363         
                      (   unit_tests.asm):10364         ; ------------------------------------------------------------

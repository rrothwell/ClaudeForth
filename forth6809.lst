                      (    forth6809.asm):21437         ; ============================================================
                      (    forth6809.asm):21438         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):21439         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):21440         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):21441         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):21442         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):21443         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):21444         ; ============================================================
                      (    forth6809.asm):21445         ; ------------------------------------------------------------
                      (    forth6809.asm):21446         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):21447         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):21448         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):21449         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):21450         ; - no indirection, no value cell.
                      (    forth6809.asm):21451         ;
                      (    forth6809.asm):21452         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):21453         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):21454         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):21455         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):21456         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):21457         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):21458         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):21459         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):21460         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):21461         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):21462         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):21463         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):21464                    PSHU  D
FF3C 39               (    forth6809.asm):21465                    RTS
                      (    forth6809.asm):21466         
FF3D CC0000           (    forth6809.asm):21467         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):21468                    PSHU  D
FF42 39               (    forth6809.asm):21469                    RTS
                      (    forth6809.asm):21470         
                      (    forth6809.asm):21471         ; ------------------------------------------------------------
                      (    forth6809.asm):21472         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):21473         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):21474         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):21475         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):21476         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):21477         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):21478                    PSHU  D
FF48 39               (    forth6809.asm):21479                    RTS
                      (    forth6809.asm):21480         
FF49 CCFFFF           (    forth6809.asm):21481         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):21482                    PSHU  D
FF4E 39               (    forth6809.asm):21483                    RTS
                      (    forth6809.asm):21484         
FF4F CC0002           (    forth6809.asm):21485         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):21486                    PSHU  D
FF54 39               (    forth6809.asm):21487                    RTS
                      (    forth6809.asm):21488         
FF55 CCFFFE           (    forth6809.asm):21489         MTWOBODY:  LDD   #-2
FF58 3606             (    forth6809.asm):21490                    PSHU  D
FF5A 39               (    forth6809.asm):21491                    RTS

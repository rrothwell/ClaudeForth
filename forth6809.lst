                      (    forth6809.asm):03994         
                      (    forth6809.asm):03995         ; ------------------------------------------------------------
                      (    forth6809.asm):03996         ; SET-CURRENT  ( wid -- )
                      (    forth6809.asm):03997         ; Make wid the wordlist that receives new definitions. Throws -11 for
                      (    forth6809.asm):03998         ; an invalid wid.
                      (    forth6809.asm):03999         ; ------------------------------------------------------------
D6BB 3710             (    forth6809.asm):04000         SETCURW:    PULU  X

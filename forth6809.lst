                      (    forth6809.asm):06243         
                      (    forth6809.asm):06244                  LDD   #OPRTS
                      (    forth6809.asm):06245                  PSHU  D
                      (    forth6809.asm):06246                  JSR   CCOMMA
                      (    forth6809.asm):06247         
                      (    forth6809.asm):06248                  LDD   TSTCSAV
                      (    forth6809.asm):06249                  STD   CODEHERE
                      (    forth6809.asm):06250         
                      (    forth6809.asm):06251                  STU   TSTU0
                      (    forth6809.asm):06252         
                      (    forth6809.asm):06253                  LDD   #TSTGUARD
                      (    forth6809.asm):06254                  PSHU  D
                      (    forth6809.asm):06255                  LDD   #TRUEV
                      (    forth6809.asm):06256                  PSHU  D
                      (    forth6809.asm):06257                  STU   TSTUB4
                      (    forth6809.asm):06258         
                      (    forth6809.asm):06259                  JSR   TSTCBUF
                      (    forth6809.asm):06260         
                      (    forth6809.asm):06261                  STU   TSTUAF
                      (    forth6809.asm):06262         
                      (    forth6809.asm):06263                  PULU  D

                      (    forth6809.asm):02957         ; TSTSLASHZ - unit test for SLASH, divide-by-zero case. n2 = 0.
                      (    forth6809.asm):02958         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02959         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02960         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02961         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02962         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02963         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02964         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02965         ; there are.
                      (    forth6809.asm):02966         ; ------------------------------------------------------------

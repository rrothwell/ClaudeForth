DDB2 8EDDD0           (    forth6809.asm):02171                     LDX   #OKMSG
DDB5 3610             (    forth6809.asm):02172                     PSHU  X                 ; c-addr
DDB7 CC0004           (    forth6809.asm):02173                     LDD   #OKMSGL

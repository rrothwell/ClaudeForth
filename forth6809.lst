                      (    forth6809.asm):03309         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03310         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03311         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03312         ;    Inputs:
                      (    forth6809.asm):03313         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03314         ;    Outputs:
                      (    forth6809.asm):03315         ;        single number: n and -1
                      (    forth6809.asm):03316         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03317         ;        not a number: c-addr and 0
                      (    forth6809.asm):03318         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03319         ; ------------------------------------------------------------
E33E 3710             (    forth6809.asm):03320         NUMBERQ:    PULU  X                 ; c-addr
E340 9F1F             (    forth6809.asm):03321                     STX   CADDR
E342 A684             (    forth6809.asm):03322                     LDA   ,X
E344 2772             (    forth6809.asm):03323                     BEQ   NQBAD
E346 9721             (    forth6809.asm):03324                     STA   CNTREM
E348 3001             (    forth6809.asm):03325                     LEAX  1,X
                      (    forth6809.asm):03326         
                      (    forth6809.asm):03327                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03328                     ; digit count. See shadow: NUMBERQ.1
E34A D621             (    forth6809.asm):03329                     LDB   CNTREM
E34C 5A               (    forth6809.asm):03330                     DECB
E34D A685             (    forth6809.asm):03331                     LDA   B,X
E34F 812E             (    forth6809.asm):03332                     CMPA  #'.'

                      (    forth6809.asm):10902         ; ------------------------------------------------------------
                      (    forth6809.asm):10903         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10904         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10905         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10906         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10907         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10908         ; sequential walk-through per region.
                      (    forth6809.asm):10909         ;
                      (    forth6809.asm):10910         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10911         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10912         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10913         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10914         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10915         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10916         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10917         ; ------------------------------------------------------------
C278 BDFC2B           (    forth6809.asm):10918         TSTMEMORY: JSR CRW
C27B 8EC28C           (    forth6809.asm):10919                    LDX   #TSTMEMMSG
C27E 3610             (    forth6809.asm):10920                    PSHU  X
C280 CC0006           (    forth6809.asm):10921                    LDD   #6
C283 3606             (    forth6809.asm):10922                    PSHU  D
C285 BDF60B           (    forth6809.asm):10923                    JSR   TYPE
C288 BDFC2B           (    forth6809.asm):10924                    JSR   CRW
                      (    forth6809.asm):10925         
                      (    forth6809.asm):10926                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10927         
                      (    forth6809.asm):10928                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10929                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10930                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10931                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10932                    JSR   TSTCODEHERE
                      (    forth6809.asm):10933                    JSR   TSTVARHERE
                      (    forth6809.asm):10934                    JSR   TSTPAD
                      (    forth6809.asm):10935                    JSR   TSTUNUSED
                      (    forth6809.asm):10936                    JSR   TSTVUNUSED
                      (    forth6809.asm):10937                    JSR   TSTFILL
                      (    forth6809.asm):10938                    JSR   TSTERASE
                      (    forth6809.asm):10939                    JSR   TSTCMOVE
                      (    forth6809.asm):10940                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10941                    JSR   TSTMOVE1
                      (    forth6809.asm):10942                    JSR   TSTMOVE2
                      (    forth6809.asm):10943                    JSR   TSTMOVE3
                      (    forth6809.asm):10944         
                      (    forth6809.asm):10945                    ENDC ; <<<<
                      (    forth6809.asm):10946         
C28B 39               (    forth6809.asm):10947                    RTS
                      (    forth6809.asm):10948         
C28C 4D656D6F7279     (    forth6809.asm):10949         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10950         
                      (    forth6809.asm):10951                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10952         
                      (    forth6809.asm):10953         ; ------------------------------------------------------------
                      (    forth6809.asm):10954         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10955         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10956         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10957         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10958         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10959         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10960         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10961         ; runs exclusively of every other.
                      (    forth6809.asm):10962         ;
                      (    forth6809.asm):10963         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10964         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10965         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10966         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10967         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10968         ; ------------------------------------------------------------
                      (    forth6809.asm):10969         
                      (    forth6809.asm):10970         ; ------------------------------------------------------------
                      (    forth6809.asm):10971         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10972         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10973         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10974         ; ------------------------------------------------------------
C292                  (    forth6809.asm):10975         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10976         
                      (    forth6809.asm):10977                        LDD  #TSTGUARD
                      (    forth6809.asm):10978                        PSHU D
                      (    forth6809.asm):10979                        LDD  #TSTVAL1
                      (    forth6809.asm):10980                        PSHU D
                      (    forth6809.asm):10981                        LDD  #TSTCBUF
                      (    forth6809.asm):10982                        PSHU D
                      (    forth6809.asm):10983                        STU  TSTUB4
                      (    forth6809.asm):10984         
                      (    forth6809.asm):10985                        JSR  STOREW
                      (    forth6809.asm):10986         
                      (    forth6809.asm):10987                        LDD  #TSTCBUF
                      (    forth6809.asm):10988                        PSHU D
                      (    forth6809.asm):10989         
                      (    forth6809.asm):10990                        JSR  ATSIGN
                      (    forth6809.asm):10991         
                      (    forth6809.asm):10992                        STU  TSTUAF
                      (    forth6809.asm):10993         
                      (    forth6809.asm):10994                        PULU D
                      (    forth6809.asm):10995                        CMPD #TSTVAL1
                      (    forth6809.asm):10996                        BNE  FSFAIL
                      (    forth6809.asm):10997                        PULU D
                      (    forth6809.asm):10998                        CMPD #TSTGUARD
                      (    forth6809.asm):10999                        BNE  FSFAIL
                      (    forth6809.asm):11000         
                      (    forth6809.asm):11001                        LDD  TSTUB4
                      (    forth6809.asm):11002                        SUBD TSTUAF
                      (    forth6809.asm):11003                        CMPD #-2
                      (    forth6809.asm):11004                        BNE  FSFAIL
                      (    forth6809.asm):11005         
                      (    forth6809.asm):11006                        LDD  #TRUEV
                      (    forth6809.asm):11007                        BRA  FSDONE
C292                  (    forth6809.asm):11008         FSFAIL:        LDD  #FALSEV
C292                  (    forth6809.asm):11009         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):11010                        PSHU X
                      (    forth6809.asm):11011                        PSHU D
                      (    forth6809.asm):11012                        JSR  TSTREPORT
                      (    forth6809.asm):11013         
                      (    forth6809.asm):11014                        LDU  TSTU0
                      (    forth6809.asm):11015                        RTS
                      (    forth6809.asm):11016         
C292                  (    forth6809.asm):11017         TSTFSNAME: FCB  13
                      (    forth6809.asm):11018                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):11019         
                      (    forth6809.asm):11020         ; ------------------------------------------------------------
                      (    forth6809.asm):11021         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):11022         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):11023         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):11024         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):11025         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):11026         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):11027         ; whatever was there).
                      (    forth6809.asm):11028         ;
                      (    forth6809.asm):11029         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):11030         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):11031         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):11032         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):11033         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):11034         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):11035         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):11036         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):11037         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):11038         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):11039         ; byte ends up where was wrong.
                      (    forth6809.asm):11040         ; ------------------------------------------------------------
C292                  (    forth6809.asm):11041         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):11042                         STD  TSTCBUF
                      (    forth6809.asm):11043         
                      (    forth6809.asm):11044                         STU  TSTU0
                      (    forth6809.asm):11045         
                      (    forth6809.asm):11046                         LDD  #TSTGUARD
                      (    forth6809.asm):11047                         PSHU D
                      (    forth6809.asm):11048                         LDD  #$34
                      (    forth6809.asm):11049                         PSHU D
                      (    forth6809.asm):11050                         LDD  #TSTCBUF
                      (    forth6809.asm):11051                         PSHU D
                      (    forth6809.asm):11052                         STU  TSTUB4
                      (    forth6809.asm):11053         
                      (    forth6809.asm):11054                         JSR  CSTOREW
                      (    forth6809.asm):11055         
                      (    forth6809.asm):11056                         LDD  TSTCBUF
                      (    forth6809.asm):11057                         CMPD #$34FF
                      (    forth6809.asm):11058                         BNE  CFFAIL
                      (    forth6809.asm):11059         
                      (    forth6809.asm):11060                         LDD  #TSTCBUF
                      (    forth6809.asm):11061                         PSHU D
                      (    forth6809.asm):11062         
                      (    forth6809.asm):11063                         JSR  CFETCH
                      (    forth6809.asm):11064         
                      (    forth6809.asm):11065                         STU  TSTUAF
                      (    forth6809.asm):11066         
                      (    forth6809.asm):11067                         PULU D
                      (    forth6809.asm):11068                         CMPD #$0034
                      (    forth6809.asm):11069                         BNE  CFFAIL
                      (    forth6809.asm):11070                         PULU D
                      (    forth6809.asm):11071                         CMPD #TSTGUARD
                      (    forth6809.asm):11072                         BNE  CFFAIL
                      (    forth6809.asm):11073         
                      (    forth6809.asm):11074                         LDD  TSTUB4
                      (    forth6809.asm):11075                         SUBD TSTUAF
                      (    forth6809.asm):11076                         CMPD #-2
                      (    forth6809.asm):11077                         BNE  CFFAIL
                      (    forth6809.asm):11078         
                      (    forth6809.asm):11079                         LDD  #TRUEV
                      (    forth6809.asm):11080                         BRA  CFDONE
C292                  (    forth6809.asm):11081         CFFAIL:         LDD  #FALSEV
C292                  (    forth6809.asm):11082         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11083                         PSHU X
                      (    forth6809.asm):11084                         PSHU D
                      (    forth6809.asm):11085                         JSR  TSTREPORT
                      (    forth6809.asm):11086         
                      (    forth6809.asm):11087                         LDU  TSTU0
                      (    forth6809.asm):11088                         RTS
                      (    forth6809.asm):11089         
C292                  (    forth6809.asm):11090         TSTCFNAME: FCB  14
                      (    forth6809.asm):11091                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11092         
                      (    forth6809.asm):11093         ; ------------------------------------------------------------
                      (    forth6809.asm):11094         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11095         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11096         ; correctly.
                      (    forth6809.asm):11097         ; ------------------------------------------------------------
C292                  (    forth6809.asm):11098         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11099                       STD  TSTCBUF
                      (    forth6809.asm):11100         
                      (    forth6809.asm):11101                       STU  TSTU0
                      (    forth6809.asm):11102         
                      (    forth6809.asm):11103                       LDD  #TSTGUARD
                      (    forth6809.asm):11104                       PSHU D
                      (    forth6809.asm):11105                       LDD  #100
                      (    forth6809.asm):11106                       PSHU D
                      (    forth6809.asm):11107                       LDD  #TSTCBUF
                      (    forth6809.asm):11108                       PSHU D
                      (    forth6809.asm):11109                       STU  TSTUB4
                      (    forth6809.asm):11110         
                      (    forth6809.asm):11111                       JSR  PLUSSTORE
                      (    forth6809.asm):11112         
                      (    forth6809.asm):11113                       STU  TSTUAF
                      (    forth6809.asm):11114         
                      (    forth6809.asm):11115                       LDD  TSTCBUF
                      (    forth6809.asm):11116                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11117                       BNE  PSFAIL
                      (    forth6809.asm):11118         
                      (    forth6809.asm):11119                       PULU D
                      (    forth6809.asm):11120                       CMPD #TSTGUARD
                      (    forth6809.asm):11121                       BNE  PSFAIL
                      (    forth6809.asm):11122         
                      (    forth6809.asm):11123                       LDD  TSTUB4
                      (    forth6809.asm):11124                       SUBD TSTUAF
                      (    forth6809.asm):11125                       CMPD #-4
                      (    forth6809.asm):11126                       BNE  PSFAIL
                      (    forth6809.asm):11127         
                      (    forth6809.asm):11128                       LDD  #TRUEV
                      (    forth6809.asm):11129                       BRA  PSDONE
C292                  (    forth6809.asm):11130         PSFAIL:       LDD  #FALSEV
C292                  (    forth6809.asm):11131         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11132                       PSHU X
                      (    forth6809.asm):11133                       PSHU D
                      (    forth6809.asm):11134                       JSR  TSTREPORT
                      (    forth6809.asm):11135         
                      (    forth6809.asm):11136                       LDU  TSTU0
                      (    forth6809.asm):11137                       RTS
                      (    forth6809.asm):11138         
C292                  (    forth6809.asm):11139         TSTPSNAME: FCB  12
                      (    forth6809.asm):11140                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11141         
                      (    forth6809.asm):11142         ; ------------------------------------------------------------
                      (    forth6809.asm):11143         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11144         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11145         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11146         ; the documented convention on both ends).
                      (    forth6809.asm):11147         ; ------------------------------------------------------------
C292                  (    forth6809.asm):11148         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11149         
                      (    forth6809.asm):11150                         LDD  #TSTGUARD
                      (    forth6809.asm):11151                         PSHU D
                      (    forth6809.asm):11152                         LDD  #TSTVAL1
                      (    forth6809.asm):11153                         PSHU D
                      (    forth6809.asm):11154                         LDD  #TSTVAL2
                      (    forth6809.asm):11155                         PSHU D
                      (    forth6809.asm):11156                         LDD  #TSTCBUF
                      (    forth6809.asm):11157                         PSHU D
                      (    forth6809.asm):11158                         STU  TSTUB4
                      (    forth6809.asm):11159         

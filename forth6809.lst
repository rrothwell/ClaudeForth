                      (    forth6809.asm):03947         ; ------------------------------------------------------------
                      (    forth6809.asm):03948         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03949         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03950         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03951         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03952         ; ------------------------------------------------------------
D6E2 3706             (    forth6809.asm):03953         SETORDERW:  PULU  D                 ; n
D6E4 1083FFFF         (    forth6809.asm):03954                     CMPD  #-1
D6E8 275D             (    forth6809.asm):03955                     BEQ   ONLYW             ; the minimum order
D6EA 4D               (    forth6809.asm):03956         SO1:        TSTA
D6EB 2B31             (    forth6809.asm):03957                     BMI   SOUNDER
D6ED 262A             (    forth6809.asm):03958                     BNE   SOOVER
D6EF C108             (    forth6809.asm):03959                     CMPB  #WLMAX
D6F1 2226             (    forth6809.asm):03960                     BHI   SOOVER

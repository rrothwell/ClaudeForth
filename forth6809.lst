                      (    forth6809.asm):02107         
                      (    forth6809.asm):02108         ; ============================================================
                      (    forth6809.asm):02109         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02110         ; ============================================================
                      (    forth6809.asm):02111                     ORG   BASECODE  ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):02112                                     ; entirely - every routine from here through
                      (    forth6809.asm):02113                                     ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):02114                                     ; every primitive) would otherwise have
                      (    forth6809.asm):02115                                     ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):02116                                     ; WARM message left the location counter,
                      (    forth6809.asm):02117                                     ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02118                                     ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02119                                     ; instead of landing in BASECODE at all
                      (    forth6809.asm):02120         
                      (    forth6809.asm):02121         ; ------------------------------------------------------------
                      (    forth6809.asm):02122         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02123         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02124         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02125         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02126         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02127         ; ------------------------------------------------------------
                      (    forth6809.asm):02128         ; ------------------------------------------------------------
                      (    forth6809.asm):02129         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02130         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02131         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02132         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02133         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02134         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02135         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02136         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02137         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02138         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02139         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02140         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02141         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02142         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02143         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02144         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02145         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02146         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02147         ; not duplicated logic in either place.
                      (    forth6809.asm):02148         ; ------------------------------------------------------------
                      (    forth6809.asm):02149         
DD54 7F0176           (    forth6809.asm):02150         SERBUFCLR:  CLR  INHEAD
DD57 7F0177           (    forth6809.asm):02151                     CLR  INTAIL
DD5A 7F0178           (    forth6809.asm):02152                     CLR  RTSSTATE    ; $00 = RTS Low (Clear)
DD5D 7F0179           (    forth6809.asm):02153                     CLR  OUTHEAD
DD60 7F017A           (    forth6809.asm):02154                     CLR  OUTTAIL
DD63 7F017B           (    forth6809.asm):02155                     CLR  OUTACTIVITY  ; $00 = Idle
                      (    forth6809.asm):02156         
                      (    forth6809.asm):02157         
DD66 7F017C           (    forth6809.asm):02158                     CLR  FECOUNT
DD69 7F017D           (    forth6809.asm):02159                     CLR  OVRNCOUNT
DD6C 7F017E           (    forth6809.asm):02160                     CLR  PECOUNT
DD6F 7F017F           (    forth6809.asm):02161                     CLR  POLLREADYCNT
DD72 39               (    forth6809.asm):02162                     RTS
                      (    forth6809.asm):02163         
DD73 BDDD54           (    forth6809.asm):02164         INITSERIAL: JSR  SERBUFCLR
DD76 9603             (    forth6809.asm):02165                     LDA   CR_RESET    ; Master Software Reset command to 6850
DD78 B7C008           (    forth6809.asm):02166                     STA   ACIACR 
DD7B 12               (    forth6809.asm):02167                     NOP               ; Settling Delay
DD7C 12               (    forth6809.asm):02168                     NOP
                      (    forth6809.asm):02169                     
                      (    forth6809.asm):02170                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02171                     LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02172                     ELSE  ; <<<<<>>>>>
DD7D 8615             (    forth6809.asm):02173                     LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02174                     ENDC  ; <<<<<<<<<<
DD7F B7C008           (    forth6809.asm):02175                     STA   ACIACR         ; was "STA ACIA" - same fix
DD82 39               (    forth6809.asm):02176                     RTS
                      (    forth6809.asm):02177         
                      (    forth6809.asm):02178                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02179         ; ------------------------------------------------------------
                      (    forth6809.asm):02180         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):02181         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):02182         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):02183         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):02184         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02185         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02186                     SUBA  INTAIL
                      (    forth6809.asm):02187                     ANDA  #INBUFSZ-1
                      (    forth6809.asm):02188                     RTS
                      (    forth6809.asm):02189         ; ------------------------------------------------------------
                      (    forth6809.asm):02190         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):02191         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):02192         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):02193         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):02194         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):02195         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):02196         ; flow control, not a chip feature.
                      (    forth6809.asm):02197         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02198         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):02199                     CMPA #INHIWATER
                      (    forth6809.asm):02200                     BLO  RTSCHIDONE
                      (    forth6809.asm):02201                     TST  RTSSTATE
                      (    forth6809.asm):02202                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02203                     LDA  #CR_RTSHI
                      (    forth6809.asm):02204                     STA  ACIACR
                      (    forth6809.asm):02205                     LDA  #1
                      (    forth6809.asm):02206                     STA  RTSSTATE
DD83                  (    forth6809.asm):02207         RTSCHIDONE: RTS
                      (    forth6809.asm):02208         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02209         UPDATE_RTS:
                      (    forth6809.asm):02210                     TST   RTSSTATE
                      (    forth6809.asm):02211                     BNE   SET_RTS_HI_TX_OFF      
                      (    forth6809.asm):02212         
                      (    forth6809.asm):02213                     TST   OUTACTIVITY           ; Is active?
                      (    forth6809.asm):02214                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02215         
                      (    forth6809.asm):02216                                           ; $B5/%1011_0101
                      (    forth6809.asm):02217                     LDA   #CR_RXTX        ; Yes! Accept input & transmit output
                      (    forth6809.asm):02218                     BRA   WRITE_CR        ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02219         
DD83                  (    forth6809.asm):02220         SET_RTS_LO_TX_OFF:                ; $95/%10010101
                      (    forth6809.asm):02221                     LDA   #CR_RXON        ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02222                     BRA   WRITE_CR        ; Why is OUTACTIVITY not updated here?
                      (    forth6809.asm):02223         
DD83                  (    forth6809.asm):02224         SET_RTS_HI_TX_OFF:                ; $D5/%1101_0101
                      (    forth6809.asm):02225                     LDA   #CR_RTSHI       ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02226                     CLR   OUTACTIVITY     ; Interrupts are hardware-disabled; clear state
DD83                  (    forth6809.asm):02227         WRITE_CR:
                      (    forth6809.asm):02228                     STA   ACIACR
                      (    forth6809.asm):02229                     RTS
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
                      (    forth6809.asm):02231         ; CHKHI/CHKLO - replace the old combined CHKWATERLEVEL. That
                      (    forth6809.asm):02232         ; routine always paid for a TST RTSSTATE/BNE to pick a
                      (    forth6809.asm):02233         ; direction (hi vs lo) before checking either watermark - but
                      (    forth6809.asm):02234         ; the direction picked never actually depended on which caller
                      (    forth6809.asm):02235         ; was asking, only on the current RTSSTATE, and each caller
                      (    forth6809.asm):02236         ; only ever moves fill one way: INCHAR (via CHKHI) only ever
                      (    forth6809.asm):02237         ; adds to the ring, so only the hi threshold can ever usefully
                      (    forth6809.asm):02238         ; fire from that side; GETCHAR (via CHKLO) only ever drains it,
                      (    forth6809.asm):02239         ; so only the lo threshold can fire from that side. Whenever
                      (    forth6809.asm):02240         ; the old routing sent a caller into the "wrong" branch for its
                      (    forth6809.asm):02241         ; own direction (e.g. INCHAR landing in CHK_LO while RTSSTATE
                      (    forth6809.asm):02242         ; was REJECT), the comparison was provably always a no-op from
                      (    forth6809.asm):02243         ; that caller - the fill level only ever moves the way that
                      (    forth6809.asm):02244         ; caller pushes it, so the other threshold's condition can't
                      (    forth6809.asm):02245         ; newly become true there. Splitting into two direction-fixed
                      (    forth6809.asm):02246         ; routines removes that dead branch+comparison from both
                      (    forth6809.asm):02247         ; callers, and both take the current fill level pre-computed in
                      (    forth6809.asm):02248         ; RegB rather than reloading INHEAD/INTAIL themselves, so a
                      (    forth6809.asm):02249         ; caller that already has one of the two pointers in a register
                      (    forth6809.asm):02250         ; (see INCHAR) doesn't pay for a redundant reload.
                      (    forth6809.asm):02251         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02252         CHKHI:
                      (    forth6809.asm):02253                     CMPB  #INHIWATER      ; Is the buffer near full?
                      (    forth6809.asm):02254                     BLO   CHKHIDONE       ; No! Do nothing.
                      (    forth6809.asm):02255                     TST   RTSSTATE
                      (    forth6809.asm):02256                     BNE   CHKHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02257                     LDA   #INREJECT       ; Yes! De-assert RTS.
                      (    forth6809.asm):02258                     STA   RTSSTATE
                      (    forth6809.asm):02259                     JSR   UPDATE_RTS
DD83                  (    forth6809.asm):02260         CHKHIDONE:  RTS
                      (    forth6809.asm):02261         
DD83                  (    forth6809.asm):02262         CHKLO:
                      (    forth6809.asm):02263                     CMPB  #INLOWATER      ; Is the buffer near empty?
                      (    forth6809.asm):02264                     BHS   CHKLODONE       ; No! Do nothing.
                      (    forth6809.asm):02265                     TST   RTSSTATE
                      (    forth6809.asm):02266                     BEQ   CHKLODONE       ; already low - nothing to do
                      (    forth6809.asm):02267                     LDA   #INACCEPT       ; Yes! Assert RTS.
                      (    forth6809.asm):02268                     STA   RTSSTATE
                      (    forth6809.asm):02269                     JSR   UPDATE_RTS
DD83                  (    forth6809.asm):02270         CHKLODONE:  RTS
                      (    forth6809.asm):02271         ; ------------------------------------------------------------
                      (    forth6809.asm):02272         ; BUG FIX: this used to loop internally (BRA back to the top)
                      (    forth6809.asm):02273         ; until the whole OUTBUF drained or CTS blocked - an unbounded
                      (    forth6809.asm):02274         ; spin of up to ~64 characters (~5.5ms at 115200 baud). In
                      (    forth6809.asm):02275         ; practice only one character was ever observed to be processed
                      (    forth6809.asm):02276         ; per call anyway (TDRE is rarely ready again this soon after
                      (    forth6809.asm):02277         ; sending), so this now makes that explicit: sends at most ONE
                      (    forth6809.asm):02278         ; character per call and returns unconditionally, whatever the
                      (    forth6809.asm):02279         ; reason (buffer empty, CTS-blocked, TDRE not ready yet, or a
                      (    forth6809.asm):02280         ; character actually sent - including the TDRE-not-ready case,
                      (    forth6809.asm):02281         ; which used to spin-wait right here and now instead just
                      (    forth6809.asm):02282         ; returns to try again on the next call). Every caller (KEY,
                      (    forth6809.asm):02283         ; PUTCHAR) already calls this once per character it handles on
                      (    forth6809.asm):02284         ; its own side, so the buffer still drains at essentially the
                      (    forth6809.asm):02285         ; same rate - this removes the unbounded worst case and the
                      (    forth6809.asm):02286         ; TDRE spin-wait, without changing normal-case throughput.
DD83                  (    forth6809.asm):02287         FLUSHOUTBUFFER:
                      (    forth6809.asm):02288                     LDB   OUTTAIL
                      (    forth6809.asm):02289                     CMPB  OUTHEAD          ; Is transmit buffer empty?
                      (    forth6809.asm):02290                     BEQ   FLUSHED          ; Yes! Exit.
                      (    forth6809.asm):02291         
                      (    forth6809.asm):02292                     LDA   ACIASR           ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02293                     BITA  #SR_CTS
                      (    forth6809.asm):02294                     BNE   FLUSHED          ; Yes! Exit.
                      (    forth6809.asm):02295         
                      (    forth6809.asm):02296                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02297                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02298                                              ; than spin-wait here.
                      (    forth6809.asm):02299         
                      (    forth6809.asm):02300                     LDX   #OUTBUF         ; The out buffer is occupied.
                      (    forth6809.asm):02301                     LDA   B,X             ; Get the character from the out buffer.
                      (    forth6809.asm):02302                     STA   ACIADR          ; Transmit character.
                      (    forth6809.asm):02303         
                      (    forth6809.asm):02304                     INCB                  ; Update tail pointer to next character slot.
                      (    forth6809.asm):02305                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02306                     STB   OUTTAIL
                      (    forth6809.asm):02307                                           ; One character sent - return rather than
                      (    forth6809.asm):02308                                           ; loop back for more (see header comment).
DD83                  (    forth6809.asm):02309         FLUSHED:
                      (    forth6809.asm):02310                 RTS
                      (    forth6809.asm):02311         ; ------------------------------------------------------------
                      (    forth6809.asm):02312         ; PUTCHAR
                      (    forth6809.asm):02313         ;    Inputs:
                      (    forth6809.asm):02314         ;        RegA = character to insert into transmit buffer.
                      (    forth6809.asm):02315         ;    Outputs:
                      (    forth6809.asm):02316         ;        none 
                      (    forth6809.asm):02317         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02318         PUTCHAR:
                      (    forth6809.asm):02319                     PSHS  CC,X              
                      (    forth6809.asm):02320                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02321         
                      (    forth6809.asm):02322                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02323                     INCB
                      (    forth6809.asm):02324                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02325                     CMPB  OUTTAIL
                      (    forth6809.asm):02326                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02327         
                      (    forth6809.asm):02328                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02329                     LDB   OUTHEAD
                      (    forth6809.asm):02330                     STA   B,X
                      (    forth6809.asm):02331         
                      (    forth6809.asm):02332                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02333                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02334                     STB   OUTHEAD
                      (    forth6809.asm):02335         
                      (    forth6809.asm):02336                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02337                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02338         
                      (    forth6809.asm):02339                     ; RTS is high (REJECT): CR_RTSHI hardware-disables the TX
                      (    forth6809.asm):02340                     ; interrupt, so nothing will ever drain OUTBUF except this
                      (    forth6809.asm):02341                     ; polling fallback. BUG FIX: FLUSHOUTBUFFER can take until
                      (    forth6809.asm):02342                     ; the whole OUTBUF drains (up to ~64 chars, ~5.5ms at 115200
                      (    forth6809.asm):02343                     ; baud) - running that under PUTCHAR's own ORCC #$50 masked
                      (    forth6809.asm):02344                     ; IRQ+FIRQ for the entire span, which is exactly why RTS
                      (    forth6809.asm):02345                     ; went high in the first place: the receiver was under
                      (    forth6809.asm):02346                     ; pressure, and masking IRQ here stops IRQH's own INCHAR
                      (    forth6809.asm):02347                     ; path from servicing it, guaranteeing overruns. Unmask
                      (    forth6809.asm):02348                     ; around the call - FLUSHOUTBUFFER only touches OUTHEAD/
                      (    forth6809.asm):02349                     ; OUTTAIL/ACIACR, none of which IRQH's RX path (INHEAD/
                      (    forth6809.asm):02350                     ; INTAIL) touches, so there is no correctness reason to
                      (    forth6809.asm):02351                     ; keep the receiver blind while this runs.
                      (    forth6809.asm):02352                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02353                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02354                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02355                                              ; expects the critical section active
                      (    forth6809.asm):02356         
                      (    forth6809.asm):02357                     BRA   PUT_EXIT
                      (    forth6809.asm):02358         
                      (    forth6809.asm):02359         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02360         ; priming the pump by transmitting a character.
DD83                  (    forth6809.asm):02361         CHK_INT_PATH:
                      (    forth6809.asm):02362                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02363                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365                                             ; No! Restart.
                      (    forth6809.asm):02366                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02367                     LDB   OUTTAIL
                      (    forth6809.asm):02368                     LDA   B,X 
                      (    forth6809.asm):02369                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02370         
                      (    forth6809.asm):02371                     INCB                    ; Update the tail pointer 
                      (    forth6809.asm):02372                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02373                     STB   OUTTAIL
                      (    forth6809.asm):02374         
                      (    forth6809.asm):02375                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02376                     STA   OUTACTIVITY
                      (    forth6809.asm):02377                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.       
                      (    forth6809.asm):02378         
DD83                  (    forth6809.asm):02379         PUT_EXIT:
                      (    forth6809.asm):02380                     PULS  CC,X,PC           ; Leaving the critical section, 
                      (    forth6809.asm):02381                                             ; by restoring the CC.
                      (    forth6809.asm):02382         ; ------------------------------------------------------------
                      (    forth6809.asm):02383         ; GETCHAR
                      (    forth6809.asm):02384         ;    Inputs: 
                      (    forth6809.asm):02385         ;        none
                      (    forth6809.asm):02386         ;    Outputs: 
                      (    forth6809.asm):02387         ;         RegA  = next character retrieved from receive buffer.
                      (    forth6809.asm):02388         ;         RegCC(carry) = valid?.
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02390         GETCHAR:
                      (    forth6809.asm):02391                     LDB   INTAIL           ; Is the out buffer populated?
                      (    forth6809.asm):02392                     CMPB  INHEAD           
                      (    forth6809.asm):02393                     BEQ   GET_NO_CHAR       ; No! Exit.       
                      (    forth6809.asm):02394         
                      (    forth6809.asm):02395                     LDX   #INBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02396                                 LDA   B,X 
                      (    forth6809.asm):02397         
                      (    forth6809.asm):02398                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02399                     ANDB  #INBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02400                     STB   INTAIL
                      (    forth6809.asm):02401         
                      (    forth6809.asm):02402                     ; BUG FIX: CHKLO reads-then-writes RTSSTATE/OUTACTIVITY and
                      (    forth6809.asm):02403                     ; can write ACIACR (via UPDATE_RTS) - state IRQH's own
                      (    forth6809.asm):02404                     ; INCHAR path also reads and writes, by calling CHKHI too
                      (    forth6809.asm):02405                     ; (safely, from ISR context, where interrupts are already
                      (    forth6809.asm):02406                     ; hardware-masked). GETCHAR is only ever called from
                      (    forth6809.asm):02407                     ; mainline code (KEY), unmasked, so without masking here an
                      (    forth6809.asm):02408                     ; interrupt landing mid-call could race this call against
                      (    forth6809.asm):02409                     ; IRQH's own concurrent one, leaving RTSSTATE corrupted or
                      (    forth6809.asm):02410                     ; ACIACR written twice with conflicting values. Masked here
                      (    forth6809.asm):02411                     ; (IRQ only, matching RTSCHECKLO's own existing discipline
                      (    forth6809.asm):02412                     ; below) rather than inside CHKLO itself, since CHKHI's
                      (    forth6809.asm):02413                     ; ISR-context caller must NOT unmask IRQ before its own RTI.
                      (    forth6809.asm):02414                     ; The fill-level read is inside the same masked span, for
                      (    forth6809.asm):02415                     ; the same reason: INHEAD could be mid-update by the ISR.
                      (    forth6809.asm):02416                     ORCC  #$10
                      (    forth6809.asm):02417                     LDB   INHEAD           ; Calculate current fill level fresh -
                      (    forth6809.asm):02418                     SUBB  INTAIL           ; both pointers may have moved since
                      (    forth6809.asm):02419                     ANDB  #INBUFSZ-1       ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02420                                             ; there's no already-loaded value here
                      (    forth6809.asm):02421                                             ; worth reusing.
                      (    forth6809.asm):02422                     JSR   CHKLO
                      (    forth6809.asm):02423                     ANDCC #$EF
                      (    forth6809.asm):02424         
                      (    forth6809.asm):02425                     ANDCC #$FE               ; Carry flag %0 = valid character
                      (    forth6809.asm):02426                     RTS
                      (    forth6809.asm):02427         
DD83                  (    forth6809.asm):02428         GET_NO_CHAR:
                      (    forth6809.asm):02429                     ORCC  #$01               ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02430                     RTS
                      (    forth6809.asm):02431         ; ------------------------------------------------------------
                      (    forth6809.asm):02432         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):02433         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):02434         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):02435         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):02436         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):02437         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):02438         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):02439         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):02440         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02441         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02442         RTSCHECKLO: 
                      (    forth6809.asm):02443                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02444         
                      (    forth6809.asm):02445                                 JSR  INFILL
                      (    forth6809.asm):02446                     CMPA #INLOWATER
                      (    forth6809.asm):02447                     BHI  RTSCLODONE
                      (    forth6809.asm):02448                     TST  RTSSTATE
                      (    forth6809.asm):02449                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):02450         
                      (    forth6809.asm):02451         
                      (    forth6809.asm):02452                     CLR  RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02453         
                      (    forth6809.asm):02454                     LDB  OUTTAIL           ; Check if chars are available.  
                      (    forth6809.asm):02455                     CMPB OUTHEAD
                      (    forth6809.asm):02456                     BEQ  RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02457         
                      (    forth6809.asm):02458                     LDA  #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02459                     STA  ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02460                     BRA  RTSCLOUNMASK
                      (    forth6809.asm):02461         
DD83                  (    forth6809.asm):02462         RTSCLONOTX: LDA  #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02463                     STA  ACIACR
                      (    forth6809.asm):02464         
DD83                  (    forth6809.asm):02465         RTSCLOUNMASK: ANDCC #$EF
                      (    forth6809.asm):02466         
DD83                  (    forth6809.asm):02467         RTSCLODONE: RTS
                      (    forth6809.asm):02468         
                      (    forth6809.asm):02469         ; ------------------------------------------------------------
                      (    forth6809.asm):02470         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02471         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02472         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02473         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02474         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02475         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02476         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02477         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02478         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02479         ;
                      (    forth6809.asm):02480         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02481         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02482         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02483         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02484         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02485         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02486         ;
                      (    forth6809.asm):02487         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02488         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02489         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02490         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02491         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02492         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02493         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02494         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02495         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02496         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02497         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02498         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02499         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02500         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02501         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02502         
                      (    forth6809.asm):02503                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02504                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02505                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02506                     BNE   INCHAR
                      (    forth6809.asm):02507                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02508                     BNE   OUTCHAR
                      (    forth6809.asm):02509                                             ; Ignore all other interrupts such as DCD change.
DD83                  (    forth6809.asm):02510         IRQDONE0:  RTI                      ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02511                                             ; & restores state.
                      (    forth6809.asm):02512         
DD83                  (    forth6809.asm):02513         INCHAR:
                      (    forth6809.asm):02514                     LDB   ACIADR               ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02515                     BITA  #SR_FE+SR_OVRN+SR_PE ; Any receiver error flagged?
                      (    forth6809.asm):02516                     BEQ   INOK                 ; No! - character is good, keep it.
                      (    forth6809.asm):02517                                              
                      (    forth6809.asm):02518                     BITA  #SR_FE               ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02519                     BEQ   INXFE                ; Tally each flagged error independently -
                      (    forth6809.asm):02520                     INC   FECOUNT              ; more than one bit can be set at once.
DD83                  (    forth6809.asm):02521         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02522                     BEQ   INXOVRN
                      (    forth6809.asm):02523                     INC   OVRNCOUNT
DD83                  (    forth6809.asm):02524         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02525                     BEQ   INXPE
                      (    forth6809.asm):02526                     INC   PECOUNT 
DD83                  (    forth6809.asm):02527         INXPE:      RTI         
                      (    forth6809.asm):02528         
DD83                  (    forth6809.asm):02529         INOK:    TFR   B,A                  ; Transfer good character from the receiver.
                      (    forth6809.asm):02530                  LDX   #INBUF               ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02531                  LDB   INHEAD
                      (    forth6809.asm):02532                  STA   B,X
                      (    forth6809.asm):02533                  INCB                  ; Figure out the new head,
                      (    forth6809.asm):02534                  ANDB  #INBUFSZ-1      ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02535                  CMPB  INTAIL          ; Would the new head slot meet the tail?
                      (    forth6809.asm):02536                  BEQ   IRQDONE1        ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02537                  STB   INHEAD          ; New head pointer is OK so store it.
                      (    forth6809.asm):02538                  ;JSR   RTSCHECKHI     ; Protect the in buffer from overflow.
                      (    forth6809.asm):02539                                        ; OPTIMIZATION: RegB still holds the new head
                      (    forth6809.asm):02540                                        ; value STB just stored (STB doesn't clobber
                      (    forth6809.asm):02541                                        ; it) - reuse it directly to get the fill
                      (    forth6809.asm):02542                                        ; level, rather than have CHKHI reload INHEAD
                      (    forth6809.asm):02543                                        ; from memory. This is the single hottest
                      (    forth6809.asm):02544                                        ; per-character path in the system (it runs
                      (    forth6809.asm):02545                                        ; on every byte received), so a redundant
                      (    forth6809.asm):02546                                        ; 4-cycle load here is worth avoiding.
                      (    forth6809.asm):02547                  SUBB  INTAIL          ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02548                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02549                  JSR   CHKHI           ; Protect the in buffer from overflow.
DD83                  (    forth6809.asm):02550         IRQDONE1: RTI
                      (    forth6809.asm):02551         
                      (    forth6809.asm):02552                  ; LDA   ACIASR          ; Recheck if the transmitter is ready.
                      (    forth6809.asm):02553                  ; BITA  #SR_TDRE        ; after handling the received character.
                      (    forth6809.asm):02554                  ; BEQ IRQDONE2          ; Yes! Process the char.
                      (    forth6809.asm):02555         
DD83                  (    forth6809.asm):02556         OUTCHAR: LDB   OUTTAIL         ; Is the out buffer empty?
                      (    forth6809.asm):02557                  CMPB  OUTHEAD
                      (    forth6809.asm):02558                  BEQ   TXOFF           ; Yes! Stop transmitting.
                      (    forth6809.asm):02559         
                      (    forth6809.asm):02560                  LDX   #OUTBUF         ; No! The out buffer is occupied.
                      (    forth6809.asm):02561                  LDA   B,X             ; Get the character from the out buffer.
                      (    forth6809.asm):02562                  STA   ACIADR          ; Transmit the char.
                      (    forth6809.asm):02563         
                      (    forth6809.asm):02564                  INCB                  ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02565                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02566                  STB   OUTTAIL
DD83                  (    forth6809.asm):02567         IRQDONE2  RTI
                      (    forth6809.asm):02568         
DD83                  (    forth6809.asm):02569         TXOFF:   ; TST   RTSSTATE        ; The buffer is empty.
                      (    forth6809.asm):02570                  ; BNE   IRQDONE3         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02571                                        ; or this would incorrectly drop it back low
                      (    forth6809.asm):02572                  ; LDA   #CR_RXON
                      (    forth6809.asm):02573                  ; STA   ACIACR
                      (    forth6809.asm):02574                  CLR   OUTACTIVITY         
                      (    forth6809.asm):02575                  JSR   UPDATE_RTS         
DD83                  (    forth6809.asm):02576         IRQDONE3 RTI
                      (    forth6809.asm):02577         
                      (    forth6809.asm):02578                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):02579         
DD83 3B               (    forth6809.asm):02580         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02581                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02582                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02583                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02584                                       ; the other unused vectors below
                      (    forth6809.asm):02585                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02586         
DD84 3B               (    forth6809.asm):02587         SWI3H:   RTI
DD85 3B               (    forth6809.asm):02588         SWI2H:   RTI
DD86 3B               (    forth6809.asm):02589         FIRQH:   RTI
DD87 3B               (    forth6809.asm):02590         NMIH:    RTI                   ; unused now that NMI -> WARM
DD88 CCFF9D           (    forth6809.asm):02591         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DD8B 3606             (    forth6809.asm):02592                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DD8D 7EE5E4           (    forth6809.asm):02593                  JMP   THROW
                      (    forth6809.asm):02594         
                      (    forth6809.asm):02595         ; ============================================================
                      (    forth6809.asm):02596         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02597         ; ============================================================
DD90 CC021B           (    forth6809.asm):02598         COLD:    LDD   #APPVARS
DD93 DD0A             (    forth6809.asm):02599                  STD   VARHERE
DD95 CC7000           (    forth6809.asm):02600                  LDD   #APPCODE
DD98 DD08             (    forth6809.asm):02601                  STD   CODEHERE
DD9A CC2000           (    forth6809.asm):02602                  LDD   #APPDICT
DD9D DD06             (    forth6809.asm):02603                  STD   DPHERE
DD9F CCDD4D           (    forth6809.asm):02604                  LDD   #BASELATEST
DDA2 DD04             (    forth6809.asm):02605                  STD   LATEST
                      (    forth6809.asm):02606         
DDA4 CC000A           (    forth6809.asm):02607                  LDD   #10
DDA7 DD02             (    forth6809.asm):02608                  STD   BASE
                      (    forth6809.asm):02609         
DDA9 CC0106           (    forth6809.asm):02610                  LDD   #TIBBUF
DDAC DDDB             (    forth6809.asm):02611                  STD   SRCADDR
DDAE CC0000           (    forth6809.asm):02612                  LDD   #0
DDB1 DDDD             (    forth6809.asm):02613                  STD   SRCLEN
DDB3 DDDF             (    forth6809.asm):02614                  STD   SRCID
                      (    forth6809.asm):02615         
DDB5 8EDE3D           (    forth6809.asm):02616                  LDX   #SIGNON
DDB8 3610             (    forth6809.asm):02617                  PSHU  X
DDBA CC000F           (    forth6809.asm):02618                  LDD   #SIGNONL
DDBD 3606             (    forth6809.asm):02619                  PSHU  D
DDBF BDF56F           (    forth6809.asm):02620                  JSR   TYPE
DDC2 BDFB95           (    forth6809.asm):02621                  JSR   CRW
                      (    forth6809.asm):02622                  ; falls through into ABORT
                      (    forth6809.asm):02623         
DDC5 CEBD00           (    forth6809.asm):02624         ABORT:   LDU   #SP0
                      (    forth6809.asm):02625                  ; falls through into QUIT
                      (    forth6809.asm):02626         
DDC8 10CEC000         (    forth6809.asm):02627         QUIT:    LDS   #RP0
DDCC CC0000           (    forth6809.asm):02628                  LDD   #0        ; BUG FIX: this reset used to live at QLOOP
DDCF DD00             (    forth6809.asm):02629                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02630                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02631                                   ; that spans more than one line of input.
                      (    forth6809.asm):02632                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02633                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02634                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02635                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02636                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02637                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02638                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02639                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02640                                   ; been reached. A colon definition split
                      (    forth6809.asm):02641                                   ; across multiple lines would have every
                      (    forth6809.asm):02642                                   ; word on every line after the first
                      (    forth6809.asm):02643                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02644                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02645                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02646                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02647                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02648                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02649                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02650                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02651                                   ; uncaught error routing back through ABORT

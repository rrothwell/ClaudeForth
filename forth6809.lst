                      (    forth6809.asm):05027         ; DO  ( C: -- dest )
                      (    forth6809.asm):05028         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):05029         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):05030         ; ------------------------------------------------------------
DC02 CCDC14           (    forth6809.asm):05031         DOW:        LDD   #DOSETUP
DC05 3606             (    forth6809.asm):05032                     PSHU  D
DC07 BDDE7F           (    forth6809.asm):05033                     JSR   CCALL
DC0A DC08             (    forth6809.asm):05034                     LDD   CODEHERE
DC0C 3606             (    forth6809.asm):05035                     PSHU  D                 ; dest
DC0E CC0003           (    forth6809.asm):05036                     LDD   #TAGDO
DC11 3606             (    forth6809.asm):05037                     PSHU  D
DC13 39               (    forth6809.asm):05038                     RTS
                      (    forth6809.asm):05039         
                      (    forth6809.asm):05040         ; ------------------------------------------------------------
                      (    forth6809.asm):05041         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):05042         ; return address.
                      (    forth6809.asm):05043         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):05044         ;    Inputs:
                      (    forth6809.asm):05045         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05046         ;    Outputs:
                      (    forth6809.asm):05047         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):05048         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05049         ; ------------------------------------------------------------
DC14 3706             (    forth6809.asm):05050         DOSETUP:    PULU  D                 ; index
DC16 DD14             (    forth6809.asm):05051                     STD   MSCR
DC18 3706             (    forth6809.asm):05052                     PULU  D                 ; limit
DC1A DD16             (    forth6809.asm):05053                     STD   MSCR2
DC1C 3510             (    forth6809.asm):05054                     PULS  X
DC1E CC0000           (    forth6809.asm):05055                     LDD   #0
DC21 3406             (    forth6809.asm):05056                     PSHS  D
DC23 DC16             (    forth6809.asm):05057                     LDD   MSCR2
DC25 3406             (    forth6809.asm):05058                     PSHS  D
DC27 DC14             (    forth6809.asm):05059                     LDD   MSCR
DC29 3406             (    forth6809.asm):05060                     PSHS  D
DC2B 3410             (    forth6809.asm):05061                     PSHS  X
DC2D 39               (    forth6809.asm):05062                     RTS
                      (    forth6809.asm):05063         
                      (    forth6809.asm):05064         ; ------------------------------------------------------------
                      (    forth6809.asm):05065         ; I  ( -- n )
                      (    forth6809.asm):05066         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):05067         ; address).
                      (    forth6809.asm):05068         ; ------------------------------------------------------------
DC2E EC62             (    forth6809.asm):05069         IW:         LDD   2,S               ; n. See bugfix: IW.1
DC30 3606             (    forth6809.asm):05070                     PSHU  D
DC32 39               (    forth6809.asm):05071                     RTS
                      (    forth6809.asm):05072         
                      (    forth6809.asm):05073         ; ------------------------------------------------------------
                      (    forth6809.asm):05074         ; J  ( -- n )
                      (    forth6809.asm):05075         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05076         ; address and the inner loop frame).
                      (    forth6809.asm):05077         ; ------------------------------------------------------------
DC33 EC68             (    forth6809.asm):05078         JW:         LDD   8,S               ; n. See bugfix: JW.1
DC35 3606             (    forth6809.asm):05079                     PSHU  D
DC37 39               (    forth6809.asm):05080                     RTS
                      (    forth6809.asm):05081         
                      (    forth6809.asm):05082         ; ------------------------------------------------------------
                      (    forth6809.asm):05083         ; LEAVE  ( -- )
                      (    forth6809.asm):05084         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05085         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05086         ; ------------------------------------------------------------
DC38 CCFFFF           (    forth6809.asm):05087         LEAVEW:     LDD   #TRUEV            ; true
DC3B ED66             (    forth6809.asm):05088                     STD   6,S               ; See bugfix: LEAVEW.1
DC3D 39               (    forth6809.asm):05089                     RTS
                      (    forth6809.asm):05090         
                      (    forth6809.asm):05091         ; ------------------------------------------------------------
                      (    forth6809.asm):05092         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05093         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05094         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05095         ; ------------------------------------------------------------
DC3E 3706             (    forth6809.asm):05096         LOOPW:      PULU  D
DC40 10830003         (    forth6809.asm):05097                     CMPD  #TAGDO
DC44 2703             (    forth6809.asm):05098                     BEQ   LOOPOK
DC46 BDDA0F           (    forth6809.asm):05099                     JSR   CFERR
DC49 3706             (    forth6809.asm):05100         LOOPOK:     PULU  D                 ; dest
DC4B 3606             (    forth6809.asm):05101                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DC4D CCDC7D           (    forth6809.asm):05102                     LDD   #DOTEST
DC50 3606             (    forth6809.asm):05103                     PSHU  D
DC52 BDDE7F           (    forth6809.asm):05104                     JSR   CCALL
DC55 CC0000           (    forth6809.asm):05105                     LDD   #0
DC58 3606             (    forth6809.asm):05106                     PSHU  D
DC5A BDD15A           (    forth6809.asm):05107                     JSR   CODECOMMA
DC5D DC08             (    forth6809.asm):05108                     LDD   CODEHERE
DC5F 830002           (    forth6809.asm):05109                     SUBD  #2
DC62 3606             (    forth6809.asm):05110                     PSHU  D                 ; location; the parked dest is beneath
DC64 BDDA79           (    forth6809.asm):05111                     JSR   PATCH
                      (    forth6809.asm):05112         
DC67 ECC4             (    forth6809.asm):05113                     LDD   ,U
DC69 10830007         (    forth6809.asm):05114                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DC6D 260D             (    forth6809.asm):05115                     BNE   LOOPDONE
DC6F 3706             (    forth6809.asm):05116                     PULU  D
DC71 3710             (    forth6809.asm):05117                     PULU  X                 ; ?DO skip operand
DC73 DC08             (    forth6809.asm):05118                     LDD   CODEHERE
DC75 3606             (    forth6809.asm):05119                     PSHU  D
DC77 3610             (    forth6809.asm):05120                     PSHU  X
DC79 BDDA79           (    forth6809.asm):05121                     JSR   PATCH
DC7C 39               (    forth6809.asm):05122         LOOPDONE:   RTS
                      (    forth6809.asm):05123         
                      (    forth6809.asm):05124         ; ------------------------------------------------------------
                      (    forth6809.asm):05125         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05126         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05127         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05128         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05129         ; DOTEST
                      (    forth6809.asm):05130         ;    Inputs:
                      (    forth6809.asm):05131         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05132         ;        first)
                      (    forth6809.asm):05133         ;    Outputs:
                      (    forth6809.asm):05134         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05135         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05136         ; ------------------------------------------------------------
DC7D EC66             (    forth6809.asm):05137         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DC7F 2615             (    forth6809.asm):05138                     BNE   DTEXIT            ; set: exit
DC81 EC62             (    forth6809.asm):05139                     LDD   2,S               ; index
DC83 C30001           (    forth6809.asm):05140                     ADDD  #1
DC86 ED62             (    forth6809.asm):05141                     STD   2,S
DC88 10A364           (    forth6809.asm):05142                     CMPD  4,S               ; limit
DC8B 2709             (    forth6809.asm):05143                     BEQ   DTEXIT
DC8D 3510             (    forth6809.asm):05144                     PULS  X                 ; X = branch operand address
DC8F EC84             (    forth6809.asm):05145                     LDD   ,X
DC91 308B             (    forth6809.asm):05146                     LEAX  D,X
DC93 3410             (    forth6809.asm):05147                     PSHS  X                 ; return to loop start
DC95 39               (    forth6809.asm):05148                     RTS
DC96 3510             (    forth6809.asm):05149         DTEXIT:     PULS  X
DC98 3002             (    forth6809.asm):05150                     LEAX  2,X               ; skip the branch operand
DC9A 3266             (    forth6809.asm):05151                     LEAS  6,S               ; discard the loop frame
DC9C 3410             (    forth6809.asm):05152                     PSHS  X
DC9E 39               (    forth6809.asm):05153                     RTS
                      (    forth6809.asm):05154         
                      (    forth6809.asm):05155         ; ------------------------------------------------------------
                      (    forth6809.asm):05156         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05157         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05158         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05159         ; ------------------------------------------------------------
DC9F 3706             (    forth6809.asm):05160         PLUSLOOPW:  PULU  D
DCA1 10830003         (    forth6809.asm):05161                     CMPD  #TAGDO
DCA5 2703             (    forth6809.asm):05162                     BEQ   PLOOPOK
DCA7 BDDA0F           (    forth6809.asm):05163                     JSR   CFERR
DCAA 3706             (    forth6809.asm):05164         PLOOPOK:    PULU  D                 ; dest
DCAC 3606             (    forth6809.asm):05165                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DCAE CCDCDE           (    forth6809.asm):05166                     LDD   #DOPLUSTEST
DCB1 3606             (    forth6809.asm):05167                     PSHU  D
DCB3 BDDE7F           (    forth6809.asm):05168                     JSR   CCALL
DCB6 CC0000           (    forth6809.asm):05169                     LDD   #0
DCB9 3606             (    forth6809.asm):05170                     PSHU  D
DCBB BDD15A           (    forth6809.asm):05171                     JSR   CODECOMMA
DCBE DC08             (    forth6809.asm):05172                     LDD   CODEHERE
DCC0 830002           (    forth6809.asm):05173                     SUBD  #2
DCC3 3606             (    forth6809.asm):05174                     PSHU  D                 ; location; the parked dest is beneath
DCC5 BDDA79           (    forth6809.asm):05175                     JSR   PATCH
                      (    forth6809.asm):05176         
DCC8 ECC4             (    forth6809.asm):05177                     LDD   ,U
DCCA 10830007         (    forth6809.asm):05178                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DCCE 260D             (    forth6809.asm):05179                     BNE   PLOOPDONE
DCD0 3706             (    forth6809.asm):05180                     PULU  D
DCD2 3710             (    forth6809.asm):05181                     PULU  X                 ; ?DO skip operand
DCD4 DC08             (    forth6809.asm):05182                     LDD   CODEHERE
DCD6 3606             (    forth6809.asm):05183                     PSHU  D
DCD8 3610             (    forth6809.asm):05184                     PSHU  X
DCDA BDDA79           (    forth6809.asm):05185                     JSR   PATCH
DCDD 39               (    forth6809.asm):05186         PLOOPDONE:  RTS
                      (    forth6809.asm):05187         
                      (    forth6809.asm):05188         ; ------------------------------------------------------------
                      (    forth6809.asm):05189         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05190         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05191         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05192         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05193         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05194         ;    Inputs:
                      (    forth6809.asm):05195         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05196         ;    Outputs:
                      (    forth6809.asm):05197         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05198         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05199         ;        scratch.
                      (    forth6809.asm):05200         ; ------------------------------------------------------------
DCDE 3706             (    forth6809.asm):05201         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DCE0 DD14             (    forth6809.asm):05202                     STD   MSCR              ; MSCR = step
DCE2 EC66             (    forth6809.asm):05203                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DCE4 262D             (    forth6809.asm):05204                     BNE   DPTEXIT           ; set: exit
DCE6 EC62             (    forth6809.asm):05205                     LDD   2,S               ; old index
DCE8 A364             (    forth6809.asm):05206                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DCEA DD16             (    forth6809.asm):05207                     STD   MSCR2
DCEC EC62             (    forth6809.asm):05208                     LDD   2,S
DCEE D314             (    forth6809.asm):05209                     ADDD  MSCR              ; new_index = old_index + step
DCF0 ED62             (    forth6809.asm):05210                     STD   2,S
DCF2 A364             (    forth6809.asm):05211                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DCF4 DD18             (    forth6809.asm):05212                     STD   MSCR3
                      (    forth6809.asm):05213                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05214                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05215                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DCF6 DC14             (    forth6809.asm):05216                     LDD   MSCR              ; reload the step to test its sign
DCF8 2B09             (    forth6809.asm):05217                     BMI   DPNEG
DCFA DC18             (    forth6809.asm):05218         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DCFC 109316           (    forth6809.asm):05219                     CMPD  MSCR2
DCFF 2512             (    forth6809.asm):05220                     BLO   DPTEXIT
DD01 2007             (    forth6809.asm):05221                     BRA   DPCONT
DD03 DC18             (    forth6809.asm):05222         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DD05 109316           (    forth6809.asm):05223                     CMPD  MSCR2
DD08 2209             (    forth6809.asm):05224                     BHI   DPTEXIT
DD0A 3510             (    forth6809.asm):05225         DPCONT:     PULS  X                 ; X = branch operand address
DD0C EC84             (    forth6809.asm):05226                     LDD   ,X
DD0E 308B             (    forth6809.asm):05227                     LEAX  D,X
DD10 3410             (    forth6809.asm):05228                     PSHS  X
DD12 39               (    forth6809.asm):05229                     RTS
DD13 3510             (    forth6809.asm):05230         DPTEXIT:    PULS  X
DD15 3002             (    forth6809.asm):05231                     LEAX  2,X               ; skip the branch operand
DD17 3266             (    forth6809.asm):05232                     LEAS  6,S               ; discard the loop frame
DD19 3410             (    forth6809.asm):05233                     PSHS  X
DD1B 39               (    forth6809.asm):05234                     RTS
                      (    forth6809.asm):05235         
                      (    forth6809.asm):05236         ; ------------------------------------------------------------
                      (    forth6809.asm):05237         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05238         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05239         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05240         ; ------------------------------------------------------------
DD1C CCDD42           (    forth6809.asm):05241         QDOW:       LDD   #QDOSETUP
DD1F 3606             (    forth6809.asm):05242                     PSHU  D
DD21 BDDE7F           (    forth6809.asm):05243                     JSR   CCALL
DD24 CC0000           (    forth6809.asm):05244                     LDD   #0
DD27 3606             (    forth6809.asm):05245                     PSHU  D
DD29 BDD15A           (    forth6809.asm):05246                     JSR   CODECOMMA
DD2C DC08             (    forth6809.asm):05247                     LDD   CODEHERE
DD2E 830002           (    forth6809.asm):05248                     SUBD  #2
DD31 3606             (    forth6809.asm):05249                     PSHU  D                 ; orig
DD33 CC0007           (    forth6809.asm):05250                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DD36 3606             (    forth6809.asm):05251                     PSHU  D
DD38 DC08             (    forth6809.asm):05252                     LDD   CODEHERE
DD3A 3606             (    forth6809.asm):05253                     PSHU  D                 ; dest
DD3C CC0003           (    forth6809.asm):05254                     LDD   #TAGDO
DD3F 3606             (    forth6809.asm):05255                     PSHU  D
DD41 39               (    forth6809.asm):05256                     RTS
                      (    forth6809.asm):05257         
                      (    forth6809.asm):05258         ; ------------------------------------------------------------
                      (    forth6809.asm):05259         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05260         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05261         ; branch operand.
                      (    forth6809.asm):05262         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05263         ;    Inputs:
                      (    forth6809.asm):05264         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05265         ;    Outputs:
                      (    forth6809.asm):05266         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05267         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05268         ; ------------------------------------------------------------
DD42 3706             (    forth6809.asm):05269         QDOSETUP:   PULU  D                 ; index
DD44 DD14             (    forth6809.asm):05270                     STD   MSCR
DD46 3706             (    forth6809.asm):05271                     PULU  D                 ; limit

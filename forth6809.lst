                      (    forth6809.asm):12975                     CMPD #TSTGUARD
                      (    forth6809.asm):12976                     BNE  CQFAIL
                      (    forth6809.asm):12977         
                      (    forth6809.asm):12978                     LDD  TSTUB4
                      (    forth6809.asm):12979                     SUBD TSTUAF
                      (    forth6809.asm):12980                     CMPD #0
                      (    forth6809.asm):12981                     BNE  CQFAIL

                      (    forth6809.asm):04128         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):04129         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):04130         ; branch operand.
                      (    forth6809.asm):04131         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):04132         ;    Inputs:
                      (    forth6809.asm):04133         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04134         ;    Outputs:
                      (    forth6809.asm):04135         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):04136         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04137         ; ------------------------------------------------------------

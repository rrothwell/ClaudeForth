                      (    forth6809.asm):09312         ; TSTMARKER - unit test for MARKER. Compiles "MARKER TESTWD"
                      (    forth6809.asm):09313         ; (CODEHERE/DPHERE/VARHERE redirected to scratch, as with every
                      (    forth6809.asm):09314         ; other test in this section), then simulates "something was
                      (    forth6809.asm):09315         ; defined after the marker" by manually advancing the redirected
                      (    forth6809.asm):09316         ; pointers further and pointing the real LATEST elsewhere,
                      (    forth6809.asm):09317         ; executes the marker word, and verifies everything was restored
                      (    forth6809.asm):09318         ; to TSTCBUF/TSTDBUF/TSTVBUF directly - the state BEFORE the
                      (    forth6809.asm):09319         ; marker word itself was created, not the state right after.
                      (    forth6809.asm):09320         ; MARKER's own documented behavior is "forgets itself too" -
                      (    forth6809.asm):09321         ; traced MARKERW's own code and confirmed its internal snapshot
                      (    forth6809.asm):09322         ; is taken at its very start, before HEADER or any compiling
                      (    forth6809.asm):09323         ; runs at all, so that's genuinely the correct restore target,
                      (    forth6809.asm):09324         ; not assumed.
                      (    forth6809.asm):09325         ;
                      (    forth6809.asm):09326         ; DOMARKER (confirmed by reading it directly) writes to the
                      (    forth6809.asm):09327         ; real DPHERE/CODEHERE/VARHERE/LATEST unconditionally, not to
                      (    forth6809.asm):09328         ; any redirected copy - so this test must execute the marker
                      (    forth6809.asm):09329         ; word while CODEHERE/DPHERE/VARHERE are still redirected (their
                      (    forth6809.asm):09330         ; real values are restored only afterward), unlike every other
                      (    forth6809.asm):09331         ; test in this section, which restores first and executes
                      (    forth6809.asm):09332         ; second. Getting this order backwards would have corrupted the
                      (    forth6809.asm):09333         ; real dictionary pointers with scratch addresses.
                      (    forth6809.asm):09334         ; ------------------------------------------------------------
C25B                  (    forth6809.asm):09335         TSTMARKER: LDD  CODEHERE

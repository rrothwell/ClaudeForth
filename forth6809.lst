                      (    forth6809.asm):00755                    JSR   TSTSWAP
                      (    forth6809.asm):00756                    JSR   TSTOVER
                      (    forth6809.asm):00757                    JSR   TSTROT
                      (    forth6809.asm):00758                    JSR   TSTQDUPNZ
                      (    forth6809.asm):00759                    JSR   TSTQDUPZ
                      (    forth6809.asm):00760                    JSR   TSTDEPTH
                      (    forth6809.asm):00761                    JSR   TSTDDUP
                      (    forth6809.asm):00762                    JSR   TSTDDROP
                      (    forth6809.asm):00763                    JSR   TSTDSWAP
                      (    forth6809.asm):00764                    JSR   TSTDOVER
                      (    forth6809.asm):00765                    JSR   TSTNIP
                      (    forth6809.asm):00766                    JSR   TSTTUCK
                      (    forth6809.asm):00767                    JSR   TSTPICK
                      (    forth6809.asm):00768                    JSR   TSTROLL
                      (    forth6809.asm):00769                    JSR   TSTDROT
                      (    forth6809.asm):00770         

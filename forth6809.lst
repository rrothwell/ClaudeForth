E44D 0322             (    forth6809.asm):03728                  COM   NUMNEG
E44F 3001             (    forth6809.asm):03729                  LEAX  1,X
E451 0A21             (    forth6809.asm):03730                  DEC   CNTREM
E453 2756             (    forth6809.asm):03731                  BEQ   NQBAD
                      (    forth6809.asm):03732         

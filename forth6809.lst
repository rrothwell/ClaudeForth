                      (    forth6809.asm):05617         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):05618         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):05619         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):05620         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):05621         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):05622         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):05623         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):05624         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):05625         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):05626         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):05627         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):05628         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):05629                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):05630                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):05631                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):05632                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):05633                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):05634                  FDB   ABORT
                      (    forth6809.asm):05635         
DEBE 04               (    forth6809.asm):05636         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):05637                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):05638                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):05639                  FDB   QUIT
                      (    forth6809.asm):05640         
                      (    forth6809.asm):05641         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):05642         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):05643         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):05644         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):05645         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):05646         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):05647         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):05648                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):05649                  FDB   H_QUIT
DECE E476             (    forth6809.asm):05650                  FDB   FIND
                      (    forth6809.asm):05651         

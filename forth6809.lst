                      (    forth6809.asm):06426         ; TSTEXIT - unit test for EXIT. Compiles
                      (    forth6809.asm):06427         ; "DO I DUP 3 LITERAL = IF EXIT THEN I + LOOP", limit=10,
                      (    forth6809.asm):06428         ; start=0 - EXIT fires when I=3, discarding the one open DO
                      (    forth6809.asm):06429         ; frame and returning immediately. Sets the real CSP to U's
                      (    forth6809.asm):06430         ; value right before the first control-flow marker is pushed
                      (    forth6809.asm):06431         ; (matching what ":" does at the start of a real definition),
                      (    forth6809.asm):06432         ; since EXIT's own compile-time frame count depends on it -
                      (    forth6809.asm):06433         ; confirmed by hand-trace: at the point EXIT is compiled, U
                      (    forth6809.asm):06434         ; holds IF's own pending (addr,TAGFWD) on top of DO's
                      (    forth6809.asm):06435         ; (addr,TAGDO), and EXIT's scan correctly counts exactly one
                      (    forth6809.asm):06436         ; TAGDO between U and CSP. Unlike TSTLEAVE, EXIT fires
                      (    forth6809.asm):06437         ; immediately when reached - the following + never runs for
                      (    forth6809.asm):06438         ; I=3, so sum=0+1+2=3, not 6.
                      (    forth6809.asm):06439         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):06440         TSTEXIT: LDD   CSP
                      (    forth6809.asm):06441                  STD   TSTCSPS
                      (    forth6809.asm):06442                  LDD   CODEHERE
                      (    forth6809.asm):06443                  STD   TSTCSAV
                      (    forth6809.asm):06444                  LDD   #TSTCBUF
                      (    forth6809.asm):06445                  STD   CODEHERE
                      (    forth6809.asm):06446         
                      (    forth6809.asm):06447                  TFR   U,D
                      (    forth6809.asm):06448                  STD   CSP
                      (    forth6809.asm):06449         
                      (    forth6809.asm):06450                  JSR   DO
                      (    forth6809.asm):06451         

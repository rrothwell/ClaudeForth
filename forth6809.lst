F45B DC00             (    forth6809.asm):06411         BRACKCHARW: LDD   STATE
F45D 2608             (    forth6809.asm):06412                     BNE   BCSTOK
F45F CCFFF2           (    forth6809.asm):06413                     LDD   #-14              ; -14
F462 3606             (    forth6809.asm):06414                     PSHU  D
F464 BDE61F           (    forth6809.asm):06415                     JSR   THROWW
F467 CC0020           (    forth6809.asm):06416         BCSTOK:     LDD   #32
F46A 3606             (    forth6809.asm):06417                     PSHU  D
F46C BDE33D           (    forth6809.asm):06418                     JSR   WORDW
F46F 3710             (    forth6809.asm):06419                     PULU  X
F471 E601             (    forth6809.asm):06420                     LDB   1,X
F473 4F               (    forth6809.asm):06421                     CLRA
F474 3606             (    forth6809.asm):06422                     PSHU  D
F476 BDEA67           (    forth6809.asm):06423                     JSR   LITERALW
F479 39               (    forth6809.asm):06424                     RTS
                      (    forth6809.asm):06425         
                      (    forth6809.asm):06426         ; ------------------------------------------------------------
                      (    forth6809.asm):06427         ; PARSE  ( char "ccc<char>" -- c-addr u )
                      (    forth6809.asm):06428         ; Parse the input up to the delimiter char (which is consumed) and
                      (    forth6809.asm):06429         ; return the parsed text. A >IN beyond the end of the input is treated
                      (    forth6809.asm):06430         ; as an exhausted input (empty result).

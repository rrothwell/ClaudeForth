EC12 3606             (    forth6809.asm):04920                     PSHU  D
EC14 39               (    forth6809.asm):04921                     RTS
                      (    forth6809.asm):04922         
                      (    forth6809.asm):04923         ; ------------------------------------------------------------
                      (    forth6809.asm):04924         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):04925         ; Copy the top cell pair of the return stack.

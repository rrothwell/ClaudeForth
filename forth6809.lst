DE76 39               (    forth6809.asm):02063         RTSCLODONE: RTS
                      (    forth6809.asm):02064         
                      (    forth6809.asm):02065         ; ------------------------------------------------------------
                      (    forth6809.asm):02066         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02067         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02068         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02069         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02070         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02071         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02072         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02073         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02074         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02075         ;
                      (    forth6809.asm):02076         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02077         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02078         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02079         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02080         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02081         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02082         ;
                      (    forth6809.asm):02083         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02084         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02085         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02086         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02087         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02088         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02089         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02090         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02091         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02092         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02093         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02094         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02095         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02096         ; ------------------------------------------------------------
DE77 B6C008           (    forth6809.asm):02097         IRQH:    LDA   ACIASR          ; Get the status.
                      (    forth6809.asm):02098         
DE7A 8580             (    forth6809.asm):02099                  BITA  #SR_IRQ         ; Is the ACIA the interrupt source?
DE7C 2708             (    forth6809.asm):02100                  BEQ   IRQDONE
DE7E 8501             (    forth6809.asm):02101                  BITA  #SR_RDRF        ; Is an incoming character available?
DE80 2605             (    forth6809.asm):02102                  BNE   INCHAR
DE82 8502             (    forth6809.asm):02103                  BITA  #SR_TDRE        ; Is the slot for an outgoing character available?
DE84 263A             (    forth6809.asm):02104                  BNE   OUTCHAR
                      (    forth6809.asm):02105                                        ; Ignore all other interrupts such as DCD change.
DE86 3B               (    forth6809.asm):02106         IRQDONE: RTI                   ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02107                                         ; & restores state.
                      (    forth6809.asm):02108         
DE87 8570             (    forth6809.asm):02109         INCHAR:  BITA  #SR_FE+SR_OVRN+SR_PE  ; Any receiver error flagged?
DE89 271A             (    forth6809.asm):02110                  BEQ   INOK                  ; None - character is good, keep it.
DE8B 8510             (    forth6809.asm):02111                  BITA  #SR_FE                ; Tally each flagged error independently -
DE8D 2703             (    forth6809.asm):02112                  BEQ   INXFE                 ; more than one bit can be set at once.
DE8F 7C01DA           (    forth6809.asm):02113                  INC   FECOUNT
DE92 8520             (    forth6809.asm):02114         INXFE:   BITA  #SR_OVRN
DE94 2703             (    forth6809.asm):02115                  BEQ   INXOVRN
DE96 7C01DB           (    forth6809.asm):02116                  INC   OVRNCOUNT
DE99 8540             (    forth6809.asm):02117         INXOVRN: BITA  #SR_PE
DE9B 2703             (    forth6809.asm):02118                  BEQ   INXPE
DE9D 7C01DC           (    forth6809.asm):02119                  INC   PECOUNT
DEA0 B6C009           (    forth6809.asm):02120         INXPE:   LDA   ACIADR          ; Clear RDRF/the error latch; discard the byte -
DEA3 20E1             (    forth6809.asm):02121                  BRA   IRQDONE         ; assumed corrupted, so never stored in INBUF.
                      (    forth6809.asm):02122         
DEA5 B6C009           (    forth6809.asm):02123         INOK:    LDA   ACIADR          ; Get the character from the receiver.
DEA8 F60106           (    forth6809.asm):02124                  LDB   INHEAD          ; Store it in the empty in buffer slot.
DEAB 8E010A           (    forth6809.asm):02125                  LDX   #INBUF
DEAE A785             (    forth6809.asm):02126                  STA   B,X
DEB0 5C               (    forth6809.asm):02127                  INCB                  ; Figure out the new head,
DEB1 C43F             (    forth6809.asm):02128                  ANDB  #INBUFSZ-1      ; pointing to the next the empty in buffer slot.
DEB3 F10107           (    forth6809.asm):02129                  CMPB  INTAIL          ; Would the new head slot meet the tail?
DEB6 27CE             (    forth6809.asm):02130                  BEQ   IRQDONE         ; Don't allow it - buffer full, drop the character.
DEB8 F70106           (    forth6809.asm):02131                  STB   INHEAD          ; New head pointer is OK so store it.
DEBB BDDE3C           (    forth6809.asm):02132                  JSR   RTSCHECKHI      ; Protect the in buffer from overflow.
DEBE 20C6             (    forth6809.asm):02133                  BRA   IRQDONE
                      (    forth6809.asm):02134         
DEC0 F60109           (    forth6809.asm):02135         OUTCHAR: LDB   OUTTAIL         ; Is the out buffer empty or occupied?
DEC3 F10108           (    forth6809.asm):02136                  CMPB  OUTHEAD
DEC6 2710             (    forth6809.asm):02137                  BEQ   TXOFF
DEC8 8E014A           (    forth6809.asm):02138                  LDX   #OUTBUF         ; The out buffer is occupied.
DECB A685             (    forth6809.asm):02139                  LDA   B,X             ; Get the character from the out buffer.
DECD B7C009           (    forth6809.asm):02140                  STA   ACIADR          ; Store it in the transmitter.
DED0 5C               (    forth6809.asm):02141                  INCB                  ; The tail pointer updated to point to the next character.
DED1 C43F             (    forth6809.asm):02142                  ANDB  #OUTBUFSZ-1
DED3 F70109           (    forth6809.asm):02143                  STB   OUTTAIL
DED6 20AE             (    forth6809.asm):02144                  BRA   IRQDONE
DED8 0DFF             (    forth6809.asm):02145         TXOFF:   TST   RTSSTATE        ; The buffer is empty.
DEDA 26AA             (    forth6809.asm):02146                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02147                                        ; or this would incorrectly drop it back low
DEDC 8695             (    forth6809.asm):02148                  LDA   #CR_RXON
DEDE B7C008           (    forth6809.asm):02149                  STA   ACIACR
DEE1 20A3             (    forth6809.asm):02150                  BRA   IRQDONE
                      (    forth6809.asm):02151         
                      (    forth6809.asm):02152                  ELSE  ; <<<<<>>>>>
DEE3                  (    forth6809.asm):02153         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02154                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02155                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02156                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02157                                       ; the other unused vectors below
                      (    forth6809.asm):02158                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02159         
DEE3 3B               (    forth6809.asm):02160         SWI3H:   RTI
DEE4 3B               (    forth6809.asm):02161         SWI2H:   RTI
DEE5 3B               (    forth6809.asm):02162         FIRQH:   RTI
DEE6 3B               (    forth6809.asm):02163         NMIH:    RTI                   ; unused now that NMI -> WARM
DEE7 CCFF9D           (    forth6809.asm):02164         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DEEA 3606             (    forth6809.asm):02165                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DEEC 7EE73B           (    forth6809.asm):02166                  JMP   THROW

                      (    forth6809.asm):08087         ; ------------------------------------------------------------
                      (    forth6809.asm):08088         ; TRUE  ( -- flag )
                      (    forth6809.asm):08089         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08090         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08091         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08092         ; ------------------------------------------------------------

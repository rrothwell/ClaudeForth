                      (    forth6809.asm):10493                     PSHU D
                      (    forth6809.asm):10494                     LDD  #DUP
                      (    forth6809.asm):10495                     PSHU D
                      (    forth6809.asm):10496                     STU  TSTUB4
                      (    forth6809.asm):10497         
                      (    forth6809.asm):10498                     JSR  EXECUTE
                      (    forth6809.asm):10499         
                      (    forth6809.asm):10500                     STU  TSTUAF
                      (    forth6809.asm):10501         
                      (    forth6809.asm):10502                     PULU D
                      (    forth6809.asm):10503                     CMPD #TSTVAL1
                      (    forth6809.asm):10504                     BNE  XQFAIL
                      (    forth6809.asm):10505                     PULU D
                      (    forth6809.asm):10506                     CMPD #TSTVAL1
                      (    forth6809.asm):10507                     BNE  XQFAIL
                      (    forth6809.asm):10508                     PULU D
                      (    forth6809.asm):10509                     CMPD #TSTGUARD
                      (    forth6809.asm):10510                     BNE  XQFAIL
                      (    forth6809.asm):10511         
                      (    forth6809.asm):10512                     LDD  TSTUB4
                      (    forth6809.asm):10513                     SUBD TSTUAF
                      (    forth6809.asm):10514                     CMPD #0
                      (    forth6809.asm):10515                     BNE  XQFAIL
                      (    forth6809.asm):10516         
                      (    forth6809.asm):10517                     LDD  #TRUEV
                      (    forth6809.asm):10518                     BRA  XQDONE
C26F                  (    forth6809.asm):10519         XQFAIL:     LDD  #FALSEV
C26F                  (    forth6809.asm):10520         XQDONE:    LDX  #TSTEXECNAME
                      (    forth6809.asm):10521                     PSHU X
                      (    forth6809.asm):10522                     PSHU D
                      (    forth6809.asm):10523                     JSR  TSTREPORT
                      (    forth6809.asm):10524         
                      (    forth6809.asm):10525                     LDU  TSTU0
                      (    forth6809.asm):10526                     RTS
                      (    forth6809.asm):10527         
C26F                  (    forth6809.asm):10528         TSTEXECNAME: FCB  10
                      (    forth6809.asm):10529                      FCC  "TSTEXECUTE"
                      (    forth6809.asm):10530         

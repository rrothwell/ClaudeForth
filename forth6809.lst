                      (    forth6809.asm):07066         ; SNAME  ( xt -- c-addr u | 0 0 )
                      (    forth6809.asm):07067         ; Find the name of the word whose xt is given by searching the
                      (    forth6809.asm):07068         ; dictionary from LATEST. Return the name or two zeros if not found.

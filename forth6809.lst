                      (    forth6809.asm):08221         
FFBD 1CAF             (    forth6809.asm):08222                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08223         
                      (    forth6809.asm):08224                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08225         
                      (    forth6809.asm):08226                     IFNE  UNITTESTS         ; >>>>>>>>>>
FFBF BDC135           (    forth6809.asm):08227                     JSR   TSTRUNNER
                      (    forth6809.asm):08228                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):08229                     NOP                     ; same size as JSR TSTRUNNER
                      (    forth6809.asm):08230                     NOP                     ; See bugfix: COLDSTRT.2
                      (    forth6809.asm):08231                     NOP
                      (    forth6809.asm):08232                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):08233         

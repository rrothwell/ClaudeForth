                      (    forth6809.asm):04120         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04121         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04122         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04123         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04124         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04125         ;    Inputs:
                      (    forth6809.asm):04126         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04127         ;    Outputs:
                      (    forth6809.asm):04128         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04129         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04130         ;        scratch.
                      (    forth6809.asm):04131         ; ------------------------------------------------------------

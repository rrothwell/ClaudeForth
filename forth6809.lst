                      (    forth6809.asm):01248                    BNE  SSFAIL
                      (    forth6809.asm):01249                    INCB
                      (    forth6809.asm):01250                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01251                    LDA  B,X
                      (    forth6809.asm):01252                    CMPA #32
                      (    forth6809.asm):01253                    BNE  SSFAIL

C27B                  (    forth6809.asm):10564         XQFAIL:     LDD  #FALSEV
C27B                  (    forth6809.asm):10565         XQDONE:    LDX  #TSTEXECNAME
                      (    forth6809.asm):10566                     PSHU X
                      (    forth6809.asm):10567                     PSHU D
                      (    forth6809.asm):10568                     JSR  TSTREPORT
                      (    forth6809.asm):10569         
                      (    forth6809.asm):10570                     LDU  TSTU0
                      (    forth6809.asm):10571                     RTS
                      (    forth6809.asm):10572         
C27B                  (    forth6809.asm):10573         TSTEXECNAME: FCB  10
                      (    forth6809.asm):10574                      FCC  "TSTEXECUTE"
                      (    forth6809.asm):10575         

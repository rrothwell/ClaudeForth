DDBE CC0004           (    forth6809.asm):02121                     LDD   #OKMSGL
DDC1 3606             (    forth6809.asm):02122                     PSHU  D                 ; u
DDC3 BDF428           (    forth6809.asm):02123                     JSR   TYPEW
DDC6 2083             (    forth6809.asm):02124                     BRA   QLOOP
                      (    forth6809.asm):02125         

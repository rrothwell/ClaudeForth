DC7E 39               (    forth6809.asm):04152                     RTS
                      (    forth6809.asm):04153         
                      (    forth6809.asm):04154         ; ------------------------------------------------------------
                      (    forth6809.asm):04155         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04156         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04157         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04158         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04159         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04160         ; NUMLOOP
                      (    forth6809.asm):04161         ;    Inputs:
                      (    forth6809.asm):04162         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04163         ;    Outputs:
                      (    forth6809.asm):04164         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04165         ;        the count remaining
                      (    forth6809.asm):04166         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04167         ; ------------------------------------------------------------
DC7F                  (    forth6809.asm):04168         TONUMBERW:
DC7F ECC4             (    forth6809.asm):04169         NUMLOOP:    LDD   ,U
DC81 2734             (    forth6809.asm):04170                     BEQ   NLDONE
DC83 AE42             (    forth6809.asm):04171                     LDX   2,U
DC85 A684             (    forth6809.asm):04172                     LDA   ,X
DC87 8130             (    forth6809.asm):04173                     CMPA  #'0'
DC89 252C             (    forth6809.asm):04174                     BLO   NLDONE
DC8B 8139             (    forth6809.asm):04175                     CMPA  #'9'
DC8D 2204             (    forth6809.asm):04176                     BHI   NLALPHA
DC8F 8030             (    forth6809.asm):04177                     SUBA  #'0'
DC91 200C             (    forth6809.asm):04178                     BRA   NLGOT
DC93 84DF             (    forth6809.asm):04179         NLALPHA:    ANDA  #$DF
DC95 8141             (    forth6809.asm):04180                     CMPA  #'A'
DC97 251E             (    forth6809.asm):04181                     BLO   NLDONE
DC99 815A             (    forth6809.asm):04182                     CMPA  #'Z'
DC9B 221A             (    forth6809.asm):04183                     BHI   NLDONE
DC9D 8037             (    forth6809.asm):04184                     SUBA  #'A'-10
DC9F 9103             (    forth6809.asm):04185         NLGOT:      CMPA  BASE+1
DCA1 2414             (    forth6809.asm):04186                     BHS   NLDONE
DCA3 1F89             (    forth6809.asm):04187                     TFR   A,B
DCA5 BDDC3E           (    forth6809.asm):04188                     JSR   UDMULADD
DCA8 AE42             (    forth6809.asm):04189                     LDX   2,U
DCAA 3001             (    forth6809.asm):04190                     LEAX  1,X
DCAC AF42             (    forth6809.asm):04191                     STX   2,U
DCAE ECC4             (    forth6809.asm):04192                     LDD   ,U
DCB0 830001           (    forth6809.asm):04193                     SUBD  #1
DCB3 EDC4             (    forth6809.asm):04194                     STD   ,U
DCB5 20C8             (    forth6809.asm):04195                     BRA   NUMLOOP
DCB7 39               (    forth6809.asm):04196         NLDONE:     RTS
                      (    forth6809.asm):04197         
                      (    forth6809.asm):04198         ; ------------------------------------------------------------
                      (    forth6809.asm):04199         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04200         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04201         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04202         ;    Inputs:
                      (    forth6809.asm):04203         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04204         ;    Outputs:
                      (    forth6809.asm):04205         ;        single number: n and -1
                      (    forth6809.asm):04206         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04207         ;        not a number: c-addr and 0
                      (    forth6809.asm):04208         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04209         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04210         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04211         ; NUMBERQ.6.
                      (    forth6809.asm):04212         ; ------------------------------------------------------------
DCB8 3710             (    forth6809.asm):04213         NUMBERQ:    PULU  X                 ; c-addr
DCBA 327D             (    forth6809.asm):04214                     LEAS  -3,S
DCBC AFE4             (    forth6809.asm):04215                     STX   ,S
DCBE E684             (    forth6809.asm):04216                     LDB   ,X
DCC0 276D             (    forth6809.asm):04217                     BEQ   NQBAD
DCC2 3001             (    forth6809.asm):04218                     LEAX  1,X
                      (    forth6809.asm):04219         
                      (    forth6809.asm):04220                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04221                     ; digit count. See shadow: NUMBERQ.1
DCC4 5A               (    forth6809.asm):04222                     DECB
DCC5 A685             (    forth6809.asm):04223                     LDA   B,X
DCC7 5C               (    forth6809.asm):04224                     INCB
DCC8 812E             (    forth6809.asm):04225                     CMPA  #'.'
DCCA 2603             (    forth6809.asm):04226                     BNE   NQNOSIGN
DCCC 5A               (    forth6809.asm):04227                     DECB
DCCD 2760             (    forth6809.asm):04228                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04229         
DCCF 6F62             (    forth6809.asm):04230         NQNOSIGN:   CLR   2,S
DCD1 A684             (    forth6809.asm):04231                     LDA   ,X
DCD3 812D             (    forth6809.asm):04232                     CMPA  #'-'
DCD5 2607             (    forth6809.asm):04233                     BNE   NQNOSIGN2
DCD7 6362             (    forth6809.asm):04234                     COM   2,S
DCD9 3001             (    forth6809.asm):04235                     LEAX  1,X
DCDB 5A               (    forth6809.asm):04236                     DECB
DCDC 2751             (    forth6809.asm):04237                     BEQ   NQBAD
                      (    forth6809.asm):04238         
DCDE 108E0000         (    forth6809.asm):04239         NQNOSIGN2:  LDY   #0
DCE2 3620             (    forth6809.asm):04240                     PSHU  Y                 ; ud low
DCE4 3620             (    forth6809.asm):04241                     PSHU  Y                 ; ud high
DCE6 3610             (    forth6809.asm):04242                     PSHU  X                 ; c-addr
DCE8 4F               (    forth6809.asm):04243                     CLRA
DCE9 3606             (    forth6809.asm):04244                     PSHU  D                 ; u
                      (    forth6809.asm):04245         
DCEB BDDC7F           (    forth6809.asm):04246                     JSR   NUMLOOP
                      (    forth6809.asm):04247         
DCEE ECC4             (    forth6809.asm):04248                     LDD   ,U

                      (    forth6809.asm):07953         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07954         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07955         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07956         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07957         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07958         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07959         ; division.

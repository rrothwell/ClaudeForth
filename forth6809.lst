DD1D DD14             (    forth6809.asm):01979                  FDB   H_1
DD1F FF76             (    forth6809.asm):01980                  FDB   MONEBODY
                      (    forth6809.asm):01981         
DD21 01               (    forth6809.asm):01982         H_2:     FCB   1
DD22 32               (    forth6809.asm):01983                  FCC   "2"
DD23 DD1A             (    forth6809.asm):01984                  FDB   H_M1
DD25 FF7C             (    forth6809.asm):01985                  FDB   TWOBODY
                      (    forth6809.asm):01986         
DD27 02               (    forth6809.asm):01987         H_M2:    FCB   2

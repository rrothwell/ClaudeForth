                      (    forth6809.asm):02849         ; ------------------------------------------------------------
                      (    forth6809.asm):02850         ; DEFER  ( "name" -- )
                      (    forth6809.asm):02851         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):02852         ; throws -21.
                      (    forth6809.asm):02853         ; ------------------------------------------------------------
E14D CC0000           (    forth6809.asm):02854         DEFERW:     LDD   #0
E150 3606             (    forth6809.asm):02855                     PSHU  D
E152 BDDF5A           (    forth6809.asm):02856                     JSR   HEADER
E155 CCDE94           (    forth6809.asm):02857                     LDD   #DODOES
E158 3606             (    forth6809.asm):02858                     PSHU  D
E15A BDEA85           (    forth6809.asm):02859                     JSR   CCALL
E15D CCDEC4           (    forth6809.asm):02860                     LDD   #DODEFER
E160 3606             (    forth6809.asm):02861                     PSHU  D
E162 BDDF08           (    forth6809.asm):02862                     JSR   CODECOMMA
E165 DC08             (    forth6809.asm):02863                     LDD   CODEHERE          ; PFA = the cell after this one
E167 C30002           (    forth6809.asm):02864                     ADDD  #2                ; See bugfix: CONSTANTW.1
E16A 3606             (    forth6809.asm):02865                     PSHU  D
E16C BDDF08           (    forth6809.asm):02866                     JSR   CODECOMMA
E16F CCDECC           (    forth6809.asm):02867                     LDD   #DOABORTUNDEF
E172 3606             (    forth6809.asm):02868                     PSHU  D
E174 BDDF02           (    forth6809.asm):02869                     JSR   COMMAW
E177 39               (    forth6809.asm):02870                     RTS
                      (    forth6809.asm):02871         
                      (    forth6809.asm):02872         ; ------------------------------------------------------------
                      (    forth6809.asm):02873         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):02874         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):02875         ; ------------------------------------------------------------
E178                  (    forth6809.asm):02876         DEFERFETCHW:
E178 BDEB37           (    forth6809.asm):02877                     JSR   TOBODYW
E17B 3710             (    forth6809.asm):02878                     PULU  X                 ; body address
E17D EC84             (    forth6809.asm):02879                     LDD   ,X
E17F 3606             (    forth6809.asm):02880                     PSHU  D                 ; xt2
E181 39               (    forth6809.asm):02881                     RTS
                      (    forth6809.asm):02882         
                      (    forth6809.asm):02883         ; ------------------------------------------------------------
                      (    forth6809.asm):02884         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):02885         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):02886         ; ------------------------------------------------------------
E182                  (    forth6809.asm):02887         DEFERSTOREW:
E182 BDEB37           (    forth6809.asm):02888                     JSR   TOBODYW
E185 3710             (    forth6809.asm):02889                     PULU  X                 ; body address of xt1
E187 3706             (    forth6809.asm):02890                     PULU  D                 ; xt2
E189 ED84             (    forth6809.asm):02891                     STD   ,X
E18B 39               (    forth6809.asm):02892                     RTS
                      (    forth6809.asm):02893         
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
                      (    forth6809.asm):02895         ; IS  ( xt "name" -- )  IMMEDIATE
                      (    forth6809.asm):02896         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):02897         ; compile code to do so at run time. Error -13 if the name is not
                      (    forth6809.asm):02898         ; found.
                      (    forth6809.asm):02899         ; ------------------------------------------------------------
E18C CC0020           (    forth6809.asm):02900         ISW:        LDD   #32
E18F 3606             (    forth6809.asm):02901                     PSHU  D
E191 BDE2C9           (    forth6809.asm):02902                     JSR   WORDW
E194 BDE335           (    forth6809.asm):02903                     JSR   FINDW
E197 3706             (    forth6809.asm):02904                     PULU  D
E199 10830000         (    forth6809.asm):02905                     CMPD  #0
E19D 260A             (    forth6809.asm):02906                     BNE   ISFOUND
E19F 3706             (    forth6809.asm):02907                     PULU  D
E1A1 CCFFF3           (    forth6809.asm):02908                     LDD   #-13
E1A4 3606             (    forth6809.asm):02909                     PSHU  D
E1A6 BDE60A           (    forth6809.asm):02910                     JSR   THROW
E1A9 3710             (    forth6809.asm):02911         ISFOUND:    PULU  X
E1AB DC00             (    forth6809.asm):02912                     LDD   STATE
E1AD 270E             (    forth6809.asm):02913                     BEQ   ISIMMED
E1AF 3610             (    forth6809.asm):02914                     PSHU  X
E1B1 BDEA92           (    forth6809.asm):02915                     JSR   LITERALW
E1B4 CCE182           (    forth6809.asm):02916                     LDD   #DEFERSTOREW
E1B7 3606             (    forth6809.asm):02917                     PSHU  D
E1B9 BDEA85           (    forth6809.asm):02918                     JSR   CCALL
E1BC 39               (    forth6809.asm):02919                     RTS
E1BD 3610             (    forth6809.asm):02920         ISIMMED:    PSHU  X
E1BF BDE182           (    forth6809.asm):02921                     JSR   DEFERSTOREW
E1C2 39               (    forth6809.asm):02922                     RTS
                      (    forth6809.asm):02923         
                      (    forth6809.asm):02924         ; ------------------------------------------------------------
                      (    forth6809.asm):02925         ; ACTION-OF  ( "name" -- xt )  IMMEDIATE
                      (    forth6809.asm):02926         ; Return the xt currently stored in the named deferred word. When
                      (    forth6809.asm):02927         ; compiling, compile code to do so at run time. Error -13 if the name
                      (    forth6809.asm):02928         ; is not found.
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
E1C3 CC0020           (    forth6809.asm):02930         ACTIONOFW:  LDD   #32

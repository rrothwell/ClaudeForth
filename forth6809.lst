                      (    forth6809.asm):00275         ; ------------------------------------------------------------
                      (    forth6809.asm):00276         ; Ring buffers for serial communications.
                      (    forth6809.asm):00277         ; One for input, one for output.
                      (    forth6809.asm):00278         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00279         ; The tricks are not used.
                      (    forth6809.asm):00280         ; ------------------------------------------------------------
                      (    forth6809.asm):00281                     ORG   SERBUFCTL         ; $176.
                      (    forth6809.asm):00282         
0176                  (    forth6809.asm):00283         INHEAD      RMB   1
0177                  (    forth6809.asm):00284         INTAIL      RMB   1
                      (    forth6809.asm):00285         ; Open question moved to shadow: RTSSTATE.1
0178                  (    forth6809.asm):00286         RTSSTATE    RMB   1                 ; $00 = RTS low, $FF = RTS high
                      (    forth6809.asm):00287         
0179                  (    forth6809.asm):00288         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00289         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00290         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00291         
017C                  (    forth6809.asm):00292         FECOUNT     RMB   1                 ; framing errors
017D                  (    forth6809.asm):00293         OVRNCOUNT   RMB   1                 ; overrun count, same as above
017E                  (    forth6809.asm):00294         PECOUNT     RMB   1                 ; parity-error count, same as above
017F                  (    forth6809.asm):00295         POLLREADYCNT
017F                  (    forth6809.asm):00296                     RMB   1                 ; polling build; see shadow POLLREADYCNT.1
                      (    forth6809.asm):00297         
                      (    forth6809.asm):00298                     ORG   SERBUF            ; $180, a 64 byte boundary.
                      (    forth6809.asm):00299         
                      (    forth6809.asm):00300                     ALIGN 64                ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00301         INBUF       RMB   INBUFSZ           ; Receive circular queue buffer

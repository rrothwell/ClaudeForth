                      (    forth6809.asm):03670         ; ------------------------------------------------------------
                      (    forth6809.asm):03671         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03672         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03673         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03674         ; FDSEARCH
                      (    forth6809.asm):03675         ;    Inputs:
                      (    forth6809.asm):03676         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03677         ;        RegY = address of the name text
                      (    forth6809.asm):03678         ;        RegB = name length
                      (    forth6809.asm):03679         ;    Outputs:
                      (    forth6809.asm):03680         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03681         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03682         ; ------------------------------------------------------------
D505 3424             (    forth6809.asm):03683         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D507 8C0000           (    forth6809.asm):03684         FDLOOP:     CMPX  #0
D50A 2733             (    forth6809.asm):03685                     BEQ   FDRET
D50C A684             (    forth6809.asm):03686                     LDA   ,X
D50E 8540             (    forth6809.asm):03687                     BITA  #$40
D510 2620             (    forth6809.asm):03688                     BNE   FDNEXT            ; smudged
D512 841F             (    forth6809.asm):03689                     ANDA  #$1F
D514 A1E4             (    forth6809.asm):03690                     CMPA  ,S
D516 261A             (    forth6809.asm):03691                     BNE   FDNEXT
D518 3410             (    forth6809.asm):03692                     PSHS  X                 ; header, kept across the compare
D51A 3001             (    forth6809.asm):03693                     LEAX  1,X
D51C 10AE63           (    forth6809.asm):03694                     LDY   3,S               ; name text
D51F E662             (    forth6809.asm):03695                     LDB   2,S               ; length
D521 2709             (    forth6809.asm):03696                     BEQ   FDHIT
D523 A680             (    forth6809.asm):03697         FDCMP:      LDA   ,X+
D525 A1A0             (    forth6809.asm):03698                     CMPA  ,Y+
D527 2607             (    forth6809.asm):03699                     BNE   FDMISS
D529 5A               (    forth6809.asm):03700                     DECB
D52A 26F7             (    forth6809.asm):03701                     BNE   FDCMP
D52C 3510             (    forth6809.asm):03702         FDHIT:      PULS  X                 ; header
D52E 200F             (    forth6809.asm):03703                     BRA   FDRET
D530 3510             (    forth6809.asm):03704         FDMISS:     PULS  X
D532 E684             (    forth6809.asm):03705         FDNEXT:     LDB   ,X
D534 C41F             (    forth6809.asm):03706                     ANDB  #$1F
D536 4F               (    forth6809.asm):03707                     CLRA
D537 3001             (    forth6809.asm):03708                     LEAX  1,X
D539 308B             (    forth6809.asm):03709                     LEAX  D,X
D53B AE84             (    forth6809.asm):03710                     LDX   ,X                ; LINK field
D53D 20C8             (    forth6809.asm):03711                     BRA   FDLOOP
D53F 3263             (    forth6809.asm):03712         FDRET:      LEAS  3,S
D541 39               (    forth6809.asm):03713                     RTS
                      (    forth6809.asm):03714         
                      (    forth6809.asm):03715         ; ------------------------------------------------------------
                      (    forth6809.asm):03716         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03717         ; ROOT, for a name.
                      (    forth6809.asm):03718         ; SRCHORD
                      (    forth6809.asm):03719         ;    Inputs:
                      (    forth6809.asm):03720         ;        RegY = address of the name text
                      (    forth6809.asm):03721         ;        RegB = name length
                      (    forth6809.asm):03722         ;    Outputs:
                      (    forth6809.asm):03723         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03724         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
D542 3424             (    forth6809.asm):03726         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D544 8E004B           (    forth6809.asm):03727                     LDX   #ORDER
D547 3410             (    forth6809.asm):03728                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D549 AEE4             (    forth6809.asm):03729         SOLOOP:     LDX   ,S
D54B 9C49             (    forth6809.asm):03730                     CMPX  ORDEND
D54D 2415             (    forth6809.asm):03731                     BHS   SOROOT
D54F 10AE81           (    forth6809.asm):03732                     LDY   ,X++              ; WID
D552 AFE4             (    forth6809.asm):03733                     STX   ,S
D554 AEA4             (    forth6809.asm):03734                     LDX   ,Y                ; newest header of that wordlist
D556 10AE63           (    forth6809.asm):03735                     LDY   3,S
D559 E662             (    forth6809.asm):03736                     LDB   2,S
D55B 8DA8             (    forth6809.asm):03737                     BSR   FDSEARCH
D55D 8C0000           (    forth6809.asm):03738                     CMPX  #0
D560 27E7             (    forth6809.asm):03739                     BEQ   SOLOOP
D562 2009             (    forth6809.asm):03740                     BRA   SORDONE
D564 9E5D             (    forth6809.asm):03741         SOROOT:     LDX   WLHEADS+2         ; ROOT
D566 10AE63           (    forth6809.asm):03742                     LDY   3,S
D569 E662             (    forth6809.asm):03743                     LDB   2,S
D56B 8D98             (    forth6809.asm):03744                     BSR   FDSEARCH
D56D 3265             (    forth6809.asm):03745         SORDONE:    LEAS  5,S
D56F 39               (    forth6809.asm):03746                     RTS
                      (    forth6809.asm):03747         
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
                      (    forth6809.asm):03749         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03750         ; HDRXT
                      (    forth6809.asm):03751         ;    Inputs:
                      (    forth6809.asm):03752         ;        RegX = header
                      (    forth6809.asm):03753         ;    Outputs:
                      (    forth6809.asm):03754         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03755         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03756         ; ------------------------------------------------------------
D570 A684             (    forth6809.asm):03757         HDRXT:      LDA   ,X
D572 1F89             (    forth6809.asm):03758                     TFR   A,B
D574 C41F             (    forth6809.asm):03759                     ANDB  #$1F
D576 3001             (    forth6809.asm):03760                     LEAX  1,X
D578 3A               (    forth6809.asm):03761                     ABX
D579 AE02             (    forth6809.asm):03762                     LDX   2,X               ; CFA field
D57B 39               (    forth6809.asm):03763                     RTS
                      (    forth6809.asm):03764         
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
                      (    forth6809.asm):03766         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03767         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03768         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03769         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03770         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03771         ; ------------------------------------------------------------
D57C 10AEC4           (    forth6809.asm):03772         FINDW:      LDY   ,U                ; counted string
D57F E6A0             (    forth6809.asm):03773                     LDB   ,Y+
D581 8DBF             (    forth6809.asm):03774                     BSR   SRCHORD
D583 8C0000           (    forth6809.asm):03775                     CMPX  #0
D586 2712             (    forth6809.asm):03776                     BEQ   NOTFOUND
D588 8DE6             (    forth6809.asm):03777                     BSR   HDRXT
D58A AFC4             (    forth6809.asm):03778                     STX   ,U                ; xt replaces c-addr
D58C 4D               (    forth6809.asm):03779                     TSTA
D58D 2A05             (    forth6809.asm):03780                     BPL   FISNORM
D58F CC0001           (    forth6809.asm):03781                     LDD   #1
D592 2003             (    forth6809.asm):03782                     BRA   FPUSH
D594 CCFFFF           (    forth6809.asm):03783         FISNORM:    LDD   #-1
D597 3606             (    forth6809.asm):03784         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D599 39               (    forth6809.asm):03785                     RTS
                      (    forth6809.asm):03786         
D59A CC0000           (    forth6809.asm):03787         NOTFOUND:   LDD   #0
D59D 3606             (    forth6809.asm):03788                     PSHU  D                 ; 0 = not found, c-addr still beneath
D59F 39               (    forth6809.asm):03789                     RTS
                      (    forth6809.asm):03790         
                      (    forth6809.asm):03791         ; ------------------------------------------------------------
                      (    forth6809.asm):03792         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03793         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03794         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03795         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03796         ; ------------------------------------------------------------
D5A0 3710             (    forth6809.asm):03797         SEARCHWLW:  PULU  X                 ; wid
D5A2 8D2D             (    forth6809.asm):03798                     BSR   WIDCHK
D5A4 AE84             (    forth6809.asm):03799                     LDX   ,X                ; newest header of the wordlist
D5A6 3706             (    forth6809.asm):03800                     PULU  D                 ; u
D5A8 3720             (    forth6809.asm):03801                     PULU  Y                 ; c-addr
D5AA 4D               (    forth6809.asm):03802                     TSTA
D5AB 261E             (    forth6809.asm):03803                     BNE   SWNOT             ; longer than any name
D5AD C11F             (    forth6809.asm):03804                     CMPB  #31
D5AF 221A             (    forth6809.asm):03805                     BHI   SWNOT
D5B1 BDD505           (    forth6809.asm):03806                     JSR   FDSEARCH
D5B4 8C0000           (    forth6809.asm):03807                     CMPX  #0
D5B7 2712             (    forth6809.asm):03808                     BEQ   SWNOT
D5B9 8DB5             (    forth6809.asm):03809                     BSR   HDRXT
D5BB 3610             (    forth6809.asm):03810                     PSHU  X                 ; xt
D5BD 4D               (    forth6809.asm):03811                     TSTA
D5BE 2A05             (    forth6809.asm):03812                     BPL   SWNORM
D5C0 CC0001           (    forth6809.asm):03813                     LDD   #1
D5C3 2003             (    forth6809.asm):03814                     BRA   SWPUSH
D5C5 CCFFFF           (    forth6809.asm):03815         SWNORM:     LDD   #-1
D5C8 3606             (    forth6809.asm):03816         SWPUSH:     PSHU  D
D5CA 39               (    forth6809.asm):03817                     RTS
D5CB CC0000           (    forth6809.asm):03818         SWNOT:      LDD   #0
D5CE 3606             (    forth6809.asm):03819                     PSHU  D
D5D0 39               (    forth6809.asm):03820                     RTS
                      (    forth6809.asm):03821         
                      (    forth6809.asm):03822         ; ------------------------------------------------------------
                      (    forth6809.asm):03823         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03824         ; WIDCHK
                      (    forth6809.asm):03825         ;    Inputs:
                      (    forth6809.asm):03826         ;        RegX = candidate WID
                      (    forth6809.asm):03827         ;    Outputs:
                      (    forth6809.asm):03828         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03829         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03830         ; ------------------------------------------------------------
D5D1 1F10             (    forth6809.asm):03831         WIDCHK:     TFR   X,D
D5D3 83005B           (    forth6809.asm):03832                     SUBD  #WLHEADS
D5D6 2509             (    forth6809.asm):03833                     BCS   WIDBAD
D5D8 C501             (    forth6809.asm):03834                     BITB  #1
D5DA 2605             (    forth6809.asm):03835                     BNE   WIDBAD
D5DC 9C45             (    forth6809.asm):03836                     CMPX  WLEND
D5DE 2401             (    forth6809.asm):03837                     BHS   WIDBAD
D5E0 39               (    forth6809.asm):03838                     RTS
D5E1 CCFFF5           (    forth6809.asm):03839         WIDBAD:     LDD   #-11
D5E4 3606             (    forth6809.asm):03840                     PSHU  D
D5E6 7ED9F1           (    forth6809.asm):03841                     JMP   THROWW
                      (    forth6809.asm):03842         
                      (    forth6809.asm):03843         ; ------------------------------------------------------------
                      (    forth6809.asm):03844         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03845         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03846         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03847         ; WLINIT
                      (    forth6809.asm):03848         ;    Inputs:
                      (    forth6809.asm):03849         ;        none
                      (    forth6809.asm):03850         ;    Outputs:
                      (    forth6809.asm):03851         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03852         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03853         ; ------------------------------------------------------------
D5E9 CCCD8A           (    forth6809.asm):03854         WLINIT:     LDD   #BASELATEST
D5EC DD5B             (    forth6809.asm):03855                     STD   WLHEADS
D5EE CCC45B           (    forth6809.asm):03856                     LDD   #BASEROOTLATEST
D5F1 DD5D             (    forth6809.asm):03857                     STD   WLHEADS+2
D5F3 CCC45B           (    forth6809.asm):03858                     LDD   #H_FORTH
D5F6 DD6F             (    forth6809.asm):03859                     STD   WLNAMES
D5F8 CCC452           (    forth6809.asm):03860                     LDD   #H_ROOT
D5FB DD71             (    forth6809.asm):03861                     STD   WLNAMES+2
D5FD CC005F           (    forth6809.asm):03862                     LDD   #WLHEADS+4
D600 DD45             (    forth6809.asm):03863                     STD   WLEND
D602 CC005B           (    forth6809.asm):03864                     LDD   #WLHEADS
D605 DD47             (    forth6809.asm):03865                     STD   CURRENT
D607 7ED6D7           (    forth6809.asm):03866                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03867         
                      (    forth6809.asm):03868         ; ------------------------------------------------------------
                      (    forth6809.asm):03869         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03870         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03871         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03872         ; PRUNE
                      (    forth6809.asm):03873         ;    Inputs:
                      (    forth6809.asm):03874         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03875         ;    Outputs:
                      (    forth6809.asm):03876         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03877         ;        into ROM
                      (    forth6809.asm):03878         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03879         ; ------------------------------------------------------------
D60A 3406             (    forth6809.asm):03880         PRUNE:      PSHS  D                 ; 0,S = mark
D60C 8E005B           (    forth6809.asm):03881                     LDX   #WLHEADS
D60F 9C45             (    forth6809.asm):03882         PRLOOP:     CMPX  WLEND
D611 2421             (    forth6809.asm):03883                     BHS   PRNDONE
D613 10AE84           (    forth6809.asm):03884                     LDY   ,X                ; newest header of this wordlist
D616 108CC000         (    forth6809.asm):03885         PRWALK:     CMPY  #ROMSTRT
D61A 2413             (    forth6809.asm):03886                     BHS   PRSTORE           ; ROM header: keep
D61C 10ACE4           (    forth6809.asm):03887                     CMPY  ,S
D61F 250E             (    forth6809.asm):03888                     BLO   PRSTORE           ; below the mark (or empty): keep
D621 E6A4             (    forth6809.asm):03889                     LDB   ,Y
D623 C41F             (    forth6809.asm):03890                     ANDB  #$1F
D625 4F               (    forth6809.asm):03891                     CLRA
D626 3121             (    forth6809.asm):03892                     LEAY  1,Y
D628 31AB             (    forth6809.asm):03893                     LEAY  D,Y
D62A 10AEA4           (    forth6809.asm):03894                     LDY   ,Y                ; follow the LINK
D62D 20E7             (    forth6809.asm):03895                     BRA   PRWALK
D62F 10AF81           (    forth6809.asm):03896         PRSTORE:    STY   ,X++
D632 20DB             (    forth6809.asm):03897                     BRA   PRLOOP
D634 3262             (    forth6809.asm):03898         PRNDONE:     LEAS  2,S
D636 39               (    forth6809.asm):03899                     RTS
                      (    forth6809.asm):03900         
                      (    forth6809.asm):03901         ; ============================================================
                      (    forth6809.asm):03902         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03903         ; ============================================================
                      (    forth6809.asm):03904         ; ------------------------------------------------------------
                      (    forth6809.asm):03905         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03906         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03907         ; ------------------------------------------------------------
D637 9E45             (    forth6809.asm):03908         WORDLISTW:  LDX   WLEND
D639 8C006F           (    forth6809.asm):03909                     CMPX  #WLHEADS+2*WLCELLS
D63C 240F             (    forth6809.asm):03910                     BHS   WLFULL
D63E CC0000           (    forth6809.asm):03911                     LDD   #0
D641 ED84             (    forth6809.asm):03912                     STD   ,X
D643 ED8814           (    forth6809.asm):03913                     STD   WLNOFF,X
D646 3610             (    forth6809.asm):03914                     PSHU  X
D648 3002             (    forth6809.asm):03915                     LEAX  2,X
D64A 9F45             (    forth6809.asm):03916                     STX   WLEND
D64C 39               (    forth6809.asm):03917                     RTS
D64D CCFFF8           (    forth6809.asm):03918         WLFULL:     LDD   #-8
D650 3606             (    forth6809.asm):03919                     PSHU  D
D652 7ED9F1           (    forth6809.asm):03920                     JMP   THROWW
                      (    forth6809.asm):03921         
                      (    forth6809.asm):03922         ; ------------------------------------------------------------
                      (    forth6809.asm):03923         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03924         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03925         ; ------------------------------------------------------------
D655 CC005B           (    forth6809.asm):03926         FORTHWLW:   LDD   #WLHEADS
D658 3606             (    forth6809.asm):03927                     PSHU  D
D65A 39               (    forth6809.asm):03928                     RTS
                      (    forth6809.asm):03929         
                      (    forth6809.asm):03930         ; ------------------------------------------------------------
                      (    forth6809.asm):03931         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03932         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03933         ; it, as it is always searched last.
                      (    forth6809.asm):03934         ; ------------------------------------------------------------
D65B 9E49             (    forth6809.asm):03935         GETORDERW:  LDX   ORDEND

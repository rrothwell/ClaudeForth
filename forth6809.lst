D66F 3606             (    forth6809.asm):03945                     PSHU  D                 ; n
D671 39               (    forth6809.asm):03946                     RTS
                      (    forth6809.asm):03947         
                      (    forth6809.asm):03948         ; ------------------------------------------------------------
                      (    forth6809.asm):03949         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03950         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03951         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03952         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03953         ; ------------------------------------------------------------
D672 3706             (    forth6809.asm):03954         SETORDERW:  PULU  D                 ; n
D674 1083FFFF         (    forth6809.asm):03955                     CMPD  #-1
D678 275D             (    forth6809.asm):03956                     BEQ   ONLYW             ; the minimum order
D67A 4D               (    forth6809.asm):03957         SO1:        TSTA
D67B 2B31             (    forth6809.asm):03958                     BMI   SOUNDER
D67D 262A             (    forth6809.asm):03959                     BNE   SOOVER
D67F C108             (    forth6809.asm):03960                     CMPB  #WLMAX
D681 2226             (    forth6809.asm):03961                     BHI   SOOVER
D683 3404             (    forth6809.asm):03962                     PSHS  B                 ; 1,S = n
D685 3404             (    forth6809.asm):03963                     PSHS  B                 ; 0,S = count down
D687 1F32             (    forth6809.asm):03964                     TFR   U,Y
D689 6DE4             (    forth6809.asm):03965         SOCHK:      TST   ,S
D68B 2709             (    forth6809.asm):03966                     BEQ   SOCOPY
D68D AEA1             (    forth6809.asm):03967                     LDX   ,Y++
D68F BDD5D1           (    forth6809.asm):03968                     JSR   WIDCHK            ; keeps Y
D692 6AE4             (    forth6809.asm):03969                     DEC   ,S
D694 20F3             (    forth6809.asm):03970                     BRA   SOCHK
D696 3506             (    forth6809.asm):03971         SOCOPY:     PULS  A,B               ; B = n
D698 8E004B           (    forth6809.asm):03972                     LDX   #ORDER
D69B 5D               (    forth6809.asm):03973         SOCP2:      TSTB
D69C 2708             (    forth6809.asm):03974                     BEQ   SOCPEND
D69E 3720             (    forth6809.asm):03975                     PULU  Y
D6A0 10AF81           (    forth6809.asm):03976                     STY   ,X++
D6A3 5A               (    forth6809.asm):03977                     DECB
D6A4 20F5             (    forth6809.asm):03978                     BRA   SOCP2
D6A6 9F49             (    forth6809.asm):03979         SOCPEND:    STX   ORDEND
D6A8 39               (    forth6809.asm):03980                     RTS
D6A9 CCFFCF           (    forth6809.asm):03981         SOOVER:     LDD   #-49
D6AC 2003             (    forth6809.asm):03982                     BRA   SOTHROW
D6AE CCFFCE           (    forth6809.asm):03983         SOUNDER:    LDD   #-50
D6B1 3606             (    forth6809.asm):03984         SOTHROW:    PSHU  D

                      (    forth6809.asm):01499                    BRA   DPDONE
C100                  (    forth6809.asm):01500         DPFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):01501         DPDONE:    LDX   #TSTDROPNAME
                      (    forth6809.asm):01502                    PSHU  X

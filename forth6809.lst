                      (    forth6809.asm):03599         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03600         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03601         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03602         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03603         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03604         ; ------------------------------------------------------------
D37F 3706             (    forth6809.asm):03605         WORDW:      PULU  D                 ; char
D381 327D             (    forth6809.asm):03606                     LEAS  -3,S              ; frame (5k): 0,S = delimiter,
D383 E7E4             (    forth6809.asm):03607                     STB   ,S                ; 1,S = start of the text

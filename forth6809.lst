                      (    forth6809.asm):10891         ; ------------------------------------------------------------
                      (    forth6809.asm):10892         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10893         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10894         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10895         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10896         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10897         ; sequential walk-through per region.
                      (    forth6809.asm):10898         ;
                      (    forth6809.asm):10899         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10900         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10901         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10902         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10903         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10904         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10905         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10906         ; ------------------------------------------------------------
C275 BDFC2B           (    forth6809.asm):10907         TSTMEMORY: JSR CRW
C278 8EC289           (    forth6809.asm):10908                    LDX   #TSTMEMMSG
C27B 3610             (    forth6809.asm):10909                    PSHU  X
C27D CC0006           (    forth6809.asm):10910                    LDD   #6
C280 3606             (    forth6809.asm):10911                    PSHU  D
C282 BDF60B           (    forth6809.asm):10912                    JSR   TYPE
C285 BDFC2B           (    forth6809.asm):10913                    JSR   CRW
                      (    forth6809.asm):10914         
                      (    forth6809.asm):10915                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10916         
                      (    forth6809.asm):10917                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10918                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10919                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10920                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10921                    JSR   TSTCODEHERE
                      (    forth6809.asm):10922                    JSR   TSTVARHERE
                      (    forth6809.asm):10923                    JSR   TSTPAD
                      (    forth6809.asm):10924                    JSR   TSTUNUSED
                      (    forth6809.asm):10925                    JSR   TSTVUNUSED
                      (    forth6809.asm):10926                    JSR   TSTFILL
                      (    forth6809.asm):10927                    JSR   TSTERASE
                      (    forth6809.asm):10928                    JSR   TSTCMOVE
                      (    forth6809.asm):10929                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10930                    JSR   TSTMOVE1
                      (    forth6809.asm):10931                    JSR   TSTMOVE2
                      (    forth6809.asm):10932                    JSR   TSTMOVE3
                      (    forth6809.asm):10933         
                      (    forth6809.asm):10934                    ENDC ; <<<<
                      (    forth6809.asm):10935         
C288 39               (    forth6809.asm):10936                    RTS
                      (    forth6809.asm):10937         
C289 4D656D6F7279     (    forth6809.asm):10938         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10939         
                      (    forth6809.asm):10940                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10941         
                      (    forth6809.asm):10942         ; ------------------------------------------------------------
                      (    forth6809.asm):10943         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10944         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10945         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10946         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10947         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10948         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10949         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10950         ; runs exclusively of every other.
                      (    forth6809.asm):10951         ;
                      (    forth6809.asm):10952         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10953         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10954         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10955         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10956         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10957         ; ------------------------------------------------------------
                      (    forth6809.asm):10958         
                      (    forth6809.asm):10959         ; ------------------------------------------------------------
                      (    forth6809.asm):10960         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10961         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10962         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10963         ; ------------------------------------------------------------
C28F                  (    forth6809.asm):10964         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10965         
                      (    forth6809.asm):10966                        LDD  #TSTGUARD
                      (    forth6809.asm):10967                        PSHU D
                      (    forth6809.asm):10968                        LDD  #TSTVAL1
                      (    forth6809.asm):10969                        PSHU D
                      (    forth6809.asm):10970                        LDD  #TSTCBUF
                      (    forth6809.asm):10971                        PSHU D
                      (    forth6809.asm):10972                        STU  TSTUB4
                      (    forth6809.asm):10973         
                      (    forth6809.asm):10974                        JSR  STOREW
                      (    forth6809.asm):10975         
                      (    forth6809.asm):10976                        LDD  #TSTCBUF
                      (    forth6809.asm):10977                        PSHU D
                      (    forth6809.asm):10978         
                      (    forth6809.asm):10979                        JSR  ATSIGN
                      (    forth6809.asm):10980         
                      (    forth6809.asm):10981                        STU  TSTUAF
                      (    forth6809.asm):10982         
                      (    forth6809.asm):10983                        PULU D
                      (    forth6809.asm):10984                        CMPD #TSTVAL1
                      (    forth6809.asm):10985                        BNE  FSFAIL
                      (    forth6809.asm):10986                        PULU D
                      (    forth6809.asm):10987                        CMPD #TSTGUARD
                      (    forth6809.asm):10988                        BNE  FSFAIL
                      (    forth6809.asm):10989         
                      (    forth6809.asm):10990                        LDD  TSTUB4
                      (    forth6809.asm):10991                        SUBD TSTUAF
                      (    forth6809.asm):10992                        CMPD #-2
                      (    forth6809.asm):10993                        BNE  FSFAIL
                      (    forth6809.asm):10994         
                      (    forth6809.asm):10995                        LDD  #TRUEV
                      (    forth6809.asm):10996                        BRA  FSDONE
C28F                  (    forth6809.asm):10997         FSFAIL:        LDD  #FALSEV
C28F                  (    forth6809.asm):10998         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):10999                        PSHU X
                      (    forth6809.asm):11000                        PSHU D
                      (    forth6809.asm):11001                        JSR  TSTREPORT
                      (    forth6809.asm):11002         
                      (    forth6809.asm):11003                        LDU  TSTU0
                      (    forth6809.asm):11004                        RTS
                      (    forth6809.asm):11005         
C28F                  (    forth6809.asm):11006         TSTFSNAME: FCB  13
                      (    forth6809.asm):11007                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):11008         
                      (    forth6809.asm):11009         ; ------------------------------------------------------------
                      (    forth6809.asm):11010         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):11011         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):11012         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):11013         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):11014         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):11015         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):11016         ; whatever was there).
                      (    forth6809.asm):11017         ;
                      (    forth6809.asm):11018         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):11019         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):11020         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):11021         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):11022         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):11023         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):11024         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):11025         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):11026         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):11027         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):11028         ; byte ends up where was wrong.
                      (    forth6809.asm):11029         ; ------------------------------------------------------------
C28F                  (    forth6809.asm):11030         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):11031                         STD  TSTCBUF
                      (    forth6809.asm):11032         
                      (    forth6809.asm):11033                         STU  TSTU0
                      (    forth6809.asm):11034         
                      (    forth6809.asm):11035                         LDD  #TSTGUARD
                      (    forth6809.asm):11036                         PSHU D
                      (    forth6809.asm):11037                         LDD  #$34
                      (    forth6809.asm):11038                         PSHU D
                      (    forth6809.asm):11039                         LDD  #TSTCBUF
                      (    forth6809.asm):11040                         PSHU D
                      (    forth6809.asm):11041                         STU  TSTUB4
                      (    forth6809.asm):11042         
                      (    forth6809.asm):11043                         JSR  CSTOREW
                      (    forth6809.asm):11044         
                      (    forth6809.asm):11045                         LDD  TSTCBUF
                      (    forth6809.asm):11046                         CMPD #$34FF
                      (    forth6809.asm):11047                         BNE  CFFAIL
                      (    forth6809.asm):11048         
                      (    forth6809.asm):11049                         LDD  #TSTCBUF
                      (    forth6809.asm):11050                         PSHU D
                      (    forth6809.asm):11051         
                      (    forth6809.asm):11052                         JSR  CFETCH
                      (    forth6809.asm):11053         
                      (    forth6809.asm):11054                         STU  TSTUAF
                      (    forth6809.asm):11055         
                      (    forth6809.asm):11056                         PULU D
                      (    forth6809.asm):11057                         CMPD #$0034
                      (    forth6809.asm):11058                         BNE  CFFAIL
                      (    forth6809.asm):11059                         PULU D
                      (    forth6809.asm):11060                         CMPD #TSTGUARD
                      (    forth6809.asm):11061                         BNE  CFFAIL
                      (    forth6809.asm):11062         
                      (    forth6809.asm):11063                         LDD  TSTUB4
                      (    forth6809.asm):11064                         SUBD TSTUAF
                      (    forth6809.asm):11065                         CMPD #-2
                      (    forth6809.asm):11066                         BNE  CFFAIL
                      (    forth6809.asm):11067         
                      (    forth6809.asm):11068                         LDD  #TRUEV
                      (    forth6809.asm):11069                         BRA  CFDONE
C28F                  (    forth6809.asm):11070         CFFAIL:         LDD  #FALSEV
C28F                  (    forth6809.asm):11071         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11072                         PSHU X
                      (    forth6809.asm):11073                         PSHU D
                      (    forth6809.asm):11074                         JSR  TSTREPORT
                      (    forth6809.asm):11075         
                      (    forth6809.asm):11076                         LDU  TSTU0
                      (    forth6809.asm):11077                         RTS
                      (    forth6809.asm):11078         
C28F                  (    forth6809.asm):11079         TSTCFNAME: FCB  14
                      (    forth6809.asm):11080                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11081         
                      (    forth6809.asm):11082         ; ------------------------------------------------------------
                      (    forth6809.asm):11083         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11084         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11085         ; correctly.
                      (    forth6809.asm):11086         ; ------------------------------------------------------------
C28F                  (    forth6809.asm):11087         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11088                       STD  TSTCBUF
                      (    forth6809.asm):11089         
                      (    forth6809.asm):11090                       STU  TSTU0
                      (    forth6809.asm):11091         
                      (    forth6809.asm):11092                       LDD  #TSTGUARD
                      (    forth6809.asm):11093                       PSHU D
                      (    forth6809.asm):11094                       LDD  #100
                      (    forth6809.asm):11095                       PSHU D
                      (    forth6809.asm):11096                       LDD  #TSTCBUF
                      (    forth6809.asm):11097                       PSHU D
                      (    forth6809.asm):11098                       STU  TSTUB4
                      (    forth6809.asm):11099         
                      (    forth6809.asm):11100                       JSR  PLUSSTORE
                      (    forth6809.asm):11101         
                      (    forth6809.asm):11102                       STU  TSTUAF
                      (    forth6809.asm):11103         
                      (    forth6809.asm):11104                       LDD  TSTCBUF
                      (    forth6809.asm):11105                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11106                       BNE  PSFAIL
                      (    forth6809.asm):11107         
                      (    forth6809.asm):11108                       PULU D
                      (    forth6809.asm):11109                       CMPD #TSTGUARD
                      (    forth6809.asm):11110                       BNE  PSFAIL
                      (    forth6809.asm):11111         
                      (    forth6809.asm):11112                       LDD  TSTUB4
                      (    forth6809.asm):11113                       SUBD TSTUAF
                      (    forth6809.asm):11114                       CMPD #-4
                      (    forth6809.asm):11115                       BNE  PSFAIL
                      (    forth6809.asm):11116         
                      (    forth6809.asm):11117                       LDD  #TRUEV
                      (    forth6809.asm):11118                       BRA  PSDONE
C28F                  (    forth6809.asm):11119         PSFAIL:       LDD  #FALSEV
C28F                  (    forth6809.asm):11120         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11121                       PSHU X
                      (    forth6809.asm):11122                       PSHU D
                      (    forth6809.asm):11123                       JSR  TSTREPORT
                      (    forth6809.asm):11124         
                      (    forth6809.asm):11125                       LDU  TSTU0
                      (    forth6809.asm):11126                       RTS
                      (    forth6809.asm):11127         
C28F                  (    forth6809.asm):11128         TSTPSNAME: FCB  12
                      (    forth6809.asm):11129                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11130         
                      (    forth6809.asm):11131         ; ------------------------------------------------------------
                      (    forth6809.asm):11132         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11133         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11134         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11135         ; the documented convention on both ends).
                      (    forth6809.asm):11136         ; ------------------------------------------------------------
C28F                  (    forth6809.asm):11137         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11138         
                      (    forth6809.asm):11139                         LDD  #TSTGUARD
                      (    forth6809.asm):11140                         PSHU D
                      (    forth6809.asm):11141                         LDD  #TSTVAL1
                      (    forth6809.asm):11142                         PSHU D
                      (    forth6809.asm):11143                         LDD  #TSTVAL2
                      (    forth6809.asm):11144                         PSHU D
                      (    forth6809.asm):11145                         LDD  #TSTCBUF
                      (    forth6809.asm):11146                         PSHU D
                      (    forth6809.asm):11147                         STU  TSTUB4
                      (    forth6809.asm):11148         
                      (    forth6809.asm):11149                         JSR  DSTORE
                      (    forth6809.asm):11150         
                      (    forth6809.asm):11151                         LDD  #TSTCBUF
                      (    forth6809.asm):11152                         PSHU D
                      (    forth6809.asm):11153         
                      (    forth6809.asm):11154                         JSR  DFETCH
                      (    forth6809.asm):11155         
                      (    forth6809.asm):11156                         STU  TSTUAF
                      (    forth6809.asm):11157         
                      (    forth6809.asm):11158                         PULU D
                      (    forth6809.asm):11159                         CMPD #TSTVAL2
                      (    forth6809.asm):11160                         BNE  DFFAIL
                      (    forth6809.asm):11161                         PULU D
                      (    forth6809.asm):11162                         CMPD #TSTVAL1
                      (    forth6809.asm):11163                         BNE  DFFAIL
                      (    forth6809.asm):11164                         PULU D
                      (    forth6809.asm):11165                         CMPD #TSTGUARD
                      (    forth6809.asm):11166                         BNE  DFFAIL
                      (    forth6809.asm):11167         
                      (    forth6809.asm):11168                         LDD  TSTUB4
                      (    forth6809.asm):11169                         SUBD TSTUAF
                      (    forth6809.asm):11170                         CMPD #-2
                      (    forth6809.asm):11171                         BNE  DFFAIL
                      (    forth6809.asm):11172         
                      (    forth6809.asm):11173                         LDD  TSTCBUF
                      (    forth6809.asm):11174                         CMPD #TSTVAL1
                      (    forth6809.asm):11175                         BNE  DFFAIL
                      (    forth6809.asm):11176                         LDD  TSTCBUF+2
                      (    forth6809.asm):11177                         CMPD #TSTVAL2
                      (    forth6809.asm):11178                         BNE  DFFAIL
                      (    forth6809.asm):11179         
                      (    forth6809.asm):11180                         LDD  #TRUEV
                      (    forth6809.asm):11181                         BRA  DFDONE
C28F                  (    forth6809.asm):11182         DFFAIL:         LDD  #FALSEV
C28F                  (    forth6809.asm):11183         DFDONE:         LDX  #TSTDFNAME
                      (    forth6809.asm):11184                         PSHU X
                      (    forth6809.asm):11185                         PSHU D
                      (    forth6809.asm):11186                         JSR  TSTREPORT
                      (    forth6809.asm):11187         
                      (    forth6809.asm):11188                         LDU  TSTU0
                      (    forth6809.asm):11189                         RTS
                      (    forth6809.asm):11190         
C28F                  (    forth6809.asm):11191         TSTDFNAME: FCB  14
                      (    forth6809.asm):11192                    FCC  "TST2FETCHSTORE"
                      (    forth6809.asm):11193         
                      (    forth6809.asm):11194         ; ------------------------------------------------------------
                      (    forth6809.asm):11195         ; TSTCODEHERE - combined unit test for , C, ALLOT, and HERE
                      (    forth6809.asm):11196         ; together (glossary section 3.11's own CODEHERE-region words).
                      (    forth6809.asm):11197         ; Redirects CODEHERE to scratch and walks through a sequence:
                      (    forth6809.asm):11198         ; HERE reports the redirected value, COMMA appends a cell (and
                      (    forth6809.asm):11199         ; the written cell is verified directly, not just the advance),
                      (    forth6809.asm):11200         ; C, appends a byte (verified the same way), ALLOT reserves then
                      (    forth6809.asm):11201         ; releases bytes (confirming both directions work, matching
                      (    forth6809.asm):11202         ; "reserve (or release, if negative)"), and a final HERE
                      (    forth6809.asm):11203         ; confirms the cumulative result.
                      (    forth6809.asm):11204         ; ------------------------------------------------------------
C28F                  (    forth6809.asm):11205         TSTCODEHERE: LDD  CODEHERE
                      (    forth6809.asm):11206                      STD  TSTCSAV
                      (    forth6809.asm):11207         
                      (    forth6809.asm):11208                      LDD  #TSTCBUF
                      (    forth6809.asm):11209                      STD  CODEHERE
                      (    forth6809.asm):11210         
                      (    forth6809.asm):11211                      STU  TSTU0
                      (    forth6809.asm):11212         
                      (    forth6809.asm):11213                      LDD  #TSTGUARD
                      (    forth6809.asm):11214                      PSHU D

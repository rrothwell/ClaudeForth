                      (    forth6809.asm):02251                                           ; loop back for more (see header comment).
DD69                  (    forth6809.asm):02252         FLUSHED:
                      (    forth6809.asm):02253                 RTS
                      (    forth6809.asm):02254         ; ------------------------------------------------------------
                      (    forth6809.asm):02255         ; PUTCHAR
                      (    forth6809.asm):02256         ;    Inputs:
                      (    forth6809.asm):02257         ;        RegA = character to insert into transmit buffer.
                      (    forth6809.asm):02258         ;    Outputs:
                      (    forth6809.asm):02259         ;        none 
                      (    forth6809.asm):02260         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02261         PUTCHAR:
                      (    forth6809.asm):02262                     PSHS  CC,X              

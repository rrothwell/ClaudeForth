                      (    forth6809.asm):01038                    JSR   QDUP
                      (    forth6809.asm):01039         
                      (    forth6809.asm):01040                    STU   TSTUAF
                      (    forth6809.asm):01041         
                      (    forth6809.asm):01042                    PULU  D
                      (    forth6809.asm):01043                    CMPD  #TSTVAL1
                      (    forth6809.asm):01044                    BNE   QNFAIL
                      (    forth6809.asm):01045                    PULU  D

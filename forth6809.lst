                      (    forth6809.asm):10885                     CMPD #-2
                      (    forth6809.asm):10886                     BNE  AQ2FAIL
                      (    forth6809.asm):10887         
                      (    forth6809.asm):10888                     LDD  TSTUB4
                      (    forth6809.asm):10889                     SUBD TSTUAF
                      (    forth6809.asm):10890                     CMPD #0
                      (    forth6809.asm):10891                     BNE  AQ2FAIL
                      (    forth6809.asm):10892         
                      (    forth6809.asm):10893                     LDD  #TRUEV
                      (    forth6809.asm):10894                     BRA  AQ2DONE
C27E                  (    forth6809.asm):10895         AQ2FAIL:    LDD  #FALSEV
C27E                  (    forth6809.asm):10896         AQ2DONE:    LDX  #TSTAQ2NAME
                      (    forth6809.asm):10897                     PSHU X
                      (    forth6809.asm):10898                     PSHU D
                      (    forth6809.asm):10899                     JSR  TSTREPORT
                      (    forth6809.asm):10900         
                      (    forth6809.asm):10901                     LDU  TSTU0

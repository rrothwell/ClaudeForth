                      (    forth6809.asm):01590                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01591                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01592                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01593                                        ; WARM message left the location counter,
                      (    forth6809.asm):01594                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01595                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01596                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01597         
                      (    forth6809.asm):01598         ; ------------------------------------------------------------
                      (    forth6809.asm):01599         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01600         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01601         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01602         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01603         ; ------------------------------------------------------------

F47A 3706             (    forth6809.asm):06432         PARSEW:     PULU  D                 ; char
F47C 3404             (    forth6809.asm):06433                     PSHS  B                 ; 0,S = delimiter (5k: no scratch cells)
F47E DC4E             (    forth6809.asm):06434                     LDD   SRCLEN
F480 9310             (    forth6809.asm):06435                     SUBD  TOIN
F482 10250035         (    forth6809.asm):06436                     LBLO  PEMP              ; See bugfix: PARSEW.1
F486 1F02             (    forth6809.asm):06437                     TFR   D,Y
F488 DC10             (    forth6809.asm):06438                     LDD   TOIN
F48A 9E4C             (    forth6809.asm):06439                     LDX   SRCADDR

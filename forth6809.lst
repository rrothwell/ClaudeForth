E809 EC62             (    forth6809.asm):04165                     LDD   2,S
E80B D314             (    forth6809.asm):04166                     ADDD  MSCR              ; new_index = old_index + step
E80D ED62             (    forth6809.asm):04167                     STD   2,S
E80F A364             (    forth6809.asm):04168                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E811 DD18             (    forth6809.asm):04169                     STD   MSCR3
                      (    forth6809.asm):04170                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04171                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04172                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

                      (    forth6809.asm):05514         ; "IF <lit 111> ELSE <lit 222> THEN" into scratch. True flag
                      (    forth6809.asm):05515         ; should take the IF-body (111) and skip the ELSE-body (222)
                      (    forth6809.asm):05516         ; via ELSE's own unconditional branch. Verified by hand-trace:
                      (    forth6809.asm):05517         ; IF's patched offset (12) lands exactly at the ELSE-body's
                      (    forth6809.asm):05518         ; start; ELSE's own patched offset (7) lands exactly past it.
                      (    forth6809.asm):05519         ; ------------------------------------------------------------

                      (    forth6809.asm):01975         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01976         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01977         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01978         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01979         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01980         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01981         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01982         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01983         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01984         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01985         ; were chained on after H_QUIT in a later turn.
DCF8 05               (    forth6809.asm):01986         H_ABORT: FCB   5
DCF9 41424F5254       (    forth6809.asm):01987                  FCC   "ABORT"
DCFE DCEE             (    forth6809.asm):01988                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01989                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01990                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01991                                        ; now H_FALSE, the chain's newest entry
DD00 DD9F             (    forth6809.asm):01992                  FDB   ABORT
                      (    forth6809.asm):01993         
DD02 04               (    forth6809.asm):01994         H_QUIT:  FCB   4
DD03 51554954         (    forth6809.asm):01995                  FCC   "QUIT"
DD07 DCF8             (    forth6809.asm):01996                  FDB   H_ABORT
DD09 DDA2             (    forth6809.asm):01997                  FDB   QUIT
                      (    forth6809.asm):01998         
                      (    forth6809.asm):01999         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):02000         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):02001         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):02002         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):02003         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):02004         ; reconstructs and pushes the original c-addr, then 0.
DD0B 04               (    forth6809.asm):02005         H_FIND:  FCB   4
DD0C 46494E44         (    forth6809.asm):02006                  FCC   "FIND"
DD10 DD02             (    forth6809.asm):02007                  FDB   H_QUIT

DD48 32               (    forth6809.asm):02089                     FCC   "2"
DD49 DD40             (    forth6809.asm):02090                     FDB   H_M1
DD4B FEE5             (    forth6809.asm):02091                     FDB   TWOBODY
                      (    forth6809.asm):02092         

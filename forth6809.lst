                      (    forth6809.asm):04160         ; ------------------------------------------------------------
                      (    forth6809.asm):04161         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04162         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04163         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04164         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04165         ; DOTEST
                      (    forth6809.asm):04166         ;    Inputs:
                      (    forth6809.asm):04167         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04168         ;        first)
                      (    forth6809.asm):04169         ;    Outputs:
                      (    forth6809.asm):04170         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04171         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04172         ; ------------------------------------------------------------

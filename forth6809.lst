E430 EC42             (    forth6809.asm):03556                     LDD   2,U
E432 43               (    forth6809.asm):03557                     COMA
E433 53               (    forth6809.asm):03558                     COMB
E434 C30001           (    forth6809.asm):03559                     ADDD  #1
E437 ED42             (    forth6809.asm):03560                     STD   2,U
E439 2407             (    forth6809.asm):03561                     BCC   NQPOS32
E43B ECC4             (    forth6809.asm):03562                     LDD   ,U
E43D C30001           (    forth6809.asm):03563                     ADDD  #1
E440 EDC4             (    forth6809.asm):03564                     STD   ,U
                      (    forth6809.asm):03565         
E442                  (    forth6809.asm):03566         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):03567                     ; last character was '.' - determines which return convention
E442 AEE4             (    forth6809.asm):03568                     LDX   ,S
E444 E684             (    forth6809.asm):03569                     LDB   ,X
E446 5A               (    forth6809.asm):03570                     DECB
E447 3001             (    forth6809.asm):03571                     LEAX  1,X
E449 A685             (    forth6809.asm):03572                     LDA   B,X
E44B 3263             (    forth6809.asm):03573                     LEAS  3,S
E44D 812E             (    forth6809.asm):03574                     CMPA  #'.'
E44F 2606             (    forth6809.asm):03575                     BNE   NQSINGLE
                      (    forth6809.asm):03576         
                      (    forth6809.asm):03577                     ; DOUBLE success: ud is already low below high; add a
                      (    forth6809.asm):03578                     ; distinct success code (1, not -1) so TRYNUM can tell
                      (    forth6809.asm):03579                     ; single and double apart
E451 CC0001           (    forth6809.asm):03580                     LDD   #1
E454 3606             (    forth6809.asm):03581                     PSHU  D
E456 39               (    forth6809.asm):03582                     RTS
                      (    forth6809.asm):03583         
E457 3342             (    forth6809.asm):03584         NQSINGLE:   LEAU  2,U               ; SINGLE success: drop the high cell
E459 CCFFFF           (    forth6809.asm):03585                     LDD   #-1
E45C 3606             (    forth6809.asm):03586                     PSHU  D
E45E 39               (    forth6809.asm):03587                     RTS
                      (    forth6809.asm):03588         
E45F 3348             (    forth6809.asm):03589         NQBADF:     LEAU  8,U               ; drop the frame
E461 AEE4             (    forth6809.asm):03590         NQBAD:      LDX   ,S
E463 3263             (    forth6809.asm):03591                     LEAS  3,S
E465 3610             (    forth6809.asm):03592                     PSHU  X
E467 CC0000           (    forth6809.asm):03593                     LDD   #0
E46A 3606             (    forth6809.asm):03594                     PSHU  D
E46C 39               (    forth6809.asm):03595                     RTS
                      (    forth6809.asm):03596         
                      (    forth6809.asm):03597         ; ============================================================
                      (    forth6809.asm):03598         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03599         ; ============================================================
                      (    forth6809.asm):03600                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03601         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03602         
                      (    forth6809.asm):03603         ; ------------------------------------------------------------
                      (    forth6809.asm):03604         ; KEY  ( -- char )
                      (    forth6809.asm):03605         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03606         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03607         ; ------------------------------------------------------------
E46D                  (    forth6809.asm):03608         KEYW:
                      (    forth6809.asm):03609         
E46D 7D0178           (    forth6809.asm):03610                     TST   RTSSTATE          ; Is throttling?
E470 2703             (    forth6809.asm):03611                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03612         
                      (    forth6809.asm):03613                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E472 BDDC7E           (    forth6809.asm):03614                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03615                                             ; by transmitting all chars.
                      (    forth6809.asm):03616         
E475                  (    forth6809.asm):03617         TRY_READ:
E475 BDDCEB           (    forth6809.asm):03618                     JSR   GETCHAR           ; Is char available in input buffer.
E478 25F3             (    forth6809.asm):03619                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03620                                             ; while still transmitting!
                      (    forth6809.asm):03621         
E47A 1F89             (    forth6809.asm):03622                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E47C 4F               (    forth6809.asm):03623                     CLRA                    ; Clear MSB.
E47D 3606             (    forth6809.asm):03624                     PSHU  D                 ; char
                      (    forth6809.asm):03625         
E47F 39               (    forth6809.asm):03626                     RTS
                      (    forth6809.asm):03627         
                      (    forth6809.asm):03628         ; ------------------------------------------------------------
                      (    forth6809.asm):03629         ; KEY?  ( -- flag )
                      (    forth6809.asm):03630         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03631         ; ------------------------------------------------------------
E480                  (    forth6809.asm):03632         KEYQW:
                      (    forth6809.asm):03633                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03634         
E480 B60176           (    forth6809.asm):03635                     LDA   INHEAD            ; Characters received?
E483 B10177           (    forth6809.asm):03636                     CMPA  INTAIL
                      (    forth6809.asm):03637         
                      (    forth6809.asm):03638                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03639         
E486 2606             (    forth6809.asm):03640                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03641         
E488 CC0000           (    forth6809.asm):03642                     LDD   #FALSEV           ; No! Return false result.
E48B 3606             (    forth6809.asm):03643                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03644         
E48D 39               (    forth6809.asm):03645                     RTS
                      (    forth6809.asm):03646         
E48E                  (    forth6809.asm):03647         KQTRUE:
E48E CCFFFF           (    forth6809.asm):03648                     LDD   #TRUEV            ; Yes! Return true result.
E491 3606             (    forth6809.asm):03649                     PSHU  D                 ; flag = true
E493 39               (    forth6809.asm):03650                     RTS
                      (    forth6809.asm):03651         
                      (    forth6809.asm):03652         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03653         
                      (    forth6809.asm):03654         ; ------------------------------------------------------------
                      (    forth6809.asm):03655         ; EMIT  ( char -- )
                      (    forth6809.asm):03656         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03657         ; discarded if the ring is full.
                      (    forth6809.asm):03658         ; ------------------------------------------------------------
E494                  (    forth6809.asm):03659         EMITW:
E494 3706             (    forth6809.asm):03660                     PULU  D                 ; char
E496 1F98             (    forth6809.asm):03661                     TFR   B,A
E498 BDDCA0           (    forth6809.asm):03662                     JSR   PUTCHAR           ; Transmit char.
E49B 39               (    forth6809.asm):03663                     RTS
                      (    forth6809.asm):03664         
                      (    forth6809.asm):03665                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03666         ; ------------------------------------------------------------
                      (    forth6809.asm):03667         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03668         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03669         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03670         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03671         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03672         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03673         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03674         ; follow.
                      (    forth6809.asm):03675         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03676         KEYW:
                      (    forth6809.asm):03677                     LDA   ACIASR
                      (    forth6809.asm):03678                     BITA  #SR_RDRF
                      (    forth6809.asm):03679                     BEQ   KWAIT
                      (    forth6809.asm):03680                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03681                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E49C                  (    forth6809.asm):03682         KWAIT:
E49C                  (    forth6809.asm):03683         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03684                     BITA  #SR_RDRF
                      (    forth6809.asm):03685                     BEQ   KSPIN
E49C                  (    forth6809.asm):03686         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03687                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03688                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03689                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03690                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03691                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03692                     BEQ   KGETCH
                      (    forth6809.asm):03693                     BITA  #SR_FE
                      (    forth6809.asm):03694                     BEQ   KXFE
                      (    forth6809.asm):03695                     INC   FECOUNT
E49C                  (    forth6809.asm):03696         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03697                     BEQ   KXOVRN
                      (    forth6809.asm):03698                     INC   OVRNCOUNT
E49C                  (    forth6809.asm):03699         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03700                     BEQ   KGETCH
                      (    forth6809.asm):03701                     INC   PECOUNT
E49C                  (    forth6809.asm):03702         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03703                     TFR   A,B
                      (    forth6809.asm):03704                     CLRA
                      (    forth6809.asm):03705                     PSHU  D                 ; char
                      (    forth6809.asm):03706                     RTS
                      (    forth6809.asm):03707         
                      (    forth6809.asm):03708         ; ------------------------------------------------------------
                      (    forth6809.asm):03709         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03710         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03711         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03712         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03713         ;    Inputs:
                      (    forth6809.asm):03714         ;        none
                      (    forth6809.asm):03715         ;    Outputs:
                      (    forth6809.asm):03716         ;        XON or XOFF transmitted
                      (    forth6809.asm):03717         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03718         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03719         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03720         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03721                     BRA   PUTXCH
E49C                  (    forth6809.asm):03722         PUTXON:     LDA   #XONCH
E49C                  (    forth6809.asm):03723         PUTXCH:     PSHS  A
E49C                  (    forth6809.asm):03724         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03725                     BITB  #SR_TDRE
                      (    forth6809.asm):03726                     BEQ   PXWT
                      (    forth6809.asm):03727                     PULS  A
                      (    forth6809.asm):03728                     STA   ACIADR
                      (    forth6809.asm):03729                     RTS
                      (    forth6809.asm):03730         
                      (    forth6809.asm):03731         ; ------------------------------------------------------------
                      (    forth6809.asm):03732         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03733         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03734         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03735         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03736                     BITA  #SR_RDRF
                      (    forth6809.asm):03737                     BEQ   KQFALSE
                      (    forth6809.asm):03738                     LDD   #TRUEV
                      (    forth6809.asm):03739                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03740                     RTS
E49C                  (    forth6809.asm):03741         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03742                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03743                     RTS
                      (    forth6809.asm):03744         
                      (    forth6809.asm):03745         ; ------------------------------------------------------------
                      (    forth6809.asm):03746         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03747         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03749         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03750                     STB   EMITCH
E49C                  (    forth6809.asm):03751         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03752                     BITA  #SR_TDRE
                      (    forth6809.asm):03753                     BEQ   EMITWT
                      (    forth6809.asm):03754                     LDA   EMITCH
                      (    forth6809.asm):03755                     STA   ACIADR
                      (    forth6809.asm):03756                     RTS
                      (    forth6809.asm):03757         
                      (    forth6809.asm):03758                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03762         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03763         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03764         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
E49C 335E             (    forth6809.asm):03766         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E49E CC0000           (    forth6809.asm):03767                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E4A1 EDC4             (    forth6809.asm):03768                     STD   ,U
                      (    forth6809.asm):03769         
                      (    forth6809.asm):03770                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03771                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03772                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03773                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03774                                             ; stream this line's characters
                      (    forth6809.asm):03775                     JSR   PUTXON
                      (    forth6809.asm):03776                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03777         
E4A3 BDE46D           (    forth6809.asm):03778         ALOOP:      JSR   KEYW
E4A6 3706             (    forth6809.asm):03779                     PULU  D
E4A8 1F02             (    forth6809.asm):03780                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03781         
E4AA C10D             (    forth6809.asm):03782                     CMPB  #13
E4AC 274F             (    forth6809.asm):03783                     BEQ   ADONE
E4AE C10A             (    forth6809.asm):03784                     CMPB  #10
E4B0 27F1             (    forth6809.asm):03785                     BEQ   ALOOP
E4B2 C108             (    forth6809.asm):03786                     CMPB  #8
E4B4 2724             (    forth6809.asm):03787                     BEQ   ABKSP
E4B6 C17F             (    forth6809.asm):03788                     CMPB  #127
E4B8 2720             (    forth6809.asm):03789                     BEQ   ABKSP
                      (    forth6809.asm):03790         
E4BA ECC4             (    forth6809.asm):03791                     LDD   ,U
E4BC 10A342           (    forth6809.asm):03792                     CMPD  2,U
E4BF 27E2             (    forth6809.asm):03793                     BEQ   ALOOP
                      (    forth6809.asm):03794         
E4C1 AE44             (    forth6809.asm):03795                     LDX   4,U
E4C3 308B             (    forth6809.asm):03796                     LEAX  D,X
E4C5 1F20             (    forth6809.asm):03797                     TFR   Y,D
E4C7 E784             (    forth6809.asm):03798                     STB   ,X
E4C9 ECC4             (    forth6809.asm):03799                     LDD   ,U
E4CB C30001           (    forth6809.asm):03800                     ADDD  #1
E4CE EDC4             (    forth6809.asm):03801                     STD   ,U
                      (    forth6809.asm):03802         
E4D0 1F20             (    forth6809.asm):03803                     TFR   Y,D
E4D2 4F               (    forth6809.asm):03804                     CLRA
E4D3 3606             (    forth6809.asm):03805                     PSHU  D
E4D5 BDE494           (    forth6809.asm):03806                     JSR   EMITW
E4D8 20C9             (    forth6809.asm):03807                     BRA   ALOOP
                      (    forth6809.asm):03808         
E4DA ECC4             (    forth6809.asm):03809         ABKSP:      LDD   ,U
E4DC 27C5             (    forth6809.asm):03810                     BEQ   ALOOP
E4DE 830001           (    forth6809.asm):03811                     SUBD  #1
E4E1 EDC4             (    forth6809.asm):03812                     STD   ,U
E4E3 CC0008           (    forth6809.asm):03813                     LDD   #8
E4E6 3606             (    forth6809.asm):03814                     PSHU  D
E4E8 BDE494           (    forth6809.asm):03815                     JSR   EMITW
E4EB CC0020           (    forth6809.asm):03816                     LDD   #32
E4EE 3606             (    forth6809.asm):03817                     PSHU  D
E4F0 BDE494           (    forth6809.asm):03818                     JSR   EMITW
E4F3 CC0008           (    forth6809.asm):03819                     LDD   #8
E4F6 3606             (    forth6809.asm):03820                     PSHU  D
E4F8 BDE494           (    forth6809.asm):03821                     JSR   EMITW
E4FB 20A6             (    forth6809.asm):03822                     BRA   ALOOP
                      (    forth6809.asm):03823         
E4FD                  (    forth6809.asm):03824         ADONE:
                      (    forth6809.asm):03825                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03826                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03827                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03828                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03829                                             ; with KEY never polled at all
                      (    forth6809.asm):03830                     JSR   PUTXOFF
                      (    forth6809.asm):03831                     ENDC                    ; <<<<<<<<<<
E4FD ECC4             (    forth6809.asm):03832                     LDD   ,U
E4FF ED44             (    forth6809.asm):03833                     STD   4,U               ; +n2
E501 3344             (    forth6809.asm):03834                     LEAU  4,U
E503 39               (    forth6809.asm):03835                     RTS
                      (    forth6809.asm):03836         
                      (    forth6809.asm):03837         ; ------------------------------------------------------------
                      (    forth6809.asm):03838         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03839         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03840         ; ------------------------------------------------------------
E504 BDE49C           (    forth6809.asm):03841         EXPECTW:    JSR   ACCEPTW
E507 3706             (    forth6809.asm):03842                     PULU  D
E509 DD3F             (    forth6809.asm):03843                     STD   SPAN
E50B 39               (    forth6809.asm):03844                     RTS
                      (    forth6809.asm):03845         
                      (    forth6809.asm):03846         ; ------------------------------------------------------------
                      (    forth6809.asm):03847         ; QUERY  ( -- )
                      (    forth6809.asm):03848         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03849         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03850         ; to 0 and >IN to 0.
                      (    forth6809.asm):03851         ; ------------------------------------------------------------
E50C 8E0106           (    forth6809.asm):03852         QUERYW:     LDX   #TIBBUF
E50F 3610             (    forth6809.asm):03853                     PSHU  X
E511 CC0050           (    forth6809.asm):03854                     LDD   #TIBBUFL
E514 3606             (    forth6809.asm):03855                     PSHU  D
E516 BDE49C           (    forth6809.asm):03856                     JSR   ACCEPTW
E519 3706             (    forth6809.asm):03857                     PULU  D
E51B DD12             (    forth6809.asm):03858                     STD   NTIB
E51D DD3B             (    forth6809.asm):03859                     STD   SRCLEN
E51F CC0106           (    forth6809.asm):03860                     LDD   #TIBBUF
E522 DD39             (    forth6809.asm):03861                     STD   SRCADDR
E524 CC0000           (    forth6809.asm):03862                     LDD   #0
E527 DD3D             (    forth6809.asm):03863                     STD   SRCID
E529 DD10             (    forth6809.asm):03864                     STD   TOIN
E52B 39               (    forth6809.asm):03865                     RTS
                      (    forth6809.asm):03866         
                      (    forth6809.asm):03867         ; ============================================================
                      (    forth6809.asm):03868         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03869         ; ============================================================
                      (    forth6809.asm):03870         ; ------------------------------------------------------------
                      (    forth6809.asm):03871         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03872         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03873         ; one expected.
                      (    forth6809.asm):03874         ; CFERR
                      (    forth6809.asm):03875         ;    Inputs:
                      (    forth6809.asm):03876         ;        none
                      (    forth6809.asm):03877         ;    Outputs:
                      (    forth6809.asm):03878         ;        does not return (THROW -22)
                      (    forth6809.asm):03879         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03880         ; ------------------------------------------------------------
E52C CCFFEA           (    forth6809.asm):03881         CFERR:      LDD   #-22
E52F 3606             (    forth6809.asm):03882                     PSHU  D                 ; -22
E531 BDE561           (    forth6809.asm):03883                     JSR   THROWW

                      (    forth6809.asm):11161         
                      (    forth6809.asm):11162                         LDD  #TSTCBUF
                      (    forth6809.asm):11163                         PSHU D
                      (    forth6809.asm):11164         
                      (    forth6809.asm):11165                         JSR  DFETCH
                      (    forth6809.asm):11166         
                      (    forth6809.asm):11167                         STU  TSTUAF
                      (    forth6809.asm):11168         
                      (    forth6809.asm):11169                         PULU D
                      (    forth6809.asm):11170                         CMPD #TSTVAL2
                      (    forth6809.asm):11171                         BNE  DFFAIL
                      (    forth6809.asm):11172                         PULU D
                      (    forth6809.asm):11173                         CMPD #TSTVAL1
                      (    forth6809.asm):11174                         BNE  DFFAIL
                      (    forth6809.asm):11175                         PULU D
                      (    forth6809.asm):11176                         CMPD #TSTGUARD
                      (    forth6809.asm):11177                         BNE  DFFAIL
                      (    forth6809.asm):11178         
                      (    forth6809.asm):11179                         LDD  TSTUB4
                      (    forth6809.asm):11180                         SUBD TSTUAF
                      (    forth6809.asm):11181                         CMPD #-2
                      (    forth6809.asm):11182                         BNE  DFFAIL
                      (    forth6809.asm):11183         
                      (    forth6809.asm):11184                         LDD  TSTCBUF
                      (    forth6809.asm):11185                         CMPD #TSTVAL1
                      (    forth6809.asm):11186                         BNE  DFFAIL
                      (    forth6809.asm):11187                         LDD  TSTCBUF+2
                      (    forth6809.asm):11188                         CMPD #TSTVAL2
                      (    forth6809.asm):11189                         BNE  DFFAIL
                      (    forth6809.asm):11190         
                      (    forth6809.asm):11191                         LDD  #TRUEV
                      (    forth6809.asm):11192                         BRA  DFDONE

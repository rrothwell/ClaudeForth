                      (    forth6809.asm):11876         ; delegates to CMOVE> (high-to-low) whenever dst > src,
                      (    forth6809.asm):11877         ; specifically to avoid the corruption a naive low-to-high copy
                      (    forth6809.asm):11878         ; would cause here (byte 2 would get overwritten by the copy
                      (    forth6809.asm):11879         ; before ever being read as a source byte). Expected result
                      (    forth6809.asm):11880         ; hand-derived and independently simulated in Python before
                      (    forth6809.asm):11881         ; writing this test, not guessed: "ABABCDE" across bytes 0-6.
                      (    forth6809.asm):11882         ; ------------------------------------------------------------

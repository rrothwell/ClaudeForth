                      (    forth6809.asm):00800         
                      (    forth6809.asm):00801         ; ============================================================
                      (    forth6809.asm):00802         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00803         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):00804         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):00805         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):00806         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):00807         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):00808         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):00809         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):00810         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):00811         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):00812         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):00813         ; they no longer need indirection.
                      (    forth6809.asm):00814         ;
                      (    forth6809.asm):00815         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):00816         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):00817         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):00818         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):00819         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):00820         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):00821         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):00822         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):00823         ;
                      (    forth6809.asm):00824         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):00825         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):00826         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):00827         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):00828         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):00829         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):00830         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):00831         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):00832         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):00833         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):00834         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):00835         ;
                      (    forth6809.asm):00836         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):00837         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):00838         ;
                      (    forth6809.asm):00839         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):00840         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):00841         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):00842         ; ============================================================

                      (    forth6809.asm):03942         ; the xt held in CURXT.
                      (    forth6809.asm):03943         ; ------------------------------------------------------------
E80E DC34             (    forth6809.asm):03944         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E810 3606             (    forth6809.asm):03945                     PSHU  D                 ; See bugfix: RECURSEW.1
E812 BDEAB7           (    forth6809.asm):03946                     JSR   CCALL

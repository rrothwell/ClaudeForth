                      (    forth6809.asm):07080         ; ------------------------------------------------------------
                      (    forth6809.asm):07081         ; SNAME  ( xt -- c-addr u | 0 0 )
                      (    forth6809.asm):07082         ; Find the name of the word whose xt is given by searching the
                      (    forth6809.asm):07083         ; dictionary from LATEST. Return the name or two zeros if not found.

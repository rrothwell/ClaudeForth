                      (    forth6809.asm):02661         ; ------------------------------------------------------------
                      (    forth6809.asm):02662         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02663         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02664         ; LIT   ( -- x )
                      (    forth6809.asm):02665         ;    Inputs:
                      (    forth6809.asm):02666         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02667         ;    Outputs:
                      (    forth6809.asm):02668         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02669         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02670         ; ------------------------------------------------------------
CF30 3510             (    forth6809.asm):02671         LIT:        PULS  X
CF32 EC81             (    forth6809.asm):02672                     LDD   ,X++
CF34 3606             (    forth6809.asm):02673                     PSHU  D                 ; x
CF36 3410             (    forth6809.asm):02674                     PSHS  X
CF38 39               (    forth6809.asm):02675                     RTS
                      (    forth6809.asm):02676         
                      (    forth6809.asm):02677         ; ------------------------------------------------------------
                      (    forth6809.asm):02678         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02679         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02680         ; address.
                      (    forth6809.asm):02681         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02682         ;    Inputs:
                      (    forth6809.asm):02683         ;        flag on the data stack
                      (    forth6809.asm):02684         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02685         ;    Outputs:
                      (    forth6809.asm):02686         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02687         ;        the offset
                      (    forth6809.asm):02688         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02689         ; ------------------------------------------------------------
CF39 3706             (    forth6809.asm):02690         ZBRANCH:    PULU  D                 ; flag
CF3B 3510             (    forth6809.asm):02691                     PULS  X
CF3D 10830000         (    forth6809.asm):02692                     CMPD  #0
CF41 2607             (    forth6809.asm):02693                     BNE   ZSKIP
CF43 EC84             (    forth6809.asm):02694                     LDD   ,X
CF45 308B             (    forth6809.asm):02695                     LEAX  D,X
CF47 3410             (    forth6809.asm):02696                     PSHS  X
CF49 39               (    forth6809.asm):02697                     RTS
CF4A 3002             (    forth6809.asm):02698         ZSKIP:      LEAX  2,X
CF4C 3410             (    forth6809.asm):02699                     PSHS  X
CF4E 39               (    forth6809.asm):02700                     RTS
                      (    forth6809.asm):02701         
                      (    forth6809.asm):02702         ; ------------------------------------------------------------
                      (    forth6809.asm):02703         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02704         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02705         ; BRANCH
                      (    forth6809.asm):02706         ;    Inputs:
                      (    forth6809.asm):02707         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02708         ;    Outputs:
                      (    forth6809.asm):02709         ;        return address set to the branch target
                      (    forth6809.asm):02710         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02711         ; ------------------------------------------------------------
CF4F 3510             (    forth6809.asm):02712         BRANCH:     PULS  X
CF51 EC84             (    forth6809.asm):02713                     LDD   ,X
CF53 308B             (    forth6809.asm):02714                     LEAX  D,X
CF55 3410             (    forth6809.asm):02715                     PSHS  X
CF57 39               (    forth6809.asm):02716                     RTS
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02720         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02721         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02722         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02723         ;    Inputs:
                      (    forth6809.asm):02724         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02725         ;        trampoline
                      (    forth6809.asm):02726         ;    Outputs:
                      (    forth6809.asm):02727         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02728         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02729         ; ------------------------------------------------------------
CF58 3510             (    forth6809.asm):02730         DODOES:     PULS  X
CF5A 10AE81           (    forth6809.asm):02731                     LDY   ,X++
CF5D EC84             (    forth6809.asm):02732                     LDD   ,X
CF5F 3606             (    forth6809.asm):02733                     PSHU  D                 ; pfa
CF61 6EA4             (    forth6809.asm):02734                     JMP   ,Y
                      (    forth6809.asm):02735         
                      (    forth6809.asm):02736         ; ------------------------------------------------------------
                      (    forth6809.asm):02737         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02738         ; field address on the stack.
                      (    forth6809.asm):02739         ; DOESRT0
                      (    forth6809.asm):02740         ;    Inputs:
                      (    forth6809.asm):02741         ;        none
                      (    forth6809.asm):02742         ;    Outputs:
                      (    forth6809.asm):02743         ;        none
                      (    forth6809.asm):02744         ;    Registers: none.
                      (    forth6809.asm):02745         ; ------------------------------------------------------------
CF63 39               (    forth6809.asm):02746         DOESRT0:    RTS
                      (    forth6809.asm):02747         
                      (    forth6809.asm):02748         ; ------------------------------------------------------------
                      (    forth6809.asm):02749         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02750         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02751         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02752         ; SETDOES
                      (    forth6809.asm):02753         ;    Inputs:
                      (    forth6809.asm):02754         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02755         ;        BEHAVIOR)
                      (    forth6809.asm):02756         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02757         ;        address
                      (    forth6809.asm):02758         ;    Outputs:
                      (    forth6809.asm):02759         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02760         ;        defining word's caller
                      (    forth6809.asm):02761         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02762         ; ------------------------------------------------------------
CF64 3510             (    forth6809.asm):02763         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
CF66 1F12             (    forth6809.asm):02764                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02765         
CF68 9E04             (    forth6809.asm):02766                     LDX   LATEST
CF6A E684             (    forth6809.asm):02767                     LDB   ,X
CF6C C41F             (    forth6809.asm):02768                     ANDB  #$1F
CF6E 4F               (    forth6809.asm):02769                     CLRA
CF6F 308B             (    forth6809.asm):02770                     LEAX  D,X               ; header + name length
CF71 EC03             (    forth6809.asm):02771                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
CF73 C30003           (    forth6809.asm):02772                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
CF76 1F01             (    forth6809.asm):02773                     TFR   D,X
                      (    forth6809.asm):02774         
CF78 10AF84           (    forth6809.asm):02775                     STY   ,X                ; patch it
                      (    forth6809.asm):02776         
CF7B 3510             (    forth6809.asm):02777                     PULS  X                 ; X = the OUTER defining word's own return addr
CF7D 6E84             (    forth6809.asm):02778                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02779         
                      (    forth6809.asm):02780         ; ------------------------------------------------------------
                      (    forth6809.asm):02781         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02782         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02783         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02784         ;    Inputs:
                      (    forth6809.asm):02785         ;        pfa on the data stack
                      (    forth6809.asm):02786         ;    Outputs:
                      (    forth6809.asm):02787         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02788         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02789         ; ------------------------------------------------------------
CF7F 3710             (    forth6809.asm):02790         DODEFER:    PULU  X                 ; pfa
CF81 EC84             (    forth6809.asm):02791                     LDD   ,X
CF83 1F01             (    forth6809.asm):02792                     TFR   D,X
CF85 6E84             (    forth6809.asm):02793                     JMP   ,X
                      (    forth6809.asm):02794         
                      (    forth6809.asm):02795         ; ------------------------------------------------------------
                      (    forth6809.asm):02796         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02797         ; DOABORTUNDEF
                      (    forth6809.asm):02798         ;    Inputs:
                      (    forth6809.asm):02799         ;        none
                      (    forth6809.asm):02800         ;    Outputs:
                      (    forth6809.asm):02801         ;        none (does not return)
                      (    forth6809.asm):02802         ;    Registers: RegD changed.
                      (    forth6809.asm):02803         ; ------------------------------------------------------------
CF87                  (    forth6809.asm):02804         DOABORTUNDEF:
CF87 CCFFEB           (    forth6809.asm):02805                     LDD   #-21
CF8A 3606             (    forth6809.asm):02806                     PSHU  D                 ; throw code (-21)
CF8C 7ED905           (    forth6809.asm):02807                     JMP   THROWW
                      (    forth6809.asm):02808         
                      (    forth6809.asm):02809         ; ------------------------------------------------------------
                      (    forth6809.asm):02810         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02811         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02812         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02813         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02814         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02815         ;    Inputs:
                      (    forth6809.asm):02816         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02817         ;    Outputs:
                      (    forth6809.asm):02818         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02819         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02820         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02821         ; ------------------------------------------------------------
CF8F 3710             (    forth6809.asm):02822         DOMARKER:   PULU  X                 ; pfa
CF91 EC84             (    forth6809.asm):02823                     LDD   ,X
CF93 DD06             (    forth6809.asm):02824                     STD   DPHERE
CF95 EC02             (    forth6809.asm):02825                     LDD   2,X
CF97 DD08             (    forth6809.asm):02826                     STD   CODEHERE
CF99 EC04             (    forth6809.asm):02827                     LDD   4,X
CF9B DD0A             (    forth6809.asm):02828                     STD   VARHERE
CF9D EC06             (    forth6809.asm):02829                     LDD   6,X
CF9F DD04             (    forth6809.asm):02830                     STD   LATEST
CFA1 3008             (    forth6809.asm):02831                     LEAX  8,X               ; the saved search-order state follows
CFA3 108E0045         (    forth6809.asm):02832                     LDY   #SRCHSAVE
CFA7 C616             (    forth6809.asm):02833                     LDB   #SRCHSAVESZ
CFA9 A680             (    forth6809.asm):02834         DMCOPY:     LDA   ,X+
CFAB A7A0             (    forth6809.asm):02835                     STA   ,Y+
CFAD 5A               (    forth6809.asm):02836                     DECB
CFAE 26F9             (    forth6809.asm):02837                     BNE   DMCOPY
CFB0 DC06             (    forth6809.asm):02838                     LDD   DPHERE
CFB2 7ED4F6           (    forth6809.asm):02839                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02840         
                      (    forth6809.asm):02841         ; ------------------------------------------------------------
                      (    forth6809.asm):02842         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02843         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02844         ; ------------------------------------------------------------
CFB5 3710             (    forth6809.asm):02845         EXECUTEW:   PULU  X                 ; xt
CFB7 AD84             (    forth6809.asm):02846                     JSR   ,X
CFB9 39               (    forth6809.asm):02847                     RTS
                      (    forth6809.asm):02848         
                      (    forth6809.asm):02849         ; ============================================================
                      (    forth6809.asm):02850         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02851         ; ============================================================
                      (    forth6809.asm):02852         ; ------------------------------------------------------------
                      (    forth6809.asm):02853         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02854         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02855         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02856         ;    Inputs:
                      (    forth6809.asm):02857         ;        RegX = address of the here pointer
                      (    forth6809.asm):02858         ;        x on the data stack
                      (    forth6809.asm):02859         ;    Outputs:
                      (    forth6809.asm):02860         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02861         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02862         ; ------------------------------------------------------------
CFBA 3706             (    forth6809.asm):02863         APPENDCELL: PULU  D                 ; x
CFBC 10AE84           (    forth6809.asm):02864                     LDY   ,X
CFBF EDA1             (    forth6809.asm):02865                     STD   ,Y++
CFC1 10AF84           (    forth6809.asm):02866                     STY   ,X
CFC4 39               (    forth6809.asm):02867                     RTS
                      (    forth6809.asm):02868         
                      (    forth6809.asm):02869         ; ------------------------------------------------------------
                      (    forth6809.asm):02870         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02871         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02872         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02873         ;    Inputs:
                      (    forth6809.asm):02874         ;        RegX = address of the here pointer
                      (    forth6809.asm):02875         ;        char on the data stack
                      (    forth6809.asm):02876         ;    Outputs:
                      (    forth6809.asm):02877         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02878         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02879         ; ------------------------------------------------------------
CFC5 3706             (    forth6809.asm):02880         APPENDBYTE: PULU  D                 ; char
CFC7 10AE84           (    forth6809.asm):02881                     LDY   ,X
CFCA E7A0             (    forth6809.asm):02882                     STB   ,Y+
CFCC 10AF84           (    forth6809.asm):02883                     STY   ,X
CFCF 39               (    forth6809.asm):02884                     RTS
                      (    forth6809.asm):02885         
                      (    forth6809.asm):02886         ; ------------------------------------------------------------
                      (    forth6809.asm):02887         ; ,  ( x -- )
                      (    forth6809.asm):02888         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02889         ; ------------------------------------------------------------
CFD0 8E0008           (    forth6809.asm):02890         COMMAW:     LDX   #CODEHERE
CFD3 7ECFBA           (    forth6809.asm):02891                     JMP   APPENDCELL
                      (    forth6809.asm):02892         
                      (    forth6809.asm):02893         ; ------------------------------------------------------------
                      (    forth6809.asm):02894         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02895         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02896         ; ------------------------------------------------------------
CFD6 8E0008           (    forth6809.asm):02897         CODECOMMA:  LDX   #CODEHERE
CFD9 7ECFBA           (    forth6809.asm):02898                     JMP   APPENDCELL
                      (    forth6809.asm):02899         
                      (    forth6809.asm):02900         ; ------------------------------------------------------------
                      (    forth6809.asm):02901         ; C,  ( char -- )
                      (    forth6809.asm):02902         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02903         ; ------------------------------------------------------------
CFDC 8E0008           (    forth6809.asm):02904         CCOMMAW:    LDX   #CODEHERE
CFDF 7ECFC5           (    forth6809.asm):02905                     JMP   APPENDBYTE
                      (    forth6809.asm):02906         
                      (    forth6809.asm):02907         ; ------------------------------------------------------------
                      (    forth6809.asm):02908         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02909         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02910         ; ------------------------------------------------------------
CFE2 8E0008           (    forth6809.asm):02911         CCOMMA1:    LDX   #CODEHERE
CFE5 7ECFC5           (    forth6809.asm):02912                     JMP   APPENDBYTE
                      (    forth6809.asm):02913         
                      (    forth6809.asm):02914         ; ------------------------------------------------------------
                      (    forth6809.asm):02915         ; V,  ( x -- )
                      (    forth6809.asm):02916         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02917         ; ------------------------------------------------------------
CFE8 8E000A           (    forth6809.asm):02918         VCOMMAW:    LDX   #VARHERE
CFEB 7ECFBA           (    forth6809.asm):02919                     JMP   APPENDCELL
                      (    forth6809.asm):02920         
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
                      (    forth6809.asm):02922         ; VC,  ( char -- )
                      (    forth6809.asm):02923         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02924         ; ------------------------------------------------------------
CFEE 8E000A           (    forth6809.asm):02925         VCCOMMAW:   LDX   #VARHERE
CFF1 7ECFC5           (    forth6809.asm):02926                     JMP   APPENDBYTE
                      (    forth6809.asm):02927         
                      (    forth6809.asm):02928         ; ------------------------------------------------------------
                      (    forth6809.asm):02929         ; ALLOT  ( n -- )
                      (    forth6809.asm):02930         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02931         ; ------------------------------------------------------------
CFF4 3706             (    forth6809.asm):02932         ALLOTW:     PULU  D                 ; n
CFF6 9E08             (    forth6809.asm):02933                     LDX   CODEHERE
CFF8 308B             (    forth6809.asm):02934                     LEAX  D,X
CFFA 9F08             (    forth6809.asm):02935                     STX   CODEHERE
CFFC 39               (    forth6809.asm):02936                     RTS
                      (    forth6809.asm):02937         
                      (    forth6809.asm):02938         ; ------------------------------------------------------------
                      (    forth6809.asm):02939         ; VALLOT  ( n -- )
                      (    forth6809.asm):02940         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02941         ; ------------------------------------------------------------
CFFD 3706             (    forth6809.asm):02942         VALLOTW:    PULU  D                 ; n
CFFF 9E0A             (    forth6809.asm):02943                     LDX   VARHERE
D001 308B             (    forth6809.asm):02944                     LEAX  D,X
D003 9F0A             (    forth6809.asm):02945                     STX   VARHERE
D005 39               (    forth6809.asm):02946                     RTS
                      (    forth6809.asm):02947         
                      (    forth6809.asm):02948         ; ------------------------------------------------------------
                      (    forth6809.asm):02949         ; HERE  ( -- addr )
                      (    forth6809.asm):02950         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02951         ; ------------------------------------------------------------
D006 DC08             (    forth6809.asm):02952         HEREW:      LDD   CODEHERE
D008 3606             (    forth6809.asm):02953                     PSHU  D                 ; addr
D00A 39               (    forth6809.asm):02954                     RTS
                      (    forth6809.asm):02955         
                      (    forth6809.asm):02956         ; ------------------------------------------------------------
                      (    forth6809.asm):02957         ; VHERE  ( -- addr )
                      (    forth6809.asm):02958         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02959         ; ------------------------------------------------------------
D00B DC0A             (    forth6809.asm):02960         VHEREW:     LDD   VARHERE
D00D 3606             (    forth6809.asm):02961                     PSHU  D                 ; addr
D00F 39               (    forth6809.asm):02962                     RTS
                      (    forth6809.asm):02963         
                      (    forth6809.asm):02964         ; ------------------------------------------------------------
                      (    forth6809.asm):02965         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02966         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02967         ; ------------------------------------------------------------
D010 DC08             (    forth6809.asm):02968         PADW:       LDD   CODEHERE
D012 C30080           (    forth6809.asm):02969                     ADDD  #PADOFFSET
D015 3606             (    forth6809.asm):02970                     PSHU  D                 ; c-addr
D017 39               (    forth6809.asm):02971                     RTS
                      (    forth6809.asm):02972         
                      (    forth6809.asm):02973         ; ------------------------------------------------------------
                      (    forth6809.asm):02974         ; UNUSED  ( -- u )
                      (    forth6809.asm):02975         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02976         ; ------------------------------------------------------------
D018 CCB900           (    forth6809.asm):02977         UNUSEDW:    LDD   #CODETOP
D01B 9308             (    forth6809.asm):02978                     SUBD  CODEHERE
D01D 3606             (    forth6809.asm):02979                     PSHU  D                 ; u
D01F 39               (    forth6809.asm):02980                     RTS
                      (    forth6809.asm):02981         
                      (    forth6809.asm):02982         ; ------------------------------------------------------------
                      (    forth6809.asm):02983         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02984         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02985         ; ------------------------------------------------------------
D020 CC1FFF           (    forth6809.asm):02986         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D023 930A             (    forth6809.asm):02987                     SUBD  VARHERE
D025 3606             (    forth6809.asm):02988                     PSHU  D                 ; u
D027 39               (    forth6809.asm):02989                     RTS
                      (    forth6809.asm):02990         
                      (    forth6809.asm):02991         ; ============================================================
                      (    forth6809.asm):02992         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02993         ; ============================================================
                      (    forth6809.asm):02994         ; ------------------------------------------------------------
                      (    forth6809.asm):02995         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02996         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02997         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02998         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02999         ; wordlist are updated.
                      (    forth6809.asm):03000         ; HEADER   ( smudge-flag "name" -- )   Throws -16 for an empty name and
                      (    forth6809.asm):03001         ;    -19 for a name of more than 31 characters (the length byte holds the
                      (    forth6809.asm):03002         ;    length in bits 0-4 and the flags in bits 5-7).
                      (    forth6809.asm):03003         ;    Inputs:
                      (    forth6809.asm):03004         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):03005         ;        name parsed from the input stream
                      (    forth6809.asm):03006         ;    Outputs:
                      (    forth6809.asm):03007         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):03008         ;        LATEST = address of the new header
                      (    forth6809.asm):03009         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03010         ; ------------------------------------------------------------
D028 CC0020           (    forth6809.asm):03011         HEADER:     LDD   #32
D02B 3606             (    forth6809.asm):03012                     PSHU  D
D02D BDD37F           (    forth6809.asm):03013                     JSR   WORDW
D030 3710             (    forth6809.asm):03014                     PULU  X                 ; c-addr of the name
D032 3706             (    forth6809.asm):03015                     PULU  D                 ; smudge flag in B
D034 A680             (    forth6809.asm):03016                     LDA   ,X+               ; name length, X = name text
D036 2731             (    forth6809.asm):03017                     BEQ   HDZERO            ; no name: throw -16
D038 811F             (    forth6809.asm):03018                     CMPA  #31
D03A 2232             (    forth6809.asm):03019                     BHI   HDLONG            ; over 31 characters: throw -19
D03C 3402             (    forth6809.asm):03020                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D03E 5D               (    forth6809.asm):03021                     TSTB
D03F 2702             (    forth6809.asm):03022                     BEQ   HDNOSM
D041 8A40             (    forth6809.asm):03023                     ORA   #$40
D043 109E06           (    forth6809.asm):03024         HDNOSM:     LDY   DPHERE
D046 3420             (    forth6809.asm):03025                     PSHS  Y                 ; 0,S = address of the new header
D048 A7A0             (    forth6809.asm):03026                     STA   ,Y+
D04A E662             (    forth6809.asm):03027                     LDB   2,S               ; length is 1 to 31 here
D04C A680             (    forth6809.asm):03028         HDCPY:      LDA   ,X+
D04E A7A0             (    forth6809.asm):03029                     STA   ,Y+
D050 5A               (    forth6809.asm):03030                     DECB
D051 26F9             (    forth6809.asm):03031                     BNE   HDCPY
D053 9E47             (    forth6809.asm):03032                     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D055 EC84             (    forth6809.asm):03033                     LDD   ,X
D057 EDA1             (    forth6809.asm):03034                     STD   ,Y++              ; LINK = old head of that wordlist
D059 DC08             (    forth6809.asm):03035                     LDD   CODEHERE
D05B EDA1             (    forth6809.asm):03036                     STD   ,Y++
D05D 109F06           (    forth6809.asm):03037                     STY   DPHERE
D060 3506             (    forth6809.asm):03038                     PULS  D
D062 DD04             (    forth6809.asm):03039                     STD   LATEST            ; LATEST = newest header of any wordlist
D064 ED84             (    forth6809.asm):03040                     STD   ,X                ; and the new head of the CURRENT wordlist
D066 3261             (    forth6809.asm):03041                     LEAS  1,S
D068 39               (    forth6809.asm):03042                     RTS
D069 CCFFF0           (    forth6809.asm):03043         HDZERO:     LDD   #-16              ; attempt to use zero-length string as a name
D06C 2003             (    forth6809.asm):03044                     BRA   HDTHROW
D06E CCFFED           (    forth6809.asm):03045         HDLONG:     LDD   #-19              ; definition name too long (flags need bits 5-7)
D071 3606             (    forth6809.asm):03046         HDTHROW:    PSHU  D
D073 7ED905           (    forth6809.asm):03047                     JMP   THROWW
                      (    forth6809.asm):03048         
                      (    forth6809.asm):03049         ; ------------------------------------------------------------
                      (    forth6809.asm):03050         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03051         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03052         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03053         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03054         ; SMUDGE   ( -- )
                      (    forth6809.asm):03055         ;    Inputs:
                      (    forth6809.asm):03056         ;        none
                      (    forth6809.asm):03057         ;    Outputs:
                      (    forth6809.asm):03058         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03059         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03060         ; ------------------------------------------------------------
D076 9E04             (    forth6809.asm):03061         SMUDGEW:    LDX   LATEST
D078 A684             (    forth6809.asm):03062                     LDA   ,X
D07A 8840             (    forth6809.asm):03063                     EORA  #$40
D07C A784             (    forth6809.asm):03064                     STA   ,X
D07E 39               (    forth6809.asm):03065                     RTS
                      (    forth6809.asm):03066         
                      (    forth6809.asm):03067         ; ============================================================
                      (    forth6809.asm):03068         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03069         ; ============================================================
                      (    forth6809.asm):03070         ; ------------------------------------------------------------
                      (    forth6809.asm):03071         ; :  ( "name" -- )
                      (    forth6809.asm):03072         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03073         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03074         ; CSP and enter compile state.
                      (    forth6809.asm):03075         ; ------------------------------------------------------------
D07F CCFFFF           (    forth6809.asm):03076         COLONW:     LDD   #TRUEV
D082 3606             (    forth6809.asm):03077                     PSHU  D
D084 BDD028           (    forth6809.asm):03078                     JSR   HEADER
D087 DC08             (    forth6809.asm):03079                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D089 DD1F             (    forth6809.asm):03080                     STD   CURXT             ; See bugfix: COLONW.1
D08B 1F30             (    forth6809.asm):03081                     TFR   U,D
D08D DD21             (    forth6809.asm):03082                     STD   CSP
D08F CCFFFF           (    forth6809.asm):03083                     LDD   #-1
D092 DD00             (    forth6809.asm):03084                     STD   STATE
D094 39               (    forth6809.asm):03085                     RTS
                      (    forth6809.asm):03086         
                      (    forth6809.asm):03087         ; ------------------------------------------------------------
                      (    forth6809.asm):03088         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03089         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03090         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03091         ; new word and return to interpret state.
                      (    forth6809.asm):03092         ; ------------------------------------------------------------
D095 CC0039           (    forth6809.asm):03093         SEMIW:      LDD   #RTSOPC
D098 3606             (    forth6809.asm):03094                     PSHU  D
D09A BDCFE2           (    forth6809.asm):03095                     JSR   CCOMMA1
D09D 1F30             (    forth6809.asm):03096                     TFR   U,D
D09F 109321           (    forth6809.asm):03097                     CMPD  CSP
D0A2 2703             (    forth6809.asm):03098                     BEQ   SEMIOK
D0A4 BDD8D0           (    forth6809.asm):03099                     JSR   CFERR
D0A7 9E04             (    forth6809.asm):03100         SEMIOK:     LDX   LATEST
D0A9 A684             (    forth6809.asm):03101                     LDA   ,X
D0AB 84BF             (    forth6809.asm):03102                     ANDA  #$BF
D0AD A784             (    forth6809.asm):03103                     STA   ,X
D0AF CC0000           (    forth6809.asm):03104                     LDD   #0
D0B2 DD00             (    forth6809.asm):03105                     STD   STATE
D0B4 39               (    forth6809.asm):03106                     RTS
                      (    forth6809.asm):03107         
                      (    forth6809.asm):03108         ; ------------------------------------------------------------
                      (    forth6809.asm):03109         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03110         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03111         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03112         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03113         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03114         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03115         ; ------------------------------------------------------------
D0B5 DC08             (    forth6809.asm):03116         NONAMEW:    LDD   CODEHERE
D0B7 3606             (    forth6809.asm):03117                     PSHU  D                 ; xt
D0B9 DD1F             (    forth6809.asm):03118                     STD   CURXT             ; See bugfix: NONAMEW.1
D0BB 1F30             (    forth6809.asm):03119                     TFR   U,D
D0BD DD21             (    forth6809.asm):03120                     STD   CSP
D0BF CCFFFF           (    forth6809.asm):03121                     LDD   #-1
D0C2 DD00             (    forth6809.asm):03122                     STD   STATE
D0C4 39               (    forth6809.asm):03123                     RTS
                      (    forth6809.asm):03124         
                      (    forth6809.asm):03125         ; ------------------------------------------------------------
                      (    forth6809.asm):03126         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03127         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03128         ; BLDDOES
                      (    forth6809.asm):03129         ;    Inputs:
                      (    forth6809.asm):03130         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03131         ;    Outputs:
                      (    forth6809.asm):03132         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03133         ;    Registers: all changed.
                      (    forth6809.asm):03134         ; BLDSELF
                      (    forth6809.asm):03135         ;    Inputs:
                      (    forth6809.asm):03136         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03137         ;    Outputs:
                      (    forth6809.asm):03138         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03139         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03140         ;    Registers: all changed.
                      (    forth6809.asm):03141         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03142         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03143         ; ------------------------------------------------------------
D0C5 3406             (    forth6809.asm):03144         BLDDOES:    PSHS  D                 ; behaviour address
D0C7 CC0000           (    forth6809.asm):03145                     LDD   #0
D0CA 3606             (    forth6809.asm):03146                     PSHU  D
D0CC BDD028           (    forth6809.asm):03147                     JSR   HEADER
D0CF CCCF58           (    forth6809.asm):03148                     LDD   #DODOES
D0D2 3606             (    forth6809.asm):03149                     PSHU  D
D0D4 BDDD40           (    forth6809.asm):03150                     JSR   CCALL
D0D7 3506             (    forth6809.asm):03151                     PULS  D
D0D9 3606             (    forth6809.asm):03152                     PSHU  D                 ; behaviour address
D0DB BDCFD6           (    forth6809.asm):03153                     JSR   CODECOMMA
D0DE 39               (    forth6809.asm):03154                     RTS
                      (    forth6809.asm):03155         
D0DF BDD0C5           (    forth6809.asm):03156         BLDSELF:    JSR   BLDDOES
D0E2 DC08             (    forth6809.asm):03157                     LDD   CODEHERE          ; PFA = the cell after this one
D0E4 C30002           (    forth6809.asm):03158                     ADDD  #2                ; See bugfix: CONSTANTW.1
D0E7 3606             (    forth6809.asm):03159                     PSHU  D
D0E9 BDCFD6           (    forth6809.asm):03160                     JSR   CODECOMMA
D0EC 39               (    forth6809.asm):03161                     RTS
                      (    forth6809.asm):03162         
                      (    forth6809.asm):03163         ; ------------------------------------------------------------
                      (    forth6809.asm):03164         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03165         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03166         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03167         ; address in the code area, on the stack.
                      (    forth6809.asm):03168         ; ------------------------------------------------------------
D0ED CCCF63           (    forth6809.asm):03169         CREATEW:    LDD   #DOESRT0
D0F0 BDD0DF           (    forth6809.asm):03170                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D0F3 39               (    forth6809.asm):03171                     RTS
                      (    forth6809.asm):03172         
                      (    forth6809.asm):03173         ; ------------------------------------------------------------
                      (    forth6809.asm):03174         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03175         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03176         ; of the word being defined.
                      (    forth6809.asm):03177         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03178         ; ------------------------------------------------------------
D0F4 CCCF64           (    forth6809.asm):03179         DOESGTW:    LDD   #SETDOES
D0F7 3606             (    forth6809.asm):03180                     PSHU  D
D0F9 BDDD40           (    forth6809.asm):03181                     JSR   CCALL
D0FC 39               (    forth6809.asm):03182                     RTS
                      (    forth6809.asm):03183         
                      (    forth6809.asm):03184         ; ------------------------------------------------------------
                      (    forth6809.asm):03185         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03186         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03187         ; area, initialised to zero.
                      (    forth6809.asm):03188         ; ------------------------------------------------------------
D0FD CC0000           (    forth6809.asm):03189         VARIABLEW:  LDD   #0
D100 3606             (    forth6809.asm):03190                     PSHU  D
D102 BDD028           (    forth6809.asm):03191                     JSR   HEADER
D105 CCCF58           (    forth6809.asm):03192                     LDD   #DODOES
D108 3606             (    forth6809.asm):03193                     PSHU  D
D10A BDDD40           (    forth6809.asm):03194                     JSR   CCALL
D10D CCCF63           (    forth6809.asm):03195                     LDD   #DOESRT0
D110 3606             (    forth6809.asm):03196                     PSHU  D
D112 BDCFD6           (    forth6809.asm):03197                     JSR   CODECOMMA
D115 DC0A             (    forth6809.asm):03198                     LDD   VARHERE
D117 3606             (    forth6809.asm):03199                     PSHU  D
D119 BDCFD6           (    forth6809.asm):03200                     JSR   CODECOMMA
D11C CC0000           (    forth6809.asm):03201                     LDD   #0
D11F 9E0A             (    forth6809.asm):03202                     LDX   VARHERE
D121 ED81             (    forth6809.asm):03203                     STD   ,X++
D123 9F0A             (    forth6809.asm):03204                     STX   VARHERE
D125 39               (    forth6809.asm):03205                     RTS
                      (    forth6809.asm):03206         
                      (    forth6809.asm):03207         ; ------------------------------------------------------------
                      (    forth6809.asm):03208         ; @  ( a-addr -- x )
                      (    forth6809.asm):03209         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03210         ; ------------------------------------------------------------
D126 3710             (    forth6809.asm):03211         FETCHW:     PULU  X                 ; a-addr
D128 EC84             (    forth6809.asm):03212                     LDD   ,X
D12A 3606             (    forth6809.asm):03213                     PSHU  D                 ; x
D12C 39               (    forth6809.asm):03214                     RTS
                      (    forth6809.asm):03215         
                      (    forth6809.asm):03216         ; ------------------------------------------------------------
                      (    forth6809.asm):03217         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03218         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03219         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03220         ; ------------------------------------------------------------
D12D CCD126           (    forth6809.asm):03221         CONSTANTW:  LDD   #FETCHW
D130 BDD0DF           (    forth6809.asm):03222                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D133 BDCFD0           (    forth6809.asm):03223                     JSR   COMMAW
D136 39               (    forth6809.asm):03224                     RTS
                      (    forth6809.asm):03225         
                      (    forth6809.asm):03226         ; ------------------------------------------------------------
                      (    forth6809.asm):03227         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03228         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03229         ;    Inputs:
                      (    forth6809.asm):03230         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03231         ;    Outputs:
                      (    forth6809.asm):03232         ;        pfa replaced by the value
                      (    forth6809.asm):03233         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03234         ; ------------------------------------------------------------
D137 3710             (    forth6809.asm):03235         DOVALUE:    PULU  X                 ; pfa
D139 EC84             (    forth6809.asm):03236                     LDD   ,X
D13B 3606             (    forth6809.asm):03237                     PSHU  D                 ; x
D13D 39               (    forth6809.asm):03238                     RTS
                      (    forth6809.asm):03239         
                      (    forth6809.asm):03240         ; ------------------------------------------------------------
                      (    forth6809.asm):03241         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03242         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03243         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03244         ; ------------------------------------------------------------
D13E CCD137           (    forth6809.asm):03245         VALUEW:     LDD   #DOVALUE
D141 BDD0C5           (    forth6809.asm):03246                     JSR   BLDDOES
D144 DC0A             (    forth6809.asm):03247                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D146 3606             (    forth6809.asm):03248                     PSHU  D                 ; See bugfix: VALUEW.1
D148 BDCFD6           (    forth6809.asm):03249                     JSR   CODECOMMA
D14B BDCFE8           (    forth6809.asm):03250                     JSR   VCOMMAW           ; store x in the variable area
D14E 39               (    forth6809.asm):03251                     RTS
                      (    forth6809.asm):03252         
                      (    forth6809.asm):03253         ; ------------------------------------------------------------
                      (    forth6809.asm):03254         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03255         ; lower address as 2@ expects.
                      (    forth6809.asm):03256         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03257         ; ------------------------------------------------------------
D14F 7EE701           (    forth6809.asm):03258         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03259         
                      (    forth6809.asm):03260         ; ------------------------------------------------------------
                      (    forth6809.asm):03261         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03262         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03263         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03264         ; ------------------------------------------------------------
D152 CCD14F           (    forth6809.asm):03265         TWOVALUEW:  LDD   #DO2VALUE
D155 BDD0C5           (    forth6809.asm):03266                     JSR   BLDDOES
D158 DC0A             (    forth6809.asm):03267                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D15A 3606             (    forth6809.asm):03268                     PSHU  D
D15C BDCFD6           (    forth6809.asm):03269                     JSR   CODECOMMA
D15F BDCFE8           (    forth6809.asm):03270                     JSR   VCOMMAW           ; x2 at the lower address
D162 BDCFE8           (    forth6809.asm):03271                     JSR   VCOMMAW           ; then x1
D165 39               (    forth6809.asm):03272                     RTS
                      (    forth6809.asm):03273         
                      (    forth6809.asm):03274         ; ------------------------------------------------------------
                      (    forth6809.asm):03275         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03276         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03277         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03278         ; ------------------------------------------------------------
D166 CC0020           (    forth6809.asm):03279         TOW:        LDD   #32
D169 3606             (    forth6809.asm):03280                     PSHU  D
D16B BDD37F           (    forth6809.asm):03281                     JSR   WORDW
D16E BDD468           (    forth6809.asm):03282                     JSR   FINDW
D171 3706             (    forth6809.asm):03283                     PULU  D
D173 10830000         (    forth6809.asm):03284                     CMPD  #0
D177 260A             (    forth6809.asm):03285                     BNE   TOFOUND
D179 3706             (    forth6809.asm):03286                     PULU  D
D17B CCFFF3           (    forth6809.asm):03287                     LDD   #-13
D17E 3606             (    forth6809.asm):03288                     PSHU  D
D180 BDD905           (    forth6809.asm):03289                     JSR   THROWW
D183 AEC4             (    forth6809.asm):03290         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
D185 EC03             (    forth6809.asm):03291                     LDD   3,X
D187 1083D14F         (    forth6809.asm):03292                     CMPD  #DO2VALUE
D18B 271A             (    forth6809.asm):03293                     BEQ   TOTWO
D18D BDDE01           (    forth6809.asm):03294                     JSR   TOBODYW
D190 DC00             (    forth6809.asm):03295                     LDD   STATE
D192 270C             (    forth6809.asm):03296                     BEQ   TOIMMED
D194 BDDD4D           (    forth6809.asm):03297                     JSR   LITERALW
D197 CCE6E2           (    forth6809.asm):03298                     LDD   #STOREW
D19A 3606             (    forth6809.asm):03299                     PSHU  D
D19C BDDD40           (    forth6809.asm):03300                     JSR   CCALL
D19F 39               (    forth6809.asm):03301                     RTS
D1A0 3710             (    forth6809.asm):03302         TOIMMED:    PULU  X                 ; a-addr of the value cell
D1A2 3706             (    forth6809.asm):03303                     PULU  D                 ; x
D1A4 ED84             (    forth6809.asm):03304                     STD   ,X
D1A6 39               (    forth6809.asm):03305                     RTS
D1A7 BDDE01           (    forth6809.asm):03306         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
D1AA DC00             (    forth6809.asm):03307                     LDD   STATE
D1AC 270C             (    forth6809.asm):03308                     BEQ   TOTWOIMM
D1AE BDDD4D           (    forth6809.asm):03309                     JSR   LITERALW
D1B1 CCE70C           (    forth6809.asm):03310                     LDD   #TWOSTOREW
D1B4 3606             (    forth6809.asm):03311                     PSHU  D
D1B6 BDDD40           (    forth6809.asm):03312                     JSR   CCALL
D1B9 39               (    forth6809.asm):03313                     RTS
D1BA 7EE70C           (    forth6809.asm):03314         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03315         
                      (    forth6809.asm):03316         ; ------------------------------------------------------------
                      (    forth6809.asm):03317         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03318         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03319         ; the variable area, initialised to zero.
                      (    forth6809.asm):03320         ; ------------------------------------------------------------
D1BD                  (    forth6809.asm):03321         TWOVARIABLEW:
D1BD CC0000           (    forth6809.asm):03322                     LDD   #0
D1C0 3606             (    forth6809.asm):03323                     PSHU  D
D1C2 BDD028           (    forth6809.asm):03324                     JSR   HEADER
D1C5 CCCF58           (    forth6809.asm):03325                     LDD   #DODOES

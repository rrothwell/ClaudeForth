                      (    forth6809.asm):09344                    STD  TSTSLSAV
                      (    forth6809.asm):09345                    LDD  TOIN
                      (    forth6809.asm):09346                    STD  TSTTISAV
                      (    forth6809.asm):09347                    LDD  LATEST

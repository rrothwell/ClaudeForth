                      (    forth6809.asm):07486                   JSR  OF
                      (    forth6809.asm):07487                   LDD  #222
                      (    forth6809.asm):07488                   PSHU D
                      (    forth6809.asm):07489                   JSR  LITERALW
                      (    forth6809.asm):07490                   JSR  ENDOF

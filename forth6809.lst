                      (    forth6809.asm):03868         ; DO  ( C: -- dest )
                      (    forth6809.asm):03869         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03870         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03871         ; ------------------------------------------------------------
E7BC CCE7CE           (    forth6809.asm):03872         DOW:        LDD   #DOSETUP
E7BF 3606             (    forth6809.asm):03873                     PSHU  D

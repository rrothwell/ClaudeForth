                      (    forth6809.asm):15293         
                      (    forth6809.asm):15294                       LDD  TSTUB4
                      (    forth6809.asm):15295                       SUBD TSTUAF
                      (    forth6809.asm):15296                       CMPD #-2
                      (    forth6809.asm):15297                       BNE  TVFAIL
                      (    forth6809.asm):15298         
                      (    forth6809.asm):15299                       LDD  #TRUEV
                      (    forth6809.asm):15300                       BRA  TVDONE
C302                  (    forth6809.asm):15301         TVFAIL:       LDD  #FALSEV
C302                  (    forth6809.asm):15302         TVDONE:       LDX  #TSTTZNAME
                      (    forth6809.asm):15303                       PSHU X
                      (    forth6809.asm):15304                       PSHU D
                      (    forth6809.asm):15305                       JSR  TSTREPORT
                      (    forth6809.asm):15306         
                      (    forth6809.asm):15307                       LDU  TSTU0
                      (    forth6809.asm):15308                       RTS

                      (    forth6809.asm):01849         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):01850         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):01851         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):01852         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):01853         ; IRQH
                      (    forth6809.asm):01854         ;    Inputs:
                      (    forth6809.asm):01855         ;        none (hardware interrupt entry)
                      (    forth6809.asm):01856         ;    Outputs:
                      (    forth6809.asm):01857         ;        none (returns with RTI)
                      (    forth6809.asm):01858         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):01859         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):01860         ; ------------------------------------------------------------
DE0F B6C008           (    forth6809.asm):01861         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):01862         
DE12 8580             (    forth6809.asm):01863                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DE14 2708             (    forth6809.asm):01864                     BEQ   IRQDONE0          ; No! Just exit.
DE16 8501             (    forth6809.asm):01865                     BITA  #SR_RDRF          ; Is an incoming character available?
DE18 2605             (    forth6809.asm):01866                     BNE   INCHAR
DE1A 8502             (    forth6809.asm):01867                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DE1C 263C             (    forth6809.asm):01868                     BNE   OUTCHAR
                      (    forth6809.asm):01869                                             ; Ignore all other interrupts such as DCD change.
DE1E 3B               (    forth6809.asm):01870         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):01871                                             ; & restores state.
                      (    forth6809.asm):01872         
DE1F                  (    forth6809.asm):01873         INCHAR:
DE1F F6C009           (    forth6809.asm):01874                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
DE22 8570             (    forth6809.asm):01875                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):01876                                             ; Any receiver error flagged?
DE24 2716             (    forth6809.asm):01877                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):01878         
DE26 8510             (    forth6809.asm):01879                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DE28 2703             (    forth6809.asm):01880                     BEQ   INXFE             ; Tally each flagged error independently -
DE2A 7C017C           (    forth6809.asm):01881                     INC   FECOUNT           ; more than one bit can be set at once.
DE2D 8520             (    forth6809.asm):01882         INXFE:      BITA  #SR_OVRN
DE2F 2703             (    forth6809.asm):01883                     BEQ   INXOVRN
DE31 7C017D           (    forth6809.asm):01884                     INC   OVRNCOUNT
DE34 8540             (    forth6809.asm):01885         INXOVRN:    BITA  #SR_PE
DE36 2703             (    forth6809.asm):01886                     BEQ   INXPE
DE38 7C017E           (    forth6809.asm):01887                     INC   PECOUNT
DE3B 3B               (    forth6809.asm):01888         INXPE:      RTI
                      (    forth6809.asm):01889         
DE3C 1F98             (    forth6809.asm):01890         INOK:       TFR   B,A               ; Transfer good character from the receiver.

                      (    forth6809.asm):20032         ; ============================================================
                      (    forth6809.asm):20033         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):20034         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):20035         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):20036         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):20037         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):20038         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):20039         ; ============================================================
                      (    forth6809.asm):20040         ; ------------------------------------------------------------
                      (    forth6809.asm):20041         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):20042         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):20043         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):20044         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):20045         ; - no indirection, no value cell.
                      (    forth6809.asm):20046         ;
                      (    forth6809.asm):20047         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):20048         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):20049         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):20050         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):20051         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):20052         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):20053         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):20054         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):20055         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):20056         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):20057         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):20058         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):20059                    PSHU  D
FF3C 39               (    forth6809.asm):20060                    RTS
                      (    forth6809.asm):20061         
FF3D CC0000           (    forth6809.asm):20062         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):20063                    PSHU  D
FF42 39               (    forth6809.asm):20064                    RTS
                      (    forth6809.asm):20065         
                      (    forth6809.asm):20066         ; ------------------------------------------------------------
                      (    forth6809.asm):20067         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):20068         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):20069         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):20070         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):20071         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):20072         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):20073                    PSHU  D
FF48 39               (    forth6809.asm):20074                    RTS
                      (    forth6809.asm):20075         
FF49 CCFFFF           (    forth6809.asm):20076         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):20077                    PSHU  D
FF4E 39               (    forth6809.asm):20078                    RTS
                      (    forth6809.asm):20079         
FF4F CC0002           (    forth6809.asm):20080         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):20081                    PSHU  D
FF54 39               (    forth6809.asm):20082                    RTS
                      (    forth6809.asm):20083         
FF55 CCFFFE           (    forth6809.asm):20084         MTWOBODY:  LDD   #-2
FF58 3606             (    forth6809.asm):20085                    PSHU  D
FF5A 39               (    forth6809.asm):20086                    RTS
                      (    forth6809.asm):20087         
                      (    forth6809.asm):20088         ; Verify no collision with init code,
                      (    forth6809.asm):20089         ; value should match ORG INITCODE.
     FF5B             (    forth6809.asm):20090         BASECODEEND  EQU   *
     2071             (    forth6809.asm):20091         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):20092         
                      (    forth6809.asm):20093         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):20094         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):20095         ; .bin file.

                      (    forth6809.asm):09475         
                      (    forth6809.asm):09476         ; ------------------------------------------------------------
                      (    forth6809.asm):09477         ; 1  ( -- 1 )
                      (    forth6809.asm):09478         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):09479         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):09480         ; 27), since "1" and "-1" are not valid assembler labels.

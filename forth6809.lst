F91C 3706             (    forth6809.asm):05805         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F91E DDAB             (    forth6809.asm):05806                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):05807                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):05808                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):05809                                   ; real source length was misread as an
                      (    forth6809.asm):05810                                   ; address, the real source address was never
                      (    forth6809.asm):05811                                   ; popped at all, and the true destination
                      (    forth6809.asm):05812                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):05813                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):05814                                   ; c-addr2 (dest) is on top, popped first.
F920 3706             (    forth6809.asm):05815                    PULU D         ; next: u1 (source length)
F922 DDA9             (    forth6809.asm):05816                    STD  UESRCLEN
F924 3706             (    forth6809.asm):05817                    PULU D         ; next: c-addr1 (source address)
F926 DDA7             (    forth6809.asm):05818                    STD  UEADDR
F928 CC0000           (    forth6809.asm):05819                    LDD  #0

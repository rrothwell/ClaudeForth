E606 3402             (    forth6809.asm):03601                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03602                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03603                                         ; this needs no dedicated scratch global
E608 BDDE4C           (    forth6809.asm):03604                  JSR   RTSCHECKLO
E60B 3502             (    forth6809.asm):03605                  PULS  A
E60D 1F89             (    forth6809.asm):03606                  TFR   A,B
E60F 4F               (    forth6809.asm):03607                  CLRA
E610 3606             (    forth6809.asm):03608                  PSHU  D
E612 39               (    forth6809.asm):03609                  RTS
                      (    forth6809.asm):03610         

                      (    forth6809.asm):02661         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02662         ; Covers every word in that section, with representative
                      (    forth6809.asm):02663         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02664         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02665         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02666         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02667         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02668         ; cases chosen.
                      (    forth6809.asm):02669         ; ------------------------------------------------------------

                      (    forth6809.asm):06708         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):06709         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):06710         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):06711         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):06712         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):06713         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):06714         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):06715         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):06716         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):06717         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):06718         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):06719         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):06720         ; ------------------------------------------------------------
C248                  (    forth6809.asm):06721         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):06722                   STD  TSTLSAV
                      (    forth6809.asm):06723                   LDD  CODEHERE
                      (    forth6809.asm):06724                   STD  TSTCSAV
                      (    forth6809.asm):06725         
                      (    forth6809.asm):06726                   LDA  #3
                      (    forth6809.asm):06727                   STA  TSTFHDR
                      (    forth6809.asm):06728                   LDA  #'F'
                      (    forth6809.asm):06729                   STA  TSTFHDR+1
                      (    forth6809.asm):06730                   LDA  #'O'
                      (    forth6809.asm):06731                   STA  TSTFHDR+2
                      (    forth6809.asm):06732                   LDA  #'O'
                      (    forth6809.asm):06733                   STA  TSTFHDR+3
                      (    forth6809.asm):06734                   LDD  #0
                      (    forth6809.asm):06735                   STD  TSTFHDR+4
                      (    forth6809.asm):06736                   LDD  #DUP
                      (    forth6809.asm):06737                   STD  TSTFHDR+6
                      (    forth6809.asm):06738         

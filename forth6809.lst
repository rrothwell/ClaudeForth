E23F BDE99C           (    forth6809.asm):02994                     JSR   CCALL
E242 20DC             (    forth6809.asm):02995                     BRA   ILOOP
                      (    forth6809.asm):02996         
E244 BDDF05           (    forth6809.asm):02997         DOEXEC:     JSR   EXECUTEW
E247 20D7             (    forth6809.asm):02998                     BRA   ILOOP
                      (    forth6809.asm):02999         
E249 BDE3EA           (    forth6809.asm):03000         TRYNUM:     JSR   NUMBERQ
E24C 3706             (    forth6809.asm):03001                     PULU  D
E24E 10830000         (    forth6809.asm):03002                     CMPD  #0                ; flag (PULU does not set CC)
E252 273B             (    forth6809.asm):03003                     BEQ   BADWORD
                      (    forth6809.asm):03004         
E254 10830001         (    forth6809.asm):03005                     CMPD  #1                ; 1 = double-number result
E258 2711             (    forth6809.asm):03006                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03007         
E25A DC00             (    forth6809.asm):03008                     LDD   STATE
E25C 27C2             (    forth6809.asm):03009                     BEQ   ILOOP
E25E CCDE93           (    forth6809.asm):03010                     LDD   #LIT
E261 3606             (    forth6809.asm):03011                     PSHU  D
E263 BDE99C           (    forth6809.asm):03012                     JSR   CCALL
E266 BDDF26           (    forth6809.asm):03013                     JSR   CODECOMMA
E269 20B5             (    forth6809.asm):03014                     BRA   ILOOP
                      (    forth6809.asm):03015         
E26B                  (    forth6809.asm):03016         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03017                                             ; ANS's (ud1) stack order directly.
E26B DC00             (    forth6809.asm):03018                     LDD   STATE
E26D 27B1             (    forth6809.asm):03019                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03020                                             ; nothing more to do
                      (    forth6809.asm):03021                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03022                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03023                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03024                     ; pop it aside first, freeing UDLO to be compiled first.
E26F 3706             (    forth6809.asm):03025                     PULU  D
E271 DD1A             (    forth6809.asm):03026                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03027                                             ; untouched by CCALL/CODECOMMA
E273 CCDE93           (    forth6809.asm):03028                     LDD   #LIT
E276 3606             (    forth6809.asm):03029                     PSHU  D
E278 BDE99C           (    forth6809.asm):03030                     JSR   CCALL
E27B BDDF26           (    forth6809.asm):03031                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
E27E CCDE93           (    forth6809.asm):03032                     LDD   #LIT
E281 3606             (    forth6809.asm):03033                     PSHU  D
E283 BDE99C           (    forth6809.asm):03034                     JSR   CCALL
E286 DC1A             (    forth6809.asm):03035                     LDD   MSCR4
E288 3606             (    forth6809.asm):03036                     PSHU  D

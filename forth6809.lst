                      (    forth6809.asm):04859         ; ------------------------------------------------------------
                      (    forth6809.asm):04860         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):04861         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):04862         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):04863         ; the transfer.
                      (    forth6809.asm):04864         ; ------------------------------------------------------------

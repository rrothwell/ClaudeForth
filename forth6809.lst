                      (    forth6809.asm):09265         ; TSTMARKER - unit test for MARKER. Compiles "MARKER TESTWD"
                      (    forth6809.asm):09266         ; (CODEHERE/DPHERE/VARHERE redirected to scratch, as with every
                      (    forth6809.asm):09267         ; other test in this section), then simulates "something was
                      (    forth6809.asm):09268         ; defined after the marker" by manually advancing the redirected
                      (    forth6809.asm):09269         ; pointers further and pointing the real LATEST elsewhere,
                      (    forth6809.asm):09270         ; executes the marker word, and verifies everything was restored
                      (    forth6809.asm):09271         ; to TSTCBUF/TSTDBUF/TSTVBUF directly - the state BEFORE the
                      (    forth6809.asm):09272         ; marker word itself was created, not the state right after.
                      (    forth6809.asm):09273         ; MARKER's own documented behavior is "forgets itself too" -
                      (    forth6809.asm):09274         ; traced MARKERW's own code and confirmed its internal snapshot
                      (    forth6809.asm):09275         ; is taken at its very start, before HEADER or any compiling
                      (    forth6809.asm):09276         ; runs at all, so that's genuinely the correct restore target,
                      (    forth6809.asm):09277         ; not assumed.
                      (    forth6809.asm):09278         ;
                      (    forth6809.asm):09279         ; DOMARKER (confirmed by reading it directly) writes to the
                      (    forth6809.asm):09280         ; real DPHERE/CODEHERE/VARHERE/LATEST unconditionally, not to
                      (    forth6809.asm):09281         ; any redirected copy - so this test must execute the marker
                      (    forth6809.asm):09282         ; word while CODEHERE/DPHERE/VARHERE are still redirected (their
                      (    forth6809.asm):09283         ; real values are restored only afterward), unlike every other
                      (    forth6809.asm):09284         ; test in this section, which restores first and executes
                      (    forth6809.asm):09285         ; second. Getting this order backwards would have corrupted the
                      (    forth6809.asm):09286         ; real dictionary pointers with scratch addresses.
                      (    forth6809.asm):09287         ; ------------------------------------------------------------

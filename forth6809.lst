                      (    forth6809.asm):06135         ; ------------------------------------------------------------
                      (    forth6809.asm):06136         ; TSTCTRLFLOW - control-flow tests (glossary section 3.8, 22
                      (    forth6809.asm):06137         ; words - all except UNLOOP, which is a genuine runtime no-op
                      (    forth6809.asm):06138         ; and tested directly like ALIGN's own test, needing none of
                      (    forth6809.asm):06139         ; this section's compile-time harness). Every other test
                      (    forth6809.asm):06140         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):06141         ; real compile-time words directly (JSR IF, JSR THEN, JSR DO,
                      (    forth6809.asm):06142         ; etc - the actual routines the compiler itself calls, not a
                      (    forth6809.asm):06143         ; hand-simulated imitation), restores CODEHERE, then executes
                      (    forth6809.asm):06144         ; the compiled snippet directly. Tests the real interaction
                      (    forth6809.asm):06145         ; between compile-time correctness (right bytes, right patched
                      (    forth6809.asm):06146         ; offsets) and runtime correctness (right control flow) in one
                      (    forth6809.asm):06147         ; coherent check, without needing the outer interpreter, FIND,
                      (    forth6809.asm):06148         ; or a real dictionary entry.
                      (    forth6809.asm):06149         ;
                      (    forth6809.asm):06150         ; Given the planned future application of the ANS test suite for
                      (    forth6809.asm):06151         ; broader standards-compliance coverage, these tests focus on
                      (    forth6809.asm):06152         ; this system's own compile/patch mechanism working correctly -
                      (    forth6809.asm):06153         ; not full end-to-end parsing, which the ANS suite will cover.
                      (    forth6809.asm):06154         ;
                      (    forth6809.asm):06155         ; One case is deliberately NOT tested: DO with limit=index.
                      (    forth6809.asm):06156         ; Traced precisely (simulated the real DOTEST increment-and-
                      (    forth6809.asm):06157         ; compare-equal logic) and confirmed it takes a full 65536-
                      (    forth6809.asm):06158         ; iteration wraparound to naturally reconverge on equality, not
                      (    forth6809.asm):06159         ; one - true to the letter of "runs at least once" but
                      (    forth6809.asm):06160         ; impractical for a boot-time self-check. ?DO's own equivalent
                      (    forth6809.asm):06161         ; case IS tested (TSTQDOLPEQ) - its own skip check happens
                      (    forth6809.asm):06162         ; before the loop is entered at all, confirmed fast and safe by
                      (    forth6809.asm):06163         ; the same kind of trace.
                      (    forth6809.asm):06164         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06165         TSTCTRLFLOW: JSR CRW
                      (    forth6809.asm):06166                    LDX   #TSTCTRLMSG
                      (    forth6809.asm):06167                    PSHU  X
                      (    forth6809.asm):06168                    LDD   #8
                      (    forth6809.asm):06169                    PSHU  D
                      (    forth6809.asm):06170                    JSR   TYPE
                      (    forth6809.asm):06171                    JSR   CRW
                      (    forth6809.asm):06172         
                      (    forth6809.asm):06173                    IFEQ TSTSELECTOR-7  ; >>>>
                      (    forth6809.asm):06174         
                      (    forth6809.asm):06175                    JSR   TSTIFT1
                      (    forth6809.asm):06176                    JSR   TSTIFT2
                      (    forth6809.asm):06177                    JSR   TSTIET1
                      (    forth6809.asm):06178                    JSR   TSTIET2
                      (    forth6809.asm):06179                    JSR   TSTBGU
                      (    forth6809.asm):06180                    JSR   TSTBWR
                      (    forth6809.asm):06181                    JSR   TSTRECUR
                      (    forth6809.asm):06182                    JSR   TSTDOLP
                      (    forth6809.asm):06183                    JSR   TSTQDOLP
                      (    forth6809.asm):06184                    JSR   TSTQDOLPEQ
                      (    forth6809.asm):06185                    JSR   TSTPLOOP
                      (    forth6809.asm):06186                    JSR   TSTJIDX
                      (    forth6809.asm):06187                    JSR   TSTLEAVE
                      (    forth6809.asm):06188                    JSR   TSTEXIT
                      (    forth6809.asm):06189                    JSR   TSTUNLOOP
                      (    forth6809.asm):06190                    JSR   TSTCASE1
                      (    forth6809.asm):06191                    JSR   TSTCASE2
                      (    forth6809.asm):06192                    JSR   TSTTHENZ
                      (    forth6809.asm):06193                    JSR   TSTUNTILZ
                      (    forth6809.asm):06194                    JSR   TSTENDOFZ
                      (    forth6809.asm):06195         
                      (    forth6809.asm):06196                    ENDC ; <<<<
                      (    forth6809.asm):06197         
                      (    forth6809.asm):06198                    RTS
                      (    forth6809.asm):06199         
C100                  (    forth6809.asm):06200         TSTCTRLMSG: FCC "CtrlFlow"
                      (    forth6809.asm):06201         
                      (    forth6809.asm):06202                    IFEQ TSTSELECTOR-7  ; >>>>
                      (    forth6809.asm):06203         
                      (    forth6809.asm):06204         ; ------------------------------------------------------------
                      (    forth6809.asm):06205         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):06206         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):06207         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):06208         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):06209         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):06210         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):06211         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):06212         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):06213         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):06214         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):06215         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):06216         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):06217         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):06218         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):06219         ; ------------------------------------------------------------
                      (    forth6809.asm):06220         
                      (    forth6809.asm):06221         ; ------------------------------------------------------------
                      (    forth6809.asm):06222         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):06223         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):06224         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):06225         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):06226         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):06227         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):06228         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):06229         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06230         TSTIFT1: LDD   CODEHERE
                      (    forth6809.asm):06231                  STD   TSTCSAV
                      (    forth6809.asm):06232                  LDD   #TSTCBUF
                      (    forth6809.asm):06233                  STD   CODEHERE
                      (    forth6809.asm):06234         
                      (    forth6809.asm):06235                  JSR   IF
                      (    forth6809.asm):06236         
                      (    forth6809.asm):06237                  LDD   #111
                      (    forth6809.asm):06238                  PSHU  D
                      (    forth6809.asm):06239                  JSR   LITERALW
                      (    forth6809.asm):06240         
                      (    forth6809.asm):06241                  JSR   THEN
                      (    forth6809.asm):06242         
                      (    forth6809.asm):06243                  LDD   #OPRTS
                      (    forth6809.asm):06244                  PSHU  D
                      (    forth6809.asm):06245                  JSR   CCOMMA
                      (    forth6809.asm):06246         
                      (    forth6809.asm):06247                  LDD   TSTCSAV
                      (    forth6809.asm):06248                  STD   CODEHERE
                      (    forth6809.asm):06249         
                      (    forth6809.asm):06250                  STU   TSTU0
                      (    forth6809.asm):06251         
                      (    forth6809.asm):06252                  LDD   #TSTGUARD
                      (    forth6809.asm):06253                  PSHU  D
                      (    forth6809.asm):06254                  LDD   #TRUEV
                      (    forth6809.asm):06255                  PSHU  D
                      (    forth6809.asm):06256                  STU   TSTUB4
                      (    forth6809.asm):06257         
                      (    forth6809.asm):06258                  JSR   TSTCBUF
                      (    forth6809.asm):06259         
                      (    forth6809.asm):06260                  STU   TSTUAF
                      (    forth6809.asm):06261         
                      (    forth6809.asm):06262                  PULU  D
                      (    forth6809.asm):06263                  CMPD  #111
                      (    forth6809.asm):06264                  BNE   T1FAIL
                      (    forth6809.asm):06265                  PULU  D
                      (    forth6809.asm):06266                  CMPD  #TSTGUARD
                      (    forth6809.asm):06267                  BNE   T1FAIL
                      (    forth6809.asm):06268         
                      (    forth6809.asm):06269                  LDD   TSTUB4
                      (    forth6809.asm):06270                  SUBD  TSTUAF
                      (    forth6809.asm):06271                  CMPD  #0
                      (    forth6809.asm):06272                  BNE   T1FAIL
                      (    forth6809.asm):06273         
                      (    forth6809.asm):06274                  LDD   #TRUEV
                      (    forth6809.asm):06275                  BRA   T1DONE
C100                  (    forth6809.asm):06276         T1FAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):06277         T1DONE:  LDX   #TSTIFT1NAME
                      (    forth6809.asm):06278                  PSHU  X
                      (    forth6809.asm):06279                  PSHU  D
                      (    forth6809.asm):06280                  JSR   TSTREPORT
                      (    forth6809.asm):06281         
                      (    forth6809.asm):06282                  LDU   TSTU0
                      (    forth6809.asm):06283                  RTS
                      (    forth6809.asm):06284         
C100                  (    forth6809.asm):06285         TSTIFT1NAME: FCB  7
                      (    forth6809.asm):06286                      FCC  "TSTIFT1"
                      (    forth6809.asm):06287         
                      (    forth6809.asm):06288         ; ------------------------------------------------------------
                      (    forth6809.asm):06289         ; TSTIFT2 - unit test for IF/THEN, false case. Same compiled
                      (    forth6809.asm):06290         ; snippet as TSTIFT1, run with a false flag instead - the
                      (    forth6809.asm):06291         ; branch IS taken, jumping straight past the LIT+111, so 111
                      (    forth6809.asm):06292         ; should NOT appear; only the guard remains.
                      (    forth6809.asm):06293         ; ------------------------------------------------------------
C100                  (    forth6809.asm):06294         TSTIFT2: LDD   CODEHERE
                      (    forth6809.asm):06295                  STD   TSTCSAV
                      (    forth6809.asm):06296                  LDD   #TSTCBUF
                      (    forth6809.asm):06297                  STD   CODEHERE

                      (    forth6809.asm):07740         ;        ud on the data stack
                      (    forth6809.asm):07741         ;    Outputs:
                      (    forth6809.asm):07742         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):07743         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):07744         ; ------------------------------------------------------------

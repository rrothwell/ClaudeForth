                      (    forth6809.asm):02211                    CMPD  #TSTVAL3
                      (    forth6809.asm):02212                    BNE   PKFAIL
                      (    forth6809.asm):02213                    PULU  D
                      (    forth6809.asm):02214                    CMPD  #TSTVAL2
                      (    forth6809.asm):02215                    BNE   PKFAIL
                      (    forth6809.asm):02216                    PULU  D
                      (    forth6809.asm):02217                    CMPD  #TSTVAL1
                      (    forth6809.asm):02218                    BNE   PKFAIL
                      (    forth6809.asm):02219                    PULU  D
                      (    forth6809.asm):02220                    CMPD  #TSTGUARD
                      (    forth6809.asm):02221                    BNE   PKFAIL

                      (    forth6809.asm):08263                    LDA  #'W'
                      (    forth6809.asm):08264                    STA  TSTNAMEB+4
                      (    forth6809.asm):08265                    LDA  #'D'
                      (    forth6809.asm):08266                    STA  TSTNAMEB+5
                      (    forth6809.asm):08267         

                      (    forth6809.asm):09821         ; per their own ANS data type, which the original single-cell
                      (    forth6809.asm):09822         ; ENVFOUND (pushing exactly one value before TRUE) couldn't
                      (    forth6809.asm):09823         ; represent. Added a second table (ENVTABLE2) and matching loop

                      (    forth6809.asm):08567         ; Add the string c-addr u to the front of the pictured numeric output
                      (    forth6809.asm):08568         ; string.
                      (    forth6809.asm):08569         ; ------------------------------------------------------------
EE6B ECC4             (    forth6809.asm):08570         HOLDSW:     LDD   ,U                ; u at 0, c-addr at 2
EE6D 2713             (    forth6809.asm):08571                     BEQ   HSDONE
EE6F 830001           (    forth6809.asm):08572                     SUBD  #1
EE72 EDC4             (    forth6809.asm):08573                     STD   ,U                ; remaining count
EE74 AE42             (    forth6809.asm):08574                     LDX   2,U
EE76 A68B             (    forth6809.asm):08575                     LDA   D,X               ; the last remaining character
EE78 1F89             (    forth6809.asm):08576                     TFR   A,B
EE7A 4F               (    forth6809.asm):08577                     CLRA
EE7B 3606             (    forth6809.asm):08578                     PSHU  D
EE7D BDEE60           (    forth6809.asm):08579                     JSR   HOLDW             ; consumes the character
EE80 20E9             (    forth6809.asm):08580                     BRA   HOLDSW
EE82 3344             (    forth6809.asm):08581         HSDONE:     LEAU  4,U               ; drop the two parameters
EE84 39               (    forth6809.asm):08582                     RTS
                      (    forth6809.asm):08583         
                      (    forth6809.asm):08584         ; ------------------------------------------------------------
                      (    forth6809.asm):08585         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):08586         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):08587         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):08588         ; ------------------------------------------------------------
EE85 BDEE9A           (    forth6809.asm):08589         NUMW:       JSR   UDDIGIT           ; ud1 is divided in place on the data stack
EE88 810A             (    forth6809.asm):08590                     CMPA  #10
EE8A 2504             (    forth6809.asm):08591                     BLO   NDIGIT
EE8C 8B37             (    forth6809.asm):08592                     ADDA  #'A'-10
EE8E 2002             (    forth6809.asm):08593                     BRA   NHOLD
EE90 8B30             (    forth6809.asm):08594         NDIGIT:     ADDA  #'0'
EE92 1F89             (    forth6809.asm):08595         NHOLD:      TFR   A,B
EE94 4F               (    forth6809.asm):08596                     CLRA
EE95 3606             (    forth6809.asm):08597                     PSHU  D
EE97 7EEE60           (    forth6809.asm):08598                     JMP   HOLDW
                      (    forth6809.asm):08599         
                      (    forth6809.asm):08600         ; ------------------------------------------------------------
                      (    forth6809.asm):08601         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08602         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08603         ; low byte of BASE is used.
                      (    forth6809.asm):08604         ; UDDIGIT
                      (    forth6809.asm):08605         ;    Inputs:
                      (    forth6809.asm):08606         ;        ud on the data stack
                      (    forth6809.asm):08607         ;    Outputs:
                      (    forth6809.asm):08608         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):08609         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):08610         ; ------------------------------------------------------------
EE9A 4F               (    forth6809.asm):08611         UDDIGIT:    CLRA                    ; A = remainder
EE9B C620             (    forth6809.asm):08612                     LDB   #32
EE9D 6843             (    forth6809.asm):08613         UDDLOOP:    ASL   3,U
EE9F 6942             (    forth6809.asm):08614                     ROL   2,U
EEA1 6941             (    forth6809.asm):08615                     ROL   1,U
EEA3 69C4             (    forth6809.asm):08616                     ROL   ,U
EEA5 49               (    forth6809.asm):08617                     ROLA
EEA6 9103             (    forth6809.asm):08618                     CMPA  BASE+1
EEA8 2504             (    forth6809.asm):08619                     BLO   UDNEXT
EEAA 9003             (    forth6809.asm):08620                     SUBA  BASE+1
EEAC 6C43             (    forth6809.asm):08621                     INC   3,U
EEAE 5A               (    forth6809.asm):08622         UDNEXT:     DECB
EEAF 26EC             (    forth6809.asm):08623                     BNE   UDDLOOP
EEB1 39               (    forth6809.asm):08624                     RTS
                      (    forth6809.asm):08625         
                      (    forth6809.asm):08626         ; ------------------------------------------------------------
                      (    forth6809.asm):08627         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):08628         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):08629         ; is produced).
                      (    forth6809.asm):08630         ; ------------------------------------------------------------
EEB2 BDEE85           (    forth6809.asm):08631         NUMSW:      JSR   NUMW
EEB5 ECC4             (    forth6809.asm):08632                     LDD   ,U
EEB7 26F9             (    forth6809.asm):08633                     BNE   NUMSW
EEB9 EC42             (    forth6809.asm):08634                     LDD   2,U
EEBB 26F5             (    forth6809.asm):08635                     BNE   NUMSW
EEBD 39               (    forth6809.asm):08636                     RTS
                      (    forth6809.asm):08637         
                      (    forth6809.asm):08638         ; ------------------------------------------------------------
                      (    forth6809.asm):08639         ; SIGN  ( n -- )
                      (    forth6809.asm):08640         ; If n is negative, add a minus sign to the pictured numeric output
                      (    forth6809.asm):08641         ; string.
                      (    forth6809.asm):08642         ; ------------------------------------------------------------
EEBE 3706             (    forth6809.asm):08643         SIGNW:      PULU  D                 ; n

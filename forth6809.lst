                      (    forth6809.asm):00920         ; TSTOVER - unit test for OVER ( n1 n2 -- n1 n2 n1 ). Verifies
                      (    forth6809.asm):00921         ; the copy of n1 is correct, the originals and guard are
                      (    forth6809.asm):00922         ; undisturbed, and exactly one cell was added.
                      (    forth6809.asm):00923         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):00924         TSTOVER:   STU   TSTU0
                      (    forth6809.asm):00925         
                      (    forth6809.asm):00926                    LDD   #TSTGUARD
                      (    forth6809.asm):00927                    PSHU  D
                      (    forth6809.asm):00928                    LDD   #TSTVAL1
                      (    forth6809.asm):00929                    PSHU  D

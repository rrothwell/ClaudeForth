                      (    forth6809.asm):16613                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):16614                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):16615                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):16616                                   ; read the outer loop's limit instead - a

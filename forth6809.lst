                      (    forth6809.asm):05362         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05363         ; ------------------------------------------------------------
DD50 CC0000           (    forth6809.asm):05364         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1

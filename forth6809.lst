                      (    forth6809.asm):15499                    STD  SRCADDR
                      (    forth6809.asm):15500                    LDD  TSTSLSAV
                      (    forth6809.asm):15501                    STD  SRCLEN
                      (    forth6809.asm):15502                    LDD  TSTTISAV
                      (    forth6809.asm):15503                    STD  TOIN
                      (    forth6809.asm):15504         

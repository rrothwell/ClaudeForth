                      (    forth6809.asm):08096         
                      (    forth6809.asm):08097         ; ------------------------------------------------------------
                      (    forth6809.asm):08098         ; FALSE  ( -- flag )
                      (    forth6809.asm):08099         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08100         ; ------------------------------------------------------------
FED3 CC0000           (    forth6809.asm):08101         FALSEW:     LDD   #$0000
FED6 3606             (    forth6809.asm):08102                     PSHU  D
FED8 39               (    forth6809.asm):08103                     RTS
                      (    forth6809.asm):08104         
                      (    forth6809.asm):08105         ; ------------------------------------------------------------
                      (    forth6809.asm):08106         ; 1  ( -- 1 )
                      (    forth6809.asm):08107         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08108         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08109         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):08110         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):08111         ; ------------------------------------------------------------

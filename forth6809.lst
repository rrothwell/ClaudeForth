                      (   unit_tests.asm):10437         
                      (   unit_tests.asm):10438                         STU  TSTU0
                      (   unit_tests.asm):10439         
                      (   unit_tests.asm):10440                         LDD  #TSTGUARD
                      (   unit_tests.asm):10441                         PSHU D
                      (   unit_tests.asm):10442                         LDD  #$34
                      (   unit_tests.asm):10443                         PSHU D

                      (    forth6809.asm):14100         
                      (    forth6809.asm):14101                     STU  TSTUAF
                      (    forth6809.asm):14102         
                      (    forth6809.asm):14103                     LDD  TSTBASAV
                      (    forth6809.asm):14104                     STD  BASE
                      (    forth6809.asm):14105         
                      (    forth6809.asm):14106                     PULU D
                      (    forth6809.asm):14107                     CMPD #0
                      (    forth6809.asm):14108                     BNE  NZFAIL
                      (    forth6809.asm):14109                     PULU D
                      (    forth6809.asm):14110                     CMPD #2
                      (    forth6809.asm):14111                     BNE  NZFAIL
                      (    forth6809.asm):14112         
                      (    forth6809.asm):14113                     LDX  HLD
                      (    forth6809.asm):14114                     LDA  ,X
                      (    forth6809.asm):14115                     CMPA #'5'
                      (    forth6809.asm):14116                     BNE  NZFAIL
                      (    forth6809.asm):14117         
                      (    forth6809.asm):14118                     PULU D
                      (    forth6809.asm):14119                     CMPD #TSTGUARD
                      (    forth6809.asm):14120                     BNE  NZFAIL
                      (    forth6809.asm):14121         
                      (    forth6809.asm):14122                     LDD  TSTUB4
                      (    forth6809.asm):14123                     SUBD TSTUAF
                      (    forth6809.asm):14124                     CMPD #4  ; BUG FIX: was 0 - mistakenly copied the net-
                      (    forth6809.asm):14125                              ; zero reasoning from TSTNUMSIGNSGT (which calls
                      (    forth6809.asm):14126                              ; #> to consume ud2 before capturing TSTUAF).
                      (    forth6809.asm):14127                              ; This test captures TSTUAF right after NUMSIGN
                      (    forth6809.asm):14128                              ; returns, with ud2 (the quotient) still sitting
                      (    forth6809.asm):14129                              ; on the stack - confirmed via MAME: the user's
                      (    forth6809.asm):14130                              ; own register dump showed D=$0004 at this exact
                      (    forth6809.asm):14131                              ; comparison, precisely matching the 2 extra
                      (    forth6809.asm):14132                              ; cells (quotient low+high) genuinely present at
                      (    forth6809.asm):14133                              ; TSTUAF's own capture point that aren't present
                      (    forth6809.asm):14134                              ; at TSTUB4's (captured before NUMSIGN even ran).
                      (    forth6809.asm):14135                              ; NUMSIGN itself was never broken; only this
                      (    forth6809.asm):14136                              ; test's own expected depth value was wrong.
                      (    forth6809.asm):14137                     BNE  NZFAIL
                      (    forth6809.asm):14138         
                      (    forth6809.asm):14139                     LDD  #TRUEV
                      (    forth6809.asm):14140                     BRA  NZDONE
C2CE                  (    forth6809.asm):14141         NZFAIL:     LDD  #FALSEV

                      (    forth6809.asm):07720         ; an EVALUATEd string, return false.
                      (    forth6809.asm):07721         ; ------------------------------------------------------------
FB83 DCDF             (    forth6809.asm):07722         REFILLW:    LDD   SRCID
FB85 2706             (    forth6809.asm):07723                     BEQ   RFTERM

E35F 0322             (    forth6809.asm):03341                     COM   NUMNEG
E361 3001             (    forth6809.asm):03342                     LEAX  1,X
E363 0A21             (    forth6809.asm):03343                     DEC   CNTREM
E365 2751             (    forth6809.asm):03344                     BEQ   NQBAD
                      (    forth6809.asm):03345         

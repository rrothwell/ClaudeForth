                      (    forth6809.asm):01721         ; own behavior for this case. ?DUP needs two tests, one per
                      (    forth6809.asm):01722         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01723         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01724         ; ------------------------------------------------------------

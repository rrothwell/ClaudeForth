CE2E 39               (    forth6809.asm):02115                     RTS
                      (    forth6809.asm):02116         
                      (    forth6809.asm):02117                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02118         ; ------------------------------------------------------------
                      (    forth6809.asm):02119         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02120         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02121         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02122         ; INFILL
                      (    forth6809.asm):02123         ;    Inputs:
                      (    forth6809.asm):02124         ;        none
                      (    forth6809.asm):02125         ;    Outputs:
                      (    forth6809.asm):02126         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02127         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02128         ; ------------------------------------------------------------
CE2F B60176           (    forth6809.asm):02129         INFILL:     LDA   INHEAD
CE32 B00177           (    forth6809.asm):02130                     SUBA  INTAIL
CE35 843F             (    forth6809.asm):02131                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
CE37 39               (    forth6809.asm):02132                     RTS
                      (    forth6809.asm):02133         ; ------------------------------------------------------------
                      (    forth6809.asm):02134         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02135         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02136         ; receive path with interrupts already masked.
                      (    forth6809.asm):02137         ; RTSCHECKHI
                      (    forth6809.asm):02138         ;    Inputs:
                      (    forth6809.asm):02139         ;        none
                      (    forth6809.asm):02140         ;    Outputs:
                      (    forth6809.asm):02141         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02142         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02143         ; ------------------------------------------------------------
CE38 BDCE2F           (    forth6809.asm):02144         RTSCHECKHI: JSR   INFILL
CE3B 8130             (    forth6809.asm):02145                     CMPA  #INHIWATER
CE3D 250F             (    forth6809.asm):02146                     BLO   RTSCHIDONE
CE3F 7D0178           (    forth6809.asm):02147                     TST   RTSSTATE
CE42 260A             (    forth6809.asm):02148                     BNE   RTSCHIDONE        ; already high - nothing to do
CE44 86D5             (    forth6809.asm):02149                     LDA   #CR_RTSHI
CE46 B7C008           (    forth6809.asm):02150                     STA   ACIACR
CE49 8601             (    forth6809.asm):02151                     LDA   #1
CE4B B70178           (    forth6809.asm):02152                     STA   RTSSTATE
CE4E 39               (    forth6809.asm):02153         RTSCHIDONE: RTS
                      (    forth6809.asm):02154         ; ------------------------------------------------------------
                      (    forth6809.asm):02155         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02156         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02157         ; enables it only while output is pending.
                      (    forth6809.asm):02158         ; UPDATE_RTS
                      (    forth6809.asm):02159         ;    Inputs:
                      (    forth6809.asm):02160         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02161         ;    Outputs:
                      (    forth6809.asm):02162         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02163         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02164         ; ------------------------------------------------------------
CE4F                  (    forth6809.asm):02165         UPDATE_RTS:
CE4F 7D0178           (    forth6809.asm):02166                     TST   RTSSTATE
CE52 260D             (    forth6809.asm):02167                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02168         
CE54 7D017B           (    forth6809.asm):02169                     TST   OUTACTIVITY       ; Is active?
CE57 2704             (    forth6809.asm):02170                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02171         
                      (    forth6809.asm):02172                                             ; $B5/%1011_0101
CE59 86B5             (    forth6809.asm):02173                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
CE5B 2009             (    forth6809.asm):02174                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02175         
CE5D                  (    forth6809.asm):02176         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
CE5D 8695             (    forth6809.asm):02177                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
CE5F 2005             (    forth6809.asm):02178                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02179         
CE61                  (    forth6809.asm):02180         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
CE61 86D5             (    forth6809.asm):02181                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
CE63 7F017B           (    forth6809.asm):02182                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CE66                  (    forth6809.asm):02183         WRITE_CR:
CE66 B7C008           (    forth6809.asm):02184                     STA   ACIACR
CE69 39               (    forth6809.asm):02185                     RTS
                      (    forth6809.asm):02186         ; ------------------------------------------------------------
                      (    forth6809.asm):02187         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02188         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02189         ; Called after a character is added to the ring.
                      (    forth6809.asm):02190         ; CHKHI
                      (    forth6809.asm):02191         ;    Inputs:
                      (    forth6809.asm):02192         ;        RegB = input ring fill level
                      (    forth6809.asm):02193         ;    Outputs:
                      (    forth6809.asm):02194         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02195         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02196         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02197         ; ------------------------------------------------------------
CE6A                  (    forth6809.asm):02198         CHKHI:
CE6A C130             (    forth6809.asm):02199                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
CE6C 250D             (    forth6809.asm):02200                     BLO   CHKHIDONE         ; No! Do nothing.
CE6E 7D0178           (    forth6809.asm):02201                     TST   RTSSTATE
CE71 2608             (    forth6809.asm):02202                     BNE   CHKHIDONE         ; already high - nothing to do
CE73 86FF             (    forth6809.asm):02203                     LDA   #INREJECT         ; Yes! De-assert RTS.
CE75 B70178           (    forth6809.asm):02204                     STA   RTSSTATE
CE78 BDCE4F           (    forth6809.asm):02205                     JSR   UPDATE_RTS
CE7B 39               (    forth6809.asm):02206         CHKHIDONE:  RTS
                      (    forth6809.asm):02207         
                      (    forth6809.asm):02208         ; ------------------------------------------------------------
                      (    forth6809.asm):02209         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02210         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02211         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02212         ; CHKLO
                      (    forth6809.asm):02213         ;    Inputs:
                      (    forth6809.asm):02214         ;        RegB = input ring fill level
                      (    forth6809.asm):02215         ;    Outputs:
                      (    forth6809.asm):02216         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02217         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02218         ; ------------------------------------------------------------
CE7C                  (    forth6809.asm):02219         CHKLO:
CE7C C110             (    forth6809.asm):02220                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
CE7E 240D             (    forth6809.asm):02221                     BHS   CHKLODONE         ; No! Do nothing.
CE80 7D0178           (    forth6809.asm):02222                     TST   RTSSTATE
CE83 2708             (    forth6809.asm):02223                     BEQ   CHKLODONE         ; already low - nothing to do
CE85 8600             (    forth6809.asm):02224                     LDA   #INACCEPT         ; Yes! Assert RTS.
CE87 B70178           (    forth6809.asm):02225                     STA   RTSSTATE
CE8A BDCE4F           (    forth6809.asm):02226                     JSR   UPDATE_RTS
CE8D 39               (    forth6809.asm):02227         CHKLODONE:  RTS
                      (    forth6809.asm):02228         ; ------------------------------------------------------------
                      (    forth6809.asm):02229         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02230         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02231         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02232         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02233         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02234         ;    Inputs:
                      (    forth6809.asm):02235         ;        none
                      (    forth6809.asm):02236         ;    Outputs:
                      (    forth6809.asm):02237         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02238         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02239         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02240         ; ------------------------------------------------------------
CE8E                  (    forth6809.asm):02241         FLUSHOUTBUFFER:
CE8E F6017A           (    forth6809.asm):02242                     LDB   OUTTAIL
CE91 F10179           (    forth6809.asm):02243                     CMPB  OUTHEAD           ; Is transmit buffer empty?
CE94 2719             (    forth6809.asm):02244                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02245         
CE96 B6C008           (    forth6809.asm):02246                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
CE99 8508             (    forth6809.asm):02247                     BITA  #SR_CTS
CE9B 2612             (    forth6809.asm):02248                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02249         
CE9D 8502             (    forth6809.asm):02250                     BITA  #SR_TDRE          ; Is transmit register empty?
CE9F 270E             (    forth6809.asm):02251                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02252                                             ; than spin-wait here.
                      (    forth6809.asm):02253         
CEA1 8E01C0           (    forth6809.asm):02254                     LDX   #OUTBUF           ; The out buffer is occupied.
CEA4 A685             (    forth6809.asm):02255                     LDA   B,X               ; Get the character from the out buffer.
CEA6 B7C009           (    forth6809.asm):02256                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02257         
CEA9 5C               (    forth6809.asm):02258                     INCB                    ; Update tail pointer to next character slot.
CEAA C43F             (    forth6809.asm):02259                     ANDB  #OUTBUFSZ-1
CEAC F7017A           (    forth6809.asm):02260                     STB   OUTTAIL
                      (    forth6809.asm):02261                                             ; One character sent - return rather than
                      (    forth6809.asm):02262                                             ; loop back for more (see header comment).
CEAF                  (    forth6809.asm):02263         FLUSHED:
CEAF 39               (    forth6809.asm):02264                     RTS
                      (    forth6809.asm):02265         ; ------------------------------------------------------------
                      (    forth6809.asm):02266         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02267         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02268         ; PUTCHAR
                      (    forth6809.asm):02269         ;    Inputs:
                      (    forth6809.asm):02270         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02271         ;    Outputs:
                      (    forth6809.asm):02272         ;        none
                      (    forth6809.asm):02273         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02274         ; ------------------------------------------------------------
CEB0                  (    forth6809.asm):02275         PUTCHAR:
CEB0 3411             (    forth6809.asm):02276                     PSHS  CC,X
CEB2 1A50             (    forth6809.asm):02277                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02278         
CEB4 F60179           (    forth6809.asm):02279                     LDB   OUTHEAD           ; Is buffer full?
CEB7 5C               (    forth6809.asm):02280                     INCB
CEB8 C43F             (    forth6809.asm):02281                     ANDB  #OUTBUFSZ-1
CEBA F1017A           (    forth6809.asm):02282                     CMPB  OUTTAIL
CEBD 273A             (    forth6809.asm):02283                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02284         
CEBF 8E01C0           (    forth6809.asm):02285                     LDX   #OUTBUF           ; Put character into character slot.
CEC2 F60179           (    forth6809.asm):02286                     LDB   OUTHEAD
CEC5 A785             (    forth6809.asm):02287                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02288         
CEC7 5C               (    forth6809.asm):02289                     INCB                    ; Update tail pointer to next character slot.
CEC8 C43F             (    forth6809.asm):02290                     ANDB  #OUTBUFSZ-1
CECA F70179           (    forth6809.asm):02291                     STB   OUTHEAD
                      (    forth6809.asm):02292         
CECD 7D0178           (    forth6809.asm):02293                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
CED0 2709             (    forth6809.asm):02294                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02295         
                      (    forth6809.asm):02296                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02297                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
CED2 1CAF             (    forth6809.asm):02298                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
CED4 BDCE8E           (    forth6809.asm):02299                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
CED7 1A50             (    forth6809.asm):02300                     ORCC  #$50              ; re-mask - PUT_EXIT below still

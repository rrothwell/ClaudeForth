                      (    forth6809.asm):01802                  INCB
                      (    forth6809.asm):01803                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):01804                  CMPB  INTAIL
                      (    forth6809.asm):01805                  BEQ   IRQDONE
                      (    forth6809.asm):01806                  STB   INHEAD

                      (    forth6809.asm):08164         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (    forth6809.asm):08165         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (    forth6809.asm):08166         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (    forth6809.asm):08167         ; compiled as the new behavior, terminated with RTS) - executing
                      (    forth6809.asm):08168         ; TESTWD should push 6 (5 fetched, then incremented).
                      (    forth6809.asm):08169         ;
                      (    forth6809.asm):08170         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (    forth6809.asm):08171         ; return": it patches LATEST's behavior field using the return
                      (    forth6809.asm):08172         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (    forth6809.asm):08173         ; SECOND return address and jumps there - designed for the
                      (    forth6809.asm):08174         ; normal case where DOES> is reached from inside an enclosing
                      (    forth6809.asm):08175         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (    forth6809.asm):08176         ; would compile), which itself has its own caller. Traced by
                      (    forth6809.asm):08177         ; hand: calling directly into the compiled "JSR SETDOES"
                      (    forth6809.asm):08178         ; instruction itself (not through an intermediate wrapper)
                      (    forth6809.asm):08179         ; naturally supplies exactly the two stack levels SETDOES
                      (    forth6809.asm):08180         ; expects - its own JSR provides the first (becoming the new
                      (    forth6809.asm):08181         ; behavior field value), and this test's own call provides the
                      (    forth6809.asm):08182         ; second (correctly resuming here afterward) - no extra
                      (    forth6809.asm):08183         ; scaffolding needed, confirmed correct rather than assumed.
                      (    forth6809.asm):08184         ; ------------------------------------------------------------
C48E                  (    forth6809.asm):08185         TSTCRDOES: LDD  CODEHERE
                      (    forth6809.asm):08186                    STD  TSTCSAV
                      (    forth6809.asm):08187                    LDD  DPHERE
                      (    forth6809.asm):08188                    STD  TSTDSAV
                      (    forth6809.asm):08189                    LDD  VARHERE
                      (    forth6809.asm):08190                    STD  TSTVSAV
                      (    forth6809.asm):08191                    LDD  SRCADDR
                      (    forth6809.asm):08192                    STD  TSTSASAV
                      (    forth6809.asm):08193                    LDD  SRCLEN
                      (    forth6809.asm):08194                    STD  TSTSLSAV
                      (    forth6809.asm):08195                    LDD  TOIN
                      (    forth6809.asm):08196                    STD  TSTTISAV
                      (    forth6809.asm):08197                    LDD  LATEST
                      (    forth6809.asm):08198                    STD  TSTLSAV
                      (    forth6809.asm):08199         
                      (    forth6809.asm):08200                    LDA  #'T'
                      (    forth6809.asm):08201                    STA  TSTNAMEB
                      (    forth6809.asm):08202                    LDA  #'E'
                      (    forth6809.asm):08203                    STA  TSTNAMEB+1
                      (    forth6809.asm):08204                    LDA  #'S'
                      (    forth6809.asm):08205                    STA  TSTNAMEB+2
                      (    forth6809.asm):08206                    LDA  #'T'
                      (    forth6809.asm):08207                    STA  TSTNAMEB+3
                      (    forth6809.asm):08208                    LDA  #'W'
                      (    forth6809.asm):08209                    STA  TSTNAMEB+4
                      (    forth6809.asm):08210                    LDA  #'D'
                      (    forth6809.asm):08211                    STA  TSTNAMEB+5
                      (    forth6809.asm):08212         

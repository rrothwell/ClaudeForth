                      (    forth6809.asm):07069         ; ============================================================
                      (    forth6809.asm):07070         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07071         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07072         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07073         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07074         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07075         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07076         ; ============================================================
                      (    forth6809.asm):07077         ; ------------------------------------------------------------
                      (    forth6809.asm):07078         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07079         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07080         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07081         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07082         ; - no indirection, no value cell.
                      (    forth6809.asm):07083         ;
                      (    forth6809.asm):07084         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07085         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07086         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07087         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07088         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07089         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07090         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07091         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07092         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07093         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07094         ; ------------------------------------------------------------
FF36 CCFFFF           (    forth6809.asm):07095         TRUEBODY:  LDD   #$FFFF
FF39 3606             (    forth6809.asm):07096                    PSHU  D
FF3B 39               (    forth6809.asm):07097                    RTS
                      (    forth6809.asm):07098         
FF3C CC0000           (    forth6809.asm):07099         FALSEBODY: LDD   #$0000
FF3F 3606             (    forth6809.asm):07100                    PSHU  D
FF41 39               (    forth6809.asm):07101                    RTS
                      (    forth6809.asm):07102         
                      (    forth6809.asm):07103         ; ------------------------------------------------------------
                      (    forth6809.asm):07104         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07105         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07106         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07107         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07108         ; ------------------------------------------------------------
FF42 CC0001           (    forth6809.asm):07109         ONEBODY:   LDD   #1
FF45 3606             (    forth6809.asm):07110                    PSHU  D
FF47 39               (    forth6809.asm):07111                    RTS
                      (    forth6809.asm):07112         
FF48 CCFFFF           (    forth6809.asm):07113         MONEBODY:  LDD   #-1
FF4B 3606             (    forth6809.asm):07114                    PSHU  D
FF4D 39               (    forth6809.asm):07115                    RTS
                      (    forth6809.asm):07116         
FF4E CC0002           (    forth6809.asm):07117         TWOBODY:   LDD   #2
FF51 3606             (    forth6809.asm):07118                    PSHU  D
FF53 39               (    forth6809.asm):07119                    RTS
                      (    forth6809.asm):07120         
FF54 CCFFFE           (    forth6809.asm):07121         MTWOBODY:  LDD   #-2
FF57 3606             (    forth6809.asm):07122                    PSHU  D
FF59 39               (    forth6809.asm):07123                    RTS
                      (    forth6809.asm):07124         
                      (    forth6809.asm):07125         ; Verify no collision with init code,
                      (    forth6809.asm):07126         ; value should match ORG INITCODE.
     FF5A             (    forth6809.asm):07127         BASECODEEND  EQU   *
     2070             (    forth6809.asm):07128         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07129         
                      (    forth6809.asm):07130         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07131         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07132         ; .bin file.

                      (    forth6809.asm):02212                    CMPD  #-10
                      (    forth6809.asm):02213                    BNE   MXFAIL
                      (    forth6809.asm):02214         
                      (    forth6809.asm):02215                    LDD   TSTUB4
                      (    forth6809.asm):02216                    SUBD  TSTUAF
                      (    forth6809.asm):02217                    CMPD  #0
                      (    forth6809.asm):02218                    BNE   MXFAIL
                      (    forth6809.asm):02219         
                      (    forth6809.asm):02220                    LDD   #TRUEV
                      (    forth6809.asm):02221                    BRA   MXDONE
C17D                  (    forth6809.asm):02222         MXFAIL:     LDD   #FALSEV
C17D                  (    forth6809.asm):02223         MXDONE:     LDX   #TSTSLMODZNAME
                      (    forth6809.asm):02224                    PSHU  X

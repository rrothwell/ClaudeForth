                      (    forth6809.asm):02212                    PSHU  D
                      (    forth6809.asm):02213                    LDD   #TSTVAL2
                      (    forth6809.asm):02214                    PSHU  D
                      (    forth6809.asm):02215                    LDD   #TSTVAL3
                      (    forth6809.asm):02216                    PSHU  D
                      (    forth6809.asm):02217                    LDD   #2
                      (    forth6809.asm):02218                    PSHU  D
                      (    forth6809.asm):02219                    STU   TSTUB4
                      (    forth6809.asm):02220         
                      (    forth6809.asm):02221                    JSR   ROLL
                      (    forth6809.asm):02222         
                      (    forth6809.asm):02223                    STU   TSTUAF
                      (    forth6809.asm):02224         
                      (    forth6809.asm):02225                    PULU  D
                      (    forth6809.asm):02226                    CMPD  #TSTVAL1
                      (    forth6809.asm):02227                    BNE   RLFAIL
                      (    forth6809.asm):02228                    PULU  D
                      (    forth6809.asm):02229                    CMPD  #TSTVAL3
                      (    forth6809.asm):02230                    BNE   RLFAIL
                      (    forth6809.asm):02231                    PULU  D
                      (    forth6809.asm):02232                    CMPD  #TSTVAL2
                      (    forth6809.asm):02233                    BNE   RLFAIL
                      (    forth6809.asm):02234                    PULU  D
                      (    forth6809.asm):02235                    CMPD  #TSTGUARD
                      (    forth6809.asm):02236                    BNE   RLFAIL
                      (    forth6809.asm):02237         
                      (    forth6809.asm):02238                    LDD   TSTUB4
                      (    forth6809.asm):02239                    SUBD  TSTUAF
                      (    forth6809.asm):02240                    CMPD  #-2
                      (    forth6809.asm):02241                    BNE   RLFAIL
                      (    forth6809.asm):02242         
                      (    forth6809.asm):02243                    LDD   #TRUEV
                      (    forth6809.asm):02244                    BRA   RLDONE
C18C                  (    forth6809.asm):02245         RLFAIL:    LDD   #FALSEV
C18C                  (    forth6809.asm):02246         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):02247                    PSHU  X
                      (    forth6809.asm):02248                    PSHU  D
                      (    forth6809.asm):02249                    JSR   TSTREPORT
                      (    forth6809.asm):02250         
                      (    forth6809.asm):02251                    LDU   TSTU0
                      (    forth6809.asm):02252                    RTS
                      (    forth6809.asm):02253         
C18C                  (    forth6809.asm):02254         TSTROLLNAME: FCB  7
                      (    forth6809.asm):02255                      FCC  "TSTROLL"
                      (    forth6809.asm):02256         
                      (    forth6809.asm):02257         ; ------------------------------------------------------------
                      (    forth6809.asm):02258         ; TSTDROT - unit test for 2ROT
                      (    forth6809.asm):02259         ; ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 ). Verifies the
                      (    forth6809.asm):02260         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):02261         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):02262         ; ------------------------------------------------------------
C18C                  (    forth6809.asm):02263         TSTDROT:   STU   TSTU0
                      (    forth6809.asm):02264         
                      (    forth6809.asm):02265                    LDD   #TSTGUARD
                      (    forth6809.asm):02266                    PSHU  D
                      (    forth6809.asm):02267                    LDD   #TSTVAL1
                      (    forth6809.asm):02268                    PSHU  D
                      (    forth6809.asm):02269                    LDD   #TSTVAL2
                      (    forth6809.asm):02270                    PSHU  D
                      (    forth6809.asm):02271                    LDD   #TSTVAL3
                      (    forth6809.asm):02272                    PSHU  D
                      (    forth6809.asm):02273                    LDD   #TSTVAL4
                      (    forth6809.asm):02274                    PSHU  D
                      (    forth6809.asm):02275                    LDD   #TSTVAL5
                      (    forth6809.asm):02276                    PSHU  D
                      (    forth6809.asm):02277                    LDD   #TSTVAL6
                      (    forth6809.asm):02278                    PSHU  D
                      (    forth6809.asm):02279                    STU   TSTUB4
                      (    forth6809.asm):02280         
                      (    forth6809.asm):02281                    JSR   DROT
                      (    forth6809.asm):02282         
                      (    forth6809.asm):02283                    STU   TSTUAF
                      (    forth6809.asm):02284         
                      (    forth6809.asm):02285                    PULU  D
                      (    forth6809.asm):02286                    CMPD  #TSTVAL2
                      (    forth6809.asm):02287                    BNE   RO2FAIL
                      (    forth6809.asm):02288                    PULU  D
                      (    forth6809.asm):02289                    CMPD  #TSTVAL1
                      (    forth6809.asm):02290                    BNE   RO2FAIL
                      (    forth6809.asm):02291                    PULU  D
                      (    forth6809.asm):02292                    CMPD  #TSTVAL6
                      (    forth6809.asm):02293                    BNE   RO2FAIL
                      (    forth6809.asm):02294                    PULU  D
                      (    forth6809.asm):02295                    CMPD  #TSTVAL5
                      (    forth6809.asm):02296                    BNE   RO2FAIL
                      (    forth6809.asm):02297                    PULU  D
                      (    forth6809.asm):02298                    CMPD  #TSTVAL4
                      (    forth6809.asm):02299                    BNE   RO2FAIL
                      (    forth6809.asm):02300                    PULU  D
                      (    forth6809.asm):02301                    CMPD  #TSTVAL3
                      (    forth6809.asm):02302                    BNE   RO2FAIL
                      (    forth6809.asm):02303                    PULU  D
                      (    forth6809.asm):02304                    CMPD  #TSTGUARD
                      (    forth6809.asm):02305                    BNE   RO2FAIL
                      (    forth6809.asm):02306         
                      (    forth6809.asm):02307                    LDD   TSTUB4
                      (    forth6809.asm):02308                    SUBD  TSTUAF
                      (    forth6809.asm):02309                    CMPD  #0
                      (    forth6809.asm):02310                    BNE   RO2FAIL
                      (    forth6809.asm):02311         
                      (    forth6809.asm):02312                    LDD   #TRUEV
                      (    forth6809.asm):02313                    BRA   RO2DONE
C18C                  (    forth6809.asm):02314         RO2FAIL:   LDD   #FALSEV
C18C                  (    forth6809.asm):02315         RO2DONE:   LDX   #TSTDROTNAME
                      (    forth6809.asm):02316                    PSHU  X
                      (    forth6809.asm):02317                    PSHU  D
                      (    forth6809.asm):02318                    JSR   TSTREPORT
                      (    forth6809.asm):02319         
                      (    forth6809.asm):02320                    LDU   TSTU0
                      (    forth6809.asm):02321                    RTS

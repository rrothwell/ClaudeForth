                      (    forth6809.asm):15854         ; TSTREFILL - unit test for REFILL, string-source path only.
                      (    forth6809.asm):15855         ; Confirmed via its own code that the terminal-source path
                      (    forth6809.asm):15856         ; (SRCID=0) genuinely blocks on real input (calls QUERY, which
                      (    forth6809.asm):15857         ; per section 3.1's own established finding calls ACCEPT, which
                      (    forth6809.asm):15858         ; calls KEY, which spins forever without it) - deliberately not
                      (    forth6809.asm):15859         ; tested, matching the same reasoning already applied to KEY/
                      (    forth6809.asm):15860         ; ACCEPT/EXPECT/QUERY themselves. Only the safely-testable path
                      (    forth6809.asm):15861         ; (source is a string, SRCID<>0) is exercised: redirects SRCID
                      (    forth6809.asm):15862         ; to a nonzero value and verifies REFILL correctly reports
                      (    forth6809.asm):15863         ; false, matching its own documented "fails (false) if the
                      (    forth6809.asm):15864         ; current source is a string, per ANS".
                      (    forth6809.asm):15865         ; ------------------------------------------------------------

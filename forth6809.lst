E38A 3606             (    forth6809.asm):05596                     PSHU  D
E38C 39               (    forth6809.asm):05597                     RTS
                      (    forth6809.asm):05598         
                      (    forth6809.asm):05599         ; ============================================================
                      (    forth6809.asm):05600         ; SECTION 14: STACK MANIPULATION (Core + Core Ext + return stack)
                      (    forth6809.asm):05601         ; ============================================================
                      (    forth6809.asm):05602         ; ------------------------------------------------------------
                      (    forth6809.asm):05603         ; DUP  ( x -- x x )

                      (    forth6809.asm):03833         ; ============================================================
                      (    forth6809.asm):03834         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03835         ; ============================================================
                      (    forth6809.asm):03836                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E4B5                  (    forth6809.asm):03837         X_KEY:     LDA   INHEAD
                      (    forth6809.asm):03838                  CMPA  INTAIL
                      (    forth6809.asm):03839                  BEQ   KEY
                      (    forth6809.asm):03840                  LDX   #INBUF
                      (    forth6809.asm):03841                  LDB   INTAIL
                      (    forth6809.asm):03842                  LDA   B,X
                      (    forth6809.asm):03843                  INCB
                      (    forth6809.asm):03844                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):03845                  STB   INTAIL
                      (    forth6809.asm):03846                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03847                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03848                                         ; this needs no dedicated scratch global
                      (    forth6809.asm):03849                  JSR   RTSCHECKLO
                      (    forth6809.asm):03850                  PULS  A
                      (    forth6809.asm):03851                  TFR   A,B
                      (    forth6809.asm):03852                  CLRA
                      (    forth6809.asm):03853                  PSHU  D
                      (    forth6809.asm):03854                  RTS
                      (    forth6809.asm):03855         
                      (    forth6809.asm):03856         ; ------------------------------------------------------------
                      (    forth6809.asm):03857         ; KEY ( -- char )
                      (    forth6809.asm):03858         ; ------------------------------------------------------------
E4B5                  (    forth6809.asm):03859         KEY:
                      (    forth6809.asm):03860         
                      (    forth6809.asm):03861                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03862                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03863         
                      (    forth6809.asm):03864                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03865                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03866                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03867                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03868                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03869                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03870                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03871                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03872                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03873                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03874                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03875                                             ; by transmitting all chars.
                      (    forth6809.asm):03876         
E4B5                  (    forth6809.asm):03877         TRY_READ:
                      (    forth6809.asm):03878                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03879                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03880                                             ; while still transmitting!
                      (    forth6809.asm):03881                 
                      (    forth6809.asm):03882                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03883                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03884                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03885         
                      (    forth6809.asm):03886                     RTS                     
                      (    forth6809.asm):03887         
                      (    forth6809.asm):03888         ; ------------------------------------------------------------
                      (    forth6809.asm):03889         ; KEY? ( -- flag )
                      (    forth6809.asm):03890         ; ------------------------------------------------------------
E4B5                  (    forth6809.asm):03891         KEYQ:  
                      (    forth6809.asm):03892                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03893         
                      (    forth6809.asm):03894                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03895                     CMPA  INTAIL
                      (    forth6809.asm):03896         
                      (    forth6809.asm):03897                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03898         
                      (    forth6809.asm):03899                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03900         
                      (    forth6809.asm):03901                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03902                     PSHU  D
                      (    forth6809.asm):03903         
                      (    forth6809.asm):03904                     RTS
                      (    forth6809.asm):03905         
E4B5                  (    forth6809.asm):03906         KQTRUE:     
                      (    forth6809.asm):03907                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03908                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03909                     RTS
                      (    forth6809.asm):03910         ; ------------------------------------------------------------
                      (    forth6809.asm):03911         ; EMIT  ( char -- )
                      (    forth6809.asm):03912         ; ------------------------------------------------------------
                      (    forth6809.asm):03913         
E4B5                  (    forth6809.asm):03914         X_EMIT:    PULU  D
                      (    forth6809.asm):03915                  STB   EMITCH
E4B5                  (    forth6809.asm):03916         EMITWT:  LDB   OUTHEAD
                      (    forth6809.asm):03917                  INCB
                      (    forth6809.asm):03918                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03919                  CMPB  OUTTAIL
                      (    forth6809.asm):03920                  BEQ   EMITWT
                      (    forth6809.asm):03921                  LDX   #OUTBUF
                      (    forth6809.asm):03922                  LDB   OUTHEAD
                      (    forth6809.asm):03923                  LDA   EMITCH
                      (    forth6809.asm):03924                  STA   B,X
                      (    forth6809.asm):03925                  INCB
                      (    forth6809.asm):03926                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03927                  STB   OUTHEAD
                      (    forth6809.asm):03928                  TST   RTSSTATE
                      (    forth6809.asm):03929                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03930                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03931                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03932                                         ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03933                  LDA   #CR_RXTX
                      (    forth6809.asm):03934                  STA   ACIACR
E4B5                  (    forth6809.asm):03935         EMITNORTS: RTS
                      (    forth6809.asm):03936         
E4B5                  (    forth6809.asm):03937         EMIT:
                      (    forth6809.asm):03938                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03939                     TFR   B,A               
                      (    forth6809.asm):03940                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03941                     RTS                     
                      (    forth6809.asm):03942         
                      (    forth6809.asm):03943                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):03944         ; ------------------------------------------------------------
                      (    forth6809.asm):03945         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03946         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03947         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03948         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03949         ; directly against ACIASR.
                      (    forth6809.asm):03950         ;
                      (    forth6809.asm):03951         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03952         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03953         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03954         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03955         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03956         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03957         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03958         ; ------------------------------------------------------------
E4B5                  (    forth6809.asm):03959         KEY:
E4B5 B6C008           (    forth6809.asm):03960                  LDA   ACIASR
E4B8 8501             (    forth6809.asm):03961                  BITA  #SR_RDRF
E4BA 2705             (    forth6809.asm):03962                  BEQ   KWAIT
E4BC 7C017F           (    forth6809.asm):03963                  INC   POLLREADYCNT   ; character was already queued when we
E4BF 2007             (    forth6809.asm):03964                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E4C1                  (    forth6809.asm):03965         KWAIT:
E4C1 B6C008           (    forth6809.asm):03966         KSPIN:   LDA   ACIASR
E4C4 8501             (    forth6809.asm):03967                  BITA  #SR_RDRF
E4C6 27F9             (    forth6809.asm):03968                  BEQ   KSPIN
E4C8                  (    forth6809.asm):03969         KGOTSTAT:                     ; A holds the status byte exactly as it was
                      (    forth6809.asm):03970                                        ; when RDRF first went true - check the
                      (    forth6809.asm):03971                                        ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03972                                        ; read, since reading ACIADR below clears
                      (    forth6809.asm):03973                                        ; RDRF and the latched error bits together
E4C8 8570             (    forth6809.asm):03974                  BITA  #SR_FE+SR_OVRN+SR_PE
E4CA 2715             (    forth6809.asm):03975                  BEQ   KGETCH
E4CC 8510             (    forth6809.asm):03976                  BITA  #SR_FE
E4CE 2703             (    forth6809.asm):03977                  BEQ   KXFE
E4D0 7C017C           (    forth6809.asm):03978                  INC   FECOUNT
E4D3 8520             (    forth6809.asm):03979         KXFE:    BITA  #SR_OVRN
E4D5 2703             (    forth6809.asm):03980                  BEQ   KXOVRN
E4D7 7C017D           (    forth6809.asm):03981                  INC   OVRNCOUNT
E4DA 8540             (    forth6809.asm):03982         KXOVRN:  BITA  #SR_PE
E4DC 2703             (    forth6809.asm):03983                  BEQ   KGETCH
E4DE 7C017E           (    forth6809.asm):03984                  INC   PECOUNT
E4E1 B6C009           (    forth6809.asm):03985         KGETCH:  LDA   ACIADR
E4E4 1F89             (    forth6809.asm):03986                  TFR   A,B
E4E6 4F               (    forth6809.asm):03987                  CLRA
E4E7 3606             (    forth6809.asm):03988                  PSHU  D
E4E9 39               (    forth6809.asm):03989                  RTS
                      (    forth6809.asm):03990         
                      (    forth6809.asm):03991         ; ------------------------------------------------------------
                      (    forth6809.asm):03992         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):03993         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):03994         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):03995         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):03996         ; either is safe to call from ACCEPT at any point without

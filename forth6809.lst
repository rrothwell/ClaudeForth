                      (    forth6809.asm):07070                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA6                  (    forth6809.asm):07071         COLDSTRT:
FFA6 1A50             (    forth6809.asm):07072                  ORCC  #$50
FFA8 10CEC000         (    forth6809.asm):07073                  LDS   #RSTACK+1
FFAC CEBD00           (    forth6809.asm):07074                  LDU   #DSTACK+1
FFAF 4F               (    forth6809.asm):07075                  CLRA
FFB0 1F8B             (    forth6809.asm):07076                  TFR   A,DP
                      (    forth6809.asm):07077         
FFB2 8E0000           (    forth6809.asm):07078                  LDX   #GLOBALS
FFB5 C600             (    forth6809.asm):07079                  LDB   #0
FFB7 6F80             (    forth6809.asm):07080         CLRGLOB: CLR   ,X+
FFB9 5A               (    forth6809.asm):07081                  DECB
FFBA 26FB             (    forth6809.asm):07082                  BNE   CLRGLOB
                      (    forth6809.asm):07083         
FFBC 8E0106           (    forth6809.asm):07084                  LDX   #SERBUF
FFBF 6F80             (    forth6809.asm):07085                  CLR   ,X+
FFC1 6F84             (    forth6809.asm):07086                  CLR   ,X
                      (    forth6809.asm):07087         
FFC3 BDDEEA           (    forth6809.asm):07088                  JSR   INITSERIAL
                      (    forth6809.asm):07089         
                      (    forth6809.asm):07090                  IFNE  UNITTESTS  ; >>>>>>>>>>
FFC6 BDC135           (    forth6809.asm):07091                  JSR   TSTRUNNER
                      (    forth6809.asm):07092                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):07093                  NOP             ; BUG FIX (see the historical note above this
                      (    forth6809.asm):07094                  NOP             ; call site's own comment, describing the
                      (    forth6809.asm):07095                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07096                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07097                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07098                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07099                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07100                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07101                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07102                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07103                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07104                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07105                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07106                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07107                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07108                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07109         
FFC9 7EDF02           (    forth6809.asm):07110                  JMP   COLD
                      (    forth6809.asm):07111         
FFCC 1A50             (    forth6809.asm):07112         WARM:    ORCC  #$50

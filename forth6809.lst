                      (    forth6809.asm):01836         ; ------------------------------------------------------------
                      (    forth6809.asm):01837         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):01838         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):01839         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):01840         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):01841         ; IRQH
                      (    forth6809.asm):01842         ;    Inputs:
                      (    forth6809.asm):01843         ;        none (hardware interrupt entry)
                      (    forth6809.asm):01844         ;    Outputs:
                      (    forth6809.asm):01845         ;        none (returns with RTI)
                      (    forth6809.asm):01846         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):01847         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):01848         ; ------------------------------------------------------------
DE0F B6C008           (    forth6809.asm):01849         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):01850         
DE12 8580             (    forth6809.asm):01851                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DE14 2708             (    forth6809.asm):01852                     BEQ   IRQDONE0          ; No! Just exit.
DE16 8501             (    forth6809.asm):01853                     BITA  #SR_RDRF          ; Is an incoming character available?
DE18 2605             (    forth6809.asm):01854                     BNE   INCHAR
DE1A 8502             (    forth6809.asm):01855                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DE1C 263C             (    forth6809.asm):01856                     BNE   OUTCHAR
                      (    forth6809.asm):01857                                             ; Ignore all other interrupts such as DCD change.
DE1E 3B               (    forth6809.asm):01858         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):01859                                             ; & restores state.
                      (    forth6809.asm):01860         
DE1F                  (    forth6809.asm):01861         INCHAR:
DE1F F6C009           (    forth6809.asm):01862                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
DE22 8570             (    forth6809.asm):01863                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):01864                                             ; Any receiver error flagged?
DE24 2716             (    forth6809.asm):01865                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):01866         
DE26 8510             (    forth6809.asm):01867                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DE28 2703             (    forth6809.asm):01868                     BEQ   INXFE             ; Tally each flagged error independently -
DE2A 7C017C           (    forth6809.asm):01869                     INC   FECOUNT           ; more than one bit can be set at once.
DE2D 8520             (    forth6809.asm):01870         INXFE:      BITA  #SR_OVRN
DE2F 2703             (    forth6809.asm):01871                     BEQ   INXOVRN
DE31 7C017D           (    forth6809.asm):01872                     INC   OVRNCOUNT
DE34 8540             (    forth6809.asm):01873         INXOVRN:    BITA  #SR_PE
DE36 2703             (    forth6809.asm):01874                     BEQ   INXPE
DE38 7C017E           (    forth6809.asm):01875                     INC   PECOUNT
DE3B 3B               (    forth6809.asm):01876         INXPE:      RTI
                      (    forth6809.asm):01877         
DE3C 1F98             (    forth6809.asm):01878         INOK:       TFR   B,A               ; Transfer good character from the receiver.
DE3E 8E0180           (    forth6809.asm):01879                     LDX   #INBUF            ; Store it in the empty in buffer slot.
DE41 F60176           (    forth6809.asm):01880                     LDB   INHEAD
DE44 A785             (    forth6809.asm):01881                     STA   B,X
DE46 5C               (    forth6809.asm):01882                     INCB                    ; Figure out the new head,
DE47 C43F             (    forth6809.asm):01883                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
DE49 F10177           (    forth6809.asm):01884                     CMPB  INTAIL            ; Would the new head slot meet the tail?
DE4C 270B             (    forth6809.asm):01885                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
DE4E F70176           (    forth6809.asm):01886                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):01887                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):01888                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):01889                     ; See shadow: INCHAR.1
DE51 F00177           (    forth6809.asm):01890                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
DE54 C43F             (    forth6809.asm):01891                     ANDB  #INBUFSZ-1
DE56 BDDD2E           (    forth6809.asm):01892                     JSR   CHKHI             ; Protect the in buffer from overflow.
DE59 3B               (    forth6809.asm):01893         IRQDONE1:   RTI
                      (    forth6809.asm):01894         
                      (    forth6809.asm):01895                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):01896         
DE5A F6017A           (    forth6809.asm):01897         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
DE5D F10179           (    forth6809.asm):01898                     CMPB  OUTHEAD
DE60 270F             (    forth6809.asm):01899                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):01900         
DE62 8E01C0           (    forth6809.asm):01901                     LDX   #OUTBUF           ; No! The out buffer is occupied.

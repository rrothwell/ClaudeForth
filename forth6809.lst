                      (    forth6809.asm):02946         ; TSTSTSMZ - unit test for STARSLASHMOD, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):02947         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02948         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02949         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02950         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02951         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02952         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02953         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02954         ; there are.
                      (    forth6809.asm):02955         ; ------------------------------------------------------------
C180                  (    forth6809.asm):02956         TSTSTSMZ:   STU   TSTU0
                      (    forth6809.asm):02957         
                      (    forth6809.asm):02958                    LDD   #TSTVAL1
                      (    forth6809.asm):02959                    PSHU  D
                      (    forth6809.asm):02960                    LDD   #TSTVAL2
                      (    forth6809.asm):02961                    PSHU  D
                      (    forth6809.asm):02962                    LDD   #$0000
                      (    forth6809.asm):02963                    PSHU  D
                      (    forth6809.asm):02964                    LDX   #STARSLASHMOD
                      (    forth6809.asm):02965                    PSHU  X
                      (    forth6809.asm):02966                    STU   TSTUB4
                      (    forth6809.asm):02967         
                      (    forth6809.asm):02968                    JSR   CATCH
                      (    forth6809.asm):02969         
                      (    forth6809.asm):02970                    STU   TSTUAF
                      (    forth6809.asm):02971         
                      (    forth6809.asm):02972                    PULU  D
                      (    forth6809.asm):02973                    CMPD  #-10
                      (    forth6809.asm):02974                    BNE   TXFAIL
                      (    forth6809.asm):02975         
                      (    forth6809.asm):02976                    LDD   TSTUB4
                      (    forth6809.asm):02977                    SUBD  TSTUAF
                      (    forth6809.asm):02978                    CMPD  #0
                      (    forth6809.asm):02979                    BNE   TXFAIL
                      (    forth6809.asm):02980         
                      (    forth6809.asm):02981                    LDD   #TRUEV
                      (    forth6809.asm):02982                    BRA   TXDONE
C180                  (    forth6809.asm):02983         TXFAIL:     LDD   #FALSEV
C180                  (    forth6809.asm):02984         TXDONE:     LDX   #TSTSTSMZNAME
                      (    forth6809.asm):02985                    PSHU  X
                      (    forth6809.asm):02986                    PSHU  D
                      (    forth6809.asm):02987                    JSR   TSTREPORT
                      (    forth6809.asm):02988         
                      (    forth6809.asm):02989                    LDU   TSTU0
                      (    forth6809.asm):02990                    RTS

                      (    forth6809.asm):09496         ; TSTCOMPWORDS - compiling-words tests (glossary section 3.10,
                      (    forth6809.asm):09497         ; 13 words, 17 tests since several get separate cases: TICK
                      (    forth6809.asm):09498         ; found/not-found, ['] compiling/interpreting state, POSTPONE
                      (    forth6809.asm):09499         ; normal/immediate word, SLITERAL compiling/interpreting state,
                      (    forth6809.asm):09500         ; ABORT" false/true flag). Reuses the scratch infrastructure
                      (    forth6809.asm):09501         ; established for sections 3.8/3.9 throughout.
                      (    forth6809.asm):09502         ;
                      (    forth6809.asm):09503         ; POSTPONE is this section's hardest case: a genuine two-level
                      (    forth6809.asm):09504         ; compile-time mechanism. Traced its own code first - for a
                      (    forth6809.asm):09505         ; normal word, it compiles code that ITSELF compiles a call to
                      (    forth6809.asm):09506         ; that word later, when the current definition eventually runs,
                      (    forth6809.asm):09507         ; not immediately (standard ANS semantics: POSTPONE appends a
                      (    forth6809.asm):09508         ; word's own compilation semantics to the current definition,
                      (    forth6809.asm):09509         ; and for an ordinary word that semantics IS "compile a call to
                      (    forth6809.asm):09510         ; it", so appending it only makes sense if the current
                      (    forth6809.asm):09511         ; definition later performs that compiling action itself,
                      (    forth6809.asm):09512         ; against whatever's being compiled at that later point).
                      (    forth6809.asm):09513         ; Verified via the compiled byte sequence directly rather than
                      (    forth6809.asm):09514         ; fully executing a triple-nested compile chain.
                      (    forth6809.asm):09515         ;
                      (    forth6809.asm):09516         ; ABORT" is safely testable for both its flag cases - confirmed
                      (    forth6809.asm):09517         ; by reading its own runtime code that it uses THROW -2
                      (    forth6809.asm):09518         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09519         ; ABORT itself uses (still deliberately untested, per section
                      (    forth6809.asm):09520         ; 3.1's own reasoning).
                      (    forth6809.asm):09521         ; ------------------------------------------------------------
C264 BDFC2B           (    forth6809.asm):09522         TSTCOMPWORDS: JSR CRW
C267 8EC278           (    forth6809.asm):09523                    LDX   #TSTCWMSG
C26A 3610             (    forth6809.asm):09524                    PSHU  X
C26C CC0009           (    forth6809.asm):09525                    LDD   #9
C26F 3606             (    forth6809.asm):09526                    PSHU  D
C271 BDF60B           (    forth6809.asm):09527                    JSR   TYPE
C274 BDFC2B           (    forth6809.asm):09528                    JSR   CRW
                      (    forth6809.asm):09529         
                      (    forth6809.asm):09530                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09531         
                      (    forth6809.asm):09532                    JSR   TSTIMMED
                      (    forth6809.asm):09533                    JSR   TSTSTATE
                      (    forth6809.asm):09534                    JSR   TSTBRACKETS
                      (    forth6809.asm):09535                    JSR   TSTTICK1
                      (    forth6809.asm):09536                    JSR   TSTTICK2
                      (    forth6809.asm):09537                    JSR   TSTCOMPCOMMA
                      (    forth6809.asm):09538                    JSR   TSTLITERAL
                      (    forth6809.asm):09539                    JSR   TSTBRACKTICK1
                      (    forth6809.asm):09540                    JSR   TSTBRACKTICK2
                      (    forth6809.asm):09541                    JSR   TSTPOSTPONE1
                      (    forth6809.asm):09542                    JSR   TSTPOSTPONE2
                      (    forth6809.asm):09543                    JSR   TSTTOBODY
                      (    forth6809.asm):09544                    JSR   TSTEXECUTE
                      (    forth6809.asm):09545                    JSR   TSTSLITERAL1
                      (    forth6809.asm):09546                    JSR   TSTSLITERAL2
                      (    forth6809.asm):09547                    JSR   TSTABORTQ1
                      (    forth6809.asm):09548                    JSR   TSTABORTQ2
                      (    forth6809.asm):09549         
                      (    forth6809.asm):09550                    ENDC ; <<<<

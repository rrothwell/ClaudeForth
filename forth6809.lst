                      (    forth6809.asm):10376                       STD  TSTSLSAV
                      (    forth6809.asm):10377                       LDD  TOIN
                      (    forth6809.asm):10378                       STD  TSTTISAV
                      (    forth6809.asm):10379                       LDD  STATE
                      (    forth6809.asm):10380                       STD  TSTSTSAV
                      (    forth6809.asm):10381         
                      (    forth6809.asm):10382                       LDA  #$83
                      (    forth6809.asm):10383                       STA  TSTFHDR
                      (    forth6809.asm):10384                       LDA  #'F'
                      (    forth6809.asm):10385                       STA  TSTFHDR+1
                      (    forth6809.asm):10386                       LDA  #'O'
                      (    forth6809.asm):10387                       STA  TSTFHDR+2
                      (    forth6809.asm):10388                       LDA  #'O'
                      (    forth6809.asm):10389                       STA  TSTFHDR+3
                      (    forth6809.asm):10390                       LDD  #0
                      (    forth6809.asm):10391                       STD  TSTFHDR+4
                      (    forth6809.asm):10392                       LDD  #SPACEW
                      (    forth6809.asm):10393                       STD  TSTFHDR+6
                      (    forth6809.asm):10394         
                      (    forth6809.asm):10395                       LDA  #'F'

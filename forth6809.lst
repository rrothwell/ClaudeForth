                      (    forth6809.asm):07972         
                      (    forth6809.asm):07973         ; ------------------------------------------------------------
                      (    forth6809.asm):07974         ; FALSE  ( -- flag )
                      (    forth6809.asm):07975         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):07976         ; ------------------------------------------------------------
FE7B CC0000           (    forth6809.asm):07977         FALSEW:     LDD   #$0000
FE7E 3606             (    forth6809.asm):07978                     PSHU  D
FE80 39               (    forth6809.asm):07979                     RTS
                      (    forth6809.asm):07980         
                      (    forth6809.asm):07981         ; ------------------------------------------------------------
                      (    forth6809.asm):07982         ; 1  ( -- 1 )
                      (    forth6809.asm):07983         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):07984         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):07985         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):07986         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):07987         ; ------------------------------------------------------------
FE81 CC0001           (    forth6809.asm):07988         POSONEW:    LDD   #1
FE84 3606             (    forth6809.asm):07989                     PSHU  D
FE86 39               (    forth6809.asm):07990                     RTS
                      (    forth6809.asm):07991         
                      (    forth6809.asm):07992         ; ------------------------------------------------------------
                      (    forth6809.asm):07993         ; -1  ( -- -1 )
                      (    forth6809.asm):07994         ; Push the constant -1.
                      (    forth6809.asm):07995         ; ------------------------------------------------------------
FE87 CCFFFF           (    forth6809.asm):07996         NEGONEW:    LDD   #-1
FE8A 3606             (    forth6809.asm):07997                     PSHU  D
FE8C 39               (    forth6809.asm):07998                     RTS
                      (    forth6809.asm):07999         
                      (    forth6809.asm):08000         ; ------------------------------------------------------------
                      (    forth6809.asm):08001         ; 2  ( -- 2 )
                      (    forth6809.asm):08002         ; Push the constant 2.
                      (    forth6809.asm):08003         ; ------------------------------------------------------------
FE8D CC0002           (    forth6809.asm):08004         POSTWOW:    LDD   #2
FE90 3606             (    forth6809.asm):08005                     PSHU  D
FE92 39               (    forth6809.asm):08006                     RTS
                      (    forth6809.asm):08007         
                      (    forth6809.asm):08008         ; ------------------------------------------------------------
                      (    forth6809.asm):08009         ; -2  ( -- -2 )
                      (    forth6809.asm):08010         ; Push the constant -2.
                      (    forth6809.asm):08011         ; ------------------------------------------------------------
FE93 CCFFFE           (    forth6809.asm):08012         NEGTWOW:    LDD   #-2
FE96 3606             (    forth6809.asm):08013                     PSHU  D
FE98 39               (    forth6809.asm):08014                     RTS
                      (    forth6809.asm):08015         

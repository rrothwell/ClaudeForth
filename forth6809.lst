                      (    forth6809.asm):03096         ; ------------------------------------------------------------
                      (    forth6809.asm):03097         ; Multiply the unsigned double UDHI:UDLO by BASE and add a digit.
                      (    forth6809.asm):03098         ; UDMULADD
                      (    forth6809.asm):03099         ;    Inputs:
                      (    forth6809.asm):03100         ;        UDHI:UDLO = ud
                      (    forth6809.asm):03101         ;        RegB = digit value to add
                      (    forth6809.asm):03102         ;        BASE
                      (    forth6809.asm):03103         ;    Outputs:
                      (    forth6809.asm):03104         ;        UDHI:UDLO = ud * BASE + digit
                      (    forth6809.asm):03105         ;    Registers: RegA, RegB and CC changed; CARRY and MULBASE used as
                      (    forth6809.asm):03106         ;        scratch.
                      (    forth6809.asm):03107         ; ------------------------------------------------------------
E42C D725             (    forth6809.asm):03108         UDMULADD:   STB   CARRY

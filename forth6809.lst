                      (    forth6809.asm):01574         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01575         ; receiver-error counters to zero.
                      (    forth6809.asm):01576         ; SERBUFCLR
                      (    forth6809.asm):01577         ;    Inputs:
                      (    forth6809.asm):01578         ;        none
                      (    forth6809.asm):01579         ;    Outputs:
                      (    forth6809.asm):01580         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01581         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01582         ;    Registers: only CC changed.
                      (    forth6809.asm):01583         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01584         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01585         ; ------------------------------------------------------------
                      (    forth6809.asm):01586         
DBF0 7F0176           (    forth6809.asm):01587         SERBUFCLR:  CLR   INHEAD
DBF3 7F0177           (    forth6809.asm):01588                     CLR   INTAIL
DBF6 7F0178           (    forth6809.asm):01589                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
DBF9 7F0179           (    forth6809.asm):01590                     CLR   OUTHEAD
DBFC 7F017A           (    forth6809.asm):01591                     CLR   OUTTAIL
DBFF 7F017B           (    forth6809.asm):01592                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01593         
                      (    forth6809.asm):01594         
DC02 7F017C           (    forth6809.asm):01595                     CLR   FECOUNT

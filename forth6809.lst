                      (    forth6809.asm):02272         
                      (    forth6809.asm):02273                     INCB                  ; Update tail pointer to next character slot.
                      (    forth6809.asm):02274                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02275                     STB   OUTTAIL

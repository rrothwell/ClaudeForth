                      (    forth6809.asm):02495         
                      (    forth6809.asm):02496                    LDD  #TSTGUARD
                      (    forth6809.asm):02497                    PSHU D
                      (    forth6809.asm):02498                    LDD  #TSTVAL1
                      (    forth6809.asm):02499                    PSHU D
                      (    forth6809.asm):02500                    LDD  #TSTVAL2
                      (    forth6809.asm):02501                    PSHU D
                      (    forth6809.asm):02502                    STU  TSTUB4
                      (    forth6809.asm):02503         
                      (    forth6809.asm):02504                    JSR  TWOTOR
                      (    forth6809.asm):02505         
                      (    forth6809.asm):02506                    STU  TSTUMID
                      (    forth6809.asm):02507         
                      (    forth6809.asm):02508                    LDD  TSTUB4
                      (    forth6809.asm):02509                    SUBD TSTUMID
                      (    forth6809.asm):02510                    CMPD #-4
                      (    forth6809.asm):02511                    BNE  T2RFAIL
                      (    forth6809.asm):02512         
                      (    forth6809.asm):02513                    JSR  TWOFROMR
                      (    forth6809.asm):02514         
                      (    forth6809.asm):02515                    STU  TSTUAF
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517                    PULU D
                      (    forth6809.asm):02518                    CMPD #TSTVAL2
                      (    forth6809.asm):02519                    BNE  T2RFAIL
                      (    forth6809.asm):02520                    PULU D
                      (    forth6809.asm):02521                    CMPD #TSTVAL1
                      (    forth6809.asm):02522                    BNE  T2RFAIL
                      (    forth6809.asm):02523                    PULU D
                      (    forth6809.asm):02524                    CMPD #TSTGUARD
                      (    forth6809.asm):02525                    BNE  T2RFAIL
                      (    forth6809.asm):02526         
                      (    forth6809.asm):02527                    LDD  TSTUB4
                      (    forth6809.asm):02528                    SUBD TSTUAF
                      (    forth6809.asm):02529                    CMPD #0
                      (    forth6809.asm):02530                    BNE  T2RFAIL
                      (    forth6809.asm):02531         
                      (    forth6809.asm):02532                    LDD  #TRUEV
                      (    forth6809.asm):02533                    BRA  T2RDONE
C3E4                  (    forth6809.asm):02534         T2RFAIL:   LDD  #FALSEV
C3E4                  (    forth6809.asm):02535         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02536                    PSHU X
                      (    forth6809.asm):02537                    PSHU D
                      (    forth6809.asm):02538                    JSR  TSTREPORT
                      (    forth6809.asm):02539         
                      (    forth6809.asm):02540                    LDU  TSTU0
                      (    forth6809.asm):02541                    RTS
                      (    forth6809.asm):02542         
C3E4                  (    forth6809.asm):02543         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02544                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546         ; ------------------------------------------------------------
                      (    forth6809.asm):02547         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02548         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02549         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02550         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02551         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02552         ; ------------------------------------------------------------

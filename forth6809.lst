                      (    forth6809.asm):04249         ; UNLOOP  ( -- )
                      (    forth6809.asm):04250         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):04251         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):04252         ; ------------------------------------------------------------

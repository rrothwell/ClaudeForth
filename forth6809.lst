                      (    forth6809.asm):09962         
                      (    forth6809.asm):09963                     PULU D
                      (    forth6809.asm):09964                     CMPD #TSTVAL1
                      (    forth6809.asm):09965                     BNE  LIFAIL
                      (    forth6809.asm):09966                     PULU D
                      (    forth6809.asm):09967                     CMPD #TSTGUARD
                      (    forth6809.asm):09968                     BNE  LIFAIL
                      (    forth6809.asm):09969         
                      (    forth6809.asm):09970                     LDD  TSTUB4
                      (    forth6809.asm):09971                     SUBD TSTUAF
                      (    forth6809.asm):09972                     CMPD #2
                      (    forth6809.asm):09973                     BNE  LIFAIL
                      (    forth6809.asm):09974         

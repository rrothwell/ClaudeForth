                      (    forth6809.asm):03808         ;    Inputs:
                      (    forth6809.asm):03809         ;        none
                      (    forth6809.asm):03810         ;    Outputs:
                      (    forth6809.asm):03811         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03812         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03813         ; ------------------------------------------------------------

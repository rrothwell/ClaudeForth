                      (    forth6809.asm):07841                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):07842         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07843                  ORCC  #$50        ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):07844                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07845                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07846                  CLRA
FFAE 1F8B             (    forth6809.asm):07847                  TFR   A,DP
                      (    forth6809.asm):07848         
FFB0 8E0000           (    forth6809.asm):07849                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07850                  LDB   #0
FFB5 6F80             (    forth6809.asm):07851         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07852                  DECB
FFB8 26FB             (    forth6809.asm):07853                  BNE   CLRGLOB
                      (    forth6809.asm):07854         
FFBA BDDD65           (    forth6809.asm):07855                  JSR   INITSERIAL
                      (    forth6809.asm):07856         
FFBD 1CAF             (    forth6809.asm):07857                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):07858         
                      (    forth6809.asm):07859                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07860                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07861                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07862                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07863                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07864                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07865                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07866                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07867                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07868                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07869                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07870                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07871                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07872                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07873                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07874                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07875                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07876                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07877                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07878                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07879                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07880                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07881                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07882                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07883                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07884                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07885                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07886                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07887                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07888                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07889                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07890                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07891                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07892                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07893                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07894                                  ; unused vectors).
                      (    forth6809.asm):07895         
                      (    forth6809.asm):07896                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07897                  JSR   TSTRUNNER
                      (    forth6809.asm):07898                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07899                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07900                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07901                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07902                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07903                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07904                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07905                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07906                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07907                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07908                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07909                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07910                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07911                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07912                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07913                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07914                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07915         
FFC2 7EDD82           (    forth6809.asm):07916                  JMP   COLD
                      (    forth6809.asm):07917         
FFC5 1A50             (    forth6809.asm):07918         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):07919                  CLRA
FFC8 1F8B             (    forth6809.asm):07920                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07921                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07922                  LDS   #RP0
                      (    forth6809.asm):07923         
FFD1 BDDD65           (    forth6809.asm):07924                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07925                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07926                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07927                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07928                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07929                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07930                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07931                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07932                                         ; reported separately) left either side
                      (    forth6809.asm):07933                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07934                                         ; would previously have inherited it
                      (    forth6809.asm):07935                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07936                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07937                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07938                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07939                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07940                                         ; only once setup is complete.
                      (    forth6809.asm):07941         
FFD4 8EFFE6           (    forth6809.asm):07942                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):07943                  PSHU  X
FFD9 CC0006           (    forth6809.asm):07944                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):07945                  PSHU  D

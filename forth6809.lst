                      (    forth6809.asm):11057                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):11058                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):11059                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):11060                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):11061                                      ; matching "always increment" rather than
                      (    forth6809.asm):11062                                      ; "increment only on genuine carry".

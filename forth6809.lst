                      (    forth6809.asm):09857                   LDD  #TSTNAMEB
                      (    forth6809.asm):09858                   STD  SRCADDR
                      (    forth6809.asm):09859                   LDD  #3
                      (    forth6809.asm):09860                   STD  SRCLEN
                      (    forth6809.asm):09861                   LDD  #0
                      (    forth6809.asm):09862                   STD  TOIN
                      (    forth6809.asm):09863         
                      (    forth6809.asm):09864                   STU  TSTU0
                      (    forth6809.asm):09865         
                      (    forth6809.asm):09866                   LDX  #TICK
                      (    forth6809.asm):09867                   PSHU X
                      (    forth6809.asm):09868                   STU  TSTUB4
                      (    forth6809.asm):09869         

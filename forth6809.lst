D8F3 DD0C             (    forth6809.asm):04731                     STD   HANDLER
                      (    forth6809.asm):04732         
D8F5 AD84             (    forth6809.asm):04733                     JSR   ,X
                      (    forth6809.asm):04734         
D8F7 3268             (    forth6809.asm):04735                     LEAS  8,S               ; drop saved input source
D8F9 3262             (    forth6809.asm):04736                     LEAS  2,S               ; saved U
D8FB 3506             (    forth6809.asm):04737                     PULS  D

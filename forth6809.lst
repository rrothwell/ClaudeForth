                      (    forth6809.asm):02998         ; INTERPRET  ( -- )
                      (    forth6809.asm):02999         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03000         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03001         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03002         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03003         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03004         ; ------------------------------------------------------------

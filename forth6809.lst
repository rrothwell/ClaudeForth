                      (    forth6809.asm):03559                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03560                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03561                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03562                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03563                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03564                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03565                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03566                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03567                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03568                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03569                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03570                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03571                  ; for it.

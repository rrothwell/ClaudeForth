                      (    forth6809.asm):16203         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):16204         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):16205         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):16206         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):16207         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):16208         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):16209         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):16210         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):16211         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):16212         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):16213         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):16214         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):16215                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):16216                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):16217                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):16218                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):16219                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):16220                  FDB   ABORT
                      (    forth6809.asm):16221         
DEBE 04               (    forth6809.asm):16222         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):16223                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):16224                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):16225                  FDB   QUIT
                      (    forth6809.asm):16226         
                      (    forth6809.asm):16227         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):16228         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):16229         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):16230         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):16231         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):16232         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):16233         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):16234                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):16235                  FDB   H_QUIT
DECE E476             (    forth6809.asm):16236                  FDB   FIND
                      (    forth6809.asm):16237         
DED0 01               (    forth6809.asm):16238         H_1:     FCB   1
DED1 31               (    forth6809.asm):16239                  FCC   "1"
DED2 DEC7             (    forth6809.asm):16240                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):16241                  FDB   ONEBODY
                      (    forth6809.asm):16242         
DED6 02               (    forth6809.asm):16243         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):16244                  FCC   "-1"
DED9 DED0             (    forth6809.asm):16245                  FDB   H_1
DEDB FF49             (    forth6809.asm):16246                  FDB   MONEBODY
                      (    forth6809.asm):16247         
DEDD 01               (    forth6809.asm):16248         H_2:     FCB   1
DEDE 32               (    forth6809.asm):16249                  FCC   "2"
DEDF DED6             (    forth6809.asm):16250                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):16251                  FDB   TWOBODY
                      (    forth6809.asm):16252         
DEE3 02               (    forth6809.asm):16253         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):16254                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):16255                  FDB   H_2
DEE8 FF55             (    forth6809.asm):16256                  FDB   MTWOBODY
                      (    forth6809.asm):16257         
     DEE3             (    forth6809.asm):16258         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):16259                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):16260                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):16261                                   ; were chained on after it; before that,
                      (    forth6809.asm):16262                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):16263                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):16264                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):16265                                   ; before this one.
                      (    forth6809.asm):16266         
                      (    forth6809.asm):16267         ; Verify no collision with base code.
                      (    forth6809.asm):16268         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):16269         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):16270         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):16271         
                      (    forth6809.asm):16272         ; ============================================================
                      (    forth6809.asm):16273         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):16274         ; ============================================================
                      (    forth6809.asm):16275                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):16276                                        ; entirely - every routine from here through
                      (    forth6809.asm):16277                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):16278                                        ; every primitive) would otherwise have
                      (    forth6809.asm):16279                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):16280                                        ; WARM message left the location counter,
                      (    forth6809.asm):16281                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):16282                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):16283                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):16284         
                      (    forth6809.asm):16285         ; ------------------------------------------------------------
                      (    forth6809.asm):16286         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):16287         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):16288         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):16289         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):16290         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):16291         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):16292         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):16293                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):16294                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):16295                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):16296                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):16297                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):16298                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):16299                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):16300                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):16301                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):16302                  RTS
                      (    forth6809.asm):16303         
                      (    forth6809.asm):16304                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):16305         ; ------------------------------------------------------------
                      (    forth6809.asm):16306         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):16307         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):16308         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):16309         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):16310         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16311         INFILL:  LDA   INHEAD
                      (    forth6809.asm):16312                  SUBA  INTAIL
                      (    forth6809.asm):16313                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):16314                  RTS
                      (    forth6809.asm):16315         
                      (    forth6809.asm):16316         ; ------------------------------------------------------------
                      (    forth6809.asm):16317         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):16318         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):16319         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):16320         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):16321         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):16322         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):16323         ; flow control, not a chip feature.
                      (    forth6809.asm):16324         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16325         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):16326                     CMPA #INHIWATER
                      (    forth6809.asm):16327                     BLO  RTSCHIDONE
                      (    forth6809.asm):16328                     TST  RTSSTATE
                      (    forth6809.asm):16329                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):16330                     LDA  #CR_RTSHI
                      (    forth6809.asm):16331                     STA  ACIACR
                      (    forth6809.asm):16332                     LDA  #1
                      (    forth6809.asm):16333                     STA  RTSSTATE
DEF5                  (    forth6809.asm):16334         RTSCHIDONE: RTS
                      (    forth6809.asm):16335         
                      (    forth6809.asm):16336         ; ------------------------------------------------------------
                      (    forth6809.asm):16337         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):16338         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):16339         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):16340         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):16341         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):16342         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):16343         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):16344         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):16345         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):16346         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16347         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):16348                     CMPA #INLOWATER
                      (    forth6809.asm):16349                     BHI  RTSCLODONE
                      (    forth6809.asm):16350                     TST  RTSSTATE
                      (    forth6809.asm):16351                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):16352                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):16353                     CLR  RTSSTATE
                      (    forth6809.asm):16354                     LDB  OUTTAIL
                      (    forth6809.asm):16355                     CMPB OUTHEAD
                      (    forth6809.asm):16356                     BEQ  RTSCLONOTX
                      (    forth6809.asm):16357                     LDA  #CR_RXTX
                      (    forth6809.asm):16358                     STA  ACIACR
                      (    forth6809.asm):16359                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):16360         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):16361                     STA  ACIACR

                      (    forth6809.asm):02099         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02100         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02101         ; LIT   ( -- x )
                      (    forth6809.asm):02102         ;    Inputs:
                      (    forth6809.asm):02103         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02104         ;    Outputs:
                      (    forth6809.asm):02105         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02106         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02107         ; ------------------------------------------------------------
DF67 3510             (    forth6809.asm):02108         LIT:        PULS  X
DF69 EC81             (    forth6809.asm):02109                     LDD   ,X++
DF6B 3606             (    forth6809.asm):02110                     PSHU  D                 ; x
DF6D 3410             (    forth6809.asm):02111                     PSHS  X
DF6F 39               (    forth6809.asm):02112                     RTS
                      (    forth6809.asm):02113         
                      (    forth6809.asm):02114         ; ------------------------------------------------------------
                      (    forth6809.asm):02115         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02116         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02117         ; address.
                      (    forth6809.asm):02118         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02119         ;    Inputs:
                      (    forth6809.asm):02120         ;        flag on the data stack
                      (    forth6809.asm):02121         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02122         ;    Outputs:
                      (    forth6809.asm):02123         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02124         ;        the offset
                      (    forth6809.asm):02125         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02126         ; ------------------------------------------------------------
DF70 3706             (    forth6809.asm):02127         ZBRANCH:    PULU  D                 ; flag
DF72 3510             (    forth6809.asm):02128                     PULS  X
DF74 10830000         (    forth6809.asm):02129                     CMPD  #0
DF78 2607             (    forth6809.asm):02130                     BNE   ZSKIP
DF7A EC84             (    forth6809.asm):02131                     LDD   ,X
DF7C 308B             (    forth6809.asm):02132                     LEAX  D,X
DF7E 3410             (    forth6809.asm):02133                     PSHS  X
DF80 39               (    forth6809.asm):02134                     RTS
DF81 3002             (    forth6809.asm):02135         ZSKIP:      LEAX  2,X
DF83 3410             (    forth6809.asm):02136                     PSHS  X
DF85 39               (    forth6809.asm):02137                     RTS
                      (    forth6809.asm):02138         
                      (    forth6809.asm):02139         ; ------------------------------------------------------------
                      (    forth6809.asm):02140         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02141         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02142         ; BRANCH
                      (    forth6809.asm):02143         ;    Inputs:
                      (    forth6809.asm):02144         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02145         ;    Outputs:
                      (    forth6809.asm):02146         ;        return address set to the branch target
                      (    forth6809.asm):02147         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02148         ; ------------------------------------------------------------
DF86 3510             (    forth6809.asm):02149         BRANCH:     PULS  X
DF88 EC84             (    forth6809.asm):02150                     LDD   ,X
DF8A 308B             (    forth6809.asm):02151                     LEAX  D,X
DF8C 3410             (    forth6809.asm):02152                     PSHS  X
DF8E 39               (    forth6809.asm):02153                     RTS
                      (    forth6809.asm):02154         
                      (    forth6809.asm):02155         ; ------------------------------------------------------------
                      (    forth6809.asm):02156         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02157         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02158         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02159         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02160         ;    Inputs:
                      (    forth6809.asm):02161         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02162         ;        trampoline
                      (    forth6809.asm):02163         ;    Outputs:
                      (    forth6809.asm):02164         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02165         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02166         ; ------------------------------------------------------------
DF8F 3510             (    forth6809.asm):02167         DODOES:     PULS  X
DF91 10AE81           (    forth6809.asm):02168                     LDY   ,X++
DF94 EC84             (    forth6809.asm):02169                     LDD   ,X
DF96 3606             (    forth6809.asm):02170                     PSHU  D                 ; pfa
DF98 6EA4             (    forth6809.asm):02171                     JMP   ,Y
                      (    forth6809.asm):02172         
                      (    forth6809.asm):02173         ; ------------------------------------------------------------
                      (    forth6809.asm):02174         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02175         ; field address on the stack.
                      (    forth6809.asm):02176         ; DOESRT0
                      (    forth6809.asm):02177         ;    Inputs:
                      (    forth6809.asm):02178         ;        none
                      (    forth6809.asm):02179         ;    Outputs:
                      (    forth6809.asm):02180         ;        none
                      (    forth6809.asm):02181         ;    Registers: none.
                      (    forth6809.asm):02182         ; ------------------------------------------------------------
DF9A 39               (    forth6809.asm):02183         DOESRT0:    RTS
                      (    forth6809.asm):02184         
                      (    forth6809.asm):02185         ; ------------------------------------------------------------
                      (    forth6809.asm):02186         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02187         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02188         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02189         ; SETDOES
                      (    forth6809.asm):02190         ;    Inputs:
                      (    forth6809.asm):02191         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02192         ;        BEHAVIOR)
                      (    forth6809.asm):02193         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02194         ;        address
                      (    forth6809.asm):02195         ;    Outputs:
                      (    forth6809.asm):02196         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02197         ;        defining word's caller
                      (    forth6809.asm):02198         ;    Registers: RegD, RegX, RegY, CC and HDRFLAGS changed.
                      (    forth6809.asm):02199         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):02200         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF9D 1F12             (    forth6809.asm):02201                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02202         
DF9F 9E04             (    forth6809.asm):02203                     LDX   LATEST
DFA1 A684             (    forth6809.asm):02204                     LDA   ,X
DFA3 971B             (    forth6809.asm):02205                     STA   HDRFLAGS
DFA5 3001             (    forth6809.asm):02206                     LEAX  1,X
DFA7 D61B             (    forth6809.asm):02207                     LDB   HDRFLAGS
DFA9 C41F             (    forth6809.asm):02208                     ANDB  #$1F
DFAB 4F               (    forth6809.asm):02209                     CLRA
DFAC 308B             (    forth6809.asm):02210                     LEAX  D,X               ; skip name -> LINK field
DFAE 3002             (    forth6809.asm):02211                     LEAX  2,X               ; skip LINK -> CFA field
DFB0 EC84             (    forth6809.asm):02212                     LDD   ,X                ; D = CFA (trampoline address)
DFB2 C30003           (    forth6809.asm):02213                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFB5 1F01             (    forth6809.asm):02214                     TFR   D,X
                      (    forth6809.asm):02215         
DFB7 10AF84           (    forth6809.asm):02216                     STY   ,X                ; patch it
                      (    forth6809.asm):02217         
DFBA 3510             (    forth6809.asm):02218                     PULS  X                 ; X = the OUTER defining word's own return addr
DFBC 6E84             (    forth6809.asm):02219                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02220         
                      (    forth6809.asm):02221         ; ------------------------------------------------------------
                      (    forth6809.asm):02222         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02223         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02224         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02225         ;    Inputs:
                      (    forth6809.asm):02226         ;        pfa on the data stack
                      (    forth6809.asm):02227         ;    Outputs:
                      (    forth6809.asm):02228         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02229         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
DFBE 3710             (    forth6809.asm):02231         DODEFER:    PULU  X                 ; pfa
DFC0 EC84             (    forth6809.asm):02232                     LDD   ,X
DFC2 1F01             (    forth6809.asm):02233                     TFR   D,X
DFC4 6E84             (    forth6809.asm):02234                     JMP   ,X
                      (    forth6809.asm):02235         
                      (    forth6809.asm):02236         ; ------------------------------------------------------------
                      (    forth6809.asm):02237         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02238         ; DOABORTUNDEF
                      (    forth6809.asm):02239         ;    Inputs:
                      (    forth6809.asm):02240         ;        none
                      (    forth6809.asm):02241         ;    Outputs:
                      (    forth6809.asm):02242         ;        none (does not return)
                      (    forth6809.asm):02243         ;    Registers: RegD changed.
                      (    forth6809.asm):02244         ; ------------------------------------------------------------
DFC6                  (    forth6809.asm):02245         DOABORTUNDEF:
DFC6 CCFFEB           (    forth6809.asm):02246                     LDD   #-21
DFC9 3606             (    forth6809.asm):02247                     PSHU  D                 ; throw code (-21)
DFCB 7EE63E           (    forth6809.asm):02248                     JMP   THROWW
                      (    forth6809.asm):02249         
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
                      (    forth6809.asm):02251         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02252         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02253         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02254         ;    Inputs:
                      (    forth6809.asm):02255         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02256         ;    Outputs:
                      (    forth6809.asm):02257         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02258         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02259         ; ------------------------------------------------------------
DFCE 3710             (    forth6809.asm):02260         DOMARKER:   PULU  X                 ; pfa
DFD0 EC84             (    forth6809.asm):02261                     LDD   ,X
DFD2 DD06             (    forth6809.asm):02262                     STD   DPHERE
DFD4 EC02             (    forth6809.asm):02263                     LDD   2,X
DFD6 DD08             (    forth6809.asm):02264                     STD   CODEHERE
DFD8 EC04             (    forth6809.asm):02265                     LDD   4,X
DFDA DD0A             (    forth6809.asm):02266                     STD   VARHERE
DFDC EC06             (    forth6809.asm):02267                     LDD   6,X
DFDE DD04             (    forth6809.asm):02268                     STD   LATEST
DFE0 39               (    forth6809.asm):02269                     RTS
                      (    forth6809.asm):02270         
                      (    forth6809.asm):02271         ; ------------------------------------------------------------
                      (    forth6809.asm):02272         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02273         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02274         ; ------------------------------------------------------------
DFE1 3710             (    forth6809.asm):02275         EXECUTEW:   PULU  X                 ; xt
DFE3 AD84             (    forth6809.asm):02276                     JSR   ,X
DFE5 39               (    forth6809.asm):02277                     RTS
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279         ; ============================================================
                      (    forth6809.asm):02280         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02281         ; ============================================================
                      (    forth6809.asm):02282         ; ------------------------------------------------------------
                      (    forth6809.asm):02283         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02284         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02285         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02286         ;    Inputs:
                      (    forth6809.asm):02287         ;        RegX = address of the here pointer
                      (    forth6809.asm):02288         ;        x on the data stack
                      (    forth6809.asm):02289         ;    Outputs:
                      (    forth6809.asm):02290         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02291         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02292         ; ------------------------------------------------------------
DFE6 3706             (    forth6809.asm):02293         APPENDCELL: PULU  D                 ; x
DFE8 10AE84           (    forth6809.asm):02294                     LDY   ,X
DFEB EDA1             (    forth6809.asm):02295                     STD   ,Y++
DFED 10AF84           (    forth6809.asm):02296                     STY   ,X
DFF0 39               (    forth6809.asm):02297                     RTS
                      (    forth6809.asm):02298         
                      (    forth6809.asm):02299         ; ------------------------------------------------------------
                      (    forth6809.asm):02300         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02301         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02302         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02303         ;    Inputs:
                      (    forth6809.asm):02304         ;        RegX = address of the here pointer
                      (    forth6809.asm):02305         ;        char on the data stack
                      (    forth6809.asm):02306         ;    Outputs:
                      (    forth6809.asm):02307         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02308         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02309         ; ------------------------------------------------------------
DFF1 3706             (    forth6809.asm):02310         APPENDBYTE: PULU  D                 ; char
DFF3 10AE84           (    forth6809.asm):02311                     LDY   ,X
DFF6 E7A0             (    forth6809.asm):02312                     STB   ,Y+
DFF8 10AF84           (    forth6809.asm):02313                     STY   ,X
DFFB 39               (    forth6809.asm):02314                     RTS
                      (    forth6809.asm):02315         
                      (    forth6809.asm):02316         ; ------------------------------------------------------------
                      (    forth6809.asm):02317         ; ,  ( x -- )
                      (    forth6809.asm):02318         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02319         ; ------------------------------------------------------------
DFFC 8E0008           (    forth6809.asm):02320         COMMAW:     LDX   #CODEHERE
DFFF 7EDFE6           (    forth6809.asm):02321                     JMP   APPENDCELL
                      (    forth6809.asm):02322         
                      (    forth6809.asm):02323         ; ------------------------------------------------------------
                      (    forth6809.asm):02324         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02325         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02326         ; ------------------------------------------------------------
E002 8E0008           (    forth6809.asm):02327         CODECOMMA:  LDX   #CODEHERE
E005 7EDFE6           (    forth6809.asm):02328                     JMP   APPENDCELL
                      (    forth6809.asm):02329         
                      (    forth6809.asm):02330         ; ------------------------------------------------------------
                      (    forth6809.asm):02331         ; C,  ( char -- )
                      (    forth6809.asm):02332         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02333         ; ------------------------------------------------------------
E008 8E0008           (    forth6809.asm):02334         CCOMMAW:    LDX   #CODEHERE
E00B 7EDFF1           (    forth6809.asm):02335                     JMP   APPENDBYTE
                      (    forth6809.asm):02336         
                      (    forth6809.asm):02337         ; ------------------------------------------------------------
                      (    forth6809.asm):02338         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02339         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02340         ; ------------------------------------------------------------
E00E 8E0008           (    forth6809.asm):02341         CCOMMA1:    LDX   #CODEHERE
E011 7EDFF1           (    forth6809.asm):02342                     JMP   APPENDBYTE
                      (    forth6809.asm):02343         
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; V,  ( x -- )
                      (    forth6809.asm):02346         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02347         ; ------------------------------------------------------------
E014 8E000A           (    forth6809.asm):02348         VCOMMAW:    LDX   #VARHERE
E017 7EDFE6           (    forth6809.asm):02349                     JMP   APPENDCELL
                      (    forth6809.asm):02350         
                      (    forth6809.asm):02351         ; ------------------------------------------------------------
                      (    forth6809.asm):02352         ; VC,  ( char -- )
                      (    forth6809.asm):02353         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02354         ; ------------------------------------------------------------
E01A 8E000A           (    forth6809.asm):02355         VCCOMMAW:   LDX   #VARHERE
E01D 7EDFF1           (    forth6809.asm):02356                     JMP   APPENDBYTE
                      (    forth6809.asm):02357         
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
                      (    forth6809.asm):02359         ; ALLOT  ( n -- )
                      (    forth6809.asm):02360         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02361         ; ------------------------------------------------------------
E020 3706             (    forth6809.asm):02362         ALLOTW:     PULU  D                 ; n
E022 9E08             (    forth6809.asm):02363                     LDX   CODEHERE
E024 308B             (    forth6809.asm):02364                     LEAX  D,X
E026 9F08             (    forth6809.asm):02365                     STX   CODEHERE
E028 39               (    forth6809.asm):02366                     RTS
                      (    forth6809.asm):02367         
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
                      (    forth6809.asm):02369         ; VALLOT  ( n -- )
                      (    forth6809.asm):02370         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02371         ; ------------------------------------------------------------
E029 3706             (    forth6809.asm):02372         VALLOTW:    PULU  D                 ; n
E02B 9E0A             (    forth6809.asm):02373                     LDX   VARHERE
E02D 308B             (    forth6809.asm):02374                     LEAX  D,X
E02F 9F0A             (    forth6809.asm):02375                     STX   VARHERE
E031 39               (    forth6809.asm):02376                     RTS
                      (    forth6809.asm):02377         
                      (    forth6809.asm):02378         ; ------------------------------------------------------------
                      (    forth6809.asm):02379         ; HERE  ( -- addr )
                      (    forth6809.asm):02380         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02381         ; ------------------------------------------------------------
E032 DC08             (    forth6809.asm):02382         HEREW:      LDD   CODEHERE
E034 3606             (    forth6809.asm):02383                     PSHU  D                 ; addr
E036 39               (    forth6809.asm):02384                     RTS
                      (    forth6809.asm):02385         
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; VHERE  ( -- addr )
                      (    forth6809.asm):02388         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
E037 DC0A             (    forth6809.asm):02390         VHEREW:     LDD   VARHERE
E039 3606             (    forth6809.asm):02391                     PSHU  D                 ; addr
E03B 39               (    forth6809.asm):02392                     RTS
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
                      (    forth6809.asm):02395         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02396         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02397         ; ------------------------------------------------------------
E03C DC08             (    forth6809.asm):02398         PADW:       LDD   CODEHERE
E03E C30080           (    forth6809.asm):02399                     ADDD  #PADOFFSET
E041 3606             (    forth6809.asm):02400                     PSHU  D                 ; c-addr
E043 39               (    forth6809.asm):02401                     RTS
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403         ; ------------------------------------------------------------
                      (    forth6809.asm):02404         ; UNUSED  ( -- u )
                      (    forth6809.asm):02405         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
E044 CCB900           (    forth6809.asm):02407         UNUSEDW:    LDD   #CODETOP
E047 9308             (    forth6809.asm):02408                     SUBD  CODEHERE
E049 3606             (    forth6809.asm):02409                     PSHU  D                 ; u
E04B 39               (    forth6809.asm):02410                     RTS
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
                      (    forth6809.asm):02413         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02414         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02415         ; ------------------------------------------------------------
E04C CC1FFF           (    forth6809.asm):02416         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E04F 930A             (    forth6809.asm):02417                     SUBD  VARHERE
E051 3606             (    forth6809.asm):02418                     PSHU  D                 ; u
E053 39               (    forth6809.asm):02419                     RTS
                      (    forth6809.asm):02420         
                      (    forth6809.asm):02421         ; ============================================================
                      (    forth6809.asm):02422         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02423         ; ============================================================
                      (    forth6809.asm):02424         ; ------------------------------------------------------------
                      (    forth6809.asm):02425         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02426         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02427         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02428         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02429         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02430         ;    Inputs:
                      (    forth6809.asm):02431         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02432         ;        name parsed from the input stream
                      (    forth6809.asm):02433         ;    Outputs:
                      (    forth6809.asm):02434         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02435         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
E054 CC0020           (    forth6809.asm):02437         HEADER:     LDD   #32
E057 3606             (    forth6809.asm):02438                     PSHU  D
E059 BDE345           (    forth6809.asm):02439                     JSR   WORDW
E05C 3710             (    forth6809.asm):02440                     PULU  X                 ; c-addr of the name
E05E 3706             (    forth6809.asm):02441                     PULU  D                 ; smudge flag in B
E060 A680             (    forth6809.asm):02442                     LDA   ,X+               ; name length, X = name text
E062 3402             (    forth6809.asm):02443                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
E064 5D               (    forth6809.asm):02444                     TSTB
E065 2702             (    forth6809.asm):02445                     BEQ   HDNOSM
E067 8A40             (    forth6809.asm):02446                     ORA   #$40
E069 109E06           (    forth6809.asm):02447         HDNOSM:     LDY   DPHERE
E06C 3420             (    forth6809.asm):02448                     PSHS  Y                 ; 0,S = address of the new header
E06E A7A0             (    forth6809.asm):02449                     STA   ,Y+
E070 E662             (    forth6809.asm):02450                     LDB   2,S
E072 2707             (    forth6809.asm):02451                     BEQ   HDNONM
E074 A680             (    forth6809.asm):02452         HDCPY:      LDA   ,X+
E076 A7A0             (    forth6809.asm):02453                     STA   ,Y+
E078 5A               (    forth6809.asm):02454                     DECB
E079 26F9             (    forth6809.asm):02455                     BNE   HDCPY
E07B DC04             (    forth6809.asm):02456         HDNONM:     LDD   LATEST
E07D EDA1             (    forth6809.asm):02457                     STD   ,Y++
E07F DC08             (    forth6809.asm):02458                     LDD   CODEHERE
E081 EDA1             (    forth6809.asm):02459                     STD   ,Y++
E083 109F06           (    forth6809.asm):02460                     STY   DPHERE
E086 3506             (    forth6809.asm):02461                     PULS  D
E088 DD04             (    forth6809.asm):02462                     STD   LATEST
E08A 3261             (    forth6809.asm):02463                     LEAS  1,S
E08C 39               (    forth6809.asm):02464                     RTS
                      (    forth6809.asm):02465         
                      (    forth6809.asm):02466         ; ============================================================
                      (    forth6809.asm):02467         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02468         ; ============================================================
                      (    forth6809.asm):02469         ; ------------------------------------------------------------
                      (    forth6809.asm):02470         ; :  ( "name" -- )
                      (    forth6809.asm):02471         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02472         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02473         ; CSP and enter compile state.
                      (    forth6809.asm):02474         ; ------------------------------------------------------------
E08D CCFFFF           (    forth6809.asm):02475         COLONW:     LDD   #TRUEV
E090 3606             (    forth6809.asm):02476                     PSHU  D
E092 BDE054           (    forth6809.asm):02477                     JSR   HEADER
E095 DC08             (    forth6809.asm):02478                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E097 DD31             (    forth6809.asm):02479                     STD   CURXT             ; See bugfix: COLONW.1
E099 1F30             (    forth6809.asm):02480                     TFR   U,D
E09B DD33             (    forth6809.asm):02481                     STD   CSP
E09D CCFFFF           (    forth6809.asm):02482                     LDD   #-1
E0A0 DD00             (    forth6809.asm):02483                     STD   STATE
E0A2 39               (    forth6809.asm):02484                     RTS
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486         ; ------------------------------------------------------------
                      (    forth6809.asm):02487         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02488         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02489         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02490         ; new word and return to interpret state.
                      (    forth6809.asm):02491         ; ------------------------------------------------------------
E0A3 CC0039           (    forth6809.asm):02492         SEMIW:      LDD   #RTSOPC
E0A6 3606             (    forth6809.asm):02493                     PSHU  D
E0A8 BDE00E           (    forth6809.asm):02494                     JSR   CCOMMA1
E0AB 1F30             (    forth6809.asm):02495                     TFR   U,D
E0AD 109333           (    forth6809.asm):02496                     CMPD  CSP
E0B0 2703             (    forth6809.asm):02497                     BEQ   SEMIOK
E0B2 BDE609           (    forth6809.asm):02498                     JSR   CFERR
E0B5 9E04             (    forth6809.asm):02499         SEMIOK:     LDX   LATEST
E0B7 A684             (    forth6809.asm):02500                     LDA   ,X
E0B9 84BF             (    forth6809.asm):02501                     ANDA  #$BF
E0BB A784             (    forth6809.asm):02502                     STA   ,X
E0BD CC0000           (    forth6809.asm):02503                     LDD   #0
E0C0 DD00             (    forth6809.asm):02504                     STD   STATE
E0C2 39               (    forth6809.asm):02505                     RTS
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507         ; ------------------------------------------------------------
                      (    forth6809.asm):02508         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02509         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02510         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02511         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02512         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02513         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02514         ; ------------------------------------------------------------
E0C3 DC08             (    forth6809.asm):02515         NONAMEW:    LDD   CODEHERE
E0C5 3606             (    forth6809.asm):02516                     PSHU  D                 ; xt
E0C7 DD31             (    forth6809.asm):02517                     STD   CURXT             ; See bugfix: NONAMEW.1
E0C9 1F30             (    forth6809.asm):02518                     TFR   U,D
E0CB DD33             (    forth6809.asm):02519                     STD   CSP
E0CD CCFFFF           (    forth6809.asm):02520                     LDD   #-1
E0D0 DD00             (    forth6809.asm):02521                     STD   STATE
E0D2 39               (    forth6809.asm):02522                     RTS
                      (    forth6809.asm):02523         
                      (    forth6809.asm):02524         ; ------------------------------------------------------------
                      (    forth6809.asm):02525         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02526         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02527         ; BLDDOES
                      (    forth6809.asm):02528         ;    Inputs:
                      (    forth6809.asm):02529         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02530         ;    Outputs:
                      (    forth6809.asm):02531         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02532         ;    Registers: all changed.
                      (    forth6809.asm):02533         ; BLDSELF
                      (    forth6809.asm):02534         ;    Inputs:
                      (    forth6809.asm):02535         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02536         ;    Outputs:
                      (    forth6809.asm):02537         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02538         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02539         ;    Registers: all changed.
                      (    forth6809.asm):02540         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02541         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
E0D3 3406             (    forth6809.asm):02543         BLDDOES:    PSHS  D                 ; behaviour address
E0D5 CC0000           (    forth6809.asm):02544                     LDD   #0
E0D8 3606             (    forth6809.asm):02545                     PSHU  D
E0DA BDE054           (    forth6809.asm):02546                     JSR   HEADER
E0DD CCDF8F           (    forth6809.asm):02547                     LDD   #DODOES
E0E0 3606             (    forth6809.asm):02548                     PSHU  D
E0E2 BDEA79           (    forth6809.asm):02549                     JSR   CCALL
E0E5 3506             (    forth6809.asm):02550                     PULS  D
E0E7 3606             (    forth6809.asm):02551                     PSHU  D                 ; behaviour address
E0E9 BDE002           (    forth6809.asm):02552                     JSR   CODECOMMA
E0EC 39               (    forth6809.asm):02553                     RTS
                      (    forth6809.asm):02554         
E0ED BDE0D3           (    forth6809.asm):02555         BLDSELF:    JSR   BLDDOES
E0F0 DC08             (    forth6809.asm):02556                     LDD   CODEHERE          ; PFA = the cell after this one
E0F2 C30002           (    forth6809.asm):02557                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0F5 3606             (    forth6809.asm):02558                     PSHU  D
E0F7 BDE002           (    forth6809.asm):02559                     JSR   CODECOMMA
E0FA 39               (    forth6809.asm):02560                     RTS
                      (    forth6809.asm):02561         
                      (    forth6809.asm):02562         ; ------------------------------------------------------------
                      (    forth6809.asm):02563         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02564         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02565         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02566         ; address in the code area, on the stack.
                      (    forth6809.asm):02567         ; ------------------------------------------------------------
E0FB CCDF9A           (    forth6809.asm):02568         CREATEW:    LDD   #DOESRT0
E0FE BDE0ED           (    forth6809.asm):02569                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E101 39               (    forth6809.asm):02570                     RTS
                      (    forth6809.asm):02571         
                      (    forth6809.asm):02572         ; ------------------------------------------------------------
                      (    forth6809.asm):02573         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02574         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02575         ; of the word being defined.
                      (    forth6809.asm):02576         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02577         ; ------------------------------------------------------------
E102 CCDF9B           (    forth6809.asm):02578         DOESGTW:    LDD   #SETDOES
E105 3606             (    forth6809.asm):02579                     PSHU  D
E107 BDEA79           (    forth6809.asm):02580                     JSR   CCALL
E10A 39               (    forth6809.asm):02581                     RTS
                      (    forth6809.asm):02582         
                      (    forth6809.asm):02583         ; ------------------------------------------------------------
                      (    forth6809.asm):02584         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02585         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02586         ; area, initialised to zero.
                      (    forth6809.asm):02587         ; ------------------------------------------------------------
E10B CC0000           (    forth6809.asm):02588         VARIABLEW:  LDD   #0
E10E 3606             (    forth6809.asm):02589                     PSHU  D
E110 BDE054           (    forth6809.asm):02590                     JSR   HEADER
E113 CCDF8F           (    forth6809.asm):02591                     LDD   #DODOES
E116 3606             (    forth6809.asm):02592                     PSHU  D
E118 BDEA79           (    forth6809.asm):02593                     JSR   CCALL
E11B CCDF9A           (    forth6809.asm):02594                     LDD   #DOESRT0
E11E 3606             (    forth6809.asm):02595                     PSHU  D
E120 BDE002           (    forth6809.asm):02596                     JSR   CODECOMMA
E123 DC0A             (    forth6809.asm):02597                     LDD   VARHERE
E125 3606             (    forth6809.asm):02598                     PSHU  D
E127 BDE002           (    forth6809.asm):02599                     JSR   CODECOMMA
E12A CC0000           (    forth6809.asm):02600                     LDD   #0
E12D 9E0A             (    forth6809.asm):02601                     LDX   VARHERE
E12F ED81             (    forth6809.asm):02602                     STD   ,X++
E131 9F0A             (    forth6809.asm):02603                     STX   VARHERE
E133 39               (    forth6809.asm):02604                     RTS
                      (    forth6809.asm):02605         
                      (    forth6809.asm):02606         ; ------------------------------------------------------------
                      (    forth6809.asm):02607         ; @  ( a-addr -- x )
                      (    forth6809.asm):02608         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02609         ; ------------------------------------------------------------
E134 3710             (    forth6809.asm):02610         FETCHW:     PULU  X                 ; a-addr
E136 EC84             (    forth6809.asm):02611                     LDD   ,X
E138 3606             (    forth6809.asm):02612                     PSHU  D                 ; x
E13A 39               (    forth6809.asm):02613                     RTS
                      (    forth6809.asm):02614         
                      (    forth6809.asm):02615         ; ------------------------------------------------------------
                      (    forth6809.asm):02616         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02617         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02618         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
E13B CCE134           (    forth6809.asm):02620         CONSTANTW:  LDD   #FETCHW
E13E BDE0ED           (    forth6809.asm):02621                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E141 BDDFFC           (    forth6809.asm):02622                     JSR   COMMAW
E144 39               (    forth6809.asm):02623                     RTS
                      (    forth6809.asm):02624         
                      (    forth6809.asm):02625         ; ------------------------------------------------------------
                      (    forth6809.asm):02626         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02627         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02628         ;    Inputs:
                      (    forth6809.asm):02629         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02630         ;    Outputs:
                      (    forth6809.asm):02631         ;        pfa replaced by the value
                      (    forth6809.asm):02632         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
E145 3710             (    forth6809.asm):02634         DOVALUE:    PULU  X                 ; pfa
E147 EC84             (    forth6809.asm):02635                     LDD   ,X
E149 3606             (    forth6809.asm):02636                     PSHU  D                 ; x
E14B 39               (    forth6809.asm):02637                     RTS
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ------------------------------------------------------------
                      (    forth6809.asm):02640         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02641         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02642         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
E14C CCE145           (    forth6809.asm):02644         VALUEW:     LDD   #DOVALUE
E14F BDE0D3           (    forth6809.asm):02645                     JSR   BLDDOES
E152 DC0A             (    forth6809.asm):02646                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E154 3606             (    forth6809.asm):02647                     PSHU  D                 ; See bugfix: VALUEW.1
E156 BDE002           (    forth6809.asm):02648                     JSR   CODECOMMA
E159 BDE014           (    forth6809.asm):02649                     JSR   VCOMMAW           ; store x in the variable area
E15C 39               (    forth6809.asm):02650                     RTS
                      (    forth6809.asm):02651         
                      (    forth6809.asm):02652         ; ------------------------------------------------------------
                      (    forth6809.asm):02653         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02654         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02655         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02656         ; ------------------------------------------------------------
E15D CC0020           (    forth6809.asm):02657         TOW:        LDD   #32
E160 3606             (    forth6809.asm):02658                     PSHU  D
E162 BDE345           (    forth6809.asm):02659                     JSR   WORDW
E165 BDE3B7           (    forth6809.asm):02660                     JSR   FINDW
E168 3706             (    forth6809.asm):02661                     PULU  D
E16A 10830000         (    forth6809.asm):02662                     CMPD  #0
E16E 260A             (    forth6809.asm):02663                     BNE   TOFOUND
E170 3706             (    forth6809.asm):02664                     PULU  D
E172 CCFFF3           (    forth6809.asm):02665                     LDD   #-13
E175 3606             (    forth6809.asm):02666                     PSHU  D
E177 BDE63E           (    forth6809.asm):02667                     JSR   THROWW
E17A BDEB2B           (    forth6809.asm):02668         TOFOUND:    JSR   TOBODYW
E17D DC00             (    forth6809.asm):02669                     LDD   STATE
E17F 270C             (    forth6809.asm):02670                     BEQ   TOIMMED
E181 BDEA86           (    forth6809.asm):02671                     JSR   LITERALW
E184 CCF326           (    forth6809.asm):02672                     LDD   #STOREW
E187 3606             (    forth6809.asm):02673                     PSHU  D
E189 BDEA79           (    forth6809.asm):02674                     JSR   CCALL
E18C 39               (    forth6809.asm):02675                     RTS
E18D 3710             (    forth6809.asm):02676         TOIMMED:    PULU  X                 ; a-addr of the value cell
E18F 3706             (    forth6809.asm):02677                     PULU  D                 ; x
E191 ED84             (    forth6809.asm):02678                     STD   ,X
E193 39               (    forth6809.asm):02679                     RTS
                      (    forth6809.asm):02680         
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
                      (    forth6809.asm):02682         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02683         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02684         ; the variable area, initialised to zero.
                      (    forth6809.asm):02685         ; ------------------------------------------------------------
E194                  (    forth6809.asm):02686         TWOVARIABLEW:
E194 CC0000           (    forth6809.asm):02687                     LDD   #0
E197 3606             (    forth6809.asm):02688                     PSHU  D
E199 BDE054           (    forth6809.asm):02689                     JSR   HEADER
E19C CCDF8F           (    forth6809.asm):02690                     LDD   #DODOES
E19F 3606             (    forth6809.asm):02691                     PSHU  D
E1A1 BDEA79           (    forth6809.asm):02692                     JSR   CCALL
E1A4 CCDF9A           (    forth6809.asm):02693                     LDD   #DOESRT0
E1A7 3606             (    forth6809.asm):02694                     PSHU  D
E1A9 BDE002           (    forth6809.asm):02695                     JSR   CODECOMMA
E1AC DC0A             (    forth6809.asm):02696                     LDD   VARHERE
E1AE 3606             (    forth6809.asm):02697                     PSHU  D
E1B0 BDE002           (    forth6809.asm):02698                     JSR   CODECOMMA
E1B3 CC0000           (    forth6809.asm):02699                     LDD   #0
E1B6 9E0A             (    forth6809.asm):02700                     LDX   VARHERE
E1B8 ED81             (    forth6809.asm):02701                     STD   ,X++
E1BA ED81             (    forth6809.asm):02702                     STD   ,X++
E1BC 9F0A             (    forth6809.asm):02703                     STX   VARHERE
E1BE 39               (    forth6809.asm):02704                     RTS
                      (    forth6809.asm):02705         
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02708         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02709         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02710         ; ------------------------------------------------------------
E1BF                  (    forth6809.asm):02711         TWOCONSTANTW:
E1BF CCF345           (    forth6809.asm):02712                     LDD   #TWOFETCHW
E1C2 BDE0ED           (    forth6809.asm):02713                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1C5 3706             (    forth6809.asm):02714                     PULU  D                 ; x2
E1C7 DD26             (    forth6809.asm):02715                     STD   MSCR
E1C9 DC26             (    forth6809.asm):02716                     LDD   MSCR
E1CB 3606             (    forth6809.asm):02717                     PSHU  D
E1CD BDDFFC           (    forth6809.asm):02718                     JSR   COMMAW            ; x2 -> lower address
E1D0 BDDFFC           (    forth6809.asm):02719                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1
E1D3 39               (    forth6809.asm):02720                     RTS
                      (    forth6809.asm):02721         
                      (    forth6809.asm):02722         ; ------------------------------------------------------------
                      (    forth6809.asm):02723         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02724         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):02725         ; the variable area.
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
E1D4                  (    forth6809.asm):02727         BUFFERCOLONW:
E1D4 3706             (    forth6809.asm):02728                     PULU  D                 ; u
E1D6 DD28             (    forth6809.asm):02729                     STD   MSCR2
E1D8 CC0000           (    forth6809.asm):02730                     LDD   #0
E1DB 3606             (    forth6809.asm):02731                     PSHU  D
E1DD BDE054           (    forth6809.asm):02732                     JSR   HEADER
E1E0 CCDF8F           (    forth6809.asm):02733                     LDD   #DODOES
E1E3 3606             (    forth6809.asm):02734                     PSHU  D
E1E5 BDEA79           (    forth6809.asm):02735                     JSR   CCALL
E1E8 CCDF9A           (    forth6809.asm):02736                     LDD   #DOESRT0
E1EB 3606             (    forth6809.asm):02737                     PSHU  D
E1ED BDE002           (    forth6809.asm):02738                     JSR   CODECOMMA
E1F0 DC0A             (    forth6809.asm):02739                     LDD   VARHERE
E1F2 3606             (    forth6809.asm):02740                     PSHU  D
E1F4 BDE002           (    forth6809.asm):02741                     JSR   CODECOMMA
E1F7 DC28             (    forth6809.asm):02742                     LDD   MSCR2
E1F9 3606             (    forth6809.asm):02743                     PSHU  D
E1FB BDE029           (    forth6809.asm):02744                     JSR   VALLOTW
E1FE 39               (    forth6809.asm):02745                     RTS
                      (    forth6809.asm):02746         
                      (    forth6809.asm):02747         ; ------------------------------------------------------------
                      (    forth6809.asm):02748         ; DEFER  ( "name" -- )
                      (    forth6809.asm):02749         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):02750         ; throws -21.
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
E1FF CCDFBE           (    forth6809.asm):02752         DEFERW:     LDD   #DODEFER
E202 BDE0ED           (    forth6809.asm):02753                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E205 CCDFC6           (    forth6809.asm):02754                     LDD   #DOABORTUNDEF
E208 3606             (    forth6809.asm):02755                     PSHU  D
E20A BDDFFC           (    forth6809.asm):02756                     JSR   COMMAW
E20D 39               (    forth6809.asm):02757                     RTS
                      (    forth6809.asm):02758         
                      (    forth6809.asm):02759         ; ------------------------------------------------------------
                      (    forth6809.asm):02760         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):02761         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):02762         ; ------------------------------------------------------------
E20E                  (    forth6809.asm):02763         DEFERFETCHW:
E20E BDEB2B           (    forth6809.asm):02764                     JSR   TOBODYW
E211 3710             (    forth6809.asm):02765                     PULU  X                 ; body address
E213 EC84             (    forth6809.asm):02766                     LDD   ,X
E215 3606             (    forth6809.asm):02767                     PSHU  D                 ; xt2
E217 39               (    forth6809.asm):02768                     RTS
                      (    forth6809.asm):02769         
                      (    forth6809.asm):02770         ; ------------------------------------------------------------
                      (    forth6809.asm):02771         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):02772         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):02773         ; ------------------------------------------------------------
E218                  (    forth6809.asm):02774         DEFERSTOREW:
E218 BDEB2B           (    forth6809.asm):02775                     JSR   TOBODYW
E21B 3710             (    forth6809.asm):02776                     PULU  X                 ; body address of xt1
E21D 3706             (    forth6809.asm):02777                     PULU  D                 ; xt2
E21F ED84             (    forth6809.asm):02778                     STD   ,X
E221 39               (    forth6809.asm):02779                     RTS
                      (    forth6809.asm):02780         
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
                      (    forth6809.asm):02782         ; IS  ( xt "name" -- )  IMMEDIATE
                      (    forth6809.asm):02783         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):02784         ; compile code to do so at run time. Error -13 if the name is not

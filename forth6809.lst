                      (    forth6809.asm):03213         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03214         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03215         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03216         ;    Inputs:
                      (    forth6809.asm):03217         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03218         ;    Outputs:
                      (    forth6809.asm):03219         ;        single number: n and -1
                      (    forth6809.asm):03220         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03221         ;        not a number: c-addr and 0
                      (    forth6809.asm):03222         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03223         ; ------------------------------------------------------------
E4C6 3710             (    forth6809.asm):03224         NUMBERQ:    PULU  X                 ; c-addr
E4C8 9F1C             (    forth6809.asm):03225                     STX   CADDR
E4CA A684             (    forth6809.asm):03226                     LDA   ,X
E4CC 2772             (    forth6809.asm):03227                     BEQ   NQBAD
E4CE 971E             (    forth6809.asm):03228                     STA   CNTREM
E4D0 3001             (    forth6809.asm):03229                     LEAX  1,X
                      (    forth6809.asm):03230         
                      (    forth6809.asm):03231                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03232                     ; digit count. See shadow: NUMBERQ.1
E4D2 D61E             (    forth6809.asm):03233                     LDB   CNTREM
E4D4 5A               (    forth6809.asm):03234                     DECB
E4D5 A685             (    forth6809.asm):03235                     LDA   B,X
E4D7 812E             (    forth6809.asm):03236                     CMPA  #'.'
E4D9 2604             (    forth6809.asm):03237                     BNE   NQNOSIGN
E4DB 0A1E             (    forth6809.asm):03238                     DEC   CNTREM
E4DD 2761             (    forth6809.asm):03239                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03240         
E4DF 0F1F             (    forth6809.asm):03241         NQNOSIGN:   CLR   NUMNEG
E4E1 A684             (    forth6809.asm):03242                     LDA   ,X
E4E3 812D             (    forth6809.asm):03243                     CMPA  #'-'
E4E5 2608             (    forth6809.asm):03244                     BNE   NQNOSIGN2
E4E7 031F             (    forth6809.asm):03245                     COM   NUMNEG
E4E9 3001             (    forth6809.asm):03246                     LEAX  1,X
E4EB 0A1E             (    forth6809.asm):03247                     DEC   CNTREM
E4ED 2751             (    forth6809.asm):03248                     BEQ   NQBAD
                      (    forth6809.asm):03249         
E4EF 9F20             (    forth6809.asm):03250         NQNOSIGN2:  STX   NADDR
E4F1 4F               (    forth6809.asm):03251                     CLRA
E4F2 D61E             (    forth6809.asm):03252                     LDB   CNTREM
E4F4 DD22             (    forth6809.asm):03253                     STD   NCNT
E4F6 CC0000           (    forth6809.asm):03254                     LDD   #0
E4F9 DD4E             (    forth6809.asm):03255                     STD   UDHI
E4FB DD50             (    forth6809.asm):03256                     STD   UDLO
                      (    forth6809.asm):03257         

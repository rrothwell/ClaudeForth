                      (    forth6809.asm):06237         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):06238         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):06239         ; M*/W
                      (    forth6809.asm):06240         ;    Inputs:

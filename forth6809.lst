F783 3706             (    forth6809.asm):06741         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F785 DDAB             (    forth6809.asm):06742                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):06743                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):06744                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):06745                                   ; real source length was misread as an
                      (    forth6809.asm):06746                                   ; address, the real source address was never
                      (    forth6809.asm):06747                                   ; popped at all, and the true destination
                      (    forth6809.asm):06748                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):06749                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):06750                                   ; c-addr2 (dest) is on top, popped first.
F787 3706             (    forth6809.asm):06751                    PULU D         ; next: u1 (source length)
F789 DDA9             (    forth6809.asm):06752                    STD  UESRCLEN
F78B 3706             (    forth6809.asm):06753                    PULU D         ; next: c-addr1 (source address)
F78D DDA7             (    forth6809.asm):06754                    STD  UEADDR
F78F CC0000           (    forth6809.asm):06755                    LDD  #0
F792 DDAD             (    forth6809.asm):06756                    STD  UEOUTLEN
F794 9EA7             (    forth6809.asm):06757                    LDX  UEADDR
F796 109EAB           (    forth6809.asm):06758                    LDY  UEDST
                      (    forth6809.asm):06759         
                      (    forth6809.asm):06760                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06761                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06762                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06763                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06764                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06765                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06766                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06767                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06768                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06769                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06770                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06771                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06772                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):06773                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):06774                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):06775                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):06776                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):06777                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):06778                    ; wrong algorithm entirely, not a smaller bug within it.
F799 DCA9             (    forth6809.asm):06779         UELOOP:    LDD  UESRCLEN
F79B 2715             (    forth6809.asm):06780                    BEQ  UEDONE
F79D A680             (    forth6809.asm):06781                    LDA  ,X+
F79F 8125             (    forth6809.asm):06782                    CMPA #'%'
F7A1 2604             (    forth6809.asm):06783                    BNE  UENOTPCT
F7A3 C625             (    forth6809.asm):06784                    LDB  #'%'      ; write the extra '%' first - the character
F7A5 E7A0             (    forth6809.asm):06785                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06786                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06787                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06788                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06789                                   ; independently for each one the loop visits.
F7A7 A7A0             (    forth6809.asm):06790         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06791                                   ; every character, '%' or not
F7A9 DCA9             (    forth6809.asm):06792                    LDD  UESRCLEN
F7AB 830001           (    forth6809.asm):06793                    SUBD #1
F7AE DDA9             (    forth6809.asm):06794                    STD  UESRCLEN
F7B0 20E7             (    forth6809.asm):06795                    BRA  UELOOP
F7B2 1F20             (    forth6809.asm):06796         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F7B4 93AB             (    forth6809.asm):06797                    SUBD UEDST     ; overwriting whatever was left on top of
F7B6 DDAD             (    forth6809.asm):06798                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06799                                   ; required return values, and separately,
                      (    forth6809.asm):06800                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06801                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06802                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06803                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06804                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06805                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06806                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06807                                   ; correct regardless of how many characters
                      (    forth6809.asm):06808                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06809                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06810                                   ; incremented alongside it.
F7B8 DCAB             (    forth6809.asm):06811                    LDD  UEDST
F7BA 3606             (    forth6809.asm):06812                    PSHU D         ; push c-addr2 (destination address)
F7BC DCAD             (    forth6809.asm):06813                    LDD  UEOUTLEN
F7BE 3606             (    forth6809.asm):06814                    PSHU D         ; push u2 (actual unescaped length)
F7C0 39               (    forth6809.asm):06815                    RTS
                      (    forth6809.asm):06816         

                      (    forth6809.asm):00425         ; ============================================================
                      (    forth6809.asm):00426         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00427         ;
                      (    forth6809.asm):00428         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00429         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00430         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00431         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00432         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00433         ; hand-built. Headers are in search order (shadow SECTION27.1).
                      (    forth6809.asm):00434         ;
                      (    forth6809.asm):00435         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00436         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00437         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00438         ; ============================================================
                      (    forth6809.asm):00439         
                      (    forth6809.asm):00440                     ORG   BASEDICT
                      (    forth6809.asm):00441         ; ROOT wordlist: the Search-Order words. It is always searched, last,
                      (    forth6809.asm):00442         ; and FORTH continues into it (the link of the first FORTH header names
                      (    forth6809.asm):00443         ; BASEROOTLATEST), so FORTH-WORDLIST also contains these words.
                      (    forth6809.asm):00444         ; See shadow BASEROOTLATEST.1

                      (    forth6809.asm):00826                    SUBD  TSTUAF
                      (    forth6809.asm):00827                    CMPD  #-2
                      (    forth6809.asm):00828                    BNE   DPFAIL
                      (    forth6809.asm):00829         
                      (    forth6809.asm):00830                    LDD   #TRUEV
                      (    forth6809.asm):00831                    BRA   DPDONE
C158                  (    forth6809.asm):00832         DPFAIL:    LDD   #FALSEV
C158                  (    forth6809.asm):00833         DPDONE:    LDX   #TSTDROPNAME
                      (    forth6809.asm):00834                    PSHU  X
                      (    forth6809.asm):00835                    PSHU  D

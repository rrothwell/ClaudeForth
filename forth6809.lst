                      (    forth6809.asm):01633                    LDD   #TSTVAL5
                      (    forth6809.asm):01634                    PSHU  D
                      (    forth6809.asm):01635                    LDD   #TSTVAL6
                      (    forth6809.asm):01636                    PSHU  D

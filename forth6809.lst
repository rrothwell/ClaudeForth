                      (    forth6809.asm):07724         ; ============================================================
                      (    forth6809.asm):07725         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07726         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07727         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07728         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07729         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07730         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07731         ; ============================================================
                      (    forth6809.asm):07732         ; ------------------------------------------------------------
                      (    forth6809.asm):07733         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07734         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07735         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07736         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07737         ; - no indirection, no value cell.
                      (    forth6809.asm):07738         ;
                      (    forth6809.asm):07739         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07740         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07741         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07742         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07743         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07744         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07745         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07746         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07747         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07748         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07749         ; ------------------------------------------------------------
FDF9 CCFFFF           (    forth6809.asm):07750         TRUEBODY:  LDD   #$FFFF
FDFC 3606             (    forth6809.asm):07751                    PSHU  D
FDFE 39               (    forth6809.asm):07752                    RTS
                      (    forth6809.asm):07753         
FDFF CC0000           (    forth6809.asm):07754         FALSEBODY: LDD   #$0000
FE02 3606             (    forth6809.asm):07755                    PSHU  D
FE04 39               (    forth6809.asm):07756                    RTS
                      (    forth6809.asm):07757         
                      (    forth6809.asm):07758         ; ------------------------------------------------------------
                      (    forth6809.asm):07759         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07760         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07761         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07762         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07763         ; ------------------------------------------------------------
FE05 CC0001           (    forth6809.asm):07764         ONEBODY:   LDD   #1
FE08 3606             (    forth6809.asm):07765                    PSHU  D
FE0A 39               (    forth6809.asm):07766                    RTS
                      (    forth6809.asm):07767         
FE0B CCFFFF           (    forth6809.asm):07768         MONEBODY:  LDD   #-1
FE0E 3606             (    forth6809.asm):07769                    PSHU  D
FE10 39               (    forth6809.asm):07770                    RTS
                      (    forth6809.asm):07771         
FE11 CC0002           (    forth6809.asm):07772         TWOBODY:   LDD   #2
FE14 3606             (    forth6809.asm):07773                    PSHU  D
FE16 39               (    forth6809.asm):07774                    RTS
                      (    forth6809.asm):07775         
FE17 CCFFFE           (    forth6809.asm):07776         MTWOBODY:  LDD   #-2
FE1A 3606             (    forth6809.asm):07777                    PSHU  D
FE1C 39               (    forth6809.asm):07778                    RTS
                      (    forth6809.asm):07779         
                      (    forth6809.asm):07780         ; Verify no collision with init code,
                      (    forth6809.asm):07781         ; value should match ORG INITCODE.
     FE1D             (    forth6809.asm):07782         BASECODEEND  EQU   *
     20E3             (    forth6809.asm):07783         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07784         
                      (    forth6809.asm):07785         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07786         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07787         ; .bin file.
FE1D                  (    forth6809.asm):07788         BASEND:
FE1D FFFFFFFFFFFFFFFF (    forth6809.asm):07789                  FILL $FF,INITCODE-BASEND

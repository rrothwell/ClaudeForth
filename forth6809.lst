C289                  (    forth6809.asm):11054         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11055                       STD  TSTCBUF
                      (    forth6809.asm):11056         
                      (    forth6809.asm):11057                       STU  TSTU0
                      (    forth6809.asm):11058         
                      (    forth6809.asm):11059                       LDD  #TSTGUARD
                      (    forth6809.asm):11060                       PSHU D
                      (    forth6809.asm):11061                       LDD  #100
                      (    forth6809.asm):11062                       PSHU D
                      (    forth6809.asm):11063                       LDD  #TSTCBUF
                      (    forth6809.asm):11064                       PSHU D
                      (    forth6809.asm):11065                       STU  TSTUB4
                      (    forth6809.asm):11066         

                      (    forth6809.asm):04148         
E851 ECC4             (    forth6809.asm):04149                     LDD   ,U
E853 10830007         (    forth6809.asm):04150                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E857 260D             (    forth6809.asm):04151                     BNE   LOOPDONE
E859 3706             (    forth6809.asm):04152                     PULU  D
E85B 3710             (    forth6809.asm):04153                     PULU  X                 ; ?DO skip operand
E85D DC08             (    forth6809.asm):04154                     LDD   CODEHERE
E85F 3606             (    forth6809.asm):04155                     PSHU  D
E861 3610             (    forth6809.asm):04156                     PSHU  X
E863 BDE63F           (    forth6809.asm):04157                     JSR   PATCH
E866 39               (    forth6809.asm):04158         LOOPDONE:   RTS

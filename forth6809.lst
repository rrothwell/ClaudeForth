                      (    forth6809.asm):09250                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):09251                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):09252                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):09253                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):09254                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):09255                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):09256                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):09257                   ; high cell.
E5C3 0D22             (    forth6809.asm):09258                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):09259                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):09260                   LDD   UDLO
E5C9 43               (    forth6809.asm):09261                   COMA
E5CA 53               (    forth6809.asm):09262                   COMB
E5CB C30001           (    forth6809.asm):09263                   ADDD  #1
E5CE DD76             (    forth6809.asm):09264                   STD   UDLO
E5D0 3401             (    forth6809.asm):09265                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):09266                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):09267                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):09268                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):09269                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):09270                                      ; silently overwrote the real carry here
                      (    forth6809.asm):09271                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):09272                                      ; making the high-cell increment run
                      (    forth6809.asm):09273                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):09274                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):09275                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):09276                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):09277                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):09278                                      ; matching "always increment" rather than
                      (    forth6809.asm):09279                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):09280                   LDD   UDHI
E5D4 43               (    forth6809.asm):09281                   COMA
E5D5 53               (    forth6809.asm):09282                   COMB
E5D6 3501             (    forth6809.asm):09283                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):09284                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):09285                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):09286                                      ; when there's no carry - the complemented
                      (    forth6809.asm):09287                                      ; value was computed in D but never
                      (    forth6809.asm):09288                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):09289                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):09290                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):09291                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):09292                                      ; was always seen as set, so this branch
                      (    forth6809.asm):09293                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):09294                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):09295                                      ; alone would have made this second,
                      (    forth6809.asm):09296                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):09297                                      ; only past the "+1", never past the
                      (    forth6809.asm):09298                                      ; store itself - the store always runs,
                      (    forth6809.asm):09299                                      ; either way.
E5DA C30001           (    forth6809.asm):09300                   ADDD  #1
E5DD DD74             (    forth6809.asm):09301         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):09302         
E5DF                  (    forth6809.asm):09303         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):09304                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):09305                   LDX   CADDR
E5E1 E684             (    forth6809.asm):09306                   LDB   ,X
E5E3 5A               (    forth6809.asm):09307                   DECB

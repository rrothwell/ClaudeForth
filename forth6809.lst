                      (    forth6809.asm):03931                    JSR   TSTDTOS
                      (    forth6809.asm):03932                    JSR   TSTDMAX
                      (    forth6809.asm):03933                    JSR   TSTDMIN
                      (    forth6809.asm):03934         

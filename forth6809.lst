                      (    forth6809.asm):03158         ; ------------------------------------------------------------
                      (    forth6809.asm):03159         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03160         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03161         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03162         ;    Inputs:
                      (    forth6809.asm):03163         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03164         ;    Outputs:
                      (    forth6809.asm):03165         ;        single number: n and -1
                      (    forth6809.asm):03166         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03167         ;        not a number: c-addr and 0
                      (    forth6809.asm):03168         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03169         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03170         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03171         ; NUMBERQ.6.
                      (    forth6809.asm):03172         ; ------------------------------------------------------------

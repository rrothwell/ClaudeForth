DF41 DD00             (    forth6809.asm):02101                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02102                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02103                                   ; that spans more than one line of input.
                      (    forth6809.asm):02104                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02105                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02106                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02107                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02108                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02109                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02110                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02111                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02112                                   ; been reached. A colon definition split
                      (    forth6809.asm):02113                                   ; across multiple lines would have every
                      (    forth6809.asm):02114                                   ; word on every line after the first
                      (    forth6809.asm):02115                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02116                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02117                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02118                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02119                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02120                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02121                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02122                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02123                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):02124                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):02125                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):02126                                   ; so this still correctly forces interpret
                      (    forth6809.asm):02127                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):02128                                   ; semantics call for it - just not on every
                      (    forth6809.asm):02129                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):02130                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):02131         

FF3C 39               (    forth6809.asm):15299                    RTS
                      (    forth6809.asm):15300         
FF3D CC0000           (    forth6809.asm):15301         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):15302                    PSHU  D
FF42 39               (    forth6809.asm):15303                    RTS
                      (    forth6809.asm):15304         
                      (    forth6809.asm):15305         ; ------------------------------------------------------------
                      (    forth6809.asm):15306         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as

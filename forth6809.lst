                      (    forth6809.asm):14114                     BNE  NZFAIL
                      (    forth6809.asm):14115         
                      (    forth6809.asm):14116                     LDD  TSTUB4
                      (    forth6809.asm):14117                     SUBD TSTUAF
                      (    forth6809.asm):14118                     CMPD #4  ; BUG FIX: was 0 - mistakenly copied the net-
                      (    forth6809.asm):14119                              ; zero reasoning from TSTNUMSIGNSGT (which calls
                      (    forth6809.asm):14120                              ; #> to consume ud2 before capturing TSTUAF).
                      (    forth6809.asm):14121                              ; This test captures TSTUAF right after NUMSIGN
                      (    forth6809.asm):14122                              ; returns, with ud2 (the quotient) still sitting
                      (    forth6809.asm):14123                              ; on the stack - confirmed via MAME: the user's
                      (    forth6809.asm):14124                              ; own register dump showed D=$0004 at this exact
                      (    forth6809.asm):14125                              ; comparison, precisely matching the 2 extra
                      (    forth6809.asm):14126                              ; cells (quotient low+high) genuinely present at
                      (    forth6809.asm):14127                              ; TSTUAF's own capture point that aren't present
                      (    forth6809.asm):14128                              ; at TSTUB4's (captured before NUMSIGN even ran).

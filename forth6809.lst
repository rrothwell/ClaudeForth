                      (    forth6809.asm):02553         
                      (    forth6809.asm):02554         ; ------------------------------------------------------------
                      (    forth6809.asm):02555         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02556         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02557         ; ------------------------------------------------------------
CE7A CCFFFF           (    forth6809.asm):02558         ABORTW:     LDD   #-1
CE7D 3606             (    forth6809.asm):02559                     PSHU  D                 ; throw code (-1)
CE7F 7ED905           (    forth6809.asm):02560                     JMP   THROWW

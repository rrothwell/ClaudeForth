                      (    forth6809.asm):13618                    RTS
                      (    forth6809.asm):13619         
C2AE                  (    forth6809.asm):13620         TSTSN2NAME: FCB  9
                      (    forth6809.asm):13621                     FCC  "TSTSNAME2"
                      (    forth6809.asm):13622         
                      (    forth6809.asm):13623         ; ------------------------------------------------------------
                      (    forth6809.asm):13624         ; TSTUNESCAPE - unit test for UNESCAPE. Source "A%B" (3 chars,
                      (    forth6809.asm):13625         ; one '%' in the middle) doubles the '%' to produce "A%%B" (4
                      (    forth6809.asm):13626         ; chars) - confirmed via its own code and a prior session's
                      (    forth6809.asm):13627         ; already-corrected design comment that this is genuinely a
                      (    forth6809.asm):13628         ; doubling operation, not backslash-sequence decoding. Verifies
                      (    forth6809.asm):13629         ; every output character individually and the grown length,
                      (    forth6809.asm):13630         ; not just that some output was produced.
                      (    forth6809.asm):13631         ; ------------------------------------------------------------
C2AE                  (    forth6809.asm):13632         TSTUNESCAPE: LDA  #'A'
                      (    forth6809.asm):13633                      STA  TSTCBUF
                      (    forth6809.asm):13634                      LDA  #'%'
                      (    forth6809.asm):13635                      STA  TSTCBUF+1
                      (    forth6809.asm):13636                      LDA  #'B'
                      (    forth6809.asm):13637                      STA  TSTCBUF+2
                      (    forth6809.asm):13638         
                      (    forth6809.asm):13639                      STU  TSTU0
                      (    forth6809.asm):13640         
                      (    forth6809.asm):13641                      LDD  #TSTGUARD
                      (    forth6809.asm):13642                      PSHU D
                      (    forth6809.asm):13643                      LDD  #TSTCBUF
                      (    forth6809.asm):13644                      PSHU D
                      (    forth6809.asm):13645                      LDD  #3
                      (    forth6809.asm):13646                      PSHU D
                      (    forth6809.asm):13647                      LDD  #TSTCBUF+10
                      (    forth6809.asm):13648                      PSHU D
                      (    forth6809.asm):13649                      STU  TSTUB4
                      (    forth6809.asm):13650         
                      (    forth6809.asm):13651                      JSR  UNESCAPEW
                      (    forth6809.asm):13652         
                      (    forth6809.asm):13653                      STU  TSTUAF
                      (    forth6809.asm):13654         
                      (    forth6809.asm):13655                      PULU D
                      (    forth6809.asm):13656                      CMPD #4
                      (    forth6809.asm):13657                      BNE  UXFAIL
                      (    forth6809.asm):13658                      PULU D
                      (    forth6809.asm):13659                      CMPD #TSTCBUF+10
                      (    forth6809.asm):13660                      BNE  UXFAIL
                      (    forth6809.asm):13661         
                      (    forth6809.asm):13662                      TFR  D,X
                      (    forth6809.asm):13663                      LDA  ,X
                      (    forth6809.asm):13664                      CMPA #'A'
                      (    forth6809.asm):13665                      BNE  UXFAIL
                      (    forth6809.asm):13666                      LDA  1,X
                      (    forth6809.asm):13667                      CMPA #'%'
                      (    forth6809.asm):13668                      BNE  UXFAIL
                      (    forth6809.asm):13669                      LDA  2,X
                      (    forth6809.asm):13670                      CMPA #'%'
                      (    forth6809.asm):13671                      BNE  UXFAIL
                      (    forth6809.asm):13672                      LDA  3,X
                      (    forth6809.asm):13673                      CMPA #'B'
                      (    forth6809.asm):13674                      BNE  UXFAIL
                      (    forth6809.asm):13675         
                      (    forth6809.asm):13676                      PULU D
                      (    forth6809.asm):13677                      CMPD #TSTGUARD
                      (    forth6809.asm):13678                      BNE  UXFAIL
                      (    forth6809.asm):13679         
                      (    forth6809.asm):13680                      LDD  TSTUB4
                      (    forth6809.asm):13681                      SUBD TSTUAF
                      (    forth6809.asm):13682                      CMPD #-2
                      (    forth6809.asm):13683                      BNE  UXFAIL
                      (    forth6809.asm):13684         
                      (    forth6809.asm):13685                      LDD  #TRUEV
                      (    forth6809.asm):13686                      BRA  UXDONE
C2AE                  (    forth6809.asm):13687         UXFAIL:      LDD  #FALSEV
C2AE                  (    forth6809.asm):13688         UXDONE:      LDX  #TSTUENAME
                      (    forth6809.asm):13689                      PSHU X
                      (    forth6809.asm):13690                      PSHU D
                      (    forth6809.asm):13691                      JSR  TSTREPORT
                      (    forth6809.asm):13692         
                      (    forth6809.asm):13693                      LDU  TSTU0
                      (    forth6809.asm):13694                      RTS
                      (    forth6809.asm):13695         
C2AE                  (    forth6809.asm):13696         TSTUENAME: FCB  11
                      (    forth6809.asm):13697                    FCC  "TSTUNESCAPE"
                      (    forth6809.asm):13698         
                      (    forth6809.asm):13699                    ENDC ; <<<<
                      (    forth6809.asm):13700         
                      (    forth6809.asm):13701         ; ------------------------------------------------------------
                      (    forth6809.asm):13702         ; TSTNUMOUT - numeric output tests (glossary section 3.13, 14
                      (    forth6809.asm):13703         ; words, 13 tests since #S and #> are combined into one test,
                      (    forth6809.asm):13704         ; matching how they're naturally used together as the tail of
                      (    forth6809.asm):13705         ; the standard pictured-output idiom "<# ... #S #>").
                      (    forth6809.asm):13706         ;
                      (    forth6809.asm):13707         ; The pictured-numeric-output core (<# # #S #> HOLD HOLDS) is
                      (    forth6809.asm):13708         ; pure string-building with no I/O, tested directly. SIGN
                      (    forth6809.asm):13709         ; carries real bug-fix history - a prior bare BPL right after
                      (    forth6809.asm):13710         ; PULU didn't affect condition codes on real 6809 hardware, and
                      (    forth6809.asm):13711         ; the bug was masked for every internal caller by caller-side
                      (    forth6809.asm):13712         ; luck (each ran a flag-setting LDD right before calling SIGN).
                      (    forth6809.asm):13713         ; This section's own SIGN test deliberately poisons the flags
                      (    forth6809.asm):13714         ; with an unrelated CMPX immediately before each direct call,
                      (    forth6809.asm):13715         ; so it exercises the exact previously-broken scenario rather
                      (    forth6809.asm):13716         ; than repeating the same kind of luck that hid the bug.
                      (    forth6809.asm):13717         ;
                      (    forth6809.asm):13718         ; The high-level printing words (./U./.R/U.R/?/D./D.R) all
                      (    forth6809.asm):13719         ; produce real output via TYPE/EMIT internally, so each applies
                      (    forth6809.asm):13720         ; the SERIALPOLL-conditional split established in section 3.1 -
                      (    forth6809.asm):13721         ; full OUTHEAD/OUTBUF verification under SERIALPOLL=0, an
                      (    forth6809.asm):13722         ; EMITCH-based last-character check under SERIALPOLL=1. .R/U.R/
                      (    forth6809.asm):13723         ; D.R specifically test the padding path (a width wider than the
                      (    forth6809.asm):13724         ; actual digits), not just a no-padding sanity case. D./D.R use
                      (    forth6809.asm):13725         ; a genuine double-cell value (-100000, computed and verified
                      (    forth6809.asm):13726         ; independently in Python before writing the tests) to exercise
                      (    forth6809.asm):13727         ; the 32-bit negation path, not a value that happens to fit in
                      (    forth6809.asm):13728         ; one cell.
                      (    forth6809.asm):13729         ;
                      (    forth6809.asm):13730         ; Note: this section's own COMPARE-adjacent naming risk doesn't
                      (    forth6809.asm):13731         ; apply here, but every group wrapper name (TSTNUMOUT) and every
                      (    forth6809.asm):13732         ; internal FAIL/DONE prefix was still checked against the whole
                      (    forth6809.asm):13733         ; file before insertion, per the standard practice that caught
                      (    forth6809.asm):13734         ; the TSTCOMPARE collision in the prior section.
                      (    forth6809.asm):13735         ; ------------------------------------------------------------
C2AE BDFC2B           (    forth6809.asm):13736         TSTNUMOUT: JSR CRW
C2B1 8EC2C2           (    forth6809.asm):13737                    LDX   #TSTNUMOUTMSG
C2B4 3610             (    forth6809.asm):13738                    PSHU  X
C2B6 CC0006           (    forth6809.asm):13739                    LDD   #6
C2B9 3606             (    forth6809.asm):13740                    PSHU  D
C2BB BDF60B           (    forth6809.asm):13741                    JSR   TYPE
C2BE BDFC2B           (    forth6809.asm):13742                    JSR   CRW
                      (    forth6809.asm):13743         
                      (    forth6809.asm):13744                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13745         
                      (    forth6809.asm):13746                    JSR   TSTLTNUM
                      (    forth6809.asm):13747                    JSR   TSTHOLD
                      (    forth6809.asm):13748                    JSR   TSTHOLDS
                      (    forth6809.asm):13749                    JSR   TSTSIGN
                      (    forth6809.asm):13750                    JSR   TSTNUMSIGN
                      (    forth6809.asm):13751                    JSR   TSTNUMSIGNSGT
                      (    forth6809.asm):13752                    JSR   TSTDOT
                      (    forth6809.asm):13753                    JSR   TSTUDOT
                      (    forth6809.asm):13754                    JSR   TSTDOTR
                      (    forth6809.asm):13755                    JSR   TSTUDOTR
                      (    forth6809.asm):13756                    JSR   TSTQMARK
                      (    forth6809.asm):13757                    JSR   TSTDDOT
                      (    forth6809.asm):13758                    JSR   TSTDDOTR
                      (    forth6809.asm):13759         
                      (    forth6809.asm):13760                    ENDC ; <<<<
                      (    forth6809.asm):13761         
C2C1 39               (    forth6809.asm):13762                    RTS
                      (    forth6809.asm):13763         
C2C2 4E756D4F7574     (    forth6809.asm):13764         TSTNUMOUTMSG: FCC "NumOut"
                      (    forth6809.asm):13765         
                      (    forth6809.asm):13766                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13767         
                      (    forth6809.asm):13768         ; ------------------------------------------------------------
                      (    forth6809.asm):13769         ; Numeric Output test harness (glossary section 3.13). The
                      (    forth6809.asm):13770         ; pictured-numeric-output core (<# # #S #> HOLD HOLDS SIGN) is
                      (    forth6809.asm):13771         ; pure string-building with no I/O, tested directly. The
                      (    forth6809.asm):13772         ; high-level printing words (./U./.R/U.R/?/D./D.R) all produce
                      (    forth6809.asm):13773         ; real output via TYPE and/or EMIT internally, so per section
                      (    forth6809.asm):13774         ; 3.1's own already-debugged finding, each applies the
                      (    forth6809.asm):13775         ; SERIALPOLL-conditional split established there: full OUTHEAD/
                      (    forth6809.asm):13776         ; OUTBUF verification under SERIALPOLL=0, an EMITCH-based check
                      (    forth6809.asm):13777         ; of the last character under SERIALPOLL=1 - accepted as a
                      (    forth6809.asm):13778         ; known, honest limitation for words ending in a trailing space
                      (    forth6809.asm):13779         ; (./U./D. all print a fixed final space character, so the
                      (    forth6809.asm):13780         ; polling-mode check there confirms less than for the
                      (    forth6809.asm):13781         ; no-trailing-space words, but is still correct and consistent
                      (    forth6809.asm):13782         ; with the same trade-off already established for TSTCR/
                      (    forth6809.asm):13783         ; TSTSPACES/TSTTYPE/TSTDOTQUOTE in earlier sections).
                      (    forth6809.asm):13784         ;
                      (    forth6809.asm):13785         ; SIGN itself carries real bug-fix history: a prior version used
                      (    forth6809.asm):13786         ; a bare BPL immediately after PULU, which doesn't affect
                      (    forth6809.asm):13787         ; condition codes on real 6809 hardware - the bug was masked for
                      (    forth6809.asm):13788         ; every internal caller by "caller-side luck" (each happened to
                      (    forth6809.asm):13789         ; run a flag-setting LDD right before calling SIGN). This
                      (    forth6809.asm):13790         ; section's own SIGN test deliberately poisons the flags with an
                      (    forth6809.asm):13791         ; unrelated, known-positive value immediately before the actual
                      (    forth6809.asm):13792         ; PSHU/JSR SIGN sequence specifically so a standalone call - the
                      (    forth6809.asm):13793         ; exact scenario the bug-fix comment says was previously broken
                      (    forth6809.asm):13794         ; - is what gets tested, not a scenario that happens to work via
                      (    forth6809.asm):13795         ; the same kind of caller-side luck that hid the original bug.
                      (    forth6809.asm):13796         ; ------------------------------------------------------------
                      (    forth6809.asm):13797         
                      (    forth6809.asm):13798         ; ------------------------------------------------------------
                      (    forth6809.asm):13799         ; TSTLTNUM - unit test for <#. No stack effect of its own -
                      (    forth6809.asm):13800         ; verifies it sets HLD to PAD's current (redirected) address.
                      (    forth6809.asm):13801         ; ------------------------------------------------------------
C2C8                  (    forth6809.asm):13802         TSTLTNUM: LDD  CODEHERE
                      (    forth6809.asm):13803                   STD  TSTCSAV
                      (    forth6809.asm):13804         
                      (    forth6809.asm):13805                   LDD  #TSTCBUF
                      (    forth6809.asm):13806                   STD  CODEHERE
                      (    forth6809.asm):13807         
                      (    forth6809.asm):13808                   STU  TSTU0
                      (    forth6809.asm):13809         
                      (    forth6809.asm):13810                   LDD  #TSTGUARD
                      (    forth6809.asm):13811                   PSHU D
                      (    forth6809.asm):13812                   STU  TSTUB4
                      (    forth6809.asm):13813         
                      (    forth6809.asm):13814                   JSR  LTNUM
                      (    forth6809.asm):13815         
                      (    forth6809.asm):13816                   STU  TSTUAF
                      (    forth6809.asm):13817         
                      (    forth6809.asm):13818                   LDD  HLD
                      (    forth6809.asm):13819                   CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):13820                   BNE  LNFAIL
                      (    forth6809.asm):13821         
                      (    forth6809.asm):13822                   PULU D
                      (    forth6809.asm):13823                   CMPD #TSTGUARD
                      (    forth6809.asm):13824                   BNE  LNFAIL
                      (    forth6809.asm):13825         
                      (    forth6809.asm):13826                   LDD  TSTUB4
                      (    forth6809.asm):13827                   SUBD TSTUAF
                      (    forth6809.asm):13828                   CMPD #0
                      (    forth6809.asm):13829                   BNE  LNFAIL
                      (    forth6809.asm):13830         
                      (    forth6809.asm):13831                   LDD  #TRUEV
                      (    forth6809.asm):13832                   BRA  LNDONE
C2C8                  (    forth6809.asm):13833         LNFAIL:   LDD  #FALSEV
C2C8                  (    forth6809.asm):13834         LNDONE:   LDX  #TSTLNNAME
                      (    forth6809.asm):13835                   PSHU X
                      (    forth6809.asm):13836                   PSHU D
                      (    forth6809.asm):13837                   JSR  TSTREPORT
                      (    forth6809.asm):13838         
                      (    forth6809.asm):13839                   LDD  TSTCSAV
                      (    forth6809.asm):13840                   STD  CODEHERE
                      (    forth6809.asm):13841         
                      (    forth6809.asm):13842                   LDU  TSTU0
                      (    forth6809.asm):13843                   RTS
                      (    forth6809.asm):13844         
C2C8                  (    forth6809.asm):13845         TSTLNNAME: FCB  8
                      (    forth6809.asm):13846                    FCC  "TSTLTNUM"
                      (    forth6809.asm):13847         
                      (    forth6809.asm):13848         ; ------------------------------------------------------------
                      (    forth6809.asm):13849         ; TSTHOLD - unit test for HOLD. Holds 'A' then 'B' - since HOLD
                      (    forth6809.asm):13850         ; grows the buffer downward and prepends (decrements HLD first,
                      (    forth6809.asm):13851         ; then writes at the new, lower position), the second-held
                      (    forth6809.asm):13852         ; character ends up at the lower address, so reading forward
                      (    forth6809.asm):13853         ; from the final HLD should give "BA", not "AB".
                      (    forth6809.asm):13854         ; ------------------------------------------------------------
C2C8                  (    forth6809.asm):13855         TSTHOLD: LDD  CODEHERE
                      (    forth6809.asm):13856                  STD  TSTCSAV
                      (    forth6809.asm):13857         
                      (    forth6809.asm):13858                  LDD  #TSTCBUF
                      (    forth6809.asm):13859                  STD  CODEHERE
                      (    forth6809.asm):13860         
                      (    forth6809.asm):13861                  STU  TSTU0
                      (    forth6809.asm):13862         
                      (    forth6809.asm):13863                  LDD  #TSTGUARD
                      (    forth6809.asm):13864                  PSHU D
                      (    forth6809.asm):13865                  STU  TSTUB4
                      (    forth6809.asm):13866         
                      (    forth6809.asm):13867                  JSR  LTNUM
                      (    forth6809.asm):13868         
                      (    forth6809.asm):13869                  LDD  #'A'
                      (    forth6809.asm):13870                  PSHU D
                      (    forth6809.asm):13871                  JSR  HOLD
                      (    forth6809.asm):13872         
                      (    forth6809.asm):13873                  LDD  #'B'
                      (    forth6809.asm):13874                  PSHU D
                      (    forth6809.asm):13875                  JSR  HOLD
                      (    forth6809.asm):13876         
                      (    forth6809.asm):13877                  STU  TSTUAF
                      (    forth6809.asm):13878         
                      (    forth6809.asm):13879                  LDX  HLD
                      (    forth6809.asm):13880                  LDA  ,X
                      (    forth6809.asm):13881                  CMPA #'B'
                      (    forth6809.asm):13882                  BNE  HDFAIL
                      (    forth6809.asm):13883                  LDA  1,X
                      (    forth6809.asm):13884                  CMPA #'A'
                      (    forth6809.asm):13885                  BNE  HDFAIL
                      (    forth6809.asm):13886         
                      (    forth6809.asm):13887                  PULU D
                      (    forth6809.asm):13888                  CMPD #TSTGUARD
                      (    forth6809.asm):13889                  BNE  HDFAIL
                      (    forth6809.asm):13890         
                      (    forth6809.asm):13891                  LDD  TSTUB4
                      (    forth6809.asm):13892                  SUBD TSTUAF
                      (    forth6809.asm):13893                  CMPD #0
                      (    forth6809.asm):13894                  BNE  HDFAIL
                      (    forth6809.asm):13895         
                      (    forth6809.asm):13896                  LDD  #TRUEV
                      (    forth6809.asm):13897                  BRA  HDDONE
C2C8                  (    forth6809.asm):13898         HDFAIL:  LDD  #FALSEV
C2C8                  (    forth6809.asm):13899         HDDONE:  LDX  #TSTHDNAME
                      (    forth6809.asm):13900                  PSHU X
                      (    forth6809.asm):13901                  PSHU D
                      (    forth6809.asm):13902                  JSR  TSTREPORT
                      (    forth6809.asm):13903         
                      (    forth6809.asm):13904                  LDD  TSTCSAV
                      (    forth6809.asm):13905                  STD  CODEHERE
                      (    forth6809.asm):13906         
                      (    forth6809.asm):13907                  LDU  TSTU0
                      (    forth6809.asm):13908                  RTS
                      (    forth6809.asm):13909         
C2C8                  (    forth6809.asm):13910         TSTHDNAME: FCB  7
                      (    forth6809.asm):13911                    FCC  "TSTHOLD"
                      (    forth6809.asm):13912         
                      (    forth6809.asm):13913         ; ------------------------------------------------------------
                      (    forth6809.asm):13914         ; TSTHOLDS - unit test for HOLDS. Holds the string "XY" - since
                      (    forth6809.asm):13915         ; HOLDS iterates its source backward (last character first) and
                      (    forth6809.asm):13916         ; HOLD itself prepends, the two behaviors combine to preserve
                      (    forth6809.asm):13917         ; the original forward order in the pictured buffer, matching
                      (    forth6809.asm):13918         ; its own documented "depends on HOLD's exact decrement-by-one
                      (    forth6809.asm):13919         ; behavior".
                      (    forth6809.asm):13920         ; ------------------------------------------------------------
C2C8                  (    forth6809.asm):13921         TSTHOLDS: LDD  CODEHERE
                      (    forth6809.asm):13922                   STD  TSTCSAV
                      (    forth6809.asm):13923         
                      (    forth6809.asm):13924                   LDD  #TSTCBUF
                      (    forth6809.asm):13925                   STD  CODEHERE
                      (    forth6809.asm):13926         
                      (    forth6809.asm):13927                   LDA  #'X'
                      (    forth6809.asm):13928                   STA  TSTNAMEB
                      (    forth6809.asm):13929                   LDA  #'Y'
                      (    forth6809.asm):13930                   STA  TSTNAMEB+1
                      (    forth6809.asm):13931         
                      (    forth6809.asm):13932                   STU  TSTU0
                      (    forth6809.asm):13933         
                      (    forth6809.asm):13934                   LDD  #TSTGUARD
                      (    forth6809.asm):13935                   PSHU D
                      (    forth6809.asm):13936                   STU  TSTUB4
                      (    forth6809.asm):13937         
                      (    forth6809.asm):13938                   JSR  LTNUM
                      (    forth6809.asm):13939         
                      (    forth6809.asm):13940                   LDD  #TSTNAMEB
                      (    forth6809.asm):13941                   PSHU D
                      (    forth6809.asm):13942                   LDD  #2
                      (    forth6809.asm):13943                   PSHU D
                      (    forth6809.asm):13944                   JSR  HOLDS
                      (    forth6809.asm):13945         
                      (    forth6809.asm):13946                   STU  TSTUAF
                      (    forth6809.asm):13947         
                      (    forth6809.asm):13948                   LDX  HLD
                      (    forth6809.asm):13949                   LDA  ,X
                      (    forth6809.asm):13950                   CMPA #'X'
                      (    forth6809.asm):13951                   BNE  HOFAIL
                      (    forth6809.asm):13952                   LDA  1,X
                      (    forth6809.asm):13953                   CMPA #'Y'
                      (    forth6809.asm):13954                   BNE  HOFAIL
                      (    forth6809.asm):13955         
                      (    forth6809.asm):13956                   PULU D
                      (    forth6809.asm):13957                   CMPD #TSTGUARD
                      (    forth6809.asm):13958                   BNE  HOFAIL
                      (    forth6809.asm):13959         
                      (    forth6809.asm):13960                   LDD  TSTUB4
                      (    forth6809.asm):13961                   SUBD TSTUAF
                      (    forth6809.asm):13962                   CMPD #0
                      (    forth6809.asm):13963                   BNE  HOFAIL
                      (    forth6809.asm):13964         
                      (    forth6809.asm):13965                   LDD  #TRUEV
                      (    forth6809.asm):13966                   BRA  HODONE
C2C8                  (    forth6809.asm):13967         HOFAIL:   LDD  #FALSEV
C2C8                  (    forth6809.asm):13968         HODONE:   LDX  #TSTHSNAME
                      (    forth6809.asm):13969                   PSHU X
                      (    forth6809.asm):13970                   PSHU D
                      (    forth6809.asm):13971                   JSR  TSTREPORT
                      (    forth6809.asm):13972         
                      (    forth6809.asm):13973                   LDD  TSTCSAV
                      (    forth6809.asm):13974                   STD  CODEHERE
                      (    forth6809.asm):13975         
                      (    forth6809.asm):13976                   LDU  TSTU0
                      (    forth6809.asm):13977                   RTS
                      (    forth6809.asm):13978         
C2C8                  (    forth6809.asm):13979         TSTHSNAME: FCB  8
                      (    forth6809.asm):13980                    FCC  "TSTHOLDS"
                      (    forth6809.asm):13981         
                      (    forth6809.asm):13982         ; ------------------------------------------------------------
                      (    forth6809.asm):13983         ; TSTSIGN - unit test for SIGN. Deliberately poisons the CPU
                      (    forth6809.asm):13984         ; flags with an unrelated CMPX (setting them to reflect a
                      (    forth6809.asm):13985         ; positive comparison result, without touching D or the value
                      (    forth6809.asm):13986         ; about to be pushed) immediately before each PSHU/JSR SIGN
                      (    forth6809.asm):13987         ; call - specifically so this test exercises the exact scenario
                      (    forth6809.asm):13988         ; the word's own bug-fix comment says was previously broken (a
                      (    forth6809.asm):13989         ; direct, standalone call not preceded by a flag-setting LDD of
                      (    forth6809.asm):13990         ; the true value), rather than relying on the same kind of
                      (    forth6809.asm):13991         ; caller-side luck that hid the original bug. Two sub-cases:
                      (    forth6809.asm):13992         ; negative (with flags poisoned toward positive, confirming the
                      (    forth6809.asm):13993         ; minus sign still gets added - would fail if SIGN reverted to
                      (    forth6809.asm):13994         ; testing stale flags instead of the value it just popped) and
                      (    forth6809.asm):13995         ; positive (with flags poisoned toward negative, confirming no
                      (    forth6809.asm):13996         ; minus sign gets added incorrectly).

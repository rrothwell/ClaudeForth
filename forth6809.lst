                      (    forth6809.asm):10903         ; ------------------------------------------------------------
                      (    forth6809.asm):10904         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10905         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10906         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10907         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10908         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10909         ; sequential walk-through per region.
                      (    forth6809.asm):10910         ;
                      (    forth6809.asm):10911         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10912         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10913         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10914         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10915         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10916         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10917         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10918         ; ------------------------------------------------------------
C27B BDFC2B           (    forth6809.asm):10919         TSTMEMORY: JSR CRW
C27E 8EC28F           (    forth6809.asm):10920                    LDX   #TSTMEMMSG
C281 3610             (    forth6809.asm):10921                    PSHU  X
C283 CC0006           (    forth6809.asm):10922                    LDD   #6
C286 3606             (    forth6809.asm):10923                    PSHU  D
C288 BDF60B           (    forth6809.asm):10924                    JSR   TYPE
C28B BDFC2B           (    forth6809.asm):10925                    JSR   CRW
                      (    forth6809.asm):10926         
                      (    forth6809.asm):10927                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10928         
                      (    forth6809.asm):10929                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10930                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10931                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10932                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10933                    JSR   TSTCODEHERE
                      (    forth6809.asm):10934                    JSR   TSTVARHERE
                      (    forth6809.asm):10935                    JSR   TSTPAD
                      (    forth6809.asm):10936                    JSR   TSTUNUSED
                      (    forth6809.asm):10937                    JSR   TSTVUNUSED
                      (    forth6809.asm):10938                    JSR   TSTFILL
                      (    forth6809.asm):10939                    JSR   TSTERASE
                      (    forth6809.asm):10940                    JSR   TSTCMOVE
                      (    forth6809.asm):10941                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10942                    JSR   TSTMOVE1
                      (    forth6809.asm):10943                    JSR   TSTMOVE2
                      (    forth6809.asm):10944                    JSR   TSTMOVE3
                      (    forth6809.asm):10945         
                      (    forth6809.asm):10946                    ENDC ; <<<<
                      (    forth6809.asm):10947         
C28E 39               (    forth6809.asm):10948                    RTS
                      (    forth6809.asm):10949         
C28F 4D656D6F7279     (    forth6809.asm):10950         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10951         
                      (    forth6809.asm):10952                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10953         
                      (    forth6809.asm):10954         ; ------------------------------------------------------------
                      (    forth6809.asm):10955         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10956         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10957         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10958         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10959         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10960         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10961         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10962         ; runs exclusively of every other.
                      (    forth6809.asm):10963         ;
                      (    forth6809.asm):10964         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10965         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10966         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10967         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10968         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10969         ; ------------------------------------------------------------
                      (    forth6809.asm):10970         
                      (    forth6809.asm):10971         ; ------------------------------------------------------------
                      (    forth6809.asm):10972         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10973         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10974         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10975         ; ------------------------------------------------------------
C295                  (    forth6809.asm):10976         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10977         
                      (    forth6809.asm):10978                        LDD  #TSTGUARD
                      (    forth6809.asm):10979                        PSHU D
                      (    forth6809.asm):10980                        LDD  #TSTVAL1
                      (    forth6809.asm):10981                        PSHU D
                      (    forth6809.asm):10982                        LDD  #TSTCBUF
                      (    forth6809.asm):10983                        PSHU D
                      (    forth6809.asm):10984                        STU  TSTUB4
                      (    forth6809.asm):10985         
                      (    forth6809.asm):10986                        JSR  STOREW
                      (    forth6809.asm):10987         
                      (    forth6809.asm):10988                        LDD  #TSTCBUF
                      (    forth6809.asm):10989                        PSHU D
                      (    forth6809.asm):10990         
                      (    forth6809.asm):10991                        JSR  ATSIGN
                      (    forth6809.asm):10992         
                      (    forth6809.asm):10993                        STU  TSTUAF
                      (    forth6809.asm):10994         
                      (    forth6809.asm):10995                        PULU D
                      (    forth6809.asm):10996                        CMPD #TSTVAL1
                      (    forth6809.asm):10997                        BNE  FSFAIL
                      (    forth6809.asm):10998                        PULU D
                      (    forth6809.asm):10999                        CMPD #TSTGUARD
                      (    forth6809.asm):11000                        BNE  FSFAIL
                      (    forth6809.asm):11001         
                      (    forth6809.asm):11002                        LDD  TSTUB4
                      (    forth6809.asm):11003                        SUBD TSTUAF
                      (    forth6809.asm):11004                        CMPD #-2
                      (    forth6809.asm):11005                        BNE  FSFAIL
                      (    forth6809.asm):11006         
                      (    forth6809.asm):11007                        LDD  #TRUEV
                      (    forth6809.asm):11008                        BRA  FSDONE
C295                  (    forth6809.asm):11009         FSFAIL:        LDD  #FALSEV
C295                  (    forth6809.asm):11010         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):11011                        PSHU X
                      (    forth6809.asm):11012                        PSHU D
                      (    forth6809.asm):11013                        JSR  TSTREPORT
                      (    forth6809.asm):11014         
                      (    forth6809.asm):11015                        LDU  TSTU0
                      (    forth6809.asm):11016                        RTS
                      (    forth6809.asm):11017         
C295                  (    forth6809.asm):11018         TSTFSNAME: FCB  13
                      (    forth6809.asm):11019                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):11020         
                      (    forth6809.asm):11021         ; ------------------------------------------------------------
                      (    forth6809.asm):11022         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):11023         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):11024         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):11025         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):11026         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):11027         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):11028         ; whatever was there).
                      (    forth6809.asm):11029         ;
                      (    forth6809.asm):11030         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):11031         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):11032         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):11033         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):11034         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):11035         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):11036         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):11037         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):11038         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):11039         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):11040         ; byte ends up where was wrong.
                      (    forth6809.asm):11041         ; ------------------------------------------------------------
C295                  (    forth6809.asm):11042         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):11043                         STD  TSTCBUF
                      (    forth6809.asm):11044         
                      (    forth6809.asm):11045                         STU  TSTU0
                      (    forth6809.asm):11046         
                      (    forth6809.asm):11047                         LDD  #TSTGUARD
                      (    forth6809.asm):11048                         PSHU D
                      (    forth6809.asm):11049                         LDD  #$34
                      (    forth6809.asm):11050                         PSHU D
                      (    forth6809.asm):11051                         LDD  #TSTCBUF
                      (    forth6809.asm):11052                         PSHU D
                      (    forth6809.asm):11053                         STU  TSTUB4
                      (    forth6809.asm):11054         
                      (    forth6809.asm):11055                         JSR  CSTOREW
                      (    forth6809.asm):11056         
                      (    forth6809.asm):11057                         LDD  TSTCBUF
                      (    forth6809.asm):11058                         CMPD #$34FF
                      (    forth6809.asm):11059                         BNE  CFFAIL
                      (    forth6809.asm):11060         
                      (    forth6809.asm):11061                         LDD  #TSTCBUF
                      (    forth6809.asm):11062                         PSHU D
                      (    forth6809.asm):11063         
                      (    forth6809.asm):11064                         JSR  CFETCH
                      (    forth6809.asm):11065         
                      (    forth6809.asm):11066                         STU  TSTUAF
                      (    forth6809.asm):11067         
                      (    forth6809.asm):11068                         PULU D
                      (    forth6809.asm):11069                         CMPD #$0034
                      (    forth6809.asm):11070                         BNE  CFFAIL
                      (    forth6809.asm):11071                         PULU D
                      (    forth6809.asm):11072                         CMPD #TSTGUARD
                      (    forth6809.asm):11073                         BNE  CFFAIL
                      (    forth6809.asm):11074         
                      (    forth6809.asm):11075                         LDD  TSTUB4
                      (    forth6809.asm):11076                         SUBD TSTUAF
                      (    forth6809.asm):11077                         CMPD #-2
                      (    forth6809.asm):11078                         BNE  CFFAIL
                      (    forth6809.asm):11079         
                      (    forth6809.asm):11080                         LDD  #TRUEV
                      (    forth6809.asm):11081                         BRA  CFDONE
C295                  (    forth6809.asm):11082         CFFAIL:         LDD  #FALSEV
C295                  (    forth6809.asm):11083         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11084                         PSHU X
                      (    forth6809.asm):11085                         PSHU D
                      (    forth6809.asm):11086                         JSR  TSTREPORT
                      (    forth6809.asm):11087         
                      (    forth6809.asm):11088                         LDU  TSTU0
                      (    forth6809.asm):11089                         RTS
                      (    forth6809.asm):11090         
C295                  (    forth6809.asm):11091         TSTCFNAME: FCB  14
                      (    forth6809.asm):11092                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11093         
                      (    forth6809.asm):11094         ; ------------------------------------------------------------
                      (    forth6809.asm):11095         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11096         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11097         ; correctly.
                      (    forth6809.asm):11098         ; ------------------------------------------------------------
C295                  (    forth6809.asm):11099         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11100                       STD  TSTCBUF
                      (    forth6809.asm):11101         
                      (    forth6809.asm):11102                       STU  TSTU0
                      (    forth6809.asm):11103         
                      (    forth6809.asm):11104                       LDD  #TSTGUARD
                      (    forth6809.asm):11105                       PSHU D
                      (    forth6809.asm):11106                       LDD  #100
                      (    forth6809.asm):11107                       PSHU D
                      (    forth6809.asm):11108                       LDD  #TSTCBUF
                      (    forth6809.asm):11109                       PSHU D
                      (    forth6809.asm):11110                       STU  TSTUB4
                      (    forth6809.asm):11111         
                      (    forth6809.asm):11112                       JSR  PLUSSTORE
                      (    forth6809.asm):11113         
                      (    forth6809.asm):11114                       STU  TSTUAF
                      (    forth6809.asm):11115         
                      (    forth6809.asm):11116                       LDD  TSTCBUF
                      (    forth6809.asm):11117                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11118                       BNE  PSFAIL
                      (    forth6809.asm):11119         
                      (    forth6809.asm):11120                       PULU D
                      (    forth6809.asm):11121                       CMPD #TSTGUARD
                      (    forth6809.asm):11122                       BNE  PSFAIL
                      (    forth6809.asm):11123         
                      (    forth6809.asm):11124                       LDD  TSTUB4
                      (    forth6809.asm):11125                       SUBD TSTUAF
                      (    forth6809.asm):11126                       CMPD #-4
                      (    forth6809.asm):11127                       BNE  PSFAIL
                      (    forth6809.asm):11128         
                      (    forth6809.asm):11129                       LDD  #TRUEV
                      (    forth6809.asm):11130                       BRA  PSDONE
C295                  (    forth6809.asm):11131         PSFAIL:       LDD  #FALSEV
C295                  (    forth6809.asm):11132         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11133                       PSHU X
                      (    forth6809.asm):11134                       PSHU D
                      (    forth6809.asm):11135                       JSR  TSTREPORT
                      (    forth6809.asm):11136         
                      (    forth6809.asm):11137                       LDU  TSTU0
                      (    forth6809.asm):11138                       RTS
                      (    forth6809.asm):11139         
C295                  (    forth6809.asm):11140         TSTPSNAME: FCB  12
                      (    forth6809.asm):11141                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11142         
                      (    forth6809.asm):11143         ; ------------------------------------------------------------
                      (    forth6809.asm):11144         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11145         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11146         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11147         ; the documented convention on both ends).
                      (    forth6809.asm):11148         ; ------------------------------------------------------------
C295                  (    forth6809.asm):11149         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11150         
                      (    forth6809.asm):11151                         LDD  #TSTGUARD
                      (    forth6809.asm):11152                         PSHU D
                      (    forth6809.asm):11153                         LDD  #TSTVAL1
                      (    forth6809.asm):11154                         PSHU D
                      (    forth6809.asm):11155                         LDD  #TSTVAL2
                      (    forth6809.asm):11156                         PSHU D
                      (    forth6809.asm):11157                         LDD  #TSTCBUF
                      (    forth6809.asm):11158                         PSHU D
                      (    forth6809.asm):11159                         STU  TSTUB4
                      (    forth6809.asm):11160         
                      (    forth6809.asm):11161                         JSR  DSTORE
                      (    forth6809.asm):11162         
                      (    forth6809.asm):11163                         LDD  #TSTCBUF
                      (    forth6809.asm):11164                         PSHU D
                      (    forth6809.asm):11165         
                      (    forth6809.asm):11166                         JSR  DFETCH
                      (    forth6809.asm):11167         
                      (    forth6809.asm):11168                         STU  TSTUAF
                      (    forth6809.asm):11169         
                      (    forth6809.asm):11170                         PULU D
                      (    forth6809.asm):11171                         CMPD #TSTVAL2
                      (    forth6809.asm):11172                         BNE  DFFAIL
                      (    forth6809.asm):11173                         PULU D
                      (    forth6809.asm):11174                         CMPD #TSTVAL1
                      (    forth6809.asm):11175                         BNE  DFFAIL
                      (    forth6809.asm):11176                         PULU D
                      (    forth6809.asm):11177                         CMPD #TSTGUARD
                      (    forth6809.asm):11178                         BNE  DFFAIL
                      (    forth6809.asm):11179         
                      (    forth6809.asm):11180                         LDD  TSTUB4
                      (    forth6809.asm):11181                         SUBD TSTUAF
                      (    forth6809.asm):11182                         CMPD #-2
                      (    forth6809.asm):11183                         BNE  DFFAIL
                      (    forth6809.asm):11184         
                      (    forth6809.asm):11185                         LDD  TSTCBUF
                      (    forth6809.asm):11186                         CMPD #TSTVAL1

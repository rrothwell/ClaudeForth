DCCD 7F0179           (    forth6809.asm):01594                     CLR   OUTHEAD
DCD0 7F017A           (    forth6809.asm):01595                     CLR   OUTTAIL
DCD3 7F017B           (    forth6809.asm):01596                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01597         
                      (    forth6809.asm):01598         
DCD6 7F017C           (    forth6809.asm):01599                     CLR   FECOUNT

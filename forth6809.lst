E5A3 DC29             (    forth6809.asm):03851                     LDD   MSCR
E5A5 3606             (    forth6809.asm):03852                     PSHU  D
E5A7 BDE534           (    forth6809.asm):03853                     JSR   PATCH
E5AA DC46             (    forth6809.asm):03854                     LDD   NEWFLD
E5AC 3606             (    forth6809.asm):03855                     PSHU  D                 ; orig2
E5AE CC0001           (    forth6809.asm):03856                     LDD   #TAGFWD
E5B1 3606             (    forth6809.asm):03857                     PSHU  D
E5B3 39               (    forth6809.asm):03858                     RTS
                      (    forth6809.asm):03859         
                      (    forth6809.asm):03860         ; ------------------------------------------------------------
                      (    forth6809.asm):03861         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03862         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03863         ; stack.
                      (    forth6809.asm):03864         ; ------------------------------------------------------------
E5B4 DC08             (    forth6809.asm):03865         BEGINW:     LDD   CODEHERE
E5B6 3606             (    forth6809.asm):03866                     PSHU  D                 ; dest
E5B8 CC0002           (    forth6809.asm):03867                     LDD   #TAGBACK
E5BB 3606             (    forth6809.asm):03868                     PSHU  D
E5BD 39               (    forth6809.asm):03869                     RTS
                      (    forth6809.asm):03870         
                      (    forth6809.asm):03871         ; ------------------------------------------------------------
                      (    forth6809.asm):03872         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03873         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03874         ; ------------------------------------------------------------
E5BE 3706             (    forth6809.asm):03875         UNTILW:     PULU  D
E5C0 10830002         (    forth6809.asm):03876                     CMPD  #TAGBACK
E5C4 2703             (    forth6809.asm):03877                     BEQ   UNOK
E5C6 BDE4CA           (    forth6809.asm):03878                     JSR   CFERR
E5C9 3706             (    forth6809.asm):03879         UNOK:       PULU  D                 ; dest
E5CB 3606             (    forth6809.asm):03880                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E5CD CCDDE5           (    forth6809.asm):03881                     LDD   #ZBRANCH
E5D0 3606             (    forth6809.asm):03882                     PSHU  D
E5D2 BDE97A           (    forth6809.asm):03883                     JSR   CCALL
E5D5 CC0000           (    forth6809.asm):03884                     LDD   #0
E5D8 3606             (    forth6809.asm):03885                     PSHU  D
E5DA BDDE78           (    forth6809.asm):03886                     JSR   CODECOMMA
E5DD DC08             (    forth6809.asm):03887                     LDD   CODEHERE
E5DF 830002           (    forth6809.asm):03888                     SUBD  #2
E5E2 DD44             (    forth6809.asm):03889                     STD   PFIELD
E5E4 3706             (    forth6809.asm):03890                     PULU  D
E5E6 3606             (    forth6809.asm):03891                     PSHU  D
E5E8 DC44             (    forth6809.asm):03892                     LDD   PFIELD
E5EA 3606             (    forth6809.asm):03893                     PSHU  D
E5EC BDE534           (    forth6809.asm):03894                     JSR   PATCH
E5EF 39               (    forth6809.asm):03895                     RTS
                      (    forth6809.asm):03896         
                      (    forth6809.asm):03897         ; ------------------------------------------------------------
                      (    forth6809.asm):03898         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03899         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03900         ; ------------------------------------------------------------
E5F0 3706             (    forth6809.asm):03901         AGAINW:     PULU  D
E5F2 10830002         (    forth6809.asm):03902                     CMPD  #TAGBACK
E5F6 2703             (    forth6809.asm):03903                     BEQ   AGOK
E5F8 BDE4CA           (    forth6809.asm):03904                     JSR   CFERR
E5FB 3706             (    forth6809.asm):03905         AGOK:       PULU  D                 ; dest
E5FD 3606             (    forth6809.asm):03906                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E5FF CCDDFB           (    forth6809.asm):03907                     LDD   #BRANCH
E602 3606             (    forth6809.asm):03908                     PSHU  D
E604 BDE97A           (    forth6809.asm):03909                     JSR   CCALL
E607 CC0000           (    forth6809.asm):03910                     LDD   #0
E60A 3606             (    forth6809.asm):03911                     PSHU  D
E60C BDDE78           (    forth6809.asm):03912                     JSR   CODECOMMA
E60F DC08             (    forth6809.asm):03913                     LDD   CODEHERE
E611 830002           (    forth6809.asm):03914                     SUBD  #2
E614 DD44             (    forth6809.asm):03915                     STD   PFIELD
E616 3706             (    forth6809.asm):03916                     PULU  D
E618 3606             (    forth6809.asm):03917                     PSHU  D
E61A DC44             (    forth6809.asm):03918                     LDD   PFIELD
E61C 3606             (    forth6809.asm):03919                     PSHU  D
E61E BDE534           (    forth6809.asm):03920                     JSR   PATCH
E621 39               (    forth6809.asm):03921                     RTS
                      (    forth6809.asm):03922         
                      (    forth6809.asm):03923         ; ------------------------------------------------------------
                      (    forth6809.asm):03924         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03925         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03926         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03927         ; ------------------------------------------------------------
E622 CCDDE5           (    forth6809.asm):03928         WHILEW:     LDD   #ZBRANCH
E625 3606             (    forth6809.asm):03929                     PSHU  D
E627 BDE97A           (    forth6809.asm):03930                     JSR   CCALL
E62A CC0000           (    forth6809.asm):03931                     LDD   #0
E62D 3606             (    forth6809.asm):03932                     PSHU  D
E62F BDDE78           (    forth6809.asm):03933                     JSR   CODECOMMA
E632 DC08             (    forth6809.asm):03934                     LDD   CODEHERE
E634 830002           (    forth6809.asm):03935                     SUBD  #2
E637 3606             (    forth6809.asm):03936                     PSHU  D                 ; orig
E639 CC0001           (    forth6809.asm):03937                     LDD   #TAGFWD
E63C 3606             (    forth6809.asm):03938                     PSHU  D
E63E 39               (    forth6809.asm):03939                     RTS
                      (    forth6809.asm):03940         
                      (    forth6809.asm):03941         ; ------------------------------------------------------------
                      (    forth6809.asm):03942         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03943         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03944         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03945         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03946         ; ------------------------------------------------------------
E63F 3706             (    forth6809.asm):03947         REPEATW:    PULU  D
E641 10830001         (    forth6809.asm):03948                     CMPD  #TAGFWD
E645 2703             (    forth6809.asm):03949                     BEQ   RPOK1
E647 BDE4CA           (    forth6809.asm):03950                     JSR   CFERR
E64A 3710             (    forth6809.asm):03951         RPOK1:      PULU  X                 ; orig
E64C 9F46             (    forth6809.asm):03952                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03953         
                      (    forth6809.asm):03954                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03955                     ; See bugfix: REPEATW.1
E64E 3040             (    forth6809.asm):03956                     LEAX  0,U               ; scan from top of control stack
E650 9F2B             (    forth6809.asm):03957                     STX   MSCR2             ; MSCR2 = base of scan region
E652 9F2F             (    forth6809.asm):03958                     STX   MSCR4             ; MSCR4 = scan pointer
E654 DC2F             (    forth6809.asm):03959         RPSCAN:     LDD   MSCR4
E656 109348           (    forth6809.asm):03960                     CMPD  CSP
E659 2603             (    forth6809.asm):03961                     BNE   RPSCANOK
E65B BDE4CA           (    forth6809.asm):03962                     JSR   CFERR             ; no matching BEGIN
E65E 9E2F             (    forth6809.asm):03963         RPSCANOK:   LDX   MSCR4
E660 EC84             (    forth6809.asm):03964                     LDD   ,X
E662 10830002         (    forth6809.asm):03965                     CMPD  #TAGBACK
E666 2712             (    forth6809.asm):03966                     BEQ   RPFOUND
E668 10830001         (    forth6809.asm):03967                     CMPD  #TAGFWD
E66C 2703             (    forth6809.asm):03968                     BEQ   RPSKIP
E66E BDE4CA           (    forth6809.asm):03969                     JSR   CFERR             ; anything else is a genuine mismatch
E671 DC2F             (    forth6809.asm):03970         RPSKIP:     LDD   MSCR4
E673 C30004           (    forth6809.asm):03971                     ADDD  #4
E676 DD2F             (    forth6809.asm):03972                     STD   MSCR4
E678 20DA             (    forth6809.asm):03973                     BRA   RPSCAN
E67A 9E2F             (    forth6809.asm):03974         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E67C EC02             (    forth6809.asm):03975                     LDD   2,X               ; dest = BEGIN's address
E67E DD44             (    forth6809.asm):03976                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):03977         
                      (    forth6809.asm):03978                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03979                     ; bytes, highest word first.
E680 DC2F             (    forth6809.asm):03980                     LDD   MSCR4
E682 932B             (    forth6809.asm):03981                     SUBD  MSCR2
E684 DD2D             (    forth6809.asm):03982                     STD   MSCR3             ; MSCR3 = bytes to shift
E686 2715             (    forth6809.asm):03983                     BEQ   RPSHIFTDONE
E688 DC2D             (    forth6809.asm):03984         RPSHIFT:    LDD   MSCR3
E68A 830002           (    forth6809.asm):03985                     SUBD  #2
E68D DD2D             (    forth6809.asm):03986                     STD   MSCR3
E68F 9E2B             (    forth6809.asm):03987                     LDX   MSCR2
E691 308B             (    forth6809.asm):03988                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E693 EC84             (    forth6809.asm):03989                     LDD   ,X
E695 3004             (    forth6809.asm):03990                     LEAX  4,X
E697 ED84             (    forth6809.asm):03991                     STD   ,X                ; copy one word 4 bytes higher
E699 DC2D             (    forth6809.asm):03992                     LDD   MSCR3
E69B 26EB             (    forth6809.asm):03993                     BNE   RPSHIFT
E69D                  (    forth6809.asm):03994         RPSHIFTDONE:
E69D 9E2B             (    forth6809.asm):03995                     LDX   MSCR2
E69F 3004             (    forth6809.asm):03996                     LEAX  4,X
E6A1 1F13             (    forth6809.asm):03997                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03998         
E6A3 CCDDFB           (    forth6809.asm):03999                     LDD   #BRANCH
E6A6 3606             (    forth6809.asm):04000                     PSHU  D
E6A8 BDE97A           (    forth6809.asm):04001                     JSR   CCALL
E6AB CC0000           (    forth6809.asm):04002                     LDD   #0
E6AE 3606             (    forth6809.asm):04003                     PSHU  D
E6B0 BDDE78           (    forth6809.asm):04004                     JSR   CODECOMMA
E6B3 DC08             (    forth6809.asm):04005                     LDD   CODEHERE
E6B5 830002           (    forth6809.asm):04006                     SUBD  #2
E6B8 DD2D             (    forth6809.asm):04007                     STD   MSCR3             ; MSCR3 = branch operand address
E6BA DC44             (    forth6809.asm):04008                     LDD   PFIELD            ; target = BEGIN's address
E6BC 3606             (    forth6809.asm):04009                     PSHU  D
E6BE DC2D             (    forth6809.asm):04010                     LDD   MSCR3             ; location = the operand just compiled
E6C0 3606             (    forth6809.asm):04011                     PSHU  D
E6C2 BDE534           (    forth6809.asm):04012                     JSR   PATCH
E6C5 DC08             (    forth6809.asm):04013                     LDD   CODEHERE
E6C7 3606             (    forth6809.asm):04014                     PSHU  D
E6C9 DC46             (    forth6809.asm):04015                     LDD   NEWFLD
E6CB 3606             (    forth6809.asm):04016                     PSHU  D
E6CD BDE534           (    forth6809.asm):04017                     JSR   PATCH
E6D0 39               (    forth6809.asm):04018                     RTS
                      (    forth6809.asm):04019         
                      (    forth6809.asm):04020         ; ------------------------------------------------------------
                      (    forth6809.asm):04021         ; RECURSE  ( -- )
                      (    forth6809.asm):04022         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):04023         ; the xt held in CURXT.
                      (    forth6809.asm):04024         ; ------------------------------------------------------------
E6D1 DC3D             (    forth6809.asm):04025         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E6D3 3606             (    forth6809.asm):04026                     PSHU  D                 ; See bugfix: RECURSEW.1
E6D5 BDE97A           (    forth6809.asm):04027                     JSR   CCALL
E6D8 39               (    forth6809.asm):04028                     RTS
                      (    forth6809.asm):04029         
                      (    forth6809.asm):04030         ; ------------------------------------------------------------
                      (    forth6809.asm):04031         ; DO  ( C: -- dest )
                      (    forth6809.asm):04032         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04033         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04034         ; ------------------------------------------------------------
E6D9 CCE6EB           (    forth6809.asm):04035         DOW:        LDD   #DOSETUP
E6DC 3606             (    forth6809.asm):04036                     PSHU  D
E6DE BDE97A           (    forth6809.asm):04037                     JSR   CCALL
E6E1 DC08             (    forth6809.asm):04038                     LDD   CODEHERE
E6E3 3606             (    forth6809.asm):04039                     PSHU  D                 ; dest
E6E5 CC0003           (    forth6809.asm):04040                     LDD   #TAGDO
E6E8 3606             (    forth6809.asm):04041                     PSHU  D
E6EA 39               (    forth6809.asm):04042                     RTS
                      (    forth6809.asm):04043         
                      (    forth6809.asm):04044         ; ------------------------------------------------------------
                      (    forth6809.asm):04045         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04046         ; return address.
                      (    forth6809.asm):04047         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04048         ;    Inputs:
                      (    forth6809.asm):04049         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04050         ;    Outputs:
                      (    forth6809.asm):04051         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04052         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04053         ; ------------------------------------------------------------
E6EB 3706             (    forth6809.asm):04054         DOSETUP:    PULU  D                 ; index
E6ED DD29             (    forth6809.asm):04055                     STD   MSCR
E6EF 3706             (    forth6809.asm):04056                     PULU  D                 ; limit
E6F1 DD2B             (    forth6809.asm):04057                     STD   MSCR2
E6F3 3510             (    forth6809.asm):04058                     PULS  X
E6F5 CC0000           (    forth6809.asm):04059                     LDD   #0
E6F8 3406             (    forth6809.asm):04060                     PSHS  D
E6FA DC2B             (    forth6809.asm):04061                     LDD   MSCR2
E6FC 3406             (    forth6809.asm):04062                     PSHS  D
E6FE DC29             (    forth6809.asm):04063                     LDD   MSCR
E700 3406             (    forth6809.asm):04064                     PSHS  D
E702 3410             (    forth6809.asm):04065                     PSHS  X
E704 39               (    forth6809.asm):04066                     RTS
                      (    forth6809.asm):04067         
                      (    forth6809.asm):04068         ; ------------------------------------------------------------
                      (    forth6809.asm):04069         ; I  ( -- n )
                      (    forth6809.asm):04070         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04071         ; address).
                      (    forth6809.asm):04072         ; ------------------------------------------------------------
E705 EC62             (    forth6809.asm):04073         IW:         LDD   2,S               ; n. See bugfix: IW.1
E707 3606             (    forth6809.asm):04074                     PSHU  D
E709 39               (    forth6809.asm):04075                     RTS
                      (    forth6809.asm):04076         
                      (    forth6809.asm):04077         ; ------------------------------------------------------------
                      (    forth6809.asm):04078         ; J  ( -- n )
                      (    forth6809.asm):04079         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04080         ; address and the inner loop frame).
                      (    forth6809.asm):04081         ; ------------------------------------------------------------
E70A EC68             (    forth6809.asm):04082         JW:         LDD   8,S               ; n. See bugfix: JW.1
E70C 3606             (    forth6809.asm):04083                     PSHU  D
E70E 39               (    forth6809.asm):04084                     RTS
                      (    forth6809.asm):04085         
                      (    forth6809.asm):04086         ; ------------------------------------------------------------
                      (    forth6809.asm):04087         ; LEAVE  ( -- )
                      (    forth6809.asm):04088         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04089         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04090         ; ------------------------------------------------------------
E70F CCFFFF           (    forth6809.asm):04091         LEAVEW:     LDD   #TRUEV            ; true
E712 ED66             (    forth6809.asm):04092                     STD   6,S               ; See bugfix: LEAVEW.1
E714 39               (    forth6809.asm):04093                     RTS
                      (    forth6809.asm):04094         
                      (    forth6809.asm):04095         ; ------------------------------------------------------------
                      (    forth6809.asm):04096         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04097         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04098         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04099         ; ------------------------------------------------------------
E715 3706             (    forth6809.asm):04100         LOOPW:      PULU  D
E717 10830003         (    forth6809.asm):04101                     CMPD  #TAGDO
E71B 2703             (    forth6809.asm):04102                     BEQ   LOOPOK
E71D BDE4CA           (    forth6809.asm):04103                     JSR   CFERR
E720 3706             (    forth6809.asm):04104         LOOPOK:     PULU  D                 ; dest
E722 3606             (    forth6809.asm):04105                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E724 CCE75C           (    forth6809.asm):04106                     LDD   #DOTEST
E727 3606             (    forth6809.asm):04107                     PSHU  D
E729 BDE97A           (    forth6809.asm):04108                     JSR   CCALL
E72C CC0000           (    forth6809.asm):04109                     LDD   #0
E72F 3606             (    forth6809.asm):04110                     PSHU  D
E731 BDDE78           (    forth6809.asm):04111                     JSR   CODECOMMA
E734 DC08             (    forth6809.asm):04112                     LDD   CODEHERE
E736 830002           (    forth6809.asm):04113                     SUBD  #2
E739 DD44             (    forth6809.asm):04114                     STD   PFIELD
E73B 3706             (    forth6809.asm):04115                     PULU  D
E73D 3606             (    forth6809.asm):04116                     PSHU  D
E73F DC44             (    forth6809.asm):04117                     LDD   PFIELD
E741 3606             (    forth6809.asm):04118                     PSHU  D
E743 BDE534           (    forth6809.asm):04119                     JSR   PATCH
                      (    forth6809.asm):04120         
E746 ECC4             (    forth6809.asm):04121                     LDD   ,U
E748 10830007         (    forth6809.asm):04122                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E74C 260D             (    forth6809.asm):04123                     BNE   LOOPDONE
E74E 3706             (    forth6809.asm):04124                     PULU  D
E750 3710             (    forth6809.asm):04125                     PULU  X                 ; ?DO skip operand
E752 DC08             (    forth6809.asm):04126                     LDD   CODEHERE
E754 3606             (    forth6809.asm):04127                     PSHU  D
E756 3610             (    forth6809.asm):04128                     PSHU  X
E758 BDE534           (    forth6809.asm):04129                     JSR   PATCH
E75B 39               (    forth6809.asm):04130         LOOPDONE:   RTS
                      (    forth6809.asm):04131         
                      (    forth6809.asm):04132         ; ------------------------------------------------------------
                      (    forth6809.asm):04133         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04134         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04135         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04136         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04137         ; DOTEST
                      (    forth6809.asm):04138         ;    Inputs:

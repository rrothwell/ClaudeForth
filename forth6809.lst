                      (    forth6809.asm):11188                         SUBD TSTUAF
                      (    forth6809.asm):11189                         CMPD #-2
                      (    forth6809.asm):11190                         BNE  DFFAIL
                      (    forth6809.asm):11191         
                      (    forth6809.asm):11192                         LDD  TSTCBUF
                      (    forth6809.asm):11193                         CMPD #TSTVAL1
                      (    forth6809.asm):11194                         BNE  DFFAIL

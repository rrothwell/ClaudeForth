                      (    forth6809.asm):09785         ; TSTTICK2 - unit test for ' (tick), not-found case. Redirects
                      (    forth6809.asm):09786         ; LATEST to an empty chain (0, the standard chain-terminator
                      (    forth6809.asm):09787         ; sentinel used throughout this ROM), so FIND has nothing to
                      (    forth6809.asm):09788         ; match. Verifies -13 via CATCH.
                      (    forth6809.asm):09789         ; ------------------------------------------------------------

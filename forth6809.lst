                      (    forth6809.asm):12743                     STD  SRCLEN
                      (    forth6809.asm):12744                     LDD  TSTTISAV
                      (    forth6809.asm):12745                     STD  TOIN
                      (    forth6809.asm):12746                     LDD  TSTSTSAV
                      (    forth6809.asm):12747                     STD  STATE

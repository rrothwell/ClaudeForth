                      (    forth6809.asm):00368         ; GLOBALS - real layout, applied. Every scratch/state cell
                      (    forth6809.asm):00369         ; referenced across the whole build now has a fixed address
                      (    forth6809.asm):00370         ; in page zero (DP = $00 at reset, set in COLDSTRT), laid out
                      (    forth6809.asm):00371         ; in RMB order below. Total: 256 of 256 bytes used - the page
                      (    forth6809.asm):00372         ; is fully packed. (DOESBEH and RTSSTATE were added in later
                      (    forth6809.asm):00373         ; passes, after this comment was first written with 253/256;
                      (    forth6809.asm):00374         ; they used up the last 3 bytes of headroom entirely.)
                      (    forth6809.asm):00375         ;
                      (    forth6809.asm):00376         ; SNEND, which appeared in the original placeholder list
                      (    forth6809.asm):00377         ; (documented under S"/."/SLITERAL/ABORT"'s string runtime),
                      (    forth6809.asm):00378         ; was dropped here: a full pass over every reference confirmed
                      (    forth6809.asm):00379         ; it is never actually read or written anywhere - SCNT/SPTR
                      (    forth6809.asm):00380         ; alone carry that runtime. CSAVE was removed earlier (see the
                      (    forth6809.asm):00381         ; COMMA/CODECOMMA history) and was never part of this layout.
                      (    forth6809.asm):00382         ; ============================================================

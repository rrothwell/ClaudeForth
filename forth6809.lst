                      (    forth6809.asm):17513         ; ============================================================
                      (    forth6809.asm):17514         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):17515         ; ============================================================
                      (    forth6809.asm):17516                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):17517                                        ; entirely - every routine from here through
                      (    forth6809.asm):17518                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):17519                                        ; every primitive) would otherwise have
                      (    forth6809.asm):17520                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):17521                                        ; WARM message left the location counter,
                      (    forth6809.asm):17522                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):17523                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):17524                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):17525         
                      (    forth6809.asm):17526         ; ------------------------------------------------------------
                      (    forth6809.asm):17527         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):17528         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):17529         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):17530         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):17531         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):17532         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):17533         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):17534                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):17535                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):17536                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):17537                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):17538                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):17539                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):17540                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):17541                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):17542                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):17543                  RTS
                      (    forth6809.asm):17544         
                      (    forth6809.asm):17545                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):17546         ; ------------------------------------------------------------
                      (    forth6809.asm):17547         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):17548         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):17549         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):17550         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):17551         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):17552         INFILL:  LDA   INHEAD
                      (    forth6809.asm):17553                  SUBA  INTAIL
                      (    forth6809.asm):17554                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):17555                  RTS
                      (    forth6809.asm):17556         
                      (    forth6809.asm):17557         ; ------------------------------------------------------------
                      (    forth6809.asm):17558         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):17559         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):17560         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):17561         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):17562         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):17563         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):17564         ; flow control, not a chip feature.
                      (    forth6809.asm):17565         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):17566         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):17567                     CMPA #INHIWATER
                      (    forth6809.asm):17568                     BLO  RTSCHIDONE
                      (    forth6809.asm):17569                     TST  RTSSTATE
                      (    forth6809.asm):17570                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):17571                     LDA  #CR_RTSHI
                      (    forth6809.asm):17572                     STA  ACIACR
                      (    forth6809.asm):17573                     LDA  #1
                      (    forth6809.asm):17574                     STA  RTSSTATE
DEF5                  (    forth6809.asm):17575         RTSCHIDONE: RTS
                      (    forth6809.asm):17576         
                      (    forth6809.asm):17577         ; ------------------------------------------------------------
                      (    forth6809.asm):17578         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):17579         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):17580         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):17581         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):17582         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):17583         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):17584         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):17585         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):17586         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):17587         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):17588         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):17589                     CMPA #INLOWATER
                      (    forth6809.asm):17590                     BHI  RTSCLODONE
                      (    forth6809.asm):17591                     TST  RTSSTATE
                      (    forth6809.asm):17592                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):17593                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):17594                     CLR  RTSSTATE
                      (    forth6809.asm):17595                     LDB  OUTTAIL
                      (    forth6809.asm):17596                     CMPB OUTHEAD
                      (    forth6809.asm):17597                     BEQ  RTSCLONOTX
                      (    forth6809.asm):17598                     LDA  #CR_RXTX
                      (    forth6809.asm):17599                     STA  ACIACR
                      (    forth6809.asm):17600                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):17601         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):17602                     STA  ACIACR
DEF5                  (    forth6809.asm):17603         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):17604         RTSCLODONE: RTS
                      (    forth6809.asm):17605         
DEF5                  (    forth6809.asm):17606         IRQH:    LDA   ACIASR
                      (    forth6809.asm):17607                  BITA  #SR_IRQ
                      (    forth6809.asm):17608                  BEQ   IRQDONE
                      (    forth6809.asm):17609         
                      (    forth6809.asm):17610                  BITA  #SR_RDRF
                      (    forth6809.asm):17611                  BEQ   TXCHK
                      (    forth6809.asm):17612         
                      (    forth6809.asm):17613                  LDB   INHEAD
                      (    forth6809.asm):17614                  LDA   ACIADR
                      (    forth6809.asm):17615                  LDX   #INBUF
                      (    forth6809.asm):17616                  STA   B,X
                      (    forth6809.asm):17617                  INCB
                      (    forth6809.asm):17618                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):17619                  CMPB  INTAIL
                      (    forth6809.asm):17620                  BEQ   IRQDONE
                      (    forth6809.asm):17621                  STB   INHEAD
                      (    forth6809.asm):17622                  JSR   RTSCHECKHI
                      (    forth6809.asm):17623                  BRA   IRQDONE
                      (    forth6809.asm):17624         
DEF5                  (    forth6809.asm):17625         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):17626                  CMPB  OUTHEAD
                      (    forth6809.asm):17627                  BEQ   TXOFF
                      (    forth6809.asm):17628                  LDX   #OUTBUF
                      (    forth6809.asm):17629                  LDA   B,X
                      (    forth6809.asm):17630                  STA   ACIADR
                      (    forth6809.asm):17631                  INCB
                      (    forth6809.asm):17632                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):17633                  STB   OUTTAIL
                      (    forth6809.asm):17634                  BRA   IRQDONE
                      (    forth6809.asm):17635         
DEF5                  (    forth6809.asm):17636         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):17637                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,

C267 3610             (    forth6809.asm):09523                    PSHU  X
C269 CC0009           (    forth6809.asm):09524                    LDD   #9
C26C 3606             (    forth6809.asm):09525                    PSHU  D
C26E BDF60B           (    forth6809.asm):09526                    JSR   TYPE
C271 BDFC2B           (    forth6809.asm):09527                    JSR   CRW

                      (    forth6809.asm):07832         ; ------------------------------------------------------------
                      (    forth6809.asm):07833         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):07834         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):07835         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):07836         ; enter COLD.
                      (    forth6809.asm):07837         ; COLDSTRT
                      (    forth6809.asm):07838         ;    Inputs:
                      (    forth6809.asm):07839         ;        hardware reset
                      (    forth6809.asm):07840         ;    Outputs:
                      (    forth6809.asm):07841         ;        does not return
                      (    forth6809.asm):07842         ;    Registers: all registers initialised.
                      (    forth6809.asm):07843         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):07844         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07845                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):07846                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07847                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07848                     CLRA
FFAE 1F8B             (    forth6809.asm):07849                     TFR   A,DP
                      (    forth6809.asm):07850         
FFB0 8E0000           (    forth6809.asm):07851                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07852                     LDB   #0
FFB5 6F80             (    forth6809.asm):07853         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):07854                     DECB
FFB8 26FB             (    forth6809.asm):07855                     BNE   CLRGLOB
                      (    forth6809.asm):07856         
FFBA BDDCE3           (    forth6809.asm):07857                     JSR   INITSERIAL
                      (    forth6809.asm):07858         
FFBD 1CAF             (    forth6809.asm):07859                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):07860         
                      (    forth6809.asm):07861                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):07862         
                      (    forth6809.asm):07863                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):07864                     JSR   TSTRUNNER
                      (    forth6809.asm):07865                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07866                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):07867                     NOP                     ; See bugfix: COLDSTRT.2
FFC1 12               (    forth6809.asm):07868                     NOP
                      (    forth6809.asm):07869                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):07870         

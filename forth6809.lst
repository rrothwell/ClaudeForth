F48E 3720             (    forth6809.asm):06570                     PULU  Y                 ; c-addr
F490 3610             (    forth6809.asm):06571                     PSHU  X                 ; result c-addr
F492 3606             (    forth6809.asm):06572                     PSHU  D                 ; result u
F494 5D               (    forth6809.asm):06573                     TSTB
F495 2707             (    forth6809.asm):06574                     BEQ   SQIEND
F497 A6A0             (    forth6809.asm):06575         SQICPY:     LDA   ,Y+
F499 A780             (    forth6809.asm):06576                     STA   ,X+
F49B 5A               (    forth6809.asm):06577                     DECB
F49C 26F9             (    forth6809.asm):06578                     BNE   SQICPY
F49E 39               (    forth6809.asm):06579         SQIEND:     RTS
                      (    forth6809.asm):06580         
                      (    forth6809.asm):06581         ; ------------------------------------------------------------
                      (    forth6809.asm):06582         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06583         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):06584         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):06585         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):06586         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):06587         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):06588         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):06589         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):06590         ; A result over 255 characters throws -18.
                      (    forth6809.asm):06591         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):06592         ; ------------------------------------------------------------
F49F BDDFB4           (    forth6809.asm):06593         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F4A2 ECC4             (    forth6809.asm):06594                     LDD   ,U
F4A4 3406             (    forth6809.asm):06595                     PSHS  D                 ; output pointer
F4A6 3406             (    forth6809.asm):06596                     PSHS  D                 ; output start
F4A8 DC39             (    forth6809.asm):06597                     LDD   SRCADDR
F4AA D33B             (    forth6809.asm):06598                     ADDD  SRCLEN
F4AC 3406             (    forth6809.asm):06599                     PSHS  D                 ; input end
F4AE DC39             (    forth6809.asm):06600                     LDD   SRCADDR
F4B0 D310             (    forth6809.asm):06601                     ADDD  TOIN
F4B2 1F02             (    forth6809.asm):06602                     TFR   D,Y               ; input pointer
F4B4 10AC60           (    forth6809.asm):06603         SQEL:       CMPY  0,S
F4B7 247E             (    forth6809.asm):06604                     BHS   SQEND
F4B9 A6A0             (    forth6809.asm):06605                     LDA   ,Y+
F4BB 8122             (    forth6809.asm):06606                     CMPA  #34
F4BD 2778             (    forth6809.asm):06607                     BEQ   SQEND
F4BF 815C             (    forth6809.asm):06608                     CMPA  #92
F4C1 261C             (    forth6809.asm):06609                     BNE   SQEPUT

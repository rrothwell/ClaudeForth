                      (    forth6809.asm):13631         ; TSTUNESCAPE - unit test for UNESCAPE. Source "A%B" (3 chars,
                      (    forth6809.asm):13632         ; one '%' in the middle) doubles the '%' to produce "A%%B" (4
                      (    forth6809.asm):13633         ; chars) - confirmed via its own code and a prior session's
                      (    forth6809.asm):13634         ; already-corrected design comment that this is genuinely a
                      (    forth6809.asm):13635         ; doubling operation, not backslash-sequence decoding. Verifies
                      (    forth6809.asm):13636         ; every output character individually and the grown length,
                      (    forth6809.asm):13637         ; not just that some output was produced.
                      (    forth6809.asm):13638         ; ------------------------------------------------------------
C2B4                  (    forth6809.asm):13639         TSTUNESCAPE: LDA  #'A'
                      (    forth6809.asm):13640                      STA  TSTCBUF
                      (    forth6809.asm):13641                      LDA  #'%'
                      (    forth6809.asm):13642                      STA  TSTCBUF+1
                      (    forth6809.asm):13643                      LDA  #'B'
                      (    forth6809.asm):13644                      STA  TSTCBUF+2
                      (    forth6809.asm):13645         
                      (    forth6809.asm):13646                      STU  TSTU0
                      (    forth6809.asm):13647         
                      (    forth6809.asm):13648                      LDD  #TSTGUARD
                      (    forth6809.asm):13649                      PSHU D
                      (    forth6809.asm):13650                      LDD  #TSTCBUF
                      (    forth6809.asm):13651                      PSHU D
                      (    forth6809.asm):13652                      LDD  #3
                      (    forth6809.asm):13653                      PSHU D
                      (    forth6809.asm):13654                      LDD  #TSTCBUF+10
                      (    forth6809.asm):13655                      PSHU D
                      (    forth6809.asm):13656                      STU  TSTUB4
                      (    forth6809.asm):13657         
                      (    forth6809.asm):13658                      JSR  UNESCAPEW
                      (    forth6809.asm):13659         
                      (    forth6809.asm):13660                      STU  TSTUAF
                      (    forth6809.asm):13661         
                      (    forth6809.asm):13662                      PULU D
                      (    forth6809.asm):13663                      CMPD #4
                      (    forth6809.asm):13664                      BNE  UXFAIL
                      (    forth6809.asm):13665                      PULU D
                      (    forth6809.asm):13666                      CMPD #TSTCBUF+10
                      (    forth6809.asm):13667                      BNE  UXFAIL
                      (    forth6809.asm):13668         
                      (    forth6809.asm):13669                      TFR  D,X
                      (    forth6809.asm):13670                      LDA  ,X
                      (    forth6809.asm):13671                      CMPA #'A'
                      (    forth6809.asm):13672                      BNE  UXFAIL
                      (    forth6809.asm):13673                      LDA  1,X
                      (    forth6809.asm):13674                      CMPA #'%'
                      (    forth6809.asm):13675                      BNE  UXFAIL
                      (    forth6809.asm):13676                      LDA  2,X
                      (    forth6809.asm):13677                      CMPA #'%'
                      (    forth6809.asm):13678                      BNE  UXFAIL
                      (    forth6809.asm):13679                      LDA  3,X
                      (    forth6809.asm):13680                      CMPA #'B'
                      (    forth6809.asm):13681                      BNE  UXFAIL
                      (    forth6809.asm):13682         
                      (    forth6809.asm):13683                      PULU D
                      (    forth6809.asm):13684                      CMPD #TSTGUARD
                      (    forth6809.asm):13685                      BNE  UXFAIL
                      (    forth6809.asm):13686         
                      (    forth6809.asm):13687                      LDD  TSTUB4
                      (    forth6809.asm):13688                      SUBD TSTUAF
                      (    forth6809.asm):13689                      CMPD #-2
                      (    forth6809.asm):13690                      BNE  UXFAIL
                      (    forth6809.asm):13691         
                      (    forth6809.asm):13692                      LDD  #TRUEV
                      (    forth6809.asm):13693                      BRA  UXDONE
C2B4                  (    forth6809.asm):13694         UXFAIL:      LDD  #FALSEV
C2B4                  (    forth6809.asm):13695         UXDONE:      LDX  #TSTUENAME
                      (    forth6809.asm):13696                      PSHU X
                      (    forth6809.asm):13697                      PSHU D
                      (    forth6809.asm):13698                      JSR  TSTREPORT
                      (    forth6809.asm):13699         
                      (    forth6809.asm):13700                      LDU  TSTU0
                      (    forth6809.asm):13701                      RTS
                      (    forth6809.asm):13702         
C2B4                  (    forth6809.asm):13703         TSTUENAME: FCB  11
                      (    forth6809.asm):13704                    FCC  "TSTUNESCAPE"
                      (    forth6809.asm):13705         
                      (    forth6809.asm):13706                    ENDC ; <<<<
                      (    forth6809.asm):13707         
                      (    forth6809.asm):13708         ; ------------------------------------------------------------
                      (    forth6809.asm):13709         ; TSTNUMOUT - numeric output tests (glossary section 3.13, 14
                      (    forth6809.asm):13710         ; words, 13 tests since #S and #> are combined into one test,
                      (    forth6809.asm):13711         ; matching how they're naturally used together as the tail of
                      (    forth6809.asm):13712         ; the standard pictured-output idiom "<# ... #S #>").
                      (    forth6809.asm):13713         ;
                      (    forth6809.asm):13714         ; The pictured-numeric-output core (<# # #S #> HOLD HOLDS) is
                      (    forth6809.asm):13715         ; pure string-building with no I/O, tested directly. SIGN
                      (    forth6809.asm):13716         ; carries real bug-fix history - a prior bare BPL right after
                      (    forth6809.asm):13717         ; PULU didn't affect condition codes on real 6809 hardware, and
                      (    forth6809.asm):13718         ; the bug was masked for every internal caller by caller-side
                      (    forth6809.asm):13719         ; luck (each ran a flag-setting LDD right before calling SIGN).
                      (    forth6809.asm):13720         ; This section's own SIGN test deliberately poisons the flags
                      (    forth6809.asm):13721         ; with an unrelated CMPX immediately before each direct call,
                      (    forth6809.asm):13722         ; so it exercises the exact previously-broken scenario rather
                      (    forth6809.asm):13723         ; than repeating the same kind of luck that hid the bug.
                      (    forth6809.asm):13724         ;
                      (    forth6809.asm):13725         ; The high-level printing words (./U./.R/U.R/?/D./D.R) all
                      (    forth6809.asm):13726         ; produce real output via TYPE/EMIT internally, so each applies
                      (    forth6809.asm):13727         ; the SERIALPOLL-conditional split established in section 3.1 -
                      (    forth6809.asm):13728         ; full OUTHEAD/OUTBUF verification under SERIALPOLL=0, an
                      (    forth6809.asm):13729         ; EMITCH-based last-character check under SERIALPOLL=1. .R/U.R/
                      (    forth6809.asm):13730         ; D.R specifically test the padding path (a width wider than the
                      (    forth6809.asm):13731         ; actual digits), not just a no-padding sanity case. D./D.R use
                      (    forth6809.asm):13732         ; a genuine double-cell value (-100000, computed and verified
                      (    forth6809.asm):13733         ; independently in Python before writing the tests) to exercise
                      (    forth6809.asm):13734         ; the 32-bit negation path, not a value that happens to fit in
                      (    forth6809.asm):13735         ; one cell.
                      (    forth6809.asm):13736         ;
                      (    forth6809.asm):13737         ; Note: this section's own COMPARE-adjacent naming risk doesn't
                      (    forth6809.asm):13738         ; apply here, but every group wrapper name (TSTNUMOUT) and every
                      (    forth6809.asm):13739         ; internal FAIL/DONE prefix was still checked against the whole
                      (    forth6809.asm):13740         ; file before insertion, per the standard practice that caught
                      (    forth6809.asm):13741         ; the TSTCOMPARE collision in the prior section.
                      (    forth6809.asm):13742         ; ------------------------------------------------------------
C2B4 BDFC2B           (    forth6809.asm):13743         TSTNUMOUT: JSR CRW
C2B7 8EC2C8           (    forth6809.asm):13744                    LDX   #TSTNUMOUTMSG
C2BA 3610             (    forth6809.asm):13745                    PSHU  X
C2BC CC0006           (    forth6809.asm):13746                    LDD   #6
C2BF 3606             (    forth6809.asm):13747                    PSHU  D
C2C1 BDF60B           (    forth6809.asm):13748                    JSR   TYPE
C2C4 BDFC2B           (    forth6809.asm):13749                    JSR   CRW
                      (    forth6809.asm):13750         
                      (    forth6809.asm):13751                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13752         
                      (    forth6809.asm):13753                    JSR   TSTLTNUM
                      (    forth6809.asm):13754                    JSR   TSTHOLD
                      (    forth6809.asm):13755                    JSR   TSTHOLDS
                      (    forth6809.asm):13756                    JSR   TSTSIGN
                      (    forth6809.asm):13757                    JSR   TSTNUMSIGN
                      (    forth6809.asm):13758                    JSR   TSTNUMSIGNSGT
                      (    forth6809.asm):13759                    JSR   TSTDOT
                      (    forth6809.asm):13760                    JSR   TSTUDOT
                      (    forth6809.asm):13761                    JSR   TSTDOTR
                      (    forth6809.asm):13762                    JSR   TSTUDOTR
                      (    forth6809.asm):13763                    JSR   TSTQMARK
                      (    forth6809.asm):13764                    JSR   TSTDDOT
                      (    forth6809.asm):13765                    JSR   TSTDDOTR
                      (    forth6809.asm):13766         
                      (    forth6809.asm):13767                    ENDC ; <<<<
                      (    forth6809.asm):13768         
C2C7 39               (    forth6809.asm):13769                    RTS
                      (    forth6809.asm):13770         
C2C8 4E756D4F7574     (    forth6809.asm):13771         TSTNUMOUTMSG: FCC "NumOut"
                      (    forth6809.asm):13772         
                      (    forth6809.asm):13773                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13774         
                      (    forth6809.asm):13775         ; ------------------------------------------------------------
                      (    forth6809.asm):13776         ; Numeric Output test harness (glossary section 3.13). The
                      (    forth6809.asm):13777         ; pictured-numeric-output core (<# # #S #> HOLD HOLDS SIGN) is
                      (    forth6809.asm):13778         ; pure string-building with no I/O, tested directly. The
                      (    forth6809.asm):13779         ; high-level printing words (./U./.R/U.R/?/D./D.R) all produce
                      (    forth6809.asm):13780         ; real output via TYPE and/or EMIT internally, so per section
                      (    forth6809.asm):13781         ; 3.1's own already-debugged finding, each applies the
                      (    forth6809.asm):13782         ; SERIALPOLL-conditional split established there: full OUTHEAD/
                      (    forth6809.asm):13783         ; OUTBUF verification under SERIALPOLL=0, an EMITCH-based check
                      (    forth6809.asm):13784         ; of the last character under SERIALPOLL=1 - accepted as a
                      (    forth6809.asm):13785         ; known, honest limitation for words ending in a trailing space
                      (    forth6809.asm):13786         ; (./U./D. all print a fixed final space character, so the
                      (    forth6809.asm):13787         ; polling-mode check there confirms less than for the
                      (    forth6809.asm):13788         ; no-trailing-space words, but is still correct and consistent
                      (    forth6809.asm):13789         ; with the same trade-off already established for TSTCR/
                      (    forth6809.asm):13790         ; TSTSPACES/TSTTYPE/TSTDOTQUOTE in earlier sections).
                      (    forth6809.asm):13791         ;
                      (    forth6809.asm):13792         ; SIGN itself carries real bug-fix history: a prior version used
                      (    forth6809.asm):13793         ; a bare BPL immediately after PULU, which doesn't affect
                      (    forth6809.asm):13794         ; condition codes on real 6809 hardware - the bug was masked for
                      (    forth6809.asm):13795         ; every internal caller by "caller-side luck" (each happened to
                      (    forth6809.asm):13796         ; run a flag-setting LDD right before calling SIGN). This
                      (    forth6809.asm):13797         ; section's own SIGN test deliberately poisons the flags with an
                      (    forth6809.asm):13798         ; unrelated, known-positive value immediately before the actual
                      (    forth6809.asm):13799         ; PSHU/JSR SIGN sequence specifically so a standalone call - the
                      (    forth6809.asm):13800         ; exact scenario the bug-fix comment says was previously broken
                      (    forth6809.asm):13801         ; - is what gets tested, not a scenario that happens to work via
                      (    forth6809.asm):13802         ; the same kind of caller-side luck that hid the original bug.
                      (    forth6809.asm):13803         ; ------------------------------------------------------------
                      (    forth6809.asm):13804         
                      (    forth6809.asm):13805         ; ------------------------------------------------------------
                      (    forth6809.asm):13806         ; TSTLTNUM - unit test for <#. No stack effect of its own -
                      (    forth6809.asm):13807         ; verifies it sets HLD to PAD's current (redirected) address.
                      (    forth6809.asm):13808         ; ------------------------------------------------------------
C2CE                  (    forth6809.asm):13809         TSTLTNUM: LDD  CODEHERE
                      (    forth6809.asm):13810                   STD  TSTCSAV
                      (    forth6809.asm):13811         
                      (    forth6809.asm):13812                   LDD  #TSTCBUF
                      (    forth6809.asm):13813                   STD  CODEHERE
                      (    forth6809.asm):13814         
                      (    forth6809.asm):13815                   STU  TSTU0
                      (    forth6809.asm):13816         
                      (    forth6809.asm):13817                   LDD  #TSTGUARD
                      (    forth6809.asm):13818                   PSHU D
                      (    forth6809.asm):13819                   STU  TSTUB4
                      (    forth6809.asm):13820         
                      (    forth6809.asm):13821                   JSR  LTNUM
                      (    forth6809.asm):13822         
                      (    forth6809.asm):13823                   STU  TSTUAF
                      (    forth6809.asm):13824         
                      (    forth6809.asm):13825                   LDD  HLD
                      (    forth6809.asm):13826                   CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):13827                   BNE  LNFAIL
                      (    forth6809.asm):13828         
                      (    forth6809.asm):13829                   PULU D
                      (    forth6809.asm):13830                   CMPD #TSTGUARD
                      (    forth6809.asm):13831                   BNE  LNFAIL
                      (    forth6809.asm):13832         
                      (    forth6809.asm):13833                   LDD  TSTUB4
                      (    forth6809.asm):13834                   SUBD TSTUAF
                      (    forth6809.asm):13835                   CMPD #0
                      (    forth6809.asm):13836                   BNE  LNFAIL
                      (    forth6809.asm):13837         
                      (    forth6809.asm):13838                   LDD  #TRUEV
                      (    forth6809.asm):13839                   BRA  LNDONE
C2CE                  (    forth6809.asm):13840         LNFAIL:   LDD  #FALSEV
C2CE                  (    forth6809.asm):13841         LNDONE:   LDX  #TSTLNNAME
                      (    forth6809.asm):13842                   PSHU X
                      (    forth6809.asm):13843                   PSHU D
                      (    forth6809.asm):13844                   JSR  TSTREPORT
                      (    forth6809.asm):13845         
                      (    forth6809.asm):13846                   LDD  TSTCSAV
                      (    forth6809.asm):13847                   STD  CODEHERE
                      (    forth6809.asm):13848         
                      (    forth6809.asm):13849                   LDU  TSTU0
                      (    forth6809.asm):13850                   RTS
                      (    forth6809.asm):13851         
C2CE                  (    forth6809.asm):13852         TSTLNNAME: FCB  8
                      (    forth6809.asm):13853                    FCC  "TSTLTNUM"
                      (    forth6809.asm):13854         
                      (    forth6809.asm):13855         ; ------------------------------------------------------------
                      (    forth6809.asm):13856         ; TSTHOLD - unit test for HOLD. Holds 'A' then 'B' - since HOLD
                      (    forth6809.asm):13857         ; grows the buffer downward and prepends (decrements HLD first,
                      (    forth6809.asm):13858         ; then writes at the new, lower position), the second-held
                      (    forth6809.asm):13859         ; character ends up at the lower address, so reading forward
                      (    forth6809.asm):13860         ; from the final HLD should give "BA", not "AB".
                      (    forth6809.asm):13861         ; ------------------------------------------------------------
C2CE                  (    forth6809.asm):13862         TSTHOLD: LDD  CODEHERE
                      (    forth6809.asm):13863                  STD  TSTCSAV
                      (    forth6809.asm):13864         
                      (    forth6809.asm):13865                  LDD  #TSTCBUF
                      (    forth6809.asm):13866                  STD  CODEHERE
                      (    forth6809.asm):13867         
                      (    forth6809.asm):13868                  STU  TSTU0
                      (    forth6809.asm):13869         
                      (    forth6809.asm):13870                  LDD  #TSTGUARD
                      (    forth6809.asm):13871                  PSHU D
                      (    forth6809.asm):13872                  STU  TSTUB4
                      (    forth6809.asm):13873         
                      (    forth6809.asm):13874                  JSR  LTNUM
                      (    forth6809.asm):13875         
                      (    forth6809.asm):13876                  LDD  #'A'
                      (    forth6809.asm):13877                  PSHU D
                      (    forth6809.asm):13878                  JSR  HOLD
                      (    forth6809.asm):13879         
                      (    forth6809.asm):13880                  LDD  #'B'
                      (    forth6809.asm):13881                  PSHU D
                      (    forth6809.asm):13882                  JSR  HOLD
                      (    forth6809.asm):13883         
                      (    forth6809.asm):13884                  STU  TSTUAF
                      (    forth6809.asm):13885         
                      (    forth6809.asm):13886                  LDX  HLD
                      (    forth6809.asm):13887                  LDA  ,X
                      (    forth6809.asm):13888                  CMPA #'B'
                      (    forth6809.asm):13889                  BNE  HDFAIL
                      (    forth6809.asm):13890                  LDA  1,X
                      (    forth6809.asm):13891                  CMPA #'A'
                      (    forth6809.asm):13892                  BNE  HDFAIL
                      (    forth6809.asm):13893         
                      (    forth6809.asm):13894                  PULU D
                      (    forth6809.asm):13895                  CMPD #TSTGUARD
                      (    forth6809.asm):13896                  BNE  HDFAIL
                      (    forth6809.asm):13897         
                      (    forth6809.asm):13898                  LDD  TSTUB4
                      (    forth6809.asm):13899                  SUBD TSTUAF
                      (    forth6809.asm):13900                  CMPD #0
                      (    forth6809.asm):13901                  BNE  HDFAIL
                      (    forth6809.asm):13902         
                      (    forth6809.asm):13903                  LDD  #TRUEV
                      (    forth6809.asm):13904                  BRA  HDDONE
C2CE                  (    forth6809.asm):13905         HDFAIL:  LDD  #FALSEV
C2CE                  (    forth6809.asm):13906         HDDONE:  LDX  #TSTHDNAME
                      (    forth6809.asm):13907                  PSHU X
                      (    forth6809.asm):13908                  PSHU D
                      (    forth6809.asm):13909                  JSR  TSTREPORT
                      (    forth6809.asm):13910         
                      (    forth6809.asm):13911                  LDD  TSTCSAV
                      (    forth6809.asm):13912                  STD  CODEHERE
                      (    forth6809.asm):13913         
                      (    forth6809.asm):13914                  LDU  TSTU0
                      (    forth6809.asm):13915                  RTS
                      (    forth6809.asm):13916         
C2CE                  (    forth6809.asm):13917         TSTHDNAME: FCB  7
                      (    forth6809.asm):13918                    FCC  "TSTHOLD"
                      (    forth6809.asm):13919         
                      (    forth6809.asm):13920         ; ------------------------------------------------------------
                      (    forth6809.asm):13921         ; TSTHOLDS - unit test for HOLDS. Holds the string "XY" - since
                      (    forth6809.asm):13922         ; HOLDS iterates its source backward (last character first) and
                      (    forth6809.asm):13923         ; HOLD itself prepends, the two behaviors combine to preserve
                      (    forth6809.asm):13924         ; the original forward order in the pictured buffer, matching
                      (    forth6809.asm):13925         ; its own documented "depends on HOLD's exact decrement-by-one
                      (    forth6809.asm):13926         ; behavior".
                      (    forth6809.asm):13927         ; ------------------------------------------------------------
C2CE                  (    forth6809.asm):13928         TSTHOLDS: LDD  CODEHERE
                      (    forth6809.asm):13929                   STD  TSTCSAV
                      (    forth6809.asm):13930         
                      (    forth6809.asm):13931                   LDD  #TSTCBUF
                      (    forth6809.asm):13932                   STD  CODEHERE
                      (    forth6809.asm):13933         
                      (    forth6809.asm):13934                   LDA  #'X'
                      (    forth6809.asm):13935                   STA  TSTNAMEB
                      (    forth6809.asm):13936                   LDA  #'Y'
                      (    forth6809.asm):13937                   STA  TSTNAMEB+1
                      (    forth6809.asm):13938         
                      (    forth6809.asm):13939                   STU  TSTU0
                      (    forth6809.asm):13940         
                      (    forth6809.asm):13941                   LDD  #TSTGUARD
                      (    forth6809.asm):13942                   PSHU D
                      (    forth6809.asm):13943                   STU  TSTUB4
                      (    forth6809.asm):13944         
                      (    forth6809.asm):13945                   JSR  LTNUM
                      (    forth6809.asm):13946         
                      (    forth6809.asm):13947                   LDD  #TSTNAMEB
                      (    forth6809.asm):13948                   PSHU D
                      (    forth6809.asm):13949                   LDD  #2
                      (    forth6809.asm):13950                   PSHU D
                      (    forth6809.asm):13951                   JSR  HOLDS
                      (    forth6809.asm):13952         
                      (    forth6809.asm):13953                   STU  TSTUAF
                      (    forth6809.asm):13954         
                      (    forth6809.asm):13955                   LDX  HLD
                      (    forth6809.asm):13956                   LDA  ,X
                      (    forth6809.asm):13957                   CMPA #'X'
                      (    forth6809.asm):13958                   BNE  HOFAIL
                      (    forth6809.asm):13959                   LDA  1,X
                      (    forth6809.asm):13960                   CMPA #'Y'
                      (    forth6809.asm):13961                   BNE  HOFAIL
                      (    forth6809.asm):13962         
                      (    forth6809.asm):13963                   PULU D
                      (    forth6809.asm):13964                   CMPD #TSTGUARD
                      (    forth6809.asm):13965                   BNE  HOFAIL
                      (    forth6809.asm):13966         
                      (    forth6809.asm):13967                   LDD  TSTUB4
                      (    forth6809.asm):13968                   SUBD TSTUAF
                      (    forth6809.asm):13969                   CMPD #0
                      (    forth6809.asm):13970                   BNE  HOFAIL
                      (    forth6809.asm):13971         
                      (    forth6809.asm):13972                   LDD  #TRUEV
                      (    forth6809.asm):13973                   BRA  HODONE
C2CE                  (    forth6809.asm):13974         HOFAIL:   LDD  #FALSEV
C2CE                  (    forth6809.asm):13975         HODONE:   LDX  #TSTHSNAME
                      (    forth6809.asm):13976                   PSHU X
                      (    forth6809.asm):13977                   PSHU D
                      (    forth6809.asm):13978                   JSR  TSTREPORT
                      (    forth6809.asm):13979         
                      (    forth6809.asm):13980                   LDD  TSTCSAV
                      (    forth6809.asm):13981                   STD  CODEHERE
                      (    forth6809.asm):13982         
                      (    forth6809.asm):13983                   LDU  TSTU0
                      (    forth6809.asm):13984                   RTS
                      (    forth6809.asm):13985         
C2CE                  (    forth6809.asm):13986         TSTHSNAME: FCB  8
                      (    forth6809.asm):13987                    FCC  "TSTHOLDS"
                      (    forth6809.asm):13988         
                      (    forth6809.asm):13989         ; ------------------------------------------------------------
                      (    forth6809.asm):13990         ; TSTSIGN - unit test for SIGN. Deliberately poisons the CPU
                      (    forth6809.asm):13991         ; flags with an unrelated CMPX (setting them to reflect a
                      (    forth6809.asm):13992         ; positive comparison result, without touching D or the value
                      (    forth6809.asm):13993         ; about to be pushed) immediately before each PSHU/JSR SIGN
                      (    forth6809.asm):13994         ; call - specifically so this test exercises the exact scenario
                      (    forth6809.asm):13995         ; the word's own bug-fix comment says was previously broken (a
                      (    forth6809.asm):13996         ; direct, standalone call not preceded by a flag-setting LDD of
                      (    forth6809.asm):13997         ; the true value), rather than relying on the same kind of
                      (    forth6809.asm):13998         ; caller-side luck that hid the original bug. Two sub-cases:
                      (    forth6809.asm):13999         ; negative (with flags poisoned toward positive, confirming the
                      (    forth6809.asm):14000         ; minus sign still gets added - would fail if SIGN reverted to
                      (    forth6809.asm):14001         ; testing stale flags instead of the value it just popped) and
                      (    forth6809.asm):14002         ; positive (with flags poisoned toward negative, confirming no
                      (    forth6809.asm):14003         ; minus sign gets added incorrectly).
                      (    forth6809.asm):14004         ; ------------------------------------------------------------
C2CE                  (    forth6809.asm):14005         TSTSIGN: LDD  CODEHERE
                      (    forth6809.asm):14006                  STD  TSTCSAV
                      (    forth6809.asm):14007         
                      (    forth6809.asm):14008                  LDD  #TSTCBUF
                      (    forth6809.asm):14009                  STD  CODEHERE
                      (    forth6809.asm):14010         
                      (    forth6809.asm):14011                  STU  TSTU0
                      (    forth6809.asm):14012         
                      (    forth6809.asm):14013                  LDD  #TSTGUARD
                      (    forth6809.asm):14014                  PSHU D
                      (    forth6809.asm):14015                  STU  TSTUB4
                      (    forth6809.asm):14016         
                      (    forth6809.asm):14017                  JSR  LTNUM
                      (    forth6809.asm):14018         
                      (    forth6809.asm):14019                  LDD  #-5
                      (    forth6809.asm):14020                  LDX  #1
                      (    forth6809.asm):14021                  CMPX #0
                      (    forth6809.asm):14022                  PSHU D
                      (    forth6809.asm):14023                  JSR  SIGN
                      (    forth6809.asm):14024         
                      (    forth6809.asm):14025                  LDX  HLD
                      (    forth6809.asm):14026                  LDA  ,X
                      (    forth6809.asm):14027                  CMPA #'-'
                      (    forth6809.asm):14028                  BNE  SGFAIL
                      (    forth6809.asm):14029         
                      (    forth6809.asm):14030                  JSR  LTNUM
                      (    forth6809.asm):14031         
                      (    forth6809.asm):14032                  LDD  #5
                      (    forth6809.asm):14033                  LDX  #-1
                      (    forth6809.asm):14034                  CMPX #0
                      (    forth6809.asm):14035                  PSHU D
                      (    forth6809.asm):14036                  JSR  SIGN
                      (    forth6809.asm):14037         
                      (    forth6809.asm):14038                  STU  TSTUAF
                      (    forth6809.asm):14039         
                      (    forth6809.asm):14040                  LDD  HLD
                      (    forth6809.asm):14041                  CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):14042                  BNE  SGFAIL
                      (    forth6809.asm):14043         
                      (    forth6809.asm):14044                  PULU D
                      (    forth6809.asm):14045                  CMPD #TSTGUARD
                      (    forth6809.asm):14046                  BNE  SGFAIL
                      (    forth6809.asm):14047         
                      (    forth6809.asm):14048                  LDD  TSTUB4
                      (    forth6809.asm):14049                  SUBD TSTUAF
                      (    forth6809.asm):14050                  CMPD #0
                      (    forth6809.asm):14051                  BNE  SGFAIL
                      (    forth6809.asm):14052         
                      (    forth6809.asm):14053                  LDD  #TRUEV
                      (    forth6809.asm):14054                  BRA  SGDONE
C2CE                  (    forth6809.asm):14055         SGFAIL:  LDD  #FALSEV
C2CE                  (    forth6809.asm):14056         SGDONE:  LDX  #TSTSGNAME
                      (    forth6809.asm):14057                  PSHU X
                      (    forth6809.asm):14058                  PSHU D

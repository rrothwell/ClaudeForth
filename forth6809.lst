                      (    forth6809.asm):00780         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00781         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00782         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00783         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00784         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00785         ; pushes that set the test up).
                      (    forth6809.asm):00786         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):00787         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00788         
                      (    forth6809.asm):00789                    LDD   #TSTGUARD
                      (    forth6809.asm):00790                    PSHU  D
                      (    forth6809.asm):00791                    LDD   #TSTVAL1
                      (    forth6809.asm):00792                    PSHU  D
                      (    forth6809.asm):00793                    STU   TSTUB4
                      (    forth6809.asm):00794         
                      (    forth6809.asm):00795                    JSR   DUP
                      (    forth6809.asm):00796         
                      (    forth6809.asm):00797                    STU   TSTUAF
                      (    forth6809.asm):00798         
                      (    forth6809.asm):00799                    PULU  D
                      (    forth6809.asm):00800                    CMPD  #TSTVAL1
                      (    forth6809.asm):00801                    BNE   TDFAIL
                      (    forth6809.asm):00802                    PULU  D
                      (    forth6809.asm):00803                    CMPD  #TSTVAL1
                      (    forth6809.asm):00804                    BNE   TDFAIL
                      (    forth6809.asm):00805                    PULU  D
                      (    forth6809.asm):00806                    CMPD  #TSTGUARD
                      (    forth6809.asm):00807                    BNE   TDFAIL
                      (    forth6809.asm):00808         
                      (    forth6809.asm):00809                    LDD   TSTUB4
                      (    forth6809.asm):00810                    SUBD  TSTUAF
                      (    forth6809.asm):00811                    CMPD  #2
                      (    forth6809.asm):00812                    BNE   TDFAIL
                      (    forth6809.asm):00813         
                      (    forth6809.asm):00814                    LDD   #TRUEV
                      (    forth6809.asm):00815                    BRA   TDDONE
C15E                  (    forth6809.asm):00816         TDFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):00817         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00818                    PSHU  X
                      (    forth6809.asm):00819                    PSHU  D
                      (    forth6809.asm):00820                    JSR   TSTREPORT
                      (    forth6809.asm):00821         
                      (    forth6809.asm):00822                    LDU   TSTU0
                      (    forth6809.asm):00823                    RTS
                      (    forth6809.asm):00824         
C15E                  (    forth6809.asm):00825         TSTDUPNAME: FCB  6
                      (    forth6809.asm):00826                     FCC  "TSTDUP"
                      (    forth6809.asm):00827         

                      (    forth6809.asm):01604                    STU   TSTUB4
                      (    forth6809.asm):01605         
                      (    forth6809.asm):01606                    JSR   ROLL
                      (    forth6809.asm):01607         
                      (    forth6809.asm):01608                    STU   TSTUAF
                      (    forth6809.asm):01609         
                      (    forth6809.asm):01610                    PULU  D
                      (    forth6809.asm):01611                    CMPD  #TSTVAL1
                      (    forth6809.asm):01612                    BNE   RLFAIL
                      (    forth6809.asm):01613                    PULU  D
                      (    forth6809.asm):01614                    CMPD  #TSTVAL3
                      (    forth6809.asm):01615                    BNE   RLFAIL
                      (    forth6809.asm):01616                    PULU  D
                      (    forth6809.asm):01617                    CMPD  #TSTVAL2
                      (    forth6809.asm):01618                    BNE   RLFAIL
                      (    forth6809.asm):01619                    PULU  D
                      (    forth6809.asm):01620                    CMPD  #TSTGUARD
                      (    forth6809.asm):01621                    BNE   RLFAIL
                      (    forth6809.asm):01622         

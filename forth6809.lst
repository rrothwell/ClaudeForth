                      (    forth6809.asm):02969         ; ------------------------------------------------------------
                      (    forth6809.asm):02970         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):02971         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):02972         ; traced by hand against their real implementations before any
                      (    forth6809.asm):02973         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):02974         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):02975         ; across every word here), and which of two operands is which
                      (    forth6809.asm):02976         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):02977         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):02978         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):02979         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):02980         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):02981         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02982         TSTDARITH: JSR   CRW
                      (    forth6809.asm):02983                    LDX   #TSTDARITHMSG
                      (    forth6809.asm):02984                    PSHU  X
                      (    forth6809.asm):02985                    LDD   #11
                      (    forth6809.asm):02986                    PSHU  D
                      (    forth6809.asm):02987                    JSR   TYPE
                      (    forth6809.asm):02988                    JSR   CRW
                      (    forth6809.asm):02989         
                      (    forth6809.asm):02990                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02991         
                      (    forth6809.asm):02992                    JSR   TSTUMST
                      (    forth6809.asm):02993                    JSR   TSTUMSM
                      (    forth6809.asm):02994                    JSR   TSTUMSZ
                      (    forth6809.asm):02995                    JSR   TSTMSTAR
                      (    forth6809.asm):02996                    JSR   TSTFMSM
                      (    forth6809.asm):02997                    JSR   TSTFMSZ
                      (    forth6809.asm):02998                    JSR   TSTSMRM
                      (    forth6809.asm):02999                    JSR   TSTSMRZ
                      (    forth6809.asm):03000                    JSR   TSTDPLUS
                      (    forth6809.asm):03001                    JSR   TSTDMIN2
                      (    forth6809.asm):03002                    JSR   TSTDNEG
                      (    forth6809.asm):03003                    JSR   TSTDABS1
                      (    forth6809.asm):03004                    JSR   TSTDABS2
                      (    forth6809.asm):03005                    JSR   TSTMPLUS
                      (    forth6809.asm):03006                    JSR   TSTSTOD
                      (    forth6809.asm):03007                    JSR   TSTDTOS
                      (    forth6809.asm):03008                    JSR   TSTDMAX
                      (    forth6809.asm):03009                    JSR   TSTDMIN
                      (    forth6809.asm):03010         
                      (    forth6809.asm):03011                    ENDC ; <<<<
                      (    forth6809.asm):03012         
                      (    forth6809.asm):03013                    RTS

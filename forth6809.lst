                      (    forth6809.asm):00560         ; ------------------------------------------------------------
                      (    forth6809.asm):00561         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00562         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00563         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00564         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00565         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00566         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00567         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00568         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00569         ;
                      (    forth6809.asm):00570         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00571         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00572         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00573         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00574         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00575         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00576         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00577         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00578         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00579         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00580         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00581         ; ------------------------------------------------------------
                      (    forth6809.asm):00582                  ORG   $0100
0100                  (    forth6809.asm):00583         MVCNT      RMB   2
0102                  (    forth6809.asm):00584         MVDST      RMB   2
0104                  (    forth6809.asm):00585         MVSRC      RMB   2
     0100             (    forth6809.asm):00586         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00587         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00588         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00589         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00590         
                      (    forth6809.asm):00591         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00592         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00593                  ORG USROMSTRT
                      (    forth6809.asm):00594         
                      (    forth6809.asm):00595         ; ============================================================
                      (    forth6809.asm):00596         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00597         ;
                      (    forth6809.asm):00598         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00599         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00600         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00601         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00602         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00603         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00604         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00605         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00606         ; this existed - the default build (UNITTESTS undefined, or
                      (    forth6809.asm):00607         ; defined as 0) removes it entirely and this block reverts to
                      (    forth6809.asm):00608         ; exactly that padding, computed automatically below via the ROM
                      (    forth6809.asm):00609         ; label rather than a fixed byte count, so it's correct either
                      (    forth6809.asm):00610         ; way without needing to be hand-adjusted. Pass
                      (    forth6809.asm):00611         ; --define=UNITTESTS on the lwasm command line (see the example
                      (    forth6809.asm):00612         ; at the end of this comment) to include it.
                      (    forth6809.asm):00613         ;
                      (    forth6809.asm):00614         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00615         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00616         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00617         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00618         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00619         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00620         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00621         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00622         ;
                      (    forth6809.asm):00623         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00624         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00625         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00626         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00627         ;
                      (    forth6809.asm):00628         ; Test groups are further gated by TSTSELECTOR (see below), one
                      (    forth6809.asm):00629         ; group at a time, since assembling every group together exhausts
                      (    forth6809.asm):00630         ; the available unused ROM space. Example command line, testing
                      (    forth6809.asm):00631         ; group 2 with tests included:
                      (    forth6809.asm):00632         ;
                      (    forth6809.asm):00633         ;   lwasm --6809 --format=raw \
                      (    forth6809.asm):00634         ;   --output=forth6809.bin --list=forth6809.lst \
                      (    forth6809.asm):00635         ;   --define=UNITTESTS --define=TSTSELECTOR=2 \
                      (    forth6809.asm):00636         ;   forth6809.asm
                      (    forth6809.asm):00637         ; ============================================================
                      (    forth6809.asm):00638                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00639         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00640                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00641                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00642                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00643                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00644                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00645                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00646                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00647                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00648                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00649                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00650                           ; choice is made, not what including it does.
                      (    forth6809.asm):00651                    ENDC
                      (    forth6809.asm):00652         
                      (    forth6809.asm):00653                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00654         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00655                    ENDC
                      (    forth6809.asm):00656         
                      (    forth6809.asm):00657                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00658         
     021B             (    forth6809.asm):00659         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
     021D             (    forth6809.asm):00660         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
     021F             (    forth6809.asm):00661         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
     0221             (    forth6809.asm):00662         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00663         
     3C7A             (    forth6809.asm):00664         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00665                                       ; under test, to prove an operation
                      (    forth6809.asm):00666                                       ; doesn't disturb what's beneath it
     59E1             (    forth6809.asm):00667         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00668                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00669                                       ; that only appears to pass due to a
                      (    forth6809.asm):00670                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00671                                       ; caught rather than masked
     2468             (    forth6809.asm):00672         TSTVAL2  EQU   $2468         ; additional distinct, non-trivial
     7B3D             (    forth6809.asm):00673         TSTVAL3  EQU   $7B3D         ; values for multi-item tests (SWAP,
     4E2C             (    forth6809.asm):00674         TSTVAL4  EQU   $4E2C         ; OVER, ROT, 2DUP, 2ROT, etc) - none are
     19A7             (    forth6809.asm):00675         TSTVAL5  EQU   $19A7         ; 0, 1, -1, TSTGUARD, or any of each
     6D95             (    forth6809.asm):00676         TSTVAL6  EQU   $6D95         ; other
                      (    forth6809.asm):00677         
     0223             (    forth6809.asm):00678         TSTSCR   EQU   APPVARS+8     ; extra scratch cell - for tests (DEPTH)
                      (    forth6809.asm):00679                                       ; that need to compute an expected value
                      (    forth6809.asm):00680                                       ; independently before comparing
                      (    forth6809.asm):00681         
     0225             (    forth6809.asm):00682         TSTCBUF  EQU   APPVARS+10    ; compile-time test harness (section 3.8,
                      (    forth6809.asm):00683                                       ; control flow): scratch buffer real
                      (    forth6809.asm):00684                                       ; compile-time words (IF/THEN/DO/LOOP/
                      (    forth6809.asm):00685                                       ; etc) actually compile into - CODEHERE
                      (    forth6809.asm):00686                                       ; is redirected here for the duration of
                      (    forth6809.asm):00687                                       ; each compile, then restored, so the
                      (    forth6809.asm):00688                                       ; real ROM/dictionary is never touched.
                      (    forth6809.asm):00689                                       ; 80 bytes - generous headroom for the
                      (    forth6809.asm):00690                                       ; small test snippets planned (the
                      (    forth6809.asm):00691                                       ; largest, CASE with two OF clauses,
                      (    forth6809.asm):00692                                       ; comes nowhere close)
     0275             (    forth6809.asm):00693         TSTCSAV  EQU   APPVARS+90    ; saved CODEHERE, across a redirected
                      (    forth6809.asm):00694                                       ; compile
     0277             (    forth6809.asm):00695         TSTCSPS  EQU   APPVARS+92    ; saved CSP, across a redirected compile -
                      (    forth6809.asm):00696                                       ; EXIT's own frame-counting scan depends
                      (    forth6809.asm):00697                                       ; on CSP marking the right baseline
     0279             (    forth6809.asm):00698         TSTLSAV  EQU   APPVARS+94    ; saved LATEST, across a RECURSE test
                      (    forth6809.asm):00699                                       ; (which reads LATEST directly)
     027B             (    forth6809.asm):00700         TSTFHDR  EQU   APPVARS+96    ; fake dictionary header, for RECURSE to
                      (    forth6809.asm):00701                                       ; read via a redirected LATEST - 16
                      (    forth6809.asm):00702                                       ; bytes (LEN/FL + name + LINK + CFA,
                      (    forth6809.asm):00703                                       ; comfortably fits any short test name)
                      (    forth6809.asm):00704         
     028B             (    forth6809.asm):00705         TSTDBUF  EQU   APPVARS+112   ; defining-words test harness (section
                      (    forth6809.asm):00706                                       ; 3.9): scratch dictionary buffer -
                      (    forth6809.asm):00707                                       ; DPHERE is redirected here for the
                      (    forth6809.asm):00708                                       ; duration of each defining-word call,
                      (    forth6809.asm):00709                                       ; so a real header never lands in the
                      (    forth6809.asm):00710                                       ; real dictionary. 40 bytes.
     02B3             (    forth6809.asm):00711         TSTDSAV  EQU   APPVARS+152   ; saved DPHERE
     02B5             (    forth6809.asm):00712         TSTVBUF  EQU   APPVARS+154   ; scratch VARHERE buffer, for VARIABLE/
                      (    forth6809.asm):00713                                       ; VALUE/2VARIABLE/BUFFER: to reserve
                      (    forth6809.asm):00714                                       ; their own mutable space into. 20
                      (    forth6809.asm):00715                                       ; bytes.
     02C9             (    forth6809.asm):00716         TSTVSAV  EQU   APPVARS+174   ; saved VARHERE
     02CB             (    forth6809.asm):00717         TSTNAMEB EQU   APPVARS+176   ; scratch fake source text, for HEADER's
                      (    forth6809.asm):00718                                       ; own WORD-based name parsing (every
                      (    forth6809.asm):00719                                       ; defining word reads a name from the
                      (    forth6809.asm):00720                                       ; input source - unlike anything in
                      (    forth6809.asm):00721                                       ; section 3.8) - 16 bytes
     02DB             (    forth6809.asm):00722         TSTSASAV EQU   APPVARS+192   ; saved SRCADDR
     02DD             (    forth6809.asm):00723         TSTSLSAV EQU   APPVARS+194   ; saved SRCLEN
     02DF             (    forth6809.asm):00724         TSTTISAV EQU   APPVARS+196   ; saved TOIN
     02E1             (    forth6809.asm):00725         TSTWCFA  EQU   APPVARS+198   ; the newly-defined test word's own CFA -
                      (    forth6809.asm):00726                                       ; equal to CODEHERE (redirected) at the
                      (    forth6809.asm):00727                                       ; moment the defining word is called,
                      (    forth6809.asm):00728                                       ; saved so the compiled trampoline can
                      (    forth6809.asm):00729                                       ; be executed afterward to verify its
                      (    forth6809.asm):00730                                       ; runtime behavior
     02E3             (    forth6809.asm):00731         TSTSTSAV EQU   APPVARS+200   ; saved STATE, across a :/; test
     02E5             (    forth6809.asm):00732         TSTSMFLG EQU   APPVARS+202   ; scratch: header SMUDGE-bit check result
     02E7             (    forth6809.asm):00733         TSTDOESA EQU   APPVARS+204   ; address of a compiled "JSR SETDOES" -
                      (    forth6809.asm):00734                                       ; JSR'd directly to simulate an outer
                      (    forth6809.asm):00735                                       ; defining word reaching that point,
                      (    forth6809.asm):00736                                       ; without needing to actually build one
     02EF             (    forth6809.asm):00737         TSTCSAV2 EQU   APPVARS+212   ; MARKER test: CODEHERE right after
                      (    forth6809.asm):00738                                       ; executing the marker word (before it's
                      (    forth6809.asm):00739                                       ; overwritten by this test's own restore)
     02F1             (    forth6809.asm):00740         TSTDSAV2 EQU   APPVARS+214   ; same, DPHERE
     02F3             (    forth6809.asm):00741         TSTVSAV2 EQU   APPVARS+216   ; same, VARHERE
     02F5             (    forth6809.asm):00742         TSTLSAV2 EQU   APPVARS+218   ; same, LATEST
     02F7             (    forth6809.asm):00743         TSTCBUF2 EQU   APPVARS+220   ; a SECOND, separate CODEHERE-redirect
                      (    forth6809.asm):00744                                       ; target - real bug found via MAME: WORD
                      (    forth6809.asm):00745                                       ; writes its parsed-token output directly
                      (    forth6809.asm):00746                                       ; at CODEHERE (by its own documented
                      (    forth6809.asm):00747                                       ; design, matching the ANS transient-
                      (    forth6809.asm):00748                                       ; region contract - confirmed by reading
                      (    forth6809.asm):00749                                       ; WORD's own code, not assumed). Any test
                      (    forth6809.asm):00750                                       ; that parses a SECOND name later (TO,
                      (    forth6809.asm):00751                                       ; IS, ACTION-OF) must NOT redirect
                      (    forth6809.asm):00752                                       ; CODEHERE back to TSTCBUF for that
                      (    forth6809.asm):00753                                       ; second parse, since TSTCBUF still holds
                      (    forth6809.asm):00754                                       ; the FIRST word's already-compiled
                      (    forth6809.asm):00755                                       ; trampoline at that point - WORD would
                      (    forth6809.asm):00756                                       ; silently overwrite it, corrupting the
                      (    forth6809.asm):00757                                       ; CFA that TSTWCFA still points to before
                      (    forth6809.asm):00758                                       ; it gets a second chance to execute. 20
                      (    forth6809.asm):00759                                       ; bytes - comfortably fits any short
                      (    forth6809.asm):00760                                       ; parsed name plus its length byte.
     030B             (    forth6809.asm):00761         TSTUMID  EQU   APPVARS+240   ; intermediate U capture (section 3.3,
                      (    forth6809.asm):00762                                       ; return stack): >R/2>R tests capture U
                      (    forth6809.asm):00763                                       ; right after moving a value to the
                      (    forth6809.asm):00764                                       ; return stack, before moving it back -
                      (    forth6809.asm):00765                                       ; a round-trip-only check could pass even
                      (    forth6809.asm):00766                                       ; if both the move-out and move-back were
                      (    forth6809.asm):00767                                       ; broken no-ops, since the value would
                      (    forth6809.asm):00768                                       ; never have actually left; this catches
                      (    forth6809.asm):00769                                       ; that specifically.
                      (    forth6809.asm):00770         
     030D             (    forth6809.asm):00771         TSTOHSAV EQU   APPVARS+242   ; section 3.1 (System/Console I/O):
                      (    forth6809.asm):00772                                       ; saves OUTHEAD (the output ring buffer's
                      (    forth6809.asm):00773                                       ; write index) before an EMIT-family call,
                      (    forth6809.asm):00774                                       ; so the test can confirm the character(s)
                      (    forth6809.asm):00775                                       ; were genuinely queued into OUTBUF - not
                      (    forth6809.asm):00776                                       ; just that the call returned without
                      (    forth6809.asm):00777                                       ; crashing.
                      (    forth6809.asm):00778         
     CFC7             (    forth6809.asm):00779         TSTNEG1  EQU   $CFC7         ; -12345 - distinct, non-trivial negative
                      (    forth6809.asm):00780                                       ; test values, needed for arithmetic
                      (    forth6809.asm):00781                                       ; tests (ABS, NEGATE, MIN/MAX, signed
                      (    forth6809.asm):00782                                       ; division, 2/) whose logic genuinely
                      (    forth6809.asm):00783                                       ; branches on sign - TSTVAL1-6 above are
                      (    forth6809.asm):00784                                       ; all positive, which wouldn't exercise
                      (    forth6809.asm):00785                                       ; those branches
     FEBF             (    forth6809.asm):00786         TSTNEG2  EQU   $FEBF         ; -321
                      (    forth6809.asm):00787         
     0001             (    forth6809.asm):00788         TSTD1HI  EQU   $0001         ; TSTDBL1 = 70000 (positive, exceeds 16
     1170             (    forth6809.asm):00789         TSTD1LO  EQU   $1170         ; bits - exercises real double-cell width,
                      (    forth6809.asm):00790                                       ; not just a sign-extended single)
     FFFE             (    forth6809.asm):00791         TSTD2HI  EQU   $FFFE         ; TSTDBL2 = -70000
     EE90             (    forth6809.asm):00792         TSTD2LO  EQU   $EE90
     00BC             (    forth6809.asm):00793         TSTD3HI  EQU   $00BC         ; TSTDBL3 = 12345678
     614E             (    forth6809.asm):00794         TSTD3LO  EQU   $614E
     0000             (    forth6809.asm):00795         TSTDSHI  EQU   $0000         ; TSTDBLSMALL = 500 - small enough to fit
     01F4             (    forth6809.asm):00796         TSTDSLO  EQU   $01F4         ; in a single cell, for D>S
                      (    forth6809.asm):00797         
                      (    forth6809.asm):00798         ; ------------------------------------------------------------
                      (    forth6809.asm):00799         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00800         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00801         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00802         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00803         ; ------------------------------------------------------------
C100 3706             (    forth6809.asm):00804         TSTREPORT: PULU  D
C102 FD0221           (    forth6809.asm):00805                    STD   TSTFLAG
C105 BDF62F           (    forth6809.asm):00806                    JSR   COUNT
C108 BDF60B           (    forth6809.asm):00807                    JSR   TYPE
C10B FC0221           (    forth6809.asm):00808                    LDD   TSTFLAG
C10E 270C             (    forth6809.asm):00809                    BEQ   TSTFAILR
C110 CCC12D           (    forth6809.asm):00810                    LDD   #TSTOKMSG
C113 3606             (    forth6809.asm):00811                    PSHU  D
C115 CC0003           (    forth6809.asm):00812                    LDD   #TSTOKMSGL
C118 3606             (    forth6809.asm):00813                    PSHU  D
C11A 200A             (    forth6809.asm):00814                    BRA   TSTPRINT
C11C CCC130           (    forth6809.asm):00815         TSTFAILR:  LDD   #TSTFAILMSG
C11F 3606             (    forth6809.asm):00816                    PSHU  D
C121 CC0005           (    forth6809.asm):00817                    LDD   #TSTFAILMSGL
C124 3606             (    forth6809.asm):00818                    PSHU  D
C126 BDF60B           (    forth6809.asm):00819         TSTPRINT:  JSR   TYPE
C129 BDFC2B           (    forth6809.asm):00820                    JSR   CRW
C12C 39               (    forth6809.asm):00821                    RTS
                      (    forth6809.asm):00822         
C12D 204F4B           (    forth6809.asm):00823         TSTOKMSG:    FCC " OK"
     0003             (    forth6809.asm):00824         TSTOKMSGL    EQU  *-TSTOKMSG
C130 204641494C       (    forth6809.asm):00825         TSTFAILMSG:  FCC " FAIL"
     0005             (    forth6809.asm):00826         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00827         
                      (    forth6809.asm):00828         ; ------------------------------------------------------------
                      (    forth6809.asm):00829         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00830         ; here as they're written.
                      (    forth6809.asm):00831         ; ------------------------------------------------------------
C135 BDC15A           (    forth6809.asm):00832         TSTRUNNER: JSR   TSTSYSIO
C138 BDC173           (    forth6809.asm):00833                    JSR   TSTSTACK
C13B BDC18C           (    forth6809.asm):00834                    JSR   TSTRETSTACK
C13E BDC1A8           (    forth6809.asm):00835                    JSR   TSTSARITH
C141 BDC1C7           (    forth6809.asm):00836                    JSR   TSTDARITH
C144 BDC1E6           (    forth6809.asm):00837                    JSR   TSTLOGIC
C147 BDC1FF           (    forth6809.asm):00838                    JSR   TSTCOMPARE
C14A BDC21A           (    forth6809.asm):00839                    JSR   TSTCTRLFLOW
C14D BDC236           (    forth6809.asm):00840                    JSR   TSTDEFWORDS
C150 BDC252           (    forth6809.asm):00841                    JSR   TSTCOMPWORDS
C153 BDC26F           (    forth6809.asm):00842                    JSR   TSTMEMORY
C156 BDC289           (    forth6809.asm):00843                    JSR   TSTSTRPARSE
C159 39               (    forth6809.asm):00844                    RTS
                      (    forth6809.asm):00845         
                      (    forth6809.asm):00846         ; ------------------------------------------------------------
                      (    forth6809.asm):00847         ; TSTSYSIO - System/Console I/O tests (glossary section 3.1, 12
                      (    forth6809.asm):00848         ; words, 7 tests). Six words are deliberately NOT tested here -
                      (    forth6809.asm):00849         ; KEY, ACCEPT, EXPECT, and QUERY all genuinely block on real
                      (    forth6809.asm):00850         ; input during automated, headless boot-time testing (confirmed
                      (    forth6809.asm):00851         ; by reading their own implementations: KEY spins on itself,
                      (    forth6809.asm):00852         ; ACCEPT calls KEY directly, EXPECT/QUERY both call ACCEPT); and
                      (    forth6809.asm):00853         ; ABORT/QUIT are both designed to never return (ABORT falls
                      (    forth6809.asm):00854         ; through into QUIT, which resets the return stack, discarding
                      (    forth6809.asm):00855         ; this entire call chain and hijacking the boot sequence into
                      (    forth6809.asm):00856         ; the interpreter's own top-level loop). See this group's own
                      (    forth6809.asm):00857         ; leading comment block, right before TSTKEYQ, for the full
                      (    forth6809.asm):00858         ; reasoning.
                      (    forth6809.asm):00859         ;
                      (    forth6809.asm):00860         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00861         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00862         ; thousands of times already across every prior test group.
                      (    forth6809.asm):00863         ; Each test here verifies the real queuing mechanism (OUTHEAD/
                      (    forth6809.asm):00864         ; OUTBUF), reading the actual character(s) back out of the
                      (    forth6809.asm):00865         ; output ring buffer to confirm they were genuinely queued, not
                      (    forth6809.asm):00866         ; just that the call returned without crashing.
                      (    forth6809.asm):00867         ; ------------------------------------------------------------
C15A BDFC2B           (    forth6809.asm):00868         TSTSYSIO: JSR   CRW
C15D 8EC16E           (    forth6809.asm):00869                    LDX   #TSTSYSIOMSG
C160 3610             (    forth6809.asm):00870                    PSHU  X
C162 CC0005           (    forth6809.asm):00871                    LDD   #5
C165 3606             (    forth6809.asm):00872                    PSHU  D
C167 BDF60B           (    forth6809.asm):00873                    JSR   TYPE
C16A BDFC2B           (    forth6809.asm):00874                    JSR   CRW
                      (    forth6809.asm):00875         
                      (    forth6809.asm):00876                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00877         
                      (    forth6809.asm):00878                    JSR   TSTKEYQ
                      (    forth6809.asm):00879                    JSR   TSTEMIT
                      (    forth6809.asm):00880                    JSR   TSTCR
                      (    forth6809.asm):00881                    JSR   TSTSPACE
                      (    forth6809.asm):00882                    JSR   TSTSPACES
                      (    forth6809.asm):00883                    JSR   TSTSPACESZ
                      (    forth6809.asm):00884                    JSR   TSTTYPE
                      (    forth6809.asm):00885         
                      (    forth6809.asm):00886                    ENDC ; <<<<
                      (    forth6809.asm):00887         
C16D 39               (    forth6809.asm):00888                    RTS
                      (    forth6809.asm):00889         
C16E 537973494F       (    forth6809.asm):00890         TSTSYSIOMSG: FCC "SysIO"
                      (    forth6809.asm):00891         
                      (    forth6809.asm):00892                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00893         
                      (    forth6809.asm):00894         ; ------------------------------------------------------------
                      (    forth6809.asm):00895         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00896         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00897         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00898         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00899         ;
                      (    forth6809.asm):00900         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00901         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00902         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00903         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00904         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00905         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00906         ; where no real input will ever arrive.
                      (    forth6809.asm):00907         ;
                      (    forth6809.asm):00908         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00909         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00910         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00911         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00912         ; entirely, not just fail one test.
                      (    forth6809.asm):00913         ;
                      (    forth6809.asm):00914         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00915         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00916         ; thousands of times already across every prior test group
                      (    forth6809.asm):00917         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00918         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00919         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00920         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00921         ; returned.
                      (    forth6809.asm):00922         ; ------------------------------------------------------------
                      (    forth6809.asm):00923         
                      (    forth6809.asm):00924         ; ------------------------------------------------------------
                      (    forth6809.asm):00925         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00926         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00927         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00928         ; ------------------------------------------------------------
C173                  (    forth6809.asm):00929         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00930         
                      (    forth6809.asm):00931                  LDD   #TSTGUARD
                      (    forth6809.asm):00932                  PSHU  D
                      (    forth6809.asm):00933                  STU   TSTUB4
                      (    forth6809.asm):00934         
                      (    forth6809.asm):00935                  JSR   KEYQ
                      (    forth6809.asm):00936         
                      (    forth6809.asm):00937                  STU   TSTUAF
                      (    forth6809.asm):00938         
                      (    forth6809.asm):00939                  PULU  D
                      (    forth6809.asm):00940                  CMPD  #FALSEV
                      (    forth6809.asm):00941                  BNE   KYFAIL
                      (    forth6809.asm):00942                  PULU  D
                      (    forth6809.asm):00943                  CMPD  #TSTGUARD
                      (    forth6809.asm):00944                  BNE   KYFAIL
                      (    forth6809.asm):00945         
                      (    forth6809.asm):00946                  LDD   TSTUB4
                      (    forth6809.asm):00947                  SUBD  TSTUAF
                      (    forth6809.asm):00948                  CMPD  #2
                      (    forth6809.asm):00949                  BNE   KYFAIL
                      (    forth6809.asm):00950         
                      (    forth6809.asm):00951                  LDD   #TRUEV
                      (    forth6809.asm):00952                  BRA   KYDONE
C173                  (    forth6809.asm):00953         KYFAIL: LDD   #FALSEV
C173                  (    forth6809.asm):00954         KYDONE: LDX   #TSTKEYQNAME
                      (    forth6809.asm):00955                  PSHU  X
                      (    forth6809.asm):00956                  PSHU  D
                      (    forth6809.asm):00957                  JSR   TSTREPORT
                      (    forth6809.asm):00958         
                      (    forth6809.asm):00959                  LDU   TSTU0
                      (    forth6809.asm):00960                  RTS
                      (    forth6809.asm):00961         
C173                  (    forth6809.asm):00962         TSTKEYQNAME: FCB  7
                      (    forth6809.asm):00963                      FCC  "TSTKEYQ"
                      (    forth6809.asm):00964         
                      (    forth6809.asm):00965         ; ------------------------------------------------------------
                      (    forth6809.asm):00966         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):00967         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):00968         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):00969         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):00970         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):00971         ; that the call returned.
                      (    forth6809.asm):00972         ; ------------------------------------------------------------
C173                  (    forth6809.asm):00973         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):00974         
                      (    forth6809.asm):00975                  LDD   #TSTGUARD
                      (    forth6809.asm):00976                  PSHU  D
                      (    forth6809.asm):00977                  LDD   #65
                      (    forth6809.asm):00978                  PSHU  D
                      (    forth6809.asm):00979                  STU   TSTUB4
                      (    forth6809.asm):00980         
                      (    forth6809.asm):00981                  JSR   EMIT
                      (    forth6809.asm):00982         
                      (    forth6809.asm):00983                  STU   TSTUAF
                      (    forth6809.asm):00984         
                      (    forth6809.asm):00985                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):00986                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):00987                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):00988                                 ; different implementations, gated the same way
                      (    forth6809.asm):00989                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):00990                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):00991                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):00992                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):00993                                 ; always failed despite the character genuinely
                      (    forth6809.asm):00994                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):00995                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):00996                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):00997                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):00998                                 ; - checking it verifies the argument was
                      (    forth6809.asm):00999                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):01000                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):01001                                 ; conditional needed.
                      (    forth6809.asm):01002                  CMPA  #65
                      (    forth6809.asm):01003                  BNE   EMFAIL
                      (    forth6809.asm):01004         
                      (    forth6809.asm):01005                  PULU  D
                      (    forth6809.asm):01006                  CMPD  #TSTGUARD
                      (    forth6809.asm):01007                  BNE   EMFAIL
                      (    forth6809.asm):01008         
                      (    forth6809.asm):01009                  LDD   TSTUB4
                      (    forth6809.asm):01010                  SUBD  TSTUAF
                      (    forth6809.asm):01011                  CMPD  #-2
                      (    forth6809.asm):01012                  BNE   EMFAIL
                      (    forth6809.asm):01013         
                      (    forth6809.asm):01014                  LDD   #TRUEV
                      (    forth6809.asm):01015                  BRA   EMDONE
C173                  (    forth6809.asm):01016         EMFAIL:  LDD   #FALSEV
C173                  (    forth6809.asm):01017         EMDONE:  LDX   #TSTEMITNAME
                      (    forth6809.asm):01018                  PSHU  X
                      (    forth6809.asm):01019                  PSHU  D
                      (    forth6809.asm):01020                  JSR   TSTREPORT
                      (    forth6809.asm):01021         
                      (    forth6809.asm):01022                  LDU   TSTU0
                      (    forth6809.asm):01023                  RTS
                      (    forth6809.asm):01024         
C173                  (    forth6809.asm):01025         TSTEMITNAME: FCB  7
                      (    forth6809.asm):01026                      FCC  "TSTEMIT"
                      (    forth6809.asm):01027         
                      (    forth6809.asm):01028         ; ------------------------------------------------------------
                      (    forth6809.asm):01029         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01030         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01031         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01032         ; ------------------------------------------------------------
C173                  (    forth6809.asm):01033         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01034         
                      (    forth6809.asm):01035                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01036                  LDA   OUTHEAD
                      (    forth6809.asm):01037                  STA   TSTOHSAV
                      (    forth6809.asm):01038                  ENDC ; <<<<
                      (    forth6809.asm):01039         
                      (    forth6809.asm):01040         
                      (    forth6809.asm):01041                  LDD   #TSTGUARD
                      (    forth6809.asm):01042                  PSHU  D
                      (    forth6809.asm):01043                  STU   TSTUB4
                      (    forth6809.asm):01044         
                      (    forth6809.asm):01045                  JSR   CRW
                      (    forth6809.asm):01046         
                      (    forth6809.asm):01047                  STU   TSTUAF
                      (    forth6809.asm):01048         
                      (    forth6809.asm):01049                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01050                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01051                                   ; in order
                      (    forth6809.asm):01052                  LDA   TSTOHSAV
                      (    forth6809.asm):01053                  ADDA  #2
                      (    forth6809.asm):01054                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01055                  CMPA  OUTHEAD
                      (    forth6809.asm):01056                  BNE   CRFAIL
                      (    forth6809.asm):01057         
                      (    forth6809.asm):01058                  LDX   #OUTBUF
                      (    forth6809.asm):01059                  LDB   TSTOHSAV
                      (    forth6809.asm):01060                  LDA   B,X
                      (    forth6809.asm):01061                  CMPA  #13
                      (    forth6809.asm):01062                  BNE   CRFAIL
                      (    forth6809.asm):01063                  INCB
                      (    forth6809.asm):01064                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01065                  LDA   B,X
                      (    forth6809.asm):01066                  CMPA  #10
                      (    forth6809.asm):01067                  BNE   CRFAIL
                      (    forth6809.asm):01068                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01069                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01070                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01071                                   ; entirely different implementations, gated
                      (    forth6809.asm):01072                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01073                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01074                                   ; currently active build) writes directly to
                      (    forth6809.asm):01075                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01076                                   ; all, so this check always failed despite
                      (    forth6809.asm):01077                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01078                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01079                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01080                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01081                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01082                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01083                                   ; depth check below is the most this variant
                      (    forth6809.asm):01084                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01085                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01086                                   ; persistent state.
                      (    forth6809.asm):01087                  LDA   EMITCH
                      (    forth6809.asm):01088                  CMPA  #10
                      (    forth6809.asm):01089                  BNE   CRFAIL
                      (    forth6809.asm):01090                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01091         
                      (    forth6809.asm):01092                  PULU  D
                      (    forth6809.asm):01093                  CMPD  #TSTGUARD
                      (    forth6809.asm):01094                  BNE   CRFAIL
                      (    forth6809.asm):01095         
                      (    forth6809.asm):01096                  LDD   TSTUB4
                      (    forth6809.asm):01097                  SUBD  TSTUAF
                      (    forth6809.asm):01098                  CMPD  #0
                      (    forth6809.asm):01099                  BNE   CRFAIL
                      (    forth6809.asm):01100         
                      (    forth6809.asm):01101                  LDD   #TRUEV
                      (    forth6809.asm):01102                  BRA   CRDONE
C173                  (    forth6809.asm):01103         CRFAIL: LDD   #FALSEV
C173                  (    forth6809.asm):01104         CRDONE: LDX   #TSTCRNAME
                      (    forth6809.asm):01105                  PSHU  X
                      (    forth6809.asm):01106                  PSHU  D
                      (    forth6809.asm):01107                  JSR   TSTREPORT
                      (    forth6809.asm):01108         
                      (    forth6809.asm):01109                  LDU   TSTU0
                      (    forth6809.asm):01110                  RTS
                      (    forth6809.asm):01111         
C173                  (    forth6809.asm):01112         TSTCRNAME: FCB  5
                      (    forth6809.asm):01113                    FCC  "TSTCR"
                      (    forth6809.asm):01114         
                      (    forth6809.asm):01115         ; ------------------------------------------------------------
                      (    forth6809.asm):01116         ; TSTSPACE - unit test for SPACE. Verifies one space (32) is
                      (    forth6809.asm):01117         ; genuinely queued.
                      (    forth6809.asm):01118         ; ------------------------------------------------------------
C173                  (    forth6809.asm):01119         TSTSPACE: STU  TSTU0
                      (    forth6809.asm):01120         
                      (    forth6809.asm):01121                   LDD  #TSTGUARD
                      (    forth6809.asm):01122                   PSHU D
                      (    forth6809.asm):01123                   STU  TSTUB4
                      (    forth6809.asm):01124         
                      (    forth6809.asm):01125                   JSR  SPACEW
                      (    forth6809.asm):01126         
                      (    forth6809.asm):01127                   STU  TSTUAF
                      (    forth6809.asm):01128         
                      (    forth6809.asm):01129                   LDA  EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF - same
                      (    forth6809.asm):01130                                 ; fix and same reasoning as TSTEMIT's own fix
                      (    forth6809.asm):01131                                 ; (see its comment). SPACEW calls EMIT
                      (    forth6809.asm):01132                                 ; internally with a single character (32), so
                      (    forth6809.asm):01133                                 ; EMITCH correctly reflects it regardless of
                      (    forth6809.asm):01134                                 ; which EMIT variant is active.
                      (    forth6809.asm):01135                   CMPA #32
                      (    forth6809.asm):01136                   BNE  SCFAIL
                      (    forth6809.asm):01137         
                      (    forth6809.asm):01138                   PULU D
                      (    forth6809.asm):01139                   CMPD #TSTGUARD
                      (    forth6809.asm):01140                   BNE  SCFAIL
                      (    forth6809.asm):01141         
                      (    forth6809.asm):01142                   LDD  TSTUB4
                      (    forth6809.asm):01143                   SUBD TSTUAF
                      (    forth6809.asm):01144                   CMPD #0
                      (    forth6809.asm):01145                   BNE  SCFAIL
                      (    forth6809.asm):01146         
                      (    forth6809.asm):01147                   LDD  #TRUEV
                      (    forth6809.asm):01148                   BRA  SCDONE
C173                  (    forth6809.asm):01149         SCFAIL:   LDD  #FALSEV
C173                  (    forth6809.asm):01150         SCDONE:  LDX  #TSTSPACENAME
                      (    forth6809.asm):01151                   PSHU X
                      (    forth6809.asm):01152                   PSHU D
                      (    forth6809.asm):01153                   JSR  TSTREPORT
                      (    forth6809.asm):01154         
                      (    forth6809.asm):01155                   LDU  TSTU0
                      (    forth6809.asm):01156                   RTS
                      (    forth6809.asm):01157         
C173                  (    forth6809.asm):01158         TSTSPACENAME: FCB  8
                      (    forth6809.asm):01159                       FCC  "TSTSPACE"
                      (    forth6809.asm):01160         
                      (    forth6809.asm):01161         ; ------------------------------------------------------------
                      (    forth6809.asm):01162         ; TSTSPACES - unit test for SPACES, normal (n=3) case. Verifies
                      (    forth6809.asm):01163         ; all three queued bytes are genuinely spaces (32), not just
                      (    forth6809.asm):01164         ; that OUTHEAD advanced by the right count.
                      (    forth6809.asm):01165         ; ------------------------------------------------------------
C173                  (    forth6809.asm):01166         TSTSPACES: STU  TSTU0
                      (    forth6809.asm):01167         
                      (    forth6809.asm):01168                    IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01169                    LDA  OUTHEAD
                      (    forth6809.asm):01170                    STA  TSTOHSAV
                      (    forth6809.asm):01171                    ENDC ; <<<<
                      (    forth6809.asm):01172         
                      (    forth6809.asm):01173                    LDD  #TSTGUARD
                      (    forth6809.asm):01174                    PSHU D
                      (    forth6809.asm):01175                    LDD  #3
                      (    forth6809.asm):01176                    PSHU D
                      (    forth6809.asm):01177                    STU  TSTUB4
                      (    forth6809.asm):01178         
                      (    forth6809.asm):01179                    JSR  SPACESW
                      (    forth6809.asm):01180         
                      (    forth6809.asm):01181                    STU  TSTUAF
                      (    forth6809.asm):01182         
                      (    forth6809.asm):01183                    IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01184                                     ; queues all three bytes into OUTBUF,
                      (    forth6809.asm):01185                                     ; verifiable individually
                      (    forth6809.asm):01186                    LDA  TSTOHSAV
                      (    forth6809.asm):01187                    ADDA #3
                      (    forth6809.asm):01188                    ANDA #OUTBUFSZ-1
                      (    forth6809.asm):01189                    CMPA OUTHEAD
                      (    forth6809.asm):01190                    BNE  SSFAIL
                      (    forth6809.asm):01191         
                      (    forth6809.asm):01192                    LDX  #OUTBUF
                      (    forth6809.asm):01193                    LDB  TSTOHSAV
                      (    forth6809.asm):01194                    LDA  B,X
                      (    forth6809.asm):01195                    CMPA #32
                      (    forth6809.asm):01196                    BNE  SSFAIL
                      (    forth6809.asm):01197                    INCB
                      (    forth6809.asm):01198                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01199                    LDA  B,X
                      (    forth6809.asm):01200                    CMPA #32
                      (    forth6809.asm):01201                    BNE  SSFAIL
                      (    forth6809.asm):01202                    INCB
                      (    forth6809.asm):01203                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01204                    LDA  B,X
                      (    forth6809.asm):01205                    CMPA #32
                      (    forth6809.asm):01206                    BNE  SSFAIL
                      (    forth6809.asm):01207                    ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking
                      (    forth6809.asm):01208                                     ; OUTHEAD/OUTBUF - same fix and reasoning as
                      (    forth6809.asm):01209                                     ; TSTCR's own fix. In polling mode, EMITCH
                      (    forth6809.asm):01210                                     ; only reflects the LAST of the three
                      (    forth6809.asm):01211                                     ; identical spaces emitted, and there is no
                      (    forth6809.asm):01212                                     ; persistent per-call count to verify
                      (    forth6809.asm):01213                                     ; exactly three calls happened, not just
                      (    forth6809.asm):01214                                     ; one or two - a genuine limitation of a
                      (    forth6809.asm):01215                                     ; direct hardware write with no buffering,
                      (    forth6809.asm):01216                                     ; not something this test can work around.
                      (    forth6809.asm):01217                                     ; The depth check below still confirms n=3
                      (    forth6809.asm):01218                                     ; was correctly consumed as an argument.
                      (    forth6809.asm):01219                    LDA  EMITCH
                      (    forth6809.asm):01220                    CMPA #32
                      (    forth6809.asm):01221                    BNE  SSFAIL
                      (    forth6809.asm):01222                    ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01223         
                      (    forth6809.asm):01224                    PULU D
                      (    forth6809.asm):01225                    CMPD #TSTGUARD
                      (    forth6809.asm):01226                    BNE  SSFAIL
                      (    forth6809.asm):01227         
                      (    forth6809.asm):01228                    LDD  TSTUB4
                      (    forth6809.asm):01229                    SUBD TSTUAF
                      (    forth6809.asm):01230                    CMPD #-2
                      (    forth6809.asm):01231                    BNE  SSFAIL
                      (    forth6809.asm):01232         
                      (    forth6809.asm):01233                    LDD  #TRUEV
                      (    forth6809.asm):01234                    BRA  SSDONE
C173                  (    forth6809.asm):01235         SSFAIL:    LDD  #FALSEV
C173                  (    forth6809.asm):01236         SSDONE:    LDX  #TSTSPACESNAME
                      (    forth6809.asm):01237                    PSHU X
                      (    forth6809.asm):01238                    PSHU D
                      (    forth6809.asm):01239                    JSR  TSTREPORT
                      (    forth6809.asm):01240         
                      (    forth6809.asm):01241                    LDU  TSTU0
                      (    forth6809.asm):01242                    RTS
                      (    forth6809.asm):01243         
C173                  (    forth6809.asm):01244         TSTSPACESNAME: FCB  9
                      (    forth6809.asm):01245                        FCC  "TSTSPACES"
                      (    forth6809.asm):01246         
                      (    forth6809.asm):01247         ; ------------------------------------------------------------
                      (    forth6809.asm):01248         ; TSTSPACESZ - unit test for SPACES, n<=0 case. Documented
                      (    forth6809.asm):01249         ; behavior is "no output if n <= 0" - verifies OUTHEAD genuinely
                      (    forth6809.asm):01250         ; doesn't advance at all, not just that the call didn't crash.
                      (    forth6809.asm):01251         ; ------------------------------------------------------------
C173                  (    forth6809.asm):01252         TSTSPACESZ: LDA  OUTHEAD
                      (    forth6809.asm):01253                     STA  TSTOHSAV
                      (    forth6809.asm):01254         
                      (    forth6809.asm):01255                     STU  TSTU0
                      (    forth6809.asm):01256         
                      (    forth6809.asm):01257                     LDD  #TSTGUARD
                      (    forth6809.asm):01258                     PSHU D
                      (    forth6809.asm):01259                     LDD  #0
                      (    forth6809.asm):01260                     PSHU D
                      (    forth6809.asm):01261                     STU  TSTUB4
                      (    forth6809.asm):01262         
                      (    forth6809.asm):01263                     JSR  SPACESW
                      (    forth6809.asm):01264         
                      (    forth6809.asm):01265                     STU  TSTUAF
                      (    forth6809.asm):01266         
                      (    forth6809.asm):01267                     LDA  TSTOHSAV
                      (    forth6809.asm):01268                     CMPA OUTHEAD
                      (    forth6809.asm):01269                     BNE  S0FAIL
                      (    forth6809.asm):01270         
                      (    forth6809.asm):01271                     PULU D

                      (    forth6809.asm):01759         ; TSTDEPTH - unit test for DEPTH ( -- n ). Independently
                      (    forth6809.asm):01760         ; computes the expected depth via the same (SP0-U)/2 formula
                      (    forth6809.asm):01761         ; DEPTH itself uses, rather than assuming a fixed starting
                      (    forth6809.asm):01762         ; depth - robust regardless of whatever is already on the stack
                      (    forth6809.asm):01763         ; when this test runs. Also verifies DEPTH's own net effect
                      (    forth6809.asm):01764         ; (exactly one cell pushed) and that the three items pushed to
                      (    forth6809.asm):01765         ; set up the test are left undisturbed.
                      (    forth6809.asm):01766         ; ------------------------------------------------------------

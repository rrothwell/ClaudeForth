                      (    forth6809.asm):01556         ; ------------------------------------------------------------
                      (    forth6809.asm):01557         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01558         ; receiver-error counters to zero.
                      (    forth6809.asm):01559         ; SERBUFCLR
                      (    forth6809.asm):01560         ;    Inputs:
                      (    forth6809.asm):01561         ;        none
                      (    forth6809.asm):01562         ;    Outputs:
                      (    forth6809.asm):01563         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01564         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01565         ;    Registers: only CC changed.
                      (    forth6809.asm):01566         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01567         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01568         ; ------------------------------------------------------------
                      (    forth6809.asm):01569         
DCC4 7F0176           (    forth6809.asm):01570         SERBUFCLR:  CLR   INHEAD
DCC7 7F0177           (    forth6809.asm):01571                     CLR   INTAIL

                      (    forth6809.asm):15300         
                      (    forth6809.asm):15301                       LDD  TSTUB4
                      (    forth6809.asm):15302                       SUBD TSTUAF
                      (    forth6809.asm):15303                       CMPD #-2
                      (    forth6809.asm):15304                       BNE  TVFAIL
                      (    forth6809.asm):15305         
                      (    forth6809.asm):15306                       LDD  #TRUEV
                      (    forth6809.asm):15307                       BRA  TVDONE
C308                  (    forth6809.asm):15308         TVFAIL:       LDD  #FALSEV
C308                  (    forth6809.asm):15309         TVDONE:       LDX  #TSTTZNAME
                      (    forth6809.asm):15310                       PSHU X
                      (    forth6809.asm):15311                       PSHU D
                      (    forth6809.asm):15312                       JSR  TSTREPORT
                      (    forth6809.asm):15313         
                      (    forth6809.asm):15314                       LDU  TSTU0
                      (    forth6809.asm):15315                       RTS

                      (    forth6809.asm):03310         ; ============================================================
                      (    forth6809.asm):03311         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03312         ; ============================================================
                      (    forth6809.asm):03313                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03314         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03315         
                      (    forth6809.asm):03316         ; ------------------------------------------------------------
                      (    forth6809.asm):03317         ; KEY  ( -- char )
                      (    forth6809.asm):03318         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03319         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03320         ; ------------------------------------------------------------
E54A                  (    forth6809.asm):03321         KEYW:
                      (    forth6809.asm):03322         
E54A 7D0178           (    forth6809.asm):03323                     TST   RTSSTATE          ; Is throttling?
E54D 2703             (    forth6809.asm):03324                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03325         
                      (    forth6809.asm):03326                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E54F BDDD52           (    forth6809.asm):03327                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03328                                             ; by transmitting all chars.
                      (    forth6809.asm):03329         
E552                  (    forth6809.asm):03330         TRY_READ:
E552 BDDDBF           (    forth6809.asm):03331                     JSR   GETCHAR           ; Is char available in input buffer.
E555 25F3             (    forth6809.asm):03332                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03333                                             ; while still transmitting!
                      (    forth6809.asm):03334         
E557 1F89             (    forth6809.asm):03335                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E559 4F               (    forth6809.asm):03336                     CLRA                    ; Clear MSB.
E55A 3606             (    forth6809.asm):03337                     PSHU  D                 ; char
                      (    forth6809.asm):03338         
E55C 39               (    forth6809.asm):03339                     RTS
                      (    forth6809.asm):03340         
                      (    forth6809.asm):03341         ; ------------------------------------------------------------
                      (    forth6809.asm):03342         ; KEY?  ( -- flag )
                      (    forth6809.asm):03343         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03344         ; ------------------------------------------------------------
E55D                  (    forth6809.asm):03345         KEYQW:
                      (    forth6809.asm):03346                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03347         
E55D B60176           (    forth6809.asm):03348                     LDA   INHEAD            ; Characters received?
E560 B10177           (    forth6809.asm):03349                     CMPA  INTAIL
                      (    forth6809.asm):03350         
                      (    forth6809.asm):03351                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03352         
E563 2606             (    forth6809.asm):03353                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03354         
E565 CC0000           (    forth6809.asm):03355                     LDD   #FALSEV           ; No! Return false result.
E568 3606             (    forth6809.asm):03356                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03357         
E56A 39               (    forth6809.asm):03358                     RTS
                      (    forth6809.asm):03359         
E56B                  (    forth6809.asm):03360         KQTRUE:
E56B CCFFFF           (    forth6809.asm):03361                     LDD   #TRUEV            ; Yes! Return true result.
E56E 3606             (    forth6809.asm):03362                     PSHU  D                 ; flag = true
E570 39               (    forth6809.asm):03363                     RTS
                      (    forth6809.asm):03364         
                      (    forth6809.asm):03365         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03366         
                      (    forth6809.asm):03367         ; ------------------------------------------------------------
                      (    forth6809.asm):03368         ; EMIT  ( char -- )
                      (    forth6809.asm):03369         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03370         ; discarded if the ring is full.
                      (    forth6809.asm):03371         ; ------------------------------------------------------------
E571                  (    forth6809.asm):03372         EMITW:
E571 3706             (    forth6809.asm):03373                     PULU  D                 ; char
E573 1F98             (    forth6809.asm):03374                     TFR   B,A
E575 BDDD74           (    forth6809.asm):03375                     JSR   PUTCHAR           ; Transmit char.
E578 39               (    forth6809.asm):03376                     RTS
                      (    forth6809.asm):03377         
                      (    forth6809.asm):03378                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03379         ; ------------------------------------------------------------
                      (    forth6809.asm):03380         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03381         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03382         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03383         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03384         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03385         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03386         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03387         ; follow.
                      (    forth6809.asm):03388         ; ------------------------------------------------------------
E579                  (    forth6809.asm):03389         KEYW:
                      (    forth6809.asm):03390                     LDA   ACIASR
                      (    forth6809.asm):03391                     BITA  #SR_RDRF
                      (    forth6809.asm):03392                     BEQ   KWAIT
                      (    forth6809.asm):03393                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03394                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E579                  (    forth6809.asm):03395         KWAIT:
E579                  (    forth6809.asm):03396         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03397                     BITA  #SR_RDRF
                      (    forth6809.asm):03398                     BEQ   KSPIN
E579                  (    forth6809.asm):03399         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03400                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03401                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03402                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03403                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03404                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03405                     BEQ   KGETCH
                      (    forth6809.asm):03406                     BITA  #SR_FE
                      (    forth6809.asm):03407                     BEQ   KXFE
                      (    forth6809.asm):03408                     INC   FECOUNT
E579                  (    forth6809.asm):03409         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03410                     BEQ   KXOVRN
                      (    forth6809.asm):03411                     INC   OVRNCOUNT
E579                  (    forth6809.asm):03412         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03413                     BEQ   KGETCH
                      (    forth6809.asm):03414                     INC   PECOUNT
E579                  (    forth6809.asm):03415         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03416                     TFR   A,B
                      (    forth6809.asm):03417                     CLRA
                      (    forth6809.asm):03418                     PSHU  D                 ; char
                      (    forth6809.asm):03419                     RTS
                      (    forth6809.asm):03420         
                      (    forth6809.asm):03421         ; ------------------------------------------------------------
                      (    forth6809.asm):03422         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03423         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03424         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03425         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03426         ;    Inputs:
                      (    forth6809.asm):03427         ;        none
                      (    forth6809.asm):03428         ;    Outputs:
                      (    forth6809.asm):03429         ;        XON or XOFF transmitted
                      (    forth6809.asm):03430         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03431         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03432         ; ------------------------------------------------------------
E579                  (    forth6809.asm):03433         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03434                     BRA   PUTXCH
E579                  (    forth6809.asm):03435         PUTXON:     LDA   #XONCH
E579                  (    forth6809.asm):03436         PUTXCH:     PSHS  A
E579                  (    forth6809.asm):03437         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03438                     BITB  #SR_TDRE
                      (    forth6809.asm):03439                     BEQ   PXWT
                      (    forth6809.asm):03440                     PULS  A
                      (    forth6809.asm):03441                     STA   ACIADR
                      (    forth6809.asm):03442                     RTS
                      (    forth6809.asm):03443         
                      (    forth6809.asm):03444         ; ------------------------------------------------------------
                      (    forth6809.asm):03445         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03446         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03447         ; ------------------------------------------------------------
E579                  (    forth6809.asm):03448         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03449                     BITA  #SR_RDRF
                      (    forth6809.asm):03450                     BEQ   KQFALSE

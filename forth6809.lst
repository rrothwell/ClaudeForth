F3F4 A780             (    forth6809.asm):06316                     STA   ,X+
F3F6 5A               (    forth6809.asm):06317                     DECB
F3F7 26F9             (    forth6809.asm):06318                     BNE   CSCPY
F3F9 9F08             (    forth6809.asm):06319         CSEND:      STX   CODEHERE
F3FB 39               (    forth6809.asm):06320                     RTS
                      (    forth6809.asm):06321         
                      (    forth6809.asm):06322         ; ------------------------------------------------------------
                      (    forth6809.asm):06323         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06324         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06325         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06326         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06327         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06328         ; ------------------------------------------------------------
F3FC BDF3CD           (    forth6809.asm):06329         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F3FF DC00             (    forth6809.asm):06330                     LDD   STATE
F401 2706             (    forth6809.asm):06331                     BEQ   SQINTERP
F403 CCF3BD           (    forth6809.asm):06332                     LDD   #DOSTR
F406 7EF3E2           (    forth6809.asm):06333                     JMP   CSTRCOMP
                      (    forth6809.asm):06334         
                      (    forth6809.asm):06335                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06336                     ; SQUOTEW.2.
F409                  (    forth6809.asm):06337         SQINTERP:
F409 BDE03C           (    forth6809.asm):06338                     JSR   PADW
F40C 3710             (    forth6809.asm):06339                     PULU  X                 ; PAD
F40E 3706             (    forth6809.asm):06340                     PULU  D                 ; u
F410 3720             (    forth6809.asm):06341                     PULU  Y                 ; c-addr
F412 3610             (    forth6809.asm):06342                     PSHU  X                 ; result c-addr
F414 3606             (    forth6809.asm):06343                     PSHU  D                 ; result u
F416 5D               (    forth6809.asm):06344                     TSTB
F417 2707             (    forth6809.asm):06345                     BEQ   SQIEND
F419 A6A0             (    forth6809.asm):06346         SQICPY:     LDA   ,Y+
F41B A780             (    forth6809.asm):06347                     STA   ,X+
F41D 5A               (    forth6809.asm):06348                     DECB
F41E 26F9             (    forth6809.asm):06349                     BNE   SQICPY
F420 39               (    forth6809.asm):06350         SQIEND:     RTS
                      (    forth6809.asm):06351         
                      (    forth6809.asm):06352         ; ------------------------------------------------------------
                      (    forth6809.asm):06353         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06354         ; and skip over it.
                      (    forth6809.asm):06355         ; DOTSTR
                      (    forth6809.asm):06356         ;    Inputs:
                      (    forth6809.asm):06357         ;        return address on S points at the count byte
                      (    forth6809.asm):06358         ;    Outputs:
                      (    forth6809.asm):06359         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06360         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06361         ; ------------------------------------------------------------
F421 3510             (    forth6809.asm):06362         DOTSTR:     PULS  X
F423 E684             (    forth6809.asm):06363                     LDB   ,X
F425 3001             (    forth6809.asm):06364                     LEAX  1,X
F427 3610             (    forth6809.asm):06365                     PSHU  X

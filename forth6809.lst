                      (    forth6809.asm):05400         ; TSTCOMPARE - comparison tests (glossary section 3.7). Covers
                      (    forth6809.asm):05401         ; every word in that section. Like several words in the previous
                      (    forth6809.asm):05402         ; group, most of these modify the top of stack in place rather
                      (    forth6809.asm):05403         ; than PULU/PSHU - the tests verify what's observable via the
                      (    forth6809.asm):05404         ; stack either way. Signed vs unsigned comparisons (</U<, >/U>)
                      (    forth6809.asm):05405         ; each tested with a case that would give the opposite answer
                      (    forth6809.asm):05406         ; under the other convention, confirming genuine sign-awareness
                      (    forth6809.asm):05407         ; rather than an accidentally-shared implementation. WITHIN
                      (    forth6809.asm):05408         ; tested against a wraparound range specifically (n2 near $FFFF,
                      (    forth6809.asm):05409         ; n3 wrapped past $0000), both inside and outside cases - the
                      (    forth6809.asm):05410         ; documented special case its own unsigned-offset implementation
                      (    forth6809.asm):05411         ; exists to handle, not just an ordinary non-wrapping range. D</
                      (    forth6809.asm):05412         ; DU< both tested with equal high cells and different low cells -
                      (    forth6809.asm):05413         ; the documented tie-break case a naive high-cell-only comparison
                      (    forth6809.asm):05414         ; would get wrong.
                      (    forth6809.asm):05415         ; ------------------------------------------------------------
C100                  (    forth6809.asm):05416         TSTCOMPARE: JSR   CRW
                      (    forth6809.asm):05417                    LDX   #TSTCOMPMSG
                      (    forth6809.asm):05418                    PSHU  X
                      (    forth6809.asm):05419                    LDD   #7
                      (    forth6809.asm):05420                    PSHU  D
                      (    forth6809.asm):05421                    JSR   TYPE
                      (    forth6809.asm):05422                    JSR   CRW
                      (    forth6809.asm):05423         
                      (    forth6809.asm):05424                    IFEQ TSTSELECTOR-6  ; >>>>
                      (    forth6809.asm):05425         
                      (    forth6809.asm):05426                    JSR   TSTEQ
                      (    forth6809.asm):05427                    JSR   TSTLT
                      (    forth6809.asm):05428                    JSR   TSTGT
                      (    forth6809.asm):05429                    JSR   TSTZEQ
                      (    forth6809.asm):05430                    JSR   TSTZLT
                      (    forth6809.asm):05431                    JSR   TSTULT
                      (    forth6809.asm):05432                    JSR   TSTNE
                      (    forth6809.asm):05433                    JSR   TSTZNE
                      (    forth6809.asm):05434                    JSR   TSTZGT
                      (    forth6809.asm):05435                    JSR   TSTUGT
                      (    forth6809.asm):05436                    JSR   TSTWI1
                      (    forth6809.asm):05437                    JSR   TSTWI2
                      (    forth6809.asm):05438                    JSR   TSTDEQ
                      (    forth6809.asm):05439                    JSR   TSTDLT
                      (    forth6809.asm):05440                    JSR   TSTDULT
                      (    forth6809.asm):05441         
                      (    forth6809.asm):05442                    ENDC ; <<<<
                      (    forth6809.asm):05443         
                      (    forth6809.asm):05444                    RTS
                      (    forth6809.asm):05445         

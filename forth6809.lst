                      (    forth6809.asm):03857         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03858         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03859         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03860         ; ------------------------------------------------------------
E763 CCDF70           (    forth6809.asm):03861         WHILEW:     LDD   #ZBRANCH
E766 3606             (    forth6809.asm):03862                     PSHU  D
E768 BDEABB           (    forth6809.asm):03863                     JSR   CCALL
E76B CC0000           (    forth6809.asm):03864                     LDD   #0
E76E 3606             (    forth6809.asm):03865                     PSHU  D
E770 BDE002           (    forth6809.asm):03866                     JSR   CODECOMMA
E773 DC08             (    forth6809.asm):03867                     LDD   CODEHERE
E775 830002           (    forth6809.asm):03868                     SUBD  #2
E778 3606             (    forth6809.asm):03869                     PSHU  D                 ; orig
E77A CC0001           (    forth6809.asm):03870                     LDD   #TAGFWD
E77D 3606             (    forth6809.asm):03871                     PSHU  D
E77F 39               (    forth6809.asm):03872                     RTS
                      (    forth6809.asm):03873         
                      (    forth6809.asm):03874         ; ------------------------------------------------------------
                      (    forth6809.asm):03875         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03876         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03877         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03878         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03879         ; ------------------------------------------------------------
E780 3706             (    forth6809.asm):03880         REPEATW:    PULU  D
E782 10830001         (    forth6809.asm):03881                     CMPD  #TAGFWD
E786 2703             (    forth6809.asm):03882                     BEQ   RPOK1
E788 BDE611           (    forth6809.asm):03883                     JSR   CFERR
E78B 3710             (    forth6809.asm):03884         RPOK1:      PULU  X                 ; orig
E78D 9F41             (    forth6809.asm):03885                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03886         
                      (    forth6809.asm):03887                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03888                     ; See bugfix: REPEATW.1
E78F 3040             (    forth6809.asm):03889                     LEAX  0,U               ; scan from top of control stack
E791 9F2B             (    forth6809.asm):03890                     STX   MSCR2             ; MSCR2 = base of scan region
E793 9F2F             (    forth6809.asm):03891                     STX   MSCR4             ; MSCR4 = scan pointer
E795 DC2F             (    forth6809.asm):03892         RPSCAN:     LDD   MSCR4
E797 109343           (    forth6809.asm):03893                     CMPD  CSP
E79A 2603             (    forth6809.asm):03894                     BNE   RPSCANOK
E79C BDE611           (    forth6809.asm):03895                     JSR   CFERR             ; no matching BEGIN
E79F 9E2F             (    forth6809.asm):03896         RPSCANOK:   LDX   MSCR4
E7A1 EC84             (    forth6809.asm):03897                     LDD   ,X
E7A3 10830002         (    forth6809.asm):03898                     CMPD  #TAGBACK
E7A7 2712             (    forth6809.asm):03899                     BEQ   RPFOUND
E7A9 10830001         (    forth6809.asm):03900                     CMPD  #TAGFWD
E7AD 2703             (    forth6809.asm):03901                     BEQ   RPSKIP
E7AF BDE611           (    forth6809.asm):03902                     JSR   CFERR             ; anything else is a genuine mismatch
E7B2 DC2F             (    forth6809.asm):03903         RPSKIP:     LDD   MSCR4
E7B4 C30004           (    forth6809.asm):03904                     ADDD  #4
E7B7 DD2F             (    forth6809.asm):03905                     STD   MSCR4
E7B9 20DA             (    forth6809.asm):03906                     BRA   RPSCAN
E7BB 9E2F             (    forth6809.asm):03907         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E7BD EC02             (    forth6809.asm):03908                     LDD   2,X               ; dest = BEGIN's address
E7BF DD3F             (    forth6809.asm):03909                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):03910         
                      (    forth6809.asm):03911                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03912                     ; bytes, highest word first.
E7C1 DC2F             (    forth6809.asm):03913                     LDD   MSCR4
E7C3 932B             (    forth6809.asm):03914                     SUBD  MSCR2
E7C5 DD2D             (    forth6809.asm):03915                     STD   MSCR3             ; MSCR3 = bytes to shift
E7C7 2715             (    forth6809.asm):03916                     BEQ   RPSHIFTDONE
E7C9 DC2D             (    forth6809.asm):03917         RPSHIFT:    LDD   MSCR3
E7CB 830002           (    forth6809.asm):03918                     SUBD  #2
E7CE DD2D             (    forth6809.asm):03919                     STD   MSCR3
E7D0 9E2B             (    forth6809.asm):03920                     LDX   MSCR2
E7D2 308B             (    forth6809.asm):03921                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E7D4 EC84             (    forth6809.asm):03922                     LDD   ,X
E7D6 3004             (    forth6809.asm):03923                     LEAX  4,X
E7D8 ED84             (    forth6809.asm):03924                     STD   ,X                ; copy one word 4 bytes higher
E7DA DC2D             (    forth6809.asm):03925                     LDD   MSCR3
E7DC 26EB             (    forth6809.asm):03926                     BNE   RPSHIFT
E7DE                  (    forth6809.asm):03927         RPSHIFTDONE:
E7DE 9E2B             (    forth6809.asm):03928                     LDX   MSCR2
E7E0 3004             (    forth6809.asm):03929                     LEAX  4,X
E7E2 1F13             (    forth6809.asm):03930                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03931         
E7E4 CCDF86           (    forth6809.asm):03932                     LDD   #BRANCH
E7E7 3606             (    forth6809.asm):03933                     PSHU  D
E7E9 BDEABB           (    forth6809.asm):03934                     JSR   CCALL
E7EC CC0000           (    forth6809.asm):03935                     LDD   #0
E7EF 3606             (    forth6809.asm):03936                     PSHU  D
E7F1 BDE002           (    forth6809.asm):03937                     JSR   CODECOMMA
E7F4 DC08             (    forth6809.asm):03938                     LDD   CODEHERE
E7F6 830002           (    forth6809.asm):03939                     SUBD  #2
E7F9 DD2D             (    forth6809.asm):03940                     STD   MSCR3             ; MSCR3 = branch operand address
E7FB DC3F             (    forth6809.asm):03941                     LDD   PFIELD            ; target = BEGIN's address
E7FD 3606             (    forth6809.asm):03942                     PSHU  D
E7FF DC2D             (    forth6809.asm):03943                     LDD   MSCR3             ; location = the operand just compiled
E801 3606             (    forth6809.asm):03944                     PSHU  D
E803 BDE67B           (    forth6809.asm):03945                     JSR   PATCH
E806 DC08             (    forth6809.asm):03946                     LDD   CODEHERE
E808 3606             (    forth6809.asm):03947                     PSHU  D
E80A DC41             (    forth6809.asm):03948                     LDD   NEWFLD
E80C 3606             (    forth6809.asm):03949                     PSHU  D
E80E BDE67B           (    forth6809.asm):03950                     JSR   PATCH

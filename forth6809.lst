                      (    forth6809.asm):00713         
                      (    forth6809.asm):00714         ; ============================================================
                      (    forth6809.asm):00715         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00716         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):00717         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):00718         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):00719         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):00720         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):00721         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):00722         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):00723         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):00724         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):00725         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):00726         ; they no longer need indirection.
                      (    forth6809.asm):00727         ;
                      (    forth6809.asm):00728         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):00729         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):00730         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):00731         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):00732         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):00733         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):00734         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):00735         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):00736         ;
                      (    forth6809.asm):00737         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):00738         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):00739         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):00740         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):00741         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):00742         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):00743         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):00744         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):00745         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):00746         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):00747         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):00748         ;
                      (    forth6809.asm):00749         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):00750         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):00751         ;
                      (    forth6809.asm):00752         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):00753         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):00754         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):00755         ; ============================================================
                      (    forth6809.asm):00756         
                      (    forth6809.asm):00757                  ORG   BASEDICT       ; BASEDICT is $D83F
                      (    forth6809.asm):00758         
D81F                  (    forth6809.asm):00759         H_KEY:
D81F 03               (    forth6809.asm):00760                  FCB   $03
D820 4B4559           (    forth6809.asm):00761                  FCC   "KEY"
D823 0000             (    forth6809.asm):00762                  FDB   0

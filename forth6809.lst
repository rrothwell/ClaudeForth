                      (    forth6809.asm):06746         
                      (    forth6809.asm):06747                  LDD   #DUP
                      (    forth6809.asm):06748                  PSHU  D
                      (    forth6809.asm):06749                  JSR   CCALL
                      (    forth6809.asm):06750         
                      (    forth6809.asm):06751                  LDD   #3
                      (    forth6809.asm):06752                  PSHU  D
                      (    forth6809.asm):06753                  JSR   LITERALW
                      (    forth6809.asm):06754         
                      (    forth6809.asm):06755                  LDD   #EQUALW
                      (    forth6809.asm):06756                  PSHU  D
                      (    forth6809.asm):06757                  JSR   CCALL
                      (    forth6809.asm):06758         
                      (    forth6809.asm):06759                  JSR   IF
                      (    forth6809.asm):06760         
                      (    forth6809.asm):06761                  JSR   EXIT
                      (    forth6809.asm):06762         
                      (    forth6809.asm):06763                  JSR   THEN
                      (    forth6809.asm):06764         

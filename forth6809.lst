                      (    forth6809.asm):05488         ; ------------------------------------------------------------
                      (    forth6809.asm):05489         ; '  ( "name" -- xt )
                      (    forth6809.asm):05490         ; Parse the next blank-delimited name and return its xt. THROW -13 if
                      (    forth6809.asm):05491         ; the name is not found.
                      (    forth6809.asm):05492         ; ------------------------------------------------------------
DE0B CC0020           (    forth6809.asm):05493         TICKW:      LDD   #32
DE0E 3606             (    forth6809.asm):05494                     PSHU  D                 ; BL delimiter
DE10 BDD493           (    forth6809.asm):05495                     JSR   WORDW
DE13 BDD57C           (    forth6809.asm):05496                     JSR   FINDW
DE16 3706             (    forth6809.asm):05497                     PULU  D                 ; found flag
DE18 10830000         (    forth6809.asm):05498                     CMPD  #0
DE1C 260A             (    forth6809.asm):05499                     BNE   TICKOK
DE1E 3706             (    forth6809.asm):05500                     PULU  D                 ; drop the name
DE20 CCFFF3           (    forth6809.asm):05501                     LDD   #-13              ; -13
DE23 3606             (    forth6809.asm):05502                     PSHU  D
DE25 BDD9F1           (    forth6809.asm):05503                     JSR   THROWW
DE28 39               (    forth6809.asm):05504         TICKOK:     RTS
                      (    forth6809.asm):05505         
                      (    forth6809.asm):05506         ; ------------------------------------------------------------
                      (    forth6809.asm):05507         ; COMPILE,  ( xt -- )
                      (    forth6809.asm):05508         ; Compile a call to xt (see CCALL).
                      (    forth6809.asm):05509         ; ------------------------------------------------------------
DE29                  (    forth6809.asm):05510         COMPILECOMMAW:
DE29 7EDE2C           (    forth6809.asm):05511                     JMP   CCALL
                      (    forth6809.asm):05512         
                      (    forth6809.asm):05513         ; ------------------------------------------------------------
                      (    forth6809.asm):05514         ; Append a JSR to xt at the code pointer CODEHERE.
                      (    forth6809.asm):05515         ; CCALL   ( xt -- )
                      (    forth6809.asm):05516         ;    Inputs:
                      (    forth6809.asm):05517         ;        xt on the data stack
                      (    forth6809.asm):05518         ;    Outputs:
                      (    forth6809.asm):05519         ;        JSR xt appended at CODEHERE; CODEHERE advanced by 3
                      (    forth6809.asm):05520         ;    Registers: RegA, RegB, RegD and RegX changed.
                      (    forth6809.asm):05521         ; ------------------------------------------------------------
DE2C 9E08             (    forth6809.asm):05522         CCALL:      LDX   CODEHERE          ; X = code pointer
DE2E 86BD             (    forth6809.asm):05523                     LDA   #OPJSR            ; JSR opcode
DE30 A780             (    forth6809.asm):05524                     STA   ,X+
DE32 3706             (    forth6809.asm):05525                     PULU  D                 ; xt
DE34 ED81             (    forth6809.asm):05526                     STD   ,X++              ; See bugfix: CCALL.1
DE36 9F08             (    forth6809.asm):05527                     STX   CODEHERE
DE38 39               (    forth6809.asm):05528                     RTS
                      (    forth6809.asm):05529         
                      (    forth6809.asm):05530         ; ------------------------------------------------------------
                      (    forth6809.asm):05531         ; LITERAL  ( x -- )
                      (    forth6809.asm):05532         ; Compile LIT followed by x, so that x is pushed when the definition
                      (    forth6809.asm):05533         ; runs.
                      (    forth6809.asm):05534         ; ------------------------------------------------------------
DE39 CCD044           (    forth6809.asm):05535         LITERALW:   LDD   #LIT
DE3C 3606             (    forth6809.asm):05536                     PSHU  D

                      (    forth6809.asm):15208         ; TSTTHROWHLP - internal helper, not a dictionary word or a
                      (    forth6809.asm):15209         ; test of its own. Pushes two dummy values (to verify CATCH's
                      (    forth6809.asm):15210         ; own stack-depth restoration genuinely discards them, not just
                      (    forth6809.asm):15211         ; that a thrown code arrives correctly) then throws a known,
                      (    forth6809.asm):15212         ; distinctive, non-trivial code. Only ever invoked via CATCH
                      (    forth6809.asm):15213         ; (below), never called directly - calling it any other way
                      (    forth6809.asm):15214         ; would hit THROW's own uncaught path (JMP ABORT), which this
                      (    forth6809.asm):15215         ; whole test framework cannot survive.
                      (    forth6809.asm):15216         ; ------------------------------------------------------------
C305                  (    forth6809.asm):15217         TSTTHROWHLP: LDD  #TSTVAL1
                      (    forth6809.asm):15218                      PSHU D
                      (    forth6809.asm):15219                      LDD  #TSTVAL2
                      (    forth6809.asm):15220                      PSHU D
                      (    forth6809.asm):15221                      LDD  #TSTNEG1
                      (    forth6809.asm):15222                      PSHU D
                      (    forth6809.asm):15223                      JSR  THROW
                      (    forth6809.asm):15224                      RTS
                      (    forth6809.asm):15225         
                      (    forth6809.asm):15226         ; ------------------------------------------------------------
                      (    forth6809.asm):15227         ; TSTCATCHTHROW - unit test for CATCH, exception path, and for
                      (    forth6809.asm):15228         ; THROW's own non-local exit together (the two can only be
                      (    forth6809.asm):15229         ; meaningfully tested as a pair - THROW's own effect is only
                      (    forth6809.asm):15230         ; observable through a CATCH that traps it). Verifies CATCH
                      (    forth6809.asm):15231         ; returns the exact thrown code, and specifically verifies the
                      (    forth6809.asm):15232         ; two dummy values TSTTHROWHLP pushes before throwing are
                      (    forth6809.asm):15233         ; genuinely gone afterward - confirming the documented "restores
                      (    forth6809.asm):15234         ; data stack depth... on either path" for real, not just that
                      (    forth6809.asm):15235         ; the final result happens to look right.
                      (    forth6809.asm):15236         ; ------------------------------------------------------------
C305                  (    forth6809.asm):15237         TSTCATCHTHROW: STU  TSTU0
                      (    forth6809.asm):15238         
                      (    forth6809.asm):15239                        LDD  #TSTGUARD
                      (    forth6809.asm):15240                        PSHU D
                      (    forth6809.asm):15241                        LDX  #TSTTHROWHLP
                      (    forth6809.asm):15242                        PSHU X
                      (    forth6809.asm):15243                        STU  TSTUB4
                      (    forth6809.asm):15244         
                      (    forth6809.asm):15245                        JSR  CATCH
                      (    forth6809.asm):15246         
                      (    forth6809.asm):15247                        STU  TSTUAF
                      (    forth6809.asm):15248         
                      (    forth6809.asm):15249                        PULU D
                      (    forth6809.asm):15250                        CMPD #TSTNEG1
                      (    forth6809.asm):15251                        BNE  CTFAIL2
                      (    forth6809.asm):15252                        PULU D
                      (    forth6809.asm):15253                        CMPD #TSTGUARD
                      (    forth6809.asm):15254                        BNE  CTFAIL2
                      (    forth6809.asm):15255         
                      (    forth6809.asm):15256                        LDD  TSTUB4
                      (    forth6809.asm):15257                        SUBD TSTUAF
                      (    forth6809.asm):15258                        CMPD #0
                      (    forth6809.asm):15259                        BNE  CTFAIL2
                      (    forth6809.asm):15260         
                      (    forth6809.asm):15261                        LDD  #TRUEV
                      (    forth6809.asm):15262                        BRA  CTDONE2
C305                  (    forth6809.asm):15263         CTFAIL2:       LDD  #FALSEV
C305                  (    forth6809.asm):15264         CTDONE2:       LDX  #TSTCTNAME2
                      (    forth6809.asm):15265                        PSHU X
                      (    forth6809.asm):15266                        PSHU D
                      (    forth6809.asm):15267                        JSR  TSTREPORT
                      (    forth6809.asm):15268         
                      (    forth6809.asm):15269                        LDU  TSTU0
                      (    forth6809.asm):15270                        RTS
                      (    forth6809.asm):15271         
C305                  (    forth6809.asm):15272         TSTCTNAME2: FCB  13
                      (    forth6809.asm):15273                     FCC  "TSTCATCHTHROW"
                      (    forth6809.asm):15274         

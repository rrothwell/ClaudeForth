                      (    forth6809.asm):03630                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03631                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03632                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03633                  ; for it.

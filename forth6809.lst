                      (    forth6809.asm):08504         ; ------------------------------------------------------------
                      (    forth6809.asm):08505         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):08506         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):08507         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):08508         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):08509         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):08510         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):08511         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):08512         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):08513         ; available the skip ends.
                      (    forth6809.asm):08514         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):08515         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):08516         ; ------------------------------------------------------------

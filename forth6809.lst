                      (    forth6809.asm):02077         ; ============================================================
                      (    forth6809.asm):02078         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02079         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02080         ; ============================================================
                      (    forth6809.asm):02081         ; ------------------------------------------------------------
                      (    forth6809.asm):02082         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02083         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02084         ; LIT   ( -- x )
                      (    forth6809.asm):02085         ;    Inputs:
                      (    forth6809.asm):02086         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02087         ;    Outputs:
                      (    forth6809.asm):02088         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02089         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02090         ; ------------------------------------------------------------
DF67 3510             (    forth6809.asm):02091         LIT:        PULS  X
DF69 EC81             (    forth6809.asm):02092                     LDD   ,X++
DF6B 3606             (    forth6809.asm):02093                     PSHU  D                 ; x
DF6D 3410             (    forth6809.asm):02094                     PSHS  X
DF6F 39               (    forth6809.asm):02095                     RTS
                      (    forth6809.asm):02096         
                      (    forth6809.asm):02097         ; ------------------------------------------------------------
                      (    forth6809.asm):02098         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02099         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02100         ; address.
                      (    forth6809.asm):02101         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02102         ;    Inputs:
                      (    forth6809.asm):02103         ;        flag on the data stack
                      (    forth6809.asm):02104         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02105         ;    Outputs:
                      (    forth6809.asm):02106         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02107         ;        the offset
                      (    forth6809.asm):02108         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
DF70 3706             (    forth6809.asm):02110         ZBRANCH:    PULU  D                 ; flag
DF72 3510             (    forth6809.asm):02111                     PULS  X
DF74 10830000         (    forth6809.asm):02112                     CMPD  #0
DF78 2607             (    forth6809.asm):02113                     BNE   ZSKIP
DF7A EC84             (    forth6809.asm):02114                     LDD   ,X
DF7C 308B             (    forth6809.asm):02115                     LEAX  D,X
DF7E 3410             (    forth6809.asm):02116                     PSHS  X
DF80 39               (    forth6809.asm):02117                     RTS
DF81 3002             (    forth6809.asm):02118         ZSKIP:      LEAX  2,X
DF83 3410             (    forth6809.asm):02119                     PSHS  X
DF85 39               (    forth6809.asm):02120                     RTS
                      (    forth6809.asm):02121         
                      (    forth6809.asm):02122         ; ------------------------------------------------------------
                      (    forth6809.asm):02123         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02124         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02125         ; BRANCH
                      (    forth6809.asm):02126         ;    Inputs:
                      (    forth6809.asm):02127         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02128         ;    Outputs:
                      (    forth6809.asm):02129         ;        return address set to the branch target
                      (    forth6809.asm):02130         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02131         ; ------------------------------------------------------------
DF86 3510             (    forth6809.asm):02132         BRANCH:     PULS  X
DF88 EC84             (    forth6809.asm):02133                     LDD   ,X
DF8A 308B             (    forth6809.asm):02134                     LEAX  D,X
DF8C 3410             (    forth6809.asm):02135                     PSHS  X
DF8E 39               (    forth6809.asm):02136                     RTS
                      (    forth6809.asm):02137         
                      (    forth6809.asm):02138         ; ------------------------------------------------------------
                      (    forth6809.asm):02139         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02140         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02141         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02142         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02143         ;    Inputs:
                      (    forth6809.asm):02144         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02145         ;        trampoline
                      (    forth6809.asm):02146         ;    Outputs:
                      (    forth6809.asm):02147         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02148         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02149         ; ------------------------------------------------------------
DF8F 3510             (    forth6809.asm):02150         DODOES:     PULS  X
DF91 10AE81           (    forth6809.asm):02151                     LDY   ,X++
DF94 EC84             (    forth6809.asm):02152                     LDD   ,X
DF96 3606             (    forth6809.asm):02153                     PSHU  D                 ; pfa
DF98 6EA4             (    forth6809.asm):02154                     JMP   ,Y
                      (    forth6809.asm):02155         
                      (    forth6809.asm):02156         ; ------------------------------------------------------------
                      (    forth6809.asm):02157         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02158         ; field address on the stack.
                      (    forth6809.asm):02159         ; DOESRT0
                      (    forth6809.asm):02160         ;    Inputs:
                      (    forth6809.asm):02161         ;        none
                      (    forth6809.asm):02162         ;    Outputs:
                      (    forth6809.asm):02163         ;        none
                      (    forth6809.asm):02164         ;    Registers: none.
                      (    forth6809.asm):02165         ; ------------------------------------------------------------
DF9A 39               (    forth6809.asm):02166         DOESRT0:    RTS
                      (    forth6809.asm):02167         
                      (    forth6809.asm):02168         ; ------------------------------------------------------------
                      (    forth6809.asm):02169         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02170         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02171         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02172         ; SETDOES
                      (    forth6809.asm):02173         ;    Inputs:
                      (    forth6809.asm):02174         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02175         ;        BEHAVIOR)
                      (    forth6809.asm):02176         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02177         ;        address
                      (    forth6809.asm):02178         ;    Outputs:
                      (    forth6809.asm):02179         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02180         ;        defining word's caller
                      (    forth6809.asm):02181         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02182         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):02183         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF9D 1F12             (    forth6809.asm):02184                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02185         
DF9F 9E04             (    forth6809.asm):02186                     LDX   LATEST
DFA1 E684             (    forth6809.asm):02187                     LDB   ,X
DFA3 C41F             (    forth6809.asm):02188                     ANDB  #$1F
DFA5 4F               (    forth6809.asm):02189                     CLRA
DFA6 308B             (    forth6809.asm):02190                     LEAX  D,X               ; header + name length
DFA8 EC03             (    forth6809.asm):02191                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DFAA C30003           (    forth6809.asm):02192                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFAD 1F01             (    forth6809.asm):02193                     TFR   D,X
                      (    forth6809.asm):02194         
DFAF 10AF84           (    forth6809.asm):02195                     STY   ,X                ; patch it
                      (    forth6809.asm):02196         
DFB2 3510             (    forth6809.asm):02197                     PULS  X                 ; X = the OUTER defining word's own return addr
DFB4 6E84             (    forth6809.asm):02198                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02199         
                      (    forth6809.asm):02200         ; ------------------------------------------------------------
                      (    forth6809.asm):02201         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02202         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02203         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02204         ;    Inputs:
                      (    forth6809.asm):02205         ;        pfa on the data stack
                      (    forth6809.asm):02206         ;    Outputs:
                      (    forth6809.asm):02207         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02208         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02209         ; ------------------------------------------------------------
DFB6 3710             (    forth6809.asm):02210         DODEFER:    PULU  X                 ; pfa
DFB8 EC84             (    forth6809.asm):02211                     LDD   ,X
DFBA 1F01             (    forth6809.asm):02212                     TFR   D,X
DFBC 6E84             (    forth6809.asm):02213                     JMP   ,X
                      (    forth6809.asm):02214         
                      (    forth6809.asm):02215         ; ------------------------------------------------------------
                      (    forth6809.asm):02216         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02217         ; DOABORTUNDEF
                      (    forth6809.asm):02218         ;    Inputs:
                      (    forth6809.asm):02219         ;        none
                      (    forth6809.asm):02220         ;    Outputs:
                      (    forth6809.asm):02221         ;        none (does not return)
                      (    forth6809.asm):02222         ;    Registers: RegD changed.
                      (    forth6809.asm):02223         ; ------------------------------------------------------------
DFBE                  (    forth6809.asm):02224         DOABORTUNDEF:
DFBE CCFFEB           (    forth6809.asm):02225                     LDD   #-21
DFC1 3606             (    forth6809.asm):02226                     PSHU  D                 ; throw code (-21)
DFC3 7EE5FE           (    forth6809.asm):02227                     JMP   THROWW
                      (    forth6809.asm):02228         
                      (    forth6809.asm):02229         ; ------------------------------------------------------------
                      (    forth6809.asm):02230         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02231         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02232         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02233         ;    Inputs:
                      (    forth6809.asm):02234         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02235         ;    Outputs:
                      (    forth6809.asm):02236         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02237         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02238         ; ------------------------------------------------------------
DFC6 3710             (    forth6809.asm):02239         DOMARKER:   PULU  X                 ; pfa
DFC8 EC84             (    forth6809.asm):02240                     LDD   ,X
DFCA DD06             (    forth6809.asm):02241                     STD   DPHERE
DFCC EC02             (    forth6809.asm):02242                     LDD   2,X
DFCE DD08             (    forth6809.asm):02243                     STD   CODEHERE
DFD0 EC04             (    forth6809.asm):02244                     LDD   4,X
DFD2 DD0A             (    forth6809.asm):02245                     STD   VARHERE
DFD4 EC06             (    forth6809.asm):02246                     LDD   6,X
DFD6 DD04             (    forth6809.asm):02247                     STD   LATEST
DFD8 39               (    forth6809.asm):02248                     RTS
                      (    forth6809.asm):02249         
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
                      (    forth6809.asm):02251         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02252         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02253         ; ------------------------------------------------------------
DFD9 3710             (    forth6809.asm):02254         EXECUTEW:   PULU  X                 ; xt
DFDB AD84             (    forth6809.asm):02255                     JSR   ,X
DFDD 39               (    forth6809.asm):02256                     RTS
                      (    forth6809.asm):02257         
                      (    forth6809.asm):02258         ; ============================================================
                      (    forth6809.asm):02259         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02260         ; ============================================================
                      (    forth6809.asm):02261         ; ------------------------------------------------------------
                      (    forth6809.asm):02262         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02263         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02264         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02265         ;    Inputs:
                      (    forth6809.asm):02266         ;        RegX = address of the here pointer
                      (    forth6809.asm):02267         ;        x on the data stack
                      (    forth6809.asm):02268         ;    Outputs:
                      (    forth6809.asm):02269         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02270         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02271         ; ------------------------------------------------------------
DFDE 3706             (    forth6809.asm):02272         APPENDCELL: PULU  D                 ; x
DFE0 10AE84           (    forth6809.asm):02273                     LDY   ,X
DFE3 EDA1             (    forth6809.asm):02274                     STD   ,Y++
DFE5 10AF84           (    forth6809.asm):02275                     STY   ,X
DFE8 39               (    forth6809.asm):02276                     RTS
                      (    forth6809.asm):02277         
                      (    forth6809.asm):02278         ; ------------------------------------------------------------
                      (    forth6809.asm):02279         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02280         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02281         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02282         ;    Inputs:
                      (    forth6809.asm):02283         ;        RegX = address of the here pointer
                      (    forth6809.asm):02284         ;        char on the data stack
                      (    forth6809.asm):02285         ;    Outputs:
                      (    forth6809.asm):02286         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02287         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02288         ; ------------------------------------------------------------
DFE9 3706             (    forth6809.asm):02289         APPENDBYTE: PULU  D                 ; char
DFEB 10AE84           (    forth6809.asm):02290                     LDY   ,X
DFEE E7A0             (    forth6809.asm):02291                     STB   ,Y+
DFF0 10AF84           (    forth6809.asm):02292                     STY   ,X
DFF3 39               (    forth6809.asm):02293                     RTS
                      (    forth6809.asm):02294         
                      (    forth6809.asm):02295         ; ------------------------------------------------------------
                      (    forth6809.asm):02296         ; ,  ( x -- )
                      (    forth6809.asm):02297         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02298         ; ------------------------------------------------------------
DFF4 8E0008           (    forth6809.asm):02299         COMMAW:     LDX   #CODEHERE
DFF7 7EDFDE           (    forth6809.asm):02300                     JMP   APPENDCELL
                      (    forth6809.asm):02301         
                      (    forth6809.asm):02302         ; ------------------------------------------------------------
                      (    forth6809.asm):02303         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02304         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02305         ; ------------------------------------------------------------
DFFA 8E0008           (    forth6809.asm):02306         CODECOMMA:  LDX   #CODEHERE
DFFD 7EDFDE           (    forth6809.asm):02307                     JMP   APPENDCELL
                      (    forth6809.asm):02308         
                      (    forth6809.asm):02309         ; ------------------------------------------------------------
                      (    forth6809.asm):02310         ; C,  ( char -- )
                      (    forth6809.asm):02311         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02312         ; ------------------------------------------------------------
E000 8E0008           (    forth6809.asm):02313         CCOMMAW:    LDX   #CODEHERE
E003 7EDFE9           (    forth6809.asm):02314                     JMP   APPENDBYTE
                      (    forth6809.asm):02315         
                      (    forth6809.asm):02316         ; ------------------------------------------------------------
                      (    forth6809.asm):02317         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02318         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02319         ; ------------------------------------------------------------
E006 8E0008           (    forth6809.asm):02320         CCOMMA1:    LDX   #CODEHERE
E009 7EDFE9           (    forth6809.asm):02321                     JMP   APPENDBYTE
                      (    forth6809.asm):02322         
                      (    forth6809.asm):02323         ; ------------------------------------------------------------
                      (    forth6809.asm):02324         ; V,  ( x -- )
                      (    forth6809.asm):02325         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02326         ; ------------------------------------------------------------
E00C 8E000A           (    forth6809.asm):02327         VCOMMAW:    LDX   #VARHERE
E00F 7EDFDE           (    forth6809.asm):02328                     JMP   APPENDCELL
                      (    forth6809.asm):02329         
                      (    forth6809.asm):02330         ; ------------------------------------------------------------
                      (    forth6809.asm):02331         ; VC,  ( char -- )
                      (    forth6809.asm):02332         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02333         ; ------------------------------------------------------------
E012 8E000A           (    forth6809.asm):02334         VCCOMMAW:   LDX   #VARHERE
E015 7EDFE9           (    forth6809.asm):02335                     JMP   APPENDBYTE
                      (    forth6809.asm):02336         
                      (    forth6809.asm):02337         ; ------------------------------------------------------------
                      (    forth6809.asm):02338         ; ALLOT  ( n -- )
                      (    forth6809.asm):02339         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02340         ; ------------------------------------------------------------
E018 3706             (    forth6809.asm):02341         ALLOTW:     PULU  D                 ; n
E01A 9E08             (    forth6809.asm):02342                     LDX   CODEHERE
E01C 308B             (    forth6809.asm):02343                     LEAX  D,X
E01E 9F08             (    forth6809.asm):02344                     STX   CODEHERE
E020 39               (    forth6809.asm):02345                     RTS
                      (    forth6809.asm):02346         
                      (    forth6809.asm):02347         ; ------------------------------------------------------------
                      (    forth6809.asm):02348         ; VALLOT  ( n -- )
                      (    forth6809.asm):02349         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02350         ; ------------------------------------------------------------
E021 3706             (    forth6809.asm):02351         VALLOTW:    PULU  D                 ; n
E023 9E0A             (    forth6809.asm):02352                     LDX   VARHERE
E025 308B             (    forth6809.asm):02353                     LEAX  D,X
E027 9F0A             (    forth6809.asm):02354                     STX   VARHERE
E029 39               (    forth6809.asm):02355                     RTS
                      (    forth6809.asm):02356         
                      (    forth6809.asm):02357         ; ------------------------------------------------------------
                      (    forth6809.asm):02358         ; HERE  ( -- addr )
                      (    forth6809.asm):02359         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02360         ; ------------------------------------------------------------
E02A DC08             (    forth6809.asm):02361         HEREW:      LDD   CODEHERE
E02C 3606             (    forth6809.asm):02362                     PSHU  D                 ; addr
E02E 39               (    forth6809.asm):02363                     RTS
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         ; ------------------------------------------------------------
                      (    forth6809.asm):02366         ; VHERE  ( -- addr )
                      (    forth6809.asm):02367         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
E02F DC0A             (    forth6809.asm):02369         VHEREW:     LDD   VARHERE
E031 3606             (    forth6809.asm):02370                     PSHU  D                 ; addr
E033 39               (    forth6809.asm):02371                     RTS
                      (    forth6809.asm):02372         
                      (    forth6809.asm):02373         ; ------------------------------------------------------------
                      (    forth6809.asm):02374         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02375         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02376         ; ------------------------------------------------------------
E034 DC08             (    forth6809.asm):02377         PADW:       LDD   CODEHERE
E036 C30080           (    forth6809.asm):02378                     ADDD  #PADOFFSET
E039 3606             (    forth6809.asm):02379                     PSHU  D                 ; c-addr
E03B 39               (    forth6809.asm):02380                     RTS
                      (    forth6809.asm):02381         
                      (    forth6809.asm):02382         ; ------------------------------------------------------------
                      (    forth6809.asm):02383         ; UNUSED  ( -- u )
                      (    forth6809.asm):02384         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02385         ; ------------------------------------------------------------
E03C CCB900           (    forth6809.asm):02386         UNUSEDW:    LDD   #CODETOP
E03F 9308             (    forth6809.asm):02387                     SUBD  CODEHERE
E041 3606             (    forth6809.asm):02388                     PSHU  D                 ; u
E043 39               (    forth6809.asm):02389                     RTS
                      (    forth6809.asm):02390         
                      (    forth6809.asm):02391         ; ------------------------------------------------------------
                      (    forth6809.asm):02392         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02393         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02394         ; ------------------------------------------------------------
E044 CC1FFF           (    forth6809.asm):02395         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E047 930A             (    forth6809.asm):02396                     SUBD  VARHERE
E049 3606             (    forth6809.asm):02397                     PSHU  D                 ; u
E04B 39               (    forth6809.asm):02398                     RTS
                      (    forth6809.asm):02399         
                      (    forth6809.asm):02400         ; ============================================================
                      (    forth6809.asm):02401         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02402         ; ============================================================
                      (    forth6809.asm):02403         ; ------------------------------------------------------------
                      (    forth6809.asm):02404         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02405         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02406         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02407         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02408         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02409         ;    Inputs:
                      (    forth6809.asm):02410         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02411         ;        name parsed from the input stream
                      (    forth6809.asm):02412         ;    Outputs:
                      (    forth6809.asm):02413         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02414         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02415         ; ------------------------------------------------------------
E04C CC0020           (    forth6809.asm):02416         HEADER:     LDD   #32
E04F 3606             (    forth6809.asm):02417                     PSHU  D
E051 BDE33D           (    forth6809.asm):02418                     JSR   WORDW
E054 3710             (    forth6809.asm):02419                     PULU  X                 ; c-addr of the name
E056 3706             (    forth6809.asm):02420                     PULU  D                 ; smudge flag in B
E058 A680             (    forth6809.asm):02421                     LDA   ,X+               ; name length, X = name text
E05A 3402             (    forth6809.asm):02422                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
E05C 5D               (    forth6809.asm):02423                     TSTB
E05D 2702             (    forth6809.asm):02424                     BEQ   HDNOSM
E05F 8A40             (    forth6809.asm):02425                     ORA   #$40
E061 109E06           (    forth6809.asm):02426         HDNOSM:     LDY   DPHERE
E064 3420             (    forth6809.asm):02427                     PSHS  Y                 ; 0,S = address of the new header
E066 A7A0             (    forth6809.asm):02428                     STA   ,Y+
E068 E662             (    forth6809.asm):02429                     LDB   2,S
E06A 2707             (    forth6809.asm):02430                     BEQ   HDNONM
E06C A680             (    forth6809.asm):02431         HDCPY:      LDA   ,X+
E06E A7A0             (    forth6809.asm):02432                     STA   ,Y+
E070 5A               (    forth6809.asm):02433                     DECB
E071 26F9             (    forth6809.asm):02434                     BNE   HDCPY
E073 DC04             (    forth6809.asm):02435         HDNONM:     LDD   LATEST
E075 EDA1             (    forth6809.asm):02436                     STD   ,Y++
E077 DC08             (    forth6809.asm):02437                     LDD   CODEHERE
E079 EDA1             (    forth6809.asm):02438                     STD   ,Y++
E07B 109F06           (    forth6809.asm):02439                     STY   DPHERE
E07E 3506             (    forth6809.asm):02440                     PULS  D
E080 DD04             (    forth6809.asm):02441                     STD   LATEST
E082 3261             (    forth6809.asm):02442                     LEAS  1,S
E084 39               (    forth6809.asm):02443                     RTS
                      (    forth6809.asm):02444         
                      (    forth6809.asm):02445         ; ============================================================
                      (    forth6809.asm):02446         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02447         ; ============================================================
                      (    forth6809.asm):02448         ; ------------------------------------------------------------
                      (    forth6809.asm):02449         ; :  ( "name" -- )
                      (    forth6809.asm):02450         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02451         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02452         ; CSP and enter compile state.
                      (    forth6809.asm):02453         ; ------------------------------------------------------------
E085 CCFFFF           (    forth6809.asm):02454         COLONW:     LDD   #TRUEV
E088 3606             (    forth6809.asm):02455                     PSHU  D
E08A BDE04C           (    forth6809.asm):02456                     JSR   HEADER
E08D DC08             (    forth6809.asm):02457                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E08F DD1F             (    forth6809.asm):02458                     STD   CURXT             ; See bugfix: COLONW.1
E091 1F30             (    forth6809.asm):02459                     TFR   U,D
E093 DD21             (    forth6809.asm):02460                     STD   CSP
E095 CCFFFF           (    forth6809.asm):02461                     LDD   #-1
E098 DD00             (    forth6809.asm):02462                     STD   STATE
E09A 39               (    forth6809.asm):02463                     RTS
                      (    forth6809.asm):02464         
                      (    forth6809.asm):02465         ; ------------------------------------------------------------
                      (    forth6809.asm):02466         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02467         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02468         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02469         ; new word and return to interpret state.
                      (    forth6809.asm):02470         ; ------------------------------------------------------------
E09B CC0039           (    forth6809.asm):02471         SEMIW:      LDD   #RTSOPC
E09E 3606             (    forth6809.asm):02472                     PSHU  D
E0A0 BDE006           (    forth6809.asm):02473                     JSR   CCOMMA1
E0A3 1F30             (    forth6809.asm):02474                     TFR   U,D
E0A5 109321           (    forth6809.asm):02475                     CMPD  CSP
E0A8 2703             (    forth6809.asm):02476                     BEQ   SEMIOK
E0AA BDE5C9           (    forth6809.asm):02477                     JSR   CFERR
E0AD 9E04             (    forth6809.asm):02478         SEMIOK:     LDX   LATEST
E0AF A684             (    forth6809.asm):02479                     LDA   ,X
E0B1 84BF             (    forth6809.asm):02480                     ANDA  #$BF
E0B3 A784             (    forth6809.asm):02481                     STA   ,X
E0B5 CC0000           (    forth6809.asm):02482                     LDD   #0
E0B8 DD00             (    forth6809.asm):02483                     STD   STATE
E0BA 39               (    forth6809.asm):02484                     RTS
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486         ; ------------------------------------------------------------
                      (    forth6809.asm):02487         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02488         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02489         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02490         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02491         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02492         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02493         ; ------------------------------------------------------------
E0BB DC08             (    forth6809.asm):02494         NONAMEW:    LDD   CODEHERE
E0BD 3606             (    forth6809.asm):02495                     PSHU  D                 ; xt
E0BF DD1F             (    forth6809.asm):02496                     STD   CURXT             ; See bugfix: NONAMEW.1
E0C1 1F30             (    forth6809.asm):02497                     TFR   U,D
E0C3 DD21             (    forth6809.asm):02498                     STD   CSP
E0C5 CCFFFF           (    forth6809.asm):02499                     LDD   #-1
E0C8 DD00             (    forth6809.asm):02500                     STD   STATE
E0CA 39               (    forth6809.asm):02501                     RTS
                      (    forth6809.asm):02502         
                      (    forth6809.asm):02503         ; ------------------------------------------------------------
                      (    forth6809.asm):02504         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02505         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02506         ; BLDDOES
                      (    forth6809.asm):02507         ;    Inputs:
                      (    forth6809.asm):02508         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02509         ;    Outputs:
                      (    forth6809.asm):02510         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02511         ;    Registers: all changed.
                      (    forth6809.asm):02512         ; BLDSELF
                      (    forth6809.asm):02513         ;    Inputs:
                      (    forth6809.asm):02514         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02515         ;    Outputs:
                      (    forth6809.asm):02516         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02517         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02518         ;    Registers: all changed.
                      (    forth6809.asm):02519         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02520         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02521         ; ------------------------------------------------------------
E0CB 3406             (    forth6809.asm):02522         BLDDOES:    PSHS  D                 ; behaviour address
E0CD CC0000           (    forth6809.asm):02523                     LDD   #0
E0D0 3606             (    forth6809.asm):02524                     PSHU  D
E0D2 BDE04C           (    forth6809.asm):02525                     JSR   HEADER
E0D5 CCDF8F           (    forth6809.asm):02526                     LDD   #DODOES
E0D8 3606             (    forth6809.asm):02527                     PSHU  D
E0DA BDEA39           (    forth6809.asm):02528                     JSR   CCALL
E0DD 3506             (    forth6809.asm):02529                     PULS  D
E0DF 3606             (    forth6809.asm):02530                     PSHU  D                 ; behaviour address
E0E1 BDDFFA           (    forth6809.asm):02531                     JSR   CODECOMMA
E0E4 39               (    forth6809.asm):02532                     RTS
                      (    forth6809.asm):02533         
E0E5 BDE0CB           (    forth6809.asm):02534         BLDSELF:    JSR   BLDDOES
E0E8 DC08             (    forth6809.asm):02535                     LDD   CODEHERE          ; PFA = the cell after this one
E0EA C30002           (    forth6809.asm):02536                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0ED 3606             (    forth6809.asm):02537                     PSHU  D
E0EF BDDFFA           (    forth6809.asm):02538                     JSR   CODECOMMA
E0F2 39               (    forth6809.asm):02539                     RTS
                      (    forth6809.asm):02540         
                      (    forth6809.asm):02541         ; ------------------------------------------------------------
                      (    forth6809.asm):02542         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02543         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02544         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02545         ; address in the code area, on the stack.
                      (    forth6809.asm):02546         ; ------------------------------------------------------------
E0F3 CCDF9A           (    forth6809.asm):02547         CREATEW:    LDD   #DOESRT0
E0F6 BDE0E5           (    forth6809.asm):02548                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E0F9 39               (    forth6809.asm):02549                     RTS
                      (    forth6809.asm):02550         
                      (    forth6809.asm):02551         ; ------------------------------------------------------------
                      (    forth6809.asm):02552         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02553         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02554         ; of the word being defined.
                      (    forth6809.asm):02555         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02556         ; ------------------------------------------------------------
E0FA CCDF9B           (    forth6809.asm):02557         DOESGTW:    LDD   #SETDOES
E0FD 3606             (    forth6809.asm):02558                     PSHU  D
E0FF BDEA39           (    forth6809.asm):02559                     JSR   CCALL
E102 39               (    forth6809.asm):02560                     RTS
                      (    forth6809.asm):02561         
                      (    forth6809.asm):02562         ; ------------------------------------------------------------
                      (    forth6809.asm):02563         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02564         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02565         ; area, initialised to zero.
                      (    forth6809.asm):02566         ; ------------------------------------------------------------
E103 CC0000           (    forth6809.asm):02567         VARIABLEW:  LDD   #0
E106 3606             (    forth6809.asm):02568                     PSHU  D
E108 BDE04C           (    forth6809.asm):02569                     JSR   HEADER
E10B CCDF8F           (    forth6809.asm):02570                     LDD   #DODOES
E10E 3606             (    forth6809.asm):02571                     PSHU  D
E110 BDEA39           (    forth6809.asm):02572                     JSR   CCALL
E113 CCDF9A           (    forth6809.asm):02573                     LDD   #DOESRT0
E116 3606             (    forth6809.asm):02574                     PSHU  D
E118 BDDFFA           (    forth6809.asm):02575                     JSR   CODECOMMA
E11B DC0A             (    forth6809.asm):02576                     LDD   VARHERE
E11D 3606             (    forth6809.asm):02577                     PSHU  D
E11F BDDFFA           (    forth6809.asm):02578                     JSR   CODECOMMA
E122 CC0000           (    forth6809.asm):02579                     LDD   #0
E125 9E0A             (    forth6809.asm):02580                     LDX   VARHERE
E127 ED81             (    forth6809.asm):02581                     STD   ,X++
E129 9F0A             (    forth6809.asm):02582                     STX   VARHERE
E12B 39               (    forth6809.asm):02583                     RTS
                      (    forth6809.asm):02584         
                      (    forth6809.asm):02585         ; ------------------------------------------------------------
                      (    forth6809.asm):02586         ; @  ( a-addr -- x )
                      (    forth6809.asm):02587         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02588         ; ------------------------------------------------------------
E12C 3710             (    forth6809.asm):02589         FETCHW:     PULU  X                 ; a-addr
E12E EC84             (    forth6809.asm):02590                     LDD   ,X
E130 3606             (    forth6809.asm):02591                     PSHU  D                 ; x
E132 39               (    forth6809.asm):02592                     RTS
                      (    forth6809.asm):02593         
                      (    forth6809.asm):02594         ; ------------------------------------------------------------
                      (    forth6809.asm):02595         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02596         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02597         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02598         ; ------------------------------------------------------------
E133 CCE12C           (    forth6809.asm):02599         CONSTANTW:  LDD   #FETCHW
E136 BDE0E5           (    forth6809.asm):02600                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E139 BDDFF4           (    forth6809.asm):02601                     JSR   COMMAW
E13C 39               (    forth6809.asm):02602                     RTS
                      (    forth6809.asm):02603         
                      (    forth6809.asm):02604         ; ------------------------------------------------------------
                      (    forth6809.asm):02605         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02606         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02607         ;    Inputs:
                      (    forth6809.asm):02608         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02609         ;    Outputs:
                      (    forth6809.asm):02610         ;        pfa replaced by the value
                      (    forth6809.asm):02611         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02612         ; ------------------------------------------------------------
E13D 3710             (    forth6809.asm):02613         DOVALUE:    PULU  X                 ; pfa
E13F EC84             (    forth6809.asm):02614                     LDD   ,X
E141 3606             (    forth6809.asm):02615                     PSHU  D                 ; x
E143 39               (    forth6809.asm):02616                     RTS
                      (    forth6809.asm):02617         
                      (    forth6809.asm):02618         ; ------------------------------------------------------------
                      (    forth6809.asm):02619         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02620         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02621         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02622         ; ------------------------------------------------------------
E144 CCE13D           (    forth6809.asm):02623         VALUEW:     LDD   #DOVALUE
E147 BDE0CB           (    forth6809.asm):02624                     JSR   BLDDOES
E14A DC0A             (    forth6809.asm):02625                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E14C 3606             (    forth6809.asm):02626                     PSHU  D                 ; See bugfix: VALUEW.1
E14E BDDFFA           (    forth6809.asm):02627                     JSR   CODECOMMA
E151 BDE00C           (    forth6809.asm):02628                     JSR   VCOMMAW           ; store x in the variable area
E154 39               (    forth6809.asm):02629                     RTS
                      (    forth6809.asm):02630         
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02633         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02634         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02635         ; ------------------------------------------------------------
E155 CC0020           (    forth6809.asm):02636         TOW:        LDD   #32
E158 3606             (    forth6809.asm):02637                     PSHU  D
E15A BDE33D           (    forth6809.asm):02638                     JSR   WORDW
E15D BDE3AF           (    forth6809.asm):02639                     JSR   FINDW
E160 3706             (    forth6809.asm):02640                     PULU  D
E162 10830000         (    forth6809.asm):02641                     CMPD  #0
E166 260A             (    forth6809.asm):02642                     BNE   TOFOUND
E168 3706             (    forth6809.asm):02643                     PULU  D
E16A CCFFF3           (    forth6809.asm):02644                     LDD   #-13
E16D 3606             (    forth6809.asm):02645                     PSHU  D
E16F BDE5FE           (    forth6809.asm):02646                     JSR   THROWW
E172 BDEAEB           (    forth6809.asm):02647         TOFOUND:    JSR   TOBODYW
E175 DC00             (    forth6809.asm):02648                     LDD   STATE
E177 270C             (    forth6809.asm):02649                     BEQ   TOIMMED
E179 BDEA46           (    forth6809.asm):02650                     JSR   LITERALW
E17C CCF2E6           (    forth6809.asm):02651                     LDD   #STOREW
E17F 3606             (    forth6809.asm):02652                     PSHU  D
E181 BDEA39           (    forth6809.asm):02653                     JSR   CCALL
E184 39               (    forth6809.asm):02654                     RTS
E185 3710             (    forth6809.asm):02655         TOIMMED:    PULU  X                 ; a-addr of the value cell
E187 3706             (    forth6809.asm):02656                     PULU  D                 ; x
E189 ED84             (    forth6809.asm):02657                     STD   ,X
E18B 39               (    forth6809.asm):02658                     RTS
                      (    forth6809.asm):02659         
                      (    forth6809.asm):02660         ; ------------------------------------------------------------
                      (    forth6809.asm):02661         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02662         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02663         ; the variable area, initialised to zero.
                      (    forth6809.asm):02664         ; ------------------------------------------------------------
E18C                  (    forth6809.asm):02665         TWOVARIABLEW:
E18C CC0000           (    forth6809.asm):02666                     LDD   #0
E18F 3606             (    forth6809.asm):02667                     PSHU  D
E191 BDE04C           (    forth6809.asm):02668                     JSR   HEADER
E194 CCDF8F           (    forth6809.asm):02669                     LDD   #DODOES
E197 3606             (    forth6809.asm):02670                     PSHU  D
E199 BDEA39           (    forth6809.asm):02671                     JSR   CCALL
E19C CCDF9A           (    forth6809.asm):02672                     LDD   #DOESRT0
E19F 3606             (    forth6809.asm):02673                     PSHU  D
E1A1 BDDFFA           (    forth6809.asm):02674                     JSR   CODECOMMA
E1A4 DC0A             (    forth6809.asm):02675                     LDD   VARHERE
E1A6 3606             (    forth6809.asm):02676                     PSHU  D
E1A8 BDDFFA           (    forth6809.asm):02677                     JSR   CODECOMMA
E1AB CC0000           (    forth6809.asm):02678                     LDD   #0
E1AE 9E0A             (    forth6809.asm):02679                     LDX   VARHERE
E1B0 ED81             (    forth6809.asm):02680                     STD   ,X++
E1B2 ED81             (    forth6809.asm):02681                     STD   ,X++
E1B4 9F0A             (    forth6809.asm):02682                     STX   VARHERE
E1B6 39               (    forth6809.asm):02683                     RTS
                      (    forth6809.asm):02684         
                      (    forth6809.asm):02685         ; ------------------------------------------------------------
                      (    forth6809.asm):02686         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02687         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02688         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02689         ; ------------------------------------------------------------
E1B7                  (    forth6809.asm):02690         TWOCONSTANTW:
E1B7 CCF305           (    forth6809.asm):02691                     LDD   #TWOFETCHW
E1BA BDE0E5           (    forth6809.asm):02692                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1BD 3706             (    forth6809.asm):02693                     PULU  D                 ; x2
E1BF DD14             (    forth6809.asm):02694                     STD   MSCR
E1C1 DC14             (    forth6809.asm):02695                     LDD   MSCR
E1C3 3606             (    forth6809.asm):02696                     PSHU  D
E1C5 BDDFF4           (    forth6809.asm):02697                     JSR   COMMAW            ; x2 -> lower address
E1C8 BDDFF4           (    forth6809.asm):02698                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1
E1CB 39               (    forth6809.asm):02699                     RTS
                      (    forth6809.asm):02700         
                      (    forth6809.asm):02701         ; ------------------------------------------------------------
                      (    forth6809.asm):02702         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02703         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):02704         ; the variable area.
                      (    forth6809.asm):02705         ; ------------------------------------------------------------
E1CC                  (    forth6809.asm):02706         BUFFERCOLONW:
E1CC 3706             (    forth6809.asm):02707                     PULU  D                 ; u
E1CE DD16             (    forth6809.asm):02708                     STD   MSCR2
E1D0 CC0000           (    forth6809.asm):02709                     LDD   #0
E1D3 3606             (    forth6809.asm):02710                     PSHU  D
E1D5 BDE04C           (    forth6809.asm):02711                     JSR   HEADER
E1D8 CCDF8F           (    forth6809.asm):02712                     LDD   #DODOES
E1DB 3606             (    forth6809.asm):02713                     PSHU  D
E1DD BDEA39           (    forth6809.asm):02714                     JSR   CCALL
E1E0 CCDF9A           (    forth6809.asm):02715                     LDD   #DOESRT0
E1E3 3606             (    forth6809.asm):02716                     PSHU  D
E1E5 BDDFFA           (    forth6809.asm):02717                     JSR   CODECOMMA
E1E8 DC0A             (    forth6809.asm):02718                     LDD   VARHERE
E1EA 3606             (    forth6809.asm):02719                     PSHU  D
E1EC BDDFFA           (    forth6809.asm):02720                     JSR   CODECOMMA
E1EF DC16             (    forth6809.asm):02721                     LDD   MSCR2
E1F1 3606             (    forth6809.asm):02722                     PSHU  D
E1F3 BDE021           (    forth6809.asm):02723                     JSR   VALLOTW
E1F6 39               (    forth6809.asm):02724                     RTS
                      (    forth6809.asm):02725         
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
                      (    forth6809.asm):02727         ; DEFER  ( "name" -- )
                      (    forth6809.asm):02728         ; Build a deferred word. Until IS stores an xt in it, executing it
                      (    forth6809.asm):02729         ; throws -21.
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
E1F7 CCDFB6           (    forth6809.asm):02731         DEFERW:     LDD   #DODEFER
E1FA BDE0E5           (    forth6809.asm):02732                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1FD CCDFBE           (    forth6809.asm):02733                     LDD   #DOABORTUNDEF
E200 3606             (    forth6809.asm):02734                     PSHU  D
E202 BDDFF4           (    forth6809.asm):02735                     JSR   COMMAW
E205 39               (    forth6809.asm):02736                     RTS
                      (    forth6809.asm):02737         
                      (    forth6809.asm):02738         ; ------------------------------------------------------------
                      (    forth6809.asm):02739         ; DEFER@  ( xt1 -- xt2 )
                      (    forth6809.asm):02740         ; Return the xt currently stored in the deferred word xt1.
                      (    forth6809.asm):02741         ; ------------------------------------------------------------
E206                  (    forth6809.asm):02742         DEFERFETCHW:
E206 BDEAEB           (    forth6809.asm):02743                     JSR   TOBODYW
E209 3710             (    forth6809.asm):02744                     PULU  X                 ; body address
E20B EC84             (    forth6809.asm):02745                     LDD   ,X
E20D 3606             (    forth6809.asm):02746                     PSHU  D                 ; xt2
E20F 39               (    forth6809.asm):02747                     RTS
                      (    forth6809.asm):02748         
                      (    forth6809.asm):02749         ; ------------------------------------------------------------
                      (    forth6809.asm):02750         ; DEFER!  ( xt2 xt1 -- )
                      (    forth6809.asm):02751         ; Store xt2 as the action of the deferred word xt1.
                      (    forth6809.asm):02752         ; ------------------------------------------------------------
E210                  (    forth6809.asm):02753         DEFERSTOREW:
E210 BDEAEB           (    forth6809.asm):02754                     JSR   TOBODYW
E213 3710             (    forth6809.asm):02755                     PULU  X                 ; body address of xt1
E215 3706             (    forth6809.asm):02756                     PULU  D                 ; xt2
E217 ED84             (    forth6809.asm):02757                     STD   ,X
E219 39               (    forth6809.asm):02758                     RTS
                      (    forth6809.asm):02759         
                      (    forth6809.asm):02760         ; ------------------------------------------------------------
                      (    forth6809.asm):02761         ; IS  ( xt "name" -- )  IMMEDIATE
                      (    forth6809.asm):02762         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):02763         ; compile code to do so at run time. Error -13 if the name is not
                      (    forth6809.asm):02764         ; found.
                      (    forth6809.asm):02765         ; ------------------------------------------------------------
E21A CC0020           (    forth6809.asm):02766         ISW:        LDD   #32
E21D 3606             (    forth6809.asm):02767                     PSHU  D
E21F BDE33D           (    forth6809.asm):02768                     JSR   WORDW
E222 BDE3AF           (    forth6809.asm):02769                     JSR   FINDW
E225 3706             (    forth6809.asm):02770                     PULU  D
E227 10830000         (    forth6809.asm):02771                     CMPD  #0
E22B 260A             (    forth6809.asm):02772                     BNE   ISFOUND
E22D 3706             (    forth6809.asm):02773                     PULU  D
E22F CCFFF3           (    forth6809.asm):02774                     LDD   #-13
E232 3606             (    forth6809.asm):02775                     PSHU  D
E234 BDE5FE           (    forth6809.asm):02776                     JSR   THROWW
E237 3710             (    forth6809.asm):02777         ISFOUND:    PULU  X
E239 DC00             (    forth6809.asm):02778                     LDD   STATE
E23B 270E             (    forth6809.asm):02779                     BEQ   ISIMMED
E23D 3610             (    forth6809.asm):02780                     PSHU  X
E23F BDEA46           (    forth6809.asm):02781                     JSR   LITERALW
E242 CCE210           (    forth6809.asm):02782                     LDD   #DEFERSTOREW
E245 3606             (    forth6809.asm):02783                     PSHU  D
E247 BDEA39           (    forth6809.asm):02784                     JSR   CCALL
E24A 39               (    forth6809.asm):02785                     RTS

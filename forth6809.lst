FD13 EC84             (    forth6809.asm):06854         ENVLOOP:  LDD  ,X
FD15 10830000         (    forth6809.asm):06855                   CMPD #0
FD19 272B             (    forth6809.asm):06856                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):06857                                     ; the double-cell table (below) before
                      (    forth6809.asm):06858                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):06859                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):06860                                     ; turn - both are double-cell values per
                      (    forth6809.asm):06861                                     ; their own ANS data type, which this
                      (    forth6809.asm):06862                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):06863                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):06864                                     ; represent correctly.
FD1B 3410             (    forth6809.asm):06865                   PSHS X          ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):06866                                     ; internal scratch (LDX CMPA1, then LDA
                      (    forth6809.asm):06867                                     ; ,X+ advancing through the comparison),
                      (    forth6809.asm):06868                                     ; clobbering whatever the caller had there.
                      (    forth6809.asm):06869                                     ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):06870                                     ; current table entry after COMPAREW
                      (    forth6809.asm):06871                                     ; returns, both for ENVFOUND's own LDD 4,X
                      (    forth6809.asm):06872                                     ; and for advancing to the next entry -
                      (    forth6809.asm):06873                                     ; without saving it first, a successful
                      (    forth6809.asm):06874                                     ; match left X sitting just past the
                      (    forth6809.asm):06875                                     ; matched string's own text (for
                      (    forth6809.asm):06876                                     ; "/COUNTED-STRING", 15 characters, that
                      (    forth6809.asm):06877                                     ; lands exactly at the start of the next
                      (    forth6809.asm):06878                                     ; entry's string, "MAX-N") - so ENVFOUND
                      (    forth6809.asm):06879                                     ; read the "value" field from inside the
                      (    forth6809.asm):06880                                     ; NEXT entry's own string text instead of
                      (    forth6809.asm):06881                                     ; the real value. Confirmed via MAME: this
                      (    forth6809.asm):06882                                     ; exact mechanism produces $4E4D precisely
                      (    forth6809.asm):06883                                     ; - the bytes 'N' ($4E) and 'M' ($4D, the
                      (    forth6809.asm):06884                                     ; start of "MAX-U") sitting 4 bytes into
                      (    forth6809.asm):06885                                     ; "MAX-N", read as one cell.

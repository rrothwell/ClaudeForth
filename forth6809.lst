                      (    forth6809.asm):03441         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03442         ; buffers, no interrupts, no RTS/CTS handshaking. Each blocks
                      (    forth6809.asm):03443         ; (KEY, EMIT) or checks once (KEYQ) directly against ACIASR.
                      (    forth6809.asm):03444         ; ------------------------------------------------------------
E684                  (    forth6809.asm):03445         KEY:     LDA   ACIASR
                      (    forth6809.asm):03446                  BITA  #SR_RDRF
                      (    forth6809.asm):03447                  BEQ   KEY

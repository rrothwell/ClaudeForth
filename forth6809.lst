                      (    forth6809.asm):01629         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01630         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01631         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01632         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01633         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01634         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01635         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01636         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01637         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01638         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01639         ; were chained on after H_QUIT in a later turn.
DFF4 05               (    forth6809.asm):01640         H_ABORT: FCB   5
DFF5 41424F5254       (    forth6809.asm):01641                  FCC   "ABORT"
DFFA DFEA             (    forth6809.asm):01642                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01643                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01644                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01645                                        ; now H_FALSE, the chain's newest entry
DFFC E077             (    forth6809.asm):01646                  FDB   ABORT
                      (    forth6809.asm):01647         
DFFE 04               (    forth6809.asm):01648         H_QUIT:  FCB   4
DFFF 51554954         (    forth6809.asm):01649                  FCC   "QUIT"
E003 DFF4             (    forth6809.asm):01650                  FDB   H_ABORT
E005 E07A             (    forth6809.asm):01651                  FDB   QUIT
                      (    forth6809.asm):01652         
                      (    forth6809.asm):01653         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):01654         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):01655         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):01656         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):01657         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):01658         ; reconstructs and pushes the original c-addr, then 0.
E007 04               (    forth6809.asm):01659         H_FIND:  FCB   4
E008 46494E44         (    forth6809.asm):01660                  FCC   "FIND"
E00C DFFE             (    forth6809.asm):01661                  FDB   H_QUIT
E00E E583             (    forth6809.asm):01662                  FDB   FIND
                      (    forth6809.asm):01663         

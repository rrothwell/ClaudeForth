                      (    forth6809.asm):10909         ; ------------------------------------------------------------
                      (    forth6809.asm):10910         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10911         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10912         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10913         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10914         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10915         ; sequential walk-through per region.
                      (    forth6809.asm):10916         ;
                      (    forth6809.asm):10917         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10918         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10919         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10920         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10921         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10922         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10923         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10924         ; ------------------------------------------------------------
C27E BDFC2B           (    forth6809.asm):10925         TSTMEMORY: JSR CRW
C281 8EC292           (    forth6809.asm):10926                    LDX   #TSTMEMMSG
C284 3610             (    forth6809.asm):10927                    PSHU  X
C286 CC0006           (    forth6809.asm):10928                    LDD   #6
C289 3606             (    forth6809.asm):10929                    PSHU  D
C28B BDF60B           (    forth6809.asm):10930                    JSR   TYPE
C28E BDFC2B           (    forth6809.asm):10931                    JSR   CRW
                      (    forth6809.asm):10932         
                      (    forth6809.asm):10933                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10934         
                      (    forth6809.asm):10935                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10936                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10937                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10938                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10939                    JSR   TSTCODEHERE
                      (    forth6809.asm):10940                    JSR   TSTVARHERE
                      (    forth6809.asm):10941                    JSR   TSTPAD
                      (    forth6809.asm):10942                    JSR   TSTUNUSED
                      (    forth6809.asm):10943                    JSR   TSTVUNUSED
                      (    forth6809.asm):10944                    JSR   TSTFILL
                      (    forth6809.asm):10945                    JSR   TSTERASE
                      (    forth6809.asm):10946                    JSR   TSTCMOVE
                      (    forth6809.asm):10947                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10948                    JSR   TSTMOVE1
                      (    forth6809.asm):10949                    JSR   TSTMOVE2
                      (    forth6809.asm):10950                    JSR   TSTMOVE3
                      (    forth6809.asm):10951         
                      (    forth6809.asm):10952                    ENDC ; <<<<
                      (    forth6809.asm):10953         
C291 39               (    forth6809.asm):10954                    RTS
                      (    forth6809.asm):10955         
C292 4D656D6F7279     (    forth6809.asm):10956         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10957         
                      (    forth6809.asm):10958                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10959         
                      (    forth6809.asm):10960         ; ------------------------------------------------------------
                      (    forth6809.asm):10961         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10962         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10963         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10964         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10965         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10966         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10967         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10968         ; runs exclusively of every other.
                      (    forth6809.asm):10969         ;
                      (    forth6809.asm):10970         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10971         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10972         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10973         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10974         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10975         ; ------------------------------------------------------------
                      (    forth6809.asm):10976         
                      (    forth6809.asm):10977         ; ------------------------------------------------------------
                      (    forth6809.asm):10978         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10979         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10980         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10981         ; ------------------------------------------------------------
C298                  (    forth6809.asm):10982         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10983         
                      (    forth6809.asm):10984                        LDD  #TSTGUARD
                      (    forth6809.asm):10985                        PSHU D
                      (    forth6809.asm):10986                        LDD  #TSTVAL1
                      (    forth6809.asm):10987                        PSHU D
                      (    forth6809.asm):10988                        LDD  #TSTCBUF
                      (    forth6809.asm):10989                        PSHU D
                      (    forth6809.asm):10990                        STU  TSTUB4
                      (    forth6809.asm):10991         
                      (    forth6809.asm):10992                        JSR  STOREW
                      (    forth6809.asm):10993         
                      (    forth6809.asm):10994                        LDD  #TSTCBUF
                      (    forth6809.asm):10995                        PSHU D
                      (    forth6809.asm):10996         
                      (    forth6809.asm):10997                        JSR  ATSIGN
                      (    forth6809.asm):10998         
                      (    forth6809.asm):10999                        STU  TSTUAF
                      (    forth6809.asm):11000         
                      (    forth6809.asm):11001                        PULU D
                      (    forth6809.asm):11002                        CMPD #TSTVAL1
                      (    forth6809.asm):11003                        BNE  FSFAIL
                      (    forth6809.asm):11004                        PULU D
                      (    forth6809.asm):11005                        CMPD #TSTGUARD
                      (    forth6809.asm):11006                        BNE  FSFAIL
                      (    forth6809.asm):11007         
                      (    forth6809.asm):11008                        LDD  TSTUB4
                      (    forth6809.asm):11009                        SUBD TSTUAF
                      (    forth6809.asm):11010                        CMPD #-2
                      (    forth6809.asm):11011                        BNE  FSFAIL
                      (    forth6809.asm):11012         
                      (    forth6809.asm):11013                        LDD  #TRUEV
                      (    forth6809.asm):11014                        BRA  FSDONE
C298                  (    forth6809.asm):11015         FSFAIL:        LDD  #FALSEV
C298                  (    forth6809.asm):11016         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):11017                        PSHU X
                      (    forth6809.asm):11018                        PSHU D
                      (    forth6809.asm):11019                        JSR  TSTREPORT
                      (    forth6809.asm):11020         
                      (    forth6809.asm):11021                        LDU  TSTU0
                      (    forth6809.asm):11022                        RTS
                      (    forth6809.asm):11023         
C298                  (    forth6809.asm):11024         TSTFSNAME: FCB  13
                      (    forth6809.asm):11025                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):11026         
                      (    forth6809.asm):11027         ; ------------------------------------------------------------
                      (    forth6809.asm):11028         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):11029         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):11030         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):11031         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):11032         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):11033         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):11034         ; whatever was there).
                      (    forth6809.asm):11035         ;
                      (    forth6809.asm):11036         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):11037         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):11038         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):11039         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):11040         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):11041         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):11042         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):11043         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):11044         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):11045         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):11046         ; byte ends up where was wrong.
                      (    forth6809.asm):11047         ; ------------------------------------------------------------
C298                  (    forth6809.asm):11048         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):11049                         STD  TSTCBUF
                      (    forth6809.asm):11050         
                      (    forth6809.asm):11051                         STU  TSTU0
                      (    forth6809.asm):11052         
                      (    forth6809.asm):11053                         LDD  #TSTGUARD
                      (    forth6809.asm):11054                         PSHU D
                      (    forth6809.asm):11055                         LDD  #$34
                      (    forth6809.asm):11056                         PSHU D
                      (    forth6809.asm):11057                         LDD  #TSTCBUF
                      (    forth6809.asm):11058                         PSHU D
                      (    forth6809.asm):11059                         STU  TSTUB4
                      (    forth6809.asm):11060         
                      (    forth6809.asm):11061                         JSR  CSTOREW
                      (    forth6809.asm):11062         
                      (    forth6809.asm):11063                         LDD  TSTCBUF
                      (    forth6809.asm):11064                         CMPD #$34FF
                      (    forth6809.asm):11065                         BNE  CFFAIL
                      (    forth6809.asm):11066         
                      (    forth6809.asm):11067                         LDD  #TSTCBUF
                      (    forth6809.asm):11068                         PSHU D
                      (    forth6809.asm):11069         
                      (    forth6809.asm):11070                         JSR  CFETCH
                      (    forth6809.asm):11071         
                      (    forth6809.asm):11072                         STU  TSTUAF
                      (    forth6809.asm):11073         
                      (    forth6809.asm):11074                         PULU D
                      (    forth6809.asm):11075                         CMPD #$0034
                      (    forth6809.asm):11076                         BNE  CFFAIL
                      (    forth6809.asm):11077                         PULU D
                      (    forth6809.asm):11078                         CMPD #TSTGUARD
                      (    forth6809.asm):11079                         BNE  CFFAIL
                      (    forth6809.asm):11080         
                      (    forth6809.asm):11081                         LDD  TSTUB4
                      (    forth6809.asm):11082                         SUBD TSTUAF
                      (    forth6809.asm):11083                         CMPD #-2
                      (    forth6809.asm):11084                         BNE  CFFAIL
                      (    forth6809.asm):11085         
                      (    forth6809.asm):11086                         LDD  #TRUEV
                      (    forth6809.asm):11087                         BRA  CFDONE
C298                  (    forth6809.asm):11088         CFFAIL:         LDD  #FALSEV
C298                  (    forth6809.asm):11089         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11090                         PSHU X
                      (    forth6809.asm):11091                         PSHU D
                      (    forth6809.asm):11092                         JSR  TSTREPORT
                      (    forth6809.asm):11093         
                      (    forth6809.asm):11094                         LDU  TSTU0
                      (    forth6809.asm):11095                         RTS
                      (    forth6809.asm):11096         
C298                  (    forth6809.asm):11097         TSTCFNAME: FCB  14
                      (    forth6809.asm):11098                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11099         
                      (    forth6809.asm):11100         ; ------------------------------------------------------------
                      (    forth6809.asm):11101         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11102         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11103         ; correctly.
                      (    forth6809.asm):11104         ; ------------------------------------------------------------
C298                  (    forth6809.asm):11105         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11106                       STD  TSTCBUF
                      (    forth6809.asm):11107         
                      (    forth6809.asm):11108                       STU  TSTU0
                      (    forth6809.asm):11109         
                      (    forth6809.asm):11110                       LDD  #TSTGUARD
                      (    forth6809.asm):11111                       PSHU D
                      (    forth6809.asm):11112                       LDD  #100
                      (    forth6809.asm):11113                       PSHU D
                      (    forth6809.asm):11114                       LDD  #TSTCBUF
                      (    forth6809.asm):11115                       PSHU D
                      (    forth6809.asm):11116                       STU  TSTUB4
                      (    forth6809.asm):11117         
                      (    forth6809.asm):11118                       JSR  PLUSSTORE
                      (    forth6809.asm):11119         
                      (    forth6809.asm):11120                       STU  TSTUAF
                      (    forth6809.asm):11121         
                      (    forth6809.asm):11122                       LDD  TSTCBUF
                      (    forth6809.asm):11123                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11124                       BNE  PSFAIL
                      (    forth6809.asm):11125         
                      (    forth6809.asm):11126                       PULU D
                      (    forth6809.asm):11127                       CMPD #TSTGUARD
                      (    forth6809.asm):11128                       BNE  PSFAIL
                      (    forth6809.asm):11129         
                      (    forth6809.asm):11130                       LDD  TSTUB4
                      (    forth6809.asm):11131                       SUBD TSTUAF
                      (    forth6809.asm):11132                       CMPD #-4
                      (    forth6809.asm):11133                       BNE  PSFAIL
                      (    forth6809.asm):11134         
                      (    forth6809.asm):11135                       LDD  #TRUEV
                      (    forth6809.asm):11136                       BRA  PSDONE
C298                  (    forth6809.asm):11137         PSFAIL:       LDD  #FALSEV
C298                  (    forth6809.asm):11138         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11139                       PSHU X
                      (    forth6809.asm):11140                       PSHU D
                      (    forth6809.asm):11141                       JSR  TSTREPORT
                      (    forth6809.asm):11142         
                      (    forth6809.asm):11143                       LDU  TSTU0
                      (    forth6809.asm):11144                       RTS
                      (    forth6809.asm):11145         
C298                  (    forth6809.asm):11146         TSTPSNAME: FCB  12
                      (    forth6809.asm):11147                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11148         
                      (    forth6809.asm):11149         ; ------------------------------------------------------------
                      (    forth6809.asm):11150         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11151         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11152         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11153         ; the documented convention on both ends).
                      (    forth6809.asm):11154         ; ------------------------------------------------------------
C298                  (    forth6809.asm):11155         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11156         
                      (    forth6809.asm):11157                         LDD  #TSTGUARD
                      (    forth6809.asm):11158                         PSHU D
                      (    forth6809.asm):11159                         LDD  #TSTVAL1
                      (    forth6809.asm):11160                         PSHU D
                      (    forth6809.asm):11161                         LDD  #TSTVAL2
                      (    forth6809.asm):11162                         PSHU D
                      (    forth6809.asm):11163                         LDD  #TSTCBUF
                      (    forth6809.asm):11164                         PSHU D
                      (    forth6809.asm):11165                         STU  TSTUB4
                      (    forth6809.asm):11166         
                      (    forth6809.asm):11167                         JSR  DSTORE
                      (    forth6809.asm):11168         
                      (    forth6809.asm):11169                         LDD  #TSTCBUF
                      (    forth6809.asm):11170                         PSHU D
                      (    forth6809.asm):11171         
                      (    forth6809.asm):11172                         JSR  DFETCH
                      (    forth6809.asm):11173         
                      (    forth6809.asm):11174                         STU  TSTUAF
                      (    forth6809.asm):11175         
                      (    forth6809.asm):11176                         PULU D
                      (    forth6809.asm):11177                         CMPD #TSTVAL2
                      (    forth6809.asm):11178                         BNE  DFFAIL
                      (    forth6809.asm):11179                         PULU D
                      (    forth6809.asm):11180                         CMPD #TSTVAL1
                      (    forth6809.asm):11181                         BNE  DFFAIL
                      (    forth6809.asm):11182                         PULU D
                      (    forth6809.asm):11183                         CMPD #TSTGUARD
                      (    forth6809.asm):11184                         BNE  DFFAIL
                      (    forth6809.asm):11185         
                      (    forth6809.asm):11186                         LDD  TSTUB4
                      (    forth6809.asm):11187                         SUBD TSTUAF
                      (    forth6809.asm):11188                         CMPD #-2
                      (    forth6809.asm):11189                         BNE  DFFAIL
                      (    forth6809.asm):11190         
                      (    forth6809.asm):11191                         LDD  TSTCBUF

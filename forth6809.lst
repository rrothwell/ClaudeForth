                      (    forth6809.asm):03275         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03276         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03277         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03278         ;    Inputs:
                      (    forth6809.asm):03279         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03280         ;    Outputs:
                      (    forth6809.asm):03281         ;        single number: n and -1
                      (    forth6809.asm):03282         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03283         ;        not a number: c-addr and 0
                      (    forth6809.asm):03284         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03285         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03286         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03287         ; NUMBERQ.6.
                      (    forth6809.asm):03288         ; ------------------------------------------------------------
E3EA 3710             (    forth6809.asm):03289         NUMBERQ:    PULU  X                 ; c-addr
E3EC 327D             (    forth6809.asm):03290                     LEAS  -3,S
E3EE AFE4             (    forth6809.asm):03291                     STX   ,S
E3F0 E684             (    forth6809.asm):03292                     LDB   ,X
E3F2 276D             (    forth6809.asm):03293                     BEQ   NQBAD
E3F4 3001             (    forth6809.asm):03294                     LEAX  1,X
                      (    forth6809.asm):03295         
                      (    forth6809.asm):03296                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03297                     ; digit count. See shadow: NUMBERQ.1
E3F6 5A               (    forth6809.asm):03298                     DECB
E3F7 A685             (    forth6809.asm):03299                     LDA   B,X
E3F9 5C               (    forth6809.asm):03300                     INCB
E3FA 812E             (    forth6809.asm):03301                     CMPA  #'.'
E3FC 2603             (    forth6809.asm):03302                     BNE   NQNOSIGN
E3FE 5A               (    forth6809.asm):03303                     DECB
E3FF 2760             (    forth6809.asm):03304                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03305         
E401 6F62             (    forth6809.asm):03306         NQNOSIGN:   CLR   2,S
E403 A684             (    forth6809.asm):03307                     LDA   ,X
E405 812D             (    forth6809.asm):03308                     CMPA  #'-'
E407 2607             (    forth6809.asm):03309                     BNE   NQNOSIGN2
E409 6362             (    forth6809.asm):03310                     COM   2,S
E40B 3001             (    forth6809.asm):03311                     LEAX  1,X
E40D 5A               (    forth6809.asm):03312                     DECB
E40E 2751             (    forth6809.asm):03313                     BEQ   NQBAD
                      (    forth6809.asm):03314         
E410 108E0000         (    forth6809.asm):03315         NQNOSIGN2:  LDY   #0
E414 3620             (    forth6809.asm):03316                     PSHU  Y                 ; ud low
E416 3620             (    forth6809.asm):03317                     PSHU  Y                 ; ud high
E418 3610             (    forth6809.asm):03318                     PSHU  X                 ; c-addr
E41A 4F               (    forth6809.asm):03319                     CLRA
E41B 3606             (    forth6809.asm):03320                     PSHU  D                 ; u
                      (    forth6809.asm):03321         
E41D BDE3B1           (    forth6809.asm):03322                     JSR   NUMLOOP
                      (    forth6809.asm):03323         
E420 ECC4             (    forth6809.asm):03324                     LDD   ,U
E422 263B             (    forth6809.asm):03325                     BNE   NQBADF            ; unconverted characters remain
E424 3344             (    forth6809.asm):03326                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):03327         
                      (    forth6809.asm):03328                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E426 6D62             (    forth6809.asm):03329                     TST   2,S
E428 2718             (    forth6809.asm):03330                     BEQ   NQPOS32
E42A ECC4             (    forth6809.asm):03331                     LDD   ,U
E42C 43               (    forth6809.asm):03332                     COMA
E42D 53               (    forth6809.asm):03333                     COMB
E42E EDC4             (    forth6809.asm):03334                     STD   ,U
E430 EC42             (    forth6809.asm):03335                     LDD   2,U
E432 43               (    forth6809.asm):03336                     COMA
E433 53               (    forth6809.asm):03337                     COMB
E434 C30001           (    forth6809.asm):03338                     ADDD  #1
E437 ED42             (    forth6809.asm):03339                     STD   2,U
E439 2407             (    forth6809.asm):03340                     BCC   NQPOS32
E43B ECC4             (    forth6809.asm):03341                     LDD   ,U
E43D C30001           (    forth6809.asm):03342                     ADDD  #1
E440 EDC4             (    forth6809.asm):03343                     STD   ,U
                      (    forth6809.asm):03344         
E442                  (    forth6809.asm):03345         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):03346                     ; last character was '.' - determines which return convention
E442 AEE4             (    forth6809.asm):03347                     LDX   ,S
E444 E684             (    forth6809.asm):03348                     LDB   ,X
E446 5A               (    forth6809.asm):03349                     DECB
E447 3001             (    forth6809.asm):03350                     LEAX  1,X
E449 A685             (    forth6809.asm):03351                     LDA   B,X
E44B 3263             (    forth6809.asm):03352                     LEAS  3,S
E44D 812E             (    forth6809.asm):03353                     CMPA  #'.'
E44F 2606             (    forth6809.asm):03354                     BNE   NQSINGLE
                      (    forth6809.asm):03355         
                      (    forth6809.asm):03356                     ; DOUBLE success: ud is already low below high; add a
                      (    forth6809.asm):03357                     ; distinct success code (1, not -1) so TRYNUM can tell
                      (    forth6809.asm):03358                     ; single and double apart
E451 CC0001           (    forth6809.asm):03359                     LDD   #1
E454 3606             (    forth6809.asm):03360                     PSHU  D
E456 39               (    forth6809.asm):03361                     RTS
                      (    forth6809.asm):03362         
E457 3342             (    forth6809.asm):03363         NQSINGLE:   LEAU  2,U               ; SINGLE success: drop the high cell
E459 CCFFFF           (    forth6809.asm):03364                     LDD   #-1
E45C 3606             (    forth6809.asm):03365                     PSHU  D
E45E 39               (    forth6809.asm):03366                     RTS
                      (    forth6809.asm):03367         
E45F 3348             (    forth6809.asm):03368         NQBADF:     LEAU  8,U               ; drop the frame
E461 AEE4             (    forth6809.asm):03369         NQBAD:      LDX   ,S
E463 3263             (    forth6809.asm):03370                     LEAS  3,S
E465 3610             (    forth6809.asm):03371                     PSHU  X
E467 CC0000           (    forth6809.asm):03372                     LDD   #0
E46A 3606             (    forth6809.asm):03373                     PSHU  D
E46C 39               (    forth6809.asm):03374                     RTS
                      (    forth6809.asm):03375         
                      (    forth6809.asm):03376         ; ============================================================
                      (    forth6809.asm):03377         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03378         ; ============================================================
                      (    forth6809.asm):03379                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03380         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03381         
                      (    forth6809.asm):03382         ; ------------------------------------------------------------
                      (    forth6809.asm):03383         ; KEY  ( -- char )
                      (    forth6809.asm):03384         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03385         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03386         ; ------------------------------------------------------------
E46D                  (    forth6809.asm):03387         KEYW:
                      (    forth6809.asm):03388         
E46D 7D0178           (    forth6809.asm):03389                     TST   RTSSTATE          ; Is throttling?
E470 2703             (    forth6809.asm):03390                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03391         
                      (    forth6809.asm):03392                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E472 BDDC7E           (    forth6809.asm):03393                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03394                                             ; by transmitting all chars.
                      (    forth6809.asm):03395         
E475                  (    forth6809.asm):03396         TRY_READ:
E475 BDDCEB           (    forth6809.asm):03397                     JSR   GETCHAR           ; Is char available in input buffer.
E478 25F3             (    forth6809.asm):03398                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03399                                             ; while still transmitting!
                      (    forth6809.asm):03400         
E47A 1F89             (    forth6809.asm):03401                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E47C 4F               (    forth6809.asm):03402                     CLRA                    ; Clear MSB.
E47D 3606             (    forth6809.asm):03403                     PSHU  D                 ; char
                      (    forth6809.asm):03404         
E47F 39               (    forth6809.asm):03405                     RTS
                      (    forth6809.asm):03406         
                      (    forth6809.asm):03407         ; ------------------------------------------------------------
                      (    forth6809.asm):03408         ; KEY?  ( -- flag )
                      (    forth6809.asm):03409         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03410         ; ------------------------------------------------------------
E480                  (    forth6809.asm):03411         KEYQW:
                      (    forth6809.asm):03412                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03413         
E480 B60176           (    forth6809.asm):03414                     LDA   INHEAD            ; Characters received?
E483 B10177           (    forth6809.asm):03415                     CMPA  INTAIL
                      (    forth6809.asm):03416         
                      (    forth6809.asm):03417                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03418         
E486 2606             (    forth6809.asm):03419                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03420         
E488 CC0000           (    forth6809.asm):03421                     LDD   #FALSEV           ; No! Return false result.
E48B 3606             (    forth6809.asm):03422                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03423         
E48D 39               (    forth6809.asm):03424                     RTS
                      (    forth6809.asm):03425         
E48E                  (    forth6809.asm):03426         KQTRUE:
E48E CCFFFF           (    forth6809.asm):03427                     LDD   #TRUEV            ; Yes! Return true result.
E491 3606             (    forth6809.asm):03428                     PSHU  D                 ; flag = true
E493 39               (    forth6809.asm):03429                     RTS
                      (    forth6809.asm):03430         
                      (    forth6809.asm):03431         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03432         
                      (    forth6809.asm):03433         ; ------------------------------------------------------------
                      (    forth6809.asm):03434         ; EMIT  ( char -- )
                      (    forth6809.asm):03435         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03436         ; discarded if the ring is full.
                      (    forth6809.asm):03437         ; ------------------------------------------------------------
E494                  (    forth6809.asm):03438         EMITW:
E494 3706             (    forth6809.asm):03439                     PULU  D                 ; char
E496 1F98             (    forth6809.asm):03440                     TFR   B,A
E498 BDDCA0           (    forth6809.asm):03441                     JSR   PUTCHAR           ; Transmit char.
E49B 39               (    forth6809.asm):03442                     RTS
                      (    forth6809.asm):03443         
                      (    forth6809.asm):03444                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03445         ; ------------------------------------------------------------
                      (    forth6809.asm):03446         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03447         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03448         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03449         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03450         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03451         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03452         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03453         ; follow.
                      (    forth6809.asm):03454         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03455         KEYW:
                      (    forth6809.asm):03456                     LDA   ACIASR
                      (    forth6809.asm):03457                     BITA  #SR_RDRF
                      (    forth6809.asm):03458                     BEQ   KWAIT
                      (    forth6809.asm):03459                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03460                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E49C                  (    forth6809.asm):03461         KWAIT:
E49C                  (    forth6809.asm):03462         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03463                     BITA  #SR_RDRF
                      (    forth6809.asm):03464                     BEQ   KSPIN
E49C                  (    forth6809.asm):03465         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03466                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03467                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03468                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03469                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03470                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03471                     BEQ   KGETCH
                      (    forth6809.asm):03472                     BITA  #SR_FE
                      (    forth6809.asm):03473                     BEQ   KXFE
                      (    forth6809.asm):03474                     INC   FECOUNT
E49C                  (    forth6809.asm):03475         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03476                     BEQ   KXOVRN
                      (    forth6809.asm):03477                     INC   OVRNCOUNT
E49C                  (    forth6809.asm):03478         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03479                     BEQ   KGETCH
                      (    forth6809.asm):03480                     INC   PECOUNT
E49C                  (    forth6809.asm):03481         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03482                     TFR   A,B
                      (    forth6809.asm):03483                     CLRA
                      (    forth6809.asm):03484                     PSHU  D                 ; char
                      (    forth6809.asm):03485                     RTS
                      (    forth6809.asm):03486         
                      (    forth6809.asm):03487         ; ------------------------------------------------------------
                      (    forth6809.asm):03488         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03489         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03490         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03491         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03492         ;    Inputs:
                      (    forth6809.asm):03493         ;        none
                      (    forth6809.asm):03494         ;    Outputs:
                      (    forth6809.asm):03495         ;        XON or XOFF transmitted
                      (    forth6809.asm):03496         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03497         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03498         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03499         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03500                     BRA   PUTXCH
E49C                  (    forth6809.asm):03501         PUTXON:     LDA   #XONCH
E49C                  (    forth6809.asm):03502         PUTXCH:     PSHS  A
E49C                  (    forth6809.asm):03503         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03504                     BITB  #SR_TDRE
                      (    forth6809.asm):03505                     BEQ   PXWT
                      (    forth6809.asm):03506                     PULS  A
                      (    forth6809.asm):03507                     STA   ACIADR
                      (    forth6809.asm):03508                     RTS
                      (    forth6809.asm):03509         
                      (    forth6809.asm):03510         ; ------------------------------------------------------------
                      (    forth6809.asm):03511         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03512         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03513         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03514         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03515                     BITA  #SR_RDRF
                      (    forth6809.asm):03516                     BEQ   KQFALSE
                      (    forth6809.asm):03517                     LDD   #TRUEV
                      (    forth6809.asm):03518                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03519                     RTS
E49C                  (    forth6809.asm):03520         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03521                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03522                     RTS
                      (    forth6809.asm):03523         
                      (    forth6809.asm):03524         ; ------------------------------------------------------------
                      (    forth6809.asm):03525         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03526         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03527         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03528         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03529                     STB   EMITCH
E49C                  (    forth6809.asm):03530         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03531                     BITA  #SR_TDRE
                      (    forth6809.asm):03532                     BEQ   EMITWT
                      (    forth6809.asm):03533                     LDA   EMITCH
                      (    forth6809.asm):03534                     STA   ACIADR
                      (    forth6809.asm):03535                     RTS
                      (    forth6809.asm):03536         
                      (    forth6809.asm):03537                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03538         
                      (    forth6809.asm):03539         ; ------------------------------------------------------------
                      (    forth6809.asm):03540         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03541         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03542         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03543         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03544         ; ------------------------------------------------------------
E49C 335E             (    forth6809.asm):03545         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E49E CC0000           (    forth6809.asm):03546                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E4A1 EDC4             (    forth6809.asm):03547                     STD   ,U
                      (    forth6809.asm):03548         
                      (    forth6809.asm):03549                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03550                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03551                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03552                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03553                                             ; stream this line's characters
                      (    forth6809.asm):03554                     JSR   PUTXON
                      (    forth6809.asm):03555                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03556         
E4A3 BDE46D           (    forth6809.asm):03557         ALOOP:      JSR   KEYW
E4A6 3706             (    forth6809.asm):03558                     PULU  D
E4A8 1F02             (    forth6809.asm):03559                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03560         
E4AA C10D             (    forth6809.asm):03561                     CMPB  #13
E4AC 274F             (    forth6809.asm):03562                     BEQ   ADONE
E4AE C10A             (    forth6809.asm):03563                     CMPB  #10
E4B0 27F1             (    forth6809.asm):03564                     BEQ   ALOOP
E4B2 C108             (    forth6809.asm):03565                     CMPB  #8
E4B4 2724             (    forth6809.asm):03566                     BEQ   ABKSP
E4B6 C17F             (    forth6809.asm):03567                     CMPB  #127
E4B8 2720             (    forth6809.asm):03568                     BEQ   ABKSP
                      (    forth6809.asm):03569         
E4BA ECC4             (    forth6809.asm):03570                     LDD   ,U
E4BC 10A342           (    forth6809.asm):03571                     CMPD  2,U
E4BF 27E2             (    forth6809.asm):03572                     BEQ   ALOOP
                      (    forth6809.asm):03573         
E4C1 AE44             (    forth6809.asm):03574                     LDX   4,U
E4C3 308B             (    forth6809.asm):03575                     LEAX  D,X
E4C5 1F20             (    forth6809.asm):03576                     TFR   Y,D
E4C7 E784             (    forth6809.asm):03577                     STB   ,X
E4C9 ECC4             (    forth6809.asm):03578                     LDD   ,U
E4CB C30001           (    forth6809.asm):03579                     ADDD  #1
E4CE EDC4             (    forth6809.asm):03580                     STD   ,U
                      (    forth6809.asm):03581         
E4D0 1F20             (    forth6809.asm):03582                     TFR   Y,D
E4D2 4F               (    forth6809.asm):03583                     CLRA
E4D3 3606             (    forth6809.asm):03584                     PSHU  D
E4D5 BDE494           (    forth6809.asm):03585                     JSR   EMITW
E4D8 20C9             (    forth6809.asm):03586                     BRA   ALOOP
                      (    forth6809.asm):03587         
E4DA ECC4             (    forth6809.asm):03588         ABKSP:      LDD   ,U
E4DC 27C5             (    forth6809.asm):03589                     BEQ   ALOOP
E4DE 830001           (    forth6809.asm):03590                     SUBD  #1
E4E1 EDC4             (    forth6809.asm):03591                     STD   ,U
E4E3 CC0008           (    forth6809.asm):03592                     LDD   #8
E4E6 3606             (    forth6809.asm):03593                     PSHU  D
E4E8 BDE494           (    forth6809.asm):03594                     JSR   EMITW
E4EB CC0020           (    forth6809.asm):03595                     LDD   #32
E4EE 3606             (    forth6809.asm):03596                     PSHU  D
E4F0 BDE494           (    forth6809.asm):03597                     JSR   EMITW
E4F3 CC0008           (    forth6809.asm):03598                     LDD   #8
E4F6 3606             (    forth6809.asm):03599                     PSHU  D
E4F8 BDE494           (    forth6809.asm):03600                     JSR   EMITW
E4FB 20A6             (    forth6809.asm):03601                     BRA   ALOOP
                      (    forth6809.asm):03602         
E4FD                  (    forth6809.asm):03603         ADONE:
                      (    forth6809.asm):03604                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03605                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03606                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03607                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03608                                             ; with KEY never polled at all
                      (    forth6809.asm):03609                     JSR   PUTXOFF
                      (    forth6809.asm):03610                     ENDC                    ; <<<<<<<<<<
E4FD ECC4             (    forth6809.asm):03611                     LDD   ,U
E4FF ED44             (    forth6809.asm):03612                     STD   4,U               ; +n2
E501 3344             (    forth6809.asm):03613                     LEAU  4,U
E503 39               (    forth6809.asm):03614                     RTS
                      (    forth6809.asm):03615         
                      (    forth6809.asm):03616         ; ------------------------------------------------------------
                      (    forth6809.asm):03617         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03618         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03619         ; ------------------------------------------------------------
E504 BDE49C           (    forth6809.asm):03620         EXPECTW:    JSR   ACCEPTW
E507 3706             (    forth6809.asm):03621                     PULU  D
E509 DD3F             (    forth6809.asm):03622                     STD   SPAN
E50B 39               (    forth6809.asm):03623                     RTS
                      (    forth6809.asm):03624         
                      (    forth6809.asm):03625         ; ------------------------------------------------------------
                      (    forth6809.asm):03626         ; QUERY  ( -- )
                      (    forth6809.asm):03627         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03628         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03629         ; to 0 and >IN to 0.
                      (    forth6809.asm):03630         ; ------------------------------------------------------------
E50C 8E0106           (    forth6809.asm):03631         QUERYW:     LDX   #TIBBUF
E50F 3610             (    forth6809.asm):03632                     PSHU  X
E511 CC0050           (    forth6809.asm):03633                     LDD   #TIBBUFL
E514 3606             (    forth6809.asm):03634                     PSHU  D
E516 BDE49C           (    forth6809.asm):03635                     JSR   ACCEPTW
E519 3706             (    forth6809.asm):03636                     PULU  D
E51B DD12             (    forth6809.asm):03637                     STD   NTIB
E51D DD3B             (    forth6809.asm):03638                     STD   SRCLEN
E51F CC0106           (    forth6809.asm):03639                     LDD   #TIBBUF
E522 DD39             (    forth6809.asm):03640                     STD   SRCADDR
E524 CC0000           (    forth6809.asm):03641                     LDD   #0
E527 DD3D             (    forth6809.asm):03642                     STD   SRCID
E529 DD10             (    forth6809.asm):03643                     STD   TOIN
E52B 39               (    forth6809.asm):03644                     RTS
                      (    forth6809.asm):03645         
                      (    forth6809.asm):03646         ; ============================================================
                      (    forth6809.asm):03647         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03648         ; ============================================================
                      (    forth6809.asm):03649         ; ------------------------------------------------------------
                      (    forth6809.asm):03650         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03651         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03652         ; one expected.
                      (    forth6809.asm):03653         ; CFERR
                      (    forth6809.asm):03654         ;    Inputs:
                      (    forth6809.asm):03655         ;        none
                      (    forth6809.asm):03656         ;    Outputs:
                      (    forth6809.asm):03657         ;        does not return (THROW -22)
                      (    forth6809.asm):03658         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03659         ; ------------------------------------------------------------
E52C CCFFEA           (    forth6809.asm):03660         CFERR:      LDD   #-22
E52F 3606             (    forth6809.asm):03661                     PSHU  D                 ; -22
E531 BDE561           (    forth6809.asm):03662                     JSR   THROWW
E534 39               (    forth6809.asm):03663                     RTS
                      (    forth6809.asm):03664         
                      (    forth6809.asm):03665         ; ------------------------------------------------------------
                      (    forth6809.asm):03666         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03667         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03668         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03669         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03670         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03671         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03672         ; ------------------------------------------------------------
E535 3710             (    forth6809.asm):03673         CATCHW:     PULU  X                 ; xt
E537 DC0C             (    forth6809.asm):03674                     LDD   HANDLER
E539 3406             (    forth6809.asm):03675                     PSHS  D
E53B 3440             (    forth6809.asm):03676                     PSHS  U
                      (    forth6809.asm):03677                     ; Save the input source specification.
                      (    forth6809.asm):03678                     ; See bugfix: CATCHW.1
E53D DC39             (    forth6809.asm):03679                     LDD   SRCADDR
E53F 3406             (    forth6809.asm):03680                     PSHS  D
E541 DC3B             (    forth6809.asm):03681                     LDD   SRCLEN
E543 3406             (    forth6809.asm):03682                     PSHS  D
E545 DC3D             (    forth6809.asm):03683                     LDD   SRCID
E547 3406             (    forth6809.asm):03684                     PSHS  D
E549 DC10             (    forth6809.asm):03685                     LDD   TOIN
E54B 3406             (    forth6809.asm):03686                     PSHS  D
E54D 1F40             (    forth6809.asm):03687                     TFR   S,D
E54F DD0C             (    forth6809.asm):03688                     STD   HANDLER
                      (    forth6809.asm):03689         
E551 AD84             (    forth6809.asm):03690                     JSR   ,X
                      (    forth6809.asm):03691         
E553 3268             (    forth6809.asm):03692                     LEAS  8,S               ; drop saved input source
E555 3262             (    forth6809.asm):03693                     LEAS  2,S               ; saved U
E557 3506             (    forth6809.asm):03694                     PULS  D
E559 DD0C             (    forth6809.asm):03695                     STD   HANDLER
E55B CC0000           (    forth6809.asm):03696                     LDD   #0
E55E 3606             (    forth6809.asm):03697                     PSHU  D                 ; 0 = no exception
E560 39               (    forth6809.asm):03698                     RTS
                      (    forth6809.asm):03699         
                      (    forth6809.asm):03700         ; ------------------------------------------------------------
                      (    forth6809.asm):03701         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03702         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03703         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03704         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03705         ; ------------------------------------------------------------
E561 3706             (    forth6809.asm):03706         THROWW:     PULU  D                 ; n
E563 10830000         (    forth6809.asm):03707                     CMPD  #0
E567 2725             (    forth6809.asm):03708                     BEQ   THDONE
                      (    forth6809.asm):03709         
E569 DD0E             (    forth6809.asm):03710                     STD   THROWN
E56B 9E0C             (    forth6809.asm):03711                     LDX   HANDLER
E56D 2720             (    forth6809.asm):03712                     BEQ   THUNCAU
                      (    forth6809.asm):03713         
E56F 1F14             (    forth6809.asm):03714                     TFR   X,S
E571 3506             (    forth6809.asm):03715                     PULS  D                 ; restore input source saved by CATCH
E573 DD10             (    forth6809.asm):03716                     STD   TOIN
E575 3506             (    forth6809.asm):03717                     PULS  D
E577 DD3D             (    forth6809.asm):03718                     STD   SRCID
E579 3506             (    forth6809.asm):03719                     PULS  D
E57B DD3B             (    forth6809.asm):03720                     STD   SRCLEN
E57D 3506             (    forth6809.asm):03721                     PULS  D
E57F DD39             (    forth6809.asm):03722                     STD   SRCADDR
E581 3506             (    forth6809.asm):03723                     PULS  D
E583 1F03             (    forth6809.asm):03724                     TFR   D,U
E585 3506             (    forth6809.asm):03725                     PULS  D
E587 DD0C             (    forth6809.asm):03726                     STD   HANDLER
                      (    forth6809.asm):03727         
E589 DC0E             (    forth6809.asm):03728                     LDD   THROWN
E58B 3606             (    forth6809.asm):03729                     PSHU  D
E58D 39               (    forth6809.asm):03730                     RTS
E58E 39               (    forth6809.asm):03731         THDONE:     RTS
                      (    forth6809.asm):03732         
                      (    forth6809.asm):03733                     ; No CATCH is active: leave n on the stack and ABORT.
E58F DC0E             (    forth6809.asm):03734         THUNCAU:    LDD   THROWN
E591 3606             (    forth6809.asm):03735                     PSHU  D
E593 7EDDEF           (    forth6809.asm):03736                     JMP   ABORT
                      (    forth6809.asm):03737         
                      (    forth6809.asm):03738         ; ============================================================
                      (    forth6809.asm):03739         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03740         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03741         ; ============================================================
                      (    forth6809.asm):03742         ; ------------------------------------------------------------
                      (    forth6809.asm):03743         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03744         ; location.
                      (    forth6809.asm):03745         ; PATCH   ( target location -- )
                      (    forth6809.asm):03746         ;    Inputs:
                      (    forth6809.asm):03747         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03748         ;    Outputs:
                      (    forth6809.asm):03749         ;        the cell at location holds target - location
                      (    forth6809.asm):03750         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03751         ; ------------------------------------------------------------
E596 3710             (    forth6809.asm):03752         PATCH:      PULU  X                 ; location
E598 3706             (    forth6809.asm):03753                     PULU  D                 ; target
E59A 3410             (    forth6809.asm):03754                     PSHS  X
E59C A3E1             (    forth6809.asm):03755                     SUBD  ,S++              ; target - location
E59E ED84             (    forth6809.asm):03756                     STD   ,X
E5A0 39               (    forth6809.asm):03757                     RTS
                      (    forth6809.asm):03758         
                      (    forth6809.asm):03759         ; ------------------------------------------------------------
                      (    forth6809.asm):03760         ; IF  ( C: -- orig )
                      (    forth6809.asm):03761         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03762         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03763         ; ------------------------------------------------------------
E5A1 CCDE9C           (    forth6809.asm):03764         IFW:        LDD   #ZBRANCH
E5A4 3606             (    forth6809.asm):03765                     PSHU  D
E5A6 BDE99C           (    forth6809.asm):03766                     JSR   CCALL
E5A9 CC0000           (    forth6809.asm):03767                     LDD   #0
E5AC 3606             (    forth6809.asm):03768                     PSHU  D
E5AE BDDF26           (    forth6809.asm):03769                     JSR   CODECOMMA
E5B1 DC08             (    forth6809.asm):03770                     LDD   CODEHERE
E5B3 830002           (    forth6809.asm):03771                     SUBD  #2
E5B6 3606             (    forth6809.asm):03772                     PSHU  D                 ; orig
E5B8 CC0001           (    forth6809.asm):03773                     LDD   #TAGFWD
E5BB 3606             (    forth6809.asm):03774                     PSHU  D
E5BD 39               (    forth6809.asm):03775                     RTS
                      (    forth6809.asm):03776         
                      (    forth6809.asm):03777         ; ------------------------------------------------------------
                      (    forth6809.asm):03778         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03779         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03780         ; operand to jump to the current code address.
                      (    forth6809.asm):03781         ; ------------------------------------------------------------
E5BE 3706             (    forth6809.asm):03782         THENW:      PULU  D
E5C0 10830001         (    forth6809.asm):03783                     CMPD  #TAGFWD
E5C4 2703             (    forth6809.asm):03784                     BEQ   THOK
E5C6 BDE52C           (    forth6809.asm):03785                     JSR   CFERR
E5C9 3710             (    forth6809.asm):03786         THOK:       PULU  X                 ; orig
E5CB DC08             (    forth6809.asm):03787                     LDD   CODEHERE
E5CD 3606             (    forth6809.asm):03788                     PSHU  D
E5CF 3610             (    forth6809.asm):03789                     PSHU  X
E5D1 BDE596           (    forth6809.asm):03790                     JSR   PATCH
E5D4 39               (    forth6809.asm):03791                     RTS
                      (    forth6809.asm):03792         
                      (    forth6809.asm):03793         ; ------------------------------------------------------------
                      (    forth6809.asm):03794         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03795         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03796         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
E5D5 3706             (    forth6809.asm):03798         ELSEW:      PULU  D
E5D7 10830001         (    forth6809.asm):03799                     CMPD  #TAGFWD
E5DB 2703             (    forth6809.asm):03800                     BEQ   ELOK
E5DD BDE52C           (    forth6809.asm):03801                     JSR   CFERR
E5E0 3706             (    forth6809.asm):03802         ELOK:       PULU  D                 ; orig1
E5E2 3406             (    forth6809.asm):03803                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E5E4 CCDEB2           (    forth6809.asm):03804                     LDD   #BRANCH
E5E7 3606             (    forth6809.asm):03805                     PSHU  D
E5E9 BDE99C           (    forth6809.asm):03806                     JSR   CCALL
E5EC CC0000           (    forth6809.asm):03807                     LDD   #0
E5EF 3606             (    forth6809.asm):03808                     PSHU  D
E5F1 BDDF26           (    forth6809.asm):03809                     JSR   CODECOMMA
E5F4 DC08             (    forth6809.asm):03810                     LDD   CODEHERE
E5F6 3606             (    forth6809.asm):03811                     PSHU  D
E5F8 3506             (    forth6809.asm):03812                     PULS  D                 ; orig1
E5FA 3606             (    forth6809.asm):03813                     PSHU  D
E5FC BDE596           (    forth6809.asm):03814                     JSR   PATCH
E5FF DC08             (    forth6809.asm):03815                     LDD   CODEHERE
E601 830002           (    forth6809.asm):03816                     SUBD  #2
E604 3606             (    forth6809.asm):03817                     PSHU  D                 ; orig2
E606 CC0001           (    forth6809.asm):03818                     LDD   #TAGFWD
E609 3606             (    forth6809.asm):03819                     PSHU  D
E60B 39               (    forth6809.asm):03820                     RTS
                      (    forth6809.asm):03821         
                      (    forth6809.asm):03822         ; ------------------------------------------------------------
                      (    forth6809.asm):03823         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03824         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03825         ; stack.
                      (    forth6809.asm):03826         ; ------------------------------------------------------------
E60C DC08             (    forth6809.asm):03827         BEGINW:     LDD   CODEHERE
E60E 3606             (    forth6809.asm):03828                     PSHU  D                 ; dest
E610 CC0002           (    forth6809.asm):03829                     LDD   #TAGBACK
E613 3606             (    forth6809.asm):03830                     PSHU  D
E615 39               (    forth6809.asm):03831                     RTS
                      (    forth6809.asm):03832         
                      (    forth6809.asm):03833         ; ------------------------------------------------------------
                      (    forth6809.asm):03834         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03835         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03836         ; ------------------------------------------------------------
E616 3706             (    forth6809.asm):03837         UNTILW:     PULU  D
E618 10830002         (    forth6809.asm):03838                     CMPD  #TAGBACK
E61C 2703             (    forth6809.asm):03839                     BEQ   UNOK
E61E BDE52C           (    forth6809.asm):03840                     JSR   CFERR
E621 3706             (    forth6809.asm):03841         UNOK:       PULU  D                 ; dest
E623 3606             (    forth6809.asm):03842                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E625 CCDE9C           (    forth6809.asm):03843                     LDD   #ZBRANCH
E628 3606             (    forth6809.asm):03844                     PSHU  D
E62A BDE99C           (    forth6809.asm):03845                     JSR   CCALL
E62D CC0000           (    forth6809.asm):03846                     LDD   #0
E630 3606             (    forth6809.asm):03847                     PSHU  D
E632 BDDF26           (    forth6809.asm):03848                     JSR   CODECOMMA
E635 DC08             (    forth6809.asm):03849                     LDD   CODEHERE
E637 830002           (    forth6809.asm):03850                     SUBD  #2
E63A 3606             (    forth6809.asm):03851                     PSHU  D                 ; location; the parked dest is beneath
E63C BDE596           (    forth6809.asm):03852                     JSR   PATCH
E63F 39               (    forth6809.asm):03853                     RTS
                      (    forth6809.asm):03854         
                      (    forth6809.asm):03855         ; ------------------------------------------------------------
                      (    forth6809.asm):03856         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03857         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03858         ; ------------------------------------------------------------
E640 3706             (    forth6809.asm):03859         AGAINW:     PULU  D
E642 10830002         (    forth6809.asm):03860                     CMPD  #TAGBACK
E646 2703             (    forth6809.asm):03861                     BEQ   AGOK
E648 BDE52C           (    forth6809.asm):03862                     JSR   CFERR
E64B 3706             (    forth6809.asm):03863         AGOK:       PULU  D                 ; dest
E64D 3606             (    forth6809.asm):03864                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E64F CCDEB2           (    forth6809.asm):03865                     LDD   #BRANCH
E652 3606             (    forth6809.asm):03866                     PSHU  D
E654 BDE99C           (    forth6809.asm):03867                     JSR   CCALL
E657 CC0000           (    forth6809.asm):03868                     LDD   #0
E65A 3606             (    forth6809.asm):03869                     PSHU  D
E65C BDDF26           (    forth6809.asm):03870                     JSR   CODECOMMA
E65F DC08             (    forth6809.asm):03871                     LDD   CODEHERE
E661 830002           (    forth6809.asm):03872                     SUBD  #2
E664 3606             (    forth6809.asm):03873                     PSHU  D                 ; location; the parked dest is beneath
E666 BDE596           (    forth6809.asm):03874                     JSR   PATCH
E669 39               (    forth6809.asm):03875                     RTS
                      (    forth6809.asm):03876         
                      (    forth6809.asm):03877         ; ------------------------------------------------------------
                      (    forth6809.asm):03878         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03879         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03880         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03881         ; ------------------------------------------------------------
E66A CCDE9C           (    forth6809.asm):03882         WHILEW:     LDD   #ZBRANCH
E66D 3606             (    forth6809.asm):03883                     PSHU  D
E66F BDE99C           (    forth6809.asm):03884                     JSR   CCALL
E672 CC0000           (    forth6809.asm):03885                     LDD   #0
E675 3606             (    forth6809.asm):03886                     PSHU  D
E677 BDDF26           (    forth6809.asm):03887                     JSR   CODECOMMA
E67A DC08             (    forth6809.asm):03888                     LDD   CODEHERE
E67C 830002           (    forth6809.asm):03889                     SUBD  #2
E67F 3606             (    forth6809.asm):03890                     PSHU  D                 ; orig
E681 CC0001           (    forth6809.asm):03891                     LDD   #TAGFWD
E684 3606             (    forth6809.asm):03892                     PSHU  D
E686 39               (    forth6809.asm):03893                     RTS
                      (    forth6809.asm):03894         
                      (    forth6809.asm):03895         ; ------------------------------------------------------------
                      (    forth6809.asm):03896         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03897         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03898         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03899         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03900         ; ------------------------------------------------------------
E687 3706             (    forth6809.asm):03901         REPEATW:    PULU  D
E689 10830001         (    forth6809.asm):03902                     CMPD  #TAGFWD
E68D 2703             (    forth6809.asm):03903                     BEQ   RPOK1
E68F BDE52C           (    forth6809.asm):03904                     JSR   CFERR
E692 3710             (    forth6809.asm):03905         RPOK1:      PULU  X                 ; orig
E694 3410             (    forth6809.asm):03906                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03907         
                      (    forth6809.asm):03908                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03909                     ; See bugfix: REPEATW.1
E696 3040             (    forth6809.asm):03910                     LEAX  0,U               ; scan from top of control stack
E698 9F16             (    forth6809.asm):03911                     STX   MSCR2             ; MSCR2 = base of scan region
E69A 9F1A             (    forth6809.asm):03912                     STX   MSCR4             ; MSCR4 = scan pointer
E69C DC1A             (    forth6809.asm):03913         RPSCAN:     LDD   MSCR4
E69E 109321           (    forth6809.asm):03914                     CMPD  CSP
E6A1 2603             (    forth6809.asm):03915                     BNE   RPSCANOK
E6A3 BDE52C           (    forth6809.asm):03916                     JSR   CFERR             ; no matching BEGIN
E6A6 9E1A             (    forth6809.asm):03917         RPSCANOK:   LDX   MSCR4
E6A8 EC84             (    forth6809.asm):03918                     LDD   ,X
E6AA 10830002         (    forth6809.asm):03919                     CMPD  #TAGBACK
E6AE 2712             (    forth6809.asm):03920                     BEQ   RPFOUND
E6B0 10830001         (    forth6809.asm):03921                     CMPD  #TAGFWD
E6B4 2703             (    forth6809.asm):03922                     BEQ   RPSKIP
E6B6 BDE52C           (    forth6809.asm):03923                     JSR   CFERR             ; anything else is a genuine mismatch
E6B9 DC1A             (    forth6809.asm):03924         RPSKIP:     LDD   MSCR4
E6BB C30004           (    forth6809.asm):03925                     ADDD  #4
E6BE DD1A             (    forth6809.asm):03926                     STD   MSCR4
E6C0 20DA             (    forth6809.asm):03927                     BRA   RPSCAN
E6C2 9E1A             (    forth6809.asm):03928         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E6C4 EC02             (    forth6809.asm):03929                     LDD   2,X               ; dest = BEGIN's address
E6C6 3406             (    forth6809.asm):03930                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03931         
                      (    forth6809.asm):03932                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03933                     ; bytes, highest word first.
E6C8 DC1A             (    forth6809.asm):03934                     LDD   MSCR4
E6CA 9316             (    forth6809.asm):03935                     SUBD  MSCR2
E6CC DD18             (    forth6809.asm):03936                     STD   MSCR3             ; MSCR3 = bytes to shift
E6CE 2715             (    forth6809.asm):03937                     BEQ   RPSHIFTDONE
E6D0 DC18             (    forth6809.asm):03938         RPSHIFT:    LDD   MSCR3
E6D2 830002           (    forth6809.asm):03939                     SUBD  #2
E6D5 DD18             (    forth6809.asm):03940                     STD   MSCR3
E6D7 9E16             (    forth6809.asm):03941                     LDX   MSCR2
E6D9 308B             (    forth6809.asm):03942                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E6DB EC84             (    forth6809.asm):03943                     LDD   ,X
E6DD 3004             (    forth6809.asm):03944                     LEAX  4,X
E6DF ED84             (    forth6809.asm):03945                     STD   ,X                ; copy one word 4 bytes higher
E6E1 DC18             (    forth6809.asm):03946                     LDD   MSCR3
E6E3 26EB             (    forth6809.asm):03947                     BNE   RPSHIFT
E6E5                  (    forth6809.asm):03948         RPSHIFTDONE:
E6E5 9E16             (    forth6809.asm):03949                     LDX   MSCR2
E6E7 3004             (    forth6809.asm):03950                     LEAX  4,X
E6E9 1F13             (    forth6809.asm):03951                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03952         
E6EB CCDEB2           (    forth6809.asm):03953                     LDD   #BRANCH

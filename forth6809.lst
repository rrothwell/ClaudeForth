                      (    forth6809.asm):01796         ; ------------------------------------------------------------
                      (    forth6809.asm):01797         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):01798         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):01799         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):01800         ; RTSCHECKLO
                      (    forth6809.asm):01801         ;    Inputs:
                      (    forth6809.asm):01802         ;        none
                      (    forth6809.asm):01803         ;    Outputs:
                      (    forth6809.asm):01804         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):01805         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):01806         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):01807         ; ------------------------------------------------------------

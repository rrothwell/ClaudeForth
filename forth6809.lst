DDCE CC0000           (    forth6809.asm):02047                     LDD   #0
DDD1 DD3B             (    forth6809.asm):02048                     STD   SRCLEN
DDD3 DD3D             (    forth6809.asm):02049                     STD   SRCID
                      (    forth6809.asm):02050         
DDD5 8EDE78           (    forth6809.asm):02051                     LDX   #SIGNON
DDD8 3610             (    forth6809.asm):02052                     PSHU  X                 ; c-addr
DDDA CC000F           (    forth6809.asm):02053                     LDD   #SIGNONL
DDDD 3606             (    forth6809.asm):02054                     PSHU  D                 ; u

                      (    forth6809.asm):09444         ; TSTCOMPWORDS - compiling-words tests (glossary section 3.10,
                      (    forth6809.asm):09445         ; 13 words, 17 tests since several get separate cases: TICK
                      (    forth6809.asm):09446         ; found/not-found, ['] compiling/interpreting state, POSTPONE
                      (    forth6809.asm):09447         ; normal/immediate word, SLITERAL compiling/interpreting state,
                      (    forth6809.asm):09448         ; ABORT" false/true flag). Reuses the scratch infrastructure
                      (    forth6809.asm):09449         ; established for sections 3.8/3.9 throughout.
                      (    forth6809.asm):09450         ;
                      (    forth6809.asm):09451         ; POSTPONE is this section's hardest case: a genuine two-level
                      (    forth6809.asm):09452         ; compile-time mechanism. Traced its own code first - for a
                      (    forth6809.asm):09453         ; normal word, it compiles code that ITSELF compiles a call to
                      (    forth6809.asm):09454         ; that word later, when the current definition eventually runs,
                      (    forth6809.asm):09455         ; not immediately (standard ANS semantics: POSTPONE appends a
                      (    forth6809.asm):09456         ; word's own compilation semantics to the current definition,
                      (    forth6809.asm):09457         ; and for an ordinary word that semantics IS "compile a call to
                      (    forth6809.asm):09458         ; it", so appending it only makes sense if the current
                      (    forth6809.asm):09459         ; definition later performs that compiling action itself,
                      (    forth6809.asm):09460         ; against whatever's being compiled at that later point).
                      (    forth6809.asm):09461         ; Verified via the compiled byte sequence directly rather than
                      (    forth6809.asm):09462         ; fully executing a triple-nested compile chain.
                      (    forth6809.asm):09463         ;
                      (    forth6809.asm):09464         ; ABORT" is safely testable for both its flag cases - confirmed
                      (    forth6809.asm):09465         ; by reading its own runtime code that it uses THROW -2
                      (    forth6809.asm):09466         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09467         ; ABORT itself uses (still deliberately untested, per section
                      (    forth6809.asm):09468         ; 3.1's own reasoning).
                      (    forth6809.asm):09469         ; ------------------------------------------------------------
C252 BDFC2B           (    forth6809.asm):09470         TSTCOMPWORDS: JSR CRW
C255 8EC266           (    forth6809.asm):09471                    LDX   #TSTCWMSG
C258 3610             (    forth6809.asm):09472                    PSHU  X
C25A CC0009           (    forth6809.asm):09473                    LDD   #9
C25D 3606             (    forth6809.asm):09474                    PSHU  D
C25F BDF60B           (    forth6809.asm):09475                    JSR   TYPE
C262 BDFC2B           (    forth6809.asm):09476                    JSR   CRW
                      (    forth6809.asm):09477         
                      (    forth6809.asm):09478                    IFEQ TSTSELECTOR-9  ; >>>>
                      (    forth6809.asm):09479         
                      (    forth6809.asm):09480                    JSR   TSTIMMED
                      (    forth6809.asm):09481                    JSR   TSTSTATE
                      (    forth6809.asm):09482                    JSR   TSTBRACKETS
                      (    forth6809.asm):09483                    JSR   TSTTICK1
                      (    forth6809.asm):09484                    JSR   TSTTICK2
                      (    forth6809.asm):09485                    JSR   TSTCOMPCOMMA
                      (    forth6809.asm):09486                    JSR   TSTLITERAL
                      (    forth6809.asm):09487                    JSR   TSTBRACKTICK1
                      (    forth6809.asm):09488                    JSR   TSTBRACKTICK2
                      (    forth6809.asm):09489                    JSR   TSTPOSTPONE1
                      (    forth6809.asm):09490                    JSR   TSTPOSTPONE2
                      (    forth6809.asm):09491                    JSR   TSTTOBODY
                      (    forth6809.asm):09492                    JSR   TSTEXECUTE
                      (    forth6809.asm):09493                    JSR   TSTSLITERAL1
                      (    forth6809.asm):09494                    JSR   TSTSLITERAL2
                      (    forth6809.asm):09495                    JSR   TSTABORTQ1
                      (    forth6809.asm):09496                    JSR   TSTABORTQ2
                      (    forth6809.asm):09497         
                      (    forth6809.asm):09498                    ENDC ; <<<<

                      (    forth6809.asm):16042                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):16043                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):16044                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):16045                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):16046                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):16047                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):16048                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):16049                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):16050                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):16051                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):16052                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):16053                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):16054                  ; for it.
E591 D621             (    forth6809.asm):16055                  LDB   CNTREM
E593 5A               (    forth6809.asm):16056                  DECB
E594 A685             (    forth6809.asm):16057                  LDA   B,X
E596 812E             (    forth6809.asm):16058                  CMPA  #'.'
E598 2604             (    forth6809.asm):16059                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):16060                  DEC   CNTREM
E59C 2766             (    forth6809.asm):16061                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):16062         
E59E 0F22             (    forth6809.asm):16063         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):16064                  LDA   ,X
E5A2 812D             (    forth6809.asm):16065                  CMPA  #'-'

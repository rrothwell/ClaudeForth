                      (    forth6809.asm):05823         
                      (    forth6809.asm):05824                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):05825                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):05826                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):05827                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):05828                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):05829                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):05830                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):05831                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):05832                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):05833                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):05834                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):05835                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):05836                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):05837                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):05838                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):05839                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):05840                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):05841                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):05842                    ; wrong algorithm entirely, not a smaller bug within it.
F932 DCA9             (    forth6809.asm):05843         UELOOP:    LDD  UESRCLEN
F934 2715             (    forth6809.asm):05844                    BEQ  UEDONE
F936 A680             (    forth6809.asm):05845                    LDA  ,X+
F938 8125             (    forth6809.asm):05846                    CMPA #'%'
F93A 2604             (    forth6809.asm):05847                    BNE  UENOTPCT
F93C C625             (    forth6809.asm):05848                    LDB  #'%'      ; write the extra '%' first - the character
F93E E7A0             (    forth6809.asm):05849                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):05850                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):05851                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):05852                                   ; the same string correctly, since this runs
                      (    forth6809.asm):05853                                   ; independently for each one the loop visits.
F940 A7A0             (    forth6809.asm):05854         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):05855                                   ; every character, '%' or not
F942 DCA9             (    forth6809.asm):05856                    LDD  UESRCLEN
F944 830001           (    forth6809.asm):05857                    SUBD #1
F947 DDA9             (    forth6809.asm):05858                    STD  UESRCLEN
F949 20E7             (    forth6809.asm):05859                    BRA  UELOOP
F94B 1F20             (    forth6809.asm):05860         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F94D 93AB             (    forth6809.asm):05861                    SUBD UEDST     ; overwriting whatever was left on top of
F94F DDAD             (    forth6809.asm):05862                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):05863                                   ; required return values, and separately,
                      (    forth6809.asm):05864                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):05865                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):05866                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):05867                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):05868                                   ; characters. Now computed directly as the
                      (    forth6809.asm):05869                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):05870                                   ; original destination address (UEDST) -
                      (    forth6809.asm):05871                                   ; correct regardless of how many characters
                      (    forth6809.asm):05872                                   ; were doubled, since it's derived from
                      (    forth6809.asm):05873                                   ; where writing actually stopped rather than
                      (    forth6809.asm):05874                                   ; incremented alongside it.
F951 DCAB             (    forth6809.asm):05875                    LDD  UEDST
F953 3606             (    forth6809.asm):05876                    PSHU D         ; push c-addr2 (destination address)
F955 DCAD             (    forth6809.asm):05877                    LDD  UEOUTLEN
F957 3606             (    forth6809.asm):05878                    PSHU D         ; push u2 (actual unescaped length)
F959 39               (    forth6809.asm):05879                    RTS
                      (    forth6809.asm):05880         

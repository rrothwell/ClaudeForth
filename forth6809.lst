                      (    forth6809.asm):02208                    STU   TSTUAF
                      (    forth6809.asm):02209         
                      (    forth6809.asm):02210                    PULU  D
                      (    forth6809.asm):02211                    CMPD  #-10
                      (    forth6809.asm):02212                    BNE   MXFAIL
                      (    forth6809.asm):02213         
                      (    forth6809.asm):02214                    LDD   TSTUB4
                      (    forth6809.asm):02215                    SUBD  TSTUAF
                      (    forth6809.asm):02216                    CMPD  #0
                      (    forth6809.asm):02217                    BNE   MXFAIL
                      (    forth6809.asm):02218         
                      (    forth6809.asm):02219                    LDD   #TRUEV
                      (    forth6809.asm):02220                    BRA   MXDONE
C100                  (    forth6809.asm):02221         MXFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02222         MXDONE:     LDX   #TSTSLMODZNAME

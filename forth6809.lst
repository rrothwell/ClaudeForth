                      (    forth6809.asm):04134         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04135         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04136         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04137         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04138         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04139         ;    Inputs:
                      (    forth6809.asm):04140         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04141         ;    Outputs:
                      (    forth6809.asm):04142         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04143         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04144         ;        scratch.
                      (    forth6809.asm):04145         ; ------------------------------------------------------------

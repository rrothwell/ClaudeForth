                      (    forth6809.asm):02492         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02493         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02494         ; confirms both cells genuinely left the data stack before

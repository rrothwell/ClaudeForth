                      (    forth6809.asm):04707         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04708         ; ============================================================
                      (    forth6809.asm):04709         ; ------------------------------------------------------------
                      (    forth6809.asm):04710         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04711         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04712         ; one expected.
                      (    forth6809.asm):04713         ; CFERR
                      (    forth6809.asm):04714         ;    Inputs:
                      (    forth6809.asm):04715         ;        none
                      (    forth6809.asm):04716         ;    Outputs:
                      (    forth6809.asm):04717         ;        does not return (THROW -22)
                      (    forth6809.asm):04718         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04719         ; ------------------------------------------------------------
D9BC CCFFEA           (    forth6809.asm):04720         CFERR:      LDD   #-22
D9BF 3606             (    forth6809.asm):04721                     PSHU  D                 ; -22
D9C1 BDD9F1           (    forth6809.asm):04722                     JSR   THROWW
D9C4 39               (    forth6809.asm):04723                     RTS
                      (    forth6809.asm):04724         
                      (    forth6809.asm):04725         ; ------------------------------------------------------------
                      (    forth6809.asm):04726         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04727         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04728         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04729         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04730         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04731         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04732         ; ------------------------------------------------------------
D9C5 3710             (    forth6809.asm):04733         CATCHW:     PULU  X                 ; xt
D9C7 DC0C             (    forth6809.asm):04734                     LDD   HANDLER
D9C9 3406             (    forth6809.asm):04735                     PSHS  D
D9CB 3440             (    forth6809.asm):04736                     PSHS  U
                      (    forth6809.asm):04737                     ; Save the input source specification.
                      (    forth6809.asm):04738                     ; See bugfix: CATCHW.1
D9CD DC39             (    forth6809.asm):04739                     LDD   SRCADDR
D9CF 3406             (    forth6809.asm):04740                     PSHS  D
D9D1 DC3B             (    forth6809.asm):04741                     LDD   SRCLEN
D9D3 3406             (    forth6809.asm):04742                     PSHS  D
D9D5 DC3D             (    forth6809.asm):04743                     LDD   SRCID
D9D7 3406             (    forth6809.asm):04744                     PSHS  D
D9D9 DC10             (    forth6809.asm):04745                     LDD   TOIN
D9DB 3406             (    forth6809.asm):04746                     PSHS  D

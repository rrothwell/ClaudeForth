                      (    forth6809.asm):01219                    PSHU D
                      (    forth6809.asm):01220                    LDD  #3
                      (    forth6809.asm):01221                    PSHU D
                      (    forth6809.asm):01222                    STU  TSTUB4
                      (    forth6809.asm):01223         
                      (    forth6809.asm):01224                    JSR  SPACESW
                      (    forth6809.asm):01225         
                      (    forth6809.asm):01226                    STU  TSTUAF
                      (    forth6809.asm):01227         
                      (    forth6809.asm):01228                    IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01229                                     ; queues all three bytes into OUTBUF,
                      (    forth6809.asm):01230                                     ; verifiable individually
                      (    forth6809.asm):01231                    LDA  TSTOHSAV
                      (    forth6809.asm):01232                    ADDA #3
                      (    forth6809.asm):01233                    ANDA #OUTBUFSZ-1
                      (    forth6809.asm):01234                    CMPA OUTHEAD
                      (    forth6809.asm):01235                    BNE  SSFAIL
                      (    forth6809.asm):01236         
                      (    forth6809.asm):01237                    LDX  #OUTBUF
                      (    forth6809.asm):01238                    LDB  TSTOHSAV
                      (    forth6809.asm):01239                    LDA  B,X
                      (    forth6809.asm):01240                    CMPA #32
                      (    forth6809.asm):01241                    BNE  SSFAIL
                      (    forth6809.asm):01242                    INCB
                      (    forth6809.asm):01243                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01244                    LDA  B,X
                      (    forth6809.asm):01245                    CMPA #32
                      (    forth6809.asm):01246                    BNE  SSFAIL
                      (    forth6809.asm):01247                    INCB
                      (    forth6809.asm):01248                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01249                    LDA  B,X
                      (    forth6809.asm):01250                    CMPA #32
                      (    forth6809.asm):01251                    BNE  SSFAIL
                      (    forth6809.asm):01252                    ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking
                      (    forth6809.asm):01253                                     ; OUTHEAD/OUTBUF - same fix and reasoning as
                      (    forth6809.asm):01254                                     ; TSTCR's own fix. In polling mode, EMITCH
                      (    forth6809.asm):01255                                     ; only reflects the LAST of the three
                      (    forth6809.asm):01256                                     ; identical spaces emitted, and there is no
                      (    forth6809.asm):01257                                     ; persistent per-call count to verify

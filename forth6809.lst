                      (    forth6809.asm):09950                     STD  CODEHERE
                      (    forth6809.asm):09951         
                      (    forth6809.asm):09952                     STU  TSTU0
                      (    forth6809.asm):09953         
                      (    forth6809.asm):09954                     LDD  #TSTGUARD
                      (    forth6809.asm):09955                     PSHU D
                      (    forth6809.asm):09956                     STU  TSTUB4
                      (    forth6809.asm):09957         

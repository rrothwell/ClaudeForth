                      (    forth6809.asm):06048         ; ============================================================
                      (    forth6809.asm):06049         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06050         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06051         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06052         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06053         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06054         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06055         ; ============================================================
                      (    forth6809.asm):06056         ; ------------------------------------------------------------
                      (    forth6809.asm):06057         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06058         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06059         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06060         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06061         ; - no indirection, no value cell.
                      (    forth6809.asm):06062         ;
                      (    forth6809.asm):06063         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06064         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06065         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06066         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06067         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06068         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06069         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06070         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06071         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06072         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06073         ; ------------------------------------------------------------
FEF4 CCFFFF           (    forth6809.asm):06074         TRUEBODY:  LDD   #$FFFF
FEF7 3606             (    forth6809.asm):06075                    PSHU  D
FEF9 39               (    forth6809.asm):06076                    RTS
                      (    forth6809.asm):06077         
FEFA CC0000           (    forth6809.asm):06078         FALSEBODY: LDD   #$0000
FEFD 3606             (    forth6809.asm):06079                    PSHU  D
FEFF 39               (    forth6809.asm):06080                    RTS
                      (    forth6809.asm):06081         
                      (    forth6809.asm):06082         ; ------------------------------------------------------------
                      (    forth6809.asm):06083         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):06084         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):06085         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):06086         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):06087         ; ------------------------------------------------------------
FF00 CC0001           (    forth6809.asm):06088         ONEBODY:   LDD   #1
FF03 3606             (    forth6809.asm):06089                    PSHU  D
FF05 39               (    forth6809.asm):06090                    RTS
                      (    forth6809.asm):06091         
FF06 CCFFFF           (    forth6809.asm):06092         MONEBODY:  LDD   #-1
FF09 3606             (    forth6809.asm):06093                    PSHU  D
FF0B 39               (    forth6809.asm):06094                    RTS
                      (    forth6809.asm):06095         
FF0C CC0002           (    forth6809.asm):06096         TWOBODY:   LDD   #2
FF0F 3606             (    forth6809.asm):06097                    PSHU  D
FF11 39               (    forth6809.asm):06098                    RTS
                      (    forth6809.asm):06099         
FF12 CCFFFE           (    forth6809.asm):06100         MTWOBODY:  LDD   #-2
FF15 3606             (    forth6809.asm):06101                    PSHU  D
FF17 39               (    forth6809.asm):06102                    RTS
                      (    forth6809.asm):06103         
                      (    forth6809.asm):06104         ; Verify no collision with init code,
                      (    forth6809.asm):06105         ; value should match ORG INITCODE.
     FF18             (    forth6809.asm):06106         BASECODEEND  EQU   *
     1EEE             (    forth6809.asm):06107         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):06108         
                      (    forth6809.asm):06109         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):06110         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):06111         ; .bin file.
FF18                  (    forth6809.asm):06112         BASEND:
FF18 FFFFFFFFFFFFFFFF (    forth6809.asm):06113                  FILL $FF,INITCODE-BASEND

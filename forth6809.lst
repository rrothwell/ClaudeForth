D48B 3606             (    forth6809.asm):03593                     PSHU  D
D48D BDD9F1           (    forth6809.asm):03594                     JSR   THROWW
                      (    forth6809.asm):03595         
D490 3710             (    forth6809.asm):03596         IDONE:      PULU  X                 ; c-addr from WORD (empty). See bugfix: INTERPRET.4
D492 39               (    forth6809.asm):03597                     RTS
                      (    forth6809.asm):03598         
                      (    forth6809.asm):03599         ; ------------------------------------------------------------
                      (    forth6809.asm):03600         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03601         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03602         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03603         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03604         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03605         ; ------------------------------------------------------------
D493 3706             (    forth6809.asm):03606         WORDW:      PULU  D                 ; char
D495 327D             (    forth6809.asm):03607                     LEAS  -3,S              ; frame (5k): 0,S = delimiter,
D497 E7E4             (    forth6809.asm):03608                     STB   ,S                ; 1,S = start of the text
D499 DC10             (    forth6809.asm):03609                     LDD   TOIN
D49B 9E39             (    forth6809.asm):03610                     LDX   SRCADDR
D49D 308B             (    forth6809.asm):03611                     LEAX  D,X

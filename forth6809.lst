                      (    forth6809.asm):07208         ; TSTLEAVE - unit test for LEAVE. Compiles
                      (    forth6809.asm):07209         ; "DO I DUP 3 LITERAL = IF LEAVE THEN + LOOP", limit=10,
                      (    forth6809.asm):07210         ; start=0 - would normally visit I=0..9, but LEAVE forces exit
                      (    forth6809.asm):07211         ; once I=3 is reached. LEAVE only sets a flag; the actual exit
                      (    forth6809.asm):07212         ; happens at the NEXT LOOP check (per its own documented
                      (    forth6809.asm):07213         ; behavior, "exit at its next LOOP") - confirmed by hand-trace
                      (    forth6809.asm):07214         ; of DOTEST's own logic (checks the flag first, before its

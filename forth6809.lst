                      (    forth6809.asm):06351         
                      (    forth6809.asm):06352                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06353                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06354                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06355                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06356                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06357                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06358                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06359                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06360                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06361                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06362                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06363                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06364                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):06365                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):06366                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):06367                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):06368                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):06369                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):06370                    ; wrong algorithm entirely, not a smaller bug within it.
F8A6 DCA9             (    forth6809.asm):06371         UELOOP:    LDD  UESRCLEN
F8A8 2715             (    forth6809.asm):06372                    BEQ  UEDONE
F8AA A680             (    forth6809.asm):06373                    LDA  ,X+
F8AC 8125             (    forth6809.asm):06374                    CMPA #'%'
F8AE 2604             (    forth6809.asm):06375                    BNE  UENOTPCT
F8B0 C625             (    forth6809.asm):06376                    LDB  #'%'      ; write the extra '%' first - the character
F8B2 E7A0             (    forth6809.asm):06377                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06378                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06379                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06380                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06381                                   ; independently for each one the loop visits.
F8B4 A7A0             (    forth6809.asm):06382         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06383                                   ; every character, '%' or not
F8B6 DCA9             (    forth6809.asm):06384                    LDD  UESRCLEN
F8B8 830001           (    forth6809.asm):06385                    SUBD #1
F8BB DDA9             (    forth6809.asm):06386                    STD  UESRCLEN
F8BD 20E7             (    forth6809.asm):06387                    BRA  UELOOP
F8BF 1F20             (    forth6809.asm):06388         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F8C1 93AB             (    forth6809.asm):06389                    SUBD UEDST     ; overwriting whatever was left on top of
F8C3 DDAD             (    forth6809.asm):06390                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06391                                   ; required return values, and separately,
                      (    forth6809.asm):06392                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06393                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06394                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06395                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06396                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06397                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06398                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06399                                   ; correct regardless of how many characters
                      (    forth6809.asm):06400                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06401                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06402                                   ; incremented alongside it.
F8C5 DCAB             (    forth6809.asm):06403                    LDD  UEDST
F8C7 3606             (    forth6809.asm):06404                    PSHU D         ; push c-addr2 (destination address)
F8C9 DCAD             (    forth6809.asm):06405                    LDD  UEOUTLEN
F8CB 3606             (    forth6809.asm):06406                    PSHU D         ; push u2 (actual unescaped length)

                      (    forth6809.asm):09442                    CMPD #TSTCBUF  ; captured snapshot of CODEHERE right AFTER
                      (    forth6809.asm):09443                                   ; MARKERW finished building its own header -
                      (    forth6809.asm):09444                                   ; wrong target. MARKER's own documented
                      (    forth6809.asm):09445                                   ; behavior is "forgets itself too" - traced
                      (    forth6809.asm):09446                                   ; MARKERW's own code and confirmed its
                      (    forth6809.asm):09447                                   ; snapshot (MKDP/MKCODE/MKVAR/MKLATEST) is
                      (    forth6809.asm):09448                                   ; taken at its very start, before HEADER or
                      (    forth6809.asm):09449                                   ; any compiling runs at all - so DOMARKER
                      (    forth6809.asm):09450                                   ; correctly restores to the state BEFORE the
                      (    forth6809.asm):09451                                   ; marker word itself was created (TSTCBUF
                      (    forth6809.asm):09452                                   ; directly), not the state right after. The
                      (    forth6809.asm):09453                                   ; real dictionary/compile mechanism was
                      (    forth6809.asm):09454                                   ; already working correctly; only this
                      (    forth6809.asm):09455                                   ; test's own comparison target was wrong.
                      (    forth6809.asm):09456                    BNE  MKFAIL
                      (    forth6809.asm):09457                    LDD  TSTDSAV2

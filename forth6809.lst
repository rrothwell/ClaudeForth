                      (    forth6809.asm):12907         ; TSTSCOMPARE - unit test for COMPARE. Four sequential sub-cases
                      (    forth6809.asm):12908         ; within one test body, each popping and verifying its own
                      (    forth6809.asm):12909         ; result immediately: less-than, equal, greater-than, and the
                      (    forth6809.asm):12910         ; prefix tie-break case specifically (a shorter string that's a
                      (    forth6809.asm):12911         ; true prefix of a longer one compares less, per the standard
                      (    forth6809.asm):12912         ; three-way convention) - not just LT/EQ/GT on same-length
                      (    forth6809.asm):12913         ; strings, which alone wouldn't exercise the tie-break path at
                      (    forth6809.asm):12914         ; all.
                      (    forth6809.asm):12915         ; ------------------------------------------------------------

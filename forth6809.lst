                      (    forth6809.asm):18369         ; ============================================================
                      (    forth6809.asm):18370         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):18371         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):18372         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):18373         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):18374         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):18375         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):18376         ; ============================================================
                      (    forth6809.asm):18377         ; ------------------------------------------------------------
                      (    forth6809.asm):18378         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):18379         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):18380         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):18381         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):18382         ; - no indirection, no value cell.
                      (    forth6809.asm):18383         ;
                      (    forth6809.asm):18384         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):18385         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):18386         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):18387         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):18388         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):18389         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):18390         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):18391         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):18392         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):18393         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):18394         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):18395         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):18396                    PSHU  D
FF3C 39               (    forth6809.asm):18397                    RTS
                      (    forth6809.asm):18398         
FF3D CC0000           (    forth6809.asm):18399         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):18400                    PSHU  D
FF42 39               (    forth6809.asm):18401                    RTS
                      (    forth6809.asm):18402         
                      (    forth6809.asm):18403         ; ------------------------------------------------------------
                      (    forth6809.asm):18404         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):18405         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):18406         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):18407         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):18408         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):18409         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):18410                    PSHU  D
FF48 39               (    forth6809.asm):18411                    RTS
                      (    forth6809.asm):18412         
FF49 CCFFFF           (    forth6809.asm):18413         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):18414                    PSHU  D
FF4E 39               (    forth6809.asm):18415                    RTS
                      (    forth6809.asm):18416         
FF4F CC0002           (    forth6809.asm):18417         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):18418                    PSHU  D
FF54 39               (    forth6809.asm):18419                    RTS
                      (    forth6809.asm):18420         
FF55 CCFFFE           (    forth6809.asm):18421         MTWOBODY:  LDD   #-2
FF58 3606             (    forth6809.asm):18422                    PSHU  D
FF5A 39               (    forth6809.asm):18423                    RTS
                      (    forth6809.asm):18424         
                      (    forth6809.asm):18425         ; Verify no collision with init code,
                      (    forth6809.asm):18426         ; value should match ORG INITCODE.

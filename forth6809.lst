C13B BDC183           (    forth6809.asm):00817                    JSR   TSTDARITH
C13E BDC1A2           (    forth6809.asm):00818                    JSR   TSTLOGIC
C141 BDC1BB           (    forth6809.asm):00819                    JSR   TSTCOMPARE
C144 BDC1D6           (    forth6809.asm):00820                    JSR   TSTCTRLFLOW
C147 BDC1F2           (    forth6809.asm):00821                    JSR   TSTDEFWORDS
C14A 39               (    forth6809.asm):00822                    RTS
                      (    forth6809.asm):00823         

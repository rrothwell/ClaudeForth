DEB2 FF3D             (    forth6809.asm):10035                  FDB   FALSEBODY
                      (    forth6809.asm):10036         
                      (    forth6809.asm):10037         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):10038         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):10039         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):10040         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):10041         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):10042         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):10043         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):10044         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):10045         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):10046         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):10047         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):10048         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):10049                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):10050                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):10051                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):10052                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):10053                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):10054                  FDB   ABORT
                      (    forth6809.asm):10055         
DEBE 04               (    forth6809.asm):10056         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):10057                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):10058                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):10059                  FDB   QUIT
                      (    forth6809.asm):10060         
                      (    forth6809.asm):10061         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):10062         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):10063         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):10064         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):10065         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):10066         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):10067         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):10068                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):10069                  FDB   H_QUIT
DECE E476             (    forth6809.asm):10070                  FDB   FIND
                      (    forth6809.asm):10071         
DED0 01               (    forth6809.asm):10072         H_1:     FCB   1
DED1 31               (    forth6809.asm):10073                  FCC   "1"
DED2 DEC7             (    forth6809.asm):10074                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):10075                  FDB   ONEBODY
                      (    forth6809.asm):10076         
DED6 02               (    forth6809.asm):10077         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):10078                  FCC   "-1"
DED9 DED0             (    forth6809.asm):10079                  FDB   H_1
DEDB FF49             (    forth6809.asm):10080                  FDB   MONEBODY
                      (    forth6809.asm):10081         
DEDD 01               (    forth6809.asm):10082         H_2:     FCB   1
DEDE 32               (    forth6809.asm):10083                  FCC   "2"
DEDF DED6             (    forth6809.asm):10084                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):10085                  FDB   TWOBODY
                      (    forth6809.asm):10086         
DEE3 02               (    forth6809.asm):10087         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):10088                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):10089                  FDB   H_2
DEE8 FF55             (    forth6809.asm):10090                  FDB   MTWOBODY
                      (    forth6809.asm):10091         
     DEE3             (    forth6809.asm):10092         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):10093                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):10094                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):10095                                   ; were chained on after it; before that,
                      (    forth6809.asm):10096                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):10097                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):10098                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):10099                                   ; before this one.
                      (    forth6809.asm):10100         
                      (    forth6809.asm):10101         ; Verify no collision with base code.
                      (    forth6809.asm):10102         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):10103         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):10104         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):10105         
                      (    forth6809.asm):10106         ; ============================================================
                      (    forth6809.asm):10107         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):10108         ; ============================================================
                      (    forth6809.asm):10109                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):10110                                        ; entirely - every routine from here through
                      (    forth6809.asm):10111                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):10112                                        ; every primitive) would otherwise have
                      (    forth6809.asm):10113                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):10114                                        ; WARM message left the location counter,
                      (    forth6809.asm):10115                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):10116                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):10117                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):10118         
                      (    forth6809.asm):10119         ; ------------------------------------------------------------
                      (    forth6809.asm):10120         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):10121         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):10122         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):10123         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):10124         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):10125         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):10126         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):10127                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):10128                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):10129                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):10130                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):10131                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):10132                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):10133                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):10134                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):10135                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):10136                  RTS
                      (    forth6809.asm):10137         
                      (    forth6809.asm):10138                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):10139         ; ------------------------------------------------------------
                      (    forth6809.asm):10140         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):10141         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):10142         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):10143         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):10144         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):10145         INFILL:  LDA   INHEAD
                      (    forth6809.asm):10146                  SUBA  INTAIL
                      (    forth6809.asm):10147                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):10148                  RTS
                      (    forth6809.asm):10149         
                      (    forth6809.asm):10150         ; ------------------------------------------------------------
                      (    forth6809.asm):10151         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):10152         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):10153         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):10154         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):10155         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):10156         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):10157         ; flow control, not a chip feature.
                      (    forth6809.asm):10158         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):10159         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):10160                     CMPA #INHIWATER
                      (    forth6809.asm):10161                     BLO  RTSCHIDONE
                      (    forth6809.asm):10162                     TST  RTSSTATE
                      (    forth6809.asm):10163                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):10164                     LDA  #CR_RTSHI
                      (    forth6809.asm):10165                     STA  ACIACR
                      (    forth6809.asm):10166                     LDA  #1
                      (    forth6809.asm):10167                     STA  RTSSTATE
DEF5                  (    forth6809.asm):10168         RTSCHIDONE: RTS
                      (    forth6809.asm):10169         
                      (    forth6809.asm):10170         ; ------------------------------------------------------------
                      (    forth6809.asm):10171         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):10172         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):10173         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):10174         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):10175         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):10176         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):10177         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):10178         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):10179         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):10180         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):10181         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):10182                     CMPA #INLOWATER
                      (    forth6809.asm):10183                     BHI  RTSCLODONE
                      (    forth6809.asm):10184                     TST  RTSSTATE
                      (    forth6809.asm):10185                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):10186                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):10187                     CLR  RTSSTATE
                      (    forth6809.asm):10188                     LDB  OUTTAIL
                      (    forth6809.asm):10189                     CMPB OUTHEAD
                      (    forth6809.asm):10190                     BEQ  RTSCLONOTX
                      (    forth6809.asm):10191                     LDA  #CR_RXTX
                      (    forth6809.asm):10192                     STA  ACIACR
                      (    forth6809.asm):10193                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):10194         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):10195                     STA  ACIACR
DEF5                  (    forth6809.asm):10196         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):10197         RTSCLODONE: RTS
                      (    forth6809.asm):10198         
DEF5                  (    forth6809.asm):10199         IRQH:    LDA   ACIASR
                      (    forth6809.asm):10200                  BITA  #SR_IRQ
                      (    forth6809.asm):10201                  BEQ   IRQDONE
                      (    forth6809.asm):10202         
                      (    forth6809.asm):10203                  BITA  #SR_RDRF
                      (    forth6809.asm):10204                  BEQ   TXCHK
                      (    forth6809.asm):10205         
                      (    forth6809.asm):10206                  LDB   INHEAD
                      (    forth6809.asm):10207                  LDA   ACIADR
                      (    forth6809.asm):10208                  LDX   #INBUF
                      (    forth6809.asm):10209                  STA   B,X
                      (    forth6809.asm):10210                  INCB
                      (    forth6809.asm):10211                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):10212                  CMPB  INTAIL
                      (    forth6809.asm):10213                  BEQ   IRQDONE
                      (    forth6809.asm):10214                  STB   INHEAD
                      (    forth6809.asm):10215                  JSR   RTSCHECKHI
                      (    forth6809.asm):10216                  BRA   IRQDONE
                      (    forth6809.asm):10217         
DEF5                  (    forth6809.asm):10218         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):10219                  CMPB  OUTHEAD
                      (    forth6809.asm):10220                  BEQ   TXOFF
                      (    forth6809.asm):10221                  LDX   #OUTBUF
                      (    forth6809.asm):10222                  LDA   B,X
                      (    forth6809.asm):10223                  STA   ACIADR
                      (    forth6809.asm):10224                  INCB
                      (    forth6809.asm):10225                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):10226                  STB   OUTTAIL
                      (    forth6809.asm):10227                  BRA   IRQDONE
                      (    forth6809.asm):10228         
DEF5                  (    forth6809.asm):10229         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):10230                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):10231                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):10232                  LDA   #CR_RXON
                      (    forth6809.asm):10233                  STA   ACIACR
                      (    forth6809.asm):10234         
DEF5                  (    forth6809.asm):10235         IRQDONE: RTI
                      (    forth6809.asm):10236         
                      (    forth6809.asm):10237                  ELSE  ; <<<<<>>>>>
DEF5 3B               (    forth6809.asm):10238         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):10239                                       ; interrupts are never enabled (see
                      (    forth6809.asm):10240                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):10241                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):10242                                       ; the other unused vectors below
                      (    forth6809.asm):10243                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):10244         
DEF6 3B               (    forth6809.asm):10245         SWI3H:   RTI
DEF7 3B               (    forth6809.asm):10246         SWI2H:   RTI
DEF8 3B               (    forth6809.asm):10247         FIRQH:   RTI
DEF9 3B               (    forth6809.asm):10248         NMIH:    RTI                   ; unused now that NMI -> WARM
DEFA CCFF9D           (    forth6809.asm):10249         SWIH:    LDD   #-99             ; placeholder hardware-trap code; push and
DEFD 3606             (    forth6809.asm):10250                  PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DEFF 7EE6F9           (    forth6809.asm):10251                  JMP   THROW
                      (    forth6809.asm):10252         
                      (    forth6809.asm):10253         ; ============================================================
                      (    forth6809.asm):10254         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):10255         ; ============================================================
DF02 CC021B           (    forth6809.asm):10256         COLD:    LDD   #APPVARS
DF05 DD0A             (    forth6809.asm):10257                  STD   VARHERE
DF07 CC7000           (    forth6809.asm):10258                  LDD   #APPCODE
DF0A DD08             (    forth6809.asm):10259                  STD   CODEHERE
DF0C CC2000           (    forth6809.asm):10260                  LDD   #APPDICT
DF0F DD06             (    forth6809.asm):10261                  STD   DPHERE
DF11 CCDEE3           (    forth6809.asm):10262                  LDD   #BASELATEST
DF14 DD04             (    forth6809.asm):10263                  STD   LATEST
                      (    forth6809.asm):10264         
DF16 CC000A           (    forth6809.asm):10265                  LDD   #10
DF19 DD02             (    forth6809.asm):10266                  STD   BASE
                      (    forth6809.asm):10267         
DF1B CC018A           (    forth6809.asm):10268                  LDD   #TIBBUF
DF1E DDDB             (    forth6809.asm):10269                  STD   SRCADDR
DF20 CC0000           (    forth6809.asm):10270                  LDD   #0
DF23 DDDD             (    forth6809.asm):10271                  STD   SRCLEN
DF25 DDDF             (    forth6809.asm):10272                  STD   SRCID
                      (    forth6809.asm):10273         
DF27 8EDFAA           (    forth6809.asm):10274                  LDX   #SIGNON
DF2A 3610             (    forth6809.asm):10275                  PSHU  X
DF2C CC000F           (    forth6809.asm):10276                  LDD   #SIGNONL
DF2F 3606             (    forth6809.asm):10277                  PSHU  D
DF31 BDF60B           (    forth6809.asm):10278                  JSR   TYPE
DF34 BDFC2B           (    forth6809.asm):10279                  JSR   CRW
                      (    forth6809.asm):10280                  ; falls through into ABORT
                      (    forth6809.asm):10281         
DF37 CEBD00           (    forth6809.asm):10282         ABORT:   LDU   #SP0
                      (    forth6809.asm):10283                  ; falls through into QUIT
                      (    forth6809.asm):10284         
DF3A 10CEC000         (    forth6809.asm):10285         QUIT:    LDS   #RP0
DF3E CC0000           (    forth6809.asm):10286                  LDD   #0        ; BUG FIX: this reset used to live at QLOOP
DF41 DD00             (    forth6809.asm):10287                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):10288                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):10289                                   ; that spans more than one line of input.
                      (    forth6809.asm):10290                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):10291                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):10292                                   ; correct, sole places STATE should change
                      (    forth6809.asm):10293                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):10294                                   ; reset was a third, redundant one that
                      (    forth6809.asm):10295                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):10296                                   ; every time QUERY read a new line,
                      (    forth6809.asm):10297                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):10298                                   ; been reached. A colon definition split
                      (    forth6809.asm):10299                                   ; across multiple lines would have every
                      (    forth6809.asm):10300                                   ; word on every line after the first
                      (    forth6809.asm):10301                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):10302                                   ; stack effect, executed) instead of
                      (    forth6809.asm):10303                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):10304                                   ; data stack instead of being compiled,
                      (    forth6809.asm):10305                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):10306                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):10307                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):10308                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):10309                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):10310                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):10311                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):10312                                   ; so this still correctly forces interpret
                      (    forth6809.asm):10313                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):10314                                   ; semantics call for it - just not on every
                      (    forth6809.asm):10315                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):10316                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):10317         
DF43 BDE6B6           (    forth6809.asm):10318         QLOOP:   JSR   QUERY
                      (    forth6809.asm):10319         
DF46 DC06             (    forth6809.asm):10320                  LDD   DPHERE
DF48 DDF3             (    forth6809.asm):10321                  STD   QSAVEDP
DF4A DC08             (    forth6809.asm):10322                  LDD   CODEHERE
DF4C DDF5             (    forth6809.asm):10323                  STD   QSAVECODE
DF4E DC0A             (    forth6809.asm):10324                  LDD   VARHERE

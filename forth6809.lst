                      (    forth6809.asm):01547         ; ------------------------------------------------------------
                      (    forth6809.asm):01548         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01549         ; receiver-error counters to zero.
                      (    forth6809.asm):01550         ; SERBUFCLR
                      (    forth6809.asm):01551         ;    Inputs:
                      (    forth6809.asm):01552         ;        none
                      (    forth6809.asm):01553         ;    Outputs:
                      (    forth6809.asm):01554         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01555         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01556         ;    Registers: only CC changed.
                      (    forth6809.asm):01557         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01558         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01559         ; ------------------------------------------------------------
                      (    forth6809.asm):01560         
DCC4 7F0176           (    forth6809.asm):01561         SERBUFCLR:  CLR   INHEAD
DCC7 7F0177           (    forth6809.asm):01562                     CLR   INTAIL
DCCA 7F0178           (    forth6809.asm):01563                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
DCCD 7F0179           (    forth6809.asm):01564                     CLR   OUTHEAD
DCD0 7F017A           (    forth6809.asm):01565                     CLR   OUTTAIL
DCD3 7F017B           (    forth6809.asm):01566                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01567         
                      (    forth6809.asm):01568         
DCD6 7F017C           (    forth6809.asm):01569                     CLR   FECOUNT
DCD9 7F017D           (    forth6809.asm):01570                     CLR   OVRNCOUNT
DCDC 7F017E           (    forth6809.asm):01571                     CLR   PECOUNT
DCDF 7F017F           (    forth6809.asm):01572                     CLR   POLLREADYCNT
DCE2 39               (    forth6809.asm):01573                     RTS
                      (    forth6809.asm):01574         
                      (    forth6809.asm):01575         ; ------------------------------------------------------------
                      (    forth6809.asm):01576         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01577         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01578         ; INITSERIAL
                      (    forth6809.asm):01579         ;    Inputs:
                      (    forth6809.asm):01580         ;        none
                      (    forth6809.asm):01581         ;    Outputs:
                      (    forth6809.asm):01582         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01583         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01584         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01585         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01586         ; ------------------------------------------------------------
DCE3 BDDCC4           (    forth6809.asm):01587         INITSERIAL: JSR   SERBUFCLR
DCE6 8603             (    forth6809.asm):01588                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
DCE8 B7C008           (    forth6809.asm):01589                     STA   ACIACR
DCEB 12               (    forth6809.asm):01590                     NOP                     ; Settling Delay
DCEC 12               (    forth6809.asm):01591                     NOP
                      (    forth6809.asm):01592         
                      (    forth6809.asm):01593                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01594                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01595                     ELSE                    ; <<<<<>>>>>
DCED 8615             (    forth6809.asm):01596                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01597                     ENDC                    ; <<<<<<<<<<
DCEF B7C008           (    forth6809.asm):01598                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DCF2 39               (    forth6809.asm):01599                     RTS
                      (    forth6809.asm):01600         
                      (    forth6809.asm):01601                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01602         ; ------------------------------------------------------------
                      (    forth6809.asm):01603         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01604         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01605         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01606         ; INFILL
                      (    forth6809.asm):01607         ;    Inputs:
                      (    forth6809.asm):01608         ;        none
                      (    forth6809.asm):01609         ;    Outputs:
                      (    forth6809.asm):01610         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01611         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01612         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01613         INFILL:     LDA   INHEAD
                      (    forth6809.asm):01614                     SUBA  INTAIL
                      (    forth6809.asm):01615                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):01616                     RTS
                      (    forth6809.asm):01617         ; ------------------------------------------------------------
                      (    forth6809.asm):01618         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01619         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01620         ; receive path with interrupts already masked.
                      (    forth6809.asm):01621         ; RTSCHECKHI
                      (    forth6809.asm):01622         ;    Inputs:
                      (    forth6809.asm):01623         ;        none
                      (    forth6809.asm):01624         ;    Outputs:
                      (    forth6809.asm):01625         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01626         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01627         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01628         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):01629                     CMPA  #INHIWATER
                      (    forth6809.asm):01630                     BLO   RTSCHIDONE
                      (    forth6809.asm):01631                     TST   RTSSTATE
                      (    forth6809.asm):01632                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):01633                     LDA   #CR_RTSHI
                      (    forth6809.asm):01634                     STA   ACIACR
                      (    forth6809.asm):01635                     LDA   #1
                      (    forth6809.asm):01636                     STA   RTSSTATE
DCF3                  (    forth6809.asm):01637         RTSCHIDONE: RTS
                      (    forth6809.asm):01638         ; ------------------------------------------------------------
                      (    forth6809.asm):01639         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01640         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01641         ; enables it only while output is pending.
                      (    forth6809.asm):01642         ; UPDATE_RTS
                      (    forth6809.asm):01643         ;    Inputs:
                      (    forth6809.asm):01644         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01645         ;    Outputs:
                      (    forth6809.asm):01646         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01647         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01648         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01649         UPDATE_RTS:
                      (    forth6809.asm):01650                     TST   RTSSTATE
                      (    forth6809.asm):01651                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01652         
                      (    forth6809.asm):01653                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):01654                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01655         
                      (    forth6809.asm):01656                                             ; $B5/%1011_0101
                      (    forth6809.asm):01657                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):01658                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01659         
DCF3                  (    forth6809.asm):01660         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):01661                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):01662                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01663         
DCF3                  (    forth6809.asm):01664         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):01665                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):01666                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DCF3                  (    forth6809.asm):01667         WRITE_CR:
                      (    forth6809.asm):01668                     STA   ACIACR
                      (    forth6809.asm):01669                     RTS
                      (    forth6809.asm):01670         ; ------------------------------------------------------------
                      (    forth6809.asm):01671         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01672         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01673         ; Called after a character is added to the ring.
                      (    forth6809.asm):01674         ; CHKHI
                      (    forth6809.asm):01675         ;    Inputs:
                      (    forth6809.asm):01676         ;        RegB = input ring fill level
                      (    forth6809.asm):01677         ;    Outputs:
                      (    forth6809.asm):01678         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01679         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01680         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01681         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01682         CHKHI:
                      (    forth6809.asm):01683                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):01684                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):01685                     TST   RTSSTATE
                      (    forth6809.asm):01686                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):01687                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):01688                     STA   RTSSTATE
                      (    forth6809.asm):01689                     JSR   UPDATE_RTS
DCF3                  (    forth6809.asm):01690         CHKHIDONE:  RTS
                      (    forth6809.asm):01691         
                      (    forth6809.asm):01692         ; ------------------------------------------------------------
                      (    forth6809.asm):01693         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01694         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01695         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01696         ; CHKLO
                      (    forth6809.asm):01697         ;    Inputs:
                      (    forth6809.asm):01698         ;        RegB = input ring fill level
                      (    forth6809.asm):01699         ;    Outputs:
                      (    forth6809.asm):01700         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01701         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01702         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01703         CHKLO:
                      (    forth6809.asm):01704                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):01705                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):01706                     TST   RTSSTATE
                      (    forth6809.asm):01707                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):01708                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):01709                     STA   RTSSTATE
                      (    forth6809.asm):01710                     JSR   UPDATE_RTS
DCF3                  (    forth6809.asm):01711         CHKLODONE:  RTS
                      (    forth6809.asm):01712         ; ------------------------------------------------------------
                      (    forth6809.asm):01713         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01714         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01715         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01716         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01717         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01718         ;    Inputs:
                      (    forth6809.asm):01719         ;        none
                      (    forth6809.asm):01720         ;    Outputs:
                      (    forth6809.asm):01721         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01722         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01723         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01724         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01725         FLUSHOUTBUFFER:
                      (    forth6809.asm):01726                     LDB   OUTTAIL
                      (    forth6809.asm):01727                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):01728                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01729         
                      (    forth6809.asm):01730                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):01731                     BITA  #SR_CTS
                      (    forth6809.asm):01732                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01733         
                      (    forth6809.asm):01734                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):01735                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01736                                             ; than spin-wait here.
                      (    forth6809.asm):01737         
                      (    forth6809.asm):01738                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):01739                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):01740                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01741         
                      (    forth6809.asm):01742                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):01743                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01744                     STB   OUTTAIL
                      (    forth6809.asm):01745                                             ; One character sent - return rather than
                      (    forth6809.asm):01746                                             ; loop back for more (see header comment).
DCF3                  (    forth6809.asm):01747         FLUSHED:
                      (    forth6809.asm):01748                     RTS
                      (    forth6809.asm):01749         ; ------------------------------------------------------------
                      (    forth6809.asm):01750         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01751         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01752         ; PUTCHAR
                      (    forth6809.asm):01753         ;    Inputs:
                      (    forth6809.asm):01754         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01755         ;    Outputs:
                      (    forth6809.asm):01756         ;        none
                      (    forth6809.asm):01757         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01758         ; ------------------------------------------------------------
DCF3                  (    forth6809.asm):01759         PUTCHAR:
                      (    forth6809.asm):01760                     PSHS  CC,X
                      (    forth6809.asm):01761                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01762         
                      (    forth6809.asm):01763                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):01764                     INCB
                      (    forth6809.asm):01765                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01766                     CMPB  OUTTAIL
                      (    forth6809.asm):01767                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01768         
                      (    forth6809.asm):01769                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):01770                     LDB   OUTHEAD
                      (    forth6809.asm):01771                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01772         
                      (    forth6809.asm):01773                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):01774                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01775                     STB   OUTHEAD
                      (    forth6809.asm):01776         
                      (    forth6809.asm):01777                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):01778                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):01779         
                      (    forth6809.asm):01780                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):01781                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):01782                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):01783                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):01784                     ORCC  #$50              ; re-mask - PUT_EXIT below still

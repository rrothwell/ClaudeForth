                      (    forth6809.asm):03027         ; ------------------------------------------------------------
                      (    forth6809.asm):03028         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03029         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03030         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03031         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03032         ; count.
                      (    forth6809.asm):03033         ; ------------------------------------------------------------

DE61 6F80             (    forth6809.asm):01911                    CLR  ,X+
DE63 6F80             (    forth6809.asm):01912                    CLR  ,X+
DE65 6F80             (    forth6809.asm):01913                    CLR  ,X+
DE67 6F84             (    forth6809.asm):01914                    CLR  ,X
DE69 0FFF             (    forth6809.asm):01915                    CLR  RTSSTATE
DE6B 39               (    forth6809.asm):01916                    RTS
                      (    forth6809.asm):01917         
DE6C BDDE5E           (    forth6809.asm):01918         INITSERIAL: JSR  SERBUFCLR
DE6F 8603             (    forth6809.asm):01919                  LDA   #$03
DE71 B7C008           (    forth6809.asm):01920                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01921                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01922                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01923                  IFEQ SERIALPOLL  ; >>>>>>>>>>
DE74 8695             (    forth6809.asm):01924                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01925                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):01926                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01927                  ENDC  ; <<<<<<<<<<
DE76 B7C008           (    forth6809.asm):01928                  STA   ACIACR         ; was "STA ACIA" - same fix
DE79 39               (    forth6809.asm):01929                  RTS
                      (    forth6809.asm):01930         
                      (    forth6809.asm):01931                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01932         ; ------------------------------------------------------------
                      (    forth6809.asm):01933         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01934         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01935         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01936         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01937         ; ------------------------------------------------------------

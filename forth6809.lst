                      (    forth6809.asm):03743         ; TSTSTSLZ - unit test for STARSLASH, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):03744         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):03745         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):03746         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):03747         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):03748         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):03749         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):03750         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):03751         ; there are.
                      (    forth6809.asm):03752         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03753         TSTSTSLZ:   STU   TSTU0
                      (    forth6809.asm):03754         
                      (    forth6809.asm):03755                    LDD   #TSTVAL1
                      (    forth6809.asm):03756                    PSHU  D
                      (    forth6809.asm):03757                    LDD   #TSTVAL2
                      (    forth6809.asm):03758                    PSHU  D
                      (    forth6809.asm):03759                    LDD   #$0000
                      (    forth6809.asm):03760                    PSHU  D
                      (    forth6809.asm):03761                    LDX   #STARSLASH
                      (    forth6809.asm):03762                    PSHU  X
                      (    forth6809.asm):03763                    STU   TSTUB4
                      (    forth6809.asm):03764         
                      (    forth6809.asm):03765                    JSR   CATCH
                      (    forth6809.asm):03766         
                      (    forth6809.asm):03767                    STU   TSTUAF
                      (    forth6809.asm):03768         
                      (    forth6809.asm):03769                    PULU  D
                      (    forth6809.asm):03770                    CMPD  #-10
                      (    forth6809.asm):03771                    BNE   TZFAIL
                      (    forth6809.asm):03772         
                      (    forth6809.asm):03773                    LDD   TSTUB4
                      (    forth6809.asm):03774                    SUBD  TSTUAF
                      (    forth6809.asm):03775                    CMPD  #0
                      (    forth6809.asm):03776                    BNE   TZFAIL
                      (    forth6809.asm):03777         
                      (    forth6809.asm):03778                    LDD   #TRUEV
                      (    forth6809.asm):03779                    BRA   TZDONE
C100                  (    forth6809.asm):03780         TZFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):03781         TZDONE:     LDX   #TSTSTSLZNAME
                      (    forth6809.asm):03782                    PSHU  X
                      (    forth6809.asm):03783                    PSHU  D
                      (    forth6809.asm):03784                    JSR   TSTREPORT
                      (    forth6809.asm):03785         
                      (    forth6809.asm):03786                    LDU   TSTU0
                      (    forth6809.asm):03787                    RTS
                      (    forth6809.asm):03788         

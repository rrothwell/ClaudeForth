                      (    forth6809.asm):06825                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):06826                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):06827                                   ; landing outer-index at 8, not 10. Offset 10

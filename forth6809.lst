DC91 830002           (    forth6809.asm):05371                     SUBD  #2
DC94 3606             (    forth6809.asm):05372                     PSHU  D                 ; orig
DC96 CCDE68           (    forth6809.asm):05373                     LDD   #DROPW
DC99 3606             (    forth6809.asm):05374                     PSHU  D
DC9B BDDD40           (    forth6809.asm):05375                     JSR   CCALL
DC9E CC0005           (    forth6809.asm):05376                     LDD   #TAGOF
DCA1 3606             (    forth6809.asm):05377                     PSHU  D

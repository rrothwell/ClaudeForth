                      (    forth6809.asm):10911         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10912         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10913         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10914         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10915         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10916         ; sequential walk-through per region.
                      (    forth6809.asm):10917         ;
                      (    forth6809.asm):10918         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10919         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10920         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10921         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10922         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10923         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10924         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10925         ; ------------------------------------------------------------
C281 BDFC2B           (    forth6809.asm):10926         TSTMEMORY: JSR CRW
C284 8EC295           (    forth6809.asm):10927                    LDX   #TSTMEMMSG
C287 3610             (    forth6809.asm):10928                    PSHU  X
C289 CC0006           (    forth6809.asm):10929                    LDD   #6
C28C 3606             (    forth6809.asm):10930                    PSHU  D
C28E BDF60B           (    forth6809.asm):10931                    JSR   TYPE
C291 BDFC2B           (    forth6809.asm):10932                    JSR   CRW
                      (    forth6809.asm):10933         
                      (    forth6809.asm):10934                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10935         
                      (    forth6809.asm):10936                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10937                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10938                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10939                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10940                    JSR   TSTCODEHERE
                      (    forth6809.asm):10941                    JSR   TSTVARHERE
                      (    forth6809.asm):10942                    JSR   TSTPAD
                      (    forth6809.asm):10943                    JSR   TSTUNUSED
                      (    forth6809.asm):10944                    JSR   TSTVUNUSED
                      (    forth6809.asm):10945                    JSR   TSTFILL
                      (    forth6809.asm):10946                    JSR   TSTERASE
                      (    forth6809.asm):10947                    JSR   TSTCMOVE
                      (    forth6809.asm):10948                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10949                    JSR   TSTMOVE1
                      (    forth6809.asm):10950                    JSR   TSTMOVE2
                      (    forth6809.asm):10951                    JSR   TSTMOVE3
                      (    forth6809.asm):10952         
                      (    forth6809.asm):10953                    ENDC ; <<<<
                      (    forth6809.asm):10954         
C294 39               (    forth6809.asm):10955                    RTS
                      (    forth6809.asm):10956         
C295 4D656D6F7279     (    forth6809.asm):10957         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10958         
                      (    forth6809.asm):10959                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10960         
                      (    forth6809.asm):10961         ; ------------------------------------------------------------
                      (    forth6809.asm):10962         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10963         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10964         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10965         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10966         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10967         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10968         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10969         ; runs exclusively of every other.
                      (    forth6809.asm):10970         ;
                      (    forth6809.asm):10971         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10972         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10973         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10974         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10975         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10976         ; ------------------------------------------------------------
                      (    forth6809.asm):10977         
                      (    forth6809.asm):10978         ; ------------------------------------------------------------
                      (    forth6809.asm):10979         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10980         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10981         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10982         ; ------------------------------------------------------------
C29B                  (    forth6809.asm):10983         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10984         
                      (    forth6809.asm):10985                        LDD  #TSTGUARD
                      (    forth6809.asm):10986                        PSHU D
                      (    forth6809.asm):10987                        LDD  #TSTVAL1
                      (    forth6809.asm):10988                        PSHU D
                      (    forth6809.asm):10989                        LDD  #TSTCBUF
                      (    forth6809.asm):10990                        PSHU D
                      (    forth6809.asm):10991                        STU  TSTUB4
                      (    forth6809.asm):10992         
                      (    forth6809.asm):10993                        JSR  STOREW
                      (    forth6809.asm):10994         
                      (    forth6809.asm):10995                        LDD  #TSTCBUF
                      (    forth6809.asm):10996                        PSHU D
                      (    forth6809.asm):10997         
                      (    forth6809.asm):10998                        JSR  ATSIGN
                      (    forth6809.asm):10999         
                      (    forth6809.asm):11000                        STU  TSTUAF
                      (    forth6809.asm):11001         
                      (    forth6809.asm):11002                        PULU D
                      (    forth6809.asm):11003                        CMPD #TSTVAL1
                      (    forth6809.asm):11004                        BNE  FSFAIL
                      (    forth6809.asm):11005                        PULU D
                      (    forth6809.asm):11006                        CMPD #TSTGUARD
                      (    forth6809.asm):11007                        BNE  FSFAIL
                      (    forth6809.asm):11008         
                      (    forth6809.asm):11009                        LDD  TSTUB4
                      (    forth6809.asm):11010                        SUBD TSTUAF
                      (    forth6809.asm):11011                        CMPD #-2
                      (    forth6809.asm):11012                        BNE  FSFAIL
                      (    forth6809.asm):11013         
                      (    forth6809.asm):11014                        LDD  #TRUEV
                      (    forth6809.asm):11015                        BRA  FSDONE
C29B                  (    forth6809.asm):11016         FSFAIL:        LDD  #FALSEV
C29B                  (    forth6809.asm):11017         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):11018                        PSHU X
                      (    forth6809.asm):11019                        PSHU D
                      (    forth6809.asm):11020                        JSR  TSTREPORT
                      (    forth6809.asm):11021         
                      (    forth6809.asm):11022                        LDU  TSTU0
                      (    forth6809.asm):11023                        RTS
                      (    forth6809.asm):11024         
C29B                  (    forth6809.asm):11025         TSTFSNAME: FCB  13
                      (    forth6809.asm):11026                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):11027         
                      (    forth6809.asm):11028         ; ------------------------------------------------------------
                      (    forth6809.asm):11029         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):11030         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):11031         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):11032         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):11033         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):11034         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):11035         ; whatever was there).
                      (    forth6809.asm):11036         ;
                      (    forth6809.asm):11037         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):11038         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):11039         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):11040         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):11041         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):11042         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):11043         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):11044         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):11045         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):11046         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):11047         ; byte ends up where was wrong.
                      (    forth6809.asm):11048         ; ------------------------------------------------------------
C29B                  (    forth6809.asm):11049         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):11050                         STD  TSTCBUF
                      (    forth6809.asm):11051         
                      (    forth6809.asm):11052                         STU  TSTU0
                      (    forth6809.asm):11053         
                      (    forth6809.asm):11054                         LDD  #TSTGUARD
                      (    forth6809.asm):11055                         PSHU D
                      (    forth6809.asm):11056                         LDD  #$34
                      (    forth6809.asm):11057                         PSHU D
                      (    forth6809.asm):11058                         LDD  #TSTCBUF
                      (    forth6809.asm):11059                         PSHU D
                      (    forth6809.asm):11060                         STU  TSTUB4
                      (    forth6809.asm):11061         
                      (    forth6809.asm):11062                         JSR  CSTOREW
                      (    forth6809.asm):11063         
                      (    forth6809.asm):11064                         LDD  TSTCBUF
                      (    forth6809.asm):11065                         CMPD #$34FF
                      (    forth6809.asm):11066                         BNE  CFFAIL
                      (    forth6809.asm):11067         
                      (    forth6809.asm):11068                         LDD  #TSTCBUF
                      (    forth6809.asm):11069                         PSHU D
                      (    forth6809.asm):11070         
                      (    forth6809.asm):11071                         JSR  CFETCH
                      (    forth6809.asm):11072         
                      (    forth6809.asm):11073                         STU  TSTUAF
                      (    forth6809.asm):11074         
                      (    forth6809.asm):11075                         PULU D
                      (    forth6809.asm):11076                         CMPD #$0034
                      (    forth6809.asm):11077                         BNE  CFFAIL
                      (    forth6809.asm):11078                         PULU D
                      (    forth6809.asm):11079                         CMPD #TSTGUARD
                      (    forth6809.asm):11080                         BNE  CFFAIL
                      (    forth6809.asm):11081         
                      (    forth6809.asm):11082                         LDD  TSTUB4
                      (    forth6809.asm):11083                         SUBD TSTUAF
                      (    forth6809.asm):11084                         CMPD #-2
                      (    forth6809.asm):11085                         BNE  CFFAIL
                      (    forth6809.asm):11086         
                      (    forth6809.asm):11087                         LDD  #TRUEV
                      (    forth6809.asm):11088                         BRA  CFDONE
C29B                  (    forth6809.asm):11089         CFFAIL:         LDD  #FALSEV
C29B                  (    forth6809.asm):11090         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11091                         PSHU X
                      (    forth6809.asm):11092                         PSHU D
                      (    forth6809.asm):11093                         JSR  TSTREPORT
                      (    forth6809.asm):11094         
                      (    forth6809.asm):11095                         LDU  TSTU0
                      (    forth6809.asm):11096                         RTS
                      (    forth6809.asm):11097         
C29B                  (    forth6809.asm):11098         TSTCFNAME: FCB  14
                      (    forth6809.asm):11099                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11100         
                      (    forth6809.asm):11101         ; ------------------------------------------------------------
                      (    forth6809.asm):11102         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11103         ; known value, adds a known delta, and verifies the sum landed

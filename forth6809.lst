F7D6 109EAB           (    forth6809.asm):06950                    LDY  UEDST
                      (    forth6809.asm):06951         
                      (    forth6809.asm):06952                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06953                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06954                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06955                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06956                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06957                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06958                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06959                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06960                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06961                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06962                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06963                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06964                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):06965                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):06966                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):06967                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):06968                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):06969                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):06970                    ; wrong algorithm entirely, not a smaller bug within it.
F7D9 DCA9             (    forth6809.asm):06971         UELOOP:    LDD  UESRCLEN
F7DB 2715             (    forth6809.asm):06972                    BEQ  UEDONE
F7DD A680             (    forth6809.asm):06973                    LDA  ,X+
F7DF 8125             (    forth6809.asm):06974                    CMPA #'%'
F7E1 2604             (    forth6809.asm):06975                    BNE  UENOTPCT
F7E3 C625             (    forth6809.asm):06976                    LDB  #'%'      ; write the extra '%' first - the character
F7E5 E7A0             (    forth6809.asm):06977                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06978                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06979                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06980                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06981                                   ; independently for each one the loop visits.
F7E7 A7A0             (    forth6809.asm):06982         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06983                                   ; every character, '%' or not
F7E9 DCA9             (    forth6809.asm):06984                    LDD  UESRCLEN
F7EB 830001           (    forth6809.asm):06985                    SUBD #1
F7EE DDA9             (    forth6809.asm):06986                    STD  UESRCLEN
F7F0 20E7             (    forth6809.asm):06987                    BRA  UELOOP
F7F2 1F20             (    forth6809.asm):06988         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F7F4 93AB             (    forth6809.asm):06989                    SUBD UEDST     ; overwriting whatever was left on top of
F7F6 DDAD             (    forth6809.asm):06990                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06991                                   ; required return values, and separately,
                      (    forth6809.asm):06992                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06993                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06994                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06995                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06996                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06997                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06998                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06999                                   ; correct regardless of how many characters
                      (    forth6809.asm):07000                                   ; were doubled, since it's derived from
                      (    forth6809.asm):07001                                   ; where writing actually stopped rather than
                      (    forth6809.asm):07002                                   ; incremented alongside it.
F7F8 DCAB             (    forth6809.asm):07003                    LDD  UEDST
F7FA 3606             (    forth6809.asm):07004                    PSHU D         ; push c-addr2 (destination address)
F7FC DCAD             (    forth6809.asm):07005                    LDD  UEOUTLEN
F7FE 3606             (    forth6809.asm):07006                    PSHU D         ; push u2 (actual unescaped length)
F800 39               (    forth6809.asm):07007                    RTS
                      (    forth6809.asm):07008         

                      (    forth6809.asm):07531                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):07532         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07533                  ORCC  #$50
FFA6 10CEC000         (    forth6809.asm):07534                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07535                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07536                  CLRA
FFAE 1F8B             (    forth6809.asm):07537                  TFR   A,DP
                      (    forth6809.asm):07538         
FFB0 8E0000           (    forth6809.asm):07539                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07540                  LDB   #0
FFB5 6F80             (    forth6809.asm):07541         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07542                  DECB
FFB8 26FB             (    forth6809.asm):07543                  BNE   CLRGLOB
                      (    forth6809.asm):07544         
FFBA BDDD4D           (    forth6809.asm):07545                  JSR   INITSERIAL
                      (    forth6809.asm):07546         
FFBD 1CAF             (    forth6809.asm):07547                  ANDCC #$AF      ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07548                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07549                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07550                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07551                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07552                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07553                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07554                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07555                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07556                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07557                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07558                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07559                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07560                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07561                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07562                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07563                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07564                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07565                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07566                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07567                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07568                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07569                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07570                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07571                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07572                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07573                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07574                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07575                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07576                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07577                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07578                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07579                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07580                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07581                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07582                                  ; unused vectors).
                      (    forth6809.asm):07583         
                      (    forth6809.asm):07584                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07585                  JSR   TSTRUNNER
                      (    forth6809.asm):07586                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07587                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07588                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07589                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07590                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07591                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07592                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07593                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07594                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07595                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07596                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07597                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07598                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07599                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07600                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07601                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07602                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07603         
FFC2 7EDEE3           (    forth6809.asm):07604                  JMP   COLD
                      (    forth6809.asm):07605         
FFC5 1A50             (    forth6809.asm):07606         WARM:    ORCC  #$50
FFC7 4F               (    forth6809.asm):07607                  CLRA
FFC8 1F8B             (    forth6809.asm):07608                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07609                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07610                  LDS   #RP0
                      (    forth6809.asm):07611         
FFD1 BDDD4D           (    forth6809.asm):07612                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07613                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07614                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07615                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07616                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07617                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07618                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07619                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07620                                         ; reported separately) left either side
                      (    forth6809.asm):07621                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07622                                         ; would previously have inherited it
                      (    forth6809.asm):07623                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07624                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07625                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07626                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07627                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07628                                         ; only once setup is complete.
                      (    forth6809.asm):07629         

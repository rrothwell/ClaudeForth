                      (    forth6809.asm):02372         ; ------------------------------------------------------------
                      (    forth6809.asm):02373         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02374         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02375         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02376         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02377         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02378         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02379         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02380         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02381         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02382         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02383         ;
                      (    forth6809.asm):02384         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02385         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02386         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02387         ; right value once.
                      (    forth6809.asm):02388         ; ------------------------------------------------------------
C195 BDFC2B           (    forth6809.asm):02389         TSTRETSTACK: JSR CRW
C198 8EC1A9           (    forth6809.asm):02390                    LDX   #TSTRETMSG
C19B 3610             (    forth6809.asm):02391                    PSHU  X
C19D CC0008           (    forth6809.asm):02392                    LDD   #8
C1A0 3606             (    forth6809.asm):02393                    PSHU  D
C1A2 BDF60B           (    forth6809.asm):02394                    JSR   TYPE
C1A5 BDFC2B           (    forth6809.asm):02395                    JSR   CRW
                      (    forth6809.asm):02396         
                      (    forth6809.asm):02397                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399                    JSR   TSTTOR
                      (    forth6809.asm):02400                    JSR   TSTRFETCH
                      (    forth6809.asm):02401                    JSR   TSTTWOTOR
                      (    forth6809.asm):02402                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02403         
                      (    forth6809.asm):02404                    ENDC ; <<<<
                      (    forth6809.asm):02405         
C1A8 39               (    forth6809.asm):02406                    RTS
                      (    forth6809.asm):02407         
C1A9 526574537461636B (    forth6809.asm):02408         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02409         
                      (    forth6809.asm):02410                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
                      (    forth6809.asm):02413         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02414         ; every other test group in this file, these words operate
                      (    forth6809.asm):02415         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02416         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02417         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02418         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02419         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02420         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02421         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02422         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02423         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02424         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02425         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02426         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02427         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02428         ; ------------------------------------------------------------
                      (    forth6809.asm):02429         
                      (    forth6809.asm):02430         ; ------------------------------------------------------------
                      (    forth6809.asm):02431         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02432         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02433         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02434         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02435         ; value would never actually have left.
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
C1B1                  (    forth6809.asm):02437         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02438         
                      (    forth6809.asm):02439                  LDD   #TSTGUARD
                      (    forth6809.asm):02440                  PSHU  D
                      (    forth6809.asm):02441                  LDD   #TSTVAL1
                      (    forth6809.asm):02442                  PSHU  D
                      (    forth6809.asm):02443                  STU   TSTUB4
                      (    forth6809.asm):02444         
                      (    forth6809.asm):02445                  JSR   TOR
                      (    forth6809.asm):02446         

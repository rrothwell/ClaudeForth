E1EB C600             (    forth6809.asm):03080                     LDB   #0
                      (    forth6809.asm):03081         
E1ED 108C0000         (    forth6809.asm):03082         SCANLP:     CMPY  #0
E1F1 2715             (    forth6809.asm):03083                     BEQ   ENDW
E1F3 A684             (    forth6809.asm):03084                     LDA   ,X
E1F5 9114             (    forth6809.asm):03085                     CMPA  DELIM
E1F7 270B             (    forth6809.asm):03086                     BEQ   CONSUME

                      (    forth6809.asm):00962         ; ------------------------------------------------------------
                      (    forth6809.asm):00963         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):00964         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):00965         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):00966         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):00967         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):00968         ; that the call returned.
                      (    forth6809.asm):00969         ; ------------------------------------------------------------
C1CA FF021B           (    forth6809.asm):00970         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):00971         
C1CD CC3C7A           (    forth6809.asm):00972                  LDD   #TSTGUARD
C1D0 3606             (    forth6809.asm):00973                  PSHU  D
C1D2 CC0041           (    forth6809.asm):00974                  LDD   #65
C1D5 3606             (    forth6809.asm):00975                  PSHU  D
C1D7 FF021D           (    forth6809.asm):00976                  STU   TSTUB4
                      (    forth6809.asm):00977         
C1DA BDE631           (    forth6809.asm):00978                  JSR   EMIT
                      (    forth6809.asm):00979         
C1DD FF021F           (    forth6809.asm):00980                  STU   TSTUAF
                      (    forth6809.asm):00981         
C1E0 963C             (    forth6809.asm):00982                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):00983                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):00984                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):00985                                 ; different implementations, gated the same way
                      (    forth6809.asm):00986                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):00987                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):00988                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):00989                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):00990                                 ; always failed despite the character genuinely
                      (    forth6809.asm):00991                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):00992                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):00993                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):00994                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):00995                                 ; - checking it verifies the argument was
                      (    forth6809.asm):00996                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):00997                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):00998                                 ; conditional needed.
C1E2 8141             (    forth6809.asm):00999                  CMPA  #65
C1E4 2619             (    forth6809.asm):01000                  BNE   EMFAIL
                      (    forth6809.asm):01001         
C1E6 3706             (    forth6809.asm):01002                  PULU  D
C1E8 10833C7A         (    forth6809.asm):01003                  CMPD  #TSTGUARD
C1EC 2611             (    forth6809.asm):01004                  BNE   EMFAIL
                      (    forth6809.asm):01005         
C1EE FC021D           (    forth6809.asm):01006                  LDD   TSTUB4
C1F1 B3021F           (    forth6809.asm):01007                  SUBD  TSTUAF
C1F4 1083FFFE         (    forth6809.asm):01008                  CMPD  #-2
C1F8 2605             (    forth6809.asm):01009                  BNE   EMFAIL
                      (    forth6809.asm):01010         
C1FA CCFFFF           (    forth6809.asm):01011                  LDD   #TRUEV
C1FD 2003             (    forth6809.asm):01012                  BRA   EMDONE
C1FF CC0000           (    forth6809.asm):01013         EMFAIL:  LDD   #FALSEV
C202 8EC210           (    forth6809.asm):01014         EMDONE:  LDX   #TSTEMITNAME
C205 3610             (    forth6809.asm):01015                  PSHU  X
C207 3606             (    forth6809.asm):01016                  PSHU  D
C209 BDC100           (    forth6809.asm):01017                  JSR   TSTREPORT
                      (    forth6809.asm):01018         
C20C FE021B           (    forth6809.asm):01019                  LDU   TSTU0
C20F 39               (    forth6809.asm):01020                  RTS
                      (    forth6809.asm):01021         
C210 07               (    forth6809.asm):01022         TSTEMITNAME: FCB  7
C211 545354454D4954   (    forth6809.asm):01023                      FCC  "TSTEMIT"
                      (    forth6809.asm):01024         

                      (    forth6809.asm):03265         ; Convert digits at NADDR into UDHI:UDLO, in BASE, until NCNT
                      (    forth6809.asm):03266         ; characters are used or a non-digit is reached.
                      (    forth6809.asm):03267         ; NUMLOOP
                      (    forth6809.asm):03268         ;    Inputs:
                      (    forth6809.asm):03269         ;        NADDR = address of the first character
                      (    forth6809.asm):03270         ;        NCNT = number of characters
                      (    forth6809.asm):03271         ;        UDHI:UDLO = initial value
                      (    forth6809.asm):03272         ;    Outputs:
                      (    forth6809.asm):03273         ;        UDHI:UDLO = accumulated value
                      (    forth6809.asm):03274         ;        NADDR, NCNT = first unconverted character and the count
                      (    forth6809.asm):03275         ;        remaining

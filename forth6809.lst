                      (    forth6809.asm):07481         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07482         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07483         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07484         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07485         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07486         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07487         ; division.
                      (    forth6809.asm):07488         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):07489         ; ------------------------------------------------------------

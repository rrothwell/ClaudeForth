                      (    forth6809.asm):00772         
                      (    forth6809.asm):00773         ; ------------------------------------------------------------
                      (    forth6809.asm):00774         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00775         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00776         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00777         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00778         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00779         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00780         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00781         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00782         ;
                      (    forth6809.asm):00783         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00784         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00785         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00786         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00787         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00788         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00789         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00790         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00791         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00792         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00793         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00794         ; ------------------------------------------------------------
                      (    forth6809.asm):00795                  ORG   $0100
0100                  (    forth6809.asm):00796         MVCNT    RMB   2
0102                  (    forth6809.asm):00797         MVDST    RMB   2
0104                  (    forth6809.asm):00798         MVSRC    RMB   2
     0100             (    forth6809.asm):00799         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00800         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00801         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00802         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00803         
                      (    forth6809.asm):00804         ; ------------------------------------------------------------
                      (    forth6809.asm):00805         ; Ring buffers for serial communications.
                      (    forth6809.asm):00806         ; One for input, one for output.
                      (    forth6809.asm):00807         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00808         ; The tricks are not used.
                      (    forth6809.asm):00809         ; ------------------------------------------------------------
                      (    forth6809.asm):00810                     ORG   SERBUFCTL    ; $176.
                      (    forth6809.asm):00811         
0176                  (    forth6809.asm):00812         INHEAD      RMB  1
0177                  (    forth6809.asm):00813         INTAIL      RMB  1
                      (    forth6809.asm):00814         ; RTSSTATE -> INREQUEST ?
0178                  (    forth6809.asm):00815         RTSSTATE   RMB  1  ; $00 = RTS Low (Clear), $FF = RTS High (Throttle) 
                      (    forth6809.asm):00816         
0179                  (    forth6809.asm):00817         OUTHEAD     RMB  1
017A                  (    forth6809.asm):00818         OUTTAIL     RMB  1
017B                  (    forth6809.asm):00819         OUTACTIVITY RMB  1  ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00820         
017C                  (    forth6809.asm):00821         FECOUNT     RMB  1  ; framing-error count, incremented by IRQH (interrupt
                      (    forth6809.asm):00822                             ; build) or by polling KEY (polling build - see below)
017D                  (    forth6809.asm):00823         OVRNCOUNT   RMB  1  ; overrun count, same as above
017E                  (    forth6809.asm):00824         PECOUNT     RMB  1  ; parity-error count, same as above
017F                  (    forth6809.asm):00825         POLLREADYCNT RMB 1  ; polling build only: counts every KEY call that found
                      (    forth6809.asm):00826                             ; RDRF already set on its very first check, before
                      (    forth6809.asm):00827                             ; spinning at all - i.e. a character was already
                      (    forth6809.asm):00828                             ; sitting queued when we came back to poll for it.
                      (    forth6809.asm):00829                             ; A high count relative to total characters received
                      (    forth6809.asm):00830                             ; is evidence the host is running ahead of what the
                      (    forth6809.asm):00831                             ; 6809 has actually consumed (a transport-buffered
                      (    forth6809.asm):00832                             ; backlog), distinct from a genuine ACIA overrun
                      (    forth6809.asm):00833                             ; (which OVRNCOUNT would show instead) - last free
                      (    forth6809.asm):00834                             ; byte in this block, right before SERBUF's 64-byte
                      (    forth6809.asm):00835                             ; alignment at $0180.
                      (    forth6809.asm):00836         
                      (    forth6809.asm):00837                     ORG   SERBUF    ; $180, a 64 byte boundary.
                      (    forth6809.asm):00838         
                      (    forth6809.asm):00839                     ALIGN 64       ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00840         INBUF       RMB INBUFSZ     ; Receive circular queue buffer
                      (    forth6809.asm):00841         
                      (    forth6809.asm):00842                     ALIGN 64       ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00843         OUTBUF      RMB OUTBUFSZ    ; Transmit circular queue buffer
                      (    forth6809.asm):00844         
                      (    forth6809.asm):00845         ; ------------------------------------------------------------
                      (    forth6809.asm):00846         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00847         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00848         ; ------------------------------------------------------------
                      (    forth6809.asm):00849                  ORG USROMSTRT
                      (    forth6809.asm):00850         
                      (    forth6809.asm):00851                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00852         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00853                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00854                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00855                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00856                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00857                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00858                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00859                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00860                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00861                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00862                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00863                           ; choice is made, not what including it does.
                      (    forth6809.asm):00864                    ENDC
                      (    forth6809.asm):00865         
                      (    forth6809.asm):00866                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00867         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00868                    ENDC
                      (    forth6809.asm):00869         
                      (    forth6809.asm):00870                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00871         
                      (    forth6809.asm):00872         ; ------------------------------------------------------------
                      (    forth6809.asm):00873         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00874         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00875         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00876         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00877         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00878         ; ------------------------------------------------------------
                      (    forth6809.asm):00879                  INCLUDE unit_tests.asm
                      (    forth6809.asm):00880         
                      (    forth6809.asm):00881                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00882         
C100                  (    forth6809.asm):00883         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00884                  FILL $FF,BASEDICT-ROM

E121 39               (    forth6809.asm):02822                     RTS
                      (    forth6809.asm):02823         
                      (    forth6809.asm):02824         ; ------------------------------------------------------------
                      (    forth6809.asm):02825         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02826         ; Build a word that returns the address of a u-byte buffer reserved in
                      (    forth6809.asm):02827         ; the variable area.
                      (    forth6809.asm):02828         ; ------------------------------------------------------------
E122                  (    forth6809.asm):02829         BUFFERCOLONW:
E122 3706             (    forth6809.asm):02830                     PULU  D                 ; u
E124 DD2B             (    forth6809.asm):02831                     STD   MSCR2
E126 CC0000           (    forth6809.asm):02832                     LDD   #0
E129 3606             (    forth6809.asm):02833                     PSHU  D
E12B BDDF5A           (    forth6809.asm):02834                     JSR   HEADER
E12E CCDE94           (    forth6809.asm):02835                     LDD   #DODOES
E131 3606             (    forth6809.asm):02836                     PSHU  D
E133 BDEA85           (    forth6809.asm):02837                     JSR   CCALL
E136 CCDE9F           (    forth6809.asm):02838                     LDD   #DOESRT0
E139 3606             (    forth6809.asm):02839                     PSHU  D
E13B BDDF08           (    forth6809.asm):02840                     JSR   CODECOMMA
E13E DC0A             (    forth6809.asm):02841                     LDD   VARHERE
E140 3606             (    forth6809.asm):02842                     PSHU  D
E142 BDDF08           (    forth6809.asm):02843                     JSR   CODECOMMA
E145 DC2B             (    forth6809.asm):02844                     LDD   MSCR2

FFA4                  (    forth6809.asm):07328         COLDSTRT:
FFA4 1A50             (    forth6809.asm):07329                  ORCC  #$50
FFA6 10CEC000         (    forth6809.asm):07330                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):07331                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):07332                  CLRA
FFAE 1F8B             (    forth6809.asm):07333                  TFR   A,DP
                      (    forth6809.asm):07334         
FFB0 8E0000           (    forth6809.asm):07335                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):07336                  LDB   #0
FFB5 6F80             (    forth6809.asm):07337         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07338                  DECB
FFB8 26FB             (    forth6809.asm):07339                  BNE   CLRGLOB
                      (    forth6809.asm):07340         
FFBA BDDE25           (    forth6809.asm):07341                  JSR   INITSERIAL
                      (    forth6809.asm):07342         
FFBD 1CAF             (    forth6809.asm):07343                  ANDCC #$AF      ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07344                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07345                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07346                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07347                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07348                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07349                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07350                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07351                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07352                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07353                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07354                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07355                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07356                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07357                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07358                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07359                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07360                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07361                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07362                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07363                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07364                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07365                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07366                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07367                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07368                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07369                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07370                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07371                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07372                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07373                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07374                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07375                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07376                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07377                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07378                                  ; unused vectors).
                      (    forth6809.asm):07379         
                      (    forth6809.asm):07380                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07381                  JSR   TSTRUNNER
                      (    forth6809.asm):07382                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07383                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07384                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07385                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07386                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07387                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07388                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07389                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07390                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07391                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07392                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07393                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07394                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07395                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07396                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07397                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07398                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07399         
FFC2 7EDEEF           (    forth6809.asm):07400                  JMP   COLD
                      (    forth6809.asm):07401         
FFC5 1A50             (    forth6809.asm):07402         WARM:    ORCC  #$50
FFC7 4F               (    forth6809.asm):07403                  CLRA
FFC8 1F8B             (    forth6809.asm):07404                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07405                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07406                  LDS   #RP0
                      (    forth6809.asm):07407         
FFD1 BDDE25           (    forth6809.asm):07408                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07409                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07410                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07411                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07412                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07413                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07414                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07415                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07416                                         ; reported separately) left either side
                      (    forth6809.asm):07417                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07418                                         ; would previously have inherited it
                      (    forth6809.asm):07419                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07420                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07421                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07422                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07423                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07424                                         ; only once setup is complete.
                      (    forth6809.asm):07425         

                      (    forth6809.asm):03602                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03603                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03604                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03605                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03606                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03607                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03608                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03609                   ; high cell.
E42B 0D22             (    forth6809.asm):03610                   TST   NUMNEG
E42D 2718             (    forth6809.asm):03611                   BEQ   NQPOS32
E42F DC76             (    forth6809.asm):03612                   LDD   UDLO
E431 43               (    forth6809.asm):03613                   COMA
E432 53               (    forth6809.asm):03614                   COMB
E433 C30001           (    forth6809.asm):03615                   ADDD  #1
E436 DD76             (    forth6809.asm):03616                   STD   UDLO
E438 3401             (    forth6809.asm):03617                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03618                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03619                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03620                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03621                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03622                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03623                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03624                                      ; making the high-cell increment run
                      (    forth6809.asm):03625                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03626                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03627                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03628                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03629                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03630                                      ; matching "always increment" rather than
                      (    forth6809.asm):03631                                      ; "increment only on genuine carry".
E43A DC74             (    forth6809.asm):03632                   LDD   UDHI
E43C 43               (    forth6809.asm):03633                   COMA
E43D 53               (    forth6809.asm):03634                   COMB
E43E 3501             (    forth6809.asm):03635                   PULS  CC          ; restore the TRUE carry
E440 2403             (    forth6809.asm):03636                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03637                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03638                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03639                                      ; value was computed in D but never
                      (    forth6809.asm):03640                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03641                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03642                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03643                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03644                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03645                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03646                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03647                                      ; alone would have made this second,
                      (    forth6809.asm):03648                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03649                                      ; only past the "+1", never past the
                      (    forth6809.asm):03650                                      ; store itself - the store always runs,
                      (    forth6809.asm):03651                                      ; either way.

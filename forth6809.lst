                      (    forth6809.asm):04278         ; ------------------------------------------------------------
                      (    forth6809.asm):04279         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04280         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04281         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04282         ;    Inputs:
                      (    forth6809.asm):04283         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04284         ;    Outputs:
                      (    forth6809.asm):04285         ;        single number: n and -1
                      (    forth6809.asm):04286         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04287         ;        not a number: c-addr and 0
                      (    forth6809.asm):04288         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04289         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04290         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04291         ; NUMBERQ.6.
                      (    forth6809.asm):04292         ; ------------------------------------------------------------
D824 3710             (    forth6809.asm):04293         NUMBERQ:    PULU  X                 ; c-addr
D826 327D             (    forth6809.asm):04294                     LEAS  -3,S
D828 AFE4             (    forth6809.asm):04295                     STX   ,S
D82A E684             (    forth6809.asm):04296                     LDB   ,X
D82C 276D             (    forth6809.asm):04297                     BEQ   NQBAD
D82E 3001             (    forth6809.asm):04298                     LEAX  1,X
                      (    forth6809.asm):04299         
                      (    forth6809.asm):04300                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04301                     ; digit count. See shadow: NUMBERQ.1
D830 5A               (    forth6809.asm):04302                     DECB
D831 A685             (    forth6809.asm):04303                     LDA   B,X
D833 5C               (    forth6809.asm):04304                     INCB
D834 812E             (    forth6809.asm):04305                     CMPA  #'.'
D836 2603             (    forth6809.asm):04306                     BNE   NQNOSIGN
D838 5A               (    forth6809.asm):04307                     DECB
D839 2760             (    forth6809.asm):04308                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04309         
D83B 6F62             (    forth6809.asm):04310         NQNOSIGN:   CLR   2,S
D83D A684             (    forth6809.asm):04311                     LDA   ,X
D83F 812D             (    forth6809.asm):04312                     CMPA  #'-'
D841 2607             (    forth6809.asm):04313                     BNE   NQNOSIGN2
D843 6362             (    forth6809.asm):04314                     COM   2,S
D845 3001             (    forth6809.asm):04315                     LEAX  1,X
D847 5A               (    forth6809.asm):04316                     DECB
D848 2751             (    forth6809.asm):04317                     BEQ   NQBAD
                      (    forth6809.asm):04318         
D84A 108E0000         (    forth6809.asm):04319         NQNOSIGN2:  LDY   #0
D84E 3620             (    forth6809.asm):04320                     PSHU  Y                 ; ud low
D850 3620             (    forth6809.asm):04321                     PSHU  Y                 ; ud high
D852 3610             (    forth6809.asm):04322                     PSHU  X                 ; c-addr
D854 4F               (    forth6809.asm):04323                     CLRA

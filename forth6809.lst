E011 31               (    forth6809.asm):01665                  FCC   "1"
E012 E007             (    forth6809.asm):01666                  FDB   H_FIND
E014 FF00             (    forth6809.asm):01667                  FDB   ONEBODY
                      (    forth6809.asm):01668         
E016 02               (    forth6809.asm):01669         H_M1:    FCB   2
E017 2D31             (    forth6809.asm):01670                  FCC   "-1"
E019 E010             (    forth6809.asm):01671                  FDB   H_1
E01B FF06             (    forth6809.asm):01672                  FDB   MONEBODY
                      (    forth6809.asm):01673         
E01D 01               (    forth6809.asm):01674         H_2:     FCB   1
E01E 32               (    forth6809.asm):01675                  FCC   "2"
E01F E016             (    forth6809.asm):01676                  FDB   H_M1
E021 FF0C             (    forth6809.asm):01677                  FDB   TWOBODY
                      (    forth6809.asm):01678         
E023 02               (    forth6809.asm):01679         H_M2:    FCB   2
E024 2D32             (    forth6809.asm):01680                  FCC   "-2"
E026 E01D             (    forth6809.asm):01681                  FDB   H_2
E028 FF12             (    forth6809.asm):01682                  FDB   MTWOBODY
                      (    forth6809.asm):01683         
     E023             (    forth6809.asm):01684         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01685                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01686                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01687                                   ; were chained on after it; before that,
                      (    forth6809.asm):01688                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01689                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01690                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01691                                   ; before this one.
                      (    forth6809.asm):01692         
                      (    forth6809.asm):01693         ; Verify no collision with base code.
                      (    forth6809.asm):01694         ; Value should match ORG BASECODE
     E02A             (    forth6809.asm):01695         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01696         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01697         
                      (    forth6809.asm):01698         ; ============================================================
                      (    forth6809.asm):01699         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01700         ; ============================================================
                      (    forth6809.asm):01701                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01702                                        ; entirely - every routine from here through
                      (    forth6809.asm):01703                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01704                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01705                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01706                                        ; WARM message left the location counter,
                      (    forth6809.asm):01707                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01708                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01709                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01710         
                      (    forth6809.asm):01711         ; ------------------------------------------------------------
                      (    forth6809.asm):01712         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01713         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01714         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01715         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01716         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01717         ; ------------------------------------------------------------
E02A 8603             (    forth6809.asm):01718         INITSERIAL: LDA   #$03
E02C B7C008           (    forth6809.asm):01719                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01720                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01721                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01722                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01723                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01724                  ELSE  ; <<<<<>>>>>
E02F 8615             (    forth6809.asm):01725                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01726                  ENDC  ; <<<<<<<<<<
E031 B7C008           (    forth6809.asm):01727                  STA   ACIACR         ; was "STA ACIA" - same fix
E034 39               (    forth6809.asm):01728                  RTS
                      (    forth6809.asm):01729         
                      (    forth6809.asm):01730                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01731         ; ------------------------------------------------------------
                      (    forth6809.asm):01732         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01733         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01734         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01735         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01736         ; ------------------------------------------------------------

DF41 DD00             (    forth6809.asm):09996                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):09997                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):09998                                   ; that spans more than one line of input.
                      (    forth6809.asm):09999                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):10000                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):10001                                   ; correct, sole places STATE should change
                      (    forth6809.asm):10002                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):10003                                   ; reset was a third, redundant one that
                      (    forth6809.asm):10004                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):10005                                   ; every time QUERY read a new line,
                      (    forth6809.asm):10006                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):10007                                   ; been reached. A colon definition split
                      (    forth6809.asm):10008                                   ; across multiple lines would have every
                      (    forth6809.asm):10009                                   ; word on every line after the first
                      (    forth6809.asm):10010                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):10011                                   ; stack effect, executed) instead of
                      (    forth6809.asm):10012                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):10013                                   ; data stack instead of being compiled,
                      (    forth6809.asm):10014                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):10015                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):10016                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):10017                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):10018                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):10019                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):10020                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):10021                                   ; so this still correctly forces interpret
                      (    forth6809.asm):10022                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):10023                                   ; semantics call for it - just not on every
                      (    forth6809.asm):10024                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):10025                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):10026         

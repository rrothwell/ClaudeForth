EEF9 9103             (    forth6809.asm):08601                     CMPA  BASE+1
EEFB 2504             (    forth6809.asm):08602                     BLO   UDNEXT
EEFD 9003             (    forth6809.asm):08603                     SUBA  BASE+1
EEFF 6C43             (    forth6809.asm):08604                     INC   3,U
EF01 5A               (    forth6809.asm):08605         UDNEXT:     DECB
EF02 26EC             (    forth6809.asm):08606                     BNE   UDDLOOP
EF04 39               (    forth6809.asm):08607                     RTS
                      (    forth6809.asm):08608         
                      (    forth6809.asm):08609         ; ------------------------------------------------------------

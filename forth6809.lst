                      (    forth6809.asm):15081         ; ------------------------------------------------------------
                      (    forth6809.asm):15082         ; TSTEXCEPTION - exception handling tests (glossary section
                      (    forth6809.asm):15083         ; 3.15, 2 words, 4 tests since CATCH/THROW can only be
                      (    forth6809.asm):15084         ; meaningfully tested together - THROW's own effect is only
                      (    forth6809.asm):15085         ; observable through a CATCH that traps it). Already used
                      (    forth6809.asm):15086         ; extensively as this whole session's own error-testing
                      (    forth6809.asm):15087         ; mechanism throughout sections 3.8-3.14, so their correctness
                      (    forth6809.asm):15088         ; has substantial indirect evidence already; this section still
                      (    forth6809.asm):15089         ; gets its own, direct, dedicated tests.
                      (    forth6809.asm):15090         ;
                      (    forth6809.asm):15091         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15092         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15093         ; ABORT (unsafe to trigger directly - it resets the return
                      (    forth6809.asm):15094         ; stack, destroying this whole test framework's own call chain,
                      (    forth6809.asm):15095         ; per section 3.1's own established reasoning). Every THROW in
                      (    forth6809.asm):15096         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15097         ; active CATCH (via a dedicated internal helper, TSTTHROWHLP,
                      (    forth6809.asm):15098         ; that only ever gets invoked that way), or is a THROW(0) call -
                      (    forth6809.asm):15099         ; confirmed via THROW's own code to be a pure, unconditional
                      (    forth6809.asm):15100         ; no-op that never touches HANDLER or ABORT at all, so that one
                      (    forth6809.asm):15101         ; specific case is safe to call directly.
                      (    forth6809.asm):15102         ;
                      (    forth6809.asm):15103         ; TSTCATCHTHROW specifically verifies the two dummy values
                      (    forth6809.asm):15104         ; TSTTHROWHLP pushes before throwing are genuinely gone
                      (    forth6809.asm):15105         ; afterward, confirming CATCH's own documented "restores data
                      (    forth6809.asm):15106         ; stack depth... on either path" for real. TSTHANDLERSAVE
                      (    forth6809.asm):15107         ; verifies the HANDLER half of that same documented guarantee
                      (    forth6809.asm):15108         ; directly, by reading HANDLER itself before and after CATCH
                      (    forth6809.asm):15109         ; calls on both the success and throw paths, rather than only
                      (    forth6809.asm):15110         ; inferring it from stack-level behavior.
                      (    forth6809.asm):15111         ; ------------------------------------------------------------
C2EE BDFC2B           (    forth6809.asm):15112         TSTEXCEPTION: JSR CRW
C2F1 8EC302           (    forth6809.asm):15113                    LDX   #TSTEXCMSG
C2F4 3610             (    forth6809.asm):15114                    PSHU  X
C2F6 CC0006           (    forth6809.asm):15115                    LDD   #6
C2F9 3606             (    forth6809.asm):15116                    PSHU  D
C2FB BDF60B           (    forth6809.asm):15117                    JSR   TYPE
C2FE BDFC2B           (    forth6809.asm):15118                    JSR   CRW
                      (    forth6809.asm):15119         
                      (    forth6809.asm):15120                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15121         
                      (    forth6809.asm):15122                    JSR   TSTCATCHOK
                      (    forth6809.asm):15123                    JSR   TSTCATCHTHROW
                      (    forth6809.asm):15124                    JSR   TSTTHROWZERO
                      (    forth6809.asm):15125                    JSR   TSTHANDLERSAVE
                      (    forth6809.asm):15126         
                      (    forth6809.asm):15127                    ENDC ; <<<<
                      (    forth6809.asm):15128         
C301 39               (    forth6809.asm):15129                    RTS
                      (    forth6809.asm):15130         
C302 457863657074     (    forth6809.asm):15131         TSTEXCMSG: FCC "Except"
                      (    forth6809.asm):15132         
                      (    forth6809.asm):15133                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15134         
                      (    forth6809.asm):15135         ; ------------------------------------------------------------
                      (    forth6809.asm):15136         ; Exception Handling test harness (glossary section 3.15).
                      (    forth6809.asm):15137         ; CATCH/THROW have already been used extensively as this whole
                      (    forth6809.asm):15138         ; session's own error-testing mechanism throughout sections
                      (    forth6809.asm):15139         ; 3.8-3.14, so their correctness has substantial indirect
                      (    forth6809.asm):15140         ; evidence already - this section still gets its own, direct
                      (    forth6809.asm):15141         ; tests, matching the established practice of every section
                      (    forth6809.asm):15142         ; getting dedicated coverage rather than relying on incidental
                      (    forth6809.asm):15143         ; use elsewhere.
                      (    forth6809.asm):15144         ;
                      (    forth6809.asm):15145         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15146         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15147         ; ABORT (already established elsewhere in this session as unsafe
                      (    forth6809.asm):15148         ; to trigger directly - it resets the return stack, destroying
                      (    forth6809.asm):15149         ; this whole test framework's own call chain). Every THROW in
                      (    forth6809.asm):15150         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15151         ; active CATCH, or is a THROW(0) call - confirmed via CATCH's own
                      (    forth6809.asm):15152         ; code to be a pure no-op that never touches HANDLER or ABORT at
                      (    forth6809.asm):15153         ; all, so that specific case is safe to call directly.
                      (    forth6809.asm):15154         ; ------------------------------------------------------------
                      (    forth6809.asm):15155         
                      (    forth6809.asm):15156         ; ------------------------------------------------------------
                      (    forth6809.asm):15157         ; TSTCATCHOK - unit test for CATCH, success path. Wraps DUP (a
                      (    forth6809.asm):15158         ; genuine, real dictionary word, not a synthetic stand-in) and
                      (    forth6809.asm):15159         ; verifies both that DUP's own effect genuinely happened (the
                      (    forth6809.asm):15160         ; value really was duplicated) and that CATCH itself returns 0.
                      (    forth6809.asm):15161         ; ------------------------------------------------------------
C308                  (    forth6809.asm):15162         TSTCATCHOK: STU  TSTU0
                      (    forth6809.asm):15163         
                      (    forth6809.asm):15164                     LDD  #TSTGUARD

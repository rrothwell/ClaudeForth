                      (    forth6809.asm):02184         
                      (    forth6809.asm):02185         ; ============================================================
                      (    forth6809.asm):02186         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02187         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02188         ; ============================================================
                      (    forth6809.asm):02189         ; ------------------------------------------------------------
                      (    forth6809.asm):02190         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02191         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02192         ; LIT   ( -- x )
                      (    forth6809.asm):02193         ;    Inputs:
                      (    forth6809.asm):02194         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02195         ;    Outputs:
                      (    forth6809.asm):02196         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02197         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02198         ; ------------------------------------------------------------
DDDC 3510             (    forth6809.asm):02199         LIT:        PULS  X
DDDE EC81             (    forth6809.asm):02200                     LDD   ,X++
DDE0 3606             (    forth6809.asm):02201                     PSHU  D                 ; x
DDE2 3410             (    forth6809.asm):02202                     PSHS  X
DDE4 39               (    forth6809.asm):02203                     RTS
                      (    forth6809.asm):02204         
                      (    forth6809.asm):02205         ; ------------------------------------------------------------
                      (    forth6809.asm):02206         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02207         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02208         ; address.
                      (    forth6809.asm):02209         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        flag on the data stack
                      (    forth6809.asm):02212         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02213         ;    Outputs:
                      (    forth6809.asm):02214         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02215         ;        the offset
                      (    forth6809.asm):02216         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02217         ; ------------------------------------------------------------
DDE5 3706             (    forth6809.asm):02218         ZBRANCH:    PULU  D                 ; flag
DDE7 3510             (    forth6809.asm):02219                     PULS  X
DDE9 10830000         (    forth6809.asm):02220                     CMPD  #0
DDED 2607             (    forth6809.asm):02221                     BNE   ZSKIP
DDEF EC84             (    forth6809.asm):02222                     LDD   ,X
DDF1 308B             (    forth6809.asm):02223                     LEAX  D,X
DDF3 3410             (    forth6809.asm):02224                     PSHS  X
DDF5 39               (    forth6809.asm):02225                     RTS
DDF6 3002             (    forth6809.asm):02226         ZSKIP:      LEAX  2,X
DDF8 3410             (    forth6809.asm):02227                     PSHS  X
DDFA 39               (    forth6809.asm):02228                     RTS
                      (    forth6809.asm):02229         
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
                      (    forth6809.asm):02231         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02232         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02233         ; BRANCH
                      (    forth6809.asm):02234         ;    Inputs:
                      (    forth6809.asm):02235         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02236         ;    Outputs:
                      (    forth6809.asm):02237         ;        return address set to the branch target
                      (    forth6809.asm):02238         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02239         ; ------------------------------------------------------------
DDFB 3510             (    forth6809.asm):02240         BRANCH:     PULS  X
DDFD EC84             (    forth6809.asm):02241                     LDD   ,X
DDFF 308B             (    forth6809.asm):02242                     LEAX  D,X
DE01 3410             (    forth6809.asm):02243                     PSHS  X
DE03 39               (    forth6809.asm):02244                     RTS
                      (    forth6809.asm):02245         
                      (    forth6809.asm):02246         ; ------------------------------------------------------------
                      (    forth6809.asm):02247         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02248         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02249         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02250         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02251         ;    Inputs:
                      (    forth6809.asm):02252         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02253         ;        trampoline
                      (    forth6809.asm):02254         ;    Outputs:
                      (    forth6809.asm):02255         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02256         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02257         ; ------------------------------------------------------------
DE04 3510             (    forth6809.asm):02258         DODOES:     PULS  X
DE06 10AE81           (    forth6809.asm):02259                     LDY   ,X++
DE09 EC84             (    forth6809.asm):02260                     LDD   ,X
DE0B 3606             (    forth6809.asm):02261                     PSHU  D                 ; pfa
DE0D 6EA4             (    forth6809.asm):02262                     JMP   ,Y
                      (    forth6809.asm):02263         
                      (    forth6809.asm):02264         ; ------------------------------------------------------------
                      (    forth6809.asm):02265         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02266         ; field address on the stack.
                      (    forth6809.asm):02267         ; DOESRT0
                      (    forth6809.asm):02268         ;    Inputs:
                      (    forth6809.asm):02269         ;        none
                      (    forth6809.asm):02270         ;    Outputs:
                      (    forth6809.asm):02271         ;        none
                      (    forth6809.asm):02272         ;    Registers: none.
                      (    forth6809.asm):02273         ; ------------------------------------------------------------
DE0F 39               (    forth6809.asm):02274         DOESRT0:    RTS
                      (    forth6809.asm):02275         
                      (    forth6809.asm):02276         ; ------------------------------------------------------------
                      (    forth6809.asm):02277         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02278         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02279         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02280         ; SETDOES
                      (    forth6809.asm):02281         ;    Inputs:
                      (    forth6809.asm):02282         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02283         ;        BEHAVIOR)
                      (    forth6809.asm):02284         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02285         ;        address
                      (    forth6809.asm):02286         ;    Outputs:
                      (    forth6809.asm):02287         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02288         ;        defining word's caller
                      (    forth6809.asm):02289         ;    Registers: RegD, RegX, CC, HDRFLAGS and DOESBEH changed.
                      (    forth6809.asm):02290         ; ------------------------------------------------------------
DE10 3510             (    forth6809.asm):02291         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DE12 9FFD             (    forth6809.asm):02292                     STX   DOESBEH
                      (    forth6809.asm):02293         
DE14 9E04             (    forth6809.asm):02294                     LDX   LATEST
DE16 A684             (    forth6809.asm):02295                     LDA   ,X
DE18 971E             (    forth6809.asm):02296                     STA   HDRFLAGS
DE1A 3001             (    forth6809.asm):02297                     LEAX  1,X
DE1C D61E             (    forth6809.asm):02298                     LDB   HDRFLAGS
DE1E C41F             (    forth6809.asm):02299                     ANDB  #$1F
DE20 4F               (    forth6809.asm):02300                     CLRA
DE21 308B             (    forth6809.asm):02301                     LEAX  D,X               ; skip name -> LINK field
DE23 3002             (    forth6809.asm):02302                     LEAX  2,X               ; skip LINK -> CFA field
DE25 EC84             (    forth6809.asm):02303                     LDD   ,X                ; D = CFA (trampoline address)
DE27 C30003           (    forth6809.asm):02304                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DE2A 1F01             (    forth6809.asm):02305                     TFR   D,X
                      (    forth6809.asm):02306         
DE2C DCFD             (    forth6809.asm):02307                     LDD   DOESBEH
DE2E ED84             (    forth6809.asm):02308                     STD   ,X                ; patch it
                      (    forth6809.asm):02309         
DE30 3510             (    forth6809.asm):02310                     PULS  X                 ; X = the OUTER defining word's own return addr
DE32 6E84             (    forth6809.asm):02311                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02312         
                      (    forth6809.asm):02313         ; ------------------------------------------------------------
                      (    forth6809.asm):02314         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02315         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02316         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02317         ;    Inputs:
                      (    forth6809.asm):02318         ;        pfa on the data stack
                      (    forth6809.asm):02319         ;    Outputs:
                      (    forth6809.asm):02320         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02321         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02322         ; ------------------------------------------------------------
DE34 3710             (    forth6809.asm):02323         DODEFER:    PULU  X                 ; pfa
DE36 EC84             (    forth6809.asm):02324                     LDD   ,X
DE38 1F01             (    forth6809.asm):02325                     TFR   D,X
DE3A 6E84             (    forth6809.asm):02326                     JMP   ,X
                      (    forth6809.asm):02327         
                      (    forth6809.asm):02328         ; ------------------------------------------------------------
                      (    forth6809.asm):02329         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02330         ; DOABORTUNDEF
                      (    forth6809.asm):02331         ;    Inputs:
                      (    forth6809.asm):02332         ;        none
                      (    forth6809.asm):02333         ;    Outputs:
                      (    forth6809.asm):02334         ;        none (does not return)
                      (    forth6809.asm):02335         ;    Registers: RegD changed.
                      (    forth6809.asm):02336         ; ------------------------------------------------------------
DE3C                  (    forth6809.asm):02337         DOABORTUNDEF:
DE3C CCFFEB           (    forth6809.asm):02338                     LDD   #-21
DE3F 3606             (    forth6809.asm):02339                     PSHU  D                 ; throw code (-21)
DE41 7EE4FF           (    forth6809.asm):02340                     JMP   THROWW
                      (    forth6809.asm):02341         
                      (    forth6809.asm):02342         ; ------------------------------------------------------------
                      (    forth6809.asm):02343         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02344         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02345         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02346         ;    Inputs:
                      (    forth6809.asm):02347         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02348         ;    Outputs:
                      (    forth6809.asm):02349         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02350         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02351         ; ------------------------------------------------------------
DE44 3710             (    forth6809.asm):02352         DOMARKER:   PULU  X                 ; pfa
DE46 EC84             (    forth6809.asm):02353                     LDD   ,X
DE48 DD06             (    forth6809.asm):02354                     STD   DPHERE
DE4A EC02             (    forth6809.asm):02355                     LDD   2,X
DE4C DD08             (    forth6809.asm):02356                     STD   CODEHERE
DE4E EC04             (    forth6809.asm):02357                     LDD   4,X
DE50 DD0A             (    forth6809.asm):02358                     STD   VARHERE
DE52 EC06             (    forth6809.asm):02359                     LDD   6,X
DE54 DD04             (    forth6809.asm):02360                     STD   LATEST
DE56 39               (    forth6809.asm):02361                     RTS
                      (    forth6809.asm):02362         
                      (    forth6809.asm):02363         ; ------------------------------------------------------------
                      (    forth6809.asm):02364         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02365         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02366         ; ------------------------------------------------------------
DE57 3710             (    forth6809.asm):02367         EXECUTEW:   PULU  X                 ; xt
DE59 AD84             (    forth6809.asm):02368                     JSR   ,X
DE5B 39               (    forth6809.asm):02369                     RTS
                      (    forth6809.asm):02370         
                      (    forth6809.asm):02371         ; ============================================================
                      (    forth6809.asm):02372         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02373         ; ============================================================
                      (    forth6809.asm):02374         ; ------------------------------------------------------------
                      (    forth6809.asm):02375         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02376         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02377         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02378         ;    Inputs:
                      (    forth6809.asm):02379         ;        RegX = address of the here pointer
                      (    forth6809.asm):02380         ;        x on the data stack
                      (    forth6809.asm):02381         ;    Outputs:
                      (    forth6809.asm):02382         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02383         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
DE5C 3706             (    forth6809.asm):02385         APPENDCELL: PULU  D                 ; x
DE5E 10AE84           (    forth6809.asm):02386                     LDY   ,X
DE61 EDA1             (    forth6809.asm):02387                     STD   ,Y++
DE63 10AF84           (    forth6809.asm):02388                     STY   ,X
DE66 39               (    forth6809.asm):02389                     RTS
                      (    forth6809.asm):02390         
                      (    forth6809.asm):02391         ; ------------------------------------------------------------
                      (    forth6809.asm):02392         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02393         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02394         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02395         ;    Inputs:
                      (    forth6809.asm):02396         ;        RegX = address of the here pointer
                      (    forth6809.asm):02397         ;        char on the data stack
                      (    forth6809.asm):02398         ;    Outputs:
                      (    forth6809.asm):02399         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02400         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02401         ; ------------------------------------------------------------
DE67 3706             (    forth6809.asm):02402         APPENDBYTE: PULU  D                 ; char
DE69 10AE84           (    forth6809.asm):02403                     LDY   ,X
DE6C E7A0             (    forth6809.asm):02404                     STB   ,Y+
DE6E 10AF84           (    forth6809.asm):02405                     STY   ,X
DE71 39               (    forth6809.asm):02406                     RTS
                      (    forth6809.asm):02407         
                      (    forth6809.asm):02408         ; ------------------------------------------------------------
                      (    forth6809.asm):02409         ; ,  ( x -- )
                      (    forth6809.asm):02410         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02411         ; ------------------------------------------------------------
DE72 8E0008           (    forth6809.asm):02412         COMMAW:     LDX   #CODEHERE
DE75 7EDE5C           (    forth6809.asm):02413                     JMP   APPENDCELL
                      (    forth6809.asm):02414         
                      (    forth6809.asm):02415         ; ------------------------------------------------------------
                      (    forth6809.asm):02416         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02417         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02418         ; ------------------------------------------------------------
DE78 8E0008           (    forth6809.asm):02419         CODECOMMA:  LDX   #CODEHERE
DE7B 7EDE5C           (    forth6809.asm):02420                     JMP   APPENDCELL
                      (    forth6809.asm):02421         
                      (    forth6809.asm):02422         ; ------------------------------------------------------------
                      (    forth6809.asm):02423         ; C,  ( char -- )
                      (    forth6809.asm):02424         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02425         ; ------------------------------------------------------------
DE7E 8E0008           (    forth6809.asm):02426         CCOMMAW:    LDX   #CODEHERE
DE81 7EDE67           (    forth6809.asm):02427                     JMP   APPENDBYTE
                      (    forth6809.asm):02428         
                      (    forth6809.asm):02429         ; ------------------------------------------------------------
                      (    forth6809.asm):02430         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02431         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02432         ; ------------------------------------------------------------
DE84 8E0008           (    forth6809.asm):02433         CCOMMA1:    LDX   #CODEHERE
DE87 7EDE67           (    forth6809.asm):02434                     JMP   APPENDBYTE
                      (    forth6809.asm):02435         
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
                      (    forth6809.asm):02437         ; V,  ( x -- )
                      (    forth6809.asm):02438         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02439         ; ------------------------------------------------------------
DE8A 8E000A           (    forth6809.asm):02440         VCOMMAW:    LDX   #VARHERE
DE8D 7EDE5C           (    forth6809.asm):02441                     JMP   APPENDCELL
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443         ; ------------------------------------------------------------
                      (    forth6809.asm):02444         ; VC,  ( char -- )
                      (    forth6809.asm):02445         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02446         ; ------------------------------------------------------------
DE90 8E000A           (    forth6809.asm):02447         VCCOMMAW:   LDX   #VARHERE
DE93 7EDE67           (    forth6809.asm):02448                     JMP   APPENDBYTE
                      (    forth6809.asm):02449         
                      (    forth6809.asm):02450         ; ------------------------------------------------------------
                      (    forth6809.asm):02451         ; ALLOT  ( n -- )
                      (    forth6809.asm):02452         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02453         ; ------------------------------------------------------------
DE96 3706             (    forth6809.asm):02454         ALLOTW:     PULU  D                 ; n
DE98 9E08             (    forth6809.asm):02455                     LDX   CODEHERE
DE9A 308B             (    forth6809.asm):02456                     LEAX  D,X
DE9C 9F08             (    forth6809.asm):02457                     STX   CODEHERE
DE9E 39               (    forth6809.asm):02458                     RTS
                      (    forth6809.asm):02459         
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
                      (    forth6809.asm):02461         ; VALLOT  ( n -- )
                      (    forth6809.asm):02462         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02463         ; ------------------------------------------------------------
DE9F 3706             (    forth6809.asm):02464         VALLOTW:    PULU  D                 ; n
DEA1 9E0A             (    forth6809.asm):02465                     LDX   VARHERE
DEA3 308B             (    forth6809.asm):02466                     LEAX  D,X
DEA5 9F0A             (    forth6809.asm):02467                     STX   VARHERE
DEA7 39               (    forth6809.asm):02468                     RTS
                      (    forth6809.asm):02469         
                      (    forth6809.asm):02470         ; ------------------------------------------------------------
                      (    forth6809.asm):02471         ; HERE  ( -- addr )
                      (    forth6809.asm):02472         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
DEA8 DC08             (    forth6809.asm):02474         HEREW:      LDD   CODEHERE
DEAA 3606             (    forth6809.asm):02475                     PSHU  D                 ; addr
DEAC 39               (    forth6809.asm):02476                     RTS
                      (    forth6809.asm):02477         
                      (    forth6809.asm):02478         ; ------------------------------------------------------------
                      (    forth6809.asm):02479         ; VHERE  ( -- addr )
                      (    forth6809.asm):02480         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02481         ; ------------------------------------------------------------
DEAD DC0A             (    forth6809.asm):02482         VHEREW:     LDD   VARHERE
DEAF 3606             (    forth6809.asm):02483                     PSHU  D                 ; addr
DEB1 39               (    forth6809.asm):02484                     RTS
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486         ; ------------------------------------------------------------
                      (    forth6809.asm):02487         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02488         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02489         ; ------------------------------------------------------------
DEB2 DC08             (    forth6809.asm):02490         PADW:       LDD   CODEHERE
DEB4 C30080           (    forth6809.asm):02491                     ADDD  #PADOFFSET
DEB7 3606             (    forth6809.asm):02492                     PSHU  D                 ; c-addr
DEB9 39               (    forth6809.asm):02493                     RTS
                      (    forth6809.asm):02494         
                      (    forth6809.asm):02495         ; ------------------------------------------------------------
                      (    forth6809.asm):02496         ; UNUSED  ( -- u )
                      (    forth6809.asm):02497         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
DEBA CCB900           (    forth6809.asm):02499         UNUSEDW:    LDD   #CODETOP
DEBD 9308             (    forth6809.asm):02500                     SUBD  CODEHERE
DEBF 3606             (    forth6809.asm):02501                     PSHU  D                 ; u
DEC1 39               (    forth6809.asm):02502                     RTS
                      (    forth6809.asm):02503         
                      (    forth6809.asm):02504         ; ------------------------------------------------------------
                      (    forth6809.asm):02505         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02506         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02507         ; ------------------------------------------------------------
DEC2 CC1FFF           (    forth6809.asm):02508         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DEC5 930A             (    forth6809.asm):02509                     SUBD  VARHERE
DEC7 3606             (    forth6809.asm):02510                     PSHU  D                 ; u
DEC9 39               (    forth6809.asm):02511                     RTS
                      (    forth6809.asm):02512         
                      (    forth6809.asm):02513         ; ============================================================
                      (    forth6809.asm):02514         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02515         ; ============================================================
                      (    forth6809.asm):02516         ; ------------------------------------------------------------
                      (    forth6809.asm):02517         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02518         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02519         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02520         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02521         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02522         ;    Inputs:
                      (    forth6809.asm):02523         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02524         ;        name parsed from the input stream
                      (    forth6809.asm):02525         ;    Outputs:
                      (    forth6809.asm):02526         ;        header built at DPHERE; LATEST and NEWHDR = address of the
                      (    forth6809.asm):02527         ;        new header
                      (    forth6809.asm):02528         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
DECA CC0020           (    forth6809.asm):02530         HEADER:     LDD   #32
DECD 3606             (    forth6809.asm):02531                     PSHU  D
DECF BDE1C3           (    forth6809.asm):02532                     JSR   WORDW
DED2 3710             (    forth6809.asm):02533                     PULU  X                 ; c-addr of the name
DED4 A684             (    forth6809.asm):02534                     LDA   ,X
DED6 9741             (    forth6809.asm):02535                     STA   NAMELEN
DED8 3001             (    forth6809.asm):02536                     LEAX  1,X
DEDA 9F3F             (    forth6809.asm):02537                     STX   NAMEP
                      (    forth6809.asm):02538         
DEDC 3706             (    forth6809.asm):02539                     PULU  D                 ; smudge flag
DEDE D74E             (    forth6809.asm):02540                     STB   HDRSMUDGE
                      (    forth6809.asm):02541         
DEE0 DC06             (    forth6809.asm):02542                     LDD   DPHERE
DEE2 DD3D             (    forth6809.asm):02543                     STD   NEWHDR
DEE4 9E06             (    forth6809.asm):02544                     LDX   DPHERE
DEE6 9641             (    forth6809.asm):02545                     LDA   NAMELEN
DEE8 0D4E             (    forth6809.asm):02546                     TST   HDRSMUDGE
DEEA 2702             (    forth6809.asm):02547                     BEQ   HDNOSM
DEEC 8A40             (    forth6809.asm):02548                     ORA   #$40
DEEE A780             (    forth6809.asm):02549         HDNOSM:     STA   ,X+
DEF0 109E3F           (    forth6809.asm):02550                     LDY   NAMEP
DEF3 D641             (    forth6809.asm):02551                     LDB   NAMELEN
DEF5 2707             (    forth6809.asm):02552                     BEQ   HDNONM
DEF7 A6A0             (    forth6809.asm):02553         HDCPY:      LDA   ,Y+
DEF9 A780             (    forth6809.asm):02554                     STA   ,X+
DEFB 5A               (    forth6809.asm):02555                     DECB
DEFC 26F9             (    forth6809.asm):02556                     BNE   HDCPY
DEFE DC04             (    forth6809.asm):02557         HDNONM:     LDD   LATEST
DF00 ED81             (    forth6809.asm):02558                     STD   ,X++
DF02 DC08             (    forth6809.asm):02559                     LDD   CODEHERE
DF04 ED81             (    forth6809.asm):02560                     STD   ,X++
DF06 9F06             (    forth6809.asm):02561                     STX   DPHERE
DF08 DC3D             (    forth6809.asm):02562                     LDD   NEWHDR
DF0A DD04             (    forth6809.asm):02563                     STD   LATEST
DF0C 39               (    forth6809.asm):02564                     RTS
                      (    forth6809.asm):02565         
                      (    forth6809.asm):02566         ; ============================================================
                      (    forth6809.asm):02567         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02568         ; ============================================================
                      (    forth6809.asm):02569         ; ------------------------------------------------------------
                      (    forth6809.asm):02570         ; :  ( "name" -- )
                      (    forth6809.asm):02571         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02572         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02573         ; CSP and enter compile state.
                      (    forth6809.asm):02574         ; ------------------------------------------------------------
DF0D CCFFFF           (    forth6809.asm):02575         COLONW:     LDD   #TRUEV
DF10 3606             (    forth6809.asm):02576                     PSHU  D
DF12 BDDECA           (    forth6809.asm):02577                     JSR   HEADER
DF15 DC08             (    forth6809.asm):02578                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DF17 DD3D             (    forth6809.asm):02579                     STD   CURXT             ; See bugfix: COLONW.1
DF19 1F30             (    forth6809.asm):02580                     TFR   U,D
DF1B DD48             (    forth6809.asm):02581                     STD   CSP
DF1D CCFFFF           (    forth6809.asm):02582                     LDD   #-1
DF20 DD00             (    forth6809.asm):02583                     STD   STATE
DF22 39               (    forth6809.asm):02584                     RTS
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586         ; ------------------------------------------------------------
                      (    forth6809.asm):02587         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02588         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02589         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02590         ; new word and return to interpret state.
                      (    forth6809.asm):02591         ; ------------------------------------------------------------
DF23 CC0039           (    forth6809.asm):02592         SEMIW:      LDD   #RTSOPC
DF26 3606             (    forth6809.asm):02593                     PSHU  D
DF28 BDDE84           (    forth6809.asm):02594                     JSR   CCOMMA1
DF2B 1F30             (    forth6809.asm):02595                     TFR   U,D
DF2D 109348           (    forth6809.asm):02596                     CMPD  CSP
DF30 2703             (    forth6809.asm):02597                     BEQ   SEMIOK
DF32 BDE4CA           (    forth6809.asm):02598                     JSR   CFERR
DF35 9E04             (    forth6809.asm):02599         SEMIOK:     LDX   LATEST
DF37 A684             (    forth6809.asm):02600                     LDA   ,X
DF39 84BF             (    forth6809.asm):02601                     ANDA  #$BF
DF3B A784             (    forth6809.asm):02602                     STA   ,X
DF3D CC0000           (    forth6809.asm):02603                     LDD   #0
DF40 DD00             (    forth6809.asm):02604                     STD   STATE
DF42 39               (    forth6809.asm):02605                     RTS
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02609         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02610         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02611         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02612         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02613         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02614         ; ------------------------------------------------------------
DF43 DC08             (    forth6809.asm):02615         NONAMEW:    LDD   CODEHERE
DF45 3606             (    forth6809.asm):02616                     PSHU  D                 ; xt
DF47 DD3D             (    forth6809.asm):02617                     STD   CURXT             ; See bugfix: NONAMEW.1
DF49 1F30             (    forth6809.asm):02618                     TFR   U,D
DF4B DD48             (    forth6809.asm):02619                     STD   CSP
DF4D CCFFFF           (    forth6809.asm):02620                     LDD   #-1
DF50 DD00             (    forth6809.asm):02621                     STD   STATE
DF52 39               (    forth6809.asm):02622                     RTS
                      (    forth6809.asm):02623         
                      (    forth6809.asm):02624         ; ------------------------------------------------------------
                      (    forth6809.asm):02625         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02626         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02627         ; BLDDOES
                      (    forth6809.asm):02628         ;    Inputs:
                      (    forth6809.asm):02629         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02630         ;    Outputs:
                      (    forth6809.asm):02631         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02632         ;    Registers: all changed.
                      (    forth6809.asm):02633         ; BLDSELF
                      (    forth6809.asm):02634         ;    Inputs:
                      (    forth6809.asm):02635         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02636         ;    Outputs:
                      (    forth6809.asm):02637         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02638         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02639         ;    Registers: all changed.
                      (    forth6809.asm):02640         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02641         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02642         ; ------------------------------------------------------------
DF53 3406             (    forth6809.asm):02643         BLDDOES:    PSHS  D                 ; behaviour address
DF55 CC0000           (    forth6809.asm):02644                     LDD   #0
DF58 3606             (    forth6809.asm):02645                     PSHU  D
DF5A BDDECA           (    forth6809.asm):02646                     JSR   HEADER
DF5D CCDE04           (    forth6809.asm):02647                     LDD   #DODOES
DF60 3606             (    forth6809.asm):02648                     PSHU  D
DF62 BDE97A           (    forth6809.asm):02649                     JSR   CCALL
DF65 3506             (    forth6809.asm):02650                     PULS  D
DF67 3606             (    forth6809.asm):02651                     PSHU  D                 ; behaviour address
DF69 BDDE78           (    forth6809.asm):02652                     JSR   CODECOMMA
DF6C 39               (    forth6809.asm):02653                     RTS
                      (    forth6809.asm):02654         
DF6D BDDF53           (    forth6809.asm):02655         BLDSELF:    JSR   BLDDOES
DF70 DC08             (    forth6809.asm):02656                     LDD   CODEHERE          ; PFA = the cell after this one
DF72 C30002           (    forth6809.asm):02657                     ADDD  #2                ; See bugfix: CONSTANTW.1
DF75 3606             (    forth6809.asm):02658                     PSHU  D
DF77 BDDE78           (    forth6809.asm):02659                     JSR   CODECOMMA
DF7A 39               (    forth6809.asm):02660                     RTS
                      (    forth6809.asm):02661         
                      (    forth6809.asm):02662         ; ------------------------------------------------------------
                      (    forth6809.asm):02663         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02664         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02665         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02666         ; address in the code area, on the stack.
                      (    forth6809.asm):02667         ; ------------------------------------------------------------
DF7B CCDE0F           (    forth6809.asm):02668         CREATEW:    LDD   #DOESRT0
DF7E BDDF6D           (    forth6809.asm):02669                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DF81 39               (    forth6809.asm):02670                     RTS
                      (    forth6809.asm):02671         
                      (    forth6809.asm):02672         ; ------------------------------------------------------------
                      (    forth6809.asm):02673         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02674         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02675         ; of the word being defined.
                      (    forth6809.asm):02676         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02677         ; ------------------------------------------------------------
DF82 CCDE10           (    forth6809.asm):02678         DOESGTW:    LDD   #SETDOES
DF85 3606             (    forth6809.asm):02679                     PSHU  D
DF87 BDE97A           (    forth6809.asm):02680                     JSR   CCALL
DF8A 39               (    forth6809.asm):02681                     RTS
                      (    forth6809.asm):02682         
                      (    forth6809.asm):02683         ; ------------------------------------------------------------
                      (    forth6809.asm):02684         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02685         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02686         ; area, initialised to zero.
                      (    forth6809.asm):02687         ; ------------------------------------------------------------
DF8B CC0000           (    forth6809.asm):02688         VARIABLEW:  LDD   #0
DF8E 3606             (    forth6809.asm):02689                     PSHU  D
DF90 BDDECA           (    forth6809.asm):02690                     JSR   HEADER
DF93 CCDE04           (    forth6809.asm):02691                     LDD   #DODOES
DF96 3606             (    forth6809.asm):02692                     PSHU  D
DF98 BDE97A           (    forth6809.asm):02693                     JSR   CCALL
DF9B CCDE0F           (    forth6809.asm):02694                     LDD   #DOESRT0
DF9E 3606             (    forth6809.asm):02695                     PSHU  D
DFA0 BDDE78           (    forth6809.asm):02696                     JSR   CODECOMMA
DFA3 DC0A             (    forth6809.asm):02697                     LDD   VARHERE
DFA5 3606             (    forth6809.asm):02698                     PSHU  D
DFA7 BDDE78           (    forth6809.asm):02699                     JSR   CODECOMMA
DFAA CC0000           (    forth6809.asm):02700                     LDD   #0
DFAD 9E0A             (    forth6809.asm):02701                     LDX   VARHERE
DFAF ED81             (    forth6809.asm):02702                     STD   ,X++
DFB1 9F0A             (    forth6809.asm):02703                     STX   VARHERE
DFB3 39               (    forth6809.asm):02704                     RTS
                      (    forth6809.asm):02705         
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; @  ( a-addr -- x )
                      (    forth6809.asm):02708         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
DFB4 3710             (    forth6809.asm):02710         FETCHW:     PULU  X                 ; a-addr
DFB6 EC84             (    forth6809.asm):02711                     LDD   ,X
DFB8 3606             (    forth6809.asm):02712                     PSHU  D                 ; x
DFBA 39               (    forth6809.asm):02713                     RTS
                      (    forth6809.asm):02714         
                      (    forth6809.asm):02715         ; ------------------------------------------------------------
                      (    forth6809.asm):02716         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02717         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02718         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
DFBB CCDFB4           (    forth6809.asm):02720         CONSTANTW:  LDD   #FETCHW
DFBE BDDF6D           (    forth6809.asm):02721                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DFC1 BDDE72           (    forth6809.asm):02722                     JSR   COMMAW
DFC4 39               (    forth6809.asm):02723                     RTS
                      (    forth6809.asm):02724         
                      (    forth6809.asm):02725         ; ------------------------------------------------------------
                      (    forth6809.asm):02726         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02727         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02728         ;    Inputs:
                      (    forth6809.asm):02729         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02730         ;    Outputs:
                      (    forth6809.asm):02731         ;        pfa replaced by the value
                      (    forth6809.asm):02732         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
DFC5 3710             (    forth6809.asm):02734         DOVALUE:    PULU  X                 ; pfa
DFC7 EC84             (    forth6809.asm):02735                     LDD   ,X
DFC9 3606             (    forth6809.asm):02736                     PSHU  D                 ; x
DFCB 39               (    forth6809.asm):02737                     RTS
                      (    forth6809.asm):02738         
                      (    forth6809.asm):02739         ; ------------------------------------------------------------
                      (    forth6809.asm):02740         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02741         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02742         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02743         ; ------------------------------------------------------------
DFCC CCDFC5           (    forth6809.asm):02744         VALUEW:     LDD   #DOVALUE
DFCF BDDF53           (    forth6809.asm):02745                     JSR   BLDDOES
DFD2 DC0A             (    forth6809.asm):02746                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DFD4 3606             (    forth6809.asm):02747                     PSHU  D                 ; See bugfix: VALUEW.1
DFD6 BDDE78           (    forth6809.asm):02748                     JSR   CODECOMMA
DFD9 BDDE8A           (    forth6809.asm):02749                     JSR   VCOMMAW           ; store x in the variable area
DFDC 39               (    forth6809.asm):02750                     RTS
                      (    forth6809.asm):02751         
                      (    forth6809.asm):02752         ; ------------------------------------------------------------
                      (    forth6809.asm):02753         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02754         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02755         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02756         ; ------------------------------------------------------------
DFDD CC0020           (    forth6809.asm):02757         TOW:        LDD   #32
DFE0 3606             (    forth6809.asm):02758                     PSHU  D
DFE2 BDE1C3           (    forth6809.asm):02759                     JSR   WORDW
DFE5 BDE22F           (    forth6809.asm):02760                     JSR   FINDW
DFE8 3706             (    forth6809.asm):02761                     PULU  D
DFEA 10830000         (    forth6809.asm):02762                     CMPD  #0
DFEE 260A             (    forth6809.asm):02763                     BNE   TOFOUND
DFF0 3706             (    forth6809.asm):02764                     PULU  D
DFF2 CCFFF3           (    forth6809.asm):02765                     LDD   #-13
DFF5 3606             (    forth6809.asm):02766                     PSHU  D
DFF7 BDE4FF           (    forth6809.asm):02767                     JSR   THROWW
DFFA BDEA2C           (    forth6809.asm):02768         TOFOUND:    JSR   TOBODYW
DFFD DC00             (    forth6809.asm):02769                     LDD   STATE
DFFF 270C             (    forth6809.asm):02770                     BEQ   TOIMMED
E001 BDE987           (    forth6809.asm):02771                     JSR   LITERALW
E004 CCF2CF           (    forth6809.asm):02772                     LDD   #STOREW
E007 3606             (    forth6809.asm):02773                     PSHU  D
E009 BDE97A           (    forth6809.asm):02774                     JSR   CCALL
E00C 39               (    forth6809.asm):02775                     RTS
E00D 3710             (    forth6809.asm):02776         TOIMMED:    PULU  X                 ; a-addr of the value cell
E00F 3706             (    forth6809.asm):02777                     PULU  D                 ; x
E011 ED84             (    forth6809.asm):02778                     STD   ,X
E013 39               (    forth6809.asm):02779                     RTS
                      (    forth6809.asm):02780         
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
                      (    forth6809.asm):02782         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02783         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02784         ; the variable area, initialised to zero.
                      (    forth6809.asm):02785         ; ------------------------------------------------------------
E014                  (    forth6809.asm):02786         TWOVARIABLEW:
E014 CC0000           (    forth6809.asm):02787                     LDD   #0
E017 3606             (    forth6809.asm):02788                     PSHU  D
E019 BDDECA           (    forth6809.asm):02789                     JSR   HEADER
E01C CCDE04           (    forth6809.asm):02790                     LDD   #DODOES
E01F 3606             (    forth6809.asm):02791                     PSHU  D
E021 BDE97A           (    forth6809.asm):02792                     JSR   CCALL
E024 CCDE0F           (    forth6809.asm):02793                     LDD   #DOESRT0
E027 3606             (    forth6809.asm):02794                     PSHU  D
E029 BDDE78           (    forth6809.asm):02795                     JSR   CODECOMMA
E02C DC0A             (    forth6809.asm):02796                     LDD   VARHERE
E02E 3606             (    forth6809.asm):02797                     PSHU  D
E030 BDDE78           (    forth6809.asm):02798                     JSR   CODECOMMA
E033 CC0000           (    forth6809.asm):02799                     LDD   #0
E036 9E0A             (    forth6809.asm):02800                     LDX   VARHERE
E038 ED81             (    forth6809.asm):02801                     STD   ,X++
E03A ED81             (    forth6809.asm):02802                     STD   ,X++
E03C 9F0A             (    forth6809.asm):02803                     STX   VARHERE
E03E 39               (    forth6809.asm):02804                     RTS
                      (    forth6809.asm):02805         
                      (    forth6809.asm):02806         ; ------------------------------------------------------------
                      (    forth6809.asm):02807         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02808         ; Build a word that returns x1 x2. The pair is stored in the code area

E570 3001             (    forth6809.asm):03430                  LEAX  1,X
                      (    forth6809.asm):03431         
                      (    forth6809.asm):03432                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03433                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03434                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03435                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03436                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03437                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03438                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03439                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03440                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03441                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03442                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03443                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03444                  ; for it.
E572 D621             (    forth6809.asm):03445                  LDB   CNTREM
E574 5A               (    forth6809.asm):03446                  DECB
E575 A685             (    forth6809.asm):03447                  LDA   B,X
E577 812E             (    forth6809.asm):03448                  CMPA  #'.'
E579 2604             (    forth6809.asm):03449                  BNE   NQNOSIGN
E57B 0A21             (    forth6809.asm):03450                  DEC   CNTREM
E57D 2766             (    forth6809.asm):03451                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03452         
E57F 0F22             (    forth6809.asm):03453         NQNOSIGN: CLR   NUMNEG
E581 A684             (    forth6809.asm):03454                  LDA   ,X
E583 812D             (    forth6809.asm):03455                  CMPA  #'-'
E585 2608             (    forth6809.asm):03456                  BNE   NQNOSIGN2
E587 0322             (    forth6809.asm):03457                  COM   NUMNEG
E589 3001             (    forth6809.asm):03458                  LEAX  1,X
E58B 0A21             (    forth6809.asm):03459                  DEC   CNTREM
E58D 2756             (    forth6809.asm):03460                  BEQ   NQBAD
                      (    forth6809.asm):03461         
E58F 9F23             (    forth6809.asm):03462         NQNOSIGN2: STX  NADDR
E591 4F               (    forth6809.asm):03463                   CLRA
E592 D621             (    forth6809.asm):03464                   LDB   CNTREM
E594 DD25             (    forth6809.asm):03465                   STD   NCNT
E596 CC0000           (    forth6809.asm):03466                   LDD   #0
E599 DD74             (    forth6809.asm):03467                   STD   UDHI

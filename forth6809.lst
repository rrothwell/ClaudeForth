                      (    forth6809.asm):08245                    PSHU D
                      (    forth6809.asm):08246                    JSR  CCALL
                      (    forth6809.asm):08247         
                      (    forth6809.asm):08248                    LDD  #OPRTS
                      (    forth6809.asm):08249                    PSHU D
                      (    forth6809.asm):08250                    JSR  CCOMMA
                      (    forth6809.asm):08251         
                      (    forth6809.asm):08252                    LDD  TSTCSAV
                      (    forth6809.asm):08253                    STD  CODEHERE
                      (    forth6809.asm):08254                    LDD  TSTDSAV
                      (    forth6809.asm):08255                    STD  DPHERE
                      (    forth6809.asm):08256                    LDD  TSTVSAV
                      (    forth6809.asm):08257                    STD  VARHERE
                      (    forth6809.asm):08258                    LDD  TSTSASAV
                      (    forth6809.asm):08259                    STD  SRCADDR
                      (    forth6809.asm):08260                    LDD  TSTSLSAV
                      (    forth6809.asm):08261                    STD  SRCLEN
                      (    forth6809.asm):08262                    LDD  TSTTISAV
                      (    forth6809.asm):08263                    STD  TOIN
                      (    forth6809.asm):08264         
                      (    forth6809.asm):08265                    LDX  TSTDOESA  ; BUG FIX: was preceded by restoring LATEST
                      (    forth6809.asm):08266                                   ; to its real value here - but SETDOES
                      (    forth6809.asm):08267                                   ; (confirmed by reading its own code) reads
                      (    forth6809.asm):08268                                   ; LATEST directly to find which header to
                      (    forth6809.asm):08269                                   ; patch, so restoring it first meant SETDOES
                      (    forth6809.asm):08270                                   ; patched the real, wrong word instead of
                      (    forth6809.asm):08271                                   ; TESTWD, leaving TESTWD stuck on its
                      (    forth6809.asm):08272                                   ; original DOESRT0 placeholder. LATEST now
                      (    forth6809.asm):08273                                   ; stays pointed at TESTWD (this test's own
                      (    forth6809.asm):08274                                   ; fake header) until right after this call.
                      (    forth6809.asm):08275                    JSR  ,X
                      (    forth6809.asm):08276         
                      (    forth6809.asm):08277                    LDD  TSTLSAV
                      (    forth6809.asm):08278                    STD  LATEST
                      (    forth6809.asm):08279         
                      (    forth6809.asm):08280                    STU  TSTU0
                      (    forth6809.asm):08281         
                      (    forth6809.asm):08282                    LDD  #TSTGUARD
                      (    forth6809.asm):08283                    PSHU D
                      (    forth6809.asm):08284                    STU  TSTUB4
                      (    forth6809.asm):08285         

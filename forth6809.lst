FD79 FDC900050022     (    forth6809.asm):06725                  FDB   EN7,EN7L,HOLDMINSIZE  ; NEW: /HOLD was previously absent
                      (    forth6809.asm):06726                                      ; entirely (the top-of-file note calling
                      (    forth6809.asm):06727                                      ; out "/HOLD and /PAD... remain explicitly
                      (    forth6809.asm):06728                                      ; incomplete/absent" was accurate at the
                      (    forth6809.asm):06729                                      ; time). Answers HOLDMINSIZE (34), not the
                      (    forth6809.asm):06730                                      ; larger PADOFFSET (84) - HOLDMINSIZE is
                      (    forth6809.asm):06731                                      ; specifically the portion of the
                      (    forth6809.asm):06732                                      ; CODEHERE-to-PAD gap reserved for the
                      (    forth6809.asm):06733                                      ; pictured numeric output buffer, the same
                      (    forth6809.asm):06734                                      ; amount WORDMAXCHARS deliberately holds
                      (    forth6809.asm):06735                                      ; back from WORD's own use at the other
                      (    forth6809.asm):06736                                      ; end of that same shared gap. PADOFFSET
                      (    forth6809.asm):06737                                      ; is the total gap width, most of which is
                      (    forth6809.asm):06738                                      ; actually earmarked for WORD's own
                      (    forth6809.asm):06739                                      ; parsing - reporting it here would
                      (    forth6809.asm):06740                                      ; overstate what HOLD can safely use
                      (    forth6809.asm):06741                                      ; without risking collision with whatever
                      (    forth6809.asm):06742                                      ; WORD is doing in the same space.
FD7F FDCE00040054     (    forth6809.asm):06743                  FDB   EN8,EN8L,PADMINSIZE  ; NEW: /PAD, the last of the two
                      (    forth6809.asm):06744                                      ; entries the top-of-file note originally
                      (    forth6809.asm):06745                                      ; flagged as absent - now both present.
                      (    forth6809.asm):06746                                      ; Answers PADMINSIZE (84) directly, per
                      (    forth6809.asm):06747                                      ; ANS's own /PAD meaning (3.3.3.6, "the
                      (    forth6809.asm):06748                                      ; size of the scratch area whose address
                      (    forth6809.asm):06749                                      ; is returned by PAD") - PAD's own region,
                      (    forth6809.asm):06750                                      ; growing upward from PAD itself, distinct
                      (    forth6809.asm):06751                                      ; from HOLDMINSIZE above (which answers
                      (    forth6809.asm):06752                                      ; for a different region entirely, the
                      (    forth6809.asm):06753                                      ; downward-growing pictured-numeric buffer
                      (    forth6809.asm):06754                                      ; in the CODEHERE-to-PAD gap). PADOFFSET
                      (    forth6809.asm):06755                                      ; happens to equal PADMINSIZE numerically
                      (    forth6809.asm):06756                                      ; in this implementation (PADOFFSET EQU
                      (    forth6809.asm):06757                                      ; PADMINSIZE), but /PAD is answered with
                      (    forth6809.asm):06758                                      ; the conceptually correct constant, not
                      (    forth6809.asm):06759                                      ; the coincidentally-equal one.
FD85 FDD200070000     (    forth6809.asm):06760                  FDB   EN9,EN9L,0    ; NEW: FLOORED - previously the one item
                      (    forth6809.asm):06761                                      ; in this area explicitly left open
                      (    forth6809.asm):06762                                      ; pending its own investigation (unlike
                      (    forth6809.asm):06763                                      ; WORDLISTS, this is a CORE query, not
                      (    forth6809.asm):06764                                      ; tied to an unimplemented optional word
                      (    forth6809.asm):06765                                      ; set, so "false by omission" wasn't the
                      (    forth6809.asm):06766                                      ; right default). Investigated by tracing
                      (    forth6809.asm):06767                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):06768                                      ; against this system's own SM/REM and
                      (    forth6809.asm):06769                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):06770                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):06771                                      ; dividend's own original sign) after
                      (    forth6809.asm):06772                                      ; dividing absolute values - exactly
                      (    forth6809.asm):06773                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):06774                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):06775                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):06776                                      ; adjustment step (correcting the
                      (    forth6809.asm):06777                                      ; quotient and remainder when the
                      (    forth6809.asm):06778                                      ; quotient would be negative with a
                      (    forth6809.asm):06779                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):06780                                      ; not have. This system's primary
                      (    forth6809.asm):06781                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):06782                                      ; symmetric division, not floored -
                      (    forth6809.asm):06783                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):06784                                      ; answer (recognized query, value false),
                      (    forth6809.asm):06785                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):06786                                      ; WORDLISTS correctly uses.
FD8B FDD9000800FF     (    forth6809.asm):06787                  FDB   EN10,EN10L,255  ; NEW: MAX-CHAR - maximum value of any
                      (    forth6809.asm):06788                                      ; character in this implementation's
                      (    forth6809.asm):06789                                      ; character set (3.2.6). This system uses
                      (    forth6809.asm):06790                                      ; 8-bit characters throughout (matching
                      (    forth6809.asm):06791                                      ; ADDRESS-UNIT-BITS=8, already in this
                      (    forth6809.asm):06792                                      ; table) - a single byte's maximum value
                      (    forth6809.asm):06793                                      ; is 255.

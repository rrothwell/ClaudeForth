                      (    forth6809.asm):03514         
D55B 10830001         (    forth6809.asm):03515                     CMPD  #1                ; 1 = double-number result
D55F 2711             (    forth6809.asm):03516                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3

                      (    forth6809.asm):02281         
                      (    forth6809.asm):02282                     ; RTS is high (REJECT): CR_RTSHI hardware-disables the TX
                      (    forth6809.asm):02283                     ; interrupt, so nothing will ever drain OUTBUF except this
                      (    forth6809.asm):02284                     ; polling fallback. BUG FIX: FLUSHOUTBUFFER can take until
                      (    forth6809.asm):02285                     ; the whole OUTBUF drains (up to ~64 chars, ~5.5ms at 115200
                      (    forth6809.asm):02286                     ; baud) - running that under PUTCHAR's own ORCC #$50 masked
                      (    forth6809.asm):02287                     ; IRQ+FIRQ for the entire span, which is exactly why RTS

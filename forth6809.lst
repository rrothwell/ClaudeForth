                      (    forth6809.asm):03960                    STU   TSTUAF
                      (    forth6809.asm):03961         
                      (    forth6809.asm):03962                    PULU  D
                      (    forth6809.asm):03963                    CMPD  #$0060
                      (    forth6809.asm):03964                    BNE   ANFAIL
                      (    forth6809.asm):03965                    PULU  D
                      (    forth6809.asm):03966                    CMPD  #TSTGUARD
                      (    forth6809.asm):03967                    BNE   ANFAIL
                      (    forth6809.asm):03968         
                      (    forth6809.asm):03969                    LDD   TSTUB4
                      (    forth6809.asm):03970                    SUBD  TSTUAF
                      (    forth6809.asm):03971                    CMPD  #-2
                      (    forth6809.asm):03972                    BNE   ANFAIL
                      (    forth6809.asm):03973         
                      (    forth6809.asm):03974                    LDD   #TRUEV
                      (    forth6809.asm):03975                    BRA   ANDONE
C100                  (    forth6809.asm):03976         ANFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):03977         ANDONE:     LDX   #TSTANDNAME
                      (    forth6809.asm):03978                    PSHU  X
                      (    forth6809.asm):03979                    PSHU  D
                      (    forth6809.asm):03980                    JSR   TSTREPORT
                      (    forth6809.asm):03981         
                      (    forth6809.asm):03982                    LDU   TSTU0
                      (    forth6809.asm):03983                    RTS
                      (    forth6809.asm):03984         
C100                  (    forth6809.asm):03985         TSTANDNAME: FCB  6
                      (    forth6809.asm):03986                       FCC  "TSTAND"
                      (    forth6809.asm):03987         

                      (    forth6809.asm):01129                    LDD   #TSTVAL2
                      (    forth6809.asm):01130                    PSHU  D
                      (    forth6809.asm):01131                    LDD   #TSTVAL3
                      (    forth6809.asm):01132                    PSHU  D
                      (    forth6809.asm):01133                    STU   TSTUB4
                      (    forth6809.asm):01134         
                      (    forth6809.asm):01135                    JSR   DEPTH
                      (    forth6809.asm):01136         
                      (    forth6809.asm):01137                    STU   TSTUAF
                      (    forth6809.asm):01138         
                      (    forth6809.asm):01139                    LDD   #SP0
                      (    forth6809.asm):01140                    SUBD  TSTUB4
                      (    forth6809.asm):01141                    LSRA
                      (    forth6809.asm):01142                    RORB
                      (    forth6809.asm):01143                    STD   TSTSCR
                      (    forth6809.asm):01144         
                      (    forth6809.asm):01145                    PULU  D
                      (    forth6809.asm):01146                    CMPD  TSTSCR
                      (    forth6809.asm):01147                    BNE   DHFAIL
                      (    forth6809.asm):01148         
                      (    forth6809.asm):01149                    LDD   TSTUB4
                      (    forth6809.asm):01150                    SUBD  TSTUAF
                      (    forth6809.asm):01151                    CMPD  #2
                      (    forth6809.asm):01152                    BNE   DHFAIL
                      (    forth6809.asm):01153         
                      (    forth6809.asm):01154                    PULU  D
                      (    forth6809.asm):01155                    CMPD  #TSTVAL3
                      (    forth6809.asm):01156                    BNE   DHFAIL
                      (    forth6809.asm):01157                    PULU  D
                      (    forth6809.asm):01158                    CMPD  #TSTVAL2
                      (    forth6809.asm):01159                    BNE   DHFAIL
                      (    forth6809.asm):01160                    PULU  D
                      (    forth6809.asm):01161                    CMPD  #TSTVAL1
                      (    forth6809.asm):01162                    BNE   DHFAIL
                      (    forth6809.asm):01163         
                      (    forth6809.asm):01164                    LDD   #TRUEV
                      (    forth6809.asm):01165                    BRA   DHDONE
C15E                  (    forth6809.asm):01166         DHFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):01167         DHDONE:    LDX   #TSTDEPTHNAME
                      (    forth6809.asm):01168                    PSHU  X
                      (    forth6809.asm):01169                    PSHU  D
                      (    forth6809.asm):01170                    JSR   TSTREPORT
                      (    forth6809.asm):01171         
                      (    forth6809.asm):01172                    LDU   TSTU0
                      (    forth6809.asm):01173                    RTS
                      (    forth6809.asm):01174         
C15E                  (    forth6809.asm):01175         TSTDEPTHNAME: FCB  8
                      (    forth6809.asm):01176                       FCC  "TSTDEPTH"
                      (    forth6809.asm):01177         

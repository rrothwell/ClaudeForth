                      (    forth6809.asm):05319         ; EXIT  ( -- )
                      (    forth6809.asm):05320         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05321         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05322         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05323         ; ------------------------------------------------------------
DD20 108E0000         (    forth6809.asm):05324         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DD24 1F31             (    forth6809.asm):05325                     TFR   U,X               ; X = scan pointer
DD26 9C21             (    forth6809.asm):05326         EXSCAN:     CMPX  CSP
DD28 270E             (    forth6809.asm):05327                     BEQ   EXSCANDONE
DD2A EC84             (    forth6809.asm):05328                     LDD   ,X
DD2C 10830003         (    forth6809.asm):05329                     CMPD  #TAGDO
DD30 2602             (    forth6809.asm):05330                     BNE   EXNOTDO
DD32 3121             (    forth6809.asm):05331                     LEAY  1,Y
DD34 3004             (    forth6809.asm):05332         EXNOTDO:    LEAX  4,X
DD36 20EE             (    forth6809.asm):05333                     BRA   EXSCAN
DD38                  (    forth6809.asm):05334         EXSCANDONE:
DD38 3420             (    forth6809.asm):05335                     PSHS  Y                 ; the count survives CCALL on S
DD3A CCDD4A           (    forth6809.asm):05336                     LDD   #EXITUNLOOP
DD3D 3606             (    forth6809.asm):05337                     PSHU  D
DD3F BDDE2C           (    forth6809.asm):05338                     JSR   CCALL
DD42 3506             (    forth6809.asm):05339                     PULS  D
DD44 3606             (    forth6809.asm):05340                     PSHU  D
DD46 BDD0EA           (    forth6809.asm):05341                     JSR   CODECOMMA
DD49 39               (    forth6809.asm):05342                     RTS
                      (    forth6809.asm):05343         
                      (    forth6809.asm):05344         ; ------------------------------------------------------------
                      (    forth6809.asm):05345         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05346         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05347         ; EXITUNLOOP
                      (    forth6809.asm):05348         ;    Inputs:
                      (    forth6809.asm):05349         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05350         ;        address
                      (    forth6809.asm):05351         ;    Outputs:
                      (    forth6809.asm):05352         ;        returns to the caller of the definition
                      (    forth6809.asm):05353         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05354         ; ------------------------------------------------------------
DD4A 3510             (    forth6809.asm):05355         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DD4C 3520             (    forth6809.asm):05356                     PULS  Y                 ; Y = return address
DD4E 6EA4             (    forth6809.asm):05357                     JMP   ,Y

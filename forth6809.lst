                      (    forth6809.asm):07139         ; .bin file.
FF9B                  (    forth6809.asm):07140         BASEND:
FF9B FFFFFFFFFFFFFFFF (    forth6809.asm):07141                  FILL $FF,INITCODE-BASEND

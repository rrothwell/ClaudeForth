                      (    forth6809.asm):05450         ; SECTION 13: COMPILING WORDS (IMMEDIATE/[/]/'/COMPILE,/
                      (    forth6809.asm):05451         ; LITERAL/[']/POSTPONE/>BODY, SLITERAL, ABORT")
                      (    forth6809.asm):05452         ; ============================================================

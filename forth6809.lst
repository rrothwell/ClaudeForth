                      (    forth6809.asm):09467         
                      (    forth6809.asm):09468         ; ------------------------------------------------------------
                      (    forth6809.asm):09469         ; FALSE  ( -- flag )
                      (    forth6809.asm):09470         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):09471         ; ------------------------------------------------------------
F4C9 CC0000           (    forth6809.asm):09472         FALSEW:     LDD   #$0000
F4CC 3606             (    forth6809.asm):09473                     PSHU  D

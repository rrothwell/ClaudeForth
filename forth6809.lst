                      (    forth6809.asm):09806                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):09807                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):09808                                   ; before this one.
                      (    forth6809.asm):09809         
                      (    forth6809.asm):09810         ; Verify no collision with base code.

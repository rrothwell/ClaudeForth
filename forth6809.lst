                      (    forth6809.asm):09933                       PSHU D
                      (    forth6809.asm):09934                       LDD  #TSTVAL1
                      (    forth6809.asm):09935                       PSHU D
                      (    forth6809.asm):09936                       STU  TSTUB4
                      (    forth6809.asm):09937         

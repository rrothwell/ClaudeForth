                      (    forth6809.asm):20422                      ; "%...%" delimiters untouched in the output - and never
                      (    forth6809.asm):20423                      ; returned the substitution count ANS requires as a
                      (    forth6809.asm):20424                      ; third stack item. Per the ANS spec (forth-standard.org/
                      (    forth6809.asm):20425                      ; standard/string/SUBSTITUTE), SUBSTITUTE must scan for
                      (    forth6809.asm):20426                      ; text between '%' (ASCII $25) delimiter pairs
                      (    forth6809.asm):20427                      ; specifically: "%%" collapses to a single '%' (count
                      (    forth6809.asm):20428                      ; unchanged); a name matching the REPLACES registration

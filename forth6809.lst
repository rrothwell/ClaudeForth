DCCD 7F0179           (    forth6809.asm):01573                     CLR   OUTHEAD
DCD0 7F017A           (    forth6809.asm):01574                     CLR   OUTTAIL
DCD3 7F017B           (    forth6809.asm):01575                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01576         
                      (    forth6809.asm):01577         
DCD6 7F017C           (    forth6809.asm):01578                     CLR   FECOUNT
DCD9 7F017D           (    forth6809.asm):01579                     CLR   OVRNCOUNT
DCDC 7F017E           (    forth6809.asm):01580                     CLR   PECOUNT
DCDF 7F017F           (    forth6809.asm):01581                     CLR   POLLREADYCNT
DCE2 39               (    forth6809.asm):01582                     RTS
                      (    forth6809.asm):01583         
                      (    forth6809.asm):01584         ; ------------------------------------------------------------
                      (    forth6809.asm):01585         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01586         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01587         ; INITSERIAL
                      (    forth6809.asm):01588         ;    Inputs:
                      (    forth6809.asm):01589         ;        none
                      (    forth6809.asm):01590         ;    Outputs:
                      (    forth6809.asm):01591         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01592         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01593         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01594         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01595         ; ------------------------------------------------------------
DCE3 BDDCC4           (    forth6809.asm):01596         INITSERIAL: JSR   SERBUFCLR
DCE6 8603             (    forth6809.asm):01597                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
DCE8 B7C008           (    forth6809.asm):01598                     STA   ACIACR
DCEB 12               (    forth6809.asm):01599                     NOP                     ; Settling Delay
DCEC 12               (    forth6809.asm):01600                     NOP
                      (    forth6809.asm):01601         
                      (    forth6809.asm):01602                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
DCED 8695             (    forth6809.asm):01603                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01604                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):01605                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01606                     ENDC                    ; <<<<<<<<<<
DCEF B7C008           (    forth6809.asm):01607                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DCF2 39               (    forth6809.asm):01608                     RTS
                      (    forth6809.asm):01609         
                      (    forth6809.asm):01610                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01611         ; ------------------------------------------------------------
                      (    forth6809.asm):01612         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01613         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01614         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01615         ; INFILL
                      (    forth6809.asm):01616         ;    Inputs:
                      (    forth6809.asm):01617         ;        none
                      (    forth6809.asm):01618         ;    Outputs:
                      (    forth6809.asm):01619         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01620         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01621         ; ------------------------------------------------------------
DCF3 B60176           (    forth6809.asm):01622         INFILL:     LDA   INHEAD
DCF6 B00177           (    forth6809.asm):01623                     SUBA  INTAIL
DCF9 843F             (    forth6809.asm):01624                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DCFB 39               (    forth6809.asm):01625                     RTS
                      (    forth6809.asm):01626         ; ------------------------------------------------------------
                      (    forth6809.asm):01627         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01628         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01629         ; receive path with interrupts already masked.
                      (    forth6809.asm):01630         ; RTSCHECKHI
                      (    forth6809.asm):01631         ;    Inputs:
                      (    forth6809.asm):01632         ;        none
                      (    forth6809.asm):01633         ;    Outputs:
                      (    forth6809.asm):01634         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01635         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01636         ; ------------------------------------------------------------
DCFC BDDCF3           (    forth6809.asm):01637         RTSCHECKHI: JSR   INFILL
DCFF 8130             (    forth6809.asm):01638                     CMPA  #INHIWATER
DD01 250F             (    forth6809.asm):01639                     BLO   RTSCHIDONE
DD03 7D0178           (    forth6809.asm):01640                     TST   RTSSTATE
DD06 260A             (    forth6809.asm):01641                     BNE   RTSCHIDONE        ; already high - nothing to do
DD08 86D5             (    forth6809.asm):01642                     LDA   #CR_RTSHI
DD0A B7C008           (    forth6809.asm):01643                     STA   ACIACR
DD0D 8601             (    forth6809.asm):01644                     LDA   #1
DD0F B70178           (    forth6809.asm):01645                     STA   RTSSTATE
DD12 39               (    forth6809.asm):01646         RTSCHIDONE: RTS
                      (    forth6809.asm):01647         ; ------------------------------------------------------------
                      (    forth6809.asm):01648         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01649         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01650         ; enables it only while output is pending.
                      (    forth6809.asm):01651         ; UPDATE_RTS
                      (    forth6809.asm):01652         ;    Inputs:
                      (    forth6809.asm):01653         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01654         ;    Outputs:
                      (    forth6809.asm):01655         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01656         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01657         ; ------------------------------------------------------------
DD13                  (    forth6809.asm):01658         UPDATE_RTS:
DD13 7D0178           (    forth6809.asm):01659                     TST   RTSSTATE
DD16 260D             (    forth6809.asm):01660                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01661         
DD18 7D017B           (    forth6809.asm):01662                     TST   OUTACTIVITY       ; Is active?
DD1B 2704             (    forth6809.asm):01663                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01664         
                      (    forth6809.asm):01665                                             ; $B5/%1011_0101
DD1D 86B5             (    forth6809.asm):01666                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DD1F 2009             (    forth6809.asm):01667                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01668         
DD21                  (    forth6809.asm):01669         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DD21 8695             (    forth6809.asm):01670                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DD23 2005             (    forth6809.asm):01671                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01672         
DD25                  (    forth6809.asm):01673         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DD25 86D5             (    forth6809.asm):01674                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DD27 7F017B           (    forth6809.asm):01675                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DD2A                  (    forth6809.asm):01676         WRITE_CR:
DD2A B7C008           (    forth6809.asm):01677                     STA   ACIACR
DD2D 39               (    forth6809.asm):01678                     RTS
                      (    forth6809.asm):01679         ; ------------------------------------------------------------
                      (    forth6809.asm):01680         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01681         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01682         ; Called after a character is added to the ring.
                      (    forth6809.asm):01683         ; CHKHI
                      (    forth6809.asm):01684         ;    Inputs:
                      (    forth6809.asm):01685         ;        RegB = input ring fill level
                      (    forth6809.asm):01686         ;    Outputs:
                      (    forth6809.asm):01687         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01688         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01689         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01690         ; ------------------------------------------------------------
DD2E                  (    forth6809.asm):01691         CHKHI:
DD2E C130             (    forth6809.asm):01692                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DD30 250D             (    forth6809.asm):01693                     BLO   CHKHIDONE         ; No! Do nothing.
DD32 7D0178           (    forth6809.asm):01694                     TST   RTSSTATE
DD35 2608             (    forth6809.asm):01695                     BNE   CHKHIDONE         ; already high - nothing to do
DD37 86FF             (    forth6809.asm):01696                     LDA   #INREJECT         ; Yes! De-assert RTS.
DD39 B70178           (    forth6809.asm):01697                     STA   RTSSTATE
DD3C BDDD13           (    forth6809.asm):01698                     JSR   UPDATE_RTS
DD3F 39               (    forth6809.asm):01699         CHKHIDONE:  RTS
                      (    forth6809.asm):01700         
                      (    forth6809.asm):01701         ; ------------------------------------------------------------
                      (    forth6809.asm):01702         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01703         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01704         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01705         ; CHKLO
                      (    forth6809.asm):01706         ;    Inputs:
                      (    forth6809.asm):01707         ;        RegB = input ring fill level
                      (    forth6809.asm):01708         ;    Outputs:
                      (    forth6809.asm):01709         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01710         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01711         ; ------------------------------------------------------------
DD40                  (    forth6809.asm):01712         CHKLO:
DD40 C110             (    forth6809.asm):01713                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DD42 240D             (    forth6809.asm):01714                     BHS   CHKLODONE         ; No! Do nothing.
DD44 7D0178           (    forth6809.asm):01715                     TST   RTSSTATE
DD47 2708             (    forth6809.asm):01716                     BEQ   CHKLODONE         ; already low - nothing to do
DD49 8600             (    forth6809.asm):01717                     LDA   #INACCEPT         ; Yes! Assert RTS.
DD4B B70178           (    forth6809.asm):01718                     STA   RTSSTATE
DD4E BDDD13           (    forth6809.asm):01719                     JSR   UPDATE_RTS
DD51 39               (    forth6809.asm):01720         CHKLODONE:  RTS
                      (    forth6809.asm):01721         ; ------------------------------------------------------------
                      (    forth6809.asm):01722         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01723         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01724         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01725         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01726         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01727         ;    Inputs:
                      (    forth6809.asm):01728         ;        none
                      (    forth6809.asm):01729         ;    Outputs:
                      (    forth6809.asm):01730         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01731         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01732         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01733         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01734         FLUSHOUTBUFFER:
DD52 F6017A           (    forth6809.asm):01735                     LDB   OUTTAIL
DD55 F10179           (    forth6809.asm):01736                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DD58 2719             (    forth6809.asm):01737                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01738         
DD5A B6C008           (    forth6809.asm):01739                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01740                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01741                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01742         
DD61 8502             (    forth6809.asm):01743                     BITA  #SR_TDRE          ; Is transmit register empty?
DD63 270E             (    forth6809.asm):01744                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01745                                             ; than spin-wait here.
                      (    forth6809.asm):01746         
DD65 8E01C0           (    forth6809.asm):01747                     LDX   #OUTBUF           ; The out buffer is occupied.
DD68 A685             (    forth6809.asm):01748                     LDA   B,X               ; Get the character from the out buffer.
DD6A B7C009           (    forth6809.asm):01749                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01750         
DD6D 5C               (    forth6809.asm):01751                     INCB                    ; Update tail pointer to next character slot.
DD6E C43F             (    forth6809.asm):01752                     ANDB  #OUTBUFSZ-1
DD70 F7017A           (    forth6809.asm):01753                     STB   OUTTAIL
                      (    forth6809.asm):01754                                             ; One character sent - return rather than
                      (    forth6809.asm):01755                                             ; loop back for more (see header comment).
DD73                  (    forth6809.asm):01756         FLUSHED:
DD73 39               (    forth6809.asm):01757                     RTS
                      (    forth6809.asm):01758         ; ------------------------------------------------------------
                      (    forth6809.asm):01759         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01760         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01761         ; PUTCHAR
                      (    forth6809.asm):01762         ;    Inputs:
                      (    forth6809.asm):01763         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01764         ;    Outputs:
                      (    forth6809.asm):01765         ;        none
                      (    forth6809.asm):01766         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01767         ; ------------------------------------------------------------
DD74                  (    forth6809.asm):01768         PUTCHAR:
DD74 3411             (    forth6809.asm):01769                     PSHS  CC,X
DD76 1A50             (    forth6809.asm):01770                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01771         
DD78 F60179           (    forth6809.asm):01772                     LDB   OUTHEAD           ; Is buffer full?
DD7B 5C               (    forth6809.asm):01773                     INCB
DD7C C43F             (    forth6809.asm):01774                     ANDB  #OUTBUFSZ-1
DD7E F1017A           (    forth6809.asm):01775                     CMPB  OUTTAIL
DD81 273A             (    forth6809.asm):01776                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01777         
DD83 8E01C0           (    forth6809.asm):01778                     LDX   #OUTBUF           ; Put character into character slot.
DD86 F60179           (    forth6809.asm):01779                     LDB   OUTHEAD
DD89 A785             (    forth6809.asm):01780                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01781         
DD8B 5C               (    forth6809.asm):01782                     INCB                    ; Update tail pointer to next character slot.
DD8C C43F             (    forth6809.asm):01783                     ANDB  #OUTBUFSZ-1
DD8E F70179           (    forth6809.asm):01784                     STB   OUTHEAD
                      (    forth6809.asm):01785         

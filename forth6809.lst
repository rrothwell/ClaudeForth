                      (    forth6809.asm):07308         ; TSTEXIT - unit test for EXIT. Compiles
                      (    forth6809.asm):07309         ; "DO I DUP 3 LITERAL = IF EXIT THEN I + LOOP", limit=10,
                      (    forth6809.asm):07310         ; start=0 - EXIT fires when I=3, discarding the one open DO
                      (    forth6809.asm):07311         ; frame and returning immediately. Sets the real CSP to U's
                      (    forth6809.asm):07312         ; value right before the first control-flow marker is pushed
                      (    forth6809.asm):07313         ; (matching what ":" does at the start of a real definition),
                      (    forth6809.asm):07314         ; since EXIT's own compile-time frame count depends on it -
                      (    forth6809.asm):07315         ; confirmed by hand-trace: at the point EXIT is compiled, U
                      (    forth6809.asm):07316         ; holds IF's own pending (addr,TAGFWD) on top of DO's
                      (    forth6809.asm):07317         ; (addr,TAGDO), and EXIT's scan correctly counts exactly one
                      (    forth6809.asm):07318         ; TAGDO between U and CSP. Unlike TSTLEAVE, EXIT fires
                      (    forth6809.asm):07319         ; immediately when reached - the following + never runs for
                      (    forth6809.asm):07320         ; I=3, so sum=0+1+2=3, not 6.
                      (    forth6809.asm):07321         ; ------------------------------------------------------------

                      (    forth6809.asm):03964         ; DO  ( C: -- dest )
                      (    forth6809.asm):03965         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03966         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03967         ; ------------------------------------------------------------
E81A CCE82C           (    forth6809.asm):03968         DOW:        LDD   #DOSETUP
E81D 3606             (    forth6809.asm):03969                     PSHU  D
E81F BDEABB           (    forth6809.asm):03970                     JSR   CCALL
E822 DC08             (    forth6809.asm):03971                     LDD   CODEHERE
E824 3606             (    forth6809.asm):03972                     PSHU  D                 ; dest
E826 CC0003           (    forth6809.asm):03973                     LDD   #TAGDO
E829 3606             (    forth6809.asm):03974                     PSHU  D
E82B 39               (    forth6809.asm):03975                     RTS
                      (    forth6809.asm):03976         
                      (    forth6809.asm):03977         ; ------------------------------------------------------------
                      (    forth6809.asm):03978         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03979         ; return address.
                      (    forth6809.asm):03980         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03981         ;    Inputs:
                      (    forth6809.asm):03982         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03983         ;    Outputs:
                      (    forth6809.asm):03984         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03985         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03986         ; ------------------------------------------------------------
E82C 3706             (    forth6809.asm):03987         DOSETUP:    PULU  D                 ; index
E82E DD29             (    forth6809.asm):03988                     STD   MSCR
E830 3706             (    forth6809.asm):03989                     PULU  D                 ; limit
E832 DD2B             (    forth6809.asm):03990                     STD   MSCR2
E834 3510             (    forth6809.asm):03991                     PULS  X
E836 CC0000           (    forth6809.asm):03992                     LDD   #0
E839 3406             (    forth6809.asm):03993                     PSHS  D
E83B DC2B             (    forth6809.asm):03994                     LDD   MSCR2
E83D 3406             (    forth6809.asm):03995                     PSHS  D
E83F DC29             (    forth6809.asm):03996                     LDD   MSCR
E841 3406             (    forth6809.asm):03997                     PSHS  D
E843 3410             (    forth6809.asm):03998                     PSHS  X
E845 39               (    forth6809.asm):03999                     RTS
                      (    forth6809.asm):04000         
                      (    forth6809.asm):04001         ; ------------------------------------------------------------
                      (    forth6809.asm):04002         ; I  ( -- n )
                      (    forth6809.asm):04003         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04004         ; address).
                      (    forth6809.asm):04005         ; ------------------------------------------------------------
E846 EC62             (    forth6809.asm):04006         IW:         LDD   2,S               ; n. See bugfix: IW.1
E848 3606             (    forth6809.asm):04007                     PSHU  D
E84A 39               (    forth6809.asm):04008                     RTS
                      (    forth6809.asm):04009         
                      (    forth6809.asm):04010         ; ------------------------------------------------------------
                      (    forth6809.asm):04011         ; J  ( -- n )
                      (    forth6809.asm):04012         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04013         ; address and the inner loop frame).
                      (    forth6809.asm):04014         ; ------------------------------------------------------------
E84B EC68             (    forth6809.asm):04015         JW:         LDD   8,S               ; n. See bugfix: JW.1
E84D 3606             (    forth6809.asm):04016                     PSHU  D
E84F 39               (    forth6809.asm):04017                     RTS
                      (    forth6809.asm):04018         
                      (    forth6809.asm):04019         ; ------------------------------------------------------------
                      (    forth6809.asm):04020         ; LEAVE  ( -- )
                      (    forth6809.asm):04021         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04022         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04023         ; ------------------------------------------------------------
E850 CCFFFF           (    forth6809.asm):04024         LEAVEW:     LDD   #TRUEV            ; true
E853 ED66             (    forth6809.asm):04025                     STD   6,S               ; See bugfix: LEAVEW.1
E855 39               (    forth6809.asm):04026                     RTS
                      (    forth6809.asm):04027         
                      (    forth6809.asm):04028         ; ------------------------------------------------------------
                      (    forth6809.asm):04029         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04030         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04031         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04032         ; ------------------------------------------------------------
E856 3706             (    forth6809.asm):04033         LOOPW:      PULU  D
E858 10830003         (    forth6809.asm):04034                     CMPD  #TAGDO
E85C 2703             (    forth6809.asm):04035                     BEQ   LOOPOK
E85E BDE611           (    forth6809.asm):04036                     JSR   CFERR
E861 3706             (    forth6809.asm):04037         LOOPOK:     PULU  D                 ; dest
E863 3606             (    forth6809.asm):04038                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E865 CCE89D           (    forth6809.asm):04039                     LDD   #DOTEST
E868 3606             (    forth6809.asm):04040                     PSHU  D
E86A BDEABB           (    forth6809.asm):04041                     JSR   CCALL
E86D CC0000           (    forth6809.asm):04042                     LDD   #0
E870 3606             (    forth6809.asm):04043                     PSHU  D
E872 BDE002           (    forth6809.asm):04044                     JSR   CODECOMMA
E875 DC08             (    forth6809.asm):04045                     LDD   CODEHERE
E877 830002           (    forth6809.asm):04046                     SUBD  #2
E87A DD3F             (    forth6809.asm):04047                     STD   PFIELD
E87C 3706             (    forth6809.asm):04048                     PULU  D
E87E 3606             (    forth6809.asm):04049                     PSHU  D
E880 DC3F             (    forth6809.asm):04050                     LDD   PFIELD
E882 3606             (    forth6809.asm):04051                     PSHU  D
E884 BDE67B           (    forth6809.asm):04052                     JSR   PATCH
                      (    forth6809.asm):04053         
E887 ECC4             (    forth6809.asm):04054                     LDD   ,U
E889 10830007         (    forth6809.asm):04055                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E88D 260D             (    forth6809.asm):04056                     BNE   LOOPDONE
E88F 3706             (    forth6809.asm):04057                     PULU  D
E891 3710             (    forth6809.asm):04058                     PULU  X                 ; ?DO skip operand
E893 DC08             (    forth6809.asm):04059                     LDD   CODEHERE
E895 3606             (    forth6809.asm):04060                     PSHU  D
E897 3610             (    forth6809.asm):04061                     PSHU  X
E899 BDE67B           (    forth6809.asm):04062                     JSR   PATCH
E89C 39               (    forth6809.asm):04063         LOOPDONE:   RTS
                      (    forth6809.asm):04064         
                      (    forth6809.asm):04065         ; ------------------------------------------------------------
                      (    forth6809.asm):04066         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04067         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04068         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04069         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04070         ; DOTEST
                      (    forth6809.asm):04071         ;    Inputs:
                      (    forth6809.asm):04072         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04073         ;        first)
                      (    forth6809.asm):04074         ;    Outputs:
                      (    forth6809.asm):04075         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04076         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04077         ; ------------------------------------------------------------
E89D EC66             (    forth6809.asm):04078         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E89F 2615             (    forth6809.asm):04079                     BNE   DTEXIT            ; set: exit
E8A1 EC62             (    forth6809.asm):04080                     LDD   2,S               ; index
E8A3 C30001           (    forth6809.asm):04081                     ADDD  #1
E8A6 ED62             (    forth6809.asm):04082                     STD   2,S
E8A8 10A364           (    forth6809.asm):04083                     CMPD  4,S               ; limit
E8AB 2709             (    forth6809.asm):04084                     BEQ   DTEXIT
E8AD 3510             (    forth6809.asm):04085                     PULS  X                 ; X = branch operand address
E8AF EC84             (    forth6809.asm):04086                     LDD   ,X
E8B1 308B             (    forth6809.asm):04087                     LEAX  D,X
E8B3 3410             (    forth6809.asm):04088                     PSHS  X                 ; return to loop start
E8B5 39               (    forth6809.asm):04089                     RTS
E8B6 3510             (    forth6809.asm):04090         DTEXIT:     PULS  X
E8B8 3002             (    forth6809.asm):04091                     LEAX  2,X               ; skip the branch operand
E8BA 3266             (    forth6809.asm):04092                     LEAS  6,S               ; discard the loop frame
E8BC 3410             (    forth6809.asm):04093                     PSHS  X
E8BE 39               (    forth6809.asm):04094                     RTS
                      (    forth6809.asm):04095         
                      (    forth6809.asm):04096         ; ------------------------------------------------------------
                      (    forth6809.asm):04097         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):04098         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):04099         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04100         ; ------------------------------------------------------------
E8BF 3706             (    forth6809.asm):04101         PLUSLOOPW:  PULU  D
E8C1 10830003         (    forth6809.asm):04102                     CMPD  #TAGDO
E8C5 2703             (    forth6809.asm):04103                     BEQ   PLOOPOK
E8C7 BDE611           (    forth6809.asm):04104                     JSR   CFERR
E8CA 3706             (    forth6809.asm):04105         PLOOPOK:    PULU  D                 ; dest
E8CC 3606             (    forth6809.asm):04106                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E8CE CCE906           (    forth6809.asm):04107                     LDD   #DOPLUSTEST
E8D1 3606             (    forth6809.asm):04108                     PSHU  D
E8D3 BDEABB           (    forth6809.asm):04109                     JSR   CCALL
E8D6 CC0000           (    forth6809.asm):04110                     LDD   #0

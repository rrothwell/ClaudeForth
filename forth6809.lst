F521 1F02             (    forth6809.asm):20155                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):20156                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):20157                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):20158                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):20159                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):20160                                   ; The high byte took on the fill character's
                      (    forth6809.asm):20161                                   ; value instead of the count's real high
                      (    forth6809.asm):20162                                   ; byte, so the count almost never reached
                      (    forth6809.asm):20163                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):20164                                   ; past the requested length. Keeping the
                      (    forth6809.asm):20165                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):20166                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):20167                                   ; fill character into A) and removes the
                      (    forth6809.asm):20168                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):20169                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):20170                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):20171                                   ; MAME debugger.
F523 3706             (    forth6809.asm):20172                  PULU  D
F525 1F01             (    forth6809.asm):20173                  TFR   D,X        ; address, kept directly in X rather than
                      (    forth6809.asm):20174                                   ; round-tripping through FILLADDR too

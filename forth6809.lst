                      (    forth6809.asm):21533                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):21534                                      ; against this system's own SM/REM and
                      (    forth6809.asm):21535                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):21536                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):21537                                      ; dividend's own original sign) after
                      (    forth6809.asm):21538                                      ; dividing absolute values - exactly
                      (    forth6809.asm):21539                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):21540                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):21541                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):21542                                      ; adjustment step (correcting the

                      (    forth6809.asm):09850                   BRA  TK2DONE
C26F                  (    forth6809.asm):09851         TK2FAIL:  LDD  #FALSEV
C26F                  (    forth6809.asm):09852         TK2DONE:  LDX  #TSTTICK2NAME
                      (    forth6809.asm):09853                   PSHU X

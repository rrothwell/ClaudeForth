                      (    forth6809.asm):03521         
E5B7 ECC4             (    forth6809.asm):03522         ABKSP:      LDD   ,U
E5B9 27C5             (    forth6809.asm):03523                     BEQ   ALOOP
E5BB 830001           (    forth6809.asm):03524                     SUBD  #1
E5BE EDC4             (    forth6809.asm):03525                     STD   ,U
E5C0 CC0008           (    forth6809.asm):03526                     LDD   #8
E5C3 3606             (    forth6809.asm):03527                     PSHU  D
E5C5 BDE571           (    forth6809.asm):03528                     JSR   EMITW
E5C8 CC0020           (    forth6809.asm):03529                     LDD   #32
E5CB 3606             (    forth6809.asm):03530                     PSHU  D
E5CD BDE571           (    forth6809.asm):03531                     JSR   EMITW
E5D0 CC0008           (    forth6809.asm):03532                     LDD   #8
E5D3 3606             (    forth6809.asm):03533                     PSHU  D
E5D5 BDE571           (    forth6809.asm):03534                     JSR   EMITW
E5D8 20A6             (    forth6809.asm):03535                     BRA   ALOOP
                      (    forth6809.asm):03536         
E5DA                  (    forth6809.asm):03537         ADONE:
                      (    forth6809.asm):03538                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03539                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03540                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03541                                             ; the host to pause before INTERPRET runs

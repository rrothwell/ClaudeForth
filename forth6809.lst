D928 AE42             (    forth6809.asm):04229                     LDX   2,U
D92A 3001             (    forth6809.asm):04230                     LEAX  1,X
D92C AF42             (    forth6809.asm):04231                     STX   2,U
D92E ECC4             (    forth6809.asm):04232                     LDD   ,U
D930 830001           (    forth6809.asm):04233                     SUBD  #1

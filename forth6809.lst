                      (    forth6809.asm):03863         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03864         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03865         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03866         ; ------------------------------------------------------------
E6BE CCDEF0           (    forth6809.asm):03867         WHILEW:     LDD   #ZBRANCH
E6C1 3606             (    forth6809.asm):03868                     PSHU  D
E6C3 BDE9F0           (    forth6809.asm):03869                     JSR   CCALL
E6C6 CC0000           (    forth6809.asm):03870                     LDD   #0
E6C9 3606             (    forth6809.asm):03871                     PSHU  D
E6CB BDDF7A           (    forth6809.asm):03872                     JSR   CODECOMMA
E6CE DC08             (    forth6809.asm):03873                     LDD   CODEHERE
E6D0 830002           (    forth6809.asm):03874                     SUBD  #2
E6D3 3606             (    forth6809.asm):03875                     PSHU  D                 ; orig
E6D5 CC0001           (    forth6809.asm):03876                     LDD   #TAGFWD
E6D8 3606             (    forth6809.asm):03877                     PSHU  D
E6DA 39               (    forth6809.asm):03878                     RTS
                      (    forth6809.asm):03879         
                      (    forth6809.asm):03880         ; ------------------------------------------------------------
                      (    forth6809.asm):03881         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03882         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03883         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03884         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03885         ; ------------------------------------------------------------
E6DB 3706             (    forth6809.asm):03886         REPEATW:    PULU  D
E6DD 10830001         (    forth6809.asm):03887                     CMPD  #TAGFWD
E6E1 2703             (    forth6809.asm):03888                     BEQ   RPOK1
E6E3 BDE580           (    forth6809.asm):03889                     JSR   CFERR
E6E6 3710             (    forth6809.asm):03890         RPOK1:      PULU  X                 ; orig
E6E8 3410             (    forth6809.asm):03891                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03892         
                      (    forth6809.asm):03893                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03894                     ; See bugfix: REPEATW.1
E6EA 3040             (    forth6809.asm):03895                     LEAX  0,U               ; scan from top of control stack
E6EC 9F16             (    forth6809.asm):03896                     STX   MSCR2             ; MSCR2 = base of scan region
E6EE 9F1A             (    forth6809.asm):03897                     STX   MSCR4             ; MSCR4 = scan pointer
E6F0 DC1A             (    forth6809.asm):03898         RPSCAN:     LDD   MSCR4
E6F2 109321           (    forth6809.asm):03899                     CMPD  CSP
E6F5 2603             (    forth6809.asm):03900                     BNE   RPSCANOK
E6F7 BDE580           (    forth6809.asm):03901                     JSR   CFERR             ; no matching BEGIN
E6FA 9E1A             (    forth6809.asm):03902         RPSCANOK:   LDX   MSCR4
E6FC EC84             (    forth6809.asm):03903                     LDD   ,X
E6FE 10830002         (    forth6809.asm):03904                     CMPD  #TAGBACK
E702 2712             (    forth6809.asm):03905                     BEQ   RPFOUND
E704 10830001         (    forth6809.asm):03906                     CMPD  #TAGFWD
E708 2703             (    forth6809.asm):03907                     BEQ   RPSKIP
E70A BDE580           (    forth6809.asm):03908                     JSR   CFERR             ; anything else is a genuine mismatch
E70D DC1A             (    forth6809.asm):03909         RPSKIP:     LDD   MSCR4
E70F C30004           (    forth6809.asm):03910                     ADDD  #4
E712 DD1A             (    forth6809.asm):03911                     STD   MSCR4
E714 20DA             (    forth6809.asm):03912                     BRA   RPSCAN
E716 9E1A             (    forth6809.asm):03913         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E718 EC02             (    forth6809.asm):03914                     LDD   2,X               ; dest = BEGIN's address
E71A 3406             (    forth6809.asm):03915                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03916         
                      (    forth6809.asm):03917                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03918                     ; bytes, highest word first.
E71C DC1A             (    forth6809.asm):03919                     LDD   MSCR4
E71E 9316             (    forth6809.asm):03920                     SUBD  MSCR2
E720 DD18             (    forth6809.asm):03921                     STD   MSCR3             ; MSCR3 = bytes to shift
E722 2715             (    forth6809.asm):03922                     BEQ   RPSHIFTDONE
E724 DC18             (    forth6809.asm):03923         RPSHIFT:    LDD   MSCR3
E726 830002           (    forth6809.asm):03924                     SUBD  #2
E729 DD18             (    forth6809.asm):03925                     STD   MSCR3
E72B 9E16             (    forth6809.asm):03926                     LDX   MSCR2
E72D 308B             (    forth6809.asm):03927                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E72F EC84             (    forth6809.asm):03928                     LDD   ,X
E731 3004             (    forth6809.asm):03929                     LEAX  4,X
E733 ED84             (    forth6809.asm):03930                     STD   ,X                ; copy one word 4 bytes higher
E735 DC18             (    forth6809.asm):03931                     LDD   MSCR3
E737 26EB             (    forth6809.asm):03932                     BNE   RPSHIFT
E739                  (    forth6809.asm):03933         RPSHIFTDONE:
E739 9E16             (    forth6809.asm):03934                     LDX   MSCR2
E73B 3004             (    forth6809.asm):03935                     LEAX  4,X
E73D 1F13             (    forth6809.asm):03936                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03937         
E73F CCDF06           (    forth6809.asm):03938                     LDD   #BRANCH
E742 3606             (    forth6809.asm):03939                     PSHU  D
E744 BDE9F0           (    forth6809.asm):03940                     JSR   CCALL
E747 CC0000           (    forth6809.asm):03941                     LDD   #0
E74A 3606             (    forth6809.asm):03942                     PSHU  D
E74C BDDF7A           (    forth6809.asm):03943                     JSR   CODECOMMA
E74F EC60             (    forth6809.asm):03944                     LDD   0,S               ; target = BEGIN's address
E751 3606             (    forth6809.asm):03945                     PSHU  D
E753 DC08             (    forth6809.asm):03946                     LDD   CODEHERE
E755 830002           (    forth6809.asm):03947                     SUBD  #2                ; location = the operand just compiled
E758 3606             (    forth6809.asm):03948                     PSHU  D
E75A BDE5EA           (    forth6809.asm):03949                     JSR   PATCH
E75D DC08             (    forth6809.asm):03950                     LDD   CODEHERE
E75F 3606             (    forth6809.asm):03951                     PSHU  D
E761 EC62             (    forth6809.asm):03952                     LDD   2,S               ; orig
E763 3606             (    forth6809.asm):03953                     PSHU  D
E765 BDE5EA           (    forth6809.asm):03954                     JSR   PATCH
E768 3264             (    forth6809.asm):03955                     LEAS  4,S               ; drop the frame
E76A 39               (    forth6809.asm):03956                     RTS
                      (    forth6809.asm):03957         
                      (    forth6809.asm):03958         ; ------------------------------------------------------------
                      (    forth6809.asm):03959         ; RECURSE  ( -- )
                      (    forth6809.asm):03960         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03961         ; the xt held in CURXT.
                      (    forth6809.asm):03962         ; ------------------------------------------------------------
E76B DC1F             (    forth6809.asm):03963         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E76D 3606             (    forth6809.asm):03964                     PSHU  D                 ; See bugfix: RECURSEW.1
E76F BDE9F0           (    forth6809.asm):03965                     JSR   CCALL
E772 39               (    forth6809.asm):03966                     RTS
                      (    forth6809.asm):03967         
                      (    forth6809.asm):03968         ; ------------------------------------------------------------
                      (    forth6809.asm):03969         ; DO  ( C: -- dest )
                      (    forth6809.asm):03970         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03971         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03972         ; ------------------------------------------------------------
E773 CCE785           (    forth6809.asm):03973         DOW:        LDD   #DOSETUP
E776 3606             (    forth6809.asm):03974                     PSHU  D
E778 BDE9F0           (    forth6809.asm):03975                     JSR   CCALL
E77B DC08             (    forth6809.asm):03976                     LDD   CODEHERE
E77D 3606             (    forth6809.asm):03977                     PSHU  D                 ; dest
E77F CC0003           (    forth6809.asm):03978                     LDD   #TAGDO
E782 3606             (    forth6809.asm):03979                     PSHU  D
E784 39               (    forth6809.asm):03980                     RTS
                      (    forth6809.asm):03981         
                      (    forth6809.asm):03982         ; ------------------------------------------------------------
                      (    forth6809.asm):03983         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03984         ; return address.
                      (    forth6809.asm):03985         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03986         ;    Inputs:
                      (    forth6809.asm):03987         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03988         ;    Outputs:
                      (    forth6809.asm):03989         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03990         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03991         ; ------------------------------------------------------------
E785 3706             (    forth6809.asm):03992         DOSETUP:    PULU  D                 ; index
E787 DD14             (    forth6809.asm):03993                     STD   MSCR
E789 3706             (    forth6809.asm):03994                     PULU  D                 ; limit
E78B DD16             (    forth6809.asm):03995                     STD   MSCR2
E78D 3510             (    forth6809.asm):03996                     PULS  X
E78F CC0000           (    forth6809.asm):03997                     LDD   #0
E792 3406             (    forth6809.asm):03998                     PSHS  D
E794 DC16             (    forth6809.asm):03999                     LDD   MSCR2
E796 3406             (    forth6809.asm):04000                     PSHS  D
E798 DC14             (    forth6809.asm):04001                     LDD   MSCR
E79A 3406             (    forth6809.asm):04002                     PSHS  D
E79C 3410             (    forth6809.asm):04003                     PSHS  X
E79E 39               (    forth6809.asm):04004                     RTS
                      (    forth6809.asm):04005         
                      (    forth6809.asm):04006         ; ------------------------------------------------------------
                      (    forth6809.asm):04007         ; I  ( -- n )
                      (    forth6809.asm):04008         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04009         ; address).
                      (    forth6809.asm):04010         ; ------------------------------------------------------------
E79F EC62             (    forth6809.asm):04011         IW:         LDD   2,S               ; n. See bugfix: IW.1
E7A1 3606             (    forth6809.asm):04012                     PSHU  D
E7A3 39               (    forth6809.asm):04013                     RTS
                      (    forth6809.asm):04014         
                      (    forth6809.asm):04015         ; ------------------------------------------------------------
                      (    forth6809.asm):04016         ; J  ( -- n )
                      (    forth6809.asm):04017         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04018         ; address and the inner loop frame).
                      (    forth6809.asm):04019         ; ------------------------------------------------------------
E7A4 EC68             (    forth6809.asm):04020         JW:         LDD   8,S               ; n. See bugfix: JW.1
E7A6 3606             (    forth6809.asm):04021                     PSHU  D
E7A8 39               (    forth6809.asm):04022                     RTS
                      (    forth6809.asm):04023         
                      (    forth6809.asm):04024         ; ------------------------------------------------------------
                      (    forth6809.asm):04025         ; LEAVE  ( -- )
                      (    forth6809.asm):04026         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04027         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04028         ; ------------------------------------------------------------
E7A9 CCFFFF           (    forth6809.asm):04029         LEAVEW:     LDD   #TRUEV            ; true
E7AC ED66             (    forth6809.asm):04030                     STD   6,S               ; See bugfix: LEAVEW.1
E7AE 39               (    forth6809.asm):04031                     RTS
                      (    forth6809.asm):04032         
                      (    forth6809.asm):04033         ; ------------------------------------------------------------
                      (    forth6809.asm):04034         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04035         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04036         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04037         ; ------------------------------------------------------------
E7AF 3706             (    forth6809.asm):04038         LOOPW:      PULU  D
E7B1 10830003         (    forth6809.asm):04039                     CMPD  #TAGDO
E7B5 2703             (    forth6809.asm):04040                     BEQ   LOOPOK
E7B7 BDE580           (    forth6809.asm):04041                     JSR   CFERR
E7BA 3706             (    forth6809.asm):04042         LOOPOK:     PULU  D                 ; dest
E7BC 3606             (    forth6809.asm):04043                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E7BE CCE7EE           (    forth6809.asm):04044                     LDD   #DOTEST
E7C1 3606             (    forth6809.asm):04045                     PSHU  D
E7C3 BDE9F0           (    forth6809.asm):04046                     JSR   CCALL
E7C6 CC0000           (    forth6809.asm):04047                     LDD   #0
E7C9 3606             (    forth6809.asm):04048                     PSHU  D
E7CB BDDF7A           (    forth6809.asm):04049                     JSR   CODECOMMA
E7CE DC08             (    forth6809.asm):04050                     LDD   CODEHERE
E7D0 830002           (    forth6809.asm):04051                     SUBD  #2
E7D3 3606             (    forth6809.asm):04052                     PSHU  D                 ; location; the parked dest is beneath
E7D5 BDE5EA           (    forth6809.asm):04053                     JSR   PATCH
                      (    forth6809.asm):04054         
E7D8 ECC4             (    forth6809.asm):04055                     LDD   ,U
E7DA 10830007         (    forth6809.asm):04056                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E7DE 260D             (    forth6809.asm):04057                     BNE   LOOPDONE
E7E0 3706             (    forth6809.asm):04058                     PULU  D
E7E2 3710             (    forth6809.asm):04059                     PULU  X                 ; ?DO skip operand
E7E4 DC08             (    forth6809.asm):04060                     LDD   CODEHERE
E7E6 3606             (    forth6809.asm):04061                     PSHU  D
E7E8 3610             (    forth6809.asm):04062                     PSHU  X
E7EA BDE5EA           (    forth6809.asm):04063                     JSR   PATCH
E7ED 39               (    forth6809.asm):04064         LOOPDONE:   RTS
                      (    forth6809.asm):04065         
                      (    forth6809.asm):04066         ; ------------------------------------------------------------
                      (    forth6809.asm):04067         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04068         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04069         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04070         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04071         ; DOTEST
                      (    forth6809.asm):04072         ;    Inputs:
                      (    forth6809.asm):04073         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04074         ;        first)
                      (    forth6809.asm):04075         ;    Outputs:
                      (    forth6809.asm):04076         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04077         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04078         ; ------------------------------------------------------------
E7EE EC66             (    forth6809.asm):04079         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E7F0 2615             (    forth6809.asm):04080                     BNE   DTEXIT            ; set: exit
E7F2 EC62             (    forth6809.asm):04081                     LDD   2,S               ; index
E7F4 C30001           (    forth6809.asm):04082                     ADDD  #1
E7F7 ED62             (    forth6809.asm):04083                     STD   2,S
E7F9 10A364           (    forth6809.asm):04084                     CMPD  4,S               ; limit
E7FC 2709             (    forth6809.asm):04085                     BEQ   DTEXIT
E7FE 3510             (    forth6809.asm):04086                     PULS  X                 ; X = branch operand address
E800 EC84             (    forth6809.asm):04087                     LDD   ,X
E802 308B             (    forth6809.asm):04088                     LEAX  D,X
E804 3410             (    forth6809.asm):04089                     PSHS  X                 ; return to loop start
E806 39               (    forth6809.asm):04090                     RTS
E807 3510             (    forth6809.asm):04091         DTEXIT:     PULS  X
E809 3002             (    forth6809.asm):04092                     LEAX  2,X               ; skip the branch operand
E80B 3266             (    forth6809.asm):04093                     LEAS  6,S               ; discard the loop frame
E80D 3410             (    forth6809.asm):04094                     PSHS  X
E80F 39               (    forth6809.asm):04095                     RTS
                      (    forth6809.asm):04096         
                      (    forth6809.asm):04097         ; ------------------------------------------------------------
                      (    forth6809.asm):04098         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):04099         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):04100         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.

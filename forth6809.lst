                      (    forth6809.asm):06172         ; ------------------------------------------------------------
F357 EC42             (    forth6809.asm):06173         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F359 270F             (    forth6809.asm):06174                     BEQ   FDONE

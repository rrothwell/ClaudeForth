                      (    forth6809.asm):01577         ; ------------------------------------------------------------
                      (    forth6809.asm):01578         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01579         ; receiver-error counters to zero.
                      (    forth6809.asm):01580         ; SERBUFCLR
                      (    forth6809.asm):01581         ;    Inputs:
                      (    forth6809.asm):01582         ;        none
                      (    forth6809.asm):01583         ;    Outputs:
                      (    forth6809.asm):01584         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01585         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01586         ;    Registers: only CC changed.
                      (    forth6809.asm):01587         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01588         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01589         ; ------------------------------------------------------------
                      (    forth6809.asm):01590         
DCC4 7F0176           (    forth6809.asm):01591         SERBUFCLR:  CLR   INHEAD
DCC7 7F0177           (    forth6809.asm):01592                     CLR   INTAIL

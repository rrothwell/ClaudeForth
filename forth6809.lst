                      (    forth6809.asm):02580                       BNE  T2FFAIL
                      (    forth6809.asm):02581                       PULU D
                      (    forth6809.asm):02582                       CMPD #TSTVAL1
                      (    forth6809.asm):02583                       BNE  T2FFAIL
                      (    forth6809.asm):02584                       PULU D
                      (    forth6809.asm):02585                       CMPD #TSTGUARD
                      (    forth6809.asm):02586                       BNE  T2FFAIL
                      (    forth6809.asm):02587         

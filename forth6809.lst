                      (    forth6809.asm):02933         
                      (    forth6809.asm):02934         ; ------------------------------------------------------------
                      (    forth6809.asm):02935         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):02936         ; lower address as 2@ expects.
                      (    forth6809.asm):02937         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):02938         ; ------------------------------------------------------------

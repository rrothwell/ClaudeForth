F7D3 DDA9             (    forth6809.asm):06954                    STD  UESRCLEN
F7D5 3706             (    forth6809.asm):06955                    PULU D         ; next: c-addr1 (source address)
F7D7 DDA7             (    forth6809.asm):06956                    STD  UEADDR
F7D9 CC0000           (    forth6809.asm):06957                    LDD  #0
F7DC DDAD             (    forth6809.asm):06958                    STD  UEOUTLEN
F7DE 9EA7             (    forth6809.asm):06959                    LDX  UEADDR
F7E0 109EAB           (    forth6809.asm):06960                    LDY  UEDST
                      (    forth6809.asm):06961         
                      (    forth6809.asm):06962                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06963                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06964                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06965                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06966                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06967                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06968                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06969                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06970                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06971                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06972                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06973                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06974                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):06975                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):06976                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):06977                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):06978                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):06979                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):06980                    ; wrong algorithm entirely, not a smaller bug within it.
F7E3 DCA9             (    forth6809.asm):06981         UELOOP:    LDD  UESRCLEN
F7E5 2715             (    forth6809.asm):06982                    BEQ  UEDONE
F7E7 A680             (    forth6809.asm):06983                    LDA  ,X+
F7E9 8125             (    forth6809.asm):06984                    CMPA #'%'
F7EB 2604             (    forth6809.asm):06985                    BNE  UENOTPCT
F7ED C625             (    forth6809.asm):06986                    LDB  #'%'      ; write the extra '%' first - the character
F7EF E7A0             (    forth6809.asm):06987                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06988                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06989                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06990                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06991                                   ; independently for each one the loop visits.
F7F1 A7A0             (    forth6809.asm):06992         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06993                                   ; every character, '%' or not
F7F3 DCA9             (    forth6809.asm):06994                    LDD  UESRCLEN
F7F5 830001           (    forth6809.asm):06995                    SUBD #1
F7F8 DDA9             (    forth6809.asm):06996                    STD  UESRCLEN
F7FA 20E7             (    forth6809.asm):06997                    BRA  UELOOP
F7FC 1F20             (    forth6809.asm):06998         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F7FE 93AB             (    forth6809.asm):06999                    SUBD UEDST     ; overwriting whatever was left on top of
F800 DDAD             (    forth6809.asm):07000                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):07001                                   ; required return values, and separately,
                      (    forth6809.asm):07002                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):07003                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):07004                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):07005                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):07006                                   ; characters. Now computed directly as the
                      (    forth6809.asm):07007                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):07008                                   ; original destination address (UEDST) -
                      (    forth6809.asm):07009                                   ; correct regardless of how many characters
                      (    forth6809.asm):07010                                   ; were doubled, since it's derived from
                      (    forth6809.asm):07011                                   ; where writing actually stopped rather than
                      (    forth6809.asm):07012                                   ; incremented alongside it.
F802 DCAB             (    forth6809.asm):07013                    LDD  UEDST
F804 3606             (    forth6809.asm):07014                    PSHU D         ; push c-addr2 (destination address)
F806 DCAD             (    forth6809.asm):07015                    LDD  UEOUTLEN
F808 3606             (    forth6809.asm):07016                    PSHU D         ; push u2 (actual unescaped length)
F80A 39               (    forth6809.asm):07017                    RTS

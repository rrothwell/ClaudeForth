F863 3706             (    forth6809.asm):09116         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F865 DDAB             (    forth6809.asm):09117                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):09118                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):09119                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):09120                                   ; real source length was misread as an
                      (    forth6809.asm):09121                                   ; address, the real source address was never
                      (    forth6809.asm):09122                                   ; popped at all, and the true destination
                      (    forth6809.asm):09123                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):09124                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):09125                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):09126                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):09127                    STD  UESRCLEN
F86B 3706             (    forth6809.asm):09128                    PULU D         ; next: c-addr1 (source address)
F86D DDA7             (    forth6809.asm):09129                    STD  UEADDR
F86F CC0000           (    forth6809.asm):09130                    LDD  #0
F872 DDAD             (    forth6809.asm):09131                    STD  UEOUTLEN

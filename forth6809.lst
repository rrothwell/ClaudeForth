                      (   unit_tests.asm):11795         ; TSTMOVE3 - unit test for MOVE, overlapping case with dst <
                      (   unit_tests.asm):11796         ; src (dst = TSTCBUF, src = TSTCBUF+2, 5 bytes - a 2-byte

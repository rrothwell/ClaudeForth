                      (    forth6809.asm):09990         ; TSTBRACKTICK1 - unit test for ['], compiling-state case.
                      (    forth6809.asm):09991         ; Compile-only, so STATE must be -1 for this to work at all
                      (    forth6809.asm):09992         ; (confirmed by reading its own code: throws -14 otherwise).
                      (    forth6809.asm):09993         ; Builds a fake header pointing at DUP, compiles a literal of
                      (    forth6809.asm):09994         ; its xt via ['], then executes the result to confirm it
                      (    forth6809.asm):09995         ; genuinely pushes DUP's own xt.
                      (    forth6809.asm):09996         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):09997         TSTBRACKTICK1: LDD  CODEHERE
                      (    forth6809.asm):09998                        STD  TSTCSAV
                      (    forth6809.asm):09999                        LDD  LATEST
                      (    forth6809.asm):10000                        STD  TSTLSAV
                      (    forth6809.asm):10001                        LDD  SRCADDR
                      (    forth6809.asm):10002                        STD  TSTSASAV
                      (    forth6809.asm):10003                        LDD  SRCLEN
                      (    forth6809.asm):10004                        STD  TSTSLSAV
                      (    forth6809.asm):10005                        LDD  TOIN
                      (    forth6809.asm):10006                        STD  TSTTISAV
                      (    forth6809.asm):10007                        LDD  STATE

                      (    forth6809.asm):00528         
                      (    forth6809.asm):00529         ; ------------------------------------------------------------
                      (    forth6809.asm):00530         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00531         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00532         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00533         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00534         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00535         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00536         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00537         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00538         ;
                      (    forth6809.asm):00539         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00540         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00541         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00542         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00543         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00544         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00545         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00546         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00547         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00548         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00549         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00550         ; ------------------------------------------------------------
                      (    forth6809.asm):00551                  ORG   $0100
0100                  (    forth6809.asm):00552         MVCNT      RMB   2
0102                  (    forth6809.asm):00553         MVDST      RMB   2
0104                  (    forth6809.asm):00554         MVSRC      RMB   2
     0100             (    forth6809.asm):00555         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00556         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00557         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00558         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00559         
                      (    forth6809.asm):00560         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00561         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00562                  ORG USROMSTRT
                      (    forth6809.asm):00563         
                      (    forth6809.asm):00564         ; ============================================================
                      (    forth6809.asm):00565         ; UNIT TEST FRAMEWORK
                      (    forth6809.asm):00566         ;
                      (    forth6809.asm):00567         ; Self-checking assembly-level tests for this ROM's own
                      (    forth6809.asm):00568         ; primitives, gated by UNITTESTS below and run once at cold
                      (    forth6809.asm):00569         ; boot, right after INITSERIAL and before COLD (so U/S are
                      (    forth6809.asm):00570         ; already valid - COLDSTRT sets them at its very start - but
                      (    forth6809.asm):00571         ; nothing else has been initialized yet: APPVARS/DPHERE/
                      (    forth6809.asm):00572         ; CODEHERE/LATEST/BASE all still hold whatever COLD is about to
                      (    forth6809.asm):00573         ; set them to). Lives here, in previously-unused ROM space right
                      (    forth6809.asm):00574         ; after INOUT's shadow, since this was pure FILL padding before
                      (    forth6809.asm):00575         ; this existed - UNITTESTS=1 removes it entirely and this block
                      (    forth6809.asm):00576         ; reverts to exactly that padding, computed automatically below
                      (    forth6809.asm):00577         ; via the ROM label rather than a fixed byte count, so it's
                      (    forth6809.asm):00578         ; correct either way without needing to be hand-adjusted.
                      (    forth6809.asm):00579         ;
                      (    forth6809.asm):00580         ; Each test is independent by construction: it saves the data
                      (    forth6809.asm):00581         ; stack pointer (U) before touching anything, and unconditionally
                      (    forth6809.asm):00582         ; restores it at the end regardless of pass or fail - so one
                      (    forth6809.asm):00583         ; test's assertions failing can never leave stack residue for the
                      (    forth6809.asm):00584         ; next test to inherit. Test scratch variables live in the very
                      (    forth6809.asm):00585         ; start of APPVARS - safe only because tests run strictly before
                      (    forth6809.asm):00586         ; COLD initializes VARHERE to that same address; COLD immediately
                      (    forth6809.asm):00587         ; and correctly re-purposes that space afterward.
                      (    forth6809.asm):00588         ;
                      (    forth6809.asm):00589         ; Reporting: each test's name (a counted string, matching how
                      (    forth6809.asm):00590         ; BADWORD itself prints a failing word) is printed via COUNT+TYPE,
                      (    forth6809.asm):00591         ; followed by " OK" or " FAIL", followed by a CR - all via
                      (    forth6809.asm):00592         ; TSTREPORT, shared by every test rather than duplicated in each.
                      (    forth6809.asm):00593         ; ============================================================
     0001             (    forth6809.asm):00594         UNITTESTS EQU 1   ; was 0 (included) - set to 1 (excluded) per explicit
                      (    forth6809.asm):00595                           ; request: unit tests don't work yet and resolution
                      (    forth6809.asm):00596                           ; has been postponed. 0 = included (matches this
                      (    forth6809.asm):00597                           ; file's established IFEQ convention, e.g.
                      (    forth6809.asm):00598                           ; SERIALPOLL); 1 = excluded entirely, reverting to
                      (    forth6809.asm):00599                           ; plain FILL padding.
                      (    forth6809.asm):00600         
                      (    forth6809.asm):00601                  IFEQ  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00602         
C100                  (    forth6809.asm):00603         TSTU0    EQU   APPVARS       ; saved U, before a test touches it
C100                  (    forth6809.asm):00604         TSTUB4   EQU   APPVARS+2     ; U immediately before the op under test
C100                  (    forth6809.asm):00605         TSTUAF   EQU   APPVARS+4     ; U immediately after the op under test
C100                  (    forth6809.asm):00606         TSTFLAG  EQU   APPVARS+6     ; scratch for TSTREPORT's pass/fail arg
                      (    forth6809.asm):00607         
C100                  (    forth6809.asm):00608         TSTGUARD EQU   $3C7A         ; sentinel value, pushed below the value
                      (    forth6809.asm):00609                                       ; under test, to prove an operation
                      (    forth6809.asm):00610                                       ; doesn't disturb what's beneath it
C100                  (    forth6809.asm):00611         TSTVAL1  EQU   $59E1         ; the value under test itself - neither
                      (    forth6809.asm):00612                                       ; constant is 0, 1, or -1, so a test
                      (    forth6809.asm):00613                                       ; that only appears to pass due to a
                      (    forth6809.asm):00614                                       ; trivial/special-cased value would be
                      (    forth6809.asm):00615                                       ; caught rather than masked
                      (    forth6809.asm):00616         
                      (    forth6809.asm):00617         ; ------------------------------------------------------------
                      (    forth6809.asm):00618         ; TSTREPORT - ( testname-caddr passflag -- ) shared by every
                      (    forth6809.asm):00619         ; test. Prints the test's name (via COUNT+TYPE), then " OK" or
                      (    forth6809.asm):00620         ; " FAIL" depending on passflag (TRUEV = pass, FALSEV = fail),
                      (    forth6809.asm):00621         ; then a CR, readying the terminal for the next test's line.
                      (    forth6809.asm):00622         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00623         TSTREPORT: PULU  D
                      (    forth6809.asm):00624                    STD   TSTFLAG
                      (    forth6809.asm):00625                    JSR   COUNT
                      (    forth6809.asm):00626                    JSR   TYPE
                      (    forth6809.asm):00627                    LDD   TSTFLAG
                      (    forth6809.asm):00628                    BEQ   TSTFAILR
                      (    forth6809.asm):00629                    LDD   #TSTOKMSG
                      (    forth6809.asm):00630                    PSHU  D
                      (    forth6809.asm):00631                    LDD   #TSTOKMSGL
                      (    forth6809.asm):00632                    PSHU  D
                      (    forth6809.asm):00633                    BRA   TSTPRINT
C100                  (    forth6809.asm):00634         TSTFAILR:  LDD   #TSTFAILMSG
                      (    forth6809.asm):00635                    PSHU  D
                      (    forth6809.asm):00636                    LDD   #TSTFAILMSGL
                      (    forth6809.asm):00637                    PSHU  D
C100                  (    forth6809.asm):00638         TSTPRINT:  JSR   TYPE
                      (    forth6809.asm):00639                    JSR   CRW
                      (    forth6809.asm):00640                    RTS
                      (    forth6809.asm):00641         
C100                  (    forth6809.asm):00642         TSTOKMSG:    FCC " OK"
C100                  (    forth6809.asm):00643         TSTOKMSGL    EQU  *-TSTOKMSG
C100                  (    forth6809.asm):00644         TSTFAILMSG:  FCC " FAIL"
C100                  (    forth6809.asm):00645         TSTFAILMSGL  EQU  *-TSTFAILMSG
                      (    forth6809.asm):00646         
                      (    forth6809.asm):00647         ; ------------------------------------------------------------
                      (    forth6809.asm):00648         ; TSTRUNNER - calls each test group in turn. Add new groups
                      (    forth6809.asm):00649         ; here as they're written.
                      (    forth6809.asm):00650         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00651         TSTRUNNER: JSR   TSTSTACK
                      (    forth6809.asm):00652                    RTS
                      (    forth6809.asm):00653         
                      (    forth6809.asm):00654         ; ------------------------------------------------------------
                      (    forth6809.asm):00655         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):00656         ; they're written.
                      (    forth6809.asm):00657         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00658         TSTSTACK:  JSR   TSTDUP
                      (    forth6809.asm):00659                    RTS
                      (    forth6809.asm):00660         
                      (    forth6809.asm):00661         ; ------------------------------------------------------------
                      (    forth6809.asm):00662         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00663         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00664         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00665         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00666         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00667         ; pushes that set the test up).
                      (    forth6809.asm):00668         ; ------------------------------------------------------------
C100                  (    forth6809.asm):00669         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00670         
                      (    forth6809.asm):00671                    LDD   #TSTGUARD
                      (    forth6809.asm):00672                    PSHU  D
                      (    forth6809.asm):00673                    LDD   #TSTVAL1
                      (    forth6809.asm):00674                    PSHU  D
                      (    forth6809.asm):00675                    STU   TSTUB4
                      (    forth6809.asm):00676         
                      (    forth6809.asm):00677                    JSR   DUP
                      (    forth6809.asm):00678         
                      (    forth6809.asm):00679                    STU   TSTUAF
                      (    forth6809.asm):00680         
                      (    forth6809.asm):00681                    PULU  D
                      (    forth6809.asm):00682                    CMPD  #TSTVAL1
                      (    forth6809.asm):00683                    BNE   TDFAIL
                      (    forth6809.asm):00684                    PULU  D
                      (    forth6809.asm):00685                    CMPD  #TSTVAL1
                      (    forth6809.asm):00686                    BNE   TDFAIL
                      (    forth6809.asm):00687                    PULU  D
                      (    forth6809.asm):00688                    CMPD  #TSTGUARD
                      (    forth6809.asm):00689                    BNE   TDFAIL
                      (    forth6809.asm):00690         
                      (    forth6809.asm):00691                    LDD   TSTUB4
                      (    forth6809.asm):00692                    SUBD  TSTUAF
                      (    forth6809.asm):00693                    CMPD  #2
                      (    forth6809.asm):00694                    BNE   TDFAIL
                      (    forth6809.asm):00695         
                      (    forth6809.asm):00696                    LDD   #TRUEV
                      (    forth6809.asm):00697                    BRA   TDDONE
C100                  (    forth6809.asm):00698         TDFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):00699         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00700                    PSHU  X
                      (    forth6809.asm):00701                    PSHU  D
                      (    forth6809.asm):00702                    JSR   TSTREPORT
                      (    forth6809.asm):00703         
                      (    forth6809.asm):00704                    LDU   TSTU0
                      (    forth6809.asm):00705                    RTS
                      (    forth6809.asm):00706         
C100                  (    forth6809.asm):00707         TSTDUPNAME: FCB  6
                      (    forth6809.asm):00708                     FCC  "TSTDUP"
                      (    forth6809.asm):00709         
                      (    forth6809.asm):00710                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00711         
C100                  (    forth6809.asm):00712         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00713                  FILL $FF,BASEDICT-ROM

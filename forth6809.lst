                      (    forth6809.asm):02276                     ; interrupt, so nothing will ever drain OUTBUF except this
                      (    forth6809.asm):02277                     ; polling fallback. BUG FIX: FLUSHOUTBUFFER can take until
                      (    forth6809.asm):02278                     ; the whole OUTBUF drains (up to ~64 chars, ~5.5ms at 115200
                      (    forth6809.asm):02279                     ; baud) - running that under PUTCHAR's own ORCC #$50 masked

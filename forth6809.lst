E480 2641             (    forth6809.asm):03764                   BNE   NQBAD
                      (    forth6809.asm):03765         
                      (    forth6809.asm):03766                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03767                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03768                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03769                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03770                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03771                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03772                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03773                   ; high cell.
E482 0D22             (    forth6809.asm):03774                   TST   NUMNEG
E484 2718             (    forth6809.asm):03775                   BEQ   NQPOS32
E486 DC76             (    forth6809.asm):03776                   LDD   UDLO
E488 43               (    forth6809.asm):03777                   COMA
E489 53               (    forth6809.asm):03778                   COMB
E48A C30001           (    forth6809.asm):03779                   ADDD  #1
E48D DD76             (    forth6809.asm):03780                   STD   UDLO
E48F 3401             (    forth6809.asm):03781                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03782                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03783                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03784                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03785                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03786                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03787                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03788                                      ; making the high-cell increment run
                      (    forth6809.asm):03789                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03790                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03791                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03792                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03793                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03794                                      ; matching "always increment" rather than
                      (    forth6809.asm):03795                                      ; "increment only on genuine carry".
E491 DC74             (    forth6809.asm):03796                   LDD   UDHI
E493 43               (    forth6809.asm):03797                   COMA
E494 53               (    forth6809.asm):03798                   COMB
E495 3501             (    forth6809.asm):03799                   PULS  CC          ; restore the TRUE carry
E497 2403             (    forth6809.asm):03800                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03801                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03802                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03803                                      ; value was computed in D but never
                      (    forth6809.asm):03804                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03805                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03806                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03807                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03808                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03809                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03810                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03811                                      ; alone would have made this second,
                      (    forth6809.asm):03812                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03813                                      ; only past the "+1", never past the
                      (    forth6809.asm):03814                                      ; store itself - the store always runs,
                      (    forth6809.asm):03815                                      ; either way.
E499 C30001           (    forth6809.asm):03816                   ADDD  #1
E49C DD74             (    forth6809.asm):03817         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03818         
E49E                  (    forth6809.asm):03819         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03820                   ; was '.' - determines which return convention to use
E49E 9E1F             (    forth6809.asm):03821                   LDX   CADDR
E4A0 E684             (    forth6809.asm):03822                   LDB   ,X
E4A2 5A               (    forth6809.asm):03823                   DECB
E4A3 3001             (    forth6809.asm):03824                   LEAX  1,X
E4A5 A685             (    forth6809.asm):03825                   LDA   B,X
E4A7 812E             (    forth6809.asm):03826                   CMPA  #'.'
E4A9 260E             (    forth6809.asm):03827                   BNE   NQSINGLE
                      (    forth6809.asm):03828         
                      (    forth6809.asm):03829                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03830                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03831                   ; apart without needing a separate flag of its own either
E4AB DC76             (    forth6809.asm):03832                   LDD   UDLO
E4AD 3606             (    forth6809.asm):03833                   PSHU  D
E4AF DC74             (    forth6809.asm):03834                   LDD   UDHI
E4B1 3606             (    forth6809.asm):03835                   PSHU  D
E4B3 CC0001           (    forth6809.asm):03836                   LDD   #1
E4B6 3606             (    forth6809.asm):03837                   PSHU  D
E4B8 39               (    forth6809.asm):03838                   RTS
                      (    forth6809.asm):03839         
E4B9                  (    forth6809.asm):03840         NQSINGLE: ; SINGLE success - unchanged from the original convention
E4B9 DC76             (    forth6809.asm):03841                   LDD   UDLO
E4BB 3606             (    forth6809.asm):03842                   PSHU  D
E4BD CCFFFF           (    forth6809.asm):03843                   LDD   #-1
E4C0 3606             (    forth6809.asm):03844                   PSHU  D
E4C2 39               (    forth6809.asm):03845                   RTS
                      (    forth6809.asm):03846         
E4C3 9E1F             (    forth6809.asm):03847         NQBAD:    LDX   CADDR
E4C5 3610             (    forth6809.asm):03848                   PSHU  X
E4C7 CC0000           (    forth6809.asm):03849                   LDD   #0
E4CA 3606             (    forth6809.asm):03850                   PSHU  D
E4CC 39               (    forth6809.asm):03851                   RTS
                      (    forth6809.asm):03852         
                      (    forth6809.asm):03853         ; ============================================================
                      (    forth6809.asm):03854         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03855         ; ============================================================
                      (    forth6809.asm):03856                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E4CD                  (    forth6809.asm):03857         X_KEY:     LDA   INHEAD
                      (    forth6809.asm):03858                  CMPA  INTAIL
                      (    forth6809.asm):03859                  BEQ   KEY
                      (    forth6809.asm):03860                  LDX   #INBUF
                      (    forth6809.asm):03861                  LDB   INTAIL
                      (    forth6809.asm):03862                  LDA   B,X
                      (    forth6809.asm):03863                  INCB
                      (    forth6809.asm):03864                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):03865                  STB   INTAIL
                      (    forth6809.asm):03866                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03867                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03868                                         ; this needs no dedicated scratch global
                      (    forth6809.asm):03869                  JSR   RTSCHECKLO
                      (    forth6809.asm):03870                  PULS  A
                      (    forth6809.asm):03871                  TFR   A,B
                      (    forth6809.asm):03872                  CLRA
                      (    forth6809.asm):03873                  PSHU  D
                      (    forth6809.asm):03874                  RTS
                      (    forth6809.asm):03875         
                      (    forth6809.asm):03876         ; ------------------------------------------------------------
                      (    forth6809.asm):03877         ; KEY ( -- char )
                      (    forth6809.asm):03878         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03879         KEY:
                      (    forth6809.asm):03880         
                      (    forth6809.asm):03881                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03882                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03883         
                      (    forth6809.asm):03884                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03885                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03886                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03887                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03888                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03889                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03890                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03891                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03892                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03893                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03894                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03895                                             ; by transmitting all chars.
                      (    forth6809.asm):03896         
E4CD                  (    forth6809.asm):03897         TRY_READ:
                      (    forth6809.asm):03898                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03899                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03900                                             ; while still transmitting!
                      (    forth6809.asm):03901                 
                      (    forth6809.asm):03902                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03903                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03904                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03905         
                      (    forth6809.asm):03906                     RTS                     
                      (    forth6809.asm):03907         
                      (    forth6809.asm):03908         ; ------------------------------------------------------------
                      (    forth6809.asm):03909         ; KEY? ( -- flag )
                      (    forth6809.asm):03910         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03911         KEYQ:  
                      (    forth6809.asm):03912                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03913         
                      (    forth6809.asm):03914                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03915                     CMPA  INTAIL
                      (    forth6809.asm):03916         
                      (    forth6809.asm):03917                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03918         
                      (    forth6809.asm):03919                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03920         
                      (    forth6809.asm):03921                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03922                     PSHU  D
                      (    forth6809.asm):03923         
                      (    forth6809.asm):03924                     RTS
                      (    forth6809.asm):03925         
E4CD                  (    forth6809.asm):03926         KQTRUE:     
                      (    forth6809.asm):03927                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03928                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03929                     RTS
                      (    forth6809.asm):03930         ; ------------------------------------------------------------
                      (    forth6809.asm):03931         ; EMIT  ( char -- )
                      (    forth6809.asm):03932         ; ------------------------------------------------------------
                      (    forth6809.asm):03933         
E4CD                  (    forth6809.asm):03934         X_EMIT:    PULU  D
                      (    forth6809.asm):03935                  STB   EMITCH
E4CD                  (    forth6809.asm):03936         EMITWT:  LDB   OUTHEAD
                      (    forth6809.asm):03937                  INCB
                      (    forth6809.asm):03938                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03939                  CMPB  OUTTAIL
                      (    forth6809.asm):03940                  BEQ   EMITWT
                      (    forth6809.asm):03941                  LDX   #OUTBUF
                      (    forth6809.asm):03942                  LDB   OUTHEAD
                      (    forth6809.asm):03943                  LDA   EMITCH
                      (    forth6809.asm):03944                  STA   B,X
                      (    forth6809.asm):03945                  INCB
                      (    forth6809.asm):03946                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03947                  STB   OUTHEAD
                      (    forth6809.asm):03948                  TST   RTSSTATE
                      (    forth6809.asm):03949                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03950                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03951                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03952                                         ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03953                  LDA   #CR_RXTX
                      (    forth6809.asm):03954                  STA   ACIACR
E4CD                  (    forth6809.asm):03955         EMITNORTS: RTS
                      (    forth6809.asm):03956         
E4CD                  (    forth6809.asm):03957         EMIT:
                      (    forth6809.asm):03958                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03959                     TFR   B,A               
                      (    forth6809.asm):03960                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03961                     RTS                     
                      (    forth6809.asm):03962         
                      (    forth6809.asm):03963                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):03964         ; ------------------------------------------------------------
                      (    forth6809.asm):03965         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03966         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03967         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03968         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03969         ; directly against ACIASR.
                      (    forth6809.asm):03970         ;
                      (    forth6809.asm):03971         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03972         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03973         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03974         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03975         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03976         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03977         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03978         ; ------------------------------------------------------------
E4CD                  (    forth6809.asm):03979         KEY:
E4CD B6C008           (    forth6809.asm):03980                  LDA   ACIASR
E4D0 8501             (    forth6809.asm):03981                  BITA  #SR_RDRF
E4D2 2705             (    forth6809.asm):03982                  BEQ   KWAIT
E4D4 7C017F           (    forth6809.asm):03983                  INC   POLLREADYCNT   ; character was already queued when we
E4D7 2007             (    forth6809.asm):03984                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E4D9                  (    forth6809.asm):03985         KWAIT:
E4D9 B6C008           (    forth6809.asm):03986         KSPIN:   LDA   ACIASR
E4DC 8501             (    forth6809.asm):03987                  BITA  #SR_RDRF
E4DE 27F9             (    forth6809.asm):03988                  BEQ   KSPIN
E4E0                  (    forth6809.asm):03989         KGOTSTAT:                     ; A holds the status byte exactly as it was

                      (    forth6809.asm):04300         ; ============================================================
                      (    forth6809.asm):04301         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04302         ; ============================================================
                      (    forth6809.asm):04303                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04304         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04305         
                      (    forth6809.asm):04306         ; ------------------------------------------------------------
                      (    forth6809.asm):04307         ; KEY  ( -- char )
                      (    forth6809.asm):04308         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04309         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04310         ; ------------------------------------------------------------
DD3B                  (    forth6809.asm):04311         KEYW:
                      (    forth6809.asm):04312         
DD3B 7D0178           (    forth6809.asm):04313                     TST   RTSSTATE          ; Is throttling?
DD3E 2703             (    forth6809.asm):04314                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04315         
                      (    forth6809.asm):04316                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
DD40 BDD2CE           (    forth6809.asm):04317                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04318                                             ; by transmitting all chars.
                      (    forth6809.asm):04319         
DD43                  (    forth6809.asm):04320         TRY_READ:
DD43 BDD33B           (    forth6809.asm):04321                     JSR   GETCHAR           ; Is char available in input buffer.
DD46 25F3             (    forth6809.asm):04322                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04323                                             ; while still transmitting!
                      (    forth6809.asm):04324         
DD48 1F89             (    forth6809.asm):04325                     TFR   A,B               ; Move char result to Reg B (LSB of D)
DD4A 4F               (    forth6809.asm):04326                     CLRA                    ; Clear MSB.
DD4B 3606             (    forth6809.asm):04327                     PSHU  D                 ; char
                      (    forth6809.asm):04328         
DD4D 39               (    forth6809.asm):04329                     RTS
                      (    forth6809.asm):04330         
                      (    forth6809.asm):04331         ; ------------------------------------------------------------
                      (    forth6809.asm):04332         ; KEY?  ( -- flag )

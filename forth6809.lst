                      (    forth6809.asm):22773                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):22774                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):22775                                  ; excluded the test framework, meaning
                      (    forth6809.asm):22776                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):22777                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):22778                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):22779                                  ; the code overflowing into VECTORS whenever

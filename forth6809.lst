C295 3610             (    forth6809.asm):12060                    PSHU  X
C297 CC0008           (    forth6809.asm):12061                    LDD   #8
C29A 3606             (    forth6809.asm):12062                    PSHU  D
C29C BDF60B           (    forth6809.asm):12063                    JSR   TYPE

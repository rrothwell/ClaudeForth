F592                  (    forth6809.asm):16846         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):16847                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):16848                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):16849                                   ; characters and (worse) shared identically
                      (    forth6809.asm):16850                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):16851                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):16852                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):16853                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):16854                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):16855                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):16856                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):16857                                   ; testing/design decision: rather than give
                      (    forth6809.asm):16858                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):16859                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):16860                                   ; definition for stable storage instead - but
                      (    forth6809.asm):16861                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):16862                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):16863                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):16864                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):16865                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):16866                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):16867                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):16868                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):16869                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):16870                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):16871                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):16872                   JSR  PADW
F595 3710             (    forth6809.asm):16873                   PULU X

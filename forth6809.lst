                      (    forth6809.asm):06532         ; TSTUNLOOP - unit test for UNLOOP. A true no-op (bare RTS) per
                      (    forth6809.asm):06533         ; its own extensively-documented design history in the source -
                      (    forth6809.asm):06534         ; superseded by EXIT's own automatic frame-discarding, kept
                      (    forth6809.asm):06535         ; only for source compatibility. Not compile-time/immediate
                      (    forth6809.asm):06536         ; like the rest of this section - a plain runtime word, tested
                      (    forth6809.asm):06537         ; directly without the compile harness, same pattern as ALIGN's
                      (    forth6809.asm):06538         ; own test in section 3.6: pushes decoy values, calls UNLOOP,
                      (    forth6809.asm):06539         ; confirms the whole stack is genuinely undisturbed.
                      (    forth6809.asm):06540         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):06541         TSTUNLOOP: STU  TSTU0
                      (    forth6809.asm):06542         
                      (    forth6809.asm):06543                    LDD  #TSTGUARD
                      (    forth6809.asm):06544                    PSHU D
                      (    forth6809.asm):06545                    LDD  #TSTVAL1
                      (    forth6809.asm):06546                    PSHU D
                      (    forth6809.asm):06547                    LDD  #TSTVAL2
                      (    forth6809.asm):06548                    PSHU D
                      (    forth6809.asm):06549                    STU  TSTUB4
                      (    forth6809.asm):06550         
                      (    forth6809.asm):06551                    JSR  UNLOOP
                      (    forth6809.asm):06552         
                      (    forth6809.asm):06553                    STU  TSTUAF
                      (    forth6809.asm):06554         
                      (    forth6809.asm):06555                    PULU D
                      (    forth6809.asm):06556                    CMPD #TSTVAL2
                      (    forth6809.asm):06557                    BNE  UOFAIL
                      (    forth6809.asm):06558                    PULU D
                      (    forth6809.asm):06559                    CMPD #TSTVAL1
                      (    forth6809.asm):06560                    BNE  UOFAIL
                      (    forth6809.asm):06561                    PULU D
                      (    forth6809.asm):06562                    CMPD #TSTGUARD
                      (    forth6809.asm):06563                    BNE  UOFAIL
                      (    forth6809.asm):06564         
                      (    forth6809.asm):06565                    LDD  TSTUB4
                      (    forth6809.asm):06566                    SUBD TSTUAF
                      (    forth6809.asm):06567                    CMPD #0
                      (    forth6809.asm):06568                    BNE  UOFAIL
                      (    forth6809.asm):06569         
                      (    forth6809.asm):06570                    LDD  #TRUEV
                      (    forth6809.asm):06571                    BRA  UODONE
C1F2                  (    forth6809.asm):06572         UOFAIL:    LDD  #FALSEV
C1F2                  (    forth6809.asm):06573         UODONE:    LDX  #TSTUNLOOPNAME
                      (    forth6809.asm):06574                    PSHU X
                      (    forth6809.asm):06575                    PSHU D
                      (    forth6809.asm):06576                    JSR  TSTREPORT
                      (    forth6809.asm):06577         
                      (    forth6809.asm):06578                    LDU  TSTU0
                      (    forth6809.asm):06579                    RTS
                      (    forth6809.asm):06580         
C1F2                  (    forth6809.asm):06581         TSTUNLOOPNAME: FCB  9
                      (    forth6809.asm):06582                        FCC  "TSTUNLOOP"
                      (    forth6809.asm):06583         

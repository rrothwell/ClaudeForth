F592                  (    forth6809.asm):10065         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):10066                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):10067                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):10068                                   ; characters and (worse) shared identically
                      (    forth6809.asm):10069                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):10070                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):10071                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):10072                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):10073                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):10074                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):10075                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):10076                                   ; testing/design decision: rather than give
                      (    forth6809.asm):10077                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):10078                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):10079                                   ; definition for stable storage instead - but
                      (    forth6809.asm):10080                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):10081                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):10082                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):10083                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):10084                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):10085                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):10086                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):10087                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):10088                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):10089                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):10090                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):10091                   JSR  PADW
F595 3710             (    forth6809.asm):10092                   PULU X

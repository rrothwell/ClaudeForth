                      (    forth6809.asm):02574         ; ------------------------------------------------------------
                      (    forth6809.asm):02575         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02576         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02577         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02578         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02579         ; ------------------------------------------------------------

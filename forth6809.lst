                      (    forth6809.asm):01816         ;    Inputs:
                      (    forth6809.asm):01817         ;        none
                      (    forth6809.asm):01818         ;    Outputs:
                      (    forth6809.asm):01819         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):01820         ;        Carry clear = character returned, set = ring empty

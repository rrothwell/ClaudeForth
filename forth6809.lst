                      (    forth6809.asm):02304         
                      (    forth6809.asm):02305         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02306         ; priming the pump by transmitting a character.
CEDB                  (    forth6809.asm):02307         CHK_INT_PATH:
CEDB 7D017B           (    forth6809.asm):02308                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
CEDE 2619             (    forth6809.asm):02309                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02310         
                      (    forth6809.asm):02311                                             ; No! Restart.
CEE0 8E01C0           (    forth6809.asm):02312                     LDX   #OUTBUF           ; Pull character from the out buffer.
CEE3 F6017A           (    forth6809.asm):02313                     LDB   OUTTAIL
CEE6 A685             (    forth6809.asm):02314                     LDA   B,X

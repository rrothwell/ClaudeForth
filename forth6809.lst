                      (    forth6809.asm):07519         ; ============================================================
                      (    forth6809.asm):07520         ; ------------------------------------------------------------
                      (    forth6809.asm):07521         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):07522         ; address and length and skip over it.
                      (    forth6809.asm):07523         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):07524         ;    Inputs:
                      (    forth6809.asm):07525         ;        return address on S points at the count byte
                      (    forth6809.asm):07526         ;    Outputs:
                      (    forth6809.asm):07527         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):07528         ;        string
                      (    forth6809.asm):07529         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07530         ; ------------------------------------------------------------
E8B0 3510             (    forth6809.asm):07531         DOSTR:      PULS  X
E8B2 E684             (    forth6809.asm):07532                     LDB   ,X
E8B4 3001             (    forth6809.asm):07533                     LEAX  1,X
E8B6 3610             (    forth6809.asm):07534                     PSHU  X
E8B8 4F               (    forth6809.asm):07535                     CLRA
E8B9 3606             (    forth6809.asm):07536                     PSHU  D
E8BB 3085             (    forth6809.asm):07537                     LEAX  B,X
E8BD 3410             (    forth6809.asm):07538                     PSHS  X
E8BF 39               (    forth6809.asm):07539                     RTS
                      (    forth6809.asm):07540         
                      (    forth6809.asm):07541         ; ------------------------------------------------------------
                      (    forth6809.asm):07542         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07543         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07544         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07545         ; PARSEQUOTE
                      (    forth6809.asm):07546         ;    Inputs:
                      (    forth6809.asm):07547         ;        none (parses from >IN)
                      (    forth6809.asm):07548         ;    Outputs:
                      (    forth6809.asm):07549         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07550         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07551         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07552         ; ------------------------------------------------------------
E8C0 CC0022           (    forth6809.asm):07553         PARSEQUOTE: LDD   #34
E8C3 3606             (    forth6809.asm):07554                     PSHU  D
E8C5 BDEA96           (    forth6809.asm):07555                     JSR   PARSEW
E8C8 6DC4             (    forth6809.asm):07556                     TST   ,U                ; high byte of the length
E8CA 2601             (    forth6809.asm):07557                     BNE   PQLONG
E8CC 39               (    forth6809.asm):07558                     RTS
E8CD CCFFEE           (    forth6809.asm):07559         PQLONG:     LDD   #-18
E8D0 3606             (    forth6809.asm):07560                     PSHU  D
E8D2 7EDA44           (    forth6809.asm):07561                     JMP   THROWW
                      (    forth6809.asm):07562         
                      (    forth6809.asm):07563         ; ------------------------------------------------------------
                      (    forth6809.asm):07564         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07565         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07566         ;    Inputs:
                      (    forth6809.asm):07567         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07568         ;        c-addr u on the data stack
                      (    forth6809.asm):07569         ;    Outputs:
                      (    forth6809.asm):07570         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07571         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07572         ; ------------------------------------------------------------
E8D5 3606             (    forth6809.asm):07573         CSTRCOMP:   PSHU  D
E8D7 BDDE7F           (    forth6809.asm):07574                     JSR   CCALL
E8DA 3706             (    forth6809.asm):07575                     PULU  D                 ; u
E8DC 3720             (    forth6809.asm):07576                     PULU  Y                 ; c-addr
E8DE 9E08             (    forth6809.asm):07577                     LDX   CODEHERE
E8E0 E780             (    forth6809.asm):07578                     STB   ,X+
E8E2 5D               (    forth6809.asm):07579                     TSTB
E8E3 2707             (    forth6809.asm):07580                     BEQ   CSEND
E8E5 A6A0             (    forth6809.asm):07581         CSCPY:      LDA   ,Y+
E8E7 A780             (    forth6809.asm):07582                     STA   ,X+
E8E9 5A               (    forth6809.asm):07583                     DECB
E8EA 26F9             (    forth6809.asm):07584                     BNE   CSCPY
E8EC 9F08             (    forth6809.asm):07585         CSEND:      STX   CODEHERE
E8EE 39               (    forth6809.asm):07586                     RTS
                      (    forth6809.asm):07587         
                      (    forth6809.asm):07588         ; ------------------------------------------------------------
                      (    forth6809.asm):07589         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07590         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07591         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07592         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07593         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07594         ; ------------------------------------------------------------
E8EF BDE8C0           (    forth6809.asm):07595         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
E8F2 DC00             (    forth6809.asm):07596         SQSTATE:    LDD   STATE
E8F4 2706             (    forth6809.asm):07597                     BEQ   SQINTERP
E8F6 CCE8B0           (    forth6809.asm):07598                     LDD   #DOSTR
E8F9 7EE8D5           (    forth6809.asm):07599                     JMP   CSTRCOMP
                      (    forth6809.asm):07600         
                      (    forth6809.asm):07601                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):07602                     ; SQUOTEW.2.
E8FC                  (    forth6809.asm):07603         SQINTERP:
E8FC BDD194           (    forth6809.asm):07604                     JSR   PADW
E8FF 3710             (    forth6809.asm):07605                     PULU  X                 ; PAD
E901 3706             (    forth6809.asm):07606                     PULU  D                 ; u
E903 3720             (    forth6809.asm):07607                     PULU  Y                 ; c-addr
E905 3610             (    forth6809.asm):07608                     PSHU  X                 ; result c-addr
E907 3606             (    forth6809.asm):07609                     PSHU  D                 ; result u
E909 5D               (    forth6809.asm):07610                     TSTB
E90A 2707             (    forth6809.asm):07611                     BEQ   SQIEND
E90C A6A0             (    forth6809.asm):07612         SQICPY:     LDA   ,Y+
E90E A780             (    forth6809.asm):07613                     STA   ,X+
E910 5A               (    forth6809.asm):07614                     DECB
E911 26F9             (    forth6809.asm):07615                     BNE   SQICPY
E913 39               (    forth6809.asm):07616         SQIEND:     RTS
                      (    forth6809.asm):07617         
                      (    forth6809.asm):07618         ; ------------------------------------------------------------
                      (    forth6809.asm):07619         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07620         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07621         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07622         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07623         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07624         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07625         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07626         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07627         ; A result over 255 characters throws -18.

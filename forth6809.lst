                      (    forth6809.asm):11825                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):11826                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):11827                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):11828                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):11829                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):11830                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):11831                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):11832                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):11833                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):11834                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):11835                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):11836                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):11837                  ; for it.
E591 D621             (    forth6809.asm):11838                  LDB   CNTREM
E593 5A               (    forth6809.asm):11839                  DECB
E594 A685             (    forth6809.asm):11840                  LDA   B,X
E596 812E             (    forth6809.asm):11841                  CMPA  #'.'
E598 2604             (    forth6809.asm):11842                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):11843                  DEC   CNTREM
E59C 2766             (    forth6809.asm):11844                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):11845         
E59E 0F22             (    forth6809.asm):11846         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):11847                  LDA   ,X
E5A2 812D             (    forth6809.asm):11848                  CMPA  #'-'
E5A4 2608             (    forth6809.asm):11849                  BNE   NQNOSIGN2
E5A6 0322             (    forth6809.asm):11850                  COM   NUMNEG
E5A8 3001             (    forth6809.asm):11851                  LEAX  1,X
E5AA 0A21             (    forth6809.asm):11852                  DEC   CNTREM
E5AC 2756             (    forth6809.asm):11853                  BEQ   NQBAD
                      (    forth6809.asm):11854         

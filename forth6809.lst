                      (    forth6809.asm):00412         ; ------------------------------------------------------------
                      (    forth6809.asm):00413         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00414         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00415         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00416         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00417         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00418         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00419         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00420         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00421         ;
                      (    forth6809.asm):00422         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00423         ;     FILLCNT  EQU MVCNT   - FILL's remaining-byte count
                      (    forth6809.asm):00424         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00425         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00426         ;     FILLADDR EQU MVDST   - FILL's target address
                      (    forth6809.asm):00427         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00428         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00429         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00430         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00431         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00432         ; ------------------------------------------------------------
                      (    forth6809.asm):00433                  ORG   $0100
0100                  (    forth6809.asm):00434         MVCNT      RMB   2
0102                  (    forth6809.asm):00435         MVDST      RMB   2
0104                  (    forth6809.asm):00436         MVSRC      RMB   2
     0100             (    forth6809.asm):00437         FILLCNT  EQU  MVCNT
     0100             (    forth6809.asm):00438         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00439         FILLADDR EQU  MVDST
     0102             (    forth6809.asm):00440         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00441         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00442         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00443         

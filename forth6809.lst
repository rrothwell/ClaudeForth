                      (    forth6809.asm):04013                    JSR   TSTRSH
                      (    forth6809.asm):04014                    JSR   TSTCELS
                      (    forth6809.asm):04015                    JSR   TSTCELP
                      (    forth6809.asm):04016                    JSR   TSTCHRS
                      (    forth6809.asm):04017                    JSR   TSTCHRP
                      (    forth6809.asm):04018                    JSR   TSTALGD

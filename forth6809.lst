                      (    forth6809.asm):06342         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06343         ; address and length and skip over it.
                      (    forth6809.asm):06344         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06345         ;    Inputs:
                      (    forth6809.asm):06346         ;        return address on S points at the count byte
                      (    forth6809.asm):06347         ;    Outputs:
                      (    forth6809.asm):06348         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06349         ;        string
                      (    forth6809.asm):06350         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06351         ; ------------------------------------------------------------
F443 3510             (    forth6809.asm):06352         DOSTR:      PULS  X
F445 E684             (    forth6809.asm):06353                     LDB   ,X

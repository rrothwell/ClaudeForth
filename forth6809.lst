                      (    forth6809.asm):01494         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):01495         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):01496         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):01497         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):01498         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):01499         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):01500         ; one copy pushed).
                      (    forth6809.asm):01501         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):01502         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):01503         
                      (    forth6809.asm):01504                    LDD   #TSTGUARD
                      (    forth6809.asm):01505                    PSHU  D
                      (    forth6809.asm):01506                    LDD   #TSTVAL1
                      (    forth6809.asm):01507                    PSHU  D
                      (    forth6809.asm):01508                    LDD   #TSTVAL2
                      (    forth6809.asm):01509                    PSHU  D
                      (    forth6809.asm):01510                    LDD   #TSTVAL3
                      (    forth6809.asm):01511                    PSHU  D
                      (    forth6809.asm):01512                    LDD   #2
                      (    forth6809.asm):01513                    PSHU  D
                      (    forth6809.asm):01514                    STU   TSTUB4
                      (    forth6809.asm):01515         
                      (    forth6809.asm):01516                    JSR   PICK
                      (    forth6809.asm):01517         
                      (    forth6809.asm):01518                    STU   TSTUAF
                      (    forth6809.asm):01519         
                      (    forth6809.asm):01520                    PULU  D
                      (    forth6809.asm):01521                    CMPD  #TSTVAL1
                      (    forth6809.asm):01522                    BNE   PKFAIL
                      (    forth6809.asm):01523                    PULU  D
                      (    forth6809.asm):01524                    CMPD  #TSTVAL3
                      (    forth6809.asm):01525                    BNE   PKFAIL
                      (    forth6809.asm):01526                    PULU  D
                      (    forth6809.asm):01527                    CMPD  #TSTVAL2
                      (    forth6809.asm):01528                    BNE   PKFAIL
                      (    forth6809.asm):01529                    PULU  D
                      (    forth6809.asm):01530                    CMPD  #TSTVAL1
                      (    forth6809.asm):01531                    BNE   PKFAIL
                      (    forth6809.asm):01532                    PULU  D
                      (    forth6809.asm):01533                    CMPD  #TSTGUARD
                      (    forth6809.asm):01534                    BNE   PKFAIL
                      (    forth6809.asm):01535         
                      (    forth6809.asm):01536                    LDD   TSTUB4
                      (    forth6809.asm):01537                    SUBD  TSTUAF
                      (    forth6809.asm):01538                    CMPD  #0
                      (    forth6809.asm):01539                    BNE   PKFAIL
                      (    forth6809.asm):01540         
                      (    forth6809.asm):01541                    LDD   #TRUEV
                      (    forth6809.asm):01542                    BRA   PKDONE
C15E                  (    forth6809.asm):01543         PKFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):01544         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):01545                    PSHU  X
                      (    forth6809.asm):01546                    PSHU  D
                      (    forth6809.asm):01547                    JSR   TSTREPORT
                      (    forth6809.asm):01548         
                      (    forth6809.asm):01549                    LDU   TSTU0
                      (    forth6809.asm):01550                    RTS
                      (    forth6809.asm):01551         
C15E                  (    forth6809.asm):01552         TSTPICKNAME: FCB  7
                      (    forth6809.asm):01553                      FCC  "TSTPICK"
                      (    forth6809.asm):01554         
                      (    forth6809.asm):01555         ; ------------------------------------------------------------
                      (    forth6809.asm):01556         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):01557         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):01558         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):01559         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):01560         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):01561         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):01562         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):01563         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):01564         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):01565         TSTROLL:   STU   TSTU0
                      (    forth6809.asm):01566         
                      (    forth6809.asm):01567                    LDD   #TSTGUARD
                      (    forth6809.asm):01568                    PSHU  D
                      (    forth6809.asm):01569                    LDD   #TSTVAL1
                      (    forth6809.asm):01570                    PSHU  D
                      (    forth6809.asm):01571                    LDD   #TSTVAL2
                      (    forth6809.asm):01572                    PSHU  D
                      (    forth6809.asm):01573                    LDD   #TSTVAL3
                      (    forth6809.asm):01574                    PSHU  D
                      (    forth6809.asm):01575                    LDD   #2
                      (    forth6809.asm):01576                    PSHU  D
                      (    forth6809.asm):01577                    STU   TSTUB4
                      (    forth6809.asm):01578         
                      (    forth6809.asm):01579                    JSR   ROLL
                      (    forth6809.asm):01580         
                      (    forth6809.asm):01581                    STU   TSTUAF
                      (    forth6809.asm):01582         
                      (    forth6809.asm):01583                    PULU  D
                      (    forth6809.asm):01584                    CMPD  #TSTVAL1
                      (    forth6809.asm):01585                    BNE   RLFAIL
                      (    forth6809.asm):01586                    PULU  D
                      (    forth6809.asm):01587                    CMPD  #TSTVAL3
                      (    forth6809.asm):01588                    BNE   RLFAIL
                      (    forth6809.asm):01589                    PULU  D
                      (    forth6809.asm):01590                    CMPD  #TSTVAL2
                      (    forth6809.asm):01591                    BNE   RLFAIL
                      (    forth6809.asm):01592                    PULU  D
                      (    forth6809.asm):01593                    CMPD  #TSTGUARD
                      (    forth6809.asm):01594                    BNE   RLFAIL
                      (    forth6809.asm):01595         
                      (    forth6809.asm):01596                    LDD   TSTUB4
                      (    forth6809.asm):01597                    SUBD  TSTUAF
                      (    forth6809.asm):01598                    CMPD  #-2
                      (    forth6809.asm):01599                    BNE   RLFAIL
                      (    forth6809.asm):01600         
                      (    forth6809.asm):01601                    LDD   #TRUEV
                      (    forth6809.asm):01602                    BRA   RLDONE
C15E                  (    forth6809.asm):01603         RLFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):01604         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):01605                    PSHU  X
                      (    forth6809.asm):01606                    PSHU  D
                      (    forth6809.asm):01607                    JSR   TSTREPORT
                      (    forth6809.asm):01608         
                      (    forth6809.asm):01609                    LDU   TSTU0
                      (    forth6809.asm):01610                    RTS
                      (    forth6809.asm):01611         
C15E                  (    forth6809.asm):01612         TSTROLLNAME: FCB  7
                      (    forth6809.asm):01613                      FCC  "TSTROLL"
                      (    forth6809.asm):01614         
                      (    forth6809.asm):01615         ; ------------------------------------------------------------

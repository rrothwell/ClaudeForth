                      (    forth6809.asm):01048                    PULU  D
                      (    forth6809.asm):01049                    CMPD  #TSTGUARD
                      (    forth6809.asm):01050                    BNE   QNFAIL
                      (    forth6809.asm):01051         
                      (    forth6809.asm):01052                    LDD   TSTUB4
                      (    forth6809.asm):01053                    SUBD  TSTUAF
                      (    forth6809.asm):01054                    CMPD  #2
                      (    forth6809.asm):01055                    BNE   QNFAIL
                      (    forth6809.asm):01056         
                      (    forth6809.asm):01057                    LDD   #TRUEV
                      (    forth6809.asm):01058                    BRA   QNDONE
C100                  (    forth6809.asm):01059         QNFAIL:    LDD   #FALSEV

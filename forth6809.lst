F5D9                  (    forth6809.asm):05516         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):05517                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):05518                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):05519                                   ; characters and (worse) shared identically
                      (    forth6809.asm):05520                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):05521                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):05522                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):05523                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):05524                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):05525                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):05526                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):05527                                   ; testing/design decision: rather than give
                      (    forth6809.asm):05528                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):05529                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):05530                                   ; definition for stable storage instead - but
                      (    forth6809.asm):05531                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):05532                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):05533                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):05534                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):05535                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):05536                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):05537                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):05538                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):05539                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):05540                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):05541                                   ; the GLOBALS layout notes above).
F5D9 BDE0B6           (    forth6809.asm):05542                   JSR  PADW

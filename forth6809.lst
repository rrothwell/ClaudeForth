                      (    forth6809.asm):01023         ; TSTQDUPNZ - unit test for ?DUP ( n -- n n | 0 ), nonzero case.
                      (    forth6809.asm):01024         ; Verifies the nonzero value is duplicated, the guard beneath is
                      (    forth6809.asm):01025         ; undisturbed, and exactly one cell was added - same as DUP's
                      (    forth6809.asm):01026         ; own behavior for this case. ?DUP needs two tests, one per
                      (    forth6809.asm):01027         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01028         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01029         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01030         TSTQDUPNZ: STU   TSTU0
                      (    forth6809.asm):01031         

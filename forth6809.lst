F750 2715             (    forth6809.asm):06682                    BEQ  UEDONE
F752 A680             (    forth6809.asm):06683                    LDA  ,X+
F754 8125             (    forth6809.asm):06684                    CMPA #'%'
F756 2604             (    forth6809.asm):06685                    BNE  UENOTPCT
F758 C625             (    forth6809.asm):06686                    LDB  #'%'      ; write the extra '%' first - the character
F75A E7A0             (    forth6809.asm):06687                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06688                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06689                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06690                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06691                                   ; independently for each one the loop visits.
F75C A7A0             (    forth6809.asm):06692         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06693                                   ; every character, '%' or not
F75E DCA9             (    forth6809.asm):06694                    LDD  UESRCLEN
F760 830001           (    forth6809.asm):06695                    SUBD #1
F763 DDA9             (    forth6809.asm):06696                    STD  UESRCLEN
F765 20E7             (    forth6809.asm):06697                    BRA  UELOOP
F767 1F20             (    forth6809.asm):06698         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F769 93AB             (    forth6809.asm):06699                    SUBD UEDST     ; overwriting whatever was left on top of
F76B DDAD             (    forth6809.asm):06700                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06701                                   ; required return values, and separately,
                      (    forth6809.asm):06702                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06703                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06704                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06705                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06706                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06707                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06708                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06709                                   ; correct regardless of how many characters
                      (    forth6809.asm):06710                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06711                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06712                                   ; incremented alongside it.
F76D DCAB             (    forth6809.asm):06713                    LDD  UEDST

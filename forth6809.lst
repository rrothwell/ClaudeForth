E3E9 ED44             (    forth6809.asm):05699                     STD   4,U
E3EB 39               (    forth6809.asm):05700                     RTS
                      (    forth6809.asm):05701         
                      (    forth6809.asm):05702         ; ------------------------------------------------------------
                      (    forth6809.asm):05703         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05704         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05705         ; ------------------------------------------------------------
E3EC EC46             (    forth6809.asm):05706         DOVERW:     LDD   6,U               ; x1
E3EE AE44             (    forth6809.asm):05707                     LDX   4,U               ; x2
E3F0 3606             (    forth6809.asm):05708                     PSHU  D
E3F2 3610             (    forth6809.asm):05709                     PSHU  X
E3F4 39               (    forth6809.asm):05710                     RTS
                      (    forth6809.asm):05711         
                      (    forth6809.asm):05712         ; ------------------------------------------------------------
                      (    forth6809.asm):05713         ; NIP  ( x1 x2 -- x2 )
                      (    forth6809.asm):05714         ; Discard the second cell.

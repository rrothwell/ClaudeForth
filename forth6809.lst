                      (    forth6809.asm):06219         ; /  ( n1 n2 -- n3 )
                      (    forth6809.asm):06220         ; Quotient of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):06221         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):06222         ; zero.

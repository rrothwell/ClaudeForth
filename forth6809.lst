                      (    forth6809.asm):06998         ; Compile DOCSTR followed by the string up to the closing quote as a
                      (    forth6809.asm):06999         ; counted string. THROW -14 if not compiling.
                      (    forth6809.asm):07000         ; ------------------------------------------------------------

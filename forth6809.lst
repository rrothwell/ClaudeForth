                      (    forth6809.asm):07734         ; ------------------------------------------------------------
                      (    forth6809.asm):07735         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):07736         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):07737         ; low byte of BASE is used.
                      (    forth6809.asm):07738         ; UDDIGIT

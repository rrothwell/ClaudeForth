                      (    forth6809.asm):03925         ; ------------------------------------------------------------
                      (    forth6809.asm):03926         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03927         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03928         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03929         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03930         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03931         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03932         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03933         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03934         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03935         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03936         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03937         ; ------------------------------------------------------------
C1CA BDFC2B           (    forth6809.asm):03938         TSTDARITH: JSR   CRW
C1CD 8EC1DE           (    forth6809.asm):03939                    LDX   #TSTDARITHMSG
C1D0 3610             (    forth6809.asm):03940                    PSHU  X
C1D2 CC000B           (    forth6809.asm):03941                    LDD   #11
C1D5 3606             (    forth6809.asm):03942                    PSHU  D
C1D7 BDF60B           (    forth6809.asm):03943                    JSR   TYPE
C1DA BDFC2B           (    forth6809.asm):03944                    JSR   CRW
                      (    forth6809.asm):03945         
                      (    forth6809.asm):03946                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03947         
                      (    forth6809.asm):03948                    JSR   TSTUMST
                      (    forth6809.asm):03949                    JSR   TSTUMSM
                      (    forth6809.asm):03950                    JSR   TSTUMSZ
                      (    forth6809.asm):03951                    JSR   TSTMSTAR
                      (    forth6809.asm):03952                    JSR   TSTFMSM
                      (    forth6809.asm):03953                    JSR   TSTFMSZ
                      (    forth6809.asm):03954                    JSR   TSTSMRM
                      (    forth6809.asm):03955                    JSR   TSTSMRZ
                      (    forth6809.asm):03956                    JSR   TSTDPLUS
                      (    forth6809.asm):03957                    JSR   TSTDMIN2
                      (    forth6809.asm):03958                    JSR   TSTDNEG
                      (    forth6809.asm):03959                    JSR   TSTDABS1
                      (    forth6809.asm):03960                    JSR   TSTDABS2
                      (    forth6809.asm):03961                    JSR   TSTMPLUS
                      (    forth6809.asm):03962                    JSR   TSTSTOD
                      (    forth6809.asm):03963                    JSR   TSTDTOS
                      (    forth6809.asm):03964                    JSR   TSTDMAX
                      (    forth6809.asm):03965                    JSR   TSTDMIN
                      (    forth6809.asm):03966         
                      (    forth6809.asm):03967                    ENDC ; <<<<
                      (    forth6809.asm):03968         
C1DD 39               (    forth6809.asm):03969                    RTS
                      (    forth6809.asm):03970         

E9B9 A181             (    forth6809.asm):07578                     CMPA  ,X++
E9BB 26F8             (    forth6809.asm):07579                     BNE   SQEFND
E9BD A61F             (    forth6809.asm):07580                     LDA   -1,X
E9BF AE64             (    forth6809.asm):07581         SQEPUT:     LDX   4,S
E9C1 A780             (    forth6809.asm):07582                     STA   ,X+
E9C3 AF64             (    forth6809.asm):07583                     STX   4,S
E9C5 20CD             (    forth6809.asm):07584                     BRA   SQEL
E9C7 AE64             (    forth6809.asm):07585         SQEM:       LDX   4,S
E9C9 860D             (    forth6809.asm):07586                     LDA   #13
E9CB A780             (    forth6809.asm):07587                     STA   ,X+
E9CD 860A             (    forth6809.asm):07588                     LDA   #10
E9CF A780             (    forth6809.asm):07589                     STA   ,X+
E9D1 AF64             (    forth6809.asm):07590                     STX   4,S
E9D3 20BF             (    forth6809.asm):07591                     BRA   SQEL
E9D5 8D1A             (    forth6809.asm):07592         SQEHEX:     BSR   SQEHD             ; first digit
E9D7 25BB             (    forth6809.asm):07593                     BCS   SQEL              ; none: nothing is added

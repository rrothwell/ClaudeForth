                      (    forth6809.asm):11214         ; TSTCODEHERE - combined unit test for , C, ALLOT, and HERE
                      (    forth6809.asm):11215         ; together (glossary section 3.11's own CODEHERE-region words).
                      (    forth6809.asm):11216         ; Redirects CODEHERE to scratch and walks through a sequence:
                      (    forth6809.asm):11217         ; HERE reports the redirected value, COMMA appends a cell (and
                      (    forth6809.asm):11218         ; the written cell is verified directly, not just the advance),
                      (    forth6809.asm):11219         ; C, appends a byte (verified the same way), ALLOT reserves then
                      (    forth6809.asm):11220         ; releases bytes (confirming both directions work, matching
                      (    forth6809.asm):11221         ; "reserve (or release, if negative)"), and a final HERE
                      (    forth6809.asm):11222         ; confirms the cumulative result.
                      (    forth6809.asm):11223         ; ------------------------------------------------------------

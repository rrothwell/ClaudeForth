DE41 BDD0EA           (    forth6809.asm):05538                     JSR   CODECOMMA         ; x
DE44 39               (    forth6809.asm):05539                     RTS
                      (    forth6809.asm):05540         
                      (    forth6809.asm):05541         ; ------------------------------------------------------------
                      (    forth6809.asm):05542         ; 2LITERAL  ( x1 x2 -- )  IMMEDIATE
                      (    forth6809.asm):05543         ; Compile two LITs so that x1 x2 are pushed when the definition runs.
                      (    forth6809.asm):05544         ; ------------------------------------------------------------
DE45                  (    forth6809.asm):05545         TWOLITERALW:
DE45 3706             (    forth6809.asm):05546                     PULU  D                 ; x2
DE47 3406             (    forth6809.asm):05547                     PSHS  D
DE49 BDDE39           (    forth6809.asm):05548                     JSR   LITERALW          ; x1 first, so it lands below x2
DE4C 3506             (    forth6809.asm):05549                     PULS  D
DE4E 3606             (    forth6809.asm):05550                     PSHU  D
DE50 BDDE39           (    forth6809.asm):05551                     JSR   LITERALW
DE53 39               (    forth6809.asm):05552                     RTS
                      (    forth6809.asm):05553         
                      (    forth6809.asm):05554         ; ------------------------------------------------------------
                      (    forth6809.asm):05555         ; [']  ( "name" -- )
                      (    forth6809.asm):05556         ; Compile the xt of the next name as a literal. THROW -14 if not
                      (    forth6809.asm):05557         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05558         ; ------------------------------------------------------------
DE54 DC00             (    forth6809.asm):05559         BRACKTICKW: LDD   STATE
DE56 2608             (    forth6809.asm):05560                     BNE   BTSTOK
DE58 CCFFF2           (    forth6809.asm):05561                     LDD   #-14              ; -14
DE5B 3606             (    forth6809.asm):05562                     PSHU  D
DE5D BDD9F1           (    forth6809.asm):05563                     JSR   THROWW
DE60 CC0020           (    forth6809.asm):05564         BTSTOK:     LDD   #32
DE63 3606             (    forth6809.asm):05565                     PSHU  D
DE65 BDD493           (    forth6809.asm):05566                     JSR   WORDW
DE68 BDD57C           (    forth6809.asm):05567                     JSR   FINDW
DE6B 3706             (    forth6809.asm):05568                     PULU  D
DE6D 10830000         (    forth6809.asm):05569                     CMPD  #0
DE71 260A             (    forth6809.asm):05570                     BNE   BTOK
DE73 3706             (    forth6809.asm):05571                     PULU  D
DE75 CCFFF3           (    forth6809.asm):05572                     LDD   #-13              ; -13
DE78 3606             (    forth6809.asm):05573                     PSHU  D
DE7A BDD9F1           (    forth6809.asm):05574                     JSR   THROWW
DE7D BDDE39           (    forth6809.asm):05575         BTOK:       JSR   LITERALW
DE80 39               (    forth6809.asm):05576                     RTS
                      (    forth6809.asm):05577         
                      (    forth6809.asm):05578         ; ------------------------------------------------------------
                      (    forth6809.asm):05579         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):05580         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):05581         ; compile its xt as a literal followed by a call to COMPILE, so that
                      (    forth6809.asm):05582         ; it is compiled when the enclosing definition runs. THROW -14 if not
                      (    forth6809.asm):05583         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05584         ; ------------------------------------------------------------
DE81 DC00             (    forth6809.asm):05585         POSTPONEW:  LDD   STATE
DE83 2608             (    forth6809.asm):05586                     BNE   PPSTOK
DE85 CCFFF2           (    forth6809.asm):05587                     LDD   #-14              ; -14

C100                  (    forth6809.asm):09255         ISDONE:  LDX   #TSTISOFNAME
                      (    forth6809.asm):09256                  PSHU  X
                      (    forth6809.asm):09257                  PSHU  D
                      (    forth6809.asm):09258                  JSR   TSTREPORT

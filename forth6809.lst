FFB3 C600             (    forth6809.asm):07118                  LDB   #0
FFB5 6F80             (    forth6809.asm):07119         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):07120                  DECB
FFB8 26FB             (    forth6809.asm):07121                  BNE   CLRGLOB
                      (    forth6809.asm):07122         
FFBA 8E0106           (    forth6809.asm):07123                  LDX   #SERBUF
FFBD 6F80             (    forth6809.asm):07124                  CLR   ,X+
FFBF 6F84             (    forth6809.asm):07125                  CLR   ,X
                      (    forth6809.asm):07126         
FFC1 BDDE7A           (    forth6809.asm):07127                  JSR   INITSERIAL
                      (    forth6809.asm):07128         
FFC4 1CAF             (    forth6809.asm):07129                  ANDCC #$AF      ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07130                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07131                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07132                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07133                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07134                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07135                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07136                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07137                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07138                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07139                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07140                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07141                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07142                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07143                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07144                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07145                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07146                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07147                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07148                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07149                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07150                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07151                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07152                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07153                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07154                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07155                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07156                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07157                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07158                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07159                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07160                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07161                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07162                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07163                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07164                                  ; unused vectors).
                      (    forth6809.asm):07165         
                      (    forth6809.asm):07166                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07167                  JSR   TSTRUNNER
                      (    forth6809.asm):07168                  ELSE  ; <<<<<>>>>>
FFC6 12               (    forth6809.asm):07169                  NOP             ; BUG FIX (see the historical note above this
FFC7 12               (    forth6809.asm):07170                  NOP             ; call site's own comment, describing the
FFC8 12               (    forth6809.asm):07171                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07172                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07173                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07174                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07175                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07176                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07177                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07178                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07179                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07180                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07181                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07182                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07183                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07184                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07185         
FFC9 7EDF1D           (    forth6809.asm):07186                  JMP   COLD
                      (    forth6809.asm):07187         
FFCC 1A50             (    forth6809.asm):07188         WARM:    ORCC  #$50
FFCE 4F               (    forth6809.asm):07189                  CLRA
FFCF 1F8B             (    forth6809.asm):07190                  TFR   A,DP
FFD1 CEBD00           (    forth6809.asm):07191                  LDU   #SP0
FFD4 10CEC000         (    forth6809.asm):07192                  LDS   #RP0
FFD8 8EFFEA           (    forth6809.asm):07193                  LDX   #WARMMSG
FFDB 3610             (    forth6809.asm):07194                  PSHU  X
FFDD CC0006           (    forth6809.asm):07195                  LDD   #WARMMSGL

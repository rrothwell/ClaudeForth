                      (    forth6809.asm):06496         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06497         ; ============================================================
                      (    forth6809.asm):06498         ; ------------------------------------------------------------
                      (    forth6809.asm):06499         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06500         ; address and length and skip over it.
                      (    forth6809.asm):06501         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06502         ;    Inputs:
                      (    forth6809.asm):06503         ;        return address on S points at the count byte
                      (    forth6809.asm):06504         ;    Outputs:
                      (    forth6809.asm):06505         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06506         ;        string
                      (    forth6809.asm):06507         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06508         ; ------------------------------------------------------------
F3E7 3510             (    forth6809.asm):06509         DOSTR:      PULS  X
F3E9 E684             (    forth6809.asm):06510                     LDB   ,X
F3EB 3001             (    forth6809.asm):06511                     LEAX  1,X
F3ED 3610             (    forth6809.asm):06512                     PSHU  X
F3EF 4F               (    forth6809.asm):06513                     CLRA
F3F0 3606             (    forth6809.asm):06514                     PSHU  D
F3F2 3085             (    forth6809.asm):06515                     LEAX  B,X
F3F4 3410             (    forth6809.asm):06516                     PSHS  X
F3F6 39               (    forth6809.asm):06517                     RTS
                      (    forth6809.asm):06518         
                      (    forth6809.asm):06519         ; ------------------------------------------------------------
                      (    forth6809.asm):06520         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06521         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06522         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06523         ; PARSEQUOTE
                      (    forth6809.asm):06524         ;    Inputs:
                      (    forth6809.asm):06525         ;        none (parses from >IN)
                      (    forth6809.asm):06526         ;    Outputs:
                      (    forth6809.asm):06527         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06528         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06529         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06530         ; ------------------------------------------------------------
F3F7 CC0022           (    forth6809.asm):06531         PARSEQUOTE: LDD   #34
F3FA 3606             (    forth6809.asm):06532                     PSHU  D
F3FC BDF5CD           (    forth6809.asm):06533                     JSR   PARSEW
F3FF 6DC4             (    forth6809.asm):06534                     TST   ,U                ; high byte of the length
F401 2601             (    forth6809.asm):06535                     BNE   PQLONG
F403 39               (    forth6809.asm):06536                     RTS
F404 CCFFEE           (    forth6809.asm):06537         PQLONG:     LDD   #-18
F407 3606             (    forth6809.asm):06538                     PSHU  D
F409 7EE561           (    forth6809.asm):06539                     JMP   THROWW
                      (    forth6809.asm):06540         
                      (    forth6809.asm):06541         ; ------------------------------------------------------------
                      (    forth6809.asm):06542         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06543         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06544         ;    Inputs:
                      (    forth6809.asm):06545         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06546         ;        c-addr u on the data stack
                      (    forth6809.asm):06547         ;    Outputs:
                      (    forth6809.asm):06548         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06549         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06550         ; ------------------------------------------------------------
F40C 3606             (    forth6809.asm):06551         CSTRCOMP:   PSHU  D
F40E BDE99C           (    forth6809.asm):06552                     JSR   CCALL
F411 3706             (    forth6809.asm):06553                     PULU  D                 ; u
F413 3720             (    forth6809.asm):06554                     PULU  Y                 ; c-addr
F415 9E08             (    forth6809.asm):06555                     LDX   CODEHERE
F417 E780             (    forth6809.asm):06556                     STB   ,X+
F419 5D               (    forth6809.asm):06557                     TSTB
F41A 2707             (    forth6809.asm):06558                     BEQ   CSEND
F41C A6A0             (    forth6809.asm):06559         CSCPY:      LDA   ,Y+
F41E A780             (    forth6809.asm):06560                     STA   ,X+
F420 5A               (    forth6809.asm):06561                     DECB
F421 26F9             (    forth6809.asm):06562                     BNE   CSCPY
F423 9F08             (    forth6809.asm):06563         CSEND:      STX   CODEHERE
F425 39               (    forth6809.asm):06564                     RTS
                      (    forth6809.asm):06565         
                      (    forth6809.asm):06566         ; ------------------------------------------------------------
                      (    forth6809.asm):06567         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06568         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06569         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06570         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06571         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06572         ; ------------------------------------------------------------
F426 BDF3F7           (    forth6809.asm):06573         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F429 DC00             (    forth6809.asm):06574         SQSTATE:    LDD   STATE
F42B 2706             (    forth6809.asm):06575                     BEQ   SQINTERP
F42D CCF3E7           (    forth6809.asm):06576                     LDD   #DOSTR
F430 7EF40C           (    forth6809.asm):06577                     JMP   CSTRCOMP
                      (    forth6809.asm):06578         
                      (    forth6809.asm):06579                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06580                     ; SQUOTEW.2.
F433                  (    forth6809.asm):06581         SQINTERP:
F433 BDDF60           (    forth6809.asm):06582                     JSR   PADW
F436 3710             (    forth6809.asm):06583                     PULU  X                 ; PAD
F438 3706             (    forth6809.asm):06584                     PULU  D                 ; u
F43A 3720             (    forth6809.asm):06585                     PULU  Y                 ; c-addr
F43C 3610             (    forth6809.asm):06586                     PSHU  X                 ; result c-addr
F43E 3606             (    forth6809.asm):06587                     PSHU  D                 ; result u
F440 5D               (    forth6809.asm):06588                     TSTB
F441 2707             (    forth6809.asm):06589                     BEQ   SQIEND
F443 A6A0             (    forth6809.asm):06590         SQICPY:     LDA   ,Y+
F445 A780             (    forth6809.asm):06591                     STA   ,X+
F447 5A               (    forth6809.asm):06592                     DECB
F448 26F9             (    forth6809.asm):06593                     BNE   SQICPY
F44A 39               (    forth6809.asm):06594         SQIEND:     RTS
                      (    forth6809.asm):06595         
                      (    forth6809.asm):06596         ; ------------------------------------------------------------
                      (    forth6809.asm):06597         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06598         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):06599         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):06600         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):06601         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):06602         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):06603         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):06604         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):06605         ; A result over 255 characters throws -18.
                      (    forth6809.asm):06606         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):06607         ; ------------------------------------------------------------
F44B BDDF60           (    forth6809.asm):06608         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F44E ECC4             (    forth6809.asm):06609                     LDD   ,U
F450 3406             (    forth6809.asm):06610                     PSHS  D                 ; output pointer
F452 3406             (    forth6809.asm):06611                     PSHS  D                 ; output start
F454 DC39             (    forth6809.asm):06612                     LDD   SRCADDR
F456 D33B             (    forth6809.asm):06613                     ADDD  SRCLEN
F458 3406             (    forth6809.asm):06614                     PSHS  D                 ; input end
F45A DC39             (    forth6809.asm):06615                     LDD   SRCADDR
F45C D310             (    forth6809.asm):06616                     ADDD  TOIN
F45E 1F02             (    forth6809.asm):06617                     TFR   D,Y               ; input pointer
F460 10AC60           (    forth6809.asm):06618         SQEL:       CMPY  0,S
F463 247E             (    forth6809.asm):06619                     BHS   SQEND
F465 A6A0             (    forth6809.asm):06620                     LDA   ,Y+
F467 8122             (    forth6809.asm):06621                     CMPA  #34
F469 2778             (    forth6809.asm):06622                     BEQ   SQEND
F46B 815C             (    forth6809.asm):06623                     CMPA  #92
F46D 261C             (    forth6809.asm):06624                     BNE   SQEPUT
F46F 10AC60           (    forth6809.asm):06625                     CMPY  0,S
F472 246F             (    forth6809.asm):06626                     BHS   SQEND

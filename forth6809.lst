                      (    forth6809.asm):02333         ;        none
                      (    forth6809.asm):02334         ;    Outputs:
                      (    forth6809.asm):02335         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02336         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02337         ;    Registers: RegA, RegB, RegX and CC changed.

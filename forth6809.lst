                      (    forth6809.asm):17971                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):17972                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):17973                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):17974                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):17975                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):17976                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):17977                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):17978                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):17979                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):17980                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):17981                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):17982                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):17983                  ; for it.

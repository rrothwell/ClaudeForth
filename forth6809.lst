                      (    forth6809.asm):12567                       BRA  PZDONE
C2AB                  (    forth6809.asm):12568         PZFAIL:       LDD  #FALSEV
C2AB                  (    forth6809.asm):12569         PZDONE:       LDX  #TSTPNNAME
                      (    forth6809.asm):12570                       PSHU X
                      (    forth6809.asm):12571                       PSHU D
                      (    forth6809.asm):12572                       JSR  TSTREPORT
                      (    forth6809.asm):12573         
                      (    forth6809.asm):12574                       LDU  TSTU0
                      (    forth6809.asm):12575                       RTS
                      (    forth6809.asm):12576         
C2AB                  (    forth6809.asm):12577         TSTPNNAME: FCB  12
                      (    forth6809.asm):12578                    FCC  "TSTPARSENAME"
                      (    forth6809.asm):12579         
                      (    forth6809.asm):12580         ; ------------------------------------------------------------
                      (    forth6809.asm):12581         ; TSTSQUOTE1 - unit test for S", compiling-state case. Compiles
                      (    forth6809.asm):12582         ; a known 2-character string, then executes the result to
                      (    forth6809.asm):12583         ; confirm it genuinely pushes (addr len) with the correct
                      (    forth6809.asm):12584         ; content at addr - not just that the call returned two numbers.
                      (    forth6809.asm):12585         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):12586         TSTSQUOTE1: LDD  CODEHERE
                      (    forth6809.asm):12587                     STD  TSTCSAV
                      (    forth6809.asm):12588                     LDD  SRCADDR
                      (    forth6809.asm):12589                     STD  TSTSASAV
                      (    forth6809.asm):12590                     LDD  SRCLEN
                      (    forth6809.asm):12591                     STD  TSTSLSAV
                      (    forth6809.asm):12592                     LDD  TOIN
                      (    forth6809.asm):12593                     STD  TSTTISAV
                      (    forth6809.asm):12594                     LDD  STATE
                      (    forth6809.asm):12595                     STD  TSTSTSAV
                      (    forth6809.asm):12596         
                      (    forth6809.asm):12597                     LDA  #'H'
                      (    forth6809.asm):12598                     STA  TSTNAMEB
                      (    forth6809.asm):12599                     LDA  #'I'
                      (    forth6809.asm):12600                     STA  TSTNAMEB+1
                      (    forth6809.asm):12601                     LDA  #34
                      (    forth6809.asm):12602                     STA  TSTNAMEB+2
                      (    forth6809.asm):12603         
                      (    forth6809.asm):12604                     LDD  #TSTCBUF
                      (    forth6809.asm):12605                     STD  CODEHERE
                      (    forth6809.asm):12606                     LDD  #TSTNAMEB
                      (    forth6809.asm):12607                     STD  SRCADDR
                      (    forth6809.asm):12608                     LDD  #3
                      (    forth6809.asm):12609                     STD  SRCLEN
                      (    forth6809.asm):12610                     LDD  #0
                      (    forth6809.asm):12611                     STD  TOIN
                      (    forth6809.asm):12612                     LDD  #-1
                      (    forth6809.asm):12613                     STD  STATE
                      (    forth6809.asm):12614         
                      (    forth6809.asm):12615                     JSR  SQUOTE
                      (    forth6809.asm):12616         
                      (    forth6809.asm):12617                     LDD  #OPRTS
                      (    forth6809.asm):12618                     PSHU D
                      (    forth6809.asm):12619                     JSR  CCOMMA
                      (    forth6809.asm):12620         
                      (    forth6809.asm):12621                     LDD  TSTCSAV
                      (    forth6809.asm):12622                     STD  CODEHERE
                      (    forth6809.asm):12623                     LDD  TSTSASAV
                      (    forth6809.asm):12624                     STD  SRCADDR
                      (    forth6809.asm):12625                     LDD  TSTSLSAV
                      (    forth6809.asm):12626                     STD  SRCLEN
                      (    forth6809.asm):12627                     LDD  TSTTISAV
                      (    forth6809.asm):12628                     STD  TOIN
                      (    forth6809.asm):12629                     LDD  TSTSTSAV
                      (    forth6809.asm):12630                     STD  STATE
                      (    forth6809.asm):12631         
                      (    forth6809.asm):12632                     STU  TSTU0
                      (    forth6809.asm):12633         
                      (    forth6809.asm):12634                     LDD  #TSTGUARD
                      (    forth6809.asm):12635                     PSHU D
                      (    forth6809.asm):12636                     STU  TSTUB4
                      (    forth6809.asm):12637         
                      (    forth6809.asm):12638                     LDX  #TSTCBUF
                      (    forth6809.asm):12639                     JSR  ,X
                      (    forth6809.asm):12640         
                      (    forth6809.asm):12641                     STU  TSTUAF
                      (    forth6809.asm):12642         
                      (    forth6809.asm):12643                     PULU D
                      (    forth6809.asm):12644                     CMPD #2
                      (    forth6809.asm):12645                     BNE  SQ1FAIL
                      (    forth6809.asm):12646         
                      (    forth6809.asm):12647                     PULU D
                      (    forth6809.asm):12648                     TFR  D,X
                      (    forth6809.asm):12649                     LDA  ,X
                      (    forth6809.asm):12650                     CMPA #'H'
                      (    forth6809.asm):12651                     BNE  SQ1FAIL
                      (    forth6809.asm):12652                     LDA  1,X
                      (    forth6809.asm):12653                     CMPA #'I'
                      (    forth6809.asm):12654                     BNE  SQ1FAIL
                      (    forth6809.asm):12655         
                      (    forth6809.asm):12656                     PULU D
                      (    forth6809.asm):12657                     CMPD #TSTGUARD
                      (    forth6809.asm):12658                     BNE  SQ1FAIL
                      (    forth6809.asm):12659         
                      (    forth6809.asm):12660                     LDD  TSTUB4
                      (    forth6809.asm):12661                     SUBD TSTUAF
                      (    forth6809.asm):12662                     CMPD #4
                      (    forth6809.asm):12663                     BNE  SQ1FAIL
                      (    forth6809.asm):12664         
                      (    forth6809.asm):12665                     LDD  #TRUEV
                      (    forth6809.asm):12666                     BRA  SQ1DONE
C2AB                  (    forth6809.asm):12667         SQ1FAIL:    LDD  #FALSEV
C2AB                  (    forth6809.asm):12668         SQ1DONE:    LDX  #TSTSQ1NAME
                      (    forth6809.asm):12669                     PSHU X
                      (    forth6809.asm):12670                     PSHU D
                      (    forth6809.asm):12671                     JSR  TSTREPORT
                      (    forth6809.asm):12672         
                      (    forth6809.asm):12673                     LDU  TSTU0
                      (    forth6809.asm):12674                     RTS
                      (    forth6809.asm):12675         
C2AB                  (    forth6809.asm):12676         TSTSQ1NAME: FCB  10
                      (    forth6809.asm):12677                     FCC  "TSTSQUOTE1"
                      (    forth6809.asm):12678         
                      (    forth6809.asm):12679         ; ------------------------------------------------------------
                      (    forth6809.asm):12680         ; TSTSQUOTE2 - unit test for S", interpreting-state case.
                      (    forth6809.asm):12681         ; Redirects CODEHERE first so PAD's own computed address (which
                      (    forth6809.asm):12682         ; SQUOTE's own interpreting branch writes to) is predictable,
                      (    forth6809.asm):12683         ; then calls S" directly (no compile/execute step needed, since
                      (    forth6809.asm):12684         ; interpreting S" stages the string and returns immediately) and
                      (    forth6809.asm):12685         ; verifies the returned (addr len) content, plus that addr
                      (    forth6809.asm):12686         ; genuinely landed at PAD's current, redirected address.
                      (    forth6809.asm):12687         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):12688         TSTSQUOTE2: LDD  CODEHERE
                      (    forth6809.asm):12689                     STD  TSTCSAV
                      (    forth6809.asm):12690                     LDD  SRCADDR
                      (    forth6809.asm):12691                     STD  TSTSASAV
                      (    forth6809.asm):12692                     LDD  SRCLEN
                      (    forth6809.asm):12693                     STD  TSTSLSAV
                      (    forth6809.asm):12694                     LDD  TOIN
                      (    forth6809.asm):12695                     STD  TSTTISAV
                      (    forth6809.asm):12696                     LDD  STATE
                      (    forth6809.asm):12697                     STD  TSTSTSAV
                      (    forth6809.asm):12698         
                      (    forth6809.asm):12699                     LDA  #'H'
                      (    forth6809.asm):12700                     STA  TSTNAMEB
                      (    forth6809.asm):12701                     LDA  #'I'
                      (    forth6809.asm):12702                     STA  TSTNAMEB+1
                      (    forth6809.asm):12703                     LDA  #34
                      (    forth6809.asm):12704                     STA  TSTNAMEB+2
                      (    forth6809.asm):12705         
                      (    forth6809.asm):12706                     LDD  #TSTCBUF
                      (    forth6809.asm):12707                     STD  CODEHERE
                      (    forth6809.asm):12708                     LDD  #TSTNAMEB
                      (    forth6809.asm):12709                     STD  SRCADDR
                      (    forth6809.asm):12710                     LDD  #3
                      (    forth6809.asm):12711                     STD  SRCLEN
                      (    forth6809.asm):12712                     LDD  #0
                      (    forth6809.asm):12713                     STD  TOIN
                      (    forth6809.asm):12714                     LDD  #0
                      (    forth6809.asm):12715                     STD  STATE
                      (    forth6809.asm):12716         
                      (    forth6809.asm):12717                     STU  TSTU0
                      (    forth6809.asm):12718         
                      (    forth6809.asm):12719                     LDD  #TSTGUARD
                      (    forth6809.asm):12720                     PSHU D
                      (    forth6809.asm):12721                     STU  TSTUB4
                      (    forth6809.asm):12722         
                      (    forth6809.asm):12723                     JSR  SQUOTE
                      (    forth6809.asm):12724         
                      (    forth6809.asm):12725                     STU  TSTUAF
                      (    forth6809.asm):12726         
                      (    forth6809.asm):12727                     LDD  TSTCSAV
                      (    forth6809.asm):12728                     STD  CODEHERE
                      (    forth6809.asm):12729                     LDD  TSTSASAV
                      (    forth6809.asm):12730                     STD  SRCADDR
                      (    forth6809.asm):12731                     LDD  TSTSLSAV
                      (    forth6809.asm):12732                     STD  SRCLEN
                      (    forth6809.asm):12733                     LDD  TSTTISAV
                      (    forth6809.asm):12734                     STD  TOIN
                      (    forth6809.asm):12735                     LDD  TSTSTSAV
                      (    forth6809.asm):12736                     STD  STATE
                      (    forth6809.asm):12737         
                      (    forth6809.asm):12738                     PULU D
                      (    forth6809.asm):12739                     CMPD #2
                      (    forth6809.asm):12740                     BNE  SQ2FAIL
                      (    forth6809.asm):12741         
                      (    forth6809.asm):12742                     PULU D
                      (    forth6809.asm):12743                     CMPD #TSTCBUF+PADOFFSET
                      (    forth6809.asm):12744                     BNE  SQ2FAIL
                      (    forth6809.asm):12745         
                      (    forth6809.asm):12746                     TFR  D,X
                      (    forth6809.asm):12747                     LDA  ,X
                      (    forth6809.asm):12748                     CMPA #'H'
                      (    forth6809.asm):12749                     BNE  SQ2FAIL
                      (    forth6809.asm):12750                     LDA  1,X
                      (    forth6809.asm):12751                     CMPA #'I'
                      (    forth6809.asm):12752                     BNE  SQ2FAIL
                      (    forth6809.asm):12753         
                      (    forth6809.asm):12754                     PULU D
                      (    forth6809.asm):12755                     CMPD #TSTGUARD
                      (    forth6809.asm):12756                     BNE  SQ2FAIL
                      (    forth6809.asm):12757         
                      (    forth6809.asm):12758                     LDD  TSTUB4
                      (    forth6809.asm):12759                     SUBD TSTUAF
                      (    forth6809.asm):12760                     CMPD #4
                      (    forth6809.asm):12761                     BNE  SQ2FAIL
                      (    forth6809.asm):12762         
                      (    forth6809.asm):12763                     LDD  #TRUEV
                      (    forth6809.asm):12764                     BRA  SQ2DONE
C2AB                  (    forth6809.asm):12765         SQ2FAIL:    LDD  #FALSEV
C2AB                  (    forth6809.asm):12766         SQ2DONE:    LDX  #TSTSQ2NAME
                      (    forth6809.asm):12767                     PSHU X
                      (    forth6809.asm):12768                     PSHU D
                      (    forth6809.asm):12769                     JSR  TSTREPORT
                      (    forth6809.asm):12770         
                      (    forth6809.asm):12771                     LDU  TSTU0
                      (    forth6809.asm):12772                     RTS

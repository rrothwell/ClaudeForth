                      (    forth6809.asm):02090         ; ------------------------------------------------------------
                      (    forth6809.asm):02091         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02092         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low

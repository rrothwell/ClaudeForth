                      (    forth6809.asm):08298                    STD  TOIN
                      (    forth6809.asm):08299         
                      (    forth6809.asm):08300                    LDX  TSTDOESA  ; BUG FIX: was preceded by restoring LATEST
                      (    forth6809.asm):08301                                   ; to its real value here - but SETDOES
                      (    forth6809.asm):08302                                   ; (confirmed by reading its own code) reads
                      (    forth6809.asm):08303                                   ; LATEST directly to find which header to
                      (    forth6809.asm):08304                                   ; patch, so restoring it first meant SETDOES
                      (    forth6809.asm):08305                                   ; patched the real, wrong word instead of
                      (    forth6809.asm):08306                                   ; TESTWD, leaving TESTWD stuck on its
                      (    forth6809.asm):08307                                   ; original DOESRT0 placeholder. LATEST now
                      (    forth6809.asm):08308                                   ; stays pointed at TESTWD (this test's own
                      (    forth6809.asm):08309                                   ; fake header) until right after this call.
                      (    forth6809.asm):08310                    JSR  ,X
                      (    forth6809.asm):08311         
                      (    forth6809.asm):08312                    LDD  TSTLSAV
                      (    forth6809.asm):08313                    STD  LATEST

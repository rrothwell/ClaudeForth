                      (    forth6809.asm):07904         ; ------------------------------------------------------------
                      (    forth6809.asm):07905         ; 1  ( -- 1 )
                      (    forth6809.asm):07906         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):07907         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):07908         ; 27), since "1" and "-1" are not valid assembler labels.

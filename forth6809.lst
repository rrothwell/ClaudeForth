F77D ED48             (    forth6809.asm):07054         SRCHOUT:    STD   8,U               ; flag
F77F 3348             (    forth6809.asm):07055                     LEAU  8,U               ; drop the locals and u2
F781 39               (    forth6809.asm):07056                     RTS
F782 AEC4             (    forth6809.asm):07057         SNOMATCH:   LDX   ,U
F784 3001             (    forth6809.asm):07058                     LEAX  1,X
F786 AFC4             (    forth6809.asm):07059                     STX   ,U

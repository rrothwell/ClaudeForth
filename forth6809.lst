DD78 F60179           (    forth6809.asm):01707                     LDB   OUTHEAD           ; Is buffer full?
DD7B 5C               (    forth6809.asm):01708                     INCB
DD7C C43F             (    forth6809.asm):01709                     ANDB  #OUTBUFSZ-1
DD7E F1017A           (    forth6809.asm):01710                     CMPB  OUTTAIL
DD81 273A             (    forth6809.asm):01711                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.

                      (    forth6809.asm):06994                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E60E                  (    forth6809.asm):06995         KEY:     LDA   INHEAD
                      (    forth6809.asm):06996                  CMPA  INTAIL
                      (    forth6809.asm):06997                  BEQ   KEY

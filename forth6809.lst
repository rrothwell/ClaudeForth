                      (    forth6809.asm):06422         
                      (    forth6809.asm):06423         ; ============================================================
                      (    forth6809.asm):06424         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):06425         ; ============================================================
                      (    forth6809.asm):06426                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):06427                                        ; entirely - every routine from here through
                      (    forth6809.asm):06428                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):06429                                        ; every primitive) would otherwise have
                      (    forth6809.asm):06430                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):06431                                        ; WARM message left the location counter,
                      (    forth6809.asm):06432                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):06433                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):06434                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):06435         
                      (    forth6809.asm):06436         ; ------------------------------------------------------------
                      (    forth6809.asm):06437         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):06438         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):06439         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):06440         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):06441         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):06442         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):06443         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):06444                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):06445                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):06446                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):06447                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):06448                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):06449                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):06450                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):06451                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):06452                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):06453                  RTS
                      (    forth6809.asm):06454         
                      (    forth6809.asm):06455                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):06456         ; ------------------------------------------------------------
                      (    forth6809.asm):06457         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):06458         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):06459         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):06460         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):06461         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):06462         INFILL:  LDA   INHEAD
                      (    forth6809.asm):06463                  SUBA  INTAIL
                      (    forth6809.asm):06464                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):06465                  RTS
                      (    forth6809.asm):06466         
                      (    forth6809.asm):06467         ; ------------------------------------------------------------
                      (    forth6809.asm):06468         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):06469         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):06470         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):06471         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):06472         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):06473         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):06474         ; flow control, not a chip feature.
                      (    forth6809.asm):06475         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):06476         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):06477                     CMPA #INHIWATER
                      (    forth6809.asm):06478                     BLO  RTSCHIDONE
                      (    forth6809.asm):06479                     TST  RTSSTATE
                      (    forth6809.asm):06480                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):06481                     LDA  #CR_RTSHI
                      (    forth6809.asm):06482                     STA  ACIACR
                      (    forth6809.asm):06483                     LDA  #1
                      (    forth6809.asm):06484                     STA  RTSSTATE
DEF5                  (    forth6809.asm):06485         RTSCHIDONE: RTS
                      (    forth6809.asm):06486         
                      (    forth6809.asm):06487         ; ------------------------------------------------------------
                      (    forth6809.asm):06488         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):06489         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):06490         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):06491         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):06492         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):06493         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):06494         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):06495         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):06496         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):06497         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):06498         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):06499                     CMPA #INLOWATER
                      (    forth6809.asm):06500                     BHI  RTSCLODONE
                      (    forth6809.asm):06501                     TST  RTSSTATE
                      (    forth6809.asm):06502                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):06503                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):06504                     CLR  RTSSTATE
                      (    forth6809.asm):06505                     LDB  OUTTAIL
                      (    forth6809.asm):06506                     CMPB OUTHEAD
                      (    forth6809.asm):06507                     BEQ  RTSCLONOTX
                      (    forth6809.asm):06508                     LDA  #CR_RXTX
                      (    forth6809.asm):06509                     STA  ACIACR
                      (    forth6809.asm):06510                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):06511         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):06512                     STA  ACIACR
DEF5                  (    forth6809.asm):06513         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):06514         RTSCLODONE: RTS
                      (    forth6809.asm):06515         
DEF5                  (    forth6809.asm):06516         IRQH:    LDA   ACIASR
                      (    forth6809.asm):06517                  BITA  #SR_IRQ
                      (    forth6809.asm):06518                  BEQ   IRQDONE
                      (    forth6809.asm):06519         
                      (    forth6809.asm):06520                  BITA  #SR_RDRF
                      (    forth6809.asm):06521                  BEQ   TXCHK
                      (    forth6809.asm):06522         
                      (    forth6809.asm):06523                  LDB   INHEAD
                      (    forth6809.asm):06524                  LDA   ACIADR
                      (    forth6809.asm):06525                  LDX   #INBUF
                      (    forth6809.asm):06526                  STA   B,X
                      (    forth6809.asm):06527                  INCB
                      (    forth6809.asm):06528                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):06529                  CMPB  INTAIL
                      (    forth6809.asm):06530                  BEQ   IRQDONE
                      (    forth6809.asm):06531                  STB   INHEAD
                      (    forth6809.asm):06532                  JSR   RTSCHECKHI
                      (    forth6809.asm):06533                  BRA   IRQDONE
                      (    forth6809.asm):06534         
DEF5                  (    forth6809.asm):06535         TXCHK:   LDB   OUTTAIL
                      (    forth6809.asm):06536                  CMPB  OUTHEAD
                      (    forth6809.asm):06537                  BEQ   TXOFF
                      (    forth6809.asm):06538                  LDX   #OUTBUF
                      (    forth6809.asm):06539                  LDA   B,X
                      (    forth6809.asm):06540                  STA   ACIADR
                      (    forth6809.asm):06541                  INCB
                      (    forth6809.asm):06542                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):06543                  STB   OUTTAIL
                      (    forth6809.asm):06544                  BRA   IRQDONE
                      (    forth6809.asm):06545         
DEF5                  (    forth6809.asm):06546         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):06547                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):06548                                         ; or this would incorrectly drop it back low
                      (    forth6809.asm):06549                  LDA   #CR_RXON
                      (    forth6809.asm):06550                  STA   ACIACR
                      (    forth6809.asm):06551         
DEF5                  (    forth6809.asm):06552         IRQDONE: RTI
                      (    forth6809.asm):06553         
                      (    forth6809.asm):06554                  ELSE  ; <<<<<>>>>>
DEF5 3B               (    forth6809.asm):06555         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):06556                                       ; interrupts are never enabled (see
                      (    forth6809.asm):06557                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):06558                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):06559                                       ; the other unused vectors below
                      (    forth6809.asm):06560                  ENDC  ; <<<<<<<<<<

                      (    forth6809.asm):06761         ; DOCSTR
                      (    forth6809.asm):06762         ;    Outputs:
                      (    forth6809.asm):06763         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):06764         ;        the string

                      (    forth6809.asm):05367         ; ------------------------------------------------------------
                      (    forth6809.asm):05368         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):05369         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):05370         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):05371         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):05372         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):05373         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):05374         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):05375         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):05376         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):05377         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):05378         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):05379         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):05380         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):05381         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):05382         ; ------------------------------------------------------------
                      (    forth6809.asm):05383         
                      (    forth6809.asm):05384         ; ------------------------------------------------------------
                      (    forth6809.asm):05385         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):05386         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):05387         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):05388         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):05389         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):05390         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):05391         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):05392         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):05393         TSTIFT1: LDD   CODEHERE
                      (    forth6809.asm):05394                  STD   TSTCSAV
                      (    forth6809.asm):05395                  LDD   #TSTCBUF
                      (    forth6809.asm):05396                  STD   CODEHERE
                      (    forth6809.asm):05397         
                      (    forth6809.asm):05398                  JSR   IF
                      (    forth6809.asm):05399         
                      (    forth6809.asm):05400                  LDD   #111
                      (    forth6809.asm):05401                  PSHU  D
                      (    forth6809.asm):05402                  JSR   LITERALW
                      (    forth6809.asm):05403         
                      (    forth6809.asm):05404                  JSR   THEN
                      (    forth6809.asm):05405         
                      (    forth6809.asm):05406                  LDD   #OPRTS
                      (    forth6809.asm):05407                  PSHU  D
                      (    forth6809.asm):05408                  JSR   CCOMMA
                      (    forth6809.asm):05409         
                      (    forth6809.asm):05410                  LDD   TSTCSAV
                      (    forth6809.asm):05411                  STD   CODEHERE
                      (    forth6809.asm):05412         
                      (    forth6809.asm):05413                  STU   TSTU0
                      (    forth6809.asm):05414         
                      (    forth6809.asm):05415                  LDD   #TSTGUARD
                      (    forth6809.asm):05416                  PSHU  D
                      (    forth6809.asm):05417                  LDD   #TRUEV
                      (    forth6809.asm):05418                  PSHU  D
                      (    forth6809.asm):05419                  STU   TSTUB4
                      (    forth6809.asm):05420         
                      (    forth6809.asm):05421                  JSR   TSTCBUF
                      (    forth6809.asm):05422         
                      (    forth6809.asm):05423                  STU   TSTUAF
                      (    forth6809.asm):05424         
                      (    forth6809.asm):05425                  PULU  D
                      (    forth6809.asm):05426                  CMPD  #111
                      (    forth6809.asm):05427                  BNE   T1FAIL
                      (    forth6809.asm):05428                  PULU  D
                      (    forth6809.asm):05429                  CMPD  #TSTGUARD
                      (    forth6809.asm):05430                  BNE   T1FAIL
                      (    forth6809.asm):05431         
                      (    forth6809.asm):05432                  LDD   TSTUB4
                      (    forth6809.asm):05433                  SUBD  TSTUAF
                      (    forth6809.asm):05434                  CMPD  #0
                      (    forth6809.asm):05435                  BNE   T1FAIL
                      (    forth6809.asm):05436         
                      (    forth6809.asm):05437                  LDD   #TRUEV
                      (    forth6809.asm):05438                  BRA   T1DONE
C1F2                  (    forth6809.asm):05439         T1FAIL:  LDD   #FALSEV
C1F2                  (    forth6809.asm):05440         T1DONE:  LDX   #TSTIFT1NAME
                      (    forth6809.asm):05441                  PSHU  X
                      (    forth6809.asm):05442                  PSHU  D
                      (    forth6809.asm):05443                  JSR   TSTREPORT
                      (    forth6809.asm):05444         
                      (    forth6809.asm):05445                  LDU   TSTU0
                      (    forth6809.asm):05446                  RTS
                      (    forth6809.asm):05447         
C1F2                  (    forth6809.asm):05448         TSTIFT1NAME: FCB  7
                      (    forth6809.asm):05449                      FCC  "TSTIFT1"

                      (    forth6809.asm):02077         ; ============================================================
                      (    forth6809.asm):02078         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02079         ; ============================================================
                      (    forth6809.asm):02080                     ORG   BASECODE  ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):02081                                     ; entirely - every routine from here through
                      (    forth6809.asm):02082                                     ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):02083                                     ; every primitive) would otherwise have
                      (    forth6809.asm):02084                                     ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):02085                                     ; WARM message left the location counter,
                      (    forth6809.asm):02086                                     ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02087                                     ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02088                                     ; instead of landing in BASECODE at all
                      (    forth6809.asm):02089         
                      (    forth6809.asm):02090         ; ------------------------------------------------------------
                      (    forth6809.asm):02091         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02092         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02093         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02094         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02095         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02096         ; ------------------------------------------------------------
                      (    forth6809.asm):02097         ; ------------------------------------------------------------
                      (    forth6809.asm):02098         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02099         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02100         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02101         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02102         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02103         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02104         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02105         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02106         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02107         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02108         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02109         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02110         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02111         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02112         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02113         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02114         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02115         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02116         ; not duplicated logic in either place.
                      (    forth6809.asm):02117         ; ------------------------------------------------------------
                      (    forth6809.asm):02118         
DD46 7F0176           (    forth6809.asm):02119         SERBUFCLR:  CLR  INHEAD
DD49 7F0177           (    forth6809.asm):02120                     CLR  INTAIL
DD4C 7F0178           (    forth6809.asm):02121                     CLR  RTSSTATE    ; $00 = RTS Low (Clear)
DD4F 7F0179           (    forth6809.asm):02122                     CLR  OUTHEAD
DD52 7F017A           (    forth6809.asm):02123                     CLR  OUTTAIL
DD55 7F017B           (    forth6809.asm):02124                     CLR  OUTACTIVITY  ; $00 = Idle
                      (    forth6809.asm):02125         
                      (    forth6809.asm):02126         
DD58 7F017C           (    forth6809.asm):02127                     CLR  FECOUNT
DD5B 7F017D           (    forth6809.asm):02128                     CLR  OVRNCOUNT
DD5E 7F017E           (    forth6809.asm):02129                     CLR  PECOUNT
DD61 7F017F           (    forth6809.asm):02130                     CLR  POLLREADYCNT
DD64 39               (    forth6809.asm):02131                     RTS
                      (    forth6809.asm):02132         
DD65 BDDD46           (    forth6809.asm):02133         INITSERIAL: JSR  SERBUFCLR
DD68 9603             (    forth6809.asm):02134                     LDA   CR_RESET    ; Master Software Reset command to 6850
DD6A B7C008           (    forth6809.asm):02135                     STA   ACIACR 
DD6D 12               (    forth6809.asm):02136                     NOP               ; Settling Delay
DD6E 12               (    forth6809.asm):02137                     NOP
                      (    forth6809.asm):02138                     
                      (    forth6809.asm):02139                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02140                     LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02141                     ELSE  ; <<<<<>>>>>
DD6F 8615             (    forth6809.asm):02142                     LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02143                     ENDC  ; <<<<<<<<<<
DD71 B7C008           (    forth6809.asm):02144                     STA   ACIACR         ; was "STA ACIA" - same fix
DD74 39               (    forth6809.asm):02145                     RTS
                      (    forth6809.asm):02146         
                      (    forth6809.asm):02147                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02148         ; ------------------------------------------------------------
                      (    forth6809.asm):02149         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):02150         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):02151         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):02152         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):02153         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02154         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02155                     SUBA  INTAIL
                      (    forth6809.asm):02156                     ANDA  #INBUFSZ-1
                      (    forth6809.asm):02157                     RTS
                      (    forth6809.asm):02158         ; ------------------------------------------------------------
                      (    forth6809.asm):02159         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):02160         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):02161         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):02162         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):02163         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):02164         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):02165         ; flow control, not a chip feature.
                      (    forth6809.asm):02166         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02167         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):02168                     CMPA #INHIWATER
                      (    forth6809.asm):02169                     BLO  RTSCHIDONE
                      (    forth6809.asm):02170                     TST  RTSSTATE
                      (    forth6809.asm):02171                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02172                     LDA  #CR_RTSHI
                      (    forth6809.asm):02173                     STA  ACIACR
                      (    forth6809.asm):02174                     LDA  #1
                      (    forth6809.asm):02175                     STA  RTSSTATE
DD75                  (    forth6809.asm):02176         RTSCHIDONE: RTS
                      (    forth6809.asm):02177         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02178         UPDATE_RTS:
                      (    forth6809.asm):02179                     TST   RTSSTATE
                      (    forth6809.asm):02180                     BNE   SET_RTS_HI_TX_OFF      
                      (    forth6809.asm):02181         
                      (    forth6809.asm):02182                     TST   OUTACTIVITY           ; Is active?
                      (    forth6809.asm):02183                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02184         
                      (    forth6809.asm):02185                                           ; $B5/%1011_0101
                      (    forth6809.asm):02186                     LDA   #CR_RXTX        ; Yes! Accept input & transmit output
                      (    forth6809.asm):02187                     BRA   WRITE_CR        ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02188         
DD75                  (    forth6809.asm):02189         SET_RTS_LO_TX_OFF:                ; $95/%10010101
                      (    forth6809.asm):02190                     LDA   #CR_RXON        ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02191                     BRA   WRITE_CR        ; Why is OUTACTIVITY not updated here?
                      (    forth6809.asm):02192         
DD75                  (    forth6809.asm):02193         SET_RTS_HI_TX_OFF:                ; $D5/%1101_0101
                      (    forth6809.asm):02194                     LDA   #CR_RTSHI       ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02195                     CLR   OUTACTIVITY     ; Interrupts are hardware-disabled; clear state
DD75                  (    forth6809.asm):02196         WRITE_CR:
                      (    forth6809.asm):02197                     STA   ACIACR
                      (    forth6809.asm):02198                     RTS
                      (    forth6809.asm):02199         ; ------------------------------------------------------------
                      (    forth6809.asm):02200         ; CHKHI/CHKLO - replace the old combined CHKWATERLEVEL. That
                      (    forth6809.asm):02201         ; routine always paid for a TST RTSSTATE/BNE to pick a
                      (    forth6809.asm):02202         ; direction (hi vs lo) before checking either watermark - but
                      (    forth6809.asm):02203         ; the direction picked never actually depended on which caller
                      (    forth6809.asm):02204         ; was asking, only on the current RTSSTATE, and each caller
                      (    forth6809.asm):02205         ; only ever moves fill one way: INCHAR (via CHKHI) only ever
                      (    forth6809.asm):02206         ; adds to the ring, so only the hi threshold can ever usefully
                      (    forth6809.asm):02207         ; fire from that side; GETCHAR (via CHKLO) only ever drains it,
                      (    forth6809.asm):02208         ; so only the lo threshold can fire from that side. Whenever
                      (    forth6809.asm):02209         ; the old routing sent a caller into the "wrong" branch for its
                      (    forth6809.asm):02210         ; own direction (e.g. INCHAR landing in CHK_LO while RTSSTATE
                      (    forth6809.asm):02211         ; was REJECT), the comparison was provably always a no-op from
                      (    forth6809.asm):02212         ; that caller - the fill level only ever moves the way that
                      (    forth6809.asm):02213         ; caller pushes it, so the other threshold's condition can't
                      (    forth6809.asm):02214         ; newly become true there. Splitting into two direction-fixed
                      (    forth6809.asm):02215         ; routines removes that dead branch+comparison from both
                      (    forth6809.asm):02216         ; callers, and both take the current fill level pre-computed in
                      (    forth6809.asm):02217         ; RegB rather than reloading INHEAD/INTAIL themselves, so a
                      (    forth6809.asm):02218         ; caller that already has one of the two pointers in a register
                      (    forth6809.asm):02219         ; (see INCHAR) doesn't pay for a redundant reload.
                      (    forth6809.asm):02220         ; ------------------------------------------------------------
DD75                  (    forth6809.asm):02221         CHKHI:
                      (    forth6809.asm):02222                     CMPB  #INHIWATER      ; Is the buffer near full?
                      (    forth6809.asm):02223                     BLO   CHKHIDONE       ; No! Do nothing.
                      (    forth6809.asm):02224                     TST   RTSSTATE
                      (    forth6809.asm):02225                     BNE   CHKHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02226                     LDA   #INREJECT       ; Yes! De-assert RTS.
                      (    forth6809.asm):02227                     STA   RTSSTATE
                      (    forth6809.asm):02228                     JSR   UPDATE_RTS
DD75                  (    forth6809.asm):02229         CHKHIDONE:  RTS
                      (    forth6809.asm):02230         
DD75                  (    forth6809.asm):02231         CHKLO:
                      (    forth6809.asm):02232                     CMPB  #INLOWATER      ; Is the buffer near empty?
                      (    forth6809.asm):02233                     BHS   CHKLODONE       ; No! Do nothing.
                      (    forth6809.asm):02234                     TST   RTSSTATE
                      (    forth6809.asm):02235                     BEQ   CHKLODONE       ; already low - nothing to do
                      (    forth6809.asm):02236                     LDA   #INACCEPT       ; Yes! Assert RTS.
                      (    forth6809.asm):02237                     STA   RTSSTATE
                      (    forth6809.asm):02238                     JSR   UPDATE_RTS
DD75                  (    forth6809.asm):02239         CHKLODONE:  RTS
                      (    forth6809.asm):02240         ; ------------------------------------------------------------
                      (    forth6809.asm):02241         ; BUG FIX: this used to loop internally (BRA back to the top)
                      (    forth6809.asm):02242         ; until the whole OUTBUF drained or CTS blocked - an unbounded
                      (    forth6809.asm):02243         ; spin of up to ~64 characters (~5.5ms at 115200 baud). In
                      (    forth6809.asm):02244         ; practice only one character was ever observed to be processed
                      (    forth6809.asm):02245         ; per call anyway (TDRE is rarely ready again this soon after
                      (    forth6809.asm):02246         ; sending), so this now makes that explicit: sends at most ONE
                      (    forth6809.asm):02247         ; character per call and returns unconditionally, whatever the
                      (    forth6809.asm):02248         ; reason (buffer empty, CTS-blocked, TDRE not ready yet, or a
                      (    forth6809.asm):02249         ; character actually sent - including the TDRE-not-ready case,
                      (    forth6809.asm):02250         ; which used to spin-wait right here and now instead just
                      (    forth6809.asm):02251         ; returns to try again on the next call). Every caller (KEY,
                      (    forth6809.asm):02252         ; PUTCHAR) already calls this once per character it handles on
                      (    forth6809.asm):02253         ; its own side, so the buffer still drains at essentially the
                      (    forth6809.asm):02254         ; same rate - this removes the unbounded worst case and the
                      (    forth6809.asm):02255         ; TDRE spin-wait, without changing normal-case throughput.

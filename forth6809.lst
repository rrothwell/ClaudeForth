                      (    forth6809.asm):02072         ; receive path with interrupts already masked.
                      (    forth6809.asm):02073         ; RTSCHECKHI
                      (    forth6809.asm):02074         ;    Inputs:
                      (    forth6809.asm):02075         ;        none
                      (    forth6809.asm):02076         ;    Outputs:
                      (    forth6809.asm):02077         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached

                      (    forth6809.asm):08008         ; ------------------------------------------------------------
                      (    forth6809.asm):08009         ; 1  ( -- 1 )
                      (    forth6809.asm):08010         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08011         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08012         ; 27), since "1" and "-1" are not valid assembler labels.

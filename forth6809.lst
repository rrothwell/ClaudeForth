F522                  (    forth6809.asm):06566         SQINTERP:                           ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):06567                                             ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):06568                                             ; capping every interpreted S" string at 32
                      (    forth6809.asm):06569                                             ; characters and (worse) shared identically
                      (    forth6809.asm):06570                                             ; by every S" call, so a second S" call before
                      (    forth6809.asm):06571                                             ; the first string was actually used (e.g.
                      (    forth6809.asm):06572                                             ; registering two REPLACES strings, or a
                      (    forth6809.asm):06573                                             ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):06574                                             ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):06575                                             ; testing and traced precisely earlier this
                      (    forth6809.asm):06576                                             ; session. Retired per user's own follow-up
                      (    forth6809.asm):06577                                             ; testing/design decision: rather than give
                      (    forth6809.asm):06578                                             ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):06579                                             ; storage, wrap each string in its own colon
                      (    forth6809.asm):06580                                             ; definition for stable storage instead - but
                      (    forth6809.asm):06581                                             ; that still leaves interpreted S" itself
                      (    forth6809.asm):06582                                             ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):06583                                             ; single string. Now computes PAD's current
                      (    forth6809.asm):06584                                             ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):06585                                             ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):06586                                             ; semantics) and writes there instead, giving
                      (    forth6809.asm):06587                                             ; interpreted S" access to PAD's full
                      (    forth6809.asm):06588                                             ; PADMINSIZE-character region (128, comfortably
                      (    forth6809.asm):06589                                             ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):06590                                             ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):06591                                             ; the GLOBALS layout notes above).
F522 BDDF42           (    forth6809.asm):06592                     JSR   PADW
F525 3710             (    forth6809.asm):06593                     PULU  X

                      (    forth6809.asm):03488                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03489                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03490                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03491                                             ; the host to pause before INTERPRET runs

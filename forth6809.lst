DCF2 39               (    forth6809.asm):01576                     RTS
                      (    forth6809.asm):01577         
                      (    forth6809.asm):01578                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01579         ; ------------------------------------------------------------
                      (    forth6809.asm):01580         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01581         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01582         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01583         ; INFILL
                      (    forth6809.asm):01584         ;    Inputs:
                      (    forth6809.asm):01585         ;        none
                      (    forth6809.asm):01586         ;    Outputs:
                      (    forth6809.asm):01587         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01588         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01589         ; ------------------------------------------------------------
DCF3 B60176           (    forth6809.asm):01590         INFILL:     LDA   INHEAD
DCF6 B00177           (    forth6809.asm):01591                     SUBA  INTAIL
DCF9 843F             (    forth6809.asm):01592                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DCFB 39               (    forth6809.asm):01593                     RTS
                      (    forth6809.asm):01594         ; ------------------------------------------------------------
                      (    forth6809.asm):01595         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01596         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01597         ; receive path with interrupts already masked.
                      (    forth6809.asm):01598         ; RTSCHECKHI
                      (    forth6809.asm):01599         ;    Inputs:
                      (    forth6809.asm):01600         ;        none
                      (    forth6809.asm):01601         ;    Outputs:
                      (    forth6809.asm):01602         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01603         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01604         ; ------------------------------------------------------------
DCFC BDDCF3           (    forth6809.asm):01605         RTSCHECKHI: JSR   INFILL
DCFF 8130             (    forth6809.asm):01606                     CMPA  #INHIWATER
DD01 250F             (    forth6809.asm):01607                     BLO   RTSCHIDONE
DD03 7D0178           (    forth6809.asm):01608                     TST   RTSSTATE
DD06 260A             (    forth6809.asm):01609                     BNE   RTSCHIDONE        ; already high - nothing to do
DD08 86D5             (    forth6809.asm):01610                     LDA   #CR_RTSHI
DD0A B7C008           (    forth6809.asm):01611                     STA   ACIACR
DD0D 8601             (    forth6809.asm):01612                     LDA   #1
DD0F B70178           (    forth6809.asm):01613                     STA   RTSSTATE
DD12 39               (    forth6809.asm):01614         RTSCHIDONE: RTS
                      (    forth6809.asm):01615         ; ------------------------------------------------------------
                      (    forth6809.asm):01616         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01617         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01618         ; enables it only while output is pending.
                      (    forth6809.asm):01619         ; UPDATE_RTS
                      (    forth6809.asm):01620         ;    Inputs:
                      (    forth6809.asm):01621         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01622         ;    Outputs:
                      (    forth6809.asm):01623         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01624         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01625         ; ------------------------------------------------------------
DD13                  (    forth6809.asm):01626         UPDATE_RTS:
DD13 7D0178           (    forth6809.asm):01627                     TST   RTSSTATE
DD16 260D             (    forth6809.asm):01628                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01629         
DD18 7D017B           (    forth6809.asm):01630                     TST   OUTACTIVITY       ; Is active?
DD1B 2704             (    forth6809.asm):01631                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01632         
                      (    forth6809.asm):01633                                             ; $B5/%1011_0101
DD1D 86B5             (    forth6809.asm):01634                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DD1F 2009             (    forth6809.asm):01635                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01636         
DD21                  (    forth6809.asm):01637         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DD21 8695             (    forth6809.asm):01638                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DD23 2005             (    forth6809.asm):01639                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01640         
DD25                  (    forth6809.asm):01641         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DD25 86D5             (    forth6809.asm):01642                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DD27 7F017B           (    forth6809.asm):01643                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DD2A                  (    forth6809.asm):01644         WRITE_CR:
DD2A B7C008           (    forth6809.asm):01645                     STA   ACIACR
DD2D 39               (    forth6809.asm):01646                     RTS
                      (    forth6809.asm):01647         ; ------------------------------------------------------------
                      (    forth6809.asm):01648         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01649         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01650         ; Called after a character is added to the ring.
                      (    forth6809.asm):01651         ; CHKHI
                      (    forth6809.asm):01652         ;    Inputs:
                      (    forth6809.asm):01653         ;        RegB = input ring fill level
                      (    forth6809.asm):01654         ;    Outputs:
                      (    forth6809.asm):01655         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01656         ;    Registers: RegA and CC changed.

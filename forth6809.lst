E5D5 2641             (    forth6809.asm):03127                   BNE   NQBAD
                      (    forth6809.asm):03128         
                      (    forth6809.asm):03129                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03130                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03131                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03132                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03133                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03134                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03135                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03136                   ; high cell.
E5D7 0D22             (    forth6809.asm):03137                   TST   NUMNEG
E5D9 2718             (    forth6809.asm):03138                   BEQ   NQPOS32
E5DB DC76             (    forth6809.asm):03139                   LDD   UDLO
E5DD 43               (    forth6809.asm):03140                   COMA
E5DE 53               (    forth6809.asm):03141                   COMB
E5DF C30001           (    forth6809.asm):03142                   ADDD  #1
E5E2 DD76             (    forth6809.asm):03143                   STD   UDLO
E5E4 3401             (    forth6809.asm):03144                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03145                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03146                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03147                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03148                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03149                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03150                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03151                                      ; making the high-cell increment run
                      (    forth6809.asm):03152                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03153                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03154                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03155                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03156                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03157                                      ; matching "always increment" rather than
                      (    forth6809.asm):03158                                      ; "increment only on genuine carry".
E5E6 DC74             (    forth6809.asm):03159                   LDD   UDHI
E5E8 43               (    forth6809.asm):03160                   COMA
E5E9 53               (    forth6809.asm):03161                   COMB
E5EA 3501             (    forth6809.asm):03162                   PULS  CC          ; restore the TRUE carry
E5EC 2403             (    forth6809.asm):03163                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03164                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03165                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03166                                      ; value was computed in D but never
                      (    forth6809.asm):03167                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03168                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03169                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03170                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03171                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03172                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03173                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03174                                      ; alone would have made this second,
                      (    forth6809.asm):03175                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03176                                      ; only past the "+1", never past the
                      (    forth6809.asm):03177                                      ; store itself - the store always runs,
                      (    forth6809.asm):03178                                      ; either way.
E5EE C30001           (    forth6809.asm):03179                   ADDD  #1
E5F1 DD74             (    forth6809.asm):03180         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03181         
E5F3                  (    forth6809.asm):03182         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03183                   ; was '.' - determines which return convention to use
E5F3 9E1F             (    forth6809.asm):03184                   LDX   CADDR
E5F5 E684             (    forth6809.asm):03185                   LDB   ,X
E5F7 5A               (    forth6809.asm):03186                   DECB

                      (    forth6809.asm):03343         ; ============================================================
                      (    forth6809.asm):03344         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03345         ; ============================================================
                      (    forth6809.asm):03346                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03347         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03348         
                      (    forth6809.asm):03349         ; ------------------------------------------------------------
                      (    forth6809.asm):03350         ; KEY  ( -- char )
                      (    forth6809.asm):03351         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03352         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03353         ; ------------------------------------------------------------
E54E                  (    forth6809.asm):03354         KEYW:
                      (    forth6809.asm):03355         
E54E 7D0178           (    forth6809.asm):03356                     TST   RTSSTATE          ; Is throttling?
E551 2703             (    forth6809.asm):03357                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03358         
                      (    forth6809.asm):03359                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E553 BDDD52           (    forth6809.asm):03360                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03361                                             ; by transmitting all chars.
                      (    forth6809.asm):03362         
E556                  (    forth6809.asm):03363         TRY_READ:
E556 BDDDBF           (    forth6809.asm):03364                     JSR   GETCHAR           ; Is char available in input buffer.
E559 25F3             (    forth6809.asm):03365                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03366                                             ; while still transmitting!
                      (    forth6809.asm):03367         
E55B 1F89             (    forth6809.asm):03368                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E55D 4F               (    forth6809.asm):03369                     CLRA                    ; Clear MSB.
E55E 3606             (    forth6809.asm):03370                     PSHU  D                 ; char
                      (    forth6809.asm):03371         
E560 39               (    forth6809.asm):03372                     RTS
                      (    forth6809.asm):03373         
                      (    forth6809.asm):03374         ; ------------------------------------------------------------
                      (    forth6809.asm):03375         ; KEY?  ( -- flag )
                      (    forth6809.asm):03376         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03377         ; ------------------------------------------------------------
E561                  (    forth6809.asm):03378         KEYQW:
                      (    forth6809.asm):03379                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03380         
E561 B60176           (    forth6809.asm):03381                     LDA   INHEAD            ; Characters received?
E564 B10177           (    forth6809.asm):03382                     CMPA  INTAIL
                      (    forth6809.asm):03383         
                      (    forth6809.asm):03384                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03385         
E567 2606             (    forth6809.asm):03386                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03387         
E569 CC0000           (    forth6809.asm):03388                     LDD   #FALSEV           ; No! Return false result.
E56C 3606             (    forth6809.asm):03389                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03390         
E56E 39               (    forth6809.asm):03391                     RTS
                      (    forth6809.asm):03392         
E56F                  (    forth6809.asm):03393         KQTRUE:
E56F CCFFFF           (    forth6809.asm):03394                     LDD   #TRUEV            ; Yes! Return true result.
E572 3606             (    forth6809.asm):03395                     PSHU  D                 ; flag = true
E574 39               (    forth6809.asm):03396                     RTS
                      (    forth6809.asm):03397         
                      (    forth6809.asm):03398         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03399         
                      (    forth6809.asm):03400         ; ------------------------------------------------------------
                      (    forth6809.asm):03401         ; EMIT  ( char -- )
                      (    forth6809.asm):03402         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03403         ; discarded if the ring is full.
                      (    forth6809.asm):03404         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03405         EMITW:
E575 3706             (    forth6809.asm):03406                     PULU  D                 ; char
E577 1F98             (    forth6809.asm):03407                     TFR   B,A
E579 BDDD74           (    forth6809.asm):03408                     JSR   PUTCHAR           ; Transmit char.
E57C 39               (    forth6809.asm):03409                     RTS
                      (    forth6809.asm):03410         
                      (    forth6809.asm):03411                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03412         ; ------------------------------------------------------------
                      (    forth6809.asm):03413         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03414         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03415         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03416         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03417         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03418         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03419         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03420         ; follow.
                      (    forth6809.asm):03421         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03422         KEYW:
                      (    forth6809.asm):03423                     LDA   ACIASR
                      (    forth6809.asm):03424                     BITA  #SR_RDRF
                      (    forth6809.asm):03425                     BEQ   KWAIT
                      (    forth6809.asm):03426                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03427                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E57D                  (    forth6809.asm):03428         KWAIT:
E57D                  (    forth6809.asm):03429         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03430                     BITA  #SR_RDRF
                      (    forth6809.asm):03431                     BEQ   KSPIN
E57D                  (    forth6809.asm):03432         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03433                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03434                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03435                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03436                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03437                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03438                     BEQ   KGETCH
                      (    forth6809.asm):03439                     BITA  #SR_FE
                      (    forth6809.asm):03440                     BEQ   KXFE
                      (    forth6809.asm):03441                     INC   FECOUNT
E57D                  (    forth6809.asm):03442         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03443                     BEQ   KXOVRN
                      (    forth6809.asm):03444                     INC   OVRNCOUNT
E57D                  (    forth6809.asm):03445         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03446                     BEQ   KGETCH
                      (    forth6809.asm):03447                     INC   PECOUNT
E57D                  (    forth6809.asm):03448         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03449                     TFR   A,B
                      (    forth6809.asm):03450                     CLRA
                      (    forth6809.asm):03451                     PSHU  D                 ; char
                      (    forth6809.asm):03452                     RTS
                      (    forth6809.asm):03453         
                      (    forth6809.asm):03454         ; ------------------------------------------------------------
                      (    forth6809.asm):03455         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03456         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03457         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03458         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03459         ;    Inputs:
                      (    forth6809.asm):03460         ;        none
                      (    forth6809.asm):03461         ;    Outputs:
                      (    forth6809.asm):03462         ;        XON or XOFF transmitted
                      (    forth6809.asm):03463         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03464         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03465         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03466         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03467                     BRA   PUTXCH
E57D                  (    forth6809.asm):03468         PUTXON:     LDA   #XONCH
E57D                  (    forth6809.asm):03469         PUTXCH:     PSHS  A
E57D                  (    forth6809.asm):03470         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03471                     BITB  #SR_TDRE
                      (    forth6809.asm):03472                     BEQ   PXWT
                      (    forth6809.asm):03473                     PULS  A
                      (    forth6809.asm):03474                     STA   ACIADR
                      (    forth6809.asm):03475                     RTS
                      (    forth6809.asm):03476         
                      (    forth6809.asm):03477         ; ------------------------------------------------------------
                      (    forth6809.asm):03478         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03479         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03480         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03481         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03482                     BITA  #SR_RDRF
                      (    forth6809.asm):03483                     BEQ   KQFALSE
                      (    forth6809.asm):03484                     LDD   #TRUEV
                      (    forth6809.asm):03485                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03486                     RTS
E57D                  (    forth6809.asm):03487         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03488                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03489                     RTS
                      (    forth6809.asm):03490         
                      (    forth6809.asm):03491         ; ------------------------------------------------------------
                      (    forth6809.asm):03492         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03493         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03494         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03495         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03496                     STB   EMITCH
E57D                  (    forth6809.asm):03497         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03498                     BITA  #SR_TDRE
                      (    forth6809.asm):03499                     BEQ   EMITWT
                      (    forth6809.asm):03500                     LDA   EMITCH
                      (    forth6809.asm):03501                     STA   ACIADR
                      (    forth6809.asm):03502                     RTS
                      (    forth6809.asm):03503         
                      (    forth6809.asm):03504                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03505         
                      (    forth6809.asm):03506         ; ------------------------------------------------------------
                      (    forth6809.asm):03507         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03508         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03509         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03510         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03511         ; ------------------------------------------------------------
E57D 3706             (    forth6809.asm):03512         ACCEPTW:    PULU  D                 ; +n1
E57F DD33             (    forth6809.asm):03513                     STD   AMAX
E581 3706             (    forth6809.asm):03514                     PULU  D                 ; c-addr
E583 DD35             (    forth6809.asm):03515                     STD   ABUFP
E585 CC0000           (    forth6809.asm):03516                     LDD   #0
E588 DD37             (    forth6809.asm):03517                     STD   ACNT
                      (    forth6809.asm):03518         
                      (    forth6809.asm):03519                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03520                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03521                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03522                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03523                                             ; stream this line's characters
                      (    forth6809.asm):03524                     JSR   PUTXON
                      (    forth6809.asm):03525                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03526         
E58A BDE54E           (    forth6809.asm):03527         ALOOP:      JSR   KEYW
E58D 3706             (    forth6809.asm):03528                     PULU  D
E58F 1F02             (    forth6809.asm):03529                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03530         
E591 C10D             (    forth6809.asm):03531                     CMPB  #13
E593 274F             (    forth6809.asm):03532                     BEQ   ADONE
E595 C10A             (    forth6809.asm):03533                     CMPB  #10
E597 27F1             (    forth6809.asm):03534                     BEQ   ALOOP
E599 C108             (    forth6809.asm):03535                     CMPB  #8
E59B 2724             (    forth6809.asm):03536                     BEQ   ABKSP
E59D C17F             (    forth6809.asm):03537                     CMPB  #127
E59F 2720             (    forth6809.asm):03538                     BEQ   ABKSP
                      (    forth6809.asm):03539         
E5A1 DC37             (    forth6809.asm):03540                     LDD   ACNT
E5A3 109333           (    forth6809.asm):03541                     CMPD  AMAX
E5A6 27E2             (    forth6809.asm):03542                     BEQ   ALOOP
                      (    forth6809.asm):03543         
E5A8 9E35             (    forth6809.asm):03544                     LDX   ABUFP
E5AA 308B             (    forth6809.asm):03545                     LEAX  D,X
E5AC 1F20             (    forth6809.asm):03546                     TFR   Y,D
E5AE E784             (    forth6809.asm):03547                     STB   ,X
E5B0 DC37             (    forth6809.asm):03548                     LDD   ACNT
E5B2 C30001           (    forth6809.asm):03549                     ADDD  #1
E5B5 DD37             (    forth6809.asm):03550                     STD   ACNT
                      (    forth6809.asm):03551         
E5B7 1F20             (    forth6809.asm):03552                     TFR   Y,D
E5B9 4F               (    forth6809.asm):03553                     CLRA
E5BA 3606             (    forth6809.asm):03554                     PSHU  D
E5BC BDE575           (    forth6809.asm):03555                     JSR   EMITW
E5BF 20C9             (    forth6809.asm):03556                     BRA   ALOOP
                      (    forth6809.asm):03557         
E5C1 DC37             (    forth6809.asm):03558         ABKSP:      LDD   ACNT
E5C3 27C5             (    forth6809.asm):03559                     BEQ   ALOOP
E5C5 830001           (    forth6809.asm):03560                     SUBD  #1
E5C8 DD37             (    forth6809.asm):03561                     STD   ACNT
E5CA CC0008           (    forth6809.asm):03562                     LDD   #8
E5CD 3606             (    forth6809.asm):03563                     PSHU  D
E5CF BDE575           (    forth6809.asm):03564                     JSR   EMITW
E5D2 CC0020           (    forth6809.asm):03565                     LDD   #32
E5D5 3606             (    forth6809.asm):03566                     PSHU  D
E5D7 BDE575           (    forth6809.asm):03567                     JSR   EMITW
E5DA CC0008           (    forth6809.asm):03568                     LDD   #8
E5DD 3606             (    forth6809.asm):03569                     PSHU  D
E5DF BDE575           (    forth6809.asm):03570                     JSR   EMITW
E5E2 20A6             (    forth6809.asm):03571                     BRA   ALOOP
                      (    forth6809.asm):03572         
E5E4                  (    forth6809.asm):03573         ADONE:
                      (    forth6809.asm):03574                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03575                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03576                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03577                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03578                                             ; with KEY never polled at all
                      (    forth6809.asm):03579                     JSR   PUTXOFF
                      (    forth6809.asm):03580                     ENDC                    ; <<<<<<<<<<
E5E4 DC37             (    forth6809.asm):03581                     LDD   ACNT
E5E6 3606             (    forth6809.asm):03582                     PSHU  D                 ; +n2
E5E8 39               (    forth6809.asm):03583                     RTS
                      (    forth6809.asm):03584         
                      (    forth6809.asm):03585         ; ------------------------------------------------------------
                      (    forth6809.asm):03586         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03587         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03588         ; ------------------------------------------------------------
E5E9 BDE57D           (    forth6809.asm):03589         EXPECTW:    JSR   ACCEPTW
E5EC 3706             (    forth6809.asm):03590                     PULU  D
E5EE DDA1             (    forth6809.asm):03591                     STD   SPAN
E5F0 39               (    forth6809.asm):03592                     RTS
                      (    forth6809.asm):03593         
                      (    forth6809.asm):03594         ; ------------------------------------------------------------
                      (    forth6809.asm):03595         ; QUERY  ( -- )
                      (    forth6809.asm):03596         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03597         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03598         ; to 0 and >IN to 0.
                      (    forth6809.asm):03599         ; ------------------------------------------------------------
E5F1 8E0106           (    forth6809.asm):03600         QUERYW:     LDX   #TIBBUF
E5F4 3610             (    forth6809.asm):03601                     PSHU  X
E5F6 CC0050           (    forth6809.asm):03602                     LDD   #TIBBUFL
E5F9 3606             (    forth6809.asm):03603                     PSHU  D
E5FB BDE57D           (    forth6809.asm):03604                     JSR   ACCEPTW
E5FE 3706             (    forth6809.asm):03605                     PULU  D
E600 DD12             (    forth6809.asm):03606                     STD   NTIB
E602 DD9D             (    forth6809.asm):03607                     STD   SRCLEN
E604 CC0106           (    forth6809.asm):03608                     LDD   #TIBBUF
E607 DD9B             (    forth6809.asm):03609                     STD   SRCADDR
E609 CC0000           (    forth6809.asm):03610                     LDD   #0
E60C DD9F             (    forth6809.asm):03611                     STD   SRCID
E60E DD10             (    forth6809.asm):03612                     STD   TOIN
E610 39               (    forth6809.asm):03613                     RTS
                      (    forth6809.asm):03614         
                      (    forth6809.asm):03615         ; ============================================================
                      (    forth6809.asm):03616         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03617         ; ============================================================
                      (    forth6809.asm):03618         ; ------------------------------------------------------------
                      (    forth6809.asm):03619         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03620         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03621         ; one expected.
                      (    forth6809.asm):03622         ; CFERR
                      (    forth6809.asm):03623         ;    Inputs:
                      (    forth6809.asm):03624         ;        none
                      (    forth6809.asm):03625         ;    Outputs:
                      (    forth6809.asm):03626         ;        does not return (THROW -22)
                      (    forth6809.asm):03627         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03628         ; ------------------------------------------------------------
E611 CCFFEA           (    forth6809.asm):03629         CFERR:      LDD   #-22
E614 3606             (    forth6809.asm):03630                     PSHU  D                 ; -22
E616 BDE646           (    forth6809.asm):03631                     JSR   THROWW
E619 39               (    forth6809.asm):03632                     RTS
                      (    forth6809.asm):03633         
                      (    forth6809.asm):03634         ; ------------------------------------------------------------
                      (    forth6809.asm):03635         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03636         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03637         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03638         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03639         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03640         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03641         ; ------------------------------------------------------------
E61A 3710             (    forth6809.asm):03642         CATCHW:     PULU  X                 ; xt
E61C DC0C             (    forth6809.asm):03643                     LDD   HANDLER
E61E 3406             (    forth6809.asm):03644                     PSHS  D
E620 3440             (    forth6809.asm):03645                     PSHS  U
                      (    forth6809.asm):03646                     ; Save the input source specification.
                      (    forth6809.asm):03647                     ; See bugfix: CATCHW.1
E622 DC9B             (    forth6809.asm):03648                     LDD   SRCADDR
E624 3406             (    forth6809.asm):03649                     PSHS  D
E626 DC9D             (    forth6809.asm):03650                     LDD   SRCLEN
E628 3406             (    forth6809.asm):03651                     PSHS  D
E62A DC9F             (    forth6809.asm):03652                     LDD   SRCID
E62C 3406             (    forth6809.asm):03653                     PSHS  D
E62E DC10             (    forth6809.asm):03654                     LDD   TOIN
E630 3406             (    forth6809.asm):03655                     PSHS  D
E632 1F40             (    forth6809.asm):03656                     TFR   S,D
E634 DD0C             (    forth6809.asm):03657                     STD   HANDLER
                      (    forth6809.asm):03658         
E636 AD84             (    forth6809.asm):03659                     JSR   ,X
                      (    forth6809.asm):03660         
E638 3268             (    forth6809.asm):03661                     LEAS  8,S               ; drop saved input source
E63A 3262             (    forth6809.asm):03662                     LEAS  2,S               ; saved U
E63C 3506             (    forth6809.asm):03663                     PULS  D
E63E DD0C             (    forth6809.asm):03664                     STD   HANDLER
E640 CC0000           (    forth6809.asm):03665                     LDD   #0
E643 3606             (    forth6809.asm):03666                     PSHU  D                 ; 0 = no exception
E645 39               (    forth6809.asm):03667                     RTS
                      (    forth6809.asm):03668         
                      (    forth6809.asm):03669         ; ------------------------------------------------------------
                      (    forth6809.asm):03670         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03671         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03672         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03673         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03674         ; ------------------------------------------------------------
E646 3706             (    forth6809.asm):03675         THROWW:     PULU  D                 ; n
E648 10830000         (    forth6809.asm):03676                     CMPD  #0
E64C 2725             (    forth6809.asm):03677                     BEQ   THDONE
                      (    forth6809.asm):03678         
E64E DD0E             (    forth6809.asm):03679                     STD   THROWN
E650 9E0C             (    forth6809.asm):03680                     LDX   HANDLER
E652 2720             (    forth6809.asm):03681                     BEQ   THUNCAU
                      (    forth6809.asm):03682         
E654 1F14             (    forth6809.asm):03683                     TFR   X,S
E656 3506             (    forth6809.asm):03684                     PULS  D                 ; restore input source saved by CATCH
E658 DD10             (    forth6809.asm):03685                     STD   TOIN
E65A 3506             (    forth6809.asm):03686                     PULS  D
E65C DD9F             (    forth6809.asm):03687                     STD   SRCID
E65E 3506             (    forth6809.asm):03688                     PULS  D
E660 DD9D             (    forth6809.asm):03689                     STD   SRCLEN
E662 3506             (    forth6809.asm):03690                     PULS  D
E664 DD9B             (    forth6809.asm):03691                     STD   SRCADDR
E666 3506             (    forth6809.asm):03692                     PULS  D
E668 1F03             (    forth6809.asm):03693                     TFR   D,U
E66A 3506             (    forth6809.asm):03694                     PULS  D
E66C DD0C             (    forth6809.asm):03695                     STD   HANDLER
                      (    forth6809.asm):03696         
E66E DC0E             (    forth6809.asm):03697                     LDD   THROWN
E670 3606             (    forth6809.asm):03698                     PSHU  D
E672 39               (    forth6809.asm):03699                     RTS
E673 39               (    forth6809.asm):03700         THDONE:     RTS
                      (    forth6809.asm):03701         
                      (    forth6809.asm):03702                     ; No CATCH is active: leave n on the stack and ABORT.
E674 DC0E             (    forth6809.asm):03703         THUNCAU:    LDD   THROWN
E676 3606             (    forth6809.asm):03704                     PSHU  D
E678 7EDEC3           (    forth6809.asm):03705                     JMP   ABORT
                      (    forth6809.asm):03706         
                      (    forth6809.asm):03707         ; ============================================================
                      (    forth6809.asm):03708         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03709         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03710         ; ============================================================
                      (    forth6809.asm):03711         ; ------------------------------------------------------------
                      (    forth6809.asm):03712         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03713         ; location.
                      (    forth6809.asm):03714         ; PATCH   ( target location -- )
                      (    forth6809.asm):03715         ;    Inputs:
                      (    forth6809.asm):03716         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03717         ;    Outputs:
                      (    forth6809.asm):03718         ;        the cell at location holds target - location
                      (    forth6809.asm):03719         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03720         ; ------------------------------------------------------------
E67B 3710             (    forth6809.asm):03721         PATCH:      PULU  X                 ; location
E67D 3706             (    forth6809.asm):03722                     PULU  D                 ; target
E67F 3410             (    forth6809.asm):03723                     PSHS  X
E681 A3E1             (    forth6809.asm):03724                     SUBD  ,S++              ; target - location
E683 ED84             (    forth6809.asm):03725                     STD   ,X
E685 39               (    forth6809.asm):03726                     RTS
                      (    forth6809.asm):03727         
                      (    forth6809.asm):03728         ; ------------------------------------------------------------
                      (    forth6809.asm):03729         ; IF  ( C: -- orig )
                      (    forth6809.asm):03730         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03731         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
E686 CCDF70           (    forth6809.asm):03733         IFW:        LDD   #ZBRANCH
E689 3606             (    forth6809.asm):03734                     PSHU  D
E68B BDEABB           (    forth6809.asm):03735                     JSR   CCALL
E68E CC0000           (    forth6809.asm):03736                     LDD   #0
E691 3606             (    forth6809.asm):03737                     PSHU  D
E693 BDE002           (    forth6809.asm):03738                     JSR   CODECOMMA
E696 DC08             (    forth6809.asm):03739                     LDD   CODEHERE
E698 830002           (    forth6809.asm):03740                     SUBD  #2
E69B 3606             (    forth6809.asm):03741                     PSHU  D                 ; orig
E69D CC0001           (    forth6809.asm):03742                     LDD   #TAGFWD
E6A0 3606             (    forth6809.asm):03743                     PSHU  D
E6A2 39               (    forth6809.asm):03744                     RTS
                      (    forth6809.asm):03745         
                      (    forth6809.asm):03746         ; ------------------------------------------------------------
                      (    forth6809.asm):03747         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03748         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03749         ; operand to jump to the current code address.
                      (    forth6809.asm):03750         ; ------------------------------------------------------------
E6A3 3706             (    forth6809.asm):03751         THENW:      PULU  D
E6A5 10830001         (    forth6809.asm):03752                     CMPD  #TAGFWD
E6A9 2703             (    forth6809.asm):03753                     BEQ   THOK
E6AB BDE611           (    forth6809.asm):03754                     JSR   CFERR
E6AE 3710             (    forth6809.asm):03755         THOK:       PULU  X                 ; orig
E6B0 DC08             (    forth6809.asm):03756                     LDD   CODEHERE
E6B2 3606             (    forth6809.asm):03757                     PSHU  D
E6B4 3610             (    forth6809.asm):03758                     PSHU  X
E6B6 BDE67B           (    forth6809.asm):03759                     JSR   PATCH
E6B9 39               (    forth6809.asm):03760                     RTS
                      (    forth6809.asm):03761         
                      (    forth6809.asm):03762         ; ------------------------------------------------------------
                      (    forth6809.asm):03763         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03764         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03765         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03766         ; ------------------------------------------------------------
E6BA 3706             (    forth6809.asm):03767         ELSEW:      PULU  D
E6BC 10830001         (    forth6809.asm):03768                     CMPD  #TAGFWD
E6C0 2703             (    forth6809.asm):03769                     BEQ   ELOK
E6C2 BDE611           (    forth6809.asm):03770                     JSR   CFERR
E6C5 3706             (    forth6809.asm):03771         ELOK:       PULU  D                 ; orig1
E6C7 DD29             (    forth6809.asm):03772                     STD   MSCR              ; See bugfix: ELSEW.1
E6C9 CCDF86           (    forth6809.asm):03773                     LDD   #BRANCH
E6CC 3606             (    forth6809.asm):03774                     PSHU  D
E6CE BDEABB           (    forth6809.asm):03775                     JSR   CCALL
E6D1 CC0000           (    forth6809.asm):03776                     LDD   #0
E6D4 3606             (    forth6809.asm):03777                     PSHU  D
E6D6 BDE002           (    forth6809.asm):03778                     JSR   CODECOMMA
E6D9 DC08             (    forth6809.asm):03779                     LDD   CODEHERE
E6DB 830002           (    forth6809.asm):03780                     SUBD  #2
E6DE DD41             (    forth6809.asm):03781                     STD   NEWFLD
E6E0 DC08             (    forth6809.asm):03782                     LDD   CODEHERE
E6E2 3606             (    forth6809.asm):03783                     PSHU  D
E6E4 DC29             (    forth6809.asm):03784                     LDD   MSCR
E6E6 3606             (    forth6809.asm):03785                     PSHU  D
E6E8 BDE67B           (    forth6809.asm):03786                     JSR   PATCH
E6EB DC41             (    forth6809.asm):03787                     LDD   NEWFLD

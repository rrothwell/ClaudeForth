                      (    forth6809.asm):08311                    STD  TOIN
                      (    forth6809.asm):08312         
                      (    forth6809.asm):08313                    LDX  TSTDOESA  ; BUG FIX: was preceded by restoring LATEST
                      (    forth6809.asm):08314                                   ; to its real value here - but SETDOES
                      (    forth6809.asm):08315                                   ; (confirmed by reading its own code) reads
                      (    forth6809.asm):08316                                   ; LATEST directly to find which header to
                      (    forth6809.asm):08317                                   ; patch, so restoring it first meant SETDOES
                      (    forth6809.asm):08318                                   ; patched the real, wrong word instead of
                      (    forth6809.asm):08319                                   ; TESTWD, leaving TESTWD stuck on its
                      (    forth6809.asm):08320                                   ; original DOESRT0 placeholder. LATEST now
                      (    forth6809.asm):08321                                   ; stays pointed at TESTWD (this test's own
                      (    forth6809.asm):08322                                   ; fake header) until right after this call.
                      (    forth6809.asm):08323                    JSR  ,X
                      (    forth6809.asm):08324         
                      (    forth6809.asm):08325                    LDD  TSTLSAV
                      (    forth6809.asm):08326                    STD  LATEST

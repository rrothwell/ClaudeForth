                      (    forth6809.asm):06579                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):06580                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):06581                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):06582                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):06583                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):06584                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):06585                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):06586                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):06587                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):06588                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):06589                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):06590                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):06591                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):06592                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):06593                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):06594                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):06595                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):06596                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):06597                    ; wrong algorithm entirely, not a smaller bug within it.
F721 DCA9             (    forth6809.asm):06598         UELOOP:    LDD  UESRCLEN
F723 2715             (    forth6809.asm):06599                    BEQ  UEDONE
F725 A680             (    forth6809.asm):06600                    LDA  ,X+
F727 8125             (    forth6809.asm):06601                    CMPA #'%'
F729 2604             (    forth6809.asm):06602                    BNE  UENOTPCT
F72B C625             (    forth6809.asm):06603                    LDB  #'%'      ; write the extra '%' first - the character
F72D E7A0             (    forth6809.asm):06604                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06605                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06606                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06607                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06608                                   ; independently for each one the loop visits.
F72F A7A0             (    forth6809.asm):06609         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06610                                   ; every character, '%' or not
F731 DCA9             (    forth6809.asm):06611                    LDD  UESRCLEN
F733 830001           (    forth6809.asm):06612                    SUBD #1
F736 DDA9             (    forth6809.asm):06613                    STD  UESRCLEN
F738 20E7             (    forth6809.asm):06614                    BRA  UELOOP
F73A 1F20             (    forth6809.asm):06615         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F73C 93AB             (    forth6809.asm):06616                    SUBD UEDST     ; overwriting whatever was left on top of
F73E DDAD             (    forth6809.asm):06617                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06618                                   ; required return values, and separately,
                      (    forth6809.asm):06619                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06620                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06621                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06622                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06623                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06624                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06625                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06626                                   ; correct regardless of how many characters
                      (    forth6809.asm):06627                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06628                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06629                                   ; incremented alongside it.
F740 DCAB             (    forth6809.asm):06630                    LDD  UEDST
F742 3606             (    forth6809.asm):06631                    PSHU D         ; push c-addr2 (destination address)
F744 DCAD             (    forth6809.asm):06632                    LDD  UEOUTLEN
F746 3606             (    forth6809.asm):06633                    PSHU D         ; push u2 (actual unescaped length)
F748 39               (    forth6809.asm):06634                    RTS
                      (    forth6809.asm):06635         

                      (    forth6809.asm):03789                  LDA   #CR_RXTX
                      (    forth6809.asm):03790                  STA   ACIACR
E476                  (    forth6809.asm):03791         EMITNORTS: RTS
                      (    forth6809.asm):03792         
E476                  (    forth6809.asm):03793         EMIT:
                      (    forth6809.asm):03794                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03795                     TFR   B,A               
                      (    forth6809.asm):03796                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03797                     RTS                     
                      (    forth6809.asm):03798         

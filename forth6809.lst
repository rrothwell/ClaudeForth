                      (    forth6809.asm):05306         ; ------------------------------------------------------------
DD73 108E0000         (    forth6809.asm):05307         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DD77 1F31             (    forth6809.asm):05308                     TFR   U,X               ; X = scan pointer
DD79 9C21             (    forth6809.asm):05309         EXSCAN:     CMPX  CSP
DD7B 270E             (    forth6809.asm):05310                     BEQ   EXSCANDONE
DD7D EC84             (    forth6809.asm):05311                     LDD   ,X
DD7F 10830003         (    forth6809.asm):05312                     CMPD  #TAGDO
DD83 2602             (    forth6809.asm):05313                     BNE   EXNOTDO
DD85 3121             (    forth6809.asm):05314                     LEAY  1,Y
DD87 3004             (    forth6809.asm):05315         EXNOTDO:    LEAX  4,X
DD89 20EE             (    forth6809.asm):05316                     BRA   EXSCAN
DD8B                  (    forth6809.asm):05317         EXSCANDONE:
DD8B 3420             (    forth6809.asm):05318                     PSHS  Y                 ; the count survives CCALL on S
DD8D CCDD9D           (    forth6809.asm):05319                     LDD   #EXITUNLOOP
DD90 3606             (    forth6809.asm):05320                     PSHU  D
DD92 BDDE7F           (    forth6809.asm):05321                     JSR   CCALL
DD95 3506             (    forth6809.asm):05322                     PULS  D

                      (    forth6809.asm):06444         ;    Registers: RegB, RegD and RegX changed; SPTR and SCNT used as
                      (    forth6809.asm):06445         ;        scratch.
                      (    forth6809.asm):06446         ; ------------------------------------------------------------
F4B4 3510             (    forth6809.asm):06447         DOTSTR:     PULS  X

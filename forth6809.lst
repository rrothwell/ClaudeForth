                      (    forth6809.asm):05912         ; ------------------------------------------------------------
E4B3 3706             (    forth6809.asm):05913         MINW:       PULU  D                 ; n2
E4B5 10A3C4           (    forth6809.asm):05914                     CMPD  ,U

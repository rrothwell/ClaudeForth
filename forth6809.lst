     FFEC             (    forth6809.asm):07641         INITEND  EQU   *          ; Verify no collision with vectors, value should match vector ORG
     0048             (    forth6809.asm):07642         INITSIZE EQU   INITEND-INITCODE
                      (    forth6809.asm):07643         
                      (    forth6809.asm):07644         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07645         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):07646         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):07647                  FILL $FF,VECTORS-INITEND
                      (    forth6809.asm):07648         
                      (    forth6809.asm):07649         ; ============================================================
                      (    forth6809.asm):07650         ; SECTION 1: HARDWARE VECTOR TABLE
                      (    forth6809.asm):07651         ; ============================================================
                      (    forth6809.asm):07652                  ORG   VECTORS       ; VECTORS is $FFF0
FFF0 0000             (    forth6809.asm):07653         VRESV    FDB   $0000
FFF2 DED7             (    forth6809.asm):07654         VSWI3    FDB   SWI3H
FFF4 DED8             (    forth6809.asm):07655         VSWI2    FDB   SWI2H
FFF6 DED9             (    forth6809.asm):07656         VFIRQ    FDB   FIRQH
FFF8 DE6F             (    forth6809.asm):07657         VIRQ     FDB   IRQH
FFFA DEDB             (    forth6809.asm):07658         VSWI     FDB   SWIH
FFFC FFC5             (    forth6809.asm):07659         VNMI     FDB   WARM            ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):07660         VRESET   FDB   COLDSTRT
                      (    forth6809.asm):07661         
     0000             (    forth6809.asm):07662         VECTOREND  EQU   *          ; Verify vectors size, value should match $10.

                      (    forth6809.asm):01760         ; DEPTH itself uses, rather than assuming a fixed starting
                      (    forth6809.asm):01761         ; depth - robust regardless of whatever is already on the stack
                      (    forth6809.asm):01762         ; when this test runs. Also verifies DEPTH's own net effect
                      (    forth6809.asm):01763         ; (exactly one cell pushed) and that the three items pushed to
                      (    forth6809.asm):01764         ; set up the test are left undisturbed.
                      (    forth6809.asm):01765         ; ------------------------------------------------------------

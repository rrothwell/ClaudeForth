                      (    forth6809.asm):05107         ; Common part of /, MOD and /MOD: divide n1 by n2 with the sign
                      (    forth6809.asm):05108         ; handling for truncating division. THROW -10 if n2 is zero.
                      (    forth6809.asm):05109         ; DIVCOMMON   ( n1 n2 -- )
                      (    forth6809.asm):05110         ;    Inputs:
                      (    forth6809.asm):05111         ;        n1 and n2 on the data stack (n2 on top)
                      (    forth6809.asm):05112         ;    Outputs:
                      (    forth6809.asm):05113         ;        DIVNUM = quotient, DIVREM = remainder (data stack popped)
                      (    forth6809.asm):05114         ;    Registers: RegD changed; DIVNUM, DIVDEN, DIVREM, DNSIGN, DVSIGN
                      (    forth6809.asm):05115         ;        used.
                      (    forth6809.asm):05116         ; ------------------------------------------------------------
EC2B 3706             (    forth6809.asm):05117         DIVCOMMON:  PULU  D                 ; n2

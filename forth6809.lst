                      (    forth6809.asm):02923         ; NONAME (":NONAME", CORE EXT): like COLON, but deliberately skips
                      (    forth6809.asm):02924         ; HEADER entirely - no WORD call (consumes no name from the input),
                      (    forth6809.asm):02925         ; no new header written at DPHERE, and LATEST is left completely
                      (    forth6809.asm):02926         ; untouched. That's the ANS-required "no-name" definition: never
                      (    forth6809.asm):02927         ; findable by FIND, never linked into the dictionary chain at all.
                      (    forth6809.asm):02928         ; In this subroutine-threaded system the execution token IS the code
                      (    forth6809.asm):02929         ; address (no separate CFA indirection, unlike CREATE's DODOES
                      (    forth6809.asm):02930         ; trampoline), so the xt ANS requires :NONAME to leave on the stack
                      (    forth6809.asm):02931         ; is simply CODEHERE at this instant - identical to what HEREW
                      (    forth6809.asm):02932         ; returns - pushed BEFORE compilation of the body begins, matching
                      (    forth6809.asm):02933         ; where ANS says :NONAME produces it. CSP is snapshotted AFTER that
                      (    forth6809.asm):02934         ; push (mirroring COLON's own CSP snapshot, taken after HEADER's
                      (    forth6809.asm):02935         ; transient pushes/pops have already netted back to baseline) so
                      (    forth6809.asm):02936         ; SEMI's control-flow consistency check at ";" only catches a
                      (    forth6809.asm):02937         ; genuinely unbalanced IF/DO etc. left over from the body, not the
                      (    forth6809.asm):02938         ; xt itself, which is meant to still be there when ";" returns.
                      (    forth6809.asm):02939         ; SEMI itself needs no changes: its unsmudge-the-word-at-LATEST step
                      (    forth6809.asm):02940         ; still targets whatever LATEST already was (the previous NAMED
                      (    forth6809.asm):02941         ; word, untouched by this routine) - a harmless no-op there, since a
                      (    forth6809.asm):02942         ; normal definition is already unsmudged by the time any later
                      (    forth6809.asm):02943         ; definition's SEMI runs.
DFA8 DC08             (    forth6809.asm):02944         NONAME:  LDD   CODEHERE
DFAA 3606             (    forth6809.asm):02945                  PSHU  D
DFAC 1F30             (    forth6809.asm):02946                  TFR   U,D
DFAE DD48             (    forth6809.asm):02947                  STD   CSP
DFB0 CCFFFF           (    forth6809.asm):02948                  LDD   #-1
DFB3 DD00             (    forth6809.asm):02949                  STD   STATE
DFB5 39               (    forth6809.asm):02950                  RTS
                      (    forth6809.asm):02951         
DFB6 CC0000           (    forth6809.asm):02952         CREATE:  LDD   #0
DFB9 3606             (    forth6809.asm):02953                  PSHU  D
DFBB BDDF33           (    forth6809.asm):02954                  JSR   HEADER
DFBE CCDE6D           (    forth6809.asm):02955                  LDD   #DODOES
DFC1 3606             (    forth6809.asm):02956                  PSHU  D
DFC3 BDEA01           (    forth6809.asm):02957                  JSR   CCALL
DFC6 CCDE78           (    forth6809.asm):02958                  LDD   #DOESRT0
DFC9 3606             (    forth6809.asm):02959                  PSHU  D
DFCB BDDEE1           (    forth6809.asm):02960                  JSR   CODECOMMA
DFCE DC08             (    forth6809.asm):02961                  LDD   CODEHERE  ; BUG FIX: same self-referential PFA bug as
DFD0 C30002           (    forth6809.asm):02962                  ADDD  #2        ; CONSTANT/DEFER/2CONSTANT/MARKER (CONSTANT's
DFD3 3606             (    forth6809.asm):02963                  PSHU  D         ; instance confirmed via MAME debugger) -
DFD5 BDDEE1           (    forth6809.asm):02964                  JSR   CODECOMMA ; without +2 this pointed at itself instead
                      (    forth6809.asm):02965                                   ; of the value cell that "," appends next.
                      (    forth6809.asm):02966                                   ; Never on the previously-flagged list (only
                      (    forth6809.asm):02967                                   ; DEFER/2CONSTANT/MARKER were), so it went
                      (    forth6809.asm):02968                                   ; unfixed until confirmed by inspection here.
                      (    forth6809.asm):02969                                   ; Confirmed via MAME: ": ENUM CREATE , DOES>
                      (    forth6809.asm):02970                                   ; @ ;" returned the PFA-pointer field's own
                      (    forth6809.asm):02971                                   ; address instead of the value COMMA stored
                      (    forth6809.asm):02972                                   ; one cell further on - exactly "the address
                      (    forth6809.asm):02973                                   ; before the 16-bit constant" instead of the
                      (    forth6809.asm):02974                                   ; address 1 cell further on, matching a
                      (    forth6809.asm):02975                                   ; user-reported MAME trace precisely.

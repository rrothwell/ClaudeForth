                      (    forth6809.asm):07990         ; ------------------------------------------------------------
                      (    forth6809.asm):07991         ; TRUE  ( -- flag )
                      (    forth6809.asm):07992         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):07993         ; DODOES trampoline and no value cell.

                      (    forth6809.asm):07799         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):07800         ; ============================================================
                      (    forth6809.asm):07801         ; ------------------------------------------------------------
                      (    forth6809.asm):07802         ; TRUE  ( -- flag )
                      (    forth6809.asm):07803         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):07804         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):07805         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):07806         ; ------------------------------------------------------------
FD35 CCFFFF           (    forth6809.asm):07807         TRUEW:      LDD   #$FFFF
FD38 3606             (    forth6809.asm):07808                     PSHU  D
FD3A 39               (    forth6809.asm):07809                     RTS
                      (    forth6809.asm):07810         
                      (    forth6809.asm):07811         ; ------------------------------------------------------------
                      (    forth6809.asm):07812         ; FALSE  ( -- flag )
                      (    forth6809.asm):07813         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):07814         ; ------------------------------------------------------------
FD3B CC0000           (    forth6809.asm):07815         FALSEW:     LDD   #$0000
FD3E 3606             (    forth6809.asm):07816                     PSHU  D
FD40 39               (    forth6809.asm):07817                     RTS
                      (    forth6809.asm):07818         
                      (    forth6809.asm):07819         ; ------------------------------------------------------------
                      (    forth6809.asm):07820         ; 1  ( -- 1 )
                      (    forth6809.asm):07821         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):07822         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):07823         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):07824         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):07825         ; ------------------------------------------------------------
FD41 CC0001           (    forth6809.asm):07826         POSONEW:    LDD   #1
FD44 3606             (    forth6809.asm):07827                     PSHU  D
FD46 39               (    forth6809.asm):07828                     RTS
                      (    forth6809.asm):07829         
                      (    forth6809.asm):07830         ; ------------------------------------------------------------
                      (    forth6809.asm):07831         ; -1  ( -- -1 )
                      (    forth6809.asm):07832         ; Push the constant -1.
                      (    forth6809.asm):07833         ; ------------------------------------------------------------
FD47 CCFFFF           (    forth6809.asm):07834         NEGONEW:    LDD   #-1
FD4A 3606             (    forth6809.asm):07835                     PSHU  D
FD4C 39               (    forth6809.asm):07836                     RTS
                      (    forth6809.asm):07837         
                      (    forth6809.asm):07838         ; ------------------------------------------------------------
                      (    forth6809.asm):07839         ; 2  ( -- 2 )
                      (    forth6809.asm):07840         ; Push the constant 2.
                      (    forth6809.asm):07841         ; ------------------------------------------------------------
FD4D CC0002           (    forth6809.asm):07842         POSTWOW:    LDD   #2
FD50 3606             (    forth6809.asm):07843                     PSHU  D
FD52 39               (    forth6809.asm):07844                     RTS
                      (    forth6809.asm):07845         
                      (    forth6809.asm):07846         ; ------------------------------------------------------------
                      (    forth6809.asm):07847         ; -2  ( -- -2 )
                      (    forth6809.asm):07848         ; Push the constant -2.
                      (    forth6809.asm):07849         ; ------------------------------------------------------------
FD53 CCFFFE           (    forth6809.asm):07850         NEGTWOW:    LDD   #-2
FD56 3606             (    forth6809.asm):07851                     PSHU  D
FD58 39               (    forth6809.asm):07852                     RTS
                      (    forth6809.asm):07853         
                      (    forth6809.asm):07854         ; Verify no collision with init code,
                      (    forth6809.asm):07855         ; value should match ORG INITCODE.
     FD59             (    forth6809.asm):07856         BASECODEEND EQU   *
     2095             (    forth6809.asm):07857         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07858         

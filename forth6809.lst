                      (    forth6809.asm):02165         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02166         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02167         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02168         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02169         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02170         ;    Inputs:
                      (    forth6809.asm):02171         ;        none
                      (    forth6809.asm):02172         ;    Outputs:
                      (    forth6809.asm):02173         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02174         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02175         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02176         ; ------------------------------------------------------------
D2CE                  (    forth6809.asm):02177         FLUSHOUTBUFFER:
D2CE F6017A           (    forth6809.asm):02178                     LDB   OUTTAIL
D2D1 F10179           (    forth6809.asm):02179                     CMPB  OUTHEAD           ; Is transmit buffer empty?
D2D4 2719             (    forth6809.asm):02180                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02181         
D2D6 B6C008           (    forth6809.asm):02182                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
D2D9 8508             (    forth6809.asm):02183                     BITA  #SR_CTS
D2DB 2612             (    forth6809.asm):02184                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02185         
D2DD 8502             (    forth6809.asm):02186                     BITA  #SR_TDRE          ; Is transmit register empty?
D2DF 270E             (    forth6809.asm):02187                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02188                                             ; than spin-wait here.
                      (    forth6809.asm):02189         
D2E1 8E01C0           (    forth6809.asm):02190                     LDX   #OUTBUF           ; The out buffer is occupied.
D2E4 A685             (    forth6809.asm):02191                     LDA   B,X               ; Get the character from the out buffer.
D2E6 B7C009           (    forth6809.asm):02192                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02193         
D2E9 5C               (    forth6809.asm):02194                     INCB                    ; Update tail pointer to next character slot.
D2EA C43F             (    forth6809.asm):02195                     ANDB  #OUTBUFSZ-1
D2EC F7017A           (    forth6809.asm):02196                     STB   OUTTAIL

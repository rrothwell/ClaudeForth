                      (    forth6809.asm):10333                       LDA  5,X
                      (    forth6809.asm):10334                       CMPA #OPJSR
                      (    forth6809.asm):10335                       BNE  PP1FAIL
                      (    forth6809.asm):10336                       LDD  6,X
                      (    forth6809.asm):10337                       CMPD #COMPILECOMMA
                      (    forth6809.asm):10338                       BNE  PP1FAIL
                      (    forth6809.asm):10339         
                      (    forth6809.asm):10340                       LDD  #TRUEV
                      (    forth6809.asm):10341                       BRA  PP1DONE
C27B                  (    forth6809.asm):10342         PP1FAIL:      LDD  #FALSEV
C27B                  (    forth6809.asm):10343         PP1DONE:      LDX  #TSTPP1NAME
                      (    forth6809.asm):10344                       PSHU X

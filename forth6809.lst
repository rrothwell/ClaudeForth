                      (    forth6809.asm):10245         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):10246         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):10247         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):10248         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):10249         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):10250         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):10251         ; ============================================================
                      (    forth6809.asm):10252         ; ------------------------------------------------------------
                      (    forth6809.asm):10253         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):10254         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):10255         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):10256         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):10257         ; - no indirection, no value cell.
                      (    forth6809.asm):10258         ;
                      (    forth6809.asm):10259         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):10260         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):10261         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):10262         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):10263         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):10264         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):10265         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):10266         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):10267         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):10268         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):10269         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):10270         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):10271                    PSHU  D
FF3C 39               (    forth6809.asm):10272                    RTS
                      (    forth6809.asm):10273         
FF3D CC0000           (    forth6809.asm):10274         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):10275                    PSHU  D
FF42 39               (    forth6809.asm):10276                    RTS
                      (    forth6809.asm):10277         
                      (    forth6809.asm):10278         ; ------------------------------------------------------------
                      (    forth6809.asm):10279         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):10280         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):10281         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):10282         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):10283         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):10284         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):10285                    PSHU  D
FF48 39               (    forth6809.asm):10286                    RTS
                      (    forth6809.asm):10287         
FF49 CCFFFF           (    forth6809.asm):10288         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):10289                    PSHU  D
FF4E 39               (    forth6809.asm):10290                    RTS
                      (    forth6809.asm):10291         
FF4F CC0002           (    forth6809.asm):10292         TWOBODY:   LDD   #2

                      (    forth6809.asm):00767         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):00768         ; they're written.
                      (    forth6809.asm):00769         ; ------------------------------------------------------------
C148 BDFC2B           (    forth6809.asm):00770         TSTSTACK:  JSR   CRW
C14B 8EC15C           (    forth6809.asm):00771                    LDX   #TSTSTACKMSG
C14E 3610             (    forth6809.asm):00772                    PSHU  X
C150 CC0005           (    forth6809.asm):00773                    LDD   #5
C153 3606             (    forth6809.asm):00774                    PSHU  D
C155 BDF60B           (    forth6809.asm):00775                    JSR   TYPE
C158 BDFC2B           (    forth6809.asm):00776                    JSR   CRW
                      (    forth6809.asm):00777         
                      (    forth6809.asm):00778                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00779         
                      (    forth6809.asm):00780                    JSR   TSTDUP
                      (    forth6809.asm):00781                    JSR   TSTDROP
                      (    forth6809.asm):00782                    JSR   TSTSWAP
                      (    forth6809.asm):00783                    JSR   TSTOVER
                      (    forth6809.asm):00784                    JSR   TSTROT
                      (    forth6809.asm):00785                    JSR   TSTQDUPNZ
                      (    forth6809.asm):00786                    JSR   TSTQDUPZ
                      (    forth6809.asm):00787                    JSR   TSTDEPTH
                      (    forth6809.asm):00788                    JSR   TSTDDUP
                      (    forth6809.asm):00789                    JSR   TSTDDROP
                      (    forth6809.asm):00790                    JSR   TSTDSWAP
                      (    forth6809.asm):00791                    JSR   TSTDOVER
                      (    forth6809.asm):00792                    JSR   TSTNIP
                      (    forth6809.asm):00793                    JSR   TSTTUCK
                      (    forth6809.asm):00794                    JSR   TSTPICK
                      (    forth6809.asm):00795                    JSR   TSTROLL
                      (    forth6809.asm):00796                    JSR   TSTDROT

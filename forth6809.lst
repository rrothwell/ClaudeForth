DEE6 DEDD             (    forth6809.asm):14850                  FDB   H_2
DEE8 FF55             (    forth6809.asm):14851                  FDB   MTWOBODY
                      (    forth6809.asm):14852         
     DEE3             (    forth6809.asm):14853         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):14854                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):14855                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):14856                                   ; were chained on after it; before that,
                      (    forth6809.asm):14857                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):14858                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):14859                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):14860                                   ; before this one.
                      (    forth6809.asm):14861         
                      (    forth6809.asm):14862         ; Verify no collision with base code.
                      (    forth6809.asm):14863         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):14864         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):14865         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):14866         
                      (    forth6809.asm):14867         ; ============================================================
                      (    forth6809.asm):14868         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):14869         ; ============================================================
                      (    forth6809.asm):14870                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):14871                                        ; entirely - every routine from here through
                      (    forth6809.asm):14872                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):14873                                        ; every primitive) would otherwise have
                      (    forth6809.asm):14874                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):14875                                        ; WARM message left the location counter,
                      (    forth6809.asm):14876                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):14877                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):14878                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):14879         
                      (    forth6809.asm):14880         ; ------------------------------------------------------------
                      (    forth6809.asm):14881         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):14882         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):14883         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):14884         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):14885         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):14886         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):14887         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):14888                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):14889                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):14890                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):14891                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):14892                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):14893                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):14894                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):14895                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):14896                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):14897                  RTS
                      (    forth6809.asm):14898         
                      (    forth6809.asm):14899                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):14900         ; ------------------------------------------------------------
                      (    forth6809.asm):14901         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):14902         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):14903         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):14904         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):14905         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):14906         INFILL:  LDA   INHEAD
                      (    forth6809.asm):14907                  SUBA  INTAIL
                      (    forth6809.asm):14908                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):14909                  RTS
                      (    forth6809.asm):14910         
                      (    forth6809.asm):14911         ; ------------------------------------------------------------
                      (    forth6809.asm):14912         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):14913         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):14914         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):14915         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):14916         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):14917         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):14918         ; flow control, not a chip feature.
                      (    forth6809.asm):14919         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):14920         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):14921                     CMPA #INHIWATER
                      (    forth6809.asm):14922                     BLO  RTSCHIDONE
                      (    forth6809.asm):14923                     TST  RTSSTATE
                      (    forth6809.asm):14924                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):14925                     LDA  #CR_RTSHI
                      (    forth6809.asm):14926                     STA  ACIACR
                      (    forth6809.asm):14927                     LDA  #1
                      (    forth6809.asm):14928                     STA  RTSSTATE
DEF5                  (    forth6809.asm):14929         RTSCHIDONE: RTS
                      (    forth6809.asm):14930         
                      (    forth6809.asm):14931         ; ------------------------------------------------------------
                      (    forth6809.asm):14932         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):14933         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):14934         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):14935         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):14936         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):14937         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):14938         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):14939         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):14940         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):14941         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):14942         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):14943                     CMPA #INLOWATER
                      (    forth6809.asm):14944                     BHI  RTSCLODONE
                      (    forth6809.asm):14945                     TST  RTSSTATE

EBE6 3410             (    forth6809.asm):04868                     PSHS  X
EBE8 39               (    forth6809.asm):04869                     RTS
                      (    forth6809.asm):04870         
                      (    forth6809.asm):04871         ; ------------------------------------------------------------
                      (    forth6809.asm):04872         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):04873         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):04874         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):04875         ; the transfer.
                      (    forth6809.asm):04876         ; ------------------------------------------------------------
EBE9 3510             (    forth6809.asm):04877         FROMRW:     PULS  X

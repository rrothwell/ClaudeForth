                      (    forth6809.asm):02147                    LDD   #TSTVAL2
                      (    forth6809.asm):02148                    PSHU  D
                      (    forth6809.asm):02149                    LDD   #TSTVAL3
                      (    forth6809.asm):02150                    PSHU  D
                      (    forth6809.asm):02151                    LDD   #2
                      (    forth6809.asm):02152                    PSHU  D
                      (    forth6809.asm):02153                    STU   TSTUB4
                      (    forth6809.asm):02154         
                      (    forth6809.asm):02155                    JSR   PICK
                      (    forth6809.asm):02156         
                      (    forth6809.asm):02157                    STU   TSTUAF
                      (    forth6809.asm):02158         

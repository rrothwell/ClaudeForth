                      (    forth6809.asm):04825         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):04826         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):04827         ; the string.
                      (    forth6809.asm):04828         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):04829         ;    Inputs:
                      (    forth6809.asm):04830         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):04831         ;        count byte
                      (    forth6809.asm):04832         ;    Outputs:
                      (    forth6809.asm):04833         ;        execution continues after the string, or THROW -2

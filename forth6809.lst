                      (    forth6809.asm):02080         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02081         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02082         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02083         ; "ERROR n"; -1 (ABORT) is silent. Never returns.

                      (    forth6809.asm):08527         ; ------------------------------------------------------------
                      (    forth6809.asm):08528         ; <#  ( -- )
                      (    forth6809.asm):08529         ; Start a pictured numeric output string: HLD is set to the end of
                      (    forth6809.asm):08530         ; PAD. The string is built backwards from there.
                      (    forth6809.asm):08531         ; ------------------------------------------------------------
ED6C BDD010           (    forth6809.asm):08532         LTNUMW:     JSR   PADW

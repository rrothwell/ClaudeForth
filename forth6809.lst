C27B                  (    forth6809.asm):10799         AQ1DONE:    LDX  #TSTAQ1NAME
                      (    forth6809.asm):10800                     PSHU X
                      (    forth6809.asm):10801                     PSHU D
                      (    forth6809.asm):10802                     JSR  TSTREPORT
                      (    forth6809.asm):10803         
                      (    forth6809.asm):10804                     LDU  TSTU0
                      (    forth6809.asm):10805                     RTS
                      (    forth6809.asm):10806         
C27B                  (    forth6809.asm):10807         TSTAQ1NAME: FCB  10
                      (    forth6809.asm):10808                     FCC  "TSTABORTQ1"
                      (    forth6809.asm):10809         
                      (    forth6809.asm):10810         ; ------------------------------------------------------------
                      (    forth6809.asm):10811         ; TSTABORTQ2 - unit test for ABORT", true-flag case. Same
                      (    forth6809.asm):10812         ; compiled snippet as TSTABORTQ1, executed via CATCH with a true
                      (    forth6809.asm):10813         ; flag instead. Confirmed by reading DOABORTQUOTE's own code
                      (    forth6809.asm):10814         ; that it uses THROW -2 internally, not the raw, never-returns
                      (    forth6809.asm):10815         ; ABORT mechanism plain ABORT itself uses (which remains
                      (    forth6809.asm):10816         ; deliberately untested, per section 3.1's own reasoning) - so
                      (    forth6809.asm):10817         ; this case is safe to test directly, unlike plain ABORT would
                      (    forth6809.asm):10818         ; be.
                      (    forth6809.asm):10819         ; ------------------------------------------------------------
C27B                  (    forth6809.asm):10820         TSTABORTQ2: LDD  CODEHERE
                      (    forth6809.asm):10821                     STD  TSTCSAV
                      (    forth6809.asm):10822                     LDD  SRCADDR
                      (    forth6809.asm):10823                     STD  TSTSASAV
                      (    forth6809.asm):10824                     LDD  SRCLEN
                      (    forth6809.asm):10825                     STD  TSTSLSAV
                      (    forth6809.asm):10826                     LDD  TOIN
                      (    forth6809.asm):10827                     STD  TSTTISAV
                      (    forth6809.asm):10828                     LDD  STATE
                      (    forth6809.asm):10829                     STD  TSTSTSAV
                      (    forth6809.asm):10830         
                      (    forth6809.asm):10831                     LDA  #'H'
                      (    forth6809.asm):10832                     STA  TSTNAMEB
                      (    forth6809.asm):10833                     LDA  #'I'
                      (    forth6809.asm):10834                     STA  TSTNAMEB+1
                      (    forth6809.asm):10835                     LDA  #34
                      (    forth6809.asm):10836                     STA  TSTNAMEB+2
                      (    forth6809.asm):10837         
                      (    forth6809.asm):10838                     LDD  #TSTCBUF
                      (    forth6809.asm):10839                     STD  CODEHERE
                      (    forth6809.asm):10840                     LDD  #TSTNAMEB
                      (    forth6809.asm):10841                     STD  SRCADDR
                      (    forth6809.asm):10842                     LDD  #3
                      (    forth6809.asm):10843                     STD  SRCLEN
                      (    forth6809.asm):10844                     LDD  #0
                      (    forth6809.asm):10845                     STD  TOIN
                      (    forth6809.asm):10846                     LDD  #-1
                      (    forth6809.asm):10847                     STD  STATE
                      (    forth6809.asm):10848         
                      (    forth6809.asm):10849                     JSR  ABORTQUOTE
                      (    forth6809.asm):10850         
                      (    forth6809.asm):10851                     LDD  #OPRTS
                      (    forth6809.asm):10852                     PSHU D
                      (    forth6809.asm):10853                     JSR  CCOMMA
                      (    forth6809.asm):10854         
                      (    forth6809.asm):10855                     LDD  TSTCSAV
                      (    forth6809.asm):10856                     STD  CODEHERE
                      (    forth6809.asm):10857                     LDD  TSTSASAV
                      (    forth6809.asm):10858                     STD  SRCADDR
                      (    forth6809.asm):10859                     LDD  TSTSLSAV
                      (    forth6809.asm):10860                     STD  SRCLEN
                      (    forth6809.asm):10861                     LDD  TSTTISAV
                      (    forth6809.asm):10862                     STD  TOIN
                      (    forth6809.asm):10863                     LDD  TSTSTSAV
                      (    forth6809.asm):10864                     STD  STATE
                      (    forth6809.asm):10865         
                      (    forth6809.asm):10866                     STU  TSTU0
                      (    forth6809.asm):10867         
                      (    forth6809.asm):10868                     LDD  #TRUEV
                      (    forth6809.asm):10869                     PSHU D
                      (    forth6809.asm):10870                     LDX  #TSTCBUF
                      (    forth6809.asm):10871                     PSHU X
                      (    forth6809.asm):10872                     STU  TSTUB4
                      (    forth6809.asm):10873         
                      (    forth6809.asm):10874                     JSR  CATCH
                      (    forth6809.asm):10875         
                      (    forth6809.asm):10876                     STU  TSTUAF
                      (    forth6809.asm):10877         
                      (    forth6809.asm):10878                     PULU D
                      (    forth6809.asm):10879                     CMPD #-2
                      (    forth6809.asm):10880                     BNE  AQ2FAIL
                      (    forth6809.asm):10881         
                      (    forth6809.asm):10882                     LDD  TSTUB4
                      (    forth6809.asm):10883                     SUBD TSTUAF
                      (    forth6809.asm):10884                     CMPD #0
                      (    forth6809.asm):10885                     BNE  AQ2FAIL
                      (    forth6809.asm):10886         
                      (    forth6809.asm):10887                     LDD  #TRUEV
                      (    forth6809.asm):10888                     BRA  AQ2DONE
C27B                  (    forth6809.asm):10889         AQ2FAIL:    LDD  #FALSEV
C27B                  (    forth6809.asm):10890         AQ2DONE:    LDX  #TSTAQ2NAME
                      (    forth6809.asm):10891                     PSHU X
                      (    forth6809.asm):10892                     PSHU D
                      (    forth6809.asm):10893                     JSR  TSTREPORT
                      (    forth6809.asm):10894         
                      (    forth6809.asm):10895                     LDU  TSTU0
                      (    forth6809.asm):10896                     RTS
                      (    forth6809.asm):10897         
C27B                  (    forth6809.asm):10898         TSTAQ2NAME: FCB  10
                      (    forth6809.asm):10899                     FCC  "TSTABORTQ2"

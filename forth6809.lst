                      (    forth6809.asm):01874         ; ============================================================
                      (    forth6809.asm):01875         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01876         ; ============================================================
                      (    forth6809.asm):01877                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01878                                        ; entirely - every routine from here through
                      (    forth6809.asm):01879                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01880                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01881                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01882                                        ; WARM message left the location counter,
                      (    forth6809.asm):01883                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01884                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01885                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01886         
                      (    forth6809.asm):01887         ; ------------------------------------------------------------
                      (    forth6809.asm):01888         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01889         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01890         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01891         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01892         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01893         ; ------------------------------------------------------------
                      (    forth6809.asm):01894         ; ------------------------------------------------------------
                      (    forth6809.asm):01895         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):01896         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):01897         ; RTSSTATE. BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):01898         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):01899         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):01900         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):01901         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):01902         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):01903         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):01904         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):01905         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):01906         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):01907         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):01908         ; not duplicated logic in either place.
                      (    forth6809.asm):01909         ; ------------------------------------------------------------

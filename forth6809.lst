                      (    forth6809.asm):07644                   PSHU D
                      (    forth6809.asm):07645                   LDD  #0
                      (    forth6809.asm):07646                   PSHU D
                      (    forth6809.asm):07647                   LDX  #THEN
                      (    forth6809.asm):07648                   PSHU X
                      (    forth6809.asm):07649                   STU  TSTUB4
                      (    forth6809.asm):07650         
                      (    forth6809.asm):07651                   JSR  CATCH
                      (    forth6809.asm):07652         
                      (    forth6809.asm):07653                   STU  TSTUAF
                      (    forth6809.asm):07654         
                      (    forth6809.asm):07655                   PULU D
                      (    forth6809.asm):07656                   CMPD #-22
                      (    forth6809.asm):07657                   BNE  T3FAIL
                      (    forth6809.asm):07658         
                      (    forth6809.asm):07659                   LDD  TSTUB4
                      (    forth6809.asm):07660                   SUBD TSTUAF
                      (    forth6809.asm):07661                   CMPD #0
                      (    forth6809.asm):07662                   BNE  T3FAIL
                      (    forth6809.asm):07663         
                      (    forth6809.asm):07664                   LDD  #TRUEV
                      (    forth6809.asm):07665                   BRA  T3DONE
C23F                  (    forth6809.asm):07666         T3FAIL:   LDD  #FALSEV
C23F                  (    forth6809.asm):07667         T3DONE:   LDX  #TSTTHENZNAME
                      (    forth6809.asm):07668                   PSHU X
                      (    forth6809.asm):07669                   PSHU D
                      (    forth6809.asm):07670                   JSR  TSTREPORT
                      (    forth6809.asm):07671         
                      (    forth6809.asm):07672                   LDU  TSTU0
                      (    forth6809.asm):07673                   RTS
                      (    forth6809.asm):07674         

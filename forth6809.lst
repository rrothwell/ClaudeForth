                      (    forth6809.asm):03759         ; TSTUMSZ - unit test for UMSLASHMOD, divide-by-zero case. u1 = 0.
                      (    forth6809.asm):03760         ; Verifies THROW -10 and CATCH's own depth-restoration contract
                      (    forth6809.asm):03761         ; (net 0 change across the JSR CATCH) - same pattern established
                      (    forth6809.asm):03762         ; in the section 3.4 tests.
                      (    forth6809.asm):03763         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03764         TSTUMSZ:    STU   TSTU0
                      (    forth6809.asm):03765         
                      (    forth6809.asm):03766                    LDD   #TSTD1LO
                      (    forth6809.asm):03767                    PSHU  D
                      (    forth6809.asm):03768                    LDD   #TSTD1HI
                      (    forth6809.asm):03769                    PSHU  D
                      (    forth6809.asm):03770                    LDD   #$0000
                      (    forth6809.asm):03771                    PSHU  D
                      (    forth6809.asm):03772                    LDX   #UMSLASHMOD
                      (    forth6809.asm):03773                    PSHU  X
                      (    forth6809.asm):03774                    STU   TSTUB4
                      (    forth6809.asm):03775         
                      (    forth6809.asm):03776                    JSR   CATCH
                      (    forth6809.asm):03777         
                      (    forth6809.asm):03778                    STU   TSTUAF
                      (    forth6809.asm):03779         
                      (    forth6809.asm):03780                    PULU  D
                      (    forth6809.asm):03781                    CMPD  #-10
                      (    forth6809.asm):03782                    BNE   UZFAIL
                      (    forth6809.asm):03783         
                      (    forth6809.asm):03784                    LDD   TSTUB4
                      (    forth6809.asm):03785                    SUBD  TSTUAF
                      (    forth6809.asm):03786                    CMPD  #0
                      (    forth6809.asm):03787                    BNE   UZFAIL
                      (    forth6809.asm):03788         
                      (    forth6809.asm):03789                    LDD   #TRUEV
                      (    forth6809.asm):03790                    BRA   UZDONE
C100                  (    forth6809.asm):03791         UZFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):03792         UZDONE:     LDX   #TSTUMSZNAME
                      (    forth6809.asm):03793                    PSHU  X
                      (    forth6809.asm):03794                    PSHU  D
                      (    forth6809.asm):03795                    JSR   TSTREPORT
                      (    forth6809.asm):03796         
                      (    forth6809.asm):03797                    LDU   TSTU0
                      (    forth6809.asm):03798                    RTS
                      (    forth6809.asm):03799         

                      (    forth6809.asm):07003         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07004         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07005         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07006         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07007         ; ============================================================
                      (    forth6809.asm):07008         ; ------------------------------------------------------------
                      (    forth6809.asm):07009         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07010         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07011         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07012         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07013         ; - no indirection, no value cell.
                      (    forth6809.asm):07014         ;
                      (    forth6809.asm):07015         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07016         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07017         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07018         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07019         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07020         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07021         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07022         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07023         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07024         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07025         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):07026         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):07027                    PSHU  D
FF3C 39               (    forth6809.asm):07028                    RTS
                      (    forth6809.asm):07029         
FF3D CC0000           (    forth6809.asm):07030         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):07031                    PSHU  D
FF42 39               (    forth6809.asm):07032                    RTS
                      (    forth6809.asm):07033         
                      (    forth6809.asm):07034         ; ------------------------------------------------------------
                      (    forth6809.asm):07035         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07036         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07037         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07038         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07039         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):07040         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):07041                    PSHU  D
FF48 39               (    forth6809.asm):07042                    RTS
                      (    forth6809.asm):07043         
FF49 CCFFFF           (    forth6809.asm):07044         MONEBODY:  LDD   #-1
FF4C 3606             (    forth6809.asm):07045                    PSHU  D
FF4E 39               (    forth6809.asm):07046                    RTS
                      (    forth6809.asm):07047         
FF4F CC0002           (    forth6809.asm):07048         TWOBODY:   LDD   #2
FF52 3606             (    forth6809.asm):07049                    PSHU  D
FF54 39               (    forth6809.asm):07050                    RTS
                      (    forth6809.asm):07051         
FF55 CCFFFE           (    forth6809.asm):07052         MTWOBODY:  LDD   #-2
FF58 3606             (    forth6809.asm):07053                    PSHU  D
FF5A 39               (    forth6809.asm):07054                    RTS
                      (    forth6809.asm):07055         
                      (    forth6809.asm):07056         ; Verify no collision with init code,
                      (    forth6809.asm):07057         ; value should match ORG INITCODE.
     FF5B             (    forth6809.asm):07058         BASECODEEND  EQU   *
     2071             (    forth6809.asm):07059         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07060         
                      (    forth6809.asm):07061         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07062         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07063         ; .bin file.
FF5B                  (    forth6809.asm):07064         BASEND:
FF5B FFFFFFFFFFFFFFFF (    forth6809.asm):07065                  FILL $FF,INITCODE-BASEND
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFFFFFFFFFFFF
     FFFFFF

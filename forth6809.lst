                      (    forth6809.asm):00714         
                      (    forth6809.asm):00715         ; ============================================================
                      (    forth6809.asm):00716         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00717         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):00718         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):00719         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):00720         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):00721         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):00722         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):00723         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):00724         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):00725         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):00726         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):00727         ; they no longer need indirection.
                      (    forth6809.asm):00728         ;
                      (    forth6809.asm):00729         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):00730         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):00731         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):00732         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):00733         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):00734         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):00735         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):00736         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):00737         ;
                      (    forth6809.asm):00738         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):00739         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):00740         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):00741         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):00742         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):00743         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):00744         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):00745         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):00746         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):00747         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):00748         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):00749         ;
                      (    forth6809.asm):00750         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):00751         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):00752         ;
                      (    forth6809.asm):00753         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):00754         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):00755         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):00756         ; ============================================================
                      (    forth6809.asm):00757         
                      (    forth6809.asm):00758                  ORG   BASEDICT       ; BASEDICT is $D83F
                      (    forth6809.asm):00759         
D6FF                  (    forth6809.asm):00760         H_KEY:
D6FF 03               (    forth6809.asm):00761                  FCB   $03
D700 4B4559           (    forth6809.asm):00762                  FCC   "KEY"
D703 0000             (    forth6809.asm):00763                  FDB   0
D705 E60E             (    forth6809.asm):00764                  FDB   KEY
D707                  (    forth6809.asm):00765         H_KEYQ:
D707 04               (    forth6809.asm):00766                  FCB   $04
D708 4B45593F         (    forth6809.asm):00767                  FCC   "KEY?"
D70C D6FF             (    forth6809.asm):00768                  FDB   H_KEY
D70E E61E             (    forth6809.asm):00769                  FDB   KEYQ
D710                  (    forth6809.asm):00770         H_EMIT:
D710 04               (    forth6809.asm):00771                  FCB   $04
D711 454D4954         (    forth6809.asm):00772                  FCC   "EMIT"

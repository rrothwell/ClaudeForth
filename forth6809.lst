                      (    forth6809.asm):01609         ; ------------------------------------------------------------
                      (    forth6809.asm):01610         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01611         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01612         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01613         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01614         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01615         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01616         ; flow control, not a chip feature.
                      (    forth6809.asm):01617         ; ------------------------------------------------------------

                      (    forth6809.asm):02230         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):02231         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):02232         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):02233         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):02234         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):02235         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):02236         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):02237         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):02238         ; ------------------------------------------------------------

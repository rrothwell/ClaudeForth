                      (    forth6809.asm):02136         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02137         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02138         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02139         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02140         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02141         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02142         ; one copy pushed).
                      (    forth6809.asm):02143         ; ------------------------------------------------------------
C18C                  (    forth6809.asm):02144         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):02145         
                      (    forth6809.asm):02146                    LDD   #TSTGUARD
                      (    forth6809.asm):02147                    PSHU  D
                      (    forth6809.asm):02148                    LDD   #TSTVAL1
                      (    forth6809.asm):02149                    PSHU  D
                      (    forth6809.asm):02150                    LDD   #TSTVAL2
                      (    forth6809.asm):02151                    PSHU  D
                      (    forth6809.asm):02152                    LDD   #TSTVAL3
                      (    forth6809.asm):02153                    PSHU  D
                      (    forth6809.asm):02154                    LDD   #2
                      (    forth6809.asm):02155                    PSHU  D
                      (    forth6809.asm):02156                    STU   TSTUB4
                      (    forth6809.asm):02157         
                      (    forth6809.asm):02158                    JSR   PICK
                      (    forth6809.asm):02159         
                      (    forth6809.asm):02160                    STU   TSTUAF
                      (    forth6809.asm):02161         
                      (    forth6809.asm):02162                    PULU  D
                      (    forth6809.asm):02163                    CMPD  #TSTVAL1
                      (    forth6809.asm):02164                    BNE   PKFAIL
                      (    forth6809.asm):02165                    PULU  D
                      (    forth6809.asm):02166                    CMPD  #TSTVAL3
                      (    forth6809.asm):02167                    BNE   PKFAIL
                      (    forth6809.asm):02168                    PULU  D
                      (    forth6809.asm):02169                    CMPD  #TSTVAL2
                      (    forth6809.asm):02170                    BNE   PKFAIL
                      (    forth6809.asm):02171                    PULU  D
                      (    forth6809.asm):02172                    CMPD  #TSTVAL1
                      (    forth6809.asm):02173                    BNE   PKFAIL
                      (    forth6809.asm):02174                    PULU  D
                      (    forth6809.asm):02175                    CMPD  #TSTGUARD
                      (    forth6809.asm):02176                    BNE   PKFAIL
                      (    forth6809.asm):02177         
                      (    forth6809.asm):02178                    LDD   TSTUB4
                      (    forth6809.asm):02179                    SUBD  TSTUAF
                      (    forth6809.asm):02180                    CMPD  #0
                      (    forth6809.asm):02181                    BNE   PKFAIL
                      (    forth6809.asm):02182         
                      (    forth6809.asm):02183                    LDD   #TRUEV
                      (    forth6809.asm):02184                    BRA   PKDONE
C18C                  (    forth6809.asm):02185         PKFAIL:    LDD   #FALSEV
C18C                  (    forth6809.asm):02186         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):02187                    PSHU  X
                      (    forth6809.asm):02188                    PSHU  D
                      (    forth6809.asm):02189                    JSR   TSTREPORT
                      (    forth6809.asm):02190         
                      (    forth6809.asm):02191                    LDU   TSTU0
                      (    forth6809.asm):02192                    RTS
                      (    forth6809.asm):02193         
C18C                  (    forth6809.asm):02194         TSTPICKNAME: FCB  7
                      (    forth6809.asm):02195                      FCC  "TSTPICK"
                      (    forth6809.asm):02196         
                      (    forth6809.asm):02197         ; ------------------------------------------------------------
                      (    forth6809.asm):02198         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):02199         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):02200         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):02201         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):02202         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):02203         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):02204         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):02205         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):02206         ; ------------------------------------------------------------
C18C                  (    forth6809.asm):02207         TSTROLL:   STU   TSTU0
                      (    forth6809.asm):02208         
                      (    forth6809.asm):02209                    LDD   #TSTGUARD

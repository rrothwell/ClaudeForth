E8D2 BDE6D6           (    forth6809.asm):03691                  JSR   CFERR
E8D5 3706             (    forth6809.asm):03692         LOOPOK:  PULU  D          ; BUG FIX: was PULU X, then TFR X,D to retrieve
E8D7 3606             (    forth6809.asm):03693                  PSHU  D          ; it after CCALL/CODECOMMA below - but both of
                      (    forth6809.asm):03694                                   ; those clobber X internally (CCALL's own LDX
                      (    forth6809.asm):03695                                   ; CODEHERE, CODECOMMA's LDX #CODEHERE via
                      (    forth6809.asm):03696                                   ; APPENDCELL), so X no longer held the target
                      (    forth6809.asm):03697                                   ; by the time TFR X,D ran - it held the address
                      (    forth6809.asm):03698                                   ; of the CODEHERE variable itself, corrupting
                      (    forth6809.asm):03699                                   ; the branch displacement PATCH computed.
                      (    forth6809.asm):03700                                   ; Parking the target on U instead (untouched by
                      (    forth6809.asm):03701                                   ; CCALL/CODECOMMA, which only use D/X/A) keeps
                      (    forth6809.asm):03702                                   ; it safe across both calls; retrieved below via
                      (    forth6809.asm):03703                                   ; PULU D in place of the old TFR X,D. Confirmed
                      (    forth6809.asm):03704                                   ; via MAME debugger: the compiled displacement
                      (    forth6809.asm):03705                                   ; came out as +8, executing DOTEST's return to
                      (    forth6809.asm):03706                                   ; a near-zero, invalid address.
E8D9 CCE911           (    forth6809.asm):03707                  LDD   #DOTEST
E8DC 3606             (    forth6809.asm):03708                  PSHU  D
E8DE BDEB2C           (    forth6809.asm):03709                  JSR   CCALL

E49C D73C             (    forth6809.asm):03587                     STB   EMITCH
E49E B6C008           (    forth6809.asm):03588         EMITWT:     LDA   ACIASR
E4A1 8502             (    forth6809.asm):03589                     BITA  #SR_TDRE
E4A3 27F9             (    forth6809.asm):03590                     BEQ   EMITWT
E4A5 963C             (    forth6809.asm):03591                     LDA   EMITCH
E4A7 B7C009           (    forth6809.asm):03592                     STA   ACIADR
E4AA 39               (    forth6809.asm):03593                     RTS
                      (    forth6809.asm):03594         

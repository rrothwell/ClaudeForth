F358 ED02             (    forth6809.asm):06170                     STD   2,X
F35A 39               (    forth6809.asm):06171                     RTS
                      (    forth6809.asm):06172         
                      (    forth6809.asm):06173         ; ------------------------------------------------------------
                      (    forth6809.asm):06174         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06175         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):06176         ; ------------------------------------------------------------
F35B ECC4             (    forth6809.asm):06177         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F35D 2713             (    forth6809.asm):06178                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F35F AE44             (    forth6809.asm):06179                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F361 308B             (    forth6809.asm):06180                     LEAX  D,X               ; end address = c-addr1 + u
F363 AFC4             (    forth6809.asm):06181                     STX   ,U                ; keep it in u's old slot as the loop limit
F365 AE44             (    forth6809.asm):06182                     LDX   4,U               ; X = source
F367 10AE42           (    forth6809.asm):06183                     LDY   2,U               ; Y = destination
F36A A680             (    forth6809.asm):06184         CMVLOOP:    LDA   ,X+
F36C A7A0             (    forth6809.asm):06185                     STA   ,Y+
F36E ACC4             (    forth6809.asm):06186                     CMPX  ,U                ; reached the end address?
F370 26F8             (    forth6809.asm):06187                     BNE   CMVLOOP
F372 3346             (    forth6809.asm):06188         CMDONE:     LEAU  6,U               ; drop the three parameters
F374 39               (    forth6809.asm):06189                     RTS
                      (    forth6809.asm):06190         
                      (    forth6809.asm):06191         ; ------------------------------------------------------------
                      (    forth6809.asm):06192         ; CMOVE>  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06193         ; Copy u bytes from c-addr1 to c-addr2, starting at the high
                      (    forth6809.asm):06194         ; addresses.
                      (    forth6809.asm):06195         ; ------------------------------------------------------------
F375 ECC4             (    forth6809.asm):06196         CMOVEGTW:   LDD   ,U                ; u. Parameters stay on the data stack:
F377 2711             (    forth6809.asm):06197                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
F379 AE44             (    forth6809.asm):06198                     LDX   4,U
F37B 308B             (    forth6809.asm):06199                     LEAX  D,X               ; X = one past the end of the source
F37D 10AE42           (    forth6809.asm):06200                     LDY   2,U
F380 31AB             (    forth6809.asm):06201                     LEAY  D,Y               ; Y = one past the end of the destination
F382 A682             (    forth6809.asm):06202         CGLOOP:     LDA   ,-X
F384 A7A2             (    forth6809.asm):06203                     STA   ,-Y
F386 AC44             (    forth6809.asm):06204                     CMPX  4,U               ; back at the start of the source?
F388 26F8             (    forth6809.asm):06205                     BNE   CGLOOP
F38A 3346             (    forth6809.asm):06206         CGDONE:     LEAU  6,U               ; drop the three parameters
F38C 39               (    forth6809.asm):06207                     RTS
                      (    forth6809.asm):06208         
                      (    forth6809.asm):06209         ; ------------------------------------------------------------
                      (    forth6809.asm):06210         ; MOVE  ( addr1 addr2 u -- )
                      (    forth6809.asm):06211         ; Copy u bytes from addr1 to addr2, choosing CMOVE or CMOVE> so that
                      (    forth6809.asm):06212         ; overlapping regions are handled correctly.
                      (    forth6809.asm):06213         ; ------------------------------------------------------------
F38D EC42             (    forth6809.asm):06214         MOVEW:      LDD   2,U               ; addr2
F38F 10A344           (    forth6809.asm):06215                     CMPD  4,U               ; addr1
F392 22E1             (    forth6809.asm):06216                     BHI   CMOVEGTW          ; addr2 above addr1: copy from the top
F394 7EF35B           (    forth6809.asm):06217                     JMP   CMOVEW
                      (    forth6809.asm):06218         
                      (    forth6809.asm):06219         ; ------------------------------------------------------------
                      (    forth6809.asm):06220         ; FILL  ( c-addr u char -- )
                      (    forth6809.asm):06221         ; Store char in each of u bytes starting at c-addr.
                      (    forth6809.asm):06222         ; ------------------------------------------------------------
F397 EC42             (    forth6809.asm):06223         FILLW:      LDD   2,U               ; u. char is at 0, c-addr at 4
F399 270F             (    forth6809.asm):06224                     BEQ   FDONE
F39B AE44             (    forth6809.asm):06225                     LDX   4,U
F39D 318B             (    forth6809.asm):06226                     LEAY  D,X               ; end address
F39F 10AF42           (    forth6809.asm):06227                     STY   2,U               ; keep it in u's slot as the loop limit
F3A2 A641             (    forth6809.asm):06228                     LDA   1,U               ; fill byte. See bugfix: FILLW.1
F3A4 A780             (    forth6809.asm):06229         FILLOOP:    STA   ,X+
F3A6 AC42             (    forth6809.asm):06230                     CMPX  2,U
F3A8 26FA             (    forth6809.asm):06231                     BNE   FILLOOP
F3AA 3346             (    forth6809.asm):06232         FDONE:      LEAU  6,U               ; drop the three parameters
F3AC 39               (    forth6809.asm):06233                     RTS
                      (    forth6809.asm):06234         
                      (    forth6809.asm):06235         ; ------------------------------------------------------------
                      (    forth6809.asm):06236         ; ERASE  ( c-addr u -- )

F3C9 1F02             (    forth6809.asm):06077                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):06078                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):06079                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):06080                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):06081                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):06082                                   ; The high byte took on the fill character's
                      (    forth6809.asm):06083                                   ; value instead of the count's real high
                      (    forth6809.asm):06084                                   ; byte, so the count almost never reached
                      (    forth6809.asm):06085                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):06086                                   ; past the requested length. Keeping the
                      (    forth6809.asm):06087                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):06088                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):06089                                   ; fill character into A) and removes the
                      (    forth6809.asm):06090                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):06091                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):06092                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):06093                                   ; MAME debugger.

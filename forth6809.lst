                      (    forth6809.asm):02683                    JSR   TSTSLMOD
                      (    forth6809.asm):02684                    JSR   TSTSLMODZ
                      (    forth6809.asm):02685                    JSR   TSTNEGATE
                      (    forth6809.asm):02686                    JSR   TSTABS1

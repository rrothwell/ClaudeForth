                      (    forth6809.asm):03787         ; ------------------------------------------------------------
                      (    forth6809.asm):03788         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03789         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03790         ; operand to jump to the current code address.
                      (    forth6809.asm):03791         ; ------------------------------------------------------------
E6A1 3706             (    forth6809.asm):03792         THENW:      PULU  D
E6A3 10830001         (    forth6809.asm):03793                     CMPD  #TAGFWD
E6A7 2703             (    forth6809.asm):03794                     BEQ   THOK
E6A9 BDE609           (    forth6809.asm):03795                     JSR   CFERR
E6AC 3710             (    forth6809.asm):03796         THOK:       PULU  X                 ; orig
E6AE DC08             (    forth6809.asm):03797                     LDD   CODEHERE
E6B0 3606             (    forth6809.asm):03798                     PSHU  D
E6B2 3610             (    forth6809.asm):03799                     PSHU  X
E6B4 BDE673           (    forth6809.asm):03800                     JSR   PATCH
E6B7 39               (    forth6809.asm):03801                     RTS
                      (    forth6809.asm):03802         
                      (    forth6809.asm):03803         ; ------------------------------------------------------------
                      (    forth6809.asm):03804         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03805         ; Compile BRANCH with a placeholder operand, resolve orig1 to the

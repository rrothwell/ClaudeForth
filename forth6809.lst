                      (    forth6809.asm):00001         ; ============================================================
                      (    forth6809.asm):00002         ; 6809 ANS FORTH - subroutine threaded
                      (    forth6809.asm):00003         ;
                      (    forth6809.asm):00004         ; Layout of this file: memory map and constants, GLOBALS (page zero),
                      (    forth6809.asm):00005         ; serial buffers, SECTION 27 (dictionary headers), SECTIONS 3-26 (code),
                      (    forth6809.asm):00006         ; SECTION 2 (init code), SECTION 1 (vectors).
                      (    forth6809.asm):00007         ;
                      (    forth6809.asm):00008         ; Build options (lwasm -D): SERIALPOLL (1 = polled ACIA, 0 = interrupt
                      (    forth6809.asm):00009         ; driven), UNITTESTS (1 = include unit_tests.asm), TSTSELECTOR.
                      (    forth6809.asm):00010         ;
                      (    forth6809.asm):00011         ; Long explanatory and bug-fix comments are kept in the shadow file
                      (    forth6809.asm):00012         ; forth6809.shd, and are referred to here by their NAME.n codes.
                      (    forth6809.asm):00013         ; The original header comment is shadow HEADER.0.
                      (    forth6809.asm):00014         ; ============================================================
                      (    forth6809.asm):00015         
                      (    forth6809.asm):00016         ; ------------------------------------------------------------
                      (    forth6809.asm):00017         ; MEMORY MAP
                      (    forth6809.asm):00018         ; ------------------------------------------------------------
     C000             (    forth6809.asm):00019         ROMSTRT     EQU   $C000             ; physical start of the 16K EPROM
     C100             (    forth6809.asm):00020         USROMSTRT   EQU   $C100             ; usable ROM start (above INOUT)
     FFEF             (    forth6809.asm):00021         USROMEND    EQU   VECTORS-1         ; usable ROM end (VECTORS-1)
     FFF0             (    forth6809.asm):00022         VECTORS     EQU   $FFF0
     FFA4             (    forth6809.asm):00023         INITCODE    EQU   $FFA4             ; start of the init code (COLDSTRT)
                      (    forth6809.asm):00024                     ; Commented-out code moved to shadow: MEMMAP.5
     DCC4             (    forth6809.asm):00025         BASECODE    EQU   $DCC4             ; base code. See shadow MEMMAP.6
                      (    forth6809.asm):00026                     ; Commented-out code moved to shadow: MEMMAP.7
     D498             (    forth6809.asm):00027         BASEDICT    EQU   $D498             ; base dictionary. See shadow MEMMAP.8
     C000             (    forth6809.asm):00028         INOUT       EQU   $C000             ; I/O block (ACIA), 256 bytes
     C0FF             (    forth6809.asm):00029         INOUTEND    EQU   INOUT+$FF
     BFFF             (    forth6809.asm):00030         RSTACK      EQU   $BFFF             ; return stack top
     BCFF             (    forth6809.asm):00031         DSTACK      EQU   $BCFF             ; data stack top
     B900             (    forth6809.asm):00032         CODETOP     EQU   $B900             ; code space ceiling
                      (    forth6809.asm):00033         
                      (    forth6809.asm):00034         ; ANS transient-region sizes (ANS 3.3.3.6):
                      (    forth6809.asm):00035         ;   PADMINSIZE  - size of PAD's scratch region, in characters.
                      (    forth6809.asm):00036         ;   WORDMINSIZE - minimum size for WORD's region (33).
                      (    forth6809.asm):00037         ;   HOLDMINSIZE - pictured numeric output buffer, (2 * 16) + 2 = 34;
                      (    forth6809.asm):00038         ;                 it grows downward from PAD into the CODEHERE-to-PAD
                      (    forth6809.asm):00039         ;                 gap.
                      (    forth6809.asm):00040         ; PADOFFSET (the CODEHERE-to-PAD gap) equals PADMINSIZE. Original
                      (    forth6809.asm):00041         ; comment: shadow PADSIZE.0.
     0080             (    forth6809.asm):00042         PADMINSIZE  EQU   128
     0021             (    forth6809.asm):00043         WORDMINSIZE EQU   33
     0022             (    forth6809.asm):00044         HOLDMINSIZE EQU   34
     0080             (    forth6809.asm):00045         PADOFFSET   EQU   PADMINSIZE        ; CODEHERE-to-PAD gap
     005A             (    forth6809.asm):00046         WORDMAXCHARS EQU   PADOFFSET-HOLDMINSIZE-1-3
                      (    forth6809.asm):00047                     ; Maximum characters WORD can scan in the CODEHERE-to-PAD gap:
                      (    forth6809.asm):00048                     ; PADOFFSET - HOLDMINSIZE - 1 (count byte) - 3 (bytes reserved by
                      (    forth6809.asm):00049                     ; S", ." and ABORT"). Original comment: shadow WORDMAXCHARS.1.
                      (    forth6809.asm):00050         
     7000             (    forth6809.asm):00051         APPCODE     EQU   $7000             ; application code area
     2000             (    forth6809.asm):00052         APPDICT     EQU   $2000             ; application dictionary
     0200             (    forth6809.asm):00053         SUBPOOL     EQU   $0200             ; REPLACES substitution table. See shadow
     0040             (    forth6809.asm):00054         SUBPOOLSZ   EQU   64                ; REPLACES.1; $0200-$023F
     0240             (    forth6809.asm):00055         APPVARS     EQU   SUBPOOL+SUBPOOLSZ ; application variables ($0240)
     1FFF             (    forth6809.asm):00056         APPVARSEND  EQU   APPDICT-1         ; end of application variables
                      (    forth6809.asm):00057         ; $01DD-$01FF were formerly WORDBUF and SIBUF; $0200 now starts SUBPOOL.
                      (    forth6809.asm):00058         ; Original comment: shadow MEMMAP.17.
                      (    forth6809.asm):00059         
                      (    forth6809.asm):00060         ; Commented-out code moved to shadow: MEMMAP.18
     0106             (    forth6809.asm):00061         TIBBUF      EQU   $0106             ; terminal input buffer
     0050             (    forth6809.asm):00062         TIBBUFL     EQU   80                ; length of TIBBUF
                      (    forth6809.asm):00063         
     0000             (    forth6809.asm):00064         GLOBALS     EQU   $0000
                      (    forth6809.asm):00065         
     BD00             (    forth6809.asm):00066         SP0         EQU   DSTACK+1
     C000             (    forth6809.asm):00067         RP0         EQU   RSTACK+1
                      (    forth6809.asm):00068         
                      (    forth6809.asm):00069         ; ------------------------------------------------------------
                      (    forth6809.asm):00070         ; SERIALPOLL - conditional-assembly switch for serial I/O.
                      (    forth6809.asm):00071         ; 1 (default): KEY/KEYQ/EMIT poll ACIASR directly, no interrupts,
                      (    forth6809.asm):00072         ; no ring buffers, no RTS/CTS handshaking - IRQH is a harmless RTI
                      (    forth6809.asm):00073         ; stub, matching the other unused vectors (NMIH/FIRQH/SWI2H/
                      (    forth6809.asm):00074         ; SWI3H). 0: the original interrupt-driven implementation, with
                      (    forth6809.asm):00075         ; INBUF/OUTBUF ring buffers serviced by IRQH and RTS-based flow
                      (    forth6809.asm):00076         ; control via INFILL/RTSCHECKHI/RTSCHECKLO. Uses LWASM's IFEQ/
                      (    forth6809.asm):00077         ; ELSE/ENDC (a numeric-expression test, not IFDEF/IFNDEF, since
                      (    forth6809.asm):00078         ; this is a value to compare, not a symbol's mere presence).
                      (    forth6809.asm):00079         ;
                      (    forth6809.asm):00080         ; SERIALPOLL can be chosen at build time with lwasm -DSERIALPOLL=0 or
                      (    forth6809.asm):00081         ; -DSERIALPOLL=1 (the default). Original comment: shadow SERIALPOLL.1.
                      (    forth6809.asm):00082         ; ------------------------------------------------------------
                      (    forth6809.asm):00083                     IFNDEF SERIALPOLL
0000                  (    forth6809.asm):00084         SERIALPOLL  SET   1                 ; default if -D not passed
                      (    forth6809.asm):00085                     ENDC
                      (    forth6809.asm):00086         
                      (    forth6809.asm):00087         ; ------------------------------------------------------------
                      (    forth6809.asm):00088         ; ACIA (6850) constants - the chip sits at INOUT+8, not at the
                      (    forth6809.asm):00089         ; base of the I/O block, leaving INOUT+0..INOUT+7 free for other
                      (    forth6809.asm):00090         ; memory-mapped devices sharing this 256-byte region
                      (    forth6809.asm):00091         ; ------------------------------------------------------------
     C008             (    forth6809.asm):00092         ACIA        EQU   INOUT+8
     C008             (    forth6809.asm):00093         ACIACR      EQU   ACIA
     C008             (    forth6809.asm):00094         ACIASR      EQU   ACIA
     C009             (    forth6809.asm):00095         ACIADR      EQU   ACIA+1
                      (    forth6809.asm):00096         
                      (    forth6809.asm):00097         ; ACIA Status Register Bits
                      (    forth6809.asm):00098         
     0080             (    forth6809.asm):00099         SR_IRQ      EQU   %10000000         ; ($80) (Interrupt Request)
     0001             (    forth6809.asm):00100         SR_RDRF     EQU   %00000001         ; ($01) (Receive Data Register Full)
     0002             (    forth6809.asm):00101         SR_TDRE     EQU   %00000010         ; ($02) (Transmit Data Register Empty)
     0008             (    forth6809.asm):00102         SR_CTS      EQU   %00001000         ; ($08) CTS blocks transmit
                      (    forth6809.asm):00103         
                      (    forth6809.asm):00104         ; Errors only meaningful together with RDRF
     0010             (    forth6809.asm):00105         SR_FE       EQU   %00010000         ; ($10) (Framing Error)
     0020             (    forth6809.asm):00106         SR_OVRN     EQU   %00100000         ; ($20) (Overrun Error)
     0040             (    forth6809.asm):00107         SR_PE       EQU   %01000000         ; ($40) (Parity Error)
                      (    forth6809.asm):00108         
                      (    forth6809.asm):00109         ; ACIA Control Register Bits
                      (    forth6809.asm):00110         
     0003             (    forth6809.asm):00111         CR_RESET    EQU   %00000011         ; ($03) (Master Reset mode)
     0095             (    forth6809.asm):00112         CR_BASE     EQU   %10010101         ; ($95) (Rx Int Enabled, 8-N-1, /16 Clock)
     0095             (    forth6809.asm):00113         CR_RXON     EQU   %10010101         ; ($95) (Rx Int Enabled, 8-N-1, /16 Clock)
     00B5             (    forth6809.asm):00114         CR_RXTX     EQU   %10110101         ; ($B5) Rx Int, Tx Int/RTS, 8-N-1
     0015             (    forth6809.asm):00115         CR_POLL     EQU   %00010101         ; ($15) Polling, no ints, 8-N-1
     00D5             (    forth6809.asm):00116         CR_RTSHI    EQU   %11010101         ; ($D5) RTS high, Tx int off, 8-N-1
                      (    forth6809.asm):00117         
                      (    forth6809.asm):00118         ; CR_POLL
                      (    forth6809.asm):00119         
                      (    forth6809.asm):00120         ; bit7=0 (RX interrupt disabled), bits6-5=00 (RTS
                      (    forth6809.asm):00121         ; low, TX interrupt disabled) - CR_RXON ($95) with
                      (    forth6809.asm):00122         ; only the RX-interrupt-enable bit cleared. Used
                      (    forth6809.asm):00123         ; only when SERIALPOLL=1; RTS stays permanently
                      (    forth6809.asm):00124         ; low (asserted), since polling mode has no ring
                      (    forth6809.asm):00125         ; buffer to overflow and so needs no flow control
                      (    forth6809.asm):00126         
                      (    forth6809.asm):00127         ; CR_RTSHI
                      (    forth6809.asm):00128         
                      (    forth6809.asm):00129         ; bits6-5=10: RTS high, TX int disabled, RX int enabled -
                      (    forth6809.asm):00130         ; derived from CR_RXON ($95) with bits6-5 changed from
                      (    forth6809.asm):00131         ; 00 to 10; the ACIA has no combination offering RTS
                      (    forth6809.asm):00132         ; high AND TX interrupt enabled simultaneously (bits6-5
                      (    forth6809.asm):00133         ; only has 00/01/10/11, and only 01 enables TX interrupt,
                      (    forth6809.asm):00134         ; which always ties RTS low) - EMIT/IRQH's OUTCHAR must
                      (    forth6809.asm):00135         ; respect this and defer transmission while RTS is high
                      (    forth6809.asm):00136         
                      (    forth6809.asm):00137         ; Ring buffer control
     0176             (    forth6809.asm):00138         SERBUFCTL   EQU   $0176
     0180             (    forth6809.asm):00139         SERBUF      EQU   $0180             ; ring buffer start, 64-byte aligned
     0040             (    forth6809.asm):00140         INBUFSZ     EQU   64
     0040             (    forth6809.asm):00141         OUTBUFSZ    EQU   64
     0030             (    forth6809.asm):00142         INHIWATER   EQU   48                ; input ring level: RTS high
     0010             (    forth6809.asm):00143         INLOWATER   EQU   16                ; input ring level: RTS low
                      (    forth6809.asm):00144         
                      (    forth6809.asm):00145         ; Input control
                      (    forth6809.asm):00146         ; /RTS flag states
     0000             (    forth6809.asm):00147         INACCEPT    EQU   $00
     00FF             (    forth6809.asm):00148         INREJECT    EQU   $FF
                      (    forth6809.asm):00149         
                      (    forth6809.asm):00150         ; Output control
                      (    forth6809.asm):00151         ; Transmit buffer interrupt active flag states.
     0000             (    forth6809.asm):00152         OUTIDLE     EQU   $00
     00FF             (    forth6809.asm):00153         OUTBUSY     EQU   $FF
                      (    forth6809.asm):00154         
                      (    forth6809.asm):00155         ; Software (in-band) flow control - polling build only. The
                      (    forth6809.asm):00156         ; interrupt-driven build has real RTS/CTS hardware flow control
                      (    forth6809.asm):00157         ; already (CHKHI/CHKLO/UPDATE_RTS); polling mode has no ring
                      (    forth6809.asm):00158         ; buffer and no hardware handshaking at all, so it needs its own
                      (    forth6809.asm):00159         ; substitute - see ACCEPT and PUTXON/PUTXOFF.
     0011             (    forth6809.asm):00160         XONCH       EQU   $11
     0013             (    forth6809.asm):00161         XOFFCH      EQU   $13
                      (    forth6809.asm):00162         
                      (    forth6809.asm):00163         ; ------------------------------------------------------------
                      (    forth6809.asm):00164         ; Flag / opcode constants
                      (    forth6809.asm):00165         ; ------------------------------------------------------------
     FFFF             (    forth6809.asm):00166         TRUEV       EQU   $FFFF
     0000             (    forth6809.asm):00167         FALSEV      EQU   $0000
     00BD             (    forth6809.asm):00168         OPJSR       EQU   $BD
     0039             (    forth6809.asm):00169         OPRTS       EQU   $39               ; used by section 3.8's control-flow test
                      (    forth6809.asm):00170                                             ; harness to terminate each compiled test
                      (    forth6809.asm):00171                                             ; snippet, compiled via CCOMMA
     0039             (    forth6809.asm):00172         RTSOPC      EQU   $39
                      (    forth6809.asm):00173         
                      (    forth6809.asm):00174         ; ------------------------------------------------------------
                      (    forth6809.asm):00175         ; Control-flow compile-time tags
                      (    forth6809.asm):00176         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00177         TAGFWD      EQU   1
     0002             (    forth6809.asm):00178         TAGBACK     EQU   2
     0003             (    forth6809.asm):00179         TAGDO       EQU   3
     0004             (    forth6809.asm):00180         TAGCASE     EQU   4
     0005             (    forth6809.asm):00181         TAGOF       EQU   5
     0006             (    forth6809.asm):00182         TAGENDOF    EQU   6
     0007             (    forth6809.asm):00183         TAGQDO      EQU   7                 ; ?DO marker. See bugfix: TAGQDO.1
                      (    forth6809.asm):00184         
                      (    forth6809.asm):00185         ; ============================================================
                      (    forth6809.asm):00186         ; GLOBALS - scratch and state cells in page zero (DP = $00, set in
                      (    forth6809.asm):00187         ; COLDSTRT), laid out in RMB order. 127 of 256 bytes are used
                      (    forth6809.asm):00188         ; (GLOBALS_USED). Original comment: shadow GLOBALS.0.
                      (    forth6809.asm):00189         ; ============================================================
                      (    forth6809.asm):00190                     ORG   $0000             ; GLOBALS page (DP = $00)
0000                  (    forth6809.asm):00191         STATE       RMB   2                 ; offset $00
0002                  (    forth6809.asm):00192         BASE        RMB   2                 ; offset $02

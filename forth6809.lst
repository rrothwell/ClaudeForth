                      (    forth6809.asm):01674         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01675         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01676         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01677         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01678         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01679         ;    Inputs:
                      (    forth6809.asm):01680         ;        none
                      (    forth6809.asm):01681         ;    Outputs:
                      (    forth6809.asm):01682         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01683         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01684         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01685         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01686         FLUSHOUTBUFFER:
DD52 F6017A           (    forth6809.asm):01687                     LDB   OUTTAIL
DD55 F10179           (    forth6809.asm):01688                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DD58 2719             (    forth6809.asm):01689                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01690         
DD5A B6C008           (    forth6809.asm):01691                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01692                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01693                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01694         
DD61 8502             (    forth6809.asm):01695                     BITA  #SR_TDRE          ; Is transmit register empty?
DD63 270E             (    forth6809.asm):01696                     BEQ   FLUSHED           ; No! Exit - try again next call rather

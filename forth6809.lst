                      (    forth6809.asm):06835         ; UNESCAPE  ( c-addr1 u1 c-addr2 -- c-addr2 u2 )
                      (    forth6809.asm):06836         ; Copy the string c-addr1 u1 to c-addr2, doubling every "%" so that
                      (    forth6809.asm):06837         ; SUBSTITUTE turns it back into the original. u2 is the length of the
                      (    forth6809.asm):06838         ; result.

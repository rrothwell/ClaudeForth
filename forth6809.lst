                      (    forth6809.asm):17971         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):17972         ; ============================================================
                      (    forth6809.asm):17973                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):17974                                        ; entirely - every routine from here through
                      (    forth6809.asm):17975                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):17976                                        ; every primitive) would otherwise have
                      (    forth6809.asm):17977                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):17978                                        ; WARM message left the location counter,
                      (    forth6809.asm):17979                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):17980                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):17981                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):17982         
                      (    forth6809.asm):17983         ; ------------------------------------------------------------
                      (    forth6809.asm):17984         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):17985         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):17986         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):17987         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):17988         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):17989         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):17990         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):17991                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):17992                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):17993                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):17994                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):17995                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):17996                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):17997                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):17998                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):17999                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):18000                  RTS
                      (    forth6809.asm):18001         
                      (    forth6809.asm):18002                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):18003         ; ------------------------------------------------------------
                      (    forth6809.asm):18004         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):18005         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):18006         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):18007         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):18008         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):18009         INFILL:  LDA   INHEAD
                      (    forth6809.asm):18010                  SUBA  INTAIL
                      (    forth6809.asm):18011                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):18012                  RTS
                      (    forth6809.asm):18013         
                      (    forth6809.asm):18014         ; ------------------------------------------------------------
                      (    forth6809.asm):18015         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):18016         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):18017         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):18018         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):18019         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):18020         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):18021         ; flow control, not a chip feature.
                      (    forth6809.asm):18022         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):18023         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):18024                     CMPA #INHIWATER
                      (    forth6809.asm):18025                     BLO  RTSCHIDONE
                      (    forth6809.asm):18026                     TST  RTSSTATE
                      (    forth6809.asm):18027                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):18028                     LDA  #CR_RTSHI
                      (    forth6809.asm):18029                     STA  ACIACR
                      (    forth6809.asm):18030                     LDA  #1
                      (    forth6809.asm):18031                     STA  RTSSTATE
DEF5                  (    forth6809.asm):18032         RTSCHIDONE: RTS
                      (    forth6809.asm):18033         
                      (    forth6809.asm):18034         ; ------------------------------------------------------------
                      (    forth6809.asm):18035         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):18036         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):18037         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):18038         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):18039         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):18040         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):18041         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):18042         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):18043         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):18044         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):18045         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):18046                     CMPA #INLOWATER
                      (    forth6809.asm):18047                     BHI  RTSCLODONE
                      (    forth6809.asm):18048                     TST  RTSSTATE
                      (    forth6809.asm):18049                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):18050                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):18051                     CLR  RTSSTATE
                      (    forth6809.asm):18052                     LDB  OUTTAIL
                      (    forth6809.asm):18053                     CMPB OUTHEAD
                      (    forth6809.asm):18054                     BEQ  RTSCLONOTX
                      (    forth6809.asm):18055                     LDA  #CR_RXTX
                      (    forth6809.asm):18056                     STA  ACIACR

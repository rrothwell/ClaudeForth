                      (    forth6809.asm):06732         ; DOTSTR
                      (    forth6809.asm):06733         ;    Inputs:
                      (    forth6809.asm):06734         ;        return address on S points at the count byte
                      (    forth6809.asm):06735         ;    Outputs:
                      (    forth6809.asm):06736         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06737         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06738         ; ------------------------------------------------------------
F528 3510             (    forth6809.asm):06739         DOTSTR:     PULS  X

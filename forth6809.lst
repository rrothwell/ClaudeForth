                      (    forth6809.asm):02874         ; ------------------------------------------------------------
                      (    forth6809.asm):02875         ; INTERPRET  ( -- )
                      (    forth6809.asm):02876         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02877         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02878         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02879         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02880         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02881         ; ------------------------------------------------------------
E2C5                  (    forth6809.asm):02882         INTERPRET:
E2C5 CC0020           (    forth6809.asm):02883         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1

                      (    forth6809.asm):03038         
E379 108C0000         (    forth6809.asm):03039         SCANLP:     CMPY  #0
E37D 2715             (    forth6809.asm):03040                     BEQ   ENDW
E37F A684             (    forth6809.asm):03041                     LDA   ,X
E381 9114             (    forth6809.asm):03042                     CMPA  DELIM
E383 270B             (    forth6809.asm):03043                     BEQ   CONSUME
E385 C15A             (    forth6809.asm):03044                     CMPB  #WORDMAXCHARS     ; Length limit. See shadow: WORDW.2
E387 270B             (    forth6809.asm):03045                     BEQ   ENDW
E389 3001             (    forth6809.asm):03046                     LEAX  1,X
E38B 313F             (    forth6809.asm):03047                     LEAY  -1,Y
E38D 5C               (    forth6809.asm):03048                     INCB
E38E 20E9             (    forth6809.asm):03049                     BRA   SCANLP
                      (    forth6809.asm):03050         

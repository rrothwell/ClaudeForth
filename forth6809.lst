F87B 2715             (    forth6809.asm):20872                    BEQ  UEDONE
F87D A680             (    forth6809.asm):20873                    LDA  ,X+
F87F 8125             (    forth6809.asm):20874                    CMPA #'%'
F881 2604             (    forth6809.asm):20875                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):20876                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):20877                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):20878                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):20879                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):20880                                   ; the same string correctly, since this runs
                      (    forth6809.asm):20881                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):20882         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):20883                                   ; every character, '%' or not

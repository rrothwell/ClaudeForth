                      (    forth6809.asm):09116                  LDD   #TSTVBUF
                      (    forth6809.asm):09117                  STD   VARHERE
                      (    forth6809.asm):09118                  LDD   #TSTNAMEB
                      (    forth6809.asm):09119                  STD   SRCADDR
                      (    forth6809.asm):09120                  LDD   #6
                      (    forth6809.asm):09121                  STD   SRCLEN
                      (    forth6809.asm):09122                  LDD   #0
                      (    forth6809.asm):09123                  STD   TOIN
                      (    forth6809.asm):09124         
                      (    forth6809.asm):09125                  LDD   CODEHERE
                      (    forth6809.asm):09126                  STD   TSTWCFA
                      (    forth6809.asm):09127         
                      (    forth6809.asm):09128                  JSR   DEFERW
                      (    forth6809.asm):09129         
                      (    forth6809.asm):09130                  LDD   TSTCSAV
                      (    forth6809.asm):09131                  STD   CODEHERE
                      (    forth6809.asm):09132         
                      (    forth6809.asm):09133                  LDA   #'T'
                      (    forth6809.asm):09134                  STA   TSTNAMEB
                      (    forth6809.asm):09135                  LDA   #'E'
                      (    forth6809.asm):09136                  STA   TSTNAMEB+1
                      (    forth6809.asm):09137                  LDA   #'S'
                      (    forth6809.asm):09138                  STA   TSTNAMEB+2
                      (    forth6809.asm):09139                  LDA   #'T'
                      (    forth6809.asm):09140                  STA   TSTNAMEB+3
                      (    forth6809.asm):09141                  LDA   #'W'
                      (    forth6809.asm):09142                  STA   TSTNAMEB+4
                      (    forth6809.asm):09143                  LDA   #'D'
                      (    forth6809.asm):09144                  STA   TSTNAMEB+5
                      (    forth6809.asm):09145                  LDD   #TSTNAMEB
                      (    forth6809.asm):09146                  STD   SRCADDR
                      (    forth6809.asm):09147                  LDD   #6
                      (    forth6809.asm):09148                  STD   SRCLEN
                      (    forth6809.asm):09149                  LDD   #0
                      (    forth6809.asm):09150                  STD   TOIN
                      (    forth6809.asm):09151                  LDD   #0
                      (    forth6809.asm):09152                  STD   STATE
                      (    forth6809.asm):09153         
                      (    forth6809.asm):09154                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):09155                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):09156                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):09157                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09158                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09159                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09160                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09161                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09162                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09163                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09164                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09165                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09166                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09167                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):09168                  STD   CODEHERE
                      (    forth6809.asm):09169         
                      (    forth6809.asm):09170                  LDD   #DUP
                      (    forth6809.asm):09171                  PSHU  D
                      (    forth6809.asm):09172                  JSR   ISW
                      (    forth6809.asm):09173         
                      (    forth6809.asm):09174                  STU   TSTU0
                      (    forth6809.asm):09175         
                      (    forth6809.asm):09176                  LDD   #TSTGUARD
                      (    forth6809.asm):09177                  PSHU  D
                      (    forth6809.asm):09178                  LDD   #TSTVAL1
                      (    forth6809.asm):09179                  PSHU  D
                      (    forth6809.asm):09180                  STU   TSTUB4
                      (    forth6809.asm):09181         
                      (    forth6809.asm):09182                  LDX   TSTWCFA
                      (    forth6809.asm):09183                  JSR   ,X
                      (    forth6809.asm):09184         
                      (    forth6809.asm):09185                  STU   TSTUAF
                      (    forth6809.asm):09186         
                      (    forth6809.asm):09187                  PULU  D
                      (    forth6809.asm):09188                  CMPD  #TSTVAL1
                      (    forth6809.asm):09189                  LBNE   ISFAIL  ; was BNE - out of short-branch range, since
                      (    forth6809.asm):09190                                 ; ISFAIL sits past this test's entire second
                      (    forth6809.asm):09191                                 ; phase (the ACTION-OF lookup and re-check)
                      (    forth6809.asm):09192                  PULU  D
                      (    forth6809.asm):09193                  CMPD  #TSTVAL1
                      (    forth6809.asm):09194                  BNE   ISFAIL
                      (    forth6809.asm):09195                  PULU  D
                      (    forth6809.asm):09196                  CMPD  #TSTGUARD
                      (    forth6809.asm):09197                  BNE   ISFAIL
                      (    forth6809.asm):09198         
                      (    forth6809.asm):09199                  LDD   TSTUB4
                      (    forth6809.asm):09200                  SUBD  TSTUAF
                      (    forth6809.asm):09201                  CMPD  #2
                      (    forth6809.asm):09202                  BNE   ISFAIL
                      (    forth6809.asm):09203         
                      (    forth6809.asm):09204                  LDA   #'T'
                      (    forth6809.asm):09205                  STA   TSTNAMEB
                      (    forth6809.asm):09206                  LDA   #'E'
                      (    forth6809.asm):09207                  STA   TSTNAMEB+1
                      (    forth6809.asm):09208                  LDA   #'S'
                      (    forth6809.asm):09209                  STA   TSTNAMEB+2
                      (    forth6809.asm):09210                  LDA   #'T'
                      (    forth6809.asm):09211                  STA   TSTNAMEB+3
                      (    forth6809.asm):09212                  LDA   #'W'
                      (    forth6809.asm):09213                  STA   TSTNAMEB+4
                      (    forth6809.asm):09214                  LDA   #'D'
                      (    forth6809.asm):09215                  STA   TSTNAMEB+5
                      (    forth6809.asm):09216                  LDD   #TSTNAMEB
                      (    forth6809.asm):09217                  STD   SRCADDR
                      (    forth6809.asm):09218                  LDD   #6
                      (    forth6809.asm):09219                  STD   SRCLEN
                      (    forth6809.asm):09220                  LDD   #0
                      (    forth6809.asm):09221                  STD   TOIN
                      (    forth6809.asm):09222         
                      (    forth6809.asm):09223                  LDD   #TSTCBUF2  ; BUG FIX: same missing redirect as before
                      (    forth6809.asm):09224                                   ; ISW above - ACTIONOF's own internal WORD
                      (    forth6809.asm):09225                                   ; call needs somewhere safe to write its
                      (    forth6809.asm):09226                                   ; parsed-token output too.
                      (    forth6809.asm):09227                  STD   CODEHERE
                      (    forth6809.asm):09228         
                      (    forth6809.asm):09229                  JSR   ACTIONOF
                      (    forth6809.asm):09230         
                      (    forth6809.asm):09231                  LDD   TSTCSAV
                      (    forth6809.asm):09232                  STD   CODEHERE
                      (    forth6809.asm):09233                  LDD   TSTDSAV
                      (    forth6809.asm):09234                  STD   DPHERE
                      (    forth6809.asm):09235                  LDD   TSTVSAV
                      (    forth6809.asm):09236                  STD   VARHERE
                      (    forth6809.asm):09237                  LDD   TSTSASAV
                      (    forth6809.asm):09238                  STD   SRCADDR
                      (    forth6809.asm):09239                  LDD   TSTSLSAV
                      (    forth6809.asm):09240                  STD   SRCLEN
                      (    forth6809.asm):09241                  LDD   TSTTISAV
                      (    forth6809.asm):09242                  STD   TOIN
                      (    forth6809.asm):09243                  LDD   TSTSTSAV
                      (    forth6809.asm):09244                  STD   STATE
                      (    forth6809.asm):09245                  LDD   TSTLSAV

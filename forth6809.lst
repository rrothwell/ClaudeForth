                      (    forth6809.asm):03656                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03657                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03658                                      ; silently overwrote the real carry here

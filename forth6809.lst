                      (    forth6809.asm):00906                    PSHU  D
                      (    forth6809.asm):00907                    LDD   #TSTVAL1
                      (    forth6809.asm):00908                    PSHU  D
                      (    forth6809.asm):00909                    LDD   #TSTVAL2
                      (    forth6809.asm):00910                    PSHU  D
                      (    forth6809.asm):00911                    STU   TSTUB4
                      (    forth6809.asm):00912         
                      (    forth6809.asm):00913                    JSR   SWAP
                      (    forth6809.asm):00914         
                      (    forth6809.asm):00915                    STU   TSTUAF
                      (    forth6809.asm):00916         

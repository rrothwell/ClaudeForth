                      (    forth6809.asm):09980         ; TSTLITERAL - unit test for LITERAL. Already used extensively
                      (    forth6809.asm):09981         ; as an internal helper throughout sections 3.8/3.9's own tests,
                      (    forth6809.asm):09982         ; but gets its own dedicated, direct test here too, per this
                      (    forth6809.asm):09983         ; section's own coverage. Compiles a known value as a literal,
                      (    forth6809.asm):09984         ; then executes the result to confirm it genuinely pushes it.
                      (    forth6809.asm):09985         ; ------------------------------------------------------------
C27E                  (    forth6809.asm):09986         TSTLITERAL: LDD  CODEHERE
                      (    forth6809.asm):09987                     STD  TSTCSAV
                      (    forth6809.asm):09988         

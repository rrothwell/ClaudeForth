                      (    forth6809.asm):01982         ; ============================================================
                      (    forth6809.asm):01983         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):01984         ; ============================================================
                      (    forth6809.asm):01985         ; ------------------------------------------------------------
                      (    forth6809.asm):01986         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):01987         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):01988         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):01989         ; COLD
                      (    forth6809.asm):01990         ;    Inputs:
                      (    forth6809.asm):01991         ;        none (entered at reset)
                      (    forth6809.asm):01992         ;    Outputs:
                      (    forth6809.asm):01993         ;        none (does not return)
                      (    forth6809.asm):01994         ;    Registers: all changed.
                      (    forth6809.asm):01995         ; ------------------------------------------------------------

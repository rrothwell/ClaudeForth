                      (    forth6809.asm):06885         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):06886         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):06887         ; each %name% that matches the name registered by REPLACES with its
                      (    forth6809.asm):06888         ; text. "%%" becomes a single "%"; a %name% that does not match, and
                      (    forth6809.asm):06889         ; an unpaired "%", are copied unchanged. u3 is the output length and n
                      (    forth6809.asm):06890         ; the number of substitutions. THROW -1 if the output does not fit.
                      (    forth6809.asm):06891         ; Scratch: MSCR = read position, MSCR2 = substitution count, MSCR3 and
                      (    forth6809.asm):06892         ; MSCR4 = temporaries for each %-pair. Original comment: shadow
                      (    forth6809.asm):06893         ; SUBSTITUTEW.1.
                      (    forth6809.asm):06894         ; ------------------------------------------------------------

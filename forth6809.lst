DEA1 CC0008           (    forth6809.asm):02117                     LDD   #ERRMSGL
DEA4 3606             (    forth6809.asm):02118                     PSHU  D                 ; u
DEA6 BDF5C4           (    forth6809.asm):02119                     JSR   TYPEW
DEA9 ECE4             (    forth6809.asm):02120                     LDD   ,S
DEAB 3606             (    forth6809.asm):02121                     PSHU  D                 ; n
DEAD BDFA8F           (    forth6809.asm):02122                     JSR   DOTW

                      (    forth6809.asm):08371         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):08372         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):08373         ; each %name% that matches the name registered by REPLACES with its
                      (    forth6809.asm):08374         ; text. "%%" becomes a single "%"; a %name% that does not match, and
                      (    forth6809.asm):08375         ; an unpaired "%", are copied unchanged. u3 is the output length and n

CF62 8570             (    forth6809.asm):02438                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02439                                             ; Any receiver error flagged?
CF64 2716             (    forth6809.asm):02440                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02441         
CF66 8510             (    forth6809.asm):02442                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
CF68 2703             (    forth6809.asm):02443                     BEQ   INXFE             ; Tally each flagged error independently -
CF6A 7C017C           (    forth6809.asm):02444                     INC   FECOUNT           ; more than one bit can be set at once.
CF6D 8520             (    forth6809.asm):02445         INXFE:      BITA  #SR_OVRN
CF6F 2703             (    forth6809.asm):02446                     BEQ   INXOVRN
CF71 7C017D           (    forth6809.asm):02447                     INC   OVRNCOUNT
CF74 8540             (    forth6809.asm):02448         INXOVRN:    BITA  #SR_PE
CF76 2703             (    forth6809.asm):02449                     BEQ   INXPE
CF78 7C017E           (    forth6809.asm):02450                     INC   PECOUNT
CF7B 3B               (    forth6809.asm):02451         INXPE:      RTI
                      (    forth6809.asm):02452         
CF7C 1F98             (    forth6809.asm):02453         INOK:       TFR   B,A               ; Transfer good character from the receiver.

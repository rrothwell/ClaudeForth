                      (    forth6809.asm):18014                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):18015                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):18016                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):18017                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):18018                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):18019                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):18020                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):18021                   ; high cell.
E5C3 0D22             (    forth6809.asm):18022                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):18023                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):18024                   LDD   UDLO
E5C9 43               (    forth6809.asm):18025                   COMA
E5CA 53               (    forth6809.asm):18026                   COMB
E5CB C30001           (    forth6809.asm):18027                   ADDD  #1
E5CE DD76             (    forth6809.asm):18028                   STD   UDLO
E5D0 3401             (    forth6809.asm):18029                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):18030                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):18031                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):18032                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):18033                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):18034                                      ; silently overwrote the real carry here
                      (    forth6809.asm):18035                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):18036                                      ; making the high-cell increment run
                      (    forth6809.asm):18037                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):18038                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):18039                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):18040                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):18041                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):18042                                      ; matching "always increment" rather than
                      (    forth6809.asm):18043                                      ; "increment only on genuine carry".

                      (    forth6809.asm):04480         
                      (    forth6809.asm):04481         ; ============================================================
                      (    forth6809.asm):04482         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):04483         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):04484         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):04485         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):04486         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):04487         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):04488         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):04489         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):04490         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):04491         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):04492         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):04493         ; they no longer need indirection.
                      (    forth6809.asm):04494         ;
                      (    forth6809.asm):04495         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):04496         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):04497         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):04498         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):04499         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):04500         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):04501         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):04502         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):04503         ;
                      (    forth6809.asm):04504         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):04505         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):04506         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):04507         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):04508         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):04509         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):04510         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):04511         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):04512         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):04513         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):04514         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):04515         ;
                      (    forth6809.asm):04516         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):04517         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):04518         ;
                      (    forth6809.asm):04519         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):04520         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):04521         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):04522         ; ============================================================

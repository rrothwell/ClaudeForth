                      (    forth6809.asm):02104         
D294 7D017B           (    forth6809.asm):02105                     TST   OUTACTIVITY       ; Is active?
D297 2704             (    forth6809.asm):02106                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02107         
                      (    forth6809.asm):02108                                             ; $B5/%1011_0101
D299 86B5             (    forth6809.asm):02109                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
D29B 2009             (    forth6809.asm):02110                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02111         
D29D                  (    forth6809.asm):02112         SET_RTS_LO_TX_OFF:                  ; $95/%10010101

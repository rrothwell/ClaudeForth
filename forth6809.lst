C115 CC0003           (   unit_tests.asm):00244                    LDD   #TSTOKMSGL
C118 3606             (   unit_tests.asm):00245                    PSHU  D
C11A 200A             (   unit_tests.asm):00246                    BRA   TSTPRINT

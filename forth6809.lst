                      (    forth6809.asm):03179         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):03180         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):03181         ; >NUMBER, so no page-zero cells are needed.)

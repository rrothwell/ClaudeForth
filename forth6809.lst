                      (    forth6809.asm):12850                      LDA  TSTOHSAV
                      (    forth6809.asm):12851                      ADDA #2
                      (    forth6809.asm):12852                      ANDA #OUTBUFSZ-1
                      (    forth6809.asm):12853                      CMPA OUTHEAD
                      (    forth6809.asm):12854                      BNE  DXFAIL
                      (    forth6809.asm):12855         

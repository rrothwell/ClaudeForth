                      (    forth6809.asm):01726                    STU   TSTUB4
                      (    forth6809.asm):01727         
                      (    forth6809.asm):01728                    JSR   QDUP
                      (    forth6809.asm):01729         
                      (    forth6809.asm):01730                    STU   TSTUAF
                      (    forth6809.asm):01731         
                      (    forth6809.asm):01732                    PULU  D
                      (    forth6809.asm):01733                    CMPD  #0
                      (    forth6809.asm):01734                    BNE   QZFAIL
                      (    forth6809.asm):01735                    PULU  D
                      (    forth6809.asm):01736                    CMPD  #TSTGUARD
                      (    forth6809.asm):01737                    BNE   QZFAIL
                      (    forth6809.asm):01738         
                      (    forth6809.asm):01739                    LDD   TSTUB4
                      (    forth6809.asm):01740                    SUBD  TSTUAF
                      (    forth6809.asm):01741                    CMPD  #0
                      (    forth6809.asm):01742                    BNE   QZFAIL
                      (    forth6809.asm):01743         
                      (    forth6809.asm):01744                    LDD   #TRUEV
                      (    forth6809.asm):01745                    BRA   QZDONE

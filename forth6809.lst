DF5C DD00             (    forth6809.asm):02055                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02056                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02057                                   ; that spans more than one line of input.
                      (    forth6809.asm):02058                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02059                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02060                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02061                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02062                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02063                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02064                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02065                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02066                                   ; been reached. A colon definition split
                      (    forth6809.asm):02067                                   ; across multiple lines would have every
                      (    forth6809.asm):02068                                   ; word on every line after the first
                      (    forth6809.asm):02069                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02070                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02071                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02072                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02073                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02074                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02075                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02076                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02077                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):02078                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):02079                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):02080                                   ; so this still correctly forces interpret
                      (    forth6809.asm):02081                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):02082                                   ; semantics call for it - just not on every
                      (    forth6809.asm):02083                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):02084                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):02085         

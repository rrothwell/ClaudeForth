                      (    forth6809.asm):02564         ; ABORT
                      (    forth6809.asm):02565         ;    Inputs:
                      (    forth6809.asm):02566         ;        none
                      (    forth6809.asm):02567         ;    Outputs:
                      (    forth6809.asm):02568         ;        none (does not return)

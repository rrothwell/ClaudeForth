                      (    forth6809.asm):03500         ; ------------------------------------------------------------
                      (    forth6809.asm):03501         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03502         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03503         ; ------------------------------------------------------------
E5A1 BDE539           (    forth6809.asm):03504         EXPECTW:    JSR   ACCEPTW
E5A4 3706             (    forth6809.asm):03505                     PULU  D
E5A6 DD3F             (    forth6809.asm):03506                     STD   SPAN
E5A8 39               (    forth6809.asm):03507                     RTS
                      (    forth6809.asm):03508         
                      (    forth6809.asm):03509         ; ------------------------------------------------------------
                      (    forth6809.asm):03510         ; QUERY  ( -- )
                      (    forth6809.asm):03511         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03512         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03513         ; to 0 and >IN to 0.
                      (    forth6809.asm):03514         ; ------------------------------------------------------------
E5A9 8E0106           (    forth6809.asm):03515         QUERYW:     LDX   #TIBBUF
E5AC 3610             (    forth6809.asm):03516                     PSHU  X
E5AE CC0050           (    forth6809.asm):03517                     LDD   #TIBBUFL
E5B1 3606             (    forth6809.asm):03518                     PSHU  D
E5B3 BDE539           (    forth6809.asm):03519                     JSR   ACCEPTW
E5B6 3706             (    forth6809.asm):03520                     PULU  D
E5B8 DD12             (    forth6809.asm):03521                     STD   NTIB
E5BA DD3B             (    forth6809.asm):03522                     STD   SRCLEN
E5BC CC0106           (    forth6809.asm):03523                     LDD   #TIBBUF
E5BF DD39             (    forth6809.asm):03524                     STD   SRCADDR
E5C1 CC0000           (    forth6809.asm):03525                     LDD   #0
E5C4 DD3D             (    forth6809.asm):03526                     STD   SRCID
E5C6 DD10             (    forth6809.asm):03527                     STD   TOIN
E5C8 39               (    forth6809.asm):03528                     RTS
                      (    forth6809.asm):03529         
                      (    forth6809.asm):03530         ; ============================================================
                      (    forth6809.asm):03531         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03532         ; ============================================================
                      (    forth6809.asm):03533         ; ------------------------------------------------------------
                      (    forth6809.asm):03534         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03535         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03536         ; one expected.
                      (    forth6809.asm):03537         ; CFERR
                      (    forth6809.asm):03538         ;    Inputs:
                      (    forth6809.asm):03539         ;        none
                      (    forth6809.asm):03540         ;    Outputs:
                      (    forth6809.asm):03541         ;        does not return (THROW -22)
                      (    forth6809.asm):03542         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03543         ; ------------------------------------------------------------
E5C9 CCFFEA           (    forth6809.asm):03544         CFERR:      LDD   #-22
E5CC 3606             (    forth6809.asm):03545                     PSHU  D                 ; -22
E5CE BDE5FE           (    forth6809.asm):03546                     JSR   THROWW
E5D1 39               (    forth6809.asm):03547                     RTS
                      (    forth6809.asm):03548         
                      (    forth6809.asm):03549         ; ------------------------------------------------------------
                      (    forth6809.asm):03550         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03551         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03552         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03553         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03554         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03555         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03556         ; ------------------------------------------------------------
E5D2 3710             (    forth6809.asm):03557         CATCHW:     PULU  X                 ; xt
E5D4 DC0C             (    forth6809.asm):03558                     LDD   HANDLER
E5D6 3406             (    forth6809.asm):03559                     PSHS  D
E5D8 3440             (    forth6809.asm):03560                     PSHS  U
                      (    forth6809.asm):03561                     ; Save the input source specification.
                      (    forth6809.asm):03562                     ; See bugfix: CATCHW.1
E5DA DC39             (    forth6809.asm):03563                     LDD   SRCADDR
E5DC 3406             (    forth6809.asm):03564                     PSHS  D
E5DE DC3B             (    forth6809.asm):03565                     LDD   SRCLEN
E5E0 3406             (    forth6809.asm):03566                     PSHS  D
E5E2 DC3D             (    forth6809.asm):03567                     LDD   SRCID
E5E4 3406             (    forth6809.asm):03568                     PSHS  D
E5E6 DC10             (    forth6809.asm):03569                     LDD   TOIN
E5E8 3406             (    forth6809.asm):03570                     PSHS  D
E5EA 1F40             (    forth6809.asm):03571                     TFR   S,D
E5EC DD0C             (    forth6809.asm):03572                     STD   HANDLER
                      (    forth6809.asm):03573         
E5EE AD84             (    forth6809.asm):03574                     JSR   ,X
                      (    forth6809.asm):03575         
E5F0 3268             (    forth6809.asm):03576                     LEAS  8,S               ; drop saved input source
E5F2 3262             (    forth6809.asm):03577                     LEAS  2,S               ; saved U
E5F4 3506             (    forth6809.asm):03578                     PULS  D
E5F6 DD0C             (    forth6809.asm):03579                     STD   HANDLER
E5F8 CC0000           (    forth6809.asm):03580                     LDD   #0
E5FB 3606             (    forth6809.asm):03581                     PSHU  D                 ; 0 = no exception
E5FD 39               (    forth6809.asm):03582                     RTS
                      (    forth6809.asm):03583         
                      (    forth6809.asm):03584         ; ------------------------------------------------------------
                      (    forth6809.asm):03585         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03586         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03587         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03588         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03589         ; ------------------------------------------------------------
E5FE 3706             (    forth6809.asm):03590         THROWW:     PULU  D                 ; n
E600 10830000         (    forth6809.asm):03591                     CMPD  #0
E604 2725             (    forth6809.asm):03592                     BEQ   THDONE
                      (    forth6809.asm):03593         
E606 DD0E             (    forth6809.asm):03594                     STD   THROWN
E608 9E0C             (    forth6809.asm):03595                     LDX   HANDLER
E60A 2720             (    forth6809.asm):03596                     BEQ   THUNCAU
                      (    forth6809.asm):03597         
E60C 1F14             (    forth6809.asm):03598                     TFR   X,S
E60E 3506             (    forth6809.asm):03599                     PULS  D                 ; restore input source saved by CATCH
E610 DD10             (    forth6809.asm):03600                     STD   TOIN
E612 3506             (    forth6809.asm):03601                     PULS  D
E614 DD3D             (    forth6809.asm):03602                     STD   SRCID
E616 3506             (    forth6809.asm):03603                     PULS  D
E618 DD3B             (    forth6809.asm):03604                     STD   SRCLEN
E61A 3506             (    forth6809.asm):03605                     PULS  D
E61C DD39             (    forth6809.asm):03606                     STD   SRCADDR
E61E 3506             (    forth6809.asm):03607                     PULS  D
E620 1F03             (    forth6809.asm):03608                     TFR   D,U
E622 3506             (    forth6809.asm):03609                     PULS  D
E624 DD0C             (    forth6809.asm):03610                     STD   HANDLER
                      (    forth6809.asm):03611         
E626 DC0E             (    forth6809.asm):03612                     LDD   THROWN
E628 3606             (    forth6809.asm):03613                     PSHU  D
E62A 39               (    forth6809.asm):03614                     RTS
E62B 39               (    forth6809.asm):03615         THDONE:     RTS
                      (    forth6809.asm):03616         
                      (    forth6809.asm):03617                     ; No CATCH is active: leave n on the stack and ABORT.
E62C DC0E             (    forth6809.asm):03618         THUNCAU:    LDD   THROWN
E62E 3606             (    forth6809.asm):03619                     PSHU  D
E630 7EDEC3           (    forth6809.asm):03620                     JMP   ABORT
                      (    forth6809.asm):03621         
                      (    forth6809.asm):03622         ; ============================================================
                      (    forth6809.asm):03623         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03624         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03625         ; ============================================================
                      (    forth6809.asm):03626         ; ------------------------------------------------------------
                      (    forth6809.asm):03627         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03628         ; location.
                      (    forth6809.asm):03629         ; PATCH   ( target location -- )
                      (    forth6809.asm):03630         ;    Inputs:
                      (    forth6809.asm):03631         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03632         ;    Outputs:
                      (    forth6809.asm):03633         ;        the cell at location holds target - location
                      (    forth6809.asm):03634         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03635         ; ------------------------------------------------------------
E633 3710             (    forth6809.asm):03636         PATCH:      PULU  X                 ; location
E635 3706             (    forth6809.asm):03637                     PULU  D                 ; target
E637 3410             (    forth6809.asm):03638                     PSHS  X
E639 A3E1             (    forth6809.asm):03639                     SUBD  ,S++              ; target - location
E63B ED84             (    forth6809.asm):03640                     STD   ,X
E63D 39               (    forth6809.asm):03641                     RTS
                      (    forth6809.asm):03642         
                      (    forth6809.asm):03643         ; ------------------------------------------------------------
                      (    forth6809.asm):03644         ; IF  ( C: -- orig )
                      (    forth6809.asm):03645         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03646         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03647         ; ------------------------------------------------------------
E63E CCDF70           (    forth6809.asm):03648         IFW:        LDD   #ZBRANCH
E641 3606             (    forth6809.asm):03649                     PSHU  D
E643 BDEA39           (    forth6809.asm):03650                     JSR   CCALL
E646 CC0000           (    forth6809.asm):03651                     LDD   #0
E649 3606             (    forth6809.asm):03652                     PSHU  D
E64B BDDFFA           (    forth6809.asm):03653                     JSR   CODECOMMA
E64E DC08             (    forth6809.asm):03654                     LDD   CODEHERE
E650 830002           (    forth6809.asm):03655                     SUBD  #2
E653 3606             (    forth6809.asm):03656                     PSHU  D                 ; orig
E655 CC0001           (    forth6809.asm):03657                     LDD   #TAGFWD
E658 3606             (    forth6809.asm):03658                     PSHU  D
E65A 39               (    forth6809.asm):03659                     RTS
                      (    forth6809.asm):03660         
                      (    forth6809.asm):03661         ; ------------------------------------------------------------
                      (    forth6809.asm):03662         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03663         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03664         ; operand to jump to the current code address.
                      (    forth6809.asm):03665         ; ------------------------------------------------------------
E65B 3706             (    forth6809.asm):03666         THENW:      PULU  D
E65D 10830001         (    forth6809.asm):03667                     CMPD  #TAGFWD
E661 2703             (    forth6809.asm):03668                     BEQ   THOK
E663 BDE5C9           (    forth6809.asm):03669                     JSR   CFERR
E666 3710             (    forth6809.asm):03670         THOK:       PULU  X                 ; orig
E668 DC08             (    forth6809.asm):03671                     LDD   CODEHERE
E66A 3606             (    forth6809.asm):03672                     PSHU  D
E66C 3610             (    forth6809.asm):03673                     PSHU  X
E66E BDE633           (    forth6809.asm):03674                     JSR   PATCH
E671 39               (    forth6809.asm):03675                     RTS
                      (    forth6809.asm):03676         
                      (    forth6809.asm):03677         ; ------------------------------------------------------------
                      (    forth6809.asm):03678         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03679         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03680         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03681         ; ------------------------------------------------------------
E672 3706             (    forth6809.asm):03682         ELSEW:      PULU  D
E674 10830001         (    forth6809.asm):03683                     CMPD  #TAGFWD
E678 2703             (    forth6809.asm):03684                     BEQ   ELOK
E67A BDE5C9           (    forth6809.asm):03685                     JSR   CFERR
E67D 3706             (    forth6809.asm):03686         ELOK:       PULU  D                 ; orig1
E67F 3406             (    forth6809.asm):03687                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E681 CCDF86           (    forth6809.asm):03688                     LDD   #BRANCH
E684 3606             (    forth6809.asm):03689                     PSHU  D
E686 BDEA39           (    forth6809.asm):03690                     JSR   CCALL
E689 CC0000           (    forth6809.asm):03691                     LDD   #0
E68C 3606             (    forth6809.asm):03692                     PSHU  D
E68E BDDFFA           (    forth6809.asm):03693                     JSR   CODECOMMA
E691 DC08             (    forth6809.asm):03694                     LDD   CODEHERE
E693 3606             (    forth6809.asm):03695                     PSHU  D
E695 3506             (    forth6809.asm):03696                     PULS  D                 ; orig1
E697 3606             (    forth6809.asm):03697                     PSHU  D
E699 BDE633           (    forth6809.asm):03698                     JSR   PATCH
E69C DC08             (    forth6809.asm):03699                     LDD   CODEHERE
E69E 830002           (    forth6809.asm):03700                     SUBD  #2
E6A1 3606             (    forth6809.asm):03701                     PSHU  D                 ; orig2
E6A3 CC0001           (    forth6809.asm):03702                     LDD   #TAGFWD
E6A6 3606             (    forth6809.asm):03703                     PSHU  D
E6A8 39               (    forth6809.asm):03704                     RTS
                      (    forth6809.asm):03705         
                      (    forth6809.asm):03706         ; ------------------------------------------------------------
                      (    forth6809.asm):03707         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03708         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03709         ; stack.
                      (    forth6809.asm):03710         ; ------------------------------------------------------------
E6A9 DC08             (    forth6809.asm):03711         BEGINW:     LDD   CODEHERE
E6AB 3606             (    forth6809.asm):03712                     PSHU  D                 ; dest
E6AD CC0002           (    forth6809.asm):03713                     LDD   #TAGBACK
E6B0 3606             (    forth6809.asm):03714                     PSHU  D
E6B2 39               (    forth6809.asm):03715                     RTS
                      (    forth6809.asm):03716         
                      (    forth6809.asm):03717         ; ------------------------------------------------------------
                      (    forth6809.asm):03718         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03719         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03720         ; ------------------------------------------------------------
E6B3 3706             (    forth6809.asm):03721         UNTILW:     PULU  D
E6B5 10830002         (    forth6809.asm):03722                     CMPD  #TAGBACK
E6B9 2703             (    forth6809.asm):03723                     BEQ   UNOK
E6BB BDE5C9           (    forth6809.asm):03724                     JSR   CFERR
E6BE 3706             (    forth6809.asm):03725         UNOK:       PULU  D                 ; dest
E6C0 3606             (    forth6809.asm):03726                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E6C2 CCDF70           (    forth6809.asm):03727                     LDD   #ZBRANCH
E6C5 3606             (    forth6809.asm):03728                     PSHU  D
E6C7 BDEA39           (    forth6809.asm):03729                     JSR   CCALL
E6CA CC0000           (    forth6809.asm):03730                     LDD   #0
E6CD 3606             (    forth6809.asm):03731                     PSHU  D
E6CF BDDFFA           (    forth6809.asm):03732                     JSR   CODECOMMA
E6D2 DC08             (    forth6809.asm):03733                     LDD   CODEHERE
E6D4 830002           (    forth6809.asm):03734                     SUBD  #2
E6D7 3606             (    forth6809.asm):03735                     PSHU  D                 ; location; the parked dest is beneath
E6D9 BDE633           (    forth6809.asm):03736                     JSR   PATCH
E6DC 39               (    forth6809.asm):03737                     RTS
                      (    forth6809.asm):03738         
                      (    forth6809.asm):03739         ; ------------------------------------------------------------
                      (    forth6809.asm):03740         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03741         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03742         ; ------------------------------------------------------------
E6DD 3706             (    forth6809.asm):03743         AGAINW:     PULU  D
E6DF 10830002         (    forth6809.asm):03744                     CMPD  #TAGBACK
E6E3 2703             (    forth6809.asm):03745                     BEQ   AGOK
E6E5 BDE5C9           (    forth6809.asm):03746                     JSR   CFERR
E6E8 3706             (    forth6809.asm):03747         AGOK:       PULU  D                 ; dest
E6EA 3606             (    forth6809.asm):03748                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E6EC CCDF86           (    forth6809.asm):03749                     LDD   #BRANCH
E6EF 3606             (    forth6809.asm):03750                     PSHU  D
E6F1 BDEA39           (    forth6809.asm):03751                     JSR   CCALL
E6F4 CC0000           (    forth6809.asm):03752                     LDD   #0
E6F7 3606             (    forth6809.asm):03753                     PSHU  D
E6F9 BDDFFA           (    forth6809.asm):03754                     JSR   CODECOMMA
E6FC DC08             (    forth6809.asm):03755                     LDD   CODEHERE
E6FE 830002           (    forth6809.asm):03756                     SUBD  #2
E701 3606             (    forth6809.asm):03757                     PSHU  D                 ; location; the parked dest is beneath
E703 BDE633           (    forth6809.asm):03758                     JSR   PATCH
E706 39               (    forth6809.asm):03759                     RTS
                      (    forth6809.asm):03760         
                      (    forth6809.asm):03761         ; ------------------------------------------------------------
                      (    forth6809.asm):03762         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03763         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03764         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
E707 CCDF70           (    forth6809.asm):03766         WHILEW:     LDD   #ZBRANCH
E70A 3606             (    forth6809.asm):03767                     PSHU  D
E70C BDEA39           (    forth6809.asm):03768                     JSR   CCALL
E70F CC0000           (    forth6809.asm):03769                     LDD   #0
E712 3606             (    forth6809.asm):03770                     PSHU  D
E714 BDDFFA           (    forth6809.asm):03771                     JSR   CODECOMMA
E717 DC08             (    forth6809.asm):03772                     LDD   CODEHERE
E719 830002           (    forth6809.asm):03773                     SUBD  #2
E71C 3606             (    forth6809.asm):03774                     PSHU  D                 ; orig
E71E CC0001           (    forth6809.asm):03775                     LDD   #TAGFWD
E721 3606             (    forth6809.asm):03776                     PSHU  D
E723 39               (    forth6809.asm):03777                     RTS
                      (    forth6809.asm):03778         
                      (    forth6809.asm):03779         ; ------------------------------------------------------------
                      (    forth6809.asm):03780         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03781         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03782         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03783         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03784         ; ------------------------------------------------------------
E724 3706             (    forth6809.asm):03785         REPEATW:    PULU  D
E726 10830001         (    forth6809.asm):03786                     CMPD  #TAGFWD
E72A 2703             (    forth6809.asm):03787                     BEQ   RPOK1
E72C BDE5C9           (    forth6809.asm):03788                     JSR   CFERR
E72F 3710             (    forth6809.asm):03789         RPOK1:      PULU  X                 ; orig
E731 3410             (    forth6809.asm):03790                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03791         
                      (    forth6809.asm):03792                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03793                     ; See bugfix: REPEATW.1
E733 3040             (    forth6809.asm):03794                     LEAX  0,U               ; scan from top of control stack
E735 9F16             (    forth6809.asm):03795                     STX   MSCR2             ; MSCR2 = base of scan region
E737 9F1A             (    forth6809.asm):03796                     STX   MSCR4             ; MSCR4 = scan pointer
E739 DC1A             (    forth6809.asm):03797         RPSCAN:     LDD   MSCR4
E73B 109321           (    forth6809.asm):03798                     CMPD  CSP
E73E 2603             (    forth6809.asm):03799                     BNE   RPSCANOK
E740 BDE5C9           (    forth6809.asm):03800                     JSR   CFERR             ; no matching BEGIN
E743 9E1A             (    forth6809.asm):03801         RPSCANOK:   LDX   MSCR4
E745 EC84             (    forth6809.asm):03802                     LDD   ,X
E747 10830002         (    forth6809.asm):03803                     CMPD  #TAGBACK
E74B 2712             (    forth6809.asm):03804                     BEQ   RPFOUND
E74D 10830001         (    forth6809.asm):03805                     CMPD  #TAGFWD
E751 2703             (    forth6809.asm):03806                     BEQ   RPSKIP
E753 BDE5C9           (    forth6809.asm):03807                     JSR   CFERR             ; anything else is a genuine mismatch
E756 DC1A             (    forth6809.asm):03808         RPSKIP:     LDD   MSCR4
E758 C30004           (    forth6809.asm):03809                     ADDD  #4
E75B DD1A             (    forth6809.asm):03810                     STD   MSCR4
E75D 20DA             (    forth6809.asm):03811                     BRA   RPSCAN
E75F 9E1A             (    forth6809.asm):03812         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E761 EC02             (    forth6809.asm):03813                     LDD   2,X               ; dest = BEGIN's address
E763 3406             (    forth6809.asm):03814                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03815         
                      (    forth6809.asm):03816                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03817                     ; bytes, highest word first.
E765 DC1A             (    forth6809.asm):03818                     LDD   MSCR4
E767 9316             (    forth6809.asm):03819                     SUBD  MSCR2
E769 DD18             (    forth6809.asm):03820                     STD   MSCR3             ; MSCR3 = bytes to shift
E76B 2715             (    forth6809.asm):03821                     BEQ   RPSHIFTDONE
E76D DC18             (    forth6809.asm):03822         RPSHIFT:    LDD   MSCR3
E76F 830002           (    forth6809.asm):03823                     SUBD  #2
E772 DD18             (    forth6809.asm):03824                     STD   MSCR3
E774 9E16             (    forth6809.asm):03825                     LDX   MSCR2
E776 308B             (    forth6809.asm):03826                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E778 EC84             (    forth6809.asm):03827                     LDD   ,X
E77A 3004             (    forth6809.asm):03828                     LEAX  4,X
E77C ED84             (    forth6809.asm):03829                     STD   ,X                ; copy one word 4 bytes higher
E77E DC18             (    forth6809.asm):03830                     LDD   MSCR3
E780 26EB             (    forth6809.asm):03831                     BNE   RPSHIFT
E782                  (    forth6809.asm):03832         RPSHIFTDONE:
E782 9E16             (    forth6809.asm):03833                     LDX   MSCR2
E784 3004             (    forth6809.asm):03834                     LEAX  4,X
E786 1F13             (    forth6809.asm):03835                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03836         

                      (    forth6809.asm):02097                                   ; were chained on after it; before that,
                      (    forth6809.asm):02098                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):02099                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):02100                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):02101                                   ; before this one.
                      (    forth6809.asm):02102         
                      (    forth6809.asm):02103         ; Verify no collision with base code.

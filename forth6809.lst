                      (    forth6809.asm):05585         ; Push the address of the terminal input buffer.
                      (    forth6809.asm):05586         ; ------------------------------------------------------------
E381 CC0106           (    forth6809.asm):05587         TIBW:       LDD   #TIBBUF
E384 3606             (    forth6809.asm):05588                     PSHU  D
E386 39               (    forth6809.asm):05589                     RTS
                      (    forth6809.asm):05590         
                      (    forth6809.asm):05591         ; ------------------------------------------------------------
                      (    forth6809.asm):05592         ; #TIB  ( -- a-addr )

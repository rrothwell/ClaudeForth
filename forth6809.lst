F407 3606             (    forth6809.asm):06759                     PSHU  D
F409 7EE561           (    forth6809.asm):06760                     JMP   THROWW
                      (    forth6809.asm):06761         
                      (    forth6809.asm):06762         ; ------------------------------------------------------------
                      (    forth6809.asm):06763         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06764         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06765         ;    Inputs:
                      (    forth6809.asm):06766         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06767         ;        c-addr u on the data stack
                      (    forth6809.asm):06768         ;    Outputs:
                      (    forth6809.asm):06769         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06770         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06771         ; ------------------------------------------------------------
F40C 3606             (    forth6809.asm):06772         CSTRCOMP:   PSHU  D
F40E BDE99C           (    forth6809.asm):06773                     JSR   CCALL
F411 3706             (    forth6809.asm):06774                     PULU  D                 ; u
F413 3720             (    forth6809.asm):06775                     PULU  Y                 ; c-addr
F415 9E08             (    forth6809.asm):06776                     LDX   CODEHERE
F417 E780             (    forth6809.asm):06777                     STB   ,X+
F419 5D               (    forth6809.asm):06778                     TSTB
F41A 2707             (    forth6809.asm):06779                     BEQ   CSEND

                      (    forth6809.asm):01744                    BNE   QNFAIL
                      (    forth6809.asm):01745         
                      (    forth6809.asm):01746                    LDD   TSTUB4
                      (    forth6809.asm):01747                    SUBD  TSTUAF
                      (    forth6809.asm):01748                    CMPD  #2
                      (    forth6809.asm):01749                    BNE   QNFAIL
                      (    forth6809.asm):01750         
                      (    forth6809.asm):01751                    LDD   #TRUEV
                      (    forth6809.asm):01752                    BRA   QNDONE

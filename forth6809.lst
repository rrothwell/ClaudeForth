E904 DD29             (    forth6809.asm):04133                     STD   MSCR              ; MSCR = step
E906 EC66             (    forth6809.asm):04134                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E908 262D             (    forth6809.asm):04135                     BNE   DPTEXIT           ; set: exit
E90A EC62             (    forth6809.asm):04136                     LDD   2,S               ; old index
E90C A364             (    forth6809.asm):04137                     SUBD  4,S               ; old_u = old_index - limit, mod 65536

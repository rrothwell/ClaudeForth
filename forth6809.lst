                      (    forth6809.asm):02376         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02377         ; ------------------------------------------------------------
DD5D                  (    forth6809.asm):02378         RTSCHECKLO: 
                      (    forth6809.asm):02379                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02380         
                      (    forth6809.asm):02381                                 JSR  INFILL
                      (    forth6809.asm):02382                     CMPA #INLOWATER
                      (    forth6809.asm):02383                     BHI  RTSCLODONE
                      (    forth6809.asm):02384                     TST  RTSSTATE
                      (    forth6809.asm):02385                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):02386         
                      (    forth6809.asm):02387         
                      (    forth6809.asm):02388                     CLR  RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02389         
                      (    forth6809.asm):02390                     LDB  OUTTAIL           ; Check if chars are available.  
                      (    forth6809.asm):02391                     CMPB OUTHEAD
                      (    forth6809.asm):02392                     BEQ  RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394                     LDA  #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02395                     STA  ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02396                     BRA  RTSCLOUNMASK
                      (    forth6809.asm):02397         
DD5D                  (    forth6809.asm):02398         RTSCLONOTX: LDA  #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02399                     STA  ACIACR
                      (    forth6809.asm):02400         
DD5D                  (    forth6809.asm):02401         RTSCLOUNMASK: ANDCC #$EF
                      (    forth6809.asm):02402         
DD5D                  (    forth6809.asm):02403         RTSCLODONE: RTS
                      (    forth6809.asm):02404         
                      (    forth6809.asm):02405         ; ------------------------------------------------------------
                      (    forth6809.asm):02406         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02407         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02408         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02409         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02410         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02411         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02412         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02413         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02414         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02415         ;
                      (    forth6809.asm):02416         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02417         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02418         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02419         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02420         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02421         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02422         ;
                      (    forth6809.asm):02423         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02424         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02425         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02426         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02427         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02428         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02429         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02430         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02431         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02432         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02433         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02434         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02435         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
DD5D                  (    forth6809.asm):02437         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02438         
                      (    forth6809.asm):02439                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02440                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02441                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02442                     BNE   INCHAR
                      (    forth6809.asm):02443                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02444                     BNE   OUTCHAR
                      (    forth6809.asm):02445                                             ; Ignore all other interrupts such as DCD change.
DD5D                  (    forth6809.asm):02446         IRQDONE0:  RTI                      ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02447                                             ; & restores state.
                      (    forth6809.asm):02448         
DD5D                  (    forth6809.asm):02449         INCHAR:
                      (    forth6809.asm):02450                     LDB   ACIADR               ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02451                     BITA  #SR_FE+SR_OVRN+SR_PE ; Any receiver error flagged?
                      (    forth6809.asm):02452                     BEQ   INOK                 ; No! - character is good, keep it.
                      (    forth6809.asm):02453                                              
                      (    forth6809.asm):02454                     BITA  #SR_FE               ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02455                     BEQ   INXFE                ; Tally each flagged error independently -
                      (    forth6809.asm):02456                     INC   FECOUNT              ; more than one bit can be set at once.
DD5D                  (    forth6809.asm):02457         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02458                     BEQ   INXOVRN
                      (    forth6809.asm):02459                     INC   OVRNCOUNT
DD5D                  (    forth6809.asm):02460         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02461                     BEQ   INXPE
                      (    forth6809.asm):02462                     INC   PECOUNT 
DD5D                  (    forth6809.asm):02463         INXPE:      RTI         
                      (    forth6809.asm):02464         
DD5D                  (    forth6809.asm):02465         INOK:    TFR   B,A                  ; Transfer good character from the receiver.
                      (    forth6809.asm):02466                  LDX   #INBUF               ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02467                  LDB   INHEAD
                      (    forth6809.asm):02468                  STA   B,X
                      (    forth6809.asm):02469                  INCB                  ; Figure out the new head,
                      (    forth6809.asm):02470                  ANDB  #INBUFSZ-1      ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02471                  CMPB  INTAIL          ; Would the new head slot meet the tail?
                      (    forth6809.asm):02472                  BEQ   IRQDONE1        ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02473                  STB   INHEAD          ; New head pointer is OK so store it.
                      (    forth6809.asm):02474                  ;JSR   RTSCHECKHI     ; Protect the in buffer from overflow.
                      (    forth6809.asm):02475                                        ; OPTIMIZATION: RegB still holds the new head
                      (    forth6809.asm):02476                                        ; value STB just stored (STB doesn't clobber
                      (    forth6809.asm):02477                                        ; it) - reuse it directly to get the fill
                      (    forth6809.asm):02478                                        ; level, rather than have CHKHI reload INHEAD
                      (    forth6809.asm):02479                                        ; from memory. This is the single hottest
                      (    forth6809.asm):02480                                        ; per-character path in the system (it runs
                      (    forth6809.asm):02481                                        ; on every byte received), so a redundant
                      (    forth6809.asm):02482                                        ; 4-cycle load here is worth avoiding.
                      (    forth6809.asm):02483                  SUBB  INTAIL          ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02484                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02485                  JSR   CHKHI           ; Protect the in buffer from overflow.
DD5D                  (    forth6809.asm):02486         IRQDONE1: RTI
                      (    forth6809.asm):02487         
                      (    forth6809.asm):02488                  ; LDA   ACIASR          ; Recheck if the transmitter is ready.
                      (    forth6809.asm):02489                  ; BITA  #SR_TDRE        ; after handling the received character.
                      (    forth6809.asm):02490                  ; BEQ IRQDONE2          ; Yes! Process the char.
                      (    forth6809.asm):02491         
DD5D                  (    forth6809.asm):02492         OUTCHAR: LDB   OUTTAIL         ; Is the out buffer empty?
                      (    forth6809.asm):02493                  CMPB  OUTHEAD
                      (    forth6809.asm):02494                  BEQ   TXOFF           ; Yes! Stop transmitting.
                      (    forth6809.asm):02495         
                      (    forth6809.asm):02496                  LDX   #OUTBUF         ; No! The out buffer is occupied.
                      (    forth6809.asm):02497                  LDA   B,X             ; Get the character from the out buffer.
                      (    forth6809.asm):02498                  STA   ACIADR          ; Transmit the char.
                      (    forth6809.asm):02499         
                      (    forth6809.asm):02500                  INCB                  ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02501                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02502                  STB   OUTTAIL
DD5D                  (    forth6809.asm):02503         IRQDONE2  RTI
                      (    forth6809.asm):02504         
DD5D                  (    forth6809.asm):02505         TXOFF:   ; TST   RTSSTATE        ; The buffer is empty.
                      (    forth6809.asm):02506                  ; BNE   IRQDONE3         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02507                                        ; or this would incorrectly drop it back low
                      (    forth6809.asm):02508                  ; LDA   #CR_RXON
                      (    forth6809.asm):02509                  ; STA   ACIACR
                      (    forth6809.asm):02510                  CLR   OUTACTIVITY         
                      (    forth6809.asm):02511                  JSR   UPDATE_RTS         
DD5D                  (    forth6809.asm):02512         IRQDONE3 RTI
                      (    forth6809.asm):02513         
                      (    forth6809.asm):02514                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):02515         
DD5D 3B               (    forth6809.asm):02516         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02517                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02518                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02519                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02520                                       ; the other unused vectors below
                      (    forth6809.asm):02521                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02522         
DD5E 3B               (    forth6809.asm):02523         SWI3H:   RTI
DD5F 3B               (    forth6809.asm):02524         SWI2H:   RTI

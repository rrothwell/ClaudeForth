DEF5                  (    forth6809.asm):18058         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):18059                     STA  ACIACR
DEF5                  (    forth6809.asm):18060         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):18061         RTSCLODONE: RTS
                      (    forth6809.asm):18062         

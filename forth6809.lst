                      (    forth6809.asm):04131         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04132         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04133         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04134         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04135         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04136         ;    Inputs:
                      (    forth6809.asm):04137         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04138         ;    Outputs:
                      (    forth6809.asm):04139         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04140         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04141         ;        scratch.
                      (    forth6809.asm):04142         ; ------------------------------------------------------------
E84F 3706             (    forth6809.asm):04143         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E851 DD14             (    forth6809.asm):04144                     STD   MSCR              ; MSCR = step
E853 EC66             (    forth6809.asm):04145                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E855 262D             (    forth6809.asm):04146                     BNE   DPTEXIT           ; set: exit
E857 EC62             (    forth6809.asm):04147                     LDD   2,S               ; old index
E859 A364             (    forth6809.asm):04148                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E85B DD16             (    forth6809.asm):04149                     STD   MSCR2
E85D EC62             (    forth6809.asm):04150                     LDD   2,S
E85F D314             (    forth6809.asm):04151                     ADDD  MSCR              ; new_index = old_index + step
E861 ED62             (    forth6809.asm):04152                     STD   2,S
E863 A364             (    forth6809.asm):04153                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E865 DD18             (    forth6809.asm):04154                     STD   MSCR3
                      (    forth6809.asm):04155                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04156                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04157                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

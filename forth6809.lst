                      (    forth6809.asm):11589         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):11590         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):11591         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):11592         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):11593         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):11594         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):11595         ; ============================================================
                      (    forth6809.asm):11596         ; ------------------------------------------------------------
                      (    forth6809.asm):11597         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):11598         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):11599         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):11600         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):11601         ; - no indirection, no value cell.
                      (    forth6809.asm):11602         ;
                      (    forth6809.asm):11603         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):11604         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):11605         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):11606         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):11607         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):11608         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):11609         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):11610         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):11611         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):11612         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):11613         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):11614         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):11615                    PSHU  D
FF3C 39               (    forth6809.asm):11616                    RTS
                      (    forth6809.asm):11617         
FF3D CC0000           (    forth6809.asm):11618         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):11619                    PSHU  D
FF42 39               (    forth6809.asm):11620                    RTS
                      (    forth6809.asm):11621         
                      (    forth6809.asm):11622         ; ------------------------------------------------------------
                      (    forth6809.asm):11623         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):11624         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):11625         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):11626         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):11627         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):11628         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):11629                    PSHU  D

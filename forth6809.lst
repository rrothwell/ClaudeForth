                      (    forth6809.asm):02469         ; TSTMODZ - unit test for MODW, divide-by-zero case. n2 = 0.
                      (    forth6809.asm):02470         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02471         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02472         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02473         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02474         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02475         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02476         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02477         ; there are.
                      (    forth6809.asm):02478         ; ------------------------------------------------------------
C358                  (    forth6809.asm):02479         TSTMODZ:    STU   TSTU0
                      (    forth6809.asm):02480         
                      (    forth6809.asm):02481                    LDD   #TSTVAL1
                      (    forth6809.asm):02482                    PSHU  D
                      (    forth6809.asm):02483                    LDD   #$0000
                      (    forth6809.asm):02484                    PSHU  D
                      (    forth6809.asm):02485                    LDX   #MODW
                      (    forth6809.asm):02486                    PSHU  X
                      (    forth6809.asm):02487                    STU   TSTUB4
                      (    forth6809.asm):02488         
                      (    forth6809.asm):02489                    JSR   CATCH
                      (    forth6809.asm):02490         
                      (    forth6809.asm):02491                    STU   TSTUAF
                      (    forth6809.asm):02492         
                      (    forth6809.asm):02493                    PULU  D
                      (    forth6809.asm):02494                    CMPD  #-10
                      (    forth6809.asm):02495                    BNE   MZFAIL
                      (    forth6809.asm):02496         
                      (    forth6809.asm):02497                    LDD   TSTUB4
                      (    forth6809.asm):02498                    SUBD  TSTUAF
                      (    forth6809.asm):02499                    CMPD  #0
                      (    forth6809.asm):02500                    BNE   MZFAIL
                      (    forth6809.asm):02501         
                      (    forth6809.asm):02502                    LDD   #TRUEV
                      (    forth6809.asm):02503                    BRA   MZDONE
C358                  (    forth6809.asm):02504         MZFAIL:     LDD   #FALSEV
C358                  (    forth6809.asm):02505         MZDONE:     LDX   #TSTMODZNAME
                      (    forth6809.asm):02506                    PSHU  X
                      (    forth6809.asm):02507                    PSHU  D

                      (    forth6809.asm):03894         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03895         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03896         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03897         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03898         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03899         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03900         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03901         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03902         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03903         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03904         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03905         ; ------------------------------------------------------------
C1C7 BDFC2B           (    forth6809.asm):03906         TSTDARITH: JSR   CRW
C1CA 8EC1DB           (    forth6809.asm):03907                    LDX   #TSTDARITHMSG
C1CD 3610             (    forth6809.asm):03908                    PSHU  X
C1CF CC000B           (    forth6809.asm):03909                    LDD   #11
C1D2 3606             (    forth6809.asm):03910                    PSHU  D

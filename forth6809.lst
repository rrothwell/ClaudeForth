                      (    forth6809.asm):07084         ; Divide the unsigned double UDHI:UDLO by BASE (restoring division, 32
                      (    forth6809.asm):07085         ; iterations). Only the low byte of BASE is used.
                      (    forth6809.asm):07086         ; UDDIGIT

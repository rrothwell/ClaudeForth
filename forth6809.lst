                      (    forth6809.asm):12843                      STD  CODEHERE
                      (    forth6809.asm):12844                      LDD  TSTSASAV
                      (    forth6809.asm):12845                      STD  SRCADDR
                      (    forth6809.asm):12846                      LDD  TSTSLSAV
                      (    forth6809.asm):12847                      STD  SRCLEN
                      (    forth6809.asm):12848                      LDD  TSTTISAV
                      (    forth6809.asm):12849                      STD  TOIN
                      (    forth6809.asm):12850         
                      (    forth6809.asm):12851                      IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):12852                      LDA  OUTHEAD
                      (    forth6809.asm):12853                      STA  TSTOHSAV
                      (    forth6809.asm):12854                      ENDC ; <<<<
                      (    forth6809.asm):12855         
                      (    forth6809.asm):12856                      STU  TSTU0
                      (    forth6809.asm):12857         
                      (    forth6809.asm):12858                      LDD  #TSTGUARD
                      (    forth6809.asm):12859                      PSHU D
                      (    forth6809.asm):12860                      STU  TSTUB4
                      (    forth6809.asm):12861         

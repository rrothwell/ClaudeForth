E853 3606             (    forth6809.asm):04429                     PSHU  D
E855 DC08             (    forth6809.asm):04430                     LDD   CODEHERE
E857 3606             (    forth6809.asm):04431                     PSHU  D                 ; dest
E859 CC0003           (    forth6809.asm):04432                     LDD   #TAGDO
E85C 3606             (    forth6809.asm):04433                     PSHU  D

E72D 3706             (    forth6809.asm):03820         AGAINW:     PULU  D
E72F 10830002         (    forth6809.asm):03821                     CMPD  #TAGBACK
E733 2703             (    forth6809.asm):03822                     BEQ   AGOK
E735 BDE60D           (    forth6809.asm):03823                     JSR   CFERR
E738 3706             (    forth6809.asm):03824         AGOK:       PULU  D                 ; dest
E73A 3606             (    forth6809.asm):03825                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E73C CCDF86           (    forth6809.asm):03826                     LDD   #BRANCH
E73F 3606             (    forth6809.asm):03827                     PSHU  D
E741 BDEAB7           (    forth6809.asm):03828                     JSR   CCALL

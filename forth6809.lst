                      (    forth6809.asm):10674         ; TSTABORTQ1 - unit test for ABORT", false-flag case. Compile-
                      (    forth6809.asm):10675         ; only (throws -14 otherwise). Compiles ABORT" with a known
                      (    forth6809.asm):10676         ; message ("HI"), executes with a false flag, and verifies
                      (    forth6809.asm):10677         ; execution genuinely resumes right after the embedded message
                      (    forth6809.asm):10678         ; text - confirmed by hand-tracing DOABORTQUOTE's own code: on
                      (    forth6809.asm):10679         ; false, it skips past the inline message and returns normally,
                      (    forth6809.asm):10680         ; matching its own documented "on false flag: does nothing
                      (    forth6809.asm):10681         ; further".
                      (    forth6809.asm):10682         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):10683         TSTABORTQ1: LDD  CODEHERE
                      (    forth6809.asm):10684                     STD  TSTCSAV
                      (    forth6809.asm):10685                     LDD  SRCADDR
                      (    forth6809.asm):10686                     STD  TSTSASAV
                      (    forth6809.asm):10687                     LDD  SRCLEN
                      (    forth6809.asm):10688                     STD  TSTSLSAV
                      (    forth6809.asm):10689                     LDD  TOIN
                      (    forth6809.asm):10690                     STD  TSTTISAV
                      (    forth6809.asm):10691                     LDD  STATE
                      (    forth6809.asm):10692                     STD  TSTSTSAV
                      (    forth6809.asm):10693         
                      (    forth6809.asm):10694                     LDA  #'H'
                      (    forth6809.asm):10695                     STA  TSTNAMEB
                      (    forth6809.asm):10696                     LDA  #'I'
                      (    forth6809.asm):10697                     STA  TSTNAMEB+1
                      (    forth6809.asm):10698                     LDA  #34
                      (    forth6809.asm):10699                     STA  TSTNAMEB+2
                      (    forth6809.asm):10700         
                      (    forth6809.asm):10701                     LDD  #TSTCBUF
                      (    forth6809.asm):10702                     STD  CODEHERE
                      (    forth6809.asm):10703                     LDD  #TSTNAMEB
                      (    forth6809.asm):10704                     STD  SRCADDR
                      (    forth6809.asm):10705                     LDD  #3
                      (    forth6809.asm):10706                     STD  SRCLEN
                      (    forth6809.asm):10707                     LDD  #0
                      (    forth6809.asm):10708                     STD  TOIN
                      (    forth6809.asm):10709                     LDD  #-1
                      (    forth6809.asm):10710                     STD  STATE
                      (    forth6809.asm):10711         
                      (    forth6809.asm):10712                     JSR  ABORTQUOTE
                      (    forth6809.asm):10713         
                      (    forth6809.asm):10714                     LDD  #OPRTS
                      (    forth6809.asm):10715                     PSHU D
                      (    forth6809.asm):10716                     JSR  CCOMMA
                      (    forth6809.asm):10717         
                      (    forth6809.asm):10718                     LDD  TSTCSAV
                      (    forth6809.asm):10719                     STD  CODEHERE
                      (    forth6809.asm):10720                     LDD  TSTSASAV
                      (    forth6809.asm):10721                     STD  SRCADDR
                      (    forth6809.asm):10722                     LDD  TSTSLSAV
                      (    forth6809.asm):10723                     STD  SRCLEN
                      (    forth6809.asm):10724                     LDD  TSTTISAV
                      (    forth6809.asm):10725                     STD  TOIN
                      (    forth6809.asm):10726                     LDD  TSTSTSAV
                      (    forth6809.asm):10727                     STD  STATE
                      (    forth6809.asm):10728         
                      (    forth6809.asm):10729                     STU  TSTU0
                      (    forth6809.asm):10730         
                      (    forth6809.asm):10731                     LDD  #TSTGUARD
                      (    forth6809.asm):10732                     PSHU D
                      (    forth6809.asm):10733                     LDD  #FALSEV
                      (    forth6809.asm):10734                     PSHU D
                      (    forth6809.asm):10735                     STU  TSTUB4
                      (    forth6809.asm):10736         
                      (    forth6809.asm):10737                     LDX  #TSTCBUF
                      (    forth6809.asm):10738                     JSR  ,X
                      (    forth6809.asm):10739         

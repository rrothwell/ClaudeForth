                      (   unit_tests.asm):01767         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (   unit_tests.asm):01768         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (   unit_tests.asm):01769         ; one round-trip test, matching how they can only be meaningfully
                      (   unit_tests.asm):01770         ; tested together - the "must be balanced within the same
                      (   unit_tests.asm):01771         ; definition" constraint each word's own glossary entry
                      (   unit_tests.asm):01772         ; documents). Every >R/2>R in these tests is balanced by a
                      (   unit_tests.asm):01773         ; matching R>/2R> before this group's own RTS - these words
                      (   unit_tests.asm):01774         ; operate directly on the return stack, the same stack holding
                      (   unit_tests.asm):01775         ; real subroutine return addresses, so leaving one unbalanced
                      (   unit_tests.asm):01776         ; would corrupt the path back to whatever called this test.
                      (   unit_tests.asm):01777         ;
                      (   unit_tests.asm):01778         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (   unit_tests.asm):01779         ; peek, then retrieve the original afterward and confirm it's
                      (   unit_tests.asm):01780         ; still correct - not just that the peek itself returned the
                      (   unit_tests.asm):01781         ; right value once.
                      (   unit_tests.asm):01782         ; ------------------------------------------------------------
C19E BDFC2B           (   unit_tests.asm):01783         TSTRETSTACK: JSR CRW
C1A1 8EC1B2           (   unit_tests.asm):01784                    LDX   #TSTRETMSG
C1A4 3610             (   unit_tests.asm):01785                    PSHU  X
C1A6 CC0008           (   unit_tests.asm):01786                    LDD   #8
C1A9 3606             (   unit_tests.asm):01787                    PSHU  D
C1AB BDF60B           (   unit_tests.asm):01788                    JSR   TYPE
C1AE BDFC2B           (   unit_tests.asm):01789                    JSR   CRW
                      (   unit_tests.asm):01790         
                      (   unit_tests.asm):01791                    IFEQ TSTSELECTOR-2  ; >>>>
                      (   unit_tests.asm):01792         
                      (   unit_tests.asm):01793                    JSR   TSTTOR
                      (   unit_tests.asm):01794                    JSR   TSTRFETCH
                      (   unit_tests.asm):01795                    JSR   TSTTWOTOR
                      (   unit_tests.asm):01796                    JSR   TSTTWORFETCH
                      (   unit_tests.asm):01797         
                      (   unit_tests.asm):01798                    ENDC ; <<<<
                      (   unit_tests.asm):01799         
C1B1 39               (   unit_tests.asm):01800                    RTS
                      (   unit_tests.asm):01801         
C1B2 526574537461636B (   unit_tests.asm):01802         TSTRETMSG: FCC "RetStack"
                      (   unit_tests.asm):01803         
                      (   unit_tests.asm):01804                    IFEQ TSTSELECTOR-2  ; >>>>
                      (   unit_tests.asm):01805         
                      (   unit_tests.asm):01806         ; ------------------------------------------------------------
                      (   unit_tests.asm):01807         ; Return-stack test harness (glossary section 3.3). Unlike
                      (   unit_tests.asm):01808         ; every other test group in this file, these words operate
                      (   unit_tests.asm):01809         ; directly on the return stack (S) - the same stack holding
                      (   unit_tests.asm):01810         ; real subroutine return addresses, including this very test
                      (   unit_tests.asm):01811         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (   unit_tests.asm):01812         ; R>/2R> within the same test body, before this test's own
                      (   unit_tests.asm):01813         ; RTS - leaving one unbalanced would corrupt the return address
                      (   unit_tests.asm):01814         ; needed to get back to TSTRUNNER (or whatever called it).
                      (   unit_tests.asm):01815         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (   unit_tests.asm):01816         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (   unit_tests.asm):01817         ; own return address off S, do the actual move, then restore it
                      (   unit_tests.asm):01818         ; on top - so the moved value ends up correctly nested one level
                      (   unit_tests.asm):01819         ; inside the current subroutine's own return-stack frame,
                      (   unit_tests.asm):01820         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (   unit_tests.asm):01821         ; gone by the time this test's own RTS runs.
                      (   unit_tests.asm):01822         ; ------------------------------------------------------------
                      (   unit_tests.asm):01823         
                      (   unit_tests.asm):01824         ; ------------------------------------------------------------
                      (   unit_tests.asm):01825         ; TSTTOR - unit test for >R and R> together. Includes an
                      (   unit_tests.asm):01826         ; intermediate check (right after >R, before R>) confirming the
                      (   unit_tests.asm):01827         ; value genuinely left the data stack - a pure round-trip check
                      (   unit_tests.asm):01828         ; could pass even if both words were broken no-ops, since the
                      (   unit_tests.asm):01829         ; value would never actually have left.
                      (   unit_tests.asm):01830         ; ------------------------------------------------------------
C1BA                  (   unit_tests.asm):01831         TSTTOR:  STU   TSTU0
                      (   unit_tests.asm):01832         
                      (   unit_tests.asm):01833                  LDD   #TSTGUARD
                      (   unit_tests.asm):01834                  PSHU  D
                      (   unit_tests.asm):01835                  LDD   #TSTVAL1
                      (   unit_tests.asm):01836                  PSHU  D
                      (   unit_tests.asm):01837                  STU   TSTUB4
                      (   unit_tests.asm):01838         
                      (   unit_tests.asm):01839                  JSR   TOR
                      (   unit_tests.asm):01840         
                      (   unit_tests.asm):01841                  STU   TSTUMID
                      (   unit_tests.asm):01842         
                      (   unit_tests.asm):01843                  LDD   TSTUB4
                      (   unit_tests.asm):01844                  SUBD  TSTUMID
                      (   unit_tests.asm):01845                  CMPD  #-2
                      (   unit_tests.asm):01846                  BNE   TRFAIL
                      (   unit_tests.asm):01847         
                      (   unit_tests.asm):01848                  JSR   FROMR
                      (   unit_tests.asm):01849         
                      (   unit_tests.asm):01850                  STU   TSTUAF
                      (   unit_tests.asm):01851         
                      (   unit_tests.asm):01852                  PULU  D
                      (   unit_tests.asm):01853                  CMPD  #TSTVAL1
                      (   unit_tests.asm):01854                  BNE   TRFAIL
                      (   unit_tests.asm):01855                  PULU  D
                      (   unit_tests.asm):01856                  CMPD  #TSTGUARD
                      (   unit_tests.asm):01857                  BNE   TRFAIL
                      (   unit_tests.asm):01858         
                      (   unit_tests.asm):01859                  LDD   TSTUB4
                      (   unit_tests.asm):01860                  SUBD  TSTUAF
                      (   unit_tests.asm):01861                  CMPD  #0
                      (   unit_tests.asm):01862                  BNE   TRFAIL
                      (   unit_tests.asm):01863         
                      (   unit_tests.asm):01864                  LDD   #TRUEV
                      (   unit_tests.asm):01865                  BRA   TRDONE
C1BA                  (   unit_tests.asm):01866         TRFAIL:  LDD   #FALSEV
C1BA                  (   unit_tests.asm):01867         TRDONE:  LDX   #TSTTORNAME
                      (   unit_tests.asm):01868                  PSHU  X
                      (   unit_tests.asm):01869                  PSHU  D

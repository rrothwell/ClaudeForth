                      (    forth6809.asm):03434         ; ============================================================
                      (    forth6809.asm):03435         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03436         ; ============================================================
                      (    forth6809.asm):03437                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03438         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03439         
                      (    forth6809.asm):03440         ; ------------------------------------------------------------
                      (    forth6809.asm):03441         ; KEY  ( -- char )
                      (    forth6809.asm):03442         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03443         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03444         ; ------------------------------------------------------------
E43D                  (    forth6809.asm):03445         KEYW:
                      (    forth6809.asm):03446         
                      (    forth6809.asm):03447                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03448                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03449         
                      (    forth6809.asm):03450                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):03451                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03452                                             ; by transmitting all chars.
                      (    forth6809.asm):03453         
E43D                  (    forth6809.asm):03454         TRY_READ:
                      (    forth6809.asm):03455                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03456                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03457                                             ; while still transmitting!
                      (    forth6809.asm):03458         
                      (    forth6809.asm):03459                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03460                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03461                     PSHU  D                 ; char
                      (    forth6809.asm):03462         
                      (    forth6809.asm):03463                     RTS
                      (    forth6809.asm):03464         
                      (    forth6809.asm):03465         ; ------------------------------------------------------------
                      (    forth6809.asm):03466         ; KEY?  ( -- flag )
                      (    forth6809.asm):03467         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03468         ; ------------------------------------------------------------
E43D                  (    forth6809.asm):03469         KEYQW:
                      (    forth6809.asm):03470                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03471         
                      (    forth6809.asm):03472                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03473                     CMPA  INTAIL
                      (    forth6809.asm):03474         
                      (    forth6809.asm):03475                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03476         
                      (    forth6809.asm):03477                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03478         
                      (    forth6809.asm):03479                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03480                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03481         
                      (    forth6809.asm):03482                     RTS
                      (    forth6809.asm):03483         
E43D                  (    forth6809.asm):03484         KQTRUE:
                      (    forth6809.asm):03485                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03486                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03487                     RTS
                      (    forth6809.asm):03488         
                      (    forth6809.asm):03489         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03490         
                      (    forth6809.asm):03491         ; ------------------------------------------------------------
                      (    forth6809.asm):03492         ; EMIT  ( char -- )
                      (    forth6809.asm):03493         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03494         ; discarded if the ring is full.
                      (    forth6809.asm):03495         ; ------------------------------------------------------------
E43D                  (    forth6809.asm):03496         EMITW:
                      (    forth6809.asm):03497                     PULU  D                 ; char
                      (    forth6809.asm):03498                     TFR   B,A
                      (    forth6809.asm):03499                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03500                     RTS
                      (    forth6809.asm):03501         
                      (    forth6809.asm):03502                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03503         ; ------------------------------------------------------------
                      (    forth6809.asm):03504         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03505         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03506         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03507         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03508         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03509         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03510         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03511         ; follow.
                      (    forth6809.asm):03512         ; ------------------------------------------------------------
E43D                  (    forth6809.asm):03513         KEYW:
E43D B6C008           (    forth6809.asm):03514                     LDA   ACIASR
E440 8501             (    forth6809.asm):03515                     BITA  #SR_RDRF
E442 2705             (    forth6809.asm):03516                     BEQ   KWAIT
E444 7C017F           (    forth6809.asm):03517                     INC   POLLREADYCNT      ; character was already queued when we
E447 2007             (    forth6809.asm):03518                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E449                  (    forth6809.asm):03519         KWAIT:
E449 B6C008           (    forth6809.asm):03520         KSPIN:      LDA   ACIASR
E44C 8501             (    forth6809.asm):03521                     BITA  #SR_RDRF
E44E 27F9             (    forth6809.asm):03522                     BEQ   KSPIN
E450                  (    forth6809.asm):03523         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03524                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03525                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03526                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03527                                             ; RDRF and the latched error bits together
E450 8570             (    forth6809.asm):03528                     BITA  #SR_FE+SR_OVRN+SR_PE
E452 2715             (    forth6809.asm):03529                     BEQ   KGETCH
E454 8510             (    forth6809.asm):03530                     BITA  #SR_FE
E456 2703             (    forth6809.asm):03531                     BEQ   KXFE
E458 7C017C           (    forth6809.asm):03532                     INC   FECOUNT
E45B 8520             (    forth6809.asm):03533         KXFE:       BITA  #SR_OVRN
E45D 2703             (    forth6809.asm):03534                     BEQ   KXOVRN
E45F 7C017D           (    forth6809.asm):03535                     INC   OVRNCOUNT
E462 8540             (    forth6809.asm):03536         KXOVRN:     BITA  #SR_PE
E464 2703             (    forth6809.asm):03537                     BEQ   KGETCH
E466 7C017E           (    forth6809.asm):03538                     INC   PECOUNT
E469 B6C009           (    forth6809.asm):03539         KGETCH:     LDA   ACIADR
E46C 1F89             (    forth6809.asm):03540                     TFR   A,B
E46E 4F               (    forth6809.asm):03541                     CLRA
E46F 3606             (    forth6809.asm):03542                     PSHU  D                 ; char
E471 39               (    forth6809.asm):03543                     RTS
                      (    forth6809.asm):03544         
                      (    forth6809.asm):03545         ; ------------------------------------------------------------
                      (    forth6809.asm):03546         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03547         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03548         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03549         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03550         ;    Inputs:
                      (    forth6809.asm):03551         ;        none
                      (    forth6809.asm):03552         ;    Outputs:
                      (    forth6809.asm):03553         ;        XON or XOFF transmitted
                      (    forth6809.asm):03554         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03555         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03556         ; ------------------------------------------------------------
E472 8613             (    forth6809.asm):03557         PUTXOFF:    LDA   #XOFFCH
E474 2002             (    forth6809.asm):03558                     BRA   PUTXCH
E476 8611             (    forth6809.asm):03559         PUTXON:     LDA   #XONCH
E478 3402             (    forth6809.asm):03560         PUTXCH:     PSHS  A
E47A F6C008           (    forth6809.asm):03561         PXWT:       LDB   ACIASR
E47D C502             (    forth6809.asm):03562                     BITB  #SR_TDRE
E47F 27F9             (    forth6809.asm):03563                     BEQ   PXWT
E481 3502             (    forth6809.asm):03564                     PULS  A
E483 B7C009           (    forth6809.asm):03565                     STA   ACIADR
E486 39               (    forth6809.asm):03566                     RTS
                      (    forth6809.asm):03567         

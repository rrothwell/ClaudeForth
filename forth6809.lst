FCD1 EC84             (    forth6809.asm):06597         ENVLOOP:  LDD  ,X
FCD3 10830000         (    forth6809.asm):06598                   CMPD #0
FCD7 272B             (    forth6809.asm):06599                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):06600                                     ; the double-cell table (below) before
                      (    forth6809.asm):06601                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):06602                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):06603                                     ; turn - both are double-cell values per
                      (    forth6809.asm):06604                                     ; their own ANS data type, which this
                      (    forth6809.asm):06605                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):06606                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):06607                                     ; represent correctly.
FCD9 3410             (    forth6809.asm):06608                   PSHS X          ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):06609                                     ; internal scratch (LDX CMPA1, then LDA
                      (    forth6809.asm):06610                                     ; ,X+ advancing through the comparison),
                      (    forth6809.asm):06611                                     ; clobbering whatever the caller had there.
                      (    forth6809.asm):06612                                     ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):06613                                     ; current table entry after COMPAREW
                      (    forth6809.asm):06614                                     ; returns, both for ENVFOUND's own LDD 4,X
                      (    forth6809.asm):06615                                     ; and for advancing to the next entry -
                      (    forth6809.asm):06616                                     ; without saving it first, a successful
                      (    forth6809.asm):06617                                     ; match left X sitting just past the
                      (    forth6809.asm):06618                                     ; matched string's own text (for
                      (    forth6809.asm):06619                                     ; "/COUNTED-STRING", 15 characters, that
                      (    forth6809.asm):06620                                     ; lands exactly at the start of the next
                      (    forth6809.asm):06621                                     ; entry's string, "MAX-N") - so ENVFOUND
                      (    forth6809.asm):06622                                     ; read the "value" field from inside the
                      (    forth6809.asm):06623                                     ; NEXT entry's own string text instead of
                      (    forth6809.asm):06624                                     ; the real value. Confirmed via MAME: this
                      (    forth6809.asm):06625                                     ; exact mechanism produces $4E4D precisely
                      (    forth6809.asm):06626                                     ; - the bytes 'N' ($4E) and 'M' ($4D, the
                      (    forth6809.asm):06627                                     ; start of "MAX-U") sitting 4 bytes into
                      (    forth6809.asm):06628                                     ; "MAX-N", read as one cell.

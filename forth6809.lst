                      (    forth6809.asm):00693                              ; GLOBALS page is now
                      (    forth6809.asm):00694                              ; fully packed bar 1: 255 of 256 bytes used, 1 free.
                      (    forth6809.asm):00695         
     00FF             (    forth6809.asm):00696         GLOBALS_USED EQU 255  ; total bytes used, of 256 available - nearly fully packed
                      (    forth6809.asm):00697         
                      (    forth6809.asm):00698         ; ------------------------------------------------------------
                      (    forth6809.asm):00699         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00700         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00701         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00702         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00703         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00704         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00705         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00706         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00707         ;
                      (    forth6809.asm):00708         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00709         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00710         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00711         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00712         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00713         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00714         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00715         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00716         ; FILLCNT/FILLADDR (formerly aliasing MVCNT/MVDST) were removed once
                      (    forth6809.asm):00717         ; genuinely unused - FILLW now keeps its count and address directly
                      (    forth6809.asm):00718         ; in Y/X rather than round-tripping through memory each iteration.
                      (    forth6809.asm):00719         ; ------------------------------------------------------------
                      (    forth6809.asm):00720                  ORG   $0100
0100                  (    forth6809.asm):00721         MVCNT    RMB   2
0102                  (    forth6809.asm):00722         MVDST    RMB   2
0104                  (    forth6809.asm):00723         MVSRC    RMB   2
     0100             (    forth6809.asm):00724         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00725         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00726         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00727         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00728         
                      (    forth6809.asm):00729         ; ------------------------------------------------------------
                      (    forth6809.asm):00730         ; Ring buffers for serial communications.
                      (    forth6809.asm):00731         ; One for input, one for output.
                      (    forth6809.asm):00732         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00733         ; The tricks are not used.
                      (    forth6809.asm):00734         ; ------------------------------------------------------------
                      (    forth6809.asm):00735                     ORG   SERBUFCTL    ; $176.
                      (    forth6809.asm):00736         
0176                  (    forth6809.asm):00737         INHEAD      RMB  1
0177                  (    forth6809.asm):00738         INTAIL      RMB  1
0178                  (    forth6809.asm):00739         INREQUEST   RMB  1  ; $00 = RTS Low (Clear), $FF = RTS High (Throttle) 
                      (    forth6809.asm):00740         
0179                  (    forth6809.asm):00741         OUTHEAD     RMB  1
017A                  (    forth6809.asm):00742         OUTTAIL     RMB  1
017B                  (    forth6809.asm):00743         OUTACTIVITY RMB  1  ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00744         
017C                  (    forth6809.asm):00745         FECOUNT     RMB  1  ; framing-error count, incremented by IRQH
017D                  (    forth6809.asm):00746         OVRNCOUNT   RMB  1  ; overrun count, incremented by IRQH
017E                  (    forth6809.asm):00747         PECOUNT     RMB  1  ; parity-error count, incremented by IRQH
                      (    forth6809.asm):00748         
017F                  (    forth6809.asm):00749         RTSSTATE   RMB   1  ; offset $FF - 0 = RTS low (normal), nonzero = RTS
                      (    forth6809.asm):00750                             ; high (paused) - see CR_RTSHI.
                      (    forth6809.asm):00751                               
                      (    forth6809.asm):00752                     ORG   SERBUF    ; $180, a 64 byte boundary.
                      (    forth6809.asm):00753         
                      (    forth6809.asm):00754                     ALIGN 64       ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00755         INBUF       RMB INBUFSZ     ; Receive circular queue buffer
                      (    forth6809.asm):00756         
                      (    forth6809.asm):00757                     ALIGN 64       ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00758         OUTBUF      RMB OUTBUFSZ    ; Transmit circular queue buffer
                      (    forth6809.asm):00759         
                      (    forth6809.asm):00760         ; ------------------------------------------------------------
                      (    forth6809.asm):00761         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00762         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00763         ; ------------------------------------------------------------
                      (    forth6809.asm):00764                  ORG USROMSTRT
                      (    forth6809.asm):00765         
                      (    forth6809.asm):00766                    IFNDEF UNITTESTS
C100                  (    forth6809.asm):00767         UNITTESTS SET 0   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00768                           ; Flag meaning reversed from this file's original
                      (    forth6809.asm):00769                           ; UNITTESTS convention (0=included,1=excluded under
                      (    forth6809.asm):00770                           ; IFEQ) to support overriding via lwasm's -D command
                      (    forth6809.asm):00771                           ; line option: default (0, no -D given) now means
                      (    forth6809.asm):00772                           ; EXCLUDED - production builds get plain FILL
                      (    forth6809.asm):00773                           ; padding here with no test-framework code, by
                      (    forth6809.asm):00774                           ; default. Pass -DUNITTESTS=1 (or any nonzero value)
                      (    forth6809.asm):00775                           ; to INCLUDE the test framework - tested and
                      (    forth6809.asm):00776                           ; confirmed working on real MAME hardware under the
                      (    forth6809.asm):00777                           ; old convention; this reversal only changes how the
                      (    forth6809.asm):00778                           ; choice is made, not what including it does.
                      (    forth6809.asm):00779                    ENDC
                      (    forth6809.asm):00780         
                      (    forth6809.asm):00781                    IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00782         TSTSELECTOR SET 2   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00783                    ENDC
                      (    forth6809.asm):00784         
                      (    forth6809.asm):00785                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):00786         
                      (    forth6809.asm):00787         ; ------------------------------------------------------------
                      (    forth6809.asm):00788         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00789         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00790         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00791         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00792         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00793         ; ------------------------------------------------------------
                      (    forth6809.asm):00794                  INCLUDE unit_tests.asm
                      (    forth6809.asm):00795         
                      (    forth6809.asm):00796                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):00797         
C100                  (    forth6809.asm):00798         ROM:
C100 FFFFFFFFFFFFFFFF (    forth6809.asm):00799                  FILL $FF,BASEDICT-ROM

                      (    forth6809.asm):07011         ; TSTPLOOP - unit test for DO/+LOOP. Compiles
                      (    forth6809.asm):07012         ; "DO I + 3 LITERAL +LOOP", run with limit=10, start=0 - a step
                      (    forth6809.asm):07013         ; (3) that doesn't land exactly on the limit, deliberately
                      (    forth6809.asm):07014         ; exercising the crossing-boundary exit condition rather than
                      (    forth6809.asm):07015         ; landing-exactly-on-it, since those are handled by genuinely
                      (    forth6809.asm):07016         ; different checks in DOPLUSTEST (confirmed by reading its own
                      (    forth6809.asm):07017         ; code - crosses-sign OR lands-exactly, checked separately).
                      (    forth6809.asm):07018         ; Visits I=0,3,6,9, exits when 9+3=12 crosses past 10. Sum=18.
                      (    forth6809.asm):07019         ; ------------------------------------------------------------

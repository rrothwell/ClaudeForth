F592                  (    forth6809.asm):21612         SQINTERP: ; REDESIGN: was a fixed "LDX #SIBUF" here and at SQIEND -
                      (    forth6809.asm):21613                                   ; SIBUF was a dedicated, fixed 32-byte buffer,
                      (    forth6809.asm):21614                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):21615                                   ; characters and (worse) shared identically
                      (    forth6809.asm):21616                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):21617                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):21618                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):21619                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):21620                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):21621                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):21622                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):21623                                   ; testing/design decision: rather than give
                      (    forth6809.asm):21624                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):21625                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):21626                                   ; definition for stable storage instead - but
                      (    forth6809.asm):21627                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):21628                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):21629                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):21630                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):21631                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):21632                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):21633                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):21634                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):21635                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):21636                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):21637                                   ; the GLOBALS layout notes above).
F592 BDE09B           (    forth6809.asm):21638                   JSR  PADW
F595 3710             (    forth6809.asm):21639                   PULU X
F597 9F2F             (    forth6809.asm):21640                   STX  MSCR4        ; save PAD's own address - X gets advanced
                      (    forth6809.asm):21641                                      ; by the copy loop below, need the
                      (    forth6809.asm):21642                                      ; original back for the return value

F521 1F02             (    forth6809.asm):05389                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):05390                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):05391                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):05392                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):05393                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):05394                                   ; The high byte took on the fill character's
                      (    forth6809.asm):05395                                   ; value instead of the count's real high
                      (    forth6809.asm):05396                                   ; byte, so the count almost never reached
                      (    forth6809.asm):05397                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):05398                                   ; past the requested length. Keeping the
                      (    forth6809.asm):05399                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):05400                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):05401                                   ; fill character into A) and removes the
                      (    forth6809.asm):05402                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):05403                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):05404                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):05405                                   ; MAME debugger.

                      (    forth6809.asm):05954                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):05955                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):05956                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):05957                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):05958                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):05959                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):05960                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):05961                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):05962                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):05963                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):05964                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):05965                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):05966                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):05967                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):05968                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):05969                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):05970                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):05971                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):05972                    ; wrong algorithm entirely, not a smaller bug within it.
F978 DCA9             (    forth6809.asm):05973         UELOOP:    LDD  UESRCLEN
F97A 2715             (    forth6809.asm):05974                    BEQ  UEDONE
F97C A680             (    forth6809.asm):05975                    LDA  ,X+
F97E 8125             (    forth6809.asm):05976                    CMPA #'%'
F980 2604             (    forth6809.asm):05977                    BNE  UENOTPCT
F982 C625             (    forth6809.asm):05978                    LDB  #'%'      ; write the extra '%' first - the character
F984 E7A0             (    forth6809.asm):05979                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):05980                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):05981                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):05982                                   ; the same string correctly, since this runs
                      (    forth6809.asm):05983                                   ; independently for each one the loop visits.
F986 A7A0             (    forth6809.asm):05984         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):05985                                   ; every character, '%' or not
F988 DCA9             (    forth6809.asm):05986                    LDD  UESRCLEN
F98A 830001           (    forth6809.asm):05987                    SUBD #1
F98D DDA9             (    forth6809.asm):05988                    STD  UESRCLEN
F98F 20E7             (    forth6809.asm):05989                    BRA  UELOOP
F991 1F20             (    forth6809.asm):05990         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F993 93AB             (    forth6809.asm):05991                    SUBD UEDST     ; overwriting whatever was left on top of
F995 DDAD             (    forth6809.asm):05992                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):05993                                   ; required return values, and separately,
                      (    forth6809.asm):05994                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):05995                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):05996                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):05997                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):05998                                   ; characters. Now computed directly as the
                      (    forth6809.asm):05999                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06000                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06001                                   ; correct regardless of how many characters
                      (    forth6809.asm):06002                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06003                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06004                                   ; incremented alongside it.
F997 DCAB             (    forth6809.asm):06005                    LDD  UEDST
F999 3606             (    forth6809.asm):06006                    PSHU D         ; push c-addr2 (destination address)
F99B DCAD             (    forth6809.asm):06007                    LDD  UEOUTLEN
F99D 3606             (    forth6809.asm):06008                    PSHU D         ; push u2 (actual unescaped length)
F99F 39               (    forth6809.asm):06009                    RTS

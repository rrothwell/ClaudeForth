                      (    forth6809.asm):01819                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01820                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01821                                        ; now H_FALSE, the chain's newest entry
DE30 DF4B             (    forth6809.asm):01822                  FDB   ABORT
                      (    forth6809.asm):01823         

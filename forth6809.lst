D95B 3606             (    forth6809.asm):04563                     PSHU  D
D95D 39               (    forth6809.asm):04564                     RTS
D95E CC0087           (    forth6809.asm):04565         KEYVW:      LDD   #KEYV
D961 3606             (    forth6809.asm):04566                     PSHU  D
D963 39               (    forth6809.asm):04567                     RTS
D964 CC0089           (    forth6809.asm):04568         KEYQVW:     LDD   #KEYQV
D967 3606             (    forth6809.asm):04569                     PSHU  D
D969 39               (    forth6809.asm):04570                     RTS
                      (    forth6809.asm):04571         

D93B 3606             (    forth6809.asm):04431                     PSHU  D                 ; flag = true
D93D 39               (    forth6809.asm):04432                     RTS
                      (    forth6809.asm):04433         
                      (    forth6809.asm):04434         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04435         
                      (    forth6809.asm):04436         ; ------------------------------------------------------------
                      (    forth6809.asm):04437         ; EMIT  ( char -- )

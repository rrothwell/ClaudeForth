FCD1 EC84             (    forth6809.asm):12794         ENVLOOP:  LDD  ,X
FCD3 10830000         (    forth6809.asm):12795                   CMPD #0
FCD7 272B             (    forth6809.asm):12796                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):12797                                     ; the double-cell table (below) before
                      (    forth6809.asm):12798                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):12799                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):12800                                     ; turn - both are double-cell values per
                      (    forth6809.asm):12801                                     ; their own ANS data type, which this
                      (    forth6809.asm):12802                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):12803                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):12804                                     ; represent correctly.
FCD9 3410             (    forth6809.asm):12805                   PSHS X          ; BUG FIX: COMPAREW uses X as its own
                      (    forth6809.asm):12806                                     ; internal scratch (LDX CMPA1, then LDA
                      (    forth6809.asm):12807                                     ; ,X+ advancing through the comparison),
                      (    forth6809.asm):12808                                     ; clobbering whatever the caller had there.
                      (    forth6809.asm):12809                                     ; ENVQUERY needs X to still point at the
                      (    forth6809.asm):12810                                     ; current table entry after COMPAREW
                      (    forth6809.asm):12811                                     ; returns, both for ENVFOUND's own LDD 4,X
                      (    forth6809.asm):12812                                     ; and for advancing to the next entry -
                      (    forth6809.asm):12813                                     ; without saving it first, a successful
                      (    forth6809.asm):12814                                     ; match left X sitting just past the
                      (    forth6809.asm):12815                                     ; matched string's own text (for
                      (    forth6809.asm):12816                                     ; "/COUNTED-STRING", 15 characters, that
                      (    forth6809.asm):12817                                     ; lands exactly at the start of the next
                      (    forth6809.asm):12818                                     ; entry's string, "MAX-N") - so ENVFOUND
                      (    forth6809.asm):12819                                     ; read the "value" field from inside the
                      (    forth6809.asm):12820                                     ; NEXT entry's own string text instead of
                      (    forth6809.asm):12821                                     ; the real value. Confirmed via MAME: this
                      (    forth6809.asm):12822                                     ; exact mechanism produces $4E4D precisely
                      (    forth6809.asm):12823                                     ; - the bytes 'N' ($4E) and 'M' ($4D, the
                      (    forth6809.asm):12824                                     ; start of "MAX-U") sitting 4 bytes into
                      (    forth6809.asm):12825                                     ; "MAX-N", read as one cell.

                      (    forth6809.asm):07823         ; ------------------------------------------------------------
                      (    forth6809.asm):07824         ; TRUE  ( -- flag )
                      (    forth6809.asm):07825         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):07826         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):07827         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):07828         ; ------------------------------------------------------------

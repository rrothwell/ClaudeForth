                      (    forth6809.asm):09864         ; TSTCOMPCOMMA - unit test for COMPILE,. Compiles a call to
                      (    forth6809.asm):09865         ; DUP's own xt into scratch, then executes the result with a
                      (    forth6809.asm):09866         ; known value to confirm it genuinely behaves like DUP - not
                      (    forth6809.asm):09867         ; just that some bytes were written.
                      (    forth6809.asm):09868         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):09869         TSTCOMPCOMMA: LDD  CODEHERE
                      (    forth6809.asm):09870                       STD  TSTCSAV
                      (    forth6809.asm):09871         
                      (    forth6809.asm):09872                       LDD  #TSTCBUF
                      (    forth6809.asm):09873                       STD  CODEHERE
                      (    forth6809.asm):09874         
                      (    forth6809.asm):09875                       LDD  #DUP
                      (    forth6809.asm):09876                       PSHU D
                      (    forth6809.asm):09877                       JSR  COMPILECOMMA
                      (    forth6809.asm):09878         
                      (    forth6809.asm):09879                       LDD  #OPRTS
                      (    forth6809.asm):09880                       PSHU D
                      (    forth6809.asm):09881                       JSR  CCOMMA
                      (    forth6809.asm):09882         
                      (    forth6809.asm):09883                       LDD  TSTCSAV
                      (    forth6809.asm):09884                       STD  CODEHERE
                      (    forth6809.asm):09885         
                      (    forth6809.asm):09886                       STU  TSTU0
                      (    forth6809.asm):09887         
                      (    forth6809.asm):09888                       LDD  #TSTGUARD
                      (    forth6809.asm):09889                       PSHU D
                      (    forth6809.asm):09890                       LDD  #TSTVAL1
                      (    forth6809.asm):09891                       PSHU D
                      (    forth6809.asm):09892                       STU  TSTUB4
                      (    forth6809.asm):09893         
                      (    forth6809.asm):09894                       LDX  #TSTCBUF
                      (    forth6809.asm):09895                       JSR  ,X
                      (    forth6809.asm):09896         
                      (    forth6809.asm):09897                       STU  TSTUAF
                      (    forth6809.asm):09898         
                      (    forth6809.asm):09899                       PULU D
                      (    forth6809.asm):09900                       CMPD #TSTVAL1
                      (    forth6809.asm):09901                       BNE  CCFAIL
                      (    forth6809.asm):09902                       PULU D
                      (    forth6809.asm):09903                       CMPD #TSTVAL1
                      (    forth6809.asm):09904                       BNE  CCFAIL
                      (    forth6809.asm):09905                       PULU D
                      (    forth6809.asm):09906                       CMPD #TSTGUARD
                      (    forth6809.asm):09907                       BNE  CCFAIL
                      (    forth6809.asm):09908         
                      (    forth6809.asm):09909                       LDD  TSTUB4
                      (    forth6809.asm):09910                       SUBD TSTUAF
                      (    forth6809.asm):09911                       CMPD #2
                      (    forth6809.asm):09912                       BNE  CCFAIL
                      (    forth6809.asm):09913         
                      (    forth6809.asm):09914                       LDD  #TRUEV
                      (    forth6809.asm):09915                       BRA  CCDONE
C26F                  (    forth6809.asm):09916         CCFAIL:       LDD  #FALSEV
C26F                  (    forth6809.asm):09917         CCDONE:       LDX  #TSTCCNAME
                      (    forth6809.asm):09918                       PSHU X
                      (    forth6809.asm):09919                       PSHU D
                      (    forth6809.asm):09920                       JSR  TSTREPORT
                      (    forth6809.asm):09921         
                      (    forth6809.asm):09922                       LDU  TSTU0
                      (    forth6809.asm):09923                       RTS
                      (    forth6809.asm):09924         

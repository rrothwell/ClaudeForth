     0003             (   unit_tests.asm):00256         TSTOKMSGL   EQU   *-TSTOKMSG
C130 204641494C       (   unit_tests.asm):00257         TSTFAILMSG: FCC   " FAIL"
     0005             (   unit_tests.asm):00258         TSTFAILMSGL EQU   *-TSTFAILMSG
                      (   unit_tests.asm):00259         

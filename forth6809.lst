F430 7EF415           (    forth6809.asm):06470                     JMP   FILLW
                      (    forth6809.asm):06471         
                      (    forth6809.asm):06472         ; ------------------------------------------------------------
                      (    forth6809.asm):06473         ; BLANK  ( c-addr u -- )
                      (    forth6809.asm):06474         ; Store a space in each of u bytes starting at c-addr.
                      (    forth6809.asm):06475         ; ------------------------------------------------------------
F433 CC0020           (    forth6809.asm):06476         BLANKW:     LDD   #32

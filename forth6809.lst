                      (    forth6809.asm):08526         ; TSTISOF - unit test for IS and ACTION-OF together. Compiles
                      (    forth6809.asm):08527         ; "DEFER TESTWD", interprets "DUP IS TESTWD" directly (IS parses
                      (    forth6809.asm):08528         ; "TESTWD" via WORD+FIND, needing LATEST still pointed at it -
                      (    forth6809.asm):08529         ; not restored until this whole test finishes), executes TESTWD
                      (    forth6809.asm):08530         ; (should now behave like DUP), then interprets "ACTION-OF
                      (    forth6809.asm):08531         ; TESTWD" to fetch the current target by name and confirms it
                      (    forth6809.asm):08532         ; matches DUP's own xt. Explicitly forces STATE=0 before both IS
                      (    forth6809.asm):08533         ; and ACTION-OF, since both are documented to behave differently
                      (    forth6809.asm):08534         ; by STATE, same reasoning as TSTVALTO's own TO test.
                      (    forth6809.asm):08535         ; ------------------------------------------------------------
C3E3                  (    forth6809.asm):08536         TSTISOF: LDD   CODEHERE
                      (    forth6809.asm):08537                  STD   TSTCSAV
                      (    forth6809.asm):08538                  LDD   DPHERE
                      (    forth6809.asm):08539                  STD   TSTDSAV
                      (    forth6809.asm):08540                  LDD   VARHERE
                      (    forth6809.asm):08541                  STD   TSTVSAV
                      (    forth6809.asm):08542                  LDD   SRCADDR
                      (    forth6809.asm):08543                  STD   TSTSASAV
                      (    forth6809.asm):08544                  LDD   SRCLEN
                      (    forth6809.asm):08545                  STD   TSTSLSAV
                      (    forth6809.asm):08546                  LDD   TOIN
                      (    forth6809.asm):08547                  STD   TSTTISAV

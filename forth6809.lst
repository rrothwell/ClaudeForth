                      (    forth6809.asm):05090         ; ------------------------------------------------------------
                      (    forth6809.asm):05091         ; Unsigned 16-bit division by shift and subtract. The divisor is not
                      (    forth6809.asm):05092         ; checked for zero.
                      (    forth6809.asm):05093         ; UDIV16
                      (    forth6809.asm):05094         ;    Inputs:
                      (    forth6809.asm):05095         ;        DIVNUM = dividend, DIVDEN = divisor (unsigned)
                      (    forth6809.asm):05096         ;    Outputs:
                      (    forth6809.asm):05097         ;        DIVNUM = quotient, DIVREM = remainder
                      (    forth6809.asm):05098         ;    Registers: RegD changed; DIVCNT used as the loop counter.
                      (    forth6809.asm):05099         ; ------------------------------------------------------------
ECCB 0F2C             (    forth6809.asm):05100         UDIV16:     CLR   DIVREM
ECCD 0F2D             (    forth6809.asm):05101                     CLR   DIVREM+1
ECCF C610             (    forth6809.asm):05102                     LDB   #16
ECD1 D72E             (    forth6809.asm):05103                     STB   DIVCNT
ECD3 0829             (    forth6809.asm):05104         UD16LOOP:   ASL   DIVNUM+1
ECD5 0928             (    forth6809.asm):05105                     ROL   DIVNUM
ECD7 092D             (    forth6809.asm):05106                     ROL   DIVREM+1
ECD9 092C             (    forth6809.asm):05107                     ROL   DIVREM
ECDB DC2C             (    forth6809.asm):05108                     LDD   DIVREM
ECDD 932A             (    forth6809.asm):05109                     SUBD  DIVDEN
ECDF 2504             (    forth6809.asm):05110                     BLO   UDSKIP
ECE1 DD2C             (    forth6809.asm):05111                     STD   DIVREM
ECE3 0C29             (    forth6809.asm):05112                     INC   DIVNUM+1
ECE5 0A2E             (    forth6809.asm):05113         UDSKIP:     DEC   DIVCNT
ECE7 26EA             (    forth6809.asm):05114                     BNE   UD16LOOP

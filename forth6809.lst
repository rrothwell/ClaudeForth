E498 3606             (    forth6809.asm):03181                     PSHU  D                 ; ud2 low
E49A DC46             (    forth6809.asm):03182                     LDD   UDHI
E49C 3606             (    forth6809.asm):03183                     PSHU  D                 ; ud2 high
E49E 9E18             (    forth6809.asm):03184                     LDX   NADDR
E4A0 3610             (    forth6809.asm):03185                     PSHU  X                 ; c-addr2
E4A2 DC1A             (    forth6809.asm):03186                     LDD   NCNT
E4A4 3606             (    forth6809.asm):03187                     PSHU  D                 ; u2
E4A6 39               (    forth6809.asm):03188                     RTS
                      (    forth6809.asm):03189         
                      (    forth6809.asm):03190         ; ------------------------------------------------------------
                      (    forth6809.asm):03191         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03192         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03193         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03194         ;    Inputs:
                      (    forth6809.asm):03195         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03196         ;    Outputs:
                      (    forth6809.asm):03197         ;        single number: n and -1
                      (    forth6809.asm):03198         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03199         ;        not a number: c-addr and 0
                      (    forth6809.asm):03200         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03201         ; ------------------------------------------------------------
E4A7 3710             (    forth6809.asm):03202         NUMBERQ:    PULU  X                 ; c-addr
E4A9 9F14             (    forth6809.asm):03203                     STX   CADDR
E4AB A684             (    forth6809.asm):03204                     LDA   ,X
E4AD 2772             (    forth6809.asm):03205                     BEQ   NQBAD
E4AF 9716             (    forth6809.asm):03206                     STA   CNTREM
E4B1 3001             (    forth6809.asm):03207                     LEAX  1,X
                      (    forth6809.asm):03208         
                      (    forth6809.asm):03209                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03210                     ; digit count. See shadow: NUMBERQ.1
E4B3 D616             (    forth6809.asm):03211                     LDB   CNTREM
E4B5 5A               (    forth6809.asm):03212                     DECB
E4B6 A685             (    forth6809.asm):03213                     LDA   B,X
E4B8 812E             (    forth6809.asm):03214                     CMPA  #'.'
E4BA 2604             (    forth6809.asm):03215                     BNE   NQNOSIGN
E4BC 0A16             (    forth6809.asm):03216                     DEC   CNTREM
E4BE 2761             (    forth6809.asm):03217                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03218         
E4C0 0F17             (    forth6809.asm):03219         NQNOSIGN:   CLR   NUMNEG
E4C2 A684             (    forth6809.asm):03220                     LDA   ,X
E4C4 812D             (    forth6809.asm):03221                     CMPA  #'-'
E4C6 2608             (    forth6809.asm):03222                     BNE   NQNOSIGN2
E4C8 0317             (    forth6809.asm):03223                     COM   NUMNEG
E4CA 3001             (    forth6809.asm):03224                     LEAX  1,X
E4CC 0A16             (    forth6809.asm):03225                     DEC   CNTREM
E4CE 2751             (    forth6809.asm):03226                     BEQ   NQBAD
                      (    forth6809.asm):03227         
E4D0 9F18             (    forth6809.asm):03228         NQNOSIGN2:  STX   NADDR
E4D2 4F               (    forth6809.asm):03229                     CLRA
E4D3 D616             (    forth6809.asm):03230                     LDB   CNTREM
E4D5 DD1A             (    forth6809.asm):03231                     STD   NCNT
E4D7 CC0000           (    forth6809.asm):03232                     LDD   #0
E4DA DD46             (    forth6809.asm):03233                     STD   UDHI
E4DC DD48             (    forth6809.asm):03234                     STD   UDLO
                      (    forth6809.asm):03235         
E4DE BDE44A           (    forth6809.asm):03236                     JSR   NUMLOOP
                      (    forth6809.asm):03237         
E4E1 DC1A             (    forth6809.asm):03238                     LDD   NCNT
E4E3 263C             (    forth6809.asm):03239                     BNE   NQBAD
                      (    forth6809.asm):03240         
                      (    forth6809.asm):03241                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E4E5 0D17             (    forth6809.asm):03242                     TST   NUMNEG
E4E7 2713             (    forth6809.asm):03243                     BEQ   NQPOS32
E4E9 DC48             (    forth6809.asm):03244                     LDD   UDLO
E4EB DD31             (    forth6809.asm):03245                     STD   PRODLO
E4ED DC46             (    forth6809.asm):03246                     LDD   UDHI
E4EF DD2F             (    forth6809.asm):03247                     STD   PRODHI
E4F1 BDEE28           (    forth6809.asm):03248                     JSR   MNEG32            ; shared negate. See bugfix: NUMBERQ.5
E4F4 DC31             (    forth6809.asm):03249                     LDD   PRODLO
E4F6 DD48             (    forth6809.asm):03250                     STD   UDLO
E4F8 DC2F             (    forth6809.asm):03251                     LDD   PRODHI
E4FA DD46             (    forth6809.asm):03252                     STD   UDHI
                      (    forth6809.asm):03253         
E4FC                  (    forth6809.asm):03254         NQPOS32:                            ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03255                     ; was '.' - determines which return convention to use
E4FC 9E14             (    forth6809.asm):03256                     LDX   CADDR
E4FE E684             (    forth6809.asm):03257                     LDB   ,X
E500 5A               (    forth6809.asm):03258                     DECB
E501 3001             (    forth6809.asm):03259                     LEAX  1,X
E503 A685             (    forth6809.asm):03260                     LDA   B,X
E505 812E             (    forth6809.asm):03261                     CMPA  #'.'

                      (    forth6809.asm):04707         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04708         ; location.
                      (    forth6809.asm):04709         ; PATCH   ( target location -- )
                      (    forth6809.asm):04710         ;    Inputs:
                      (    forth6809.asm):04711         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04712         ;    Outputs:
                      (    forth6809.asm):04713         ;        the cell at location holds target - location
                      (    forth6809.asm):04714         ;    Registers: RegD and RegX changed.

                      (    forth6809.asm):03331         ; ============================================================
                      (    forth6809.asm):03332         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03333         ; ============================================================
                      (    forth6809.asm):03334                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03335         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03336         
                      (    forth6809.asm):03337         ; ------------------------------------------------------------
                      (    forth6809.asm):03338         ; KEY  ( -- char )
                      (    forth6809.asm):03339         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03340         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03341         ; ------------------------------------------------------------
E54E                  (    forth6809.asm):03342         KEYW:
                      (    forth6809.asm):03343         
E54E 7D0178           (    forth6809.asm):03344                     TST   RTSSTATE          ; Is throttling?
E551 2703             (    forth6809.asm):03345                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03346         
                      (    forth6809.asm):03347                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
E553 BDDD52           (    forth6809.asm):03348                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03349                                             ; by transmitting all chars.
                      (    forth6809.asm):03350         
E556                  (    forth6809.asm):03351         TRY_READ:
E556 BDDDBF           (    forth6809.asm):03352                     JSR   GETCHAR           ; Is char available in input buffer.
E559 25F3             (    forth6809.asm):03353                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03354                                             ; while still transmitting!
                      (    forth6809.asm):03355         
E55B 1F89             (    forth6809.asm):03356                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E55D 4F               (    forth6809.asm):03357                     CLRA                    ; Clear MSB.
E55E 3606             (    forth6809.asm):03358                     PSHU  D                 ; char
                      (    forth6809.asm):03359         
E560 39               (    forth6809.asm):03360                     RTS
                      (    forth6809.asm):03361         
                      (    forth6809.asm):03362         ; ------------------------------------------------------------
                      (    forth6809.asm):03363         ; KEY?  ( -- flag )
                      (    forth6809.asm):03364         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03365         ; ------------------------------------------------------------
E561                  (    forth6809.asm):03366         KEYQW:
                      (    forth6809.asm):03367                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03368         
E561 B60176           (    forth6809.asm):03369                     LDA   INHEAD            ; Characters received?
E564 B10177           (    forth6809.asm):03370                     CMPA  INTAIL
                      (    forth6809.asm):03371         
                      (    forth6809.asm):03372                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03373         
E567 2606             (    forth6809.asm):03374                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03375         
E569 CC0000           (    forth6809.asm):03376                     LDD   #FALSEV           ; No! Return false result.
E56C 3606             (    forth6809.asm):03377                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03378         
E56E 39               (    forth6809.asm):03379                     RTS
                      (    forth6809.asm):03380         
E56F                  (    forth6809.asm):03381         KQTRUE:
E56F CCFFFF           (    forth6809.asm):03382                     LDD   #TRUEV            ; Yes! Return true result.
E572 3606             (    forth6809.asm):03383                     PSHU  D                 ; flag = true
E574 39               (    forth6809.asm):03384                     RTS
                      (    forth6809.asm):03385         
                      (    forth6809.asm):03386         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03387         
                      (    forth6809.asm):03388         ; ------------------------------------------------------------
                      (    forth6809.asm):03389         ; EMIT  ( char -- )
                      (    forth6809.asm):03390         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03391         ; discarded if the ring is full.
                      (    forth6809.asm):03392         ; ------------------------------------------------------------
E575                  (    forth6809.asm):03393         EMITW:
E575 3706             (    forth6809.asm):03394                     PULU  D                 ; char
E577 1F98             (    forth6809.asm):03395                     TFR   B,A
E579 BDDD74           (    forth6809.asm):03396                     JSR   PUTCHAR           ; Transmit char.
E57C 39               (    forth6809.asm):03397                     RTS
                      (    forth6809.asm):03398         
                      (    forth6809.asm):03399                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03400         ; ------------------------------------------------------------
                      (    forth6809.asm):03401         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03402         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03403         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03404         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03405         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03406         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03407         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03408         ; follow.
                      (    forth6809.asm):03409         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03410         KEYW:
                      (    forth6809.asm):03411                     LDA   ACIASR
                      (    forth6809.asm):03412                     BITA  #SR_RDRF
                      (    forth6809.asm):03413                     BEQ   KWAIT
                      (    forth6809.asm):03414                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03415                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E57D                  (    forth6809.asm):03416         KWAIT:
E57D                  (    forth6809.asm):03417         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03418                     BITA  #SR_RDRF
                      (    forth6809.asm):03419                     BEQ   KSPIN
E57D                  (    forth6809.asm):03420         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03421                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03422                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03423                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03424                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03425                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03426                     BEQ   KGETCH
                      (    forth6809.asm):03427                     BITA  #SR_FE
                      (    forth6809.asm):03428                     BEQ   KXFE
                      (    forth6809.asm):03429                     INC   FECOUNT
E57D                  (    forth6809.asm):03430         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03431                     BEQ   KXOVRN
                      (    forth6809.asm):03432                     INC   OVRNCOUNT
E57D                  (    forth6809.asm):03433         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03434                     BEQ   KGETCH
                      (    forth6809.asm):03435                     INC   PECOUNT
E57D                  (    forth6809.asm):03436         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03437                     TFR   A,B
                      (    forth6809.asm):03438                     CLRA
                      (    forth6809.asm):03439                     PSHU  D                 ; char
                      (    forth6809.asm):03440                     RTS
                      (    forth6809.asm):03441         
                      (    forth6809.asm):03442         ; ------------------------------------------------------------
                      (    forth6809.asm):03443         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03444         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03445         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03446         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03447         ;    Inputs:
                      (    forth6809.asm):03448         ;        none
                      (    forth6809.asm):03449         ;    Outputs:
                      (    forth6809.asm):03450         ;        XON or XOFF transmitted
                      (    forth6809.asm):03451         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03452         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03453         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03454         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03455                     BRA   PUTXCH
E57D                  (    forth6809.asm):03456         PUTXON:     LDA   #XONCH
E57D                  (    forth6809.asm):03457         PUTXCH:     PSHS  A
E57D                  (    forth6809.asm):03458         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03459                     BITB  #SR_TDRE
                      (    forth6809.asm):03460                     BEQ   PXWT
                      (    forth6809.asm):03461                     PULS  A
                      (    forth6809.asm):03462                     STA   ACIADR
                      (    forth6809.asm):03463                     RTS
                      (    forth6809.asm):03464         
                      (    forth6809.asm):03465         ; ------------------------------------------------------------
                      (    forth6809.asm):03466         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03467         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03468         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03469         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03470                     BITA  #SR_RDRF
                      (    forth6809.asm):03471                     BEQ   KQFALSE
                      (    forth6809.asm):03472                     LDD   #TRUEV
                      (    forth6809.asm):03473                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03474                     RTS
E57D                  (    forth6809.asm):03475         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03476                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03477                     RTS
                      (    forth6809.asm):03478         
                      (    forth6809.asm):03479         ; ------------------------------------------------------------
                      (    forth6809.asm):03480         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03481         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03482         ; ------------------------------------------------------------
E57D                  (    forth6809.asm):03483         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03484                     STB   EMITCH
E57D                  (    forth6809.asm):03485         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03486                     BITA  #SR_TDRE
                      (    forth6809.asm):03487                     BEQ   EMITWT
                      (    forth6809.asm):03488                     LDA   EMITCH
                      (    forth6809.asm):03489                     STA   ACIADR
                      (    forth6809.asm):03490                     RTS
                      (    forth6809.asm):03491         
                      (    forth6809.asm):03492                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03493         
                      (    forth6809.asm):03494         ; ------------------------------------------------------------
                      (    forth6809.asm):03495         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03496         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03497         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03498         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03499         ; ------------------------------------------------------------
E57D 335E             (    forth6809.asm):03500         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E57F CC0000           (    forth6809.asm):03501                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E582 EDC4             (    forth6809.asm):03502                     STD   ,U
                      (    forth6809.asm):03503         
                      (    forth6809.asm):03504                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03505                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03506                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03507                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03508                                             ; stream this line's characters
                      (    forth6809.asm):03509                     JSR   PUTXON
                      (    forth6809.asm):03510                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03511         
E584 BDE54E           (    forth6809.asm):03512         ALOOP:      JSR   KEYW
E587 3706             (    forth6809.asm):03513                     PULU  D
E589 1F02             (    forth6809.asm):03514                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03515         
E58B C10D             (    forth6809.asm):03516                     CMPB  #13
E58D 274F             (    forth6809.asm):03517                     BEQ   ADONE
E58F C10A             (    forth6809.asm):03518                     CMPB  #10
E591 27F1             (    forth6809.asm):03519                     BEQ   ALOOP
E593 C108             (    forth6809.asm):03520                     CMPB  #8
E595 2724             (    forth6809.asm):03521                     BEQ   ABKSP
E597 C17F             (    forth6809.asm):03522                     CMPB  #127
E599 2720             (    forth6809.asm):03523                     BEQ   ABKSP
                      (    forth6809.asm):03524         
E59B ECC4             (    forth6809.asm):03525                     LDD   ,U
E59D 10A342           (    forth6809.asm):03526                     CMPD  2,U
E5A0 27E2             (    forth6809.asm):03527                     BEQ   ALOOP
                      (    forth6809.asm):03528         
E5A2 AE44             (    forth6809.asm):03529                     LDX   4,U
E5A4 308B             (    forth6809.asm):03530                     LEAX  D,X
E5A6 1F20             (    forth6809.asm):03531                     TFR   Y,D
E5A8 E784             (    forth6809.asm):03532                     STB   ,X
E5AA ECC4             (    forth6809.asm):03533                     LDD   ,U
E5AC C30001           (    forth6809.asm):03534                     ADDD  #1
E5AF EDC4             (    forth6809.asm):03535                     STD   ,U
                      (    forth6809.asm):03536         
E5B1 1F20             (    forth6809.asm):03537                     TFR   Y,D
E5B3 4F               (    forth6809.asm):03538                     CLRA
E5B4 3606             (    forth6809.asm):03539                     PSHU  D
E5B6 BDE575           (    forth6809.asm):03540                     JSR   EMITW
E5B9 20C9             (    forth6809.asm):03541                     BRA   ALOOP
                      (    forth6809.asm):03542         
E5BB ECC4             (    forth6809.asm):03543         ABKSP:      LDD   ,U
E5BD 27C5             (    forth6809.asm):03544                     BEQ   ALOOP
E5BF 830001           (    forth6809.asm):03545                     SUBD  #1
E5C2 EDC4             (    forth6809.asm):03546                     STD   ,U
E5C4 CC0008           (    forth6809.asm):03547                     LDD   #8
E5C7 3606             (    forth6809.asm):03548                     PSHU  D
E5C9 BDE575           (    forth6809.asm):03549                     JSR   EMITW
E5CC CC0020           (    forth6809.asm):03550                     LDD   #32
E5CF 3606             (    forth6809.asm):03551                     PSHU  D
E5D1 BDE575           (    forth6809.asm):03552                     JSR   EMITW
E5D4 CC0008           (    forth6809.asm):03553                     LDD   #8
E5D7 3606             (    forth6809.asm):03554                     PSHU  D
E5D9 BDE575           (    forth6809.asm):03555                     JSR   EMITW
E5DC 20A6             (    forth6809.asm):03556                     BRA   ALOOP
                      (    forth6809.asm):03557         
E5DE                  (    forth6809.asm):03558         ADONE:
                      (    forth6809.asm):03559                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03560                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03561                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03562                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03563                                             ; with KEY never polled at all
                      (    forth6809.asm):03564                     JSR   PUTXOFF
                      (    forth6809.asm):03565                     ENDC                    ; <<<<<<<<<<
E5DE ECC4             (    forth6809.asm):03566                     LDD   ,U
E5E0 ED44             (    forth6809.asm):03567                     STD   4,U               ; +n2
E5E2 3344             (    forth6809.asm):03568                     LEAU  4,U
E5E4 39               (    forth6809.asm):03569                     RTS
                      (    forth6809.asm):03570         
                      (    forth6809.asm):03571         ; ------------------------------------------------------------
                      (    forth6809.asm):03572         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03573         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03574         ; ------------------------------------------------------------
E5E5 BDE57D           (    forth6809.asm):03575         EXPECTW:    JSR   ACCEPTW
E5E8 3706             (    forth6809.asm):03576                     PULU  D
E5EA DD75             (    forth6809.asm):03577                     STD   SPAN
E5EC 39               (    forth6809.asm):03578                     RTS
                      (    forth6809.asm):03579         
                      (    forth6809.asm):03580         ; ------------------------------------------------------------
                      (    forth6809.asm):03581         ; QUERY  ( -- )
                      (    forth6809.asm):03582         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03583         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03584         ; to 0 and >IN to 0.
                      (    forth6809.asm):03585         ; ------------------------------------------------------------
E5ED 8E0106           (    forth6809.asm):03586         QUERYW:     LDX   #TIBBUF
E5F0 3610             (    forth6809.asm):03587                     PSHU  X
E5F2 CC0050           (    forth6809.asm):03588                     LDD   #TIBBUFL
E5F5 3606             (    forth6809.asm):03589                     PSHU  D
E5F7 BDE57D           (    forth6809.asm):03590                     JSR   ACCEPTW
E5FA 3706             (    forth6809.asm):03591                     PULU  D
E5FC DD12             (    forth6809.asm):03592                     STD   NTIB
E5FE DD71             (    forth6809.asm):03593                     STD   SRCLEN
E600 CC0106           (    forth6809.asm):03594                     LDD   #TIBBUF
E603 DD6F             (    forth6809.asm):03595                     STD   SRCADDR
E605 CC0000           (    forth6809.asm):03596                     LDD   #0
E608 DD73             (    forth6809.asm):03597                     STD   SRCID
E60A DD10             (    forth6809.asm):03598                     STD   TOIN
E60C 39               (    forth6809.asm):03599                     RTS
                      (    forth6809.asm):03600         
                      (    forth6809.asm):03601         ; ============================================================
                      (    forth6809.asm):03602         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03603         ; ============================================================
                      (    forth6809.asm):03604         ; ------------------------------------------------------------
                      (    forth6809.asm):03605         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03606         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03607         ; one expected.
                      (    forth6809.asm):03608         ; CFERR
                      (    forth6809.asm):03609         ;    Inputs:
                      (    forth6809.asm):03610         ;        none
                      (    forth6809.asm):03611         ;    Outputs:
                      (    forth6809.asm):03612         ;        does not return (THROW -22)
                      (    forth6809.asm):03613         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03614         ; ------------------------------------------------------------
E60D CCFFEA           (    forth6809.asm):03615         CFERR:      LDD   #-22
E610 3606             (    forth6809.asm):03616                     PSHU  D                 ; -22
E612 BDE642           (    forth6809.asm):03617                     JSR   THROWW
E615 39               (    forth6809.asm):03618                     RTS
                      (    forth6809.asm):03619         
                      (    forth6809.asm):03620         ; ------------------------------------------------------------
                      (    forth6809.asm):03621         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03622         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03623         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03624         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03625         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03626         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03627         ; ------------------------------------------------------------
E616 3710             (    forth6809.asm):03628         CATCHW:     PULU  X                 ; xt
E618 DC0C             (    forth6809.asm):03629                     LDD   HANDLER
E61A 3406             (    forth6809.asm):03630                     PSHS  D
E61C 3440             (    forth6809.asm):03631                     PSHS  U
                      (    forth6809.asm):03632                     ; Save the input source specification.
                      (    forth6809.asm):03633                     ; See bugfix: CATCHW.1
E61E DC6F             (    forth6809.asm):03634                     LDD   SRCADDR
E620 3406             (    forth6809.asm):03635                     PSHS  D
E622 DC71             (    forth6809.asm):03636                     LDD   SRCLEN
E624 3406             (    forth6809.asm):03637                     PSHS  D
E626 DC73             (    forth6809.asm):03638                     LDD   SRCID
E628 3406             (    forth6809.asm):03639                     PSHS  D
E62A DC10             (    forth6809.asm):03640                     LDD   TOIN
E62C 3406             (    forth6809.asm):03641                     PSHS  D
E62E 1F40             (    forth6809.asm):03642                     TFR   S,D
E630 DD0C             (    forth6809.asm):03643                     STD   HANDLER
                      (    forth6809.asm):03644         
E632 AD84             (    forth6809.asm):03645                     JSR   ,X
                      (    forth6809.asm):03646         
E634 3268             (    forth6809.asm):03647                     LEAS  8,S               ; drop saved input source
E636 3262             (    forth6809.asm):03648                     LEAS  2,S               ; saved U
E638 3506             (    forth6809.asm):03649                     PULS  D
E63A DD0C             (    forth6809.asm):03650                     STD   HANDLER
E63C CC0000           (    forth6809.asm):03651                     LDD   #0
E63F 3606             (    forth6809.asm):03652                     PSHU  D                 ; 0 = no exception
E641 39               (    forth6809.asm):03653                     RTS
                      (    forth6809.asm):03654         
                      (    forth6809.asm):03655         ; ------------------------------------------------------------
                      (    forth6809.asm):03656         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03657         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03658         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03659         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03660         ; ------------------------------------------------------------
E642 3706             (    forth6809.asm):03661         THROWW:     PULU  D                 ; n
E644 10830000         (    forth6809.asm):03662                     CMPD  #0
E648 2725             (    forth6809.asm):03663                     BEQ   THDONE
                      (    forth6809.asm):03664         
E64A DD0E             (    forth6809.asm):03665                     STD   THROWN
E64C 9E0C             (    forth6809.asm):03666                     LDX   HANDLER
E64E 2720             (    forth6809.asm):03667                     BEQ   THUNCAU
                      (    forth6809.asm):03668         
E650 1F14             (    forth6809.asm):03669                     TFR   X,S
E652 3506             (    forth6809.asm):03670                     PULS  D                 ; restore input source saved by CATCH
E654 DD10             (    forth6809.asm):03671                     STD   TOIN
E656 3506             (    forth6809.asm):03672                     PULS  D
E658 DD73             (    forth6809.asm):03673                     STD   SRCID
E65A 3506             (    forth6809.asm):03674                     PULS  D
E65C DD71             (    forth6809.asm):03675                     STD   SRCLEN
E65E 3506             (    forth6809.asm):03676                     PULS  D
E660 DD6F             (    forth6809.asm):03677                     STD   SRCADDR
E662 3506             (    forth6809.asm):03678                     PULS  D
E664 1F03             (    forth6809.asm):03679                     TFR   D,U
E666 3506             (    forth6809.asm):03680                     PULS  D
E668 DD0C             (    forth6809.asm):03681                     STD   HANDLER
                      (    forth6809.asm):03682         
E66A DC0E             (    forth6809.asm):03683                     LDD   THROWN
E66C 3606             (    forth6809.asm):03684                     PSHU  D
E66E 39               (    forth6809.asm):03685                     RTS
E66F 39               (    forth6809.asm):03686         THDONE:     RTS
                      (    forth6809.asm):03687         
                      (    forth6809.asm):03688                     ; No CATCH is active: leave n on the stack and ABORT.
E670 DC0E             (    forth6809.asm):03689         THUNCAU:    LDD   THROWN
E672 3606             (    forth6809.asm):03690                     PSHU  D
E674 7EDEC3           (    forth6809.asm):03691                     JMP   ABORT
                      (    forth6809.asm):03692         
                      (    forth6809.asm):03693         ; ============================================================
                      (    forth6809.asm):03694         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03695         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03696         ; ============================================================
                      (    forth6809.asm):03697         ; ------------------------------------------------------------
                      (    forth6809.asm):03698         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03699         ; location.
                      (    forth6809.asm):03700         ; PATCH   ( target location -- )
                      (    forth6809.asm):03701         ;    Inputs:
                      (    forth6809.asm):03702         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03703         ;    Outputs:
                      (    forth6809.asm):03704         ;        the cell at location holds target - location
                      (    forth6809.asm):03705         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03706         ; ------------------------------------------------------------
E677 3710             (    forth6809.asm):03707         PATCH:      PULU  X                 ; location
E679 3706             (    forth6809.asm):03708                     PULU  D                 ; target
E67B 3410             (    forth6809.asm):03709                     PSHS  X
E67D A3E1             (    forth6809.asm):03710                     SUBD  ,S++              ; target - location
E67F ED84             (    forth6809.asm):03711                     STD   ,X
E681 39               (    forth6809.asm):03712                     RTS
                      (    forth6809.asm):03713         
                      (    forth6809.asm):03714         ; ------------------------------------------------------------
                      (    forth6809.asm):03715         ; IF  ( C: -- orig )
                      (    forth6809.asm):03716         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03717         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03718         ; ------------------------------------------------------------
E682 CCDF70           (    forth6809.asm):03719         IFW:        LDD   #ZBRANCH
E685 3606             (    forth6809.asm):03720                     PSHU  D
E687 BDEAB7           (    forth6809.asm):03721                     JSR   CCALL
E68A CC0000           (    forth6809.asm):03722                     LDD   #0
E68D 3606             (    forth6809.asm):03723                     PSHU  D
E68F BDE002           (    forth6809.asm):03724                     JSR   CODECOMMA
E692 DC08             (    forth6809.asm):03725                     LDD   CODEHERE
E694 830002           (    forth6809.asm):03726                     SUBD  #2
E697 3606             (    forth6809.asm):03727                     PSHU  D                 ; orig
E699 CC0001           (    forth6809.asm):03728                     LDD   #TAGFWD
E69C 3606             (    forth6809.asm):03729                     PSHU  D
E69E 39               (    forth6809.asm):03730                     RTS
                      (    forth6809.asm):03731         
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
                      (    forth6809.asm):03733         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03734         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03735         ; operand to jump to the current code address.
                      (    forth6809.asm):03736         ; ------------------------------------------------------------
E69F 3706             (    forth6809.asm):03737         THENW:      PULU  D
E6A1 10830001         (    forth6809.asm):03738                     CMPD  #TAGFWD
E6A5 2703             (    forth6809.asm):03739                     BEQ   THOK
E6A7 BDE60D           (    forth6809.asm):03740                     JSR   CFERR
E6AA 3710             (    forth6809.asm):03741         THOK:       PULU  X                 ; orig
E6AC DC08             (    forth6809.asm):03742                     LDD   CODEHERE
E6AE 3606             (    forth6809.asm):03743                     PSHU  D
E6B0 3610             (    forth6809.asm):03744                     PSHU  X
E6B2 BDE677           (    forth6809.asm):03745                     JSR   PATCH
E6B5 39               (    forth6809.asm):03746                     RTS
                      (    forth6809.asm):03747         
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
                      (    forth6809.asm):03749         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03750         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03751         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03752         ; ------------------------------------------------------------
E6B6 3706             (    forth6809.asm):03753         ELSEW:      PULU  D
E6B8 10830001         (    forth6809.asm):03754                     CMPD  #TAGFWD
E6BC 2703             (    forth6809.asm):03755                     BEQ   ELOK
E6BE BDE60D           (    forth6809.asm):03756                     JSR   CFERR
E6C1 3706             (    forth6809.asm):03757         ELOK:       PULU  D                 ; orig1
E6C3 DD29             (    forth6809.asm):03758                     STD   MSCR              ; See bugfix: ELSEW.1
E6C5 CCDF86           (    forth6809.asm):03759                     LDD   #BRANCH
E6C8 3606             (    forth6809.asm):03760                     PSHU  D
E6CA BDEAB7           (    forth6809.asm):03761                     JSR   CCALL
E6CD CC0000           (    forth6809.asm):03762                     LDD   #0
E6D0 3606             (    forth6809.asm):03763                     PSHU  D
E6D2 BDE002           (    forth6809.asm):03764                     JSR   CODECOMMA
E6D5 DC08             (    forth6809.asm):03765                     LDD   CODEHERE
E6D7 830002           (    forth6809.asm):03766                     SUBD  #2
E6DA DD3B             (    forth6809.asm):03767                     STD   NEWFLD
E6DC DC08             (    forth6809.asm):03768                     LDD   CODEHERE
E6DE 3606             (    forth6809.asm):03769                     PSHU  D
E6E0 DC29             (    forth6809.asm):03770                     LDD   MSCR
E6E2 3606             (    forth6809.asm):03771                     PSHU  D
E6E4 BDE677           (    forth6809.asm):03772                     JSR   PATCH
E6E7 DC3B             (    forth6809.asm):03773                     LDD   NEWFLD
E6E9 3606             (    forth6809.asm):03774                     PSHU  D                 ; orig2
E6EB CC0001           (    forth6809.asm):03775                     LDD   #TAGFWD
E6EE 3606             (    forth6809.asm):03776                     PSHU  D
E6F0 39               (    forth6809.asm):03777                     RTS
                      (    forth6809.asm):03778         
                      (    forth6809.asm):03779         ; ------------------------------------------------------------
                      (    forth6809.asm):03780         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03781         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03782         ; stack.
                      (    forth6809.asm):03783         ; ------------------------------------------------------------
E6F1 DC08             (    forth6809.asm):03784         BEGINW:     LDD   CODEHERE
E6F3 3606             (    forth6809.asm):03785                     PSHU  D                 ; dest
E6F5 CC0002           (    forth6809.asm):03786                     LDD   #TAGBACK
E6F8 3606             (    forth6809.asm):03787                     PSHU  D
E6FA 39               (    forth6809.asm):03788                     RTS
                      (    forth6809.asm):03789         

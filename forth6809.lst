                      (    forth6809.asm):10687                     STD  TSTSLSAV
                      (    forth6809.asm):10688                     LDD  TOIN
                      (    forth6809.asm):10689                     STD  TSTTISAV
                      (    forth6809.asm):10690                     LDD  STATE
                      (    forth6809.asm):10691                     STD  TSTSTSAV
                      (    forth6809.asm):10692         
                      (    forth6809.asm):10693                     LDA  #'H'
                      (    forth6809.asm):10694                     STA  TSTNAMEB
                      (    forth6809.asm):10695                     LDA  #'I'
                      (    forth6809.asm):10696                     STA  TSTNAMEB+1
                      (    forth6809.asm):10697                     LDA  #34
                      (    forth6809.asm):10698                     STA  TSTNAMEB+2
                      (    forth6809.asm):10699         
                      (    forth6809.asm):10700                     LDD  #TSTCBUF
                      (    forth6809.asm):10701                     STD  CODEHERE
                      (    forth6809.asm):10702                     LDD  #TSTNAMEB
                      (    forth6809.asm):10703                     STD  SRCADDR
                      (    forth6809.asm):10704                     LDD  #3
                      (    forth6809.asm):10705                     STD  SRCLEN
                      (    forth6809.asm):10706                     LDD  #0
                      (    forth6809.asm):10707                     STD  TOIN
                      (    forth6809.asm):10708                     LDD  #-1
                      (    forth6809.asm):10709                     STD  STATE
                      (    forth6809.asm):10710         
                      (    forth6809.asm):10711                     JSR  ABORTQUOTE
                      (    forth6809.asm):10712         
                      (    forth6809.asm):10713                     LDD  #OPRTS
                      (    forth6809.asm):10714                     PSHU D
                      (    forth6809.asm):10715                     JSR  CCOMMA
                      (    forth6809.asm):10716         
                      (    forth6809.asm):10717                     LDD  TSTCSAV
                      (    forth6809.asm):10718                     STD  CODEHERE
                      (    forth6809.asm):10719                     LDD  TSTSASAV
                      (    forth6809.asm):10720                     STD  SRCADDR
                      (    forth6809.asm):10721                     LDD  TSTSLSAV
                      (    forth6809.asm):10722                     STD  SRCLEN
                      (    forth6809.asm):10723                     LDD  TSTTISAV
                      (    forth6809.asm):10724                     STD  TOIN
                      (    forth6809.asm):10725                     LDD  TSTSTSAV
                      (    forth6809.asm):10726                     STD  STATE
                      (    forth6809.asm):10727         
                      (    forth6809.asm):10728                     STU  TSTU0
                      (    forth6809.asm):10729         
                      (    forth6809.asm):10730                     LDD  #TSTGUARD
                      (    forth6809.asm):10731                     PSHU D
                      (    forth6809.asm):10732                     LDD  #FALSEV
                      (    forth6809.asm):10733                     PSHU D
                      (    forth6809.asm):10734                     STU  TSTUB4
                      (    forth6809.asm):10735         
                      (    forth6809.asm):10736                     LDX  #TSTCBUF
                      (    forth6809.asm):10737                     JSR  ,X
                      (    forth6809.asm):10738         
                      (    forth6809.asm):10739                     STU  TSTUAF
                      (    forth6809.asm):10740         
                      (    forth6809.asm):10741                     PULU D
                      (    forth6809.asm):10742                     CMPD #TSTGUARD
                      (    forth6809.asm):10743                     BNE  AQ1FAIL
                      (    forth6809.asm):10744         
                      (    forth6809.asm):10745                     LDD  TSTUB4
                      (    forth6809.asm):10746                     SUBD TSTUAF
                      (    forth6809.asm):10747                     CMPD #-2
                      (    forth6809.asm):10748                     BNE  AQ1FAIL
                      (    forth6809.asm):10749         
                      (    forth6809.asm):10750                     LDD  #TRUEV
                      (    forth6809.asm):10751                     BRA  AQ1DONE
C100                  (    forth6809.asm):10752         AQ1FAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):10753         AQ1DONE:    LDX  #TSTAQ1NAME
                      (    forth6809.asm):10754                     PSHU X
                      (    forth6809.asm):10755                     PSHU D
                      (    forth6809.asm):10756                     JSR  TSTREPORT
                      (    forth6809.asm):10757         

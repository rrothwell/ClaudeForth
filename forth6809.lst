                      (    forth6809.asm):01921         
                      (    forth6809.asm):01922         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01923         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01924         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01925         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01926         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01927         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01928         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01929         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01930         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01931         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01932         ; were chained on after H_QUIT in a later turn.
DCF8 05               (    forth6809.asm):01933         H_ABORT: FCB   5
DCF9 41424F5254       (    forth6809.asm):01934                  FCC   "ABORT"
DCFE DCEE             (    forth6809.asm):01935                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01936                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01937                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01938                                        ; now H_FALSE, the chain's newest entry
DD00 DF19             (    forth6809.asm):01939                  FDB   ABORT
                      (    forth6809.asm):01940         
DD02 04               (    forth6809.asm):01941         H_QUIT:  FCB   4
DD03 51554954         (    forth6809.asm):01942                  FCC   "QUIT"
DD07 DCF8             (    forth6809.asm):01943                  FDB   H_ABORT
DD09 DF1C             (    forth6809.asm):01944                  FDB   QUIT
                      (    forth6809.asm):01945         
                      (    forth6809.asm):01946         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):01947         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):01948         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):01949         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):01950         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):01951         ; reconstructs and pushes the original c-addr, then 0.
DD0B 04               (    forth6809.asm):01952         H_FIND:  FCB   4
DD0C 46494E44         (    forth6809.asm):01953                  FCC   "FIND"
DD10 DD02             (    forth6809.asm):01954                  FDB   H_QUIT
DD12 E458             (    forth6809.asm):01955                  FDB   FIND
                      (    forth6809.asm):01956         
DD14 01               (    forth6809.asm):01957         H_1:     FCB   1
DD15 31               (    forth6809.asm):01958                  FCC   "1"
DD16 DD0B             (    forth6809.asm):01959                  FDB   H_FIND
DD18 FF6D             (    forth6809.asm):01960                  FDB   ONEBODY
                      (    forth6809.asm):01961         
DD1A 02               (    forth6809.asm):01962         H_M1:    FCB   2
DD1B 2D31             (    forth6809.asm):01963                  FCC   "-1"
DD1D DD14             (    forth6809.asm):01964                  FDB   H_1
DD1F FF73             (    forth6809.asm):01965                  FDB   MONEBODY
                      (    forth6809.asm):01966         
DD21 01               (    forth6809.asm):01967         H_2:     FCB   1
DD22 32               (    forth6809.asm):01968                  FCC   "2"
DD23 DD1A             (    forth6809.asm):01969                  FDB   H_M1
DD25 FF79             (    forth6809.asm):01970                  FDB   TWOBODY
                      (    forth6809.asm):01971         
DD27 02               (    forth6809.asm):01972         H_M2:    FCB   2
DD28 2D32             (    forth6809.asm):01973                  FCC   "-2"
DD2A DD21             (    forth6809.asm):01974                  FDB   H_2
DD2C FF7F             (    forth6809.asm):01975                  FDB   MTWOBODY
                      (    forth6809.asm):01976         
     DD27             (    forth6809.asm):01977         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):01978                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):01979                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):01980                                   ; were chained on after it; before that,
                      (    forth6809.asm):01981                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):01982                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):01983                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):01984                                   ; before this one.
                      (    forth6809.asm):01985         
                      (    forth6809.asm):01986         ; Verify no collision with base code.
                      (    forth6809.asm):01987         ; Value should match ORG BASECODE
     DD2E             (    forth6809.asm):01988         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):01989         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):01990         
                      (    forth6809.asm):01991         ; ============================================================
                      (    forth6809.asm):01992         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01993         ; ============================================================
                      (    forth6809.asm):01994                     ORG   BASECODE  ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01995                                     ; entirely - every routine from here through
                      (    forth6809.asm):01996                                     ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01997                                     ; every primitive) would otherwise have
                      (    forth6809.asm):01998                                     ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01999                                     ; WARM message left the location counter,
                      (    forth6809.asm):02000                                     ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02001                                     ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02002                                     ; instead of landing in BASECODE at all
                      (    forth6809.asm):02003         
                      (    forth6809.asm):02004         ; ------------------------------------------------------------
                      (    forth6809.asm):02005         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02006         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02007         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02008         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02009         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02010         ; ------------------------------------------------------------
                      (    forth6809.asm):02011         ; ------------------------------------------------------------
                      (    forth6809.asm):02012         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02013         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02014         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02015         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02016         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02017         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02018         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02019         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02020         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02021         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02022         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02023         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02024         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02025         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02026         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02027         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02028         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02029         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02030         ; not duplicated logic in either place.
                      (    forth6809.asm):02031         ; ------------------------------------------------------------
                      (    forth6809.asm):02032         
DD2E 7F0176           (    forth6809.asm):02033         SERBUFCLR:  CLR  INHEAD
DD31 7F0177           (    forth6809.asm):02034                     CLR  INTAIL
DD34 7F0178           (    forth6809.asm):02035                     CLR  RTSSTATE    ; $00 = RTS Low (Clear)
DD37 7F0179           (    forth6809.asm):02036                     CLR  OUTHEAD
DD3A 7F017A           (    forth6809.asm):02037                     CLR  OUTTAIL
DD3D 7F017B           (    forth6809.asm):02038                     CLR  OUTACTIVITY  ; $00 = Idle
                      (    forth6809.asm):02039         
                      (    forth6809.asm):02040         
DD40 7F017C           (    forth6809.asm):02041                     CLR  FECOUNT
DD43 7F017D           (    forth6809.asm):02042                     CLR  OVRNCOUNT
DD46 7F017E           (    forth6809.asm):02043                     CLR  PECOUNT
DD49 39               (    forth6809.asm):02044                     RTS
                      (    forth6809.asm):02045         
DD4A BDDD2E           (    forth6809.asm):02046         INITSERIAL: JSR  SERBUFCLR
DD4D 9603             (    forth6809.asm):02047                     LDA   CR_RESET    ; Master Software Reset command to 6850
DD4F B7C008           (    forth6809.asm):02048                     STA   ACIACR 
DD52 12               (    forth6809.asm):02049                     NOP               ; Settling Delay
DD53 12               (    forth6809.asm):02050                     NOP
                      (    forth6809.asm):02051                     
                      (    forth6809.asm):02052                     IFEQ SERIALPOLL  ; >>>>>>>>>>
DD54 8695             (    forth6809.asm):02053                     LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02054                     ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):02055                     LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02056                     ENDC  ; <<<<<<<<<<

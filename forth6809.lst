                      (    forth6809.asm):18754                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):18755                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):18756                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):18757                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):18758                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):18759                                      ; matching "always increment" rather than
                      (    forth6809.asm):18760                                      ; "increment only on genuine carry".

                      (    forth6809.asm):05839                   STA  TSTFHDR+1
                      (    forth6809.asm):05840                   LDA  #'O'
                      (    forth6809.asm):05841                   STA  TSTFHDR+2
                      (    forth6809.asm):05842                   LDA  #'O'
                      (    forth6809.asm):05843                   STA  TSTFHDR+3
                      (    forth6809.asm):05844                   LDD  #0
                      (    forth6809.asm):05845                   STD  TSTFHDR+4
                      (    forth6809.asm):05846                   LDD  #DUP
                      (    forth6809.asm):05847                   STD  TSTFHDR+6

                      (    forth6809.asm):02848         ; TSTSTSLZ - unit test for STARSLASH, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):02849         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02850         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02851         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02852         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02853         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02854         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02855         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02856         ; there are.
                      (    forth6809.asm):02857         ; ------------------------------------------------------------
C180                  (    forth6809.asm):02858         TSTSTSLZ:   STU   TSTU0
                      (    forth6809.asm):02859         
                      (    forth6809.asm):02860                    LDD   #TSTVAL1
                      (    forth6809.asm):02861                    PSHU  D
                      (    forth6809.asm):02862                    LDD   #TSTVAL2
                      (    forth6809.asm):02863                    PSHU  D
                      (    forth6809.asm):02864                    LDD   #$0000
                      (    forth6809.asm):02865                    PSHU  D
                      (    forth6809.asm):02866                    LDX   #STARSLASH
                      (    forth6809.asm):02867                    PSHU  X
                      (    forth6809.asm):02868                    STU   TSTUB4
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870                    JSR   CATCH
                      (    forth6809.asm):02871         
                      (    forth6809.asm):02872                    STU   TSTUAF
                      (    forth6809.asm):02873         
                      (    forth6809.asm):02874                    PULU  D
                      (    forth6809.asm):02875                    CMPD  #-10
                      (    forth6809.asm):02876                    BNE   TZFAIL
                      (    forth6809.asm):02877         
                      (    forth6809.asm):02878                    LDD   TSTUB4
                      (    forth6809.asm):02879                    SUBD  TSTUAF
                      (    forth6809.asm):02880                    CMPD  #0
                      (    forth6809.asm):02881                    BNE   TZFAIL
                      (    forth6809.asm):02882         
                      (    forth6809.asm):02883                    LDD   #TRUEV
                      (    forth6809.asm):02884                    BRA   TZDONE
C180                  (    forth6809.asm):02885         TZFAIL:     LDD   #FALSEV
C180                  (    forth6809.asm):02886         TZDONE:     LDX   #TSTSTSLZNAME
                      (    forth6809.asm):02887                    PSHU  X
                      (    forth6809.asm):02888                    PSHU  D

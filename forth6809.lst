                      (    forth6809.asm):19209                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):19210                                      ; making the high-cell increment run
                      (    forth6809.asm):19211                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):19212                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):19213                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):19214                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):19215                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):19216                                      ; matching "always increment" rather than
                      (    forth6809.asm):19217                                      ; "increment only on genuine carry".

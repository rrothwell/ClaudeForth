                      (    forth6809.asm):10026                                      ; symmetric division, not floored -
                      (    forth6809.asm):10027                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):10028                                      ; answer (recognized query, value false),

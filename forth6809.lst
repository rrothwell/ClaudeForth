                      (    forth6809.asm):05309         ; ------------------------------------------------------------
                      (    forth6809.asm):05310         ; Control-flow test harness (glossary section 3.8). Each test
                      (    forth6809.asm):05311         ; redirects CODEHERE to a scratch buffer (TSTCBUF), calls the
                      (    forth6809.asm):05312         ; real compile-time control-flow words directly (JSR IF, JSR
                      (    forth6809.asm):05313         ; THEN, etc - the same routines the compiler itself calls when
                      (    forth6809.asm):05314         ; parsing IF/THEN/DO/LOOP/etc, not a hand-simulated imitation),
                      (    forth6809.asm):05315         ; then restores CODEHERE and executes the compiled snippet
                      (    forth6809.asm):05316         ; directly. This tests the actual interaction between compile-
                      (    forth6809.asm):05317         ; time correctness (right bytes, right patched offsets) and
                      (    forth6809.asm):05318         ; runtime correctness (right control flow) in one coherent
                      (    forth6809.asm):05319         ; test, without needing the outer interpreter, FIND, or a
                      (    forth6809.asm):05320         ; dictionary entry - matching the ANS test suite's own planned
                      (    forth6809.asm):05321         ; role for broader standards-compliance coverage; these tests
                      (    forth6809.asm):05322         ; specifically verify this system's own compile/patch mechanism
                      (    forth6809.asm):05323         ; works correctly, not full end-to-end parsing.
                      (    forth6809.asm):05324         ; ------------------------------------------------------------
                      (    forth6809.asm):05325         
                      (    forth6809.asm):05326         ; ------------------------------------------------------------
                      (    forth6809.asm):05327         ; TSTIFT1 - unit test for IF/THEN, true case. Compiles
                      (    forth6809.asm):05328         ; "IF <lit 111> THEN" into scratch, then runs it with a true
                      (    forth6809.asm):05329         ; flag - the branch is NOT taken, so 111 should be pushed.
                      (    forth6809.asm):05330         ; Verified by hand-trace before writing: ZBRANCH's patched
                      (    forth6809.asm):05331         ; offset comes out to 7 (from the placeholder field to just
                      (    forth6809.asm):05332         ; past the compiled LIT+111), correctly skipping nothing when
                      (    forth6809.asm):05333         ; the flag is true and falling through into the literal.
                      (    forth6809.asm):05334         ; ------------------------------------------------------------
C22B DC08             (    forth6809.asm):05335         TSTIFT1: LDD   CODEHERE
C22D FD0275           (    forth6809.asm):05336                  STD   TSTCSAV
C230 CC0225           (    forth6809.asm):05337                  LDD   #TSTCBUF
C233 DD08             (    forth6809.asm):05338                  STD   CODEHERE
                      (    forth6809.asm):05339         

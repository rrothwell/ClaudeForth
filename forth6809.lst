                      (    forth6809.asm):15209         ; TSTTHROWHLP - internal helper, not a dictionary word or a
                      (    forth6809.asm):15210         ; test of its own. Pushes two dummy values (to verify CATCH's
                      (    forth6809.asm):15211         ; own stack-depth restoration genuinely discards them, not just
                      (    forth6809.asm):15212         ; that a thrown code arrives correctly) then throws a known,
                      (    forth6809.asm):15213         ; distinctive, non-trivial code. Only ever invoked via CATCH
                      (    forth6809.asm):15214         ; (below), never called directly - calling it any other way
                      (    forth6809.asm):15215         ; would hit THROW's own uncaught path (JMP ABORT), which this
                      (    forth6809.asm):15216         ; whole test framework cannot survive.
                      (    forth6809.asm):15217         ; ------------------------------------------------------------
C308                  (    forth6809.asm):15218         TSTTHROWHLP: LDD  #TSTVAL1
                      (    forth6809.asm):15219                      PSHU D
                      (    forth6809.asm):15220                      LDD  #TSTVAL2
                      (    forth6809.asm):15221                      PSHU D
                      (    forth6809.asm):15222                      LDD  #TSTNEG1
                      (    forth6809.asm):15223                      PSHU D
                      (    forth6809.asm):15224                      JSR  THROW
                      (    forth6809.asm):15225                      RTS
                      (    forth6809.asm):15226         
                      (    forth6809.asm):15227         ; ------------------------------------------------------------
                      (    forth6809.asm):15228         ; TSTCATCHTHROW - unit test for CATCH, exception path, and for
                      (    forth6809.asm):15229         ; THROW's own non-local exit together (the two can only be
                      (    forth6809.asm):15230         ; meaningfully tested as a pair - THROW's own effect is only
                      (    forth6809.asm):15231         ; observable through a CATCH that traps it). Verifies CATCH
                      (    forth6809.asm):15232         ; returns the exact thrown code, and specifically verifies the
                      (    forth6809.asm):15233         ; two dummy values TSTTHROWHLP pushes before throwing are
                      (    forth6809.asm):15234         ; genuinely gone afterward - confirming the documented "restores
                      (    forth6809.asm):15235         ; data stack depth... on either path" for real, not just that
                      (    forth6809.asm):15236         ; the final result happens to look right.
                      (    forth6809.asm):15237         ; ------------------------------------------------------------
C308                  (    forth6809.asm):15238         TSTCATCHTHROW: STU  TSTU0
                      (    forth6809.asm):15239         
                      (    forth6809.asm):15240                        LDD  #TSTGUARD
                      (    forth6809.asm):15241                        PSHU D
                      (    forth6809.asm):15242                        LDX  #TSTTHROWHLP
                      (    forth6809.asm):15243                        PSHU X
                      (    forth6809.asm):15244                        STU  TSTUB4
                      (    forth6809.asm):15245         
                      (    forth6809.asm):15246                        JSR  CATCH
                      (    forth6809.asm):15247         
                      (    forth6809.asm):15248                        STU  TSTUAF
                      (    forth6809.asm):15249         
                      (    forth6809.asm):15250                        PULU D
                      (    forth6809.asm):15251                        CMPD #TSTNEG1
                      (    forth6809.asm):15252                        BNE  CTFAIL2
                      (    forth6809.asm):15253                        PULU D
                      (    forth6809.asm):15254                        CMPD #TSTGUARD
                      (    forth6809.asm):15255                        BNE  CTFAIL2
                      (    forth6809.asm):15256         
                      (    forth6809.asm):15257                        LDD  TSTUB4
                      (    forth6809.asm):15258                        SUBD TSTUAF
                      (    forth6809.asm):15259                        CMPD #0
                      (    forth6809.asm):15260                        BNE  CTFAIL2
                      (    forth6809.asm):15261         
                      (    forth6809.asm):15262                        LDD  #TRUEV
                      (    forth6809.asm):15263                        BRA  CTDONE2
C308                  (    forth6809.asm):15264         CTFAIL2:       LDD  #FALSEV
C308                  (    forth6809.asm):15265         CTDONE2:       LDX  #TSTCTNAME2
                      (    forth6809.asm):15266                        PSHU X
                      (    forth6809.asm):15267                        PSHU D
                      (    forth6809.asm):15268                        JSR  TSTREPORT
                      (    forth6809.asm):15269         
                      (    forth6809.asm):15270                        LDU  TSTU0
                      (    forth6809.asm):15271                        RTS
                      (    forth6809.asm):15272         
C308                  (    forth6809.asm):15273         TSTCTNAME2: FCB  13
                      (    forth6809.asm):15274                     FCC  "TSTCATCHTHROW"

                      (    forth6809.asm):02364                                             ; worth reusing.
                      (    forth6809.asm):02365                     JSR   CHKLO
                      (    forth6809.asm):02366                     ANDCC #$EF
                      (    forth6809.asm):02367         
                      (    forth6809.asm):02368                     ANDCC #$FE               ; Carry flag %0 = valid character
                      (    forth6809.asm):02369                     RTS
                      (    forth6809.asm):02370         
DD69                  (    forth6809.asm):02371         GET_NO_CHAR:
                      (    forth6809.asm):02372                     ORCC  #$01               ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02373                     RTS
                      (    forth6809.asm):02374         ; ------------------------------------------------------------
                      (    forth6809.asm):02375         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):02376         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):02377         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):02378         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):02379         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):02380         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):02381         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):02382         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):02383         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02385         RTSCHECKLO: 
                      (    forth6809.asm):02386                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02387         
                      (    forth6809.asm):02388                                 JSR  INFILL
                      (    forth6809.asm):02389                     CMPA #INLOWATER
                      (    forth6809.asm):02390                     BHI  RTSCLODONE
                      (    forth6809.asm):02391                     TST  RTSSTATE
                      (    forth6809.asm):02392                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394         
                      (    forth6809.asm):02395                     CLR  RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02396         
                      (    forth6809.asm):02397                     LDB  OUTTAIL           ; Check if chars are available.  
                      (    forth6809.asm):02398                     CMPB OUTHEAD
                      (    forth6809.asm):02399                     BEQ  RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02400         
                      (    forth6809.asm):02401                     LDA  #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02402                     STA  ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02403                     BRA  RTSCLOUNMASK
                      (    forth6809.asm):02404         
DD69                  (    forth6809.asm):02405         RTSCLONOTX: LDA  #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02406                     STA  ACIACR
                      (    forth6809.asm):02407         
DD69                  (    forth6809.asm):02408         RTSCLOUNMASK: ANDCC #$EF
                      (    forth6809.asm):02409         
DD69                  (    forth6809.asm):02410         RTSCLODONE: RTS
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
                      (    forth6809.asm):02413         ; IRQH - interrupt-driven ACIA (6850) servicing (SERIALPOLL=0).
                      (    forth6809.asm):02414         ; Rewritten by the user for two things at once: (1) the RX and TX
                      (    forth6809.asm):02415         ; halves are now laid out symmetrically (each is: check the
                      (    forth6809.asm):02416         ; relevant status bit, dispatch, single self-contained handler
                      (    forth6809.asm):02417         ; block), and (2) single point of exit - every path, success or
                      (    forth6809.asm):02418         ; not, falls through to IRQDONE/RTI rather than RTI-ing from
                      (    forth6809.asm):02419         ; several different places. Deliberately less byte/cycle-
                      (    forth6809.asm):02420         ; efficient than the previous version in exchange for being
                      (    forth6809.asm):02421         ; easier to review by eye; the user accepted that trade knowingly.
                      (    forth6809.asm):02422         ;
                      (    forth6809.asm):02423         ; Interrupts are automatically masked during an interrupt handler
                      (    forth6809.asm):02424         ; (6809 hardware behavior on IRQ entry), so the composite
                      (    forth6809.asm):02425         ; operations here (ring-buffer head/tail updates, RTSSTATE,
                      (    forth6809.asm):02426         ; ACIACR, the new error counters below) are all safe without any
                      (    forth6809.asm):02427         ; explicit ORCC/ANDCC masking of their own - unlike RTSCHECKLO,
                      (    forth6809.asm):02428         ; which runs from mainline code and does mask explicitly.
                      (    forth6809.asm):02429         ;
                      (    forth6809.asm):02430         ; Receiver-error counting: SR_FE/SR_OVRN/SR_PE (bits 4/5/6 of
                      (    forth6809.asm):02431         ; ACIASR - framing error, overrun, parity error) are only
                      (    forth6809.asm):02432         ; meaningful together with RDRF, and are tested from the SAME
                      (    forth6809.asm):02433         ; ACIASR byte already read into A above, BEFORE ACIADR is read -
                      (    forth6809.asm):02434         ; reading ACIADR clears RDRF and, per the 6850 datasheet, the
                      (    forth6809.asm):02435         ; latched error bits along with it, so they must be inspected
                      (    forth6809.asm):02436         ; first or the information is gone. More than one bit can be set
                      (    forth6809.asm):02437         ; at once, so each is tested and tallied independently into its
                      (    forth6809.asm):02438         ; own counter (FECOUNT/OVRNCOUNT/PECOUNT - see the memory-map
                      (    forth6809.asm):02439         ; comment where they're declared). ACIADR is still read when an
                      (    forth6809.asm):02440         ; error is flagged, to clear the condition and let the next
                      (    forth6809.asm):02441         ; character arrive, but that byte is assumed corrupted and is
                      (    forth6809.asm):02442         ; discarded rather than stored into INBUF.
                      (    forth6809.asm):02443         ; ------------------------------------------------------------
DD69                  (    forth6809.asm):02444         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02445         
                      (    forth6809.asm):02446                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02447                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02448                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02449                     BNE   INCHAR
                      (    forth6809.asm):02450                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02451                     BNE   OUTCHAR
                      (    forth6809.asm):02452                                             ; Ignore all other interrupts such as DCD change.
DD69                  (    forth6809.asm):02453         IRQDONE0:  RTI                      ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02454                                             ; & restores state.
                      (    forth6809.asm):02455         
DD69                  (    forth6809.asm):02456         INCHAR:
                      (    forth6809.asm):02457                     LDB   ACIADR               ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02458                     BITA  #SR_FE+SR_OVRN+SR_PE ; Any receiver error flagged?
                      (    forth6809.asm):02459                     BEQ   INOK                 ; No! - character is good, keep it.
                      (    forth6809.asm):02460                                              
                      (    forth6809.asm):02461                     BITA  #SR_FE               ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02462                     BEQ   INXFE                ; Tally each flagged error independently -
                      (    forth6809.asm):02463                     INC   FECOUNT              ; more than one bit can be set at once.
DD69                  (    forth6809.asm):02464         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02465                     BEQ   INXOVRN
                      (    forth6809.asm):02466                     INC   OVRNCOUNT
DD69                  (    forth6809.asm):02467         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02468                     BEQ   INXPE
                      (    forth6809.asm):02469                     INC   PECOUNT 
DD69                  (    forth6809.asm):02470         INXPE:      RTI         
                      (    forth6809.asm):02471         
DD69                  (    forth6809.asm):02472         INOK:    TFR   B,A                  ; Transfer good character from the receiver.
                      (    forth6809.asm):02473                  LDX   #INBUF               ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02474                  LDB   INHEAD
                      (    forth6809.asm):02475                  STA   B,X
                      (    forth6809.asm):02476                  INCB                  ; Figure out the new head,
                      (    forth6809.asm):02477                  ANDB  #INBUFSZ-1      ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02478                  CMPB  INTAIL          ; Would the new head slot meet the tail?
                      (    forth6809.asm):02479                  BEQ   IRQDONE1        ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02480                  STB   INHEAD          ; New head pointer is OK so store it.
                      (    forth6809.asm):02481                  ;JSR   RTSCHECKHI     ; Protect the in buffer from overflow.
                      (    forth6809.asm):02482                                        ; OPTIMIZATION: RegB still holds the new head
                      (    forth6809.asm):02483                                        ; value STB just stored (STB doesn't clobber
                      (    forth6809.asm):02484                                        ; it) - reuse it directly to get the fill
                      (    forth6809.asm):02485                                        ; level, rather than have CHKHI reload INHEAD
                      (    forth6809.asm):02486                                        ; from memory. This is the single hottest
                      (    forth6809.asm):02487                                        ; per-character path in the system (it runs
                      (    forth6809.asm):02488                                        ; on every byte received), so a redundant
                      (    forth6809.asm):02489                                        ; 4-cycle load here is worth avoiding.
                      (    forth6809.asm):02490                  SUBB  INTAIL          ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02491                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):02492                  JSR   CHKHI           ; Protect the in buffer from overflow.
DD69                  (    forth6809.asm):02493         IRQDONE1: RTI
                      (    forth6809.asm):02494         
                      (    forth6809.asm):02495                  ; LDA   ACIASR          ; Recheck if the transmitter is ready.
                      (    forth6809.asm):02496                  ; BITA  #SR_TDRE        ; after handling the received character.
                      (    forth6809.asm):02497                  ; BEQ IRQDONE2          ; Yes! Process the char.
                      (    forth6809.asm):02498         
DD69                  (    forth6809.asm):02499         OUTCHAR: LDB   OUTTAIL         ; Is the out buffer empty?
                      (    forth6809.asm):02500                  CMPB  OUTHEAD
                      (    forth6809.asm):02501                  BEQ   TXOFF           ; Yes! Stop transmitting.
                      (    forth6809.asm):02502         
                      (    forth6809.asm):02503                  LDX   #OUTBUF         ; No! The out buffer is occupied.
                      (    forth6809.asm):02504                  LDA   B,X             ; Get the character from the out buffer.
                      (    forth6809.asm):02505                  STA   ACIADR          ; Transmit the char.
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507                  INCB                  ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02508                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02509                  STB   OUTTAIL
DD69                  (    forth6809.asm):02510         IRQDONE2  RTI
                      (    forth6809.asm):02511         
DD69                  (    forth6809.asm):02512         TXOFF:   ; TST   RTSSTATE        ; The buffer is empty.
                      (    forth6809.asm):02513                  ; BNE   IRQDONE3         ; RTS is asserted high - leave ACIACR alone,
                      (    forth6809.asm):02514                                        ; or this would incorrectly drop it back low
                      (    forth6809.asm):02515                  ; LDA   #CR_RXON
                      (    forth6809.asm):02516                  ; STA   ACIACR
                      (    forth6809.asm):02517                  CLR   OUTACTIVITY         
                      (    forth6809.asm):02518                  JSR   UPDATE_RTS         
DD69                  (    forth6809.asm):02519         IRQDONE3 RTI
                      (    forth6809.asm):02520         
                      (    forth6809.asm):02521                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):02522         
DD69 3B               (    forth6809.asm):02523         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02524                                       ; interrupts are never enabled (see
                      (    forth6809.asm):02525                                       ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02526                                       ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02527                                       ; the other unused vectors below
                      (    forth6809.asm):02528                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):02529         

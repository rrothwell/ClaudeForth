                      (    forth6809.asm):00413         ; ------------------------------------------------------------
                      (    forth6809.asm):00414         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00415         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00416         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00417         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00418         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00419         ; ------------------------------------------------------------
                      (    forth6809.asm):00420                     INCLUDE unit_tests.asm
                      (   unit_tests.asm):00001         ; ============================================================
                      (   unit_tests.asm):00002         ; UNIT TEST FRAMEWORK
                      (   unit_tests.asm):00003         ;
                      (   unit_tests.asm):00004         ; Self-checking assembly-level tests of this ROM's primitives. Built
                      (   unit_tests.asm):00005         ; in when UNITTESTS is 1; run once at cold boot, after INITSERIAL and
                      (   unit_tests.asm):00006         ; before COLD (U and S are valid, but nothing else is initialised).
                      (   unit_tests.asm):00007         ;
                      (   unit_tests.asm):00008         ; Each test saves U on entry and restores it on exit, so one test's
                      (   unit_tests.asm):00009         ; failure cannot disturb the next. Scratch variables live at the
                      (   unit_tests.asm):00010         ; start of APPVARS (safe: COLD re-purposes that space afterwards).
                      (   unit_tests.asm):00011         ; Each test reports its name and OK or FAIL through TSTREPORT.
                      (   unit_tests.asm):00012         ;
                      (   unit_tests.asm):00013         ; TSTSELECTOR picks one test group per build, because all groups
                      (   unit_tests.asm):00014         ; together do not fit in the unused ROM. Example, group 2:
                      (   unit_tests.asm):00015         ;
                      (   unit_tests.asm):00016         ;   lwasm --6809 --format=raw \
                      (   unit_tests.asm):00017         ;   --output=forth6809.bin --list=forth6809.lst \
                      (   unit_tests.asm):00018         ;   --define=UNITTESTS --define=TSTSELECTOR=2 \
                      (   unit_tests.asm):00019         ;   forth6809.asm
                      (   unit_tests.asm):00020         ;
                      (   unit_tests.asm):00021         ; The original header comment is shadow UNITTEST.0.
                      (   unit_tests.asm):00022         ; ============================================================
                      (   unit_tests.asm):00023         
     021B             (   unit_tests.asm):00024         TSTU0       EQU   APPVARS           ; saved U, before a test touches it
     021D             (   unit_tests.asm):00025         TSTUB4      EQU   APPVARS+2         ; U immediately before the op under test
     021F             (   unit_tests.asm):00026         TSTUAF      EQU   APPVARS+4         ; U immediately after the op under test
     0221             (   unit_tests.asm):00027         TSTFLAG     EQU   APPVARS+6         ; scratch for TSTREPORT's pass/fail arg
                      (   unit_tests.asm):00028         
     3C7A             (   unit_tests.asm):00029         TSTGUARD    EQU   $3C7A             ; sentinel beneath the value under test
     59E1             (   unit_tests.asm):00030         TSTVAL1     EQU   $59E1             ; the value under test (non-trivial)
     2468             (   unit_tests.asm):00031         TSTVAL2     EQU   $2468             ; additional distinct, non-trivial
     7B3D             (   unit_tests.asm):00032         TSTVAL3     EQU   $7B3D             ; values for multi-item tests (SWAP,
     4E2C             (   unit_tests.asm):00033         TSTVAL4     EQU   $4E2C             ; OVER, ROT, 2DUP, 2ROT, etc) - none are
     19A7             (   unit_tests.asm):00034         TSTVAL5     EQU   $19A7             ; 0, 1, -1, TSTGUARD, or any of each
     6D95             (   unit_tests.asm):00035         TSTVAL6     EQU   $6D95             ; other
                      (   unit_tests.asm):00036         
     0223             (   unit_tests.asm):00037         TSTSCR      EQU   APPVARS+8         ; extra scratch cell (DEPTH test)
                      (   unit_tests.asm):00038         
     0225             (   unit_tests.asm):00039         TSTCBUF     EQU   APPVARS+10        ; 80-byte compile target buffer
     0275             (   unit_tests.asm):00040         TSTCSAV     EQU   APPVARS+90        ; saved CODEHERE
     0277             (   unit_tests.asm):00041         TSTCSPS     EQU   APPVARS+92        ; saved CSP
     0279             (   unit_tests.asm):00042         TSTLSAV     EQU   APPVARS+94        ; saved LATEST (RECURSE test)
     027B             (   unit_tests.asm):00043         TSTFHDR     EQU   APPVARS+96        ; 16-byte fake dictionary header
                      (   unit_tests.asm):00044         
     028B             (   unit_tests.asm):00045         TSTDBUF     EQU   APPVARS+112       ; 40-byte scratch dictionary buffer
     02B3             (   unit_tests.asm):00046         TSTDSAV     EQU   APPVARS+152       ; saved DPHERE
     02B5             (   unit_tests.asm):00047         TSTVBUF     EQU   APPVARS+154       ; 20-byte scratch VARHERE buffer
     02C9             (   unit_tests.asm):00048         TSTVSAV     EQU   APPVARS+174       ; saved VARHERE
     02CB             (   unit_tests.asm):00049         TSTNAMEB    EQU   APPVARS+176       ; 16-byte fake source text for name parsing
     02DB             (   unit_tests.asm):00050         TSTSASAV    EQU   APPVARS+192       ; saved SRCADDR
     02DD             (   unit_tests.asm):00051         TSTSLSAV    EQU   APPVARS+194       ; saved SRCLEN
     02DF             (   unit_tests.asm):00052         TSTTISAV    EQU   APPVARS+196       ; saved TOIN
     02E1             (   unit_tests.asm):00053         TSTWCFA     EQU   APPVARS+198       ; CFA of the newly defined test word
     02E3             (   unit_tests.asm):00054         TSTSTSAV    EQU   APPVARS+200       ; saved STATE, across a :/; test
     02E5             (   unit_tests.asm):00055         TSTSMFLG    EQU   APPVARS+202       ; scratch: header SMUDGE-bit check result
     02E7             (   unit_tests.asm):00056         TSTDOESA    EQU   APPVARS+204       ; address of a compiled JSR SETDOES
     02EF             (   unit_tests.asm):00057         TSTCSAV2    EQU   APPVARS+212       ; MARKER test: CODEHERE after marker ran
     02F1             (   unit_tests.asm):00058         TSTDSAV2    EQU   APPVARS+214       ; same, DPHERE
     02F3             (   unit_tests.asm):00059         TSTVSAV2    EQU   APPVARS+216       ; same, VARHERE
     02F5             (   unit_tests.asm):00060         TSTLSAV2    EQU   APPVARS+218       ; same, LATEST
     02F7             (   unit_tests.asm):00061         TSTCBUF2    EQU   APPVARS+220       ; second 20-byte CODEHERE redirect target
                      (   unit_tests.asm):00062                                             ; See bugfix: TSTCBUF2.1
     030B             (   unit_tests.asm):00063         TSTUMID     EQU   APPVARS+240       ; U captured mid round trip (>R, 2>R)
                      (   unit_tests.asm):00064         
     030D             (   unit_tests.asm):00065         TSTOHSAV    EQU   APPVARS+242       ; saved OUTHEAD (EMIT-family tests)
                      (   unit_tests.asm):00066         
     030E             (   unit_tests.asm):00067         TSTBASAV    EQU   APPVARS+243       ; saved BASE. See bugfix: TSTBASAV.1
                      (   unit_tests.asm):00068         
     0310             (   unit_tests.asm):00069         TSTHANDSAV  EQU   APPVARS+245       ; saved HANDLER (CATCH test)
                      (   unit_tests.asm):00070         
     0312             (   unit_tests.asm):00071         TSTSISAV    EQU   APPVARS+247       ; saved SRCID (SOURCE-ID, REFILL tests)
                      (   unit_tests.asm):00072         
     CFC7             (   unit_tests.asm):00073         TSTNEG1     EQU   $CFC7             ; -12345: a non-trivial negative value
     FEBF             (   unit_tests.asm):00074         TSTNEG2     EQU   $FEBF             ; -321
                      (   unit_tests.asm):00075         
     0001             (   unit_tests.asm):00076         TSTD1HI     EQU   $0001             ; TSTDBL1 = 70000 (positive, exceeds 16
     1170             (   unit_tests.asm):00077         TSTD1LO     EQU   $1170             ; bits - exercises real double-cell width,
                      (   unit_tests.asm):00078                                             ; not just a sign-extended single)
     FFFE             (   unit_tests.asm):00079         TSTD2HI     EQU   $FFFE             ; TSTDBL2 = -70000
     EE90             (   unit_tests.asm):00080         TSTD2LO     EQU   $EE90
     00BC             (   unit_tests.asm):00081         TSTD3HI     EQU   $00BC             ; TSTDBL3 = 12345678
     614E             (   unit_tests.asm):00082         TSTD3LO     EQU   $614E
     0000             (   unit_tests.asm):00083         TSTDSHI     EQU   $0000             ; TSTDBLSMALL = 500 - small enough to fit
     01F4             (   unit_tests.asm):00084         TSTDSLO     EQU   $01F4             ; in a single cell, for D>S
                      (   unit_tests.asm):00085         

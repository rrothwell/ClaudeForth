                      (    forth6809.asm):00335         
                      (    forth6809.asm):00336         ; $0100-$0105 is unclaimed (was MVSCRATCH). See shadow MVSCRATCH.1
                      (    forth6809.asm):00337         
                      (    forth6809.asm):00338         ; ------------------------------------------------------------
                      (    forth6809.asm):00339         ; Ring buffers for serial communications.
                      (    forth6809.asm):00340         ; One for input, one for output.
                      (    forth6809.asm):00341         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00342         ; The tricks are not used.
                      (    forth6809.asm):00343         ; ------------------------------------------------------------
                      (    forth6809.asm):00344                     ORG   SERBUFCTL         ; $176.
                      (    forth6809.asm):00345         
0176                  (    forth6809.asm):00346         INHEAD      RMB   1
0177                  (    forth6809.asm):00347         INTAIL      RMB   1
                      (    forth6809.asm):00348         ; Open question moved to shadow: RTSSTATE.1
0178                  (    forth6809.asm):00349         RTSSTATE    RMB   1                 ; $00 = RTS low, $FF = RTS high
                      (    forth6809.asm):00350         
0179                  (    forth6809.asm):00351         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00352         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00353         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00354         
017C                  (    forth6809.asm):00355         FECOUNT     RMB   1                 ; framing errors
017D                  (    forth6809.asm):00356         OVRNCOUNT   RMB   1                 ; overrun count, same as above
017E                  (    forth6809.asm):00357         PECOUNT     RMB   1                 ; parity-error count, same as above
017F                  (    forth6809.asm):00358         POLLREADYCNT
017F                  (    forth6809.asm):00359                     RMB   1                 ; polling build; see shadow POLLREADYCNT.1
                      (    forth6809.asm):00360         
                      (    forth6809.asm):00361                     ORG   SERBUF            ; $180, a 64 byte boundary.
                      (    forth6809.asm):00362         
                      (    forth6809.asm):00363                     ALIGN 64                ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00364         INBUF       RMB   INBUFSZ           ; Receive circular queue buffer
                      (    forth6809.asm):00365         
                      (    forth6809.asm):00366                     ALIGN 64                ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00367         OUTBUF      RMB   OUTBUFSZ          ; Transmit circular queue buffer
                      (    forth6809.asm):00368         
                      (    forth6809.asm):00369         ; ------------------------------------------------------------
                      (    forth6809.asm):00370         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00371         ; opcode offsets) for the MAME emulation and flash memory burn.
                      (    forth6809.asm):00372         ; ------------------------------------------------------------
                      (    forth6809.asm):00373                     ORG   USROMSTRT
                      (    forth6809.asm):00374         
                      (    forth6809.asm):00375                     IFNDEF UNITTESTS
C100                  (    forth6809.asm):00376         UNITTESTS   SET   0                 ; default if -D not passed
                      (    forth6809.asm):00377                     ; Default 0: unit tests excluded; -DUNITTESTS=1 includes them.
                      (    forth6809.asm):00378                     ; Original comment: shadow UNITTESTS.1.
                      (    forth6809.asm):00379                     ENDC
                      (    forth6809.asm):00380         
                      (    forth6809.asm):00381                     IFNDEF TSTSELECTOR
C100                  (    forth6809.asm):00382         TSTSELECTOR SET   2                 ; default if -D not passed
                      (    forth6809.asm):00383                     ENDC
                      (    forth6809.asm):00384         
                      (    forth6809.asm):00385                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):00386         
                      (    forth6809.asm):00387         ; ------------------------------------------------------------
                      (    forth6809.asm):00388         ; The unit test framework itself (explanatory comment plus all
                      (    forth6809.asm):00389         ; test code) lives in unit_tests.asm, a separate file included
                      (    forth6809.asm):00390         ; here only when UNITTESTS is nonzero - see unit_tests.asm for
                      (    forth6809.asm):00391         ; the full framework description, or OPEN_ITEMS_CHECKLIST_
                      (    forth6809.asm):00392         ; part1.md/part2.md for its own development history.
                      (    forth6809.asm):00393         ; ------------------------------------------------------------
                      (    forth6809.asm):00394                     INCLUDE unit_tests.asm
                      (    forth6809.asm):00395         
                      (    forth6809.asm):00396                     ENDC                    ; <<<<<<<<<<

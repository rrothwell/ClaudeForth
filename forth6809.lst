                      (    forth6809.asm):05660         ; ------------------------------------------------------------
E3BD CCBD00           (    forth6809.asm):05661         DEPTHW:     LDD   #SP0
E3C0 3440             (    forth6809.asm):05662                     PSHS  U
E3C2 A3E1             (    forth6809.asm):05663                     SUBD  ,S++
E3C4 44               (    forth6809.asm):05664                     LSRA
E3C5 56               (    forth6809.asm):05665                     RORB
E3C6 3606             (    forth6809.asm):05666                     PSHU  D                 ; +n
E3C8 39               (    forth6809.asm):05667                     RTS
                      (    forth6809.asm):05668         
                      (    forth6809.asm):05669         ; ------------------------------------------------------------
                      (    forth6809.asm):05670         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )
                      (    forth6809.asm):05671         ; Duplicate the top cell pair.
                      (    forth6809.asm):05672         ; ------------------------------------------------------------
E3C9 EC42             (    forth6809.asm):05673         DDUPW:      LDD   2,U               ; x1
E3CB AEC4             (    forth6809.asm):05674                     LDX   ,U                ; x2
E3CD 3606             (    forth6809.asm):05675                     PSHU  D
E3CF 3610             (    forth6809.asm):05676                     PSHU  X
E3D1 39               (    forth6809.asm):05677                     RTS
                      (    forth6809.asm):05678         
                      (    forth6809.asm):05679         ; ------------------------------------------------------------
                      (    forth6809.asm):05680         ; 2DROP  ( x1 x2 -- )
                      (    forth6809.asm):05681         ; Discard the top cell pair.

                      (   unit_tests.asm):14559         ; ------------------------------------------------------------
                      (   unit_tests.asm):14560         ; Exception Handling test harness (glossary section 3.15).
                      (   unit_tests.asm):14561         ; CATCH/THROW have already been used extensively as this whole
                      (   unit_tests.asm):14562         ; session's own error-testing mechanism throughout sections
                      (   unit_tests.asm):14563         ; 3.8-3.14, so their correctness has substantial indirect
                      (   unit_tests.asm):14564         ; evidence already - this section still gets its own, direct
                      (   unit_tests.asm):14565         ; tests, matching the established practice of every section
                      (   unit_tests.asm):14566         ; getting dedicated coverage rather than relying on incidental
                      (   unit_tests.asm):14567         ; use elsewhere.
                      (   unit_tests.asm):14568         ;
                      (   unit_tests.asm):14569         ; Critical safety constraint, confirmed by reading THROW's own
                      (   unit_tests.asm):14570         ; code directly: with no active CATCH, THROW jumps straight to
                      (   unit_tests.asm):14571         ; ABORT (already established elsewhere in this session as unsafe
                      (   unit_tests.asm):14572         ; to trigger directly - it resets the return stack, destroying
                      (   unit_tests.asm):14573         ; this whole test framework's own call chain). Every THROW in
                      (   unit_tests.asm):14574         ; this section's own tests is either wrapped in a genuine,
                      (   unit_tests.asm):14575         ; active CATCH, or is a THROW(0) call - confirmed via CATCH's own
                      (   unit_tests.asm):14576         ; code to be a pure no-op that never touches HANDLER or ABORT at
                      (   unit_tests.asm):14577         ; all, so that specific case is safe to call directly.
                      (   unit_tests.asm):14578         ; ------------------------------------------------------------

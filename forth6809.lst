F4E1 A780             (    forth6809.asm):06624                     STA   ,X+
F4E3 AF64             (    forth6809.asm):06625                     STX   4,S
F4E5 20CD             (    forth6809.asm):06626                     BRA   SQEL
F4E7 AE64             (    forth6809.asm):06627         SQEM:       LDX   4,S
F4E9 860D             (    forth6809.asm):06628                     LDA   #13
F4EB A780             (    forth6809.asm):06629                     STA   ,X+
F4ED 860A             (    forth6809.asm):06630                     LDA   #10
F4EF A780             (    forth6809.asm):06631                     STA   ,X+
F4F1 AF64             (    forth6809.asm):06632                     STX   4,S
F4F3 20BF             (    forth6809.asm):06633                     BRA   SQEL
F4F5 8D1A             (    forth6809.asm):06634         SQEHEX:     BSR   SQEHD             ; first digit
F4F7 25BB             (    forth6809.asm):06635                     BCS   SQEL              ; none: nothing is added

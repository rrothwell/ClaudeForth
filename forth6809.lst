                      (   unit_tests.asm):06868         ; TSTEXIT - unit test for EXIT. Compiles
                      (   unit_tests.asm):06869         ; "DO I 3 = IF UNLOOP EXIT THEN I + LOOP", limit=10, start=0,
                      (   unit_tests.asm):06870         ; seed sum=0 - EXIT fires when I=3. EXIT no longer discards
                      (   unit_tests.asm):06871         ; loop frames (standard: UNLOOP first), so the test calls UNLOOP
                      (   unit_tests.asm):06872         ; itself right before EXIT, then EXIT returns immediately.
                      (   unit_tests.asm):06873         ; (Rewritten: it used to rely on EXIT discarding the open DO
                      (   unit_tests.asm):06874         ; frame, which made EXIT return through the stale loop cells.)
                      (   unit_tests.asm):06875         ; Sets the real CSP to U's value right before the first control-flow marker is pushed
                      (   unit_tests.asm):06876         ; (matching what ":" does at the start of a real definition),
                      (   unit_tests.asm):06877         ; since EXIT's own compile-time frame count depends on it -
                      (   unit_tests.asm):06878         ; confirmed by hand-trace: at the point EXIT is compiled, U
                      (   unit_tests.asm):06879         ; holds IF's own pending (addr,TAGFWD) on top of DO's
                      (   unit_tests.asm):06880         ; (addr,TAGDO), and EXIT's scan correctly counts exactly one
                      (   unit_tests.asm):06881         ; TAGDO between U and CSP. Unlike TSTLEAVE, EXIT fires
                      (   unit_tests.asm):06882         ; immediately when reached - the following + never runs for
                      (   unit_tests.asm):06883         ; I=3, so sum=0+1+2=3, not 6.
                      (   unit_tests.asm):06884         ; ------------------------------------------------------------

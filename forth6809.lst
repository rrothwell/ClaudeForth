                      (    forth6809.asm):01246                    CMPA #32
                      (    forth6809.asm):01247                    BNE  SSFAIL
                      (    forth6809.asm):01248                    INCB
                      (    forth6809.asm):01249                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01250                    LDA  B,X
                      (    forth6809.asm):01251                    CMPA #32
                      (    forth6809.asm):01252                    BNE  SSFAIL
                      (    forth6809.asm):01253                    INCB
                      (    forth6809.asm):01254                    ANDB #OUTBUFSZ-1

F70D DDAB             (    forth6809.asm):06561                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):06562                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):06563                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):06564                                   ; real source length was misread as an
                      (    forth6809.asm):06565                                   ; address, the real source address was never
                      (    forth6809.asm):06566                                   ; popped at all, and the true destination
                      (    forth6809.asm):06567                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):06568                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):06569                                   ; c-addr2 (dest) is on top, popped first.
F70F 3706             (    forth6809.asm):06570                    PULU D         ; next: u1 (source length)
F711 DDA9             (    forth6809.asm):06571                    STD  UESRCLEN

                      (    forth6809.asm):07817                                             ; MAX-UD
FBDF 0000             (    forth6809.asm):07818                     FDB   0
FBE1 4D41582D44       (    forth6809.asm):07819         EN11:       FCC   "MAX-D"
     0005             (    forth6809.asm):07820         EN11L       EQU   *-EN11
FBE6 4D41582D5544     (    forth6809.asm):07821         EN12:       FCC   "MAX-UD"
     0006             (    forth6809.asm):07822         EN12L       EQU   *-EN12

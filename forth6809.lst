                      (    forth6809.asm):01911         
DE26 8510             (    forth6809.asm):01912                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DE28 2703             (    forth6809.asm):01913                     BEQ   INXFE             ; Tally each flagged error independently -
DE2A 7C017C           (    forth6809.asm):01914                     INC   FECOUNT           ; more than one bit can be set at once.
DE2D 8520             (    forth6809.asm):01915         INXFE:      BITA  #SR_OVRN

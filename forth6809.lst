                      (    forth6809.asm):09512         ; SECTION 28: DISASSEMBLER AND DECOMPILER (DASM, DIS, SEE)
                      (    forth6809.asm):09513         ; ============================================================
                      (    forth6809.asm):09514         ; Optional: DISASM adds DASM and DIS, DECOMP adds SEE (which needs
                      (    forth6809.asm):09515         ; DISASM). Design notes: see shadow DISASM.1 and DECOMP.1.
                      (    forth6809.asm):09516                     IFNE  DISASM
                      (    forth6809.asm):09517         ; ------------------------------------------------------------
                      (    forth6809.asm):09518         ; DISASM: 6809 disassembler (hexadecimal, lwasm style).
                      (    forth6809.asm):09519         ;
                      (    forth6809.asm):09520         ; DASM  ( addr -- addr' )   Send one instruction as text, for example
                      (    forth6809.asm):09521         ;       LDA #$A5  or  LDX <$7B  or  STA $0A,X  or  BRA $4010, and return
                      (    forth6809.asm):09522         ;       the address of the next instruction. Branch and PC-relative
                      (    forth6809.asm):09523         ;       operands show the absolute target address. A byte that is not
                      (    forth6809.asm):09524         ;       a legal instruction shows as FCB $xx and is one byte long.
                      (    forth6809.asm):09525         ; DIS   ( addr u -- )       List the instructions that start in
                      (    forth6809.asm):09526         ;       addr .. addr+u-1, one per line: address, bytes, text.
                      (    forth6809.asm):09527         ;
                      (    forth6809.asm):09528         ; The decoder is table driven: the name pool and the tables follow the
                      (    forth6809.asm):09529         ; code. Every character goes out through DCH, which is silenced while
                      (    forth6809.asm):09530         ; DISMUTE is non-zero so that DIS can measure an instruction first.
                      (    forth6809.asm):09531         ; ------------------------------------------------------------
F4E7 0D9D             (    forth6809.asm):09532         DCH:        TST   DISMUTE
F4E9 2608             (    forth6809.asm):09533                     BNE   DCHX
F4EB 1F89             (    forth6809.asm):09534                     TFR   A,B
F4ED 4F               (    forth6809.asm):09535                     CLRA
F4EE 3606             (    forth6809.asm):09536                     PSHU  D
F4F0 7ED94E           (    forth6809.asm):09537                     JMP   EMITW             ; EMITW returns to our caller
F4F3 39               (    forth6809.asm):09538         DCHX:       RTS
                      (    forth6809.asm):09539         
F4F4 8B30             (    forth6809.asm):09540         DNIB:       ADDA  #'0'              ; A = 0..15 -> one hex digit
F4F6 8139             (    forth6809.asm):09541                     CMPA  #'9'
F4F8 23ED             (    forth6809.asm):09542                     BLS   DCH
F4FA 8B07             (    forth6809.asm):09543                     ADDA  #7
F4FC 20E9             (    forth6809.asm):09544                     BRA   DCH
                      (    forth6809.asm):09545         
F4FE 3402             (    forth6809.asm):09546         DHEXA:      PSHS  A                 ; A as two hex digits

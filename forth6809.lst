D86C 43               (    forth6809.asm):04340                     COMA
D86D 53               (    forth6809.asm):04341                     COMB
D86E C30001           (    forth6809.asm):04342                     ADDD  #1
D871 ED42             (    forth6809.asm):04343                     STD   2,U
D873 2407             (    forth6809.asm):04344                     BCC   NQPOS32
D875 ECC4             (    forth6809.asm):04345                     LDD   ,U
D877 C30001           (    forth6809.asm):04346                     ADDD  #1
D87A EDC4             (    forth6809.asm):04347                     STD   ,U
                      (    forth6809.asm):04348         
D87C                  (    forth6809.asm):04349         NQPOS32:                            ; re-derive from the original c-addr whether the
                      (    forth6809.asm):04350                     ; last character was '.' - determines which return convention
D87C AEE4             (    forth6809.asm):04351                     LDX   ,S
D87E E684             (    forth6809.asm):04352                     LDB   ,X
D880 5A               (    forth6809.asm):04353                     DECB
D881 3001             (    forth6809.asm):04354                     LEAX  1,X
D883 A685             (    forth6809.asm):04355                     LDA   B,X

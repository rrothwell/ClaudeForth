                      (    forth6809.asm):01919         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):01920         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):01921         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):01922         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):01923         ; IRQH
                      (    forth6809.asm):01924         ;    Inputs:
                      (    forth6809.asm):01925         ;        none (hardware interrupt entry)
                      (    forth6809.asm):01926         ;    Outputs:
                      (    forth6809.asm):01927         ;        none (returns with RTI)
                      (    forth6809.asm):01928         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):01929         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):01930         ; ------------------------------------------------------------
DD3B B6C008           (    forth6809.asm):01931         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):01932         
DD3E 8580             (    forth6809.asm):01933                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
DD40 2708             (    forth6809.asm):01934                     BEQ   IRQDONE0          ; No! Just exit.
DD42 8501             (    forth6809.asm):01935                     BITA  #SR_RDRF          ; Is an incoming character available?
DD44 2605             (    forth6809.asm):01936                     BNE   INCHAR
DD46 8502             (    forth6809.asm):01937                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
DD48 263C             (    forth6809.asm):01938                     BNE   OUTCHAR
                      (    forth6809.asm):01939                                             ; Ignore all other interrupts such as DCD change.
DD4A 3B               (    forth6809.asm):01940         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):01941                                             ; & restores state.
                      (    forth6809.asm):01942         
DD4B                  (    forth6809.asm):01943         INCHAR:

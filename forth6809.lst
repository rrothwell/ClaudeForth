                      (    forth6809.asm):03095                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03096                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03097                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03098                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03099                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03100                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03101                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03102                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03103                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03104                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03105                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03106                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03107                  ; for it.
E591 D621             (    forth6809.asm):03108                  LDB   CNTREM
E593 5A               (    forth6809.asm):03109                  DECB
E594 A685             (    forth6809.asm):03110                  LDA   B,X
E596 812E             (    forth6809.asm):03111                  CMPA  #'.'
E598 2604             (    forth6809.asm):03112                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):03113                  DEC   CNTREM
E59C 2766             (    forth6809.asm):03114                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03115         
E59E 0F22             (    forth6809.asm):03116         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):03117                  LDA   ,X
E5A2 812D             (    forth6809.asm):03118                  CMPA  #'-'
E5A4 2608             (    forth6809.asm):03119                  BNE   NQNOSIGN2
E5A6 0322             (    forth6809.asm):03120                  COM   NUMNEG
E5A8 3001             (    forth6809.asm):03121                  LEAX  1,X
E5AA 0A21             (    forth6809.asm):03122                  DEC   CNTREM
E5AC 2756             (    forth6809.asm):03123                  BEQ   NQBAD
                      (    forth6809.asm):03124         

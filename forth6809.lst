                      (    forth6809.asm):01669         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01670         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01671         ; ------------------------------------------------------------

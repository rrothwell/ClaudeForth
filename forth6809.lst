                      (    forth6809.asm):01204         
                      (    forth6809.asm):01205         ; ------------------------------------------------------------
                      (    forth6809.asm):01206         ; TSTSPACES - unit test for SPACES, normal (n=3) case. Verifies
                      (    forth6809.asm):01207         ; all three queued bytes are genuinely spaces (32), not just
                      (    forth6809.asm):01208         ; that OUTHEAD advanced by the right count.
                      (    forth6809.asm):01209         ; ------------------------------------------------------------
C17C                  (    forth6809.asm):01210         TSTSPACES: STU  TSTU0
                      (    forth6809.asm):01211         
                      (    forth6809.asm):01212                    IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01213                    LDA  OUTHEAD
                      (    forth6809.asm):01214                    STA  TSTOHSAV
                      (    forth6809.asm):01215                    ENDC ; <<<<
                      (    forth6809.asm):01216         
                      (    forth6809.asm):01217                    LDD  #TSTGUARD
                      (    forth6809.asm):01218                    PSHU D
                      (    forth6809.asm):01219                    LDD  #3
                      (    forth6809.asm):01220                    PSHU D
                      (    forth6809.asm):01221                    STU  TSTUB4
                      (    forth6809.asm):01222         
                      (    forth6809.asm):01223                    JSR  SPACESW
                      (    forth6809.asm):01224         
                      (    forth6809.asm):01225                    STU  TSTUAF
                      (    forth6809.asm):01226         
                      (    forth6809.asm):01227                    IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01228                                     ; queues all three bytes into OUTBUF,
                      (    forth6809.asm):01229                                     ; verifiable individually
                      (    forth6809.asm):01230                    LDA  TSTOHSAV
                      (    forth6809.asm):01231                    ADDA #3
                      (    forth6809.asm):01232                    ANDA #OUTBUFSZ-1
                      (    forth6809.asm):01233                    CMPA OUTHEAD
                      (    forth6809.asm):01234                    BNE  SSFAIL
                      (    forth6809.asm):01235         
                      (    forth6809.asm):01236                    LDX  #OUTBUF
                      (    forth6809.asm):01237                    LDB  TSTOHSAV
                      (    forth6809.asm):01238                    LDA  B,X
                      (    forth6809.asm):01239                    CMPA #32
                      (    forth6809.asm):01240                    BNE  SSFAIL
                      (    forth6809.asm):01241                    INCB
                      (    forth6809.asm):01242                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01243                    LDA  B,X
                      (    forth6809.asm):01244                    CMPA #32
                      (    forth6809.asm):01245                    BNE  SSFAIL
                      (    forth6809.asm):01246                    INCB
                      (    forth6809.asm):01247                    ANDB #OUTBUFSZ-1
                      (    forth6809.asm):01248                    LDA  B,X
                      (    forth6809.asm):01249                    CMPA #32
                      (    forth6809.asm):01250                    BNE  SSFAIL
                      (    forth6809.asm):01251                    ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking
                      (    forth6809.asm):01252                                     ; OUTHEAD/OUTBUF - same fix and reasoning as
                      (    forth6809.asm):01253                                     ; TSTCR's own fix. In polling mode, EMITCH
                      (    forth6809.asm):01254                                     ; only reflects the LAST of the three
                      (    forth6809.asm):01255                                     ; identical spaces emitted, and there is no
                      (    forth6809.asm):01256                                     ; persistent per-call count to verify
                      (    forth6809.asm):01257                                     ; exactly three calls happened, not just
                      (    forth6809.asm):01258                                     ; one or two - a genuine limitation of a

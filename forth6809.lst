                      (    forth6809.asm):03893         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03894         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03895         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03896         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03897         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03898         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03899         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03900         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03901         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03902         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03903         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03904         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03905         TSTDARITH: JSR   CRW
                      (    forth6809.asm):03906                    LDX   #TSTDARITHMSG
                      (    forth6809.asm):03907                    PSHU  X
                      (    forth6809.asm):03908                    LDD   #11
                      (    forth6809.asm):03909                    PSHU  D
                      (    forth6809.asm):03910                    JSR   TYPE
                      (    forth6809.asm):03911                    JSR   CRW
                      (    forth6809.asm):03912         
                      (    forth6809.asm):03913                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03914         
                      (    forth6809.asm):03915                    JSR   TSTUMST
                      (    forth6809.asm):03916                    JSR   TSTUMSM
                      (    forth6809.asm):03917                    JSR   TSTUMSZ
                      (    forth6809.asm):03918                    JSR   TSTMSTAR
                      (    forth6809.asm):03919                    JSR   TSTFMSM
                      (    forth6809.asm):03920                    JSR   TSTFMSZ
                      (    forth6809.asm):03921                    JSR   TSTSMRM
                      (    forth6809.asm):03922                    JSR   TSTSMRZ
                      (    forth6809.asm):03923                    JSR   TSTDPLUS
                      (    forth6809.asm):03924                    JSR   TSTDMIN2
                      (    forth6809.asm):03925                    JSR   TSTDNEG
                      (    forth6809.asm):03926                    JSR   TSTDABS1
                      (    forth6809.asm):03927                    JSR   TSTDABS2
                      (    forth6809.asm):03928                    JSR   TSTMPLUS
                      (    forth6809.asm):03929                    JSR   TSTSTOD
                      (    forth6809.asm):03930                    JSR   TSTDTOS
                      (    forth6809.asm):03931                    JSR   TSTDMAX
                      (    forth6809.asm):03932                    JSR   TSTDMIN
                      (    forth6809.asm):03933         
                      (    forth6809.asm):03934                    ENDC ; <<<<
                      (    forth6809.asm):03935         
                      (    forth6809.asm):03936                    RTS
                      (    forth6809.asm):03937         
C100                  (    forth6809.asm):03938         TSTDARITHMSG: FCC "DArithmetic"
                      (    forth6809.asm):03939         
                      (    forth6809.asm):03940                    IFEQ TSTSELECTOR-4  ; >>>>
                      (    forth6809.asm):03941         

                      (    forth6809.asm):07403         ; TSTUNLOOP - unit test for UNLOOP. A true no-op (bare RTS) per
                      (    forth6809.asm):07404         ; its own extensively-documented design history in the source -
                      (    forth6809.asm):07405         ; superseded by EXIT's own automatic frame-discarding, kept
                      (    forth6809.asm):07406         ; only for source compatibility. Not compile-time/immediate
                      (    forth6809.asm):07407         ; like the rest of this section - a plain runtime word, tested
                      (    forth6809.asm):07408         ; directly without the compile harness, same pattern as ALIGN's
                      (    forth6809.asm):07409         ; own test in section 3.6: pushes decoy values, calls UNLOOP,
                      (    forth6809.asm):07410         ; confirms the whole stack is genuinely undisturbed.
                      (    forth6809.asm):07411         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):07412         TSTUNLOOP: STU  TSTU0
                      (    forth6809.asm):07413         
                      (    forth6809.asm):07414                    LDD  #TSTGUARD
                      (    forth6809.asm):07415                    PSHU D
                      (    forth6809.asm):07416                    LDD  #TSTVAL1
                      (    forth6809.asm):07417                    PSHU D
                      (    forth6809.asm):07418                    LDD  #TSTVAL2
                      (    forth6809.asm):07419                    PSHU D
                      (    forth6809.asm):07420                    STU  TSTUB4
                      (    forth6809.asm):07421         
                      (    forth6809.asm):07422                    JSR  UNLOOP
                      (    forth6809.asm):07423         
                      (    forth6809.asm):07424                    STU  TSTUAF
                      (    forth6809.asm):07425         
                      (    forth6809.asm):07426                    PULU D
                      (    forth6809.asm):07427                    CMPD #TSTVAL2
                      (    forth6809.asm):07428                    BNE  UOFAIL
                      (    forth6809.asm):07429                    PULU D
                      (    forth6809.asm):07430                    CMPD #TSTVAL1
                      (    forth6809.asm):07431                    BNE  UOFAIL
                      (    forth6809.asm):07432                    PULU D
                      (    forth6809.asm):07433                    CMPD #TSTGUARD
                      (    forth6809.asm):07434                    BNE  UOFAIL
                      (    forth6809.asm):07435         
                      (    forth6809.asm):07436                    LDD  TSTUB4
                      (    forth6809.asm):07437                    SUBD TSTUAF
                      (    forth6809.asm):07438                    CMPD #0
                      (    forth6809.asm):07439                    BNE  UOFAIL
                      (    forth6809.asm):07440         
                      (    forth6809.asm):07441                    LDD  #TRUEV
                      (    forth6809.asm):07442                    BRA  UODONE
C23C                  (    forth6809.asm):07443         UOFAIL:    LDD  #FALSEV
C23C                  (    forth6809.asm):07444         UODONE:    LDX  #TSTUNLOOPNAME
                      (    forth6809.asm):07445                    PSHU X
                      (    forth6809.asm):07446                    PSHU D

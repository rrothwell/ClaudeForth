                      (    forth6809.asm):00361         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00362         ;
                      (    forth6809.asm):00363         ; One header per word, chained by LINK, placed at BASEDICT. Each
                      (    forth6809.asm):00364         ; header is: length|flags, name, LINK, CFA. Every CFA is the word's
                      (    forth6809.asm):00365         ; own code label (raw code entries, no trampoline), including TRUE
                      (    forth6809.asm):00366         ; and FALSE. DOES> is next to CREATE; its code label is DOESGTW
                      (    forth6809.asm):00367         ; because ">" is not valid in a label. ABORT and QUIT are
                      (    forth6809.asm):00368         ; hand-built at the end of the section.
                      (    forth6809.asm):00369         ;
                      (    forth6809.asm):00370         ; Names containing a double-quote (S", ." and ABORT") have it split
                      (    forth6809.asm):00371         ; out of the FCC into a separate FCB $22.
                      (    forth6809.asm):00372         ; The original header comment is shadow SECTION27.0.
                      (    forth6809.asm):00373         ; ============================================================

                      (    forth6809.asm):04803         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04804         ; location.
                      (    forth6809.asm):04805         ; PATCH   ( target location -- )
                      (    forth6809.asm):04806         ;    Inputs:
                      (    forth6809.asm):04807         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04808         ;    Outputs:

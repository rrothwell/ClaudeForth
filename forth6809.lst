                      (    forth6809.asm):15079         
                      (    forth6809.asm):15080         ; ------------------------------------------------------------
                      (    forth6809.asm):15081         ; TSTEXCEPTION - exception handling tests (glossary section
                      (    forth6809.asm):15082         ; 3.15, 2 words, 4 tests since CATCH/THROW can only be
                      (    forth6809.asm):15083         ; meaningfully tested together - THROW's own effect is only
                      (    forth6809.asm):15084         ; observable through a CATCH that traps it). Already used
                      (    forth6809.asm):15085         ; extensively as this whole session's own error-testing
                      (    forth6809.asm):15086         ; mechanism throughout sections 3.8-3.14, so their correctness
                      (    forth6809.asm):15087         ; has substantial indirect evidence already; this section still
                      (    forth6809.asm):15088         ; gets its own, direct, dedicated tests.
                      (    forth6809.asm):15089         ;
                      (    forth6809.asm):15090         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15091         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15092         ; ABORT (unsafe to trigger directly - it resets the return
                      (    forth6809.asm):15093         ; stack, destroying this whole test framework's own call chain,
                      (    forth6809.asm):15094         ; per section 3.1's own established reasoning). Every THROW in
                      (    forth6809.asm):15095         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15096         ; active CATCH (via a dedicated internal helper, TSTTHROWHLP,
                      (    forth6809.asm):15097         ; that only ever gets invoked that way), or is a THROW(0) call -
                      (    forth6809.asm):15098         ; confirmed via THROW's own code to be a pure, unconditional
                      (    forth6809.asm):15099         ; no-op that never touches HANDLER or ABORT at all, so that one
                      (    forth6809.asm):15100         ; specific case is safe to call directly.
                      (    forth6809.asm):15101         ;
                      (    forth6809.asm):15102         ; TSTCATCHTHROW specifically verifies the two dummy values
                      (    forth6809.asm):15103         ; TSTTHROWHLP pushes before throwing are genuinely gone
                      (    forth6809.asm):15104         ; afterward, confirming CATCH's own documented "restores data
                      (    forth6809.asm):15105         ; stack depth... on either path" for real. TSTHANDLERSAVE
                      (    forth6809.asm):15106         ; verifies the HANDLER half of that same documented guarantee
                      (    forth6809.asm):15107         ; directly, by reading HANDLER itself before and after CATCH
                      (    forth6809.asm):15108         ; calls on both the success and throw paths, rather than only
                      (    forth6809.asm):15109         ; inferring it from stack-level behavior.
                      (    forth6809.asm):15110         ; ------------------------------------------------------------
C2EB BDFC2B           (    forth6809.asm):15111         TSTEXCEPTION: JSR CRW
C2EE 8EC2FF           (    forth6809.asm):15112                    LDX   #TSTEXCMSG
C2F1 3610             (    forth6809.asm):15113                    PSHU  X
C2F3 CC0006           (    forth6809.asm):15114                    LDD   #6
C2F6 3606             (    forth6809.asm):15115                    PSHU  D
C2F8 BDF60B           (    forth6809.asm):15116                    JSR   TYPE
C2FB BDFC2B           (    forth6809.asm):15117                    JSR   CRW
                      (    forth6809.asm):15118         
                      (    forth6809.asm):15119                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15120         
                      (    forth6809.asm):15121                    JSR   TSTCATCHOK
                      (    forth6809.asm):15122                    JSR   TSTCATCHTHROW
                      (    forth6809.asm):15123                    JSR   TSTTHROWZERO
                      (    forth6809.asm):15124                    JSR   TSTHANDLERSAVE
                      (    forth6809.asm):15125         
                      (    forth6809.asm):15126                    ENDC ; <<<<
                      (    forth6809.asm):15127         
C2FE 39               (    forth6809.asm):15128                    RTS
                      (    forth6809.asm):15129         
C2FF 457863657074     (    forth6809.asm):15130         TSTEXCMSG: FCC "Except"
                      (    forth6809.asm):15131         
                      (    forth6809.asm):15132                    IFEQ TSTSELECTOR-14  ; >>>>
                      (    forth6809.asm):15133         
                      (    forth6809.asm):15134         ; ------------------------------------------------------------
                      (    forth6809.asm):15135         ; Exception Handling test harness (glossary section 3.15).
                      (    forth6809.asm):15136         ; CATCH/THROW have already been used extensively as this whole
                      (    forth6809.asm):15137         ; session's own error-testing mechanism throughout sections
                      (    forth6809.asm):15138         ; 3.8-3.14, so their correctness has substantial indirect
                      (    forth6809.asm):15139         ; evidence already - this section still gets its own, direct
                      (    forth6809.asm):15140         ; tests, matching the established practice of every section
                      (    forth6809.asm):15141         ; getting dedicated coverage rather than relying on incidental
                      (    forth6809.asm):15142         ; use elsewhere.
                      (    forth6809.asm):15143         ;
                      (    forth6809.asm):15144         ; Critical safety constraint, confirmed by reading THROW's own
                      (    forth6809.asm):15145         ; code directly: with no active CATCH, THROW jumps straight to
                      (    forth6809.asm):15146         ; ABORT (already established elsewhere in this session as unsafe
                      (    forth6809.asm):15147         ; to trigger directly - it resets the return stack, destroying
                      (    forth6809.asm):15148         ; this whole test framework's own call chain). Every THROW in
                      (    forth6809.asm):15149         ; this section's own tests is either wrapped in a genuine,
                      (    forth6809.asm):15150         ; active CATCH, or is a THROW(0) call - confirmed via CATCH's own
                      (    forth6809.asm):15151         ; code to be a pure no-op that never touches HANDLER or ABORT at
                      (    forth6809.asm):15152         ; all, so that specific case is safe to call directly.
                      (    forth6809.asm):15153         ; ------------------------------------------------------------
                      (    forth6809.asm):15154         
                      (    forth6809.asm):15155         ; ------------------------------------------------------------
                      (    forth6809.asm):15156         ; TSTCATCHOK - unit test for CATCH, success path. Wraps DUP (a
                      (    forth6809.asm):15157         ; genuine, real dictionary word, not a synthetic stand-in) and
                      (    forth6809.asm):15158         ; verifies both that DUP's own effect genuinely happened (the
                      (    forth6809.asm):15159         ; value really was duplicated) and that CATCH itself returns 0.
                      (    forth6809.asm):15160         ; ------------------------------------------------------------
C305                  (    forth6809.asm):15161         TSTCATCHOK: STU  TSTU0
                      (    forth6809.asm):15162         
                      (    forth6809.asm):15163                     LDD  #TSTGUARD
                      (    forth6809.asm):15164                     PSHU D
                      (    forth6809.asm):15165                     LDD  #TSTVAL1
                      (    forth6809.asm):15166                     PSHU D
                      (    forth6809.asm):15167                     LDX  #DUP
                      (    forth6809.asm):15168                     PSHU X
                      (    forth6809.asm):15169                     STU  TSTUB4
                      (    forth6809.asm):15170         
                      (    forth6809.asm):15171                     JSR  CATCH
                      (    forth6809.asm):15172         
                      (    forth6809.asm):15173                     STU  TSTUAF
                      (    forth6809.asm):15174         
                      (    forth6809.asm):15175                     PULU D
                      (    forth6809.asm):15176                     CMPD #0
                      (    forth6809.asm):15177                     BNE  COFAIL
                      (    forth6809.asm):15178                     PULU D
                      (    forth6809.asm):15179                     CMPD #TSTVAL1
                      (    forth6809.asm):15180                     BNE  COFAIL
                      (    forth6809.asm):15181                     PULU D
                      (    forth6809.asm):15182                     CMPD #TSTVAL1
                      (    forth6809.asm):15183                     BNE  COFAIL
                      (    forth6809.asm):15184                     PULU D
                      (    forth6809.asm):15185                     CMPD #TSTGUARD
                      (    forth6809.asm):15186                     BNE  COFAIL
                      (    forth6809.asm):15187         
                      (    forth6809.asm):15188                     LDD  TSTUB4
                      (    forth6809.asm):15189                     SUBD TSTUAF
                      (    forth6809.asm):15190                     CMPD #2
                      (    forth6809.asm):15191                     BNE  COFAIL
                      (    forth6809.asm):15192         
                      (    forth6809.asm):15193                     LDD  #TRUEV
                      (    forth6809.asm):15194                     BRA  CODONE
C305                  (    forth6809.asm):15195         COFAIL:     LDD  #FALSEV
C305                  (    forth6809.asm):15196         CODONE:     LDX  #TSTCONAME
                      (    forth6809.asm):15197                     PSHU X
                      (    forth6809.asm):15198                     PSHU D
                      (    forth6809.asm):15199                     JSR  TSTREPORT
                      (    forth6809.asm):15200         

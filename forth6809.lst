                      (    forth6809.asm):09766                   STD  TSTFHDR+4
                      (    forth6809.asm):09767                   LDD  #DUP
                      (    forth6809.asm):09768                   STD  TSTFHDR+6
                      (    forth6809.asm):09769         
                      (    forth6809.asm):09770                   LDA  #'F'

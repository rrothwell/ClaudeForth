                      (    forth6809.asm):03852         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03853         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03854         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03855         ; ------------------------------------------------------------
E5FF CCDDEC           (    forth6809.asm):03856         WHILEW:     LDD   #ZBRANCH
E602 3606             (    forth6809.asm):03857                     PSHU  D
E604 BDE931           (    forth6809.asm):03858                     JSR   CCALL
E607 CC0000           (    forth6809.asm):03859                     LDD   #0
E60A 3606             (    forth6809.asm):03860                     PSHU  D
E60C BDDE76           (    forth6809.asm):03861                     JSR   CODECOMMA
E60F DC08             (    forth6809.asm):03862                     LDD   CODEHERE
E611 830002           (    forth6809.asm):03863                     SUBD  #2
E614 3606             (    forth6809.asm):03864                     PSHU  D                 ; orig
E616 CC0001           (    forth6809.asm):03865                     LDD   #TAGFWD
E619 3606             (    forth6809.asm):03866                     PSHU  D
E61B 39               (    forth6809.asm):03867                     RTS
                      (    forth6809.asm):03868         
                      (    forth6809.asm):03869         ; ------------------------------------------------------------
                      (    forth6809.asm):03870         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03871         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03872         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03873         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03874         ; ------------------------------------------------------------
E61C 3706             (    forth6809.asm):03875         REPEATW:    PULU  D
E61E 10830001         (    forth6809.asm):03876                     CMPD  #TAGFWD
E622 2703             (    forth6809.asm):03877                     BEQ   RPOK1
E624 BDE4C1           (    forth6809.asm):03878                     JSR   CFERR
E627 3710             (    forth6809.asm):03879         RPOK1:      PULU  X                 ; orig
E629 3410             (    forth6809.asm):03880                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03881         
                      (    forth6809.asm):03882                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03883                     ; See bugfix: REPEATW.1
E62B 3040             (    forth6809.asm):03884                     LEAX  0,U               ; scan from top of control stack
E62D 9F16             (    forth6809.asm):03885                     STX   MSCR2             ; MSCR2 = base of scan region
E62F 9F1A             (    forth6809.asm):03886                     STX   MSCR4             ; MSCR4 = scan pointer
E631 DC1A             (    forth6809.asm):03887         RPSCAN:     LDD   MSCR4
E633 109321           (    forth6809.asm):03888                     CMPD  CSP
E636 2603             (    forth6809.asm):03889                     BNE   RPSCANOK
E638 BDE4C1           (    forth6809.asm):03890                     JSR   CFERR             ; no matching BEGIN
E63B 9E1A             (    forth6809.asm):03891         RPSCANOK:   LDX   MSCR4
E63D EC84             (    forth6809.asm):03892                     LDD   ,X
E63F 10830002         (    forth6809.asm):03893                     CMPD  #TAGBACK
E643 2712             (    forth6809.asm):03894                     BEQ   RPFOUND
E645 10830001         (    forth6809.asm):03895                     CMPD  #TAGFWD
E649 2703             (    forth6809.asm):03896                     BEQ   RPSKIP
E64B BDE4C1           (    forth6809.asm):03897                     JSR   CFERR             ; anything else is a genuine mismatch
E64E DC1A             (    forth6809.asm):03898         RPSKIP:     LDD   MSCR4
E650 C30004           (    forth6809.asm):03899                     ADDD  #4
E653 DD1A             (    forth6809.asm):03900                     STD   MSCR4
E655 20DA             (    forth6809.asm):03901                     BRA   RPSCAN
E657 9E1A             (    forth6809.asm):03902         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E659 EC02             (    forth6809.asm):03903                     LDD   2,X               ; dest = BEGIN's address
E65B 3406             (    forth6809.asm):03904                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03905         
                      (    forth6809.asm):03906                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03907                     ; bytes, highest word first.
E65D DC1A             (    forth6809.asm):03908                     LDD   MSCR4
E65F 9316             (    forth6809.asm):03909                     SUBD  MSCR2
E661 DD18             (    forth6809.asm):03910                     STD   MSCR3             ; MSCR3 = bytes to shift
E663 2715             (    forth6809.asm):03911                     BEQ   RPSHIFTDONE
E665 DC18             (    forth6809.asm):03912         RPSHIFT:    LDD   MSCR3
E667 830002           (    forth6809.asm):03913                     SUBD  #2
E66A DD18             (    forth6809.asm):03914                     STD   MSCR3
E66C 9E16             (    forth6809.asm):03915                     LDX   MSCR2
E66E 308B             (    forth6809.asm):03916                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E670 EC84             (    forth6809.asm):03917                     LDD   ,X
E672 3004             (    forth6809.asm):03918                     LEAX  4,X
E674 ED84             (    forth6809.asm):03919                     STD   ,X                ; copy one word 4 bytes higher
E676 DC18             (    forth6809.asm):03920                     LDD   MSCR3
E678 26EB             (    forth6809.asm):03921                     BNE   RPSHIFT
E67A                  (    forth6809.asm):03922         RPSHIFTDONE:
E67A 9E16             (    forth6809.asm):03923                     LDX   MSCR2
E67C 3004             (    forth6809.asm):03924                     LEAX  4,X
E67E 1F13             (    forth6809.asm):03925                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03926         
E680 CCDE02           (    forth6809.asm):03927                     LDD   #BRANCH
E683 3606             (    forth6809.asm):03928                     PSHU  D

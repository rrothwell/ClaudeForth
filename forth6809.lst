                      (    forth6809.asm):07794         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07795         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07796         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07797         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07798         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07799         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07800         ; division.
                      (    forth6809.asm):07801         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):07802         ; ------------------------------------------------------------

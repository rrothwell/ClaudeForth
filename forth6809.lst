DD69 39               (    forth6809.asm):04366                     RTS
                      (    forth6809.asm):04367         
                      (    forth6809.asm):04368                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04369         ; ------------------------------------------------------------
                      (    forth6809.asm):04370         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04371         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04372         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04373         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04374         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04375         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04376         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04377         ; follow.
                      (    forth6809.asm):04378         ; ------------------------------------------------------------
DD6A                  (    forth6809.asm):04379         KEYW:
                      (    forth6809.asm):04380                     LDA   ACIASR
                      (    forth6809.asm):04381                     BITA  #SR_RDRF
                      (    forth6809.asm):04382                     BEQ   KWAIT
                      (    forth6809.asm):04383                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04384                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
DD6A                  (    forth6809.asm):04385         KWAIT:
DD6A                  (    forth6809.asm):04386         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04387                     BITA  #SR_RDRF
                      (    forth6809.asm):04388                     BEQ   KSPIN
DD6A                  (    forth6809.asm):04389         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04390                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04391                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04392                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04393                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04394                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04395                     BEQ   KGETCH
                      (    forth6809.asm):04396                     BITA  #SR_FE
                      (    forth6809.asm):04397                     BEQ   KXFE
                      (    forth6809.asm):04398                     INC   FECOUNT
DD6A                  (    forth6809.asm):04399         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04400                     BEQ   KXOVRN
                      (    forth6809.asm):04401                     INC   OVRNCOUNT
DD6A                  (    forth6809.asm):04402         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04403                     BEQ   KGETCH
                      (    forth6809.asm):04404                     INC   PECOUNT
DD6A                  (    forth6809.asm):04405         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04406                     TFR   A,B
                      (    forth6809.asm):04407                     CLRA
                      (    forth6809.asm):04408                     PSHU  D                 ; char
                      (    forth6809.asm):04409                     RTS
                      (    forth6809.asm):04410         
                      (    forth6809.asm):04411         ; ------------------------------------------------------------
                      (    forth6809.asm):04412         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04413         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04414         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04415         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04416         ;    Inputs:
                      (    forth6809.asm):04417         ;        none
                      (    forth6809.asm):04418         ;    Outputs:
                      (    forth6809.asm):04419         ;        XON or XOFF transmitted
                      (    forth6809.asm):04420         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04421         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04422         ; ------------------------------------------------------------
DD6A                  (    forth6809.asm):04423         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04424                     BRA   PUTXCH
DD6A                  (    forth6809.asm):04425         PUTXON:     LDA   #XONCH
DD6A                  (    forth6809.asm):04426         PUTXCH:     PSHS  A
DD6A                  (    forth6809.asm):04427         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04428                     BITB  #SR_TDRE
                      (    forth6809.asm):04429                     BEQ   PXWT
                      (    forth6809.asm):04430                     PULS  A
                      (    forth6809.asm):04431                     STA   ACIADR
                      (    forth6809.asm):04432                     RTS
                      (    forth6809.asm):04433         
                      (    forth6809.asm):04434         ; ------------------------------------------------------------
                      (    forth6809.asm):04435         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04436         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04437         ; ------------------------------------------------------------
DD6A                  (    forth6809.asm):04438         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):04439                     BITA  #SR_RDRF
                      (    forth6809.asm):04440                     BEQ   KQFALSE
                      (    forth6809.asm):04441                     LDD   #TRUEV
                      (    forth6809.asm):04442                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04443                     RTS
DD6A                  (    forth6809.asm):04444         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04445                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04446                     RTS
                      (    forth6809.asm):04447         
                      (    forth6809.asm):04448         ; ------------------------------------------------------------
                      (    forth6809.asm):04449         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04450         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04451         ; ------------------------------------------------------------
DD6A                  (    forth6809.asm):04452         EMITW:      PULU  D                 ; char

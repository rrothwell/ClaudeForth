                      (   unit_tests.asm):17967         ; unit test for [IF], [ELSE] and [THEN]: each table entry sets the
                      (   unit_tests.asm):17968         ; input source to a string, calls the word, and checks where >IN
                      (   unit_tests.asm):17969         ; ended up and that the data stack holds nothing extra. The string
                      (   unit_tests.asm):17970         ; labels end just before the text that must still be unread.
                      (   unit_tests.asm):17971         ; Entry: FDB string, FDB length, FDB expected >IN, FCB mode
                      (   unit_tests.asm):17972         ; (0 = [ELSE], 1 = [IF] with a false flag, 2 = [IF] with a true flag).
                      (   unit_tests.asm):17973         ; TSTBRCOND
                      (   unit_tests.asm):17974         ;    Inputs:
                      (   unit_tests.asm):17975         ;        none
                      (   unit_tests.asm):17976         ;    Outputs:

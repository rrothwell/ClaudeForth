                      (    forth6809.asm):04820         
                      (    forth6809.asm):04821         ; ------------------------------------------------------------
                      (    forth6809.asm):04822         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):04823         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):04824         ; ------------------------------------------------------------
EB4B 3706             (    forth6809.asm):04825         PICKW:      PULU  D                 ; u
EB4D 58               (    forth6809.asm):04826                     LSLB
EB4E 49               (    forth6809.asm):04827                     ROLA
EB4F ECCB             (    forth6809.asm):04828                     LDD   D,U

                      (    forth6809.asm):12929                     PSHU D
                      (    forth6809.asm):12930                     STU  TSTUB4
                      (    forth6809.asm):12931         
                      (    forth6809.asm):12932                     LDD  #TSTCBUF
                      (    forth6809.asm):12933                     PSHU D
                      (    forth6809.asm):12934                     LDD  #2
                      (    forth6809.asm):12935                     PSHU D
                      (    forth6809.asm):12936                     LDD  #TSTCBUF+2
                      (    forth6809.asm):12937                     PSHU D
                      (    forth6809.asm):12938                     LDD  #2
                      (    forth6809.asm):12939                     PSHU D
                      (    forth6809.asm):12940                     JSR  COMPAREW
                      (    forth6809.asm):12941                     PULU D
                      (    forth6809.asm):12942                     CMPD #-1
                      (    forth6809.asm):12943                     BNE  CQFAIL
                      (    forth6809.asm):12944         
                      (    forth6809.asm):12945                     LDD  #TSTCBUF
                      (    forth6809.asm):12946                     PSHU D
                      (    forth6809.asm):12947                     LDD  #2
                      (    forth6809.asm):12948                     PSHU D
                      (    forth6809.asm):12949                     LDD  #TSTCBUF
                      (    forth6809.asm):12950                     PSHU D
                      (    forth6809.asm):12951                     LDD  #2
                      (    forth6809.asm):12952                     PSHU D
                      (    forth6809.asm):12953                     JSR  COMPAREW
                      (    forth6809.asm):12954                     PULU D
                      (    forth6809.asm):12955                     CMPD #0
                      (    forth6809.asm):12956                     BNE  CQFAIL
                      (    forth6809.asm):12957         
                      (    forth6809.asm):12958                     LDD  #TSTCBUF+2
                      (    forth6809.asm):12959                     PSHU D
                      (    forth6809.asm):12960                     LDD  #2
                      (    forth6809.asm):12961                     PSHU D
                      (    forth6809.asm):12962                     LDD  #TSTCBUF
                      (    forth6809.asm):12963                     PSHU D
                      (    forth6809.asm):12964                     LDD  #2
                      (    forth6809.asm):12965                     PSHU D
                      (    forth6809.asm):12966                     JSR  COMPAREW
                      (    forth6809.asm):12967                     PULU D
                      (    forth6809.asm):12968                     CMPD #1
                      (    forth6809.asm):12969                     BNE  CQFAIL
                      (    forth6809.asm):12970         
                      (    forth6809.asm):12971                     LDD  #TSTCBUF
                      (    forth6809.asm):12972                     PSHU D
                      (    forth6809.asm):12973                     LDD  #2
                      (    forth6809.asm):12974                     PSHU D
                      (    forth6809.asm):12975                     LDD  #TSTCBUF
                      (    forth6809.asm):12976                     PSHU D
                      (    forth6809.asm):12977                     LDD  #3
                      (    forth6809.asm):12978                     PSHU D
                      (    forth6809.asm):12979                     JSR  COMPAREW
                      (    forth6809.asm):12980                     PULU D
                      (    forth6809.asm):12981                     CMPD #-1
                      (    forth6809.asm):12982                     BNE  CQFAIL
                      (    forth6809.asm):12983         
                      (    forth6809.asm):12984                     STU  TSTUAF
                      (    forth6809.asm):12985         

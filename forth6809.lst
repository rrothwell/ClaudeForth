                      (    forth6809.asm):07662         
                      (    forth6809.asm):07663                   PULU D
                      (    forth6809.asm):07664                   CMPD #-22
                      (    forth6809.asm):07665                   BNE  T3FAIL
                      (    forth6809.asm):07666         
                      (    forth6809.asm):07667                   LDD  TSTUB4
                      (    forth6809.asm):07668                   SUBD TSTUAF
                      (    forth6809.asm):07669                   CMPD #0
                      (    forth6809.asm):07670                   BNE  T3FAIL
                      (    forth6809.asm):07671         
                      (    forth6809.asm):07672                   LDD  #TRUEV
                      (    forth6809.asm):07673                   BRA  T3DONE
C248                  (    forth6809.asm):07674         T3FAIL:   LDD  #FALSEV
C248                  (    forth6809.asm):07675         T3DONE:   LDX  #TSTTHENZNAME
                      (    forth6809.asm):07676                   PSHU X
                      (    forth6809.asm):07677                   PSHU D
                      (    forth6809.asm):07678                   JSR  TSTREPORT
                      (    forth6809.asm):07679         

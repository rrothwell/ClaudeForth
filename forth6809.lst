                      (    forth6809.asm):00891         ; ------------------------------------------------------------
                      (    forth6809.asm):00892         ; TSTSYSIO - System/Console I/O tests (glossary section 3.1, 12
                      (    forth6809.asm):00893         ; words, 7 tests). Six words are deliberately NOT tested here -
                      (    forth6809.asm):00894         ; KEY, ACCEPT, EXPECT, and QUERY all genuinely block on real
                      (    forth6809.asm):00895         ; input during automated, headless boot-time testing (confirmed
                      (    forth6809.asm):00896         ; by reading their own implementations: KEY spins on itself,
                      (    forth6809.asm):00897         ; ACCEPT calls KEY directly, EXPECT/QUERY both call ACCEPT); and
                      (    forth6809.asm):00898         ; ABORT/QUIT are both designed to never return (ABORT falls
                      (    forth6809.asm):00899         ; through into QUIT, which resets the return stack, discarding
                      (    forth6809.asm):00900         ; this entire call chain and hijacking the boot sequence into
                      (    forth6809.asm):00901         ; the interpreter's own top-level loop). See this group's own
                      (    forth6809.asm):00902         ; leading comment block, right before TSTKEYQ, for the full
                      (    forth6809.asm):00903         ; reasoning.
                      (    forth6809.asm):00904         ;
                      (    forth6809.asm):00905         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00906         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00907         ; thousands of times already across every prior test group.
                      (    forth6809.asm):00908         ; Each test here verifies the real queuing mechanism (OUTHEAD/
                      (    forth6809.asm):00909         ; OUTBUF), reading the actual character(s) back out of the
                      (    forth6809.asm):00910         ; output ring buffer to confirm they were genuinely queued, not
                      (    forth6809.asm):00911         ; just that the call returned without crashing.
                      (    forth6809.asm):00912         ; ------------------------------------------------------------
C166 BDFC2B           (    forth6809.asm):00913         TSTSYSIO: JSR   CRW
C169 8EC17A           (    forth6809.asm):00914                    LDX   #TSTSYSIOMSG
C16C 3610             (    forth6809.asm):00915                    PSHU  X
C16E CC0005           (    forth6809.asm):00916                    LDD   #5
C171 3606             (    forth6809.asm):00917                    PSHU  D
C173 BDF60B           (    forth6809.asm):00918                    JSR   TYPE
C176 BDFC2B           (    forth6809.asm):00919                    JSR   CRW
                      (    forth6809.asm):00920         
                      (    forth6809.asm):00921                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00922         
                      (    forth6809.asm):00923                    JSR   TSTKEYQ
                      (    forth6809.asm):00924                    JSR   TSTEMIT
                      (    forth6809.asm):00925                    JSR   TSTCR
                      (    forth6809.asm):00926                    JSR   TSTSPACE
                      (    forth6809.asm):00927                    JSR   TSTSPACES
                      (    forth6809.asm):00928                    JSR   TSTSPACESZ
                      (    forth6809.asm):00929                    JSR   TSTTYPE
                      (    forth6809.asm):00930         
                      (    forth6809.asm):00931                    ENDC ; <<<<
                      (    forth6809.asm):00932         
C179 39               (    forth6809.asm):00933                    RTS
                      (    forth6809.asm):00934         
C17A 537973494F       (    forth6809.asm):00935         TSTSYSIOMSG: FCC "SysIO"
                      (    forth6809.asm):00936         
                      (    forth6809.asm):00937                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00938         
                      (    forth6809.asm):00939         ; ------------------------------------------------------------
                      (    forth6809.asm):00940         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00941         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00942         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00943         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00944         ;
                      (    forth6809.asm):00945         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00946         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00947         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00948         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00949         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00950         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00951         ; where no real input will ever arrive.
                      (    forth6809.asm):00952         ;
                      (    forth6809.asm):00953         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00954         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00955         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00956         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00957         ; entirely, not just fail one test.
                      (    forth6809.asm):00958         ;
                      (    forth6809.asm):00959         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00960         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00961         ; thousands of times already across every prior test group
                      (    forth6809.asm):00962         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00963         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00964         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00965         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00966         ; returned.
                      (    forth6809.asm):00967         ; ------------------------------------------------------------
                      (    forth6809.asm):00968         
                      (    forth6809.asm):00969         ; ------------------------------------------------------------
                      (    forth6809.asm):00970         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00971         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00972         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00973         ; ------------------------------------------------------------
C17F                  (    forth6809.asm):00974         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00975         
                      (    forth6809.asm):00976                  LDD   #TSTGUARD
                      (    forth6809.asm):00977                  PSHU  D
                      (    forth6809.asm):00978                  STU   TSTUB4
                      (    forth6809.asm):00979         
                      (    forth6809.asm):00980                  JSR   KEYQ
                      (    forth6809.asm):00981         
                      (    forth6809.asm):00982                  STU   TSTUAF
                      (    forth6809.asm):00983         
                      (    forth6809.asm):00984                  PULU  D
                      (    forth6809.asm):00985                  CMPD  #FALSEV
                      (    forth6809.asm):00986                  BNE   KYFAIL
                      (    forth6809.asm):00987                  PULU  D
                      (    forth6809.asm):00988                  CMPD  #TSTGUARD
                      (    forth6809.asm):00989                  BNE   KYFAIL
                      (    forth6809.asm):00990         
                      (    forth6809.asm):00991                  LDD   TSTUB4
                      (    forth6809.asm):00992                  SUBD  TSTUAF
                      (    forth6809.asm):00993                  CMPD  #2
                      (    forth6809.asm):00994                  BNE   KYFAIL
                      (    forth6809.asm):00995         
                      (    forth6809.asm):00996                  LDD   #TRUEV
                      (    forth6809.asm):00997                  BRA   KYDONE
C17F                  (    forth6809.asm):00998         KYFAIL: LDD   #FALSEV
C17F                  (    forth6809.asm):00999         KYDONE: LDX   #TSTKEYQNAME
                      (    forth6809.asm):01000                  PSHU  X
                      (    forth6809.asm):01001                  PSHU  D
                      (    forth6809.asm):01002                  JSR   TSTREPORT
                      (    forth6809.asm):01003         
                      (    forth6809.asm):01004                  LDU   TSTU0
                      (    forth6809.asm):01005                  RTS
                      (    forth6809.asm):01006         
C17F                  (    forth6809.asm):01007         TSTKEYQNAME: FCB  7
                      (    forth6809.asm):01008                      FCC  "TSTKEYQ"
                      (    forth6809.asm):01009         
                      (    forth6809.asm):01010         ; ------------------------------------------------------------
                      (    forth6809.asm):01011         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):01012         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):01013         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):01014         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):01015         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):01016         ; that the call returned.
                      (    forth6809.asm):01017         ; ------------------------------------------------------------
C17F                  (    forth6809.asm):01018         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):01019         
                      (    forth6809.asm):01020                  LDD   #TSTGUARD
                      (    forth6809.asm):01021                  PSHU  D
                      (    forth6809.asm):01022                  LDD   #65
                      (    forth6809.asm):01023                  PSHU  D
                      (    forth6809.asm):01024                  STU   TSTUB4
                      (    forth6809.asm):01025         
                      (    forth6809.asm):01026                  JSR   EMIT
                      (    forth6809.asm):01027         
                      (    forth6809.asm):01028                  STU   TSTUAF
                      (    forth6809.asm):01029         
                      (    forth6809.asm):01030                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):01031                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):01032                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):01033                                 ; different implementations, gated the same way
                      (    forth6809.asm):01034                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):01035                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):01036                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):01037                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):01038                                 ; always failed despite the character genuinely
                      (    forth6809.asm):01039                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):01040                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):01041                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):01042                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):01043                                 ; - checking it verifies the argument was
                      (    forth6809.asm):01044                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):01045                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):01046                                 ; conditional needed.
                      (    forth6809.asm):01047                  CMPA  #65
                      (    forth6809.asm):01048                  BNE   EMFAIL
                      (    forth6809.asm):01049         
                      (    forth6809.asm):01050                  PULU  D
                      (    forth6809.asm):01051                  CMPD  #TSTGUARD
                      (    forth6809.asm):01052                  BNE   EMFAIL
                      (    forth6809.asm):01053         
                      (    forth6809.asm):01054                  LDD   TSTUB4
                      (    forth6809.asm):01055                  SUBD  TSTUAF
                      (    forth6809.asm):01056                  CMPD  #-2
                      (    forth6809.asm):01057                  BNE   EMFAIL
                      (    forth6809.asm):01058         
                      (    forth6809.asm):01059                  LDD   #TRUEV
                      (    forth6809.asm):01060                  BRA   EMDONE
C17F                  (    forth6809.asm):01061         EMFAIL:  LDD   #FALSEV
C17F                  (    forth6809.asm):01062         EMDONE:  LDX   #TSTEMITNAME
                      (    forth6809.asm):01063                  PSHU  X
                      (    forth6809.asm):01064                  PSHU  D
                      (    forth6809.asm):01065                  JSR   TSTREPORT
                      (    forth6809.asm):01066         
                      (    forth6809.asm):01067                  LDU   TSTU0
                      (    forth6809.asm):01068                  RTS
                      (    forth6809.asm):01069         
C17F                  (    forth6809.asm):01070         TSTEMITNAME: FCB  7
                      (    forth6809.asm):01071                      FCC  "TSTEMIT"
                      (    forth6809.asm):01072         
                      (    forth6809.asm):01073         ; ------------------------------------------------------------
                      (    forth6809.asm):01074         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01075         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01076         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01077         ; ------------------------------------------------------------
C17F                  (    forth6809.asm):01078         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01079         
                      (    forth6809.asm):01080                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01081                  LDA   OUTHEAD
                      (    forth6809.asm):01082                  STA   TSTOHSAV
                      (    forth6809.asm):01083                  ENDC ; <<<<
                      (    forth6809.asm):01084         
                      (    forth6809.asm):01085         
                      (    forth6809.asm):01086                  LDD   #TSTGUARD
                      (    forth6809.asm):01087                  PSHU  D
                      (    forth6809.asm):01088                  STU   TSTUB4
                      (    forth6809.asm):01089         
                      (    forth6809.asm):01090                  JSR   CRW
                      (    forth6809.asm):01091         
                      (    forth6809.asm):01092                  STU   TSTUAF
                      (    forth6809.asm):01093         
                      (    forth6809.asm):01094                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01095                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01096                                   ; in order
                      (    forth6809.asm):01097                  LDA   TSTOHSAV
                      (    forth6809.asm):01098                  ADDA  #2
                      (    forth6809.asm):01099                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01100                  CMPA  OUTHEAD
                      (    forth6809.asm):01101                  BNE   CRFAIL
                      (    forth6809.asm):01102         
                      (    forth6809.asm):01103                  LDX   #OUTBUF
                      (    forth6809.asm):01104                  LDB   TSTOHSAV
                      (    forth6809.asm):01105                  LDA   B,X
                      (    forth6809.asm):01106                  CMPA  #13
                      (    forth6809.asm):01107                  BNE   CRFAIL
                      (    forth6809.asm):01108                  INCB
                      (    forth6809.asm):01109                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01110                  LDA   B,X
                      (    forth6809.asm):01111                  CMPA  #10
                      (    forth6809.asm):01112                  BNE   CRFAIL
                      (    forth6809.asm):01113                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01114                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01115                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01116                                   ; entirely different implementations, gated
                      (    forth6809.asm):01117                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01118                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01119                                   ; currently active build) writes directly to
                      (    forth6809.asm):01120                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01121                                   ; all, so this check always failed despite
                      (    forth6809.asm):01122                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01123                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01124                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01125                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01126                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01127                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01128                                   ; depth check below is the most this variant
                      (    forth6809.asm):01129                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01130                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01131                                   ; persistent state.
                      (    forth6809.asm):01132                  LDA   EMITCH
                      (    forth6809.asm):01133                  CMPA  #10
                      (    forth6809.asm):01134                  BNE   CRFAIL
                      (    forth6809.asm):01135                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01136         
                      (    forth6809.asm):01137                  PULU  D
                      (    forth6809.asm):01138                  CMPD  #TSTGUARD
                      (    forth6809.asm):01139                  BNE   CRFAIL
                      (    forth6809.asm):01140         
                      (    forth6809.asm):01141                  LDD   TSTUB4
                      (    forth6809.asm):01142                  SUBD  TSTUAF
                      (    forth6809.asm):01143                  CMPD  #0
                      (    forth6809.asm):01144                  BNE   CRFAIL
                      (    forth6809.asm):01145         
                      (    forth6809.asm):01146                  LDD   #TRUEV
                      (    forth6809.asm):01147                  BRA   CRDONE
C17F                  (    forth6809.asm):01148         CRFAIL: LDD   #FALSEV
C17F                  (    forth6809.asm):01149         CRDONE: LDX   #TSTCRNAME
                      (    forth6809.asm):01150                  PSHU  X
                      (    forth6809.asm):01151                  PSHU  D
                      (    forth6809.asm):01152                  JSR   TSTREPORT
                      (    forth6809.asm):01153         
                      (    forth6809.asm):01154                  LDU   TSTU0
                      (    forth6809.asm):01155                  RTS
                      (    forth6809.asm):01156         
C17F                  (    forth6809.asm):01157         TSTCRNAME: FCB  5
                      (    forth6809.asm):01158                    FCC  "TSTCR"
                      (    forth6809.asm):01159         
                      (    forth6809.asm):01160         ; ------------------------------------------------------------
                      (    forth6809.asm):01161         ; TSTSPACE - unit test for SPACE. Verifies one space (32) is
                      (    forth6809.asm):01162         ; genuinely queued.
                      (    forth6809.asm):01163         ; ------------------------------------------------------------
C17F                  (    forth6809.asm):01164         TSTSPACE: STU  TSTU0

                      (    forth6809.asm):09746         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):09747         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):09748         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):09749         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):09750         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):09751         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):09752         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):09753         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):09754         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):09755         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):09756         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):09757         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):09758                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):09759                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):09760                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):09761                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):09762                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):09763                  FDB   ABORT
                      (    forth6809.asm):09764         
DEBE 04               (    forth6809.asm):09765         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):09766                  FCC   "QUIT"

                      (    forth6809.asm):03828         ; ------------------------------------------------------------
                      (    forth6809.asm):03829         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03830         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03831         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03832         ; PRUNE
                      (    forth6809.asm):03833         ;    Inputs:
                      (    forth6809.asm):03834         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03835         ;    Outputs:
                      (    forth6809.asm):03836         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03837         ;        into ROM
                      (    forth6809.asm):03838         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03839         ; ------------------------------------------------------------

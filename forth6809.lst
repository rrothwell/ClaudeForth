                      (    forth6809.asm):08058         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):08059         ; ============================================================
                      (    forth6809.asm):08060         ; ------------------------------------------------------------
                      (    forth6809.asm):08061         ; TRUE  ( -- flag )
                      (    forth6809.asm):08062         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08063         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08064         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08065         ; ------------------------------------------------------------
FDC2 CCFFFF           (    forth6809.asm):08066         TRUEW:      LDD   #$FFFF
FDC5 3606             (    forth6809.asm):08067                     PSHU  D
FDC7 39               (    forth6809.asm):08068                     RTS
                      (    forth6809.asm):08069         
                      (    forth6809.asm):08070         ; ------------------------------------------------------------
                      (    forth6809.asm):08071         ; FALSE  ( -- flag )
                      (    forth6809.asm):08072         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08073         ; ------------------------------------------------------------
FDC8 CC0000           (    forth6809.asm):08074         FALSEW:     LDD   #$0000
FDCB 3606             (    forth6809.asm):08075                     PSHU  D
FDCD 39               (    forth6809.asm):08076                     RTS
                      (    forth6809.asm):08077         
                      (    forth6809.asm):08078         ; ------------------------------------------------------------
                      (    forth6809.asm):08079         ; 1  ( -- 1 )
                      (    forth6809.asm):08080         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08081         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08082         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):08083         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):08084         ; ------------------------------------------------------------
FDCE CC0001           (    forth6809.asm):08085         POSONEW:    LDD   #1
FDD1 3606             (    forth6809.asm):08086                     PSHU  D
FDD3 39               (    forth6809.asm):08087                     RTS
                      (    forth6809.asm):08088         
                      (    forth6809.asm):08089         ; ------------------------------------------------------------
                      (    forth6809.asm):08090         ; -1  ( -- -1 )
                      (    forth6809.asm):08091         ; Push the constant -1.
                      (    forth6809.asm):08092         ; ------------------------------------------------------------
FDD4 CCFFFF           (    forth6809.asm):08093         NEGONEW:    LDD   #-1
FDD7 3606             (    forth6809.asm):08094                     PSHU  D
FDD9 39               (    forth6809.asm):08095                     RTS
                      (    forth6809.asm):08096         
                      (    forth6809.asm):08097         ; ------------------------------------------------------------
                      (    forth6809.asm):08098         ; 2  ( -- 2 )
                      (    forth6809.asm):08099         ; Push the constant 2.
                      (    forth6809.asm):08100         ; ------------------------------------------------------------
FDDA CC0002           (    forth6809.asm):08101         POSTWOW:    LDD   #2
FDDD 3606             (    forth6809.asm):08102                     PSHU  D
FDDF 39               (    forth6809.asm):08103                     RTS
                      (    forth6809.asm):08104         
                      (    forth6809.asm):08105         ; ------------------------------------------------------------
                      (    forth6809.asm):08106         ; -2  ( -- -2 )
                      (    forth6809.asm):08107         ; Push the constant -2.
                      (    forth6809.asm):08108         ; ------------------------------------------------------------
FDE0 CCFFFE           (    forth6809.asm):08109         NEGTWOW:    LDD   #-2
FDE3 3606             (    forth6809.asm):08110                     PSHU  D
FDE5 39               (    forth6809.asm):08111                     RTS
                      (    forth6809.asm):08112         
                      (    forth6809.asm):08113         ; Verify no collision with init code,
                      (    forth6809.asm):08114         ; value should match ORG INITCODE.
     FDE6             (    forth6809.asm):08115         BASECODEEND EQU   *
     2122             (    forth6809.asm):08116         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):08117         
                      (    forth6809.asm):08118         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08119         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):08120         ; .bin file.
FDE6                  (    forth6809.asm):08121         BASEND:
FDE6 FFFFFFFFFFFFFFFF (    forth6809.asm):08122                     FILL  $FF,INITCODE-BASEND

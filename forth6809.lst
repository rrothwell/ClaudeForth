FD85 FDD200070000     (    forth6809.asm):12957                  FDB   EN9,EN9L,0    ; NEW: FLOORED - previously the one item
                      (    forth6809.asm):12958                                      ; in this area explicitly left open
                      (    forth6809.asm):12959                                      ; pending its own investigation (unlike
                      (    forth6809.asm):12960                                      ; WORDLISTS, this is a CORE query, not
                      (    forth6809.asm):12961                                      ; tied to an unimplemented optional word
                      (    forth6809.asm):12962                                      ; set, so "false by omission" wasn't the
                      (    forth6809.asm):12963                                      ; right default). Investigated by tracing
                      (    forth6809.asm):12964                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):12965                                      ; against this system's own SM/REM and
                      (    forth6809.asm):12966                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):12967                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):12968                                      ; dividend's own original sign) after
                      (    forth6809.asm):12969                                      ; dividing absolute values - exactly
                      (    forth6809.asm):12970                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):12971                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):12972                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):12973                                      ; adjustment step (correcting the
                      (    forth6809.asm):12974                                      ; quotient and remainder when the
                      (    forth6809.asm):12975                                      ; quotient would be negative with a
                      (    forth6809.asm):12976                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):12977                                      ; not have. This system's primary
                      (    forth6809.asm):12978                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):12979                                      ; symmetric division, not floored -
                      (    forth6809.asm):12980                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):12981                                      ; answer (recognized query, value false),
                      (    forth6809.asm):12982                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):12983                                      ; WORDLISTS correctly uses.

                      (    forth6809.asm):09755                   LDA  #'O'
                      (    forth6809.asm):09756                   STA  TSTFHDR+2
                      (    forth6809.asm):09757                   LDA  #'O'
                      (    forth6809.asm):09758                   STA  TSTFHDR+3
                      (    forth6809.asm):09759                   LDD  #0
                      (    forth6809.asm):09760                   STD  TSTFHDR+4
                      (    forth6809.asm):09761                   LDD  #DUP
                      (    forth6809.asm):09762                   STD  TSTFHDR+6
                      (    forth6809.asm):09763         
                      (    forth6809.asm):09764                   LDA  #'F'
                      (    forth6809.asm):09765                   STA  TSTNAMEB
                      (    forth6809.asm):09766                   LDA  #'O'
                      (    forth6809.asm):09767                   STA  TSTNAMEB+1

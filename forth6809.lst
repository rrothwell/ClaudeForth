                      (    forth6809.asm):00001         ; ============================================================
                      (    forth6809.asm):00002         ; 6809 ANS FORTH - consolidated source
                      (    forth6809.asm):00003         ; Assembled from the full design conversation.
                      (    forth6809.asm):00004         ;
                      (    forth6809.asm):00005         ; GLOBALS LAYOUT: applied. Every scratch/global cell now has a
                      (    forth6809.asm):00006         ; fixed RMB-assigned address in page zero ($0000-$00FF, DP=$00
                      (    forth6809.asm):00007         ; at reset) - see the GLOBALS section below for the full layout
                      (    forth6809.asm):00008         ; and its byte budget (256 of 256 bytes used, 0 free - the page
                      (    forth6809.asm):00009         ; is now fully packed; any future scratch cell will need to
                      (    forth6809.asm):00010         ; reuse an existing one or move a cell out of page zero).
                      (    forth6809.asm):00011         ;
                      (    forth6809.asm):00012         ; SERIAL HANDSHAKING: RTS (hardware, output) is implemented -
                      (    forth6809.asm):00013         ; IRQH/KEY toggle it based on the input ring's fill level
                      (    forth6809.asm):00014         ; against INHIWATER/INLOWATER (see SECTION 3). CTS (input) needs
                      (    forth6809.asm):00015         ; no firmware logic at all: the 6850 hardware automatically
                      (    forth6809.asm):00016         ; inhibits TDRE while CTS is deasserted, and this system's
                      (    forth6809.asm):00017         ; existing TDRE-gated transmit logic already respects that with
                      (    forth6809.asm):00018         ; no code changes. Software (XON/XOFF) handshaking remains not
                      (    forth6809.asm):00019         ; implemented - this system still neither transmits nor
                      (    forth6809.asm):00020         ; recognizes those bytes.
                      (    forth6809.asm):00021         ;
                      (    forth6809.asm):00022         ; DICTIONARY: applied (SECTION 27), 219 entries (215 original +
                      (    forth6809.asm):00023         ; DOES> + TRUE + FALSE, added in later passes - see below).
                      (    forth6809.asm):00024         ; Every primitive with a real code label now has a real ROM
                      (    forth6809.asm):00025         ; header, chained via LINK, CFA pointing directly at its code.
                      (    forth6809.asm):00026         ; Building this surfaced two real findings, not just mechanical
                      (    forth6809.asm):00027         ; work: (1) the original 1024-byte BASEDICT could not hold the
                      (    forth6809.asm):00028         ; header table (1954 bytes needed) - BASEDICT was resized to
                      (    forth6809.asm):00029         ; 2048 bytes ($E000-$E7FF), taking the space from BASECODE (then
                      (    forth6809.asm):00030         ; $E800-$FFBF, 6080 bytes, was 7104). This resize was based on
                      (    forth6809.asm):00031         ; the header-table budget alone; the actual assembled byte size
                      (    forth6809.asm):00032         ; of BASECODE's code was never measured with a real 6809
                      (    forth6809.asm):00033         ; assembler, so whether 6080 bytes was enough for all ~530
                      (    forth6809.asm):00034         ; routine labels in this file was never verified before BASECODE
                      (    forth6809.asm):00035         ; moved again (below). (2) DOES>
                      (    forth6809.asm):00036         ; initially had no corresponding code anywhere in the file -
                      (    forth6809.asm):00037         ; SETDOES and the DOES> compiling word (code label DOESGT, since
                      (    forth6809.asm):00038         ; a literal ">" is not a valid 6809 assembler label) were added
                      (    forth6809.asm):00039         ; in a follow-up pass, alongside DODOES/DOESRT0, closing that
                      (    forth6809.asm):00040         ; gap; DOESBEH was added to the GLOBALS layout to support it,
                      (    forth6809.asm):00041         ; using 2 of the page's last 3 free bytes (1 now remains). TRUE
                      (    forth6809.asm):00042         ; and FALSE were added in a still later pass: CONSTANT TRUE -1
                      (    forth6809.asm):00043         ; and CONSTANT FALSE 0, the first CONSTANT-pattern ROM-resident
                      (    forth6809.asm):00044         ; words in this system (TRUEBODY/FALSEBODY, section 26) - every
                      (    forth6809.asm):00045         ; other ROM word's CFA is a plain code label, but a CONSTANT's
                      (    forth6809.asm):00046         ; CFA is the DODOES-trampoline pattern, built by hand here with
                      (    forth6809.asm):00047         ; fixed, assemble-time addresses since there is no interactive
                      (    forth6809.asm):00048         ; CREATE/CONSTANT phase for ROM content.
                      (    forth6809.asm):00049         ;
                      (    forth6809.asm):00050         ; BASEDICT now holds 1992 bytes ($D83F-$E006) - grown from the
                      (    forth6809.asm):00051         ; earlier exact-fit 1973 bytes when H_ABORT/H_QUIT (formerly
                      (    forth6809.asm):00052         ; ABORTHDR/QUITHDR) and BASELATEST moved in from their own
                      (    forth6809.asm):00053         ; section so every dictionary header lives in one contiguous
                      (    forth6809.asm):00054         ; block. BASECODE's start ($DFF4) did not move to match, since
                      (    forth6809.asm):00055         ; it's a fixed address, not derived from BASEDICT's real size -
                      (    forth6809.asm):00056         ; this reintroduces a real overlap, 19 bytes ($DFF4-$E006),
                      (    forth6809.asm):00057         ; between the two. Not resolved here; see the open-items
                      (    forth6809.asm):00058         ; checklist. USROMSTRT/USROMEND, INOUT, RSTACK, DSTACK, CODETOP,
                      (    forth6809.asm):00059         ; APPCODE, APPDICT, and APPVARS remain mutually consistent
                      (    forth6809.asm):00060         ; otherwise, with no other overlaps anywhere in the current
                      (    forth6809.asm):00061         ; memory map. See the ROM Size Required section of the
                      (    forth6809.asm):00062         ; documentation and the open-items checklist for real content
                      (    forth6809.asm):00063         ; totals and remaining margin.
                      (    forth6809.asm):00064         ;
                      (    forth6809.asm):00065         ; This file preserves the code exactly as derived and verified
                      (    forth6809.asm):00066         ; turn-by-turn in the conversation, including the corrected
                      (    forth6809.asm):00067         ; versions of every bug that was caught and fixed in place.
                      (    forth6809.asm):00068         ; SUBSTITUTE is complete but deliberately scoped to a single
                      (    forth6809.asm):00069         ; registered name/value pair, not a full table (see REPLACES).
                      (    forth6809.asm):00070         ; ENVTABLE's /HOLD and /PAD entries were both added this session
                      (    forth6809.asm):00071         ; (HOLDMINSIZE and PADMINSIZE respectively - see the entries
                      (    forth6809.asm):00072         ; themselves for why each uses its own, conceptually correct
                      (    forth6809.asm):00073         ; constant rather than the numerically-equal PADOFFSET). The
                      (    forth6809.asm):00074         ; DPHERE/CODEHERE/VARHERE boundary checks remain explicitly
                      (    forth6809.asm):00075         ; incomplete/absent - see the inline notes preserved from that
                      (    forth6809.asm):00076         ; discussion, and the open-items checklist.
                      (    forth6809.asm):00077         ; ============================================================
                      (    forth6809.asm):00078         
                      (    forth6809.asm):00079         ; ------------------------------------------------------------
                      (    forth6809.asm):00080         ; MEMORY MAP
                      (    forth6809.asm):00081         ; ------------------------------------------------------------
     C000             (    forth6809.asm):00082         ROMSTRT  EQU $C000     ; true physical start of the 16K EPROM's own
                      (    forth6809.asm):00083                                 ; address decode (distinct from USROMSTRT
                      (    forth6809.asm):00084                                 ; below, which excludes INOUT's 256-byte
                      (    forth6809.asm):00085                                 ; shadow) - see the ROM Size Required section
                      (    forth6809.asm):00086                                 ; of the documentation, and the ROM: padding
                      (    forth6809.asm):00087                                 ; block right before SECTION 27
     C100             (    forth6809.asm):00088         USROMSTRT EQU $C100     ; Usable ROM start. Beginning of the usable
                      (    forth6809.asm):00089                                  ; EPROM address range. INITCODE, BASECODE,
                      (    forth6809.asm):00090                                  ; and BASEDICT must all fall within
                      (    forth6809.asm):00091                                  ; USROMSTRT..USROMEND - see the verification
                      (    forth6809.asm):00092                                  ; note below each one's EQU.
     FFEF             (    forth6809.asm):00093         USROMEND EQU  VECTORS-1 ; Usable ROM end. Corrected: 1 before VECTORS'
                      (    forth6809.asm):00094                                  ; start ($FFEF), not one past VECTORS' end as
                      (    forth6809.asm):00095                                  ; originally defined - this is a real 16-bit
                      (    forth6809.asm):00096                                  ; address (the last byte available before the
                      (    forth6809.asm):00097                                  ; reserved vector table), usable directly in
                      (    forth6809.asm):00098                                  ; comparisons or as a memory operand, unlike
                      (    forth6809.asm):00099                                  ; the previous $10000 definition
     FFF0             (    forth6809.asm):00100         VECTORS  EQU  $FFF0
     FFA4             (    forth6809.asm):00101         INITCODE EQU  $FFA4     ; was $FFA9 - shifted down 3 bytes, per
                      (    forth6809.asm):00102                                  ; explicit request, to make room for the
                      (    forth6809.asm):00103                                  ; UNITTESTS call site's own fix (below):
                      (    forth6809.asm):00104                                  ; that site now always emits exactly 3 bytes
                      (    forth6809.asm):00105                                  ; (either the real JSR TSTRUNNER, or 3 NOPs
                      (    forth6809.asm):00106                                  ; as a placeholder when the test framework is
                      (    forth6809.asm):00107                                  ; excluded), so COLDSTRT's total size no
                      (    forth6809.asm):00108                                  ; longer depends on UNITTESTS at all -
                      (    forth6809.asm):00109                                  ; previously it did (JSR TSTRUNNER only
                      (    forth6809.asm):00110                                  ; existed when included, with nothing emitted
                      (    forth6809.asm):00111                                  ; when excluded - using this file's original,
                      (    forth6809.asm):00112                                  ; since-reversed UNITTESTS convention at the
                      (    forth6809.asm):00113                                  ; time this fix was made), meaning INITCODE's
                      (    forth6809.asm):00114                                  ; fixed position here could be correct for
                      (    forth6809.asm):00115                                  ; one setting and wrong for the other, risking
                      (    forth6809.asm):00116                                  ; an overflow into VECTORS when tests were
                      (    forth6809.asm):00117                                  ; compiled in. Prior
                      (    forth6809.asm):00118                                  ; history: was $FFA2 - shifted up 7 bytes to
                      (    forth6809.asm):00119                                  ; reduce the overlap with BASECODE's nominal
                      (    forth6809.asm):00120                                  ; end ($FFB4) from 19 bytes to 12 - improved,
                      (    forth6809.asm):00121                                  ; not resolved. CORRECTED: INITCODE's real
                      (    forth6809.asm):00122                                  ; content is 71 bytes ($47), confirmed by an
                      (    forth6809.asm):00123                                  ; actual assembler run - not the 78-byte
                      (    forth6809.asm):00124                                  ; manual estimate relied on for several
                      (    forth6809.asm):00125                                  ; turns, which was wrong by 7 bytes. That
                      (    forth6809.asm):00126                                  ; 71-byte figure was measured with the old
                      (    forth6809.asm):00127                                  ; structure (test framework excluded emitting
                      (    forth6809.asm):00128                                  ; 0 bytes for
                      (    forth6809.asm):00129                                  ; the TSTRUNNER call site) - with the fix
                      (    forth6809.asm):00130                                  ; above, that site now always emits 3 bytes
                      (    forth6809.asm):00131                                  ; either way, so real content is reasoned to
                      (    forth6809.asm):00132                                  ; be 74 bytes now (71+3), not yet re-measured
                      (    forth6809.asm):00133                                  ; by a real assembler run. At $FFA6, that
                      (    forth6809.asm):00134                                  ; reasoned end is $FFEF - unchanged, since
                      (    forth6809.asm):00135                                  ; the 3-byte shift in INITCODE's own start
                      (    forth6809.asm):00136                                  ; and the 3-byte growth in content offset
                      (    forth6809.asm):00137                                  ; exactly - still one byte below VECTORS, if
                      (    forth6809.asm):00138                                  ; the reasoning above holds; confirm on
                      (    forth6809.asm):00139                                  ; assembly. A prior turn claimed this general
                      (    forth6809.asm):00140                                  ; shift created a new 7-byte VECTORS overlap;
                      (    forth6809.asm):00141                                  ; that was based on the incorrect 78-byte
                      (    forth6809.asm):00142                                  ; estimate and was wrong - retracted here. The
                      (    forth6809.asm):00143                                  ; BASECODE overlap (12 bytes against its
                      (    forth6809.asm):00144                                  ; nominal budget) is separate and unaffected
                      (    forth6809.asm):00145                                  ; by this correction; not resolved. See the
                      (    forth6809.asm):00146                                  ; open-items checklist.
                      (    forth6809.asm):00147                                  ;
                      (    forth6809.asm):00148                                  ; UPDATE: shifted down a further 2 bytes,
                      (    forth6809.asm):00149                                  ; $FFA6 -> $FFA4, confirmed working by the
                      (    forth6809.asm):00150                                  ; user against a real assembler run. Reason:
                      (    forth6809.asm):00151                                  ; COLDSTRT's own interrupt-mask bug fix
                      (    forth6809.asm):00152                                  ; (ANDCC #$AF, added right after JSR
                      (    forth6809.asm):00153                                  ; INITSERIAL - see COLDSTRT's own comment)
                      (    forth6809.asm):00154                                  ; is a 2-byte instruction, growing COLDSTRT's
                      (    forth6809.asm):00155                                  ; total size by exactly that much; INITCODE's
                      (    forth6809.asm):00156                                  ; own fixed budget against VECTORS needed the
                      (    forth6809.asm):00157                                  ; same 2 bytes back to stay within it.
     DE5E             (    forth6809.asm):00158         BASECODE EQU  $DE5E     ; was $DEEA ($DF6A, $DF8A, $DFCA, $DFDA, $DFEA,
                      (    forth6809.asm):00159                                  ; $E02A before that) - shifted down a further
                      (    forth6809.asm):00160                                  ; $70 (112 bytes) this time. Unlike every
                      (    forth6809.asm):00161                                  ; earlier shift in this chain (each resolving
                      (    forth6809.asm):00162                                  ; a memory-map overlap from reorganizing
                      (    forth6809.asm):00163                                  ; other regions), this one is for a different
                      (    forth6809.asm):00164                                  ; reason: SERIALPOLL=0 (interrupt-driven ACIA
                      (    forth6809.asm):00165                                  ; I/O, IRQH servicing INBUF/OUTBUF ring
                      (    forth6809.asm):00166                                  ; buffers with RTS/CTS flow control) is
                      (    forth6809.asm):00167                                  ; genuinely larger code than the SERIALPOLL=1
                      (    forth6809.asm):00168                                  ; polling path it replaces, and the two are
                      (    forth6809.asm):00169                                  ; mutually exclusive (IFEQ/ELSE/ENDC on the
                      (    forth6809.asm):00170                                  ; same flag, never both assembled at once) -
                      (    forth6809.asm):00171                                  ; but BASECODE's own budget was only ever
                      (    forth6809.asm):00172                                  ; sized against the polling path's smaller
                      (    forth6809.asm):00173                                  ; footprint, so selecting SERIALPOLL=0
                      (    forth6809.asm):00174                                  ; collided against BASEDICT below. Value
                      (    forth6809.asm):00175                                  ; provided by the user directly to resolve
                      (    forth6809.asm):00176                                  ; that collision; not independently re-
                      (    forth6809.asm):00177                                  ; derived or re-verified here. Confirm on
                      (    forth6809.asm):00178                                  ; assembly/MAME rather than trust a static
                      (    forth6809.asm):00179                                  ; estimate. See the open-items checklist.
     D673             (    forth6809.asm):00180         BASEDICT EQU  $D673     ; was $D6FF ($D77F, $D79F, $D7DF, $D7EF,
                      (    forth6809.asm):00181                                  ; $D7FF, $D83F before that) - shifted down
                      (    forth6809.asm):00182                                  ; the same $70 (112 bytes) as BASECODE above,
                      (    forth6809.asm):00183                                  ; for the same reason (making room for
                      (    forth6809.asm):00184                                  ; SERIALPOLL=0's larger, interrupt-driven
                      (    forth6809.asm):00185                                  ; code path - see BASECODE's own comment for
                      (    forth6809.asm):00186                                  ; the full explanation). Value provided by
                      (    forth6809.asm):00187                                  ; the user directly; not independently re-
                      (    forth6809.asm):00188                                  ; derived or re-verified here. Confirm on
                      (    forth6809.asm):00189                                  ; assembly/MAME rather than trust a static
                      (    forth6809.asm):00190                                  ; estimate. See the open-items checklist.
     C000             (    forth6809.asm):00191         INOUT    EQU  $C000     ; was $DF00 - moved so INOUT (256 B) sits
                      (    forth6809.asm):00192                                  ; directly below USROMSTRT ($C100), contiguous,
                      (    forth6809.asm):00193                                  ; no gap. This also resolves the INOUT portion
                      (    forth6809.asm):00194                                  ; of the collision flagged when BASEDICT moved
                      (    forth6809.asm):00195                                  ; to $D85D: INOUT no longer overlaps BASEDICT
                      (    forth6809.asm):00196                                  ; ($D85D-$E011), since $C0FF < $D85D. The
                      (    forth6809.asm):00197                                  ; DSTACK and RSTACK portions of that same
                      (    forth6809.asm):00198                                  ; collision were NOT touched by this specific
                      (    forth6809.asm):00199                                  ; change, but were resolved separately when
                      (    forth6809.asm):00200                                  ; those two regions moved (see below). This
                      (    forth6809.asm):00201                                  ; move ALSO overlapped APPCODE at the time
                      (    forth6809.asm):00202                                  ; ($7000-$D7FF then) - since resolved too, when
                      (    forth6809.asm):00203                                  ; APPCODE moved down $2000 (see below).
     C0FF             (    forth6809.asm):00204         INOUTEND EQU  INOUT+$FF
     BFFF             (    forth6809.asm):00205         RSTACK   EQU  $BFFF     ; was $BEFF - occupied range is $BD00-$BFFF
                      (    forth6809.asm):00206                                  ; (768 bytes, unchanged size). RESOLVED: once a
                      (    forth6809.asm):00207                                  ; 512-byte gap sat between this and DSTACK
                      (    forth6809.asm):00208                                  ; below; DSTACK moving up $200 closed it - now
                      (    forth6809.asm):00209                                  ; exactly contiguous, no gap
     BCFF             (    forth6809.asm):00210         DSTACK   EQU  $BCFF     ; was $BAFF - moved up $200. RESOLVED (both):
                      (    forth6809.asm):00211                                  ; occupied range is now $B900-$BCFF, which
                      (    forth6809.asm):00212                                  ; exactly matches CODETOP ($B900) as its true
                      (    forth6809.asm):00213                                  ; bottom - the 512-byte mismatch is gone - and
                      (    forth6809.asm):00214                                  ; is now exactly contiguous with RSTACK's
                      (    forth6809.asm):00215                                  ; bottom ($BD00), closing that gap too
     B900             (    forth6809.asm):00216         CODETOP  EQU  $B900     ; was $B800 - code space ceiling (data stack
                      (    forth6809.asm):00217                                  ; begins here). RESOLVED: this once no longer
                      (    forth6809.asm):00218                                  ; matched DSTACK's true occupied bottom (was
                      (    forth6809.asm):00219                                  ; $B700, a 512-byte mismatch) - now that DSTACK
                      (    forth6809.asm):00220                                  ; moved up $200 to $B900, CODETOP matches it
                      (    forth6809.asm):00221                                  ; exactly again
                      (    forth6809.asm):00222         
                      (    forth6809.asm):00223         ; ANS transient-region minimums (forth-standard.org/standard/usage,
                      (    forth6809.asm):00224         ; section 3.3.3.6 "Other transient regions"), verified against this
                      (    forth6809.asm):00225         ; system's actual layout and used to replace the bare "84" that used
                      (    forth6809.asm):00226         ; to sit directly inside PADW with a named, documented constant:
                      (    forth6809.asm):00227         ;   PADMINSIZE  - PAD's own scratch region, size in characters. WORD
                      (    forth6809.asm):00228         ;                 originally used a separate, fixed WORDBUF that
                      (    forth6809.asm):00229         ;                 happened to meet its own 33-character minimum
                      (    forth6809.asm):00230         ;                 exactly (WORDBUF's span up to where SIBUF used to
                      (    forth6809.asm):00231         ;                 begin was precisely 33 bytes, confirmed by address
                      (    forth6809.asm):00232         ;                 subtraction) - but WORD has since been redesigned
                      (    forth6809.asm):00233         ;                 (see below, and WORD itself in the Header/Compiling
                      (    forth6809.asm):00234         ;                 section) to use this same CODEHERE-to-PAD gap
                      (    forth6809.asm):00235         ;                 instead, matching the traditional fig-Forth layout,
                      (    forth6809.asm):00236         ;                 so WORDBUF itself is retired along with SIBUF.
                      (    forth6809.asm):00237         ;   HOLDMINSIZE - pictured numeric output buffer, size in characters,
                      (    forth6809.asm):00238         ;                 (2 * n) + 2 where n = bits per cell (16 here) = 34.
                      (    forth6809.asm):00239         ;                 LTNUM ("<#") anchors HLD to PADW's own return value
                      (    forth6809.asm):00240         ;                 and HOLD decrements before storing, so this buffer
                      (    forth6809.asm):00241         ;                 grows downward from PAD into the CODEHERE-to-PAD
                      (    forth6809.asm):00242         ;                 gap, not into PAD's own region above it - confirmed
                      (    forth6809.asm):00243         ;                 by tracing LTNUM/HOLD. The gap must be at least
                      (    forth6809.asm):00244         ;                 HOLDMINSIZE wide for this to fit.
                      (    forth6809.asm):00245         ; PADOFFSET (below) satisfies both: it equals PADMINSIZE, which is
                      (    forth6809.asm):00246         ; itself well above HOLDMINSIZE (84 vs 34, 50 bytes of margin) - kept
                      (    forth6809.asm):00247         ; as a single, larger-than-either-strict-minimum offset rather than
                      (    forth6809.asm):00248         ; two separately-tuned numbers, matching "larger than minimum is
                      (    forth6809.asm):00249         ; satisfactory" for a small system.
     0054             (    forth6809.asm):00250         PADMINSIZE  EQU 84
     0021             (    forth6809.asm):00251         WORDMINSIZE EQU 33
     0022             (    forth6809.asm):00252         HOLDMINSIZE EQU 34
     0054             (    forth6809.asm):00253         PADOFFSET   EQU PADMINSIZE  ; CODEHERE-to-PAD gap; also governs how
                      (    forth6809.asm):00254                                     ; much of PAD's own upward-growing region
                      (    forth6809.asm):00255                                     ; (now used by both the user and, per this
                      (    forth6809.asm):00256                                     ; change, interpreted-mode S" text) is
                      (    forth6809.asm):00257                                     ; guaranteed available before something
                      (    forth6809.asm):00258                                     ; else might claim it
     002E             (    forth6809.asm):00259         WORDMAXCHARS EQU PADOFFSET-HOLDMINSIZE-1-3  ; max characters WORD can
                      (    forth6809.asm):00260                                     ; scan when using the CODEHERE-to-PAD gap
                      (    forth6809.asm):00261                                     ; (see WORD, below) - reserves HOLDMINSIZE
                      (    forth6809.asm):00262                                     ; bytes at the PAD end for the pictured
                      (    forth6809.asm):00263                                     ; numeric output buffer (which grows
                      (    forth6809.asm):00264                                     ; downward from PAD into this same gap),
                      (    forth6809.asm):00265                                     ; using the remaining space at the
                      (    forth6809.asm):00266                                     ; CODEHERE end, less 1 byte for WORD's own
                      (    forth6809.asm):00267                                     ; leading count byte, less a further 3
                      (    forth6809.asm):00268                                     ; bytes for the worst case: S"/."/ABORT"
                      (    forth6809.asm):00269                                     ; all reserve 3 bytes ahead of CODEHERE
                      (    forth6809.asm):00270                                     ; before calling WORD (see SQUOTE/
                      (    forth6809.asm):00271                                     ; DOTQUOTE/AQSTOK), so their text lands 3
                      (    forth6809.asm):00272                                     ; bytes further into this same gap than
                      (    forth6809.asm):00273                                     ; plain WORD-parsing (e.g. a dictionary
                      (    forth6809.asm):00274                                     ; name for FIND) does. Sized for that
                      (    forth6809.asm):00275                                     ; worst case uniformly, rather than giving
                      (    forth6809.asm):00276                                     ; different callers different effective
                      (    forth6809.asm):00277                                     ; limits - simpler and safer than trying
                      (    forth6809.asm):00278                                     ; to track which caller needs which cap.
                      (    forth6809.asm):00279                                     ; 84-34-1-3 = 46.
                      (    forth6809.asm):00280         
     7000             (    forth6809.asm):00281         APPCODE  EQU  $7000     ; was $5000 - back to its original address.
                      (    forth6809.asm):00282                                  ; RESOLVED: this once overlapped DSTACK's true
                      (    forth6809.asm):00283                                  ; range by 512 bytes ($B700-$B8FF), a direct
                      (    forth6809.asm):00284                                  ; consequence of the CODETOP/DSTACK mismatch -
                      (    forth6809.asm):00285                                  ; now that DSTACK moved and CODETOP matches it
                      (    forth6809.asm):00286                                  ; again, APPCODE's nominal range (up to
                      (    forth6809.asm):00287                                  ; CODETOP-1) no longer reaches into DSTACK
     2000             (    forth6809.asm):00288         APPDICT  EQU  $2000     ; was $015B - moved up, size unchanged (20133
                      (    forth6809.asm):00289                                  ; bytes, now $2000-$6EA4). REDUCED BUT NOT
                      (    forth6809.asm):00290                                  ; RESOLVED: still overlaps APPVARS below by 347
                      (    forth6809.asm):00291                                  ; bytes ($2000-$215A), though SIBUF/WORDBUF/
                      (    forth6809.asm):00292                                  ; TIBBUF/OUTBUF (swallowed by the previous
                      (    forth6809.asm):00293                                  ; APPDICT address) are now clear. See the
                      (    forth6809.asm):00294                                  ; open-items checklist
     021B             (    forth6809.asm):00295         APPVARS  EQU  $021B     ; grown from 256 to 8000 bytes (end now $215A,
                      (    forth6809.asm):00296                                  ; was $031A), taking the space directly from
                      (    forth6809.asm):00297                                  ; APPDICT above it; start address unchanged.
                      (    forth6809.asm):00298                                  ; That 8000-byte figure describes the original
                      (    forth6809.asm):00299                                  ; intent, not the current actual usable size -
                      (    forth6809.asm):00300                                  ; see APPVARSEND below, which now tracks
                      (    forth6809.asm):00301                                  ; APPDICT's real position instead
     1FFF             (    forth6809.asm):00302         APPVARSEND EQU APPDICT-1 ; was APPVARS+8000 ($215B) - now derives
                      (    forth6809.asm):00303                                  ; directly from wherever APPDICT actually
                      (    forth6809.asm):00304                                  ; starts, currently $1FFF (7653 bytes usable,
                      (    forth6809.asm):00305                                  ; down from the static 8000). Self-correcting:
                      (    forth6809.asm):00306                                  ; this can no longer go stale if APPDICT moves
                      (    forth6809.asm):00307                                  ; again, unlike the previous fixed-size
                      (    forth6809.asm):00308                                  ; definition. VUNUSEDW (below) is unchanged -
                      (    forth6809.asm):00309                                  ; it already computed against APPVARSEND
                      (    forth6809.asm):00310         ; SIBUF EQU $01FB retired - was interpreted-mode S"'s fixed, dedicated
                      (    forth6809.asm):00311         ; 32-byte scratch buffer; S" now writes into PAD instead (see SQINTERP,
                      (    forth6809.asm):00312         ; String Words section), which is both larger and correctly per-call
                      (    forth6809.asm):00313         ; rather than a single buffer shared by every S" call in a session.
                      (    forth6809.asm):00314         ; The $01FB-$021A range it used to occupy is left unclaimed rather
                      (    forth6809.asm):00315         ; than reassigned - APPVARS below still starts at its own, unchanged
                      (    forth6809.asm):00316         ; address ($021B) - to avoid any risk to the rest of this carefully-
                      (    forth6809.asm):00317         ; verified memory map for the sake of reclaiming 32 bytes on a system
                      (    forth6809.asm):00318         ; with headroom to spare; reclaiming it would need APPVARS to move,
                      (    forth6809.asm):00319         ; a separate, larger change not undertaken here.
                      (    forth6809.asm):00320         ; WORDBUF EQU $01DA also retired, for the same reason as SIBUF above -
                      (    forth6809.asm):00321         ; WORD now uses the CODEHERE-to-PAD gap directly (see WORD in the
                      (    forth6809.asm):00322         ; Header/Compiling section, and WORDMAXCHARS above) rather than a
                      (    forth6809.asm):00323         ; fixed, separately-allocated buffer capped at 31 characters. The
                      (    forth6809.asm):00324         ; $01DA-$01FA range it used to occupy is left unclaimed, same
                      (    forth6809.asm):00325         ; reasoning as SIBUF's retirement above.
     018A             (    forth6809.asm):00326         TIBBUF   EQU  $018A     ; was $0284
     0050             (    forth6809.asm):00327         TIBBUFL  EQU  80
     0106             (    forth6809.asm):00328         SERBUF   EQU  $0106     ; was $0200 - USER0/USER1 removed entirely (see
                      (    forth6809.asm):00329                                  ; below); the 4 buffers (SERBUF's 4-byte index
                      (    forth6809.asm):00330                                  ; block, INBUF, OUTBUF, TIBBUF) still sit
                      (    forth6809.asm):00331                                  ; contiguously right after MVSCRATCH, with no
                      (    forth6809.asm):00332                                  ; gap - WORDBUF and SIBUF, which used to sit
                      (    forth6809.asm):00333                                  ; right after TIBBUF and WORDBUF respectively
                      (    forth6809.asm):00334                                  ; (closing what was once an 11-byte gap,
                      (    forth6809.asm):00335                                  ; $02F5-$02FF, in an earlier address scheme),
                      (    forth6809.asm):00336                                  ; are now both retired (see above) rather than
                      (    forth6809.asm):00337                                  ; part of this contiguous run
     0106             (    forth6809.asm):00338         INHEAD   EQU  SERBUF
     0107             (    forth6809.asm):00339         INTAIL   EQU  SERBUF+1
     0108             (    forth6809.asm):00340         OUTHEAD  EQU  SERBUF+2
     0109             (    forth6809.asm):00341         OUTTAIL  EQU  SERBUF+3
     0040             (    forth6809.asm):00342         INBUFSZ  EQU  64
     0040             (    forth6809.asm):00343         OUTBUFSZ EQU  64
     010A             (    forth6809.asm):00344         INBUF    EQU  SERBUF+4
     014A             (    forth6809.asm):00345         OUTBUF   EQU  SERBUF+4+INBUFSZ
     0000             (    forth6809.asm):00346         GLOBALS  EQU  $0000
                      (    forth6809.asm):00347         
     BD00             (    forth6809.asm):00348         SP0      EQU  DSTACK+1
     C000             (    forth6809.asm):00349         RP0      EQU  RSTACK+1
                      (    forth6809.asm):00350         
                      (    forth6809.asm):00351         ; ------------------------------------------------------------
                      (    forth6809.asm):00352         ; SERIALPOLL - conditional-assembly switch for serial I/O.
                      (    forth6809.asm):00353         ; 1 (default): KEY/KEYQ/EMIT poll ACIASR directly, no interrupts,
                      (    forth6809.asm):00354         ; no ring buffers, no RTS/CTS handshaking - IRQH is a harmless RTI
                      (    forth6809.asm):00355         ; stub, matching the other unused vectors (NMIH/FIRQH/SWI2H/
                      (    forth6809.asm):00356         ; SWI3H). 0: the original interrupt-driven implementation, with
                      (    forth6809.asm):00357         ; INBUF/OUTBUF ring buffers serviced by IRQH and RTS-based flow
                      (    forth6809.asm):00358         ; control via INFILL/RTSCHECKHI/RTSCHECKLO. Uses LWASM's IFEQ/
                      (    forth6809.asm):00359         ; ELSE/ENDC (a numeric-expression test, not IFDEF/IFNDEF, since
                      (    forth6809.asm):00360         ; this is a value to compare, not a symbol's mere presence).
                      (    forth6809.asm):00361         ;
                      (    forth6809.asm):00362         ; Was a fixed EQU, meaning it could only ever be changed by
                      (    forth6809.asm):00363         ; editing this file directly - unlike UNITTESTS/TSTSELECTOR
                      (    forth6809.asm):00364         ; below, a plain EQU cannot be overridden via lwasm's own -D
                      (    forth6809.asm):00365         ; command-line option (EQU is a one-time, permanent binding;
                      (    forth6809.asm):00366         ; -D's own documented behavior is to predefine a symbol "as
                      (    forth6809.asm):00367         ; though...defined using the SET directive," which a later EQU
                      (    forth6809.asm):00368         ; for the same symbol does not honor). Switched to the same
                      (    forth6809.asm):00369         ; IFNDEF/SET/ENDC pattern as UNITTESTS/TSTSELECTOR immediately
                      (    forth6809.asm):00370         ; below for exactly that reason: SERIALPOLL can now be selected
                      (    forth6809.asm):00371         ; at build time with -DSERIALPOLL=0 (interrupt-driven) or
                      (    forth6809.asm):00372         ; -DSERIALPOLL=1 (polling, same as omitting -D entirely, since 1
                      (    forth6809.asm):00373         ; remains the fallback default here).
                      (    forth6809.asm):00374         ; ------------------------------------------------------------
                      (    forth6809.asm):00375                    IFNDEF SERIALPOLL
0000                  (    forth6809.asm):00376         SERIALPOLL SET 1   ; Fallback default value if -D wasn't passed.
                      (    forth6809.asm):00377                    ENDC
                      (    forth6809.asm):00378         
                      (    forth6809.asm):00379         ; ------------------------------------------------------------
                      (    forth6809.asm):00380         ; ACIA (6850) constants - the chip sits at INOUT+8, not at the
                      (    forth6809.asm):00381         ; base of the I/O block, leaving INOUT+0..INOUT+7 free for other
                      (    forth6809.asm):00382         ; memory-mapped devices sharing this 256-byte region
                      (    forth6809.asm):00383         ; ------------------------------------------------------------
     C008             (    forth6809.asm):00384         ACIA     EQU  INOUT+8
     C008             (    forth6809.asm):00385         ACIACR   EQU  ACIA
     C008             (    forth6809.asm):00386         ACIASR   EQU  ACIA
     C009             (    forth6809.asm):00387         ACIADR   EQU  ACIA+1
     0001             (    forth6809.asm):00388         SR_RDRF  EQU  $01
     0002             (    forth6809.asm):00389         SR_TDRE  EQU  $02
     0080             (    forth6809.asm):00390         SR_IRQ   EQU  $80
     0003             (    forth6809.asm):00391         CR_RESET EQU  $03
     0095             (    forth6809.asm):00392         CR_RXON  EQU  $95
     00B5             (    forth6809.asm):00393         CR_RXTX  EQU  $B5
     0015             (    forth6809.asm):00394         CR_POLL  EQU  $15     ; bit7=0 (RX interrupt disabled), bits6-5=00 (RTS
                      (    forth6809.asm):00395                                ; low, TX interrupt disabled) - CR_RXON ($95) with
                      (    forth6809.asm):00396                                ; only the RX-interrupt-enable bit cleared. Used
                      (    forth6809.asm):00397                                ; only when SERIALPOLL=1; RTS stays permanently
                      (    forth6809.asm):00398                                ; low (asserted), since polling mode has no ring
                      (    forth6809.asm):00399                                ; buffer to overflow and so needs no flow control
     00D5             (    forth6809.asm):00400         CR_RTSHI EQU  $D5     ; bits6-5=10: RTS high, TX int disabled, RX int enabled -
                      (    forth6809.asm):00401                                ; derived from CR_RXON ($95) with bits6-5 changed from
                      (    forth6809.asm):00402                                ; 00 to 10; the ACIA has no combination offering RTS
                      (    forth6809.asm):00403                                ; high AND TX interrupt enabled simultaneously (bits6-5
                      (    forth6809.asm):00404                                ; only has 00/01/10/11, and only 01 enables TX interrupt,
                      (    forth6809.asm):00405                                ; which always ties RTS low) - EMIT/IRQH's TXCHK must
                      (    forth6809.asm):00406                                ; respect this and defer transmission while RTS is high
                      (    forth6809.asm):00407         
     0030             (    forth6809.asm):00408         INHIWATER EQU 48       ; input ring fill level (of 64) at/above which RTS is
                      (    forth6809.asm):00409                                 ; asserted high, telling the remote device to pause
     0010             (    forth6809.asm):00410         INLOWATER EQU 16        ; fill level at/below which RTS is reasserted low;
                      (    forth6809.asm):00411                                  ; deliberately well below INHIWATER (hysteresis) so
                      (    forth6809.asm):00412                                  ; RTS doesn't chatter right at a single threshold
                      (    forth6809.asm):00413         
                      (    forth6809.asm):00414         ; ------------------------------------------------------------
                      (    forth6809.asm):00415         ; Flag / opcode constants
                      (    forth6809.asm):00416         ; ------------------------------------------------------------
     FFFF             (    forth6809.asm):00417         TRUEV    EQU  $FFFF
     0000             (    forth6809.asm):00418         FALSEV   EQU  $0000
     00BD             (    forth6809.asm):00419         OPJSR    EQU  $BD
     0039             (    forth6809.asm):00420         OPRTS    EQU  $39      ; used by section 3.8's control-flow test
                      (    forth6809.asm):00421                                  ; harness to terminate each compiled test
                      (    forth6809.asm):00422                                  ; snippet, compiled via CCOMMA
     0039             (    forth6809.asm):00423         RTSOPC   EQU  $39
                      (    forth6809.asm):00424         
                      (    forth6809.asm):00425         ; ------------------------------------------------------------
                      (    forth6809.asm):00426         ; Control-flow compile-time tags
                      (    forth6809.asm):00427         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00428         TAGFWD   EQU  1
     0002             (    forth6809.asm):00429         TAGBACK  EQU  2
     0003             (    forth6809.asm):00430         TAGDO    EQU  3
     0004             (    forth6809.asm):00431         TAGCASE  EQU  4
     0005             (    forth6809.asm):00432         TAGOF    EQU  5
     0006             (    forth6809.asm):00433         TAGENDOF EQU  6

                      (    forth6809.asm):17969                                     ; the double-cell table (below) before
                      (    forth6809.asm):17970                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):17971                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):17972                                     ; turn - both are double-cell values per
                      (    forth6809.asm):17973                                     ; their own ANS data type, which this
                      (    forth6809.asm):17974                                     ; single-cell table's ENVFOUND (pushing

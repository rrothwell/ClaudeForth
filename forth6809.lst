                      (    forth6809.asm):07765         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07766         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07767         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07768         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07769         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07770         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07771         ; division.
                      (    forth6809.asm):07772         ; Original comment: shadow ENVQUERYW.0.
                      (    forth6809.asm):07773         ; ------------------------------------------------------------
FBCC 3706             (    forth6809.asm):07774         ENVQUERYW:  PULU  D                 ; u
FBCE DDEF             (    forth6809.asm):07775                     STD   ENVLEN
FBD0 3706             (    forth6809.asm):07776                     PULU  D                 ; c-addr
FBD2 DDF1             (    forth6809.asm):07777                     STD   ENVADDR
FBD4 8EFC67           (    forth6809.asm):07778                     LDX   #ENVTABLE
FBD7 EC84             (    forth6809.asm):07779         ENVLOOP:    LDD   ,X
FBD9 10830000         (    forth6809.asm):07780                     CMPD  #0
FBDD 272B             (    forth6809.asm):07781                     BEQ   ENV2START         ; end of table: try ENVTABLE2
FBDF 3410             (    forth6809.asm):07782                     PSHS  X                 ; See bugfix: ENVQUERYW.2
FBE1 3606             (    forth6809.asm):07783                     PSHU  D
FBE3 EC02             (    forth6809.asm):07784                     LDD   2,X
FBE5 3606             (    forth6809.asm):07785                     PSHU  D
FBE7 DCF1             (    forth6809.asm):07786                     LDD   ENVADDR
FBE9 3606             (    forth6809.asm):07787                     PSHU  D
FBEB DCEF             (    forth6809.asm):07788                     LDD   ENVLEN
FBED 3606             (    forth6809.asm):07789                     PSHU  D
FBEF BDF64F           (    forth6809.asm):07790                     JSR   COMPAREW
FBF2 3510             (    forth6809.asm):07791                     PULS  X                 ; restore X before using it again
FBF4 3706             (    forth6809.asm):07792                     PULU  D
FBF6 10830000         (    forth6809.asm):07793                     CMPD  #0
FBFA 2704             (    forth6809.asm):07794                     BEQ   ENVFOUND
FBFC 3006             (    forth6809.asm):07795                     LEAX  6,X
FBFE 20D7             (    forth6809.asm):07796                     BRA   ENVLOOP

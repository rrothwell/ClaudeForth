                      (    forth6809.asm):02643         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02644         ; Covers every word in that section, with representative
                      (    forth6809.asm):02645         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02646         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02647         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02648         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02649         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02650         ; cases chosen.
                      (    forth6809.asm):02651         ; ------------------------------------------------------------

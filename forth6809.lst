E453 2718             (    forth6809.asm):03673                   BEQ   NQPOS32
E455 DC76             (    forth6809.asm):03674                   LDD   UDLO
E457 43               (    forth6809.asm):03675                   COMA
E458 53               (    forth6809.asm):03676                   COMB
E459 C30001           (    forth6809.asm):03677                   ADDD  #1
E45C DD76             (    forth6809.asm):03678                   STD   UDLO
E45E 3401             (    forth6809.asm):03679                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03680                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03681                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03682                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03683                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03684                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03685                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03686                                      ; making the high-cell increment run
                      (    forth6809.asm):03687                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03688                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03689                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03690                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03691                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03692                                      ; matching "always increment" rather than
                      (    forth6809.asm):03693                                      ; "increment only on genuine carry".
E460 DC74             (    forth6809.asm):03694                   LDD   UDHI
E462 43               (    forth6809.asm):03695                   COMA
E463 53               (    forth6809.asm):03696                   COMB
E464 3501             (    forth6809.asm):03697                   PULS  CC          ; restore the TRUE carry
E466 2403             (    forth6809.asm):03698                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03699                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03700                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03701                                      ; value was computed in D but never
                      (    forth6809.asm):03702                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03703                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03704                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03705                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03706                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03707                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03708                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03709                                      ; alone would have made this second,
                      (    forth6809.asm):03710                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03711                                      ; only past the "+1", never past the
                      (    forth6809.asm):03712                                      ; store itself - the store always runs,
                      (    forth6809.asm):03713                                      ; either way.
E468 C30001           (    forth6809.asm):03714                   ADDD  #1
E46B DD74             (    forth6809.asm):03715         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03716         
E46D                  (    forth6809.asm):03717         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03718                   ; was '.' - determines which return convention to use
E46D 9E1F             (    forth6809.asm):03719                   LDX   CADDR
E46F E684             (    forth6809.asm):03720                   LDB   ,X
E471 5A               (    forth6809.asm):03721                   DECB
E472 3001             (    forth6809.asm):03722                   LEAX  1,X
E474 A685             (    forth6809.asm):03723                   LDA   B,X
E476 812E             (    forth6809.asm):03724                   CMPA  #'.'
E478 260E             (    forth6809.asm):03725                   BNE   NQSINGLE
                      (    forth6809.asm):03726         
                      (    forth6809.asm):03727                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03728                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03729                   ; apart without needing a separate flag of its own either
E47A DC76             (    forth6809.asm):03730                   LDD   UDLO
E47C 3606             (    forth6809.asm):03731                   PSHU  D
E47E DC74             (    forth6809.asm):03732                   LDD   UDHI
E480 3606             (    forth6809.asm):03733                   PSHU  D
E482 CC0001           (    forth6809.asm):03734                   LDD   #1
E485 3606             (    forth6809.asm):03735                   PSHU  D
E487 39               (    forth6809.asm):03736                   RTS
                      (    forth6809.asm):03737         
E488                  (    forth6809.asm):03738         NQSINGLE: ; SINGLE success - unchanged from the original convention
E488 DC76             (    forth6809.asm):03739                   LDD   UDLO
E48A 3606             (    forth6809.asm):03740                   PSHU  D
E48C CCFFFF           (    forth6809.asm):03741                   LDD   #-1
E48F 3606             (    forth6809.asm):03742                   PSHU  D
E491 39               (    forth6809.asm):03743                   RTS
                      (    forth6809.asm):03744         
E492 9E1F             (    forth6809.asm):03745         NQBAD:    LDX   CADDR
E494 3610             (    forth6809.asm):03746                   PSHU  X
E496 CC0000           (    forth6809.asm):03747                   LDD   #0
E499 3606             (    forth6809.asm):03748                   PSHU  D
E49B 39               (    forth6809.asm):03749                   RTS

                      (    forth6809.asm):07512         
                      (    forth6809.asm):07513         ; ------------------------------------------------------------
                      (    forth6809.asm):07514         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):07515         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):07516         ; low byte of BASE is used.
                      (    forth6809.asm):07517         ; UDDIGIT
                      (    forth6809.asm):07518         ;    Inputs:
                      (    forth6809.asm):07519         ;        ud on the data stack
                      (    forth6809.asm):07520         ;    Outputs:
                      (    forth6809.asm):07521         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):07522         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):07523         ; ------------------------------------------------------------
F9F7 4F               (    forth6809.asm):07524         UDDIGIT:    CLRA                    ; A = remainder
F9F8 C620             (    forth6809.asm):07525                     LDB   #32
F9FA 6843             (    forth6809.asm):07526         UDDLOOP:    ASL   3,U

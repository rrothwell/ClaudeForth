                      (    forth6809.asm):03223         ;    Outputs:
                      (    forth6809.asm):03224         ;        UDHI:UDLO = ud * BASE + digit
                      (    forth6809.asm):03225         ;    Registers: RegA, RegB and CC changed; CARRY and MULBASE used as
                      (    forth6809.asm):03226         ;        scratch.

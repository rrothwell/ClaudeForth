                      (    forth6809.asm):04868         ; Arity: 2 cell(s) in, 1 cell(s) out -> depth check
                      (    forth6809.asm):04869         ; -2 (derived, not hand-typed).
                      (    forth6809.asm):04870         ; ------------------------------------------------------------

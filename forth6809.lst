                      (    forth6809.asm):06743         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):06744         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):06745         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):06746         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):06747         ; (off-by-one, wrong direction, wrong starting value) would
                      (    forth6809.asm):06748         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (    forth6809.asm):06749         ; just "some number of iterations happened."
                      (    forth6809.asm):06750         ;
                      (    forth6809.asm):06751         ; The documented limit=index edge case (runs at least once) is
                      (    forth6809.asm):06752         ; deliberately NOT tested here: traced precisely (simulated the
                      (    forth6809.asm):06753         ; real DOTEST increment-and-compare-equal logic) and confirmed
                      (    forth6809.asm):06754         ; it takes a full 65536 iterations to naturally reconverge on
                      (    forth6809.asm):06755         ; equality, not one - true to the letter of "at least once" but
                      (    forth6809.asm):06756         ; impractical for a boot-time self-check. Left untested, not
                      (    forth6809.asm):06757         ; guessed at; noted in the open-items checklist.
                      (    forth6809.asm):06758         ; ------------------------------------------------------------
C472                  (    forth6809.asm):06759         TSTDOLP: LDD   CODEHERE
                      (    forth6809.asm):06760                  STD   TSTCSAV
                      (    forth6809.asm):06761                  LDD   #TSTCBUF
                      (    forth6809.asm):06762                  STD   CODEHERE
                      (    forth6809.asm):06763         
                      (    forth6809.asm):06764                  JSR   DO
                      (    forth6809.asm):06765         

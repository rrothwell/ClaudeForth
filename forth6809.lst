                      (    forth6809.asm):09770         
                      (    forth6809.asm):09771                   LDD  #TSTGUARD
                      (    forth6809.asm):09772                   PSHU D
                      (    forth6809.asm):09773                   STU  TSTUB4
                      (    forth6809.asm):09774         
                      (    forth6809.asm):09775                   JSR  TICK
                      (    forth6809.asm):09776         

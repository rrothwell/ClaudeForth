                      (    forth6809.asm):06736                  STD   CODEHERE
                      (    forth6809.asm):06737         
                      (    forth6809.asm):06738                  TFR   U,D
                      (    forth6809.asm):06739                  STD   CSP
                      (    forth6809.asm):06740         

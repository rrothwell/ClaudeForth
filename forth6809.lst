DCF2 39               (    forth6809.asm):01588                     RTS
                      (    forth6809.asm):01589         
                      (    forth6809.asm):01590                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01591         ; ------------------------------------------------------------
                      (    forth6809.asm):01592         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01593         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01594         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01595         ; INFILL
                      (    forth6809.asm):01596         ;    Inputs:
                      (    forth6809.asm):01597         ;        none
                      (    forth6809.asm):01598         ;    Outputs:
                      (    forth6809.asm):01599         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01600         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01601         ; ------------------------------------------------------------
DCF3 B60176           (    forth6809.asm):01602         INFILL:     LDA   INHEAD
DCF6 B00177           (    forth6809.asm):01603                     SUBA  INTAIL
DCF9 843F             (    forth6809.asm):01604                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DCFB 39               (    forth6809.asm):01605                     RTS
                      (    forth6809.asm):01606         ; ------------------------------------------------------------
                      (    forth6809.asm):01607         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01608         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01609         ; receive path with interrupts already masked.
                      (    forth6809.asm):01610         ; RTSCHECKHI
                      (    forth6809.asm):01611         ;    Inputs:
                      (    forth6809.asm):01612         ;        none
                      (    forth6809.asm):01613         ;    Outputs:
                      (    forth6809.asm):01614         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01615         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01616         ; ------------------------------------------------------------
DCFC BDDCF3           (    forth6809.asm):01617         RTSCHECKHI: JSR   INFILL
DCFF 8130             (    forth6809.asm):01618                     CMPA  #INHIWATER
DD01 250F             (    forth6809.asm):01619                     BLO   RTSCHIDONE
DD03 7D0178           (    forth6809.asm):01620                     TST   RTSSTATE
DD06 260A             (    forth6809.asm):01621                     BNE   RTSCHIDONE        ; already high - nothing to do
DD08 86D5             (    forth6809.asm):01622                     LDA   #CR_RTSHI
DD0A B7C008           (    forth6809.asm):01623                     STA   ACIACR
DD0D 8601             (    forth6809.asm):01624                     LDA   #1
DD0F B70178           (    forth6809.asm):01625                     STA   RTSSTATE
DD12 39               (    forth6809.asm):01626         RTSCHIDONE: RTS
                      (    forth6809.asm):01627         ; ------------------------------------------------------------
                      (    forth6809.asm):01628         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01629         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01630         ; enables it only while output is pending.
                      (    forth6809.asm):01631         ; UPDATE_RTS
                      (    forth6809.asm):01632         ;    Inputs:
                      (    forth6809.asm):01633         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01634         ;    Outputs:
                      (    forth6809.asm):01635         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01636         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01637         ; ------------------------------------------------------------
DD13                  (    forth6809.asm):01638         UPDATE_RTS:
DD13 7D0178           (    forth6809.asm):01639                     TST   RTSSTATE
DD16 260D             (    forth6809.asm):01640                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01641         
DD18 7D017B           (    forth6809.asm):01642                     TST   OUTACTIVITY       ; Is active?
DD1B 2704             (    forth6809.asm):01643                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01644         
                      (    forth6809.asm):01645                                             ; $B5/%1011_0101
DD1D 86B5             (    forth6809.asm):01646                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
DD1F 2009             (    forth6809.asm):01647                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01648         
DD21                  (    forth6809.asm):01649         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
DD21 8695             (    forth6809.asm):01650                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
DD23 2005             (    forth6809.asm):01651                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01652         
DD25                  (    forth6809.asm):01653         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
DD25 86D5             (    forth6809.asm):01654                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
DD27 7F017B           (    forth6809.asm):01655                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DD2A                  (    forth6809.asm):01656         WRITE_CR:
DD2A B7C008           (    forth6809.asm):01657                     STA   ACIACR
DD2D 39               (    forth6809.asm):01658                     RTS
                      (    forth6809.asm):01659         ; ------------------------------------------------------------
                      (    forth6809.asm):01660         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01661         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01662         ; Called after a character is added to the ring.
                      (    forth6809.asm):01663         ; CHKHI
                      (    forth6809.asm):01664         ;    Inputs:
                      (    forth6809.asm):01665         ;        RegB = input ring fill level
                      (    forth6809.asm):01666         ;    Outputs:
                      (    forth6809.asm):01667         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01668         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01669         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01670         ; ------------------------------------------------------------
DD2E                  (    forth6809.asm):01671         CHKHI:
DD2E C130             (    forth6809.asm):01672                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
DD30 250D             (    forth6809.asm):01673                     BLO   CHKHIDONE         ; No! Do nothing.
DD32 7D0178           (    forth6809.asm):01674                     TST   RTSSTATE
DD35 2608             (    forth6809.asm):01675                     BNE   CHKHIDONE         ; already high - nothing to do
DD37 86FF             (    forth6809.asm):01676                     LDA   #INREJECT         ; Yes! De-assert RTS.
DD39 B70178           (    forth6809.asm):01677                     STA   RTSSTATE
DD3C BDDD13           (    forth6809.asm):01678                     JSR   UPDATE_RTS
DD3F 39               (    forth6809.asm):01679         CHKHIDONE:  RTS
                      (    forth6809.asm):01680         
                      (    forth6809.asm):01681         ; ------------------------------------------------------------
                      (    forth6809.asm):01682         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01683         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01684         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01685         ; CHKLO
                      (    forth6809.asm):01686         ;    Inputs:
                      (    forth6809.asm):01687         ;        RegB = input ring fill level
                      (    forth6809.asm):01688         ;    Outputs:
                      (    forth6809.asm):01689         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01690         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01691         ; ------------------------------------------------------------
DD40                  (    forth6809.asm):01692         CHKLO:
DD40 C110             (    forth6809.asm):01693                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
DD42 240D             (    forth6809.asm):01694                     BHS   CHKLODONE         ; No! Do nothing.
DD44 7D0178           (    forth6809.asm):01695                     TST   RTSSTATE
DD47 2708             (    forth6809.asm):01696                     BEQ   CHKLODONE         ; already low - nothing to do
DD49 8600             (    forth6809.asm):01697                     LDA   #INACCEPT         ; Yes! Assert RTS.
DD4B B70178           (    forth6809.asm):01698                     STA   RTSSTATE
DD4E BDDD13           (    forth6809.asm):01699                     JSR   UPDATE_RTS
DD51 39               (    forth6809.asm):01700         CHKLODONE:  RTS
                      (    forth6809.asm):01701         ; ------------------------------------------------------------
                      (    forth6809.asm):01702         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01703         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01704         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01705         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01706         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01707         ;    Inputs:
                      (    forth6809.asm):01708         ;        none
                      (    forth6809.asm):01709         ;    Outputs:
                      (    forth6809.asm):01710         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01711         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01712         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01713         ; ------------------------------------------------------------
DD52                  (    forth6809.asm):01714         FLUSHOUTBUFFER:
DD52 F6017A           (    forth6809.asm):01715                     LDB   OUTTAIL
DD55 F10179           (    forth6809.asm):01716                     CMPB  OUTHEAD           ; Is transmit buffer empty?
DD58 2719             (    forth6809.asm):01717                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01718         
DD5A B6C008           (    forth6809.asm):01719                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01720                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01721                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01722         
DD61 8502             (    forth6809.asm):01723                     BITA  #SR_TDRE          ; Is transmit register empty?
DD63 270E             (    forth6809.asm):01724                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01725                                             ; than spin-wait here.
                      (    forth6809.asm):01726         
DD65 8E01C0           (    forth6809.asm):01727                     LDX   #OUTBUF           ; The out buffer is occupied.
DD68 A685             (    forth6809.asm):01728                     LDA   B,X               ; Get the character from the out buffer.
DD6A B7C009           (    forth6809.asm):01729                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01730         
DD6D 5C               (    forth6809.asm):01731                     INCB                    ; Update tail pointer to next character slot.
DD6E C43F             (    forth6809.asm):01732                     ANDB  #OUTBUFSZ-1
DD70 F7017A           (    forth6809.asm):01733                     STB   OUTTAIL
                      (    forth6809.asm):01734                                             ; One character sent - return rather than
                      (    forth6809.asm):01735                                             ; loop back for more (see header comment).
DD73                  (    forth6809.asm):01736         FLUSHED:
DD73 39               (    forth6809.asm):01737                     RTS
                      (    forth6809.asm):01738         ; ------------------------------------------------------------
                      (    forth6809.asm):01739         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01740         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01741         ; PUTCHAR
                      (    forth6809.asm):01742         ;    Inputs:
                      (    forth6809.asm):01743         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):01744         ;    Outputs:
                      (    forth6809.asm):01745         ;        none
                      (    forth6809.asm):01746         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):01747         ; ------------------------------------------------------------
DD74                  (    forth6809.asm):01748         PUTCHAR:
DD74 3411             (    forth6809.asm):01749                     PSHS  CC,X
DD76 1A50             (    forth6809.asm):01750                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):01751         
DD78 F60179           (    forth6809.asm):01752                     LDB   OUTHEAD           ; Is buffer full?
DD7B 5C               (    forth6809.asm):01753                     INCB
DD7C C43F             (    forth6809.asm):01754                     ANDB  #OUTBUFSZ-1
DD7E F1017A           (    forth6809.asm):01755                     CMPB  OUTTAIL
DD81 273A             (    forth6809.asm):01756                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):01757         
DD83 8E01C0           (    forth6809.asm):01758                     LDX   #OUTBUF           ; Put character into character slot.
DD86 F60179           (    forth6809.asm):01759                     LDB   OUTHEAD
DD89 A785             (    forth6809.asm):01760                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):01761         
DD8B 5C               (    forth6809.asm):01762                     INCB                    ; Update tail pointer to next character slot.
DD8C C43F             (    forth6809.asm):01763                     ANDB  #OUTBUFSZ-1
DD8E F70179           (    forth6809.asm):01764                     STB   OUTHEAD
                      (    forth6809.asm):01765         
DD91 7D0178           (    forth6809.asm):01766                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
DD94 2709             (    forth6809.asm):01767                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):01768         
                      (    forth6809.asm):01769                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):01770                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
DD96 1CAF             (    forth6809.asm):01771                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
DD98 BDDD52           (    forth6809.asm):01772                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
DD9B 1A50             (    forth6809.asm):01773                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):01774                                             ; expects the critical section active
                      (    forth6809.asm):01775         
DD9D 201E             (    forth6809.asm):01776                     BRA   PUT_EXIT
                      (    forth6809.asm):01777         
                      (    forth6809.asm):01778         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):01779         ; priming the pump by transmitting a character.
DD9F                  (    forth6809.asm):01780         CHK_INT_PATH:
DD9F 7D017B           (    forth6809.asm):01781                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
DDA2 2619             (    forth6809.asm):01782                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):01783         
                      (    forth6809.asm):01784                                             ; No! Restart.
DDA4 8E01C0           (    forth6809.asm):01785                     LDX   #OUTBUF           ; Pull character from the out buffer.
DDA7 F6017A           (    forth6809.asm):01786                     LDB   OUTTAIL
DDAA A685             (    forth6809.asm):01787                     LDA   B,X

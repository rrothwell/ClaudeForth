                      (    forth6809.asm):03713         ; KEY ( -- char )
                      (    forth6809.asm):03714         ; ------------------------------------------------------------
E476                  (    forth6809.asm):03715         KEY:
                      (    forth6809.asm):03716         
                      (    forth6809.asm):03717                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03718                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03719         
                      (    forth6809.asm):03720                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03721                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03722                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03723                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03724                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03725                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03726                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03727                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03728                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03729                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03730                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03731                                             ; by transmitting all chars.
                      (    forth6809.asm):03732         
E476                  (    forth6809.asm):03733         TRY_READ:
                      (    forth6809.asm):03734                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03735                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03736                                             ; while still transmitting!
                      (    forth6809.asm):03737                 
                      (    forth6809.asm):03738                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03739                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03740                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03741         
                      (    forth6809.asm):03742                     RTS                     
                      (    forth6809.asm):03743         
                      (    forth6809.asm):03744         ; ------------------------------------------------------------
                      (    forth6809.asm):03745         ; KEY? ( -- flag )
                      (    forth6809.asm):03746         ; ------------------------------------------------------------
E476                  (    forth6809.asm):03747         KEYQ:  
                      (    forth6809.asm):03748                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03749         
                      (    forth6809.asm):03750                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03751                     CMPA  INTAIL
                      (    forth6809.asm):03752         
                      (    forth6809.asm):03753                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03754         
                      (    forth6809.asm):03755                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03756         
                      (    forth6809.asm):03757                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03758                     PSHU  D
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760                     RTS
                      (    forth6809.asm):03761         
E476                  (    forth6809.asm):03762         KQTRUE:     
                      (    forth6809.asm):03763                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03764                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03765                     RTS
                      (    forth6809.asm):03766         ; ------------------------------------------------------------

                      (    forth6809.asm):11610         ; overlap-unsafe behavior in the high-over-low direction is
                      (    forth6809.asm):11611         ; exactly what MOVE exists to route around, so CMOVE's own
                      (    forth6809.asm):11612         ; tests stick to the simple, well-defined case; see TSTMOVE2/
                      (    forth6809.asm):11613         ; TSTMOVE3 below for the overlap-specific verification.
                      (    forth6809.asm):11614         ; ------------------------------------------------------------

                      (    forth6809.asm):02907         ; ============================================================
                      (    forth6809.asm):02908         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02909         ; ============================================================
                      (    forth6809.asm):02910         ; ------------------------------------------------------------
                      (    forth6809.asm):02911         ; INTERPRET  ( -- )
                      (    forth6809.asm):02912         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02913         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02914         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02915         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02916         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02917         ; ------------------------------------------------------------
E2CF                  (    forth6809.asm):02918         INTERPRET:
E2CF CC0020           (    forth6809.asm):02919         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1

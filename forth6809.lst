                      (    forth6809.asm):17331                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):17332                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):17333                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):17334                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):17335                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):17336                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):17337                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):17338                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):17339                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):17340                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):17341                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):17342                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):17343                  ; for it.
E591 D621             (    forth6809.asm):17344                  LDB   CNTREM
E593 5A               (    forth6809.asm):17345                  DECB
E594 A685             (    forth6809.asm):17346                  LDA   B,X
E596 812E             (    forth6809.asm):17347                  CMPA  #'.'
E598 2604             (    forth6809.asm):17348                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):17349                  DEC   CNTREM
E59C 2766             (    forth6809.asm):17350                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):17351         
E59E 0F22             (    forth6809.asm):17352         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):17353                  LDA   ,X
E5A2 812D             (    forth6809.asm):17354                  CMPA  #'-'
E5A4 2608             (    forth6809.asm):17355                  BNE   NQNOSIGN2
E5A6 0322             (    forth6809.asm):17356                  COM   NUMNEG
E5A8 3001             (    forth6809.asm):17357                  LEAX  1,X
E5AA 0A21             (    forth6809.asm):17358                  DEC   CNTREM
E5AC 2756             (    forth6809.asm):17359                  BEQ   NQBAD
                      (    forth6809.asm):17360         

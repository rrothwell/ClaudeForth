                      (    forth6809.asm):06288         ; Common part of */ and */MOD: form the 32-bit product n1 * n2, then
                      (    forth6809.asm):06289         ; divide it by n3. The quotient is negated if an odd number of the
                      (    forth6809.asm):06290         ; three is negative, the remainder if the product is negative. THROW
                      (    forth6809.asm):06291         ; -10 if n3 is zero.
                      (    forth6809.asm):06292         ; STARSLASHCOMMON   ( n1 n2 n3 -- )
                      (    forth6809.asm):06293         ;    Inputs:
                      (    forth6809.asm):06294         ;        n1, n2 and n3 on the data stack (n3 on top)
                      (    forth6809.asm):06295         ;    Outputs:
                      (    forth6809.asm):06296         ;        PRODLO = quotient, DIVREM = remainder (data stack popped)
                      (    forth6809.asm):06297         ;    Registers: RegA, RegB and RegD changed; many scratch cells used.
                      (    forth6809.asm):06298         ; ------------------------------------------------------------
E2D2                  (    forth6809.asm):06299         STARSLASHCOMMON:

                      (    forth6809.asm):02907         ; ------------------------------------------------------------
                      (    forth6809.asm):02908         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02909         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02910         ;    Inputs:
                      (    forth6809.asm):02911         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02912         ;    Outputs:
                      (    forth6809.asm):02913         ;        pfa replaced by the value
                      (    forth6809.asm):02914         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02915         ; ------------------------------------------------------------
E069 3710             (    forth6809.asm):02916         DOVALUE:    PULU  X                 ; pfa
E06B EC84             (    forth6809.asm):02917                     LDD   ,X
E06D 3606             (    forth6809.asm):02918                     PSHU  D                 ; x
E06F 39               (    forth6809.asm):02919                     RTS
                      (    forth6809.asm):02920         
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
                      (    forth6809.asm):02922         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02923         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02924         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02925         ; ------------------------------------------------------------

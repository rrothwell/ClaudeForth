                      (    forth6809.asm):07771         ; TSTDEFWORDS - defining-words tests (glossary section 3.9, 17
                      (    forth6809.asm):07772         ; words, 12 tests since VALUE/TO and IS/ACTION-OF are each
                      (    forth6809.asm):07773         ; combined into one test). Every defining word parses a name
                      (    forth6809.asm):07774         ; from the input source via WORD (HEADER's own mechanism,
                      (    forth6809.asm):07775         ; shared by :/CREATE) - a complexity nothing in section 3.8 had.
                      (    forth6809.asm):07776         ; Each test redirects CODEHERE, DPHERE, VARHERE, and
                      (    forth6809.asm):07777         ; SRCADDR/SRCLEN/TOIN together (a fake name, "TESTWD", reused
                      (    forth6809.asm):07778         ; safely across every test here since each redirect/restore
                      (    forth6809.asm):07779         ; cycle is fully isolated), calls the real defining word
                      (    forth6809.asm):07780         ; directly, saves the newly-defined word's own CFA (= CODEHERE
                      (    forth6809.asm):07781         ; at the moment the defining word was called), restores
                      (    forth6809.asm):07782         ; everything, then executes that CFA directly to verify runtime
                      (    forth6809.asm):07783         ; behavior.
                      (    forth6809.asm):07784         ;
                      (    forth6809.asm):07785         ; A real, structurally important finding from this section:
                      (    forth6809.asm):07786         ; HEADER writes to the real LATEST variable unconditionally, not
                      (    forth6809.asm):07787         ; a redirectable copy like CODEHERE/DPHERE/VARHERE - every test
                      (    forth6809.asm):07788         ; here explicitly saves and restores it, confirmed necessary by
                      (    forth6809.asm):07789         ; reading HEADER's own code directly, not assumed safe by analogy
                      (    forth6809.asm):07790         ; with the other three pointers.
                      (    forth6809.asm):07791         ;
                      (    forth6809.asm):07792         ; MARKER's own test is the one exception to the general
                      (    forth6809.asm):07793         ; redirect-then-restore-then-execute order: DOMARKER (confirmed
                      (    forth6809.asm):07794         ; by reading it directly) writes to the real DPHERE/CODEHERE/
                      (    forth6809.asm):07795         ; VARHERE/LATEST unconditionally too, so that test executes the
                      (    forth6809.asm):07796         ; marker word while still redirected, only restoring the real
                      (    forth6809.asm):07797         ; environment afterward - getting this order backwards would
                      (    forth6809.asm):07798         ; have corrupted the real dictionary pointers with scratch
                      (    forth6809.asm):07799         ; addresses.
                      (    forth6809.asm):07800         ;
                      (    forth6809.asm):07801         ; Bare CREATE (never followed by DOES>) is deliberately not
                      (    forth6809.asm):07802         ; tested on its own - traced its placeholder "behavior field"
                      (    forth6809.asm):07803         ; (a genuine compiled JSR DOESRT0 instruction) and confirmed
                      (    forth6809.asm):07804         ; DODOES reads that field as raw data, not as code to execute -
                      (    forth6809.asm):07805         ; which only produces a valid jump target for the raw-address
                      (    forth6809.asm):07806         ; form every other defining word uses (VARIABLE, CONSTANT, etc,
                      (    forth6809.asm):07807         ; via CODECOMMA), not CREATE's own placeholder JSR instruction.
                      (    forth6809.asm):07808         ; Bare CREATE's own direct-execution behavior isn't meant to be
                      (    forth6809.asm):07809         ; relied upon before a DOES> patches it.
                      (    forth6809.asm):07810         ; ------------------------------------------------------------
C248 BDFC2B           (    forth6809.asm):07811         TSTDEFWORDS: JSR CRW
C24B 8EC25C           (    forth6809.asm):07812                    LDX   #TSTDEFMSG
C24E 3610             (    forth6809.asm):07813                    PSHU  X
C250 CC0008           (    forth6809.asm):07814                    LDD   #8
C253 3606             (    forth6809.asm):07815                    PSHU  D
C255 BDF60B           (    forth6809.asm):07816                    JSR   TYPE
C258 BDFC2B           (    forth6809.asm):07817                    JSR   CRW
                      (    forth6809.asm):07818         
                      (    forth6809.asm):07819                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07820         
                      (    forth6809.asm):07821                    JSR   TSTVAR
                      (    forth6809.asm):07822                    JSR   TSTCONST
                      (    forth6809.asm):07823                    JSR   TSTCOLON
                      (    forth6809.asm):07824                    JSR   TSTCRDOES
                      (    forth6809.asm):07825                    JSR   TST2VAR
                      (    forth6809.asm):07826                    JSR   TST2CONST
                      (    forth6809.asm):07827                    JSR   TSTBUFC
                      (    forth6809.asm):07828                    JSR   TSTVALTO
                      (    forth6809.asm):07829                    JSR   TSTDEFER1
                      (    forth6809.asm):07830                    JSR   TSTDEFER2
                      (    forth6809.asm):07831                    JSR   TSTISOF
                      (    forth6809.asm):07832                    JSR   TSTMARKER
                      (    forth6809.asm):07833         
                      (    forth6809.asm):07834                    ENDC ; <<<<
                      (    forth6809.asm):07835         
C25B 39               (    forth6809.asm):07836                    RTS
                      (    forth6809.asm):07837         
C25C 446566576F726473 (    forth6809.asm):07838         TSTDEFMSG: FCC "DefWords"
                      (    forth6809.asm):07839         
                      (    forth6809.asm):07840                    IFEQ TSTSELECTOR-8  ; >>>>
                      (    forth6809.asm):07841         
                      (    forth6809.asm):07842         ; ------------------------------------------------------------
                      (    forth6809.asm):07843         ; Defining-words test harness (glossary section 3.9). Every
                      (    forth6809.asm):07844         ; defining word parses a name from the input source via WORD -
                      (    forth6809.asm):07845         ; unlike anything in section 3.8's control-flow tests - so each
                      (    forth6809.asm):07846         ; test redirects CODEHERE, DPHERE, VARHERE, and SRCADDR/SRCLEN/
                      (    forth6809.asm):07847         ; TOIN together (a fake name text, "TESTWD", reused safely
                      (    forth6809.asm):07848         ; across every test here since each redirect/restore cycle is
                      (    forth6809.asm):07849         ; fully isolated), calls the real defining word directly, saves
                      (    forth6809.asm):07850         ; the newly-defined word's own CFA (= CODEHERE at the moment the
                      (    forth6809.asm):07851         ; defining word was called), restores everything, then executes
                      (    forth6809.asm):07852         ; that CFA directly to verify runtime behavior. Traced by hand:
                      (    forth6809.asm):07853         ; CREATE/VARIABLE/CONSTANT/etc all use HEADER (shared header-
                      (    forth6809.asm):07854         ; building) then compile a fixed 5-byte trampoline (3-byte
                      (    forth6809.asm):07855         ; "JSR DODOES" + a 2-byte "behavior field") before their own
                      (    forth6809.asm):07856         ; PFA - confirmed the behavior field holds a genuine compiled
                      (    forth6809.asm):07857         ; JSR instruction only for CREATE's own bare placeholder
                      (    forth6809.asm):07858         ; (DOESRT0, later patched by DOES>); every other defining word
                      (    forth6809.asm):07859         ; (VARIABLE, CONSTANT, DEFER, MARKER, VALUE) instead compiles a
                      (    forth6809.asm):07860         ; raw 2-byte address there directly (via CODECOMMA, not CCALL) -
                      (    forth6809.asm):07861         ; DODOES reads this field as data either way, which only works
                      (    forth6809.asm):07862         ; correctly for the raw-address form. This is why bare CREATE,
                      (    forth6809.asm):07863         ; executed before any DOES>, isn't tested here - its own
                      (    forth6809.asm):07864         ; placeholder behavior field isn't meant to be read as data,
                      (    forth6809.asm):07865         ; only ever overwritten by DOES> before first use.
                      (    forth6809.asm):07866         ; ------------------------------------------------------------
                      (    forth6809.asm):07867         
                      (    forth6809.asm):07868         ; ------------------------------------------------------------
                      (    forth6809.asm):07869         ; TSTVAR - unit test for VARIABLE. Compiles "VARIABLE TESTWD"
                      (    forth6809.asm):07870         ; into scratch, then executes the result. Verifies it pushes
                      (    forth6809.asm):07871         ; its own PFA address (TSTVBUF, since VARHERE was redirected
                      (    forth6809.asm):07872         ; there) and that the cell there was correctly initialized to
                      (    forth6809.asm):07873         ; zero - VARIABLE's own documented behavior, not assumed.
                      (    forth6809.asm):07874         ; ------------------------------------------------------------
C264                  (    forth6809.asm):07875         TSTVAR:  LDD   CODEHERE

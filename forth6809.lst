                      (    forth6809.asm):18459                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):18460                  JSR   TSTRUNNER
                      (    forth6809.asm):18461                  ELSE  ; <<<<<>>>>>
FFC6 12               (    forth6809.asm):18462                  NOP             ; BUG FIX (see the historical note above this
FFC7 12               (    forth6809.asm):18463                  NOP             ; call site's own comment, describing the
FFC8 12               (    forth6809.asm):18464                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):18465                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):18466                                  ; excluded the test framework, meaning
                      (    forth6809.asm):18467                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):18468                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):18469                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):18470                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):18471                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):18472                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):18473                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):18474                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):18475                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):18476                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):18477                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):18478         

                      (    forth6809.asm):03679                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03680                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03681                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03682                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03683                                      ; alone would have made this second,
                      (    forth6809.asm):03684                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03685                                      ; only past the "+1", never past the
                      (    forth6809.asm):03686                                      ; store itself - the store always runs,
                      (    forth6809.asm):03687                                      ; either way.
E45C C30001           (    forth6809.asm):03688                   ADDD  #1
E45F DD74             (    forth6809.asm):03689         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03690         
E461                  (    forth6809.asm):03691         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03692                   ; was '.' - determines which return convention to use
E461 9E1F             (    forth6809.asm):03693                   LDX   CADDR
E463 E684             (    forth6809.asm):03694                   LDB   ,X
E465 5A               (    forth6809.asm):03695                   DECB
E466 3001             (    forth6809.asm):03696                   LEAX  1,X
E468 A685             (    forth6809.asm):03697                   LDA   B,X
E46A 812E             (    forth6809.asm):03698                   CMPA  #'.'
E46C 260E             (    forth6809.asm):03699                   BNE   NQSINGLE
                      (    forth6809.asm):03700         
                      (    forth6809.asm):03701                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03702                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03703                   ; apart without needing a separate flag of its own either
E46E DC76             (    forth6809.asm):03704                   LDD   UDLO
E470 3606             (    forth6809.asm):03705                   PSHU  D
E472 DC74             (    forth6809.asm):03706                   LDD   UDHI
E474 3606             (    forth6809.asm):03707                   PSHU  D
E476 CC0001           (    forth6809.asm):03708                   LDD   #1
E479 3606             (    forth6809.asm):03709                   PSHU  D
E47B 39               (    forth6809.asm):03710                   RTS
                      (    forth6809.asm):03711         
E47C                  (    forth6809.asm):03712         NQSINGLE: ; SINGLE success - unchanged from the original convention
E47C DC76             (    forth6809.asm):03713                   LDD   UDLO
E47E 3606             (    forth6809.asm):03714                   PSHU  D
E480 CCFFFF           (    forth6809.asm):03715                   LDD   #-1
E483 3606             (    forth6809.asm):03716                   PSHU  D
E485 39               (    forth6809.asm):03717                   RTS
                      (    forth6809.asm):03718         
E486 9E1F             (    forth6809.asm):03719         NQBAD:    LDX   CADDR
E488 3610             (    forth6809.asm):03720                   PSHU  X
E48A CC0000           (    forth6809.asm):03721                   LDD   #0
E48D 3606             (    forth6809.asm):03722                   PSHU  D
E48F 39               (    forth6809.asm):03723                   RTS
                      (    forth6809.asm):03724         
                      (    forth6809.asm):03725         ; ============================================================
                      (    forth6809.asm):03726         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03727         ; ============================================================
                      (    forth6809.asm):03728                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E490                  (    forth6809.asm):03729         X_KEY:     LDA   INHEAD
                      (    forth6809.asm):03730                  CMPA  INTAIL
                      (    forth6809.asm):03731                  BEQ   KEY
                      (    forth6809.asm):03732                  LDX   #INBUF
                      (    forth6809.asm):03733                  LDB   INTAIL
                      (    forth6809.asm):03734                  LDA   B,X
                      (    forth6809.asm):03735                  INCB
                      (    forth6809.asm):03736                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):03737                  STB   INTAIL
                      (    forth6809.asm):03738                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03739                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03740                                         ; this needs no dedicated scratch global
                      (    forth6809.asm):03741                  JSR   RTSCHECKLO
                      (    forth6809.asm):03742                  PULS  A
                      (    forth6809.asm):03743                  TFR   A,B
                      (    forth6809.asm):03744                  CLRA
                      (    forth6809.asm):03745                  PSHU  D
                      (    forth6809.asm):03746                  RTS
                      (    forth6809.asm):03747         
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
                      (    forth6809.asm):03749         ; KEY ( -- char )
                      (    forth6809.asm):03750         ; ------------------------------------------------------------
E490                  (    forth6809.asm):03751         KEY:
                      (    forth6809.asm):03752         
                      (    forth6809.asm):03753                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03754                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03755         
                      (    forth6809.asm):03756                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03757                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03758                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03759                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03760                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03761                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03762                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03763                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03764                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03765                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03766                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03767                                             ; by transmitting all chars.
                      (    forth6809.asm):03768         
E490                  (    forth6809.asm):03769         TRY_READ:
                      (    forth6809.asm):03770                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03771                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03772                                             ; while still transmitting!
                      (    forth6809.asm):03773                 
                      (    forth6809.asm):03774                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03775                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03776                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03777         
                      (    forth6809.asm):03778                     RTS                     
                      (    forth6809.asm):03779         
                      (    forth6809.asm):03780         ; ------------------------------------------------------------
                      (    forth6809.asm):03781         ; KEY? ( -- flag )
                      (    forth6809.asm):03782         ; ------------------------------------------------------------
E490                  (    forth6809.asm):03783         KEYQ:  
                      (    forth6809.asm):03784                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03785         
                      (    forth6809.asm):03786                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03787                     CMPA  INTAIL
                      (    forth6809.asm):03788         
                      (    forth6809.asm):03789                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03790         
                      (    forth6809.asm):03791                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03792         
                      (    forth6809.asm):03793                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03794                     PSHU  D
                      (    forth6809.asm):03795         
                      (    forth6809.asm):03796                     RTS
                      (    forth6809.asm):03797         
E490                  (    forth6809.asm):03798         KQTRUE:     
                      (    forth6809.asm):03799                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03800                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03801                     RTS
                      (    forth6809.asm):03802         ; ------------------------------------------------------------
                      (    forth6809.asm):03803         ; EMIT  ( char -- )
                      (    forth6809.asm):03804         ; ------------------------------------------------------------
                      (    forth6809.asm):03805         
E490                  (    forth6809.asm):03806         X_EMIT:    PULU  D
                      (    forth6809.asm):03807                  STB   EMITCH
E490                  (    forth6809.asm):03808         EMITWT:  LDB   OUTHEAD
                      (    forth6809.asm):03809                  INCB
                      (    forth6809.asm):03810                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03811                  CMPB  OUTTAIL
                      (    forth6809.asm):03812                  BEQ   EMITWT
                      (    forth6809.asm):03813                  LDX   #OUTBUF
                      (    forth6809.asm):03814                  LDB   OUTHEAD
                      (    forth6809.asm):03815                  LDA   EMITCH
                      (    forth6809.asm):03816                  STA   B,X
                      (    forth6809.asm):03817                  INCB
                      (    forth6809.asm):03818                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03819                  STB   OUTHEAD
                      (    forth6809.asm):03820                  TST   RTSSTATE
                      (    forth6809.asm):03821                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03822                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03823                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03824                                         ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03825                  LDA   #CR_RXTX
                      (    forth6809.asm):03826                  STA   ACIACR
E490                  (    forth6809.asm):03827         EMITNORTS: RTS
                      (    forth6809.asm):03828         
E490                  (    forth6809.asm):03829         EMIT:
                      (    forth6809.asm):03830                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03831                     TFR   B,A               
                      (    forth6809.asm):03832                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03833                     RTS                     
                      (    forth6809.asm):03834         
                      (    forth6809.asm):03835                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):03836         ; ------------------------------------------------------------
                      (    forth6809.asm):03837         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03838         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03839         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03840         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03841         ; directly against ACIASR.
                      (    forth6809.asm):03842         ;
                      (    forth6809.asm):03843         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03844         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03845         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03846         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03847         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03848         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03849         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03850         ; ------------------------------------------------------------
E490                  (    forth6809.asm):03851         KEY:
E490 B6C008           (    forth6809.asm):03852                  LDA   ACIASR
E493 8501             (    forth6809.asm):03853                  BITA  #SR_RDRF
E495 2705             (    forth6809.asm):03854                  BEQ   KWAIT
E497 7C017F           (    forth6809.asm):03855                  INC   POLLREADYCNT   ; character was already queued when we
E49A 2007             (    forth6809.asm):03856                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E49C                  (    forth6809.asm):03857         KWAIT:
E49C B6C008           (    forth6809.asm):03858         KSPIN:   LDA   ACIASR
E49F 8501             (    forth6809.asm):03859                  BITA  #SR_RDRF
E4A1 27F9             (    forth6809.asm):03860                  BEQ   KSPIN
E4A3                  (    forth6809.asm):03861         KGOTSTAT:                     ; A holds the status byte exactly as it was
                      (    forth6809.asm):03862                                        ; when RDRF first went true - check the
                      (    forth6809.asm):03863                                        ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03864                                        ; read, since reading ACIADR below clears
                      (    forth6809.asm):03865                                        ; RDRF and the latched error bits together
E4A3 8570             (    forth6809.asm):03866                  BITA  #SR_FE+SR_OVRN+SR_PE
E4A5 2715             (    forth6809.asm):03867                  BEQ   KGETCH
E4A7 8510             (    forth6809.asm):03868                  BITA  #SR_FE
E4A9 2703             (    forth6809.asm):03869                  BEQ   KXFE
E4AB 7C017C           (    forth6809.asm):03870                  INC   FECOUNT
E4AE 8520             (    forth6809.asm):03871         KXFE:    BITA  #SR_OVRN
E4B0 2703             (    forth6809.asm):03872                  BEQ   KXOVRN
E4B2 7C017D           (    forth6809.asm):03873                  INC   OVRNCOUNT
E4B5 8540             (    forth6809.asm):03874         KXOVRN:  BITA  #SR_PE
E4B7 2703             (    forth6809.asm):03875                  BEQ   KGETCH
E4B9 7C017E           (    forth6809.asm):03876                  INC   PECOUNT
E4BC B6C009           (    forth6809.asm):03877         KGETCH:  LDA   ACIADR
E4BF 1F89             (    forth6809.asm):03878                  TFR   A,B
E4C1 4F               (    forth6809.asm):03879                  CLRA
E4C2 3606             (    forth6809.asm):03880                  PSHU  D
E4C4 39               (    forth6809.asm):03881                  RTS
                      (    forth6809.asm):03882         
                      (    forth6809.asm):03883         ; ------------------------------------------------------------
                      (    forth6809.asm):03884         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):03885         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):03886         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):03887         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):03888         ; either is safe to call from ACCEPT at any point without
                      (    forth6809.asm):03889         ; disturbing whatever's on U. See ACCEPT for where these are
                      (    forth6809.asm):03890         ; called: XON at the start of every line (the host may stream
                      (    forth6809.asm):03891         ; characters continuously while ACCEPT's own tight loop is
                      (    forth6809.asm):03892         ; polling), XOFF the instant a line is complete (CR seen), before
                      (    forth6809.asm):03893         ; handing off to INTERPRET/compilation - which does arbitrary,
                      (    forth6809.asm):03894         ; variable-length work with KEY never polled at all, exactly the
                      (    forth6809.asm):03895         ; window where a host that kept sending would build up a backlog
                      (    forth6809.asm):03896         ; this polling build (with no ring buffer to hold it) has no way
                      (    forth6809.asm):03897         ; to recover from correctly.
                      (    forth6809.asm):03898         ; ------------------------------------------------------------
E4C5 8613             (    forth6809.asm):03899         PUTXOFF: LDA   #XOFFCH
E4C7 2002             (    forth6809.asm):03900                  BRA   PUTXCH
E4C9 8611             (    forth6809.asm):03901         PUTXON:  LDA   #XONCH
E4CB 3402             (    forth6809.asm):03902         PUTXCH:  PSHS  A
E4CD F6C008           (    forth6809.asm):03903         PXWT:    LDB   ACIASR
E4D0 C502             (    forth6809.asm):03904                  BITB  #SR_TDRE
E4D2 27F9             (    forth6809.asm):03905                  BEQ   PXWT
E4D4 3502             (    forth6809.asm):03906                  PULS  A
E4D6 B7C009           (    forth6809.asm):03907                  STA   ACIADR
E4D9 39               (    forth6809.asm):03908                  RTS
                      (    forth6809.asm):03909         
E4DA B6C008           (    forth6809.asm):03910         KEYQ:    LDA   ACIASR
E4DD 8501             (    forth6809.asm):03911                  BITA  #SR_RDRF
E4DF 2706             (    forth6809.asm):03912                  BEQ   KQFALSE
E4E1 CCFFFF           (    forth6809.asm):03913                  LDD   #TRUEV
E4E4 3606             (    forth6809.asm):03914                  PSHU  D
E4E6 39               (    forth6809.asm):03915                  RTS
E4E7 CC0000           (    forth6809.asm):03916         KQFALSE: LDD   #FALSEV
E4EA 3606             (    forth6809.asm):03917                  PSHU  D
E4EC 39               (    forth6809.asm):03918                  RTS
                      (    forth6809.asm):03919         
E4ED 3706             (    forth6809.asm):03920         EMIT:    PULU  D
E4EF D73C             (    forth6809.asm):03921                  STB   EMITCH
E4F1 B6C008           (    forth6809.asm):03922         EMITWT:  LDA   ACIASR
E4F4 8502             (    forth6809.asm):03923                  BITA  #SR_TDRE
E4F6 27F9             (    forth6809.asm):03924                  BEQ   EMITWT
E4F8 963C             (    forth6809.asm):03925                  LDA   EMITCH
E4FA B7C009           (    forth6809.asm):03926                  STA   ACIADR
E4FD 39               (    forth6809.asm):03927                  RTS
                      (    forth6809.asm):03928         
                      (    forth6809.asm):03929                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):03930         
E4FE 3706             (    forth6809.asm):03931         ACCEPT:  PULU  D
E500 DD35             (    forth6809.asm):03932                  STD   AMAX
E502 3706             (    forth6809.asm):03933                  PULU  D
E504 DD37             (    forth6809.asm):03934                  STD   ABUFP
E506 CC0000           (    forth6809.asm):03935                  LDD   #0
E509 DD39             (    forth6809.asm):03936                  STD   ACNT
                      (    forth6809.asm):03937         
                      (    forth6809.asm):03938                  IFEQ  SERIALPOLL  ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03939                                     ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03940                                     ; covers this, nothing extra needed
                      (    forth6809.asm):03941                  ELSE  ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03942                                       ; stream this line's characters
E50B BDE4C9           (    forth6809.asm):03943                  JSR   PUTXON
                      (    forth6809.asm):03944                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):03945         
E50E BDE490           (    forth6809.asm):03946         ALOOP:   JSR   KEY
E511 3706             (    forth6809.asm):03947                  PULU  D

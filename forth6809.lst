                      (    forth6809.asm):06863         ; SUBSTITUTE  ( c-addr1 u1 c-addr2 u2 -- c-addr2 u3 n )
                      (    forth6809.asm):06864         ; Copy the template c-addr1 u1 to the buffer c-addr2 u2, replacing
                      (    forth6809.asm):06865         ; each %name% that matches the name registered by REPLACES with its
                      (    forth6809.asm):06866         ; text. "%%" becomes a single "%"; a %name% that does not match, and
                      (    forth6809.asm):06867         ; an unpaired "%", are copied unchanged. u3 is the output length and n
                      (    forth6809.asm):06868         ; the number of substitutions. THROW -1 if the output does not fit.
                      (    forth6809.asm):06869         ; Scratch: MSCR = read position, MSCR2 = substitution count, MSCR3 and
                      (    forth6809.asm):06870         ; MSCR4 = temporaries for each %-pair. Original comment: shadow

                      (    forth6809.asm):01117         ; TSTDEPTH - unit test for DEPTH ( -- n ). Independently
                      (    forth6809.asm):01118         ; computes the expected depth via the same (SP0-U)/2 formula
                      (    forth6809.asm):01119         ; DEPTH itself uses, rather than assuming a fixed starting
                      (    forth6809.asm):01120         ; depth - robust regardless of whatever is already on the stack
                      (    forth6809.asm):01121         ; when this test runs. Also verifies DEPTH's own net effect
                      (    forth6809.asm):01122         ; (exactly one cell pushed) and that the three items pushed to
                      (    forth6809.asm):01123         ; set up the test are left undisturbed.
                      (    forth6809.asm):01124         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):01125         TSTDEPTH:  STU   TSTU0
                      (    forth6809.asm):01126         
                      (    forth6809.asm):01127                    LDD   #TSTVAL1

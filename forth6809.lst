                      (    forth6809.asm):05200         ; MOD  ( n1 n2 -- n3 )
                      (    forth6809.asm):05201         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05202         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05203         ; zero.

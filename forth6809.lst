                      (    forth6809.asm):01833                    BNE   DHFAIL
                      (    forth6809.asm):01834                    PULU  D
                      (    forth6809.asm):01835                    CMPD  #TSTVAL1
                      (    forth6809.asm):01836                    BNE   DHFAIL

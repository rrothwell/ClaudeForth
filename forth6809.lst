                      (    forth6809.asm):03886         ; ------------------------------------------------------------
                      (    forth6809.asm):03887         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03888         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03889         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03890         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03891         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03892         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03893         ; ------------------------------------------------------------
E535 3710             (    forth6809.asm):03894         CATCHW:     PULU  X                 ; xt
E537 DC0C             (    forth6809.asm):03895                     LDD   HANDLER
E539 3406             (    forth6809.asm):03896                     PSHS  D
E53B 3440             (    forth6809.asm):03897                     PSHS  U
                      (    forth6809.asm):03898                     ; Save the input source specification.
                      (    forth6809.asm):03899                     ; See bugfix: CATCHW.1
E53D DC39             (    forth6809.asm):03900                     LDD   SRCADDR
E53F 3406             (    forth6809.asm):03901                     PSHS  D
E541 DC3B             (    forth6809.asm):03902                     LDD   SRCLEN
E543 3406             (    forth6809.asm):03903                     PSHS  D
E545 DC3D             (    forth6809.asm):03904                     LDD   SRCID
E547 3406             (    forth6809.asm):03905                     PSHS  D

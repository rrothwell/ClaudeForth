E43C ED46             (    forth6809.asm):05778                     STD   6,U
E43E EC40             (    forth6809.asm):05779                     LDD   0,U
E440 ED44             (    forth6809.asm):05780                     STD   4,U
E442 10AFC4           (    forth6809.asm):05781                     STY   ,U
E445 AF42             (    forth6809.asm):05782                     STX   2,U
E447 39               (    forth6809.asm):05783                     RTS
                      (    forth6809.asm):05784         
                      (    forth6809.asm):05785         ; ------------------------------------------------------------
                      (    forth6809.asm):05786         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05787         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05788         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05789         ; the transfer.
                      (    forth6809.asm):05790         ; ------------------------------------------------------------
E448 3706             (    forth6809.asm):05791         TORW:       PULU  D                 ; x
E44A 3510             (    forth6809.asm):05792                     PULS  X
E44C 3406             (    forth6809.asm):05793                     PSHS  D
E44E 3410             (    forth6809.asm):05794                     PSHS  X
E450 39               (    forth6809.asm):05795                     RTS
                      (    forth6809.asm):05796         
                      (    forth6809.asm):05797         ; ------------------------------------------------------------
                      (    forth6809.asm):05798         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05799         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05800         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05801         ; the transfer.
                      (    forth6809.asm):05802         ; ------------------------------------------------------------
E451 3510             (    forth6809.asm):05803         FROMRW:     PULS  X
E453 3506             (    forth6809.asm):05804                     PULS  D                 ; x
E455 3410             (    forth6809.asm):05805                     PSHS  X
E457 3606             (    forth6809.asm):05806                     PSHU  D
E459 39               (    forth6809.asm):05807                     RTS
                      (    forth6809.asm):05808         
                      (    forth6809.asm):05809         ; ------------------------------------------------------------
                      (    forth6809.asm):05810         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05811         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05812         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05813         ; back around the transfer.
                      (    forth6809.asm):05814         ; ------------------------------------------------------------
E45A 3510             (    forth6809.asm):05815         RFETCHW:    PULS  X
E45C ECE4             (    forth6809.asm):05816                     LDD   ,S                ; x
E45E 3410             (    forth6809.asm):05817                     PSHS  X
E460 3606             (    forth6809.asm):05818                     PSHU  D
E462 39               (    forth6809.asm):05819                     RTS
                      (    forth6809.asm):05820         
                      (    forth6809.asm):05821         ; ------------------------------------------------------------
                      (    forth6809.asm):05822         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05823         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05824         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05825         ; put back around the transfer.
                      (    forth6809.asm):05826         ; ------------------------------------------------------------
E463 3510             (    forth6809.asm):05827         TWOTORW:    PULS  X                 ; return address
E465 3706             (    forth6809.asm):05828                     PULU  D                 ; x2
E467 3720             (    forth6809.asm):05829                     PULU  Y                 ; x1
E469 3420             (    forth6809.asm):05830                     PSHS  Y
E46B 3406             (    forth6809.asm):05831                     PSHS  D
E46D 3410             (    forth6809.asm):05832                     PSHS  X
E46F 39               (    forth6809.asm):05833                     RTS
                      (    forth6809.asm):05834         
                      (    forth6809.asm):05835         ; ------------------------------------------------------------
                      (    forth6809.asm):05836         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05837         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05838         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05839         ; put back around the transfer.
                      (    forth6809.asm):05840         ; ------------------------------------------------------------
E470 3510             (    forth6809.asm):05841         TWOFROMRW:  PULS  X                 ; return address
E472 3506             (    forth6809.asm):05842                     PULS  D                 ; x2
E474 3520             (    forth6809.asm):05843                     PULS  Y                 ; x1
E476 3410             (    forth6809.asm):05844                     PSHS  X
E478 3620             (    forth6809.asm):05845                     PSHU  Y
E47A 3606             (    forth6809.asm):05846                     PSHU  D
E47C 39               (    forth6809.asm):05847                     RTS
                      (    forth6809.asm):05848         
                      (    forth6809.asm):05849         ; ------------------------------------------------------------
                      (    forth6809.asm):05850         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05851         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05852         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05853         ; and put back around the transfer.
                      (    forth6809.asm):05854         ; ------------------------------------------------------------
E47D 3510             (    forth6809.asm):05855         TWORFETCHW: PULS  X                 ; return address
E47F ECE4             (    forth6809.asm):05856                     LDD   ,S                ; x2
E481 10AE62           (    forth6809.asm):05857                     LDY   2,S               ; x1
E484 3410             (    forth6809.asm):05858                     PSHS  X
E486 3620             (    forth6809.asm):05859                     PSHU  Y
E488 3606             (    forth6809.asm):05860                     PSHU  D
E48A 39               (    forth6809.asm):05861                     RTS
                      (    forth6809.asm):05862         
                      (    forth6809.asm):05863         ; ============================================================
                      (    forth6809.asm):05864         ; SECTION 15: ARITHMETIC (single + double + mixed precision)
                      (    forth6809.asm):05865         ; ============================================================
                      (    forth6809.asm):05866         ; ------------------------------------------------------------
                      (    forth6809.asm):05867         ; +  ( n1 n2 -- n3 )
                      (    forth6809.asm):05868         ; Add n2 to n1.

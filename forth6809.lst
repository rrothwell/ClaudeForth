                      (    forth6809.asm):12953                     LDD  #2
                      (    forth6809.asm):12954                     PSHU D
                      (    forth6809.asm):12955                     LDD  #TSTCBUF
                      (    forth6809.asm):12956                     PSHU D
                      (    forth6809.asm):12957                     LDD  #2
                      (    forth6809.asm):12958                     PSHU D
                      (    forth6809.asm):12959                     JSR  COMPAREW
                      (    forth6809.asm):12960                     PULU D
                      (    forth6809.asm):12961                     CMPD #0

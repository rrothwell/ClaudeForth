                      (    forth6809.asm):02133         ; ============================================================
                      (    forth6809.asm):02134         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02135         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02136         ; ============================================================
                      (    forth6809.asm):02137         ; ------------------------------------------------------------
                      (    forth6809.asm):02138         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02139         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02140         ; LIT   ( -- x )
                      (    forth6809.asm):02141         ;    Inputs:
                      (    forth6809.asm):02142         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02143         ;    Outputs:
                      (    forth6809.asm):02144         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02145         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02146         ; ------------------------------------------------------------
DDE3 3510             (    forth6809.asm):02147         LIT:        PULS  X
DDE5 EC81             (    forth6809.asm):02148                     LDD   ,X++
DDE7 3606             (    forth6809.asm):02149                     PSHU  D                 ; x
DDE9 3410             (    forth6809.asm):02150                     PSHS  X
DDEB 39               (    forth6809.asm):02151                     RTS
                      (    forth6809.asm):02152         
                      (    forth6809.asm):02153         ; ------------------------------------------------------------
                      (    forth6809.asm):02154         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02155         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02156         ; address.
                      (    forth6809.asm):02157         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02158         ;    Inputs:
                      (    forth6809.asm):02159         ;        flag on the data stack
                      (    forth6809.asm):02160         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02161         ;    Outputs:
                      (    forth6809.asm):02162         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02163         ;        the offset
                      (    forth6809.asm):02164         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02165         ; ------------------------------------------------------------
DDEC 3706             (    forth6809.asm):02166         ZBRANCH:    PULU  D                 ; flag
DDEE 3510             (    forth6809.asm):02167                     PULS  X
DDF0 10830000         (    forth6809.asm):02168                     CMPD  #0
DDF4 2607             (    forth6809.asm):02169                     BNE   ZSKIP
DDF6 EC84             (    forth6809.asm):02170                     LDD   ,X
DDF8 308B             (    forth6809.asm):02171                     LEAX  D,X
DDFA 3410             (    forth6809.asm):02172                     PSHS  X
DDFC 39               (    forth6809.asm):02173                     RTS
DDFD 3002             (    forth6809.asm):02174         ZSKIP:      LEAX  2,X
DDFF 3410             (    forth6809.asm):02175                     PSHS  X
DE01 39               (    forth6809.asm):02176                     RTS
                      (    forth6809.asm):02177         
                      (    forth6809.asm):02178         ; ------------------------------------------------------------
                      (    forth6809.asm):02179         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02180         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02181         ; BRANCH
                      (    forth6809.asm):02182         ;    Inputs:
                      (    forth6809.asm):02183         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02184         ;    Outputs:
                      (    forth6809.asm):02185         ;        return address set to the branch target
                      (    forth6809.asm):02186         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02187         ; ------------------------------------------------------------
DE02 3510             (    forth6809.asm):02188         BRANCH:     PULS  X
DE04 EC84             (    forth6809.asm):02189                     LDD   ,X
DE06 308B             (    forth6809.asm):02190                     LEAX  D,X
DE08 3410             (    forth6809.asm):02191                     PSHS  X
DE0A 39               (    forth6809.asm):02192                     RTS
                      (    forth6809.asm):02193         
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
                      (    forth6809.asm):02195         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02196         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02197         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02198         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02199         ;    Inputs:
                      (    forth6809.asm):02200         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02201         ;        trampoline
                      (    forth6809.asm):02202         ;    Outputs:
                      (    forth6809.asm):02203         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02204         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02205         ; ------------------------------------------------------------
DE0B 3510             (    forth6809.asm):02206         DODOES:     PULS  X
DE0D 10AE81           (    forth6809.asm):02207                     LDY   ,X++
DE10 EC84             (    forth6809.asm):02208                     LDD   ,X
DE12 3606             (    forth6809.asm):02209                     PSHU  D                 ; pfa
DE14 6EA4             (    forth6809.asm):02210                     JMP   ,Y
                      (    forth6809.asm):02211         
                      (    forth6809.asm):02212         ; ------------------------------------------------------------
                      (    forth6809.asm):02213         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02214         ; field address on the stack.
                      (    forth6809.asm):02215         ; DOESRT0
                      (    forth6809.asm):02216         ;    Inputs:
                      (    forth6809.asm):02217         ;        none
                      (    forth6809.asm):02218         ;    Outputs:
                      (    forth6809.asm):02219         ;        none
                      (    forth6809.asm):02220         ;    Registers: none.
                      (    forth6809.asm):02221         ; ------------------------------------------------------------
DE16 39               (    forth6809.asm):02222         DOESRT0:    RTS
                      (    forth6809.asm):02223         
                      (    forth6809.asm):02224         ; ------------------------------------------------------------
                      (    forth6809.asm):02225         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02226         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02227         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02228         ; SETDOES
                      (    forth6809.asm):02229         ;    Inputs:
                      (    forth6809.asm):02230         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02231         ;        BEHAVIOR)
                      (    forth6809.asm):02232         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02233         ;        address
                      (    forth6809.asm):02234         ;    Outputs:
                      (    forth6809.asm):02235         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02236         ;        defining word's caller
                      (    forth6809.asm):02237         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02238         ; ------------------------------------------------------------
DE17 3510             (    forth6809.asm):02239         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DE19 1F12             (    forth6809.asm):02240                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02241         
DE1B 9E04             (    forth6809.asm):02242                     LDX   LATEST
DE1D E684             (    forth6809.asm):02243                     LDB   ,X
DE1F C41F             (    forth6809.asm):02244                     ANDB  #$1F
DE21 4F               (    forth6809.asm):02245                     CLRA
DE22 308B             (    forth6809.asm):02246                     LEAX  D,X               ; header + name length
DE24 EC03             (    forth6809.asm):02247                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DE26 C30003           (    forth6809.asm):02248                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DE29 1F01             (    forth6809.asm):02249                     TFR   D,X
                      (    forth6809.asm):02250         
DE2B 10AF84           (    forth6809.asm):02251                     STY   ,X                ; patch it
                      (    forth6809.asm):02252         
DE2E 3510             (    forth6809.asm):02253                     PULS  X                 ; X = the OUTER defining word's own return addr
DE30 6E84             (    forth6809.asm):02254                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02255         
                      (    forth6809.asm):02256         ; ------------------------------------------------------------
                      (    forth6809.asm):02257         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02258         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02259         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02260         ;    Inputs:
                      (    forth6809.asm):02261         ;        pfa on the data stack
                      (    forth6809.asm):02262         ;    Outputs:
                      (    forth6809.asm):02263         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02264         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02265         ; ------------------------------------------------------------
DE32 3710             (    forth6809.asm):02266         DODEFER:    PULU  X                 ; pfa
DE34 EC84             (    forth6809.asm):02267                     LDD   ,X
DE36 1F01             (    forth6809.asm):02268                     TFR   D,X
DE38 6E84             (    forth6809.asm):02269                     JMP   ,X
                      (    forth6809.asm):02270         
                      (    forth6809.asm):02271         ; ------------------------------------------------------------
                      (    forth6809.asm):02272         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02273         ; DOABORTUNDEF
                      (    forth6809.asm):02274         ;    Inputs:
                      (    forth6809.asm):02275         ;        none
                      (    forth6809.asm):02276         ;    Outputs:
                      (    forth6809.asm):02277         ;        none (does not return)
                      (    forth6809.asm):02278         ;    Registers: RegD changed.
                      (    forth6809.asm):02279         ; ------------------------------------------------------------
DE3A                  (    forth6809.asm):02280         DOABORTUNDEF:
DE3A CCFFEB           (    forth6809.asm):02281                     LDD   #-21
DE3D 3606             (    forth6809.asm):02282                     PSHU  D                 ; throw code (-21)
DE3F 7EE4F6           (    forth6809.asm):02283                     JMP   THROWW
                      (    forth6809.asm):02284         
                      (    forth6809.asm):02285         ; ------------------------------------------------------------
                      (    forth6809.asm):02286         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02287         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02288         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02289         ;    Inputs:
                      (    forth6809.asm):02290         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02291         ;    Outputs:
                      (    forth6809.asm):02292         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02293         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02294         ; ------------------------------------------------------------
DE42 3710             (    forth6809.asm):02295         DOMARKER:   PULU  X                 ; pfa
DE44 EC84             (    forth6809.asm):02296                     LDD   ,X
DE46 DD06             (    forth6809.asm):02297                     STD   DPHERE
DE48 EC02             (    forth6809.asm):02298                     LDD   2,X
DE4A DD08             (    forth6809.asm):02299                     STD   CODEHERE
DE4C EC04             (    forth6809.asm):02300                     LDD   4,X
DE4E DD0A             (    forth6809.asm):02301                     STD   VARHERE
DE50 EC06             (    forth6809.asm):02302                     LDD   6,X
DE52 DD04             (    forth6809.asm):02303                     STD   LATEST
DE54 39               (    forth6809.asm):02304                     RTS
                      (    forth6809.asm):02305         
                      (    forth6809.asm):02306         ; ------------------------------------------------------------
                      (    forth6809.asm):02307         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02308         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02309         ; ------------------------------------------------------------
DE55 3710             (    forth6809.asm):02310         EXECUTEW:   PULU  X                 ; xt
DE57 AD84             (    forth6809.asm):02311                     JSR   ,X
DE59 39               (    forth6809.asm):02312                     RTS
                      (    forth6809.asm):02313         
                      (    forth6809.asm):02314         ; ============================================================
                      (    forth6809.asm):02315         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02316         ; ============================================================
                      (    forth6809.asm):02317         ; ------------------------------------------------------------
                      (    forth6809.asm):02318         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02319         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02320         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02321         ;    Inputs:
                      (    forth6809.asm):02322         ;        RegX = address of the here pointer
                      (    forth6809.asm):02323         ;        x on the data stack
                      (    forth6809.asm):02324         ;    Outputs:
                      (    forth6809.asm):02325         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02326         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02327         ; ------------------------------------------------------------
DE5A 3706             (    forth6809.asm):02328         APPENDCELL: PULU  D                 ; x
DE5C 10AE84           (    forth6809.asm):02329                     LDY   ,X
DE5F EDA1             (    forth6809.asm):02330                     STD   ,Y++
DE61 10AF84           (    forth6809.asm):02331                     STY   ,X
DE64 39               (    forth6809.asm):02332                     RTS
                      (    forth6809.asm):02333         
                      (    forth6809.asm):02334         ; ------------------------------------------------------------
                      (    forth6809.asm):02335         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02336         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02337         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02338         ;    Inputs:
                      (    forth6809.asm):02339         ;        RegX = address of the here pointer
                      (    forth6809.asm):02340         ;        char on the data stack
                      (    forth6809.asm):02341         ;    Outputs:
                      (    forth6809.asm):02342         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02343         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
DE65 3706             (    forth6809.asm):02345         APPENDBYTE: PULU  D                 ; char
DE67 10AE84           (    forth6809.asm):02346                     LDY   ,X
DE6A E7A0             (    forth6809.asm):02347                     STB   ,Y+
DE6C 10AF84           (    forth6809.asm):02348                     STY   ,X
DE6F 39               (    forth6809.asm):02349                     RTS
                      (    forth6809.asm):02350         
                      (    forth6809.asm):02351         ; ------------------------------------------------------------
                      (    forth6809.asm):02352         ; ,  ( x -- )
                      (    forth6809.asm):02353         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02354         ; ------------------------------------------------------------
DE70 8E0008           (    forth6809.asm):02355         COMMAW:     LDX   #CODEHERE
DE73 7EDE5A           (    forth6809.asm):02356                     JMP   APPENDCELL
                      (    forth6809.asm):02357         
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
                      (    forth6809.asm):02359         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02360         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02361         ; ------------------------------------------------------------
DE76 8E0008           (    forth6809.asm):02362         CODECOMMA:  LDX   #CODEHERE
DE79 7EDE5A           (    forth6809.asm):02363                     JMP   APPENDCELL
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         ; ------------------------------------------------------------
                      (    forth6809.asm):02366         ; C,  ( char -- )
                      (    forth6809.asm):02367         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
DE7C 8E0008           (    forth6809.asm):02369         CCOMMAW:    LDX   #CODEHERE
DE7F 7EDE65           (    forth6809.asm):02370                     JMP   APPENDBYTE
                      (    forth6809.asm):02371         
                      (    forth6809.asm):02372         ; ------------------------------------------------------------
                      (    forth6809.asm):02373         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02374         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02375         ; ------------------------------------------------------------
DE82 8E0008           (    forth6809.asm):02376         CCOMMA1:    LDX   #CODEHERE
DE85 7EDE65           (    forth6809.asm):02377                     JMP   APPENDBYTE
                      (    forth6809.asm):02378         
                      (    forth6809.asm):02379         ; ------------------------------------------------------------
                      (    forth6809.asm):02380         ; V,  ( x -- )
                      (    forth6809.asm):02381         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02382         ; ------------------------------------------------------------
DE88 8E000A           (    forth6809.asm):02383         VCOMMAW:    LDX   #VARHERE
DE8B 7EDE5A           (    forth6809.asm):02384                     JMP   APPENDCELL
                      (    forth6809.asm):02385         
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; VC,  ( char -- )
                      (    forth6809.asm):02388         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
DE8E 8E000A           (    forth6809.asm):02390         VCCOMMAW:   LDX   #VARHERE
DE91 7EDE65           (    forth6809.asm):02391                     JMP   APPENDBYTE
                      (    forth6809.asm):02392         
                      (    forth6809.asm):02393         ; ------------------------------------------------------------
                      (    forth6809.asm):02394         ; ALLOT  ( n -- )
                      (    forth6809.asm):02395         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
DE94 3706             (    forth6809.asm):02397         ALLOTW:     PULU  D                 ; n
DE96 9E08             (    forth6809.asm):02398                     LDX   CODEHERE
DE98 308B             (    forth6809.asm):02399                     LEAX  D,X
DE9A 9F08             (    forth6809.asm):02400                     STX   CODEHERE
DE9C 39               (    forth6809.asm):02401                     RTS
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403         ; ------------------------------------------------------------
                      (    forth6809.asm):02404         ; VALLOT  ( n -- )
                      (    forth6809.asm):02405         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
DE9D 3706             (    forth6809.asm):02407         VALLOTW:    PULU  D                 ; n
DE9F 9E0A             (    forth6809.asm):02408                     LDX   VARHERE
DEA1 308B             (    forth6809.asm):02409                     LEAX  D,X
DEA3 9F0A             (    forth6809.asm):02410                     STX   VARHERE
DEA5 39               (    forth6809.asm):02411                     RTS
                      (    forth6809.asm):02412         
                      (    forth6809.asm):02413         ; ------------------------------------------------------------
                      (    forth6809.asm):02414         ; HERE  ( -- addr )
                      (    forth6809.asm):02415         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02416         ; ------------------------------------------------------------
DEA6 DC08             (    forth6809.asm):02417         HEREW:      LDD   CODEHERE
DEA8 3606             (    forth6809.asm):02418                     PSHU  D                 ; addr
DEAA 39               (    forth6809.asm):02419                     RTS
                      (    forth6809.asm):02420         
                      (    forth6809.asm):02421         ; ------------------------------------------------------------
                      (    forth6809.asm):02422         ; VHERE  ( -- addr )
                      (    forth6809.asm):02423         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02424         ; ------------------------------------------------------------
DEAB DC0A             (    forth6809.asm):02425         VHEREW:     LDD   VARHERE
DEAD 3606             (    forth6809.asm):02426                     PSHU  D                 ; addr
DEAF 39               (    forth6809.asm):02427                     RTS
                      (    forth6809.asm):02428         
                      (    forth6809.asm):02429         ; ------------------------------------------------------------
                      (    forth6809.asm):02430         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02431         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02432         ; ------------------------------------------------------------
DEB0 DC08             (    forth6809.asm):02433         PADW:       LDD   CODEHERE
DEB2 C30080           (    forth6809.asm):02434                     ADDD  #PADOFFSET
DEB5 3606             (    forth6809.asm):02435                     PSHU  D                 ; c-addr
DEB7 39               (    forth6809.asm):02436                     RTS
                      (    forth6809.asm):02437         
                      (    forth6809.asm):02438         ; ------------------------------------------------------------
                      (    forth6809.asm):02439         ; UNUSED  ( -- u )
                      (    forth6809.asm):02440         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02441         ; ------------------------------------------------------------
DEB8 CCB900           (    forth6809.asm):02442         UNUSEDW:    LDD   #CODETOP
DEBB 9308             (    forth6809.asm):02443                     SUBD  CODEHERE
DEBD 3606             (    forth6809.asm):02444                     PSHU  D                 ; u
DEBF 39               (    forth6809.asm):02445                     RTS
                      (    forth6809.asm):02446         
                      (    forth6809.asm):02447         ; ------------------------------------------------------------
                      (    forth6809.asm):02448         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02449         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02450         ; ------------------------------------------------------------
DEC0 CC1FFF           (    forth6809.asm):02451         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DEC3 930A             (    forth6809.asm):02452                     SUBD  VARHERE
DEC5 3606             (    forth6809.asm):02453                     PSHU  D                 ; u
DEC7 39               (    forth6809.asm):02454                     RTS
                      (    forth6809.asm):02455         
                      (    forth6809.asm):02456         ; ============================================================
                      (    forth6809.asm):02457         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02458         ; ============================================================
                      (    forth6809.asm):02459         ; ------------------------------------------------------------
                      (    forth6809.asm):02460         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02461         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02462         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02463         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02464         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02465         ;    Inputs:
                      (    forth6809.asm):02466         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02467         ;        name parsed from the input stream
                      (    forth6809.asm):02468         ;    Outputs:
                      (    forth6809.asm):02469         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02470         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02471         ; ------------------------------------------------------------
DEC8 CC0020           (    forth6809.asm):02472         HEADER:     LDD   #32
DECB 3606             (    forth6809.asm):02473                     PSHU  D
DECD BDE1F0           (    forth6809.asm):02474                     JSR   WORDW
DED0 3710             (    forth6809.asm):02475                     PULU  X                 ; c-addr of the name
DED2 3706             (    forth6809.asm):02476                     PULU  D                 ; smudge flag in B
DED4 A680             (    forth6809.asm):02477                     LDA   ,X+               ; name length, X = name text
DED6 3402             (    forth6809.asm):02478                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DED8 5D               (    forth6809.asm):02479                     TSTB
DED9 2702             (    forth6809.asm):02480                     BEQ   HDNOSM
DEDB 8A40             (    forth6809.asm):02481                     ORA   #$40
DEDD 109E06           (    forth6809.asm):02482         HDNOSM:     LDY   DPHERE
DEE0 3420             (    forth6809.asm):02483                     PSHS  Y                 ; 0,S = address of the new header
DEE2 A7A0             (    forth6809.asm):02484                     STA   ,Y+
DEE4 E662             (    forth6809.asm):02485                     LDB   2,S
DEE6 2707             (    forth6809.asm):02486                     BEQ   HDNONM
DEE8 A680             (    forth6809.asm):02487         HDCPY:      LDA   ,X+
DEEA A7A0             (    forth6809.asm):02488                     STA   ,Y+
DEEC 5A               (    forth6809.asm):02489                     DECB
DEED 26F9             (    forth6809.asm):02490                     BNE   HDCPY
DEEF DC04             (    forth6809.asm):02491         HDNONM:     LDD   LATEST
DEF1 EDA1             (    forth6809.asm):02492                     STD   ,Y++
DEF3 DC08             (    forth6809.asm):02493                     LDD   CODEHERE
DEF5 EDA1             (    forth6809.asm):02494                     STD   ,Y++
DEF7 109F06           (    forth6809.asm):02495                     STY   DPHERE
DEFA 3506             (    forth6809.asm):02496                     PULS  D
DEFC DD04             (    forth6809.asm):02497                     STD   LATEST
DEFE 3261             (    forth6809.asm):02498                     LEAS  1,S
DF00 39               (    forth6809.asm):02499                     RTS
                      (    forth6809.asm):02500         
                      (    forth6809.asm):02501         ; ============================================================
                      (    forth6809.asm):02502         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02503         ; ============================================================
                      (    forth6809.asm):02504         ; ------------------------------------------------------------
                      (    forth6809.asm):02505         ; :  ( "name" -- )
                      (    forth6809.asm):02506         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02507         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02508         ; CSP and enter compile state.
                      (    forth6809.asm):02509         ; ------------------------------------------------------------
DF01 CCFFFF           (    forth6809.asm):02510         COLONW:     LDD   #TRUEV
DF04 3606             (    forth6809.asm):02511                     PSHU  D
DF06 BDDEC8           (    forth6809.asm):02512                     JSR   HEADER
DF09 DC08             (    forth6809.asm):02513                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DF0B DD1F             (    forth6809.asm):02514                     STD   CURXT             ; See bugfix: COLONW.1
DF0D 1F30             (    forth6809.asm):02515                     TFR   U,D
DF0F DD21             (    forth6809.asm):02516                     STD   CSP
DF11 CCFFFF           (    forth6809.asm):02517                     LDD   #-1
DF14 DD00             (    forth6809.asm):02518                     STD   STATE
DF16 39               (    forth6809.asm):02519                     RTS
                      (    forth6809.asm):02520         
                      (    forth6809.asm):02521         ; ------------------------------------------------------------
                      (    forth6809.asm):02522         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02523         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02524         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02525         ; new word and return to interpret state.
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
DF17 CC0039           (    forth6809.asm):02527         SEMIW:      LDD   #RTSOPC
DF1A 3606             (    forth6809.asm):02528                     PSHU  D
DF1C BDDE82           (    forth6809.asm):02529                     JSR   CCOMMA1
DF1F 1F30             (    forth6809.asm):02530                     TFR   U,D
DF21 109321           (    forth6809.asm):02531                     CMPD  CSP
DF24 2703             (    forth6809.asm):02532                     BEQ   SEMIOK
DF26 BDE4C1           (    forth6809.asm):02533                     JSR   CFERR
DF29 9E04             (    forth6809.asm):02534         SEMIOK:     LDX   LATEST
DF2B A684             (    forth6809.asm):02535                     LDA   ,X
DF2D 84BF             (    forth6809.asm):02536                     ANDA  #$BF
DF2F A784             (    forth6809.asm):02537                     STA   ,X
DF31 CC0000           (    forth6809.asm):02538                     LDD   #0
DF34 DD00             (    forth6809.asm):02539                     STD   STATE
DF36 39               (    forth6809.asm):02540                     RTS
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
                      (    forth6809.asm):02543         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02544         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02545         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02546         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02547         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02548         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02549         ; ------------------------------------------------------------
DF37 DC08             (    forth6809.asm):02550         NONAMEW:    LDD   CODEHERE
DF39 3606             (    forth6809.asm):02551                     PSHU  D                 ; xt
DF3B DD1F             (    forth6809.asm):02552                     STD   CURXT             ; See bugfix: NONAMEW.1
DF3D 1F30             (    forth6809.asm):02553                     TFR   U,D
DF3F DD21             (    forth6809.asm):02554                     STD   CSP
DF41 CCFFFF           (    forth6809.asm):02555                     LDD   #-1
DF44 DD00             (    forth6809.asm):02556                     STD   STATE
DF46 39               (    forth6809.asm):02557                     RTS
                      (    forth6809.asm):02558         
                      (    forth6809.asm):02559         ; ------------------------------------------------------------
                      (    forth6809.asm):02560         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02561         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02562         ; BLDDOES
                      (    forth6809.asm):02563         ;    Inputs:
                      (    forth6809.asm):02564         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02565         ;    Outputs:
                      (    forth6809.asm):02566         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02567         ;    Registers: all changed.
                      (    forth6809.asm):02568         ; BLDSELF
                      (    forth6809.asm):02569         ;    Inputs:
                      (    forth6809.asm):02570         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02571         ;    Outputs:
                      (    forth6809.asm):02572         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02573         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02574         ;    Registers: all changed.
                      (    forth6809.asm):02575         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02576         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02577         ; ------------------------------------------------------------
DF47 3406             (    forth6809.asm):02578         BLDDOES:    PSHS  D                 ; behaviour address
DF49 CC0000           (    forth6809.asm):02579                     LDD   #0
DF4C 3606             (    forth6809.asm):02580                     PSHU  D
DF4E BDDEC8           (    forth6809.asm):02581                     JSR   HEADER
DF51 CCDE0B           (    forth6809.asm):02582                     LDD   #DODOES
DF54 3606             (    forth6809.asm):02583                     PSHU  D
DF56 BDE931           (    forth6809.asm):02584                     JSR   CCALL
DF59 3506             (    forth6809.asm):02585                     PULS  D
DF5B 3606             (    forth6809.asm):02586                     PSHU  D                 ; behaviour address
DF5D BDDE76           (    forth6809.asm):02587                     JSR   CODECOMMA
DF60 39               (    forth6809.asm):02588                     RTS
                      (    forth6809.asm):02589         
DF61 BDDF47           (    forth6809.asm):02590         BLDSELF:    JSR   BLDDOES
DF64 DC08             (    forth6809.asm):02591                     LDD   CODEHERE          ; PFA = the cell after this one
DF66 C30002           (    forth6809.asm):02592                     ADDD  #2                ; See bugfix: CONSTANTW.1
DF69 3606             (    forth6809.asm):02593                     PSHU  D
DF6B BDDE76           (    forth6809.asm):02594                     JSR   CODECOMMA
DF6E 39               (    forth6809.asm):02595                     RTS
                      (    forth6809.asm):02596         
                      (    forth6809.asm):02597         ; ------------------------------------------------------------
                      (    forth6809.asm):02598         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02599         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02600         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02601         ; address in the code area, on the stack.
                      (    forth6809.asm):02602         ; ------------------------------------------------------------
DF6F CCDE16           (    forth6809.asm):02603         CREATEW:    LDD   #DOESRT0
DF72 BDDF61           (    forth6809.asm):02604                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DF75 39               (    forth6809.asm):02605                     RTS
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02609         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02610         ; of the word being defined.
                      (    forth6809.asm):02611         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02612         ; ------------------------------------------------------------
DF76 CCDE17           (    forth6809.asm):02613         DOESGTW:    LDD   #SETDOES
DF79 3606             (    forth6809.asm):02614                     PSHU  D
DF7B BDE931           (    forth6809.asm):02615                     JSR   CCALL
DF7E 39               (    forth6809.asm):02616                     RTS
                      (    forth6809.asm):02617         
                      (    forth6809.asm):02618         ; ------------------------------------------------------------
                      (    forth6809.asm):02619         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02620         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02621         ; area, initialised to zero.
                      (    forth6809.asm):02622         ; ------------------------------------------------------------
DF7F CC0000           (    forth6809.asm):02623         VARIABLEW:  LDD   #0
DF82 3606             (    forth6809.asm):02624                     PSHU  D
DF84 BDDEC8           (    forth6809.asm):02625                     JSR   HEADER
DF87 CCDE0B           (    forth6809.asm):02626                     LDD   #DODOES
DF8A 3606             (    forth6809.asm):02627                     PSHU  D
DF8C BDE931           (    forth6809.asm):02628                     JSR   CCALL
DF8F CCDE16           (    forth6809.asm):02629                     LDD   #DOESRT0
DF92 3606             (    forth6809.asm):02630                     PSHU  D
DF94 BDDE76           (    forth6809.asm):02631                     JSR   CODECOMMA
DF97 DC0A             (    forth6809.asm):02632                     LDD   VARHERE
DF99 3606             (    forth6809.asm):02633                     PSHU  D
DF9B BDDE76           (    forth6809.asm):02634                     JSR   CODECOMMA
DF9E CC0000           (    forth6809.asm):02635                     LDD   #0
DFA1 9E0A             (    forth6809.asm):02636                     LDX   VARHERE
DFA3 ED81             (    forth6809.asm):02637                     STD   ,X++
DFA5 9F0A             (    forth6809.asm):02638                     STX   VARHERE
DFA7 39               (    forth6809.asm):02639                     RTS
                      (    forth6809.asm):02640         
                      (    forth6809.asm):02641         ; ------------------------------------------------------------
                      (    forth6809.asm):02642         ; @  ( a-addr -- x )
                      (    forth6809.asm):02643         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02644         ; ------------------------------------------------------------
DFA8 3710             (    forth6809.asm):02645         FETCHW:     PULU  X                 ; a-addr
DFAA EC84             (    forth6809.asm):02646                     LDD   ,X
DFAC 3606             (    forth6809.asm):02647                     PSHU  D                 ; x
DFAE 39               (    forth6809.asm):02648                     RTS
                      (    forth6809.asm):02649         
                      (    forth6809.asm):02650         ; ------------------------------------------------------------
                      (    forth6809.asm):02651         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02652         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02653         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02654         ; ------------------------------------------------------------
DFAF CCDFA8           (    forth6809.asm):02655         CONSTANTW:  LDD   #FETCHW
DFB2 BDDF61           (    forth6809.asm):02656                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DFB5 BDDE70           (    forth6809.asm):02657                     JSR   COMMAW
DFB8 39               (    forth6809.asm):02658                     RTS
                      (    forth6809.asm):02659         
                      (    forth6809.asm):02660         ; ------------------------------------------------------------
                      (    forth6809.asm):02661         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02662         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02663         ;    Inputs:
                      (    forth6809.asm):02664         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02665         ;    Outputs:
                      (    forth6809.asm):02666         ;        pfa replaced by the value
                      (    forth6809.asm):02667         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02668         ; ------------------------------------------------------------
DFB9 3710             (    forth6809.asm):02669         DOVALUE:    PULU  X                 ; pfa
DFBB EC84             (    forth6809.asm):02670                     LDD   ,X
DFBD 3606             (    forth6809.asm):02671                     PSHU  D                 ; x
DFBF 39               (    forth6809.asm):02672                     RTS
                      (    forth6809.asm):02673         
                      (    forth6809.asm):02674         ; ------------------------------------------------------------
                      (    forth6809.asm):02675         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02676         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02677         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02678         ; ------------------------------------------------------------
DFC0 CCDFB9           (    forth6809.asm):02679         VALUEW:     LDD   #DOVALUE
DFC3 BDDF47           (    forth6809.asm):02680                     JSR   BLDDOES
DFC6 DC0A             (    forth6809.asm):02681                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DFC8 3606             (    forth6809.asm):02682                     PSHU  D                 ; See bugfix: VALUEW.1
DFCA BDDE76           (    forth6809.asm):02683                     JSR   CODECOMMA
DFCD BDDE88           (    forth6809.asm):02684                     JSR   VCOMMAW           ; store x in the variable area
DFD0 39               (    forth6809.asm):02685                     RTS
                      (    forth6809.asm):02686         
                      (    forth6809.asm):02687         ; ------------------------------------------------------------
                      (    forth6809.asm):02688         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):02689         ; lower address as 2@ expects.
                      (    forth6809.asm):02690         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):02691         ; ------------------------------------------------------------
DFD1 7EF304           (    forth6809.asm):02692         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):02693         
                      (    forth6809.asm):02694         ; ------------------------------------------------------------
                      (    forth6809.asm):02695         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):02696         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):02697         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):02698         ; ------------------------------------------------------------
DFD4 CCDFD1           (    forth6809.asm):02699         TWOVALUEW:  LDD   #DO2VALUE
DFD7 BDDF47           (    forth6809.asm):02700                     JSR   BLDDOES
DFDA DC0A             (    forth6809.asm):02701                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DFDC 3606             (    forth6809.asm):02702                     PSHU  D
DFDE BDDE76           (    forth6809.asm):02703                     JSR   CODECOMMA
DFE1 BDDE88           (    forth6809.asm):02704                     JSR   VCOMMAW           ; x2 at the lower address
DFE4 BDDE88           (    forth6809.asm):02705                     JSR   VCOMMAW           ; then x1
DFE7 39               (    forth6809.asm):02706                     RTS
                      (    forth6809.asm):02707         
                      (    forth6809.asm):02708         ; ------------------------------------------------------------
                      (    forth6809.asm):02709         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02710         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02711         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02712         ; ------------------------------------------------------------
DFE8 CC0020           (    forth6809.asm):02713         TOW:        LDD   #32
DFEB 3606             (    forth6809.asm):02714                     PSHU  D
DFED BDE1F0           (    forth6809.asm):02715                     JSR   WORDW
DFF0 BDE262           (    forth6809.asm):02716                     JSR   FINDW
DFF3 3706             (    forth6809.asm):02717                     PULU  D
DFF5 10830000         (    forth6809.asm):02718                     CMPD  #0
DFF9 260A             (    forth6809.asm):02719                     BNE   TOFOUND
DFFB 3706             (    forth6809.asm):02720                     PULU  D
DFFD CCFFF3           (    forth6809.asm):02721                     LDD   #-13
E000 3606             (    forth6809.asm):02722                     PSHU  D
E002 BDE4F6           (    forth6809.asm):02723                     JSR   THROWW
E005 AEC4             (    forth6809.asm):02724         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
E007 EC03             (    forth6809.asm):02725                     LDD   3,X
E009 1083DFD1         (    forth6809.asm):02726                     CMPD  #DO2VALUE
E00D 271A             (    forth6809.asm):02727                     BEQ   TOTWO
E00F BDE9F2           (    forth6809.asm):02728                     JSR   TOBODYW
E012 DC00             (    forth6809.asm):02729                     LDD   STATE
E014 270C             (    forth6809.asm):02730                     BEQ   TOIMMED
E016 BDE93E           (    forth6809.asm):02731                     JSR   LITERALW
E019 CCF2E5           (    forth6809.asm):02732                     LDD   #STOREW
E01C 3606             (    forth6809.asm):02733                     PSHU  D
E01E BDE931           (    forth6809.asm):02734                     JSR   CCALL
E021 39               (    forth6809.asm):02735                     RTS
E022 3710             (    forth6809.asm):02736         TOIMMED:    PULU  X                 ; a-addr of the value cell
E024 3706             (    forth6809.asm):02737                     PULU  D                 ; x
E026 ED84             (    forth6809.asm):02738                     STD   ,X
E028 39               (    forth6809.asm):02739                     RTS
E029 BDE9F2           (    forth6809.asm):02740         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
E02C DC00             (    forth6809.asm):02741                     LDD   STATE
E02E 270C             (    forth6809.asm):02742                     BEQ   TOTWOIMM
E030 BDE93E           (    forth6809.asm):02743                     JSR   LITERALW
E033 CCF30F           (    forth6809.asm):02744                     LDD   #TWOSTOREW
E036 3606             (    forth6809.asm):02745                     PSHU  D
E038 BDE931           (    forth6809.asm):02746                     JSR   CCALL
E03B 39               (    forth6809.asm):02747                     RTS
E03C 7EF30F           (    forth6809.asm):02748         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02752         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02753         ; the variable area, initialised to zero.
                      (    forth6809.asm):02754         ; ------------------------------------------------------------
E03F                  (    forth6809.asm):02755         TWOVARIABLEW:
E03F CC0000           (    forth6809.asm):02756                     LDD   #0
E042 3606             (    forth6809.asm):02757                     PSHU  D
E044 BDDEC8           (    forth6809.asm):02758                     JSR   HEADER
E047 CCDE0B           (    forth6809.asm):02759                     LDD   #DODOES
E04A 3606             (    forth6809.asm):02760                     PSHU  D
E04C BDE931           (    forth6809.asm):02761                     JSR   CCALL
E04F CCDE16           (    forth6809.asm):02762                     LDD   #DOESRT0
E052 3606             (    forth6809.asm):02763                     PSHU  D
E054 BDDE76           (    forth6809.asm):02764                     JSR   CODECOMMA
E057 DC0A             (    forth6809.asm):02765                     LDD   VARHERE
E059 3606             (    forth6809.asm):02766                     PSHU  D
E05B BDDE76           (    forth6809.asm):02767                     JSR   CODECOMMA
E05E CC0000           (    forth6809.asm):02768                     LDD   #0
E061 9E0A             (    forth6809.asm):02769                     LDX   VARHERE
E063 ED81             (    forth6809.asm):02770                     STD   ,X++
E065 ED81             (    forth6809.asm):02771                     STD   ,X++
E067 9F0A             (    forth6809.asm):02772                     STX   VARHERE
E069 39               (    forth6809.asm):02773                     RTS
                      (    forth6809.asm):02774         
                      (    forth6809.asm):02775         ; ------------------------------------------------------------
                      (    forth6809.asm):02776         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02777         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02778         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02779         ; ------------------------------------------------------------
E06A                  (    forth6809.asm):02780         TWOCONSTANTW:
E06A CCF304           (    forth6809.asm):02781                     LDD   #TWOFETCHW
E06D BDDF61           (    forth6809.asm):02782                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E070 3706             (    forth6809.asm):02783                     PULU  D                 ; x2
E072 DD14             (    forth6809.asm):02784                     STD   MSCR
E074 DC14             (    forth6809.asm):02785                     LDD   MSCR
E076 3606             (    forth6809.asm):02786                     PSHU  D
E078 BDDE70           (    forth6809.asm):02787                     JSR   COMMAW            ; x2 -> lower address
E07B BDDE70           (    forth6809.asm):02788                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1
E07E 39               (    forth6809.asm):02789                     RTS
                      (    forth6809.asm):02790         
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
                      (    forth6809.asm):02792         ; BUFFER:  ( u "name" -- )
                      (    forth6809.asm):02793         ; Build a word that returns the address of a u-byte buffer reserved in

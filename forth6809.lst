                      (    forth6809.asm):01782         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):01783         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):01784         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):01785         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):01786         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):01787         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):01788         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):01789         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):01790         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):01791         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):01792         ;
                      (    forth6809.asm):01793         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):01794         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):01795         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):01796         ; right value once.
                      (    forth6809.asm):01797         ; ------------------------------------------------------------

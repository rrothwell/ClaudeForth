                      (    forth6809.asm):15816         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):15817         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):15818         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):15819         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):15820         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):15821         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):15822         ; ============================================================
                      (    forth6809.asm):15823         ; ------------------------------------------------------------
                      (    forth6809.asm):15824         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):15825         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):15826         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):15827         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):15828         ; - no indirection, no value cell.
                      (    forth6809.asm):15829         ;
                      (    forth6809.asm):15830         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):15831         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):15832         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):15833         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):15834         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):15835         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):15836         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):15837         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):15838         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):15839         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):15840         ; ------------------------------------------------------------

                      (    forth6809.asm):05621         ; ------------------------------------------------------------
                      (    forth6809.asm):05622         ; >BODY  ( xt -- a-addr )
                      (    forth6809.asm):05623         ; Return the data-field address of a CREATEd word: the cell at xt+5 of
                      (    forth6809.asm):05624         ; its JSR DODOES trampoline.
                      (    forth6809.asm):05625         ; ------------------------------------------------------------
DE01 3706             (    forth6809.asm):05626         TOBODYW:    PULU  D                 ; xt
DE03 C30005           (    forth6809.asm):05627                     ADDD  #5
DE06 1F01             (    forth6809.asm):05628                     TFR   D,X
DE08 EC84             (    forth6809.asm):05629                     LDD   ,X
DE0A 3606             (    forth6809.asm):05630                     PSHU  D
DE0C 39               (    forth6809.asm):05631                     RTS
                      (    forth6809.asm):05632         
                      (    forth6809.asm):05633         ; ------------------------------------------------------------
                      (    forth6809.asm):05634         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05635         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05636         ; the string.
                      (    forth6809.asm):05637         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05638         ;    Inputs:
                      (    forth6809.asm):05639         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05640         ;        count byte
                      (    forth6809.asm):05641         ;    Outputs:
                      (    forth6809.asm):05642         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05643         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05644         ; ------------------------------------------------------------
DE0D                  (    forth6809.asm):05645         DOABORTQUOTE:
DE0D 3510             (    forth6809.asm):05646                     PULS  X
DE0F E684             (    forth6809.asm):05647                     LDB   ,X
DE11 3001             (    forth6809.asm):05648                     LEAX  1,X               ; X = text, B = length
DE13 4F               (    forth6809.asm):05649                     CLRA
DE14 3720             (    forth6809.asm):05650                     PULU  Y                 ; flag
DE16 108C0000         (    forth6809.asm):05651                     CMPY  #0
DE1A 2605             (    forth6809.asm):05652                     BNE   AQTHROW
DE1C 3085             (    forth6809.asm):05653                     LEAX  B,X
DE1E 3410             (    forth6809.asm):05654                     PSHS  X
DE20 39               (    forth6809.asm):05655                     RTS
DE21 3610             (    forth6809.asm):05656         AQTHROW:    PSHU  X
DE23 3606             (    forth6809.asm):05657                     PSHU  D
DE25 BDE8FA           (    forth6809.asm):05658                     JSR   TYPEW
DE28 CCFFFE           (    forth6809.asm):05659                     LDD   #-2               ; -2
DE2B 3606             (    forth6809.asm):05660                     PSHU  D
DE2D 7ED905           (    forth6809.asm):05661                     JMP   THROWW
                      (    forth6809.asm):05662         
                      (    forth6809.asm):05663         ; ------------------------------------------------------------
                      (    forth6809.asm):05664         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05665         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):05666         ; as a counted string. THROW -14 if not compiling.
                      (    forth6809.asm):05667         ; ------------------------------------------------------------
DE30                  (    forth6809.asm):05668         ABORTQUOTEW:
DE30 DC00             (    forth6809.asm):05669                     LDD   STATE
DE32 2608             (    forth6809.asm):05670                     BNE   AQSTOK
DE34 CCFFF2           (    forth6809.asm):05671                     LDD   #-14
DE37 3606             (    forth6809.asm):05672                     PSHU  D
DE39 BDD905           (    forth6809.asm):05673                     JSR   THROWW
DE3C BDE781           (    forth6809.asm):05674         AQSTOK:     JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
DE3F CCDE0D           (    forth6809.asm):05675                     LDD   #DOABORTQUOTE
DE42 7EE796           (    forth6809.asm):05676                     JMP   CSTRCOMP
                      (    forth6809.asm):05677         
                      (    forth6809.asm):05678         ; ------------------------------------------------------------
                      (    forth6809.asm):05679         ; BL  ( -- char )
                      (    forth6809.asm):05680         ; Push 32, the space character.

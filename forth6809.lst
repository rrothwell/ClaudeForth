                      (    forth6809.asm):05080         ; Unsigned 16-bit division by shift and subtract. The divisor is not
                      (    forth6809.asm):05081         ; checked for zero.
                      (    forth6809.asm):05082         ; UDIV16
                      (    forth6809.asm):05083         ;    Inputs:
                      (    forth6809.asm):05084         ;        DIVNUM = dividend, DIVDEN = divisor (unsigned)
                      (    forth6809.asm):05085         ;    Outputs:
                      (    forth6809.asm):05086         ;        DIVNUM = quotient, DIVREM = remainder
                      (    forth6809.asm):05087         ;    Registers: RegD changed; DIVCNT used as the loop counter.
                      (    forth6809.asm):05088         ; ------------------------------------------------------------
EC0C 0F2C             (    forth6809.asm):05089         UDIV16:     CLR   DIVREM
EC0E 0F2D             (    forth6809.asm):05090                     CLR   DIVREM+1
EC10 C610             (    forth6809.asm):05091                     LDB   #16
EC12 D72E             (    forth6809.asm):05092                     STB   DIVCNT
EC14 0829             (    forth6809.asm):05093         UD16LOOP:   ASL   DIVNUM+1
EC16 0928             (    forth6809.asm):05094                     ROL   DIVNUM
EC18 092D             (    forth6809.asm):05095                     ROL   DIVREM+1
EC1A 092C             (    forth6809.asm):05096                     ROL   DIVREM
EC1C DC2C             (    forth6809.asm):05097                     LDD   DIVREM
EC1E 932A             (    forth6809.asm):05098                     SUBD  DIVDEN
EC20 2504             (    forth6809.asm):05099                     BLO   UDSKIP
EC22 DD2C             (    forth6809.asm):05100                     STD   DIVREM
EC24 0C29             (    forth6809.asm):05101                     INC   DIVNUM+1
EC26 0A2E             (    forth6809.asm):05102         UDSKIP:     DEC   DIVCNT
EC28 26EA             (    forth6809.asm):05103                     BNE   UD16LOOP
EC2A 39               (    forth6809.asm):05104                     RTS
                      (    forth6809.asm):05105         

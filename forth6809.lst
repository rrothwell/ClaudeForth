                      (    forth6809.asm):08464         ; ------------------------------------------------------------
                      (    forth6809.asm):08465         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):08466         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):08467         ; low byte of BASE is used.
                      (    forth6809.asm):08468         ; UDDIGIT

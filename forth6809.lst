                      (    forth6809.asm):03086                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03087                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03088                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03089                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03090                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03091                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03092                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03093                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03094                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03095                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03096                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03097                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03098                  ; for it.
E5A5 D621             (    forth6809.asm):03099                  LDB   CNTREM
E5A7 5A               (    forth6809.asm):03100                  DECB
E5A8 A685             (    forth6809.asm):03101                  LDA   B,X
E5AA 812E             (    forth6809.asm):03102                  CMPA  #'.'
E5AC 2604             (    forth6809.asm):03103                  BNE   NQNOSIGN
E5AE 0A21             (    forth6809.asm):03104                  DEC   CNTREM
E5B0 2766             (    forth6809.asm):03105                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03106         
E5B2 0F22             (    forth6809.asm):03107         NQNOSIGN: CLR   NUMNEG
E5B4 A684             (    forth6809.asm):03108                  LDA   ,X
E5B6 812D             (    forth6809.asm):03109                  CMPA  #'-'
E5B8 2608             (    forth6809.asm):03110                  BNE   NQNOSIGN2
E5BA 0322             (    forth6809.asm):03111                  COM   NUMNEG
E5BC 3001             (    forth6809.asm):03112                  LEAX  1,X
E5BE 0A21             (    forth6809.asm):03113                  DEC   CNTREM
E5C0 2756             (    forth6809.asm):03114                  BEQ   NQBAD
                      (    forth6809.asm):03115         

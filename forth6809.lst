                      (    forth6809.asm):05919         
                      (    forth6809.asm):05920         ; ------------------------------------------------------------
                      (    forth6809.asm):05921         ; MAX  ( n1 n2 -- n3 )
                      (    forth6809.asm):05922         ; The greater of two signed numbers.

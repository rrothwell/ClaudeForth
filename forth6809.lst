                      (    forth6809.asm):10810         ; TSTABORTQ2 - unit test for ABORT", true-flag case. Same
                      (    forth6809.asm):10811         ; compiled snippet as TSTABORTQ1, executed via CATCH with a true
                      (    forth6809.asm):10812         ; flag instead. Confirmed by reading DOABORTQUOTE's own code
                      (    forth6809.asm):10813         ; that it uses THROW -2 internally, not the raw, never-returns
                      (    forth6809.asm):10814         ; ABORT mechanism plain ABORT itself uses (which remains
                      (    forth6809.asm):10815         ; deliberately untested, per section 3.1's own reasoning) - so
                      (    forth6809.asm):10816         ; this case is safe to test directly, unlike plain ABORT would
                      (    forth6809.asm):10817         ; be.
                      (    forth6809.asm):10818         ; ------------------------------------------------------------
C278                  (    forth6809.asm):10819         TSTABORTQ2: LDD  CODEHERE
                      (    forth6809.asm):10820                     STD  TSTCSAV
                      (    forth6809.asm):10821                     LDD  SRCADDR
                      (    forth6809.asm):10822                     STD  TSTSASAV
                      (    forth6809.asm):10823                     LDD  SRCLEN
                      (    forth6809.asm):10824                     STD  TSTSLSAV
                      (    forth6809.asm):10825                     LDD  TOIN
                      (    forth6809.asm):10826                     STD  TSTTISAV
                      (    forth6809.asm):10827                     LDD  STATE
                      (    forth6809.asm):10828                     STD  TSTSTSAV
                      (    forth6809.asm):10829         
                      (    forth6809.asm):10830                     LDA  #'H'
                      (    forth6809.asm):10831                     STA  TSTNAMEB
                      (    forth6809.asm):10832                     LDA  #'I'
                      (    forth6809.asm):10833                     STA  TSTNAMEB+1
                      (    forth6809.asm):10834                     LDA  #34
                      (    forth6809.asm):10835                     STA  TSTNAMEB+2
                      (    forth6809.asm):10836         
                      (    forth6809.asm):10837                     LDD  #TSTCBUF
                      (    forth6809.asm):10838                     STD  CODEHERE
                      (    forth6809.asm):10839                     LDD  #TSTNAMEB
                      (    forth6809.asm):10840                     STD  SRCADDR
                      (    forth6809.asm):10841                     LDD  #3
                      (    forth6809.asm):10842                     STD  SRCLEN
                      (    forth6809.asm):10843                     LDD  #0
                      (    forth6809.asm):10844                     STD  TOIN
                      (    forth6809.asm):10845                     LDD  #-1
                      (    forth6809.asm):10846                     STD  STATE
                      (    forth6809.asm):10847         
                      (    forth6809.asm):10848                     JSR  ABORTQUOTE
                      (    forth6809.asm):10849         
                      (    forth6809.asm):10850                     LDD  #OPRTS
                      (    forth6809.asm):10851                     PSHU D
                      (    forth6809.asm):10852                     JSR  CCOMMA
                      (    forth6809.asm):10853         
                      (    forth6809.asm):10854                     LDD  TSTCSAV
                      (    forth6809.asm):10855                     STD  CODEHERE
                      (    forth6809.asm):10856                     LDD  TSTSASAV
                      (    forth6809.asm):10857                     STD  SRCADDR
                      (    forth6809.asm):10858                     LDD  TSTSLSAV
                      (    forth6809.asm):10859                     STD  SRCLEN
                      (    forth6809.asm):10860                     LDD  TSTTISAV
                      (    forth6809.asm):10861                     STD  TOIN
                      (    forth6809.asm):10862                     LDD  TSTSTSAV
                      (    forth6809.asm):10863                     STD  STATE
                      (    forth6809.asm):10864         
                      (    forth6809.asm):10865                     STU  TSTU0
                      (    forth6809.asm):10866         
                      (    forth6809.asm):10867                     LDD  #TRUEV
                      (    forth6809.asm):10868                     PSHU D
                      (    forth6809.asm):10869                     LDX  #TSTCBUF
                      (    forth6809.asm):10870                     PSHU X
                      (    forth6809.asm):10871                     STU  TSTUB4
                      (    forth6809.asm):10872         

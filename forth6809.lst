                      (    forth6809.asm):03089                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03090                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03091                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03092                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03093                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03094                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03095                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03096                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03097                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03098                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03099                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03100                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03101                  ; for it.
E691 D621             (    forth6809.asm):03102                  LDB   CNTREM
E693 5A               (    forth6809.asm):03103                  DECB
E694 A685             (    forth6809.asm):03104                  LDA   B,X
E696 812E             (    forth6809.asm):03105                  CMPA  #'.'
E698 2604             (    forth6809.asm):03106                  BNE   NQNOSIGN
E69A 0A21             (    forth6809.asm):03107                  DEC   CNTREM
E69C 2766             (    forth6809.asm):03108                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03109         

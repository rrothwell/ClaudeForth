                      (    forth6809.asm):07447         
                      (    forth6809.asm):07448                   LDD  #2
                      (    forth6809.asm):07449                   PSHU D
                      (    forth6809.asm):07450                   JSR  LITERALW
                      (    forth6809.asm):07451                   JSR  OF
                      (    forth6809.asm):07452                   LDD  #222
                      (    forth6809.asm):07453                   PSHU D
                      (    forth6809.asm):07454                   JSR  LITERALW
                      (    forth6809.asm):07455                   JSR  ENDOF
                      (    forth6809.asm):07456         
                      (    forth6809.asm):07457                   JSR  ENDCASE
                      (    forth6809.asm):07458         

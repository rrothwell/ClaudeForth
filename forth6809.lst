                      (    forth6809.asm):01569                    BRA   PKDONE
C161                  (    forth6809.asm):01570         PKFAIL:    LDD   #FALSEV
C161                  (    forth6809.asm):01571         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):01572                    PSHU  X
                      (    forth6809.asm):01573                    PSHU  D
                      (    forth6809.asm):01574                    JSR   TSTREPORT
                      (    forth6809.asm):01575         
                      (    forth6809.asm):01576                    LDU   TSTU0
                      (    forth6809.asm):01577                    RTS
                      (    forth6809.asm):01578         
C161                  (    forth6809.asm):01579         TSTPICKNAME: FCB  7

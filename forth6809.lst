                      (    forth6809.asm):11050                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):11051                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):11052                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):11053                                      ; silently overwrote the real carry here

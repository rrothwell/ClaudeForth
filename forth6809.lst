DEFC DCF7             (    forth6809.asm):02116                     LDD   QSAVEVAR
DEFE DD0A             (    forth6809.asm):02117                     STD   VARHERE
DF00 DCF9             (    forth6809.asm):02118                     LDD   QSAVELATEST
DF02 DD04             (    forth6809.asm):02119                     STD   LATEST
DF04 CEBD00           (    forth6809.asm):02120                     LDU   #SP0
                      (    forth6809.asm):02121         

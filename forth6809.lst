                      (    forth6809.asm):08132         ; ------------------------------------------------------------
                      (    forth6809.asm):08133         ; -2  ( -- -2 )
                      (    forth6809.asm):08134         ; Push the constant -2.
                      (    forth6809.asm):08135         ; ------------------------------------------------------------
FEEB CCFFFE           (    forth6809.asm):08136         NEGTWOW:    LDD   #-2

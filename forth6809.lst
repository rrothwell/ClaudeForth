                      (    forth6809.asm):04942         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):04943         ; ------------------------------------------------------------
DB6A 3706             (    forth6809.asm):04944         REPEATW:    PULU  D
DB6C 10830001         (    forth6809.asm):04945                     CMPD  #TAGFWD
DB70 2703             (    forth6809.asm):04946                     BEQ   RPOK1
DB72 BDDA0F           (    forth6809.asm):04947                     JSR   CFERR
DB75 3710             (    forth6809.asm):04948         RPOK1:      PULU  X                 ; orig
DB77 3410             (    forth6809.asm):04949                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04950         
                      (    forth6809.asm):04951                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04952                     ; See bugfix: REPEATW.1
DB79 3040             (    forth6809.asm):04953                     LEAX  0,U               ; scan from top of control stack
DB7B 9F16             (    forth6809.asm):04954                     STX   MSCR2             ; MSCR2 = base of scan region
DB7D 9F1A             (    forth6809.asm):04955                     STX   MSCR4             ; MSCR4 = scan pointer
DB7F DC1A             (    forth6809.asm):04956         RPSCAN:     LDD   MSCR4
DB81 109321           (    forth6809.asm):04957                     CMPD  CSP
DB84 2603             (    forth6809.asm):04958                     BNE   RPSCANOK
DB86 BDDA0F           (    forth6809.asm):04959                     JSR   CFERR             ; no matching BEGIN
DB89 9E1A             (    forth6809.asm):04960         RPSCANOK:   LDX   MSCR4
DB8B EC84             (    forth6809.asm):04961                     LDD   ,X
DB8D 10830002         (    forth6809.asm):04962                     CMPD  #TAGBACK
DB91 2712             (    forth6809.asm):04963                     BEQ   RPFOUND
DB93 10830001         (    forth6809.asm):04964                     CMPD  #TAGFWD
DB97 2703             (    forth6809.asm):04965                     BEQ   RPSKIP
DB99 BDDA0F           (    forth6809.asm):04966                     JSR   CFERR             ; anything else is a genuine mismatch
DB9C DC1A             (    forth6809.asm):04967         RPSKIP:     LDD   MSCR4
DB9E C30004           (    forth6809.asm):04968                     ADDD  #4
DBA1 DD1A             (    forth6809.asm):04969                     STD   MSCR4
DBA3 20DA             (    forth6809.asm):04970                     BRA   RPSCAN
DBA5 9E1A             (    forth6809.asm):04971         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
DBA7 EC02             (    forth6809.asm):04972                     LDD   2,X               ; dest = BEGIN's address
DBA9 3406             (    forth6809.asm):04973                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04974         
                      (    forth6809.asm):04975                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04976                     ; bytes, highest word first.
DBAB DC1A             (    forth6809.asm):04977                     LDD   MSCR4
DBAD 9316             (    forth6809.asm):04978                     SUBD  MSCR2
DBAF DD18             (    forth6809.asm):04979                     STD   MSCR3             ; MSCR3 = bytes to shift
DBB1 2715             (    forth6809.asm):04980                     BEQ   RPSHIFTDONE
DBB3 DC18             (    forth6809.asm):04981         RPSHIFT:    LDD   MSCR3
DBB5 830002           (    forth6809.asm):04982                     SUBD  #2
DBB8 DD18             (    forth6809.asm):04983                     STD   MSCR3
DBBA 9E16             (    forth6809.asm):04984                     LDX   MSCR2
DBBC 308B             (    forth6809.asm):04985                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DBBE EC84             (    forth6809.asm):04986                     LDD   ,X
DBC0 3004             (    forth6809.asm):04987                     LEAX  4,X
DBC2 ED84             (    forth6809.asm):04988                     STD   ,X                ; copy one word 4 bytes higher
DBC4 DC18             (    forth6809.asm):04989                     LDD   MSCR3
DBC6 26EB             (    forth6809.asm):04990                     BNE   RPSHIFT
DBC8                  (    forth6809.asm):04991         RPSHIFTDONE:
DBC8 9E16             (    forth6809.asm):04992                     LDX   MSCR2
DBCA 3004             (    forth6809.asm):04993                     LEAX  4,X
DBCC 1F13             (    forth6809.asm):04994                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04995         

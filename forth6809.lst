DE4E 7D017F           (    forth6809.asm):02273                     TST  RTSSTATE
DE51 271B             (    forth6809.asm):02274                     BEQ  RTSCLODONE       ; already low - nothing to do
DE53 1A10             (    forth6809.asm):02275                     ORCC #$10              ; mask IRQ for the critical section
DE55 7F017F           (    forth6809.asm):02276                     CLR  RTSSTATE
DE58 F6017A           (    forth6809.asm):02277                     LDB  OUTTAIL

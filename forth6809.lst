F387 2713             (    forth6809.asm):06643                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F389 AE44             (    forth6809.asm):06644                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F38B 308B             (    forth6809.asm):06645                     LEAX  D,X               ; end address = c-addr1 + u
F38D AFC4             (    forth6809.asm):06646                     STX   ,U                ; keep it in u's old slot as the loop limit
F38F AE44             (    forth6809.asm):06647                     LDX   4,U               ; X = source

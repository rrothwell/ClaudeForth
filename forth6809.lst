                      (    forth6809.asm):01421         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):01422         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):01423         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):01424         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):01425         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):01426         ; pushes that set the test up).
                      (    forth6809.asm):01427         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01428         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):01429         
                      (    forth6809.asm):01430                    LDD   #TSTGUARD
                      (    forth6809.asm):01431                    PSHU  D
                      (    forth6809.asm):01432                    LDD   #TSTVAL1
                      (    forth6809.asm):01433                    PSHU  D
                      (    forth6809.asm):01434                    STU   TSTUB4
                      (    forth6809.asm):01435         
                      (    forth6809.asm):01436                    JSR   DUP
                      (    forth6809.asm):01437         
                      (    forth6809.asm):01438                    STU   TSTUAF
                      (    forth6809.asm):01439         
                      (    forth6809.asm):01440                    PULU  D
                      (    forth6809.asm):01441                    CMPD  #TSTVAL1
                      (    forth6809.asm):01442                    BNE   TDFAIL
                      (    forth6809.asm):01443                    PULU  D
                      (    forth6809.asm):01444                    CMPD  #TSTVAL1
                      (    forth6809.asm):01445                    BNE   TDFAIL
                      (    forth6809.asm):01446                    PULU  D
                      (    forth6809.asm):01447                    CMPD  #TSTGUARD
                      (    forth6809.asm):01448                    BNE   TDFAIL
                      (    forth6809.asm):01449         
                      (    forth6809.asm):01450                    LDD   TSTUB4
                      (    forth6809.asm):01451                    SUBD  TSTUAF
                      (    forth6809.asm):01452                    CMPD  #2
                      (    forth6809.asm):01453                    BNE   TDFAIL
                      (    forth6809.asm):01454         
                      (    forth6809.asm):01455                    LDD   #TRUEV
                      (    forth6809.asm):01456                    BRA   TDDONE
C100                  (    forth6809.asm):01457         TDFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):01458         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):01459                    PSHU  X
                      (    forth6809.asm):01460                    PSHU  D
                      (    forth6809.asm):01461                    JSR   TSTREPORT
                      (    forth6809.asm):01462         
                      (    forth6809.asm):01463                    LDU   TSTU0
                      (    forth6809.asm):01464                    RTS
                      (    forth6809.asm):01465         
C100                  (    forth6809.asm):01466         TSTDUPNAME: FCB  6
                      (    forth6809.asm):01467                     FCC  "TSTDUP"
                      (    forth6809.asm):01468         

                      (    forth6809.asm):11072                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11073                       BNE  PSFAIL
                      (    forth6809.asm):11074         
                      (    forth6809.asm):11075                       PULU D
                      (    forth6809.asm):11076                       CMPD #TSTGUARD
                      (    forth6809.asm):11077                       BNE  PSFAIL
                      (    forth6809.asm):11078         
                      (    forth6809.asm):11079                       LDD  TSTUB4
                      (    forth6809.asm):11080                       SUBD TSTUAF
                      (    forth6809.asm):11081                       CMPD #-4
                      (    forth6809.asm):11082                       BNE  PSFAIL
                      (    forth6809.asm):11083         
                      (    forth6809.asm):11084                       LDD  #TRUEV
                      (    forth6809.asm):11085                       BRA  PSDONE
C289                  (    forth6809.asm):11086         PSFAIL:       LDD  #FALSEV
C289                  (    forth6809.asm):11087         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11088                       PSHU X
                      (    forth6809.asm):11089                       PSHU D
                      (    forth6809.asm):11090                       JSR  TSTREPORT
                      (    forth6809.asm):11091         
                      (    forth6809.asm):11092                       LDU  TSTU0
                      (    forth6809.asm):11093                       RTS
                      (    forth6809.asm):11094         
C289                  (    forth6809.asm):11095         TSTPSNAME: FCB  12
                      (    forth6809.asm):11096                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11097         
                      (    forth6809.asm):11098         ; ------------------------------------------------------------
                      (    forth6809.asm):11099         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11100         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11101         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11102         ; the documented convention on both ends).
                      (    forth6809.asm):11103         ; ------------------------------------------------------------
C289                  (    forth6809.asm):11104         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11105         
                      (    forth6809.asm):11106                         LDD  #TSTGUARD
                      (    forth6809.asm):11107                         PSHU D
                      (    forth6809.asm):11108                         LDD  #TSTVAL1
                      (    forth6809.asm):11109                         PSHU D
                      (    forth6809.asm):11110                         LDD  #TSTVAL2
                      (    forth6809.asm):11111                         PSHU D
                      (    forth6809.asm):11112                         LDD  #TSTCBUF
                      (    forth6809.asm):11113                         PSHU D
                      (    forth6809.asm):11114                         STU  TSTUB4
                      (    forth6809.asm):11115         

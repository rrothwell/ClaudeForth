                      (    forth6809.asm):07730         ; DUMP  ( addr u -- )
                      (    forth6809.asm):07731         ; Display u bytes starting at addr, 16 per line: the hex bytes (no
                      (    forth6809.asm):07732         ; address), then the same bytes as ASCII with non-printing characters
                      (    forth6809.asm):07733         ; shown as ".". A partial last line is padded so the ASCII columns
                      (    forth6809.asm):07734         ; line up. A carriage return is sent first and after every line.
                      (    forth6809.asm):07735         ; ------------------------------------------------------------

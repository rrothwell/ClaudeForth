                      (    forth6809.asm):10852         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):10853         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):10854         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):10855         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):10856         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):10857         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):10858         ; ============================================================
                      (    forth6809.asm):10859         ; ------------------------------------------------------------
                      (    forth6809.asm):10860         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):10861         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):10862         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):10863         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):10864         ; - no indirection, no value cell.
                      (    forth6809.asm):10865         ;
                      (    forth6809.asm):10866         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):10867         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):10868         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):10869         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):10870         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):10871         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):10872         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):10873         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):10874         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):10875         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):10876         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):10877         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):10878                    PSHU  D
FF3C 39               (    forth6809.asm):10879                    RTS
                      (    forth6809.asm):10880         
FF3D CC0000           (    forth6809.asm):10881         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):10882                    PSHU  D
FF42 39               (    forth6809.asm):10883                    RTS
                      (    forth6809.asm):10884         
                      (    forth6809.asm):10885         ; ------------------------------------------------------------
                      (    forth6809.asm):10886         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):10887         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):10888         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):10889         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):10890         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):10891         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):10892                    PSHU  D
FF48 39               (    forth6809.asm):10893                    RTS
                      (    forth6809.asm):10894         

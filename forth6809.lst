DF41 DD00             (    forth6809.asm):06604                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):06605                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):06606                                   ; that spans more than one line of input.
                      (    forth6809.asm):06607                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):06608                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):06609                                   ; correct, sole places STATE should change
                      (    forth6809.asm):06610                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):06611                                   ; reset was a third, redundant one that
                      (    forth6809.asm):06612                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):06613                                   ; every time QUERY read a new line,
                      (    forth6809.asm):06614                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):06615                                   ; been reached. A colon definition split
                      (    forth6809.asm):06616                                   ; across multiple lines would have every
                      (    forth6809.asm):06617                                   ; word on every line after the first
                      (    forth6809.asm):06618                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):06619                                   ; stack effect, executed) instead of
                      (    forth6809.asm):06620                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):06621                                   ; data stack instead of being compiled,
                      (    forth6809.asm):06622                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):06623                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):06624                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):06625                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):06626                                   ; uncaught error routing back through ABORT
                      (    forth6809.asm):06627                                   ; (confirmed - ordinary successful lines
                      (    forth6809.asm):06628                                   ; loop back to QLOOP directly, never QUIT),
                      (    forth6809.asm):06629                                   ; so this still correctly forces interpret
                      (    forth6809.asm):06630                                   ; state exactly when ANS's own QUIT
                      (    forth6809.asm):06631                                   ; semantics call for it - just not on every
                      (    forth6809.asm):06632                                   ; single line of an otherwise-uninterrupted
                      (    forth6809.asm):06633                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):06634         

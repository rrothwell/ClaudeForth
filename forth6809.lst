                      (    forth6809.asm):06950         ; ------------------------------------------------------------
                      (    forth6809.asm):06951         ; Run-time part of ."  The counted string follows the call: TYPE it
                      (    forth6809.asm):06952         ; and skip over it.
                      (    forth6809.asm):06953         ; DOTSTR
                      (    forth6809.asm):06954         ;    Inputs:
                      (    forth6809.asm):06955         ;        return address on S points at the count byte
                      (    forth6809.asm):06956         ;    Outputs:
                      (    forth6809.asm):06957         ;        string displayed; execution resumes after the string
                      (    forth6809.asm):06958         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06959         ; ------------------------------------------------------------
F528 3510             (    forth6809.asm):06960         DOTSTR:     PULS  X
F52A E684             (    forth6809.asm):06961                     LDB   ,X
F52C 3001             (    forth6809.asm):06962                     LEAX  1,X
F52E 3610             (    forth6809.asm):06963                     PSHU  X

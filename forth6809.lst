                      (    forth6809.asm):16856                     LDA  #1
                      (    forth6809.asm):16857                     STA  RTSSTATE
DEF5                  (    forth6809.asm):16858         RTSCHIDONE: RTS
                      (    forth6809.asm):16859         
                      (    forth6809.asm):16860         ; ------------------------------------------------------------

F43C 3610             (    forth6809.asm):06807                     PSHU  X                 ; result c-addr
F43E 3606             (    forth6809.asm):06808                     PSHU  D                 ; result u
F440 5D               (    forth6809.asm):06809                     TSTB
F441 2707             (    forth6809.asm):06810                     BEQ   SQIEND

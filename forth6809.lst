                      (    forth6809.asm):03132                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03133                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03134                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03135                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03136                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03137                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03138                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03139                   ; high cell.
E6C3 0D22             (    forth6809.asm):03140                   TST   NUMNEG
E6C5 2718             (    forth6809.asm):03141                   BEQ   NQPOS32
E6C7 DC76             (    forth6809.asm):03142                   LDD   UDLO
E6C9 43               (    forth6809.asm):03143                   COMA
E6CA 53               (    forth6809.asm):03144                   COMB
E6CB C30001           (    forth6809.asm):03145                   ADDD  #1
E6CE DD76             (    forth6809.asm):03146                   STD   UDLO
E6D0 3401             (    forth6809.asm):03147                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03148                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03149                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03150                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03151                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03152                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03153                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03154                                      ; making the high-cell increment run
                      (    forth6809.asm):03155                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03156                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03157                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03158                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03159                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03160                                      ; matching "always increment" rather than
                      (    forth6809.asm):03161                                      ; "increment only on genuine carry".
E6D2 DC74             (    forth6809.asm):03162                   LDD   UDHI
E6D4 43               (    forth6809.asm):03163                   COMA
E6D5 53               (    forth6809.asm):03164                   COMB
E6D6 3501             (    forth6809.asm):03165                   PULS  CC          ; restore the TRUE carry
E6D8 2403             (    forth6809.asm):03166                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03167                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03168                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03169                                      ; value was computed in D but never
                      (    forth6809.asm):03170                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03171                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03172                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03173                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03174                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03175                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03176                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03177                                      ; alone would have made this second,
                      (    forth6809.asm):03178                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03179                                      ; only past the "+1", never past the
                      (    forth6809.asm):03180                                      ; store itself - the store always runs,
                      (    forth6809.asm):03181                                      ; either way.
E6DA C30001           (    forth6809.asm):03182                   ADDD  #1
E6DD DD74             (    forth6809.asm):03183         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03184         
E6DF                  (    forth6809.asm):03185         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03186                   ; was '.' - determines which return convention to use
E6DF 9E1F             (    forth6809.asm):03187                   LDX   CADDR
E6E1 E684             (    forth6809.asm):03188                   LDB   ,X
E6E3 5A               (    forth6809.asm):03189                   DECB
E6E4 3001             (    forth6809.asm):03190                   LEAX  1,X
E6E6 A685             (    forth6809.asm):03191                   LDA   B,X

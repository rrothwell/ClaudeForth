F511 9339             (    forth6809.asm):06785                     SUBD  SRCADDR
F513 DD10             (    forth6809.asm):06786                     STD   TOIN
F515 39               (    forth6809.asm):06787                     RTS
F516 DC3B             (    forth6809.asm):06788         PNEMPTY:    LDD   SRCLEN
F518 9E39             (    forth6809.asm):06789                     LDX   SRCADDR
F51A 308B             (    forth6809.asm):06790                     LEAX  D,X
F51C DD10             (    forth6809.asm):06791                     STD   TOIN
F51E 3610             (    forth6809.asm):06792                     PSHU  X
F520 CC0000           (    forth6809.asm):06793                     LDD   #0
F523 3606             (    forth6809.asm):06794                     PSHU  D
F525 39               (    forth6809.asm):06795                     RTS
                      (    forth6809.asm):06796         
                      (    forth6809.asm):06797         ; ------------------------------------------------------------
                      (    forth6809.asm):06798         ; /STRING  ( c-addr1 u1 n -- c-addr2 u2 )
                      (    forth6809.asm):06799         ; Remove n characters from the start of the string.

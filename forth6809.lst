                      (    forth6809.asm):00708         
                      (    forth6809.asm):00709         ; ============================================================
                      (    forth6809.asm):00710         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):00711         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):00712         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):00713         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):00714         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):00715         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):00716         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):00717         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):00718         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):00719         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):00720         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):00721         ; they no longer need indirection.
                      (    forth6809.asm):00722         ;
                      (    forth6809.asm):00723         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):00724         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):00725         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):00726         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):00727         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):00728         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):00729         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):00730         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):00731         ;
                      (    forth6809.asm):00732         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):00733         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):00734         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):00735         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):00736         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):00737         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):00738         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):00739         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):00740         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):00741         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):00742         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):00743         ;
                      (    forth6809.asm):00744         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):00745         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):00746         ;
                      (    forth6809.asm):00747         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):00748         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):00749         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):00750         ; ============================================================
                      (    forth6809.asm):00751         
                      (    forth6809.asm):00752                  ORG   BASEDICT       ; BASEDICT is $D83F
                      (    forth6809.asm):00753         
D7FF                  (    forth6809.asm):00754         H_KEY:
D7FF 03               (    forth6809.asm):00755                  FCB   $03
D800 4B4559           (    forth6809.asm):00756                  FCC   "KEY"
D803 0000             (    forth6809.asm):00757                  FDB   0
D805 E70E             (    forth6809.asm):00758                  FDB   KEY
D807                  (    forth6809.asm):00759         H_KEYQ:
D807 04               (    forth6809.asm):00760                  FCB   $04
D808 4B45593F         (    forth6809.asm):00761                  FCC   "KEY?"
D80C D7FF             (    forth6809.asm):00762                  FDB   H_KEY
D80E E71E             (    forth6809.asm):00763                  FDB   KEYQ
D810                  (    forth6809.asm):00764         H_EMIT:
D810 04               (    forth6809.asm):00765                  FCB   $04
D811 454D4954         (    forth6809.asm):00766                  FCC   "EMIT"
D815 D807             (    forth6809.asm):00767                  FDB   H_KEYQ
D817 E731             (    forth6809.asm):00768                  FDB   EMIT

F893 9003             (    forth6809.asm):07065                     SUBA  BASE+1
F895 6C43             (    forth6809.asm):07066                     INC   3,U
F897 5A               (    forth6809.asm):07067         UDNEXT:     DECB
F898 26EC             (    forth6809.asm):07068                     BNE   UDDLOOP
F89A 39               (    forth6809.asm):07069                     RTS
                      (    forth6809.asm):07070         
                      (    forth6809.asm):07071         ; ------------------------------------------------------------
                      (    forth6809.asm):07072         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):07073         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):07074         ; is produced).
                      (    forth6809.asm):07075         ; ------------------------------------------------------------

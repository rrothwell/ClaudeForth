                      (    forth6809.asm):03350         ; ============================================================
                      (    forth6809.asm):03351         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03352         ; ============================================================
                      (    forth6809.asm):03353                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03354         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03355         
                      (    forth6809.asm):03356         ; ------------------------------------------------------------
                      (    forth6809.asm):03357         ; KEY  ( -- char )
                      (    forth6809.asm):03358         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03359         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03360         ; ------------------------------------------------------------
E3BD                  (    forth6809.asm):03361         KEYW:
                      (    forth6809.asm):03362         
                      (    forth6809.asm):03363                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03364                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03365         
                      (    forth6809.asm):03366                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):03367                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03368                                             ; by transmitting all chars.
                      (    forth6809.asm):03369         
E3BD                  (    forth6809.asm):03370         TRY_READ:
                      (    forth6809.asm):03371                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03372                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03373                                             ; while still transmitting!
                      (    forth6809.asm):03374         
                      (    forth6809.asm):03375                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03376                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03377                     PSHU  D                 ; char
                      (    forth6809.asm):03378         
                      (    forth6809.asm):03379                     RTS
                      (    forth6809.asm):03380         
                      (    forth6809.asm):03381         ; ------------------------------------------------------------
                      (    forth6809.asm):03382         ; KEY?  ( -- flag )
                      (    forth6809.asm):03383         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03384         ; ------------------------------------------------------------
E3BD                  (    forth6809.asm):03385         KEYQW:
                      (    forth6809.asm):03386                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03387         
                      (    forth6809.asm):03388                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03389                     CMPA  INTAIL
                      (    forth6809.asm):03390         
                      (    forth6809.asm):03391                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03392         
                      (    forth6809.asm):03393                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03394         
                      (    forth6809.asm):03395                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03396                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03397         
                      (    forth6809.asm):03398                     RTS
                      (    forth6809.asm):03399         
E3BD                  (    forth6809.asm):03400         KQTRUE:
                      (    forth6809.asm):03401                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03402                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03403                     RTS
                      (    forth6809.asm):03404         
                      (    forth6809.asm):03405         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03406         
                      (    forth6809.asm):03407         ; ------------------------------------------------------------
                      (    forth6809.asm):03408         ; EMIT  ( char -- )
                      (    forth6809.asm):03409         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03410         ; discarded if the ring is full.
                      (    forth6809.asm):03411         ; ------------------------------------------------------------
E3BD                  (    forth6809.asm):03412         EMITW:
                      (    forth6809.asm):03413                     PULU  D                 ; char
                      (    forth6809.asm):03414                     TFR   B,A
                      (    forth6809.asm):03415                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03416                     RTS
                      (    forth6809.asm):03417         
                      (    forth6809.asm):03418                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03419         ; ------------------------------------------------------------
                      (    forth6809.asm):03420         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03421         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03422         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03423         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03424         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03425         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03426         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03427         ; follow.
                      (    forth6809.asm):03428         ; ------------------------------------------------------------
E3BD                  (    forth6809.asm):03429         KEYW:
E3BD B6C008           (    forth6809.asm):03430                     LDA   ACIASR
E3C0 8501             (    forth6809.asm):03431                     BITA  #SR_RDRF
E3C2 2705             (    forth6809.asm):03432                     BEQ   KWAIT
E3C4 7C017F           (    forth6809.asm):03433                     INC   POLLREADYCNT      ; character was already queued when we
E3C7 2007             (    forth6809.asm):03434                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E3C9                  (    forth6809.asm):03435         KWAIT:
E3C9 B6C008           (    forth6809.asm):03436         KSPIN:      LDA   ACIASR
E3CC 8501             (    forth6809.asm):03437                     BITA  #SR_RDRF
E3CE 27F9             (    forth6809.asm):03438                     BEQ   KSPIN
E3D0                  (    forth6809.asm):03439         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03440                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03441                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03442                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03443                                             ; RDRF and the latched error bits together
E3D0 8570             (    forth6809.asm):03444                     BITA  #SR_FE+SR_OVRN+SR_PE
E3D2 2715             (    forth6809.asm):03445                     BEQ   KGETCH
E3D4 8510             (    forth6809.asm):03446                     BITA  #SR_FE
E3D6 2703             (    forth6809.asm):03447                     BEQ   KXFE
E3D8 7C017C           (    forth6809.asm):03448                     INC   FECOUNT
E3DB 8520             (    forth6809.asm):03449         KXFE:       BITA  #SR_OVRN
E3DD 2703             (    forth6809.asm):03450                     BEQ   KXOVRN
E3DF 7C017D           (    forth6809.asm):03451                     INC   OVRNCOUNT
E3E2 8540             (    forth6809.asm):03452         KXOVRN:     BITA  #SR_PE
E3E4 2703             (    forth6809.asm):03453                     BEQ   KGETCH
E3E6 7C017E           (    forth6809.asm):03454                     INC   PECOUNT
E3E9 B6C009           (    forth6809.asm):03455         KGETCH:     LDA   ACIADR
E3EC 1F89             (    forth6809.asm):03456                     TFR   A,B
E3EE 4F               (    forth6809.asm):03457                     CLRA
E3EF 3606             (    forth6809.asm):03458                     PSHU  D                 ; char
E3F1 39               (    forth6809.asm):03459                     RTS
                      (    forth6809.asm):03460         
                      (    forth6809.asm):03461         ; ------------------------------------------------------------
                      (    forth6809.asm):03462         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03463         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03464         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03465         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03466         ;    Inputs:
                      (    forth6809.asm):03467         ;        none
                      (    forth6809.asm):03468         ;    Outputs:
                      (    forth6809.asm):03469         ;        XON or XOFF transmitted
                      (    forth6809.asm):03470         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03471         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03472         ; ------------------------------------------------------------
E3F2 8613             (    forth6809.asm):03473         PUTXOFF:    LDA   #XOFFCH
E3F4 2002             (    forth6809.asm):03474                     BRA   PUTXCH
E3F6 8611             (    forth6809.asm):03475         PUTXON:     LDA   #XONCH
E3F8 3402             (    forth6809.asm):03476         PUTXCH:     PSHS  A
E3FA F6C008           (    forth6809.asm):03477         PXWT:       LDB   ACIASR
E3FD C502             (    forth6809.asm):03478                     BITB  #SR_TDRE
E3FF 27F9             (    forth6809.asm):03479                     BEQ   PXWT
E401 3502             (    forth6809.asm):03480                     PULS  A
E403 B7C009           (    forth6809.asm):03481                     STA   ACIADR
E406 39               (    forth6809.asm):03482                     RTS
                      (    forth6809.asm):03483         
                      (    forth6809.asm):03484         ; ------------------------------------------------------------
                      (    forth6809.asm):03485         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03486         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03487         ; ------------------------------------------------------------
E407 B6C008           (    forth6809.asm):03488         KEYQW:      LDA   ACIASR
E40A 8501             (    forth6809.asm):03489                     BITA  #SR_RDRF
E40C 2706             (    forth6809.asm):03490                     BEQ   KQFALSE
E40E CCFFFF           (    forth6809.asm):03491                     LDD   #TRUEV
E411 3606             (    forth6809.asm):03492                     PSHU  D                 ; flag = true
E413 39               (    forth6809.asm):03493                     RTS
E414 CC0000           (    forth6809.asm):03494         KQFALSE:    LDD   #FALSEV
E417 3606             (    forth6809.asm):03495                     PSHU  D                 ; flag = false
E419 39               (    forth6809.asm):03496                     RTS
                      (    forth6809.asm):03497         
                      (    forth6809.asm):03498         ; ------------------------------------------------------------
                      (    forth6809.asm):03499         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03500         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03501         ; ------------------------------------------------------------
E41A 3706             (    forth6809.asm):03502         EMITW:      PULU  D                 ; char
E41C D71E             (    forth6809.asm):03503                     STB   EMITCH
E41E B6C008           (    forth6809.asm):03504         EMITWT:     LDA   ACIASR
E421 8502             (    forth6809.asm):03505                     BITA  #SR_TDRE
E423 27F9             (    forth6809.asm):03506                     BEQ   EMITWT
E425 961E             (    forth6809.asm):03507                     LDA   EMITCH
E427 B7C009           (    forth6809.asm):03508                     STA   ACIADR
E42A 39               (    forth6809.asm):03509                     RTS
                      (    forth6809.asm):03510         
                      (    forth6809.asm):03511                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03512         
                      (    forth6809.asm):03513         ; ------------------------------------------------------------
                      (    forth6809.asm):03514         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03515         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03516         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03517         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03518         ; ------------------------------------------------------------
E42B 335E             (    forth6809.asm):03519         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E42D CC0000           (    forth6809.asm):03520                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E430 EDC4             (    forth6809.asm):03521                     STD   ,U
                      (    forth6809.asm):03522         
                      (    forth6809.asm):03523                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03524                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03525                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03526                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03527                                             ; stream this line's characters
E432 BDE3F6           (    forth6809.asm):03528                     JSR   PUTXON
                      (    forth6809.asm):03529                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03530         
E435 BDE3BD           (    forth6809.asm):03531         ALOOP:      JSR   KEYW
E438 3706             (    forth6809.asm):03532                     PULU  D
E43A 1F02             (    forth6809.asm):03533                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03534         
E43C C10D             (    forth6809.asm):03535                     CMPB  #13
E43E 274F             (    forth6809.asm):03536                     BEQ   ADONE
E440 C10A             (    forth6809.asm):03537                     CMPB  #10
E442 27F1             (    forth6809.asm):03538                     BEQ   ALOOP
E444 C108             (    forth6809.asm):03539                     CMPB  #8
E446 2724             (    forth6809.asm):03540                     BEQ   ABKSP
E448 C17F             (    forth6809.asm):03541                     CMPB  #127
E44A 2720             (    forth6809.asm):03542                     BEQ   ABKSP
                      (    forth6809.asm):03543         
E44C ECC4             (    forth6809.asm):03544                     LDD   ,U
E44E 10A342           (    forth6809.asm):03545                     CMPD  2,U
E451 27E2             (    forth6809.asm):03546                     BEQ   ALOOP
                      (    forth6809.asm):03547         
E453 AE44             (    forth6809.asm):03548                     LDX   4,U
E455 308B             (    forth6809.asm):03549                     LEAX  D,X
E457 1F20             (    forth6809.asm):03550                     TFR   Y,D
E459 E784             (    forth6809.asm):03551                     STB   ,X
E45B ECC4             (    forth6809.asm):03552                     LDD   ,U
E45D C30001           (    forth6809.asm):03553                     ADDD  #1
E460 EDC4             (    forth6809.asm):03554                     STD   ,U
                      (    forth6809.asm):03555         
E462 1F20             (    forth6809.asm):03556                     TFR   Y,D
E464 4F               (    forth6809.asm):03557                     CLRA
E465 3606             (    forth6809.asm):03558                     PSHU  D
E467 BDE41A           (    forth6809.asm):03559                     JSR   EMITW
E46A 20C9             (    forth6809.asm):03560                     BRA   ALOOP
                      (    forth6809.asm):03561         
E46C ECC4             (    forth6809.asm):03562         ABKSP:      LDD   ,U
E46E 27C5             (    forth6809.asm):03563                     BEQ   ALOOP
E470 830001           (    forth6809.asm):03564                     SUBD  #1
E473 EDC4             (    forth6809.asm):03565                     STD   ,U
E475 CC0008           (    forth6809.asm):03566                     LDD   #8
E478 3606             (    forth6809.asm):03567                     PSHU  D
E47A BDE41A           (    forth6809.asm):03568                     JSR   EMITW
E47D CC0020           (    forth6809.asm):03569                     LDD   #32
E480 3606             (    forth6809.asm):03570                     PSHU  D
E482 BDE41A           (    forth6809.asm):03571                     JSR   EMITW
E485 CC0008           (    forth6809.asm):03572                     LDD   #8
E488 3606             (    forth6809.asm):03573                     PSHU  D
E48A BDE41A           (    forth6809.asm):03574                     JSR   EMITW
E48D 20A6             (    forth6809.asm):03575                     BRA   ALOOP
                      (    forth6809.asm):03576         
E48F                  (    forth6809.asm):03577         ADONE:
                      (    forth6809.asm):03578                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03579                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03580                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03581                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03582                                             ; with KEY never polled at all
E48F BDE3F2           (    forth6809.asm):03583                     JSR   PUTXOFF
                      (    forth6809.asm):03584                     ENDC                    ; <<<<<<<<<<
E492 ECC4             (    forth6809.asm):03585                     LDD   ,U
E494 ED44             (    forth6809.asm):03586                     STD   4,U               ; +n2
E496 3344             (    forth6809.asm):03587                     LEAU  4,U
E498 39               (    forth6809.asm):03588                     RTS
                      (    forth6809.asm):03589         
                      (    forth6809.asm):03590         ; ------------------------------------------------------------
                      (    forth6809.asm):03591         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03592         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03593         ; ------------------------------------------------------------
E499 BDE42B           (    forth6809.asm):03594         EXPECTW:    JSR   ACCEPTW
E49C 3706             (    forth6809.asm):03595                     PULU  D
E49E DD3F             (    forth6809.asm):03596                     STD   SPAN
E4A0 39               (    forth6809.asm):03597                     RTS
                      (    forth6809.asm):03598         
                      (    forth6809.asm):03599         ; ------------------------------------------------------------
                      (    forth6809.asm):03600         ; QUERY  ( -- )
                      (    forth6809.asm):03601         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03602         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03603         ; to 0 and >IN to 0.
                      (    forth6809.asm):03604         ; ------------------------------------------------------------
E4A1 8E0106           (    forth6809.asm):03605         QUERYW:     LDX   #TIBBUF
E4A4 3610             (    forth6809.asm):03606                     PSHU  X
E4A6 CC0050           (    forth6809.asm):03607                     LDD   #TIBBUFL
E4A9 3606             (    forth6809.asm):03608                     PSHU  D
E4AB BDE42B           (    forth6809.asm):03609                     JSR   ACCEPTW
E4AE 3706             (    forth6809.asm):03610                     PULU  D
E4B0 DD12             (    forth6809.asm):03611                     STD   NTIB
E4B2 DD3B             (    forth6809.asm):03612                     STD   SRCLEN
E4B4 CC0106           (    forth6809.asm):03613                     LDD   #TIBBUF
E4B7 DD39             (    forth6809.asm):03614                     STD   SRCADDR
E4B9 CC0000           (    forth6809.asm):03615                     LDD   #0
E4BC DD3D             (    forth6809.asm):03616                     STD   SRCID
E4BE DD10             (    forth6809.asm):03617                     STD   TOIN
E4C0 39               (    forth6809.asm):03618                     RTS
                      (    forth6809.asm):03619         
                      (    forth6809.asm):03620         ; ============================================================
                      (    forth6809.asm):03621         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03622         ; ============================================================
                      (    forth6809.asm):03623         ; ------------------------------------------------------------
                      (    forth6809.asm):03624         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03625         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03626         ; one expected.
                      (    forth6809.asm):03627         ; CFERR
                      (    forth6809.asm):03628         ;    Inputs:
                      (    forth6809.asm):03629         ;        none
                      (    forth6809.asm):03630         ;    Outputs:
                      (    forth6809.asm):03631         ;        does not return (THROW -22)
                      (    forth6809.asm):03632         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03633         ; ------------------------------------------------------------
E4C1 CCFFEA           (    forth6809.asm):03634         CFERR:      LDD   #-22
E4C4 3606             (    forth6809.asm):03635                     PSHU  D                 ; -22
E4C6 BDE4F6           (    forth6809.asm):03636                     JSR   THROWW
E4C9 39               (    forth6809.asm):03637                     RTS
                      (    forth6809.asm):03638         
                      (    forth6809.asm):03639         ; ------------------------------------------------------------
                      (    forth6809.asm):03640         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03641         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03642         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03643         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03644         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03645         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03646         ; ------------------------------------------------------------
E4CA 3710             (    forth6809.asm):03647         CATCHW:     PULU  X                 ; xt
E4CC DC0C             (    forth6809.asm):03648                     LDD   HANDLER
E4CE 3406             (    forth6809.asm):03649                     PSHS  D
E4D0 3440             (    forth6809.asm):03650                     PSHS  U
                      (    forth6809.asm):03651                     ; Save the input source specification.
                      (    forth6809.asm):03652                     ; See bugfix: CATCHW.1
E4D2 DC39             (    forth6809.asm):03653                     LDD   SRCADDR
E4D4 3406             (    forth6809.asm):03654                     PSHS  D
E4D6 DC3B             (    forth6809.asm):03655                     LDD   SRCLEN
E4D8 3406             (    forth6809.asm):03656                     PSHS  D
E4DA DC3D             (    forth6809.asm):03657                     LDD   SRCID
E4DC 3406             (    forth6809.asm):03658                     PSHS  D
E4DE DC10             (    forth6809.asm):03659                     LDD   TOIN
E4E0 3406             (    forth6809.asm):03660                     PSHS  D
E4E2 1F40             (    forth6809.asm):03661                     TFR   S,D
E4E4 DD0C             (    forth6809.asm):03662                     STD   HANDLER
                      (    forth6809.asm):03663         
E4E6 AD84             (    forth6809.asm):03664                     JSR   ,X
                      (    forth6809.asm):03665         
E4E8 3268             (    forth6809.asm):03666                     LEAS  8,S               ; drop saved input source
E4EA 3262             (    forth6809.asm):03667                     LEAS  2,S               ; saved U
E4EC 3506             (    forth6809.asm):03668                     PULS  D
E4EE DD0C             (    forth6809.asm):03669                     STD   HANDLER
E4F0 CC0000           (    forth6809.asm):03670                     LDD   #0
E4F3 3606             (    forth6809.asm):03671                     PSHU  D                 ; 0 = no exception
E4F5 39               (    forth6809.asm):03672                     RTS
                      (    forth6809.asm):03673         
                      (    forth6809.asm):03674         ; ------------------------------------------------------------
                      (    forth6809.asm):03675         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03676         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03677         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03678         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03679         ; ------------------------------------------------------------
E4F6 3706             (    forth6809.asm):03680         THROWW:     PULU  D                 ; n
E4F8 10830000         (    forth6809.asm):03681                     CMPD  #0
E4FC 2725             (    forth6809.asm):03682                     BEQ   THDONE
                      (    forth6809.asm):03683         
E4FE DD0E             (    forth6809.asm):03684                     STD   THROWN
E500 9E0C             (    forth6809.asm):03685                     LDX   HANDLER
E502 2720             (    forth6809.asm):03686                     BEQ   THUNCAU
                      (    forth6809.asm):03687         
E504 1F14             (    forth6809.asm):03688                     TFR   X,S
E506 3506             (    forth6809.asm):03689                     PULS  D                 ; restore input source saved by CATCH
E508 DD10             (    forth6809.asm):03690                     STD   TOIN
E50A 3506             (    forth6809.asm):03691                     PULS  D
E50C DD3D             (    forth6809.asm):03692                     STD   SRCID
E50E 3506             (    forth6809.asm):03693                     PULS  D
E510 DD3B             (    forth6809.asm):03694                     STD   SRCLEN
E512 3506             (    forth6809.asm):03695                     PULS  D
E514 DD39             (    forth6809.asm):03696                     STD   SRCADDR
E516 3506             (    forth6809.asm):03697                     PULS  D
E518 1F03             (    forth6809.asm):03698                     TFR   D,U
E51A 3506             (    forth6809.asm):03699                     PULS  D
E51C DD0C             (    forth6809.asm):03700                     STD   HANDLER
                      (    forth6809.asm):03701         
E51E DC0E             (    forth6809.asm):03702                     LDD   THROWN
E520 3606             (    forth6809.asm):03703                     PSHU  D
E522 39               (    forth6809.asm):03704                     RTS
E523 39               (    forth6809.asm):03705         THDONE:     RTS
                      (    forth6809.asm):03706         
                      (    forth6809.asm):03707                     ; No CATCH is active: leave n on the stack and ABORT.
E524 DC0E             (    forth6809.asm):03708         THUNCAU:    LDD   THROWN
E526 3606             (    forth6809.asm):03709                     PSHU  D
E528 7EDD3F           (    forth6809.asm):03710                     JMP   ABORT
                      (    forth6809.asm):03711         
                      (    forth6809.asm):03712         ; ============================================================
                      (    forth6809.asm):03713         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03714         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03715         ; ============================================================
                      (    forth6809.asm):03716         ; ------------------------------------------------------------
                      (    forth6809.asm):03717         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03718         ; location.
                      (    forth6809.asm):03719         ; PATCH   ( target location -- )
                      (    forth6809.asm):03720         ;    Inputs:
                      (    forth6809.asm):03721         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03722         ;    Outputs:
                      (    forth6809.asm):03723         ;        the cell at location holds target - location
                      (    forth6809.asm):03724         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
E52B 3710             (    forth6809.asm):03726         PATCH:      PULU  X                 ; location
E52D 3706             (    forth6809.asm):03727                     PULU  D                 ; target
E52F 3410             (    forth6809.asm):03728                     PSHS  X
E531 A3E1             (    forth6809.asm):03729                     SUBD  ,S++              ; target - location
E533 ED84             (    forth6809.asm):03730                     STD   ,X
E535 39               (    forth6809.asm):03731                     RTS
                      (    forth6809.asm):03732         
                      (    forth6809.asm):03733         ; ------------------------------------------------------------
                      (    forth6809.asm):03734         ; IF  ( C: -- orig )
                      (    forth6809.asm):03735         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03736         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03737         ; ------------------------------------------------------------
E536 CCDDEC           (    forth6809.asm):03738         IFW:        LDD   #ZBRANCH
E539 3606             (    forth6809.asm):03739                     PSHU  D
E53B BDE931           (    forth6809.asm):03740                     JSR   CCALL
E53E CC0000           (    forth6809.asm):03741                     LDD   #0
E541 3606             (    forth6809.asm):03742                     PSHU  D
E543 BDDE76           (    forth6809.asm):03743                     JSR   CODECOMMA
E546 DC08             (    forth6809.asm):03744                     LDD   CODEHERE
E548 830002           (    forth6809.asm):03745                     SUBD  #2
E54B 3606             (    forth6809.asm):03746                     PSHU  D                 ; orig
E54D CC0001           (    forth6809.asm):03747                     LDD   #TAGFWD
E550 3606             (    forth6809.asm):03748                     PSHU  D
E552 39               (    forth6809.asm):03749                     RTS
                      (    forth6809.asm):03750         
                      (    forth6809.asm):03751         ; ------------------------------------------------------------
                      (    forth6809.asm):03752         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03753         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03754         ; operand to jump to the current code address.
                      (    forth6809.asm):03755         ; ------------------------------------------------------------
E553 3706             (    forth6809.asm):03756         THENW:      PULU  D
E555 10830001         (    forth6809.asm):03757                     CMPD  #TAGFWD
E559 2703             (    forth6809.asm):03758                     BEQ   THOK
E55B BDE4C1           (    forth6809.asm):03759                     JSR   CFERR
E55E 3710             (    forth6809.asm):03760         THOK:       PULU  X                 ; orig
E560 DC08             (    forth6809.asm):03761                     LDD   CODEHERE
E562 3606             (    forth6809.asm):03762                     PSHU  D
E564 3610             (    forth6809.asm):03763                     PSHU  X
E566 BDE52B           (    forth6809.asm):03764                     JSR   PATCH
E569 39               (    forth6809.asm):03765                     RTS
                      (    forth6809.asm):03766         
                      (    forth6809.asm):03767         ; ------------------------------------------------------------
                      (    forth6809.asm):03768         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03769         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03770         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03771         ; ------------------------------------------------------------
E56A 3706             (    forth6809.asm):03772         ELSEW:      PULU  D
E56C 10830001         (    forth6809.asm):03773                     CMPD  #TAGFWD
E570 2703             (    forth6809.asm):03774                     BEQ   ELOK
E572 BDE4C1           (    forth6809.asm):03775                     JSR   CFERR
E575 3706             (    forth6809.asm):03776         ELOK:       PULU  D                 ; orig1
E577 3406             (    forth6809.asm):03777                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E579 CCDE02           (    forth6809.asm):03778                     LDD   #BRANCH
E57C 3606             (    forth6809.asm):03779                     PSHU  D
E57E BDE931           (    forth6809.asm):03780                     JSR   CCALL
E581 CC0000           (    forth6809.asm):03781                     LDD   #0
E584 3606             (    forth6809.asm):03782                     PSHU  D
E586 BDDE76           (    forth6809.asm):03783                     JSR   CODECOMMA
E589 DC08             (    forth6809.asm):03784                     LDD   CODEHERE

F87B 2715             (    forth6809.asm):14182                    BEQ  UEDONE
F87D A680             (    forth6809.asm):14183                    LDA  ,X+
F87F 8125             (    forth6809.asm):14184                    CMPA #'%'
F881 2604             (    forth6809.asm):14185                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):14186                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):14187                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):14188                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):14189                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):14190                                   ; the same string correctly, since this runs
                      (    forth6809.asm):14191                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):14192         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):14193                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):14194                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):14195                    SUBD #1

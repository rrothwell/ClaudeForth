                      (    forth6809.asm):02999                    SUBD  TSTUAF
                      (    forth6809.asm):03000                    CMPD  #0
                      (    forth6809.asm):03001                    BNE   SZFAIL
                      (    forth6809.asm):03002         
                      (    forth6809.asm):03003                    LDD   #TRUEV
                      (    forth6809.asm):03004                    BRA   SZDONE

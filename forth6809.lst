                      (    forth6809.asm):03562         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03563         ; to 0 and >IN to 0.
                      (    forth6809.asm):03564         ; ------------------------------------------------------------
E5E9 8E0106           (    forth6809.asm):03565         QUERYW:     LDX   #TIBBUF
E5EC 3610             (    forth6809.asm):03566                     PSHU  X
E5EE CC0050           (    forth6809.asm):03567                     LDD   #TIBBUFL
E5F1 3606             (    forth6809.asm):03568                     PSHU  D
E5F3 BDE579           (    forth6809.asm):03569                     JSR   ACCEPTW
E5F6 3706             (    forth6809.asm):03570                     PULU  D
E5F8 DD12             (    forth6809.asm):03571                     STD   NTIB
E5FA DD56             (    forth6809.asm):03572                     STD   SRCLEN
E5FC CC0106           (    forth6809.asm):03573                     LDD   #TIBBUF
E5FF DD54             (    forth6809.asm):03574                     STD   SRCADDR
E601 CC0000           (    forth6809.asm):03575                     LDD   #0
E604 DD58             (    forth6809.asm):03576                     STD   SRCID
E606 DD10             (    forth6809.asm):03577                     STD   TOIN
E608 39               (    forth6809.asm):03578                     RTS
                      (    forth6809.asm):03579         
                      (    forth6809.asm):03580         ; ============================================================
                      (    forth6809.asm):03581         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03582         ; ============================================================
                      (    forth6809.asm):03583         ; ------------------------------------------------------------
                      (    forth6809.asm):03584         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03585         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03586         ; one expected.
                      (    forth6809.asm):03587         ; CFERR
                      (    forth6809.asm):03588         ;    Inputs:
                      (    forth6809.asm):03589         ;        none
                      (    forth6809.asm):03590         ;    Outputs:
                      (    forth6809.asm):03591         ;        does not return (THROW -22)
                      (    forth6809.asm):03592         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03593         ; ------------------------------------------------------------
E609 CCFFEA           (    forth6809.asm):03594         CFERR:      LDD   #-22
E60C 3606             (    forth6809.asm):03595                     PSHU  D                 ; -22
E60E BDE63E           (    forth6809.asm):03596                     JSR   THROWW
E611 39               (    forth6809.asm):03597                     RTS
                      (    forth6809.asm):03598         
                      (    forth6809.asm):03599         ; ------------------------------------------------------------
                      (    forth6809.asm):03600         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03601         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03602         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03603         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03604         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03605         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03606         ; ------------------------------------------------------------
E612 3710             (    forth6809.asm):03607         CATCHW:     PULU  X                 ; xt
E614 DC0C             (    forth6809.asm):03608                     LDD   HANDLER
E616 3406             (    forth6809.asm):03609                     PSHS  D
E618 3440             (    forth6809.asm):03610                     PSHS  U
                      (    forth6809.asm):03611                     ; Save the input source specification.
                      (    forth6809.asm):03612                     ; See bugfix: CATCHW.1
E61A DC54             (    forth6809.asm):03613                     LDD   SRCADDR
E61C 3406             (    forth6809.asm):03614                     PSHS  D
E61E DC56             (    forth6809.asm):03615                     LDD   SRCLEN
E620 3406             (    forth6809.asm):03616                     PSHS  D
E622 DC58             (    forth6809.asm):03617                     LDD   SRCID
E624 3406             (    forth6809.asm):03618                     PSHS  D
E626 DC10             (    forth6809.asm):03619                     LDD   TOIN
E628 3406             (    forth6809.asm):03620                     PSHS  D
E62A 1F40             (    forth6809.asm):03621                     TFR   S,D
E62C DD0C             (    forth6809.asm):03622                     STD   HANDLER
                      (    forth6809.asm):03623         
E62E AD84             (    forth6809.asm):03624                     JSR   ,X
                      (    forth6809.asm):03625         
E630 3268             (    forth6809.asm):03626                     LEAS  8,S               ; drop saved input source
E632 3262             (    forth6809.asm):03627                     LEAS  2,S               ; saved U
E634 3506             (    forth6809.asm):03628                     PULS  D
E636 DD0C             (    forth6809.asm):03629                     STD   HANDLER
E638 CC0000           (    forth6809.asm):03630                     LDD   #0
E63B 3606             (    forth6809.asm):03631                     PSHU  D                 ; 0 = no exception
E63D 39               (    forth6809.asm):03632                     RTS
                      (    forth6809.asm):03633         
                      (    forth6809.asm):03634         ; ------------------------------------------------------------
                      (    forth6809.asm):03635         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03636         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03637         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03638         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03639         ; ------------------------------------------------------------
E63E 3706             (    forth6809.asm):03640         THROWW:     PULU  D                 ; n
E640 10830000         (    forth6809.asm):03641                     CMPD  #0
E644 2725             (    forth6809.asm):03642                     BEQ   THDONE
                      (    forth6809.asm):03643         
E646 DD0E             (    forth6809.asm):03644                     STD   THROWN
E648 9E0C             (    forth6809.asm):03645                     LDX   HANDLER
E64A 2720             (    forth6809.asm):03646                     BEQ   THUNCAU
                      (    forth6809.asm):03647         
E64C 1F14             (    forth6809.asm):03648                     TFR   X,S
E64E 3506             (    forth6809.asm):03649                     PULS  D                 ; restore input source saved by CATCH
E650 DD10             (    forth6809.asm):03650                     STD   TOIN
E652 3506             (    forth6809.asm):03651                     PULS  D
E654 DD58             (    forth6809.asm):03652                     STD   SRCID
E656 3506             (    forth6809.asm):03653                     PULS  D
E658 DD56             (    forth6809.asm):03654                     STD   SRCLEN
E65A 3506             (    forth6809.asm):03655                     PULS  D
E65C DD54             (    forth6809.asm):03656                     STD   SRCADDR
E65E 3506             (    forth6809.asm):03657                     PULS  D
E660 1F03             (    forth6809.asm):03658                     TFR   D,U
E662 3506             (    forth6809.asm):03659                     PULS  D
E664 DD0C             (    forth6809.asm):03660                     STD   HANDLER
                      (    forth6809.asm):03661         
E666 DC0E             (    forth6809.asm):03662                     LDD   THROWN
E668 3606             (    forth6809.asm):03663                     PSHU  D
E66A 39               (    forth6809.asm):03664                     RTS
E66B 39               (    forth6809.asm):03665         THDONE:     RTS
                      (    forth6809.asm):03666         
                      (    forth6809.asm):03667                     ; No CATCH is active: leave n on the stack and ABORT.
E66C DC0E             (    forth6809.asm):03668         THUNCAU:    LDD   THROWN
E66E 3606             (    forth6809.asm):03669                     PSHU  D
E670 7EDEC3           (    forth6809.asm):03670                     JMP   ABORT
                      (    forth6809.asm):03671         
                      (    forth6809.asm):03672         ; ============================================================
                      (    forth6809.asm):03673         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03674         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03675         ; ============================================================
                      (    forth6809.asm):03676         ; ------------------------------------------------------------
                      (    forth6809.asm):03677         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03678         ; location.
                      (    forth6809.asm):03679         ; PATCH   ( target location -- )
                      (    forth6809.asm):03680         ;    Inputs:
                      (    forth6809.asm):03681         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03682         ;    Outputs:
                      (    forth6809.asm):03683         ;        the cell at location holds target - location
                      (    forth6809.asm):03684         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03685         ; ------------------------------------------------------------
E673 3710             (    forth6809.asm):03686         PATCH:      PULU  X                 ; location
E675 3706             (    forth6809.asm):03687                     PULU  D                 ; target
E677 3410             (    forth6809.asm):03688                     PSHS  X
E679 A3E1             (    forth6809.asm):03689                     SUBD  ,S++              ; target - location
E67B ED84             (    forth6809.asm):03690                     STD   ,X
E67D 39               (    forth6809.asm):03691                     RTS
                      (    forth6809.asm):03692         
                      (    forth6809.asm):03693         ; ------------------------------------------------------------
                      (    forth6809.asm):03694         ; IF  ( C: -- orig )
                      (    forth6809.asm):03695         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03696         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03697         ; ------------------------------------------------------------
E67E CCDF70           (    forth6809.asm):03698         IFW:        LDD   #ZBRANCH
E681 3606             (    forth6809.asm):03699                     PSHU  D
E683 BDEA79           (    forth6809.asm):03700                     JSR   CCALL
E686 CC0000           (    forth6809.asm):03701                     LDD   #0
E689 3606             (    forth6809.asm):03702                     PSHU  D
E68B BDE002           (    forth6809.asm):03703                     JSR   CODECOMMA
E68E DC08             (    forth6809.asm):03704                     LDD   CODEHERE
E690 830002           (    forth6809.asm):03705                     SUBD  #2
E693 3606             (    forth6809.asm):03706                     PSHU  D                 ; orig
E695 CC0001           (    forth6809.asm):03707                     LDD   #TAGFWD
E698 3606             (    forth6809.asm):03708                     PSHU  D
E69A 39               (    forth6809.asm):03709                     RTS
                      (    forth6809.asm):03710         
                      (    forth6809.asm):03711         ; ------------------------------------------------------------
                      (    forth6809.asm):03712         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03713         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03714         ; operand to jump to the current code address.
                      (    forth6809.asm):03715         ; ------------------------------------------------------------
E69B 3706             (    forth6809.asm):03716         THENW:      PULU  D
E69D 10830001         (    forth6809.asm):03717                     CMPD  #TAGFWD
E6A1 2703             (    forth6809.asm):03718                     BEQ   THOK
E6A3 BDE609           (    forth6809.asm):03719                     JSR   CFERR
E6A6 3710             (    forth6809.asm):03720         THOK:       PULU  X                 ; orig
E6A8 DC08             (    forth6809.asm):03721                     LDD   CODEHERE
E6AA 3606             (    forth6809.asm):03722                     PSHU  D
E6AC 3610             (    forth6809.asm):03723                     PSHU  X
E6AE BDE673           (    forth6809.asm):03724                     JSR   PATCH
E6B1 39               (    forth6809.asm):03725                     RTS
                      (    forth6809.asm):03726         
                      (    forth6809.asm):03727         ; ------------------------------------------------------------
                      (    forth6809.asm):03728         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03729         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03730         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03731         ; ------------------------------------------------------------
E6B2 3706             (    forth6809.asm):03732         ELSEW:      PULU  D
E6B4 10830001         (    forth6809.asm):03733                     CMPD  #TAGFWD
E6B8 2703             (    forth6809.asm):03734                     BEQ   ELOK
E6BA BDE609           (    forth6809.asm):03735                     JSR   CFERR
E6BD 3706             (    forth6809.asm):03736         ELOK:       PULU  D                 ; orig1
E6BF 3406             (    forth6809.asm):03737                     PSHS  D                 ; See bugfix: ELSEW.1 (5k: kept on S)
E6C1 CCDF86           (    forth6809.asm):03738                     LDD   #BRANCH
E6C4 3606             (    forth6809.asm):03739                     PSHU  D
E6C6 BDEA79           (    forth6809.asm):03740                     JSR   CCALL
E6C9 CC0000           (    forth6809.asm):03741                     LDD   #0
E6CC 3606             (    forth6809.asm):03742                     PSHU  D
E6CE BDE002           (    forth6809.asm):03743                     JSR   CODECOMMA
E6D1 DC08             (    forth6809.asm):03744                     LDD   CODEHERE
E6D3 3606             (    forth6809.asm):03745                     PSHU  D
E6D5 3506             (    forth6809.asm):03746                     PULS  D                 ; orig1
E6D7 3606             (    forth6809.asm):03747                     PSHU  D
E6D9 BDE673           (    forth6809.asm):03748                     JSR   PATCH
E6DC DC08             (    forth6809.asm):03749                     LDD   CODEHERE
E6DE 830002           (    forth6809.asm):03750                     SUBD  #2
E6E1 3606             (    forth6809.asm):03751                     PSHU  D                 ; orig2
E6E3 CC0001           (    forth6809.asm):03752                     LDD   #TAGFWD
E6E6 3606             (    forth6809.asm):03753                     PSHU  D
E6E8 39               (    forth6809.asm):03754                     RTS
                      (    forth6809.asm):03755         
                      (    forth6809.asm):03756         ; ------------------------------------------------------------
                      (    forth6809.asm):03757         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03758         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03759         ; stack.
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
E6E9 DC08             (    forth6809.asm):03761         BEGINW:     LDD   CODEHERE
E6EB 3606             (    forth6809.asm):03762                     PSHU  D                 ; dest
E6ED CC0002           (    forth6809.asm):03763                     LDD   #TAGBACK
E6F0 3606             (    forth6809.asm):03764                     PSHU  D
E6F2 39               (    forth6809.asm):03765                     RTS
                      (    forth6809.asm):03766         
                      (    forth6809.asm):03767         ; ------------------------------------------------------------
                      (    forth6809.asm):03768         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03769         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03770         ; ------------------------------------------------------------
E6F3 3706             (    forth6809.asm):03771         UNTILW:     PULU  D
E6F5 10830002         (    forth6809.asm):03772                     CMPD  #TAGBACK
E6F9 2703             (    forth6809.asm):03773                     BEQ   UNOK
E6FB BDE609           (    forth6809.asm):03774                     JSR   CFERR
E6FE 3706             (    forth6809.asm):03775         UNOK:       PULU  D                 ; dest
E700 3606             (    forth6809.asm):03776                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E702 CCDF70           (    forth6809.asm):03777                     LDD   #ZBRANCH
E705 3606             (    forth6809.asm):03778                     PSHU  D
E707 BDEA79           (    forth6809.asm):03779                     JSR   CCALL
E70A CC0000           (    forth6809.asm):03780                     LDD   #0
E70D 3606             (    forth6809.asm):03781                     PSHU  D
E70F BDE002           (    forth6809.asm):03782                     JSR   CODECOMMA
E712 DC08             (    forth6809.asm):03783                     LDD   CODEHERE
E714 830002           (    forth6809.asm):03784                     SUBD  #2
E717 3606             (    forth6809.asm):03785                     PSHU  D                 ; location; the parked dest is beneath
E719 BDE673           (    forth6809.asm):03786                     JSR   PATCH
E71C 39               (    forth6809.asm):03787                     RTS
                      (    forth6809.asm):03788         
                      (    forth6809.asm):03789         ; ------------------------------------------------------------
                      (    forth6809.asm):03790         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03791         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03792         ; ------------------------------------------------------------
E71D 3706             (    forth6809.asm):03793         AGAINW:     PULU  D
E71F 10830002         (    forth6809.asm):03794                     CMPD  #TAGBACK
E723 2703             (    forth6809.asm):03795                     BEQ   AGOK
E725 BDE609           (    forth6809.asm):03796                     JSR   CFERR
E728 3706             (    forth6809.asm):03797         AGOK:       PULU  D                 ; dest
E72A 3606             (    forth6809.asm):03798                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E72C CCDF86           (    forth6809.asm):03799                     LDD   #BRANCH
E72F 3606             (    forth6809.asm):03800                     PSHU  D
E731 BDEA79           (    forth6809.asm):03801                     JSR   CCALL
E734 CC0000           (    forth6809.asm):03802                     LDD   #0
E737 3606             (    forth6809.asm):03803                     PSHU  D
E739 BDE002           (    forth6809.asm):03804                     JSR   CODECOMMA
E73C DC08             (    forth6809.asm):03805                     LDD   CODEHERE
E73E 830002           (    forth6809.asm):03806                     SUBD  #2
E741 3606             (    forth6809.asm):03807                     PSHU  D                 ; location; the parked dest is beneath
E743 BDE673           (    forth6809.asm):03808                     JSR   PATCH
E746 39               (    forth6809.asm):03809                     RTS
                      (    forth6809.asm):03810         
                      (    forth6809.asm):03811         ; ------------------------------------------------------------
                      (    forth6809.asm):03812         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03813         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03814         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03815         ; ------------------------------------------------------------
E747 CCDF70           (    forth6809.asm):03816         WHILEW:     LDD   #ZBRANCH
E74A 3606             (    forth6809.asm):03817                     PSHU  D
E74C BDEA79           (    forth6809.asm):03818                     JSR   CCALL
E74F CC0000           (    forth6809.asm):03819                     LDD   #0
E752 3606             (    forth6809.asm):03820                     PSHU  D
E754 BDE002           (    forth6809.asm):03821                     JSR   CODECOMMA
E757 DC08             (    forth6809.asm):03822                     LDD   CODEHERE
E759 830002           (    forth6809.asm):03823                     SUBD  #2
E75C 3606             (    forth6809.asm):03824                     PSHU  D                 ; orig
E75E CC0001           (    forth6809.asm):03825                     LDD   #TAGFWD
E761 3606             (    forth6809.asm):03826                     PSHU  D
E763 39               (    forth6809.asm):03827                     RTS
                      (    forth6809.asm):03828         
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
                      (    forth6809.asm):03830         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03831         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03832         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03833         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03834         ; ------------------------------------------------------------
E764 3706             (    forth6809.asm):03835         REPEATW:    PULU  D
E766 10830001         (    forth6809.asm):03836                     CMPD  #TAGFWD
E76A 2703             (    forth6809.asm):03837                     BEQ   RPOK1
E76C BDE609           (    forth6809.asm):03838                     JSR   CFERR
E76F 3710             (    forth6809.asm):03839         RPOK1:      PULU  X                 ; orig
E771 3410             (    forth6809.asm):03840                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):03841         
                      (    forth6809.asm):03842                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03843                     ; See bugfix: REPEATW.1
E773 3040             (    forth6809.asm):03844                     LEAX  0,U               ; scan from top of control stack
E775 9F28             (    forth6809.asm):03845                     STX   MSCR2             ; MSCR2 = base of scan region
E777 9F2C             (    forth6809.asm):03846                     STX   MSCR4             ; MSCR4 = scan pointer
E779 DC2C             (    forth6809.asm):03847         RPSCAN:     LDD   MSCR4
E77B 109333           (    forth6809.asm):03848                     CMPD  CSP
E77E 2603             (    forth6809.asm):03849                     BNE   RPSCANOK
E780 BDE609           (    forth6809.asm):03850                     JSR   CFERR             ; no matching BEGIN
E783 9E2C             (    forth6809.asm):03851         RPSCANOK:   LDX   MSCR4
E785 EC84             (    forth6809.asm):03852                     LDD   ,X
E787 10830002         (    forth6809.asm):03853                     CMPD  #TAGBACK
E78B 2712             (    forth6809.asm):03854                     BEQ   RPFOUND
E78D 10830001         (    forth6809.asm):03855                     CMPD  #TAGFWD
E791 2703             (    forth6809.asm):03856                     BEQ   RPSKIP
E793 BDE609           (    forth6809.asm):03857                     JSR   CFERR             ; anything else is a genuine mismatch
E796 DC2C             (    forth6809.asm):03858         RPSKIP:     LDD   MSCR4
E798 C30004           (    forth6809.asm):03859                     ADDD  #4
E79B DD2C             (    forth6809.asm):03860                     STD   MSCR4
E79D 20DA             (    forth6809.asm):03861                     BRA   RPSCAN
E79F 9E2C             (    forth6809.asm):03862         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E7A1 EC02             (    forth6809.asm):03863                     LDD   2,X               ; dest = BEGIN's address
E7A3 3406             (    forth6809.asm):03864                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):03865         
                      (    forth6809.asm):03866                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03867                     ; bytes, highest word first.
E7A5 DC2C             (    forth6809.asm):03868                     LDD   MSCR4
E7A7 9328             (    forth6809.asm):03869                     SUBD  MSCR2
E7A9 DD2A             (    forth6809.asm):03870                     STD   MSCR3             ; MSCR3 = bytes to shift
E7AB 2715             (    forth6809.asm):03871                     BEQ   RPSHIFTDONE
E7AD DC2A             (    forth6809.asm):03872         RPSHIFT:    LDD   MSCR3
E7AF 830002           (    forth6809.asm):03873                     SUBD  #2
E7B2 DD2A             (    forth6809.asm):03874                     STD   MSCR3
E7B4 9E28             (    forth6809.asm):03875                     LDX   MSCR2
E7B6 308B             (    forth6809.asm):03876                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E7B8 EC84             (    forth6809.asm):03877                     LDD   ,X
E7BA 3004             (    forth6809.asm):03878                     LEAX  4,X
E7BC ED84             (    forth6809.asm):03879                     STD   ,X                ; copy one word 4 bytes higher
E7BE DC2A             (    forth6809.asm):03880                     LDD   MSCR3
E7C0 26EB             (    forth6809.asm):03881                     BNE   RPSHIFT
E7C2                  (    forth6809.asm):03882         RPSHIFTDONE:
E7C2 9E28             (    forth6809.asm):03883                     LDX   MSCR2
E7C4 3004             (    forth6809.asm):03884                     LEAX  4,X
E7C6 1F13             (    forth6809.asm):03885                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03886         
E7C8 CCDF86           (    forth6809.asm):03887                     LDD   #BRANCH
E7CB 3606             (    forth6809.asm):03888                     PSHU  D
E7CD BDEA79           (    forth6809.asm):03889                     JSR   CCALL
E7D0 CC0000           (    forth6809.asm):03890                     LDD   #0
E7D3 3606             (    forth6809.asm):03891                     PSHU  D
E7D5 BDE002           (    forth6809.asm):03892                     JSR   CODECOMMA
E7D8 EC60             (    forth6809.asm):03893                     LDD   0,S               ; target = BEGIN's address
E7DA 3606             (    forth6809.asm):03894                     PSHU  D
E7DC DC08             (    forth6809.asm):03895                     LDD   CODEHERE
E7DE 830002           (    forth6809.asm):03896                     SUBD  #2                ; location = the operand just compiled
E7E1 3606             (    forth6809.asm):03897                     PSHU  D
E7E3 BDE673           (    forth6809.asm):03898                     JSR   PATCH
E7E6 DC08             (    forth6809.asm):03899                     LDD   CODEHERE
E7E8 3606             (    forth6809.asm):03900                     PSHU  D
E7EA EC62             (    forth6809.asm):03901                     LDD   2,S               ; orig
E7EC 3606             (    forth6809.asm):03902                     PSHU  D
E7EE BDE673           (    forth6809.asm):03903                     JSR   PATCH
E7F1 3264             (    forth6809.asm):03904                     LEAS  4,S               ; drop the frame
E7F3 39               (    forth6809.asm):03905                     RTS
                      (    forth6809.asm):03906         
                      (    forth6809.asm):03907         ; ------------------------------------------------------------
                      (    forth6809.asm):03908         ; RECURSE  ( -- )
                      (    forth6809.asm):03909         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):03910         ; the xt held in CURXT.
                      (    forth6809.asm):03911         ; ------------------------------------------------------------
E7F4 DC31             (    forth6809.asm):03912         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E7F6 3606             (    forth6809.asm):03913                     PSHU  D                 ; See bugfix: RECURSEW.1
E7F8 BDEA79           (    forth6809.asm):03914                     JSR   CCALL
E7FB 39               (    forth6809.asm):03915                     RTS
                      (    forth6809.asm):03916         
                      (    forth6809.asm):03917         ; ------------------------------------------------------------
                      (    forth6809.asm):03918         ; DO  ( C: -- dest )
                      (    forth6809.asm):03919         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03920         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03921         ; ------------------------------------------------------------
E7FC CCE80E           (    forth6809.asm):03922         DOW:        LDD   #DOSETUP
E7FF 3606             (    forth6809.asm):03923                     PSHU  D
E801 BDEA79           (    forth6809.asm):03924                     JSR   CCALL
E804 DC08             (    forth6809.asm):03925                     LDD   CODEHERE
E806 3606             (    forth6809.asm):03926                     PSHU  D                 ; dest
E808 CC0003           (    forth6809.asm):03927                     LDD   #TAGDO
E80B 3606             (    forth6809.asm):03928                     PSHU  D
E80D 39               (    forth6809.asm):03929                     RTS
                      (    forth6809.asm):03930         
                      (    forth6809.asm):03931         ; ------------------------------------------------------------
                      (    forth6809.asm):03932         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03933         ; return address.
                      (    forth6809.asm):03934         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03935         ;    Inputs:
                      (    forth6809.asm):03936         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03937         ;    Outputs:
                      (    forth6809.asm):03938         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03939         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03940         ; ------------------------------------------------------------
E80E 3706             (    forth6809.asm):03941         DOSETUP:    PULU  D                 ; index
E810 DD26             (    forth6809.asm):03942                     STD   MSCR
E812 3706             (    forth6809.asm):03943                     PULU  D                 ; limit
E814 DD28             (    forth6809.asm):03944                     STD   MSCR2
E816 3510             (    forth6809.asm):03945                     PULS  X
E818 CC0000           (    forth6809.asm):03946                     LDD   #0
E81B 3406             (    forth6809.asm):03947                     PSHS  D
E81D DC28             (    forth6809.asm):03948                     LDD   MSCR2
E81F 3406             (    forth6809.asm):03949                     PSHS  D
E821 DC26             (    forth6809.asm):03950                     LDD   MSCR
E823 3406             (    forth6809.asm):03951                     PSHS  D
E825 3410             (    forth6809.asm):03952                     PSHS  X
E827 39               (    forth6809.asm):03953                     RTS
                      (    forth6809.asm):03954         
                      (    forth6809.asm):03955         ; ------------------------------------------------------------
                      (    forth6809.asm):03956         ; I  ( -- n )
                      (    forth6809.asm):03957         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):03958         ; address).
                      (    forth6809.asm):03959         ; ------------------------------------------------------------
E828 EC62             (    forth6809.asm):03960         IW:         LDD   2,S               ; n. See bugfix: IW.1
E82A 3606             (    forth6809.asm):03961                     PSHU  D
E82C 39               (    forth6809.asm):03962                     RTS
                      (    forth6809.asm):03963         
                      (    forth6809.asm):03964         ; ------------------------------------------------------------
                      (    forth6809.asm):03965         ; J  ( -- n )
                      (    forth6809.asm):03966         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):03967         ; address and the inner loop frame).
                      (    forth6809.asm):03968         ; ------------------------------------------------------------
E82D EC68             (    forth6809.asm):03969         JW:         LDD   8,S               ; n. See bugfix: JW.1
E82F 3606             (    forth6809.asm):03970                     PSHU  D
E831 39               (    forth6809.asm):03971                     RTS
                      (    forth6809.asm):03972         
                      (    forth6809.asm):03973         ; ------------------------------------------------------------
                      (    forth6809.asm):03974         ; LEAVE  ( -- )
                      (    forth6809.asm):03975         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):03976         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):03977         ; ------------------------------------------------------------
E832 CCFFFF           (    forth6809.asm):03978         LEAVEW:     LDD   #TRUEV            ; true
E835 ED66             (    forth6809.asm):03979                     STD   6,S               ; See bugfix: LEAVEW.1
E837 39               (    forth6809.asm):03980                     RTS
                      (    forth6809.asm):03981         
                      (    forth6809.asm):03982         ; ------------------------------------------------------------
                      (    forth6809.asm):03983         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):03984         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):03985         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):03986         ; ------------------------------------------------------------
E838 3706             (    forth6809.asm):03987         LOOPW:      PULU  D
E83A 10830003         (    forth6809.asm):03988                     CMPD  #TAGDO
E83E 2703             (    forth6809.asm):03989                     BEQ   LOOPOK
E840 BDE609           (    forth6809.asm):03990                     JSR   CFERR
E843 3706             (    forth6809.asm):03991         LOOPOK:     PULU  D                 ; dest
E845 3606             (    forth6809.asm):03992                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E847 CCE877           (    forth6809.asm):03993                     LDD   #DOTEST
E84A 3606             (    forth6809.asm):03994                     PSHU  D
E84C BDEA79           (    forth6809.asm):03995                     JSR   CCALL
E84F CC0000           (    forth6809.asm):03996                     LDD   #0
E852 3606             (    forth6809.asm):03997                     PSHU  D
E854 BDE002           (    forth6809.asm):03998                     JSR   CODECOMMA
E857 DC08             (    forth6809.asm):03999                     LDD   CODEHERE
E859 830002           (    forth6809.asm):04000                     SUBD  #2
E85C 3606             (    forth6809.asm):04001                     PSHU  D                 ; location; the parked dest is beneath
E85E BDE673           (    forth6809.asm):04002                     JSR   PATCH
                      (    forth6809.asm):04003         
E861 ECC4             (    forth6809.asm):04004                     LDD   ,U
E863 10830007         (    forth6809.asm):04005                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E867 260D             (    forth6809.asm):04006                     BNE   LOOPDONE
E869 3706             (    forth6809.asm):04007                     PULU  D
E86B 3710             (    forth6809.asm):04008                     PULU  X                 ; ?DO skip operand
E86D DC08             (    forth6809.asm):04009                     LDD   CODEHERE
E86F 3606             (    forth6809.asm):04010                     PSHU  D
E871 3610             (    forth6809.asm):04011                     PSHU  X
E873 BDE673           (    forth6809.asm):04012                     JSR   PATCH
E876 39               (    forth6809.asm):04013         LOOPDONE:   RTS
                      (    forth6809.asm):04014         
                      (    forth6809.asm):04015         ; ------------------------------------------------------------
                      (    forth6809.asm):04016         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04017         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04018         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04019         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04020         ; DOTEST
                      (    forth6809.asm):04021         ;    Inputs:
                      (    forth6809.asm):04022         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04023         ;        first)
                      (    forth6809.asm):04024         ;    Outputs:
                      (    forth6809.asm):04025         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04026         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04027         ; ------------------------------------------------------------
E877 EC66             (    forth6809.asm):04028         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E879 2615             (    forth6809.asm):04029                     BNE   DTEXIT            ; set: exit
E87B EC62             (    forth6809.asm):04030                     LDD   2,S               ; index
E87D C30001           (    forth6809.asm):04031                     ADDD  #1
E880 ED62             (    forth6809.asm):04032                     STD   2,S
E882 10A364           (    forth6809.asm):04033                     CMPD  4,S               ; limit
E885 2709             (    forth6809.asm):04034                     BEQ   DTEXIT
E887 3510             (    forth6809.asm):04035                     PULS  X                 ; X = branch operand address
E889 EC84             (    forth6809.asm):04036                     LDD   ,X
E88B 308B             (    forth6809.asm):04037                     LEAX  D,X
E88D 3410             (    forth6809.asm):04038                     PSHS  X                 ; return to loop start
E88F 39               (    forth6809.asm):04039                     RTS
E890 3510             (    forth6809.asm):04040         DTEXIT:     PULS  X
E892 3002             (    forth6809.asm):04041                     LEAX  2,X               ; skip the branch operand
E894 3266             (    forth6809.asm):04042                     LEAS  6,S               ; discard the loop frame
E896 3410             (    forth6809.asm):04043                     PSHS  X
E898 39               (    forth6809.asm):04044                     RTS
                      (    forth6809.asm):04045         
                      (    forth6809.asm):04046         ; ------------------------------------------------------------
                      (    forth6809.asm):04047         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):04048         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):04049         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04050         ; ------------------------------------------------------------
E899 3706             (    forth6809.asm):04051         PLUSLOOPW:  PULU  D
E89B 10830003         (    forth6809.asm):04052                     CMPD  #TAGDO
E89F 2703             (    forth6809.asm):04053                     BEQ   PLOOPOK
E8A1 BDE609           (    forth6809.asm):04054                     JSR   CFERR
E8A4 3706             (    forth6809.asm):04055         PLOOPOK:    PULU  D                 ; dest
E8A6 3606             (    forth6809.asm):04056                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E8A8 CCE8D8           (    forth6809.asm):04057                     LDD   #DOPLUSTEST
E8AB 3606             (    forth6809.asm):04058                     PSHU  D
E8AD BDEA79           (    forth6809.asm):04059                     JSR   CCALL
E8B0 CC0000           (    forth6809.asm):04060                     LDD   #0
E8B3 3606             (    forth6809.asm):04061                     PSHU  D
E8B5 BDE002           (    forth6809.asm):04062                     JSR   CODECOMMA
E8B8 DC08             (    forth6809.asm):04063                     LDD   CODEHERE
E8BA 830002           (    forth6809.asm):04064                     SUBD  #2
E8BD 3606             (    forth6809.asm):04065                     PSHU  D                 ; location; the parked dest is beneath
E8BF BDE673           (    forth6809.asm):04066                     JSR   PATCH
                      (    forth6809.asm):04067         
E8C2 ECC4             (    forth6809.asm):04068                     LDD   ,U
E8C4 10830007         (    forth6809.asm):04069                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
E8C8 260D             (    forth6809.asm):04070                     BNE   PLOOPDONE
E8CA 3706             (    forth6809.asm):04071                     PULU  D
E8CC 3710             (    forth6809.asm):04072                     PULU  X                 ; ?DO skip operand
E8CE DC08             (    forth6809.asm):04073                     LDD   CODEHERE
E8D0 3606             (    forth6809.asm):04074                     PSHU  D
E8D2 3610             (    forth6809.asm):04075                     PSHU  X
E8D4 BDE673           (    forth6809.asm):04076                     JSR   PATCH
E8D7 39               (    forth6809.asm):04077         PLOOPDONE:  RTS
                      (    forth6809.asm):04078         
                      (    forth6809.asm):04079         ; ------------------------------------------------------------
                      (    forth6809.asm):04080         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04081         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04082         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04083         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04084         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04085         ;    Inputs:
                      (    forth6809.asm):04086         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04087         ;    Outputs:
                      (    forth6809.asm):04088         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04089         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04090         ;        scratch.
                      (    forth6809.asm):04091         ; ------------------------------------------------------------
E8D8 3706             (    forth6809.asm):04092         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E8DA DD26             (    forth6809.asm):04093                     STD   MSCR              ; MSCR = step
E8DC EC66             (    forth6809.asm):04094                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E8DE 262D             (    forth6809.asm):04095                     BNE   DPTEXIT           ; set: exit
E8E0 EC62             (    forth6809.asm):04096                     LDD   2,S               ; old index
E8E2 A364             (    forth6809.asm):04097                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E8E4 DD28             (    forth6809.asm):04098                     STD   MSCR2
E8E6 EC62             (    forth6809.asm):04099                     LDD   2,S
E8E8 D326             (    forth6809.asm):04100                     ADDD  MSCR              ; new_index = old_index + step
E8EA ED62             (    forth6809.asm):04101                     STD   2,S
E8EC A364             (    forth6809.asm):04102                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E8EE DD2A             (    forth6809.asm):04103                     STD   MSCR3
                      (    forth6809.asm):04104                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04105                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04106                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3

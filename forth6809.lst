                      (    forth6809.asm):01742         ; ------------------------------------------------------------
                      (    forth6809.asm):01743         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01744         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01745         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01746         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01747         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01748         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01749         ; flow control, not a chip feature.
                      (    forth6809.asm):01750         ; ------------------------------------------------------------
E035                  (    forth6809.asm):01751         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):01752                     CMPA #INHIWATER
                      (    forth6809.asm):01753                     BLO  RTSCHIDONE
                      (    forth6809.asm):01754                     TST  RTSSTATE

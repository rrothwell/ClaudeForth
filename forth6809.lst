E513 B7C009           (    forth6809.asm):04043                     STA   ACIADR
E516 39               (    forth6809.asm):04044                     RTS
                      (    forth6809.asm):04045         
E517 B6C008           (    forth6809.asm):04046         KEYQ:       LDA   ACIASR
E51A 8501             (    forth6809.asm):04047                     BITA  #SR_RDRF
E51C 2706             (    forth6809.asm):04048                     BEQ   KQFALSE
E51E CCFFFF           (    forth6809.asm):04049                     LDD   #TRUEV
E521 3606             (    forth6809.asm):04050                     PSHU  D
E523 39               (    forth6809.asm):04051                     RTS
E524 CC0000           (    forth6809.asm):04052         KQFALSE:    LDD   #FALSEV
E527 3606             (    forth6809.asm):04053                     PSHU  D

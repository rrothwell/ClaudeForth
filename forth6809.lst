                      (   unit_tests.asm):04597         ; Table-driven helper for the one-double-in tests (D0=, D0<, D2*,
                      (   unit_tests.asm):04598         ; D2/). Each table row is 4 cells: input low, input high, expected
                      (   unit_tests.asm):04599         ; (for mode 0, low then high; for mode 1, the flag then an unused
                      (   unit_tests.asm):04600         ; cell). The word is called with a guard cell beneath its argument and
                      (   unit_tests.asm):04601         ; the data-stack depth is checked.
                      (   unit_tests.asm):04602         ; TSTDUN
                      (   unit_tests.asm):04603         ;    Inputs:
                      (   unit_tests.asm):04604         ;        RegX = table, RegY = xt of the word, RegB = number of rows,
                      (   unit_tests.asm):04605         ;        RegA = 0 if the word returns a double, 1 if it returns a flag
                      (   unit_tests.asm):04606         ;    Outputs:
                      (   unit_tests.asm):04607         ;        RegD = TRUEV if every row passed, otherwise FALSEV
                      (   unit_tests.asm):04608         ;    Registers: all changed. S frame: 0,S mode, 1,S rows left, 2,S row
                      (   unit_tests.asm):04609         ;        pointer, 4,S word.
                      (   unit_tests.asm):04610         ; ------------------------------------------------------------
C200                  (   unit_tests.asm):04611         TSTDUN:     PSHS  A,B,X,Y
C200                  (   unit_tests.asm):04612         TDULOOP:    LDX   2,S
                      (   unit_tests.asm):04613                     LDD   #TSTGUARD
                      (   unit_tests.asm):04614                     PSHU  D
                      (   unit_tests.asm):04615                     LDD   ,X
                      (   unit_tests.asm):04616                     PSHU  D                 ; low cell
                      (   unit_tests.asm):04617                     LDD   2,X
                      (   unit_tests.asm):04618                     PSHU  D                 ; high cell
                      (   unit_tests.asm):04619                     STU   TSTUB4
                      (   unit_tests.asm):04620                     LDY   4,S
                      (   unit_tests.asm):04621                     JSR   ,Y
                      (   unit_tests.asm):04622                     STU   TSTUAF
                      (   unit_tests.asm):04623                     LDX   2,S
                      (   unit_tests.asm):04624                     TST   ,S
                      (   unit_tests.asm):04625                     BNE   TDUFLAG
                      (   unit_tests.asm):04626                     PULU  D                 ; high cell of the result
                      (   unit_tests.asm):04627                     CMPD  6,X
                      (   unit_tests.asm):04628                     BNE   TDUFAIL
                      (   unit_tests.asm):04629                     PULU  D                 ; low cell
                      (   unit_tests.asm):04630                     CMPD  4,X
                      (   unit_tests.asm):04631                     BNE   TDUFAIL
                      (   unit_tests.asm):04632                     LDD   #0                ; two cells in, two out
                      (   unit_tests.asm):04633                     BRA   TDUDEPTH
C200                  (   unit_tests.asm):04634         TDUFLAG:    PULU  D
                      (   unit_tests.asm):04635                     CMPD  4,X
                      (   unit_tests.asm):04636                     BNE   TDUFAIL
                      (   unit_tests.asm):04637                     LDD   #-2               ; two cells in, one out
C200                  (   unit_tests.asm):04638         TDUDEPTH:   PSHS  D
                      (   unit_tests.asm):04639                     PULU  D                 ; the guard
                      (   unit_tests.asm):04640                     CMPD  #TSTGUARD
                      (   unit_tests.asm):04641                     BNE   TDUFAIL2
                      (   unit_tests.asm):04642                     LDD   TSTUB4
                      (   unit_tests.asm):04643                     SUBD  TSTUAF
                      (   unit_tests.asm):04644                     CMPD  ,S++
                      (   unit_tests.asm):04645                     BNE   TDUFAIL
                      (   unit_tests.asm):04646                     LDX   2,S
                      (   unit_tests.asm):04647                     LEAX  8,X
                      (   unit_tests.asm):04648                     STX   2,S
                      (   unit_tests.asm):04649                     DEC   1,S
                      (   unit_tests.asm):04650                     BNE   TDULOOP
                      (   unit_tests.asm):04651                     LDD   #TRUEV
                      (   unit_tests.asm):04652                     LEAS  6,S
                      (   unit_tests.asm):04653                     RTS
C200                  (   unit_tests.asm):04654         TDUFAIL2:   LEAS  2,S
C200                  (   unit_tests.asm):04655         TDUFAIL:    LDD   #FALSEV
                      (   unit_tests.asm):04656                     LEAS  6,S
                      (   unit_tests.asm):04657                     RTS
                      (   unit_tests.asm):04658         
                      (   unit_tests.asm):04659         

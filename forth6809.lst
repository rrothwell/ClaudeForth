                      (    forth6809.asm):06779         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):06780         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):06781         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):06782         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):06783         ; (off-by-one, wrong direction, wrong starting value) would
                      (    forth6809.asm):06784         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (    forth6809.asm):06785         ; just "some number of iterations happened."
                      (    forth6809.asm):06786         ;
                      (    forth6809.asm):06787         ; The documented limit=index edge case (runs at least once) is
                      (    forth6809.asm):06788         ; deliberately NOT tested here: traced precisely (simulated the
                      (    forth6809.asm):06789         ; real DOTEST increment-and-compare-equal logic) and confirmed
                      (    forth6809.asm):06790         ; it takes a full 65536 iterations to naturally reconverge on
                      (    forth6809.asm):06791         ; equality, not one - true to the letter of "at least once" but
                      (    forth6809.asm):06792         ; impractical for a boot-time self-check. Left untested, not
                      (    forth6809.asm):06793         ; guessed at; noted in the open-items checklist.
                      (    forth6809.asm):06794         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):06795         TSTDOLP: LDD   CODEHERE
                      (    forth6809.asm):06796                  STD   TSTCSAV
                      (    forth6809.asm):06797                  LDD   #TSTCBUF
                      (    forth6809.asm):06798                  STD   CODEHERE
                      (    forth6809.asm):06799         
                      (    forth6809.asm):06800                  JSR   DO
                      (    forth6809.asm):06801         

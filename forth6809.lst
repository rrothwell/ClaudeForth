                      (    forth6809.asm):05861         
                      (    forth6809.asm):05862         ; ------------------------------------------------------------
                      (    forth6809.asm):05863         ; TRUE / FALSE - CONSTANT TRUE -1 / CONSTANT FALSE 0. The first
                      (    forth6809.asm):05864         ; CONSTANT-pattern ROM-resident words in this system: every
                      (    forth6809.asm):05865         ; other ROM word's CFA is a plain code label (a real routine),
                      (    forth6809.asm):05866         ; but a CONSTANT's CFA is the DODOES trampoline pattern (JSR
                      (    forth6809.asm):05867         ; DODOES + FDB ATSIGN + FDB <value-cell-address>), matching
                      (    forth6809.asm):05868         ; exactly what interactive CONSTANT compiles at runtime - the
                      (    forth6809.asm):05869         ; only difference is the value-cell address is a fixed, known-
                      (    forth6809.asm):05870         ; at-assemble-time label here (TRUEVAL/FALSEVAL) rather than a
                      (    forth6809.asm):05871         ; CODEHERE snapshot captured dynamically. DODOES pushes the
                      (    forth6809.asm):05872         ; value stored at the PFA field (the address in TRUEVAL/
                      (    forth6809.asm):05873         ; FALSEVAL); ATSIGN then fetches through that address, yielding
                      (    forth6809.asm):05874         ; the actual -1 / 0 - the same indirection interactive CONSTANT
                      (    forth6809.asm):05875         ; relies on, just with fixed addresses instead of a runtime one.
                      (    forth6809.asm):05876         ; ------------------------------------------------------------
FF72 BDE177           (    forth6809.asm):05877         TRUEBODY:  JSR   DODOES
FF75 E304             (    forth6809.asm):05878                    FDB   ATSIGN
FF77 FF79             (    forth6809.asm):05879                    FDB   TRUEVAL
FF79 FFFF             (    forth6809.asm):05880         TRUEVAL:   FDB   -1
                      (    forth6809.asm):05881         
FF7B BDE177           (    forth6809.asm):05882         FALSEBODY: JSR   DODOES
FF7E E304             (    forth6809.asm):05883                    FDB   ATSIGN
FF80 FF82             (    forth6809.asm):05884                    FDB   FALSEVAL
FF82 0000             (    forth6809.asm):05885         FALSEVAL:  FDB   0
                      (    forth6809.asm):05886         

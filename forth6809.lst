                      (    forth6809.asm):02471         
CF9A F6017A           (    forth6809.asm):02472         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
CF9D F10179           (    forth6809.asm):02473                     CMPB  OUTHEAD

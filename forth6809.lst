E441 9F23             (    forth6809.asm):03674         NQNOSIGN2: STX  NADDR
E443 4F               (    forth6809.asm):03675                   CLRA
E444 D621             (    forth6809.asm):03676                   LDB   CNTREM
E446 DD25             (    forth6809.asm):03677                   STD   NCNT
E448 CC0000           (    forth6809.asm):03678                   LDD   #0
E44B DD74             (    forth6809.asm):03679                   STD   UDHI
E44D DD76             (    forth6809.asm):03680                   STD   UDLO
                      (    forth6809.asm):03681         
E44F BDE3BB           (    forth6809.asm):03682                   JSR   NUMLOOP
                      (    forth6809.asm):03683         
E452 DC25             (    forth6809.asm):03684                   LDD   NCNT
E454 2641             (    forth6809.asm):03685                   BNE   NQBAD
                      (    forth6809.asm):03686         
                      (    forth6809.asm):03687                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03688                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03689                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03690                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03691                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03692                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03693                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03694                   ; high cell.
E456 0D22             (    forth6809.asm):03695                   TST   NUMNEG
E458 2718             (    forth6809.asm):03696                   BEQ   NQPOS32
E45A DC76             (    forth6809.asm):03697                   LDD   UDLO
E45C 43               (    forth6809.asm):03698                   COMA
E45D 53               (    forth6809.asm):03699                   COMB
E45E C30001           (    forth6809.asm):03700                   ADDD  #1
E461 DD76             (    forth6809.asm):03701                   STD   UDLO
E463 3401             (    forth6809.asm):03702                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03703                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03704                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03705                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03706                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03707                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03708                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03709                                      ; making the high-cell increment run
                      (    forth6809.asm):03710                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03711                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03712                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03713                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03714                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03715                                      ; matching "always increment" rather than
                      (    forth6809.asm):03716                                      ; "increment only on genuine carry".
E465 DC74             (    forth6809.asm):03717                   LDD   UDHI
E467 43               (    forth6809.asm):03718                   COMA
E468 53               (    forth6809.asm):03719                   COMB
E469 3501             (    forth6809.asm):03720                   PULS  CC          ; restore the TRUE carry
E46B 2403             (    forth6809.asm):03721                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03722                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03723                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03724                                      ; value was computed in D but never
                      (    forth6809.asm):03725                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03726                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03727                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03728                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03729                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03730                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03731                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03732                                      ; alone would have made this second,
                      (    forth6809.asm):03733                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03734                                      ; only past the "+1", never past the
                      (    forth6809.asm):03735                                      ; store itself - the store always runs,
                      (    forth6809.asm):03736                                      ; either way.
E46D C30001           (    forth6809.asm):03737                   ADDD  #1
E470 DD74             (    forth6809.asm):03738         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03739         
E472                  (    forth6809.asm):03740         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03741                   ; was '.' - determines which return convention to use
E472 9E1F             (    forth6809.asm):03742                   LDX   CADDR
E474 E684             (    forth6809.asm):03743                   LDB   ,X
E476 5A               (    forth6809.asm):03744                   DECB
E477 3001             (    forth6809.asm):03745                   LEAX  1,X
E479 A685             (    forth6809.asm):03746                   LDA   B,X
E47B 812E             (    forth6809.asm):03747                   CMPA  #'.'
E47D 260E             (    forth6809.asm):03748                   BNE   NQSINGLE
                      (    forth6809.asm):03749         
                      (    forth6809.asm):03750                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03751                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03752                   ; apart without needing a separate flag of its own either
E47F DC76             (    forth6809.asm):03753                   LDD   UDLO
E481 3606             (    forth6809.asm):03754                   PSHU  D
E483 DC74             (    forth6809.asm):03755                   LDD   UDHI
E485 3606             (    forth6809.asm):03756                   PSHU  D
E487 CC0001           (    forth6809.asm):03757                   LDD   #1
E48A 3606             (    forth6809.asm):03758                   PSHU  D
E48C 39               (    forth6809.asm):03759                   RTS
                      (    forth6809.asm):03760         
E48D                  (    forth6809.asm):03761         NQSINGLE: ; SINGLE success - unchanged from the original convention
E48D DC76             (    forth6809.asm):03762                   LDD   UDLO
E48F 3606             (    forth6809.asm):03763                   PSHU  D
E491 CCFFFF           (    forth6809.asm):03764                   LDD   #-1
E494 3606             (    forth6809.asm):03765                   PSHU  D
E496 39               (    forth6809.asm):03766                   RTS
                      (    forth6809.asm):03767         
E497 9E1F             (    forth6809.asm):03768         NQBAD:    LDX   CADDR
E499 3610             (    forth6809.asm):03769                   PSHU  X
E49B CC0000           (    forth6809.asm):03770                   LDD   #0
E49E 3606             (    forth6809.asm):03771                   PSHU  D
E4A0 39               (    forth6809.asm):03772                   RTS
                      (    forth6809.asm):03773         
                      (    forth6809.asm):03774         ; ============================================================
                      (    forth6809.asm):03775         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03776         ; ============================================================
                      (    forth6809.asm):03777                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E4A1                  (    forth6809.asm):03778         X_KEY:     LDA   INHEAD
                      (    forth6809.asm):03779                  CMPA  INTAIL
                      (    forth6809.asm):03780                  BEQ   KEY
                      (    forth6809.asm):03781                  LDX   #INBUF
                      (    forth6809.asm):03782                  LDB   INTAIL
                      (    forth6809.asm):03783                  LDA   B,X
                      (    forth6809.asm):03784                  INCB
                      (    forth6809.asm):03785                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):03786                  STB   INTAIL
                      (    forth6809.asm):03787                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03788                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03789                                         ; this needs no dedicated scratch global
                      (    forth6809.asm):03790                  JSR   RTSCHECKLO
                      (    forth6809.asm):03791                  PULS  A
                      (    forth6809.asm):03792                  TFR   A,B
                      (    forth6809.asm):03793                  CLRA
                      (    forth6809.asm):03794                  PSHU  D
                      (    forth6809.asm):03795                  RTS
                      (    forth6809.asm):03796         
                      (    forth6809.asm):03797         ; ------------------------------------------------------------
                      (    forth6809.asm):03798         ; KEY ( -- char )
                      (    forth6809.asm):03799         ; ------------------------------------------------------------
E4A1                  (    forth6809.asm):03800         KEY:
                      (    forth6809.asm):03801         
                      (    forth6809.asm):03802                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03803                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03804         
                      (    forth6809.asm):03805                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03806                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03807                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03808                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03809                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03810                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03811                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03812                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03813                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03814                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03815                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03816                                             ; by transmitting all chars.
                      (    forth6809.asm):03817         
E4A1                  (    forth6809.asm):03818         TRY_READ:
                      (    forth6809.asm):03819                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03820                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03821                                             ; while still transmitting!
                      (    forth6809.asm):03822                 
                      (    forth6809.asm):03823                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03824                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03825                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03826         
                      (    forth6809.asm):03827                     RTS                     
                      (    forth6809.asm):03828         
                      (    forth6809.asm):03829         ; ------------------------------------------------------------
                      (    forth6809.asm):03830         ; KEY? ( -- flag )
                      (    forth6809.asm):03831         ; ------------------------------------------------------------
E4A1                  (    forth6809.asm):03832         KEYQ:  
                      (    forth6809.asm):03833                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03834         
                      (    forth6809.asm):03835                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03836                     CMPA  INTAIL
                      (    forth6809.asm):03837         
                      (    forth6809.asm):03838                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03839         
                      (    forth6809.asm):03840                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03841         
                      (    forth6809.asm):03842                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03843                     PSHU  D
                      (    forth6809.asm):03844         
                      (    forth6809.asm):03845                     RTS
                      (    forth6809.asm):03846         
E4A1                  (    forth6809.asm):03847         KQTRUE:     
                      (    forth6809.asm):03848                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03849                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03850                     RTS
                      (    forth6809.asm):03851         ; ------------------------------------------------------------
                      (    forth6809.asm):03852         ; EMIT  ( char -- )
                      (    forth6809.asm):03853         ; ------------------------------------------------------------
                      (    forth6809.asm):03854         
E4A1                  (    forth6809.asm):03855         X_EMIT:    PULU  D
                      (    forth6809.asm):03856                  STB   EMITCH
E4A1                  (    forth6809.asm):03857         EMITWT:  LDB   OUTHEAD
                      (    forth6809.asm):03858                  INCB
                      (    forth6809.asm):03859                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03860                  CMPB  OUTTAIL
                      (    forth6809.asm):03861                  BEQ   EMITWT
                      (    forth6809.asm):03862                  LDX   #OUTBUF
                      (    forth6809.asm):03863                  LDB   OUTHEAD
                      (    forth6809.asm):03864                  LDA   EMITCH
                      (    forth6809.asm):03865                  STA   B,X
                      (    forth6809.asm):03866                  INCB
                      (    forth6809.asm):03867                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03868                  STB   OUTHEAD
                      (    forth6809.asm):03869                  TST   RTSSTATE
                      (    forth6809.asm):03870                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03871                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03872                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03873                                         ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03874                  LDA   #CR_RXTX
                      (    forth6809.asm):03875                  STA   ACIACR
E4A1                  (    forth6809.asm):03876         EMITNORTS: RTS
                      (    forth6809.asm):03877         
E4A1                  (    forth6809.asm):03878         EMIT:
                      (    forth6809.asm):03879                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03880                     TFR   B,A               
                      (    forth6809.asm):03881                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03882                     RTS                     
                      (    forth6809.asm):03883         
                      (    forth6809.asm):03884                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):03885         ; ------------------------------------------------------------
                      (    forth6809.asm):03886         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03887         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03888         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03889         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03890         ; directly against ACIASR.
                      (    forth6809.asm):03891         ;
                      (    forth6809.asm):03892         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03893         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03894         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03895         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03896         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03897         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03898         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03899         ; ------------------------------------------------------------
E4A1                  (    forth6809.asm):03900         KEY:
E4A1 B6C008           (    forth6809.asm):03901                  LDA   ACIASR
E4A4 8501             (    forth6809.asm):03902                  BITA  #SR_RDRF
E4A6 2705             (    forth6809.asm):03903                  BEQ   KWAIT
E4A8 7C017F           (    forth6809.asm):03904                  INC   POLLREADYCNT   ; character was already queued when we
E4AB 2007             (    forth6809.asm):03905                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E4AD                  (    forth6809.asm):03906         KWAIT:
E4AD B6C008           (    forth6809.asm):03907         KSPIN:   LDA   ACIASR
E4B0 8501             (    forth6809.asm):03908                  BITA  #SR_RDRF
E4B2 27F9             (    forth6809.asm):03909                  BEQ   KSPIN
E4B4                  (    forth6809.asm):03910         KGOTSTAT:                     ; A holds the status byte exactly as it was
                      (    forth6809.asm):03911                                        ; when RDRF first went true - check the
                      (    forth6809.asm):03912                                        ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03913                                        ; read, since reading ACIADR below clears
                      (    forth6809.asm):03914                                        ; RDRF and the latched error bits together
E4B4 8570             (    forth6809.asm):03915                  BITA  #SR_FE+SR_OVRN+SR_PE
E4B6 2715             (    forth6809.asm):03916                  BEQ   KGETCH
E4B8 8510             (    forth6809.asm):03917                  BITA  #SR_FE
E4BA 2703             (    forth6809.asm):03918                  BEQ   KXFE
E4BC 7C017C           (    forth6809.asm):03919                  INC   FECOUNT
E4BF 8520             (    forth6809.asm):03920         KXFE:    BITA  #SR_OVRN
E4C1 2703             (    forth6809.asm):03921                  BEQ   KXOVRN
E4C3 7C017D           (    forth6809.asm):03922                  INC   OVRNCOUNT
E4C6 8540             (    forth6809.asm):03923         KXOVRN:  BITA  #SR_PE
E4C8 2703             (    forth6809.asm):03924                  BEQ   KGETCH
E4CA 7C017E           (    forth6809.asm):03925                  INC   PECOUNT
E4CD B6C009           (    forth6809.asm):03926         KGETCH:  LDA   ACIADR
E4D0 1F89             (    forth6809.asm):03927                  TFR   A,B
E4D2 4F               (    forth6809.asm):03928                  CLRA
E4D3 3606             (    forth6809.asm):03929                  PSHU  D
E4D5 39               (    forth6809.asm):03930                  RTS
                      (    forth6809.asm):03931         
                      (    forth6809.asm):03932         ; ------------------------------------------------------------
                      (    forth6809.asm):03933         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):03934         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):03935         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):03936         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):03937         ; either is safe to call from ACCEPT at any point without
                      (    forth6809.asm):03938         ; disturbing whatever's on U. See ACCEPT for where these are
                      (    forth6809.asm):03939         ; called: XON at the start of every line (the host may stream
                      (    forth6809.asm):03940         ; characters continuously while ACCEPT's own tight loop is
                      (    forth6809.asm):03941         ; polling), XOFF the instant a line is complete (CR seen), before
                      (    forth6809.asm):03942         ; handing off to INTERPRET/compilation - which does arbitrary,
                      (    forth6809.asm):03943         ; variable-length work with KEY never polled at all, exactly the
                      (    forth6809.asm):03944         ; window where a host that kept sending would build up a backlog
                      (    forth6809.asm):03945         ; this polling build (with no ring buffer to hold it) has no way
                      (    forth6809.asm):03946         ; to recover from correctly.
                      (    forth6809.asm):03947         ; ------------------------------------------------------------
E4D6 8613             (    forth6809.asm):03948         PUTXOFF: LDA   #XOFFCH
E4D8 2002             (    forth6809.asm):03949                  BRA   PUTXCH
E4DA 8611             (    forth6809.asm):03950         PUTXON:  LDA   #XONCH
E4DC 3402             (    forth6809.asm):03951         PUTXCH:  PSHS  A
E4DE F6C008           (    forth6809.asm):03952         PXWT:    LDB   ACIASR
E4E1 C502             (    forth6809.asm):03953                  BITB  #SR_TDRE
E4E3 27F9             (    forth6809.asm):03954                  BEQ   PXWT
E4E5 3502             (    forth6809.asm):03955                  PULS  A
E4E7 B7C009           (    forth6809.asm):03956                  STA   ACIADR
E4EA 39               (    forth6809.asm):03957                  RTS
                      (    forth6809.asm):03958         
E4EB B6C008           (    forth6809.asm):03959         KEYQ:    LDA   ACIASR
E4EE 8501             (    forth6809.asm):03960                  BITA  #SR_RDRF
E4F0 2706             (    forth6809.asm):03961                  BEQ   KQFALSE
E4F2 CCFFFF           (    forth6809.asm):03962                  LDD   #TRUEV
E4F5 3606             (    forth6809.asm):03963                  PSHU  D
E4F7 39               (    forth6809.asm):03964                  RTS
E4F8 CC0000           (    forth6809.asm):03965         KQFALSE: LDD   #FALSEV
E4FB 3606             (    forth6809.asm):03966                  PSHU  D
E4FD 39               (    forth6809.asm):03967                  RTS
                      (    forth6809.asm):03968         
E4FE 3706             (    forth6809.asm):03969         EMIT:    PULU  D
E500 D73C             (    forth6809.asm):03970                  STB   EMITCH
E502 B6C008           (    forth6809.asm):03971         EMITWT:  LDA   ACIASR
E505 8502             (    forth6809.asm):03972                  BITA  #SR_TDRE
E507 27F9             (    forth6809.asm):03973                  BEQ   EMITWT
E509 963C             (    forth6809.asm):03974                  LDA   EMITCH
E50B B7C009           (    forth6809.asm):03975                  STA   ACIADR
E50E 39               (    forth6809.asm):03976                  RTS
                      (    forth6809.asm):03977         
                      (    forth6809.asm):03978                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):03979         
E50F 3706             (    forth6809.asm):03980         ACCEPT:  PULU  D
E511 DD35             (    forth6809.asm):03981                  STD   AMAX
E513 3706             (    forth6809.asm):03982                  PULU  D
E515 DD37             (    forth6809.asm):03983                  STD   ABUFP
E517 CC0000           (    forth6809.asm):03984                  LDD   #0
E51A DD39             (    forth6809.asm):03985                  STD   ACNT
                      (    forth6809.asm):03986         
                      (    forth6809.asm):03987                  IFEQ  SERIALPOLL  ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03988                                     ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03989                                     ; covers this, nothing extra needed
                      (    forth6809.asm):03990                  ELSE  ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03991                                       ; stream this line's characters
E51C BDE4DA           (    forth6809.asm):03992                  JSR   PUTXON
                      (    forth6809.asm):03993                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):03994         
E51F BDE4A1           (    forth6809.asm):03995         ALOOP:   JSR   KEY
E522 3706             (    forth6809.asm):03996                  PULU  D
E524 D73B             (    forth6809.asm):03997                  STB   ACH
                      (    forth6809.asm):03998         
E526 C10D             (    forth6809.asm):03999                  CMPB  #13
E528 274F             (    forth6809.asm):04000                  BEQ   ADONE
E52A C10A             (    forth6809.asm):04001                  CMPB  #10
E52C 27F1             (    forth6809.asm):04002                  BEQ   ALOOP
E52E C108             (    forth6809.asm):04003                  CMPB  #8
E530 2724             (    forth6809.asm):04004                  BEQ   ABKSP
E532 C17F             (    forth6809.asm):04005                  CMPB  #127
E534 2720             (    forth6809.asm):04006                  BEQ   ABKSP
                      (    forth6809.asm):04007         
E536 DC39             (    forth6809.asm):04008                  LDD   ACNT
E538 109335           (    forth6809.asm):04009                  CMPD  AMAX

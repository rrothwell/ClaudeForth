                      (    forth6809.asm):02689                    JSR   TSTSLMOD
                      (    forth6809.asm):02690                    JSR   TSTSLMODZ
                      (    forth6809.asm):02691                    JSR   TSTNEGATE
                      (    forth6809.asm):02692                    JSR   TSTABS1

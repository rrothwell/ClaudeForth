                      (    forth6809.asm):03873         
                      (    forth6809.asm):03874         ; ============================================================
                      (    forth6809.asm):03875         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):03876         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):03877         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):03878         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):03879         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):03880         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):03881         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):03882         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):03883         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):03884         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):03885         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):03886         ; they no longer need indirection.
                      (    forth6809.asm):03887         ;
                      (    forth6809.asm):03888         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):03889         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):03890         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):03891         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):03892         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):03893         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):03894         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):03895         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):03896         ;
                      (    forth6809.asm):03897         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):03898         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):03899         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):03900         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):03901         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):03902         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):03903         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):03904         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):03905         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):03906         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):03907         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):03908         ;
                      (    forth6809.asm):03909         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):03910         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):03911         ;
                      (    forth6809.asm):03912         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):03913         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):03914         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):03915         ; ============================================================

                      (    forth6809.asm):01943         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):01944         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):01945         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01946         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01947         ; simultaneously (see CR_RTSHI's comment).

DE45 CC0020           (    forth6809.asm):05682         BLW:        LDD   #32
DE48 3606             (    forth6809.asm):05683                     PSHU  D                 ; char
DE4A 39               (    forth6809.asm):05684                     RTS
                      (    forth6809.asm):05685         
                      (    forth6809.asm):05686         ; ------------------------------------------------------------
                      (    forth6809.asm):05687         ; >IN  ( -- a-addr )

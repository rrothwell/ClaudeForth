                      (    forth6809.asm):09771                   BRA  TK1DONE
C26F                  (    forth6809.asm):09772         TK1FAIL:  LDD  #FALSEV
C26F                  (    forth6809.asm):09773         TK1DONE:  LDX  #TSTTICK1NAME
                      (    forth6809.asm):09774                   PSHU X
                      (    forth6809.asm):09775                   PSHU D
                      (    forth6809.asm):09776                   JSR  TSTREPORT
                      (    forth6809.asm):09777         
                      (    forth6809.asm):09778                   LDU  TSTU0
                      (    forth6809.asm):09779                   RTS
                      (    forth6809.asm):09780         

                      (    forth6809.asm):07077         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07078         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07079         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07080         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07081         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07082         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07083         ; ============================================================
                      (    forth6809.asm):07084         ; ------------------------------------------------------------
                      (    forth6809.asm):07085         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07086         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07087         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07088         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07089         ; - no indirection, no value cell.
                      (    forth6809.asm):07090         ;
                      (    forth6809.asm):07091         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07092         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07093         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07094         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07095         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07096         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07097         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07098         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07099         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07100         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07101         ; ------------------------------------------------------------
FF77 CCFFFF           (    forth6809.asm):07102         TRUEBODY:  LDD   #$FFFF
FF7A 3606             (    forth6809.asm):07103                    PSHU  D
FF7C 39               (    forth6809.asm):07104                    RTS
                      (    forth6809.asm):07105         
FF7D CC0000           (    forth6809.asm):07106         FALSEBODY: LDD   #$0000
FF80 3606             (    forth6809.asm):07107                    PSHU  D
FF82 39               (    forth6809.asm):07108                    RTS
                      (    forth6809.asm):07109         
                      (    forth6809.asm):07110         ; ------------------------------------------------------------
                      (    forth6809.asm):07111         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07112         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07113         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07114         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07115         ; ------------------------------------------------------------
FF83 CC0001           (    forth6809.asm):07116         ONEBODY:   LDD   #1
FF86 3606             (    forth6809.asm):07117                    PSHU  D
FF88 39               (    forth6809.asm):07118                    RTS
                      (    forth6809.asm):07119         
FF89 CCFFFF           (    forth6809.asm):07120         MONEBODY:  LDD   #-1
FF8C 3606             (    forth6809.asm):07121                    PSHU  D
FF8E 39               (    forth6809.asm):07122                    RTS
                      (    forth6809.asm):07123         
FF8F CC0002           (    forth6809.asm):07124         TWOBODY:   LDD   #2
FF92 3606             (    forth6809.asm):07125                    PSHU  D
FF94 39               (    forth6809.asm):07126                    RTS
                      (    forth6809.asm):07127         
FF95 CCFFFE           (    forth6809.asm):07128         MTWOBODY:  LDD   #-2
FF98 3606             (    forth6809.asm):07129                    PSHU  D
FF9A 39               (    forth6809.asm):07130                    RTS
                      (    forth6809.asm):07131         
                      (    forth6809.asm):07132         ; Verify no collision with init code,
                      (    forth6809.asm):07133         ; value should match ORG INITCODE.
     FF9B             (    forth6809.asm):07134         BASECODEEND  EQU   *
     213D             (    forth6809.asm):07135         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07136         

                      (    forth6809.asm):06418         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06419         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):06420         ; ------------------------------------------------------------
F385 ECC4             (    forth6809.asm):06421         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F387 2713             (    forth6809.asm):06422                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F389 AE44             (    forth6809.asm):06423                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2

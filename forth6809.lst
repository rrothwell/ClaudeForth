                      (    forth6809.asm):15320         ; TSTHANDLERSAVE - unit test verifying CATCH correctly restores
                      (    forth6809.asm):15321         ; HANDLER afterward, on both paths - the success path (wrapping
                      (    forth6809.asm):15322         ; DUP) and the throw path (wrapping TSTTHROWHLP again). Confirms
                      (    forth6809.asm):15323         ; the documented "restores... HANDLER on either path" directly,
                      (    forth6809.asm):15324         ; by reading HANDLER itself before and after each call, rather
                      (    forth6809.asm):15325         ; than only inferring it from the stack-level behavior CATCH's
                      (    forth6809.asm):15326         ; other tests already cover.
                      (    forth6809.asm):15327         ; ------------------------------------------------------------
C305                  (    forth6809.asm):15328         TSTHANDLERSAVE: LDD  HANDLER
                      (    forth6809.asm):15329                         STD  TSTHANDSAV
                      (    forth6809.asm):15330         

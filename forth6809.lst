                      (    forth6809.asm):10744                     BNE  AQ1FAIL
                      (    forth6809.asm):10745         
                      (    forth6809.asm):10746                     LDD  TSTUB4
                      (    forth6809.asm):10747                     SUBD TSTUAF
                      (    forth6809.asm):10748                     CMPD #-2
                      (    forth6809.asm):10749                     BNE  AQ1FAIL
                      (    forth6809.asm):10750         
                      (    forth6809.asm):10751                     LDD  #TRUEV
                      (    forth6809.asm):10752                     BRA  AQ1DONE
C26F                  (    forth6809.asm):10753         AQ1FAIL:    LDD  #FALSEV
C26F                  (    forth6809.asm):10754         AQ1DONE:    LDX  #TSTAQ1NAME
                      (    forth6809.asm):10755                     PSHU X
                      (    forth6809.asm):10756                     PSHU D
                      (    forth6809.asm):10757                     JSR  TSTREPORT
                      (    forth6809.asm):10758         

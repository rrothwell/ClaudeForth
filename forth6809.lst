DD9D 7F017B           (    forth6809.asm):02215                     CLR   OUTACTIVITY
DDA0 BDDC3F           (    forth6809.asm):02216                     JSR   UPDATE_RTS
DDA3 3B               (    forth6809.asm):02217         IRQDONE3    RTI
                      (    forth6809.asm):02218         
                      (    forth6809.asm):02219                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02220         
DDA4                  (    forth6809.asm):02221         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02222                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02223                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02224                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02225                                             ; the other unused vectors below
                      (    forth6809.asm):02226                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02227         
                      (    forth6809.asm):02228         ; ------------------------------------------------------------
                      (    forth6809.asm):02229         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02230         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02231         ; ------------------------------------------------------------
DDA4 3B               (    forth6809.asm):02232         SWI3H:      RTI
DDA5 3B               (    forth6809.asm):02233         SWI2H:      RTI
DDA6 3B               (    forth6809.asm):02234         FIRQH:      RTI
DDA7 3B               (    forth6809.asm):02235         NMIH:       RTI                     ; unused now that NMI -> WARM
DDA8 CCFF9D           (    forth6809.asm):02236         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DDAB 3606             (    forth6809.asm):02237                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DDAD 7EE561           (    forth6809.asm):02238                     JMP   THROWW
                      (    forth6809.asm):02239         
                      (    forth6809.asm):02240         ; ============================================================
                      (    forth6809.asm):02241         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02242         ; ============================================================
                      (    forth6809.asm):02243         ; ------------------------------------------------------------
                      (    forth6809.asm):02244         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02245         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02246         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02247         ; COLD
                      (    forth6809.asm):02248         ;    Inputs:
                      (    forth6809.asm):02249         ;        none (entered at reset)
                      (    forth6809.asm):02250         ;    Outputs:
                      (    forth6809.asm):02251         ;        none (does not return)
                      (    forth6809.asm):02252         ;    Registers: all changed.
                      (    forth6809.asm):02253         ; ------------------------------------------------------------
DDB0 CC0240           (    forth6809.asm):02254         COLD:       LDD   #APPVARS
DDB3 DD0A             (    forth6809.asm):02255                     STD   VARHERE
DDB5 CC7000           (    forth6809.asm):02256                     LDD   #APPCODE
DDB8 DD08             (    forth6809.asm):02257                     STD   CODEHERE
DDBA CC2000           (    forth6809.asm):02258                     LDD   #APPDICT
DDBD DD06             (    forth6809.asm):02259                     STD   DPHERE
DDBF CCDBEA           (    forth6809.asm):02260                     LDD   #BASELATEST
DDC2 DD04             (    forth6809.asm):02261                     STD   LATEST
                      (    forth6809.asm):02262         
DDC4 CC000A           (    forth6809.asm):02263                     LDD   #10
DDC7 DD02             (    forth6809.asm):02264                     STD   BASE
                      (    forth6809.asm):02265         
DDC9 CC0106           (    forth6809.asm):02266                     LDD   #TIBBUF
DDCC DD39             (    forth6809.asm):02267                     STD   SRCADDR
DDCE CC0000           (    forth6809.asm):02268                     LDD   #0
DDD1 DD3B             (    forth6809.asm):02269                     STD   SRCLEN
DDD3 DD3D             (    forth6809.asm):02270                     STD   SRCID
                      (    forth6809.asm):02271         
DDD5 8EDE78           (    forth6809.asm):02272                     LDX   #SIGNON
DDD8 3610             (    forth6809.asm):02273                     PSHU  X                 ; c-addr
DDDA CC000F           (    forth6809.asm):02274                     LDD   #SIGNONL
DDDD 3606             (    forth6809.asm):02275                     PSHU  D                 ; u
DDDF BDF570           (    forth6809.asm):02276                     JSR   TYPEW
DDE2 BDFB6C           (    forth6809.asm):02277                     JSR   CRW
DDE5 2008             (    forth6809.asm):02278                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02279         
                      (    forth6809.asm):02280         ; ------------------------------------------------------------
                      (    forth6809.asm):02281         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02282         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02283         ; ------------------------------------------------------------
DDE7 CCFFFF           (    forth6809.asm):02284         ABORTW:     LDD   #-1
DDEA 3606             (    forth6809.asm):02285                     PSHU  D                 ; throw code (-1)
DDEC 7EE561           (    forth6809.asm):02286                     JMP   THROWW
                      (    forth6809.asm):02287         
                      (    forth6809.asm):02288         ; ------------------------------------------------------------
                      (    forth6809.asm):02289         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02290         ; ABORT
                      (    forth6809.asm):02291         ;    Inputs:
                      (    forth6809.asm):02292         ;        none
                      (    forth6809.asm):02293         ;    Outputs:
                      (    forth6809.asm):02294         ;        none (does not return)
                      (    forth6809.asm):02295         ;    Registers: RegU changed.
                      (    forth6809.asm):02296         ; ------------------------------------------------------------
DDEF CEBD00           (    forth6809.asm):02297         ABORT:      LDU   #SP0
                      (    forth6809.asm):02298                     ; falls through into QUIT
                      (    forth6809.asm):02299         
                      (    forth6809.asm):02300         ; ------------------------------------------------------------
                      (    forth6809.asm):02301         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02302         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02303         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02304         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02305         ; ------------------------------------------------------------
DDF2 10CEC000         (    forth6809.asm):02306         QUITW:      LDS   #RP0
DDF6 CC0000           (    forth6809.asm):02307                     LDD   #0
DDF9 DD00             (    forth6809.asm):02308                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02309         
DDFB BDE50C           (    forth6809.asm):02310         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02311         
DDFE DC06             (    forth6809.asm):02312                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
DE00 3406             (    forth6809.asm):02313                     PSHS  D                 ; and THROW restore S, so the frame is
DE02 DC08             (    forth6809.asm):02314                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
DE04 3406             (    forth6809.asm):02315                     PSHS  D                 ; See shadow QLOOP.2
DE06 DC0A             (    forth6809.asm):02316                     LDD   VARHERE
DE08 3406             (    forth6809.asm):02317                     PSHS  D
DE0A DC04             (    forth6809.asm):02318                     LDD   LATEST
DE0C 3406             (    forth6809.asm):02319                     PSHS  D
                      (    forth6809.asm):02320         
DE0E CCE220           (    forth6809.asm):02321                     LDD   #INTERPRET
DE11 3606             (    forth6809.asm):02322                     PSHU  D                 ; xt
DE13 BDE535           (    forth6809.asm):02323                     JSR   CATCHW
DE16 3706             (    forth6809.asm):02324                     PULU  D                 ; throw code (0 = no error)
DE18 3406             (    forth6809.asm):02325                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
DE1A 10830000         (    forth6809.asm):02326                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
DE1E 2740             (    forth6809.asm):02327                     BEQ   QOK
                      (    forth6809.asm):02328         
DE20 EC68             (    forth6809.asm):02329                     LDD   8,S
DE22 DD06             (    forth6809.asm):02330                     STD   DPHERE
DE24 EC66             (    forth6809.asm):02331                     LDD   6,S
DE26 DD08             (    forth6809.asm):02332                     STD   CODEHERE
DE28 EC64             (    forth6809.asm):02333                     LDD   4,S
DE2A DD0A             (    forth6809.asm):02334                     STD   VARHERE
DE2C EC62             (    forth6809.asm):02335                     LDD   2,S
DE2E DD04             (    forth6809.asm):02336                     STD   LATEST
DE30 CEBD00           (    forth6809.asm):02337                     LDU   #SP0
                      (    forth6809.asm):02338         
                      (    forth6809.asm):02339                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02340                     ; See bugfix: QLOOP.1
DE33 CC0000           (    forth6809.asm):02341                     LDD   #0
DE36 DD00             (    forth6809.asm):02342                     STD   STATE
                      (    forth6809.asm):02343         
DE38 ECE4             (    forth6809.asm):02344                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
DE3A 1083FFFF         (    forth6809.asm):02345                     CMPD  #-1
DE3E 2605             (    forth6809.asm):02346                     BNE   QSHOWERR
DE40 326A             (    forth6809.asm):02347                     LEAS  10,S              ; drop the frame
DE42 16FFB6           (    forth6809.asm):02348                     LBRA  QLOOP
                      (    forth6809.asm):02349         
DE45 BDFB6C           (    forth6809.asm):02350         QSHOWERR:   JSR   CRW
DE48 8EDE8B           (    forth6809.asm):02351                     LDX   #ERRMSG
DE4B 3610             (    forth6809.asm):02352                     PSHU  X                 ; c-addr
DE4D CC0008           (    forth6809.asm):02353                     LDD   #ERRMSGL
DE50 3606             (    forth6809.asm):02354                     PSHU  D                 ; u
DE52 BDF570           (    forth6809.asm):02355                     JSR   TYPEW
DE55 ECE4             (    forth6809.asm):02356                     LDD   ,S
DE57 3606             (    forth6809.asm):02357                     PSHU  D                 ; n
DE59 BDFA3B           (    forth6809.asm):02358                     JSR   DOTW
DE5C 326A             (    forth6809.asm):02359                     LEAS  10,S              ; drop the frame
DE5E 209B             (    forth6809.asm):02360                     BRA   QLOOP
                      (    forth6809.asm):02361         
DE60 326A             (    forth6809.asm):02362         QOK:        LEAS  10,S              ; drop the frame
DE62 BDFB6C           (    forth6809.asm):02363                     JSR   CRW               ; See bugfix: QOK.1
DE65 DC00             (    forth6809.asm):02364                     LDD   STATE
DE67 2692             (    forth6809.asm):02365                     BNE   QLOOP
DE69 8EDE87           (    forth6809.asm):02366                     LDX   #OKMSG
DE6C 3610             (    forth6809.asm):02367                     PSHU  X                 ; c-addr
DE6E CC0004           (    forth6809.asm):02368                     LDD   #OKMSGL
DE71 3606             (    forth6809.asm):02369                     PSHU  D                 ; u
DE73 BDF570           (    forth6809.asm):02370                     JSR   TYPEW
DE76 2083             (    forth6809.asm):02371                     BRA   QLOOP
                      (    forth6809.asm):02372         
DE78 3638303920464F52 (    forth6809.asm):02373         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02374         SIGNONL     EQU   *-SIGNON
DE87 20206F6B         (    forth6809.asm):02375         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02376         OKMSGL      EQU   *-OKMSG
DE8B 20204552524F5220 (    forth6809.asm):02377         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02378         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02379         
                      (    forth6809.asm):02380         ; ============================================================
                      (    forth6809.asm):02381         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02382         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02383         ; ============================================================
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02386         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02387         ; LIT   ( -- x )
                      (    forth6809.asm):02388         ;    Inputs:
                      (    forth6809.asm):02389         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02390         ;    Outputs:
                      (    forth6809.asm):02391         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02392         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02393         ; ------------------------------------------------------------
DE93 3510             (    forth6809.asm):02394         LIT:        PULS  X
DE95 EC81             (    forth6809.asm):02395                     LDD   ,X++
DE97 3606             (    forth6809.asm):02396                     PSHU  D                 ; x
DE99 3410             (    forth6809.asm):02397                     PSHS  X
DE9B 39               (    forth6809.asm):02398                     RTS
                      (    forth6809.asm):02399         
                      (    forth6809.asm):02400         ; ------------------------------------------------------------
                      (    forth6809.asm):02401         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02402         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02403         ; address.
                      (    forth6809.asm):02404         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02405         ;    Inputs:
                      (    forth6809.asm):02406         ;        flag on the data stack
                      (    forth6809.asm):02407         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02408         ;    Outputs:
                      (    forth6809.asm):02409         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02410         ;        the offset
                      (    forth6809.asm):02411         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02412         ; ------------------------------------------------------------
DE9C 3706             (    forth6809.asm):02413         ZBRANCH:    PULU  D                 ; flag
DE9E 3510             (    forth6809.asm):02414                     PULS  X
DEA0 10830000         (    forth6809.asm):02415                     CMPD  #0
DEA4 2607             (    forth6809.asm):02416                     BNE   ZSKIP
DEA6 EC84             (    forth6809.asm):02417                     LDD   ,X
DEA8 308B             (    forth6809.asm):02418                     LEAX  D,X
DEAA 3410             (    forth6809.asm):02419                     PSHS  X
DEAC 39               (    forth6809.asm):02420                     RTS
DEAD 3002             (    forth6809.asm):02421         ZSKIP:      LEAX  2,X
DEAF 3410             (    forth6809.asm):02422                     PSHS  X
DEB1 39               (    forth6809.asm):02423                     RTS
                      (    forth6809.asm):02424         
                      (    forth6809.asm):02425         ; ------------------------------------------------------------
                      (    forth6809.asm):02426         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02427         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02428         ; BRANCH
                      (    forth6809.asm):02429         ;    Inputs:
                      (    forth6809.asm):02430         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02431         ;    Outputs:
                      (    forth6809.asm):02432         ;        return address set to the branch target
                      (    forth6809.asm):02433         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02434         ; ------------------------------------------------------------
DEB2 3510             (    forth6809.asm):02435         BRANCH:     PULS  X
DEB4 EC84             (    forth6809.asm):02436                     LDD   ,X
DEB6 308B             (    forth6809.asm):02437                     LEAX  D,X
DEB8 3410             (    forth6809.asm):02438                     PSHS  X
DEBA 39               (    forth6809.asm):02439                     RTS
                      (    forth6809.asm):02440         
                      (    forth6809.asm):02441         ; ------------------------------------------------------------
                      (    forth6809.asm):02442         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02443         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02444         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02445         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02446         ;    Inputs:
                      (    forth6809.asm):02447         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02448         ;        trampoline
                      (    forth6809.asm):02449         ;    Outputs:
                      (    forth6809.asm):02450         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02451         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02452         ; ------------------------------------------------------------
DEBB 3510             (    forth6809.asm):02453         DODOES:     PULS  X
DEBD 10AE81           (    forth6809.asm):02454                     LDY   ,X++
DEC0 EC84             (    forth6809.asm):02455                     LDD   ,X
DEC2 3606             (    forth6809.asm):02456                     PSHU  D                 ; pfa
DEC4 6EA4             (    forth6809.asm):02457                     JMP   ,Y
                      (    forth6809.asm):02458         
                      (    forth6809.asm):02459         ; ------------------------------------------------------------
                      (    forth6809.asm):02460         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02461         ; field address on the stack.
                      (    forth6809.asm):02462         ; DOESRT0
                      (    forth6809.asm):02463         ;    Inputs:
                      (    forth6809.asm):02464         ;        none
                      (    forth6809.asm):02465         ;    Outputs:
                      (    forth6809.asm):02466         ;        none
                      (    forth6809.asm):02467         ;    Registers: none.
                      (    forth6809.asm):02468         ; ------------------------------------------------------------
DEC6 39               (    forth6809.asm):02469         DOESRT0:    RTS
                      (    forth6809.asm):02470         
                      (    forth6809.asm):02471         ; ------------------------------------------------------------
                      (    forth6809.asm):02472         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02473         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02474         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02475         ; SETDOES
                      (    forth6809.asm):02476         ;    Inputs:
                      (    forth6809.asm):02477         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02478         ;        BEHAVIOR)
                      (    forth6809.asm):02479         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02480         ;        address
                      (    forth6809.asm):02481         ;    Outputs:
                      (    forth6809.asm):02482         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02483         ;        defining word's caller
                      (    forth6809.asm):02484         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02485         ; ------------------------------------------------------------
DEC7 3510             (    forth6809.asm):02486         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DEC9 1F12             (    forth6809.asm):02487                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02488         
DECB 9E04             (    forth6809.asm):02489                     LDX   LATEST
DECD E684             (    forth6809.asm):02490                     LDB   ,X
DECF C41F             (    forth6809.asm):02491                     ANDB  #$1F
DED1 4F               (    forth6809.asm):02492                     CLRA
DED2 308B             (    forth6809.asm):02493                     LEAX  D,X               ; header + name length
DED4 EC03             (    forth6809.asm):02494                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
DED6 C30003           (    forth6809.asm):02495                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DED9 1F01             (    forth6809.asm):02496                     TFR   D,X
                      (    forth6809.asm):02497         
DEDB 10AF84           (    forth6809.asm):02498                     STY   ,X                ; patch it
                      (    forth6809.asm):02499         
DEDE 3510             (    forth6809.asm):02500                     PULS  X                 ; X = the OUTER defining word's own return addr
DEE0 6E84             (    forth6809.asm):02501                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02502         
                      (    forth6809.asm):02503         ; ------------------------------------------------------------
                      (    forth6809.asm):02504         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02505         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02506         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02507         ;    Inputs:
                      (    forth6809.asm):02508         ;        pfa on the data stack
                      (    forth6809.asm):02509         ;    Outputs:
                      (    forth6809.asm):02510         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02511         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02512         ; ------------------------------------------------------------
DEE2 3710             (    forth6809.asm):02513         DODEFER:    PULU  X                 ; pfa
DEE4 EC84             (    forth6809.asm):02514                     LDD   ,X
DEE6 1F01             (    forth6809.asm):02515                     TFR   D,X
DEE8 6E84             (    forth6809.asm):02516                     JMP   ,X
                      (    forth6809.asm):02517         
                      (    forth6809.asm):02518         ; ------------------------------------------------------------
                      (    forth6809.asm):02519         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02520         ; DOABORTUNDEF
                      (    forth6809.asm):02521         ;    Inputs:
                      (    forth6809.asm):02522         ;        none
                      (    forth6809.asm):02523         ;    Outputs:
                      (    forth6809.asm):02524         ;        none (does not return)
                      (    forth6809.asm):02525         ;    Registers: RegD changed.
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
DEEA                  (    forth6809.asm):02527         DOABORTUNDEF:
DEEA CCFFEB           (    forth6809.asm):02528                     LDD   #-21
DEED 3606             (    forth6809.asm):02529                     PSHU  D                 ; throw code (-21)
DEEF 7EE561           (    forth6809.asm):02530                     JMP   THROWW
                      (    forth6809.asm):02531         
                      (    forth6809.asm):02532         ; ------------------------------------------------------------
                      (    forth6809.asm):02533         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02534         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02535         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02536         ;    Inputs:
                      (    forth6809.asm):02537         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02538         ;    Outputs:
                      (    forth6809.asm):02539         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02540         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02541         ; ------------------------------------------------------------
DEF2 3710             (    forth6809.asm):02542         DOMARKER:   PULU  X                 ; pfa
DEF4 EC84             (    forth6809.asm):02543                     LDD   ,X
DEF6 DD06             (    forth6809.asm):02544                     STD   DPHERE
DEF8 EC02             (    forth6809.asm):02545                     LDD   2,X
DEFA DD08             (    forth6809.asm):02546                     STD   CODEHERE
DEFC EC04             (    forth6809.asm):02547                     LDD   4,X
DEFE DD0A             (    forth6809.asm):02548                     STD   VARHERE
DF00 EC06             (    forth6809.asm):02549                     LDD   6,X
DF02 DD04             (    forth6809.asm):02550                     STD   LATEST
DF04 39               (    forth6809.asm):02551                     RTS
                      (    forth6809.asm):02552         
                      (    forth6809.asm):02553         ; ------------------------------------------------------------
                      (    forth6809.asm):02554         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02555         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02556         ; ------------------------------------------------------------
DF05 3710             (    forth6809.asm):02557         EXECUTEW:   PULU  X                 ; xt
DF07 AD84             (    forth6809.asm):02558                     JSR   ,X
DF09 39               (    forth6809.asm):02559                     RTS
                      (    forth6809.asm):02560         
                      (    forth6809.asm):02561         ; ============================================================
                      (    forth6809.asm):02562         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02563         ; ============================================================
                      (    forth6809.asm):02564         ; ------------------------------------------------------------
                      (    forth6809.asm):02565         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02566         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02567         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02568         ;    Inputs:
                      (    forth6809.asm):02569         ;        RegX = address of the here pointer
                      (    forth6809.asm):02570         ;        x on the data stack
                      (    forth6809.asm):02571         ;    Outputs:
                      (    forth6809.asm):02572         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02573         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02574         ; ------------------------------------------------------------
DF0A 3706             (    forth6809.asm):02575         APPENDCELL: PULU  D                 ; x
DF0C 10AE84           (    forth6809.asm):02576                     LDY   ,X
DF0F EDA1             (    forth6809.asm):02577                     STD   ,Y++
DF11 10AF84           (    forth6809.asm):02578                     STY   ,X
DF14 39               (    forth6809.asm):02579                     RTS
                      (    forth6809.asm):02580         
                      (    forth6809.asm):02581         ; ------------------------------------------------------------
                      (    forth6809.asm):02582         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02583         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02584         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02585         ;    Inputs:
                      (    forth6809.asm):02586         ;        RegX = address of the here pointer
                      (    forth6809.asm):02587         ;        char on the data stack
                      (    forth6809.asm):02588         ;    Outputs:
                      (    forth6809.asm):02589         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02590         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02591         ; ------------------------------------------------------------
DF15 3706             (    forth6809.asm):02592         APPENDBYTE: PULU  D                 ; char
DF17 10AE84           (    forth6809.asm):02593                     LDY   ,X
DF1A E7A0             (    forth6809.asm):02594                     STB   ,Y+
DF1C 10AF84           (    forth6809.asm):02595                     STY   ,X
DF1F 39               (    forth6809.asm):02596                     RTS
                      (    forth6809.asm):02597         
                      (    forth6809.asm):02598         ; ------------------------------------------------------------
                      (    forth6809.asm):02599         ; ,  ( x -- )
                      (    forth6809.asm):02600         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02601         ; ------------------------------------------------------------
DF20 8E0008           (    forth6809.asm):02602         COMMAW:     LDX   #CODEHERE
DF23 7EDF0A           (    forth6809.asm):02603                     JMP   APPENDCELL
                      (    forth6809.asm):02604         
                      (    forth6809.asm):02605         ; ------------------------------------------------------------
                      (    forth6809.asm):02606         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02607         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02608         ; ------------------------------------------------------------
DF26 8E0008           (    forth6809.asm):02609         CODECOMMA:  LDX   #CODEHERE
DF29 7EDF0A           (    forth6809.asm):02610                     JMP   APPENDCELL
                      (    forth6809.asm):02611         
                      (    forth6809.asm):02612         ; ------------------------------------------------------------
                      (    forth6809.asm):02613         ; C,  ( char -- )
                      (    forth6809.asm):02614         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02615         ; ------------------------------------------------------------
DF2C 8E0008           (    forth6809.asm):02616         CCOMMAW:    LDX   #CODEHERE
DF2F 7EDF15           (    forth6809.asm):02617                     JMP   APPENDBYTE
                      (    forth6809.asm):02618         
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
                      (    forth6809.asm):02620         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02621         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02622         ; ------------------------------------------------------------
DF32 8E0008           (    forth6809.asm):02623         CCOMMA1:    LDX   #CODEHERE
DF35 7EDF15           (    forth6809.asm):02624                     JMP   APPENDBYTE
                      (    forth6809.asm):02625         
                      (    forth6809.asm):02626         ; ------------------------------------------------------------
                      (    forth6809.asm):02627         ; V,  ( x -- )
                      (    forth6809.asm):02628         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02629         ; ------------------------------------------------------------
DF38 8E000A           (    forth6809.asm):02630         VCOMMAW:    LDX   #VARHERE
DF3B 7EDF0A           (    forth6809.asm):02631                     JMP   APPENDCELL
                      (    forth6809.asm):02632         
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
                      (    forth6809.asm):02634         ; VC,  ( char -- )
                      (    forth6809.asm):02635         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02636         ; ------------------------------------------------------------
DF3E 8E000A           (    forth6809.asm):02637         VCCOMMAW:   LDX   #VARHERE
DF41 7EDF15           (    forth6809.asm):02638                     JMP   APPENDBYTE
                      (    forth6809.asm):02639         
                      (    forth6809.asm):02640         ; ------------------------------------------------------------
                      (    forth6809.asm):02641         ; ALLOT  ( n -- )
                      (    forth6809.asm):02642         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
DF44 3706             (    forth6809.asm):02644         ALLOTW:     PULU  D                 ; n
DF46 9E08             (    forth6809.asm):02645                     LDX   CODEHERE
DF48 308B             (    forth6809.asm):02646                     LEAX  D,X
DF4A 9F08             (    forth6809.asm):02647                     STX   CODEHERE
DF4C 39               (    forth6809.asm):02648                     RTS
                      (    forth6809.asm):02649         
                      (    forth6809.asm):02650         ; ------------------------------------------------------------
                      (    forth6809.asm):02651         ; VALLOT  ( n -- )
                      (    forth6809.asm):02652         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02653         ; ------------------------------------------------------------
DF4D 3706             (    forth6809.asm):02654         VALLOTW:    PULU  D                 ; n
DF4F 9E0A             (    forth6809.asm):02655                     LDX   VARHERE
DF51 308B             (    forth6809.asm):02656                     LEAX  D,X
DF53 9F0A             (    forth6809.asm):02657                     STX   VARHERE
DF55 39               (    forth6809.asm):02658                     RTS
                      (    forth6809.asm):02659         
                      (    forth6809.asm):02660         ; ------------------------------------------------------------
                      (    forth6809.asm):02661         ; HERE  ( -- addr )
                      (    forth6809.asm):02662         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02663         ; ------------------------------------------------------------
DF56 DC08             (    forth6809.asm):02664         HEREW:      LDD   CODEHERE
DF58 3606             (    forth6809.asm):02665                     PSHU  D                 ; addr
DF5A 39               (    forth6809.asm):02666                     RTS
                      (    forth6809.asm):02667         
                      (    forth6809.asm):02668         ; ------------------------------------------------------------
                      (    forth6809.asm):02669         ; VHERE  ( -- addr )
                      (    forth6809.asm):02670         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
DF5B DC0A             (    forth6809.asm):02672         VHEREW:     LDD   VARHERE
DF5D 3606             (    forth6809.asm):02673                     PSHU  D                 ; addr
DF5F 39               (    forth6809.asm):02674                     RTS
                      (    forth6809.asm):02675         
                      (    forth6809.asm):02676         ; ------------------------------------------------------------
                      (    forth6809.asm):02677         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02678         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02679         ; ------------------------------------------------------------
DF60 DC08             (    forth6809.asm):02680         PADW:       LDD   CODEHERE
DF62 C30080           (    forth6809.asm):02681                     ADDD  #PADOFFSET
DF65 3606             (    forth6809.asm):02682                     PSHU  D                 ; c-addr
DF67 39               (    forth6809.asm):02683                     RTS
                      (    forth6809.asm):02684         
                      (    forth6809.asm):02685         ; ------------------------------------------------------------
                      (    forth6809.asm):02686         ; UNUSED  ( -- u )
                      (    forth6809.asm):02687         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
DF68 CCB900           (    forth6809.asm):02689         UNUSEDW:    LDD   #CODETOP
DF6B 9308             (    forth6809.asm):02690                     SUBD  CODEHERE
DF6D 3606             (    forth6809.asm):02691                     PSHU  D                 ; u
DF6F 39               (    forth6809.asm):02692                     RTS
                      (    forth6809.asm):02693         
                      (    forth6809.asm):02694         ; ------------------------------------------------------------
                      (    forth6809.asm):02695         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02696         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02697         ; ------------------------------------------------------------
DF70 CC1FFF           (    forth6809.asm):02698         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DF73 930A             (    forth6809.asm):02699                     SUBD  VARHERE
DF75 3606             (    forth6809.asm):02700                     PSHU  D                 ; u
DF77 39               (    forth6809.asm):02701                     RTS
                      (    forth6809.asm):02702         
                      (    forth6809.asm):02703         ; ============================================================
                      (    forth6809.asm):02704         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02705         ; ============================================================
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02708         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02709         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02710         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02711         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02712         ;    Inputs:
                      (    forth6809.asm):02713         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02714         ;        name parsed from the input stream
                      (    forth6809.asm):02715         ;    Outputs:
                      (    forth6809.asm):02716         ;        header built at DPHERE; LATEST = address of the new header
                      (    forth6809.asm):02717         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
DF78 CC0020           (    forth6809.asm):02719         HEADER:     LDD   #32
DF7B 3606             (    forth6809.asm):02720                     PSHU  D
DF7D BDE2A0           (    forth6809.asm):02721                     JSR   WORDW
DF80 3710             (    forth6809.asm):02722                     PULU  X                 ; c-addr of the name
DF82 3706             (    forth6809.asm):02723                     PULU  D                 ; smudge flag in B
DF84 A680             (    forth6809.asm):02724                     LDA   ,X+               ; name length, X = name text
DF86 3402             (    forth6809.asm):02725                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
DF88 5D               (    forth6809.asm):02726                     TSTB
DF89 2702             (    forth6809.asm):02727                     BEQ   HDNOSM
DF8B 8A40             (    forth6809.asm):02728                     ORA   #$40
DF8D 109E06           (    forth6809.asm):02729         HDNOSM:     LDY   DPHERE
DF90 3420             (    forth6809.asm):02730                     PSHS  Y                 ; 0,S = address of the new header
DF92 A7A0             (    forth6809.asm):02731                     STA   ,Y+
DF94 E662             (    forth6809.asm):02732                     LDB   2,S
DF96 2707             (    forth6809.asm):02733                     BEQ   HDNONM
DF98 A680             (    forth6809.asm):02734         HDCPY:      LDA   ,X+
DF9A A7A0             (    forth6809.asm):02735                     STA   ,Y+
DF9C 5A               (    forth6809.asm):02736                     DECB
DF9D 26F9             (    forth6809.asm):02737                     BNE   HDCPY
DF9F DC04             (    forth6809.asm):02738         HDNONM:     LDD   LATEST
DFA1 EDA1             (    forth6809.asm):02739                     STD   ,Y++
DFA3 DC08             (    forth6809.asm):02740                     LDD   CODEHERE
DFA5 EDA1             (    forth6809.asm):02741                     STD   ,Y++
DFA7 109F06           (    forth6809.asm):02742                     STY   DPHERE
DFAA 3506             (    forth6809.asm):02743                     PULS  D
DFAC DD04             (    forth6809.asm):02744                     STD   LATEST
DFAE 3261             (    forth6809.asm):02745                     LEAS  1,S
DFB0 39               (    forth6809.asm):02746                     RTS
                      (    forth6809.asm):02747         
                      (    forth6809.asm):02748         ; ============================================================
                      (    forth6809.asm):02749         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02750         ; ============================================================
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
                      (    forth6809.asm):02752         ; :  ( "name" -- )
                      (    forth6809.asm):02753         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02754         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02755         ; CSP and enter compile state.
                      (    forth6809.asm):02756         ; ------------------------------------------------------------
DFB1 CCFFFF           (    forth6809.asm):02757         COLONW:     LDD   #TRUEV
DFB4 3606             (    forth6809.asm):02758                     PSHU  D
DFB6 BDDF78           (    forth6809.asm):02759                     JSR   HEADER
DFB9 DC08             (    forth6809.asm):02760                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DFBB DD1F             (    forth6809.asm):02761                     STD   CURXT             ; See bugfix: COLONW.1
DFBD 1F30             (    forth6809.asm):02762                     TFR   U,D
DFBF DD21             (    forth6809.asm):02763                     STD   CSP
DFC1 CCFFFF           (    forth6809.asm):02764                     LDD   #-1
DFC4 DD00             (    forth6809.asm):02765                     STD   STATE
DFC6 39               (    forth6809.asm):02766                     RTS
                      (    forth6809.asm):02767         
                      (    forth6809.asm):02768         ; ------------------------------------------------------------
                      (    forth6809.asm):02769         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02770         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02771         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02772         ; new word and return to interpret state.
                      (    forth6809.asm):02773         ; ------------------------------------------------------------
DFC7 CC0039           (    forth6809.asm):02774         SEMIW:      LDD   #RTSOPC
DFCA 3606             (    forth6809.asm):02775                     PSHU  D
DFCC BDDF32           (    forth6809.asm):02776                     JSR   CCOMMA1
DFCF 1F30             (    forth6809.asm):02777                     TFR   U,D
DFD1 109321           (    forth6809.asm):02778                     CMPD  CSP
DFD4 2703             (    forth6809.asm):02779                     BEQ   SEMIOK
DFD6 BDE52C           (    forth6809.asm):02780                     JSR   CFERR
DFD9 9E04             (    forth6809.asm):02781         SEMIOK:     LDX   LATEST
DFDB A684             (    forth6809.asm):02782                     LDA   ,X
DFDD 84BF             (    forth6809.asm):02783                     ANDA  #$BF
DFDF A784             (    forth6809.asm):02784                     STA   ,X
DFE1 CC0000           (    forth6809.asm):02785                     LDD   #0
DFE4 DD00             (    forth6809.asm):02786                     STD   STATE
DFE6 39               (    forth6809.asm):02787                     RTS
                      (    forth6809.asm):02788         
                      (    forth6809.asm):02789         ; ------------------------------------------------------------
                      (    forth6809.asm):02790         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02791         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02792         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02793         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02794         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02795         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02796         ; ------------------------------------------------------------
DFE7 DC08             (    forth6809.asm):02797         NONAMEW:    LDD   CODEHERE
DFE9 3606             (    forth6809.asm):02798                     PSHU  D                 ; xt
DFEB DD1F             (    forth6809.asm):02799                     STD   CURXT             ; See bugfix: NONAMEW.1
DFED 1F30             (    forth6809.asm):02800                     TFR   U,D
DFEF DD21             (    forth6809.asm):02801                     STD   CSP
DFF1 CCFFFF           (    forth6809.asm):02802                     LDD   #-1
DFF4 DD00             (    forth6809.asm):02803                     STD   STATE
DFF6 39               (    forth6809.asm):02804                     RTS
                      (    forth6809.asm):02805         
                      (    forth6809.asm):02806         ; ------------------------------------------------------------
                      (    forth6809.asm):02807         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02808         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02809         ; BLDDOES
                      (    forth6809.asm):02810         ;    Inputs:
                      (    forth6809.asm):02811         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02812         ;    Outputs:
                      (    forth6809.asm):02813         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02814         ;    Registers: all changed.
                      (    forth6809.asm):02815         ; BLDSELF
                      (    forth6809.asm):02816         ;    Inputs:
                      (    forth6809.asm):02817         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02818         ;    Outputs:
                      (    forth6809.asm):02819         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02820         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02821         ;    Registers: all changed.
                      (    forth6809.asm):02822         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02823         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02824         ; ------------------------------------------------------------
DFF7 3406             (    forth6809.asm):02825         BLDDOES:    PSHS  D                 ; behaviour address
DFF9 CC0000           (    forth6809.asm):02826                     LDD   #0
DFFC 3606             (    forth6809.asm):02827                     PSHU  D
DFFE BDDF78           (    forth6809.asm):02828                     JSR   HEADER
E001 CCDEBB           (    forth6809.asm):02829                     LDD   #DODOES
E004 3606             (    forth6809.asm):02830                     PSHU  D
E006 BDE99C           (    forth6809.asm):02831                     JSR   CCALL
E009 3506             (    forth6809.asm):02832                     PULS  D
E00B 3606             (    forth6809.asm):02833                     PSHU  D                 ; behaviour address
E00D BDDF26           (    forth6809.asm):02834                     JSR   CODECOMMA
E010 39               (    forth6809.asm):02835                     RTS
                      (    forth6809.asm):02836         
E011 BDDFF7           (    forth6809.asm):02837         BLDSELF:    JSR   BLDDOES
E014 DC08             (    forth6809.asm):02838                     LDD   CODEHERE          ; PFA = the cell after this one
E016 C30002           (    forth6809.asm):02839                     ADDD  #2                ; See bugfix: CONSTANTW.1
E019 3606             (    forth6809.asm):02840                     PSHU  D
E01B BDDF26           (    forth6809.asm):02841                     JSR   CODECOMMA
E01E 39               (    forth6809.asm):02842                     RTS
                      (    forth6809.asm):02843         
                      (    forth6809.asm):02844         ; ------------------------------------------------------------
                      (    forth6809.asm):02845         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02846         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02847         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02848         ; address in the code area, on the stack.
                      (    forth6809.asm):02849         ; ------------------------------------------------------------
E01F CCDEC6           (    forth6809.asm):02850         CREATEW:    LDD   #DOESRT0
E022 BDE011           (    forth6809.asm):02851                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E025 39               (    forth6809.asm):02852                     RTS
                      (    forth6809.asm):02853         
                      (    forth6809.asm):02854         ; ------------------------------------------------------------
                      (    forth6809.asm):02855         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02856         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02857         ; of the word being defined.
                      (    forth6809.asm):02858         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02859         ; ------------------------------------------------------------
E026 CCDEC7           (    forth6809.asm):02860         DOESGTW:    LDD   #SETDOES
E029 3606             (    forth6809.asm):02861                     PSHU  D
E02B BDE99C           (    forth6809.asm):02862                     JSR   CCALL
E02E 39               (    forth6809.asm):02863                     RTS
                      (    forth6809.asm):02864         
                      (    forth6809.asm):02865         ; ------------------------------------------------------------
                      (    forth6809.asm):02866         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02867         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02868         ; area, initialised to zero.
                      (    forth6809.asm):02869         ; ------------------------------------------------------------
E02F CC0000           (    forth6809.asm):02870         VARIABLEW:  LDD   #0
E032 3606             (    forth6809.asm):02871                     PSHU  D
E034 BDDF78           (    forth6809.asm):02872                     JSR   HEADER
E037 CCDEBB           (    forth6809.asm):02873                     LDD   #DODOES
E03A 3606             (    forth6809.asm):02874                     PSHU  D
E03C BDE99C           (    forth6809.asm):02875                     JSR   CCALL
E03F CCDEC6           (    forth6809.asm):02876                     LDD   #DOESRT0
E042 3606             (    forth6809.asm):02877                     PSHU  D
E044 BDDF26           (    forth6809.asm):02878                     JSR   CODECOMMA
E047 DC0A             (    forth6809.asm):02879                     LDD   VARHERE
E049 3606             (    forth6809.asm):02880                     PSHU  D
E04B BDDF26           (    forth6809.asm):02881                     JSR   CODECOMMA
E04E CC0000           (    forth6809.asm):02882                     LDD   #0
E051 9E0A             (    forth6809.asm):02883                     LDX   VARHERE
E053 ED81             (    forth6809.asm):02884                     STD   ,X++
E055 9F0A             (    forth6809.asm):02885                     STX   VARHERE
E057 39               (    forth6809.asm):02886                     RTS
                      (    forth6809.asm):02887         
                      (    forth6809.asm):02888         ; ------------------------------------------------------------
                      (    forth6809.asm):02889         ; @  ( a-addr -- x )
                      (    forth6809.asm):02890         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
E058 3710             (    forth6809.asm):02892         FETCHW:     PULU  X                 ; a-addr

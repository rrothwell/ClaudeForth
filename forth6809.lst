                      (    forth6809.asm):01877                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):01878                                        ; entirely - every routine from here through
                      (    forth6809.asm):01879                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):01880                                        ; every primitive) would otherwise have
                      (    forth6809.asm):01881                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):01882                                        ; WARM message left the location counter,
                      (    forth6809.asm):01883                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):01884                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):01885                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):01886         
                      (    forth6809.asm):01887         ; ------------------------------------------------------------
                      (    forth6809.asm):01888         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):01889         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):01890         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):01891         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):01892         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):01893         ; ------------------------------------------------------------
DE7A 8603             (    forth6809.asm):01894         INITSERIAL: LDA   #$03
DE7C B7C008           (    forth6809.asm):01895                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):01896                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):01897                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):01898                  IFEQ SERIALPOLL  ; >>>>>>>>>>
DE7F 8695             (    forth6809.asm):01899                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01900                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):01901                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01902                  ENDC  ; <<<<<<<<<<
DE81 B7C008           (    forth6809.asm):01903                  STA   ACIACR         ; was "STA ACIA" - same fix
DE84 39               (    forth6809.asm):01904                  RTS
                      (    forth6809.asm):01905         
                      (    forth6809.asm):01906                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):01907         ; ------------------------------------------------------------
                      (    forth6809.asm):01908         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):01909         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):01910         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):01911         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):01912         ; ------------------------------------------------------------
DE85 B60106           (    forth6809.asm):01913         INFILL:  LDA   INHEAD
DE88 B00107           (    forth6809.asm):01914                  SUBA  INTAIL
DE8B 843F             (    forth6809.asm):01915                  ANDA  #INBUFSZ-1
DE8D 39               (    forth6809.asm):01916                  RTS
                      (    forth6809.asm):01917         
                      (    forth6809.asm):01918         ; ------------------------------------------------------------
                      (    forth6809.asm):01919         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):01920         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):01921         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):01922         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):01923         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):01924         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):01925         ; flow control, not a chip feature.
                      (    forth6809.asm):01926         ; ------------------------------------------------------------
DE8E BDDE85           (    forth6809.asm):01927         RTSCHECKHI: JSR  INFILL
DE91 8130             (    forth6809.asm):01928                     CMPA #INHIWATER
DE93 250D             (    forth6809.asm):01929                     BLO  RTSCHIDONE
DE95 0DFF             (    forth6809.asm):01930                     TST  RTSSTATE
DE97 2609             (    forth6809.asm):01931                     BNE  RTSCHIDONE       ; already high - nothing to do
DE99 86D5             (    forth6809.asm):01932                     LDA  #CR_RTSHI
DE9B B7C008           (    forth6809.asm):01933                     STA  ACIACR
DE9E 8601             (    forth6809.asm):01934                     LDA  #1
DEA0 97FF             (    forth6809.asm):01935                     STA  RTSSTATE
DEA2 39               (    forth6809.asm):01936         RTSCHIDONE: RTS
                      (    forth6809.asm):01937         
                      (    forth6809.asm):01938         ; ------------------------------------------------------------
                      (    forth6809.asm):01939         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):01940         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):01941         ; own TXOFF path also writes ACIACR, and an interrupt landing

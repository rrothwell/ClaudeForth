                      (   unit_tests.asm):07605         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (   unit_tests.asm):07606         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (   unit_tests.asm):07607         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (   unit_tests.asm):07608         ; compiled as the new behavior, terminated with RTS) - executing
                      (   unit_tests.asm):07609         ; TESTWD should push 6 (5 fetched, then incremented).
                      (   unit_tests.asm):07610         ;
                      (   unit_tests.asm):07611         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (   unit_tests.asm):07612         ; return": it patches LATEST's behavior field using the return
                      (   unit_tests.asm):07613         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (   unit_tests.asm):07614         ; SECOND return address and jumps there - designed for the
                      (   unit_tests.asm):07615         ; normal case where DOES> is reached from inside an enclosing
                      (   unit_tests.asm):07616         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (   unit_tests.asm):07617         ; would compile), which itself has its own caller. Traced by
                      (   unit_tests.asm):07618         ; hand: calling directly into the compiled "JSR SETDOES"
                      (   unit_tests.asm):07619         ; instruction itself (not through an intermediate wrapper)
                      (   unit_tests.asm):07620         ; naturally supplies exactly the two stack levels SETDOES
                      (   unit_tests.asm):07621         ; expects - its own JSR provides the first (becoming the new
                      (   unit_tests.asm):07622         ; behavior field value), and this test's own call provides the
                      (   unit_tests.asm):07623         ; second (correctly resuming here afterward) - no extra
                      (   unit_tests.asm):07624         ; scaffolding needed, confirmed correct rather than assumed.
                      (   unit_tests.asm):07625         ; ------------------------------------------------------------

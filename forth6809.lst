E1A2 273B             (    forth6809.asm):02977                     BEQ   BADWORD
                      (    forth6809.asm):02978         
E1A4 10830001         (    forth6809.asm):02979                     CMPD  #1                ; 1 = double-number result
E1A8 2711             (    forth6809.asm):02980                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):02981         
E1AA DC00             (    forth6809.asm):02982                     LDD   STATE
E1AC 27C2             (    forth6809.asm):02983                     BEQ   ILOOP
E1AE CCDDE3           (    forth6809.asm):02984                     LDD   #LIT
E1B1 3606             (    forth6809.asm):02985                     PSHU  D
E1B3 BDE931           (    forth6809.asm):02986                     JSR   CCALL
E1B6 BDDE76           (    forth6809.asm):02987                     JSR   CODECOMMA
E1B9 20B5             (    forth6809.asm):02988                     BRA   ILOOP
                      (    forth6809.asm):02989         
E1BB                  (    forth6809.asm):02990         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):02991                                             ; ANS's (ud1) stack order directly.
E1BB DC00             (    forth6809.asm):02992                     LDD   STATE
E1BD 27B1             (    forth6809.asm):02993                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):02994                                             ; nothing more to do
                      (    forth6809.asm):02995                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):02996                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):02997                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):02998                     ; pop it aside first, freeing UDLO to be compiled first.
E1BF 3706             (    forth6809.asm):02999                     PULU  D
E1C1 DD1A             (    forth6809.asm):03000                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03001                                             ; untouched by CCALL/CODECOMMA
E1C3 CCDDE3           (    forth6809.asm):03002                     LDD   #LIT
E1C6 3606             (    forth6809.asm):03003                     PSHU  D
E1C8 BDE931           (    forth6809.asm):03004                     JSR   CCALL
E1CB BDDE76           (    forth6809.asm):03005                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
E1CE CCDDE3           (    forth6809.asm):03006                     LDD   #LIT
E1D1 3606             (    forth6809.asm):03007                     PSHU  D
E1D3 BDE931           (    forth6809.asm):03008                     JSR   CCALL
E1D6 DC1A             (    forth6809.asm):03009                     LDD   MSCR4

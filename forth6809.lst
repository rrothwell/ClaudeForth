                      (    forth6809.asm):06483         
                      (    forth6809.asm):06484         ; ------------------------------------------------------------
                      (    forth6809.asm):06485         ; TYPE  ( c-addr u -- )
                      (    forth6809.asm):06486         ; Display u characters starting at c-addr, through EMIT.

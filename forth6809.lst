                      (    forth6809.asm):03973                    JSR   TSTSMRM
                      (    forth6809.asm):03974                    JSR   TSTSMRZ
                      (    forth6809.asm):03975                    JSR   TSTDPLUS
                      (    forth6809.asm):03976                    JSR   TSTDMIN2
                      (    forth6809.asm):03977                    JSR   TSTDNEG

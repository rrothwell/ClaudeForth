                      (    forth6809.asm):03197         ; TSTSTSLZ - unit test for STARSLASH, divide-by-zero case. n3 = 0.
                      (    forth6809.asm):03198         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):03199         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):03200         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):03201         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):03202         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):03203         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):03204         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):03205         ; there are.
                      (    forth6809.asm):03206         ; ------------------------------------------------------------

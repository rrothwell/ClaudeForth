                      (    forth6809.asm):03440         ; INTERPRET  ( -- )
                      (    forth6809.asm):03441         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03442         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03443         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03444         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03445         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03446         ; ------------------------------------------------------------

E64A 3606             (    forth6809.asm):03796                     PSHU  D
E64C 3506             (    forth6809.asm):03797                     PULS  D                 ; orig1
E64E 3606             (    forth6809.asm):03798                     PSHU  D
E650 BDE5EA           (    forth6809.asm):03799                     JSR   PATCH
E653 DC08             (    forth6809.asm):03800                     LDD   CODEHERE
E655 830002           (    forth6809.asm):03801                     SUBD  #2
E658 3606             (    forth6809.asm):03802                     PSHU  D                 ; orig2
E65A CC0001           (    forth6809.asm):03803                     LDD   #TAGFWD
E65D 3606             (    forth6809.asm):03804                     PSHU  D
E65F 39               (    forth6809.asm):03805                     RTS
                      (    forth6809.asm):03806         

E025 ECC1             (    forth6809.asm):05868         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
E027 2718             (    forth6809.asm):05869                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
E029 1F02             (    forth6809.asm):05870                     TFR   D,Y               ; Y = cells to shift
E02B 58               (    forth6809.asm):05871                     LSLB
E02C 49               (    forth6809.asm):05872                     ROLA
E02D 30CB             (    forth6809.asm):05873                     LEAX  D,U               ; X = xu
E02F EC84             (    forth6809.asm):05874                     LDD   ,X
E031 3406             (    forth6809.asm):05875                     PSHS  D                 ; xu waits on the return stack
E033 EC1E             (    forth6809.asm):05876         RLOOP:      LDD   -2,X
E035 ED84             (    forth6809.asm):05877                     STD   ,X
E037 301E             (    forth6809.asm):05878                     LEAX  -2,X

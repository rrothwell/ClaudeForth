                      (    forth6809.asm):02561         
                      (    forth6809.asm):02562                    STU  TSTUAF
                      (    forth6809.asm):02563         
                      (    forth6809.asm):02564                    PULU D
                      (    forth6809.asm):02565                    CMPD #TSTVAL2
                      (    forth6809.asm):02566                    BNE  T2RFAIL
                      (    forth6809.asm):02567                    PULU D
                      (    forth6809.asm):02568                    CMPD #TSTVAL1
                      (    forth6809.asm):02569                    BNE  T2RFAIL
                      (    forth6809.asm):02570                    PULU D
                      (    forth6809.asm):02571                    CMPD #TSTGUARD
                      (    forth6809.asm):02572                    BNE  T2RFAIL
                      (    forth6809.asm):02573         
                      (    forth6809.asm):02574                    LDD  TSTUB4
                      (    forth6809.asm):02575                    SUBD TSTUAF
                      (    forth6809.asm):02576                    CMPD #0
                      (    forth6809.asm):02577                    BNE  T2RFAIL
                      (    forth6809.asm):02578         
                      (    forth6809.asm):02579                    LDD  #TRUEV
                      (    forth6809.asm):02580                    BRA  T2RDONE
C1B1                  (    forth6809.asm):02581         T2RFAIL:   LDD  #FALSEV
C1B1                  (    forth6809.asm):02582         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02583                    PSHU X
                      (    forth6809.asm):02584                    PSHU D
                      (    forth6809.asm):02585                    JSR  TSTREPORT
                      (    forth6809.asm):02586         
                      (    forth6809.asm):02587                    LDU  TSTU0
                      (    forth6809.asm):02588                    RTS
                      (    forth6809.asm):02589         
C1B1                  (    forth6809.asm):02590         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02591                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02592         
                      (    forth6809.asm):02593         ; ------------------------------------------------------------
                      (    forth6809.asm):02594         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02595         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02596         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02597         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02598         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02599         ; ------------------------------------------------------------

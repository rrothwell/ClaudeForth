                      (    forth6809.asm):04856         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):04857         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):04858         ; while the others move.
                      (    forth6809.asm):04859         ; ------------------------------------------------------------
EB71 AE4A             (    forth6809.asm):04860         DROTW:      LDX   10,U              ; x1
EB73 10AE48           (    forth6809.asm):04861                     LDY   8,U               ; x2
EB76 EC46             (    forth6809.asm):04862                     LDD   6,U
EB78 ED4A             (    forth6809.asm):04863                     STD   10,U

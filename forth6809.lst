                      (    forth6809.asm):01626                    LDD   #TSTVAL2
                      (    forth6809.asm):01627                    PSHU  D
                      (    forth6809.asm):01628                    LDD   #TSTVAL3
                      (    forth6809.asm):01629                    PSHU  D
                      (    forth6809.asm):01630                    LDD   #TSTVAL4
                      (    forth6809.asm):01631                    PSHU  D
                      (    forth6809.asm):01632                    LDD   #TSTVAL5
                      (    forth6809.asm):01633                    PSHU  D
                      (    forth6809.asm):01634                    LDD   #TSTVAL6
                      (    forth6809.asm):01635                    PSHU  D
                      (    forth6809.asm):01636                    STU   TSTUB4
                      (    forth6809.asm):01637         
                      (    forth6809.asm):01638                    JSR   DROT
                      (    forth6809.asm):01639         
                      (    forth6809.asm):01640                    STU   TSTUAF
                      (    forth6809.asm):01641         

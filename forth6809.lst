                      (    forth6809.asm):03798         ; ============================================================
                      (    forth6809.asm):03799         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03800         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03801         ; ============================================================
                      (    forth6809.asm):03802         ; ------------------------------------------------------------
                      (    forth6809.asm):03803         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03804         ; location.
                      (    forth6809.asm):03805         ; PATCH   ( target location -- )
                      (    forth6809.asm):03806         ;    Inputs:
                      (    forth6809.asm):03807         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03808         ;    Outputs:
                      (    forth6809.asm):03809         ;        the cell at location holds target - location
                      (    forth6809.asm):03810         ;    Registers: RegD and RegX changed; PFIELD and PTARGET used as
                      (    forth6809.asm):03811         ;        scratch.
                      (    forth6809.asm):03812         ; ------------------------------------------------------------
E63F 3706             (    forth6809.asm):03813         PATCH:      PULU  D
E641 DD44             (    forth6809.asm):03814                     STD   PFIELD            ; location
E643 3706             (    forth6809.asm):03815                     PULU  D
E645 DD42             (    forth6809.asm):03816                     STD   PTARGET           ; target
E647 DC42             (    forth6809.asm):03817                     LDD   PTARGET
E649 9344             (    forth6809.asm):03818                     SUBD  PFIELD
E64B 9E44             (    forth6809.asm):03819                     LDX   PFIELD
E64D ED84             (    forth6809.asm):03820                     STD   ,X
E64F 39               (    forth6809.asm):03821                     RTS
                      (    forth6809.asm):03822         
                      (    forth6809.asm):03823         ; ------------------------------------------------------------
                      (    forth6809.asm):03824         ; IF  ( C: -- orig )
                      (    forth6809.asm):03825         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03826         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03827         ; ------------------------------------------------------------
E650 CCDE75           (    forth6809.asm):03828         IFW:        LDD   #ZBRANCH
E653 3606             (    forth6809.asm):03829                     PSHU  D
E655 BDEA85           (    forth6809.asm):03830                     JSR   CCALL
E658 CC0000           (    forth6809.asm):03831                     LDD   #0
E65B 3606             (    forth6809.asm):03832                     PSHU  D
E65D BDDF08           (    forth6809.asm):03833                     JSR   CODECOMMA
E660 DC08             (    forth6809.asm):03834                     LDD   CODEHERE
E662 830002           (    forth6809.asm):03835                     SUBD  #2
E665 3606             (    forth6809.asm):03836                     PSHU  D                 ; orig
E667 CC0001           (    forth6809.asm):03837                     LDD   #TAGFWD
E66A 3606             (    forth6809.asm):03838                     PSHU  D
E66C 39               (    forth6809.asm):03839                     RTS
                      (    forth6809.asm):03840         
                      (    forth6809.asm):03841         ; ------------------------------------------------------------
                      (    forth6809.asm):03842         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03843         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03844         ; operand to jump to the current code address.
                      (    forth6809.asm):03845         ; ------------------------------------------------------------
E66D 3706             (    forth6809.asm):03846         THENW:      PULU  D
E66F 10830001         (    forth6809.asm):03847                     CMPD  #TAGFWD
E673 2703             (    forth6809.asm):03848                     BEQ   THOK
E675 BDE5D5           (    forth6809.asm):03849                     JSR   CFERR
E678 3710             (    forth6809.asm):03850         THOK:       PULU  X                 ; orig
E67A DC08             (    forth6809.asm):03851                     LDD   CODEHERE
E67C 3606             (    forth6809.asm):03852                     PSHU  D
E67E 3610             (    forth6809.asm):03853                     PSHU  X
E680 BDE63F           (    forth6809.asm):03854                     JSR   PATCH
E683 39               (    forth6809.asm):03855                     RTS
                      (    forth6809.asm):03856         
                      (    forth6809.asm):03857         ; ------------------------------------------------------------
                      (    forth6809.asm):03858         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03859         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03860         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03861         ; ------------------------------------------------------------
E684 3706             (    forth6809.asm):03862         ELSEW:      PULU  D
E686 10830001         (    forth6809.asm):03863                     CMPD  #TAGFWD
E68A 2703             (    forth6809.asm):03864                     BEQ   ELOK
E68C BDE5D5           (    forth6809.asm):03865                     JSR   CFERR
E68F 3706             (    forth6809.asm):03866         ELOK:       PULU  D                 ; orig1

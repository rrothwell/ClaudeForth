F8BD 2715             (    forth6809.asm):06168                    BEQ  UEDONE
F8BF A680             (    forth6809.asm):06169                    LDA  ,X+
F8C1 8125             (    forth6809.asm):06170                    CMPA #'%'
F8C3 2604             (    forth6809.asm):06171                    BNE  UENOTPCT
F8C5 C625             (    forth6809.asm):06172                    LDB  #'%'      ; write the extra '%' first - the character
F8C7 E7A0             (    forth6809.asm):06173                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):06174                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):06175                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):06176                                   ; the same string correctly, since this runs
                      (    forth6809.asm):06177                                   ; independently for each one the loop visits.
F8C9 A7A0             (    forth6809.asm):06178         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):06179                                   ; every character, '%' or not
F8CB DCA9             (    forth6809.asm):06180                    LDD  UESRCLEN
F8CD 830001           (    forth6809.asm):06181                    SUBD #1
F8D0 DDA9             (    forth6809.asm):06182                    STD  UESRCLEN
F8D2 20E7             (    forth6809.asm):06183                    BRA  UELOOP
F8D4 1F20             (    forth6809.asm):06184         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F8D6 93AB             (    forth6809.asm):06185                    SUBD UEDST     ; overwriting whatever was left on top of
F8D8 DDAD             (    forth6809.asm):06186                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):06187                                   ; required return values, and separately,
                      (    forth6809.asm):06188                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):06189                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):06190                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):06191                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):06192                                   ; characters. Now computed directly as the
                      (    forth6809.asm):06193                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):06194                                   ; original destination address (UEDST) -
                      (    forth6809.asm):06195                                   ; correct regardless of how many characters
                      (    forth6809.asm):06196                                   ; were doubled, since it's derived from
                      (    forth6809.asm):06197                                   ; where writing actually stopped rather than
                      (    forth6809.asm):06198                                   ; incremented alongside it.
F8DA DCAB             (    forth6809.asm):06199                    LDD  UEDST
F8DC 3606             (    forth6809.asm):06200                    PSHU D         ; push c-addr2 (destination address)
F8DE DCAD             (    forth6809.asm):06201                    LDD  UEOUTLEN
F8E0 3606             (    forth6809.asm):06202                    PSHU D         ; push u2 (actual unescaped length)
F8E2 39               (    forth6809.asm):06203                    RTS

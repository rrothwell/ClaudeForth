                      (    forth6809.asm):03751         ; ============================================================
                      (    forth6809.asm):03752         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03753         ; ============================================================
                      (    forth6809.asm):03754                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E49C                  (    forth6809.asm):03755         X_KEY:     LDA   INHEAD
                      (    forth6809.asm):03756                  CMPA  INTAIL
                      (    forth6809.asm):03757                  BEQ   KEY
                      (    forth6809.asm):03758                  LDX   #INBUF
                      (    forth6809.asm):03759                  LDB   INTAIL
                      (    forth6809.asm):03760                  LDA   B,X
                      (    forth6809.asm):03761                  INCB
                      (    forth6809.asm):03762                  ANDB  #INBUFSZ-1
                      (    forth6809.asm):03763                  STB   INTAIL
                      (    forth6809.asm):03764                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03765                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03766                                         ; this needs no dedicated scratch global
                      (    forth6809.asm):03767                  JSR   RTSCHECKLO
                      (    forth6809.asm):03768                  PULS  A
                      (    forth6809.asm):03769                  TFR   A,B
                      (    forth6809.asm):03770                  CLRA
                      (    forth6809.asm):03771                  PSHU  D
                      (    forth6809.asm):03772                  RTS
                      (    forth6809.asm):03773         
                      (    forth6809.asm):03774         ; ------------------------------------------------------------
                      (    forth6809.asm):03775         ; KEY ( -- char )
                      (    forth6809.asm):03776         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03777         KEY:
                      (    forth6809.asm):03778         
                      (    forth6809.asm):03779                     TST   RTSSTATE         ; Is throttling?
                      (    forth6809.asm):03780                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03781         
                      (    forth6809.asm):03782                     ; BUG FIX: this used to mask IRQ (ORCC #$10) around the
                      (    forth6809.asm):03783                     ; FLUSHOUTBUFFER call. FLUSHOUTBUFFER can spin until the
                      (    forth6809.asm):03784                     ; whole OUTBUF drains (up to ~5.5ms at 115200 baud), and
                      (    forth6809.asm):03785                     ; masking IRQ for that whole span blocks IRQH's own INCHAR
                      (    forth6809.asm):03786                     ; path from servicing the receiver - precisely while RTS
                      (    forth6809.asm):03787                     ; is high because the receiver is already under pressure,
                      (    forth6809.asm):03788                     ; which is what was causing the returned overrun errors.
                      (    forth6809.asm):03789                     ; FLUSHOUTBUFFER only touches OUTHEAD/OUTTAIL/ACIACR, not
                      (    forth6809.asm):03790                     ; INHEAD/INTAIL, so there's no correctness reason to mask
                      (    forth6809.asm):03791                     ; the receiver interrupt here at all.
                      (    forth6809.asm):03792                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03793                                             ; by transmitting all chars.
                      (    forth6809.asm):03794         
E49C                  (    forth6809.asm):03795         TRY_READ:
                      (    forth6809.asm):03796                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03797                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03798                                             ; while still transmitting!
                      (    forth6809.asm):03799                 
                      (    forth6809.asm):03800                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03801                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03802                     PSHU  D                                     ; Return result on data stack.
                      (    forth6809.asm):03803         
                      (    forth6809.asm):03804                     RTS                     
                      (    forth6809.asm):03805         
                      (    forth6809.asm):03806         ; ------------------------------------------------------------
                      (    forth6809.asm):03807         ; KEY? ( -- flag )
                      (    forth6809.asm):03808         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03809         KEYQ:  
                      (    forth6809.asm):03810                     ; ORCC  #$10              ; Yes! Enter critical section
                      (    forth6809.asm):03811         
                      (    forth6809.asm):03812                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03813                     CMPA  INTAIL
                      (    forth6809.asm):03814         
                      (    forth6809.asm):03815                     ; ANDCC #$EF              ; Exit critical section
                      (    forth6809.asm):03816         
                      (    forth6809.asm):03817                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03818         
                      (    forth6809.asm):03819                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03820                     PSHU  D
                      (    forth6809.asm):03821         
                      (    forth6809.asm):03822                     RTS
                      (    forth6809.asm):03823         
E49C                  (    forth6809.asm):03824         KQTRUE:     
                      (    forth6809.asm):03825                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03826                     PSHU  D                 ; Push 16-bit cell to Stack (U)
                      (    forth6809.asm):03827                     RTS
                      (    forth6809.asm):03828         ; ------------------------------------------------------------
                      (    forth6809.asm):03829         ; EMIT  ( char -- )
                      (    forth6809.asm):03830         ; ------------------------------------------------------------
                      (    forth6809.asm):03831         
E49C                  (    forth6809.asm):03832         X_EMIT:    PULU  D
                      (    forth6809.asm):03833                  STB   EMITCH
E49C                  (    forth6809.asm):03834         EMITWT:  LDB   OUTHEAD
                      (    forth6809.asm):03835                  INCB
                      (    forth6809.asm):03836                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03837                  CMPB  OUTTAIL
                      (    forth6809.asm):03838                  BEQ   EMITWT
                      (    forth6809.asm):03839                  LDX   #OUTBUF
                      (    forth6809.asm):03840                  LDB   OUTHEAD
                      (    forth6809.asm):03841                  LDA   EMITCH
                      (    forth6809.asm):03842                  STA   B,X
                      (    forth6809.asm):03843                  INCB
                      (    forth6809.asm):03844                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):03845                  STB   OUTHEAD
                      (    forth6809.asm):03846                  TST   RTSSTATE
                      (    forth6809.asm):03847                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03848                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03849                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03850                                         ; interrupt itself if OUTBUF still has data
                      (    forth6809.asm):03851                  LDA   #CR_RXTX
                      (    forth6809.asm):03852                  STA   ACIACR
E49C                  (    forth6809.asm):03853         EMITNORTS: RTS
                      (    forth6809.asm):03854         
E49C                  (    forth6809.asm):03855         EMIT:
                      (    forth6809.asm):03856                     PULU  D                 ; Copy char from 2 byte stack cell to RegA.
                      (    forth6809.asm):03857                     TFR   B,A               
                      (    forth6809.asm):03858                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03859                     RTS                     
                      (    forth6809.asm):03860         
                      (    forth6809.asm):03861                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):03862         ; ------------------------------------------------------------
                      (    forth6809.asm):03863         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03864         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03865         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03866         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03867         ; directly against ACIASR.
                      (    forth6809.asm):03868         ;
                      (    forth6809.asm):03869         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03870         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03871         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03872         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03873         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03874         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03875         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03876         ; ------------------------------------------------------------
E49C                  (    forth6809.asm):03877         KEY:
E49C B6C008           (    forth6809.asm):03878                  LDA   ACIASR
E49F 8501             (    forth6809.asm):03879                  BITA  #SR_RDRF
E4A1 2705             (    forth6809.asm):03880                  BEQ   KWAIT
E4A3 7C017F           (    forth6809.asm):03881                  INC   POLLREADYCNT   ; character was already queued when we
E4A6 2007             (    forth6809.asm):03882                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E4A8                  (    forth6809.asm):03883         KWAIT:
E4A8 B6C008           (    forth6809.asm):03884         KSPIN:   LDA   ACIASR
E4AB 8501             (    forth6809.asm):03885                  BITA  #SR_RDRF
E4AD 27F9             (    forth6809.asm):03886                  BEQ   KSPIN
E4AF                  (    forth6809.asm):03887         KGOTSTAT:                     ; A holds the status byte exactly as it was
                      (    forth6809.asm):03888                                        ; when RDRF first went true - check the
                      (    forth6809.asm):03889                                        ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03890                                        ; read, since reading ACIADR below clears
                      (    forth6809.asm):03891                                        ; RDRF and the latched error bits together
E4AF 8570             (    forth6809.asm):03892                  BITA  #SR_FE+SR_OVRN+SR_PE
E4B1 2715             (    forth6809.asm):03893                  BEQ   KGETCH
E4B3 8510             (    forth6809.asm):03894                  BITA  #SR_FE
E4B5 2703             (    forth6809.asm):03895                  BEQ   KXFE
E4B7 7C017C           (    forth6809.asm):03896                  INC   FECOUNT
E4BA 8520             (    forth6809.asm):03897         KXFE:    BITA  #SR_OVRN
E4BC 2703             (    forth6809.asm):03898                  BEQ   KXOVRN
E4BE 7C017D           (    forth6809.asm):03899                  INC   OVRNCOUNT
E4C1 8540             (    forth6809.asm):03900         KXOVRN:  BITA  #SR_PE
E4C3 2703             (    forth6809.asm):03901                  BEQ   KGETCH
E4C5 7C017E           (    forth6809.asm):03902                  INC   PECOUNT
E4C8 B6C009           (    forth6809.asm):03903         KGETCH:  LDA   ACIADR
E4CB 1F89             (    forth6809.asm):03904                  TFR   A,B
E4CD 4F               (    forth6809.asm):03905                  CLRA
E4CE 3606             (    forth6809.asm):03906                  PSHU  D
E4D0 39               (    forth6809.asm):03907                  RTS
                      (    forth6809.asm):03908         
                      (    forth6809.asm):03909         ; ------------------------------------------------------------
                      (    forth6809.asm):03910         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):03911         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):03912         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):03913         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):03914         ; either is safe to call from ACCEPT at any point without
                      (    forth6809.asm):03915         ; disturbing whatever's on U. See ACCEPT for where these are
                      (    forth6809.asm):03916         ; called: XON at the start of every line (the host may stream
                      (    forth6809.asm):03917         ; characters continuously while ACCEPT's own tight loop is
                      (    forth6809.asm):03918         ; polling), XOFF the instant a line is complete (CR seen), before
                      (    forth6809.asm):03919         ; handing off to INTERPRET/compilation - which does arbitrary,
                      (    forth6809.asm):03920         ; variable-length work with KEY never polled at all, exactly the
                      (    forth6809.asm):03921         ; window where a host that kept sending would build up a backlog
                      (    forth6809.asm):03922         ; this polling build (with no ring buffer to hold it) has no way
                      (    forth6809.asm):03923         ; to recover from correctly.
                      (    forth6809.asm):03924         ; ------------------------------------------------------------
E4D1 8613             (    forth6809.asm):03925         PUTXOFF: LDA   #XOFFCH
E4D3 2002             (    forth6809.asm):03926                  BRA   PUTXCH
E4D5 8611             (    forth6809.asm):03927         PUTXON:  LDA   #XONCH
E4D7 3402             (    forth6809.asm):03928         PUTXCH:  PSHS  A
E4D9 F6C008           (    forth6809.asm):03929         PXWT:    LDB   ACIASR
E4DC C502             (    forth6809.asm):03930                  BITB  #SR_TDRE
E4DE 27F9             (    forth6809.asm):03931                  BEQ   PXWT
E4E0 3502             (    forth6809.asm):03932                  PULS  A
E4E2 B7C009           (    forth6809.asm):03933                  STA   ACIADR
E4E5 39               (    forth6809.asm):03934                  RTS
                      (    forth6809.asm):03935         
E4E6 B6C008           (    forth6809.asm):03936         KEYQ:    LDA   ACIASR
E4E9 8501             (    forth6809.asm):03937                  BITA  #SR_RDRF
E4EB 2706             (    forth6809.asm):03938                  BEQ   KQFALSE
E4ED CCFFFF           (    forth6809.asm):03939                  LDD   #TRUEV
E4F0 3606             (    forth6809.asm):03940                  PSHU  D
E4F2 39               (    forth6809.asm):03941                  RTS
E4F3 CC0000           (    forth6809.asm):03942         KQFALSE: LDD   #FALSEV
E4F6 3606             (    forth6809.asm):03943                  PSHU  D
E4F8 39               (    forth6809.asm):03944                  RTS
                      (    forth6809.asm):03945         
E4F9 3706             (    forth6809.asm):03946         EMIT:    PULU  D
E4FB D73C             (    forth6809.asm):03947                  STB   EMITCH
E4FD B6C008           (    forth6809.asm):03948         EMITWT:  LDA   ACIASR
E500 8502             (    forth6809.asm):03949                  BITA  #SR_TDRE
E502 27F9             (    forth6809.asm):03950                  BEQ   EMITWT
E504 963C             (    forth6809.asm):03951                  LDA   EMITCH
E506 B7C009           (    forth6809.asm):03952                  STA   ACIADR
E509 39               (    forth6809.asm):03953                  RTS
                      (    forth6809.asm):03954         
                      (    forth6809.asm):03955                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):03956         
E50A 3706             (    forth6809.asm):03957         ACCEPT:  PULU  D
E50C DD35             (    forth6809.asm):03958                  STD   AMAX
E50E 3706             (    forth6809.asm):03959                  PULU  D
E510 DD37             (    forth6809.asm):03960                  STD   ABUFP
E512 CC0000           (    forth6809.asm):03961                  LDD   #0
E515 DD39             (    forth6809.asm):03962                  STD   ACNT
                      (    forth6809.asm):03963         
                      (    forth6809.asm):03964                  IFEQ  SERIALPOLL  ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03965                                     ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03966                                     ; covers this, nothing extra needed
                      (    forth6809.asm):03967                  ELSE  ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03968                                       ; stream this line's characters
E517 BDE4D5           (    forth6809.asm):03969                  JSR   PUTXON
                      (    forth6809.asm):03970                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):03971         
E51A BDE49C           (    forth6809.asm):03972         ALOOP:   JSR   KEY
E51D 3706             (    forth6809.asm):03973                  PULU  D
E51F D73B             (    forth6809.asm):03974                  STB   ACH
                      (    forth6809.asm):03975         

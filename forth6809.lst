E8D6 262D             (    forth6809.asm):04685                     BNE   DPTEXIT           ; shifting S by 2 before every one of these
                      (    forth6809.asm):04686                                             ; offset reads (6,S/2,S/4,S), landing past the
                      (    forth6809.asm):04687                                             ; 3 cells DOSETUP pushed. Deferred PULS X to
                      (    forth6809.asm):04688                                             ; each path separately below, same fix as DOTEST.
E8D8 EC62             (    forth6809.asm):04689                     LDD   2,S               ; old index (the step value is already consumed
E8DA A364             (    forth6809.asm):04690                     SUBD  4,S               ; old_u = old_index - limit, mod 65536

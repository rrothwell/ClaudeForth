                      (    forth6809.asm):03944         ; TSTAND - unit test for ANDW. bitwise AND.
                      (    forth6809.asm):03945         ; Arity: 2 cell(s) in, 1 cell(s) out -> depth check
                      (    forth6809.asm):03946         ; -2 (derived, not hand-typed).
                      (    forth6809.asm):03947         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03948         TSTAND:     STU   TSTU0
                      (    forth6809.asm):03949         
                      (    forth6809.asm):03950                    LDD   #TSTGUARD
                      (    forth6809.asm):03951                    PSHU  D

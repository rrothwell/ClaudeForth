                      (   unit_tests.asm):14506         ; TSTEXCEPTION - exception handling tests (glossary section
                      (   unit_tests.asm):14507         ; 3.15, 2 words, 4 tests since CATCH/THROW can only be
                      (   unit_tests.asm):14508         ; meaningfully tested together - THROW's own effect is only
                      (   unit_tests.asm):14509         ; observable through a CATCH that traps it). Already used
                      (   unit_tests.asm):14510         ; extensively as this whole session's own error-testing
                      (   unit_tests.asm):14511         ; mechanism throughout sections 3.8-3.14, so their correctness
                      (   unit_tests.asm):14512         ; has substantial indirect evidence already; this section still
                      (   unit_tests.asm):14513         ; gets its own, direct, dedicated tests.
                      (   unit_tests.asm):14514         ;
                      (   unit_tests.asm):14515         ; Critical safety constraint, confirmed by reading THROW's own
                      (   unit_tests.asm):14516         ; code directly: with no active CATCH, THROW jumps straight to
                      (   unit_tests.asm):14517         ; ABORT (unsafe to trigger directly - it resets the return
                      (   unit_tests.asm):14518         ; stack, destroying this whole test framework's own call chain,
                      (   unit_tests.asm):14519         ; per section 3.1's own established reasoning). Every THROW in
                      (   unit_tests.asm):14520         ; this section's own tests is either wrapped in a genuine,
                      (   unit_tests.asm):14521         ; active CATCH (via a dedicated internal helper, TSTTHROWHLP,
                      (   unit_tests.asm):14522         ; that only ever gets invoked that way), or is a THROW(0) call -
                      (   unit_tests.asm):14523         ; confirmed via THROW's own code to be a pure, unconditional
                      (   unit_tests.asm):14524         ; no-op that never touches HANDLER or ABORT at all, so that one
                      (   unit_tests.asm):14525         ; specific case is safe to call directly.
                      (   unit_tests.asm):14526         ;
                      (   unit_tests.asm):14527         ; TSTCATCHTHROW specifically verifies the two dummy values
                      (   unit_tests.asm):14528         ; TSTTHROWHLP pushes before throwing are genuinely gone
                      (   unit_tests.asm):14529         ; afterward, confirming CATCH's own documented "restores data
                      (   unit_tests.asm):14530         ; stack depth... on either path" for real. TSTHANDLERSAVE
                      (   unit_tests.asm):14531         ; verifies the HANDLER half of that same documented guarantee
                      (   unit_tests.asm):14532         ; directly, by reading HANDLER itself before and after CATCH
                      (   unit_tests.asm):14533         ; calls on both the success and throw paths, rather than only
                      (   unit_tests.asm):14534         ; inferring it from stack-level behavior.
                      (   unit_tests.asm):14535         ; ------------------------------------------------------------
C2EE BDFC2B           (   unit_tests.asm):14536         TSTEXCEPTION: JSR CRW
C2F1 8EC302           (   unit_tests.asm):14537                    LDX   #TSTEXCMSG
C2F4 3610             (   unit_tests.asm):14538                    PSHU  X
C2F6 CC0006           (   unit_tests.asm):14539                    LDD   #6
C2F9 3606             (   unit_tests.asm):14540                    PSHU  D
C2FB BDF60B           (   unit_tests.asm):14541                    JSR   TYPE
C2FE BDFC2B           (   unit_tests.asm):14542                    JSR   CRW
                      (   unit_tests.asm):14543         
                      (   unit_tests.asm):14544                    IFEQ TSTSELECTOR-14  ; >>>>
                      (   unit_tests.asm):14545         
                      (   unit_tests.asm):14546                    JSR   TSTCATCHOK
                      (   unit_tests.asm):14547                    JSR   TSTCATCHTHROW
                      (   unit_tests.asm):14548                    JSR   TSTTHROWZERO
                      (   unit_tests.asm):14549                    JSR   TSTHANDLERSAVE
                      (   unit_tests.asm):14550         
                      (   unit_tests.asm):14551                    ENDC ; <<<<

                      (    forth6809.asm):02291         ; TSTDROT - unit test for 2ROT
                      (    forth6809.asm):02292         ; ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 ). Verifies the
                      (    forth6809.asm):02293         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):02294         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):02295         ; ------------------------------------------------------------
C192                  (    forth6809.asm):02296         TSTDROT:   STU   TSTU0
                      (    forth6809.asm):02297         
                      (    forth6809.asm):02298                    LDD   #TSTGUARD
                      (    forth6809.asm):02299                    PSHU  D
                      (    forth6809.asm):02300                    LDD   #TSTVAL1
                      (    forth6809.asm):02301                    PSHU  D
                      (    forth6809.asm):02302                    LDD   #TSTVAL2
                      (    forth6809.asm):02303                    PSHU  D
                      (    forth6809.asm):02304                    LDD   #TSTVAL3
                      (    forth6809.asm):02305                    PSHU  D
                      (    forth6809.asm):02306                    LDD   #TSTVAL4
                      (    forth6809.asm):02307                    PSHU  D
                      (    forth6809.asm):02308                    LDD   #TSTVAL5
                      (    forth6809.asm):02309                    PSHU  D
                      (    forth6809.asm):02310                    LDD   #TSTVAL6
                      (    forth6809.asm):02311                    PSHU  D
                      (    forth6809.asm):02312                    STU   TSTUB4
                      (    forth6809.asm):02313         

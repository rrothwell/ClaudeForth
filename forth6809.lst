FFA6 10CEC000         (    forth6809.asm):08209                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08210                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08211                     CLRA
FFAE 1F8B             (    forth6809.asm):08212                     TFR   A,DP
                      (    forth6809.asm):08213         

                      (    forth6809.asm):22678         ; ============================================================
                      (    forth6809.asm):22679         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):22680         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):22681         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):22682         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):22683         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):22684         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):22685         ; ============================================================
                      (    forth6809.asm):22686         ; ------------------------------------------------------------
                      (    forth6809.asm):22687         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):22688         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):22689         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):22690         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):22691         ; - no indirection, no value cell.
                      (    forth6809.asm):22692         ;
                      (    forth6809.asm):22693         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):22694         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):22695         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):22696         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):22697         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):22698         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):22699         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):22700         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):22701         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):22702         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):22703         ; ------------------------------------------------------------
FF37 CCFFFF           (    forth6809.asm):22704         TRUEBODY:  LDD   #$FFFF
FF3A 3606             (    forth6809.asm):22705                    PSHU  D
FF3C 39               (    forth6809.asm):22706                    RTS
                      (    forth6809.asm):22707         
FF3D CC0000           (    forth6809.asm):22708         FALSEBODY: LDD   #$0000
FF40 3606             (    forth6809.asm):22709                    PSHU  D
FF42 39               (    forth6809.asm):22710                    RTS
                      (    forth6809.asm):22711         
                      (    forth6809.asm):22712         ; ------------------------------------------------------------
                      (    forth6809.asm):22713         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):22714         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):22715         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):22716         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):22717         ; ------------------------------------------------------------
FF43 CC0001           (    forth6809.asm):22718         ONEBODY:   LDD   #1
FF46 3606             (    forth6809.asm):22719                    PSHU  D

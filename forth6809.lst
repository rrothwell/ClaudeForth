E644 5C               (    forth6809.asm):03630                  INCB
E645 C43F             (    forth6809.asm):03631                  ANDB  #OUTBUFSZ-1
E647 F1017A           (    forth6809.asm):03632                  CMPB  OUTTAIL
E64A 27F5             (    forth6809.asm):03633                  BEQ   EMITWT
E64C 8E01C0           (    forth6809.asm):03634                  LDX   #OUTBUF
E64F F60179           (    forth6809.asm):03635                  LDB   OUTHEAD
E652 963C             (    forth6809.asm):03636                  LDA   EMITCH
E654 A785             (    forth6809.asm):03637                  STA   B,X
E656 5C               (    forth6809.asm):03638                  INCB
E657 C43F             (    forth6809.asm):03639                  ANDB  #OUTBUFSZ-1
E659 F70179           (    forth6809.asm):03640                  STB   OUTHEAD
E65C 7D017F           (    forth6809.asm):03641                  TST   RTSSTATE
E65F 2605             (    forth6809.asm):03642                  BNE   EMITNORTS       ; RTS is asserted high - leave ACIACR alone;
                      (    forth6809.asm):03643                                         ; output stays queued until RTS drops low,
                      (    forth6809.asm):03644                                         ; at which point RTSCHECKLO re-enables TX
                      (    forth6809.asm):03645                                         ; interrupt itself if OUTBUF still has data
E661 86B5             (    forth6809.asm):03646                  LDA   #CR_RXTX
E663 B7C008           (    forth6809.asm):03647                  STA   ACIACR
E666 39               (    forth6809.asm):03648         EMITNORTS: RTS
                      (    forth6809.asm):03649         
E667                  (    forth6809.asm):03650         EMIT:

                      (    forth6809.asm):00897         ; ------------------------------------------------------------
                      (    forth6809.asm):00898         ; TSTSYSIO - System/Console I/O tests (glossary section 3.1, 12
                      (    forth6809.asm):00899         ; words, 7 tests). Six words are deliberately NOT tested here -
                      (    forth6809.asm):00900         ; KEY, ACCEPT, EXPECT, and QUERY all genuinely block on real
                      (    forth6809.asm):00901         ; input during automated, headless boot-time testing (confirmed
                      (    forth6809.asm):00902         ; by reading their own implementations: KEY spins on itself,
                      (    forth6809.asm):00903         ; ACCEPT calls KEY directly, EXPECT/QUERY both call ACCEPT); and
                      (    forth6809.asm):00904         ; ABORT/QUIT are both designed to never return (ABORT falls
                      (    forth6809.asm):00905         ; through into QUIT, which resets the return stack, discarding
                      (    forth6809.asm):00906         ; this entire call chain and hijacking the boot sequence into
                      (    forth6809.asm):00907         ; the interpreter's own top-level loop). See this group's own
                      (    forth6809.asm):00908         ; leading comment block, right before TSTKEYQ, for the full
                      (    forth6809.asm):00909         ; reasoning.
                      (    forth6809.asm):00910         ;
                      (    forth6809.asm):00911         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00912         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00913         ; thousands of times already across every prior test group.
                      (    forth6809.asm):00914         ; Each test here verifies the real queuing mechanism (OUTHEAD/
                      (    forth6809.asm):00915         ; OUTBUF), reading the actual character(s) back out of the
                      (    forth6809.asm):00916         ; output ring buffer to confirm they were genuinely queued, not
                      (    forth6809.asm):00917         ; just that the call returned without crashing.
                      (    forth6809.asm):00918         ; ------------------------------------------------------------
C169 BDFC2B           (    forth6809.asm):00919         TSTSYSIO: JSR   CRW
C16C 8EC17D           (    forth6809.asm):00920                    LDX   #TSTSYSIOMSG
C16F 3610             (    forth6809.asm):00921                    PSHU  X
C171 CC0005           (    forth6809.asm):00922                    LDD   #5
C174 3606             (    forth6809.asm):00923                    PSHU  D
C176 BDF60B           (    forth6809.asm):00924                    JSR   TYPE
C179 BDFC2B           (    forth6809.asm):00925                    JSR   CRW
                      (    forth6809.asm):00926         
                      (    forth6809.asm):00927                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00928         
                      (    forth6809.asm):00929                    JSR   TSTKEYQ
                      (    forth6809.asm):00930                    JSR   TSTEMIT
                      (    forth6809.asm):00931                    JSR   TSTCR
                      (    forth6809.asm):00932                    JSR   TSTSPACE
                      (    forth6809.asm):00933                    JSR   TSTSPACES
                      (    forth6809.asm):00934                    JSR   TSTSPACESZ
                      (    forth6809.asm):00935                    JSR   TSTTYPE
                      (    forth6809.asm):00936         
                      (    forth6809.asm):00937                    ENDC ; <<<<
                      (    forth6809.asm):00938         
C17C 39               (    forth6809.asm):00939                    RTS
                      (    forth6809.asm):00940         
C17D 537973494F       (    forth6809.asm):00941         TSTSYSIOMSG: FCC "SysIO"
                      (    forth6809.asm):00942         
                      (    forth6809.asm):00943                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00944         
                      (    forth6809.asm):00945         ; ------------------------------------------------------------
                      (    forth6809.asm):00946         ; System/Console I/O test harness (glossary section 3.1). Half
                      (    forth6809.asm):00947         ; of this section's 12 words are deliberately NOT tested here,
                      (    forth6809.asm):00948         ; for reasons confirmed by reading their own implementations
                      (    forth6809.asm):00949         ; directly, not assumed from the glossary alone:
                      (    forth6809.asm):00950         ;
                      (    forth6809.asm):00951         ; KEY genuinely spins forever without real input (both its
                      (    forth6809.asm):00952         ; interrupt-driven and polled variants branch back to
                      (    forth6809.asm):00953         ; themselves - "BEQ KEY" - until a character arrives); ACCEPT
                      (    forth6809.asm):00954         ; calls KEY directly in its own main loop, and EXPECT/QUERY both
                      (    forth6809.asm):00955         ; call ACCEPT - all four inherit the same block. None of these
                      (    forth6809.asm):00956         ; can complete during automated, headless boot-time testing,
                      (    forth6809.asm):00957         ; where no real input will ever arrive.
                      (    forth6809.asm):00958         ;
                      (    forth6809.asm):00959         ; ABORT falls straight through into QUIT, which resets S to
                      (    forth6809.asm):00960         ; RP0 - discarding this entire call chain, including the path
                      (    forth6809.asm):00961         ; back to TSTRUNNER - and enters the interpreter's own top-level
                      (    forth6809.asm):00962         ; loop. Calling either directly would hijack the boot sequence
                      (    forth6809.asm):00963         ; entirely, not just fail one test.
                      (    forth6809.asm):00964         ;
                      (    forth6809.asm):00965         ; EMIT/TYPE/CR/SPACE/SPACES are safe and already proven so - this
                      (    forth6809.asm):00966         ; whole test framework has used TYPE and CR (via TSTREPORT)
                      (    forth6809.asm):00967         ; thousands of times already across every prior test group
                      (    forth6809.asm):00968         ; without incident. Each test here verifies the actual queuing
                      (    forth6809.asm):00969         ; mechanism (OUTHEAD/OUTBUF), not just "didn't crash" - reading
                      (    forth6809.asm):00970         ; the real character(s) back out of the output ring buffer to
                      (    forth6809.asm):00971         ; confirm they were genuinely queued, not just that the call
                      (    forth6809.asm):00972         ; returned.
                      (    forth6809.asm):00973         ; ------------------------------------------------------------
                      (    forth6809.asm):00974         
                      (    forth6809.asm):00975         ; ------------------------------------------------------------
                      (    forth6809.asm):00976         ; TSTKEYQ - unit test for KEY?. With no real input pending
                      (    forth6809.asm):00977         ; during automated boot-time testing, expects FALSE - the
                      (    forth6809.asm):00978         ; normal, expected case for this kind of test run.
                      (    forth6809.asm):00979         ; ------------------------------------------------------------
C182                  (    forth6809.asm):00980         TSTKEYQ: STU   TSTU0
                      (    forth6809.asm):00981         
                      (    forth6809.asm):00982                  LDD   #TSTGUARD
                      (    forth6809.asm):00983                  PSHU  D
                      (    forth6809.asm):00984                  STU   TSTUB4
                      (    forth6809.asm):00985         
                      (    forth6809.asm):00986                  JSR   KEYQ
                      (    forth6809.asm):00987         
                      (    forth6809.asm):00988                  STU   TSTUAF
                      (    forth6809.asm):00989         
                      (    forth6809.asm):00990                  PULU  D
                      (    forth6809.asm):00991                  CMPD  #FALSEV
                      (    forth6809.asm):00992                  BNE   KYFAIL
                      (    forth6809.asm):00993                  PULU  D
                      (    forth6809.asm):00994                  CMPD  #TSTGUARD
                      (    forth6809.asm):00995                  BNE   KYFAIL
                      (    forth6809.asm):00996         
                      (    forth6809.asm):00997                  LDD   TSTUB4
                      (    forth6809.asm):00998                  SUBD  TSTUAF
                      (    forth6809.asm):00999                  CMPD  #2
                      (    forth6809.asm):01000                  BNE   KYFAIL
                      (    forth6809.asm):01001         
                      (    forth6809.asm):01002                  LDD   #TRUEV
                      (    forth6809.asm):01003                  BRA   KYDONE
C182                  (    forth6809.asm):01004         KYFAIL: LDD   #FALSEV
C182                  (    forth6809.asm):01005         KYDONE: LDX   #TSTKEYQNAME
                      (    forth6809.asm):01006                  PSHU  X
                      (    forth6809.asm):01007                  PSHU  D
                      (    forth6809.asm):01008                  JSR   TSTREPORT
                      (    forth6809.asm):01009         
                      (    forth6809.asm):01010                  LDU   TSTU0
                      (    forth6809.asm):01011                  RTS
                      (    forth6809.asm):01012         
C182                  (    forth6809.asm):01013         TSTKEYQNAME: FCB  7
                      (    forth6809.asm):01014                      FCC  "TSTKEYQ"
                      (    forth6809.asm):01015         
                      (    forth6809.asm):01016         ; ------------------------------------------------------------
                      (    forth6809.asm):01017         ; TSTEMIT - unit test for EMIT. Verifies the actual queuing
                      (    forth6809.asm):01018         ; mechanism: saves OUTHEAD before the call, then confirms it
                      (    forth6809.asm):01019         ; advanced by exactly one (wrapping correctly via OUTBUFSZ, a
                      (    forth6809.asm):01020         ; power of two) and that the queued byte at the old OUTHEAD
                      (    forth6809.asm):01021         ; position genuinely matches the character emitted - not just
                      (    forth6809.asm):01022         ; that the call returned.
                      (    forth6809.asm):01023         ; ------------------------------------------------------------
C182                  (    forth6809.asm):01024         TSTEMIT: STU   TSTU0
                      (    forth6809.asm):01025         
                      (    forth6809.asm):01026                  LDD   #TSTGUARD
                      (    forth6809.asm):01027                  PSHU  D
                      (    forth6809.asm):01028                  LDD   #65
                      (    forth6809.asm):01029                  PSHU  D
                      (    forth6809.asm):01030                  STU   TSTUB4
                      (    forth6809.asm):01031         
                      (    forth6809.asm):01032                  JSR   EMIT
                      (    forth6809.asm):01033         
                      (    forth6809.asm):01034                  STU   TSTUAF
                      (    forth6809.asm):01035         
                      (    forth6809.asm):01036                  LDA   EMITCH  ; BUG FIX: was checking OUTHEAD/OUTBUF, assuming
                      (    forth6809.asm):01037                                 ; the interrupt-driven EMIT (SERIALPOLL=0). Real
                      (    forth6809.asm):01038                                 ; bug found via MAME: EMIT has two entirely
                      (    forth6809.asm):01039                                 ; different implementations, gated the same way
                      (    forth6809.asm):01040                                 ; as KEY's own two variants - the polling one
                      (    forth6809.asm):01041                                 ; (SERIALPOLL=1, confirmed the currently active
                      (    forth6809.asm):01042                                 ; build) writes directly to ACIADR and never
                      (    forth6809.asm):01043                                 ; touches OUTHEAD/OUTBUF at all, so that check
                      (    forth6809.asm):01044                                 ; always failed despite the character genuinely
                      (    forth6809.asm):01045                                 ; being transmitted (confirmed in the terminal
                      (    forth6809.asm):01046                                 ; output itself). EMITCH, by contrast, is set
                      (    forth6809.asm):01047                                 ; unconditionally by both variants as their very
                      (    forth6809.asm):01048                                 ; first step, before either mode-specific branch
                      (    forth6809.asm):01049                                 ; - checking it verifies the argument was
                      (    forth6809.asm):01050                                 ; correctly extracted from the stack regardless
                      (    forth6809.asm):01051                                 ; of which EMIT variant is active, with no
                      (    forth6809.asm):01052                                 ; conditional needed.
                      (    forth6809.asm):01053                  CMPA  #65
                      (    forth6809.asm):01054                  BNE   EMFAIL
                      (    forth6809.asm):01055         
                      (    forth6809.asm):01056                  PULU  D
                      (    forth6809.asm):01057                  CMPD  #TSTGUARD
                      (    forth6809.asm):01058                  BNE   EMFAIL
                      (    forth6809.asm):01059         
                      (    forth6809.asm):01060                  LDD   TSTUB4
                      (    forth6809.asm):01061                  SUBD  TSTUAF
                      (    forth6809.asm):01062                  CMPD  #-2
                      (    forth6809.asm):01063                  BNE   EMFAIL
                      (    forth6809.asm):01064         
                      (    forth6809.asm):01065                  LDD   #TRUEV
                      (    forth6809.asm):01066                  BRA   EMDONE
C182                  (    forth6809.asm):01067         EMFAIL:  LDD   #FALSEV
C182                  (    forth6809.asm):01068         EMDONE:  LDX   #TSTEMITNAME
                      (    forth6809.asm):01069                  PSHU  X
                      (    forth6809.asm):01070                  PSHU  D
                      (    forth6809.asm):01071                  JSR   TSTREPORT
                      (    forth6809.asm):01072         
                      (    forth6809.asm):01073                  LDU   TSTU0
                      (    forth6809.asm):01074                  RTS
                      (    forth6809.asm):01075         
C182                  (    forth6809.asm):01076         TSTEMITNAME: FCB  7
                      (    forth6809.asm):01077                      FCC  "TSTEMIT"
                      (    forth6809.asm):01078         
                      (    forth6809.asm):01079         ; ------------------------------------------------------------
                      (    forth6809.asm):01080         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01081         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01082         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01083         ; ------------------------------------------------------------
C182                  (    forth6809.asm):01084         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01085         
                      (    forth6809.asm):01086                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01087                  LDA   OUTHEAD
                      (    forth6809.asm):01088                  STA   TSTOHSAV
                      (    forth6809.asm):01089                  ENDC ; <<<<
                      (    forth6809.asm):01090         
                      (    forth6809.asm):01091         
                      (    forth6809.asm):01092                  LDD   #TSTGUARD
                      (    forth6809.asm):01093                  PSHU  D
                      (    forth6809.asm):01094                  STU   TSTUB4
                      (    forth6809.asm):01095         
                      (    forth6809.asm):01096                  JSR   CRW
                      (    forth6809.asm):01097         
                      (    forth6809.asm):01098                  STU   TSTUAF
                      (    forth6809.asm):01099         
                      (    forth6809.asm):01100                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01101                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01102                                   ; in order
                      (    forth6809.asm):01103                  LDA   TSTOHSAV
                      (    forth6809.asm):01104                  ADDA  #2
                      (    forth6809.asm):01105                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01106                  CMPA  OUTHEAD
                      (    forth6809.asm):01107                  BNE   CRFAIL
                      (    forth6809.asm):01108         
                      (    forth6809.asm):01109                  LDX   #OUTBUF
                      (    forth6809.asm):01110                  LDB   TSTOHSAV
                      (    forth6809.asm):01111                  LDA   B,X
                      (    forth6809.asm):01112                  CMPA  #13
                      (    forth6809.asm):01113                  BNE   CRFAIL
                      (    forth6809.asm):01114                  INCB
                      (    forth6809.asm):01115                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01116                  LDA   B,X
                      (    forth6809.asm):01117                  CMPA  #10
                      (    forth6809.asm):01118                  BNE   CRFAIL
                      (    forth6809.asm):01119                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01120                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01121                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01122                                   ; entirely different implementations, gated
                      (    forth6809.asm):01123                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01124                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01125                                   ; currently active build) writes directly to
                      (    forth6809.asm):01126                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01127                                   ; all, so this check always failed despite
                      (    forth6809.asm):01128                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01129                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01130                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01131                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01132                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01133                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01134                                   ; depth check below is the most this variant
                      (    forth6809.asm):01135                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01136                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01137                                   ; persistent state.
                      (    forth6809.asm):01138                  LDA   EMITCH
                      (    forth6809.asm):01139                  CMPA  #10
                      (    forth6809.asm):01140                  BNE   CRFAIL
                      (    forth6809.asm):01141                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01142         
                      (    forth6809.asm):01143                  PULU  D
                      (    forth6809.asm):01144                  CMPD  #TSTGUARD
                      (    forth6809.asm):01145                  BNE   CRFAIL
                      (    forth6809.asm):01146         
                      (    forth6809.asm):01147                  LDD   TSTUB4
                      (    forth6809.asm):01148                  SUBD  TSTUAF
                      (    forth6809.asm):01149                  CMPD  #0
                      (    forth6809.asm):01150                  BNE   CRFAIL
                      (    forth6809.asm):01151         
                      (    forth6809.asm):01152                  LDD   #TRUEV
                      (    forth6809.asm):01153                  BRA   CRDONE
C182                  (    forth6809.asm):01154         CRFAIL: LDD   #FALSEV
C182                  (    forth6809.asm):01155         CRDONE: LDX   #TSTCRNAME

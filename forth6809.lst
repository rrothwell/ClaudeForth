                      (    forth6809.asm):07857                  LDD   DPHERE
                      (    forth6809.asm):07858                  STD   TSTDSAV
                      (    forth6809.asm):07859                  LDD   VARHERE
                      (    forth6809.asm):07860                  STD   TSTVSAV
                      (    forth6809.asm):07861                  LDD   SRCADDR
                      (    forth6809.asm):07862                  STD   TSTSASAV
                      (    forth6809.asm):07863                  LDD   SRCLEN
                      (    forth6809.asm):07864                  STD   TSTSLSAV
                      (    forth6809.asm):07865                  LDD   TOIN
                      (    forth6809.asm):07866                  STD   TSTTISAV
                      (    forth6809.asm):07867                  LDD   LATEST
                      (    forth6809.asm):07868                  STD   TSTLSAV

                      (    forth6809.asm):09344                    PSHU D
                      (    forth6809.asm):09345                    STU  TSTUB4
                      (    forth6809.asm):09346         
                      (    forth6809.asm):09347                    LDD  CODEHERE
                      (    forth6809.asm):09348                    ADDD #30

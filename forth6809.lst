                      (    forth6809.asm):08788                   LBNE  VTFAIL  ; was BNE - out of short-branch range, since
                      (    forth6809.asm):08789                                 ; VTFAIL sits past this test's entire second
                      (    forth6809.asm):08790                                 ; round (the TO reassignment and re-check)
                      (    forth6809.asm):08791                   PULU D
                      (    forth6809.asm):08792                   CMPD #TSTGUARD
                      (    forth6809.asm):08793                   LBNE  VTFAIL  ; was BNE - same reason
                      (    forth6809.asm):08794         

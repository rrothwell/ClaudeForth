                      (    forth6809.asm):04144         
                      (    forth6809.asm):04145         ; ------------------------------------------------------------
                      (    forth6809.asm):04146         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04147         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04148         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04149         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04150         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04151         ;    Inputs:
                      (    forth6809.asm):04152         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04153         ;    Outputs:
                      (    forth6809.asm):04154         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04155         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04156         ;        scratch.
                      (    forth6809.asm):04157         ; ------------------------------------------------------------
E7FB 3706             (    forth6809.asm):04158         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E7FD DD14             (    forth6809.asm):04159                     STD   MSCR              ; MSCR = step
E7FF EC66             (    forth6809.asm):04160                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E801 262D             (    forth6809.asm):04161                     BNE   DPTEXIT           ; set: exit
E803 EC62             (    forth6809.asm):04162                     LDD   2,S               ; old index
E805 A364             (    forth6809.asm):04163                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E807 DD16             (    forth6809.asm):04164                     STD   MSCR2
E809 EC62             (    forth6809.asm):04165                     LDD   2,S
E80B D314             (    forth6809.asm):04166                     ADDD  MSCR              ; new_index = old_index + step
E80D ED62             (    forth6809.asm):04167                     STD   2,S
E80F A364             (    forth6809.asm):04168                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E811 DD18             (    forth6809.asm):04169                     STD   MSCR3
                      (    forth6809.asm):04170                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04171                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04172                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E813 DC14             (    forth6809.asm):04173                     LDD   MSCR              ; reload the step to test its sign
E815 2B09             (    forth6809.asm):04174                     BMI   DPNEG
E817 DC18             (    forth6809.asm):04175         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
E819 109316           (    forth6809.asm):04176                     CMPD  MSCR2
E81C 2512             (    forth6809.asm):04177                     BLO   DPTEXIT
E81E 2007             (    forth6809.asm):04178                     BRA   DPCONT
E820 DC18             (    forth6809.asm):04179         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E822 109316           (    forth6809.asm):04180                     CMPD  MSCR2
E825 2209             (    forth6809.asm):04181                     BHI   DPTEXIT
E827 3510             (    forth6809.asm):04182         DPCONT:     PULS  X                 ; X = branch operand address
E829 EC84             (    forth6809.asm):04183                     LDD   ,X
E82B 308B             (    forth6809.asm):04184                     LEAX  D,X
E82D 3410             (    forth6809.asm):04185                     PSHS  X
E82F 39               (    forth6809.asm):04186                     RTS
E830 3510             (    forth6809.asm):04187         DPTEXIT:    PULS  X
E832 3002             (    forth6809.asm):04188                     LEAX  2,X               ; skip the branch operand
E834 3266             (    forth6809.asm):04189                     LEAS  6,S               ; discard the loop frame
E836 3410             (    forth6809.asm):04190                     PSHS  X
E838 39               (    forth6809.asm):04191                     RTS
                      (    forth6809.asm):04192         

                      (    forth6809.asm):02133         
                      (    forth6809.asm):02134         ; ------------------------------------------------------------
                      (    forth6809.asm):02135         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02136         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02137         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02138         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02139         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02140         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02141         ; one copy pushed).
                      (    forth6809.asm):02142         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02143         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):02144         
                      (    forth6809.asm):02145                    LDD   #TSTGUARD
                      (    forth6809.asm):02146                    PSHU  D
                      (    forth6809.asm):02147                    LDD   #TSTVAL1
                      (    forth6809.asm):02148                    PSHU  D
                      (    forth6809.asm):02149                    LDD   #TSTVAL2
                      (    forth6809.asm):02150                    PSHU  D
                      (    forth6809.asm):02151                    LDD   #TSTVAL3
                      (    forth6809.asm):02152                    PSHU  D
                      (    forth6809.asm):02153                    LDD   #2
                      (    forth6809.asm):02154                    PSHU  D
                      (    forth6809.asm):02155                    STU   TSTUB4
                      (    forth6809.asm):02156         
                      (    forth6809.asm):02157                    JSR   PICK
                      (    forth6809.asm):02158         
                      (    forth6809.asm):02159                    STU   TSTUAF
                      (    forth6809.asm):02160         
                      (    forth6809.asm):02161                    PULU  D
                      (    forth6809.asm):02162                    CMPD  #TSTVAL1
                      (    forth6809.asm):02163                    BNE   PKFAIL
                      (    forth6809.asm):02164                    PULU  D
                      (    forth6809.asm):02165                    CMPD  #TSTVAL3
                      (    forth6809.asm):02166                    BNE   PKFAIL
                      (    forth6809.asm):02167                    PULU  D
                      (    forth6809.asm):02168                    CMPD  #TSTVAL2
                      (    forth6809.asm):02169                    BNE   PKFAIL
                      (    forth6809.asm):02170                    PULU  D
                      (    forth6809.asm):02171                    CMPD  #TSTVAL1
                      (    forth6809.asm):02172                    BNE   PKFAIL
                      (    forth6809.asm):02173                    PULU  D
                      (    forth6809.asm):02174                    CMPD  #TSTGUARD
                      (    forth6809.asm):02175                    BNE   PKFAIL
                      (    forth6809.asm):02176         
                      (    forth6809.asm):02177                    LDD   TSTUB4
                      (    forth6809.asm):02178                    SUBD  TSTUAF
                      (    forth6809.asm):02179                    CMPD  #0
                      (    forth6809.asm):02180                    BNE   PKFAIL
                      (    forth6809.asm):02181         
                      (    forth6809.asm):02182                    LDD   #TRUEV
                      (    forth6809.asm):02183                    BRA   PKDONE
C100                  (    forth6809.asm):02184         PKFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):02185         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):02186                    PSHU  X
                      (    forth6809.asm):02187                    PSHU  D
                      (    forth6809.asm):02188                    JSR   TSTREPORT
                      (    forth6809.asm):02189         
                      (    forth6809.asm):02190                    LDU   TSTU0
                      (    forth6809.asm):02191                    RTS
                      (    forth6809.asm):02192         
C100                  (    forth6809.asm):02193         TSTPICKNAME: FCB  7
                      (    forth6809.asm):02194                      FCC  "TSTPICK"
                      (    forth6809.asm):02195         
                      (    forth6809.asm):02196         ; ------------------------------------------------------------
                      (    forth6809.asm):02197         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):02198         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):02199         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):02200         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):02201         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):02202         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):02203         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):02204         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):02205         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02206         TSTROLL:   STU   TSTU0
                      (    forth6809.asm):02207         
                      (    forth6809.asm):02208                    LDD   #TSTGUARD
                      (    forth6809.asm):02209                    PSHU  D
                      (    forth6809.asm):02210                    LDD   #TSTVAL1
                      (    forth6809.asm):02211                    PSHU  D
                      (    forth6809.asm):02212                    LDD   #TSTVAL2
                      (    forth6809.asm):02213                    PSHU  D
                      (    forth6809.asm):02214                    LDD   #TSTVAL3
                      (    forth6809.asm):02215                    PSHU  D
                      (    forth6809.asm):02216                    LDD   #2
                      (    forth6809.asm):02217                    PSHU  D
                      (    forth6809.asm):02218                    STU   TSTUB4
                      (    forth6809.asm):02219         
                      (    forth6809.asm):02220                    JSR   ROLL
                      (    forth6809.asm):02221         
                      (    forth6809.asm):02222                    STU   TSTUAF
                      (    forth6809.asm):02223         
                      (    forth6809.asm):02224                    PULU  D
                      (    forth6809.asm):02225                    CMPD  #TSTVAL1
                      (    forth6809.asm):02226                    BNE   RLFAIL
                      (    forth6809.asm):02227                    PULU  D
                      (    forth6809.asm):02228                    CMPD  #TSTVAL3
                      (    forth6809.asm):02229                    BNE   RLFAIL
                      (    forth6809.asm):02230                    PULU  D
                      (    forth6809.asm):02231                    CMPD  #TSTVAL2
                      (    forth6809.asm):02232                    BNE   RLFAIL
                      (    forth6809.asm):02233                    PULU  D
                      (    forth6809.asm):02234                    CMPD  #TSTGUARD
                      (    forth6809.asm):02235                    BNE   RLFAIL
                      (    forth6809.asm):02236         
                      (    forth6809.asm):02237                    LDD   TSTUB4
                      (    forth6809.asm):02238                    SUBD  TSTUAF
                      (    forth6809.asm):02239                    CMPD  #-2
                      (    forth6809.asm):02240                    BNE   RLFAIL
                      (    forth6809.asm):02241         
                      (    forth6809.asm):02242                    LDD   #TRUEV
                      (    forth6809.asm):02243                    BRA   RLDONE
C100                  (    forth6809.asm):02244         RLFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):02245         RLDONE:    LDX   #TSTROLLNAME
                      (    forth6809.asm):02246                    PSHU  X
                      (    forth6809.asm):02247                    PSHU  D
                      (    forth6809.asm):02248                    JSR   TSTREPORT
                      (    forth6809.asm):02249         
                      (    forth6809.asm):02250                    LDU   TSTU0
                      (    forth6809.asm):02251                    RTS
                      (    forth6809.asm):02252         
C100                  (    forth6809.asm):02253         TSTROLLNAME: FCB  7
                      (    forth6809.asm):02254                      FCC  "TSTROLL"
                      (    forth6809.asm):02255         
                      (    forth6809.asm):02256         ; ------------------------------------------------------------
                      (    forth6809.asm):02257         ; TSTDROT - unit test for 2ROT
                      (    forth6809.asm):02258         ; ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 ). Verifies the
                      (    forth6809.asm):02259         ; rotation order of all three cell pairs, the guard beneath is
                      (    forth6809.asm):02260         ; undisturbed, and the net stack depth is unchanged.
                      (    forth6809.asm):02261         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02262         TSTDROT:   STU   TSTU0
                      (    forth6809.asm):02263         
                      (    forth6809.asm):02264                    LDD   #TSTGUARD
                      (    forth6809.asm):02265                    PSHU  D
                      (    forth6809.asm):02266                    LDD   #TSTVAL1
                      (    forth6809.asm):02267                    PSHU  D
                      (    forth6809.asm):02268                    LDD   #TSTVAL2
                      (    forth6809.asm):02269                    PSHU  D
                      (    forth6809.asm):02270                    LDD   #TSTVAL3
                      (    forth6809.asm):02271                    PSHU  D
                      (    forth6809.asm):02272                    LDD   #TSTVAL4
                      (    forth6809.asm):02273                    PSHU  D
                      (    forth6809.asm):02274                    LDD   #TSTVAL5
                      (    forth6809.asm):02275                    PSHU  D
                      (    forth6809.asm):02276                    LDD   #TSTVAL6
                      (    forth6809.asm):02277                    PSHU  D
                      (    forth6809.asm):02278                    STU   TSTUB4
                      (    forth6809.asm):02279         
                      (    forth6809.asm):02280                    JSR   DROT
                      (    forth6809.asm):02281         
                      (    forth6809.asm):02282                    STU   TSTUAF
                      (    forth6809.asm):02283         
                      (    forth6809.asm):02284                    PULU  D
                      (    forth6809.asm):02285                    CMPD  #TSTVAL2
                      (    forth6809.asm):02286                    BNE   RO2FAIL
                      (    forth6809.asm):02287                    PULU  D
                      (    forth6809.asm):02288                    CMPD  #TSTVAL1
                      (    forth6809.asm):02289                    BNE   RO2FAIL
                      (    forth6809.asm):02290                    PULU  D
                      (    forth6809.asm):02291                    CMPD  #TSTVAL6
                      (    forth6809.asm):02292                    BNE   RO2FAIL
                      (    forth6809.asm):02293                    PULU  D
                      (    forth6809.asm):02294                    CMPD  #TSTVAL5
                      (    forth6809.asm):02295                    BNE   RO2FAIL
                      (    forth6809.asm):02296                    PULU  D
                      (    forth6809.asm):02297                    CMPD  #TSTVAL4
                      (    forth6809.asm):02298                    BNE   RO2FAIL
                      (    forth6809.asm):02299                    PULU  D
                      (    forth6809.asm):02300                    CMPD  #TSTVAL3
                      (    forth6809.asm):02301                    BNE   RO2FAIL
                      (    forth6809.asm):02302                    PULU  D
                      (    forth6809.asm):02303                    CMPD  #TSTGUARD
                      (    forth6809.asm):02304                    BNE   RO2FAIL
                      (    forth6809.asm):02305         
                      (    forth6809.asm):02306                    LDD   TSTUB4
                      (    forth6809.asm):02307                    SUBD  TSTUAF
                      (    forth6809.asm):02308                    CMPD  #0
                      (    forth6809.asm):02309                    BNE   RO2FAIL
                      (    forth6809.asm):02310         
                      (    forth6809.asm):02311                    LDD   #TRUEV
                      (    forth6809.asm):02312                    BRA   RO2DONE
C100                  (    forth6809.asm):02313         RO2FAIL:   LDD   #FALSEV
C100                  (    forth6809.asm):02314         RO2DONE:   LDX   #TSTDROTNAME
                      (    forth6809.asm):02315                    PSHU  X
                      (    forth6809.asm):02316                    PSHU  D
                      (    forth6809.asm):02317                    JSR   TSTREPORT
                      (    forth6809.asm):02318         
                      (    forth6809.asm):02319                    LDU   TSTU0
                      (    forth6809.asm):02320                    RTS
                      (    forth6809.asm):02321         
C100                  (    forth6809.asm):02322         TSTDROTNAME: FCB  7
                      (    forth6809.asm):02323                      FCC  "TSTDROT"
                      (    forth6809.asm):02324         
                      (    forth6809.asm):02325                    ENDC ; <<<<
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327         ; ------------------------------------------------------------
                      (    forth6809.asm):02328         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02329         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02330         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02331         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02332         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02333         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02334         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02335         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02336         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02337         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02338         ;
                      (    forth6809.asm):02339         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02340         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02341         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02342         ; right value once.
                      (    forth6809.asm):02343         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02344         TSTRETSTACK: JSR CRW
                      (    forth6809.asm):02345                    LDX   #TSTRETMSG
                      (    forth6809.asm):02346                    PSHU  X
                      (    forth6809.asm):02347                    LDD   #8
                      (    forth6809.asm):02348                    PSHU  D
                      (    forth6809.asm):02349                    JSR   TYPE
                      (    forth6809.asm):02350                    JSR   CRW
                      (    forth6809.asm):02351         
                      (    forth6809.asm):02352                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02353         
                      (    forth6809.asm):02354                    JSR   TSTTOR
                      (    forth6809.asm):02355                    JSR   TSTRFETCH
                      (    forth6809.asm):02356                    JSR   TSTTWOTOR
                      (    forth6809.asm):02357                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02358         
                      (    forth6809.asm):02359                    ENDC ; <<<<
                      (    forth6809.asm):02360         
                      (    forth6809.asm):02361                    RTS
                      (    forth6809.asm):02362         
C100                  (    forth6809.asm):02363         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02366         
                      (    forth6809.asm):02367         ; ------------------------------------------------------------
                      (    forth6809.asm):02368         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02369         ; every other test group in this file, these words operate
                      (    forth6809.asm):02370         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02371         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02372         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02373         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02374         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02375         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02376         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02377         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02378         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02379         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02380         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02381         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02382         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02383         ; ------------------------------------------------------------
                      (    forth6809.asm):02384         
                      (    forth6809.asm):02385         ; ------------------------------------------------------------
                      (    forth6809.asm):02386         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02387         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02388         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02389         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02390         ; value would never actually have left.
                      (    forth6809.asm):02391         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02392         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02393         
                      (    forth6809.asm):02394                  LDD   #TSTGUARD
                      (    forth6809.asm):02395                  PSHU  D
                      (    forth6809.asm):02396                  LDD   #TSTVAL1
                      (    forth6809.asm):02397                  PSHU  D
                      (    forth6809.asm):02398                  STU   TSTUB4
                      (    forth6809.asm):02399         
                      (    forth6809.asm):02400                  JSR   TOR
                      (    forth6809.asm):02401         
                      (    forth6809.asm):02402                  STU   TSTUMID
                      (    forth6809.asm):02403         
                      (    forth6809.asm):02404                  LDD   TSTUB4
                      (    forth6809.asm):02405                  SUBD  TSTUMID
                      (    forth6809.asm):02406                  CMPD  #-2
                      (    forth6809.asm):02407                  BNE   TRFAIL
                      (    forth6809.asm):02408         
                      (    forth6809.asm):02409                  JSR   FROMR
                      (    forth6809.asm):02410         
                      (    forth6809.asm):02411                  STU   TSTUAF
                      (    forth6809.asm):02412         
                      (    forth6809.asm):02413                  PULU  D
                      (    forth6809.asm):02414                  CMPD  #TSTVAL1
                      (    forth6809.asm):02415                  BNE   TRFAIL
                      (    forth6809.asm):02416                  PULU  D
                      (    forth6809.asm):02417                  CMPD  #TSTGUARD
                      (    forth6809.asm):02418                  BNE   TRFAIL
                      (    forth6809.asm):02419         
                      (    forth6809.asm):02420                  LDD   TSTUB4
                      (    forth6809.asm):02421                  SUBD  TSTUAF
                      (    forth6809.asm):02422                  CMPD  #0
                      (    forth6809.asm):02423                  BNE   TRFAIL
                      (    forth6809.asm):02424         
                      (    forth6809.asm):02425                  LDD   #TRUEV
                      (    forth6809.asm):02426                  BRA   TRDONE
C100                  (    forth6809.asm):02427         TRFAIL:  LDD   #FALSEV
C100                  (    forth6809.asm):02428         TRDONE:  LDX   #TSTTORNAME
                      (    forth6809.asm):02429                  PSHU  X
                      (    forth6809.asm):02430                  PSHU  D
                      (    forth6809.asm):02431                  JSR   TSTREPORT
                      (    forth6809.asm):02432         
                      (    forth6809.asm):02433                  LDU   TSTU0
                      (    forth6809.asm):02434                  RTS
                      (    forth6809.asm):02435         
C100                  (    forth6809.asm):02436         TSTTORNAME: FCB  6
                      (    forth6809.asm):02437                     FCC  "TSTTOR"
                      (    forth6809.asm):02438         
                      (    forth6809.asm):02439         ; ------------------------------------------------------------
                      (    forth6809.asm):02440         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02441         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02442         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02443         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02444         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02445         ; not assumed from the name.
                      (    forth6809.asm):02446         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02447         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02448         
                      (    forth6809.asm):02449                    LDD  #TSTGUARD
                      (    forth6809.asm):02450                    PSHU D
                      (    forth6809.asm):02451                    LDD  #TSTVAL1
                      (    forth6809.asm):02452                    PSHU D
                      (    forth6809.asm):02453                    STU  TSTUB4
                      (    forth6809.asm):02454         
                      (    forth6809.asm):02455                    JSR  TOR
                      (    forth6809.asm):02456                    JSR  RFETCH
                      (    forth6809.asm):02457                    JSR  FROMR
                      (    forth6809.asm):02458         
                      (    forth6809.asm):02459                    STU  TSTUAF
                      (    forth6809.asm):02460         
                      (    forth6809.asm):02461                    PULU D
                      (    forth6809.asm):02462                    CMPD #TSTVAL1
                      (    forth6809.asm):02463                    BNE  RFFAIL
                      (    forth6809.asm):02464                    PULU D
                      (    forth6809.asm):02465                    CMPD #TSTVAL1
                      (    forth6809.asm):02466                    BNE  RFFAIL
                      (    forth6809.asm):02467                    PULU D
                      (    forth6809.asm):02468                    CMPD #TSTGUARD
                      (    forth6809.asm):02469                    BNE  RFFAIL
                      (    forth6809.asm):02470         
                      (    forth6809.asm):02471                    LDD  TSTUB4
                      (    forth6809.asm):02472                    SUBD TSTUAF
                      (    forth6809.asm):02473                    CMPD #2
                      (    forth6809.asm):02474                    BNE  RFFAIL
                      (    forth6809.asm):02475         
                      (    forth6809.asm):02476                    LDD  #TRUEV
                      (    forth6809.asm):02477                    BRA  RFDONE
C100                  (    forth6809.asm):02478         RFFAIL:    LDD  #FALSEV
C100                  (    forth6809.asm):02479         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02480                    PSHU X
                      (    forth6809.asm):02481                    PSHU D
                      (    forth6809.asm):02482                    JSR  TSTREPORT
                      (    forth6809.asm):02483         
                      (    forth6809.asm):02484                    LDU  TSTU0
                      (    forth6809.asm):02485                    RTS
                      (    forth6809.asm):02486         
C100                  (    forth6809.asm):02487         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02488                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02489         
                      (    forth6809.asm):02490         ; ------------------------------------------------------------
                      (    forth6809.asm):02491         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02492         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02493         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02494         ; verifying the round trip.
                      (    forth6809.asm):02495         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02496         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02497         
                      (    forth6809.asm):02498                    LDD  #TSTGUARD
                      (    forth6809.asm):02499                    PSHU D
                      (    forth6809.asm):02500                    LDD  #TSTVAL1
                      (    forth6809.asm):02501                    PSHU D
                      (    forth6809.asm):02502                    LDD  #TSTVAL2
                      (    forth6809.asm):02503                    PSHU D
                      (    forth6809.asm):02504                    STU  TSTUB4
                      (    forth6809.asm):02505         
                      (    forth6809.asm):02506                    JSR  TWOTOR
                      (    forth6809.asm):02507         
                      (    forth6809.asm):02508                    STU  TSTUMID
                      (    forth6809.asm):02509         
                      (    forth6809.asm):02510                    LDD  TSTUB4
                      (    forth6809.asm):02511                    SUBD TSTUMID
                      (    forth6809.asm):02512                    CMPD #-4
                      (    forth6809.asm):02513                    BNE  T2RFAIL
                      (    forth6809.asm):02514         
                      (    forth6809.asm):02515                    JSR  TWOFROMR
                      (    forth6809.asm):02516         
                      (    forth6809.asm):02517                    STU  TSTUAF
                      (    forth6809.asm):02518         
                      (    forth6809.asm):02519                    PULU D
                      (    forth6809.asm):02520                    CMPD #TSTVAL2
                      (    forth6809.asm):02521                    BNE  T2RFAIL
                      (    forth6809.asm):02522                    PULU D
                      (    forth6809.asm):02523                    CMPD #TSTVAL1
                      (    forth6809.asm):02524                    BNE  T2RFAIL
                      (    forth6809.asm):02525                    PULU D
                      (    forth6809.asm):02526                    CMPD #TSTGUARD
                      (    forth6809.asm):02527                    BNE  T2RFAIL
                      (    forth6809.asm):02528         
                      (    forth6809.asm):02529                    LDD  TSTUB4
                      (    forth6809.asm):02530                    SUBD TSTUAF
                      (    forth6809.asm):02531                    CMPD #0
                      (    forth6809.asm):02532                    BNE  T2RFAIL
                      (    forth6809.asm):02533         
                      (    forth6809.asm):02534                    LDD  #TRUEV
                      (    forth6809.asm):02535                    BRA  T2RDONE
C100                  (    forth6809.asm):02536         T2RFAIL:   LDD  #FALSEV
C100                  (    forth6809.asm):02537         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02538                    PSHU X
                      (    forth6809.asm):02539                    PSHU D
                      (    forth6809.asm):02540                    JSR  TSTREPORT
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542                    LDU  TSTU0
                      (    forth6809.asm):02543                    RTS
                      (    forth6809.asm):02544         
C100                  (    forth6809.asm):02545         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02546                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02547         
                      (    forth6809.asm):02548         ; ------------------------------------------------------------
                      (    forth6809.asm):02549         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02550         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02551         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02552         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02553         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02554         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02555         TSTTWORFETCH: STU  TSTU0
                      (    forth6809.asm):02556         
                      (    forth6809.asm):02557                       LDD  #TSTGUARD
                      (    forth6809.asm):02558                       PSHU D
                      (    forth6809.asm):02559                       LDD  #TSTVAL1
                      (    forth6809.asm):02560                       PSHU D
                      (    forth6809.asm):02561                       LDD  #TSTVAL2
                      (    forth6809.asm):02562                       PSHU D
                      (    forth6809.asm):02563                       STU  TSTUB4
                      (    forth6809.asm):02564         
                      (    forth6809.asm):02565                       JSR  TWOTOR
                      (    forth6809.asm):02566                       JSR  TWORFETCH
                      (    forth6809.asm):02567                       JSR  TWOFROMR
                      (    forth6809.asm):02568         
                      (    forth6809.asm):02569                       STU  TSTUAF
                      (    forth6809.asm):02570         
                      (    forth6809.asm):02571                       PULU D
                      (    forth6809.asm):02572                       CMPD #TSTVAL2
                      (    forth6809.asm):02573                       BNE  T2FFAIL
                      (    forth6809.asm):02574                       PULU D
                      (    forth6809.asm):02575                       CMPD #TSTVAL1
                      (    forth6809.asm):02576                       BNE  T2FFAIL
                      (    forth6809.asm):02577                       PULU D
                      (    forth6809.asm):02578                       CMPD #TSTVAL2
                      (    forth6809.asm):02579                       BNE  T2FFAIL
                      (    forth6809.asm):02580                       PULU D
                      (    forth6809.asm):02581                       CMPD #TSTVAL1
                      (    forth6809.asm):02582                       BNE  T2FFAIL
                      (    forth6809.asm):02583                       PULU D
                      (    forth6809.asm):02584                       CMPD #TSTGUARD
                      (    forth6809.asm):02585                       BNE  T2FFAIL
                      (    forth6809.asm):02586         
                      (    forth6809.asm):02587                       LDD  TSTUB4
                      (    forth6809.asm):02588                       SUBD TSTUAF
                      (    forth6809.asm):02589                       CMPD #4
                      (    forth6809.asm):02590                       BNE  T2FFAIL
                      (    forth6809.asm):02591         
                      (    forth6809.asm):02592                       LDD  #TRUEV
                      (    forth6809.asm):02593                       BRA  T2FDONE
C100                  (    forth6809.asm):02594         T2FFAIL:       LDD  #FALSEV
C100                  (    forth6809.asm):02595         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02596                       PSHU X
                      (    forth6809.asm):02597                       PSHU D
                      (    forth6809.asm):02598                       JSR  TSTREPORT
                      (    forth6809.asm):02599         
                      (    forth6809.asm):02600                       LDU  TSTU0
                      (    forth6809.asm):02601                       RTS
                      (    forth6809.asm):02602         
C100                  (    forth6809.asm):02603         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02604                           FCC  "TSTTWORFETCH"
                      (    forth6809.asm):02605         
                      (    forth6809.asm):02606                    ENDC ; <<<<
                      (    forth6809.asm):02607         
                      (    forth6809.asm):02608         ; ------------------------------------------------------------
                      (    forth6809.asm):02609         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02610         ; Covers every word in that section, with representative
                      (    forth6809.asm):02611         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02612         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02613         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02614         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02615         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02616         ; cases chosen.
                      (    forth6809.asm):02617         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02618         TSTSARITH: JSR   CRW
                      (    forth6809.asm):02619                    LDX   #TSTSARITHMSG
                      (    forth6809.asm):02620                    PSHU  X
                      (    forth6809.asm):02621                    LDD   #11
                      (    forth6809.asm):02622                    PSHU  D
                      (    forth6809.asm):02623                    JSR   TYPE
                      (    forth6809.asm):02624                    JSR   CRW
                      (    forth6809.asm):02625         
                      (    forth6809.asm):02626                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):02627         
                      (    forth6809.asm):02628                    JSR   TSTPLUS
                      (    forth6809.asm):02629                    JSR   TSTMINUS
                      (    forth6809.asm):02630                    JSR   TSTSTAR1
                      (    forth6809.asm):02631                    JSR   TSTSTAR2
                      (    forth6809.asm):02632                    JSR   TSTSLASH1
                      (    forth6809.asm):02633                    JSR   TSTSLASH2
                      (    forth6809.asm):02634                    JSR   TSTSLASHZ
                      (    forth6809.asm):02635                    JSR   TSTMODW
                      (    forth6809.asm):02636                    JSR   TSTMODZ
                      (    forth6809.asm):02637                    JSR   TSTSLMOD
                      (    forth6809.asm):02638                    JSR   TSTSLMODZ
                      (    forth6809.asm):02639                    JSR   TSTNEGATE
                      (    forth6809.asm):02640                    JSR   TSTABS1
                      (    forth6809.asm):02641                    JSR   TSTABS2
                      (    forth6809.asm):02642                    JSR   TSTMIN1
                      (    forth6809.asm):02643                    JSR   TSTMIN2
                      (    forth6809.asm):02644                    JSR   TSTMAX1
                      (    forth6809.asm):02645                    JSR   TSTMAX2
                      (    forth6809.asm):02646                    JSR   TSTONEP
                      (    forth6809.asm):02647                    JSR   TSTONEM
                      (    forth6809.asm):02648                    JSR   TSTTWOP
                      (    forth6809.asm):02649                    JSR   TSTTWOS
                      (    forth6809.asm):02650                    JSR   TSTTWOD1
                      (    forth6809.asm):02651                    JSR   TSTTWOD2
                      (    forth6809.asm):02652                    JSR   TSTSTSL
                      (    forth6809.asm):02653                    JSR   TSTSTSLZ
                      (    forth6809.asm):02654                    JSR   TSTSTSM
                      (    forth6809.asm):02655                    JSR   TSTSTSMZ
                      (    forth6809.asm):02656         
                      (    forth6809.asm):02657                    ENDC ; <<<<
                      (    forth6809.asm):02658         
                      (    forth6809.asm):02659                    RTS
                      (    forth6809.asm):02660         
C100                  (    forth6809.asm):02661         TSTSARITHMSG: FCC "SArithmetic"
                      (    forth6809.asm):02662         
                      (    forth6809.asm):02663                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):02664         
                      (    forth6809.asm):02665         ; ------------------------------------------------------------
                      (    forth6809.asm):02666         ; TSTPLUS - unit test for PLUS. n1 + n2, mixed signs.
                      (    forth6809.asm):02667         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02668         TSTPLUS:    STU   TSTU0
                      (    forth6809.asm):02669         
                      (    forth6809.asm):02670                    LDD   #TSTGUARD
                      (    forth6809.asm):02671                    PSHU  D
                      (    forth6809.asm):02672                    LDD   #TSTVAL1
                      (    forth6809.asm):02673                    PSHU  D
                      (    forth6809.asm):02674                    LDD   #TSTNEG1
                      (    forth6809.asm):02675                    PSHU  D
                      (    forth6809.asm):02676                    STU   TSTUB4
                      (    forth6809.asm):02677         
                      (    forth6809.asm):02678                    JSR   PLUS
                      (    forth6809.asm):02679         
                      (    forth6809.asm):02680                    STU   TSTUAF
                      (    forth6809.asm):02681         
                      (    forth6809.asm):02682                    PULU  D
                      (    forth6809.asm):02683                    CMPD  #$29A8
                      (    forth6809.asm):02684                    BNE   PLFAIL
                      (    forth6809.asm):02685                    PULU  D
                      (    forth6809.asm):02686                    CMPD  #TSTGUARD
                      (    forth6809.asm):02687                    BNE   PLFAIL
                      (    forth6809.asm):02688         
                      (    forth6809.asm):02689                    LDD   TSTUB4
                      (    forth6809.asm):02690                    SUBD  TSTUAF
                      (    forth6809.asm):02691                    CMPD  #-2
                      (    forth6809.asm):02692                    BNE   PLFAIL
                      (    forth6809.asm):02693         
                      (    forth6809.asm):02694                    LDD   #TRUEV
                      (    forth6809.asm):02695                    BRA   PLDONE
C100                  (    forth6809.asm):02696         PLFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02697         PLDONE:     LDX   #TSTPLUSNAME
                      (    forth6809.asm):02698                    PSHU  X
                      (    forth6809.asm):02699                    PSHU  D
                      (    forth6809.asm):02700                    JSR   TSTREPORT
                      (    forth6809.asm):02701         
                      (    forth6809.asm):02702                    LDU   TSTU0
                      (    forth6809.asm):02703                    RTS
                      (    forth6809.asm):02704         
C100                  (    forth6809.asm):02705         TSTPLUSNAME: FCB  7
                      (    forth6809.asm):02706                        FCC  "TSTPLUS"
                      (    forth6809.asm):02707         
                      (    forth6809.asm):02708         ; ------------------------------------------------------------
                      (    forth6809.asm):02709         ; TSTMINUS - unit test for MINUS. n1 - n2 (operand order matters).
                      (    forth6809.asm):02710         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02711         TSTMINUS:   STU   TSTU0
                      (    forth6809.asm):02712         
                      (    forth6809.asm):02713                    LDD   #TSTGUARD
                      (    forth6809.asm):02714                    PSHU  D
                      (    forth6809.asm):02715                    LDD   #TSTVAL1
                      (    forth6809.asm):02716                    PSHU  D
                      (    forth6809.asm):02717                    LDD   #TSTVAL2
                      (    forth6809.asm):02718                    PSHU  D
                      (    forth6809.asm):02719                    STU   TSTUB4
                      (    forth6809.asm):02720         
                      (    forth6809.asm):02721                    JSR   MINUS
                      (    forth6809.asm):02722         
                      (    forth6809.asm):02723                    STU   TSTUAF
                      (    forth6809.asm):02724         
                      (    forth6809.asm):02725                    PULU  D
                      (    forth6809.asm):02726                    CMPD  #$3579
                      (    forth6809.asm):02727                    BNE   MNFAIL
                      (    forth6809.asm):02728                    PULU  D
                      (    forth6809.asm):02729                    CMPD  #TSTGUARD
                      (    forth6809.asm):02730                    BNE   MNFAIL
                      (    forth6809.asm):02731         
                      (    forth6809.asm):02732                    LDD   TSTUB4
                      (    forth6809.asm):02733                    SUBD  TSTUAF
                      (    forth6809.asm):02734                    CMPD  #-2
                      (    forth6809.asm):02735                    BNE   MNFAIL
                      (    forth6809.asm):02736         
                      (    forth6809.asm):02737                    LDD   #TRUEV
                      (    forth6809.asm):02738                    BRA   MNDONE
C100                  (    forth6809.asm):02739         MNFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02740         MNDONE:     LDX   #TSTMINUSNAME
                      (    forth6809.asm):02741                    PSHU  X
                      (    forth6809.asm):02742                    PSHU  D
                      (    forth6809.asm):02743                    JSR   TSTREPORT
                      (    forth6809.asm):02744         
                      (    forth6809.asm):02745                    LDU   TSTU0
                      (    forth6809.asm):02746                    RTS
                      (    forth6809.asm):02747         
C100                  (    forth6809.asm):02748         TSTMINUSNAME: FCB  8
                      (    forth6809.asm):02749                         FCC  "TSTMINUS"
                      (    forth6809.asm):02750         
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
                      (    forth6809.asm):02752         ; TSTSTAR1 - unit test for STAR. normal signed multiply.
                      (    forth6809.asm):02753         ; ------------------------------------------------------------
C100                  (    forth6809.asm):02754         TSTSTAR1:   STU   TSTU0
                      (    forth6809.asm):02755         
                      (    forth6809.asm):02756                    LDD   #TSTGUARD
                      (    forth6809.asm):02757                    PSHU  D
                      (    forth6809.asm):02758                    LDD   #TSTVAL2
                      (    forth6809.asm):02759                    PSHU  D
                      (    forth6809.asm):02760                    LDD   #TSTNEG2
                      (    forth6809.asm):02761                    PSHU  D
                      (    forth6809.asm):02762                    STU   TSTUB4
                      (    forth6809.asm):02763         
                      (    forth6809.asm):02764                    JSR   STAR
                      (    forth6809.asm):02765         
                      (    forth6809.asm):02766                    STU   TSTUAF
                      (    forth6809.asm):02767         
                      (    forth6809.asm):02768                    PULU  D
                      (    forth6809.asm):02769                    CMPD  #$5998
                      (    forth6809.asm):02770                    BNE   S1FAIL
                      (    forth6809.asm):02771                    PULU  D
                      (    forth6809.asm):02772                    CMPD  #TSTGUARD
                      (    forth6809.asm):02773                    BNE   S1FAIL
                      (    forth6809.asm):02774         
                      (    forth6809.asm):02775                    LDD   TSTUB4
                      (    forth6809.asm):02776                    SUBD  TSTUAF
                      (    forth6809.asm):02777                    CMPD  #-2
                      (    forth6809.asm):02778                    BNE   S1FAIL
                      (    forth6809.asm):02779         
                      (    forth6809.asm):02780                    LDD   #TRUEV
                      (    forth6809.asm):02781                    BRA   S1DONE
C100                  (    forth6809.asm):02782         S1FAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):02783         S1DONE:     LDX   #TSTSTAR1NAME
                      (    forth6809.asm):02784                    PSHU  X

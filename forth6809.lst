FFCB 1F8B             (    forth6809.asm):10883                     TFR   A,DP
FFCD CEBD00           (    forth6809.asm):10884                     LDU   #SP0
FFD0 10CEC000         (    forth6809.asm):10885                     LDS   #RP0
                      (    forth6809.asm):10886         
FFD4 BDCEDF           (    forth6809.asm):10887                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):10888         
FFD7 8EFFE9           (    forth6809.asm):10889                     LDX   #WARMMSG

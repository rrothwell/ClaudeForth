                      (    forth6809.asm):06395         ; TSTIET1 - unit test for IF/ELSE/THEN, true case. Compiles
                      (    forth6809.asm):06396         ; "IF <lit 111> ELSE <lit 222> THEN" into scratch. True flag
                      (    forth6809.asm):06397         ; should take the IF-body (111) and skip the ELSE-body (222)
                      (    forth6809.asm):06398         ; via ELSE's own unconditional branch. Verified by hand-trace:
                      (    forth6809.asm):06399         ; IF's patched offset (12) lands exactly at the ELSE-body's
                      (    forth6809.asm):06400         ; start; ELSE's own patched offset (7) lands exactly past it.

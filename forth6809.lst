F863 3706             (    forth6809.asm):21550         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F865 DDAB             (    forth6809.asm):21551                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):21552                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):21553                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):21554                                   ; real source length was misread as an
                      (    forth6809.asm):21555                                   ; address, the real source address was never
                      (    forth6809.asm):21556                                   ; popped at all, and the true destination
                      (    forth6809.asm):21557                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):21558                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):21559                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):21560                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):21561                    STD  UESRCLEN
F86B 3706             (    forth6809.asm):21562                    PULU D         ; next: c-addr1 (source address)
F86D DDA7             (    forth6809.asm):21563                    STD  UEADDR
F86F CC0000           (    forth6809.asm):21564                    LDD  #0
F872 DDAD             (    forth6809.asm):21565                    STD  UEOUTLEN
F874 9EA7             (    forth6809.asm):21566                    LDX  UEADDR
F876 109EAB           (    forth6809.asm):21567                    LDY  UEDST
                      (    forth6809.asm):21568         
                      (    forth6809.asm):21569                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):21570                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):21571                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):21572                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):21573                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):21574                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):21575                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):21576                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):21577                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):21578                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):21579                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):21580                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):21581                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):21582                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):21583                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):21584                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):21585                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):21586                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):21587                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):21588         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):21589                    BEQ  UEDONE
F87D A680             (    forth6809.asm):21590                    LDA  ,X+
F87F 8125             (    forth6809.asm):21591                    CMPA #'%'
F881 2604             (    forth6809.asm):21592                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):21593                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):21594                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):21595                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):21596                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):21597                                   ; the same string correctly, since this runs
                      (    forth6809.asm):21598                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):21599         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):21600                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):21601                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):21602                    SUBD #1
F88E DDA9             (    forth6809.asm):21603                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):21604                    BRA  UELOOP
F892 1F20             (    forth6809.asm):21605         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):21606                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):21607                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):21608                                   ; required return values, and separately,
                      (    forth6809.asm):21609                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):21610                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):21611                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):21612                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):21613                                   ; characters. Now computed directly as the
                      (    forth6809.asm):21614                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):21615                                   ; original destination address (UEDST) -
                      (    forth6809.asm):21616                                   ; correct regardless of how many characters
                      (    forth6809.asm):21617                                   ; were doubled, since it's derived from
                      (    forth6809.asm):21618                                   ; where writing actually stopped rather than
                      (    forth6809.asm):21619                                   ; incremented alongside it.
F898 DCAB             (    forth6809.asm):21620                    LDD  UEDST
F89A 3606             (    forth6809.asm):21621                    PSHU D         ; push c-addr2 (destination address)
F89C DCAD             (    forth6809.asm):21622                    LDD  UEOUTLEN
F89E 3606             (    forth6809.asm):21623                    PSHU D         ; push u2 (actual unescaped length)
F8A0 39               (    forth6809.asm):21624                    RTS
                      (    forth6809.asm):21625         

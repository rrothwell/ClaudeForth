                      (    forth6809.asm):05806         ; 2SWAP  ( x1 x2 x3 x4 -- x3 x4 x1 x2 )
                      (    forth6809.asm):05807         ; Exchange the top two cell pairs.
                      (    forth6809.asm):05808         ; ------------------------------------------------------------
DEAB ECC4             (    forth6809.asm):05809         DSWAPW:     LDD   ,U                ; x4
DEAD DD14             (    forth6809.asm):05810                     STD   MSCR
DEAF EC42             (    forth6809.asm):05811                     LDD   2,U               ; x3
DEB1 AE44             (    forth6809.asm):05812                     LDX   4,U               ; x2
DEB3 10AE46           (    forth6809.asm):05813                     LDY   6,U               ; x1
DEB6 ED46             (    forth6809.asm):05814                     STD   6,U
DEB8 AFC4             (    forth6809.asm):05815                     STX   ,U
DEBA 10AF42           (    forth6809.asm):05816                     STY   2,U
DEBD DC14             (    forth6809.asm):05817                     LDD   MSCR
DEBF ED44             (    forth6809.asm):05818                     STD   4,U
DEC1 39               (    forth6809.asm):05819                     RTS
                      (    forth6809.asm):05820         
                      (    forth6809.asm):05821         ; ------------------------------------------------------------
                      (    forth6809.asm):05822         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05823         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05824         ; ------------------------------------------------------------
DEC2 EC46             (    forth6809.asm):05825         DOVERW:     LDD   6,U               ; x1
DEC4 AE44             (    forth6809.asm):05826                     LDX   4,U               ; x2
DEC6 3606             (    forth6809.asm):05827                     PSHU  D
DEC8 3610             (    forth6809.asm):05828                     PSHU  X
DECA 39               (    forth6809.asm):05829                     RTS
                      (    forth6809.asm):05830         
                      (    forth6809.asm):05831         ; ------------------------------------------------------------
                      (    forth6809.asm):05832         ; NIP  ( x1 x2 -- x2 )
                      (    forth6809.asm):05833         ; Discard the second cell.
                      (    forth6809.asm):05834         ; ------------------------------------------------------------
DECB ECC4             (    forth6809.asm):05835         NIPW:       LDD   ,U                ; x2
DECD ED42             (    forth6809.asm):05836                     STD   2,U
DECF 3342             (    forth6809.asm):05837                     LEAU  2,U
DED1 39               (    forth6809.asm):05838                     RTS
                      (    forth6809.asm):05839         
                      (    forth6809.asm):05840         ; ------------------------------------------------------------
                      (    forth6809.asm):05841         ; TUCK  ( x1 x2 -- x2 x1 x2 )
                      (    forth6809.asm):05842         ; Copy the top cell beneath the second cell.
                      (    forth6809.asm):05843         ; ------------------------------------------------------------
DED2 ECC4             (    forth6809.asm):05844         TUCKW:      LDD   ,U                ; x2

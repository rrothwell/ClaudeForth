                      (    forth6809.asm):12797                      STD  TSTSLSAV
                      (    forth6809.asm):12798                      LDD  TOIN
                      (    forth6809.asm):12799                      STD  TSTTISAV
                      (    forth6809.asm):12800         
                      (    forth6809.asm):12801                      LDA  #'H'
                      (    forth6809.asm):12802                      STA  TSTNAMEB
                      (    forth6809.asm):12803                      LDA  #'I'
                      (    forth6809.asm):12804                      STA  TSTNAMEB+1
                      (    forth6809.asm):12805                      LDA  #34
                      (    forth6809.asm):12806                      STA  TSTNAMEB+2
                      (    forth6809.asm):12807         
                      (    forth6809.asm):12808                      LDD  #TSTCBUF
                      (    forth6809.asm):12809                      STD  CODEHERE

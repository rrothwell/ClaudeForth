                      (    forth6809.asm):06700                                             ; UNESCAPEW.1 (still applies) and
                      (    forth6809.asm):06701                                             ; shadow UNESCAPEW.5
                      (    forth6809.asm):06702         
                      (    forth6809.asm):06703                     ; Double every %; copy all other characters unchanged.
                      (    forth6809.asm):06704                     ; See bugfix: UNESCAPEW.2

                      (    forth6809.asm):09203                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09204                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09205                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09206                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09207                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09208                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09209                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09210                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09211                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09212                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09213                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):09214                  STD   CODEHERE
                      (    forth6809.asm):09215         
                      (    forth6809.asm):09216                  LDD   #DUP
                      (    forth6809.asm):09217                  PSHU  D

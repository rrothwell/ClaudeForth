                      (    forth6809.asm):06818         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06819         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):06820         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):06821         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):06822         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):06823         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):06824         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):06825         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):06826         ; A result over 255 characters throws -18.
                      (    forth6809.asm):06827         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):06828         ; ------------------------------------------------------------
F44B BDDF60           (    forth6809.asm):06829         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F44E ECC4             (    forth6809.asm):06830                     LDD   ,U
F450 3406             (    forth6809.asm):06831                     PSHS  D                 ; output pointer
F452 3406             (    forth6809.asm):06832                     PSHS  D                 ; output start
F454 DC39             (    forth6809.asm):06833                     LDD   SRCADDR
F456 D33B             (    forth6809.asm):06834                     ADDD  SRCLEN
F458 3406             (    forth6809.asm):06835                     PSHS  D                 ; input end
F45A DC39             (    forth6809.asm):06836                     LDD   SRCADDR
F45C D310             (    forth6809.asm):06837                     ADDD  TOIN
F45E 1F02             (    forth6809.asm):06838                     TFR   D,Y               ; input pointer
F460 10AC60           (    forth6809.asm):06839         SQEL:       CMPY  0,S
F463 247E             (    forth6809.asm):06840                     BHS   SQEND
F465 A6A0             (    forth6809.asm):06841                     LDA   ,Y+
F467 8122             (    forth6809.asm):06842                     CMPA  #34
F469 2778             (    forth6809.asm):06843                     BEQ   SQEND
F46B 815C             (    forth6809.asm):06844                     CMPA  #92
F46D 261C             (    forth6809.asm):06845                     BNE   SQEPUT
F46F 10AC60           (    forth6809.asm):06846                     CMPY  0,S
F472 246F             (    forth6809.asm):06847                     BHS   SQEND
F474 A6A0             (    forth6809.asm):06848                     LDA   ,Y+               ; the escaped character
F476 8178             (    forth6809.asm):06849                     CMPA  #'x'

E81E DC08             (    forth6809.asm):03957                     LDD   CODEHERE
E820 3606             (    forth6809.asm):03958                     PSHU  D                 ; dest
E822 CC0003           (    forth6809.asm):03959                     LDD   #TAGDO
E825 3606             (    forth6809.asm):03960                     PSHU  D
E827 39               (    forth6809.asm):03961                     RTS
                      (    forth6809.asm):03962         
                      (    forth6809.asm):03963         ; ------------------------------------------------------------
                      (    forth6809.asm):03964         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03965         ; return address.
                      (    forth6809.asm):03966         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03967         ;    Inputs:
                      (    forth6809.asm):03968         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03969         ;    Outputs:
                      (    forth6809.asm):03970         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03971         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03972         ; ------------------------------------------------------------
E828 3706             (    forth6809.asm):03973         DOSETUP:    PULU  D                 ; index
E82A DD29             (    forth6809.asm):03974                     STD   MSCR
E82C 3706             (    forth6809.asm):03975                     PULU  D                 ; limit
E82E DD2B             (    forth6809.asm):03976                     STD   MSCR2
E830 3510             (    forth6809.asm):03977                     PULS  X
E832 CC0000           (    forth6809.asm):03978                     LDD   #0
E835 3406             (    forth6809.asm):03979                     PSHS  D
E837 DC2B             (    forth6809.asm):03980                     LDD   MSCR2
E839 3406             (    forth6809.asm):03981                     PSHS  D
E83B DC29             (    forth6809.asm):03982                     LDD   MSCR
E83D 3406             (    forth6809.asm):03983                     PSHS  D
E83F 3410             (    forth6809.asm):03984                     PSHS  X
E841 39               (    forth6809.asm):03985                     RTS
                      (    forth6809.asm):03986         
                      (    forth6809.asm):03987         ; ------------------------------------------------------------
                      (    forth6809.asm):03988         ; I  ( -- n )
                      (    forth6809.asm):03989         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):03990         ; address).
                      (    forth6809.asm):03991         ; ------------------------------------------------------------
E842 EC62             (    forth6809.asm):03992         IW:         LDD   2,S               ; n. See bugfix: IW.1
E844 3606             (    forth6809.asm):03993                     PSHU  D
E846 39               (    forth6809.asm):03994                     RTS
                      (    forth6809.asm):03995         
                      (    forth6809.asm):03996         ; ------------------------------------------------------------
                      (    forth6809.asm):03997         ; J  ( -- n )
                      (    forth6809.asm):03998         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):03999         ; address and the inner loop frame).
                      (    forth6809.asm):04000         ; ------------------------------------------------------------
E847 EC68             (    forth6809.asm):04001         JW:         LDD   8,S               ; n. See bugfix: JW.1
E849 3606             (    forth6809.asm):04002                     PSHU  D
E84B 39               (    forth6809.asm):04003                     RTS
                      (    forth6809.asm):04004         
                      (    forth6809.asm):04005         ; ------------------------------------------------------------
                      (    forth6809.asm):04006         ; LEAVE  ( -- )
                      (    forth6809.asm):04007         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04008         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04009         ; ------------------------------------------------------------
E84C CCFFFF           (    forth6809.asm):04010         LEAVEW:     LDD   #TRUEV            ; true
E84F ED66             (    forth6809.asm):04011                     STD   6,S               ; See bugfix: LEAVEW.1
E851 39               (    forth6809.asm):04012                     RTS
                      (    forth6809.asm):04013         
                      (    forth6809.asm):04014         ; ------------------------------------------------------------
                      (    forth6809.asm):04015         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04016         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04017         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04018         ; ------------------------------------------------------------
E852 3706             (    forth6809.asm):04019         LOOPW:      PULU  D
E854 10830003         (    forth6809.asm):04020                     CMPD  #TAGDO
E858 2703             (    forth6809.asm):04021                     BEQ   LOOPOK
E85A BDE60D           (    forth6809.asm):04022                     JSR   CFERR
E85D 3706             (    forth6809.asm):04023         LOOPOK:     PULU  D                 ; dest
E85F 3606             (    forth6809.asm):04024                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E861 CCE899           (    forth6809.asm):04025                     LDD   #DOTEST
E864 3606             (    forth6809.asm):04026                     PSHU  D
E866 BDEAB7           (    forth6809.asm):04027                     JSR   CCALL
E869 CC0000           (    forth6809.asm):04028                     LDD   #0
E86C 3606             (    forth6809.asm):04029                     PSHU  D
E86E BDE002           (    forth6809.asm):04030                     JSR   CODECOMMA
E871 DC08             (    forth6809.asm):04031                     LDD   CODEHERE
E873 830002           (    forth6809.asm):04032                     SUBD  #2
E876 DD39             (    forth6809.asm):04033                     STD   PFIELD
E878 3706             (    forth6809.asm):04034                     PULU  D
E87A 3606             (    forth6809.asm):04035                     PSHU  D
E87C DC39             (    forth6809.asm):04036                     LDD   PFIELD
E87E 3606             (    forth6809.asm):04037                     PSHU  D
E880 BDE677           (    forth6809.asm):04038                     JSR   PATCH
                      (    forth6809.asm):04039         
E883 ECC4             (    forth6809.asm):04040                     LDD   ,U
E885 10830007         (    forth6809.asm):04041                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E889 260D             (    forth6809.asm):04042                     BNE   LOOPDONE
E88B 3706             (    forth6809.asm):04043                     PULU  D
E88D 3710             (    forth6809.asm):04044                     PULU  X                 ; ?DO skip operand
E88F DC08             (    forth6809.asm):04045                     LDD   CODEHERE
E891 3606             (    forth6809.asm):04046                     PSHU  D
E893 3610             (    forth6809.asm):04047                     PSHU  X
E895 BDE677           (    forth6809.asm):04048                     JSR   PATCH
E898 39               (    forth6809.asm):04049         LOOPDONE:   RTS
                      (    forth6809.asm):04050         
                      (    forth6809.asm):04051         ; ------------------------------------------------------------
                      (    forth6809.asm):04052         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04053         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04054         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04055         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04056         ; DOTEST
                      (    forth6809.asm):04057         ;    Inputs:
                      (    forth6809.asm):04058         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04059         ;        first)
                      (    forth6809.asm):04060         ;    Outputs:
                      (    forth6809.asm):04061         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04062         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04063         ; ------------------------------------------------------------
E899 EC66             (    forth6809.asm):04064         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E89B 2615             (    forth6809.asm):04065                     BNE   DTEXIT            ; set: exit
E89D EC62             (    forth6809.asm):04066                     LDD   2,S               ; index
E89F C30001           (    forth6809.asm):04067                     ADDD  #1
E8A2 ED62             (    forth6809.asm):04068                     STD   2,S
E8A4 10A364           (    forth6809.asm):04069                     CMPD  4,S               ; limit
E8A7 2709             (    forth6809.asm):04070                     BEQ   DTEXIT
E8A9 3510             (    forth6809.asm):04071                     PULS  X                 ; X = branch operand address
E8AB EC84             (    forth6809.asm):04072                     LDD   ,X
E8AD 308B             (    forth6809.asm):04073                     LEAX  D,X
E8AF 3410             (    forth6809.asm):04074                     PSHS  X                 ; return to loop start
E8B1 39               (    forth6809.asm):04075                     RTS
E8B2 3510             (    forth6809.asm):04076         DTEXIT:     PULS  X
E8B4 3002             (    forth6809.asm):04077                     LEAX  2,X               ; skip the branch operand
E8B6 3266             (    forth6809.asm):04078                     LEAS  6,S               ; discard the loop frame
E8B8 3410             (    forth6809.asm):04079                     PSHS  X
E8BA 39               (    forth6809.asm):04080                     RTS
                      (    forth6809.asm):04081         
                      (    forth6809.asm):04082         ; ------------------------------------------------------------
                      (    forth6809.asm):04083         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):04084         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):04085         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04086         ; ------------------------------------------------------------
E8BB 3706             (    forth6809.asm):04087         PLUSLOOPW:  PULU  D
E8BD 10830003         (    forth6809.asm):04088                     CMPD  #TAGDO
E8C1 2703             (    forth6809.asm):04089                     BEQ   PLOOPOK
E8C3 BDE60D           (    forth6809.asm):04090                     JSR   CFERR
E8C6 3706             (    forth6809.asm):04091         PLOOPOK:    PULU  D                 ; dest
E8C8 3606             (    forth6809.asm):04092                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E8CA CCE902           (    forth6809.asm):04093                     LDD   #DOPLUSTEST
E8CD 3606             (    forth6809.asm):04094                     PSHU  D
E8CF BDEAB7           (    forth6809.asm):04095                     JSR   CCALL
E8D2 CC0000           (    forth6809.asm):04096                     LDD   #0
E8D5 3606             (    forth6809.asm):04097                     PSHU  D
E8D7 BDE002           (    forth6809.asm):04098                     JSR   CODECOMMA
E8DA DC08             (    forth6809.asm):04099                     LDD   CODEHERE
E8DC 830002           (    forth6809.asm):04100                     SUBD  #2
E8DF DD39             (    forth6809.asm):04101                     STD   PFIELD
E8E1 3706             (    forth6809.asm):04102                     PULU  D
E8E3 3606             (    forth6809.asm):04103                     PSHU  D
E8E5 DC39             (    forth6809.asm):04104                     LDD   PFIELD
E8E7 3606             (    forth6809.asm):04105                     PSHU  D
E8E9 BDE677           (    forth6809.asm):04106                     JSR   PATCH
                      (    forth6809.asm):04107         
E8EC ECC4             (    forth6809.asm):04108                     LDD   ,U
E8EE 10830007         (    forth6809.asm):04109                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
E8F2 260D             (    forth6809.asm):04110                     BNE   PLOOPDONE
E8F4 3706             (    forth6809.asm):04111                     PULU  D

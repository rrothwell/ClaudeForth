E863 2007             (    forth6809.asm):04261                     BRA   DPCONT
E865 DC2D             (    forth6809.asm):04262         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
E867 10932B           (    forth6809.asm):04263                     CMPD  MSCR2
E86A 2209             (    forth6809.asm):04264                     BHI   DPTEXIT
E86C 3510             (    forth6809.asm):04265         DPCONT:     PULS  X                 ; X = branch operand address
E86E EC84             (    forth6809.asm):04266                     LDD   ,X
E870 308B             (    forth6809.asm):04267                     LEAX  D,X
E872 3410             (    forth6809.asm):04268                     PSHS  X
E874 39               (    forth6809.asm):04269                     RTS
E875 3510             (    forth6809.asm):04270         DPTEXIT:    PULS  X

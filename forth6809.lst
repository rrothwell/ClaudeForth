                      (    forth6809.asm):15029                  PSHU D
                      (    forth6809.asm):15030                  STU  TSTUB4
                      (    forth6809.asm):15031         
                      (    forth6809.asm):15032                  JSR  BASEW
                      (    forth6809.asm):15033         
                      (    forth6809.asm):15034                  STU  TSTUAF
                      (    forth6809.asm):15035         
                      (    forth6809.asm):15036                  PULU D
                      (    forth6809.asm):15037                  CMPD #BASE
                      (    forth6809.asm):15038                  BNE  BSFAIL

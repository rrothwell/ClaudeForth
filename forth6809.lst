D6FA 20E6             (    forth6809.asm):04061                     BRA   SETTOP
                      (    forth6809.asm):04062         
                      (    forth6809.asm):04063         ; ------------------------------------------------------------
                      (    forth6809.asm):04064         ; PREVIOUS  ( -- )
                      (    forth6809.asm):04065         ; Remove the first wordlist from the search order. Throws -50 if the
                      (    forth6809.asm):04066         ; order is empty.
                      (    forth6809.asm):04067         ; ------------------------------------------------------------
D6FC 9E49             (    forth6809.asm):04068         PREVIOUSW:  LDX   ORDEND
D6FE 8C004B           (    forth6809.asm):04069                     CMPX  #ORDER

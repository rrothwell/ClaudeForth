                      (    forth6809.asm):00753         ; TSTDUP - unit test for DUP ( x -- x x ). Verifies both the
                      (    forth6809.asm):00754         ; stack's contents (the duplicate and the original both equal
                      (    forth6809.asm):00755         ; the pushed test value, and the guard beneath is undisturbed)
                      (    forth6809.asm):00756         ; and the data stack pointer's movement (exactly one cell, 2
                      (    forth6809.asm):00757         ; bytes - DUP's own net effect, not conflated with the two
                      (    forth6809.asm):00758         ; pushes that set the test up).
                      (    forth6809.asm):00759         ; ------------------------------------------------------------
C158                  (    forth6809.asm):00760         TSTDUP:    STU   TSTU0
                      (    forth6809.asm):00761         
                      (    forth6809.asm):00762                    LDD   #TSTGUARD
                      (    forth6809.asm):00763                    PSHU  D
                      (    forth6809.asm):00764                    LDD   #TSTVAL1
                      (    forth6809.asm):00765                    PSHU  D
                      (    forth6809.asm):00766                    STU   TSTUB4
                      (    forth6809.asm):00767         
                      (    forth6809.asm):00768                    JSR   DUP
                      (    forth6809.asm):00769         
                      (    forth6809.asm):00770                    STU   TSTUAF
                      (    forth6809.asm):00771         
                      (    forth6809.asm):00772                    PULU  D
                      (    forth6809.asm):00773                    CMPD  #TSTVAL1
                      (    forth6809.asm):00774                    BNE   TDFAIL
                      (    forth6809.asm):00775                    PULU  D
                      (    forth6809.asm):00776                    CMPD  #TSTVAL1
                      (    forth6809.asm):00777                    BNE   TDFAIL
                      (    forth6809.asm):00778                    PULU  D
                      (    forth6809.asm):00779                    CMPD  #TSTGUARD
                      (    forth6809.asm):00780                    BNE   TDFAIL
                      (    forth6809.asm):00781         
                      (    forth6809.asm):00782                    LDD   TSTUB4
                      (    forth6809.asm):00783                    SUBD  TSTUAF
                      (    forth6809.asm):00784                    CMPD  #2
                      (    forth6809.asm):00785                    BNE   TDFAIL
                      (    forth6809.asm):00786         
                      (    forth6809.asm):00787                    LDD   #TRUEV
                      (    forth6809.asm):00788                    BRA   TDDONE
C158                  (    forth6809.asm):00789         TDFAIL:    LDD   #FALSEV
C158                  (    forth6809.asm):00790         TDDONE:    LDX   #TSTDUPNAME
                      (    forth6809.asm):00791                    PSHU  X
                      (    forth6809.asm):00792                    PSHU  D
                      (    forth6809.asm):00793                    JSR   TSTREPORT
                      (    forth6809.asm):00794         
                      (    forth6809.asm):00795                    LDU   TSTU0
                      (    forth6809.asm):00796                    RTS
                      (    forth6809.asm):00797         

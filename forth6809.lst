                      (    forth6809.asm):01534                    PSHU  D
                      (    forth6809.asm):01535                    LDD   #TSTVAL2
                      (    forth6809.asm):01536                    PSHU  D
                      (    forth6809.asm):01537                    LDD   #TSTVAL3
                      (    forth6809.asm):01538                    PSHU  D
                      (    forth6809.asm):01539                    LDD   #2
                      (    forth6809.asm):01540                    PSHU  D
                      (    forth6809.asm):01541                    STU   TSTUB4
                      (    forth6809.asm):01542         
                      (    forth6809.asm):01543                    JSR   PICK
                      (    forth6809.asm):01544         
                      (    forth6809.asm):01545                    STU   TSTUAF
                      (    forth6809.asm):01546         
                      (    forth6809.asm):01547                    PULU  D
                      (    forth6809.asm):01548                    CMPD  #TSTVAL1
                      (    forth6809.asm):01549                    BNE   PKFAIL
                      (    forth6809.asm):01550                    PULU  D
                      (    forth6809.asm):01551                    CMPD  #TSTVAL3
                      (    forth6809.asm):01552                    BNE   PKFAIL
                      (    forth6809.asm):01553                    PULU  D
                      (    forth6809.asm):01554                    CMPD  #TSTVAL2
                      (    forth6809.asm):01555                    BNE   PKFAIL
                      (    forth6809.asm):01556                    PULU  D
                      (    forth6809.asm):01557                    CMPD  #TSTVAL1
                      (    forth6809.asm):01558                    BNE   PKFAIL
                      (    forth6809.asm):01559                    PULU  D
                      (    forth6809.asm):01560                    CMPD  #TSTGUARD
                      (    forth6809.asm):01561                    BNE   PKFAIL
                      (    forth6809.asm):01562         
                      (    forth6809.asm):01563                    LDD   TSTUB4
                      (    forth6809.asm):01564                    SUBD  TSTUAF
                      (    forth6809.asm):01565                    CMPD  #0
                      (    forth6809.asm):01566                    BNE   PKFAIL
                      (    forth6809.asm):01567         

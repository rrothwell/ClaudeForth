                      (    forth6809.asm):03800         ; ------------------------------------------------------------
                      (    forth6809.asm):03801         ; Polling versions of KEY/KEYQ/EMIT (SERIALPOLL=1) - no ring
                      (    forth6809.asm):03802         ; buffers, no interrupts, no hardware RTS/CTS handshaking (see
                      (    forth6809.asm):03803         ; PUTXON/PUTXOFF below and ACCEPT for this build's software
                      (    forth6809.asm):03804         ; substitute). Each blocks (KEY, EMIT) or checks once (KEYQ)
                      (    forth6809.asm):03805         ; directly against ACIASR.
                      (    forth6809.asm):03806         ;
                      (    forth6809.asm):03807         ; KEY additionally: (1) counts framing/overrun/parity errors into
                      (    forth6809.asm):03808         ; FECOUNT/OVRNCOUNT/PECOUNT - previously only the interrupt-driven
                      (    forth6809.asm):03809         ; IRQH path checked these bits at all, so a real UART-level error
                      (    forth6809.asm):03810         ; in a polling build went completely uncounted; (2) counts into
                      (    forth6809.asm):03811         ; POLLREADYCNT every time RDRF is already set on the very first
                      (    forth6809.asm):03812         ; check, before any spinning - a backlog signal distinct from a
                      (    forth6809.asm):03813         ; genuine OVRN, see POLLREADYCNT's own comment at its RMB.
                      (    forth6809.asm):03814         ; ------------------------------------------------------------
E476                  (    forth6809.asm):03815         KEY:
E476 B6C008           (    forth6809.asm):03816                  LDA   ACIASR
E479 8501             (    forth6809.asm):03817                  BITA  #SR_RDRF
E47B 2705             (    forth6809.asm):03818                  BEQ   KWAIT
E47D 7C017F           (    forth6809.asm):03819                  INC   POLLREADYCNT   ; character was already queued when we
E480 2007             (    forth6809.asm):03820                  BRA   KGOTSTAT       ; came back to poll - didn't need to wait
E482                  (    forth6809.asm):03821         KWAIT:
E482 B6C008           (    forth6809.asm):03822         KSPIN:   LDA   ACIASR
E485 8501             (    forth6809.asm):03823                  BITA  #SR_RDRF
E487 27F9             (    forth6809.asm):03824                  BEQ   KSPIN
E489                  (    forth6809.asm):03825         KGOTSTAT:                     ; A holds the status byte exactly as it was
                      (    forth6809.asm):03826                                        ; when RDRF first went true - check the
                      (    forth6809.asm):03827                                        ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03828                                        ; read, since reading ACIADR below clears
                      (    forth6809.asm):03829                                        ; RDRF and the latched error bits together
E489 8570             (    forth6809.asm):03830                  BITA  #SR_FE+SR_OVRN+SR_PE
E48B 2715             (    forth6809.asm):03831                  BEQ   KGETCH
E48D 8510             (    forth6809.asm):03832                  BITA  #SR_FE
E48F 2703             (    forth6809.asm):03833                  BEQ   KXFE
E491 7C017C           (    forth6809.asm):03834                  INC   FECOUNT
E494 8520             (    forth6809.asm):03835         KXFE:    BITA  #SR_OVRN
E496 2703             (    forth6809.asm):03836                  BEQ   KXOVRN
E498 7C017D           (    forth6809.asm):03837                  INC   OVRNCOUNT
E49B 8540             (    forth6809.asm):03838         KXOVRN:  BITA  #SR_PE
E49D 2703             (    forth6809.asm):03839                  BEQ   KGETCH
E49F 7C017E           (    forth6809.asm):03840                  INC   PECOUNT
E4A2 B6C009           (    forth6809.asm):03841         KGETCH:  LDA   ACIADR
E4A5 1F89             (    forth6809.asm):03842                  TFR   A,B
E4A7 4F               (    forth6809.asm):03843                  CLRA
E4A8 3606             (    forth6809.asm):03844                  PSHU  D
E4AA 39               (    forth6809.asm):03845                  RTS

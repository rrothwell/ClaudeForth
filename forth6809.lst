                      (    forth6809.asm):09199                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):09200                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):09201                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):09202                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09203                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09204                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09205                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09206                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09207                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09208                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09209                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09210                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09211                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09212                                   ; consistent and safe regardless of order.

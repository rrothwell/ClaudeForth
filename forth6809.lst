                      (    forth6809.asm):08199         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (    forth6809.asm):08200         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (    forth6809.asm):08201         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (    forth6809.asm):08202         ; compiled as the new behavior, terminated with RTS) - executing
                      (    forth6809.asm):08203         ; TESTWD should push 6 (5 fetched, then incremented).
                      (    forth6809.asm):08204         ;
                      (    forth6809.asm):08205         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (    forth6809.asm):08206         ; return": it patches LATEST's behavior field using the return
                      (    forth6809.asm):08207         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (    forth6809.asm):08208         ; SECOND return address and jumps there - designed for the
                      (    forth6809.asm):08209         ; normal case where DOES> is reached from inside an enclosing
                      (    forth6809.asm):08210         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (    forth6809.asm):08211         ; would compile), which itself has its own caller. Traced by
                      (    forth6809.asm):08212         ; hand: calling directly into the compiled "JSR SETDOES"
                      (    forth6809.asm):08213         ; instruction itself (not through an intermediate wrapper)
                      (    forth6809.asm):08214         ; naturally supplies exactly the two stack levels SETDOES
                      (    forth6809.asm):08215         ; expects - its own JSR provides the first (becoming the new
                      (    forth6809.asm):08216         ; behavior field value), and this test's own call provides the
                      (    forth6809.asm):08217         ; second (correctly resuming here afterward) - no extra
                      (    forth6809.asm):08218         ; scaffolding needed, confirmed correct rather than assumed.
                      (    forth6809.asm):08219         ; ------------------------------------------------------------
C255                  (    forth6809.asm):08220         TSTCRDOES: LDD  CODEHERE
                      (    forth6809.asm):08221                    STD  TSTCSAV
                      (    forth6809.asm):08222                    LDD  DPHERE
                      (    forth6809.asm):08223                    STD  TSTDSAV
                      (    forth6809.asm):08224                    LDD  VARHERE
                      (    forth6809.asm):08225                    STD  TSTVSAV
                      (    forth6809.asm):08226                    LDD  SRCADDR
                      (    forth6809.asm):08227                    STD  TSTSASAV
                      (    forth6809.asm):08228                    LDD  SRCLEN
                      (    forth6809.asm):08229                    STD  TSTSLSAV
                      (    forth6809.asm):08230                    LDD  TOIN
                      (    forth6809.asm):08231                    STD  TSTTISAV
                      (    forth6809.asm):08232                    LDD  LATEST
                      (    forth6809.asm):08233                    STD  TSTLSAV

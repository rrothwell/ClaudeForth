                      (    forth6809.asm):01767                                             ; by restoring the CC.
                      (    forth6809.asm):01768         ; ------------------------------------------------------------
                      (    forth6809.asm):01769         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):01770         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):01771         ; GETCHAR
                      (    forth6809.asm):01772         ;    Inputs:
                      (    forth6809.asm):01773         ;        none
                      (    forth6809.asm):01774         ;    Outputs:
                      (    forth6809.asm):01775         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):01776         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):01777         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01778         ; ------------------------------------------------------------
DDBF                  (    forth6809.asm):01779         GETCHAR:
DDBF F60177           (    forth6809.asm):01780                     LDB   INTAIL            ; Is the out buffer populated?
DDC2 F10176           (    forth6809.asm):01781                     CMPB  INHEAD
DDC5 271D             (    forth6809.asm):01782                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):01783         
DDC7 8E0180           (    forth6809.asm):01784                     LDX   #INBUF            ; Pull character from the out buffer.
DDCA A685             (    forth6809.asm):01785                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):01786         
DDCC 5C               (    forth6809.asm):01787                     INCB                    ; Update the tail pointer
DDCD C43F             (    forth6809.asm):01788                     ANDB  #INBUFSZ-1        ; to point to the next character.
DDCF F70177           (    forth6809.asm):01789                     STB   INTAIL
                      (    forth6809.asm):01790         
                      (    forth6809.asm):01791                     ; Mask IRQ so the flow-control check cannot race the

                      (    forth6809.asm):03563         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03564         ; ============================================================
                      (    forth6809.asm):03565                  IFEQ SERIALPOLL  ; >>>>>>>>>>
E5EF B60176           (    forth6809.asm):03566         X_KEY:     LDA   INHEAD
E5F2 B10177           (    forth6809.asm):03567                  CMPA  INTAIL
E5F5 271B             (    forth6809.asm):03568                  BEQ   KEY
E5F7 8E0180           (    forth6809.asm):03569                  LDX   #INBUF
E5FA F60177           (    forth6809.asm):03570                  LDB   INTAIL
E5FD A685             (    forth6809.asm):03571                  LDA   B,X
E5FF 5C               (    forth6809.asm):03572                  INCB
E600 C43F             (    forth6809.asm):03573                  ANDB  #INBUFSZ-1
E602 F70177           (    forth6809.asm):03574                  STB   INTAIL
E605 3402             (    forth6809.asm):03575                  PSHS  A               ; stash the char on the return stack across
                      (    forth6809.asm):03576                                         ; the call - JSR/RTS is self-balancing, so
                      (    forth6809.asm):03577                                         ; this needs no dedicated scratch global
E607 BDDE47           (    forth6809.asm):03578                  JSR   RTSCHECKLO
E60A 3502             (    forth6809.asm):03579                  PULS  A
E60C 1F89             (    forth6809.asm):03580                  TFR   A,B
E60E 4F               (    forth6809.asm):03581                  CLRA
E60F 3606             (    forth6809.asm):03582                  PSHU  D
E611 39               (    forth6809.asm):03583                  RTS
                      (    forth6809.asm):03584         
                      (    forth6809.asm):03585         ; ------------------------------------------------------------
                      (    forth6809.asm):03586         ; KEY ( -- char )
                      (    forth6809.asm):03587         ; ------------------------------------------------------------
E612                  (    forth6809.asm):03588         KEY:
E612 7D0178           (    forth6809.asm):03589                     TST   INREQUEST         ; Is throttling?
E615 2707             (    forth6809.asm):03590                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03591         
E617 1A50             (    forth6809.asm):03592                     ORCC  #$50              ; Yes! Enter critical section
E619 BDDDC0           (    forth6809.asm):03593                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer, 
                      (    forth6809.asm):03594                                             ; by transmitting chars.
E61C 1CAF             (    forth6809.asm):03595                     ANDCC #$AF              ; Exit critical section
                      (    forth6809.asm):03596         
E61E                  (    forth6809.asm):03597         TRY_READ:
E61E BDDE2B           (    forth6809.asm):03598                     JSR   GETCHAR           ; Is char available in input buffer.
E621 25EF             (    forth6809.asm):03599                     BCS   KEY               ; No? Try again to receive a char,
                      (    forth6809.asm):03600                                             ; while still transmitting!
                      (    forth6809.asm):03601                 
E623 1F89             (    forth6809.asm):03602                     TFR   A,B               ; Move char result to Reg B (LSB of D)
E625 4F               (    forth6809.asm):03603                     CLRA                    ; Clear MSB.
E626 3606             (    forth6809.asm):03604                     PSHU  D                                     ; Return result on data stack.
E628 39               (    forth6809.asm):03605                     RTS                     
                      (    forth6809.asm):03606         
                      (    forth6809.asm):03607         ; ------------------------------------------------------------
                      (    forth6809.asm):03608         ; KEY? ( -- flag )
                      (    forth6809.asm):03609         ; ------------------------------------------------------------
E629                  (    forth6809.asm):03610         KEYQ:  
E629 B60176           (    forth6809.asm):03611                     LDA   INHEAD            ; Characters received?
E62C B10177           (    forth6809.asm):03612                     CMPA  INTAIL
E62F 2606             (    forth6809.asm):03613                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03614         
E631 CC0000           (    forth6809.asm):03615                     LDD   #FALSEV           ; No! Return false result.
E634 3606             (    forth6809.asm):03616                     PSHU  D
E636 39               (    forth6809.asm):03617                     RTS
                      (    forth6809.asm):03618         
E637                  (    forth6809.asm):03619         KQTRUE:     
E637 CCFFFF           (    forth6809.asm):03620                     LDD   #TRUEV            ; Yes! Return true result.
E63A 3606             (    forth6809.asm):03621                     PSHU  D                 ; Push 16-bit cell to Stack (U)
E63C 39               (    forth6809.asm):03622                     RTS
                      (    forth6809.asm):03623         ; ------------------------------------------------------------

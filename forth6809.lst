F4BA 39               (    forth6809.asm):06462                     RTS
F4BB 3261             (    forth6809.asm):06463         PEMP:       LEAS  1,S
F4BD 16004B           (    forth6809.asm):06464                     LBRA  PNEMPTY
                      (    forth6809.asm):06465         
                      (    forth6809.asm):06466         ; ------------------------------------------------------------
                      (    forth6809.asm):06467         ; PARSE-NAME  ( "<spaces>name<space>" -- c-addr u )
                      (    forth6809.asm):06468         ; Skip leading blanks, then parse a blank-delimited name and return
                      (    forth6809.asm):06469         ; it. An empty result is returned at the end of the input.
                      (    forth6809.asm):06470         ; ------------------------------------------------------------
F4C0 DC10             (    forth6809.asm):06471         PARSENAMEW: LDD   TOIN
F4C2 9E4C             (    forth6809.asm):06472                     LDX   SRCADDR

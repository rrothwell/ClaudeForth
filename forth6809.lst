                      (    forth6809.asm):16087         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):16088         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):16089         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):16090         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):16091         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):16092         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):16093         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):16094         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):16095         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):16096         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):16097         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):16098         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):16099                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):16100                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):16101                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):16102                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):16103                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):16104                  FDB   ABORT
                      (    forth6809.asm):16105         
DEBE 04               (    forth6809.asm):16106         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):16107                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):16108                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):16109                  FDB   QUIT
                      (    forth6809.asm):16110         
                      (    forth6809.asm):16111         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):16112         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):16113         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):16114         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):16115         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):16116         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):16117         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):16118                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):16119                  FDB   H_QUIT
DECE E476             (    forth6809.asm):16120                  FDB   FIND
                      (    forth6809.asm):16121         
DED0 01               (    forth6809.asm):16122         H_1:     FCB   1
DED1 31               (    forth6809.asm):16123                  FCC   "1"
DED2 DEC7             (    forth6809.asm):16124                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):16125                  FDB   ONEBODY
                      (    forth6809.asm):16126         
DED6 02               (    forth6809.asm):16127         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):16128                  FCC   "-1"
DED9 DED0             (    forth6809.asm):16129                  FDB   H_1
DEDB FF49             (    forth6809.asm):16130                  FDB   MONEBODY
                      (    forth6809.asm):16131         
DEDD 01               (    forth6809.asm):16132         H_2:     FCB   1
DEDE 32               (    forth6809.asm):16133                  FCC   "2"
DEDF DED6             (    forth6809.asm):16134                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):16135                  FDB   TWOBODY
                      (    forth6809.asm):16136         
DEE3 02               (    forth6809.asm):16137         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):16138                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):16139                  FDB   H_2
DEE8 FF55             (    forth6809.asm):16140                  FDB   MTWOBODY
                      (    forth6809.asm):16141         
     DEE3             (    forth6809.asm):16142         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):16143                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):16144                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):16145                                   ; were chained on after it; before that,
                      (    forth6809.asm):16146                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):16147                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):16148                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):16149                                   ; before this one.
                      (    forth6809.asm):16150         
                      (    forth6809.asm):16151         ; Verify no collision with base code.
                      (    forth6809.asm):16152         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):16153         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):16154         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):16155         
                      (    forth6809.asm):16156         ; ============================================================
                      (    forth6809.asm):16157         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):16158         ; ============================================================
                      (    forth6809.asm):16159                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):16160                                        ; entirely - every routine from here through
                      (    forth6809.asm):16161                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):16162                                        ; every primitive) would otherwise have
                      (    forth6809.asm):16163                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):16164                                        ; WARM message left the location counter,
                      (    forth6809.asm):16165                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):16166                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):16167                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):16168         
                      (    forth6809.asm):16169         ; ------------------------------------------------------------
                      (    forth6809.asm):16170         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):16171         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):16172         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):16173         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):16174         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):16175         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):16176         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):16177                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):16178                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):16179                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):16180                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):16181                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):16182                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):16183                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):16184                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):16185                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):16186                  RTS
                      (    forth6809.asm):16187         
                      (    forth6809.asm):16188                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):16189         ; ------------------------------------------------------------
                      (    forth6809.asm):16190         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):16191         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):16192         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):16193         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):16194         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16195         INFILL:  LDA   INHEAD
                      (    forth6809.asm):16196                  SUBA  INTAIL
                      (    forth6809.asm):16197                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):16198                  RTS
                      (    forth6809.asm):16199         
                      (    forth6809.asm):16200         ; ------------------------------------------------------------
                      (    forth6809.asm):16201         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):16202         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):16203         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):16204         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):16205         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):16206         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):16207         ; flow control, not a chip feature.
                      (    forth6809.asm):16208         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16209         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):16210                     CMPA #INHIWATER
                      (    forth6809.asm):16211                     BLO  RTSCHIDONE
                      (    forth6809.asm):16212                     TST  RTSSTATE
                      (    forth6809.asm):16213                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):16214                     LDA  #CR_RTSHI
                      (    forth6809.asm):16215                     STA  ACIACR
                      (    forth6809.asm):16216                     LDA  #1
                      (    forth6809.asm):16217                     STA  RTSSTATE
DEF5                  (    forth6809.asm):16218         RTSCHIDONE: RTS
                      (    forth6809.asm):16219         
                      (    forth6809.asm):16220         ; ------------------------------------------------------------
                      (    forth6809.asm):16221         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):16222         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):16223         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):16224         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):16225         ; drained to INLOWATER or below and RTS is currently high,
                      (    forth6809.asm):16226         ; reassert RTS low - restoring TX-interrupt-enable too if
                      (    forth6809.asm):16227         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):16228         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):16229         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):16230         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):16231         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):16232                     CMPA #INLOWATER
                      (    forth6809.asm):16233                     BHI  RTSCLODONE
                      (    forth6809.asm):16234                     TST  RTSSTATE
                      (    forth6809.asm):16235                     BEQ  RTSCLODONE       ; already low - nothing to do
                      (    forth6809.asm):16236                     ORCC #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):16237                     CLR  RTSSTATE
                      (    forth6809.asm):16238                     LDB  OUTTAIL
                      (    forth6809.asm):16239                     CMPB OUTHEAD
                      (    forth6809.asm):16240                     BEQ  RTSCLONOTX
                      (    forth6809.asm):16241                     LDA  #CR_RXTX
                      (    forth6809.asm):16242                     STA  ACIACR
                      (    forth6809.asm):16243                     BRA  RTSCLOUNMASK
DEF5                  (    forth6809.asm):16244         RTSCLONOTX: LDA  #CR_RXON
                      (    forth6809.asm):16245                     STA  ACIACR
DEF5                  (    forth6809.asm):16246         RTSCLOUNMASK: ANDCC #$EF
DEF5                  (    forth6809.asm):16247         RTSCLODONE: RTS
                      (    forth6809.asm):16248         
DEF5                  (    forth6809.asm):16249         IRQH:    LDA   ACIASR
                      (    forth6809.asm):16250                  BITA  #SR_IRQ
                      (    forth6809.asm):16251                  BEQ   IRQDONE
                      (    forth6809.asm):16252         

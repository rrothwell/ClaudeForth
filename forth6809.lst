E547 27C5             (    forth6809.asm):03978                  BEQ   ALOOP
E549 830001           (    forth6809.asm):03979                  SUBD  #1
E54C DD39             (    forth6809.asm):03980                  STD   ACNT
E54E CC0008           (    forth6809.asm):03981                  LDD   #8

                      (    forth6809.asm):02592         
DDB7 CEBD00           (    forth6809.asm):02593         ABORT:   LDU   #SP0
                      (    forth6809.asm):02594                  ; falls through into QUIT
                      (    forth6809.asm):02595         
DDBA 10CEC000         (    forth6809.asm):02596         QUIT:    LDS   #RP0
DDBE CC0000           (    forth6809.asm):02597                  LDD   #0        ; BUG FIX: this reset used to live at QLOOP
DDC1 DD00             (    forth6809.asm):02598                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02599                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02600                                   ; that spans more than one line of input.
                      (    forth6809.asm):02601                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02602                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02603                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02604                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02605                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02606                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02607                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02608                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02609                                   ; been reached. A colon definition split
                      (    forth6809.asm):02610                                   ; across multiple lines would have every
                      (    forth6809.asm):02611                                   ; word on every line after the first
                      (    forth6809.asm):02612                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02613                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02614                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02615                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02616                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02617                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02618                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02619                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02620                                   ; uncaught error routing back through ABORT

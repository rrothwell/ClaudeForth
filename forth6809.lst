                      (    forth6809.asm):21088                                      ; DIVCOMMON (shared by /, MOD, /MOD)
                      (    forth6809.asm):21089                                      ; against this system's own SM/REM and
                      (    forth6809.asm):21090                                      ; FM/MOD: DIVCOMMON restores the
                      (    forth6809.asm):21091                                      ; remainder's sign from DNSIGN (the
                      (    forth6809.asm):21092                                      ; dividend's own original sign) after
                      (    forth6809.asm):21093                                      ; dividing absolute values - exactly
                      (    forth6809.asm):21094                                      ; SM/REM's own logic, confirmed identical
                      (    forth6809.asm):21095                                      ; by direct comparison. FM/MOD, by
                      (    forth6809.asm):21096                                      ; contrast, has an explicit flooring
                      (    forth6809.asm):21097                                      ; adjustment step (correcting the
                      (    forth6809.asm):21098                                      ; quotient and remainder when the
                      (    forth6809.asm):21099                                      ; quotient would be negative with a
                      (    forth6809.asm):21100                                      ; nonzero remainder) that DIVCOMMON does
                      (    forth6809.asm):21101                                      ; not have. This system's primary
                      (    forth6809.asm):21102                                      ; division words (/, MOD, /MOD) use
                      (    forth6809.asm):21103                                      ; symmetric division, not floored -
                      (    forth6809.asm):21104                                      ; FLOORED is 0 (false), a real, meaningful
                      (    forth6809.asm):21105                                      ; answer (recognized query, value false),
                      (    forth6809.asm):21106                                      ; not the "unrecognized" fallthrough
                      (    forth6809.asm):21107                                      ; WORDLISTS correctly uses.

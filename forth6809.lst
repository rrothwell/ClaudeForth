                      (    forth6809.asm):06540         ; starting from 0; verified by hand-trace across all 5
                      (    forth6809.asm):06541         ; iterations (0->1->2->3->4->5, exiting exactly on reaching 5,
                      (    forth6809.asm):06542         ; not one iteration early or late) before writing. The patched
                      (    forth6809.asm):06543         ; back-edge offset is negative (-17), the same PATCH routine
                      (    forth6809.asm):06544         ; used for forward references handling both directions
                      (    forth6809.asm):06545         ; correctly based on relative position.
                      (    forth6809.asm):06546         ; ------------------------------------------------------------

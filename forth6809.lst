                      (    forth6809.asm):01715         ; TSTQDUPZ - unit test for ?DUP ( n -- n n | 0 ), zero case.
                      (    forth6809.asm):01716         ; Verifies zero is left alone - no duplicate is pushed - the
                      (    forth6809.asm):01717         ; guard beneath is undisturbed, and the net stack depth is
                      (    forth6809.asm):01718         ; unchanged.

FEF8 10830004         (    forth6809.asm):08527                     CMPD  #4
FEFC 2734             (    forth6809.asm):08528                     BEQ   BR4
FEFE 10830006         (    forth6809.asm):08529                     CMPD  #6
FF02 26E7             (    forth6809.asm):08530                     BNE   BRNEXT
FF04 C606             (    forth6809.asm):08531                     LDB   #6
FF06 108EFF62         (    forth6809.asm):08532                     LDY   #BRSELSE
FF0A 3410             (    forth6809.asm):08533                     PSHS  X
FF0C BDFF54           (    forth6809.asm):08534                     JSR   BRCMP
FF0F 3510             (    forth6809.asm):08535                     PULS  X
FF11 2609             (    forth6809.asm):08536                     BNE   BR6B

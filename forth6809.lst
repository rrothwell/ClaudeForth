                      (    forth6809.asm):01713         ; ------------------------------------------------------------
                      (    forth6809.asm):01714         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):01715         ; Covers every word in that section, with representative
                      (    forth6809.asm):01716         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):01717         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):01718         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):01719         ; defined-truncation-not-error overflow behavior). See the

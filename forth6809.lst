                      (    forth6809.asm):08219         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (    forth6809.asm):08220         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (    forth6809.asm):08221         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (    forth6809.asm):08222         ; compiled as the new behavior, terminated with RTS) - executing
                      (    forth6809.asm):08223         ; TESTWD should push 6 (5 fetched, then incremented).
                      (    forth6809.asm):08224         ;
                      (    forth6809.asm):08225         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (    forth6809.asm):08226         ; return": it patches LATEST's behavior field using the return
                      (    forth6809.asm):08227         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (    forth6809.asm):08228         ; SECOND return address and jumps there - designed for the
                      (    forth6809.asm):08229         ; normal case where DOES> is reached from inside an enclosing
                      (    forth6809.asm):08230         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (    forth6809.asm):08231         ; would compile), which itself has its own caller. Traced by
                      (    forth6809.asm):08232         ; hand: calling directly into the compiled "JSR SETDOES"
                      (    forth6809.asm):08233         ; instruction itself (not through an intermediate wrapper)
                      (    forth6809.asm):08234         ; naturally supplies exactly the two stack levels SETDOES
                      (    forth6809.asm):08235         ; expects - its own JSR provides the first (becoming the new
                      (    forth6809.asm):08236         ; behavior field value), and this test's own call provides the
                      (    forth6809.asm):08237         ; second (correctly resuming here afterward) - no extra
                      (    forth6809.asm):08238         ; scaffolding needed, confirmed correct rather than assumed.
                      (    forth6809.asm):08239         ; ------------------------------------------------------------
C264                  (    forth6809.asm):08240         TSTCRDOES: LDD  CODEHERE
                      (    forth6809.asm):08241                    STD  TSTCSAV
                      (    forth6809.asm):08242                    LDD  DPHERE
                      (    forth6809.asm):08243                    STD  TSTDSAV
                      (    forth6809.asm):08244                    LDD  VARHERE
                      (    forth6809.asm):08245                    STD  TSTVSAV
                      (    forth6809.asm):08246                    LDD  SRCADDR
                      (    forth6809.asm):08247                    STD  TSTSASAV
                      (    forth6809.asm):08248                    LDD  SRCLEN
                      (    forth6809.asm):08249                    STD  TSTSLSAV
                      (    forth6809.asm):08250                    LDD  TOIN
                      (    forth6809.asm):08251                    STD  TSTTISAV
                      (    forth6809.asm):08252                    LDD  LATEST
                      (    forth6809.asm):08253                    STD  TSTLSAV

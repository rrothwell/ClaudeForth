                      (    forth6809.asm):02550         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02551         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02552         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02553         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02554         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02555         ; ------------------------------------------------------------

                      (    forth6809.asm):11868                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):11869                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):11870                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):11871                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):11872                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):11873                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):11874                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):11875                   ; high cell.
E5C3 0D22             (    forth6809.asm):11876                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):11877                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):11878                   LDD   UDLO
E5C9 43               (    forth6809.asm):11879                   COMA
E5CA 53               (    forth6809.asm):11880                   COMB
E5CB C30001           (    forth6809.asm):11881                   ADDD  #1
E5CE DD76             (    forth6809.asm):11882                   STD   UDLO
E5D0 3401             (    forth6809.asm):11883                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):11884                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):11885                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):11886                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):11887                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):11888                                      ; silently overwrote the real carry here
                      (    forth6809.asm):11889                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):11890                                      ; making the high-cell increment run
                      (    forth6809.asm):11891                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):11892                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):11893                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):11894                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):11895                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):11896                                      ; matching "always increment" rather than
                      (    forth6809.asm):11897                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):11898                   LDD   UDHI
E5D4 43               (    forth6809.asm):11899                   COMA
E5D5 53               (    forth6809.asm):11900                   COMB
E5D6 3501             (    forth6809.asm):11901                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):11902                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):11903                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):11904                                      ; when there's no carry - the complemented
                      (    forth6809.asm):11905                                      ; value was computed in D but never
                      (    forth6809.asm):11906                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):11907                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):11908                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):11909                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):11910                                      ; was always seen as set, so this branch
                      (    forth6809.asm):11911                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):11912                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):11913                                      ; alone would have made this second,
                      (    forth6809.asm):11914                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):11915                                      ; only past the "+1", never past the
                      (    forth6809.asm):11916                                      ; store itself - the store always runs,
                      (    forth6809.asm):11917                                      ; either way.
E5DA C30001           (    forth6809.asm):11918                   ADDD  #1
E5DD DD74             (    forth6809.asm):11919         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):11920         
E5DF                  (    forth6809.asm):11921         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):11922                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):11923                   LDX   CADDR
E5E1 E684             (    forth6809.asm):11924                   LDB   ,X
E5E3 5A               (    forth6809.asm):11925                   DECB
E5E4 3001             (    forth6809.asm):11926                   LEAX  1,X
E5E6 A685             (    forth6809.asm):11927                   LDA   B,X
E5E8 812E             (    forth6809.asm):11928                   CMPA  #'.'
E5EA 260E             (    forth6809.asm):11929                   BNE   NQSINGLE
                      (    forth6809.asm):11930         
                      (    forth6809.asm):11931                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):11932                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):11933                   ; apart without needing a separate flag of its own either
E5EC DC76             (    forth6809.asm):11934                   LDD   UDLO
E5EE 3606             (    forth6809.asm):11935                   PSHU  D
E5F0 DC74             (    forth6809.asm):11936                   LDD   UDHI
E5F2 3606             (    forth6809.asm):11937                   PSHU  D
E5F4 CC0001           (    forth6809.asm):11938                   LDD   #1

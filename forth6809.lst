E2BD 20B5             (    forth6809.asm):02999                     BRA   ILOOP
                      (    forth6809.asm):03000         
E2BF                  (    forth6809.asm):03001         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03002                                             ; ANS's (ud1) stack order directly.
E2BF DC00             (    forth6809.asm):03003                     LDD   STATE
E2C1 27B1             (    forth6809.asm):03004                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03005                                             ; nothing more to do
                      (    forth6809.asm):03006                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03007                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03008                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03009                     ; pop it aside first, freeing UDLO to be compiled first.
E2C3 3706             (    forth6809.asm):03010                     PULU  D

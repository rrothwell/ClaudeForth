F487 26F8             (    forth6809.asm):06636                     BNE   SQEFND
F489 A61F             (    forth6809.asm):06637                     LDA   -1,X
F48B AE64             (    forth6809.asm):06638         SQEPUT:     LDX   4,S
F48D A780             (    forth6809.asm):06639                     STA   ,X+
F48F AF64             (    forth6809.asm):06640                     STX   4,S
F491 20CD             (    forth6809.asm):06641                     BRA   SQEL
F493 AE64             (    forth6809.asm):06642         SQEM:       LDX   4,S
F495 860D             (    forth6809.asm):06643                     LDA   #13
F497 A780             (    forth6809.asm):06644                     STA   ,X+
F499 860A             (    forth6809.asm):06645                     LDA   #10
F49B A780             (    forth6809.asm):06646                     STA   ,X+
F49D AF64             (    forth6809.asm):06647                     STX   4,S
F49F 20BF             (    forth6809.asm):06648                     BRA   SQEL
F4A1 8D1A             (    forth6809.asm):06649         SQEHEX:     BSR   SQEHD             ; first digit
F4A3 25BB             (    forth6809.asm):06650                     BCS   SQEL              ; none: nothing is added

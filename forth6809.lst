                      (    forth6809.asm):07697         ; SECTION 24: ENVIRONMENTAL QUERY / SOURCE / REFILL / EVALUATE
                      (    forth6809.asm):07698         ; ============================================================
                      (    forth6809.asm):07699         ; ------------------------------------------------------------
                      (    forth6809.asm):07700         ; SOURCE  ( -- c-addr u )

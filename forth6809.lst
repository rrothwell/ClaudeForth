FFF0 0000             (    forth6809.asm):07882         VRESV    FDB   $0000
FFF2 DD5E             (    forth6809.asm):07883         VSWI3    FDB   SWI3H
FFF4 DD5F             (    forth6809.asm):07884         VSWI2    FDB   SWI2H
FFF6 DD60             (    forth6809.asm):07885         VFIRQ    FDB   FIRQH
FFF8 DD5D             (    forth6809.asm):07886         VIRQ     FDB   IRQH
FFFA DD62             (    forth6809.asm):07887         VSWI     FDB   SWIH
FFFC FFC5             (    forth6809.asm):07888         VNMI     FDB   WARM            ; NMI -> warm restart
FFFE FFA4             (    forth6809.asm):07889         VRESET   FDB   COLDSTRT
                      (    forth6809.asm):07890         
     0000             (    forth6809.asm):07891         VECTOREND  EQU   *          ; Verify vectors size, value should match $10.

                      (    forth6809.asm):06114                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):06115                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):06116                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):06117                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):06118                                   ; The high byte took on the fill character's
                      (    forth6809.asm):06119                                   ; value instead of the count's real high
                      (    forth6809.asm):06120                                   ; byte, so the count almost never reached

                      (    forth6809.asm):10580         
                      (    forth6809.asm):10581         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):10582         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):10583         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):10584         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):10585         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):10586         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):10587         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):10588         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):10589         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):10590         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):10591         ; were chained on after H_QUIT in a later turn.
DEB4 05               (    forth6809.asm):10592         H_ABORT: FCB   5
DEB5 41424F5254       (    forth6809.asm):10593                  FCC   "ABORT"
DEBA DEAA             (    forth6809.asm):10594                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):10595                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):10596                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):10597                                        ; now H_FALSE, the chain's newest entry
DEBC DF37             (    forth6809.asm):10598                  FDB   ABORT
                      (    forth6809.asm):10599         
DEBE 04               (    forth6809.asm):10600         H_QUIT:  FCB   4
DEBF 51554954         (    forth6809.asm):10601                  FCC   "QUIT"
DEC3 DEB4             (    forth6809.asm):10602                  FDB   H_ABORT
DEC5 DF3A             (    forth6809.asm):10603                  FDB   QUIT
                      (    forth6809.asm):10604         
                      (    forth6809.asm):10605         ; FIND had no dictionary entry at all - confirmed by checking for
                      (    forth6809.asm):10606         ; any H_FIND label or FCC "FIND" string anywhere in this file
                      (    forth6809.asm):10607         ; before adding this. Its actual implementation (verified before
                      (    forth6809.asm):10608         ; exposing it) already matches the standard stack effect exactly:
                      (    forth6809.asm):10609         ; success pushes xt then 1 (immediate) or -1 (normal); failure
                      (    forth6809.asm):10610         ; reconstructs and pushes the original c-addr, then 0.
DEC7 04               (    forth6809.asm):10611         H_FIND:  FCB   4
DEC8 46494E44         (    forth6809.asm):10612                  FCC   "FIND"
DECC DEBE             (    forth6809.asm):10613                  FDB   H_QUIT
DECE E476             (    forth6809.asm):10614                  FDB   FIND
                      (    forth6809.asm):10615         
DED0 01               (    forth6809.asm):10616         H_1:     FCB   1
DED1 31               (    forth6809.asm):10617                  FCC   "1"
DED2 DEC7             (    forth6809.asm):10618                  FDB   H_FIND
DED4 FF43             (    forth6809.asm):10619                  FDB   ONEBODY
                      (    forth6809.asm):10620         
DED6 02               (    forth6809.asm):10621         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):10622                  FCC   "-1"
DED9 DED0             (    forth6809.asm):10623                  FDB   H_1
DEDB FF49             (    forth6809.asm):10624                  FDB   MONEBODY
                      (    forth6809.asm):10625         
DEDD 01               (    forth6809.asm):10626         H_2:     FCB   1
DEDE 32               (    forth6809.asm):10627                  FCC   "2"
DEDF DED6             (    forth6809.asm):10628                  FDB   H_M1
DEE1 FF4F             (    forth6809.asm):10629                  FDB   TWOBODY
                      (    forth6809.asm):10630         
DEE3 02               (    forth6809.asm):10631         H_M2:    FCB   2
DEE4 2D32             (    forth6809.asm):10632                  FCC   "-2"
DEE6 DEDD             (    forth6809.asm):10633                  FDB   H_2
DEE8 FF55             (    forth6809.asm):10634                  FDB   MTWOBODY
                      (    forth6809.asm):10635         
     DEE3             (    forth6809.asm):10636         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):10637                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):10638                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):10639                                   ; were chained on after it; before that,
                      (    forth6809.asm):10640                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):10641                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):10642                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):10643                                   ; before this one.
                      (    forth6809.asm):10644         
                      (    forth6809.asm):10645         ; Verify no collision with base code.
                      (    forth6809.asm):10646         ; Value should match ORG BASECODE
     DEEA             (    forth6809.asm):10647         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):10648         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):10649         
                      (    forth6809.asm):10650         ; ============================================================
                      (    forth6809.asm):10651         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):10652         ; ============================================================
                      (    forth6809.asm):10653                  ORG   BASECODE       ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):10654                                        ; entirely - every routine from here through
                      (    forth6809.asm):10655                                        ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):10656                                        ; every primitive) would otherwise have
                      (    forth6809.asm):10657                                        ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):10658                                        ; WARM message left the location counter,
                      (    forth6809.asm):10659                                        ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):10660                                        ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):10661                                        ; instead of landing in BASECODE at all
                      (    forth6809.asm):10662         
                      (    forth6809.asm):10663         ; ------------------------------------------------------------
                      (    forth6809.asm):10664         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):10665         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):10666         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):10667         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):10668         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):10669         ; ------------------------------------------------------------
DEEA 8603             (    forth6809.asm):10670         INITSERIAL: LDA   #$03
DEEC B7C008           (    forth6809.asm):10671                  STA   ACIACR         ; was "STA ACIA" - only correct by
                      (    forth6809.asm):10672                                        ; coincidence while ACIA and ACIACR were
                      (    forth6809.asm):10673                                        ; the same address; now genuinely distinct
                      (    forth6809.asm):10674                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):10675                  LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):10676                  ELSE  ; <<<<<>>>>>
DEEF 8615             (    forth6809.asm):10677                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):10678                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):10679                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):10680                  RTS
                      (    forth6809.asm):10681         
                      (    forth6809.asm):10682                  IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):10683         ; ------------------------------------------------------------
                      (    forth6809.asm):10684         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):10685         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):10686         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):10687         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):10688         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):10689         INFILL:  LDA   INHEAD
                      (    forth6809.asm):10690                  SUBA  INTAIL
                      (    forth6809.asm):10691                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):10692                  RTS
                      (    forth6809.asm):10693         
                      (    forth6809.asm):10694         ; ------------------------------------------------------------
                      (    forth6809.asm):10695         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):10696         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):10697         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):10698         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):10699         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):10700         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):10701         ; flow control, not a chip feature.
                      (    forth6809.asm):10702         ; ------------------------------------------------------------
DEF5                  (    forth6809.asm):10703         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):10704                     CMPA #INHIWATER
                      (    forth6809.asm):10705                     BLO  RTSCHIDONE
                      (    forth6809.asm):10706                     TST  RTSSTATE
                      (    forth6809.asm):10707                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):10708                     LDA  #CR_RTSHI
                      (    forth6809.asm):10709                     STA  ACIACR
                      (    forth6809.asm):10710                     LDA  #1
                      (    forth6809.asm):10711                     STA  RTSSTATE
DEF5                  (    forth6809.asm):10712         RTSCHIDONE: RTS
                      (    forth6809.asm):10713         
                      (    forth6809.asm):10714         ; ------------------------------------------------------------
                      (    forth6809.asm):10715         ; RTSCHECKLO - called from mainline code (KEY), NOT from the
                      (    forth6809.asm):10716         ; ISR, so it must mask IRQ around its critical section: IRQH's
                      (    forth6809.asm):10717         ; own TXOFF path also writes ACIACR, and an interrupt landing
                      (    forth6809.asm):10718         ; mid-decision here could otherwise race it. If the ring has
                      (    forth6809.asm):10719         ; drained to INLOWATER or below and RTS is currently high,

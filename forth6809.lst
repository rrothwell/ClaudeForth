                      (    forth6809.asm):07946         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):07947         ; ============================================================
                      (    forth6809.asm):07948         ; ------------------------------------------------------------
                      (    forth6809.asm):07949         ; TRUE  ( -- flag )
                      (    forth6809.asm):07950         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):07951         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):07952         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):07953         ; ------------------------------------------------------------
FE30 CCFFFF           (    forth6809.asm):07954         TRUEW:      LDD   #$FFFF
FE33 3606             (    forth6809.asm):07955                     PSHU  D
FE35 39               (    forth6809.asm):07956                     RTS
                      (    forth6809.asm):07957         
                      (    forth6809.asm):07958         ; ------------------------------------------------------------
                      (    forth6809.asm):07959         ; FALSE  ( -- flag )
                      (    forth6809.asm):07960         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):07961         ; ------------------------------------------------------------
FE36 CC0000           (    forth6809.asm):07962         FALSEW:     LDD   #$0000
FE39 3606             (    forth6809.asm):07963                     PSHU  D
FE3B 39               (    forth6809.asm):07964                     RTS
                      (    forth6809.asm):07965         
                      (    forth6809.asm):07966         ; ------------------------------------------------------------
                      (    forth6809.asm):07967         ; 1  ( -- 1 )
                      (    forth6809.asm):07968         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):07969         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):07970         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):07971         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):07972         ; ------------------------------------------------------------
FE3C CC0001           (    forth6809.asm):07973         POSONEW:    LDD   #1
FE3F 3606             (    forth6809.asm):07974                     PSHU  D
FE41 39               (    forth6809.asm):07975                     RTS
                      (    forth6809.asm):07976         
                      (    forth6809.asm):07977         ; ------------------------------------------------------------
                      (    forth6809.asm):07978         ; -1  ( -- -1 )
                      (    forth6809.asm):07979         ; Push the constant -1.
                      (    forth6809.asm):07980         ; ------------------------------------------------------------
FE42 CCFFFF           (    forth6809.asm):07981         NEGONEW:    LDD   #-1
FE45 3606             (    forth6809.asm):07982                     PSHU  D
FE47 39               (    forth6809.asm):07983                     RTS
                      (    forth6809.asm):07984         
                      (    forth6809.asm):07985         ; ------------------------------------------------------------
                      (    forth6809.asm):07986         ; 2  ( -- 2 )
                      (    forth6809.asm):07987         ; Push the constant 2.
                      (    forth6809.asm):07988         ; ------------------------------------------------------------
FE48 CC0002           (    forth6809.asm):07989         POSTWOW:    LDD   #2
FE4B 3606             (    forth6809.asm):07990                     PSHU  D
FE4D 39               (    forth6809.asm):07991                     RTS
                      (    forth6809.asm):07992         
                      (    forth6809.asm):07993         ; ------------------------------------------------------------
                      (    forth6809.asm):07994         ; -2  ( -- -2 )
                      (    forth6809.asm):07995         ; Push the constant -2.
                      (    forth6809.asm):07996         ; ------------------------------------------------------------
FE4E CCFFFE           (    forth6809.asm):07997         NEGTWOW:    LDD   #-2
FE51 3606             (    forth6809.asm):07998                     PSHU  D
FE53 39               (    forth6809.asm):07999                     RTS
                      (    forth6809.asm):08000         
                      (    forth6809.asm):08001         ; Verify no collision with init code,
                      (    forth6809.asm):08002         ; value should match ORG INITCODE.
     FE54             (    forth6809.asm):08003         BASECODEEND EQU   *
     2190             (    forth6809.asm):08004         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):08005         
                      (    forth6809.asm):08006         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08007         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):08008         ; .bin file.
FE54                  (    forth6809.asm):08009         BASEND:

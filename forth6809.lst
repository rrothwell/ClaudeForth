                      (    forth6809.asm):03982         ; TSTLOGIC - logic, shift, and address-arithmetic tests (glossary
                      (    forth6809.asm):03983         ; section 3.6). Covers every word in that section. Several of
                      (    forth6809.asm):03984         ; these (INVERT, CELLS, CELL+, CHARS, CHAR+, ALIGNED) modify the
                      (    forth6809.asm):03985         ; top of stack in place (LDD/op/STD) rather than PULU/PSHU - the
                      (    forth6809.asm):03986         ; tests verify what's observable via the stack either way, not
                      (    forth6809.asm):03987         ; how each implementation gets there. Three words (CHARS, ALIGN,
                      (    forth6809.asm):03988         ; ALIGNED) are documented no-ops on this system; CHARS/ALIGNED
                      (    forth6809.asm):03989         ; still get a normal single-value test (verifying identity),
                      (    forth6809.asm):03990         ; while ALIGN - which takes no stack arguments at all - gets a
                      (    forth6809.asm):03991         ; dedicated test pushing decoy values to confirm the whole stack,
                      (    forth6809.asm):03992         ; not just one value, is genuinely undisturbed. RSHIFT tested
                      (    forth6809.asm):03993         ; against a negative input specifically, since it's documented
                      (    forth6809.asm):03994         ; logical (zero-fill), not arithmetic (sign-preserving) - the
                      (    forth6809.asm):03995         ; case that actually distinguishes the two conventions, same
                      (    forth6809.asm):03996         ; reasoning already applied to 2/ and FM/MOD vs SM/REM earlier.
                      (    forth6809.asm):03997         ; ------------------------------------------------------------
C1A2 BDFC2B           (    forth6809.asm):03998         TSTLOGIC:  JSR   CRW
C1A5 8EC1B6           (    forth6809.asm):03999                    LDX   #TSTLOGICMSG

                      (    forth6809.asm):07833         ; ------------------------------------------------------------
                      (    forth6809.asm):07834         ; FALSE  ( -- flag )
                      (    forth6809.asm):07835         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):07836         ; ------------------------------------------------------------
FD5A CC0000           (    forth6809.asm):07837         FALSEW:     LDD   #$0000
FD5D 3606             (    forth6809.asm):07838                     PSHU  D
FD5F 39               (    forth6809.asm):07839                     RTS
                      (    forth6809.asm):07840         
                      (    forth6809.asm):07841         ; ------------------------------------------------------------
                      (    forth6809.asm):07842         ; 1  ( -- 1 )
                      (    forth6809.asm):07843         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):07844         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):07845         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):07846         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):07847         ; ------------------------------------------------------------
FD60 CC0001           (    forth6809.asm):07848         POSONEW:    LDD   #1
FD63 3606             (    forth6809.asm):07849                     PSHU  D
FD65 39               (    forth6809.asm):07850                     RTS
                      (    forth6809.asm):07851         
                      (    forth6809.asm):07852         ; ------------------------------------------------------------
                      (    forth6809.asm):07853         ; -1  ( -- -1 )
                      (    forth6809.asm):07854         ; Push the constant -1.
                      (    forth6809.asm):07855         ; ------------------------------------------------------------
FD66 CCFFFF           (    forth6809.asm):07856         NEGONEW:    LDD   #-1
FD69 3606             (    forth6809.asm):07857                     PSHU  D
FD6B 39               (    forth6809.asm):07858                     RTS
                      (    forth6809.asm):07859         
                      (    forth6809.asm):07860         ; ------------------------------------------------------------
                      (    forth6809.asm):07861         ; 2  ( -- 2 )
                      (    forth6809.asm):07862         ; Push the constant 2.
                      (    forth6809.asm):07863         ; ------------------------------------------------------------
FD6C CC0002           (    forth6809.asm):07864         POSTWOW:    LDD   #2
FD6F 3606             (    forth6809.asm):07865                     PSHU  D
FD71 39               (    forth6809.asm):07866                     RTS
                      (    forth6809.asm):07867         
                      (    forth6809.asm):07868         ; ------------------------------------------------------------
                      (    forth6809.asm):07869         ; -2  ( -- -2 )
                      (    forth6809.asm):07870         ; Push the constant -2.
                      (    forth6809.asm):07871         ; ------------------------------------------------------------
FD72 CCFFFE           (    forth6809.asm):07872         NEGTWOW:    LDD   #-2
FD75 3606             (    forth6809.asm):07873                     PSHU  D
FD77 39               (    forth6809.asm):07874                     RTS

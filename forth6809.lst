                      (    forth6809.asm):01073         ; TSTQDUPZ - unit test for ?DUP ( n -- n n | 0 ), zero case.
                      (    forth6809.asm):01074         ; Verifies zero is left alone - no duplicate is pushed - the
                      (    forth6809.asm):01075         ; guard beneath is undisturbed, and the net stack depth is
                      (    forth6809.asm):01076         ; unchanged.
                      (    forth6809.asm):01077         ; ------------------------------------------------------------
C15E                  (    forth6809.asm):01078         TSTQDUPZ:  STU   TSTU0
                      (    forth6809.asm):01079         
                      (    forth6809.asm):01080                    LDD   #TSTGUARD
                      (    forth6809.asm):01081                    PSHU  D
                      (    forth6809.asm):01082                    LDD   #0
                      (    forth6809.asm):01083                    PSHU  D
                      (    forth6809.asm):01084                    STU   TSTUB4
                      (    forth6809.asm):01085         
                      (    forth6809.asm):01086                    JSR   QDUP
                      (    forth6809.asm):01087         
                      (    forth6809.asm):01088                    STU   TSTUAF
                      (    forth6809.asm):01089         
                      (    forth6809.asm):01090                    PULU  D
                      (    forth6809.asm):01091                    CMPD  #0
                      (    forth6809.asm):01092                    BNE   QZFAIL
                      (    forth6809.asm):01093                    PULU  D
                      (    forth6809.asm):01094                    CMPD  #TSTGUARD
                      (    forth6809.asm):01095                    BNE   QZFAIL
                      (    forth6809.asm):01096         
                      (    forth6809.asm):01097                    LDD   TSTUB4
                      (    forth6809.asm):01098                    SUBD  TSTUAF
                      (    forth6809.asm):01099                    CMPD  #0
                      (    forth6809.asm):01100                    BNE   QZFAIL
                      (    forth6809.asm):01101         
                      (    forth6809.asm):01102                    LDD   #TRUEV
                      (    forth6809.asm):01103                    BRA   QZDONE
C15E                  (    forth6809.asm):01104         QZFAIL:    LDD   #FALSEV
C15E                  (    forth6809.asm):01105         QZDONE:    LDX   #TSTQZNAME
                      (    forth6809.asm):01106                    PSHU  X
                      (    forth6809.asm):01107                    PSHU  D
                      (    forth6809.asm):01108                    JSR   TSTREPORT
                      (    forth6809.asm):01109         
                      (    forth6809.asm):01110                    LDU   TSTU0
                      (    forth6809.asm):01111                    RTS
                      (    forth6809.asm):01112         
C15E                  (    forth6809.asm):01113         TSTQZNAME: FCB  8
                      (    forth6809.asm):01114                    FCC  "TSTQDUPZ"

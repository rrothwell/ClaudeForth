                      (    forth6809.asm):05292         ; UNLOOP  ( -- )
                      (    forth6809.asm):05293         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05294         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05295         ; ------------------------------------------------------------
DC2D 3510             (    forth6809.asm):05296         UNLOOPW:    PULS  X
DC2F 3266             (    forth6809.asm):05297                     LEAS  6,S
DC31 3410             (    forth6809.asm):05298                     PSHS  X
DC33 39               (    forth6809.asm):05299                     RTS
                      (    forth6809.asm):05300         
                      (    forth6809.asm):05301         ; ------------------------------------------------------------
                      (    forth6809.asm):05302         ; EXIT  ( -- )
                      (    forth6809.asm):05303         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05304         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05305         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05306         ; ------------------------------------------------------------
DC34 108E0000         (    forth6809.asm):05307         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DC38 1F31             (    forth6809.asm):05308                     TFR   U,X               ; X = scan pointer
DC3A 9C21             (    forth6809.asm):05309         EXSCAN:     CMPX  CSP
DC3C 270E             (    forth6809.asm):05310                     BEQ   EXSCANDONE
DC3E EC84             (    forth6809.asm):05311                     LDD   ,X
DC40 10830003         (    forth6809.asm):05312                     CMPD  #TAGDO
DC44 2602             (    forth6809.asm):05313                     BNE   EXNOTDO
DC46 3121             (    forth6809.asm):05314                     LEAY  1,Y
DC48 3004             (    forth6809.asm):05315         EXNOTDO:    LEAX  4,X
DC4A 20EE             (    forth6809.asm):05316                     BRA   EXSCAN
DC4C                  (    forth6809.asm):05317         EXSCANDONE:
DC4C 3420             (    forth6809.asm):05318                     PSHS  Y                 ; the count survives CCALL on S
DC4E CCDC5E           (    forth6809.asm):05319                     LDD   #EXITUNLOOP
DC51 3606             (    forth6809.asm):05320                     PSHU  D
DC53 BDDD40           (    forth6809.asm):05321                     JSR   CCALL
DC56 3506             (    forth6809.asm):05322                     PULS  D
DC58 3606             (    forth6809.asm):05323                     PSHU  D
DC5A BDCFD6           (    forth6809.asm):05324                     JSR   CODECOMMA
DC5D 39               (    forth6809.asm):05325                     RTS
                      (    forth6809.asm):05326         
                      (    forth6809.asm):05327         ; ------------------------------------------------------------
                      (    forth6809.asm):05328         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05329         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05330         ; EXITUNLOOP
                      (    forth6809.asm):05331         ;    Inputs:
                      (    forth6809.asm):05332         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05333         ;        address
                      (    forth6809.asm):05334         ;    Outputs:
                      (    forth6809.asm):05335         ;        returns to the caller of the definition
                      (    forth6809.asm):05336         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05337         ; ------------------------------------------------------------
DC5E 3510             (    forth6809.asm):05338         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DC60 3520             (    forth6809.asm):05339                     PULS  Y                 ; Y = return address
DC62 6EA4             (    forth6809.asm):05340                     JMP   ,Y
                      (    forth6809.asm):05341         
                      (    forth6809.asm):05342         ; ------------------------------------------------------------
                      (    forth6809.asm):05343         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05344         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05345         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05346         ; ------------------------------------------------------------
DC64 CC0000           (    forth6809.asm):05347         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1

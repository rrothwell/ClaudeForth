                      (    forth6809.asm):06861                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):06862                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):06863                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):06864                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):06865                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):06866                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):06867                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):06868                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):06869                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):06870                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):06871                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):06872                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):06873                  ; for it.
E591 D621             (    forth6809.asm):06874                  LDB   CNTREM
E593 5A               (    forth6809.asm):06875                  DECB
E594 A685             (    forth6809.asm):06876                  LDA   B,X
E596 812E             (    forth6809.asm):06877                  CMPA  #'.'
E598 2604             (    forth6809.asm):06878                  BNE   NQNOSIGN
E59A 0A21             (    forth6809.asm):06879                  DEC   CNTREM
E59C 2766             (    forth6809.asm):06880                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):06881         
E59E 0F22             (    forth6809.asm):06882         NQNOSIGN: CLR   NUMNEG
E5A0 A684             (    forth6809.asm):06883                  LDA   ,X
E5A2 812D             (    forth6809.asm):06884                  CMPA  #'-'
E5A4 2608             (    forth6809.asm):06885                  BNE   NQNOSIGN2
E5A6 0322             (    forth6809.asm):06886                  COM   NUMNEG
E5A8 3001             (    forth6809.asm):06887                  LEAX  1,X
E5AA 0A21             (    forth6809.asm):06888                  DEC   CNTREM
E5AC 2756             (    forth6809.asm):06889                  BEQ   NQBAD
                      (    forth6809.asm):06890         

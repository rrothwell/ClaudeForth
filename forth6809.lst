                      (    forth6809.asm):14148                     STD  CODEHERE
                      (    forth6809.asm):14149         
                      (    forth6809.asm):14150                     LDU  TSTU0
                      (    forth6809.asm):14151                     RTS
                      (    forth6809.asm):14152         

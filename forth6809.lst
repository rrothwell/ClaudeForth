                      (    forth6809.asm):02040         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):02041         ; receiver-error counters to zero.
                      (    forth6809.asm):02042         ; SERBUFCLR
                      (    forth6809.asm):02043         ;    Inputs:
                      (    forth6809.asm):02044         ;        none
                      (    forth6809.asm):02045         ;    Outputs:
                      (    forth6809.asm):02046         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02047         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02048         ;    Registers: only CC changed.
                      (    forth6809.asm):02049         ; Original comment: shadow SERBUFCLR.0.

                      (    forth6809.asm):02182                    LDD   #TSTVAL2
                      (    forth6809.asm):02183                    PSHU  D
                      (    forth6809.asm):02184                    LDD   #TSTVAL3
                      (    forth6809.asm):02185                    PSHU  D
                      (    forth6809.asm):02186                    LDD   #2
                      (    forth6809.asm):02187                    PSHU  D
                      (    forth6809.asm):02188                    STU   TSTUB4
                      (    forth6809.asm):02189         
                      (    forth6809.asm):02190                    JSR   PICK
                      (    forth6809.asm):02191         
                      (    forth6809.asm):02192                    STU   TSTUAF
                      (    forth6809.asm):02193         
                      (    forth6809.asm):02194                    PULU  D
                      (    forth6809.asm):02195                    CMPD  #TSTVAL1
                      (    forth6809.asm):02196                    BNE   PKFAIL
                      (    forth6809.asm):02197                    PULU  D
                      (    forth6809.asm):02198                    CMPD  #TSTVAL3
                      (    forth6809.asm):02199                    BNE   PKFAIL
                      (    forth6809.asm):02200                    PULU  D
                      (    forth6809.asm):02201                    CMPD  #TSTVAL2
                      (    forth6809.asm):02202                    BNE   PKFAIL
                      (    forth6809.asm):02203                    PULU  D
                      (    forth6809.asm):02204                    CMPD  #TSTVAL1
                      (    forth6809.asm):02205                    BNE   PKFAIL
                      (    forth6809.asm):02206                    PULU  D
                      (    forth6809.asm):02207                    CMPD  #TSTGUARD
                      (    forth6809.asm):02208                    BNE   PKFAIL
                      (    forth6809.asm):02209         
                      (    forth6809.asm):02210                    LDD   TSTUB4
                      (    forth6809.asm):02211                    SUBD  TSTUAF

                      (    forth6809.asm):10870         ; ------------------------------------------------------------
                      (    forth6809.asm):10871         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):10872         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):10873         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):10874         ; WARM
                      (    forth6809.asm):10875         ;    Inputs:
                      (    forth6809.asm):10876         ;        NMI
                      (    forth6809.asm):10877         ;    Outputs:
                      (    forth6809.asm):10878         ;        does not return
                      (    forth6809.asm):10879         ;    Registers: all registers initialised.
                      (    forth6809.asm):10880         ; ------------------------------------------------------------

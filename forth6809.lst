                      (   unit_tests.asm):10297         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (   unit_tests.asm):10298         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (   unit_tests.asm):10299         ; IS tests, but gets its own dedicated test here too.
                      (   unit_tests.asm):10300         ;
                      (   unit_tests.asm):10301         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (   unit_tests.asm):10302         ; itself (a pure address computation) - wrong, confirmed via
                      (   unit_tests.asm):10303         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (   unit_tests.asm):10304         ; returning the VALUE stored there, not the address itself. This
                      (   unit_tests.asm):10305         ; is genuinely correct behavior for this system's own trampoline
                      (   unit_tests.asm):10306         ; design, not a bug in TOBODY - reconciled directly against why
                      (   unit_tests.asm):10307         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (   unit_tests.asm):10308         ; same TOBODY and passed on real hardware, never surfaced this:
                      (   unit_tests.asm):10309         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (   unit_tests.asm):10310         ; own compile-time code stores a genuinely meaningful value at
                      (   unit_tests.asm):10311         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (   unit_tests.asm):10312         ; value) - "the body" for this system's own design IS the value
                      (   unit_tests.asm):10313         ; at xt+5, not xt+5's own address. This test never initialized
                      (   unit_tests.asm):10314         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (   unit_tests.asm):10315         ; whatever garbage happened to already be there - now sets a
                      (   unit_tests.asm):10316         ; known value there first and verifies TOBODY returns exactly
                      (   unit_tests.asm):10317         ; that.
                      (   unit_tests.asm):10318         ; ------------------------------------------------------------

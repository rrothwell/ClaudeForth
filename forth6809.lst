                      (    forth6809.asm):04362                     ; single and double apart
D88B CC0001           (    forth6809.asm):04363                     LDD   #1
D88E 3606             (    forth6809.asm):04364                     PSHU  D
D890 39               (    forth6809.asm):04365                     RTS
                      (    forth6809.asm):04366         
D891 3342             (    forth6809.asm):04367         NQSINGLE:   LEAU  2,U               ; SINGLE success: drop the high cell
D893 CCFFFF           (    forth6809.asm):04368                     LDD   #-1
D896 3606             (    forth6809.asm):04369                     PSHU  D
D898 39               (    forth6809.asm):04370                     RTS
                      (    forth6809.asm):04371         
D899 3348             (    forth6809.asm):04372         NQBADF:     LEAU  8,U               ; drop the frame
D89B AEE4             (    forth6809.asm):04373         NQBAD:      LDX   ,S
D89D 3263             (    forth6809.asm):04374                     LEAS  3,S
D89F 3610             (    forth6809.asm):04375                     PSHU  X
D8A1 CC0000           (    forth6809.asm):04376                     LDD   #0
D8A4 3606             (    forth6809.asm):04377                     PSHU  D

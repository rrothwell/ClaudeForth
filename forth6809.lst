                      (    forth6809.asm):04108                    BRA   IVDONE
C100                  (    forth6809.asm):04109         IVFAIL:     LDD   #FALSEV
C100                  (    forth6809.asm):04110         IVDONE:     LDX   #TSTINVNAME

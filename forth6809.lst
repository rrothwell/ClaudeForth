                      (    forth6809.asm):01493         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):01494         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):01495         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):01496         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):01497         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):01498         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):01499         ; one copy pushed).
                      (    forth6809.asm):01500         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01501         TSTPICK:   STU   TSTU0
                      (    forth6809.asm):01502         
                      (    forth6809.asm):01503                    LDD   #TSTGUARD
                      (    forth6809.asm):01504                    PSHU  D
                      (    forth6809.asm):01505                    LDD   #TSTVAL1
                      (    forth6809.asm):01506                    PSHU  D
                      (    forth6809.asm):01507                    LDD   #TSTVAL2
                      (    forth6809.asm):01508                    PSHU  D
                      (    forth6809.asm):01509                    LDD   #TSTVAL3
                      (    forth6809.asm):01510                    PSHU  D
                      (    forth6809.asm):01511                    LDD   #2
                      (    forth6809.asm):01512                    PSHU  D
                      (    forth6809.asm):01513                    STU   TSTUB4
                      (    forth6809.asm):01514         
                      (    forth6809.asm):01515                    JSR   PICK
                      (    forth6809.asm):01516         
                      (    forth6809.asm):01517                    STU   TSTUAF
                      (    forth6809.asm):01518         
                      (    forth6809.asm):01519                    PULU  D
                      (    forth6809.asm):01520                    CMPD  #TSTVAL1
                      (    forth6809.asm):01521                    BNE   PKFAIL
                      (    forth6809.asm):01522                    PULU  D
                      (    forth6809.asm):01523                    CMPD  #TSTVAL3
                      (    forth6809.asm):01524                    BNE   PKFAIL
                      (    forth6809.asm):01525                    PULU  D
                      (    forth6809.asm):01526                    CMPD  #TSTVAL2
                      (    forth6809.asm):01527                    BNE   PKFAIL
                      (    forth6809.asm):01528                    PULU  D
                      (    forth6809.asm):01529                    CMPD  #TSTVAL1
                      (    forth6809.asm):01530                    BNE   PKFAIL
                      (    forth6809.asm):01531                    PULU  D
                      (    forth6809.asm):01532                    CMPD  #TSTGUARD
                      (    forth6809.asm):01533                    BNE   PKFAIL
                      (    forth6809.asm):01534         
                      (    forth6809.asm):01535                    LDD   TSTUB4
                      (    forth6809.asm):01536                    SUBD  TSTUAF
                      (    forth6809.asm):01537                    CMPD  #0
                      (    forth6809.asm):01538                    BNE   PKFAIL
                      (    forth6809.asm):01539         
                      (    forth6809.asm):01540                    LDD   #TRUEV
                      (    forth6809.asm):01541                    BRA   PKDONE
C100                  (    forth6809.asm):01542         PKFAIL:    LDD   #FALSEV
C100                  (    forth6809.asm):01543         PKDONE:    LDX   #TSTPICKNAME
                      (    forth6809.asm):01544                    PSHU  X
                      (    forth6809.asm):01545                    PSHU  D
                      (    forth6809.asm):01546                    JSR   TSTREPORT
                      (    forth6809.asm):01547         
                      (    forth6809.asm):01548                    LDU   TSTU0
                      (    forth6809.asm):01549                    RTS
                      (    forth6809.asm):01550         
C100                  (    forth6809.asm):01551         TSTPICKNAME: FCB  7
                      (    forth6809.asm):01552                      FCC  "TSTPICK"
                      (    forth6809.asm):01553         

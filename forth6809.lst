                      (    forth6809.asm):10858         ; ------------------------------------------------------------
                      (    forth6809.asm):10859         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10860         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10861         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10862         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10863         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10864         ; sequential walk-through per region.
                      (    forth6809.asm):10865         ;
                      (    forth6809.asm):10866         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10867         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10868         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10869         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10870         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10871         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10872         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10873         ; ------------------------------------------------------------
C26F BDFC2B           (    forth6809.asm):10874         TSTMEMORY: JSR CRW
C272 8EC283           (    forth6809.asm):10875                    LDX   #TSTMEMMSG
C275 3610             (    forth6809.asm):10876                    PSHU  X
C277 CC0006           (    forth6809.asm):10877                    LDD   #6
C27A 3606             (    forth6809.asm):10878                    PSHU  D
C27C BDF60B           (    forth6809.asm):10879                    JSR   TYPE
C27F BDFC2B           (    forth6809.asm):10880                    JSR   CRW
                      (    forth6809.asm):10881         
                      (    forth6809.asm):10882                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10883         
                      (    forth6809.asm):10884                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10885                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10886                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10887                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10888                    JSR   TSTCODEHERE
                      (    forth6809.asm):10889                    JSR   TSTVARHERE
                      (    forth6809.asm):10890                    JSR   TSTPAD
                      (    forth6809.asm):10891                    JSR   TSTUNUSED
                      (    forth6809.asm):10892                    JSR   TSTVUNUSED
                      (    forth6809.asm):10893                    JSR   TSTFILL
                      (    forth6809.asm):10894                    JSR   TSTERASE
                      (    forth6809.asm):10895                    JSR   TSTCMOVE
                      (    forth6809.asm):10896                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10897                    JSR   TSTMOVE1
                      (    forth6809.asm):10898                    JSR   TSTMOVE2
                      (    forth6809.asm):10899                    JSR   TSTMOVE3
                      (    forth6809.asm):10900         
                      (    forth6809.asm):10901                    ENDC ; <<<<
                      (    forth6809.asm):10902         
C282 39               (    forth6809.asm):10903                    RTS
                      (    forth6809.asm):10904         
C283 4D656D6F7279     (    forth6809.asm):10905         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10906         
                      (    forth6809.asm):10907                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10908         
                      (    forth6809.asm):10909         ; ------------------------------------------------------------
                      (    forth6809.asm):10910         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10911         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10912         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10913         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10914         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10915         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10916         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10917         ; runs exclusively of every other.
                      (    forth6809.asm):10918         ;
                      (    forth6809.asm):10919         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10920         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10921         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10922         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10923         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10924         ; ------------------------------------------------------------
                      (    forth6809.asm):10925         
                      (    forth6809.asm):10926         ; ------------------------------------------------------------
                      (    forth6809.asm):10927         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10928         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10929         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10930         ; ------------------------------------------------------------
C289                  (    forth6809.asm):10931         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10932         
                      (    forth6809.asm):10933                        LDD  #TSTGUARD
                      (    forth6809.asm):10934                        PSHU D
                      (    forth6809.asm):10935                        LDD  #TSTVAL1
                      (    forth6809.asm):10936                        PSHU D
                      (    forth6809.asm):10937                        LDD  #TSTCBUF
                      (    forth6809.asm):10938                        PSHU D
                      (    forth6809.asm):10939                        STU  TSTUB4
                      (    forth6809.asm):10940         
                      (    forth6809.asm):10941                        JSR  STOREW
                      (    forth6809.asm):10942         
                      (    forth6809.asm):10943                        LDD  #TSTCBUF
                      (    forth6809.asm):10944                        PSHU D
                      (    forth6809.asm):10945         
                      (    forth6809.asm):10946                        JSR  ATSIGN
                      (    forth6809.asm):10947         
                      (    forth6809.asm):10948                        STU  TSTUAF
                      (    forth6809.asm):10949         
                      (    forth6809.asm):10950                        PULU D
                      (    forth6809.asm):10951                        CMPD #TSTVAL1
                      (    forth6809.asm):10952                        BNE  FSFAIL
                      (    forth6809.asm):10953                        PULU D
                      (    forth6809.asm):10954                        CMPD #TSTGUARD
                      (    forth6809.asm):10955                        BNE  FSFAIL
                      (    forth6809.asm):10956         
                      (    forth6809.asm):10957                        LDD  TSTUB4
                      (    forth6809.asm):10958                        SUBD TSTUAF
                      (    forth6809.asm):10959                        CMPD #-2
                      (    forth6809.asm):10960                        BNE  FSFAIL
                      (    forth6809.asm):10961         
                      (    forth6809.asm):10962                        LDD  #TRUEV
                      (    forth6809.asm):10963                        BRA  FSDONE
C289                  (    forth6809.asm):10964         FSFAIL:        LDD  #FALSEV
C289                  (    forth6809.asm):10965         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):10966                        PSHU X
                      (    forth6809.asm):10967                        PSHU D
                      (    forth6809.asm):10968                        JSR  TSTREPORT
                      (    forth6809.asm):10969         
                      (    forth6809.asm):10970                        LDU  TSTU0
                      (    forth6809.asm):10971                        RTS
                      (    forth6809.asm):10972         
C289                  (    forth6809.asm):10973         TSTFSNAME: FCB  13
                      (    forth6809.asm):10974                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):10975         
                      (    forth6809.asm):10976         ; ------------------------------------------------------------
                      (    forth6809.asm):10977         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):10978         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):10979         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):10980         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):10981         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):10982         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):10983         ; whatever was there).
                      (    forth6809.asm):10984         ;
                      (    forth6809.asm):10985         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):10986         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):10987         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):10988         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):10989         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):10990         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):10991         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):10992         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):10993         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):10994         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):10995         ; byte ends up where was wrong.
                      (    forth6809.asm):10996         ; ------------------------------------------------------------
C289                  (    forth6809.asm):10997         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):10998                         STD  TSTCBUF
                      (    forth6809.asm):10999         
                      (    forth6809.asm):11000                         STU  TSTU0
                      (    forth6809.asm):11001         
                      (    forth6809.asm):11002                         LDD  #TSTGUARD
                      (    forth6809.asm):11003                         PSHU D
                      (    forth6809.asm):11004                         LDD  #$34
                      (    forth6809.asm):11005                         PSHU D
                      (    forth6809.asm):11006                         LDD  #TSTCBUF
                      (    forth6809.asm):11007                         PSHU D
                      (    forth6809.asm):11008                         STU  TSTUB4
                      (    forth6809.asm):11009         
                      (    forth6809.asm):11010                         JSR  CSTOREW
                      (    forth6809.asm):11011         
                      (    forth6809.asm):11012                         LDD  TSTCBUF
                      (    forth6809.asm):11013                         CMPD #$34FF
                      (    forth6809.asm):11014                         BNE  CFFAIL
                      (    forth6809.asm):11015         
                      (    forth6809.asm):11016                         LDD  #TSTCBUF
                      (    forth6809.asm):11017                         PSHU D
                      (    forth6809.asm):11018         
                      (    forth6809.asm):11019                         JSR  CFETCH
                      (    forth6809.asm):11020         
                      (    forth6809.asm):11021                         STU  TSTUAF
                      (    forth6809.asm):11022         
                      (    forth6809.asm):11023                         PULU D
                      (    forth6809.asm):11024                         CMPD #$0034
                      (    forth6809.asm):11025                         BNE  CFFAIL
                      (    forth6809.asm):11026                         PULU D
                      (    forth6809.asm):11027                         CMPD #TSTGUARD
                      (    forth6809.asm):11028                         BNE  CFFAIL
                      (    forth6809.asm):11029         
                      (    forth6809.asm):11030                         LDD  TSTUB4
                      (    forth6809.asm):11031                         SUBD TSTUAF
                      (    forth6809.asm):11032                         CMPD #-2
                      (    forth6809.asm):11033                         BNE  CFFAIL
                      (    forth6809.asm):11034         
                      (    forth6809.asm):11035                         LDD  #TRUEV
                      (    forth6809.asm):11036                         BRA  CFDONE
C289                  (    forth6809.asm):11037         CFFAIL:         LDD  #FALSEV
C289                  (    forth6809.asm):11038         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11039                         PSHU X
                      (    forth6809.asm):11040                         PSHU D
                      (    forth6809.asm):11041                         JSR  TSTREPORT
                      (    forth6809.asm):11042         
                      (    forth6809.asm):11043                         LDU  TSTU0
                      (    forth6809.asm):11044                         RTS
                      (    forth6809.asm):11045         
C289                  (    forth6809.asm):11046         TSTCFNAME: FCB  14
                      (    forth6809.asm):11047                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11048         
                      (    forth6809.asm):11049         ; ------------------------------------------------------------
                      (    forth6809.asm):11050         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11051         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11052         ; correctly.

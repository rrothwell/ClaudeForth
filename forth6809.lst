FEE0 10830000         (    forth6809.asm):08518                     CMPD  #0
FEE4 266D             (    forth6809.asm):08519                     BNE   BRTHENW           ; true: nothing to skip
FEE6 CC0001           (    forth6809.asm):08520         BRELSEW:    LDD   #1
FEE9 3406             (    forth6809.asm):08521                     PSHS  D                 ; level
FEEB BDF613           (    forth6809.asm):08522         BRNEXT:     JSR   PARSENAMEW
FEEE 3706             (    forth6809.asm):08523                     PULU  D                 ; length
FEF0 3710             (    forth6809.asm):08524                     PULU  X                 ; address

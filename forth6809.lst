                      (    forth6809.asm):21856                  IFNE  UNITTESTS  ; >>>>>>>>>>
FFC6 BDC135           (    forth6809.asm):21857                  JSR   TSTRUNNER
                      (    forth6809.asm):21858                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):21859                  NOP             ; BUG FIX (see the historical note above this
                      (    forth6809.asm):21860                  NOP             ; call site's own comment, describing the
                      (    forth6809.asm):21861                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):21862                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):21863                                  ; excluded the test framework, meaning
                      (    forth6809.asm):21864                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):21865                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):21866                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):21867                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):21868                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):21869                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):21870                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):21871                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):21872                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):21873                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):21874                  ENDC  ; <<<<<<<<<<

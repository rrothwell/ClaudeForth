                      (    forth6809.asm):02615         
                      (    forth6809.asm):02616                       PULU D
                      (    forth6809.asm):02617                       CMPD #TSTVAL2
                      (    forth6809.asm):02618                       BNE  T2FFAIL
                      (    forth6809.asm):02619                       PULU D
                      (    forth6809.asm):02620                       CMPD #TSTVAL1
                      (    forth6809.asm):02621                       BNE  T2FFAIL
                      (    forth6809.asm):02622                       PULU D
                      (    forth6809.asm):02623                       CMPD #TSTVAL2
                      (    forth6809.asm):02624                       BNE  T2FFAIL
                      (    forth6809.asm):02625                       PULU D
                      (    forth6809.asm):02626                       CMPD #TSTVAL1
                      (    forth6809.asm):02627                       BNE  T2FFAIL
                      (    forth6809.asm):02628                       PULU D
                      (    forth6809.asm):02629                       CMPD #TSTGUARD
                      (    forth6809.asm):02630                       BNE  T2FFAIL
                      (    forth6809.asm):02631         
                      (    forth6809.asm):02632                       LDD  TSTUB4
                      (    forth6809.asm):02633                       SUBD TSTUAF
                      (    forth6809.asm):02634                       CMPD #4
                      (    forth6809.asm):02635                       BNE  T2FFAIL
                      (    forth6809.asm):02636         
                      (    forth6809.asm):02637                       LDD  #TRUEV
                      (    forth6809.asm):02638                       BRA  T2FDONE
C1B1                  (    forth6809.asm):02639         T2FFAIL:       LDD  #FALSEV
C1B1                  (    forth6809.asm):02640         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02641                       PSHU X

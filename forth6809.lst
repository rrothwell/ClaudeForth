DE14 2708             (    forth6809.asm):01917                     BEQ   IRQDONE0          ; No! Just exit.
DE16 8501             (    forth6809.asm):01918                     BITA  #SR_RDRF          ; Is an incoming character available?
DE18 2605             (    forth6809.asm):01919                     BNE   INCHAR
DE1A 8502             (    forth6809.asm):01920                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?

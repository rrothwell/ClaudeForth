                      (    forth6809.asm):09210                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09211                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09212                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09213                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09214                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09215                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09216                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09217                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09218                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09219                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09220                                   ; consistent and safe regardless of order.

                      (    forth6809.asm):10673         ; TSTABORTQ1 - unit test for ABORT", false-flag case. Compile-
                      (    forth6809.asm):10674         ; only (throws -14 otherwise). Compiles ABORT" with a known
                      (    forth6809.asm):10675         ; message ("HI"), executes with a false flag, and verifies
                      (    forth6809.asm):10676         ; execution genuinely resumes right after the embedded message
                      (    forth6809.asm):10677         ; text - confirmed by hand-tracing DOABORTQUOTE's own code: on
                      (    forth6809.asm):10678         ; false, it skips past the inline message and returns normally,
                      (    forth6809.asm):10679         ; matching its own documented "on false flag: does nothing
                      (    forth6809.asm):10680         ; further".
                      (    forth6809.asm):10681         ; ------------------------------------------------------------
C100                  (    forth6809.asm):10682         TSTABORTQ1: LDD  CODEHERE
                      (    forth6809.asm):10683                     STD  TSTCSAV

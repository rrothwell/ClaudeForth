                      (    forth6809.asm):02200                    PSHU  D
                      (    forth6809.asm):02201                    LDD   #$0000
                      (    forth6809.asm):02202                    PSHU  D
                      (    forth6809.asm):02203                    LDX   #SLASHMOD
                      (    forth6809.asm):02204                    PSHU  X
                      (    forth6809.asm):02205                    STU   TSTUB4
                      (    forth6809.asm):02206         
                      (    forth6809.asm):02207                    JSR   CATCH
                      (    forth6809.asm):02208         
                      (    forth6809.asm):02209                    STU   TSTUAF
                      (    forth6809.asm):02210         

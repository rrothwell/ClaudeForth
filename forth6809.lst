                      (    forth6809.asm):02158         
                      (    forth6809.asm):02159         ; ============================================================
                      (    forth6809.asm):02160         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02161         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02162         ; ============================================================
                      (    forth6809.asm):02163         ; ------------------------------------------------------------
                      (    forth6809.asm):02164         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02165         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02166         ; LIT   ( -- x )
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02169         ;    Outputs:
                      (    forth6809.asm):02170         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02171         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02172         ; ------------------------------------------------------------
DF60 3510             (    forth6809.asm):02173         LIT:        PULS  X
DF62 EC81             (    forth6809.asm):02174                     LDD   ,X++
DF64 3606             (    forth6809.asm):02175                     PSHU  D                 ; x
DF66 3410             (    forth6809.asm):02176                     PSHS  X
DF68 39               (    forth6809.asm):02177                     RTS
                      (    forth6809.asm):02178         
                      (    forth6809.asm):02179         ; ------------------------------------------------------------
                      (    forth6809.asm):02180         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02181         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02182         ; address.
                      (    forth6809.asm):02183         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02184         ;    Inputs:
                      (    forth6809.asm):02185         ;        flag on the data stack
                      (    forth6809.asm):02186         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02187         ;    Outputs:
                      (    forth6809.asm):02188         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02189         ;        the offset
                      (    forth6809.asm):02190         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02191         ; ------------------------------------------------------------
DF69 3706             (    forth6809.asm):02192         ZBRANCH:    PULU  D                 ; flag
DF6B 3510             (    forth6809.asm):02193                     PULS  X
DF6D 10830000         (    forth6809.asm):02194                     CMPD  #0
DF71 2607             (    forth6809.asm):02195                     BNE   ZSKIP
DF73 EC84             (    forth6809.asm):02196                     LDD   ,X
DF75 308B             (    forth6809.asm):02197                     LEAX  D,X
DF77 3410             (    forth6809.asm):02198                     PSHS  X
DF79 39               (    forth6809.asm):02199                     RTS
DF7A 3002             (    forth6809.asm):02200         ZSKIP:      LEAX  2,X
DF7C 3410             (    forth6809.asm):02201                     PSHS  X
DF7E 39               (    forth6809.asm):02202                     RTS
                      (    forth6809.asm):02203         
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02206         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02207         ; BRANCH
                      (    forth6809.asm):02208         ;    Inputs:
                      (    forth6809.asm):02209         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02210         ;    Outputs:
                      (    forth6809.asm):02211         ;        return address set to the branch target
                      (    forth6809.asm):02212         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02213         ; ------------------------------------------------------------
DF7F 3510             (    forth6809.asm):02214         BRANCH:     PULS  X
DF81 EC84             (    forth6809.asm):02215                     LDD   ,X
DF83 308B             (    forth6809.asm):02216                     LEAX  D,X
DF85 3410             (    forth6809.asm):02217                     PSHS  X
DF87 39               (    forth6809.asm):02218                     RTS
                      (    forth6809.asm):02219         
                      (    forth6809.asm):02220         ; ------------------------------------------------------------
                      (    forth6809.asm):02221         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02222         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02223         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02224         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02225         ;    Inputs:
                      (    forth6809.asm):02226         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02227         ;        trampoline
                      (    forth6809.asm):02228         ;    Outputs:
                      (    forth6809.asm):02229         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02230         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02231         ; ------------------------------------------------------------
DF88 3510             (    forth6809.asm):02232         DODOES:     PULS  X
DF8A 10AE81           (    forth6809.asm):02233                     LDY   ,X++
DF8D EC84             (    forth6809.asm):02234                     LDD   ,X
DF8F 3606             (    forth6809.asm):02235                     PSHU  D                 ; pfa
DF91 6EA4             (    forth6809.asm):02236                     JMP   ,Y
                      (    forth6809.asm):02237         
                      (    forth6809.asm):02238         ; ------------------------------------------------------------
                      (    forth6809.asm):02239         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02240         ; field address on the stack.
                      (    forth6809.asm):02241         ; DOESRT0
                      (    forth6809.asm):02242         ;    Inputs:
                      (    forth6809.asm):02243         ;        none
                      (    forth6809.asm):02244         ;    Outputs:
                      (    forth6809.asm):02245         ;        none
                      (    forth6809.asm):02246         ;    Registers: none.
                      (    forth6809.asm):02247         ; ------------------------------------------------------------
DF93 39               (    forth6809.asm):02248         DOESRT0:    RTS
                      (    forth6809.asm):02249         
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
                      (    forth6809.asm):02251         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02252         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02253         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02254         ; SETDOES
                      (    forth6809.asm):02255         ;    Inputs:
                      (    forth6809.asm):02256         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02257         ;        BEHAVIOR)
                      (    forth6809.asm):02258         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02259         ;        address
                      (    forth6809.asm):02260         ;    Outputs:
                      (    forth6809.asm):02261         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02262         ;        defining word's caller
                      (    forth6809.asm):02263         ;    Registers: RegD, RegX, CC, HDRFLAGS and DOESBEH changed.
                      (    forth6809.asm):02264         ; ------------------------------------------------------------
DF94 3510             (    forth6809.asm):02265         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF96 9FFD             (    forth6809.asm):02266                     STX   DOESBEH
                      (    forth6809.asm):02267         
DF98 9E04             (    forth6809.asm):02268                     LDX   LATEST
DF9A A684             (    forth6809.asm):02269                     LDA   ,X
DF9C 971E             (    forth6809.asm):02270                     STA   HDRFLAGS
DF9E 3001             (    forth6809.asm):02271                     LEAX  1,X
DFA0 D61E             (    forth6809.asm):02272                     LDB   HDRFLAGS
DFA2 C41F             (    forth6809.asm):02273                     ANDB  #$1F
DFA4 4F               (    forth6809.asm):02274                     CLRA
DFA5 308B             (    forth6809.asm):02275                     LEAX  D,X               ; skip name -> LINK field
DFA7 3002             (    forth6809.asm):02276                     LEAX  2,X               ; skip LINK -> CFA field
DFA9 EC84             (    forth6809.asm):02277                     LDD   ,X                ; D = CFA (trampoline address)
DFAB C30003           (    forth6809.asm):02278                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFAE 1F01             (    forth6809.asm):02279                     TFR   D,X
                      (    forth6809.asm):02280         
DFB0 DCFD             (    forth6809.asm):02281                     LDD   DOESBEH
DFB2 ED84             (    forth6809.asm):02282                     STD   ,X                ; patch it
                      (    forth6809.asm):02283         
DFB4 3510             (    forth6809.asm):02284                     PULS  X                 ; X = the OUTER defining word's own return addr
DFB6 6E84             (    forth6809.asm):02285                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287         ; ------------------------------------------------------------
                      (    forth6809.asm):02288         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02289         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02290         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02291         ;    Inputs:
                      (    forth6809.asm):02292         ;        pfa on the data stack
                      (    forth6809.asm):02293         ;    Outputs:
                      (    forth6809.asm):02294         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02295         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02296         ; ------------------------------------------------------------
DFB8 3710             (    forth6809.asm):02297         DODEFER:    PULU  X                 ; pfa
DFBA EC84             (    forth6809.asm):02298                     LDD   ,X
DFBC 1F01             (    forth6809.asm):02299                     TFR   D,X
DFBE 6E84             (    forth6809.asm):02300                     JMP   ,X
                      (    forth6809.asm):02301         
                      (    forth6809.asm):02302         ; ------------------------------------------------------------
                      (    forth6809.asm):02303         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02304         ; DOABORTUNDEF
                      (    forth6809.asm):02305         ;    Inputs:
                      (    forth6809.asm):02306         ;        none
                      (    forth6809.asm):02307         ;    Outputs:
                      (    forth6809.asm):02308         ;        none (does not return)
                      (    forth6809.asm):02309         ;    Registers: RegD changed.
                      (    forth6809.asm):02310         ; ------------------------------------------------------------
DFC0                  (    forth6809.asm):02311         DOABORTUNDEF:
DFC0 CCFFEB           (    forth6809.asm):02312                     LDD   #-21
DFC3 3606             (    forth6809.asm):02313                     PSHU  D                 ; throw code (-21)
DFC5 7EE63E           (    forth6809.asm):02314                     JMP   THROWW
                      (    forth6809.asm):02315         
                      (    forth6809.asm):02316         ; ------------------------------------------------------------
                      (    forth6809.asm):02317         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02318         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02319         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02320         ;    Inputs:
                      (    forth6809.asm):02321         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02322         ;    Outputs:
                      (    forth6809.asm):02323         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02324         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02325         ; ------------------------------------------------------------
DFC8 3710             (    forth6809.asm):02326         DOMARKER:   PULU  X                 ; pfa
DFCA EC84             (    forth6809.asm):02327                     LDD   ,X
DFCC DD06             (    forth6809.asm):02328                     STD   DPHERE
DFCE EC02             (    forth6809.asm):02329                     LDD   2,X
DFD0 DD08             (    forth6809.asm):02330                     STD   CODEHERE
DFD2 EC04             (    forth6809.asm):02331                     LDD   4,X
DFD4 DD0A             (    forth6809.asm):02332                     STD   VARHERE
DFD6 EC06             (    forth6809.asm):02333                     LDD   6,X
DFD8 DD04             (    forth6809.asm):02334                     STD   LATEST
DFDA 39               (    forth6809.asm):02335                     RTS
                      (    forth6809.asm):02336         
                      (    forth6809.asm):02337         ; ------------------------------------------------------------
                      (    forth6809.asm):02338         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02339         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02340         ; ------------------------------------------------------------
DFDB 3710             (    forth6809.asm):02341         EXECUTEW:   PULU  X                 ; xt
DFDD AD84             (    forth6809.asm):02342                     JSR   ,X
DFDF 39               (    forth6809.asm):02343                     RTS
                      (    forth6809.asm):02344         
                      (    forth6809.asm):02345         ; ============================================================
                      (    forth6809.asm):02346         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02347         ; ============================================================
                      (    forth6809.asm):02348         ; ------------------------------------------------------------
                      (    forth6809.asm):02349         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02350         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02351         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02352         ;    Inputs:
                      (    forth6809.asm):02353         ;        RegX = address of the here pointer
                      (    forth6809.asm):02354         ;        x on the data stack
                      (    forth6809.asm):02355         ;    Outputs:
                      (    forth6809.asm):02356         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02357         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02358         ; ------------------------------------------------------------
DFE0 3706             (    forth6809.asm):02359         APPENDCELL: PULU  D                 ; x
DFE2 10AE84           (    forth6809.asm):02360                     LDY   ,X
DFE5 EDA1             (    forth6809.asm):02361                     STD   ,Y++
DFE7 10AF84           (    forth6809.asm):02362                     STY   ,X
DFEA 39               (    forth6809.asm):02363                     RTS
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         ; ------------------------------------------------------------
                      (    forth6809.asm):02366         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02367         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02368         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02369         ;    Inputs:
                      (    forth6809.asm):02370         ;        RegX = address of the here pointer
                      (    forth6809.asm):02371         ;        char on the data stack
                      (    forth6809.asm):02372         ;    Outputs:
                      (    forth6809.asm):02373         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02374         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02375         ; ------------------------------------------------------------
DFEB 3706             (    forth6809.asm):02376         APPENDBYTE: PULU  D                 ; char
DFED 10AE84           (    forth6809.asm):02377                     LDY   ,X
DFF0 E7A0             (    forth6809.asm):02378                     STB   ,Y+
DFF2 10AF84           (    forth6809.asm):02379                     STY   ,X
DFF5 39               (    forth6809.asm):02380                     RTS
                      (    forth6809.asm):02381         
                      (    forth6809.asm):02382         ; ------------------------------------------------------------
                      (    forth6809.asm):02383         ; ,  ( x -- )
                      (    forth6809.asm):02384         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02385         ; ------------------------------------------------------------
DFF6 8E0008           (    forth6809.asm):02386         COMMAW:     LDX   #CODEHERE
DFF9 7EDFE0           (    forth6809.asm):02387                     JMP   APPENDCELL
                      (    forth6809.asm):02388         
                      (    forth6809.asm):02389         ; ------------------------------------------------------------
                      (    forth6809.asm):02390         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02391         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02392         ; ------------------------------------------------------------
DFFC 8E0008           (    forth6809.asm):02393         CODECOMMA:  LDX   #CODEHERE
DFFF 7EDFE0           (    forth6809.asm):02394                     JMP   APPENDCELL
                      (    forth6809.asm):02395         
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
                      (    forth6809.asm):02397         ; C,  ( char -- )
                      (    forth6809.asm):02398         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02399         ; ------------------------------------------------------------
E002 8E0008           (    forth6809.asm):02400         CCOMMAW:    LDX   #CODEHERE
E005 7EDFEB           (    forth6809.asm):02401                     JMP   APPENDBYTE
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403         ; ------------------------------------------------------------
                      (    forth6809.asm):02404         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02405         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
E008 8E0008           (    forth6809.asm):02407         CCOMMA1:    LDX   #CODEHERE
E00B 7EDFEB           (    forth6809.asm):02408                     JMP   APPENDBYTE
                      (    forth6809.asm):02409         
                      (    forth6809.asm):02410         ; ------------------------------------------------------------
                      (    forth6809.asm):02411         ; V,  ( x -- )
                      (    forth6809.asm):02412         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02413         ; ------------------------------------------------------------
E00E 8E000A           (    forth6809.asm):02414         VCOMMAW:    LDX   #VARHERE
E011 7EDFE0           (    forth6809.asm):02415                     JMP   APPENDCELL
                      (    forth6809.asm):02416         
                      (    forth6809.asm):02417         ; ------------------------------------------------------------
                      (    forth6809.asm):02418         ; VC,  ( char -- )
                      (    forth6809.asm):02419         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02420         ; ------------------------------------------------------------
E014 8E000A           (    forth6809.asm):02421         VCCOMMAW:   LDX   #VARHERE
E017 7EDFEB           (    forth6809.asm):02422                     JMP   APPENDBYTE
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424         ; ------------------------------------------------------------
                      (    forth6809.asm):02425         ; ALLOT  ( n -- )
                      (    forth6809.asm):02426         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02427         ; ------------------------------------------------------------
E01A 3706             (    forth6809.asm):02428         ALLOTW:     PULU  D                 ; n
E01C 9E08             (    forth6809.asm):02429                     LDX   CODEHERE
E01E 308B             (    forth6809.asm):02430                     LEAX  D,X
E020 9F08             (    forth6809.asm):02431                     STX   CODEHERE
E022 39               (    forth6809.asm):02432                     RTS
                      (    forth6809.asm):02433         
                      (    forth6809.asm):02434         ; ------------------------------------------------------------
                      (    forth6809.asm):02435         ; VALLOT  ( n -- )
                      (    forth6809.asm):02436         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02437         ; ------------------------------------------------------------
E023 3706             (    forth6809.asm):02438         VALLOTW:    PULU  D                 ; n
E025 9E0A             (    forth6809.asm):02439                     LDX   VARHERE
E027 308B             (    forth6809.asm):02440                     LEAX  D,X
E029 9F0A             (    forth6809.asm):02441                     STX   VARHERE
E02B 39               (    forth6809.asm):02442                     RTS
                      (    forth6809.asm):02443         
                      (    forth6809.asm):02444         ; ------------------------------------------------------------
                      (    forth6809.asm):02445         ; HERE  ( -- addr )
                      (    forth6809.asm):02446         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02447         ; ------------------------------------------------------------
E02C DC08             (    forth6809.asm):02448         HEREW:      LDD   CODEHERE
E02E 3606             (    forth6809.asm):02449                     PSHU  D                 ; addr
E030 39               (    forth6809.asm):02450                     RTS
                      (    forth6809.asm):02451         
                      (    forth6809.asm):02452         ; ------------------------------------------------------------
                      (    forth6809.asm):02453         ; VHERE  ( -- addr )
                      (    forth6809.asm):02454         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02455         ; ------------------------------------------------------------
E031 DC0A             (    forth6809.asm):02456         VHEREW:     LDD   VARHERE
E033 3606             (    forth6809.asm):02457                     PSHU  D                 ; addr
E035 39               (    forth6809.asm):02458                     RTS
                      (    forth6809.asm):02459         
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
                      (    forth6809.asm):02461         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02462         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02463         ; ------------------------------------------------------------
E036 DC08             (    forth6809.asm):02464         PADW:       LDD   CODEHERE
E038 C30080           (    forth6809.asm):02465                     ADDD  #PADOFFSET
E03B 3606             (    forth6809.asm):02466                     PSHU  D                 ; c-addr
E03D 39               (    forth6809.asm):02467                     RTS
                      (    forth6809.asm):02468         
                      (    forth6809.asm):02469         ; ------------------------------------------------------------
                      (    forth6809.asm):02470         ; UNUSED  ( -- u )
                      (    forth6809.asm):02471         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02472         ; ------------------------------------------------------------
E03E CCB900           (    forth6809.asm):02473         UNUSEDW:    LDD   #CODETOP
E041 9308             (    forth6809.asm):02474                     SUBD  CODEHERE
E043 3606             (    forth6809.asm):02475                     PSHU  D                 ; u
E045 39               (    forth6809.asm):02476                     RTS
                      (    forth6809.asm):02477         
                      (    forth6809.asm):02478         ; ------------------------------------------------------------
                      (    forth6809.asm):02479         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02480         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02481         ; ------------------------------------------------------------
E046 CC1FFF           (    forth6809.asm):02482         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E049 930A             (    forth6809.asm):02483                     SUBD  VARHERE
E04B 3606             (    forth6809.asm):02484                     PSHU  D                 ; u
E04D 39               (    forth6809.asm):02485                     RTS
                      (    forth6809.asm):02486         
                      (    forth6809.asm):02487         ; ============================================================
                      (    forth6809.asm):02488         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02489         ; ============================================================
                      (    forth6809.asm):02490         ; ------------------------------------------------------------
                      (    forth6809.asm):02491         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02492         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02493         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02494         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02495         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02496         ;    Inputs:
                      (    forth6809.asm):02497         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02498         ;        name parsed from the input stream
                      (    forth6809.asm):02499         ;    Outputs:
                      (    forth6809.asm):02500         ;        header built at DPHERE; LATEST and NEWHDR = address of the
                      (    forth6809.asm):02501         ;        new header
                      (    forth6809.asm):02502         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02503         ; ------------------------------------------------------------
E04E CC0020           (    forth6809.asm):02504         HEADER:     LDD   #32
E051 3606             (    forth6809.asm):02505                     PSHU  D
E053 BDE347           (    forth6809.asm):02506                     JSR   WORDW
E056 3710             (    forth6809.asm):02507                     PULU  X                 ; c-addr of the name
E058 A684             (    forth6809.asm):02508                     LDA   ,X
E05A 9741             (    forth6809.asm):02509                     STA   NAMELEN
E05C 3001             (    forth6809.asm):02510                     LEAX  1,X
E05E 9F3F             (    forth6809.asm):02511                     STX   NAMEP
                      (    forth6809.asm):02512         
E060 3706             (    forth6809.asm):02513                     PULU  D                 ; smudge flag
E062 D74E             (    forth6809.asm):02514                     STB   HDRSMUDGE
                      (    forth6809.asm):02515         
E064 DC06             (    forth6809.asm):02516                     LDD   DPHERE
E066 DD3D             (    forth6809.asm):02517                     STD   NEWHDR
E068 9E06             (    forth6809.asm):02518                     LDX   DPHERE
E06A 9641             (    forth6809.asm):02519                     LDA   NAMELEN
E06C 0D4E             (    forth6809.asm):02520                     TST   HDRSMUDGE
E06E 2702             (    forth6809.asm):02521                     BEQ   HDNOSM
E070 8A40             (    forth6809.asm):02522                     ORA   #$40
E072 A780             (    forth6809.asm):02523         HDNOSM:     STA   ,X+
E074 109E3F           (    forth6809.asm):02524                     LDY   NAMEP
E077 D641             (    forth6809.asm):02525                     LDB   NAMELEN
E079 2707             (    forth6809.asm):02526                     BEQ   HDNONM
E07B A6A0             (    forth6809.asm):02527         HDCPY:      LDA   ,Y+
E07D A780             (    forth6809.asm):02528                     STA   ,X+
E07F 5A               (    forth6809.asm):02529                     DECB
E080 26F9             (    forth6809.asm):02530                     BNE   HDCPY
E082 DC04             (    forth6809.asm):02531         HDNONM:     LDD   LATEST
E084 ED81             (    forth6809.asm):02532                     STD   ,X++
E086 DC08             (    forth6809.asm):02533                     LDD   CODEHERE
E088 ED81             (    forth6809.asm):02534                     STD   ,X++
E08A 9F06             (    forth6809.asm):02535                     STX   DPHERE
E08C DC3D             (    forth6809.asm):02536                     LDD   NEWHDR
E08E DD04             (    forth6809.asm):02537                     STD   LATEST
E090 39               (    forth6809.asm):02538                     RTS
                      (    forth6809.asm):02539         
                      (    forth6809.asm):02540         ; ============================================================
                      (    forth6809.asm):02541         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02542         ; ============================================================
                      (    forth6809.asm):02543         ; ------------------------------------------------------------
                      (    forth6809.asm):02544         ; :  ( "name" -- )
                      (    forth6809.asm):02545         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02546         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02547         ; CSP and enter compile state.
                      (    forth6809.asm):02548         ; ------------------------------------------------------------
E091 CCFFFF           (    forth6809.asm):02549         COLONW:     LDD   #TRUEV
E094 3606             (    forth6809.asm):02550                     PSHU  D
E096 BDE04E           (    forth6809.asm):02551                     JSR   HEADER
E099 DC08             (    forth6809.asm):02552                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E09B DD3D             (    forth6809.asm):02553                     STD   CURXT             ; See bugfix: COLONW.1
E09D 1F30             (    forth6809.asm):02554                     TFR   U,D
E09F DD48             (    forth6809.asm):02555                     STD   CSP
E0A1 CCFFFF           (    forth6809.asm):02556                     LDD   #-1
E0A4 DD00             (    forth6809.asm):02557                     STD   STATE
E0A6 39               (    forth6809.asm):02558                     RTS
                      (    forth6809.asm):02559         
                      (    forth6809.asm):02560         ; ------------------------------------------------------------
                      (    forth6809.asm):02561         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02562         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02563         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02564         ; new word and return to interpret state.
                      (    forth6809.asm):02565         ; ------------------------------------------------------------
E0A7 CC0039           (    forth6809.asm):02566         SEMIW:      LDD   #RTSOPC
E0AA 3606             (    forth6809.asm):02567                     PSHU  D
E0AC BDE008           (    forth6809.asm):02568                     JSR   CCOMMA1
E0AF 1F30             (    forth6809.asm):02569                     TFR   U,D
E0B1 109348           (    forth6809.asm):02570                     CMPD  CSP
E0B4 2703             (    forth6809.asm):02571                     BEQ   SEMIOK
E0B6 BDE609           (    forth6809.asm):02572                     JSR   CFERR
E0B9 9E04             (    forth6809.asm):02573         SEMIOK:     LDX   LATEST
E0BB A684             (    forth6809.asm):02574                     LDA   ,X
E0BD 84BF             (    forth6809.asm):02575                     ANDA  #$BF
E0BF A784             (    forth6809.asm):02576                     STA   ,X
E0C1 CC0000           (    forth6809.asm):02577                     LDD   #0
E0C4 DD00             (    forth6809.asm):02578                     STD   STATE
E0C6 39               (    forth6809.asm):02579                     RTS
                      (    forth6809.asm):02580         
                      (    forth6809.asm):02581         ; ------------------------------------------------------------
                      (    forth6809.asm):02582         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02583         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02584         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02585         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02586         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02587         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02588         ; ------------------------------------------------------------
E0C7 DC08             (    forth6809.asm):02589         NONAMEW:    LDD   CODEHERE
E0C9 3606             (    forth6809.asm):02590                     PSHU  D                 ; xt
E0CB DD3D             (    forth6809.asm):02591                     STD   CURXT             ; See bugfix: NONAMEW.1
E0CD 1F30             (    forth6809.asm):02592                     TFR   U,D
E0CF DD48             (    forth6809.asm):02593                     STD   CSP
E0D1 CCFFFF           (    forth6809.asm):02594                     LDD   #-1
E0D4 DD00             (    forth6809.asm):02595                     STD   STATE
E0D6 39               (    forth6809.asm):02596                     RTS
                      (    forth6809.asm):02597         
                      (    forth6809.asm):02598         ; ------------------------------------------------------------
                      (    forth6809.asm):02599         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02600         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02601         ; BLDDOES
                      (    forth6809.asm):02602         ;    Inputs:
                      (    forth6809.asm):02603         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02604         ;    Outputs:
                      (    forth6809.asm):02605         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02606         ;    Registers: all changed.
                      (    forth6809.asm):02607         ; BLDSELF
                      (    forth6809.asm):02608         ;    Inputs:
                      (    forth6809.asm):02609         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02610         ;    Outputs:
                      (    forth6809.asm):02611         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02612         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02613         ;    Registers: all changed.
                      (    forth6809.asm):02614         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02615         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02616         ; ------------------------------------------------------------
E0D7 3406             (    forth6809.asm):02617         BLDDOES:    PSHS  D                 ; behaviour address
E0D9 CC0000           (    forth6809.asm):02618                     LDD   #0
E0DC 3606             (    forth6809.asm):02619                     PSHU  D
E0DE BDE04E           (    forth6809.asm):02620                     JSR   HEADER
E0E1 CCDF88           (    forth6809.asm):02621                     LDD   #DODOES
E0E4 3606             (    forth6809.asm):02622                     PSHU  D
E0E6 BDEAB9           (    forth6809.asm):02623                     JSR   CCALL
E0E9 3506             (    forth6809.asm):02624                     PULS  D
E0EB 3606             (    forth6809.asm):02625                     PSHU  D                 ; behaviour address
E0ED BDDFFC           (    forth6809.asm):02626                     JSR   CODECOMMA
E0F0 39               (    forth6809.asm):02627                     RTS
                      (    forth6809.asm):02628         
E0F1 BDE0D7           (    forth6809.asm):02629         BLDSELF:    JSR   BLDDOES
E0F4 DC08             (    forth6809.asm):02630                     LDD   CODEHERE          ; PFA = the cell after this one
E0F6 C30002           (    forth6809.asm):02631                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0F9 3606             (    forth6809.asm):02632                     PSHU  D
E0FB BDDFFC           (    forth6809.asm):02633                     JSR   CODECOMMA
E0FE 39               (    forth6809.asm):02634                     RTS
                      (    forth6809.asm):02635         
                      (    forth6809.asm):02636         ; ------------------------------------------------------------
                      (    forth6809.asm):02637         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02638         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02639         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02640         ; address in the code area, on the stack.
                      (    forth6809.asm):02641         ; ------------------------------------------------------------
E0FF CCDF93           (    forth6809.asm):02642         CREATEW:    LDD   #DOESRT0
E102 BDE0F1           (    forth6809.asm):02643                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E105 39               (    forth6809.asm):02644                     RTS
                      (    forth6809.asm):02645         
                      (    forth6809.asm):02646         ; ------------------------------------------------------------
                      (    forth6809.asm):02647         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02648         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02649         ; of the word being defined.
                      (    forth6809.asm):02650         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02651         ; ------------------------------------------------------------
E106 CCDF94           (    forth6809.asm):02652         DOESGTW:    LDD   #SETDOES
E109 3606             (    forth6809.asm):02653                     PSHU  D
E10B BDEAB9           (    forth6809.asm):02654                     JSR   CCALL
E10E 39               (    forth6809.asm):02655                     RTS
                      (    forth6809.asm):02656         
                      (    forth6809.asm):02657         ; ------------------------------------------------------------
                      (    forth6809.asm):02658         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02659         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02660         ; area, initialised to zero.
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
E10F CC0000           (    forth6809.asm):02662         VARIABLEW:  LDD   #0
E112 3606             (    forth6809.asm):02663                     PSHU  D
E114 BDE04E           (    forth6809.asm):02664                     JSR   HEADER
E117 CCDF88           (    forth6809.asm):02665                     LDD   #DODOES
E11A 3606             (    forth6809.asm):02666                     PSHU  D
E11C BDEAB9           (    forth6809.asm):02667                     JSR   CCALL
E11F CCDF93           (    forth6809.asm):02668                     LDD   #DOESRT0
E122 3606             (    forth6809.asm):02669                     PSHU  D
E124 BDDFFC           (    forth6809.asm):02670                     JSR   CODECOMMA
E127 DC0A             (    forth6809.asm):02671                     LDD   VARHERE
E129 3606             (    forth6809.asm):02672                     PSHU  D
E12B BDDFFC           (    forth6809.asm):02673                     JSR   CODECOMMA
E12E CC0000           (    forth6809.asm):02674                     LDD   #0
E131 9E0A             (    forth6809.asm):02675                     LDX   VARHERE
E133 ED81             (    forth6809.asm):02676                     STD   ,X++
E135 9F0A             (    forth6809.asm):02677                     STX   VARHERE
E137 39               (    forth6809.asm):02678                     RTS
                      (    forth6809.asm):02679         
                      (    forth6809.asm):02680         ; ------------------------------------------------------------
                      (    forth6809.asm):02681         ; @  ( a-addr -- x )
                      (    forth6809.asm):02682         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02683         ; ------------------------------------------------------------
E138 3710             (    forth6809.asm):02684         FETCHW:     PULU  X                 ; a-addr
E13A EC84             (    forth6809.asm):02685                     LDD   ,X
E13C 3606             (    forth6809.asm):02686                     PSHU  D                 ; x
E13E 39               (    forth6809.asm):02687                     RTS
                      (    forth6809.asm):02688         
                      (    forth6809.asm):02689         ; ------------------------------------------------------------
                      (    forth6809.asm):02690         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02691         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02692         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02693         ; ------------------------------------------------------------
E13F CCE138           (    forth6809.asm):02694         CONSTANTW:  LDD   #FETCHW
E142 BDE0F1           (    forth6809.asm):02695                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E145 BDDFF6           (    forth6809.asm):02696                     JSR   COMMAW
E148 39               (    forth6809.asm):02697                     RTS
                      (    forth6809.asm):02698         
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
                      (    forth6809.asm):02700         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02701         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02702         ;    Inputs:
                      (    forth6809.asm):02703         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02704         ;    Outputs:
                      (    forth6809.asm):02705         ;        pfa replaced by the value
                      (    forth6809.asm):02706         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02707         ; ------------------------------------------------------------
E149 3710             (    forth6809.asm):02708         DOVALUE:    PULU  X                 ; pfa
E14B EC84             (    forth6809.asm):02709                     LDD   ,X
E14D 3606             (    forth6809.asm):02710                     PSHU  D                 ; x
E14F 39               (    forth6809.asm):02711                     RTS
                      (    forth6809.asm):02712         
                      (    forth6809.asm):02713         ; ------------------------------------------------------------
                      (    forth6809.asm):02714         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02715         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02716         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02717         ; ------------------------------------------------------------
E150 CCE149           (    forth6809.asm):02718         VALUEW:     LDD   #DOVALUE
E153 BDE0D7           (    forth6809.asm):02719                     JSR   BLDDOES
E156 DC0A             (    forth6809.asm):02720                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E158 3606             (    forth6809.asm):02721                     PSHU  D                 ; See bugfix: VALUEW.1
E15A BDDFFC           (    forth6809.asm):02722                     JSR   CODECOMMA
E15D BDE00E           (    forth6809.asm):02723                     JSR   VCOMMAW           ; store x in the variable area
E160 39               (    forth6809.asm):02724                     RTS
                      (    forth6809.asm):02725         
                      (    forth6809.asm):02726         ; ------------------------------------------------------------
                      (    forth6809.asm):02727         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02728         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02729         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
E161 CC0020           (    forth6809.asm):02731         TOW:        LDD   #32
E164 3606             (    forth6809.asm):02732                     PSHU  D
E166 BDE347           (    forth6809.asm):02733                     JSR   WORDW
E169 BDE3B3           (    forth6809.asm):02734                     JSR   FINDW
E16C 3706             (    forth6809.asm):02735                     PULU  D
E16E 10830000         (    forth6809.asm):02736                     CMPD  #0
E172 260A             (    forth6809.asm):02737                     BNE   TOFOUND
E174 3706             (    forth6809.asm):02738                     PULU  D
E176 CCFFF3           (    forth6809.asm):02739                     LDD   #-13
E179 3606             (    forth6809.asm):02740                     PSHU  D
E17B BDE63E           (    forth6809.asm):02741                     JSR   THROWW
E17E BDEB6B           (    forth6809.asm):02742         TOFOUND:    JSR   TOBODYW
E181 DC00             (    forth6809.asm):02743                     LDD   STATE
E183 270C             (    forth6809.asm):02744                     BEQ   TOIMMED
E185 BDEAC6           (    forth6809.asm):02745                     JSR   LITERALW
E188 CCF400           (    forth6809.asm):02746                     LDD   #STOREW
E18B 3606             (    forth6809.asm):02747                     PSHU  D
E18D BDEAB9           (    forth6809.asm):02748                     JSR   CCALL
E190 39               (    forth6809.asm):02749                     RTS
E191 3710             (    forth6809.asm):02750         TOIMMED:    PULU  X                 ; a-addr of the value cell
E193 3706             (    forth6809.asm):02751                     PULU  D                 ; x
E195 ED84             (    forth6809.asm):02752                     STD   ,X
E197 39               (    forth6809.asm):02753                     RTS
                      (    forth6809.asm):02754         
                      (    forth6809.asm):02755         ; ------------------------------------------------------------
                      (    forth6809.asm):02756         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02757         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02758         ; the variable area, initialised to zero.
                      (    forth6809.asm):02759         ; ------------------------------------------------------------
E198                  (    forth6809.asm):02760         TWOVARIABLEW:
E198 CC0000           (    forth6809.asm):02761                     LDD   #0
E19B 3606             (    forth6809.asm):02762                     PSHU  D
E19D BDE04E           (    forth6809.asm):02763                     JSR   HEADER
E1A0 CCDF88           (    forth6809.asm):02764                     LDD   #DODOES
E1A3 3606             (    forth6809.asm):02765                     PSHU  D
E1A5 BDEAB9           (    forth6809.asm):02766                     JSR   CCALL
E1A8 CCDF93           (    forth6809.asm):02767                     LDD   #DOESRT0
E1AB 3606             (    forth6809.asm):02768                     PSHU  D
E1AD BDDFFC           (    forth6809.asm):02769                     JSR   CODECOMMA
E1B0 DC0A             (    forth6809.asm):02770                     LDD   VARHERE
E1B2 3606             (    forth6809.asm):02771                     PSHU  D
E1B4 BDDFFC           (    forth6809.asm):02772                     JSR   CODECOMMA

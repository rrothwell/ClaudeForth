                      (    forth6809.asm):04154         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04155         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04156         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04157         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04158         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04159         ;    Inputs:
                      (    forth6809.asm):04160         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04161         ;    Outputs:
                      (    forth6809.asm):04162         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04163         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04164         ;        scratch.
                      (    forth6809.asm):04165         ; ------------------------------------------------------------

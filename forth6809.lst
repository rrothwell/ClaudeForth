FA0C 26EC             (    forth6809.asm):07536                     BNE   UDDLOOP
FA0E 39               (    forth6809.asm):07537                     RTS
                      (    forth6809.asm):07538         
                      (    forth6809.asm):07539         ; ------------------------------------------------------------
                      (    forth6809.asm):07540         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):07541         ; Convert digits with # until the quotient is zero (at least one digit

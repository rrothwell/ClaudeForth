                      (    forth6809.asm):04807         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):04808         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):04809         ; ------------------------------------------------------------

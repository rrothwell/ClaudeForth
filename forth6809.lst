E162 BDE97A           (    forth6809.asm):02998                     JSR   CCALL
E165 20DC             (    forth6809.asm):02999                     BRA   ILOOP
                      (    forth6809.asm):03000         
E167 BDDE57           (    forth6809.asm):03001         DOEXEC:     JSR   EXECUTEW
E16A 20D7             (    forth6809.asm):03002                     BRA   ILOOP
                      (    forth6809.asm):03003         
E16C BDE33E           (    forth6809.asm):03004         TRYNUM:     JSR   NUMBERQ
E16F 3706             (    forth6809.asm):03005                     PULU  D
E171 10830000         (    forth6809.asm):03006                     CMPD  #0                ; flag (PULU does not set CC)
E175 273B             (    forth6809.asm):03007                     BEQ   BADWORD
                      (    forth6809.asm):03008         
E177 10830001         (    forth6809.asm):03009                     CMPD  #1                ; 1 = double-number result
E17B 2711             (    forth6809.asm):03010                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03011         
E17D DC00             (    forth6809.asm):03012                     LDD   STATE
E17F 27C2             (    forth6809.asm):03013                     BEQ   ILOOP
E181 CCDDDC           (    forth6809.asm):03014                     LDD   #LIT
E184 3606             (    forth6809.asm):03015                     PSHU  D
E186 BDE97A           (    forth6809.asm):03016                     JSR   CCALL
E189 BDDE78           (    forth6809.asm):03017                     JSR   CODECOMMA
E18C 20B5             (    forth6809.asm):03018                     BRA   ILOOP
                      (    forth6809.asm):03019         
E18E                  (    forth6809.asm):03020         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03021                                             ; ANS's (ud1) stack order directly.
E18E DC00             (    forth6809.asm):03022                     LDD   STATE
E190 27B1             (    forth6809.asm):03023                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03024                                             ; nothing more to do
                      (    forth6809.asm):03025                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03026                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03027                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03028                     ; pop it aside first, freeing UDLO to be compiled first.
E192 3706             (    forth6809.asm):03029                     PULU  D
E194 DD2F             (    forth6809.asm):03030                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03031                                             ; untouched by CCALL/CODECOMMA
E196 CCDDDC           (    forth6809.asm):03032                     LDD   #LIT
E199 3606             (    forth6809.asm):03033                     PSHU  D
E19B BDE97A           (    forth6809.asm):03034                     JSR   CCALL
E19E BDDE78           (    forth6809.asm):03035                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
E1A1 CCDDDC           (    forth6809.asm):03036                     LDD   #LIT
E1A4 3606             (    forth6809.asm):03037                     PSHU  D
E1A6 BDE97A           (    forth6809.asm):03038                     JSR   CCALL
E1A9 DC2F             (    forth6809.asm):03039                     LDD   MSCR4
E1AB 3606             (    forth6809.asm):03040                     PSHU  D
E1AD BDDE78           (    forth6809.asm):03041                     JSR   CODECOMMA         ; compiles UDHI
E1B0 2091             (    forth6809.asm):03042                     BRA   ILOOP
                      (    forth6809.asm):03043         

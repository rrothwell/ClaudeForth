                      (    forth6809.asm):15474                    STD  SRCADDR
                      (    forth6809.asm):15475                    LDD  #4
                      (    forth6809.asm):15476                    STD  SRCLEN
                      (    forth6809.asm):15477                    LDD  #0
                      (    forth6809.asm):15478                    STD  TOIN
                      (    forth6809.asm):15479         
                      (    forth6809.asm):15480                    STU  TSTU0
                      (    forth6809.asm):15481         
                      (    forth6809.asm):15482                    LDD  #TSTGUARD
                      (    forth6809.asm):15483                    PSHU D
                      (    forth6809.asm):15484                    STU  TSTUB4
                      (    forth6809.asm):15485         

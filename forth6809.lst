                      (    forth6809.asm):02610         ; TSTSARITH - single-cell arithmetic tests (glossary section 3.4).
                      (    forth6809.asm):02611         ; Covers every word in that section, with representative
                      (    forth6809.asm):02612         ; positive/negative/zero cases per word - not an exhaustive sign
                      (    forth6809.asm):02613         ; combination sweep, but enough to exercise each word's actual
                      (    forth6809.asm):02614         ; branches (sign handling, division's throw-on-zero, multiply's
                      (    forth6809.asm):02615         ; defined-truncation-not-error overflow behavior). See the
                      (    forth6809.asm):02616         ; open-items checklist for the full reasoning behind the specific
                      (    forth6809.asm):02617         ; cases chosen.
                      (    forth6809.asm):02618         ; ------------------------------------------------------------

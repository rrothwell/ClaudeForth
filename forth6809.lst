DD9F 7D017B           (    forth6809.asm):01748                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
DDA2 2619             (    forth6809.asm):01749                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):01750         
                      (    forth6809.asm):01751                                             ; No! Restart.
DDA4 8E01C0           (    forth6809.asm):01752                     LDX   #OUTBUF           ; Pull character from the out buffer.
DDA7 F6017A           (    forth6809.asm):01753                     LDB   OUTTAIL
DDAA A685             (    forth6809.asm):01754                     LDA   B,X
DDAC B7C009           (    forth6809.asm):01755                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):01756         
DDAF 5C               (    forth6809.asm):01757                     INCB                    ; Update the tail pointer
DDB0 C43F             (    forth6809.asm):01758                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
DDB2 F7017A           (    forth6809.asm):01759                     STB   OUTTAIL
                      (    forth6809.asm):01760         
DDB5 86FF             (    forth6809.asm):01761                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.

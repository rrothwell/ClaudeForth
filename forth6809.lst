                      (    forth6809.asm):07509         ; ------------------------------------------------------------
                      (    forth6809.asm):07510         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07511         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07512         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07513         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07514         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07515         ; ------------------------------------------------------------
E95A BDE92B           (    forth6809.asm):07516         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3

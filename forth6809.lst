                      (    forth6809.asm):10857         ; ------------------------------------------------------------
                      (    forth6809.asm):10858         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10859         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10860         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10861         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10862         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10863         ; sequential walk-through per region.
                      (    forth6809.asm):10864         ;
                      (    forth6809.asm):10865         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10866         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10867         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10868         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10869         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10870         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10871         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10872         ; ------------------------------------------------------------
C100                  (    forth6809.asm):10873         TSTMEMORY: JSR CRW
                      (    forth6809.asm):10874                    LDX   #TSTMEMMSG
                      (    forth6809.asm):10875                    PSHU  X
                      (    forth6809.asm):10876                    LDD   #6
                      (    forth6809.asm):10877                    PSHU  D
                      (    forth6809.asm):10878                    JSR   TYPE
                      (    forth6809.asm):10879                    JSR   CRW
                      (    forth6809.asm):10880         
                      (    forth6809.asm):10881                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10882         
                      (    forth6809.asm):10883                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10884                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10885                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10886                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10887                    JSR   TSTCODEHERE
                      (    forth6809.asm):10888                    JSR   TSTVARHERE
                      (    forth6809.asm):10889                    JSR   TSTPAD
                      (    forth6809.asm):10890                    JSR   TSTUNUSED
                      (    forth6809.asm):10891                    JSR   TSTVUNUSED
                      (    forth6809.asm):10892                    JSR   TSTFILL
                      (    forth6809.asm):10893                    JSR   TSTERASE
                      (    forth6809.asm):10894                    JSR   TSTCMOVE
                      (    forth6809.asm):10895                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10896                    JSR   TSTMOVE1
                      (    forth6809.asm):10897                    JSR   TSTMOVE2
                      (    forth6809.asm):10898                    JSR   TSTMOVE3
                      (    forth6809.asm):10899         
                      (    forth6809.asm):10900                    ENDC ; <<<<
                      (    forth6809.asm):10901         
                      (    forth6809.asm):10902                    RTS
                      (    forth6809.asm):10903         
C100                  (    forth6809.asm):10904         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10905         
                      (    forth6809.asm):10906                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10907         
                      (    forth6809.asm):10908         ; ------------------------------------------------------------
                      (    forth6809.asm):10909         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10910         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10911         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10912         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10913         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10914         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10915         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10916         ; runs exclusively of every other.
                      (    forth6809.asm):10917         ;
                      (    forth6809.asm):10918         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10919         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10920         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10921         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10922         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10923         ; ------------------------------------------------------------
                      (    forth6809.asm):10924         
                      (    forth6809.asm):10925         ; ------------------------------------------------------------
                      (    forth6809.asm):10926         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10927         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10928         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10929         ; ------------------------------------------------------------
C100                  (    forth6809.asm):10930         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10931         
                      (    forth6809.asm):10932                        LDD  #TSTGUARD
                      (    forth6809.asm):10933                        PSHU D
                      (    forth6809.asm):10934                        LDD  #TSTVAL1
                      (    forth6809.asm):10935                        PSHU D
                      (    forth6809.asm):10936                        LDD  #TSTCBUF
                      (    forth6809.asm):10937                        PSHU D
                      (    forth6809.asm):10938                        STU  TSTUB4
                      (    forth6809.asm):10939         
                      (    forth6809.asm):10940                        JSR  STOREW
                      (    forth6809.asm):10941         
                      (    forth6809.asm):10942                        LDD  #TSTCBUF
                      (    forth6809.asm):10943                        PSHU D
                      (    forth6809.asm):10944         
                      (    forth6809.asm):10945                        JSR  ATSIGN
                      (    forth6809.asm):10946         
                      (    forth6809.asm):10947                        STU  TSTUAF
                      (    forth6809.asm):10948         
                      (    forth6809.asm):10949                        PULU D
                      (    forth6809.asm):10950                        CMPD #TSTVAL1
                      (    forth6809.asm):10951                        BNE  FSFAIL
                      (    forth6809.asm):10952                        PULU D
                      (    forth6809.asm):10953                        CMPD #TSTGUARD
                      (    forth6809.asm):10954                        BNE  FSFAIL
                      (    forth6809.asm):10955         
                      (    forth6809.asm):10956                        LDD  TSTUB4
                      (    forth6809.asm):10957                        SUBD TSTUAF
                      (    forth6809.asm):10958                        CMPD #-2
                      (    forth6809.asm):10959                        BNE  FSFAIL
                      (    forth6809.asm):10960         
                      (    forth6809.asm):10961                        LDD  #TRUEV
                      (    forth6809.asm):10962                        BRA  FSDONE
C100                  (    forth6809.asm):10963         FSFAIL:        LDD  #FALSEV
C100                  (    forth6809.asm):10964         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):10965                        PSHU X
                      (    forth6809.asm):10966                        PSHU D
                      (    forth6809.asm):10967                        JSR  TSTREPORT
                      (    forth6809.asm):10968         
                      (    forth6809.asm):10969                        LDU  TSTU0
                      (    forth6809.asm):10970                        RTS
                      (    forth6809.asm):10971         
C100                  (    forth6809.asm):10972         TSTFSNAME: FCB  13
                      (    forth6809.asm):10973                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):10974         
                      (    forth6809.asm):10975         ; ------------------------------------------------------------
                      (    forth6809.asm):10976         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):10977         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):10978         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):10979         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):10980         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):10981         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):10982         ; whatever was there).
                      (    forth6809.asm):10983         ;
                      (    forth6809.asm):10984         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):10985         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):10986         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):10987         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):10988         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):10989         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):10990         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):10991         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):10992         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):10993         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):10994         ; byte ends up where was wrong.
                      (    forth6809.asm):10995         ; ------------------------------------------------------------
C100                  (    forth6809.asm):10996         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):10997                         STD  TSTCBUF
                      (    forth6809.asm):10998         
                      (    forth6809.asm):10999                         STU  TSTU0
                      (    forth6809.asm):11000         
                      (    forth6809.asm):11001                         LDD  #TSTGUARD
                      (    forth6809.asm):11002                         PSHU D
                      (    forth6809.asm):11003                         LDD  #$34
                      (    forth6809.asm):11004                         PSHU D
                      (    forth6809.asm):11005                         LDD  #TSTCBUF
                      (    forth6809.asm):11006                         PSHU D
                      (    forth6809.asm):11007                         STU  TSTUB4
                      (    forth6809.asm):11008         
                      (    forth6809.asm):11009                         JSR  CSTOREW
                      (    forth6809.asm):11010         
                      (    forth6809.asm):11011                         LDD  TSTCBUF
                      (    forth6809.asm):11012                         CMPD #$34FF
                      (    forth6809.asm):11013                         BNE  CFFAIL
                      (    forth6809.asm):11014         
                      (    forth6809.asm):11015                         LDD  #TSTCBUF
                      (    forth6809.asm):11016                         PSHU D
                      (    forth6809.asm):11017         
                      (    forth6809.asm):11018                         JSR  CFETCH
                      (    forth6809.asm):11019         
                      (    forth6809.asm):11020                         STU  TSTUAF
                      (    forth6809.asm):11021         
                      (    forth6809.asm):11022                         PULU D
                      (    forth6809.asm):11023                         CMPD #$0034
                      (    forth6809.asm):11024                         BNE  CFFAIL
                      (    forth6809.asm):11025                         PULU D
                      (    forth6809.asm):11026                         CMPD #TSTGUARD
                      (    forth6809.asm):11027                         BNE  CFFAIL
                      (    forth6809.asm):11028         
                      (    forth6809.asm):11029                         LDD  TSTUB4
                      (    forth6809.asm):11030                         SUBD TSTUAF
                      (    forth6809.asm):11031                         CMPD #-2
                      (    forth6809.asm):11032                         BNE  CFFAIL
                      (    forth6809.asm):11033         
                      (    forth6809.asm):11034                         LDD  #TRUEV
                      (    forth6809.asm):11035                         BRA  CFDONE
C100                  (    forth6809.asm):11036         CFFAIL:         LDD  #FALSEV
C100                  (    forth6809.asm):11037         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11038                         PSHU X
                      (    forth6809.asm):11039                         PSHU D
                      (    forth6809.asm):11040                         JSR  TSTREPORT
                      (    forth6809.asm):11041         
                      (    forth6809.asm):11042                         LDU  TSTU0
                      (    forth6809.asm):11043                         RTS
                      (    forth6809.asm):11044         
C100                  (    forth6809.asm):11045         TSTCFNAME: FCB  14
                      (    forth6809.asm):11046                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11047         
                      (    forth6809.asm):11048         ; ------------------------------------------------------------
                      (    forth6809.asm):11049         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11050         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11051         ; correctly.
                      (    forth6809.asm):11052         ; ------------------------------------------------------------
C100                  (    forth6809.asm):11053         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11054                       STD  TSTCBUF
                      (    forth6809.asm):11055         
                      (    forth6809.asm):11056                       STU  TSTU0
                      (    forth6809.asm):11057         
                      (    forth6809.asm):11058                       LDD  #TSTGUARD
                      (    forth6809.asm):11059                       PSHU D
                      (    forth6809.asm):11060                       LDD  #100
                      (    forth6809.asm):11061                       PSHU D
                      (    forth6809.asm):11062                       LDD  #TSTCBUF
                      (    forth6809.asm):11063                       PSHU D
                      (    forth6809.asm):11064                       STU  TSTUB4
                      (    forth6809.asm):11065         
                      (    forth6809.asm):11066                       JSR  PLUSSTORE
                      (    forth6809.asm):11067         
                      (    forth6809.asm):11068                       STU  TSTUAF
                      (    forth6809.asm):11069         
                      (    forth6809.asm):11070                       LDD  TSTCBUF
                      (    forth6809.asm):11071                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11072                       BNE  PSFAIL
                      (    forth6809.asm):11073         
                      (    forth6809.asm):11074                       PULU D
                      (    forth6809.asm):11075                       CMPD #TSTGUARD
                      (    forth6809.asm):11076                       BNE  PSFAIL
                      (    forth6809.asm):11077         
                      (    forth6809.asm):11078                       LDD  TSTUB4
                      (    forth6809.asm):11079                       SUBD TSTUAF
                      (    forth6809.asm):11080                       CMPD #-4
                      (    forth6809.asm):11081                       BNE  PSFAIL
                      (    forth6809.asm):11082         
                      (    forth6809.asm):11083                       LDD  #TRUEV
                      (    forth6809.asm):11084                       BRA  PSDONE
C100                  (    forth6809.asm):11085         PSFAIL:       LDD  #FALSEV
C100                  (    forth6809.asm):11086         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11087                       PSHU X
                      (    forth6809.asm):11088                       PSHU D
                      (    forth6809.asm):11089                       JSR  TSTREPORT
                      (    forth6809.asm):11090         
                      (    forth6809.asm):11091                       LDU  TSTU0
                      (    forth6809.asm):11092                       RTS
                      (    forth6809.asm):11093         
C100                  (    forth6809.asm):11094         TSTPSNAME: FCB  12
                      (    forth6809.asm):11095                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11096         
                      (    forth6809.asm):11097         ; ------------------------------------------------------------
                      (    forth6809.asm):11098         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11099         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11100         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11101         ; the documented convention on both ends).
                      (    forth6809.asm):11102         ; ------------------------------------------------------------
C100                  (    forth6809.asm):11103         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11104         
                      (    forth6809.asm):11105                         LDD  #TSTGUARD
                      (    forth6809.asm):11106                         PSHU D
                      (    forth6809.asm):11107                         LDD  #TSTVAL1
                      (    forth6809.asm):11108                         PSHU D
                      (    forth6809.asm):11109                         LDD  #TSTVAL2
                      (    forth6809.asm):11110                         PSHU D
                      (    forth6809.asm):11111                         LDD  #TSTCBUF
                      (    forth6809.asm):11112                         PSHU D
                      (    forth6809.asm):11113                         STU  TSTUB4
                      (    forth6809.asm):11114         
                      (    forth6809.asm):11115                         JSR  DSTORE
                      (    forth6809.asm):11116         
                      (    forth6809.asm):11117                         LDD  #TSTCBUF
                      (    forth6809.asm):11118                         PSHU D
                      (    forth6809.asm):11119         
                      (    forth6809.asm):11120                         JSR  DFETCH
                      (    forth6809.asm):11121         
                      (    forth6809.asm):11122                         STU  TSTUAF
                      (    forth6809.asm):11123         
                      (    forth6809.asm):11124                         PULU D
                      (    forth6809.asm):11125                         CMPD #TSTVAL2
                      (    forth6809.asm):11126                         BNE  DFFAIL
                      (    forth6809.asm):11127                         PULU D
                      (    forth6809.asm):11128                         CMPD #TSTVAL1
                      (    forth6809.asm):11129                         BNE  DFFAIL
                      (    forth6809.asm):11130                         PULU D
                      (    forth6809.asm):11131                         CMPD #TSTGUARD
                      (    forth6809.asm):11132                         BNE  DFFAIL
                      (    forth6809.asm):11133         
                      (    forth6809.asm):11134                         LDD  TSTUB4
                      (    forth6809.asm):11135                         SUBD TSTUAF
                      (    forth6809.asm):11136                         CMPD #-2
                      (    forth6809.asm):11137                         BNE  DFFAIL
                      (    forth6809.asm):11138         
                      (    forth6809.asm):11139                         LDD  TSTCBUF
                      (    forth6809.asm):11140                         CMPD #TSTVAL1
                      (    forth6809.asm):11141                         BNE  DFFAIL
                      (    forth6809.asm):11142                         LDD  TSTCBUF+2
                      (    forth6809.asm):11143                         CMPD #TSTVAL2
                      (    forth6809.asm):11144                         BNE  DFFAIL
                      (    forth6809.asm):11145         
                      (    forth6809.asm):11146                         LDD  #TRUEV
                      (    forth6809.asm):11147                         BRA  DFDONE
C100                  (    forth6809.asm):11148         DFFAIL:         LDD  #FALSEV
C100                  (    forth6809.asm):11149         DFDONE:         LDX  #TSTDFNAME
                      (    forth6809.asm):11150                         PSHU X
                      (    forth6809.asm):11151                         PSHU D
                      (    forth6809.asm):11152                         JSR  TSTREPORT
                      (    forth6809.asm):11153         
                      (    forth6809.asm):11154                         LDU  TSTU0
                      (    forth6809.asm):11155                         RTS
                      (    forth6809.asm):11156         
C100                  (    forth6809.asm):11157         TSTDFNAME: FCB  14
                      (    forth6809.asm):11158                    FCC  "TST2FETCHSTORE"
                      (    forth6809.asm):11159         
                      (    forth6809.asm):11160         ; ------------------------------------------------------------
                      (    forth6809.asm):11161         ; TSTCODEHERE - combined unit test for , C, ALLOT, and HERE
                      (    forth6809.asm):11162         ; together (glossary section 3.11's own CODEHERE-region words).
                      (    forth6809.asm):11163         ; Redirects CODEHERE to scratch and walks through a sequence:
                      (    forth6809.asm):11164         ; HERE reports the redirected value, COMMA appends a cell (and
                      (    forth6809.asm):11165         ; the written cell is verified directly, not just the advance),
                      (    forth6809.asm):11166         ; C, appends a byte (verified the same way), ALLOT reserves then
                      (    forth6809.asm):11167         ; releases bytes (confirming both directions work, matching
                      (    forth6809.asm):11168         ; "reserve (or release, if negative)"), and a final HERE
                      (    forth6809.asm):11169         ; confirms the cumulative result.
                      (    forth6809.asm):11170         ; ------------------------------------------------------------
C100                  (    forth6809.asm):11171         TSTCODEHERE: LDD  CODEHERE
                      (    forth6809.asm):11172                      STD  TSTCSAV
                      (    forth6809.asm):11173         
                      (    forth6809.asm):11174                      LDD  #TSTCBUF
                      (    forth6809.asm):11175                      STD  CODEHERE
                      (    forth6809.asm):11176         
                      (    forth6809.asm):11177                      STU  TSTU0
                      (    forth6809.asm):11178         
                      (    forth6809.asm):11179                      LDD  #TSTGUARD
                      (    forth6809.asm):11180                      PSHU D
                      (    forth6809.asm):11181                      STU  TSTUB4
                      (    forth6809.asm):11182         
                      (    forth6809.asm):11183                      JSR  HEREW
                      (    forth6809.asm):11184                      PULU D
                      (    forth6809.asm):11185                      CMPD #TSTCBUF
                      (    forth6809.asm):11186                      BNE  CHFAIL
                      (    forth6809.asm):11187         
                      (    forth6809.asm):11188                      LDD  #TSTVAL1
                      (    forth6809.asm):11189                      PSHU D
                      (    forth6809.asm):11190                      JSR  COMMA
                      (    forth6809.asm):11191                      LDD  TSTCBUF
                      (    forth6809.asm):11192                      CMPD #TSTVAL1
                      (    forth6809.asm):11193                      BNE  CHFAIL
                      (    forth6809.asm):11194                      LDD  CODEHERE
                      (    forth6809.asm):11195                      CMPD #TSTCBUF+2
                      (    forth6809.asm):11196                      BNE  CHFAIL
                      (    forth6809.asm):11197         
                      (    forth6809.asm):11198                      LDD  #$56
                      (    forth6809.asm):11199                      PSHU D
                      (    forth6809.asm):11200                      JSR  CCOMMA
                      (    forth6809.asm):11201                      LDA  TSTCBUF+2
                      (    forth6809.asm):11202                      CMPA #$56
                      (    forth6809.asm):11203                      BNE  CHFAIL
                      (    forth6809.asm):11204                      LDD  CODEHERE
                      (    forth6809.asm):11205                      CMPD #TSTCBUF+3
                      (    forth6809.asm):11206                      BNE  CHFAIL
                      (    forth6809.asm):11207         
                      (    forth6809.asm):11208                      LDD  #10
                      (    forth6809.asm):11209                      PSHU D
                      (    forth6809.asm):11210                      JSR  ALLOT
                      (    forth6809.asm):11211                      LDD  CODEHERE
                      (    forth6809.asm):11212                      CMPD #TSTCBUF+13
                      (    forth6809.asm):11213                      BNE  CHFAIL
                      (    forth6809.asm):11214         
                      (    forth6809.asm):11215                      LDD  #-4
                      (    forth6809.asm):11216                      PSHU D
                      (    forth6809.asm):11217                      JSR  ALLOT
                      (    forth6809.asm):11218                      LDD  CODEHERE
                      (    forth6809.asm):11219                      CMPD #TSTCBUF+9
                      (    forth6809.asm):11220                      BNE  CHFAIL
                      (    forth6809.asm):11221         
                      (    forth6809.asm):11222                      JSR  HEREW
                      (    forth6809.asm):11223                      PULU D
                      (    forth6809.asm):11224                      CMPD #TSTCBUF+9
                      (    forth6809.asm):11225                      BNE  CHFAIL
                      (    forth6809.asm):11226         
                      (    forth6809.asm):11227                      STU  TSTUAF
                      (    forth6809.asm):11228         
                      (    forth6809.asm):11229                      PULU D
                      (    forth6809.asm):11230                      CMPD #TSTGUARD
                      (    forth6809.asm):11231                      BNE  CHFAIL
                      (    forth6809.asm):11232         
                      (    forth6809.asm):11233                      LDD  TSTUB4
                      (    forth6809.asm):11234                      SUBD TSTUAF
                      (    forth6809.asm):11235                      CMPD #0
                      (    forth6809.asm):11236                      BNE  CHFAIL
                      (    forth6809.asm):11237         
                      (    forth6809.asm):11238                      LDD  #TRUEV
                      (    forth6809.asm):11239                      BRA  CHDONE
C100                  (    forth6809.asm):11240         CHFAIL:      LDD  #FALSEV
C100                  (    forth6809.asm):11241         CHDONE:      LDX  #TSTCHNAME
                      (    forth6809.asm):11242                      PSHU X
                      (    forth6809.asm):11243                      PSHU D
                      (    forth6809.asm):11244                      JSR  TSTREPORT
                      (    forth6809.asm):11245         
                      (    forth6809.asm):11246                      LDD  TSTCSAV
                      (    forth6809.asm):11247                      STD  CODEHERE
                      (    forth6809.asm):11248         
                      (    forth6809.asm):11249                      LDU  TSTU0
                      (    forth6809.asm):11250                      RTS
                      (    forth6809.asm):11251         
C100                  (    forth6809.asm):11252         TSTCHNAME: FCB  11
                      (    forth6809.asm):11253                    FCC  "TSTCODEHERE"
                      (    forth6809.asm):11254         
                      (    forth6809.asm):11255         ; ------------------------------------------------------------
                      (    forth6809.asm):11256         ; TSTVARHERE - combined unit test for V, VC, VALLOT, and VHERE
                      (    forth6809.asm):11257         ; together - same structure as TSTCODEHERE, but for the
                      (    forth6809.asm):11258         ; mutable/variable region (VARHERE) instead.
                      (    forth6809.asm):11259         ; ------------------------------------------------------------
C100                  (    forth6809.asm):11260         TSTVARHERE: LDD  VARHERE
                      (    forth6809.asm):11261                     STD  TSTVSAV
                      (    forth6809.asm):11262         
                      (    forth6809.asm):11263                     LDD  #TSTVBUF
                      (    forth6809.asm):11264                     STD  VARHERE
                      (    forth6809.asm):11265         
                      (    forth6809.asm):11266                     STU  TSTU0
                      (    forth6809.asm):11267         
                      (    forth6809.asm):11268                     LDD  #TSTGUARD
                      (    forth6809.asm):11269                     PSHU D
                      (    forth6809.asm):11270                     STU  TSTUB4
                      (    forth6809.asm):11271         
                      (    forth6809.asm):11272                     JSR  VHEREW

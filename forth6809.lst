EB84 ED44             (    forth6809.asm):04869                     STD   4,U
EB86 10AFC4           (    forth6809.asm):04870                     STY   ,U
EB89 AF42             (    forth6809.asm):04871                     STX   2,U
EB8B 39               (    forth6809.asm):04872                     RTS
                      (    forth6809.asm):04873         
                      (    forth6809.asm):04874         ; ------------------------------------------------------------
                      (    forth6809.asm):04875         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):04876         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):04877         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):04878         ; the transfer.
                      (    forth6809.asm):04879         ; ------------------------------------------------------------
EB8C 3706             (    forth6809.asm):04880         TORW:       PULU  D                 ; x
EB8E 3510             (    forth6809.asm):04881                     PULS  X
EB90 3406             (    forth6809.asm):04882                     PSHS  D
EB92 3410             (    forth6809.asm):04883                     PSHS  X
EB94 39               (    forth6809.asm):04884                     RTS
                      (    forth6809.asm):04885         
                      (    forth6809.asm):04886         ; ------------------------------------------------------------
                      (    forth6809.asm):04887         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):04888         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):04889         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):04890         ; the transfer.
                      (    forth6809.asm):04891         ; ------------------------------------------------------------
EB95 3510             (    forth6809.asm):04892         FROMRW:     PULS  X
EB97 3506             (    forth6809.asm):04893                     PULS  D                 ; x
EB99 3410             (    forth6809.asm):04894                     PSHS  X
EB9B 3606             (    forth6809.asm):04895                     PSHU  D
EB9D 39               (    forth6809.asm):04896                     RTS
                      (    forth6809.asm):04897         
                      (    forth6809.asm):04898         ; ------------------------------------------------------------
                      (    forth6809.asm):04899         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):04900         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):04901         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):04902         ; back around the transfer.
                      (    forth6809.asm):04903         ; ------------------------------------------------------------
EB9E 3510             (    forth6809.asm):04904         RFETCHW:    PULS  X
EBA0 ECE4             (    forth6809.asm):04905                     LDD   ,S                ; x
EBA2 3410             (    forth6809.asm):04906                     PSHS  X
EBA4 3606             (    forth6809.asm):04907                     PSHU  D
EBA6 39               (    forth6809.asm):04908                     RTS
                      (    forth6809.asm):04909         
                      (    forth6809.asm):04910         ; ------------------------------------------------------------
                      (    forth6809.asm):04911         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):04912         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):04913         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):04914         ; put back around the transfer.
                      (    forth6809.asm):04915         ; ------------------------------------------------------------
EBA7 3510             (    forth6809.asm):04916         TWOTORW:    PULS  X                 ; return address
EBA9 3706             (    forth6809.asm):04917                     PULU  D                 ; x2
EBAB 3720             (    forth6809.asm):04918                     PULU  Y                 ; x1
EBAD 3420             (    forth6809.asm):04919                     PSHS  Y
EBAF 3406             (    forth6809.asm):04920                     PSHS  D
EBB1 3410             (    forth6809.asm):04921                     PSHS  X
EBB3 39               (    forth6809.asm):04922                     RTS
                      (    forth6809.asm):04923         
                      (    forth6809.asm):04924         ; ------------------------------------------------------------
                      (    forth6809.asm):04925         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):04926         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):04927         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):04928         ; put back around the transfer.
                      (    forth6809.asm):04929         ; ------------------------------------------------------------
EBB4 3510             (    forth6809.asm):04930         TWOFROMRW:  PULS  X                 ; return address
EBB6 3506             (    forth6809.asm):04931                     PULS  D                 ; x2
EBB8 3520             (    forth6809.asm):04932                     PULS  Y                 ; x1
EBBA 3410             (    forth6809.asm):04933                     PSHS  X
EBBC 3620             (    forth6809.asm):04934                     PSHU  Y
EBBE 3606             (    forth6809.asm):04935                     PSHU  D
EBC0 39               (    forth6809.asm):04936                     RTS
                      (    forth6809.asm):04937         
                      (    forth6809.asm):04938         ; ------------------------------------------------------------
                      (    forth6809.asm):04939         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):04940         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):04941         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):04942         ; and put back around the transfer.
                      (    forth6809.asm):04943         ; ------------------------------------------------------------
EBC1 3510             (    forth6809.asm):04944         TWORFETCHW: PULS  X                 ; return address
EBC3 ECE4             (    forth6809.asm):04945                     LDD   ,S                ; x2
EBC5 10AE62           (    forth6809.asm):04946                     LDY   2,S               ; x1
EBC8 3410             (    forth6809.asm):04947                     PSHS  X
EBCA 3620             (    forth6809.asm):04948                     PSHU  Y
EBCC 3606             (    forth6809.asm):04949                     PSHU  D
EBCE 39               (    forth6809.asm):04950                     RTS

                      (    forth6809.asm):07461         ; ============================================================
                      (    forth6809.asm):07462         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):07463         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):07464         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):07465         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):07466         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):07467         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):07468         ; ============================================================
                      (    forth6809.asm):07469         ; ------------------------------------------------------------
                      (    forth6809.asm):07470         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):07471         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):07472         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):07473         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):07474         ; - no indirection, no value cell.
                      (    forth6809.asm):07475         ;
                      (    forth6809.asm):07476         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):07477         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):07478         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):07479         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):07480         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):07481         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):07482         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):07483         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):07484         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):07485         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):07486         ; ------------------------------------------------------------
FF64 CCFFFF           (    forth6809.asm):07487         TRUEBODY:  LDD   #$FFFF
FF67 3606             (    forth6809.asm):07488                    PSHU  D
FF69 39               (    forth6809.asm):07489                    RTS
                      (    forth6809.asm):07490         
FF6A CC0000           (    forth6809.asm):07491         FALSEBODY: LDD   #$0000
FF6D 3606             (    forth6809.asm):07492                    PSHU  D
FF6F 39               (    forth6809.asm):07493                    RTS
                      (    forth6809.asm):07494         
                      (    forth6809.asm):07495         ; ------------------------------------------------------------
                      (    forth6809.asm):07496         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):07497         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):07498         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):07499         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):07500         ; ------------------------------------------------------------
FF70 CC0001           (    forth6809.asm):07501         ONEBODY:   LDD   #1
FF73 3606             (    forth6809.asm):07502                    PSHU  D
FF75 39               (    forth6809.asm):07503                    RTS
                      (    forth6809.asm):07504         
FF76 CCFFFF           (    forth6809.asm):07505         MONEBODY:  LDD   #-1
FF79 3606             (    forth6809.asm):07506                    PSHU  D
FF7B 39               (    forth6809.asm):07507                    RTS
                      (    forth6809.asm):07508         
FF7C CC0002           (    forth6809.asm):07509         TWOBODY:   LDD   #2
FF7F 3606             (    forth6809.asm):07510                    PSHU  D
FF81 39               (    forth6809.asm):07511                    RTS
                      (    forth6809.asm):07512         
FF82 CCFFFE           (    forth6809.asm):07513         MTWOBODY:  LDD   #-2
FF85 3606             (    forth6809.asm):07514                    PSHU  D
FF87 39               (    forth6809.asm):07515                    RTS

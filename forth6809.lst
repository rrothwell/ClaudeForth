                      (    forth6809.asm):08139         ; SECTION 2: INIT CODE (COLDSTRT / WARM)
                      (    forth6809.asm):08140         ; ============================================================
                      (    forth6809.asm):08141                  ORG   INITCODE       ; INITCODE is $FFA9 (was $FFA2, before that $FFA0, before that literal $FFC0)
FFA4                  (    forth6809.asm):08142         COLDSTRT:
FFA4 1A50             (    forth6809.asm):08143                  ORCC  #$50        ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):08144                  LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):08145                  LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):08146                  CLRA
FFAE 1F8B             (    forth6809.asm):08147                  TFR   A,DP
                      (    forth6809.asm):08148         
FFB0 8E0000           (    forth6809.asm):08149                  LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):08150                  LDB   #0
FFB5 6F80             (    forth6809.asm):08151         CLRGLOB: CLR   ,X+
FFB7 5A               (    forth6809.asm):08152                  DECB
FFB8 26FB             (    forth6809.asm):08153                  BNE   CLRGLOB
                      (    forth6809.asm):08154         
FFBA BDDD73           (    forth6809.asm):08155                  JSR   INITSERIAL
                      (    forth6809.asm):08156         
FFBD 1CAF             (    forth6809.asm):08157                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):08158         
                      (    forth6809.asm):08159                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):08160                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):08161                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):08162                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):08163                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):08164                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):08165                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):08166                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):08167                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):08168                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):08169                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):08170                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):08171                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):08172                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):08173                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):08174                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):08175                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):08176                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):08177                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):08178                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):08179                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):08180                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):08181                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):08182                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):08183                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):08184                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):08185                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):08186                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):08187                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):08188                                  ; too, not just the eventual interactive
                      (    forth6809.asm):08189                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):08190                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):08191                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):08192                                  ; nothing on this system ever drives it
                      (    forth6809.asm):08193                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):08194                                  ; unused vectors).
                      (    forth6809.asm):08195         
                      (    forth6809.asm):08196                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):08197                  JSR   TSTRUNNER
                      (    forth6809.asm):08198                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08199                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):08200                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):08201                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):08202                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):08203                                  ; excluded the test framework, meaning
                      (    forth6809.asm):08204                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):08205                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):08206                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):08207                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):08208                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):08209                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):08210                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):08211                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):08212                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):08213                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):08214                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):08215         
FFC2 7EDD90           (    forth6809.asm):08216                  JMP   COLD
                      (    forth6809.asm):08217         
FFC5 1A50             (    forth6809.asm):08218         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):08219                  CLRA
FFC8 1F8B             (    forth6809.asm):08220                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):08221                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):08222                  LDS   #RP0
                      (    forth6809.asm):08223         
FFD1 BDDD73           (    forth6809.asm):08224                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):08225                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):08226                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):08227                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):08228                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):08229                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):08230                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):08231                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):08232                                         ; reported separately) left either side
                      (    forth6809.asm):08233                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):08234                                         ; would previously have inherited it
                      (    forth6809.asm):08235                                         ; unchanged rather than genuinely
                      (    forth6809.asm):08236                                         ; recovering. Placed here, matching
                      (    forth6809.asm):08237                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):08238                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):08239                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):08240                                         ; only once setup is complete.
                      (    forth6809.asm):08241         
FFD4 8EFFE6           (    forth6809.asm):08242                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):08243                  PSHU  X
FFD9 CC0006           (    forth6809.asm):08244                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):08245                  PSHU  D
FFDE BDF56F           (    forth6809.asm):08246                  JSR   TYPE
FFE1 1CAF             (    forth6809.asm):08247                  ANDCC #$AF
FFE3 7EDDC5           (    forth6809.asm):08248                  JMP   ABORT      ; Enable IRQ & FIRQ
                      (    forth6809.asm):08249         
FFE6 20207761726D     (    forth6809.asm):08250         WARMMSG: FCC   "  warm"
     0006             (    forth6809.asm):08251         WARMMSGL EQU   *-WARMMSG
                      (    forth6809.asm):08252         

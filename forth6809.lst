                      (    forth6809.asm):01196                   PSHU D
                      (    forth6809.asm):01197                   JSR  TSTREPORT
                      (    forth6809.asm):01198         
                      (    forth6809.asm):01199                   LDU  TSTU0
                      (    forth6809.asm):01200                   RTS
                      (    forth6809.asm):01201         

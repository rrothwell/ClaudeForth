                      (    forth6809.asm):01567         ; INITSERIAL
                      (    forth6809.asm):01568         ;    Inputs:
                      (    forth6809.asm):01569         ;        none
                      (    forth6809.asm):01570         ;    Outputs:
                      (    forth6809.asm):01571         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01572         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01573         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01574         ; See bugfix: INITSERIAL.1.

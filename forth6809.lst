E37A 263C             (    forth6809.asm):03357                     BNE   NQBAD
                      (    forth6809.asm):03358         
                      (    forth6809.asm):03359                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
E37C 0D22             (    forth6809.asm):03360                     TST   NUMNEG
E37E 2713             (    forth6809.asm):03361                     BEQ   NQPOS32
E380 DC76             (    forth6809.asm):03362                     LDD   UDLO
E382 DD5F             (    forth6809.asm):03363                     STD   PRODLO
E384 DC74             (    forth6809.asm):03364                     LDD   UDHI
E386 DD5D             (    forth6809.asm):03365                     STD   PRODHI
E388 BDEDF0           (    forth6809.asm):03366                     JSR   MNEG32            ; shared negate. See bugfix: NUMBERQ.5
E38B DC5F             (    forth6809.asm):03367                     LDD   PRODLO
E38D DD76             (    forth6809.asm):03368                     STD   UDLO
E38F DC5D             (    forth6809.asm):03369                     LDD   PRODHI
E391 DD74             (    forth6809.asm):03370                     STD   UDHI
                      (    forth6809.asm):03371         
E393                  (    forth6809.asm):03372         NQPOS32:                            ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03373                     ; was '.' - determines which return convention to use
E393 9E1F             (    forth6809.asm):03374                     LDX   CADDR
E395 E684             (    forth6809.asm):03375                     LDB   ,X
E397 5A               (    forth6809.asm):03376                     DECB
E398 3001             (    forth6809.asm):03377                     LEAX  1,X

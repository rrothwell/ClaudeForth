                      (    forth6809.asm):01814                  LDA   B,X
                      (    forth6809.asm):01815                  STA   ACIADR
                      (    forth6809.asm):01816                  INCB
                      (    forth6809.asm):01817                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01818                  STB   OUTTAIL
                      (    forth6809.asm):01819                  BRA   IRQDONE
                      (    forth6809.asm):01820         
E035                  (    forth6809.asm):01821         TXOFF:   TST   RTSSTATE
                      (    forth6809.asm):01822                  BNE   IRQDONE         ; RTS is asserted high - leave ACIACR alone,

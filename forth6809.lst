F8AA 3706             (    forth6809.asm):05911         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F8AC DDAB             (    forth6809.asm):05912                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):05913                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):05914                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):05915                                   ; real source length was misread as an
                      (    forth6809.asm):05916                                   ; address, the real source address was never
                      (    forth6809.asm):05917                                   ; popped at all, and the true destination
                      (    forth6809.asm):05918                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):05919                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):05920                                   ; c-addr2 (dest) is on top, popped first.
F8AE 3706             (    forth6809.asm):05921                    PULU D         ; next: u1 (source length)
F8B0 DDA9             (    forth6809.asm):05922                    STD  UESRCLEN
F8B2 3706             (    forth6809.asm):05923                    PULU D         ; next: c-addr1 (source address)
F8B4 DDA7             (    forth6809.asm):05924                    STD  UEADDR
F8B6 CC0000           (    forth6809.asm):05925                    LDD  #0
F8B9 DDAD             (    forth6809.asm):05926                    STD  UEOUTLEN
F8BB 9EA7             (    forth6809.asm):05927                    LDX  UEADDR
F8BD 109EAB           (    forth6809.asm):05928                    LDY  UEDST
                      (    forth6809.asm):05929         
                      (    forth6809.asm):05930                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):05931                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):05932                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):05933                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):05934                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):05935                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):05936                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):05937                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):05938                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):05939                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):05940                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):05941                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):05942                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):05943                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):05944                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):05945                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):05946                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):05947                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):05948                    ; wrong algorithm entirely, not a smaller bug within it.
F8C0 DCA9             (    forth6809.asm):05949         UELOOP:    LDD  UESRCLEN
F8C2 2715             (    forth6809.asm):05950                    BEQ  UEDONE
F8C4 A680             (    forth6809.asm):05951                    LDA  ,X+
F8C6 8125             (    forth6809.asm):05952                    CMPA #'%'
F8C8 2604             (    forth6809.asm):05953                    BNE  UENOTPCT
F8CA C625             (    forth6809.asm):05954                    LDB  #'%'      ; write the extra '%' first - the character
F8CC E7A0             (    forth6809.asm):05955                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):05956                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):05957                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):05958                                   ; the same string correctly, since this runs
                      (    forth6809.asm):05959                                   ; independently for each one the loop visits.
F8CE A7A0             (    forth6809.asm):05960         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):05961                                   ; every character, '%' or not
F8D0 DCA9             (    forth6809.asm):05962                    LDD  UESRCLEN
F8D2 830001           (    forth6809.asm):05963                    SUBD #1
F8D5 DDA9             (    forth6809.asm):05964                    STD  UESRCLEN
F8D7 20E7             (    forth6809.asm):05965                    BRA  UELOOP
F8D9 1F20             (    forth6809.asm):05966         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F8DB 93AB             (    forth6809.asm):05967                    SUBD UEDST     ; overwriting whatever was left on top of
F8DD DDAD             (    forth6809.asm):05968                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):05969                                   ; required return values, and separately,
                      (    forth6809.asm):05970                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):05971                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):05972                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):05973                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):05974                                   ; characters. Now computed directly as the
                      (    forth6809.asm):05975                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):05976                                   ; original destination address (UEDST) -
                      (    forth6809.asm):05977                                   ; correct regardless of how many characters
                      (    forth6809.asm):05978                                   ; were doubled, since it's derived from
                      (    forth6809.asm):05979                                   ; where writing actually stopped rather than
                      (    forth6809.asm):05980                                   ; incremented alongside it.
F8DF DCAB             (    forth6809.asm):05981                    LDD  UEDST
F8E1 3606             (    forth6809.asm):05982                    PSHU D         ; push c-addr2 (destination address)
F8E3 DCAD             (    forth6809.asm):05983                    LDD  UEOUTLEN
F8E5 3606             (    forth6809.asm):05984                    PSHU D         ; push u2 (actual unescaped length)
F8E7 39               (    forth6809.asm):05985                    RTS
                      (    forth6809.asm):05986         
                      (    forth6809.asm):05987         ; REPLACES/SUBSTITUTE - single-slot simplified version, per
                      (    forth6809.asm):05988         ; the explicit scoping-down discussed in the source conversation

                      (    forth6809.asm):06203         ; ============================================================
                      (    forth6809.asm):06204         ; ------------------------------------------------------------
                      (    forth6809.asm):06205         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06206         ; address and length and skip over it.
                      (    forth6809.asm):06207         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06208         ;    Inputs:
                      (    forth6809.asm):06209         ;        return address on S points at the count byte
                      (    forth6809.asm):06210         ;    Outputs:
                      (    forth6809.asm):06211         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06212         ;        string
                      (    forth6809.asm):06213         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06214         ; ------------------------------------------------------------
F37D 3510             (    forth6809.asm):06215         DOSTR:      PULS  X
F37F E684             (    forth6809.asm):06216                     LDB   ,X
F381 3001             (    forth6809.asm):06217                     LEAX  1,X
F383 3610             (    forth6809.asm):06218                     PSHU  X

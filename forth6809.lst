                      (    forth6809.asm):08218                    STD  VARHERE
                      (    forth6809.asm):08219                    LDD  #TSTNAMEB
                      (    forth6809.asm):08220                    STD  SRCADDR
                      (    forth6809.asm):08221                    LDD  #6
                      (    forth6809.asm):08222                    STD  SRCLEN
                      (    forth6809.asm):08223                    LDD  #0
                      (    forth6809.asm):08224                    STD  TOIN

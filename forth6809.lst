                      (    forth6809.asm):02596         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02597         ; ============================================================
DD90 CC021B           (    forth6809.asm):02598         COLD:    LDD   #APPVARS
DD93 DD0A             (    forth6809.asm):02599                  STD   VARHERE
DD95 CC7000           (    forth6809.asm):02600                  LDD   #APPCODE
DD98 DD08             (    forth6809.asm):02601                  STD   CODEHERE
DD9A CC2000           (    forth6809.asm):02602                  LDD   #APPDICT
DD9D DD06             (    forth6809.asm):02603                  STD   DPHERE
DD9F CCDD4D           (    forth6809.asm):02604                  LDD   #BASELATEST
DDA2 DD04             (    forth6809.asm):02605                  STD   LATEST
                      (    forth6809.asm):02606         
DDA4 CC000A           (    forth6809.asm):02607                  LDD   #10
DDA7 DD02             (    forth6809.asm):02608                  STD   BASE
                      (    forth6809.asm):02609         
DDA9 CC0106           (    forth6809.asm):02610                  LDD   #TIBBUF
DDAC DDDB             (    forth6809.asm):02611                  STD   SRCADDR
DDAE CC0000           (    forth6809.asm):02612                  LDD   #0
DDB1 DDDD             (    forth6809.asm):02613                  STD   SRCLEN
DDB3 DDDF             (    forth6809.asm):02614                  STD   SRCID
                      (    forth6809.asm):02615         
DDB5 8EDE3D           (    forth6809.asm):02616                  LDX   #SIGNON
DDB8 3610             (    forth6809.asm):02617                  PSHU  X
DDBA CC000F           (    forth6809.asm):02618                  LDD   #SIGNONL
DDBD 3606             (    forth6809.asm):02619                  PSHU  D
DDBF BDF56B           (    forth6809.asm):02620                  JSR   TYPE
DDC2 BDFB8B           (    forth6809.asm):02621                  JSR   CRW
                      (    forth6809.asm):02622                  ; falls through into ABORT
                      (    forth6809.asm):02623         
DDC5 CEBD00           (    forth6809.asm):02624         ABORT:   LDU   #SP0
                      (    forth6809.asm):02625                  ; falls through into QUIT
                      (    forth6809.asm):02626         
DDC8 10CEC000         (    forth6809.asm):02627         QUIT:    LDS   #RP0
DDCC CC0000           (    forth6809.asm):02628                  LDD   #0        ; BUG FIX: this reset used to live at QLOOP
DDCF DD00             (    forth6809.asm):02629                  STD   STATE     ; below, running on EVERY line - including
                      (    forth6809.asm):02630                                   ; lines in the middle of a colon definition
                      (    forth6809.asm):02631                                   ; that spans more than one line of input.
                      (    forth6809.asm):02632                                   ; COLON (sets STATE=-1) and SEMI (sets
                      (    forth6809.asm):02633                                   ; STATE=0, after checking CSP) are the
                      (    forth6809.asm):02634                                   ; correct, sole places STATE should change
                      (    forth6809.asm):02635                                   ; during normal operation - the old QLOOP
                      (    forth6809.asm):02636                                   ; reset was a third, redundant one that
                      (    forth6809.asm):02637                                   ; silently dropped back to interpret mode
                      (    forth6809.asm):02638                                   ; every time QUERY read a new line,
                      (    forth6809.asm):02639                                   ; regardless of whether ";" had actually
                      (    forth6809.asm):02640                                   ; been reached. A colon definition split
                      (    forth6809.asm):02641                                   ; across multiple lines would have every
                      (    forth6809.asm):02642                                   ; word on every line after the first
                      (    forth6809.asm):02643                                   ; interpreted (and, for anything with a
                      (    forth6809.asm):02644                                   ; stack effect, executed) instead of
                      (    forth6809.asm):02645                                   ; compiled - "TRUE" pushing TRUEV onto the
                      (    forth6809.asm):02646                                   ; data stack instead of being compiled,
                      (    forth6809.asm):02647                                   ; leaving a stray cell CSP would correctly
                      (    forth6809.asm):02648                                   ; catch as a mismatch at ";" (-22). Moved
                      (    forth6809.asm):02649                                   ; here rather than removed outright: QUIT is
                      (    forth6809.asm):02650                                   ; only re-entered on cold boot or an
                      (    forth6809.asm):02651                                   ; uncaught error routing back through ABORT

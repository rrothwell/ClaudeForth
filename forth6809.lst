                      (    forth6809.asm):01541         ;        none
                      (    forth6809.asm):01542         ;    Outputs:
                      (    forth6809.asm):01543         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,

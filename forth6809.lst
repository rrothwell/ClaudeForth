                      (    forth6809.asm):03705         
                      (    forth6809.asm):03706         ; ============================================================
                      (    forth6809.asm):03707         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03708         ; ============================================================
                      (    forth6809.asm):03709         ; ------------------------------------------------------------
                      (    forth6809.asm):03710         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03711         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03712         ; one expected.
                      (    forth6809.asm):03713         ; CFERR
                      (    forth6809.asm):03714         ;    Inputs:
                      (    forth6809.asm):03715         ;        none
                      (    forth6809.asm):03716         ;    Outputs:
                      (    forth6809.asm):03717         ;        does not return (THROW -22)
                      (    forth6809.asm):03718         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03719         ; ------------------------------------------------------------
E545 CCFFEA           (    forth6809.asm):03720         CFERR:      LDD   #-22
E548 3606             (    forth6809.asm):03721                     PSHU  D                 ; -22
E54A BDE57A           (    forth6809.asm):03722                     JSR   THROW
E54D 39               (    forth6809.asm):03723                     RTS
                      (    forth6809.asm):03724         
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
                      (    forth6809.asm):03726         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03727         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03728         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03729         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03730         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03731         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03732         ; ------------------------------------------------------------
E54E 3710             (    forth6809.asm):03733         CATCHW:     PULU  X                 ; xt
E550 DC0C             (    forth6809.asm):03734                     LDD   HANDLER
E552 3406             (    forth6809.asm):03735                     PSHS  D
E554 3440             (    forth6809.asm):03736                     PSHS  U
                      (    forth6809.asm):03737                     ; Save the input source specification.
                      (    forth6809.asm):03738                     ; See bugfix: CATCHW.1
E556 DCDB             (    forth6809.asm):03739                     LDD   SRCADDR
E558 3406             (    forth6809.asm):03740                     PSHS  D
E55A DCDD             (    forth6809.asm):03741                     LDD   SRCLEN
E55C 3406             (    forth6809.asm):03742                     PSHS  D
E55E DCDF             (    forth6809.asm):03743                     LDD   SRCID
E560 3406             (    forth6809.asm):03744                     PSHS  D
E562 DC10             (    forth6809.asm):03745                     LDD   TOIN
E564 3406             (    forth6809.asm):03746                     PSHS  D
E566 1F40             (    forth6809.asm):03747                     TFR   S,D
E568 DD0C             (    forth6809.asm):03748                     STD   HANDLER
                      (    forth6809.asm):03749         
E56A AD84             (    forth6809.asm):03750                     JSR   ,X
                      (    forth6809.asm):03751         
E56C 3268             (    forth6809.asm):03752                     LEAS  8,S               ; drop saved input source
E56E 3262             (    forth6809.asm):03753                     LEAS  2,S               ; saved U
E570 3506             (    forth6809.asm):03754                     PULS  D
E572 DD0C             (    forth6809.asm):03755                     STD   HANDLER
E574 CC0000           (    forth6809.asm):03756                     LDD   #0
E577 3606             (    forth6809.asm):03757                     PSHU  D                 ; 0 = no exception
E579 39               (    forth6809.asm):03758                     RTS
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03762         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03763         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03764         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
E57A 3706             (    forth6809.asm):03766         THROW:      PULU  D                 ; n
E57C 10830000         (    forth6809.asm):03767                     CMPD  #0
E580 2725             (    forth6809.asm):03768                     BEQ   THDONE
                      (    forth6809.asm):03769         
E582 DD0E             (    forth6809.asm):03770                     STD   THROWN
E584 9E0C             (    forth6809.asm):03771                     LDX   HANDLER
E586 2720             (    forth6809.asm):03772                     BEQ   THUNCAU
                      (    forth6809.asm):03773         
E588 1F14             (    forth6809.asm):03774                     TFR   X,S
E58A 3506             (    forth6809.asm):03775                     PULS  D                 ; restore input source saved by CATCH
E58C DD10             (    forth6809.asm):03776                     STD   TOIN
E58E 3506             (    forth6809.asm):03777                     PULS  D
E590 DDDF             (    forth6809.asm):03778                     STD   SRCID
E592 3506             (    forth6809.asm):03779                     PULS  D
E594 DDDD             (    forth6809.asm):03780                     STD   SRCLEN
E596 3506             (    forth6809.asm):03781                     PULS  D
E598 DDDB             (    forth6809.asm):03782                     STD   SRCADDR
E59A 3506             (    forth6809.asm):03783                     PULS  D
E59C 1F03             (    forth6809.asm):03784                     TFR   D,U
E59E 3506             (    forth6809.asm):03785                     PULS  D
E5A0 DD0C             (    forth6809.asm):03786                     STD   HANDLER
                      (    forth6809.asm):03787         
E5A2 DC0E             (    forth6809.asm):03788                     LDD   THROWN
E5A4 3606             (    forth6809.asm):03789                     PSHU  D
E5A6 39               (    forth6809.asm):03790                     RTS
E5A7 39               (    forth6809.asm):03791         THDONE:     RTS
                      (    forth6809.asm):03792         
                      (    forth6809.asm):03793                     ; No CATCH is active: leave n on the stack and ABORT.
E5A8 DC0E             (    forth6809.asm):03794         THUNCAU:    LDD   THROWN
E5AA 3606             (    forth6809.asm):03795                     PSHU  D
E5AC 7EDD3F           (    forth6809.asm):03796                     JMP   ABORT
                      (    forth6809.asm):03797         
                      (    forth6809.asm):03798         ; ============================================================
                      (    forth6809.asm):03799         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03800         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03801         ; ============================================================
                      (    forth6809.asm):03802         ; ------------------------------------------------------------
                      (    forth6809.asm):03803         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03804         ; location.
                      (    forth6809.asm):03805         ; PATCH   ( target location -- )
                      (    forth6809.asm):03806         ;    Inputs:
                      (    forth6809.asm):03807         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03808         ;    Outputs:
                      (    forth6809.asm):03809         ;        the cell at location holds target - location
                      (    forth6809.asm):03810         ;    Registers: RegD and RegX changed; PFIELD and PTARGET used as
                      (    forth6809.asm):03811         ;        scratch.
                      (    forth6809.asm):03812         ; ------------------------------------------------------------
E5AF 3706             (    forth6809.asm):03813         PATCH:      PULU  D
E5B1 DD44             (    forth6809.asm):03814                     STD   PFIELD            ; location
E5B3 3706             (    forth6809.asm):03815                     PULU  D
E5B5 DD42             (    forth6809.asm):03816                     STD   PTARGET           ; target
E5B7 DC42             (    forth6809.asm):03817                     LDD   PTARGET
E5B9 9344             (    forth6809.asm):03818                     SUBD  PFIELD
E5BB 9E44             (    forth6809.asm):03819                     LDX   PFIELD
E5BD ED84             (    forth6809.asm):03820                     STD   ,X
E5BF 39               (    forth6809.asm):03821                     RTS
                      (    forth6809.asm):03822         
                      (    forth6809.asm):03823         ; ------------------------------------------------------------
                      (    forth6809.asm):03824         ; IF  ( C: -- orig )
                      (    forth6809.asm):03825         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03826         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03827         ; ------------------------------------------------------------
E5C0 CCDDE5           (    forth6809.asm):03828         IFW:        LDD   #ZBRANCH
E5C3 3606             (    forth6809.asm):03829                     PSHU  D
E5C5 BDE9F5           (    forth6809.asm):03830                     JSR   CCALL
E5C8 CC0000           (    forth6809.asm):03831                     LDD   #0
E5CB 3606             (    forth6809.asm):03832                     PSHU  D
E5CD BDDE78           (    forth6809.asm):03833                     JSR   CODECOMMA
E5D0 DC08             (    forth6809.asm):03834                     LDD   CODEHERE
E5D2 830002           (    forth6809.asm):03835                     SUBD  #2
E5D5 3606             (    forth6809.asm):03836                     PSHU  D                 ; orig
E5D7 CC0001           (    forth6809.asm):03837                     LDD   #TAGFWD
E5DA 3606             (    forth6809.asm):03838                     PSHU  D
E5DC 39               (    forth6809.asm):03839                     RTS
                      (    forth6809.asm):03840         
                      (    forth6809.asm):03841         ; ------------------------------------------------------------
                      (    forth6809.asm):03842         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03843         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03844         ; operand to jump to the current code address.
                      (    forth6809.asm):03845         ; ------------------------------------------------------------
E5DD 3706             (    forth6809.asm):03846         THENW:      PULU  D
E5DF 10830001         (    forth6809.asm):03847                     CMPD  #TAGFWD
E5E3 2703             (    forth6809.asm):03848                     BEQ   THOK
E5E5 BDE545           (    forth6809.asm):03849                     JSR   CFERR
E5E8 3710             (    forth6809.asm):03850         THOK:       PULU  X                 ; orig
E5EA DC08             (    forth6809.asm):03851                     LDD   CODEHERE
E5EC 3606             (    forth6809.asm):03852                     PSHU  D
E5EE 3610             (    forth6809.asm):03853                     PSHU  X
E5F0 BDE5AF           (    forth6809.asm):03854                     JSR   PATCH
E5F3 39               (    forth6809.asm):03855                     RTS
                      (    forth6809.asm):03856         
                      (    forth6809.asm):03857         ; ------------------------------------------------------------
                      (    forth6809.asm):03858         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03859         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03860         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03861         ; ------------------------------------------------------------
E5F4 3706             (    forth6809.asm):03862         ELSEW:      PULU  D
E5F6 10830001         (    forth6809.asm):03863                     CMPD  #TAGFWD
E5FA 2703             (    forth6809.asm):03864                     BEQ   ELOK
E5FC BDE545           (    forth6809.asm):03865                     JSR   CFERR
E5FF 3706             (    forth6809.asm):03866         ELOK:       PULU  D                 ; orig1
E601 DD29             (    forth6809.asm):03867                     STD   MSCR              ; See bugfix: ELSEW.1
E603 CCDDFB           (    forth6809.asm):03868                     LDD   #BRANCH
E606 3606             (    forth6809.asm):03869                     PSHU  D
E608 BDE9F5           (    forth6809.asm):03870                     JSR   CCALL
E60B CC0000           (    forth6809.asm):03871                     LDD   #0
E60E 3606             (    forth6809.asm):03872                     PSHU  D
E610 BDDE78           (    forth6809.asm):03873                     JSR   CODECOMMA
E613 DC08             (    forth6809.asm):03874                     LDD   CODEHERE
E615 830002           (    forth6809.asm):03875                     SUBD  #2
E618 DD46             (    forth6809.asm):03876                     STD   NEWFLD
E61A DC08             (    forth6809.asm):03877                     LDD   CODEHERE
E61C 3606             (    forth6809.asm):03878                     PSHU  D
E61E DC29             (    forth6809.asm):03879                     LDD   MSCR
E620 3606             (    forth6809.asm):03880                     PSHU  D
E622 BDE5AF           (    forth6809.asm):03881                     JSR   PATCH
E625 DC46             (    forth6809.asm):03882                     LDD   NEWFLD
E627 3606             (    forth6809.asm):03883                     PSHU  D                 ; orig2
E629 CC0001           (    forth6809.asm):03884                     LDD   #TAGFWD
E62C 3606             (    forth6809.asm):03885                     PSHU  D
E62E 39               (    forth6809.asm):03886                     RTS
                      (    forth6809.asm):03887         
                      (    forth6809.asm):03888         ; ------------------------------------------------------------
                      (    forth6809.asm):03889         ; BEGIN  ( C: -- dest )
                      (    forth6809.asm):03890         ; Leave the current code address and TAGBACK on the control-flow
                      (    forth6809.asm):03891         ; stack.
                      (    forth6809.asm):03892         ; ------------------------------------------------------------
E62F DC08             (    forth6809.asm):03893         BEGINW:     LDD   CODEHERE
E631 3606             (    forth6809.asm):03894                     PSHU  D                 ; dest
E633 CC0002           (    forth6809.asm):03895                     LDD   #TAGBACK
E636 3606             (    forth6809.asm):03896                     PSHU  D
E638 39               (    forth6809.asm):03897                     RTS
                      (    forth6809.asm):03898         
                      (    forth6809.asm):03899         ; ------------------------------------------------------------
                      (    forth6809.asm):03900         ; UNTIL  ( C: dest -- )
                      (    forth6809.asm):03901         ; Compile ZBRANCH with a displacement back to dest.
                      (    forth6809.asm):03902         ; ------------------------------------------------------------
E639 3706             (    forth6809.asm):03903         UNTILW:     PULU  D
E63B 10830002         (    forth6809.asm):03904                     CMPD  #TAGBACK
E63F 2703             (    forth6809.asm):03905                     BEQ   UNOK
E641 BDE545           (    forth6809.asm):03906                     JSR   CFERR
E644 3706             (    forth6809.asm):03907         UNOK:       PULU  D                 ; dest
E646 3606             (    forth6809.asm):03908                     PSHU  D                 ; park dest. See bugfix: UNTILW.1
E648 CCDDE5           (    forth6809.asm):03909                     LDD   #ZBRANCH
E64B 3606             (    forth6809.asm):03910                     PSHU  D
E64D BDE9F5           (    forth6809.asm):03911                     JSR   CCALL
E650 CC0000           (    forth6809.asm):03912                     LDD   #0
E653 3606             (    forth6809.asm):03913                     PSHU  D
E655 BDDE78           (    forth6809.asm):03914                     JSR   CODECOMMA
E658 DC08             (    forth6809.asm):03915                     LDD   CODEHERE
E65A 830002           (    forth6809.asm):03916                     SUBD  #2
E65D DD44             (    forth6809.asm):03917                     STD   PFIELD
E65F 3706             (    forth6809.asm):03918                     PULU  D
E661 3606             (    forth6809.asm):03919                     PSHU  D
E663 DC44             (    forth6809.asm):03920                     LDD   PFIELD
E665 3606             (    forth6809.asm):03921                     PSHU  D
E667 BDE5AF           (    forth6809.asm):03922                     JSR   PATCH
E66A 39               (    forth6809.asm):03923                     RTS
                      (    forth6809.asm):03924         
                      (    forth6809.asm):03925         ; ------------------------------------------------------------
                      (    forth6809.asm):03926         ; AGAIN  ( C: dest -- )
                      (    forth6809.asm):03927         ; Compile BRANCH with a displacement back to dest.
                      (    forth6809.asm):03928         ; ------------------------------------------------------------
E66B 3706             (    forth6809.asm):03929         AGAINW:     PULU  D
E66D 10830002         (    forth6809.asm):03930                     CMPD  #TAGBACK
E671 2703             (    forth6809.asm):03931                     BEQ   AGOK
E673 BDE545           (    forth6809.asm):03932                     JSR   CFERR
E676 3706             (    forth6809.asm):03933         AGOK:       PULU  D                 ; dest
E678 3606             (    forth6809.asm):03934                     PSHU  D                 ; park dest. See bugfix: AGAINW.1
E67A CCDDFB           (    forth6809.asm):03935                     LDD   #BRANCH
E67D 3606             (    forth6809.asm):03936                     PSHU  D
E67F BDE9F5           (    forth6809.asm):03937                     JSR   CCALL
E682 CC0000           (    forth6809.asm):03938                     LDD   #0
E685 3606             (    forth6809.asm):03939                     PSHU  D
E687 BDDE78           (    forth6809.asm):03940                     JSR   CODECOMMA
E68A DC08             (    forth6809.asm):03941                     LDD   CODEHERE
E68C 830002           (    forth6809.asm):03942                     SUBD  #2
E68F DD44             (    forth6809.asm):03943                     STD   PFIELD
E691 3706             (    forth6809.asm):03944                     PULU  D
E693 3606             (    forth6809.asm):03945                     PSHU  D
E695 DC44             (    forth6809.asm):03946                     LDD   PFIELD
E697 3606             (    forth6809.asm):03947                     PSHU  D
E699 BDE5AF           (    forth6809.asm):03948                     JSR   PATCH
E69C 39               (    forth6809.asm):03949                     RTS
                      (    forth6809.asm):03950         
                      (    forth6809.asm):03951         ; ------------------------------------------------------------
                      (    forth6809.asm):03952         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03953         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03954         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03955         ; ------------------------------------------------------------
E69D CCDDE5           (    forth6809.asm):03956         WHILEW:     LDD   #ZBRANCH
E6A0 3606             (    forth6809.asm):03957                     PSHU  D
E6A2 BDE9F5           (    forth6809.asm):03958                     JSR   CCALL
E6A5 CC0000           (    forth6809.asm):03959                     LDD   #0
E6A8 3606             (    forth6809.asm):03960                     PSHU  D
E6AA BDDE78           (    forth6809.asm):03961                     JSR   CODECOMMA
E6AD DC08             (    forth6809.asm):03962                     LDD   CODEHERE
E6AF 830002           (    forth6809.asm):03963                     SUBD  #2
E6B2 3606             (    forth6809.asm):03964                     PSHU  D                 ; orig
E6B4 CC0001           (    forth6809.asm):03965                     LDD   #TAGFWD
E6B7 3606             (    forth6809.asm):03966                     PSHU  D
E6B9 39               (    forth6809.asm):03967                     RTS
                      (    forth6809.asm):03968         
                      (    forth6809.asm):03969         ; ------------------------------------------------------------
                      (    forth6809.asm):03970         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03971         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03972         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03973         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03974         ; ------------------------------------------------------------
E6BA 3706             (    forth6809.asm):03975         REPEATW:    PULU  D
E6BC 10830001         (    forth6809.asm):03976                     CMPD  #TAGFWD
E6C0 2703             (    forth6809.asm):03977                     BEQ   RPOK1
E6C2 BDE545           (    forth6809.asm):03978                     JSR   CFERR
E6C5 3710             (    forth6809.asm):03979         RPOK1:      PULU  X                 ; orig
E6C7 9F46             (    forth6809.asm):03980                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03981         
                      (    forth6809.asm):03982                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03983                     ; See bugfix: REPEATW.1
E6C9 3040             (    forth6809.asm):03984                     LEAX  0,U               ; scan from top of control stack
E6CB 9F2B             (    forth6809.asm):03985                     STX   MSCR2             ; MSCR2 = base of scan region
E6CD 9F2F             (    forth6809.asm):03986                     STX   MSCR4             ; MSCR4 = scan pointer
E6CF DC2F             (    forth6809.asm):03987         RPSCAN:     LDD   MSCR4
E6D1 109348           (    forth6809.asm):03988                     CMPD  CSP
E6D4 2603             (    forth6809.asm):03989                     BNE   RPSCANOK
E6D6 BDE545           (    forth6809.asm):03990                     JSR   CFERR             ; no matching BEGIN
E6D9 9E2F             (    forth6809.asm):03991         RPSCANOK:   LDX   MSCR4
E6DB EC84             (    forth6809.asm):03992                     LDD   ,X
E6DD 10830002         (    forth6809.asm):03993                     CMPD  #TAGBACK
E6E1 2712             (    forth6809.asm):03994                     BEQ   RPFOUND
E6E3 10830001         (    forth6809.asm):03995                     CMPD  #TAGFWD
E6E7 2703             (    forth6809.asm):03996                     BEQ   RPSKIP
E6E9 BDE545           (    forth6809.asm):03997                     JSR   CFERR             ; anything else is a genuine mismatch
E6EC DC2F             (    forth6809.asm):03998         RPSKIP:     LDD   MSCR4
E6EE C30004           (    forth6809.asm):03999                     ADDD  #4
E6F1 DD2F             (    forth6809.asm):04000                     STD   MSCR4
E6F3 20DA             (    forth6809.asm):04001                     BRA   RPSCAN
E6F5 9E2F             (    forth6809.asm):04002         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E6F7 EC02             (    forth6809.asm):04003                     LDD   2,X               ; dest = BEGIN's address
E6F9 DD44             (    forth6809.asm):04004                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):04005         
                      (    forth6809.asm):04006                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04007                     ; bytes, highest word first.
E6FB DC2F             (    forth6809.asm):04008                     LDD   MSCR4
E6FD 932B             (    forth6809.asm):04009                     SUBD  MSCR2
E6FF DD2D             (    forth6809.asm):04010                     STD   MSCR3             ; MSCR3 = bytes to shift
E701 2715             (    forth6809.asm):04011                     BEQ   RPSHIFTDONE
E703 DC2D             (    forth6809.asm):04012         RPSHIFT:    LDD   MSCR3
E705 830002           (    forth6809.asm):04013                     SUBD  #2
E708 DD2D             (    forth6809.asm):04014                     STD   MSCR3
E70A 9E2B             (    forth6809.asm):04015                     LDX   MSCR2
E70C 308B             (    forth6809.asm):04016                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E70E EC84             (    forth6809.asm):04017                     LDD   ,X
E710 3004             (    forth6809.asm):04018                     LEAX  4,X
E712 ED84             (    forth6809.asm):04019                     STD   ,X                ; copy one word 4 bytes higher
E714 DC2D             (    forth6809.asm):04020                     LDD   MSCR3
E716 26EB             (    forth6809.asm):04021                     BNE   RPSHIFT
E718                  (    forth6809.asm):04022         RPSHIFTDONE:
E718 9E2B             (    forth6809.asm):04023                     LDX   MSCR2
E71A 3004             (    forth6809.asm):04024                     LEAX  4,X
E71C 1F13             (    forth6809.asm):04025                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):04026         
E71E CCDDFB           (    forth6809.asm):04027                     LDD   #BRANCH
E721 3606             (    forth6809.asm):04028                     PSHU  D
E723 BDE9F5           (    forth6809.asm):04029                     JSR   CCALL
E726 CC0000           (    forth6809.asm):04030                     LDD   #0
E729 3606             (    forth6809.asm):04031                     PSHU  D
E72B BDDE78           (    forth6809.asm):04032                     JSR   CODECOMMA
E72E DC08             (    forth6809.asm):04033                     LDD   CODEHERE
E730 830002           (    forth6809.asm):04034                     SUBD  #2
E733 DD2D             (    forth6809.asm):04035                     STD   MSCR3             ; MSCR3 = branch operand address
E735 DC44             (    forth6809.asm):04036                     LDD   PFIELD            ; target = BEGIN's address
E737 3606             (    forth6809.asm):04037                     PSHU  D
E739 DC2D             (    forth6809.asm):04038                     LDD   MSCR3             ; location = the operand just compiled
E73B 3606             (    forth6809.asm):04039                     PSHU  D
E73D BDE5AF           (    forth6809.asm):04040                     JSR   PATCH
E740 DC08             (    forth6809.asm):04041                     LDD   CODEHERE
E742 3606             (    forth6809.asm):04042                     PSHU  D
E744 DC46             (    forth6809.asm):04043                     LDD   NEWFLD
E746 3606             (    forth6809.asm):04044                     PSHU  D
E748 BDE5AF           (    forth6809.asm):04045                     JSR   PATCH
E74B 39               (    forth6809.asm):04046                     RTS
                      (    forth6809.asm):04047         
                      (    forth6809.asm):04048         ; ------------------------------------------------------------
                      (    forth6809.asm):04049         ; RECURSE  ( -- )
                      (    forth6809.asm):04050         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):04051         ; the xt held in CURXT.
                      (    forth6809.asm):04052         ; ------------------------------------------------------------
E74C DC3D             (    forth6809.asm):04053         RECURSEW:   LDD   CURXT             ; xt of word being compiled
E74E 3606             (    forth6809.asm):04054                     PSHU  D                 ; See bugfix: RECURSEW.1
E750 BDE9F5           (    forth6809.asm):04055                     JSR   CCALL
E753 39               (    forth6809.asm):04056                     RTS
                      (    forth6809.asm):04057         
                      (    forth6809.asm):04058         ; ------------------------------------------------------------
                      (    forth6809.asm):04059         ; DO  ( C: -- dest )
                      (    forth6809.asm):04060         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):04061         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):04062         ; ------------------------------------------------------------
E754 CCE766           (    forth6809.asm):04063         DOW:        LDD   #DOSETUP
E757 3606             (    forth6809.asm):04064                     PSHU  D
E759 BDE9F5           (    forth6809.asm):04065                     JSR   CCALL
E75C DC08             (    forth6809.asm):04066                     LDD   CODEHERE
E75E 3606             (    forth6809.asm):04067                     PSHU  D                 ; dest
E760 CC0003           (    forth6809.asm):04068                     LDD   #TAGDO
E763 3606             (    forth6809.asm):04069                     PSHU  D
E765 39               (    forth6809.asm):04070                     RTS
                      (    forth6809.asm):04071         
                      (    forth6809.asm):04072         ; ------------------------------------------------------------
                      (    forth6809.asm):04073         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04074         ; return address.
                      (    forth6809.asm):04075         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04076         ;    Inputs:
                      (    forth6809.asm):04077         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04078         ;    Outputs:
                      (    forth6809.asm):04079         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04080         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04081         ; ------------------------------------------------------------
E766 3706             (    forth6809.asm):04082         DOSETUP:    PULU  D                 ; index
E768 DD29             (    forth6809.asm):04083                     STD   MSCR
E76A 3706             (    forth6809.asm):04084                     PULU  D                 ; limit
E76C DD2B             (    forth6809.asm):04085                     STD   MSCR2
E76E 3510             (    forth6809.asm):04086                     PULS  X
E770 CC0000           (    forth6809.asm):04087                     LDD   #0
E773 3406             (    forth6809.asm):04088                     PSHS  D
E775 DC2B             (    forth6809.asm):04089                     LDD   MSCR2
E777 3406             (    forth6809.asm):04090                     PSHS  D
E779 DC29             (    forth6809.asm):04091                     LDD   MSCR
E77B 3406             (    forth6809.asm):04092                     PSHS  D
E77D 3410             (    forth6809.asm):04093                     PSHS  X
E77F 39               (    forth6809.asm):04094                     RTS
                      (    forth6809.asm):04095         
                      (    forth6809.asm):04096         ; ------------------------------------------------------------
                      (    forth6809.asm):04097         ; I  ( -- n )
                      (    forth6809.asm):04098         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04099         ; address).
                      (    forth6809.asm):04100         ; ------------------------------------------------------------
E780 EC62             (    forth6809.asm):04101         IWORDW:     LDD   2,S               ; n. See bugfix: IWORDW.1
E782 3606             (    forth6809.asm):04102                     PSHU  D
E784 39               (    forth6809.asm):04103                     RTS
                      (    forth6809.asm):04104         
                      (    forth6809.asm):04105         ; ------------------------------------------------------------
                      (    forth6809.asm):04106         ; J  ( -- n )
                      (    forth6809.asm):04107         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04108         ; address and the inner loop frame).
                      (    forth6809.asm):04109         ; ------------------------------------------------------------
E785 EC68             (    forth6809.asm):04110         JWORDW:     LDD   8,S               ; n. See bugfix: JWORDW.1
E787 3606             (    forth6809.asm):04111                     PSHU  D
E789 39               (    forth6809.asm):04112                     RTS
                      (    forth6809.asm):04113         
                      (    forth6809.asm):04114         ; ------------------------------------------------------------
                      (    forth6809.asm):04115         ; LEAVE  ( -- )
                      (    forth6809.asm):04116         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04117         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04118         ; ------------------------------------------------------------
E78A CCFFFF           (    forth6809.asm):04119         LEAVEW:     LDD   #TRUEV            ; true
E78D ED66             (    forth6809.asm):04120                     STD   6,S               ; See bugfix: LEAVEW.1
E78F 39               (    forth6809.asm):04121                     RTS
                      (    forth6809.asm):04122         
                      (    forth6809.asm):04123         ; ------------------------------------------------------------
                      (    forth6809.asm):04124         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04125         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04126         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04127         ; ------------------------------------------------------------
E790 3706             (    forth6809.asm):04128         LOOPW:      PULU  D
E792 10830003         (    forth6809.asm):04129                     CMPD  #TAGDO
E796 2703             (    forth6809.asm):04130                     BEQ   LOOPOK
E798 BDE545           (    forth6809.asm):04131                     JSR   CFERR
E79B 3706             (    forth6809.asm):04132         LOOPOK:     PULU  D                 ; dest
E79D 3606             (    forth6809.asm):04133                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E79F CCE7D7           (    forth6809.asm):04134                     LDD   #DOTEST
E7A2 3606             (    forth6809.asm):04135                     PSHU  D
E7A4 BDE9F5           (    forth6809.asm):04136                     JSR   CCALL

                      (    forth6809.asm):04079         ; TSTINV - unit test for INVERT. one's-complement, in-place (never touches U itself, unlike most words - the test only cares what's observable via the stack, not how the implementation gets there).
                      (    forth6809.asm):04080         ; Arity: 1 cell(s) in, 1 cell(s) out -> depth check
                      (    forth6809.asm):04081         ; 0 (derived, not hand-typed).
                      (    forth6809.asm):04082         ; ------------------------------------------------------------

                      (    forth6809.asm):02976         ; TSTSLASHZ - unit test for SLASH, divide-by-zero case. n2 = 0.
                      (    forth6809.asm):02977         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02978         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02979         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02980         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02981         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02982         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02983         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02984         ; there are.
                      (    forth6809.asm):02985         ; ------------------------------------------------------------

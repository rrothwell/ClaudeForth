                      (    forth6809.asm):03895         ; ------------------------------------------------------------
                      (    forth6809.asm):03896         ; TSTLOGIC - logic, shift, and address-arithmetic tests (glossary
                      (    forth6809.asm):03897         ; section 3.6). Covers every word in that section. Several of
                      (    forth6809.asm):03898         ; these (INVERT, CELLS, CELL+, CHARS, CHAR+, ALIGNED) modify the
                      (    forth6809.asm):03899         ; top of stack in place (LDD/op/STD) rather than PULU/PSHU - the
                      (    forth6809.asm):03900         ; tests verify what's observable via the stack either way, not
                      (    forth6809.asm):03901         ; how each implementation gets there. Three words (CHARS, ALIGN,
                      (    forth6809.asm):03902         ; ALIGNED) are documented no-ops on this system; CHARS/ALIGNED
                      (    forth6809.asm):03903         ; still get a normal single-value test (verifying identity),
                      (    forth6809.asm):03904         ; while ALIGN - which takes no stack arguments at all - gets a
                      (    forth6809.asm):03905         ; dedicated test pushing decoy values to confirm the whole stack,
                      (    forth6809.asm):03906         ; not just one value, is genuinely undisturbed. RSHIFT tested
                      (    forth6809.asm):03907         ; against a negative input specifically, since it's documented
                      (    forth6809.asm):03908         ; logical (zero-fill), not arithmetic (sign-preserving) - the
                      (    forth6809.asm):03909         ; case that actually distinguishes the two conventions, same
                      (    forth6809.asm):03910         ; reasoning already applied to 2/ and FM/MOD vs SM/REM earlier.
                      (    forth6809.asm):03911         ; ------------------------------------------------------------
C100                  (    forth6809.asm):03912         TSTLOGIC:  JSR   CRW
                      (    forth6809.asm):03913                    LDX   #TSTLOGICMSG
                      (    forth6809.asm):03914                    PSHU  X
                      (    forth6809.asm):03915                    LDD   #5
                      (    forth6809.asm):03916                    PSHU  D
                      (    forth6809.asm):03917                    JSR   TYPE
                      (    forth6809.asm):03918                    JSR   CRW
                      (    forth6809.asm):03919         
                      (    forth6809.asm):03920                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):03921         
                      (    forth6809.asm):03922                    JSR   TSTAND
                      (    forth6809.asm):03923                    JSR   TSTOR
                      (    forth6809.asm):03924                    JSR   TSTXOR
                      (    forth6809.asm):03925                    JSR   TSTINV
                      (    forth6809.asm):03926                    JSR   TSTLSH
                      (    forth6809.asm):03927                    JSR   TSTRSH
                      (    forth6809.asm):03928                    JSR   TSTCELS
                      (    forth6809.asm):03929                    JSR   TSTCELP
                      (    forth6809.asm):03930                    JSR   TSTCHRS
                      (    forth6809.asm):03931                    JSR   TSTCHRP
                      (    forth6809.asm):03932                    JSR   TSTALGD
                      (    forth6809.asm):03933                    JSR   TSTALGN
                      (    forth6809.asm):03934         
                      (    forth6809.asm):03935                    ENDC ; <<<<
                      (    forth6809.asm):03936         
                      (    forth6809.asm):03937                    RTS
                      (    forth6809.asm):03938         
C100                  (    forth6809.asm):03939         TSTLOGICMSG: FCC "Logic"
                      (    forth6809.asm):03940         
                      (    forth6809.asm):03941                    IFEQ TSTSELECTOR-3  ; >>>>
                      (    forth6809.asm):03942         

                      (    forth6809.asm):07503         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07504         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07505         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07506         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07507         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07508         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07509         ; division.
                      (    forth6809.asm):07510         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):07511         ; ------------------------------------------------------------

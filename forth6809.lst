                      (   unit_tests.asm):10982         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (   unit_tests.asm):10983         ; known pair, fetches it back, and verifies the standard
                      (   unit_tests.asm):10984         ; ordering: ( x1 x2 a-addr -- ) stores x2 at a-addr (the lower
                      (   unit_tests.asm):10985         ; address) and x1 at a-addr+cell, and 2@ restores x1 x2.
                      (   unit_tests.asm):10986         ; (Corrected: this test used to expect x1 at the lower address,
                      (   unit_tests.asm):10987         ; the reverse of the standard - ANS Annex F section 18 caught it.)
                      (   unit_tests.asm):10988         ; ------------------------------------------------------------

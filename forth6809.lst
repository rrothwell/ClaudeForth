                      (    forth6809.asm):17374                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):17375                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):17376                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):17377                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):17378                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):17379                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):17380                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):17381                   ; high cell.
E5C3 0D22             (    forth6809.asm):17382                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):17383                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):17384                   LDD   UDLO
E5C9 43               (    forth6809.asm):17385                   COMA
E5CA 53               (    forth6809.asm):17386                   COMB
E5CB C30001           (    forth6809.asm):17387                   ADDD  #1
E5CE DD76             (    forth6809.asm):17388                   STD   UDLO
E5D0 3401             (    forth6809.asm):17389                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):17390                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):17391                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):17392                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):17393                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):17394                                      ; silently overwrote the real carry here
                      (    forth6809.asm):17395                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):17396                                      ; making the high-cell increment run
                      (    forth6809.asm):17397                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):17398                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):17399                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):17400                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):17401                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):17402                                      ; matching "always increment" rather than
                      (    forth6809.asm):17403                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):17404                   LDD   UDHI
E5D4 43               (    forth6809.asm):17405                   COMA
E5D5 53               (    forth6809.asm):17406                   COMB
E5D6 3501             (    forth6809.asm):17407                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):17408                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):17409                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):17410                                      ; when there's no carry - the complemented
                      (    forth6809.asm):17411                                      ; value was computed in D but never
                      (    forth6809.asm):17412                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):17413                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):17414                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):17415                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):17416                                      ; was always seen as set, so this branch
                      (    forth6809.asm):17417                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):17418                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):17419                                      ; alone would have made this second,
                      (    forth6809.asm):17420                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):17421                                      ; only past the "+1", never past the
                      (    forth6809.asm):17422                                      ; store itself - the store always runs,
                      (    forth6809.asm):17423                                      ; either way.
E5DA C30001           (    forth6809.asm):17424                   ADDD  #1
E5DD DD74             (    forth6809.asm):17425         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):17426         
E5DF                  (    forth6809.asm):17427         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):17428                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):17429                   LDX   CADDR
E5E1 E684             (    forth6809.asm):17430                   LDB   ,X
E5E3 5A               (    forth6809.asm):17431                   DECB

     0100             (    forth6809.asm):00481         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00482         FILLADDR EQU  MVDST
     0102             (    forth6809.asm):00483         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00484         MRESULT  EQU  MVSRC

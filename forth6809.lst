                      (    forth6809.asm):07029         ; ------------------------------------------------------------
                      (    forth6809.asm):07030         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):07031         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):07032         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):07033         ; ------------------------------------------------------------
F86E BDF883           (    forth6809.asm):07034         NUMW:       JSR   UDDIGIT           ; ud1 is divided in place on the data stack
F871 810A             (    forth6809.asm):07035                     CMPA  #10
F873 2504             (    forth6809.asm):07036                     BLO   NDIGIT
F875 8B37             (    forth6809.asm):07037                     ADDA  #'A'-10

                      (    forth6809.asm):12896         ; TSTSCOMPARE - unit test for COMPARE. Four sequential sub-cases
                      (    forth6809.asm):12897         ; within one test body, each popping and verifying its own
                      (    forth6809.asm):12898         ; result immediately: less-than, equal, greater-than, and the
                      (    forth6809.asm):12899         ; prefix tie-break case specifically (a shorter string that's a
                      (    forth6809.asm):12900         ; true prefix of a longer one compares less, per the standard
                      (    forth6809.asm):12901         ; three-way convention) - not just LT/EQ/GT on same-length
                      (    forth6809.asm):12902         ; strings, which alone wouldn't exercise the tie-break path at
                      (    forth6809.asm):12903         ; all.
                      (    forth6809.asm):12904         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):12905         TSTSCOMPARE: LDA  #'A'
                      (    forth6809.asm):12906                     STA  TSTCBUF
                      (    forth6809.asm):12907                     LDA  #'B'

                      (    forth6809.asm):00883         
                      (    forth6809.asm):00884                    PULU  D
                      (    forth6809.asm):00885                    CMPD  #TSTVAL1
                      (    forth6809.asm):00886                    BNE   TDFAIL
                      (    forth6809.asm):00887                    PULU  D
                      (    forth6809.asm):00888                    CMPD  #TSTVAL1
                      (    forth6809.asm):00889                    BNE   TDFAIL
                      (    forth6809.asm):00890                    PULU  D
                      (    forth6809.asm):00891                    CMPD  #TSTGUARD
                      (    forth6809.asm):00892                    BNE   TDFAIL
                      (    forth6809.asm):00893         
                      (    forth6809.asm):00894                    LDD   TSTUB4
                      (    forth6809.asm):00895                    SUBD  TSTUAF
                      (    forth6809.asm):00896                    CMPD  #2

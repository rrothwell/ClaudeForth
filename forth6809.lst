C25B 3610             (    forth6809.asm):09504                    PSHU  X
C25D CC0009           (    forth6809.asm):09505                    LDD   #9
C260 3606             (    forth6809.asm):09506                    PSHU  D
C262 BDF60B           (    forth6809.asm):09507                    JSR   TYPE

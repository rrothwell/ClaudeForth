                      (   unit_tests.asm):12911         ; TSTSNAME1 - unit test for SNAME, found case. Searches the
                      (   unit_tests.asm):12912         ; real, live dictionary (confirmed via its own code that it
                      (   unit_tests.asm):12913         ; walks from the real LATEST, not a redirectable copy - no
                      (   unit_tests.asm):12914         ; redirect needed or possible here) for DUP's own xt, verifying
                      (   unit_tests.asm):12915         ; the returned name content matches "DUP" exactly, not just a
                      (   unit_tests.asm):12916         ; nonzero length.
                      (   unit_tests.asm):12917         ; ------------------------------------------------------------
C2B7                  (   unit_tests.asm):12918         TSTSNAME1: LDD  LATEST
                      (   unit_tests.asm):12919                    STD  TSTLSAV
                      (   unit_tests.asm):12920         
                      (   unit_tests.asm):12921                    LDD  #BASELATEST  ; BUG FIX: confirmed via a real MAME run -
                      (   unit_tests.asm):12922                    STD  LATEST       ; SNAMEW starts its walk from LATEST
                      (   unit_tests.asm):12923                                       ; (LDD LATEST/STD SNXT), the same real,
                      (   unit_tests.asm):12924                                       ; pre-COLD dependency found and fixed in
                      (   unit_tests.asm):12925                                       ; section 3.17's own TSTEVALUATE. With
                      (   unit_tests.asm):12926                                       ; LATEST=0 (only set by COLD, which
                      (   unit_tests.asm):12927                                       ; hasn't run yet at this whole test
                      (   unit_tests.asm):12928                                       ; framework's own pre-COLD execution
                      (   unit_tests.asm):12929                                       ; point), SNLOOP's own "BEQ SNNOTFOUND"
                      (   unit_tests.asm):12930                                       ; fires immediately, before ever
                      (   unit_tests.asm):12931                                       ; comparing against DUP's own CFA - this
                      (   unit_tests.asm):12932                                       ; test was written in section 3.12,
                      (   unit_tests.asm):12933                                       ; before the LATEST=0 finding existed at
                      (   unit_tests.asm):12934                                       ; all, so it never got the fix applied.

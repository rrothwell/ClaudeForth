                      (    forth6809.asm):01583         ; TSTROLL - unit test for ROLL
                      (    forth6809.asm):01584         ; ( xu ... x0 u -- xu-1 ... x0 xu ), using u=2 as a concrete
                      (    forth6809.asm):01585         ; representative case (matches TSTPICK's own choice of u, so
                      (    forth6809.asm):01586         ; the two tests are directly comparable). Verifies the item 2
                      (    forth6809.asm):01587         ; cells deep is removed and moved to the top, the items above it
                      (    forth6809.asm):01588         ; shift down by one slot each, the guard beneath is undisturbed,
                      (    forth6809.asm):01589         ; and exactly one cell was freed (u popped, nothing replaces it
                      (    forth6809.asm):01590         ; numerically - the rolled item moves within the existing space).
                      (    forth6809.asm):01591         ; ------------------------------------------------------------

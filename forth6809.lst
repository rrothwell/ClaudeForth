                      (    forth6809.asm):09440                    LDD  TSTCSAV2  ; BUG FIX: was compared against TSTMKCOD, a
                      (    forth6809.asm):09441                    CMPD #TSTCBUF  ; captured snapshot of CODEHERE right AFTER
                      (    forth6809.asm):09442                                   ; MARKERW finished building its own header -
                      (    forth6809.asm):09443                                   ; wrong target. MARKER's own documented
                      (    forth6809.asm):09444                                   ; behavior is "forgets itself too" - traced
                      (    forth6809.asm):09445                                   ; MARKERW's own code and confirmed its
                      (    forth6809.asm):09446                                   ; snapshot (MKDP/MKCODE/MKVAR/MKLATEST) is
                      (    forth6809.asm):09447                                   ; taken at its very start, before HEADER or
                      (    forth6809.asm):09448                                   ; any compiling runs at all - so DOMARKER
                      (    forth6809.asm):09449                                   ; correctly restores to the state BEFORE the
                      (    forth6809.asm):09450                                   ; marker word itself was created (TSTCBUF
                      (    forth6809.asm):09451                                   ; directly), not the state right after. The
                      (    forth6809.asm):09452                                   ; real dictionary/compile mechanism was
                      (    forth6809.asm):09453                                   ; already working correctly; only this
                      (    forth6809.asm):09454                                   ; test's own comparison target was wrong.
                      (    forth6809.asm):09455                    BNE  MKFAIL
                      (    forth6809.asm):09456                    LDD  TSTDSAV2
                      (    forth6809.asm):09457                    CMPD #TSTDBUF
                      (    forth6809.asm):09458                    BNE  MKFAIL
                      (    forth6809.asm):09459                    LDD  TSTVSAV2
                      (    forth6809.asm):09460                    CMPD #TSTVBUF

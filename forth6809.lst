                      (    forth6809.asm):01556         
                      (    forth6809.asm):01557                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01558         ; ------------------------------------------------------------
                      (    forth6809.asm):01559         ; Return the input ring buffer fill level (0 to INBUFSZ-1).

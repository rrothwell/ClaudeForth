DD4E 8570             (    forth6809.asm):01945                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):01946                                             ; Any receiver error flagged?
DD50 2716             (    forth6809.asm):01947                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):01948         
DD52 8510             (    forth6809.asm):01949                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
DD54 2703             (    forth6809.asm):01950                     BEQ   INXFE             ; Tally each flagged error independently -
DD56 7C017C           (    forth6809.asm):01951                     INC   FECOUNT           ; more than one bit can be set at once.
DD59 8520             (    forth6809.asm):01952         INXFE:      BITA  #SR_OVRN

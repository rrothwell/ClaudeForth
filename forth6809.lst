                      (    forth6809.asm):08410                     ; Verify no collision with vectors: INITEND should equal VECTORS.
     FFEC             (    forth6809.asm):08411         INITEND     EQU   *
     0048             (    forth6809.asm):08412         INITSIZE    EQU   INITEND-INITCODE
                      (    forth6809.asm):08413         
                      (    forth6809.asm):08414         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):08415         ; INITCODE block and the VECTORS block when it generates the
                      (    forth6809.asm):08416         ; .bin file.
FFEC FFFFFFFF         (    forth6809.asm):08417                     FILL  $FF,VECTORS-INITEND
                      (    forth6809.asm):08418         

                      (    forth6809.asm):01381         ; TSTSTACK - data stack operation tests. Add new tests here as
                      (    forth6809.asm):01382         ; they're written.
                      (    forth6809.asm):01383         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01384         TSTSTACK:  JSR   CRW
                      (    forth6809.asm):01385                    LDX   #TSTSTACKMSG
                      (    forth6809.asm):01386                    PSHU  X
                      (    forth6809.asm):01387                    LDD   #5
                      (    forth6809.asm):01388                    PSHU  D
                      (    forth6809.asm):01389                    JSR   TYPE
                      (    forth6809.asm):01390                    JSR   CRW
                      (    forth6809.asm):01391         
                      (    forth6809.asm):01392                    IFEQ TSTSELECTOR-1  ; >>>>
                      (    forth6809.asm):01393         
                      (    forth6809.asm):01394                    JSR   TSTDUP
                      (    forth6809.asm):01395                    JSR   TSTDROP
                      (    forth6809.asm):01396                    JSR   TSTSWAP
                      (    forth6809.asm):01397                    JSR   TSTOVER
                      (    forth6809.asm):01398                    JSR   TSTROT
                      (    forth6809.asm):01399                    JSR   TSTQDUPNZ
                      (    forth6809.asm):01400                    JSR   TSTQDUPZ
                      (    forth6809.asm):01401                    JSR   TSTDEPTH
                      (    forth6809.asm):01402                    JSR   TSTDDUP
                      (    forth6809.asm):01403                    JSR   TSTDDROP
                      (    forth6809.asm):01404                    JSR   TSTDSWAP
                      (    forth6809.asm):01405                    JSR   TSTDOVER
                      (    forth6809.asm):01406                    JSR   TSTNIP
                      (    forth6809.asm):01407                    JSR   TSTTUCK
                      (    forth6809.asm):01408                    JSR   TSTPICK
                      (    forth6809.asm):01409                    JSR   TSTROLL
                      (    forth6809.asm):01410                    JSR   TSTDROT
                      (    forth6809.asm):01411         

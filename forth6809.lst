                      (    forth6809.asm):07738         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07739         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07740         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07741         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07742         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07743         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07744         ; division.
                      (    forth6809.asm):07745         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):07746         ; ------------------------------------------------------------
FB51 3706             (    forth6809.asm):07747         ENVQW:      PULU  D                 ; u
FB53 DDEF             (    forth6809.asm):07748                     STD   ENVLEN
FB55 3706             (    forth6809.asm):07749                     PULU  D                 ; c-addr

                      (    forth6809.asm):03145         ; Convert digits at NADDR into UDHI:UDLO, in BASE, until NCNT
                      (    forth6809.asm):03146         ; characters are used or a non-digit is reached.
                      (    forth6809.asm):03147         ; NUMLOOP
                      (    forth6809.asm):03148         ;    Inputs:
                      (    forth6809.asm):03149         ;        NADDR = address of the first character
                      (    forth6809.asm):03150         ;        NCNT = number of characters
                      (    forth6809.asm):03151         ;        UDHI:UDLO = initial value
                      (    forth6809.asm):03152         ;    Outputs:
                      (    forth6809.asm):03153         ;        UDHI:UDLO = accumulated value
                      (    forth6809.asm):03154         ;        NADDR, NCNT = first unconverted character and the count
                      (    forth6809.asm):03155         ;        remaining
                      (    forth6809.asm):03156         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03157         ; ------------------------------------------------------------
E469 DC22             (    forth6809.asm):03158         NUMLOOP:    LDD   NCNT

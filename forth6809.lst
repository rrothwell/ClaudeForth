                      (    forth6809.asm):03275         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):03276         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):03277         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):03278         ;    Inputs:
                      (    forth6809.asm):03279         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):03280         ;    Outputs:
                      (    forth6809.asm):03281         ;        single number: n and -1
                      (    forth6809.asm):03282         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):03283         ;        not a number: c-addr and 0
                      (    forth6809.asm):03284         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03285         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):03286         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):03287         ; NUMBERQ.6.
                      (    forth6809.asm):03288         ; ------------------------------------------------------------

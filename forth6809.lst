                      (    forth6809.asm):07094         
                      (    forth6809.asm):07095         ; ------------------------------------------------------------
                      (    forth6809.asm):07096         ; UNESCAPE  ( c-addr1 u1 c-addr2 -- c-addr2 u2 )
                      (    forth6809.asm):07097         ; Copy the string c-addr1 u1 to c-addr2, doubling every "%" so that

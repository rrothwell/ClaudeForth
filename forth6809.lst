E5A3 2641             (    forth6809.asm):03499                   BNE   NQBAD
                      (    forth6809.asm):03500         
                      (    forth6809.asm):03501                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03502                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03503                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03504                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03505                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03506                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03507                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03508                   ; high cell.
E5A5 0D22             (    forth6809.asm):03509                   TST   NUMNEG
E5A7 2718             (    forth6809.asm):03510                   BEQ   NQPOS32
E5A9 DC76             (    forth6809.asm):03511                   LDD   UDLO
E5AB 43               (    forth6809.asm):03512                   COMA
E5AC 53               (    forth6809.asm):03513                   COMB
E5AD C30001           (    forth6809.asm):03514                   ADDD  #1
E5B0 DD76             (    forth6809.asm):03515                   STD   UDLO
E5B2 3401             (    forth6809.asm):03516                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03517                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03518                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03519                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03520                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03521                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03522                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03523                                      ; making the high-cell increment run
                      (    forth6809.asm):03524                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03525                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03526                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03527                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03528                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03529                                      ; matching "always increment" rather than
                      (    forth6809.asm):03530                                      ; "increment only on genuine carry".
E5B4 DC74             (    forth6809.asm):03531                   LDD   UDHI
E5B6 43               (    forth6809.asm):03532                   COMA
E5B7 53               (    forth6809.asm):03533                   COMB
E5B8 3501             (    forth6809.asm):03534                   PULS  CC          ; restore the TRUE carry
E5BA 2403             (    forth6809.asm):03535                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03536                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03537                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03538                                      ; value was computed in D but never
                      (    forth6809.asm):03539                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03540                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03541                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03542                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03543                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03544                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03545                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03546                                      ; alone would have made this second,
                      (    forth6809.asm):03547                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03548                                      ; only past the "+1", never past the
                      (    forth6809.asm):03549                                      ; store itself - the store always runs,
                      (    forth6809.asm):03550                                      ; either way.
E5BC C30001           (    forth6809.asm):03551                   ADDD  #1
E5BF DD74             (    forth6809.asm):03552         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03553         
E5C1                  (    forth6809.asm):03554         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03555                   ; was '.' - determines which return convention to use
E5C1 9E1F             (    forth6809.asm):03556                   LDX   CADDR
E5C3 E684             (    forth6809.asm):03557                   LDB   ,X
E5C5 5A               (    forth6809.asm):03558                   DECB
E5C6 3001             (    forth6809.asm):03559                   LEAX  1,X
E5C8 A685             (    forth6809.asm):03560                   LDA   B,X
E5CA 812E             (    forth6809.asm):03561                   CMPA  #'.'
E5CC 260E             (    forth6809.asm):03562                   BNE   NQSINGLE
                      (    forth6809.asm):03563         
                      (    forth6809.asm):03564                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03565                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03566                   ; apart without needing a separate flag of its own either
E5CE DC76             (    forth6809.asm):03567                   LDD   UDLO
E5D0 3606             (    forth6809.asm):03568                   PSHU  D
E5D2 DC74             (    forth6809.asm):03569                   LDD   UDHI
E5D4 3606             (    forth6809.asm):03570                   PSHU  D
E5D6 CC0001           (    forth6809.asm):03571                   LDD   #1
E5D9 3606             (    forth6809.asm):03572                   PSHU  D
E5DB 39               (    forth6809.asm):03573                   RTS
                      (    forth6809.asm):03574         
E5DC                  (    forth6809.asm):03575         NQSINGLE: ; SINGLE success - unchanged from the original convention
E5DC DC76             (    forth6809.asm):03576                   LDD   UDLO
E5DE 3606             (    forth6809.asm):03577                   PSHU  D
E5E0 CCFFFF           (    forth6809.asm):03578                   LDD   #-1
E5E3 3606             (    forth6809.asm):03579                   PSHU  D
E5E5 39               (    forth6809.asm):03580                   RTS
                      (    forth6809.asm):03581         
E5E6 9E1F             (    forth6809.asm):03582         NQBAD:    LDX   CADDR
E5E8 3610             (    forth6809.asm):03583                   PSHU  X
E5EA CC0000           (    forth6809.asm):03584                   LDD   #0
E5ED 3606             (    forth6809.asm):03585                   PSHU  D
E5EF 39               (    forth6809.asm):03586                   RTS

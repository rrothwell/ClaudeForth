F520 1F02             (    forth6809.asm):05458                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):05459                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):05460                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):05461                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):05462                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):05463                                   ; The high byte took on the fill character's
                      (    forth6809.asm):05464                                   ; value instead of the count's real high
                      (    forth6809.asm):05465                                   ; byte, so the count almost never reached
                      (    forth6809.asm):05466                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):05467                                   ; past the requested length. Keeping the
                      (    forth6809.asm):05468                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):05469                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):05470                                   ; fill character into A) and removes the
                      (    forth6809.asm):05471                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):05472                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):05473                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):05474                                   ; MAME debugger.
F522 3706             (    forth6809.asm):05475                  PULU  D
F524 1F01             (    forth6809.asm):05476                  TFR   D,X        ; address, kept directly in X rather than
                      (    forth6809.asm):05477                                   ; round-tripping through FILLADDR too

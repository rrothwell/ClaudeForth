FFB7 5A               (    forth6809.asm):08361                     DECB
FFB8 26FB             (    forth6809.asm):08362                     BNE   CLRGLOB
                      (    forth6809.asm):08363         
FFBA BDDC63           (    forth6809.asm):08364                     JSR   INITSERIAL
                      (    forth6809.asm):08365         
FFBD 1CAF             (    forth6809.asm):08366                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):08367         
                      (    forth6809.asm):08368                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):08369         
                      (    forth6809.asm):08370                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):08371                     JSR   TSTRUNNER
                      (    forth6809.asm):08372                     ELSE                    ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):08373                     NOP                     ; same size as JSR TSTRUNNER
FFC0 12               (    forth6809.asm):08374                     NOP                     ; See bugfix: COLDSTRT.2

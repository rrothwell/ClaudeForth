                      (    forth6809.asm):04837         ; ------------------------------------------------------------
EB54 ECC1             (    forth6809.asm):04838         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
EB56 2718             (    forth6809.asm):04839                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
EB58 1F02             (    forth6809.asm):04840                     TFR   D,Y               ; Y = cells to shift
EB5A 58               (    forth6809.asm):04841                     LSLB
EB5B 49               (    forth6809.asm):04842                     ROLA
EB5C 30CB             (    forth6809.asm):04843                     LEAX  D,U               ; X = xu
EB5E EC84             (    forth6809.asm):04844                     LDD   ,X
EB60 3406             (    forth6809.asm):04845                     PSHS  D                 ; xu waits on the return stack
EB62 EC1E             (    forth6809.asm):04846         RLOOP:      LDD   -2,X
EB64 ED84             (    forth6809.asm):04847                     STD   ,X
EB66 301E             (    forth6809.asm):04848                     LEAX  -2,X
EB68 313F             (    forth6809.asm):04849                     LEAY  -1,Y

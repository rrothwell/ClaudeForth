                      (    forth6809.asm):03676         ; ------------------------------------------------------------
                      (    forth6809.asm):03677         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03678         ; Read a line as ACCEPT does and store the count in SPAN.

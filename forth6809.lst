                      (    forth6809.asm):05462         ; IMMEDIATE  ( -- )
                      (    forth6809.asm):05463         ; Set the immediate flag ($80) in the length byte of the most recent
                      (    forth6809.asm):05464         ; definition (LATEST).
                      (    forth6809.asm):05465         ; ------------------------------------------------------------
DDF6 9E04             (    forth6809.asm):05466         IMMEDIATEW: LDX   LATEST
DDF8 A684             (    forth6809.asm):05467                     LDA   ,X
DDFA 8A80             (    forth6809.asm):05468                     ORA   #$80
DDFC A784             (    forth6809.asm):05469                     STA   ,X

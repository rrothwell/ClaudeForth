                      (    forth6809.asm):02097         
     DD4D             (    forth6809.asm):02098         BASELATEST  EQU   H_M2              ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):02099                                             ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):02100                                             ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):02101                                             ; were chained on after it; before that,
                      (    forth6809.asm):02102                                             ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):02103                                             ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):02104                                             ; a placeholder, found and fixed several turns
                      (    forth6809.asm):02105                                             ; before this one.
                      (    forth6809.asm):02106         
                      (    forth6809.asm):02107         ; Verify no collision with base code.
                      (    forth6809.asm):02108         ; Value should match ORG BASECODE
     DD54             (    forth6809.asm):02109         BASEDICTEND EQU   *
     0811             (    forth6809.asm):02110         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):02111         
                      (    forth6809.asm):02112         ; ============================================================
                      (    forth6809.asm):02113         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02114         ; ============================================================
                      (    forth6809.asm):02115                     ORG   BASECODE          ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):02116                                             ; entirely - every routine from here through
                      (    forth6809.asm):02117                                             ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):02118                                             ; every primitive) would otherwise have
                      (    forth6809.asm):02119                                             ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):02120                                             ; WARM message left the location counter,
                      (    forth6809.asm):02121                                             ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02122                                             ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02123                                             ; instead of landing in BASECODE at all
                      (    forth6809.asm):02124         
                      (    forth6809.asm):02125         ; ------------------------------------------------------------
                      (    forth6809.asm):02126         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02127         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02128         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02129         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02130         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02131         ; ------------------------------------------------------------
                      (    forth6809.asm):02132         ; ------------------------------------------------------------
                      (    forth6809.asm):02133         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02134         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02135         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02136         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02137         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02138         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02139         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02140         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02141         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02142         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02143         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02144         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02145         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02146         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02147         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02148         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02149         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02150         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02151         ; not duplicated logic in either place.
                      (    forth6809.asm):02152         ; ------------------------------------------------------------
                      (    forth6809.asm):02153         
DD54 7F0176           (    forth6809.asm):02154         SERBUFCLR:  CLR   INHEAD
DD57 7F0177           (    forth6809.asm):02155                     CLR   INTAIL
DD5A 7F0178           (    forth6809.asm):02156                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
DD5D 7F0179           (    forth6809.asm):02157                     CLR   OUTHEAD
DD60 7F017A           (    forth6809.asm):02158                     CLR   OUTTAIL
DD63 7F017B           (    forth6809.asm):02159                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):02160         
                      (    forth6809.asm):02161         
DD66 7F017C           (    forth6809.asm):02162                     CLR   FECOUNT
DD69 7F017D           (    forth6809.asm):02163                     CLR   OVRNCOUNT
DD6C 7F017E           (    forth6809.asm):02164                     CLR   PECOUNT
DD6F 7F017F           (    forth6809.asm):02165                     CLR   POLLREADYCNT
DD72 39               (    forth6809.asm):02166                     RTS
                      (    forth6809.asm):02167         
DD73 BDDD54           (    forth6809.asm):02168         INITSERIAL: JSR   SERBUFCLR
DD76 9603             (    forth6809.asm):02169                     LDA   CR_RESET          ; Master Software Reset command to 6850
DD78 B7C008           (    forth6809.asm):02170                     STA   ACIACR
DD7B 12               (    forth6809.asm):02171                     NOP                     ; Settling Delay
DD7C 12               (    forth6809.asm):02172                     NOP
                      (    forth6809.asm):02173         
                      (    forth6809.asm):02174                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02175                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02176                     ELSE                    ; <<<<<>>>>>
DD7D 8615             (    forth6809.asm):02177                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02178                     ENDC                    ; <<<<<<<<<<
DD7F B7C008           (    forth6809.asm):02179                     STA   ACIACR            ; was "STA ACIA" - same fix
DD82 39               (    forth6809.asm):02180                     RTS
                      (    forth6809.asm):02181         
                      (    forth6809.asm):02182                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02183         ; ------------------------------------------------------------
                      (    forth6809.asm):02184         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):02185         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):02186         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):02187         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):02188         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02189         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02190                     SUBA  INTAIL
                      (    forth6809.asm):02191                     ANDA  #INBUFSZ-1
                      (    forth6809.asm):02192                     RTS
                      (    forth6809.asm):02193         ; ------------------------------------------------------------
                      (    forth6809.asm):02194         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):02195         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):02196         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):02197         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):02198         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):02199         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):02200         ; flow control, not a chip feature.
                      (    forth6809.asm):02201         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02202         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):02203                     CMPA  #INHIWATER
                      (    forth6809.asm):02204                     BLO   RTSCHIDONE
                      (    forth6809.asm):02205                     TST   RTSSTATE
                      (    forth6809.asm):02206                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):02207                     LDA   #CR_RTSHI
                      (    forth6809.asm):02208                     STA   ACIACR
                      (    forth6809.asm):02209                     LDA   #1
                      (    forth6809.asm):02210                     STA   RTSSTATE
DD83                  (    forth6809.asm):02211         RTSCHIDONE: RTS
                      (    forth6809.asm):02212         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02213         UPDATE_RTS:
                      (    forth6809.asm):02214                     TST   RTSSTATE
                      (    forth6809.asm):02215                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02216         
                      (    forth6809.asm):02217                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02218                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02219         
                      (    forth6809.asm):02220                                             ; $B5/%1011_0101
                      (    forth6809.asm):02221                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02222                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02223         
DD83                  (    forth6809.asm):02224         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02225                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02226                     BRA   WRITE_CR          ; Why is OUTACTIVITY not updated here?
                      (    forth6809.asm):02227         
DD83                  (    forth6809.asm):02228         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02229                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02230                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DD83                  (    forth6809.asm):02231         WRITE_CR:
                      (    forth6809.asm):02232                     STA   ACIACR
                      (    forth6809.asm):02233                     RTS
                      (    forth6809.asm):02234         ; ------------------------------------------------------------
                      (    forth6809.asm):02235         ; CHKHI/CHKLO - replace the old combined CHKWATERLEVEL. That
                      (    forth6809.asm):02236         ; routine always paid for a TST RTSSTATE/BNE to pick a
                      (    forth6809.asm):02237         ; direction (hi vs lo) before checking either watermark - but
                      (    forth6809.asm):02238         ; the direction picked never actually depended on which caller
                      (    forth6809.asm):02239         ; was asking, only on the current RTSSTATE, and each caller
                      (    forth6809.asm):02240         ; only ever moves fill one way: INCHAR (via CHKHI) only ever
                      (    forth6809.asm):02241         ; adds to the ring, so only the hi threshold can ever usefully
                      (    forth6809.asm):02242         ; fire from that side; GETCHAR (via CHKLO) only ever drains it,
                      (    forth6809.asm):02243         ; so only the lo threshold can fire from that side. Whenever
                      (    forth6809.asm):02244         ; the old routing sent a caller into the "wrong" branch for its
                      (    forth6809.asm):02245         ; own direction (e.g. INCHAR landing in CHK_LO while RTSSTATE
                      (    forth6809.asm):02246         ; was REJECT), the comparison was provably always a no-op from
                      (    forth6809.asm):02247         ; that caller - the fill level only ever moves the way that
                      (    forth6809.asm):02248         ; caller pushes it, so the other threshold's condition can't
                      (    forth6809.asm):02249         ; newly become true there. Splitting into two direction-fixed
                      (    forth6809.asm):02250         ; routines removes that dead branch+comparison from both
                      (    forth6809.asm):02251         ; callers, and both take the current fill level pre-computed in
                      (    forth6809.asm):02252         ; RegB rather than reloading INHEAD/INTAIL themselves, so a
                      (    forth6809.asm):02253         ; caller that already has one of the two pointers in a register
                      (    forth6809.asm):02254         ; (see INCHAR) doesn't pay for a redundant reload.
                      (    forth6809.asm):02255         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02256         CHKHI:
                      (    forth6809.asm):02257                     CMPB  #INHIWATER        ; Is the buffer near full?
                      (    forth6809.asm):02258                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02259                     TST   RTSSTATE
                      (    forth6809.asm):02260                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02261                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02262                     STA   RTSSTATE
                      (    forth6809.asm):02263                     JSR   UPDATE_RTS
DD83                  (    forth6809.asm):02264         CHKHIDONE:  RTS
                      (    forth6809.asm):02265         
DD83                  (    forth6809.asm):02266         CHKLO:
                      (    forth6809.asm):02267                     CMPB  #INLOWATER        ; Is the buffer near empty?
                      (    forth6809.asm):02268                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02269                     TST   RTSSTATE
                      (    forth6809.asm):02270                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02271                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02272                     STA   RTSSTATE
                      (    forth6809.asm):02273                     JSR   UPDATE_RTS
DD83                  (    forth6809.asm):02274         CHKLODONE:  RTS
                      (    forth6809.asm):02275         ; ------------------------------------------------------------
                      (    forth6809.asm):02276         ; BUG FIX: this used to loop internally (BRA back to the top)
                      (    forth6809.asm):02277         ; until the whole OUTBUF drained or CTS blocked - an unbounded
                      (    forth6809.asm):02278         ; spin of up to ~64 characters (~5.5ms at 115200 baud). In
                      (    forth6809.asm):02279         ; practice only one character was ever observed to be processed
                      (    forth6809.asm):02280         ; per call anyway (TDRE is rarely ready again this soon after
                      (    forth6809.asm):02281         ; sending), so this now makes that explicit: sends at most ONE
                      (    forth6809.asm):02282         ; character per call and returns unconditionally, whatever the
                      (    forth6809.asm):02283         ; reason (buffer empty, CTS-blocked, TDRE not ready yet, or a
                      (    forth6809.asm):02284         ; character actually sent - including the TDRE-not-ready case,
                      (    forth6809.asm):02285         ; which used to spin-wait right here and now instead just
                      (    forth6809.asm):02286         ; returns to try again on the next call). Every caller (KEY,
                      (    forth6809.asm):02287         ; PUTCHAR) already calls this once per character it handles on
                      (    forth6809.asm):02288         ; its own side, so the buffer still drains at essentially the
                      (    forth6809.asm):02289         ; same rate - this removes the unbounded worst case and the
                      (    forth6809.asm):02290         ; TDRE spin-wait, without changing normal-case throughput.
DD83                  (    forth6809.asm):02291         FLUSHOUTBUFFER:
                      (    forth6809.asm):02292                     LDB   OUTTAIL
                      (    forth6809.asm):02293                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02294                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02295         
                      (    forth6809.asm):02296                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02297                     BITA  #SR_CTS
                      (    forth6809.asm):02298                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02299         
                      (    forth6809.asm):02300                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02301                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02302                                             ; than spin-wait here.
                      (    forth6809.asm):02303         
                      (    forth6809.asm):02304                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02305                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02306                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02307         
                      (    forth6809.asm):02308                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02309                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02310                     STB   OUTTAIL
                      (    forth6809.asm):02311                                             ; One character sent - return rather than
                      (    forth6809.asm):02312                                             ; loop back for more (see header comment).
DD83                  (    forth6809.asm):02313         FLUSHED:
                      (    forth6809.asm):02314                     RTS
                      (    forth6809.asm):02315         ; ------------------------------------------------------------
                      (    forth6809.asm):02316         ; PUTCHAR
                      (    forth6809.asm):02317         ;    Inputs:
                      (    forth6809.asm):02318         ;        RegA = character to insert into transmit buffer.
                      (    forth6809.asm):02319         ;    Outputs:
                      (    forth6809.asm):02320         ;        none
                      (    forth6809.asm):02321         ; ------------------------------------------------------------
DD83                  (    forth6809.asm):02322         PUTCHAR:
                      (    forth6809.asm):02323                     PSHS  CC,X
                      (    forth6809.asm):02324                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02325         
                      (    forth6809.asm):02326                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02327                     INCB
                      (    forth6809.asm):02328                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02329                     CMPB  OUTTAIL
                      (    forth6809.asm):02330                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02331         
                      (    forth6809.asm):02332                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02333                     LDB   OUTHEAD
                      (    forth6809.asm):02334                     STA   B,X
                      (    forth6809.asm):02335         
                      (    forth6809.asm):02336                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02337                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02338                     STB   OUTHEAD
                      (    forth6809.asm):02339         
                      (    forth6809.asm):02340                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02341                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02342         
                      (    forth6809.asm):02343                     ; RTS is high (REJECT): CR_RTSHI hardware-disables the TX
                      (    forth6809.asm):02344                     ; interrupt, so nothing will ever drain OUTBUF except this
                      (    forth6809.asm):02345                     ; polling fallback. BUG FIX: FLUSHOUTBUFFER can take until
                      (    forth6809.asm):02346                     ; the whole OUTBUF drains (up to ~64 chars, ~5.5ms at 115200
                      (    forth6809.asm):02347                     ; baud) - running that under PUTCHAR's own ORCC #$50 masked
                      (    forth6809.asm):02348                     ; IRQ+FIRQ for the entire span, which is exactly why RTS
                      (    forth6809.asm):02349                     ; went high in the first place: the receiver was under
                      (    forth6809.asm):02350                     ; pressure, and masking IRQ here stops IRQH's own INCHAR

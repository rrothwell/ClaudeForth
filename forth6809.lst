                      (    forth6809.asm):01184                   BNE  SCFAIL
                      (    forth6809.asm):01185         
                      (    forth6809.asm):01186                   LDD  TSTUB4
                      (    forth6809.asm):01187                   SUBD TSTUAF
                      (    forth6809.asm):01188                   CMPD #0
                      (    forth6809.asm):01189                   BNE  SCFAIL
                      (    forth6809.asm):01190         
                      (    forth6809.asm):01191                   LDD  #TRUEV
                      (    forth6809.asm):01192                   BRA  SCDONE
C17C                  (    forth6809.asm):01193         SCFAIL:   LDD  #FALSEV

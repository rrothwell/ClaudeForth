                      (    forth6809.asm):08720         ; ------------------------------------------------------------
                      (    forth6809.asm):08721         ; TSTMARKER - unit test for MARKER. Compiles "MARKER TESTWD"
                      (    forth6809.asm):08722         ; (CODEHERE/DPHERE/VARHERE redirected to scratch, as with every
                      (    forth6809.asm):08723         ; other test in this section), then simulates "something was
                      (    forth6809.asm):08724         ; defined after the marker" by manually advancing the redirected
                      (    forth6809.asm):08725         ; pointers further and pointing the real LATEST elsewhere,
                      (    forth6809.asm):08726         ; executes the marker word, and verifies everything was restored
                      (    forth6809.asm):08727         ; to TSTCBUF/TSTDBUF/TSTVBUF directly - the state BEFORE the
                      (    forth6809.asm):08728         ; marker word itself was created, not the state right after.
                      (    forth6809.asm):08729         ; MARKER's own documented behavior is "forgets itself too" -
                      (    forth6809.asm):08730         ; traced MARKERW's own code and confirmed its internal snapshot
                      (    forth6809.asm):08731         ; is taken at its very start, before HEADER or any compiling
                      (    forth6809.asm):08732         ; runs at all, so that's genuinely the correct restore target,
                      (    forth6809.asm):08733         ; not assumed.
                      (    forth6809.asm):08734         ;
                      (    forth6809.asm):08735         ; DOMARKER (confirmed by reading it directly) writes to the
                      (    forth6809.asm):08736         ; real DPHERE/CODEHERE/VARHERE/LATEST unconditionally, not to
                      (    forth6809.asm):08737         ; any redirected copy - so this test must execute the marker
                      (    forth6809.asm):08738         ; word while CODEHERE/DPHERE/VARHERE are still redirected (their
                      (    forth6809.asm):08739         ; real values are restored only afterward), unlike every other
                      (    forth6809.asm):08740         ; test in this section, which restores first and executes
                      (    forth6809.asm):08741         ; second. Getting this order backwards would have corrupted the
                      (    forth6809.asm):08742         ; real dictionary pointers with scratch addresses.
                      (    forth6809.asm):08743         ; ------------------------------------------------------------
C3E3                  (    forth6809.asm):08744         TSTMARKER: LDD  CODEHERE
                      (    forth6809.asm):08745                    STD  TSTCSAV
                      (    forth6809.asm):08746                    LDD  DPHERE
                      (    forth6809.asm):08747                    STD  TSTDSAV
                      (    forth6809.asm):08748                    LDD  VARHERE
                      (    forth6809.asm):08749                    STD  TSTVSAV
                      (    forth6809.asm):08750                    LDD  SRCADDR
                      (    forth6809.asm):08751                    STD  TSTSASAV
                      (    forth6809.asm):08752                    LDD  SRCLEN
                      (    forth6809.asm):08753                    STD  TSTSLSAV
                      (    forth6809.asm):08754                    LDD  TOIN
                      (    forth6809.asm):08755                    STD  TSTTISAV
                      (    forth6809.asm):08756                    LDD  LATEST
                      (    forth6809.asm):08757                    STD  TSTLSAV
                      (    forth6809.asm):08758         
                      (    forth6809.asm):08759                    LDA  #'T'
                      (    forth6809.asm):08760                    STA  TSTNAMEB
                      (    forth6809.asm):08761                    LDA  #'E'
                      (    forth6809.asm):08762                    STA  TSTNAMEB+1
                      (    forth6809.asm):08763                    LDA  #'S'
                      (    forth6809.asm):08764                    STA  TSTNAMEB+2
                      (    forth6809.asm):08765                    LDA  #'T'
                      (    forth6809.asm):08766                    STA  TSTNAMEB+3
                      (    forth6809.asm):08767                    LDA  #'W'
                      (    forth6809.asm):08768                    STA  TSTNAMEB+4
                      (    forth6809.asm):08769                    LDA  #'D'
                      (    forth6809.asm):08770                    STA  TSTNAMEB+5
                      (    forth6809.asm):08771         
                      (    forth6809.asm):08772                    LDD  #TSTCBUF
                      (    forth6809.asm):08773                    STD  CODEHERE
                      (    forth6809.asm):08774                    LDD  #TSTDBUF
                      (    forth6809.asm):08775                    STD  DPHERE
                      (    forth6809.asm):08776                    LDD  #TSTVBUF
                      (    forth6809.asm):08777                    STD  VARHERE
                      (    forth6809.asm):08778                    LDD  #TSTNAMEB
                      (    forth6809.asm):08779                    STD  SRCADDR
                      (    forth6809.asm):08780                    LDD  #6
                      (    forth6809.asm):08781                    STD  SRCLEN
                      (    forth6809.asm):08782                    LDD  #0
                      (    forth6809.asm):08783                    STD  TOIN
                      (    forth6809.asm):08784         
                      (    forth6809.asm):08785                    LDD  CODEHERE
                      (    forth6809.asm):08786                    STD  TSTWCFA
                      (    forth6809.asm):08787         

                      (    forth6809.asm):01978         
DD86 F6017A           (    forth6809.asm):01979         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
DD89 F10179           (    forth6809.asm):01980                     CMPB  OUTHEAD
DD8C 270F             (    forth6809.asm):01981                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):01982         

                      (    forth6809.asm):15353                         BNE  HNFAIL
                      (    forth6809.asm):15354                         PULU D
                      (    forth6809.asm):15355                         CMPD #TSTVAL1
                      (    forth6809.asm):15356                         BNE  HNFAIL

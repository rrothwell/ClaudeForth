                      (    forth6809.asm):06102         ; ============================================================
                      (    forth6809.asm):06103         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06104         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06105         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06106         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06107         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06108         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06109         ; ============================================================
                      (    forth6809.asm):06110         ; ------------------------------------------------------------
                      (    forth6809.asm):06111         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06112         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06113         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06114         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06115         ; - no indirection, no value cell.
                      (    forth6809.asm):06116         ;
                      (    forth6809.asm):06117         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06118         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06119         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06120         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06121         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06122         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06123         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06124         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06125         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06126         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06127         ; ------------------------------------------------------------
FF0D CCFFFF           (    forth6809.asm):06128         TRUEBODY:  LDD   #$FFFF
FF10 3606             (    forth6809.asm):06129                    PSHU  D

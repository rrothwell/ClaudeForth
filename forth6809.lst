F865 DDAB             (    forth6809.asm):14688                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):14689                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):14690                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):14691                                   ; real source length was misread as an
                      (    forth6809.asm):14692                                   ; address, the real source address was never
                      (    forth6809.asm):14693                                   ; popped at all, and the true destination
                      (    forth6809.asm):14694                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):14695                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):14696                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):14697                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):14698                    STD  UESRCLEN
F86B 3706             (    forth6809.asm):14699                    PULU D         ; next: c-addr1 (source address)
F86D DDA7             (    forth6809.asm):14700                    STD  UEADDR
F86F CC0000           (    forth6809.asm):14701                    LDD  #0
F872 DDAD             (    forth6809.asm):14702                    STD  UEOUTLEN

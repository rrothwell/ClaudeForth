                      (    forth6809.asm):10798         ; TSTABORTQ2 - unit test for ABORT", true-flag case. Same
                      (    forth6809.asm):10799         ; compiled snippet as TSTABORTQ1, executed via CATCH with a true
                      (    forth6809.asm):10800         ; flag instead. Confirmed by reading DOABORTQUOTE's own code
                      (    forth6809.asm):10801         ; that it uses THROW -2 internally, not the raw, never-returns
                      (    forth6809.asm):10802         ; ABORT mechanism plain ABORT itself uses (which remains
                      (    forth6809.asm):10803         ; deliberately untested, per section 3.1's own reasoning) - so
                      (    forth6809.asm):10804         ; this case is safe to test directly, unlike plain ABORT would
                      (    forth6809.asm):10805         ; be.
                      (    forth6809.asm):10806         ; ------------------------------------------------------------

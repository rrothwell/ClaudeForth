                      (    forth6809.asm):11853         ; TSTMOVE2 - unit test for MOVE, overlapping case with dst >
                      (    forth6809.asm):11854         ; src (dst = TSTCBUF+2, src = TSTCBUF, 5 bytes - a 2-byte
                      (    forth6809.asm):11855         ; forward shift). MOVE's own code compares addresses and
                      (    forth6809.asm):11856         ; delegates to CMOVE> (high-to-low) whenever dst > src,
                      (    forth6809.asm):11857         ; specifically to avoid the corruption a naive low-to-high copy
                      (    forth6809.asm):11858         ; would cause here (byte 2 would get overwritten by the copy
                      (    forth6809.asm):11859         ; before ever being read as a source byte). Expected result
                      (    forth6809.asm):11860         ; hand-derived and independently simulated in Python before
                      (    forth6809.asm):11861         ; writing this test, not guessed: "ABABCDE" across bytes 0-6.
                      (    forth6809.asm):11862         ; ------------------------------------------------------------

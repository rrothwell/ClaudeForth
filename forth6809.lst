E5FA DC76             (    forth6809.asm):11943                   LDD   UDLO
E5FC 3606             (    forth6809.asm):11944                   PSHU  D
E5FE CCFFFF           (    forth6809.asm):11945                   LDD   #-1
E601 3606             (    forth6809.asm):11946                   PSHU  D
E603 39               (    forth6809.asm):11947                   RTS
                      (    forth6809.asm):11948         

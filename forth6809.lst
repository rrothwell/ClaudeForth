                      (    forth6809.asm):10917         ; COLDSTRT
                      (    forth6809.asm):10918         ;    Inputs:
                      (    forth6809.asm):10919         ;        hardware reset
                      (    forth6809.asm):10920         ;    Outputs:
                      (    forth6809.asm):10921         ;        does not return
                      (    forth6809.asm):10922         ;    Registers: all registers initialised.
                      (    forth6809.asm):10923         ; ------------------------------------------------------------

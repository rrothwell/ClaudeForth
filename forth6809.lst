                      (    forth6809.asm):03285         
                      (    forth6809.asm):03286                     ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03287                     ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03288                     ; apart without needing a separate flag of its own either
E528 DC50             (    forth6809.asm):03289                     LDD   UDLO
E52A 3606             (    forth6809.asm):03290                     PSHU  D
E52C DC4E             (    forth6809.asm):03291                     LDD   UDHI
E52E 3606             (    forth6809.asm):03292                     PSHU  D
E530 CC0001           (    forth6809.asm):03293                     LDD   #1
E533 3606             (    forth6809.asm):03294                     PSHU  D
E535 39               (    forth6809.asm):03295                     RTS
                      (    forth6809.asm):03296         
E536                  (    forth6809.asm):03297         NQSINGLE:                           ; SINGLE success - unchanged from the original convention
E536 DC50             (    forth6809.asm):03298                     LDD   UDLO
E538 3606             (    forth6809.asm):03299                     PSHU  D
E53A CCFFFF           (    forth6809.asm):03300                     LDD   #-1
E53D 3606             (    forth6809.asm):03301                     PSHU  D
E53F 39               (    forth6809.asm):03302                     RTS
                      (    forth6809.asm):03303         

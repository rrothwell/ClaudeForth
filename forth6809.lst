E8BC 3606             (    forth6809.asm):19696                  PSHU  D          ; read, shifting S by 2 first - so "2,S" landed
E8BE 39               (    forth6809.asm):19697                  RTS              ; on the limit (what's really at 4,S unshifted)
                      (    forth6809.asm):19698                                   ; instead of the index. The pair served no
                      (    forth6809.asm):19699                                   ; purpose (nothing needed offset 0 for anything
                      (    forth6809.asm):19700                                   ; here) - removed, so 2,S directly and
                      (    forth6809.asm):19701                                   ; correctly targets the index DOSETUP pushed
                      (    forth6809.asm):19702                                   ; there. Confirmed via MAME debugger: "I"
                      (    forth6809.asm):19703                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):19704         
E8BF EC68             (    forth6809.asm):19705         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E8C1 3606             (    forth6809.asm):19706                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E8C3 39               (    forth6809.asm):19707                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):19708                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):19709                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):19710                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):19711                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):19712                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):19713                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):19714                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):19715                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):19716                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):19717                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):19718                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):19719                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):19720                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):19721                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):19722                                   ; limit, never progressing). Confirmed via a
                      (    forth6809.asm):19723                                   ; real MULT-TABLE test on MAME.
                      (    forth6809.asm):19724         
E8C4 CCFFFF           (    forth6809.asm):19725         LEAVE:   LDD   #TRUEV    ; BUG FIX (earlier): was PULS X first, shifting
E8C7 ED66             (    forth6809.asm):19726                  STD   6,S       ; S by 2 before this write, landing 2 bytes
E8C9 39               (    forth6809.asm):19727                  RTS             ; past the LEAVE flag DOSETUP actually pushed.
                      (    forth6809.asm):19728                                   ; Fixed by deferring PULS X to after the
                      (    forth6809.asm):19729                                   ; write - but that left a PULS X/PSHS X pair
                      (    forth6809.asm):19730                                   ; that had become a genuine no-op (nothing
                      (    forth6809.asm):19731                                   ; between them touches S or X, and this
                      (    forth6809.asm):19732                                   ; routine never uses X's value for anything,
                      (    forth6809.asm):19733                                   ; unlike DOTEST's own deferred PULS X, which
                      (    forth6809.asm):19734                                   ; feeds LDD ,X/LEAX D,X afterward). Removed,
                      (    forth6809.asm):19735                                   ; per the parallel 68000 port's observation,
                      (    forth6809.asm):19736                                   ; confirmed by inspection.
                      (    forth6809.asm):19737         

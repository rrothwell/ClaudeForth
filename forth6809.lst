                      (    forth6809.asm):06290                  PSHU  D
                      (    forth6809.asm):06291                  JSR   CCOMMA
                      (    forth6809.asm):06292         
                      (    forth6809.asm):06293                  LDD   TSTCSAV
                      (    forth6809.asm):06294                  STD   CODEHERE
                      (    forth6809.asm):06295         
                      (    forth6809.asm):06296                  STU   TSTU0
                      (    forth6809.asm):06297         
                      (    forth6809.asm):06298                  LDD   #TSTGUARD
                      (    forth6809.asm):06299                  PSHU  D
                      (    forth6809.asm):06300                  LDD   #TRUEV
                      (    forth6809.asm):06301                  PSHU  D
                      (    forth6809.asm):06302                  STU   TSTUB4

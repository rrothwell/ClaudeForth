                      (    forth6809.asm):08162         
                      (    forth6809.asm):08163                  ELSE  ; <<<<<>>>>>
DEF5 3B               (    forth6809.asm):08164         IRQH:    RTI                 ; polling mode (SERIALPOLL=1) - ACIA

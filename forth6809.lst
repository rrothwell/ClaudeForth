                      (    forth6809.asm):06798         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):06799         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):06800         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):06801         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):06802         ; (off-by-one, wrong direction, wrong starting value) would
                      (    forth6809.asm):06803         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (    forth6809.asm):06804         ; just "some number of iterations happened."
                      (    forth6809.asm):06805         ;
                      (    forth6809.asm):06806         ; The documented limit=index edge case (runs at least once) is
                      (    forth6809.asm):06807         ; deliberately NOT tested here: traced precisely (simulated the
                      (    forth6809.asm):06808         ; real DOTEST increment-and-compare-equal logic) and confirmed
                      (    forth6809.asm):06809         ; it takes a full 65536 iterations to naturally reconverge on
                      (    forth6809.asm):06810         ; equality, not one - true to the letter of "at least once" but
                      (    forth6809.asm):06811         ; impractical for a boot-time self-check. Left untested, not
                      (    forth6809.asm):06812         ; guessed at; noted in the open-items checklist.

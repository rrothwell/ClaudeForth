DEC0 7EE646           (    forth6809.asm):02028                     JMP   THROWW
                      (    forth6809.asm):02029         
                      (    forth6809.asm):02030         ; ------------------------------------------------------------
                      (    forth6809.asm):02031         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02032         ; ABORT
                      (    forth6809.asm):02033         ;    Inputs:
                      (    forth6809.asm):02034         ;        none
                      (    forth6809.asm):02035         ;    Outputs:
                      (    forth6809.asm):02036         ;        none (does not return)

                      (    forth6809.asm):07013         ; ------------------------------------------------------------
                      (    forth6809.asm):07014         ; SEARCH  ( c-addr1 u1 c-addr2 u2 -- c-addr3 u3 flag )
                      (    forth6809.asm):07015         ; Search the string c-addr1 u1 for the string c-addr2 u2. If found,
                      (    forth6809.asm):07016         ; return the address and remaining length of the match and true;
                      (    forth6809.asm):07017         ; otherwise return the original string and false.
                      (    forth6809.asm):07018         ; ------------------------------------------------------------
F734 335A             (    forth6809.asm):07019         SEARCHW:    LEAU  -6,U              ; locals: 0,U candidate address, 2,U positions
F736 EC46             (    forth6809.asm):07020                     LDD   6,U               ; left, 4,U end of the needle.  Then u2 at 6,
F738 2606             (    forth6809.asm):07021                     BNE   SRCHNZ            ; c-addr2 at 8, u1 at 10, c-addr1 at 12
F73A EC4C             (    forth6809.asm):07022                     LDD   12,U              ; an empty needle matches at the start
F73C EDC4             (    forth6809.asm):07023                     STD   ,U
F73E 2029             (    forth6809.asm):07024                     BRA   SFOUND
F740 EC4A             (    forth6809.asm):07025         SRCHNZ:     LDD   10,U
F742 A346             (    forth6809.asm):07026                     SUBD  6,U
F744 2D34             (    forth6809.asm):07027                     BLT   SRCHNOTFOUND

                      (    forth6809.asm):13612                    LDD  TSTUB4
                      (    forth6809.asm):13613                    SUBD TSTUAF
                      (    forth6809.asm):13614                    CMPD #2
                      (    forth6809.asm):13615                    BNE  SN2FAIL
                      (    forth6809.asm):13616         
                      (    forth6809.asm):13617                    LDD  #TRUEV
                      (    forth6809.asm):13618                    BRA  SN2DONE
C2B7                  (    forth6809.asm):13619         SN2FAIL:   LDD  #FALSEV
C2B7                  (    forth6809.asm):13620         SN2DONE:   LDX  #TSTSN2NAME
                      (    forth6809.asm):13621                    PSHU X
                      (    forth6809.asm):13622                    PSHU D
                      (    forth6809.asm):13623                    JSR  TSTREPORT
                      (    forth6809.asm):13624         

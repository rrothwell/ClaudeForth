                      (    forth6809.asm):02330                    CMPD  #TSTVAL2
                      (    forth6809.asm):02331                    BNE   RO2FAIL
                      (    forth6809.asm):02332                    PULU  D
                      (    forth6809.asm):02333                    CMPD  #TSTVAL1
                      (    forth6809.asm):02334                    BNE   RO2FAIL
                      (    forth6809.asm):02335                    PULU  D
                      (    forth6809.asm):02336                    CMPD  #TSTVAL6

                      (    forth6809.asm):01769         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):01770         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):01771         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):01772         ; ------------------------------------------------------------
E035                  (    forth6809.asm):01773         RTSCHECKLO: JSR  INFILL
                      (    forth6809.asm):01774                     CMPA #INLOWATER

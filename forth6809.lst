                      (    forth6809.asm):17819                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):17820                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):17821                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):17822                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):17823                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):17824                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):17825                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):17826                   ; high cell.
E5C3 0D22             (    forth6809.asm):17827                   TST   NUMNEG
E5C5 2718             (    forth6809.asm):17828                   BEQ   NQPOS32
E5C7 DC76             (    forth6809.asm):17829                   LDD   UDLO
E5C9 43               (    forth6809.asm):17830                   COMA
E5CA 53               (    forth6809.asm):17831                   COMB
E5CB C30001           (    forth6809.asm):17832                   ADDD  #1
E5CE DD76             (    forth6809.asm):17833                   STD   UDLO
E5D0 3401             (    forth6809.asm):17834                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):17835                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):17836                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):17837                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):17838                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):17839                                      ; silently overwrote the real carry here
                      (    forth6809.asm):17840                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):17841                                      ; making the high-cell increment run
                      (    forth6809.asm):17842                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):17843                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):17844                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):17845                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):17846                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):17847                                      ; matching "always increment" rather than
                      (    forth6809.asm):17848                                      ; "increment only on genuine carry".
E5D2 DC74             (    forth6809.asm):17849                   LDD   UDHI
E5D4 43               (    forth6809.asm):17850                   COMA
E5D5 53               (    forth6809.asm):17851                   COMB
E5D6 3501             (    forth6809.asm):17852                   PULS  CC          ; restore the TRUE carry
E5D8 2403             (    forth6809.asm):17853                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):17854                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):17855                                      ; when there's no carry - the complemented
                      (    forth6809.asm):17856                                      ; value was computed in D but never
                      (    forth6809.asm):17857                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):17858                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):17859                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):17860                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):17861                                      ; was always seen as set, so this branch
                      (    forth6809.asm):17862                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):17863                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):17864                                      ; alone would have made this second,
                      (    forth6809.asm):17865                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):17866                                      ; only past the "+1", never past the
                      (    forth6809.asm):17867                                      ; store itself - the store always runs,
                      (    forth6809.asm):17868                                      ; either way.
E5DA C30001           (    forth6809.asm):17869                   ADDD  #1
E5DD DD74             (    forth6809.asm):17870         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):17871         
E5DF                  (    forth6809.asm):17872         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):17873                   ; was '.' - determines which return convention to use
E5DF 9E1F             (    forth6809.asm):17874                   LDX   CADDR
E5E1 E684             (    forth6809.asm):17875                   LDB   ,X
E5E3 5A               (    forth6809.asm):17876                   DECB
E5E4 3001             (    forth6809.asm):17877                   LEAX  1,X
E5E6 A685             (    forth6809.asm):17878                   LDA   B,X
E5E8 812E             (    forth6809.asm):17879                   CMPA  #'.'
E5EA 260E             (    forth6809.asm):17880                   BNE   NQSINGLE
                      (    forth6809.asm):17881         
                      (    forth6809.asm):17882                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):17883                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):17884                   ; apart without needing a separate flag of its own either
E5EC DC76             (    forth6809.asm):17885                   LDD   UDLO
E5EE 3606             (    forth6809.asm):17886                   PSHU  D

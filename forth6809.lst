                      (    forth6809.asm):06707         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):06708         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):06709         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):06710         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):06711         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):06712         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):06713         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):06714         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):06715         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):06716         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):06717         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):06718         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):06719         ; ------------------------------------------------------------
C245                  (    forth6809.asm):06720         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):06721                   STD  TSTLSAV
                      (    forth6809.asm):06722                   LDD  CODEHERE
                      (    forth6809.asm):06723                   STD  TSTCSAV
                      (    forth6809.asm):06724         
                      (    forth6809.asm):06725                   LDA  #3
                      (    forth6809.asm):06726                   STA  TSTFHDR
                      (    forth6809.asm):06727                   LDA  #'F'
                      (    forth6809.asm):06728                   STA  TSTFHDR+1
                      (    forth6809.asm):06729                   LDA  #'O'
                      (    forth6809.asm):06730                   STA  TSTFHDR+2
                      (    forth6809.asm):06731                   LDA  #'O'
                      (    forth6809.asm):06732                   STA  TSTFHDR+3
                      (    forth6809.asm):06733                   LDD  #0
                      (    forth6809.asm):06734                   STD  TSTFHDR+4
                      (    forth6809.asm):06735                   LDD  #DUP
                      (    forth6809.asm):06736                   STD  TSTFHDR+6
                      (    forth6809.asm):06737         
                      (    forth6809.asm):06738                   LDD  #TSTFHDR
                      (    forth6809.asm):06739                   STD  LATEST
                      (    forth6809.asm):06740         
                      (    forth6809.asm):06741                   LDD  #TSTCBUF
                      (    forth6809.asm):06742                   STD  CODEHERE
                      (    forth6809.asm):06743         
                      (    forth6809.asm):06744                   JSR  RECURSE
                      (    forth6809.asm):06745         
                      (    forth6809.asm):06746                   LDD  #OPRTS
                      (    forth6809.asm):06747                   PSHU D
                      (    forth6809.asm):06748                   JSR  CCOMMA
                      (    forth6809.asm):06749         
                      (    forth6809.asm):06750                   LDD  TSTCSAV
                      (    forth6809.asm):06751                   STD  CODEHERE
                      (    forth6809.asm):06752                   LDD  TSTLSAV
                      (    forth6809.asm):06753                   STD  LATEST
                      (    forth6809.asm):06754         
                      (    forth6809.asm):06755                   STU  TSTU0
                      (    forth6809.asm):06756         
                      (    forth6809.asm):06757                   LDD  #TSTGUARD
                      (    forth6809.asm):06758                   PSHU D
                      (    forth6809.asm):06759                   LDD  #TSTVAL1
                      (    forth6809.asm):06760                   PSHU D
                      (    forth6809.asm):06761                   STU  TSTUB4
                      (    forth6809.asm):06762         

                      (    forth6809.asm):13204         ; ============================================================
                      (    forth6809.asm):13205         ; ------------------------------------------------------------
                      (    forth6809.asm):13206         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):13207         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):13208         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):13209         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):13210         ; - no indirection, no value cell.
                      (    forth6809.asm):13211         ;
                      (    forth6809.asm):13212         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):13213         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):13214         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):13215         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):13216         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):13217         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):13218         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):13219         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):13220         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):13221         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):13222         ; ------------------------------------------------------------

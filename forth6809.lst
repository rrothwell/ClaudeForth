                      (    forth6809.asm):03094         ; ------------------------------------------------------------
                      (    forth6809.asm):03095         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03096         ; Look up the counted string in the dictionary, newest first, ignoring
                      (    forth6809.asm):03097         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03098         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03099         ; Holds no scratch cells; see shadow FINDW.1.
                      (    forth6809.asm):03100         ; ------------------------------------------------------------
E262 9E04             (    forth6809.asm):03101         FINDW:      LDX   LATEST            ; c-addr stays at ,U until the result
E264 8C0000           (    forth6809.asm):03102         FFLOOP:     CMPX  #0                ; (5l: no scratch cells)
E267 2751             (    forth6809.asm):03103                     BEQ   NOTFOUND

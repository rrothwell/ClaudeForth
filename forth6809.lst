                      (    forth6809.asm):02185         ; ============================================================
                      (    forth6809.asm):02186         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02187         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02188         ; ============================================================
                      (    forth6809.asm):02189         ; ------------------------------------------------------------
                      (    forth6809.asm):02190         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02191         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02192         ; LIT   ( -- x )
                      (    forth6809.asm):02193         ;    Inputs:
                      (    forth6809.asm):02194         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02195         ;    Outputs:
                      (    forth6809.asm):02196         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02197         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02198         ; ------------------------------------------------------------
DE6C 3510             (    forth6809.asm):02199         LIT:        PULS  X
DE6E EC81             (    forth6809.asm):02200                     LDD   ,X++
DE70 3606             (    forth6809.asm):02201                     PSHU  D                 ; x
DE72 3410             (    forth6809.asm):02202                     PSHS  X
DE74 39               (    forth6809.asm):02203                     RTS
                      (    forth6809.asm):02204         
                      (    forth6809.asm):02205         ; ------------------------------------------------------------
                      (    forth6809.asm):02206         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02207         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02208         ; address.
                      (    forth6809.asm):02209         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        flag on the data stack
                      (    forth6809.asm):02212         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02213         ;    Outputs:
                      (    forth6809.asm):02214         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02215         ;        the offset
                      (    forth6809.asm):02216         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02217         ; ------------------------------------------------------------
DE75 3706             (    forth6809.asm):02218         ZBRANCH:    PULU  D                 ; flag
DE77 3510             (    forth6809.asm):02219                     PULS  X
DE79 10830000         (    forth6809.asm):02220                     CMPD  #0
DE7D 2607             (    forth6809.asm):02221                     BNE   ZSKIP
DE7F EC84             (    forth6809.asm):02222                     LDD   ,X
DE81 308B             (    forth6809.asm):02223                     LEAX  D,X
DE83 3410             (    forth6809.asm):02224                     PSHS  X
DE85 39               (    forth6809.asm):02225                     RTS
DE86 3002             (    forth6809.asm):02226         ZSKIP:      LEAX  2,X
DE88 3410             (    forth6809.asm):02227                     PSHS  X
DE8A 39               (    forth6809.asm):02228                     RTS
                      (    forth6809.asm):02229         
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
                      (    forth6809.asm):02231         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02232         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02233         ; BRANCH
                      (    forth6809.asm):02234         ;    Inputs:
                      (    forth6809.asm):02235         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02236         ;    Outputs:
                      (    forth6809.asm):02237         ;        return address set to the branch target
                      (    forth6809.asm):02238         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02239         ; ------------------------------------------------------------
DE8B 3510             (    forth6809.asm):02240         BRANCH:     PULS  X
DE8D EC84             (    forth6809.asm):02241                     LDD   ,X
DE8F 308B             (    forth6809.asm):02242                     LEAX  D,X
DE91 3410             (    forth6809.asm):02243                     PSHS  X
DE93 39               (    forth6809.asm):02244                     RTS
                      (    forth6809.asm):02245         
                      (    forth6809.asm):02246         ; ------------------------------------------------------------
                      (    forth6809.asm):02247         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02248         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02249         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02250         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02251         ;    Inputs:
                      (    forth6809.asm):02252         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02253         ;        trampoline
                      (    forth6809.asm):02254         ;    Outputs:
                      (    forth6809.asm):02255         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02256         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02257         ; ------------------------------------------------------------
DE94 3510             (    forth6809.asm):02258         DODOES:     PULS  X
DE96 10AE81           (    forth6809.asm):02259                     LDY   ,X++
DE99 EC84             (    forth6809.asm):02260                     LDD   ,X
DE9B 3606             (    forth6809.asm):02261                     PSHU  D                 ; pfa
DE9D 6EA4             (    forth6809.asm):02262                     JMP   ,Y
                      (    forth6809.asm):02263         
                      (    forth6809.asm):02264         ; ------------------------------------------------------------
                      (    forth6809.asm):02265         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02266         ; field address on the stack.
                      (    forth6809.asm):02267         ; DOESRT0
                      (    forth6809.asm):02268         ;    Inputs:
                      (    forth6809.asm):02269         ;        none
                      (    forth6809.asm):02270         ;    Outputs:
                      (    forth6809.asm):02271         ;        none
                      (    forth6809.asm):02272         ;    Registers: none.
                      (    forth6809.asm):02273         ; ------------------------------------------------------------
DE9F 39               (    forth6809.asm):02274         DOESRT0:    RTS
                      (    forth6809.asm):02275         
                      (    forth6809.asm):02276         ; ------------------------------------------------------------
                      (    forth6809.asm):02277         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02278         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02279         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02280         ; SETDOES
                      (    forth6809.asm):02281         ;    Inputs:
                      (    forth6809.asm):02282         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02283         ;        BEHAVIOR)
                      (    forth6809.asm):02284         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02285         ;        address
                      (    forth6809.asm):02286         ;    Outputs:
                      (    forth6809.asm):02287         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02288         ;        defining word's caller
                      (    forth6809.asm):02289         ;    Registers: RegD, RegX, CC, HDRFLAGS and DOESBEH changed.
                      (    forth6809.asm):02290         ; ------------------------------------------------------------
DEA0 3510             (    forth6809.asm):02291         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DEA2 9FFD             (    forth6809.asm):02292                     STX   DOESBEH
                      (    forth6809.asm):02293         
DEA4 9E04             (    forth6809.asm):02294                     LDX   LATEST
DEA6 A684             (    forth6809.asm):02295                     LDA   ,X
DEA8 971E             (    forth6809.asm):02296                     STA   HDRFLAGS
DEAA 3001             (    forth6809.asm):02297                     LEAX  1,X
DEAC D61E             (    forth6809.asm):02298                     LDB   HDRFLAGS
DEAE C41F             (    forth6809.asm):02299                     ANDB  #$1F
DEB0 4F               (    forth6809.asm):02300                     CLRA
DEB1 308B             (    forth6809.asm):02301                     LEAX  D,X               ; skip name -> LINK field
DEB3 3002             (    forth6809.asm):02302                     LEAX  2,X               ; skip LINK -> CFA field
DEB5 EC84             (    forth6809.asm):02303                     LDD   ,X                ; D = CFA (trampoline address)
DEB7 C30003           (    forth6809.asm):02304                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DEBA 1F01             (    forth6809.asm):02305                     TFR   D,X
                      (    forth6809.asm):02306         
DEBC DCFD             (    forth6809.asm):02307                     LDD   DOESBEH
DEBE ED84             (    forth6809.asm):02308                     STD   ,X                ; patch it
                      (    forth6809.asm):02309         
DEC0 3510             (    forth6809.asm):02310                     PULS  X                 ; X = the OUTER defining word's own return addr
DEC2 6E84             (    forth6809.asm):02311                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02312         
                      (    forth6809.asm):02313         ; ------------------------------------------------------------
                      (    forth6809.asm):02314         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02315         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02316         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02317         ;    Inputs:
                      (    forth6809.asm):02318         ;        pfa on the data stack
                      (    forth6809.asm):02319         ;    Outputs:
                      (    forth6809.asm):02320         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02321         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02322         ; ------------------------------------------------------------
DEC4 3710             (    forth6809.asm):02323         DODEFER:    PULU  X                 ; pfa
DEC6 EC84             (    forth6809.asm):02324                     LDD   ,X
DEC8 1F01             (    forth6809.asm):02325                     TFR   D,X
DECA 6E84             (    forth6809.asm):02326                     JMP   ,X
                      (    forth6809.asm):02327         
                      (    forth6809.asm):02328         ; ------------------------------------------------------------
                      (    forth6809.asm):02329         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02330         ; DOABORTUNDEF
                      (    forth6809.asm):02331         ;    Inputs:
                      (    forth6809.asm):02332         ;        none
                      (    forth6809.asm):02333         ;    Outputs:
                      (    forth6809.asm):02334         ;        none (does not return)
                      (    forth6809.asm):02335         ;    Registers: RegD changed.
                      (    forth6809.asm):02336         ; ------------------------------------------------------------
DECC                  (    forth6809.asm):02337         DOABORTUNDEF:
DECC CCFFEB           (    forth6809.asm):02338                     LDD   #-21
DECF 3606             (    forth6809.asm):02339                     PSHU  D                 ; throw code (-21)
DED1 7EE60A           (    forth6809.asm):02340                     JMP   THROW
                      (    forth6809.asm):02341         
                      (    forth6809.asm):02342         ; ------------------------------------------------------------
                      (    forth6809.asm):02343         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02344         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02345         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02346         ;    Inputs:
                      (    forth6809.asm):02347         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02348         ;    Outputs:
                      (    forth6809.asm):02349         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02350         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02351         ; ------------------------------------------------------------
DED4 3710             (    forth6809.asm):02352         DOMARKER:   PULU  X                 ; pfa
DED6 EC84             (    forth6809.asm):02353                     LDD   ,X
DED8 DD06             (    forth6809.asm):02354                     STD   DPHERE
DEDA EC02             (    forth6809.asm):02355                     LDD   2,X
DEDC DD08             (    forth6809.asm):02356                     STD   CODEHERE
DEDE EC04             (    forth6809.asm):02357                     LDD   4,X
DEE0 DD0A             (    forth6809.asm):02358                     STD   VARHERE
DEE2 EC06             (    forth6809.asm):02359                     LDD   6,X
DEE4 DD04             (    forth6809.asm):02360                     STD   LATEST
DEE6 39               (    forth6809.asm):02361                     RTS
                      (    forth6809.asm):02362         
                      (    forth6809.asm):02363         ; ------------------------------------------------------------
                      (    forth6809.asm):02364         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02365         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02366         ; ------------------------------------------------------------
DEE7 3710             (    forth6809.asm):02367         EXECUTEW:   PULU  X                 ; xt
DEE9 AD84             (    forth6809.asm):02368                     JSR   ,X
DEEB 39               (    forth6809.asm):02369                     RTS
                      (    forth6809.asm):02370         
                      (    forth6809.asm):02371         ; ============================================================
                      (    forth6809.asm):02372         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02373         ; ============================================================
                      (    forth6809.asm):02374         ; ------------------------------------------------------------
                      (    forth6809.asm):02375         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02376         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02377         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02378         ;    Inputs:
                      (    forth6809.asm):02379         ;        RegX = address of the here pointer
                      (    forth6809.asm):02380         ;        x on the data stack
                      (    forth6809.asm):02381         ;    Outputs:
                      (    forth6809.asm):02382         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02383         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
DEEC 3706             (    forth6809.asm):02385         APPENDCELL: PULU  D                 ; x
DEEE 10AE84           (    forth6809.asm):02386                     LDY   ,X
DEF1 EDA1             (    forth6809.asm):02387                     STD   ,Y++
DEF3 10AF84           (    forth6809.asm):02388                     STY   ,X
DEF6 39               (    forth6809.asm):02389                     RTS
                      (    forth6809.asm):02390         
                      (    forth6809.asm):02391         ; ------------------------------------------------------------
                      (    forth6809.asm):02392         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02393         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02394         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02395         ;    Inputs:
                      (    forth6809.asm):02396         ;        RegX = address of the here pointer
                      (    forth6809.asm):02397         ;        char on the data stack
                      (    forth6809.asm):02398         ;    Outputs:
                      (    forth6809.asm):02399         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02400         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02401         ; ------------------------------------------------------------
DEF7 3706             (    forth6809.asm):02402         APPENDBYTE: PULU  D                 ; char
DEF9 10AE84           (    forth6809.asm):02403                     LDY   ,X
DEFC E7A0             (    forth6809.asm):02404                     STB   ,Y+
DEFE 10AF84           (    forth6809.asm):02405                     STY   ,X
DF01 39               (    forth6809.asm):02406                     RTS
                      (    forth6809.asm):02407         
                      (    forth6809.asm):02408         ; ------------------------------------------------------------
                      (    forth6809.asm):02409         ; ,  ( x -- )
                      (    forth6809.asm):02410         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02411         ; ------------------------------------------------------------
DF02 8E0008           (    forth6809.asm):02412         COMMAW:     LDX   #CODEHERE
DF05 7EDEEC           (    forth6809.asm):02413                     JMP   APPENDCELL
                      (    forth6809.asm):02414         
                      (    forth6809.asm):02415         ; ------------------------------------------------------------
                      (    forth6809.asm):02416         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02417         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02418         ; ------------------------------------------------------------
DF08 8E0008           (    forth6809.asm):02419         CODECOMMA:  LDX   #CODEHERE
DF0B 7EDEEC           (    forth6809.asm):02420                     JMP   APPENDCELL
                      (    forth6809.asm):02421         
                      (    forth6809.asm):02422         ; ------------------------------------------------------------
                      (    forth6809.asm):02423         ; C,  ( char -- )
                      (    forth6809.asm):02424         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02425         ; ------------------------------------------------------------
DF0E 8E0008           (    forth6809.asm):02426         CCOMMAW:    LDX   #CODEHERE
DF11 7EDEF7           (    forth6809.asm):02427                     JMP   APPENDBYTE
                      (    forth6809.asm):02428         
                      (    forth6809.asm):02429         ; ------------------------------------------------------------
                      (    forth6809.asm):02430         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02431         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02432         ; ------------------------------------------------------------
DF14 8E0008           (    forth6809.asm):02433         CCOMMA1:    LDX   #CODEHERE
DF17 7EDEF7           (    forth6809.asm):02434                     JMP   APPENDBYTE
                      (    forth6809.asm):02435         
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
                      (    forth6809.asm):02437         ; V,  ( x -- )
                      (    forth6809.asm):02438         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02439         ; ------------------------------------------------------------
DF1A 8E000A           (    forth6809.asm):02440         VCOMMAW:    LDX   #VARHERE
DF1D 7EDEEC           (    forth6809.asm):02441                     JMP   APPENDCELL
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443         ; ------------------------------------------------------------
                      (    forth6809.asm):02444         ; VC,  ( char -- )
                      (    forth6809.asm):02445         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02446         ; ------------------------------------------------------------
DF20 8E000A           (    forth6809.asm):02447         VCCOMMAW:   LDX   #VARHERE
DF23 7EDEF7           (    forth6809.asm):02448                     JMP   APPENDBYTE
                      (    forth6809.asm):02449         
                      (    forth6809.asm):02450         ; ------------------------------------------------------------
                      (    forth6809.asm):02451         ; ALLOT  ( n -- )
                      (    forth6809.asm):02452         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02453         ; ------------------------------------------------------------
DF26 3706             (    forth6809.asm):02454         ALLOTW:     PULU  D                 ; n
DF28 9E08             (    forth6809.asm):02455                     LDX   CODEHERE
DF2A 308B             (    forth6809.asm):02456                     LEAX  D,X
DF2C 9F08             (    forth6809.asm):02457                     STX   CODEHERE
DF2E 39               (    forth6809.asm):02458                     RTS
                      (    forth6809.asm):02459         
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
                      (    forth6809.asm):02461         ; VALLOT  ( n -- )
                      (    forth6809.asm):02462         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02463         ; ------------------------------------------------------------
DF2F 3706             (    forth6809.asm):02464         VALLOTW:    PULU  D                 ; n
DF31 9E0A             (    forth6809.asm):02465                     LDX   VARHERE
DF33 308B             (    forth6809.asm):02466                     LEAX  D,X
DF35 9F0A             (    forth6809.asm):02467                     STX   VARHERE
DF37 39               (    forth6809.asm):02468                     RTS
                      (    forth6809.asm):02469         
                      (    forth6809.asm):02470         ; ------------------------------------------------------------
                      (    forth6809.asm):02471         ; HERE  ( -- addr )
                      (    forth6809.asm):02472         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
DF38 DC08             (    forth6809.asm):02474         HEREW:      LDD   CODEHERE
DF3A 3606             (    forth6809.asm):02475                     PSHU  D                 ; addr
DF3C 39               (    forth6809.asm):02476                     RTS
                      (    forth6809.asm):02477         
                      (    forth6809.asm):02478         ; ------------------------------------------------------------
                      (    forth6809.asm):02479         ; VHERE  ( -- addr )
                      (    forth6809.asm):02480         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02481         ; ------------------------------------------------------------
DF3D DC0A             (    forth6809.asm):02482         VHEREW:     LDD   VARHERE
DF3F 3606             (    forth6809.asm):02483                     PSHU  D                 ; addr
DF41 39               (    forth6809.asm):02484                     RTS
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486         ; ------------------------------------------------------------
                      (    forth6809.asm):02487         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02488         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02489         ; ------------------------------------------------------------
DF42 DC08             (    forth6809.asm):02490         PADW:       LDD   CODEHERE
DF44 C30080           (    forth6809.asm):02491                     ADDD  #PADOFFSET
DF47 3606             (    forth6809.asm):02492                     PSHU  D                 ; c-addr
DF49 39               (    forth6809.asm):02493                     RTS
                      (    forth6809.asm):02494         
                      (    forth6809.asm):02495         ; ------------------------------------------------------------
                      (    forth6809.asm):02496         ; UNUSED  ( -- u )
                      (    forth6809.asm):02497         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
DF4A CCB900           (    forth6809.asm):02499         UNUSEDW:    LDD   #CODETOP
DF4D 9308             (    forth6809.asm):02500                     SUBD  CODEHERE
DF4F 3606             (    forth6809.asm):02501                     PSHU  D                 ; u
DF51 39               (    forth6809.asm):02502                     RTS
                      (    forth6809.asm):02503         
                      (    forth6809.asm):02504         ; ------------------------------------------------------------
                      (    forth6809.asm):02505         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02506         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02507         ; ------------------------------------------------------------
DF52 CC1FFF           (    forth6809.asm):02508         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
DF55 930A             (    forth6809.asm):02509                     SUBD  VARHERE
DF57 3606             (    forth6809.asm):02510                     PSHU  D                 ; u
DF59 39               (    forth6809.asm):02511                     RTS
                      (    forth6809.asm):02512         
                      (    forth6809.asm):02513         ; ============================================================
                      (    forth6809.asm):02514         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02515         ; ============================================================
                      (    forth6809.asm):02516         ; ------------------------------------------------------------
                      (    forth6809.asm):02517         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02518         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02519         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02520         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02521         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02522         ;    Inputs:
                      (    forth6809.asm):02523         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02524         ;        name parsed from the input stream
                      (    forth6809.asm):02525         ;    Outputs:
                      (    forth6809.asm):02526         ;        header built at DPHERE; LATEST and NEWHDR = address of the
                      (    forth6809.asm):02527         ;        new header
                      (    forth6809.asm):02528         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
DF5A CC0020           (    forth6809.asm):02530         HEADER:     LDD   #32
DF5D 3606             (    forth6809.asm):02531                     PSHU  D
DF5F BDE2C9           (    forth6809.asm):02532                     JSR   WORDW
DF62 3710             (    forth6809.asm):02533                     PULU  X                 ; c-addr of the name
DF64 A684             (    forth6809.asm):02534                     LDA   ,X
DF66 9741             (    forth6809.asm):02535                     STA   NAMELEN
DF68 3001             (    forth6809.asm):02536                     LEAX  1,X
DF6A 9F3F             (    forth6809.asm):02537                     STX   NAMEP
                      (    forth6809.asm):02538         
DF6C 3706             (    forth6809.asm):02539                     PULU  D                 ; smudge flag
DF6E D74E             (    forth6809.asm):02540                     STB   HDRSMUDGE
                      (    forth6809.asm):02541         
DF70 DC06             (    forth6809.asm):02542                     LDD   DPHERE
DF72 DD3D             (    forth6809.asm):02543                     STD   NEWHDR
DF74 9E06             (    forth6809.asm):02544                     LDX   DPHERE
DF76 9641             (    forth6809.asm):02545                     LDA   NAMELEN
DF78 0D4E             (    forth6809.asm):02546                     TST   HDRSMUDGE
DF7A 2702             (    forth6809.asm):02547                     BEQ   HDNOSM
DF7C 8A40             (    forth6809.asm):02548                     ORA   #$40
DF7E A780             (    forth6809.asm):02549         HDNOSM:     STA   ,X+
DF80 109E3F           (    forth6809.asm):02550                     LDY   NAMEP
DF83 D641             (    forth6809.asm):02551                     LDB   NAMELEN
DF85 2707             (    forth6809.asm):02552                     BEQ   HDNONM
DF87 A6A0             (    forth6809.asm):02553         HDCPY:      LDA   ,Y+
DF89 A780             (    forth6809.asm):02554                     STA   ,X+
DF8B 5A               (    forth6809.asm):02555                     DECB
DF8C 26F9             (    forth6809.asm):02556                     BNE   HDCPY
DF8E DC04             (    forth6809.asm):02557         HDNONM:     LDD   LATEST
DF90 ED81             (    forth6809.asm):02558                     STD   ,X++
DF92 DC08             (    forth6809.asm):02559                     LDD   CODEHERE
DF94 ED81             (    forth6809.asm):02560                     STD   ,X++
DF96 9F06             (    forth6809.asm):02561                     STX   DPHERE
DF98 DC3D             (    forth6809.asm):02562                     LDD   NEWHDR
DF9A DD04             (    forth6809.asm):02563                     STD   LATEST
DF9C 39               (    forth6809.asm):02564                     RTS
                      (    forth6809.asm):02565         
                      (    forth6809.asm):02566         ; ============================================================
                      (    forth6809.asm):02567         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02568         ; ============================================================
                      (    forth6809.asm):02569         ; ------------------------------------------------------------
                      (    forth6809.asm):02570         ; :  ( "name" -- )
                      (    forth6809.asm):02571         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02572         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02573         ; CSP and enter compile state.
                      (    forth6809.asm):02574         ; ------------------------------------------------------------
DF9D CCFFFF           (    forth6809.asm):02575         COLONW:     LDD   #TRUEV
DFA0 3606             (    forth6809.asm):02576                     PSHU  D
DFA2 BDDF5A           (    forth6809.asm):02577                     JSR   HEADER
DFA5 DC08             (    forth6809.asm):02578                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
DFA7 DD3D             (    forth6809.asm):02579                     STD   CURXT             ; See bugfix: COLONW.1
DFA9 1F30             (    forth6809.asm):02580                     TFR   U,D
DFAB DD48             (    forth6809.asm):02581                     STD   CSP
DFAD CCFFFF           (    forth6809.asm):02582                     LDD   #-1
DFB0 DD00             (    forth6809.asm):02583                     STD   STATE
DFB2 39               (    forth6809.asm):02584                     RTS
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586         ; ------------------------------------------------------------
                      (    forth6809.asm):02587         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02588         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02589         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02590         ; new word and return to interpret state.
                      (    forth6809.asm):02591         ; ------------------------------------------------------------
DFB3 CC0039           (    forth6809.asm):02592         SEMIW:      LDD   #RTSOPC
DFB6 3606             (    forth6809.asm):02593                     PSHU  D
DFB8 BDDF14           (    forth6809.asm):02594                     JSR   CCOMMA1
DFBB 1F30             (    forth6809.asm):02595                     TFR   U,D
DFBD 109348           (    forth6809.asm):02596                     CMPD  CSP
DFC0 2703             (    forth6809.asm):02597                     BEQ   SEMIOK
DFC2 BDE5D5           (    forth6809.asm):02598                     JSR   CFERR
DFC5 9E04             (    forth6809.asm):02599         SEMIOK:     LDX   LATEST
DFC7 A684             (    forth6809.asm):02600                     LDA   ,X
DFC9 84BF             (    forth6809.asm):02601                     ANDA  #$BF
DFCB A784             (    forth6809.asm):02602                     STA   ,X
DFCD CC0000           (    forth6809.asm):02603                     LDD   #0
DFD0 DD00             (    forth6809.asm):02604                     STD   STATE
DFD2 39               (    forth6809.asm):02605                     RTS
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02609         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02610         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02611         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02612         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02613         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02614         ; ------------------------------------------------------------
DFD3 DC08             (    forth6809.asm):02615         NONAMEW:    LDD   CODEHERE
DFD5 3606             (    forth6809.asm):02616                     PSHU  D                 ; xt
DFD7 DD3D             (    forth6809.asm):02617                     STD   CURXT             ; See bugfix: NONAMEW.1
DFD9 1F30             (    forth6809.asm):02618                     TFR   U,D
DFDB DD48             (    forth6809.asm):02619                     STD   CSP
DFDD CCFFFF           (    forth6809.asm):02620                     LDD   #-1
DFE0 DD00             (    forth6809.asm):02621                     STD   STATE
DFE2 39               (    forth6809.asm):02622                     RTS
                      (    forth6809.asm):02623         
                      (    forth6809.asm):02624         ; ------------------------------------------------------------
                      (    forth6809.asm):02625         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02626         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02627         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02628         ; address in the code area, on the stack.
                      (    forth6809.asm):02629         ; ------------------------------------------------------------
DFE3 CC0000           (    forth6809.asm):02630         CREATEW:    LDD   #0
DFE6 3606             (    forth6809.asm):02631                     PSHU  D
DFE8 BDDF5A           (    forth6809.asm):02632                     JSR   HEADER
DFEB CCDE94           (    forth6809.asm):02633                     LDD   #DODOES
DFEE 3606             (    forth6809.asm):02634                     PSHU  D
DFF0 BDEA85           (    forth6809.asm):02635                     JSR   CCALL
DFF3 CCDE9F           (    forth6809.asm):02636                     LDD   #DOESRT0
DFF6 3606             (    forth6809.asm):02637                     PSHU  D
DFF8 BDDF08           (    forth6809.asm):02638                     JSR   CODECOMMA
DFFB DC08             (    forth6809.asm):02639                     LDD   CODEHERE          ; PFA = the cell after this one
DFFD C30002           (    forth6809.asm):02640                     ADDD  #2                ; See bugfix: CONSTANTW.1
E000 3606             (    forth6809.asm):02641                     PSHU  D
E002 BDDF08           (    forth6809.asm):02642                     JSR   CODECOMMA
E005 39               (    forth6809.asm):02643                     RTS
                      (    forth6809.asm):02644         
                      (    forth6809.asm):02645         ; ------------------------------------------------------------
                      (    forth6809.asm):02646         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02647         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02648         ; of the word being defined.
                      (    forth6809.asm):02649         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02650         ; ------------------------------------------------------------
E006 CCDEA0           (    forth6809.asm):02651         DOESGTW:    LDD   #SETDOES
E009 3606             (    forth6809.asm):02652                     PSHU  D
E00B BDEA85           (    forth6809.asm):02653                     JSR   CCALL
E00E 39               (    forth6809.asm):02654                     RTS
                      (    forth6809.asm):02655         
                      (    forth6809.asm):02656         ; ------------------------------------------------------------
                      (    forth6809.asm):02657         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02658         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02659         ; area, initialised to zero.
                      (    forth6809.asm):02660         ; ------------------------------------------------------------
E00F CC0000           (    forth6809.asm):02661         VARIABLEW:  LDD   #0
E012 3606             (    forth6809.asm):02662                     PSHU  D
E014 BDDF5A           (    forth6809.asm):02663                     JSR   HEADER
E017 CCDE94           (    forth6809.asm):02664                     LDD   #DODOES
E01A 3606             (    forth6809.asm):02665                     PSHU  D
E01C BDEA85           (    forth6809.asm):02666                     JSR   CCALL
E01F CCDE9F           (    forth6809.asm):02667                     LDD   #DOESRT0
E022 3606             (    forth6809.asm):02668                     PSHU  D
E024 BDDF08           (    forth6809.asm):02669                     JSR   CODECOMMA
E027 DC0A             (    forth6809.asm):02670                     LDD   VARHERE
E029 3606             (    forth6809.asm):02671                     PSHU  D
E02B BDDF08           (    forth6809.asm):02672                     JSR   CODECOMMA
E02E CC0000           (    forth6809.asm):02673                     LDD   #0
E031 9E0A             (    forth6809.asm):02674                     LDX   VARHERE
E033 ED81             (    forth6809.asm):02675                     STD   ,X++
E035 9F0A             (    forth6809.asm):02676                     STX   VARHERE
E037 39               (    forth6809.asm):02677                     RTS
                      (    forth6809.asm):02678         
                      (    forth6809.asm):02679         ; ------------------------------------------------------------
                      (    forth6809.asm):02680         ; @  ( a-addr -- x )
                      (    forth6809.asm):02681         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02682         ; ------------------------------------------------------------
E038 3710             (    forth6809.asm):02683         ATSIGNW:    PULU  X                 ; a-addr
E03A EC84             (    forth6809.asm):02684                     LDD   ,X
E03C 3606             (    forth6809.asm):02685                     PSHU  D                 ; x
E03E 39               (    forth6809.asm):02686                     RTS
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
                      (    forth6809.asm):02689         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02690         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02691         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
E03F CC0000           (    forth6809.asm):02693         CONSTANTW:  LDD   #0
E042 3606             (    forth6809.asm):02694                     PSHU  D
E044 BDDF5A           (    forth6809.asm):02695                     JSR   HEADER
E047 CCDE94           (    forth6809.asm):02696                     LDD   #DODOES
E04A 3606             (    forth6809.asm):02697                     PSHU  D
E04C BDEA85           (    forth6809.asm):02698                     JSR   CCALL
E04F CCE038           (    forth6809.asm):02699                     LDD   #ATSIGNW
E052 3606             (    forth6809.asm):02700                     PSHU  D
E054 BDDF08           (    forth6809.asm):02701                     JSR   CODECOMMA
E057 DC08             (    forth6809.asm):02702                     LDD   CODEHERE          ; PFA = the cell after this one
E059 C30002           (    forth6809.asm):02703                     ADDD  #2                ; See bugfix: CONSTANTW.1
E05C 3606             (    forth6809.asm):02704                     PSHU  D
E05E BDDF08           (    forth6809.asm):02705                     JSR   CODECOMMA
E061 BDDF02           (    forth6809.asm):02706                     JSR   COMMAW
E064 39               (    forth6809.asm):02707                     RTS
                      (    forth6809.asm):02708         
                      (    forth6809.asm):02709         ; ------------------------------------------------------------
                      (    forth6809.asm):02710         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02711         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02712         ;    Inputs:
                      (    forth6809.asm):02713         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02714         ;    Outputs:
                      (    forth6809.asm):02715         ;        pfa replaced by the value
                      (    forth6809.asm):02716         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02717         ; ------------------------------------------------------------
E065 3710             (    forth6809.asm):02718         DOVALUE:    PULU  X                 ; pfa
E067 EC84             (    forth6809.asm):02719                     LDD   ,X
E069 3606             (    forth6809.asm):02720                     PSHU  D                 ; x
E06B 39               (    forth6809.asm):02721                     RTS
                      (    forth6809.asm):02722         
                      (    forth6809.asm):02723         ; ------------------------------------------------------------
                      (    forth6809.asm):02724         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02725         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02726         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02727         ; ------------------------------------------------------------
E06C CC0000           (    forth6809.asm):02728         VALUEW:     LDD   #0
E06F 3606             (    forth6809.asm):02729                     PSHU  D
E071 BDDF5A           (    forth6809.asm):02730                     JSR   HEADER            ; not smudged - immediately findable
E074 CCDE94           (    forth6809.asm):02731                     LDD   #DODOES
E077 3606             (    forth6809.asm):02732                     PSHU  D
E079 BDEA85           (    forth6809.asm):02733                     JSR   CCALL
E07C CCE065           (    forth6809.asm):02734                     LDD   #DOVALUE
E07F 3606             (    forth6809.asm):02735                     PSHU  D
E081 BDDF08           (    forth6809.asm):02736                     JSR   CODECOMMA
E084 DC0A             (    forth6809.asm):02737                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E086 3606             (    forth6809.asm):02738                     PSHU  D                 ; See bugfix: VALUEW.1
E088 BDDF08           (    forth6809.asm):02739                     JSR   CODECOMMA
E08B BDDF1A           (    forth6809.asm):02740                     JSR   VCOMMAW           ; store x in the variable area
E08E 39               (    forth6809.asm):02741                     RTS
                      (    forth6809.asm):02742         
                      (    forth6809.asm):02743         ; ------------------------------------------------------------
                      (    forth6809.asm):02744         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02745         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02746         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02747         ; ------------------------------------------------------------
E08F CC0020           (    forth6809.asm):02748         TOW:        LDD   #32
E092 3606             (    forth6809.asm):02749                     PSHU  D
E094 BDE2C9           (    forth6809.asm):02750                     JSR   WORDW
E097 BDE335           (    forth6809.asm):02751                     JSR   FINDW
E09A 3706             (    forth6809.asm):02752                     PULU  D
E09C 10830000         (    forth6809.asm):02753                     CMPD  #0
E0A0 260A             (    forth6809.asm):02754                     BNE   TOFOUND
E0A2 3706             (    forth6809.asm):02755                     PULU  D
E0A4 CCFFF3           (    forth6809.asm):02756                     LDD   #-13
E0A7 3606             (    forth6809.asm):02757                     PSHU  D
E0A9 BDE60A           (    forth6809.asm):02758                     JSR   THROW
E0AC BDEB37           (    forth6809.asm):02759         TOFOUND:    JSR   TOBODYW
E0AF DC00             (    forth6809.asm):02760                     LDD   STATE
E0B1 270C             (    forth6809.asm):02761                     BEQ   TOIMMED
E0B3 BDEA92           (    forth6809.asm):02762                     JSR   LITERALW
E0B6 CCF3DA           (    forth6809.asm):02763                     LDD   #STOREW
E0B9 3606             (    forth6809.asm):02764                     PSHU  D
E0BB BDEA85           (    forth6809.asm):02765                     JSR   CCALL
E0BE 39               (    forth6809.asm):02766                     RTS
E0BF 3710             (    forth6809.asm):02767         TOIMMED:    PULU  X                 ; a-addr of the value cell
E0C1 3706             (    forth6809.asm):02768                     PULU  D                 ; x
E0C3 ED84             (    forth6809.asm):02769                     STD   ,X
E0C5 39               (    forth6809.asm):02770                     RTS
                      (    forth6809.asm):02771         
                      (    forth6809.asm):02772         ; ------------------------------------------------------------
                      (    forth6809.asm):02773         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02774         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02775         ; the variable area, initialised to zero.
                      (    forth6809.asm):02776         ; ------------------------------------------------------------
E0C6                  (    forth6809.asm):02777         TWOVARIABLEW:
E0C6 CC0000           (    forth6809.asm):02778                     LDD   #0

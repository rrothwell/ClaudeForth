                      (    forth6809.asm):16808         
                      (    forth6809.asm):16809         ; ------------------------------------------------------------
                      (    forth6809.asm):16810         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):16811         ; interrupt-driven or polling operation depending on SERIALPOLL.

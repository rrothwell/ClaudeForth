F4B5 58               (    forth6809.asm):06660                     ASLB
F4B6 58               (    forth6809.asm):06661                     ASLB
F4B7 3404             (    forth6809.asm):06662                     PSHS  B
F4B9 ABE0             (    forth6809.asm):06663                     ADDA  ,S+
F4BB 20CE             (    forth6809.asm):06664                     BRA   SQEPUT
                      (    forth6809.asm):06665         ; Hex digit at ,Y: value in A, carry clear; carry set if not a digit

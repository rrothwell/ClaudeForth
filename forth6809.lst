                      (    forth6809.asm):02261                     CMPB  OUTTAIL
                      (    forth6809.asm):02262                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02263         
                      (    forth6809.asm):02264                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02265                     LDB   OUTHEAD
                      (    forth6809.asm):02266                     STA   B,X
                      (    forth6809.asm):02267         
                      (    forth6809.asm):02268                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02269                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02270                     STB   OUTHEAD
                      (    forth6809.asm):02271         
                      (    forth6809.asm):02272                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?

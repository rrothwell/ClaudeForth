                      (    forth6809.asm):02966         ; ============================================================
                      (    forth6809.asm):02967         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02968         ; ============================================================
                      (    forth6809.asm):02969         ; ------------------------------------------------------------
                      (    forth6809.asm):02970         ; INTERPRET  ( -- )
                      (    forth6809.asm):02971         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02972         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02973         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02974         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02975         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02976         ; ------------------------------------------------------------
E220                  (    forth6809.asm):02977         INTERPRET:
E220 CC0020           (    forth6809.asm):02978         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
E223 3606             (    forth6809.asm):02979                     PSHU  D                 ; char
E225 BDE2A0           (    forth6809.asm):02980                     JSR   WORDW
E228 AEC4             (    forth6809.asm):02981                     LDX   ,U
E22A A684             (    forth6809.asm):02982                     LDA   ,X
E22C 276F             (    forth6809.asm):02983                     BEQ   IDONE
                      (    forth6809.asm):02984         
E22E BDE312           (    forth6809.asm):02985                     JSR   FINDW
E231 3706             (    forth6809.asm):02986                     PULU  D
E233 5D               (    forth6809.asm):02987                     TSTB
E234 10270011         (    forth6809.asm):02988                     LBEQ  TRYNUM
                      (    forth6809.asm):02989         

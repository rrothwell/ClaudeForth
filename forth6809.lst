                      (    forth6809.asm):02187         ; TSTSLMODZ - unit test for SLASHMOD, divide-by-zero case. n2 = 0.
                      (    forth6809.asm):02188         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02189         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02190         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02191         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02192         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02193         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02194         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02195         ; there are.
                      (    forth6809.asm):02196         ; ------------------------------------------------------------

                      (    forth6809.asm):17738                                  ; testing CLR's result, not n1's actual sign.
                      (    forth6809.asm):17739                                  ; BPL always branched, meaning n1 was NEVER
                      (    forth6809.asm):17740                                  ; negated even when genuinely negative - found
                      (    forth6809.asm):17741                                  ; via MAME: TSTMSTAR's two returned values
                      (    forth6809.asm):17742                                  ; came back wrong, which turned out to be
                      (    forth6809.asm):17743                                  ; this, not a push-order swap in the test
                      (    forth6809.asm):17744                                  ; itself. FMSLASHMOD/SMSLASHREM already do
                      (    forth6809.asm):17745                                  ; this correctly (explicit TST PRODHI between
                      (    forth6809.asm):17746                                  ; their own CLR calls and the branch) - MSTAR

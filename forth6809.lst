                      (    forth6809.asm):06163         ; 2!  ( x1 x2 a-addr -- )
                      (    forth6809.asm):06164         ; Store the cell pair: x2 at a-addr and x1 at a-addr+2.
                      (    forth6809.asm):06165         ; ------------------------------------------------------------
F350 3710             (    forth6809.asm):06166         TWOSTOREW:  PULU  X                 ; a-addr
F352 3706             (    forth6809.asm):06167                     PULU  D                 ; x2
F354 ED84             (    forth6809.asm):06168                     STD   ,X

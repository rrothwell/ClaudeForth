                      (    forth6809.asm):10228         ; TSTPOSTPONE1 - unit test for POSTPONE, normal (non-immediate)
                      (    forth6809.asm):10229         ; word case. Traced its own code first: for a normal word,
                      (    forth6809.asm):10230         ; POSTPONE compiles "[LIT xt][JSR COMPILE,]" into the current
                      (    forth6809.asm):10231         ; definition - NOT a direct call to the word itself. This is
                      (    forth6809.asm):10232         ; standard ANS semantics (POSTPONE appends a word's own
                      (    forth6809.asm):10233         ; compilation semantics to the current definition; for an
                      (    forth6809.asm):10234         ; ordinary word, that semantics IS "compile a call to it", so
                      (    forth6809.asm):10235         ; the current definition, when it later runs, must itself
                      (    forth6809.asm):10236         ; perform that compiling action against whatever definition is
                      (    forth6809.asm):10237         ; being compiled at that later point - not immediately). Given
                      (    forth6809.asm):10238         ; the genuine complexity of fully executing that second level
                      (    forth6809.asm):10239         ; (which would need a further redirected CODEHERE and a further
                      (    forth6809.asm):10240         ; round of execute-and-verify), this test instead verifies the
                      (    forth6809.asm):10241         ; compiled byte sequence directly - still a meaningful,
                      (    forth6809.asm):10242         ; unambiguous check of POSTPONE's own documented mechanism.
                      (    forth6809.asm):10243         ; ------------------------------------------------------------
C27B                  (    forth6809.asm):10244         TSTPOSTPONE1: LDD  CODEHERE
                      (    forth6809.asm):10245                       STD  TSTCSAV
                      (    forth6809.asm):10246                       LDD  LATEST
                      (    forth6809.asm):10247                       STD  TSTLSAV
                      (    forth6809.asm):10248                       LDD  SRCADDR
                      (    forth6809.asm):10249                       STD  TSTSASAV
                      (    forth6809.asm):10250                       LDD  SRCLEN
                      (    forth6809.asm):10251                       STD  TSTSLSAV
                      (    forth6809.asm):10252                       LDD  TOIN
                      (    forth6809.asm):10253                       STD  TSTTISAV
                      (    forth6809.asm):10254                       LDD  STATE
                      (    forth6809.asm):10255                       STD  TSTSTSAV
                      (    forth6809.asm):10256         
                      (    forth6809.asm):10257                       LDA  #3
                      (    forth6809.asm):10258                       STA  TSTFHDR
                      (    forth6809.asm):10259                       LDA  #'F'
                      (    forth6809.asm):10260                       STA  TSTFHDR+1
                      (    forth6809.asm):10261                       LDA  #'O'
                      (    forth6809.asm):10262                       STA  TSTFHDR+2
                      (    forth6809.asm):10263                       LDA  #'O'
                      (    forth6809.asm):10264                       STA  TSTFHDR+3
                      (    forth6809.asm):10265                       LDD  #0
                      (    forth6809.asm):10266                       STD  TSTFHDR+4
                      (    forth6809.asm):10267                       LDD  #DUP
                      (    forth6809.asm):10268                       STD  TSTFHDR+6
                      (    forth6809.asm):10269         

                      (    forth6809.asm):01971                     ; See shadow: INCHAR.1
DD7D F00177           (    forth6809.asm):01972                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
DD80 C43F             (    forth6809.asm):01973                     ANDB  #INBUFSZ-1

E5A4 A684             (    forth6809.asm):03044                  LDA   ,X
E5A6 2777             (    forth6809.asm):03045                  BEQ   NQBAD
E5A8 9721             (    forth6809.asm):03046                  STA   CNTREM
E5AA 3001             (    forth6809.asm):03047                  LEAX  1,X
                      (    forth6809.asm):03048         
                      (    forth6809.asm):03049                  ; NEW: ANS double-number input convention (forth-standard.org/
                      (    forth6809.asm):03050                  ; standard/usage#usage:numbers, 3.4.1.3) - a number immediately
                      (    forth6809.asm):03051                  ; followed by a decimal point converts to a double-cell number
                      (    forth6809.asm):03052                  ; instead of single-cell ("1234" -> 1234; "1234." -> 1234 0).
                      (    forth6809.asm):03053                  ; Detected here to exclude the trailing '.' from CNTREM before
                      (    forth6809.asm):03054                  ; NUMLOOP runs, so it isn't mistaken for a digit. The decision
                      (    forth6809.asm):03055                  ; itself is re-derived independently at the end of this routine
                      (    forth6809.asm):03056                  ; (from CADDR and the original count, both still unchanged at
                      (    forth6809.asm):03057                  ; that point - confirmed nothing else in this routine, including
                      (    forth6809.asm):03058                  ; NUMLOOP/UDMULADD, ever touches CADDR) rather than remembered
                      (    forth6809.asm):03059                  ; in a new persistent flag here - GLOBALS is fully packed at
                      (    forth6809.asm):03060                  ; 256/256 bytes, and this avoids needing to carve out a byte
                      (    forth6809.asm):03061                  ; for it.
E5AC D621             (    forth6809.asm):03062                  LDB   CNTREM
E5AE 5A               (    forth6809.asm):03063                  DECB
E5AF A685             (    forth6809.asm):03064                  LDA   B,X
E5B1 812E             (    forth6809.asm):03065                  CMPA  #'.'
E5B3 2604             (    forth6809.asm):03066                  BNE   NQNOSIGN
E5B5 0A21             (    forth6809.asm):03067                  DEC   CNTREM
E5B7 2766             (    forth6809.asm):03068                  BEQ   NQBAD          ; lone "." with nothing before it
                      (    forth6809.asm):03069         
E5B9 0F22             (    forth6809.asm):03070         NQNOSIGN: CLR   NUMNEG
E5BB A684             (    forth6809.asm):03071                  LDA   ,X
E5BD 812D             (    forth6809.asm):03072                  CMPA  #'-'
E5BF 2608             (    forth6809.asm):03073                  BNE   NQNOSIGN2
E5C1 0322             (    forth6809.asm):03074                  COM   NUMNEG
E5C3 3001             (    forth6809.asm):03075                  LEAX  1,X
E5C5 0A21             (    forth6809.asm):03076                  DEC   CNTREM
E5C7 2756             (    forth6809.asm):03077                  BEQ   NQBAD
                      (    forth6809.asm):03078         
E5C9 9F23             (    forth6809.asm):03079         NQNOSIGN2: STX  NADDR
E5CB 4F               (    forth6809.asm):03080                   CLRA
E5CC D621             (    forth6809.asm):03081                   LDB   CNTREM
E5CE DD25             (    forth6809.asm):03082                   STD   NCNT
E5D0 CC0000           (    forth6809.asm):03083                   LDD   #0
E5D3 DD74             (    forth6809.asm):03084                   STD   UDHI
E5D5 DD76             (    forth6809.asm):03085                   STD   UDLO
                      (    forth6809.asm):03086         
E5D7 BDE543           (    forth6809.asm):03087                   JSR   NUMLOOP
                      (    forth6809.asm):03088         
E5DA DC25             (    forth6809.asm):03089                   LDD   NCNT
E5DC 2641             (    forth6809.asm):03090                   BNE   NQBAD
                      (    forth6809.asm):03091         
                      (    forth6809.asm):03092                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03093                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03094                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03095                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03096                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03097                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03098                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03099                   ; high cell.
E5DE 0D22             (    forth6809.asm):03100                   TST   NUMNEG
E5E0 2718             (    forth6809.asm):03101                   BEQ   NQPOS32
E5E2 DC76             (    forth6809.asm):03102                   LDD   UDLO
E5E4 43               (    forth6809.asm):03103                   COMA
E5E5 53               (    forth6809.asm):03104                   COMB
E5E6 C30001           (    forth6809.asm):03105                   ADDD  #1
E5E9 DD76             (    forth6809.asm):03106                   STD   UDLO
E5EB 3401             (    forth6809.asm):03107                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03108                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03109                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03110                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03111                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03112                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03113                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03114                                      ; making the high-cell increment run
                      (    forth6809.asm):03115                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03116                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03117                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03118                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03119                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03120                                      ; matching "always increment" rather than
                      (    forth6809.asm):03121                                      ; "increment only on genuine carry".
E5ED DC74             (    forth6809.asm):03122                   LDD   UDHI
E5EF 43               (    forth6809.asm):03123                   COMA
E5F0 53               (    forth6809.asm):03124                   COMB
E5F1 3501             (    forth6809.asm):03125                   PULS  CC          ; restore the TRUE carry
E5F3 2403             (    forth6809.asm):03126                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03127                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03128                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03129                                      ; value was computed in D but never
                      (    forth6809.asm):03130                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03131                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03132                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03133                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03134                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03135                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03136                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03137                                      ; alone would have made this second,
                      (    forth6809.asm):03138                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03139                                      ; only past the "+1", never past the
                      (    forth6809.asm):03140                                      ; store itself - the store always runs,
                      (    forth6809.asm):03141                                      ; either way.
E5F5 C30001           (    forth6809.asm):03142                   ADDD  #1
E5F8 DD74             (    forth6809.asm):03143         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03144         
E5FA                  (    forth6809.asm):03145         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03146                   ; was '.' - determines which return convention to use
E5FA 9E1F             (    forth6809.asm):03147                   LDX   CADDR
E5FC E684             (    forth6809.asm):03148                   LDB   ,X
E5FE 5A               (    forth6809.asm):03149                   DECB
E5FF 3001             (    forth6809.asm):03150                   LEAX  1,X
E601 A685             (    forth6809.asm):03151                   LDA   B,X
E603 812E             (    forth6809.asm):03152                   CMPA  #'.'
E605 260E             (    forth6809.asm):03153                   BNE   NQSINGLE
                      (    forth6809.asm):03154         
                      (    forth6809.asm):03155                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03156                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03157                   ; apart without needing a separate flag of its own either
E607 DC76             (    forth6809.asm):03158                   LDD   UDLO
E609 3606             (    forth6809.asm):03159                   PSHU  D
E60B DC74             (    forth6809.asm):03160                   LDD   UDHI

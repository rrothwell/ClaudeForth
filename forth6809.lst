                      (    forth6809.asm):09073         ; TSTISOF - unit test for IS and ACTION-OF together. Compiles
                      (    forth6809.asm):09074         ; "DEFER TESTWD", interprets "DUP IS TESTWD" directly (IS parses
                      (    forth6809.asm):09075         ; "TESTWD" via WORD+FIND, needing LATEST still pointed at it -
                      (    forth6809.asm):09076         ; not restored until this whole test finishes), executes TESTWD
                      (    forth6809.asm):09077         ; (should now behave like DUP), then interprets "ACTION-OF
                      (    forth6809.asm):09078         ; TESTWD" to fetch the current target by name and confirms it
                      (    forth6809.asm):09079         ; matches DUP's own xt. Explicitly forces STATE=0 before both IS
                      (    forth6809.asm):09080         ; and ACTION-OF, since both are documented to behave differently
                      (    forth6809.asm):09081         ; by STATE, same reasoning as TSTVALTO's own TO test.
                      (    forth6809.asm):09082         ; ------------------------------------------------------------
C252                  (    forth6809.asm):09083         TSTISOF: LDD   CODEHERE
                      (    forth6809.asm):09084                  STD   TSTCSAV
                      (    forth6809.asm):09085                  LDD   DPHERE
                      (    forth6809.asm):09086                  STD   TSTDSAV
                      (    forth6809.asm):09087                  LDD   VARHERE
                      (    forth6809.asm):09088                  STD   TSTVSAV
                      (    forth6809.asm):09089                  LDD   SRCADDR
                      (    forth6809.asm):09090                  STD   TSTSASAV
                      (    forth6809.asm):09091                  LDD   SRCLEN
                      (    forth6809.asm):09092                  STD   TSTSLSAV
                      (    forth6809.asm):09093                  LDD   TOIN
                      (    forth6809.asm):09094                  STD   TSTTISAV
                      (    forth6809.asm):09095                  LDD   STATE
                      (    forth6809.asm):09096                  STD   TSTSTSAV
                      (    forth6809.asm):09097                  LDD   LATEST
                      (    forth6809.asm):09098                  STD   TSTLSAV
                      (    forth6809.asm):09099         
                      (    forth6809.asm):09100                  LDA   #'T'
                      (    forth6809.asm):09101                  STA   TSTNAMEB
                      (    forth6809.asm):09102                  LDA   #'E'
                      (    forth6809.asm):09103                  STA   TSTNAMEB+1
                      (    forth6809.asm):09104                  LDA   #'S'
                      (    forth6809.asm):09105                  STA   TSTNAMEB+2
                      (    forth6809.asm):09106                  LDA   #'T'
                      (    forth6809.asm):09107                  STA   TSTNAMEB+3
                      (    forth6809.asm):09108                  LDA   #'W'
                      (    forth6809.asm):09109                  STA   TSTNAMEB+4
                      (    forth6809.asm):09110                  LDA   #'D'
                      (    forth6809.asm):09111                  STA   TSTNAMEB+5
                      (    forth6809.asm):09112         
                      (    forth6809.asm):09113                  LDD   #TSTCBUF
                      (    forth6809.asm):09114                  STD   CODEHERE
                      (    forth6809.asm):09115                  LDD   #TSTDBUF
                      (    forth6809.asm):09116                  STD   DPHERE
                      (    forth6809.asm):09117                  LDD   #TSTVBUF
                      (    forth6809.asm):09118                  STD   VARHERE
                      (    forth6809.asm):09119                  LDD   #TSTNAMEB
                      (    forth6809.asm):09120                  STD   SRCADDR
                      (    forth6809.asm):09121                  LDD   #6
                      (    forth6809.asm):09122                  STD   SRCLEN
                      (    forth6809.asm):09123                  LDD   #0
                      (    forth6809.asm):09124                  STD   TOIN
                      (    forth6809.asm):09125         
                      (    forth6809.asm):09126                  LDD   CODEHERE
                      (    forth6809.asm):09127                  STD   TSTWCFA
                      (    forth6809.asm):09128         
                      (    forth6809.asm):09129                  JSR   DEFERW
                      (    forth6809.asm):09130         
                      (    forth6809.asm):09131                  LDD   TSTCSAV
                      (    forth6809.asm):09132                  STD   CODEHERE
                      (    forth6809.asm):09133         
                      (    forth6809.asm):09134                  LDA   #'T'
                      (    forth6809.asm):09135                  STA   TSTNAMEB
                      (    forth6809.asm):09136                  LDA   #'E'
                      (    forth6809.asm):09137                  STA   TSTNAMEB+1
                      (    forth6809.asm):09138                  LDA   #'S'
                      (    forth6809.asm):09139                  STA   TSTNAMEB+2
                      (    forth6809.asm):09140                  LDA   #'T'
                      (    forth6809.asm):09141                  STA   TSTNAMEB+3
                      (    forth6809.asm):09142                  LDA   #'W'
                      (    forth6809.asm):09143                  STA   TSTNAMEB+4
                      (    forth6809.asm):09144                  LDA   #'D'
                      (    forth6809.asm):09145                  STA   TSTNAMEB+5
                      (    forth6809.asm):09146                  LDD   #TSTNAMEB
                      (    forth6809.asm):09147                  STD   SRCADDR
                      (    forth6809.asm):09148                  LDD   #6
                      (    forth6809.asm):09149                  STD   SRCLEN
                      (    forth6809.asm):09150                  LDD   #0
                      (    forth6809.asm):09151                  STD   TOIN
                      (    forth6809.asm):09152                  LDD   #0
                      (    forth6809.asm):09153                  STD   STATE
                      (    forth6809.asm):09154         
                      (    forth6809.asm):09155                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):09156                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):09157                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):09158                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09159                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09160                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09161                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09162                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09163                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09164                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09165                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09166                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09167                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09168                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):09169                  STD   CODEHERE
                      (    forth6809.asm):09170         
                      (    forth6809.asm):09171                  LDD   #DUP
                      (    forth6809.asm):09172                  PSHU  D
                      (    forth6809.asm):09173                  JSR   ISW
                      (    forth6809.asm):09174         
                      (    forth6809.asm):09175                  STU   TSTU0
                      (    forth6809.asm):09176         
                      (    forth6809.asm):09177                  LDD   #TSTGUARD
                      (    forth6809.asm):09178                  PSHU  D
                      (    forth6809.asm):09179                  LDD   #TSTVAL1
                      (    forth6809.asm):09180                  PSHU  D
                      (    forth6809.asm):09181                  STU   TSTUB4
                      (    forth6809.asm):09182         
                      (    forth6809.asm):09183                  LDX   TSTWCFA
                      (    forth6809.asm):09184                  JSR   ,X
                      (    forth6809.asm):09185         
                      (    forth6809.asm):09186                  STU   TSTUAF
                      (    forth6809.asm):09187         
                      (    forth6809.asm):09188                  PULU  D
                      (    forth6809.asm):09189                  CMPD  #TSTVAL1
                      (    forth6809.asm):09190                  LBNE   ISFAIL  ; was BNE - out of short-branch range, since
                      (    forth6809.asm):09191                                 ; ISFAIL sits past this test's entire second
                      (    forth6809.asm):09192                                 ; phase (the ACTION-OF lookup and re-check)
                      (    forth6809.asm):09193                  PULU  D
                      (    forth6809.asm):09194                  CMPD  #TSTVAL1
                      (    forth6809.asm):09195                  BNE   ISFAIL
                      (    forth6809.asm):09196                  PULU  D
                      (    forth6809.asm):09197                  CMPD  #TSTGUARD
                      (    forth6809.asm):09198                  BNE   ISFAIL
                      (    forth6809.asm):09199         
                      (    forth6809.asm):09200                  LDD   TSTUB4
                      (    forth6809.asm):09201                  SUBD  TSTUAF
                      (    forth6809.asm):09202                  CMPD  #2
                      (    forth6809.asm):09203                  BNE   ISFAIL
                      (    forth6809.asm):09204         
                      (    forth6809.asm):09205                  LDA   #'T'
                      (    forth6809.asm):09206                  STA   TSTNAMEB
                      (    forth6809.asm):09207                  LDA   #'E'
                      (    forth6809.asm):09208                  STA   TSTNAMEB+1
                      (    forth6809.asm):09209                  LDA   #'S'
                      (    forth6809.asm):09210                  STA   TSTNAMEB+2
                      (    forth6809.asm):09211                  LDA   #'T'
                      (    forth6809.asm):09212                  STA   TSTNAMEB+3
                      (    forth6809.asm):09213                  LDA   #'W'
                      (    forth6809.asm):09214                  STA   TSTNAMEB+4
                      (    forth6809.asm):09215                  LDA   #'D'
                      (    forth6809.asm):09216                  STA   TSTNAMEB+5
                      (    forth6809.asm):09217                  LDD   #TSTNAMEB
                      (    forth6809.asm):09218                  STD   SRCADDR

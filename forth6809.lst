                      (    forth6809.asm):08796                   SUBD TSTUAF
                      (    forth6809.asm):08797                   CMPD #2
                      (    forth6809.asm):08798                   LBNE  VTFAIL  ; was BNE - same reason
                      (    forth6809.asm):08799         
                      (    forth6809.asm):08800                   LDD  #TSTCBUF2  ; BUG FIX: was TSTCBUF - WORD writes its
                      (    forth6809.asm):08801                                    ; parsed-token output directly at CODEHERE
                      (    forth6809.asm):08802                                    ; (see TSTCBUF2's own comment), which would
                      (    forth6809.asm):08803                                    ; silently overwrite TESTWD's own already-
                      (    forth6809.asm):08804                                    ; compiled trampoline still sitting at
                      (    forth6809.asm):08805                                    ; TSTCBUF, corrupting the CFA TSTWCFA points
                      (    forth6809.asm):08806                                    ; to before this test's second execution.

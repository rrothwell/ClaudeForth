                      (    forth6809.asm):03843         ; WHILE  ( C: dest -- orig dest )
                      (    forth6809.asm):03844         ; Compile ZBRANCH with a placeholder operand. Leave orig (its operand
                      (    forth6809.asm):03845         ; address) and TAGFWD on top of the BEGIN frame.
                      (    forth6809.asm):03846         ; ------------------------------------------------------------
E75F CCDF70           (    forth6809.asm):03847         WHILEW:     LDD   #ZBRANCH
E762 3606             (    forth6809.asm):03848                     PSHU  D
E764 BDEAB7           (    forth6809.asm):03849                     JSR   CCALL
E767 CC0000           (    forth6809.asm):03850                     LDD   #0
E76A 3606             (    forth6809.asm):03851                     PSHU  D
E76C BDE002           (    forth6809.asm):03852                     JSR   CODECOMMA
E76F DC08             (    forth6809.asm):03853                     LDD   CODEHERE
E771 830002           (    forth6809.asm):03854                     SUBD  #2
E774 3606             (    forth6809.asm):03855                     PSHU  D                 ; orig
E776 CC0001           (    forth6809.asm):03856                     LDD   #TAGFWD
E779 3606             (    forth6809.asm):03857                     PSHU  D
E77B 39               (    forth6809.asm):03858                     RTS
                      (    forth6809.asm):03859         
                      (    forth6809.asm):03860         ; ------------------------------------------------------------
                      (    forth6809.asm):03861         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):03862         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):03863         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):03864         ; frames is found by scanning, and removed from beneath them.
                      (    forth6809.asm):03865         ; ------------------------------------------------------------
E77C 3706             (    forth6809.asm):03866         REPEATW:    PULU  D
E77E 10830001         (    forth6809.asm):03867                     CMPD  #TAGFWD
E782 2703             (    forth6809.asm):03868                     BEQ   RPOK1
E784 BDE60D           (    forth6809.asm):03869                     JSR   CFERR
E787 3710             (    forth6809.asm):03870         RPOK1:      PULU  X                 ; orig
E789 9F3B             (    forth6809.asm):03871                     STX   NEWFLD            ; save orig
                      (    forth6809.asm):03872         
                      (    forth6809.asm):03873                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):03874                     ; See bugfix: REPEATW.1
E78B 3040             (    forth6809.asm):03875                     LEAX  0,U               ; scan from top of control stack
E78D 9F2B             (    forth6809.asm):03876                     STX   MSCR2             ; MSCR2 = base of scan region
E78F 9F2F             (    forth6809.asm):03877                     STX   MSCR4             ; MSCR4 = scan pointer
E791 DC2F             (    forth6809.asm):03878         RPSCAN:     LDD   MSCR4
E793 10933D           (    forth6809.asm):03879                     CMPD  CSP
E796 2603             (    forth6809.asm):03880                     BNE   RPSCANOK
E798 BDE60D           (    forth6809.asm):03881                     JSR   CFERR             ; no matching BEGIN
E79B 9E2F             (    forth6809.asm):03882         RPSCANOK:   LDX   MSCR4
E79D EC84             (    forth6809.asm):03883                     LDD   ,X
E79F 10830002         (    forth6809.asm):03884                     CMPD  #TAGBACK
E7A3 2712             (    forth6809.asm):03885                     BEQ   RPFOUND
E7A5 10830001         (    forth6809.asm):03886                     CMPD  #TAGFWD
E7A9 2703             (    forth6809.asm):03887                     BEQ   RPSKIP
E7AB BDE60D           (    forth6809.asm):03888                     JSR   CFERR             ; anything else is a genuine mismatch
E7AE DC2F             (    forth6809.asm):03889         RPSKIP:     LDD   MSCR4
E7B0 C30004           (    forth6809.asm):03890                     ADDD  #4
E7B3 DD2F             (    forth6809.asm):03891                     STD   MSCR4
E7B5 20DA             (    forth6809.asm):03892                     BRA   RPSCAN
E7B7 9E2F             (    forth6809.asm):03893         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
E7B9 EC02             (    forth6809.asm):03894                     LDD   2,X               ; dest = BEGIN's address
E7BB DD39             (    forth6809.asm):03895                     STD   PFIELD            ; kept in PFIELD
                      (    forth6809.asm):03896         
                      (    forth6809.asm):03897                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):03898                     ; bytes, highest word first.
E7BD DC2F             (    forth6809.asm):03899                     LDD   MSCR4
E7BF 932B             (    forth6809.asm):03900                     SUBD  MSCR2
E7C1 DD2D             (    forth6809.asm):03901                     STD   MSCR3             ; MSCR3 = bytes to shift
E7C3 2715             (    forth6809.asm):03902                     BEQ   RPSHIFTDONE
E7C5 DC2D             (    forth6809.asm):03903         RPSHIFT:    LDD   MSCR3
E7C7 830002           (    forth6809.asm):03904                     SUBD  #2
E7CA DD2D             (    forth6809.asm):03905                     STD   MSCR3
E7CC 9E2B             (    forth6809.asm):03906                     LDX   MSCR2
E7CE 308B             (    forth6809.asm):03907                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E7D0 EC84             (    forth6809.asm):03908                     LDD   ,X
E7D2 3004             (    forth6809.asm):03909                     LEAX  4,X
E7D4 ED84             (    forth6809.asm):03910                     STD   ,X                ; copy one word 4 bytes higher
E7D6 DC2D             (    forth6809.asm):03911                     LDD   MSCR3
E7D8 26EB             (    forth6809.asm):03912                     BNE   RPSHIFT
E7DA                  (    forth6809.asm):03913         RPSHIFTDONE:
E7DA 9E2B             (    forth6809.asm):03914                     LDX   MSCR2
E7DC 3004             (    forth6809.asm):03915                     LEAX  4,X
E7DE 1F13             (    forth6809.asm):03916                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):03917         
E7E0 CCDF86           (    forth6809.asm):03918                     LDD   #BRANCH
E7E3 3606             (    forth6809.asm):03919                     PSHU  D
E7E5 BDEAB7           (    forth6809.asm):03920                     JSR   CCALL
E7E8 CC0000           (    forth6809.asm):03921                     LDD   #0
E7EB 3606             (    forth6809.asm):03922                     PSHU  D
E7ED BDE002           (    forth6809.asm):03923                     JSR   CODECOMMA
E7F0 DC08             (    forth6809.asm):03924                     LDD   CODEHERE
E7F2 830002           (    forth6809.asm):03925                     SUBD  #2
E7F5 DD2D             (    forth6809.asm):03926                     STD   MSCR3             ; MSCR3 = branch operand address
E7F7 DC39             (    forth6809.asm):03927                     LDD   PFIELD            ; target = BEGIN's address
E7F9 3606             (    forth6809.asm):03928                     PSHU  D
E7FB DC2D             (    forth6809.asm):03929                     LDD   MSCR3             ; location = the operand just compiled
E7FD 3606             (    forth6809.asm):03930                     PSHU  D
E7FF BDE677           (    forth6809.asm):03931                     JSR   PATCH
E802 DC08             (    forth6809.asm):03932                     LDD   CODEHERE
E804 3606             (    forth6809.asm):03933                     PSHU  D
E806 DC3B             (    forth6809.asm):03934                     LDD   NEWFLD
E808 3606             (    forth6809.asm):03935                     PSHU  D
E80A BDE677           (    forth6809.asm):03936                     JSR   PATCH
E80D 39               (    forth6809.asm):03937                     RTS

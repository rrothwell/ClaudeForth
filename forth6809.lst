DEEF 8615             (    forth6809.asm):16823                  LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):16824                  ENDC  ; <<<<<<<<<<
DEF1 B7C008           (    forth6809.asm):16825                  STA   ACIACR         ; was "STA ACIA" - same fix
DEF4 39               (    forth6809.asm):16826                  RTS
                      (    forth6809.asm):16827         

                      (   unit_tests.asm):10415         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (   unit_tests.asm):10416         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (   unit_tests.asm):10417         ; direct write (not through C!/C@ themselves), then confirms C!
                      (   unit_tests.asm):10418         ; genuinely only touches the single byte at the exact address
                      (   unit_tests.asm):10419         ; given - not the "other half" of a 2-byte cell in some assumed
                      (   unit_tests.asm):10420         ; sense - and that C@ genuinely zero-extends (not just returns
                      (   unit_tests.asm):10421         ; whatever was there).
                      (   unit_tests.asm):10422         ;
                      (   unit_tests.asm):10423         ; BUG FIX: this test's own expected value after C! was wrong,
                      (   unit_tests.asm):10424         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (   unit_tests.asm):10425         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (   unit_tests.asm):10426         ; the high byte of the word), but CSTOREW writes directly at
                      (   unit_tests.asm):10427         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (   unit_tests.asm):10428         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (   unit_tests.asm):10429         ; LDD on this big-endian 6809 reads the high byte of the word
                      (   unit_tests.asm):10430         ; from the lower address first, that's $34FF, not $FF34. The
                      (   unit_tests.asm):10431         ; single-byte write and the zero-extending fetch were both
                      (   unit_tests.asm):10432         ; already correct; only this test's own arithmetic about which
                      (   unit_tests.asm):10433         ; byte ends up where was wrong.
                      (   unit_tests.asm):10434         ; ------------------------------------------------------------
C29B                  (   unit_tests.asm):10435         TSTCFETCHSTORE: LDD  #$FFFF

                      (    forth6809.asm):06382         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06383         ; Parse up to the closing quote. When compiling, compile DOSTR
                      (    forth6809.asm):06384         ; followed by the counted string. When interpreting, copy the string
                      (    forth6809.asm):06385         ; to PAD and return its address and length.
                      (    forth6809.asm):06386         ; A 3-byte gap is reserved at CODEHERE while WORD parses, so that the

                      (    forth6809.asm):03953                    PSHU  D
                      (    forth6809.asm):03954                    LDD   #TSTVAL2
                      (    forth6809.asm):03955                    PSHU  D
                      (    forth6809.asm):03956                    STU   TSTUB4
                      (    forth6809.asm):03957         

                      (    forth6809.asm):07196         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):07197         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):07198         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):07199         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):07200         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):07201         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):07202         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):07203         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):07204         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):07205         ; M*/W
                      (    forth6809.asm):07206         ;    Inputs:
                      (    forth6809.asm):07207         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):07208         ;    Outputs:
                      (    forth6809.asm):07209         ;        d2 on the data stack
                      (    forth6809.asm):07210         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):07211         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):07212         ; ------------------------------------------------------------

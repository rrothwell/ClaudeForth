                      (    forth6809.asm):02141         
                      (    forth6809.asm):02142         ; ============================================================
                      (    forth6809.asm):02143         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02144         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02145         ; ============================================================
                      (    forth6809.asm):02146         ; ------------------------------------------------------------
                      (    forth6809.asm):02147         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02148         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02149         ; LIT   ( -- x )
                      (    forth6809.asm):02150         ;    Inputs:
                      (    forth6809.asm):02151         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02152         ;    Outputs:
                      (    forth6809.asm):02153         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02154         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02155         ; ------------------------------------------------------------
DF67 3510             (    forth6809.asm):02156         LIT:        PULS  X
DF69 EC81             (    forth6809.asm):02157                     LDD   ,X++
DF6B 3606             (    forth6809.asm):02158                     PSHU  D                 ; x
DF6D 3410             (    forth6809.asm):02159                     PSHS  X
DF6F 39               (    forth6809.asm):02160                     RTS
                      (    forth6809.asm):02161         
                      (    forth6809.asm):02162         ; ------------------------------------------------------------
                      (    forth6809.asm):02163         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02164         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02165         ; address.
                      (    forth6809.asm):02166         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        flag on the data stack
                      (    forth6809.asm):02169         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02170         ;    Outputs:
                      (    forth6809.asm):02171         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02172         ;        the offset
                      (    forth6809.asm):02173         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02174         ; ------------------------------------------------------------
DF70 3706             (    forth6809.asm):02175         ZBRANCH:    PULU  D                 ; flag
DF72 3510             (    forth6809.asm):02176                     PULS  X
DF74 10830000         (    forth6809.asm):02177                     CMPD  #0
DF78 2607             (    forth6809.asm):02178                     BNE   ZSKIP
DF7A EC84             (    forth6809.asm):02179                     LDD   ,X
DF7C 308B             (    forth6809.asm):02180                     LEAX  D,X
DF7E 3410             (    forth6809.asm):02181                     PSHS  X
DF80 39               (    forth6809.asm):02182                     RTS
DF81 3002             (    forth6809.asm):02183         ZSKIP:      LEAX  2,X
DF83 3410             (    forth6809.asm):02184                     PSHS  X
DF85 39               (    forth6809.asm):02185                     RTS
                      (    forth6809.asm):02186         
                      (    forth6809.asm):02187         ; ------------------------------------------------------------
                      (    forth6809.asm):02188         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02189         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02190         ; BRANCH
                      (    forth6809.asm):02191         ;    Inputs:
                      (    forth6809.asm):02192         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02193         ;    Outputs:
                      (    forth6809.asm):02194         ;        return address set to the branch target
                      (    forth6809.asm):02195         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02196         ; ------------------------------------------------------------
DF86 3510             (    forth6809.asm):02197         BRANCH:     PULS  X
DF88 EC84             (    forth6809.asm):02198                     LDD   ,X
DF8A 308B             (    forth6809.asm):02199                     LEAX  D,X
DF8C 3410             (    forth6809.asm):02200                     PSHS  X
DF8E 39               (    forth6809.asm):02201                     RTS
                      (    forth6809.asm):02202         
                      (    forth6809.asm):02203         ; ------------------------------------------------------------
                      (    forth6809.asm):02204         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02205         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02206         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02207         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02208         ;    Inputs:
                      (    forth6809.asm):02209         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02210         ;        trampoline
                      (    forth6809.asm):02211         ;    Outputs:
                      (    forth6809.asm):02212         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02213         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02214         ; ------------------------------------------------------------
DF8F 3510             (    forth6809.asm):02215         DODOES:     PULS  X
DF91 10AE81           (    forth6809.asm):02216                     LDY   ,X++
DF94 EC84             (    forth6809.asm):02217                     LDD   ,X
DF96 3606             (    forth6809.asm):02218                     PSHU  D                 ; pfa
DF98 6EA4             (    forth6809.asm):02219                     JMP   ,Y
                      (    forth6809.asm):02220         
                      (    forth6809.asm):02221         ; ------------------------------------------------------------
                      (    forth6809.asm):02222         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02223         ; field address on the stack.
                      (    forth6809.asm):02224         ; DOESRT0
                      (    forth6809.asm):02225         ;    Inputs:
                      (    forth6809.asm):02226         ;        none
                      (    forth6809.asm):02227         ;    Outputs:
                      (    forth6809.asm):02228         ;        none
                      (    forth6809.asm):02229         ;    Registers: none.
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
DF9A 39               (    forth6809.asm):02231         DOESRT0:    RTS
                      (    forth6809.asm):02232         
                      (    forth6809.asm):02233         ; ------------------------------------------------------------
                      (    forth6809.asm):02234         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02235         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02236         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02237         ; SETDOES
                      (    forth6809.asm):02238         ;    Inputs:
                      (    forth6809.asm):02239         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02240         ;        BEHAVIOR)
                      (    forth6809.asm):02241         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02242         ;        address
                      (    forth6809.asm):02243         ;    Outputs:
                      (    forth6809.asm):02244         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02245         ;        defining word's caller
                      (    forth6809.asm):02246         ;    Registers: RegD, RegX, RegY, CC and HDRFLAGS changed.
                      (    forth6809.asm):02247         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):02248         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
DF9D 1F12             (    forth6809.asm):02249                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02250         
DF9F 9E04             (    forth6809.asm):02251                     LDX   LATEST
DFA1 A684             (    forth6809.asm):02252                     LDA   ,X
DFA3 971E             (    forth6809.asm):02253                     STA   HDRFLAGS
DFA5 3001             (    forth6809.asm):02254                     LEAX  1,X
DFA7 D61E             (    forth6809.asm):02255                     LDB   HDRFLAGS
DFA9 C41F             (    forth6809.asm):02256                     ANDB  #$1F
DFAB 4F               (    forth6809.asm):02257                     CLRA
DFAC 308B             (    forth6809.asm):02258                     LEAX  D,X               ; skip name -> LINK field
DFAE 3002             (    forth6809.asm):02259                     LEAX  2,X               ; skip LINK -> CFA field
DFB0 EC84             (    forth6809.asm):02260                     LDD   ,X                ; D = CFA (trampoline address)
DFB2 C30003           (    forth6809.asm):02261                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
DFB5 1F01             (    forth6809.asm):02262                     TFR   D,X
                      (    forth6809.asm):02263         
DFB7 10AF84           (    forth6809.asm):02264                     STY   ,X                ; patch it
                      (    forth6809.asm):02265         
DFBA 3510             (    forth6809.asm):02266                     PULS  X                 ; X = the OUTER defining word's own return addr
DFBC 6E84             (    forth6809.asm):02267                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269         ; ------------------------------------------------------------
                      (    forth6809.asm):02270         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02271         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02272         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02273         ;    Inputs:
                      (    forth6809.asm):02274         ;        pfa on the data stack
                      (    forth6809.asm):02275         ;    Outputs:
                      (    forth6809.asm):02276         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02277         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02278         ; ------------------------------------------------------------
DFBE 3710             (    forth6809.asm):02279         DODEFER:    PULU  X                 ; pfa
DFC0 EC84             (    forth6809.asm):02280                     LDD   ,X
DFC2 1F01             (    forth6809.asm):02281                     TFR   D,X
DFC4 6E84             (    forth6809.asm):02282                     JMP   ,X
                      (    forth6809.asm):02283         
                      (    forth6809.asm):02284         ; ------------------------------------------------------------
                      (    forth6809.asm):02285         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02286         ; DOABORTUNDEF
                      (    forth6809.asm):02287         ;    Inputs:
                      (    forth6809.asm):02288         ;        none
                      (    forth6809.asm):02289         ;    Outputs:
                      (    forth6809.asm):02290         ;        none (does not return)
                      (    forth6809.asm):02291         ;    Registers: RegD changed.
                      (    forth6809.asm):02292         ; ------------------------------------------------------------
DFC6                  (    forth6809.asm):02293         DOABORTUNDEF:
DFC6 CCFFEB           (    forth6809.asm):02294                     LDD   #-21
DFC9 3606             (    forth6809.asm):02295                     PSHU  D                 ; throw code (-21)
DFCB 7EE646           (    forth6809.asm):02296                     JMP   THROWW
                      (    forth6809.asm):02297         
                      (    forth6809.asm):02298         ; ------------------------------------------------------------
                      (    forth6809.asm):02299         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02300         ; pointers and LATEST from the four cells saved when it was defined.
                      (    forth6809.asm):02301         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02302         ;    Inputs:
                      (    forth6809.asm):02303         ;        pfa on the data stack (the four saved cells)
                      (    forth6809.asm):02304         ;    Outputs:
                      (    forth6809.asm):02305         ;        pfa removed; DPHERE, CODEHERE, VARHERE and LATEST restored
                      (    forth6809.asm):02306         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02307         ; ------------------------------------------------------------
DFCE 3710             (    forth6809.asm):02308         DOMARKER:   PULU  X                 ; pfa
DFD0 EC84             (    forth6809.asm):02309                     LDD   ,X
DFD2 DD06             (    forth6809.asm):02310                     STD   DPHERE
DFD4 EC02             (    forth6809.asm):02311                     LDD   2,X
DFD6 DD08             (    forth6809.asm):02312                     STD   CODEHERE
DFD8 EC04             (    forth6809.asm):02313                     LDD   4,X
DFDA DD0A             (    forth6809.asm):02314                     STD   VARHERE
DFDC EC06             (    forth6809.asm):02315                     LDD   6,X
DFDE DD04             (    forth6809.asm):02316                     STD   LATEST
DFE0 39               (    forth6809.asm):02317                     RTS
                      (    forth6809.asm):02318         
                      (    forth6809.asm):02319         ; ------------------------------------------------------------
                      (    forth6809.asm):02320         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02321         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02322         ; ------------------------------------------------------------
DFE1 3710             (    forth6809.asm):02323         EXECUTEW:   PULU  X                 ; xt
DFE3 AD84             (    forth6809.asm):02324                     JSR   ,X
DFE5 39               (    forth6809.asm):02325                     RTS
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327         ; ============================================================
                      (    forth6809.asm):02328         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02329         ; ============================================================
                      (    forth6809.asm):02330         ; ------------------------------------------------------------
                      (    forth6809.asm):02331         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02332         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02333         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02334         ;    Inputs:
                      (    forth6809.asm):02335         ;        RegX = address of the here pointer
                      (    forth6809.asm):02336         ;        x on the data stack
                      (    forth6809.asm):02337         ;    Outputs:
                      (    forth6809.asm):02338         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02339         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02340         ; ------------------------------------------------------------
DFE6 3706             (    forth6809.asm):02341         APPENDCELL: PULU  D                 ; x
DFE8 10AE84           (    forth6809.asm):02342                     LDY   ,X
DFEB EDA1             (    forth6809.asm):02343                     STD   ,Y++
DFED 10AF84           (    forth6809.asm):02344                     STY   ,X
DFF0 39               (    forth6809.asm):02345                     RTS
                      (    forth6809.asm):02346         
                      (    forth6809.asm):02347         ; ------------------------------------------------------------
                      (    forth6809.asm):02348         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02349         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02350         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02351         ;    Inputs:
                      (    forth6809.asm):02352         ;        RegX = address of the here pointer
                      (    forth6809.asm):02353         ;        char on the data stack
                      (    forth6809.asm):02354         ;    Outputs:
                      (    forth6809.asm):02355         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02356         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02357         ; ------------------------------------------------------------
DFF1 3706             (    forth6809.asm):02358         APPENDBYTE: PULU  D                 ; char
DFF3 10AE84           (    forth6809.asm):02359                     LDY   ,X
DFF6 E7A0             (    forth6809.asm):02360                     STB   ,Y+
DFF8 10AF84           (    forth6809.asm):02361                     STY   ,X
DFFB 39               (    forth6809.asm):02362                     RTS
                      (    forth6809.asm):02363         
                      (    forth6809.asm):02364         ; ------------------------------------------------------------
                      (    forth6809.asm):02365         ; ,  ( x -- )
                      (    forth6809.asm):02366         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02367         ; ------------------------------------------------------------
DFFC 8E0008           (    forth6809.asm):02368         COMMAW:     LDX   #CODEHERE
DFFF 7EDFE6           (    forth6809.asm):02369                     JMP   APPENDCELL
                      (    forth6809.asm):02370         
                      (    forth6809.asm):02371         ; ------------------------------------------------------------
                      (    forth6809.asm):02372         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02373         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02374         ; ------------------------------------------------------------
E002 8E0008           (    forth6809.asm):02375         CODECOMMA:  LDX   #CODEHERE
E005 7EDFE6           (    forth6809.asm):02376                     JMP   APPENDCELL
                      (    forth6809.asm):02377         
                      (    forth6809.asm):02378         ; ------------------------------------------------------------
                      (    forth6809.asm):02379         ; C,  ( char -- )
                      (    forth6809.asm):02380         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02381         ; ------------------------------------------------------------
E008 8E0008           (    forth6809.asm):02382         CCOMMAW:    LDX   #CODEHERE
E00B 7EDFF1           (    forth6809.asm):02383                     JMP   APPENDBYTE
                      (    forth6809.asm):02384         
                      (    forth6809.asm):02385         ; ------------------------------------------------------------
                      (    forth6809.asm):02386         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02387         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02388         ; ------------------------------------------------------------
E00E 8E0008           (    forth6809.asm):02389         CCOMMA1:    LDX   #CODEHERE
E011 7EDFF1           (    forth6809.asm):02390                     JMP   APPENDBYTE
                      (    forth6809.asm):02391         
                      (    forth6809.asm):02392         ; ------------------------------------------------------------
                      (    forth6809.asm):02393         ; V,  ( x -- )
                      (    forth6809.asm):02394         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02395         ; ------------------------------------------------------------
E014 8E000A           (    forth6809.asm):02396         VCOMMAW:    LDX   #VARHERE
E017 7EDFE6           (    forth6809.asm):02397                     JMP   APPENDCELL
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399         ; ------------------------------------------------------------
                      (    forth6809.asm):02400         ; VC,  ( char -- )
                      (    forth6809.asm):02401         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02402         ; ------------------------------------------------------------
E01A 8E000A           (    forth6809.asm):02403         VCCOMMAW:   LDX   #VARHERE
E01D 7EDFF1           (    forth6809.asm):02404                     JMP   APPENDBYTE
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406         ; ------------------------------------------------------------
                      (    forth6809.asm):02407         ; ALLOT  ( n -- )
                      (    forth6809.asm):02408         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02409         ; ------------------------------------------------------------
E020 3706             (    forth6809.asm):02410         ALLOTW:     PULU  D                 ; n
E022 9E08             (    forth6809.asm):02411                     LDX   CODEHERE
E024 308B             (    forth6809.asm):02412                     LEAX  D,X
E026 9F08             (    forth6809.asm):02413                     STX   CODEHERE
E028 39               (    forth6809.asm):02414                     RTS
                      (    forth6809.asm):02415         
                      (    forth6809.asm):02416         ; ------------------------------------------------------------
                      (    forth6809.asm):02417         ; VALLOT  ( n -- )
                      (    forth6809.asm):02418         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02419         ; ------------------------------------------------------------
E029 3706             (    forth6809.asm):02420         VALLOTW:    PULU  D                 ; n
E02B 9E0A             (    forth6809.asm):02421                     LDX   VARHERE
E02D 308B             (    forth6809.asm):02422                     LEAX  D,X
E02F 9F0A             (    forth6809.asm):02423                     STX   VARHERE
E031 39               (    forth6809.asm):02424                     RTS
                      (    forth6809.asm):02425         
                      (    forth6809.asm):02426         ; ------------------------------------------------------------
                      (    forth6809.asm):02427         ; HERE  ( -- addr )
                      (    forth6809.asm):02428         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02429         ; ------------------------------------------------------------
E032 DC08             (    forth6809.asm):02430         HEREW:      LDD   CODEHERE
E034 3606             (    forth6809.asm):02431                     PSHU  D                 ; addr
E036 39               (    forth6809.asm):02432                     RTS
                      (    forth6809.asm):02433         
                      (    forth6809.asm):02434         ; ------------------------------------------------------------
                      (    forth6809.asm):02435         ; VHERE  ( -- addr )
                      (    forth6809.asm):02436         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02437         ; ------------------------------------------------------------
E037 DC0A             (    forth6809.asm):02438         VHEREW:     LDD   VARHERE
E039 3606             (    forth6809.asm):02439                     PSHU  D                 ; addr
E03B 39               (    forth6809.asm):02440                     RTS
                      (    forth6809.asm):02441         
                      (    forth6809.asm):02442         ; ------------------------------------------------------------
                      (    forth6809.asm):02443         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02444         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02445         ; ------------------------------------------------------------
E03C DC08             (    forth6809.asm):02446         PADW:       LDD   CODEHERE
E03E C30080           (    forth6809.asm):02447                     ADDD  #PADOFFSET
E041 3606             (    forth6809.asm):02448                     PSHU  D                 ; c-addr
E043 39               (    forth6809.asm):02449                     RTS
                      (    forth6809.asm):02450         
                      (    forth6809.asm):02451         ; ------------------------------------------------------------
                      (    forth6809.asm):02452         ; UNUSED  ( -- u )
                      (    forth6809.asm):02453         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02454         ; ------------------------------------------------------------
E044 CCB900           (    forth6809.asm):02455         UNUSEDW:    LDD   #CODETOP
E047 9308             (    forth6809.asm):02456                     SUBD  CODEHERE
E049 3606             (    forth6809.asm):02457                     PSHU  D                 ; u
E04B 39               (    forth6809.asm):02458                     RTS
                      (    forth6809.asm):02459         
                      (    forth6809.asm):02460         ; ------------------------------------------------------------
                      (    forth6809.asm):02461         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02462         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02463         ; ------------------------------------------------------------
E04C CC1FFF           (    forth6809.asm):02464         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
E04F 930A             (    forth6809.asm):02465                     SUBD  VARHERE
E051 3606             (    forth6809.asm):02466                     PSHU  D                 ; u
E053 39               (    forth6809.asm):02467                     RTS
                      (    forth6809.asm):02468         
                      (    forth6809.asm):02469         ; ============================================================
                      (    forth6809.asm):02470         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02471         ; ============================================================
                      (    forth6809.asm):02472         ; ------------------------------------------------------------
                      (    forth6809.asm):02473         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02474         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02475         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02476         ; field address (CODEHERE). LATEST and DPHERE are updated.
                      (    forth6809.asm):02477         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02478         ;    Inputs:
                      (    forth6809.asm):02479         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02480         ;        name parsed from the input stream
                      (    forth6809.asm):02481         ;    Outputs:
                      (    forth6809.asm):02482         ;        header built at DPHERE; LATEST and NEWHDR = address of the
                      (    forth6809.asm):02483         ;        new header
                      (    forth6809.asm):02484         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02485         ; ------------------------------------------------------------
E054 CC0020           (    forth6809.asm):02486         HEADER:     LDD   #32
E057 3606             (    forth6809.asm):02487                     PSHU  D
E059 BDE34F           (    forth6809.asm):02488                     JSR   WORDW
E05C 3710             (    forth6809.asm):02489                     PULU  X                 ; c-addr of the name
E05E A684             (    forth6809.asm):02490                     LDA   ,X
E060 973E             (    forth6809.asm):02491                     STA   NAMELEN
E062 3001             (    forth6809.asm):02492                     LEAX  1,X
E064 9F3C             (    forth6809.asm):02493                     STX   NAMEP
                      (    forth6809.asm):02494         
E066 3706             (    forth6809.asm):02495                     PULU  D                 ; smudge flag
E068 3404             (    forth6809.asm):02496                     PSHS  B
                      (    forth6809.asm):02497         
E06A DC06             (    forth6809.asm):02498                     LDD   DPHERE
E06C DD3A             (    forth6809.asm):02499                     STD   NEWHDR
E06E 9E06             (    forth6809.asm):02500                     LDX   DPHERE
E070 963E             (    forth6809.asm):02501                     LDA   NAMELEN
E072 6DE0             (    forth6809.asm):02502                     TST   ,S+               ; smudge flag
E074 2702             (    forth6809.asm):02503                     BEQ   HDNOSM
E076 8A40             (    forth6809.asm):02504                     ORA   #$40
E078 A780             (    forth6809.asm):02505         HDNOSM:     STA   ,X+
E07A 109E3C           (    forth6809.asm):02506                     LDY   NAMEP
E07D D63E             (    forth6809.asm):02507                     LDB   NAMELEN
E07F 2707             (    forth6809.asm):02508                     BEQ   HDNONM
E081 A6A0             (    forth6809.asm):02509         HDCPY:      LDA   ,Y+
E083 A780             (    forth6809.asm):02510                     STA   ,X+
E085 5A               (    forth6809.asm):02511                     DECB
E086 26F9             (    forth6809.asm):02512                     BNE   HDCPY
E088 DC04             (    forth6809.asm):02513         HDNONM:     LDD   LATEST
E08A ED81             (    forth6809.asm):02514                     STD   ,X++
E08C DC08             (    forth6809.asm):02515                     LDD   CODEHERE
E08E ED81             (    forth6809.asm):02516                     STD   ,X++
E090 9F06             (    forth6809.asm):02517                     STX   DPHERE
E092 DC3A             (    forth6809.asm):02518                     LDD   NEWHDR
E094 DD04             (    forth6809.asm):02519                     STD   LATEST
E096 39               (    forth6809.asm):02520                     RTS
                      (    forth6809.asm):02521         
                      (    forth6809.asm):02522         ; ============================================================
                      (    forth6809.asm):02523         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02524         ; ============================================================
                      (    forth6809.asm):02525         ; ------------------------------------------------------------
                      (    forth6809.asm):02526         ; :  ( "name" -- )
                      (    forth6809.asm):02527         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02528         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02529         ; CSP and enter compile state.
                      (    forth6809.asm):02530         ; ------------------------------------------------------------
E097 CCFFFF           (    forth6809.asm):02531         COLONW:     LDD   #TRUEV
E09A 3606             (    forth6809.asm):02532                     PSHU  D
E09C BDE054           (    forth6809.asm):02533                     JSR   HEADER
E09F DC08             (    forth6809.asm):02534                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
E0A1 DD3A             (    forth6809.asm):02535                     STD   CURXT             ; See bugfix: COLONW.1
E0A3 1F30             (    forth6809.asm):02536                     TFR   U,D
E0A5 DD43             (    forth6809.asm):02537                     STD   CSP
E0A7 CCFFFF           (    forth6809.asm):02538                     LDD   #-1
E0AA DD00             (    forth6809.asm):02539                     STD   STATE
E0AC 39               (    forth6809.asm):02540                     RTS
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
                      (    forth6809.asm):02543         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):02544         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):02545         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):02546         ; new word and return to interpret state.
                      (    forth6809.asm):02547         ; ------------------------------------------------------------
E0AD CC0039           (    forth6809.asm):02548         SEMIW:      LDD   #RTSOPC
E0B0 3606             (    forth6809.asm):02549                     PSHU  D
E0B2 BDE00E           (    forth6809.asm):02550                     JSR   CCOMMA1
E0B5 1F30             (    forth6809.asm):02551                     TFR   U,D
E0B7 109343           (    forth6809.asm):02552                     CMPD  CSP
E0BA 2703             (    forth6809.asm):02553                     BEQ   SEMIOK
E0BC BDE611           (    forth6809.asm):02554                     JSR   CFERR
E0BF 9E04             (    forth6809.asm):02555         SEMIOK:     LDX   LATEST
E0C1 A684             (    forth6809.asm):02556                     LDA   ,X
E0C3 84BF             (    forth6809.asm):02557                     ANDA  #$BF
E0C5 A784             (    forth6809.asm):02558                     STA   ,X
E0C7 CC0000           (    forth6809.asm):02559                     LDD   #0
E0CA DD00             (    forth6809.asm):02560                     STD   STATE
E0CC 39               (    forth6809.asm):02561                     RTS
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563         ; ------------------------------------------------------------
                      (    forth6809.asm):02564         ; :NONAME  ( -- xt )
                      (    forth6809.asm):02565         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):02566         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):02567         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):02568         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):02569         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):02570         ; ------------------------------------------------------------
E0CD DC08             (    forth6809.asm):02571         NONAMEW:    LDD   CODEHERE
E0CF 3606             (    forth6809.asm):02572                     PSHU  D                 ; xt
E0D1 DD3A             (    forth6809.asm):02573                     STD   CURXT             ; See bugfix: NONAMEW.1
E0D3 1F30             (    forth6809.asm):02574                     TFR   U,D
E0D5 DD43             (    forth6809.asm):02575                     STD   CSP
E0D7 CCFFFF           (    forth6809.asm):02576                     LDD   #-1
E0DA DD00             (    forth6809.asm):02577                     STD   STATE
E0DC 39               (    forth6809.asm):02578                     RTS
                      (    forth6809.asm):02579         
                      (    forth6809.asm):02580         ; ------------------------------------------------------------
                      (    forth6809.asm):02581         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):02582         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):02583         ; BLDDOES
                      (    forth6809.asm):02584         ;    Inputs:
                      (    forth6809.asm):02585         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02586         ;    Outputs:
                      (    forth6809.asm):02587         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):02588         ;    Registers: all changed.
                      (    forth6809.asm):02589         ; BLDSELF
                      (    forth6809.asm):02590         ;    Inputs:
                      (    forth6809.asm):02591         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):02592         ;    Outputs:
                      (    forth6809.asm):02593         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):02594         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):02595         ;    Registers: all changed.
                      (    forth6809.asm):02596         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):02597         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):02598         ; ------------------------------------------------------------
E0DD 3406             (    forth6809.asm):02599         BLDDOES:    PSHS  D                 ; behaviour address
E0DF CC0000           (    forth6809.asm):02600                     LDD   #0
E0E2 3606             (    forth6809.asm):02601                     PSHU  D
E0E4 BDE054           (    forth6809.asm):02602                     JSR   HEADER
E0E7 CCDF8F           (    forth6809.asm):02603                     LDD   #DODOES
E0EA 3606             (    forth6809.asm):02604                     PSHU  D
E0EC BDEABB           (    forth6809.asm):02605                     JSR   CCALL
E0EF 3506             (    forth6809.asm):02606                     PULS  D
E0F1 3606             (    forth6809.asm):02607                     PSHU  D                 ; behaviour address
E0F3 BDE002           (    forth6809.asm):02608                     JSR   CODECOMMA
E0F6 39               (    forth6809.asm):02609                     RTS
                      (    forth6809.asm):02610         
E0F7 BDE0DD           (    forth6809.asm):02611         BLDSELF:    JSR   BLDDOES
E0FA DC08             (    forth6809.asm):02612                     LDD   CODEHERE          ; PFA = the cell after this one
E0FC C30002           (    forth6809.asm):02613                     ADDD  #2                ; See bugfix: CONSTANTW.1
E0FF 3606             (    forth6809.asm):02614                     PSHU  D
E101 BDE002           (    forth6809.asm):02615                     JSR   CODECOMMA
E104 39               (    forth6809.asm):02616                     RTS
                      (    forth6809.asm):02617         
                      (    forth6809.asm):02618         ; ------------------------------------------------------------
                      (    forth6809.asm):02619         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02620         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02621         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02622         ; address in the code area, on the stack.
                      (    forth6809.asm):02623         ; ------------------------------------------------------------
E105 CCDF9A           (    forth6809.asm):02624         CREATEW:    LDD   #DOESRT0
E108 BDE0F7           (    forth6809.asm):02625                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E10B 39               (    forth6809.asm):02626                     RTS
                      (    forth6809.asm):02627         
                      (    forth6809.asm):02628         ; ------------------------------------------------------------
                      (    forth6809.asm):02629         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02630         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02631         ; of the word being defined.
                      (    forth6809.asm):02632         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02633         ; ------------------------------------------------------------
E10C CCDF9B           (    forth6809.asm):02634         DOESGTW:    LDD   #SETDOES
E10F 3606             (    forth6809.asm):02635                     PSHU  D
E111 BDEABB           (    forth6809.asm):02636                     JSR   CCALL
E114 39               (    forth6809.asm):02637                     RTS
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639         ; ------------------------------------------------------------
                      (    forth6809.asm):02640         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02641         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02642         ; area, initialised to zero.
                      (    forth6809.asm):02643         ; ------------------------------------------------------------
E115 CC0000           (    forth6809.asm):02644         VARIABLEW:  LDD   #0
E118 3606             (    forth6809.asm):02645                     PSHU  D
E11A BDE054           (    forth6809.asm):02646                     JSR   HEADER
E11D CCDF8F           (    forth6809.asm):02647                     LDD   #DODOES
E120 3606             (    forth6809.asm):02648                     PSHU  D
E122 BDEABB           (    forth6809.asm):02649                     JSR   CCALL
E125 CCDF9A           (    forth6809.asm):02650                     LDD   #DOESRT0
E128 3606             (    forth6809.asm):02651                     PSHU  D
E12A BDE002           (    forth6809.asm):02652                     JSR   CODECOMMA
E12D DC0A             (    forth6809.asm):02653                     LDD   VARHERE
E12F 3606             (    forth6809.asm):02654                     PSHU  D
E131 BDE002           (    forth6809.asm):02655                     JSR   CODECOMMA
E134 CC0000           (    forth6809.asm):02656                     LDD   #0
E137 9E0A             (    forth6809.asm):02657                     LDX   VARHERE
E139 ED81             (    forth6809.asm):02658                     STD   ,X++
E13B 9F0A             (    forth6809.asm):02659                     STX   VARHERE
E13D 39               (    forth6809.asm):02660                     RTS
                      (    forth6809.asm):02661         
                      (    forth6809.asm):02662         ; ------------------------------------------------------------
                      (    forth6809.asm):02663         ; @  ( a-addr -- x )
                      (    forth6809.asm):02664         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02665         ; ------------------------------------------------------------
E13E 3710             (    forth6809.asm):02666         FETCHW:     PULU  X                 ; a-addr
E140 EC84             (    forth6809.asm):02667                     LDD   ,X
E142 3606             (    forth6809.asm):02668                     PSHU  D                 ; x
E144 39               (    forth6809.asm):02669                     RTS
                      (    forth6809.asm):02670         
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
                      (    forth6809.asm):02672         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02673         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02674         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02675         ; ------------------------------------------------------------
E145 CCE13E           (    forth6809.asm):02676         CONSTANTW:  LDD   #FETCHW
E148 BDE0F7           (    forth6809.asm):02677                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E14B BDDFFC           (    forth6809.asm):02678                     JSR   COMMAW
E14E 39               (    forth6809.asm):02679                     RTS
                      (    forth6809.asm):02680         
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
                      (    forth6809.asm):02682         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02683         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02684         ;    Inputs:
                      (    forth6809.asm):02685         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02686         ;    Outputs:
                      (    forth6809.asm):02687         ;        pfa replaced by the value
                      (    forth6809.asm):02688         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02689         ; ------------------------------------------------------------
E14F 3710             (    forth6809.asm):02690         DOVALUE:    PULU  X                 ; pfa
E151 EC84             (    forth6809.asm):02691                     LDD   ,X
E153 3606             (    forth6809.asm):02692                     PSHU  D                 ; x
E155 39               (    forth6809.asm):02693                     RTS
                      (    forth6809.asm):02694         
                      (    forth6809.asm):02695         ; ------------------------------------------------------------
                      (    forth6809.asm):02696         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):02697         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):02698         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
E156 CCE14F           (    forth6809.asm):02700         VALUEW:     LDD   #DOVALUE
E159 BDE0DD           (    forth6809.asm):02701                     JSR   BLDDOES
E15C DC0A             (    forth6809.asm):02702                     LDD   VARHERE           ; PFA = VARHERE (writable space)
E15E 3606             (    forth6809.asm):02703                     PSHU  D                 ; See bugfix: VALUEW.1
E160 BDE002           (    forth6809.asm):02704                     JSR   CODECOMMA
E163 BDE014           (    forth6809.asm):02705                     JSR   VCOMMAW           ; store x in the variable area
E166 39               (    forth6809.asm):02706                     RTS
                      (    forth6809.asm):02707         
                      (    forth6809.asm):02708         ; ------------------------------------------------------------
                      (    forth6809.asm):02709         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):02710         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):02711         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):02712         ; ------------------------------------------------------------
E167 CC0020           (    forth6809.asm):02713         TOW:        LDD   #32
E16A 3606             (    forth6809.asm):02714                     PSHU  D
E16C BDE34F           (    forth6809.asm):02715                     JSR   WORDW
E16F BDE3BB           (    forth6809.asm):02716                     JSR   FINDW
E172 3706             (    forth6809.asm):02717                     PULU  D
E174 10830000         (    forth6809.asm):02718                     CMPD  #0
E178 260A             (    forth6809.asm):02719                     BNE   TOFOUND
E17A 3706             (    forth6809.asm):02720                     PULU  D
E17C CCFFF3           (    forth6809.asm):02721                     LDD   #-13
E17F 3606             (    forth6809.asm):02722                     PSHU  D
E181 BDE646           (    forth6809.asm):02723                     JSR   THROWW
E184 BDEB6D           (    forth6809.asm):02724         TOFOUND:    JSR   TOBODYW
E187 DC00             (    forth6809.asm):02725                     LDD   STATE
E189 270C             (    forth6809.asm):02726                     BEQ   TOIMMED
E18B BDEAC8           (    forth6809.asm):02727                     JSR   LITERALW
E18E CCF3FA           (    forth6809.asm):02728                     LDD   #STOREW
E191 3606             (    forth6809.asm):02729                     PSHU  D
E193 BDEABB           (    forth6809.asm):02730                     JSR   CCALL
E196 39               (    forth6809.asm):02731                     RTS
E197 3710             (    forth6809.asm):02732         TOIMMED:    PULU  X                 ; a-addr of the value cell
E199 3706             (    forth6809.asm):02733                     PULU  D                 ; x
E19B ED84             (    forth6809.asm):02734                     STD   ,X
E19D 39               (    forth6809.asm):02735                     RTS
                      (    forth6809.asm):02736         
                      (    forth6809.asm):02737         ; ------------------------------------------------------------
                      (    forth6809.asm):02738         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):02739         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):02740         ; the variable area, initialised to zero.
                      (    forth6809.asm):02741         ; ------------------------------------------------------------
E19E                  (    forth6809.asm):02742         TWOVARIABLEW:
E19E CC0000           (    forth6809.asm):02743                     LDD   #0
E1A1 3606             (    forth6809.asm):02744                     PSHU  D
E1A3 BDE054           (    forth6809.asm):02745                     JSR   HEADER
E1A6 CCDF8F           (    forth6809.asm):02746                     LDD   #DODOES
E1A9 3606             (    forth6809.asm):02747                     PSHU  D
E1AB BDEABB           (    forth6809.asm):02748                     JSR   CCALL
E1AE CCDF9A           (    forth6809.asm):02749                     LDD   #DOESRT0
E1B1 3606             (    forth6809.asm):02750                     PSHU  D
E1B3 BDE002           (    forth6809.asm):02751                     JSR   CODECOMMA
E1B6 DC0A             (    forth6809.asm):02752                     LDD   VARHERE
E1B8 3606             (    forth6809.asm):02753                     PSHU  D
E1BA BDE002           (    forth6809.asm):02754                     JSR   CODECOMMA
E1BD CC0000           (    forth6809.asm):02755                     LDD   #0
E1C0 9E0A             (    forth6809.asm):02756                     LDX   VARHERE
E1C2 ED81             (    forth6809.asm):02757                     STD   ,X++
E1C4 ED81             (    forth6809.asm):02758                     STD   ,X++
E1C6 9F0A             (    forth6809.asm):02759                     STX   VARHERE
E1C8 39               (    forth6809.asm):02760                     RTS
                      (    forth6809.asm):02761         
                      (    forth6809.asm):02762         ; ------------------------------------------------------------
                      (    forth6809.asm):02763         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):02764         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):02765         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):02766         ; ------------------------------------------------------------
E1C9                  (    forth6809.asm):02767         TWOCONSTANTW:
E1C9 CCF419           (    forth6809.asm):02768                     LDD   #TWOFETCHW
E1CC BDE0F7           (    forth6809.asm):02769                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
E1CF 3706             (    forth6809.asm):02770                     PULU  D                 ; x2
E1D1 DD29             (    forth6809.asm):02771                     STD   MSCR
E1D3 DC29             (    forth6809.asm):02772                     LDD   MSCR
E1D5 3606             (    forth6809.asm):02773                     PSHU  D
E1D7 BDDFFC           (    forth6809.asm):02774                     JSR   COMMAW            ; x2 -> lower address
E1DA BDDFFC           (    forth6809.asm):02775                     JSR   COMMAW            ; x1 -> higher. See bugfix: TWOCONSTANTW.1

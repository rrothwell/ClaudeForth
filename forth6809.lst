E024 39               (    forth6809.asm):05955                     RTS
                      (    forth6809.asm):05956         
                      (    forth6809.asm):05957         ; ------------------------------------------------------------
                      (    forth6809.asm):05958         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05959         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05960         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05961         ; put back around the transfer.
                      (    forth6809.asm):05962         ; ------------------------------------------------------------
E025 3510             (    forth6809.asm):05963         TWOTORW:    PULS  X                 ; return address
E027 3706             (    forth6809.asm):05964                     PULU  D                 ; x2
E029 3720             (    forth6809.asm):05965                     PULU  Y                 ; x1
E02B 3420             (    forth6809.asm):05966                     PSHS  Y
E02D 3406             (    forth6809.asm):05967                     PSHS  D
E02F 3410             (    forth6809.asm):05968                     PSHS  X
E031 39               (    forth6809.asm):05969                     RTS
                      (    forth6809.asm):05970         
                      (    forth6809.asm):05971         ; ------------------------------------------------------------
                      (    forth6809.asm):05972         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05973         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05974         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05975         ; put back around the transfer.
                      (    forth6809.asm):05976         ; ------------------------------------------------------------
E032 3510             (    forth6809.asm):05977         TWOFROMRW:  PULS  X                 ; return address
E034 3506             (    forth6809.asm):05978                     PULS  D                 ; x2
E036 3520             (    forth6809.asm):05979                     PULS  Y                 ; x1
E038 3410             (    forth6809.asm):05980                     PSHS  X
E03A 3620             (    forth6809.asm):05981                     PSHU  Y
E03C 3606             (    forth6809.asm):05982                     PSHU  D
E03E 39               (    forth6809.asm):05983                     RTS
                      (    forth6809.asm):05984         
                      (    forth6809.asm):05985         ; ------------------------------------------------------------
                      (    forth6809.asm):05986         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05987         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05988         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05989         ; and put back around the transfer.
                      (    forth6809.asm):05990         ; ------------------------------------------------------------

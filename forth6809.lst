                      (    forth6809.asm):10890         ; ------------------------------------------------------------
                      (    forth6809.asm):10891         ; TSTMEMORY - memory tests (glossary section 3.11, 22 words, 16
                      (    forth6809.asm):10892         ; tests since several are combined into round-trip tests that
                      (    forth6809.asm):10893         ; can only be meaningfully verified together: @/!, C@/C!, 2@/2!,
                      (    forth6809.asm):10894         ; and the CODEHERE-region words (,/C,/ALLOT/HERE) and VARHERE-
                      (    forth6809.asm):10895         ; region words (V,/VC,/VALLOT/VHERE) each combined into one
                      (    forth6809.asm):10896         ; sequential walk-through per region.
                      (    forth6809.asm):10897         ;
                      (    forth6809.asm):10898         ; MOVE is traced from its own code to genuinely choose its copy
                      (    forth6809.asm):10899         ; direction by comparing src and dst addresses, delegating to
                      (    forth6809.asm):10900         ; CMOVE or CMOVE> to stay overlap-safe - so its own tests
                      (    forth6809.asm):10901         ; specifically include both overlap directions (TSTMOVE2/
                      (    forth6809.asm):10902         ; TSTMOVE3), each with its expected result hand-derived and
                      (    forth6809.asm):10903         ; independently simulated in Python before writing the test, not
                      (    forth6809.asm):10904         ; a trivial non-overlapping case alone (TSTMOVE1).
                      (    forth6809.asm):10905         ; ------------------------------------------------------------
C272 BDFC2B           (    forth6809.asm):10906         TSTMEMORY: JSR CRW
C275 8EC286           (    forth6809.asm):10907                    LDX   #TSTMEMMSG
C278 3610             (    forth6809.asm):10908                    PSHU  X
C27A CC0006           (    forth6809.asm):10909                    LDD   #6
C27D 3606             (    forth6809.asm):10910                    PSHU  D
C27F BDF60B           (    forth6809.asm):10911                    JSR   TYPE
C282 BDFC2B           (    forth6809.asm):10912                    JSR   CRW
                      (    forth6809.asm):10913         
                      (    forth6809.asm):10914                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10915         
                      (    forth6809.asm):10916                    JSR   TSTFETCHSTORE
                      (    forth6809.asm):10917                    JSR   TSTCFETCHSTORE
                      (    forth6809.asm):10918                    JSR   TSTPLUSSTORE
                      (    forth6809.asm):10919                    JSR   TST2FETCHSTORE
                      (    forth6809.asm):10920                    JSR   TSTCODEHERE
                      (    forth6809.asm):10921                    JSR   TSTVARHERE
                      (    forth6809.asm):10922                    JSR   TSTPAD
                      (    forth6809.asm):10923                    JSR   TSTUNUSED
                      (    forth6809.asm):10924                    JSR   TSTVUNUSED
                      (    forth6809.asm):10925                    JSR   TSTFILL
                      (    forth6809.asm):10926                    JSR   TSTERASE
                      (    forth6809.asm):10927                    JSR   TSTCMOVE
                      (    forth6809.asm):10928                    JSR   TSTCMOVEGT
                      (    forth6809.asm):10929                    JSR   TSTMOVE1
                      (    forth6809.asm):10930                    JSR   TSTMOVE2
                      (    forth6809.asm):10931                    JSR   TSTMOVE3
                      (    forth6809.asm):10932         
                      (    forth6809.asm):10933                    ENDC ; <<<<
                      (    forth6809.asm):10934         
C285 39               (    forth6809.asm):10935                    RTS
                      (    forth6809.asm):10936         
C286 4D656D6F7279     (    forth6809.asm):10937         TSTMEMMSG: FCC "Memory"
                      (    forth6809.asm):10938         
                      (    forth6809.asm):10939                    IFEQ TSTSELECTOR-10  ; >>>>
                      (    forth6809.asm):10940         
                      (    forth6809.asm):10941         ; ------------------------------------------------------------
                      (    forth6809.asm):10942         ; Memory test harness (glossary section 3.11). Mostly simpler,
                      (    forth6809.asm):10943         ; direct memory-access words (no compile-time behavior, no
                      (    forth6809.asm):10944         ; name-parsing) - but , C, ALLOT HERE PAD touch CODEHERE, and
                      (    forth6809.asm):10945         ; V, VC, VALLOT VHERE touch VARHERE, so those still need the
                      (    forth6809.asm):10946         ; same redirect-based safety established for sections 3.8/3.9.
                      (    forth6809.asm):10947         ; TSTCBUF is reused here as general scratch memory for the
                      (    forth6809.asm):10948         ; simpler fetch/store tests, safe since each TSTSELECTOR group
                      (    forth6809.asm):10949         ; runs exclusively of every other.
                      (    forth6809.asm):10950         ;
                      (    forth6809.asm):10951         ; MOVE is traced to genuinely choose its copy direction based on
                      (    forth6809.asm):10952         ; comparing src and dst addresses (delegating to CMOVE or
                      (    forth6809.asm):10953         ; CMOVE> as appropriate) - so its own tests specifically include
                      (    forth6809.asm):10954         ; overlapping regions in both directions, not just a trivial
                      (    forth6809.asm):10955         ; non-overlapping case, to verify that claim for real.
                      (    forth6809.asm):10956         ; ------------------------------------------------------------
                      (    forth6809.asm):10957         
                      (    forth6809.asm):10958         ; ------------------------------------------------------------
                      (    forth6809.asm):10959         ; TSTFETCHSTORE - unit test for @ and ! together (can only be
                      (    forth6809.asm):10960         ; meaningfully tested as a round trip). Stores a known value at
                      (    forth6809.asm):10961         ; scratch, fetches it back, verifies the match.
                      (    forth6809.asm):10962         ; ------------------------------------------------------------
C28C                  (    forth6809.asm):10963         TSTFETCHSTORE: STU  TSTU0
                      (    forth6809.asm):10964         
                      (    forth6809.asm):10965                        LDD  #TSTGUARD
                      (    forth6809.asm):10966                        PSHU D
                      (    forth6809.asm):10967                        LDD  #TSTVAL1
                      (    forth6809.asm):10968                        PSHU D
                      (    forth6809.asm):10969                        LDD  #TSTCBUF
                      (    forth6809.asm):10970                        PSHU D
                      (    forth6809.asm):10971                        STU  TSTUB4
                      (    forth6809.asm):10972         
                      (    forth6809.asm):10973                        JSR  STOREW
                      (    forth6809.asm):10974         
                      (    forth6809.asm):10975                        LDD  #TSTCBUF
                      (    forth6809.asm):10976                        PSHU D
                      (    forth6809.asm):10977         
                      (    forth6809.asm):10978                        JSR  ATSIGN
                      (    forth6809.asm):10979         
                      (    forth6809.asm):10980                        STU  TSTUAF
                      (    forth6809.asm):10981         
                      (    forth6809.asm):10982                        PULU D
                      (    forth6809.asm):10983                        CMPD #TSTVAL1
                      (    forth6809.asm):10984                        BNE  FSFAIL
                      (    forth6809.asm):10985                        PULU D
                      (    forth6809.asm):10986                        CMPD #TSTGUARD
                      (    forth6809.asm):10987                        BNE  FSFAIL
                      (    forth6809.asm):10988         
                      (    forth6809.asm):10989                        LDD  TSTUB4
                      (    forth6809.asm):10990                        SUBD TSTUAF
                      (    forth6809.asm):10991                        CMPD #-2
                      (    forth6809.asm):10992                        BNE  FSFAIL
                      (    forth6809.asm):10993         
                      (    forth6809.asm):10994                        LDD  #TRUEV
                      (    forth6809.asm):10995                        BRA  FSDONE
C28C                  (    forth6809.asm):10996         FSFAIL:        LDD  #FALSEV
C28C                  (    forth6809.asm):10997         FSDONE:        LDX  #TSTFSNAME
                      (    forth6809.asm):10998                        PSHU X
                      (    forth6809.asm):10999                        PSHU D
                      (    forth6809.asm):11000                        JSR  TSTREPORT
                      (    forth6809.asm):11001         
                      (    forth6809.asm):11002                        LDU  TSTU0
                      (    forth6809.asm):11003                        RTS
                      (    forth6809.asm):11004         
C28C                  (    forth6809.asm):11005         TSTFSNAME: FCB  13
                      (    forth6809.asm):11006                    FCC  "TSTFETCHSTORE"
                      (    forth6809.asm):11007         
                      (    forth6809.asm):11008         ; ------------------------------------------------------------
                      (    forth6809.asm):11009         ; TSTCFETCHSTORE - unit test for C@ and C! together. Pre-fills
                      (    forth6809.asm):11010         ; the cell with a distinctive nonzero pattern ($FFFF) via a
                      (    forth6809.asm):11011         ; direct write (not through C!/C@ themselves), then confirms C!
                      (    forth6809.asm):11012         ; genuinely only touches the single byte at the exact address
                      (    forth6809.asm):11013         ; given - not the "other half" of a 2-byte cell in some assumed
                      (    forth6809.asm):11014         ; sense - and that C@ genuinely zero-extends (not just returns
                      (    forth6809.asm):11015         ; whatever was there).
                      (    forth6809.asm):11016         ;
                      (    forth6809.asm):11017         ; BUG FIX: this test's own expected value after C! was wrong,
                      (    forth6809.asm):11018         ; not CSTOREW - confirmed via MAME: expected $FF34 (assuming
                      (    forth6809.asm):11019         ; the untouched byte, from the $FFFF pre-fill, would end up as
                      (    forth6809.asm):11020         ; the high byte of the word), but CSTOREW writes directly at
                      (    forth6809.asm):11021         ; the given address (TSTCBUF itself, the LOWER address), leaving
                      (    forth6809.asm):11022         ; TSTCBUF+1 (the higher address) untouched at $FF - and since
                      (    forth6809.asm):11023         ; LDD on this big-endian 6809 reads the high byte of the word
                      (    forth6809.asm):11024         ; from the lower address first, that's $34FF, not $FF34. The
                      (    forth6809.asm):11025         ; single-byte write and the zero-extending fetch were both
                      (    forth6809.asm):11026         ; already correct; only this test's own arithmetic about which
                      (    forth6809.asm):11027         ; byte ends up where was wrong.
                      (    forth6809.asm):11028         ; ------------------------------------------------------------
C28C                  (    forth6809.asm):11029         TSTCFETCHSTORE: LDD  #$FFFF
                      (    forth6809.asm):11030                         STD  TSTCBUF
                      (    forth6809.asm):11031         
                      (    forth6809.asm):11032                         STU  TSTU0
                      (    forth6809.asm):11033         
                      (    forth6809.asm):11034                         LDD  #TSTGUARD
                      (    forth6809.asm):11035                         PSHU D
                      (    forth6809.asm):11036                         LDD  #$34
                      (    forth6809.asm):11037                         PSHU D
                      (    forth6809.asm):11038                         LDD  #TSTCBUF
                      (    forth6809.asm):11039                         PSHU D
                      (    forth6809.asm):11040                         STU  TSTUB4
                      (    forth6809.asm):11041         
                      (    forth6809.asm):11042                         JSR  CSTOREW
                      (    forth6809.asm):11043         
                      (    forth6809.asm):11044                         LDD  TSTCBUF
                      (    forth6809.asm):11045                         CMPD #$34FF
                      (    forth6809.asm):11046                         BNE  CFFAIL
                      (    forth6809.asm):11047         
                      (    forth6809.asm):11048                         LDD  #TSTCBUF
                      (    forth6809.asm):11049                         PSHU D
                      (    forth6809.asm):11050         
                      (    forth6809.asm):11051                         JSR  CFETCH
                      (    forth6809.asm):11052         
                      (    forth6809.asm):11053                         STU  TSTUAF
                      (    forth6809.asm):11054         
                      (    forth6809.asm):11055                         PULU D
                      (    forth6809.asm):11056                         CMPD #$0034
                      (    forth6809.asm):11057                         BNE  CFFAIL
                      (    forth6809.asm):11058                         PULU D
                      (    forth6809.asm):11059                         CMPD #TSTGUARD
                      (    forth6809.asm):11060                         BNE  CFFAIL
                      (    forth6809.asm):11061         
                      (    forth6809.asm):11062                         LDD  TSTUB4
                      (    forth6809.asm):11063                         SUBD TSTUAF
                      (    forth6809.asm):11064                         CMPD #-2
                      (    forth6809.asm):11065                         BNE  CFFAIL
                      (    forth6809.asm):11066         
                      (    forth6809.asm):11067                         LDD  #TRUEV
                      (    forth6809.asm):11068                         BRA  CFDONE
C28C                  (    forth6809.asm):11069         CFFAIL:         LDD  #FALSEV
C28C                  (    forth6809.asm):11070         CFDONE:         LDX  #TSTCFNAME
                      (    forth6809.asm):11071                         PSHU X
                      (    forth6809.asm):11072                         PSHU D
                      (    forth6809.asm):11073                         JSR  TSTREPORT
                      (    forth6809.asm):11074         
                      (    forth6809.asm):11075                         LDU  TSTU0
                      (    forth6809.asm):11076                         RTS
                      (    forth6809.asm):11077         
C28C                  (    forth6809.asm):11078         TSTCFNAME: FCB  14
                      (    forth6809.asm):11079                    FCC  "TSTCFETCHSTORE"
                      (    forth6809.asm):11080         
                      (    forth6809.asm):11081         ; ------------------------------------------------------------
                      (    forth6809.asm):11082         ; TSTPLUSSTORE - unit test for +!. Pre-initializes the cell to a
                      (    forth6809.asm):11083         ; known value, adds a known delta, and verifies the sum landed
                      (    forth6809.asm):11084         ; correctly.
                      (    forth6809.asm):11085         ; ------------------------------------------------------------
C28C                  (    forth6809.asm):11086         TSTPLUSSTORE: LDD  #TSTVAL1
                      (    forth6809.asm):11087                       STD  TSTCBUF
                      (    forth6809.asm):11088         
                      (    forth6809.asm):11089                       STU  TSTU0
                      (    forth6809.asm):11090         
                      (    forth6809.asm):11091                       LDD  #TSTGUARD
                      (    forth6809.asm):11092                       PSHU D
                      (    forth6809.asm):11093                       LDD  #100
                      (    forth6809.asm):11094                       PSHU D
                      (    forth6809.asm):11095                       LDD  #TSTCBUF
                      (    forth6809.asm):11096                       PSHU D
                      (    forth6809.asm):11097                       STU  TSTUB4
                      (    forth6809.asm):11098         
                      (    forth6809.asm):11099                       JSR  PLUSSTORE
                      (    forth6809.asm):11100         
                      (    forth6809.asm):11101                       STU  TSTUAF
                      (    forth6809.asm):11102         
                      (    forth6809.asm):11103                       LDD  TSTCBUF
                      (    forth6809.asm):11104                       CMPD #TSTVAL1+100
                      (    forth6809.asm):11105                       BNE  PSFAIL
                      (    forth6809.asm):11106         
                      (    forth6809.asm):11107                       PULU D
                      (    forth6809.asm):11108                       CMPD #TSTGUARD
                      (    forth6809.asm):11109                       BNE  PSFAIL
                      (    forth6809.asm):11110         
                      (    forth6809.asm):11111                       LDD  TSTUB4
                      (    forth6809.asm):11112                       SUBD TSTUAF
                      (    forth6809.asm):11113                       CMPD #-4
                      (    forth6809.asm):11114                       BNE  PSFAIL
                      (    forth6809.asm):11115         
                      (    forth6809.asm):11116                       LDD  #TRUEV
                      (    forth6809.asm):11117                       BRA  PSDONE
C28C                  (    forth6809.asm):11118         PSFAIL:       LDD  #FALSEV
C28C                  (    forth6809.asm):11119         PSDONE:       LDX  #TSTPSNAME
                      (    forth6809.asm):11120                       PSHU X
                      (    forth6809.asm):11121                       PSHU D
                      (    forth6809.asm):11122                       JSR  TSTREPORT
                      (    forth6809.asm):11123         
                      (    forth6809.asm):11124                       LDU  TSTU0
                      (    forth6809.asm):11125                       RTS
                      (    forth6809.asm):11126         
C28C                  (    forth6809.asm):11127         TSTPSNAME: FCB  12
                      (    forth6809.asm):11128                    FCC  "TSTPLUSSTORE"
                      (    forth6809.asm):11129         
                      (    forth6809.asm):11130         ; ------------------------------------------------------------
                      (    forth6809.asm):11131         ; TST2FETCHSTORE - unit test for 2@ and 2! together. Stores a
                      (    forth6809.asm):11132         ; known pair, fetches it back, and verifies the correct
                      (    forth6809.asm):11133         ; ordering (x1 at the lower address, x2 at the higher, matching
                      (    forth6809.asm):11134         ; the documented convention on both ends).
                      (    forth6809.asm):11135         ; ------------------------------------------------------------
C28C                  (    forth6809.asm):11136         TST2FETCHSTORE: STU  TSTU0
                      (    forth6809.asm):11137         
                      (    forth6809.asm):11138                         LDD  #TSTGUARD
                      (    forth6809.asm):11139                         PSHU D
                      (    forth6809.asm):11140                         LDD  #TSTVAL1
                      (    forth6809.asm):11141                         PSHU D
                      (    forth6809.asm):11142                         LDD  #TSTVAL2
                      (    forth6809.asm):11143                         PSHU D
                      (    forth6809.asm):11144                         LDD  #TSTCBUF
                      (    forth6809.asm):11145                         PSHU D
                      (    forth6809.asm):11146                         STU  TSTUB4
                      (    forth6809.asm):11147         
                      (    forth6809.asm):11148                         JSR  DSTORE
                      (    forth6809.asm):11149         
                      (    forth6809.asm):11150                         LDD  #TSTCBUF
                      (    forth6809.asm):11151                         PSHU D
                      (    forth6809.asm):11152         
                      (    forth6809.asm):11153                         JSR  DFETCH
                      (    forth6809.asm):11154         
                      (    forth6809.asm):11155                         STU  TSTUAF
                      (    forth6809.asm):11156         
                      (    forth6809.asm):11157                         PULU D
                      (    forth6809.asm):11158                         CMPD #TSTVAL2
                      (    forth6809.asm):11159                         BNE  DFFAIL
                      (    forth6809.asm):11160                         PULU D
                      (    forth6809.asm):11161                         CMPD #TSTVAL1
                      (    forth6809.asm):11162                         BNE  DFFAIL
                      (    forth6809.asm):11163                         PULU D
                      (    forth6809.asm):11164                         CMPD #TSTGUARD
                      (    forth6809.asm):11165                         BNE  DFFAIL
                      (    forth6809.asm):11166         
                      (    forth6809.asm):11167                         LDD  TSTUB4
                      (    forth6809.asm):11168                         SUBD TSTUAF
                      (    forth6809.asm):11169                         CMPD #-2
                      (    forth6809.asm):11170                         BNE  DFFAIL
                      (    forth6809.asm):11171         
                      (    forth6809.asm):11172                         LDD  TSTCBUF
                      (    forth6809.asm):11173                         CMPD #TSTVAL1
                      (    forth6809.asm):11174                         BNE  DFFAIL
                      (    forth6809.asm):11175                         LDD  TSTCBUF+2
                      (    forth6809.asm):11176                         CMPD #TSTVAL2
                      (    forth6809.asm):11177                         BNE  DFFAIL
                      (    forth6809.asm):11178         
                      (    forth6809.asm):11179                         LDD  #TRUEV
                      (    forth6809.asm):11180                         BRA  DFDONE
C28C                  (    forth6809.asm):11181         DFFAIL:         LDD  #FALSEV
C28C                  (    forth6809.asm):11182         DFDONE:         LDX  #TSTDFNAME
                      (    forth6809.asm):11183                         PSHU X
                      (    forth6809.asm):11184                         PSHU D
                      (    forth6809.asm):11185                         JSR  TSTREPORT
                      (    forth6809.asm):11186         
                      (    forth6809.asm):11187                         LDU  TSTU0
                      (    forth6809.asm):11188                         RTS
                      (    forth6809.asm):11189         
C28C                  (    forth6809.asm):11190         TSTDFNAME: FCB  14
                      (    forth6809.asm):11191                    FCC  "TST2FETCHSTORE"
                      (    forth6809.asm):11192         
                      (    forth6809.asm):11193         ; ------------------------------------------------------------
                      (    forth6809.asm):11194         ; TSTCODEHERE - combined unit test for , C, ALLOT, and HERE
                      (    forth6809.asm):11195         ; together (glossary section 3.11's own CODEHERE-region words).
                      (    forth6809.asm):11196         ; Redirects CODEHERE to scratch and walks through a sequence:
                      (    forth6809.asm):11197         ; HERE reports the redirected value, COMMA appends a cell (and
                      (    forth6809.asm):11198         ; the written cell is verified directly, not just the advance),
                      (    forth6809.asm):11199         ; C, appends a byte (verified the same way), ALLOT reserves then
                      (    forth6809.asm):11200         ; releases bytes (confirming both directions work, matching
                      (    forth6809.asm):11201         ; "reserve (or release, if negative)"), and a final HERE
                      (    forth6809.asm):11202         ; confirms the cumulative result.
                      (    forth6809.asm):11203         ; ------------------------------------------------------------
C28C                  (    forth6809.asm):11204         TSTCODEHERE: LDD  CODEHERE
                      (    forth6809.asm):11205                      STD  TSTCSAV
                      (    forth6809.asm):11206         
                      (    forth6809.asm):11207                      LDD  #TSTCBUF
                      (    forth6809.asm):11208                      STD  CODEHERE
                      (    forth6809.asm):11209         
                      (    forth6809.asm):11210                      STU  TSTU0
                      (    forth6809.asm):11211         

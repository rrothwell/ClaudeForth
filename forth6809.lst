                      (   unit_tests.asm):07229         ; Defining-words test harness (glossary section 3.9). Every
                      (   unit_tests.asm):07230         ; defining word parses a name from the input source via WORD -
                      (   unit_tests.asm):07231         ; unlike anything in section 3.8's control-flow tests - so each
                      (   unit_tests.asm):07232         ; test redirects CODEHERE, DPHERE, VARHERE, and SRCADDR/SRCLEN/
                      (   unit_tests.asm):07233         ; TOIN together (a fake name text, "TESTWD", reused safely
                      (   unit_tests.asm):07234         ; across every test here since each redirect/restore cycle is
                      (   unit_tests.asm):07235         ; fully isolated), calls the real defining word directly, saves
                      (   unit_tests.asm):07236         ; the newly-defined word's own CFA (= CODEHERE at the moment the
                      (   unit_tests.asm):07237         ; defining word was called), restores everything, then executes
                      (   unit_tests.asm):07238         ; that CFA directly to verify runtime behavior. Traced by hand:
                      (   unit_tests.asm):07239         ; CREATE/VARIABLE/CONSTANT/etc all use HEADER (shared header-
                      (   unit_tests.asm):07240         ; building) then compile a fixed 5-byte trampoline (3-byte
                      (   unit_tests.asm):07241         ; "JSR DODOES" + a 2-byte "behavior field") before their own
                      (   unit_tests.asm):07242         ; PFA - confirmed the behavior field holds a genuine compiled
                      (   unit_tests.asm):07243         ; JSR instruction only for CREATE's own bare placeholder
                      (   unit_tests.asm):07244         ; (DOESRT0, later patched by DOES>); every other defining word
                      (   unit_tests.asm):07245         ; (VARIABLE, CONSTANT, DEFER, MARKER, VALUE) instead compiles a
                      (   unit_tests.asm):07246         ; raw 2-byte address there directly (via CODECOMMA, not CCALL) -
                      (   unit_tests.asm):07247         ; DODOES reads this field as data either way, which only works
                      (   unit_tests.asm):07248         ; correctly for the raw-address form. This is why bare CREATE,
                      (   unit_tests.asm):07249         ; executed before any DOES>, isn't tested here - its own
                      (   unit_tests.asm):07250         ; placeholder behavior field isn't meant to be read as data,
                      (   unit_tests.asm):07251         ; only ever overwritten by DOES> before first use.
                      (   unit_tests.asm):07252         ; ------------------------------------------------------------
                      (   unit_tests.asm):07253         
                      (   unit_tests.asm):07254         ; ------------------------------------------------------------
                      (   unit_tests.asm):07255         ; TSTVAR - unit test for VARIABLE. Compiles "VARIABLE TESTWD"
                      (   unit_tests.asm):07256         ; into scratch, then executes the result. Verifies it pushes
                      (   unit_tests.asm):07257         ; its own PFA address (TSTVBUF, since VARHERE was redirected
                      (   unit_tests.asm):07258         ; there) and that the cell there was correctly initialized to
                      (   unit_tests.asm):07259         ; zero - VARIABLE's own documented behavior, not assumed.
                      (   unit_tests.asm):07260         ; ------------------------------------------------------------

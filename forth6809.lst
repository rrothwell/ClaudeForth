E489 DD18             (    forth6809.asm):03174                     STD   NADDR
E48B 3706             (    forth6809.asm):03175                     PULU  D                 ; ud1 high
E48D DD46             (    forth6809.asm):03176                     STD   UDHI
E48F 3706             (    forth6809.asm):03177                     PULU  D                 ; ud1 low
E491 DD48             (    forth6809.asm):03178                     STD   UDLO

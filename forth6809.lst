                      (    forth6809.asm):10549         
                      (    forth6809.asm):10550                       LDD  #TSTCBUF
                      (    forth6809.asm):10551                       STD  CODEHERE
                      (    forth6809.asm):10552                       LDD  #-1
                      (    forth6809.asm):10553                       STD  STATE
                      (    forth6809.asm):10554         
                      (    forth6809.asm):10555                       LDD  #TSTNAMEB
                      (    forth6809.asm):10556                       PSHU D
                      (    forth6809.asm):10557                       LDD  #2
                      (    forth6809.asm):10558                       PSHU D
                      (    forth6809.asm):10559                       JSR  SLITERALW
                      (    forth6809.asm):10560         
                      (    forth6809.asm):10561                       LDD  #OPRTS
                      (    forth6809.asm):10562                       PSHU D
                      (    forth6809.asm):10563                       JSR  CCOMMA
                      (    forth6809.asm):10564         
                      (    forth6809.asm):10565                       LDD  TSTCSAV
                      (    forth6809.asm):10566                       STD  CODEHERE
                      (    forth6809.asm):10567                       LDD  TSTSTSAV
                      (    forth6809.asm):10568                       STD  STATE
                      (    forth6809.asm):10569         
                      (    forth6809.asm):10570                       STU  TSTU0
                      (    forth6809.asm):10571         
                      (    forth6809.asm):10572                       LDD  #TSTGUARD
                      (    forth6809.asm):10573                       PSHU D
                      (    forth6809.asm):10574                       STU  TSTUB4
                      (    forth6809.asm):10575         
                      (    forth6809.asm):10576                       LDX  #TSTCBUF
                      (    forth6809.asm):10577                       JSR  ,X
                      (    forth6809.asm):10578         
                      (    forth6809.asm):10579                       STU  TSTUAF
                      (    forth6809.asm):10580         
                      (    forth6809.asm):10581                       PULU D
                      (    forth6809.asm):10582                       CMPD #2
                      (    forth6809.asm):10583                       BNE  SL1FAIL
                      (    forth6809.asm):10584         
                      (    forth6809.asm):10585                       PULU D
                      (    forth6809.asm):10586                       TFR  D,X
                      (    forth6809.asm):10587                       LDA  ,X
                      (    forth6809.asm):10588                       CMPA #'A'
                      (    forth6809.asm):10589                       BNE  SL1FAIL
                      (    forth6809.asm):10590                       LDA  1,X
                      (    forth6809.asm):10591                       CMPA #'B'
                      (    forth6809.asm):10592                       BNE  SL1FAIL
                      (    forth6809.asm):10593         
                      (    forth6809.asm):10594                       PULU D

                      (    forth6809.asm):00001         ; ============================================================
                      (    forth6809.asm):00002         ; 6809 ANS FORTH - consolidated source
                      (    forth6809.asm):00003         ; Assembled from the full design conversation.
                      (    forth6809.asm):00004         ;
                      (    forth6809.asm):00005         ; GLOBALS LAYOUT: applied. Every scratch/global cell now has a
                      (    forth6809.asm):00006         ; fixed RMB-assigned address in page zero ($0000-$00FF, DP=$00
                      (    forth6809.asm):00007         ; at reset) - see the GLOBALS section below for the full layout
                      (    forth6809.asm):00008         ; and its byte budget (256 of 256 bytes used, 0 free - the page
                      (    forth6809.asm):00009         ; is now fully packed; any future scratch cell will need to
                      (    forth6809.asm):00010         ; reuse an existing one or move a cell out of page zero).
                      (    forth6809.asm):00011         ;
                      (    forth6809.asm):00012         ; SERIAL HANDSHAKING: RTS (hardware, output) is implemented -
                      (    forth6809.asm):00013         ; IRQH/KEY toggle it based on the input ring's fill level
                      (    forth6809.asm):00014         ; against INHIWATER/INLOWATER (see SECTION 3). CTS (input) needs
                      (    forth6809.asm):00015         ; no firmware logic at all: the 6850 hardware automatically
                      (    forth6809.asm):00016         ; inhibits TDRE while CTS is deasserted, and this system's
                      (    forth6809.asm):00017         ; existing TDRE-gated transmit logic already respects that with
                      (    forth6809.asm):00018         ; no code changes. Software (XON/XOFF) handshaking remains not
                      (    forth6809.asm):00019         ; implemented - this system still neither transmits nor
                      (    forth6809.asm):00020         ; recognizes those bytes.
                      (    forth6809.asm):00021         ;
                      (    forth6809.asm):00022         ; DICTIONARY: applied (SECTION 27), 219 entries (215 original +
                      (    forth6809.asm):00023         ; DOES> + TRUE + FALSE, added in later passes - see below).
                      (    forth6809.asm):00024         ; Every primitive with a real code label now has a real ROM
                      (    forth6809.asm):00025         ; header, chained via LINK, CFA pointing directly at its code.
                      (    forth6809.asm):00026         ; Building this surfaced two real findings, not just mechanical
                      (    forth6809.asm):00027         ; work: (1) the original 1024-byte BASEDICT could not hold the
                      (    forth6809.asm):00028         ; header table (1954 bytes needed) - BASEDICT was resized to
                      (    forth6809.asm):00029         ; 2048 bytes ($E000-$E7FF), taking the space from BASECODE (then
                      (    forth6809.asm):00030         ; $E800-$FFBF, 6080 bytes, was 7104). This resize was based on
                      (    forth6809.asm):00031         ; the header-table budget alone; the actual assembled byte size
                      (    forth6809.asm):00032         ; of BASECODE's code was never measured with a real 6809
                      (    forth6809.asm):00033         ; assembler, so whether 6080 bytes was enough for all ~530
                      (    forth6809.asm):00034         ; routine labels in this file was never verified before BASECODE
                      (    forth6809.asm):00035         ; moved again (below). (2) DOES>
                      (    forth6809.asm):00036         ; initially had no corresponding code anywhere in the file -
                      (    forth6809.asm):00037         ; SETDOES and the DOES> compiling word (code label DOESGT, since
                      (    forth6809.asm):00038         ; a literal ">" is not a valid 6809 assembler label) were added
                      (    forth6809.asm):00039         ; in a follow-up pass, alongside DODOES/DOESRT0, closing that
                      (    forth6809.asm):00040         ; gap; DOESBEH was added to the GLOBALS layout to support it,
                      (    forth6809.asm):00041         ; using 2 of the page's last 3 free bytes (1 now remains). TRUE
                      (    forth6809.asm):00042         ; and FALSE were added in a still later pass: CONSTANT TRUE -1
                      (    forth6809.asm):00043         ; and CONSTANT FALSE 0, the first CONSTANT-pattern ROM-resident
                      (    forth6809.asm):00044         ; words in this system (TRUEBODY/FALSEBODY, section 26) - every
                      (    forth6809.asm):00045         ; other ROM word's CFA is a plain code label, but a CONSTANT's
                      (    forth6809.asm):00046         ; CFA is the DODOES-trampoline pattern, built by hand here with
                      (    forth6809.asm):00047         ; fixed, assemble-time addresses since there is no interactive
                      (    forth6809.asm):00048         ; CREATE/CONSTANT phase for ROM content.
                      (    forth6809.asm):00049         ;
                      (    forth6809.asm):00050         ; BASEDICT now holds 1992 bytes ($D83F-$E006) - grown from the
                      (    forth6809.asm):00051         ; earlier exact-fit 1973 bytes when H_ABORT/H_QUIT (formerly
                      (    forth6809.asm):00052         ; ABORTHDR/QUITHDR) and BASELATEST moved in from their own
                      (    forth6809.asm):00053         ; section so every dictionary header lives in one contiguous
                      (    forth6809.asm):00054         ; block. BASECODE's start ($DFF4) did not move to match, since
                      (    forth6809.asm):00055         ; it's a fixed address, not derived from BASEDICT's real size -
                      (    forth6809.asm):00056         ; this reintroduces a real overlap, 19 bytes ($DFF4-$E006),
                      (    forth6809.asm):00057         ; between the two. Not resolved here; see the open-items
                      (    forth6809.asm):00058         ; checklist. USROMSTRT/USROMEND, INOUT, RSTACK, DSTACK, CODETOP,
                      (    forth6809.asm):00059         ; APPCODE, APPDICT, and APPVARS remain mutually consistent
                      (    forth6809.asm):00060         ; otherwise, with no other overlaps anywhere in the current
                      (    forth6809.asm):00061         ; memory map. See the ROM Size Required section of the
                      (    forth6809.asm):00062         ; documentation and the open-items checklist for real content
                      (    forth6809.asm):00063         ; totals and remaining margin.
                      (    forth6809.asm):00064         ;
                      (    forth6809.asm):00065         ; This file preserves the code exactly as derived and verified
                      (    forth6809.asm):00066         ; turn-by-turn in the conversation, including the corrected
                      (    forth6809.asm):00067         ; versions of every bug that was caught and fixed in place.
                      (    forth6809.asm):00068         ; SUBSTITUTE is complete but deliberately scoped to a single
                      (    forth6809.asm):00069         ; registered name/value pair, not a full table (see REPLACES).
                      (    forth6809.asm):00070         ; ENVTABLE's /HOLD and /PAD entries, and the DPHERE/CODEHERE/
                      (    forth6809.asm):00071         ; VARHERE boundary checks, remain explicitly incomplete/absent -
                      (    forth6809.asm):00072         ; see the inline notes preserved from that discussion, and the
                      (    forth6809.asm):00073         ; open-items checklist.
                      (    forth6809.asm):00074         ; ============================================================
                      (    forth6809.asm):00075         
                      (    forth6809.asm):00076         ; ------------------------------------------------------------
                      (    forth6809.asm):00077         ; MEMORY MAP
                      (    forth6809.asm):00078         ; ------------------------------------------------------------
     C000             (    forth6809.asm):00079         ROMSTRT  EQU $C000     ; true physical start of the 16K EPROM's own
                      (    forth6809.asm):00080                                 ; address decode (distinct from USROMSTRT
                      (    forth6809.asm):00081                                 ; below, which excludes INOUT's 256-byte
                      (    forth6809.asm):00082                                 ; shadow) - see the ROM Size Required section
                      (    forth6809.asm):00083                                 ; of the documentation, and the ROM: padding
                      (    forth6809.asm):00084                                 ; block right before SECTION 27
     C100             (    forth6809.asm):00085         USROMSTRT EQU $C100     ; Usable ROM start. Beginning of the usable
                      (    forth6809.asm):00086                                  ; EPROM address range. INITCODE, BASECODE,
                      (    forth6809.asm):00087                                  ; and BASEDICT must all fall within
                      (    forth6809.asm):00088                                  ; USROMSTRT..USROMEND - see the verification
                      (    forth6809.asm):00089                                  ; note below each one's EQU.
     FFEF             (    forth6809.asm):00090         USROMEND EQU  VECTORS-1 ; Usable ROM end. Corrected: 1 before VECTORS'
                      (    forth6809.asm):00091                                  ; start ($FFEF), not one past VECTORS' end as
                      (    forth6809.asm):00092                                  ; originally defined - this is a real 16-bit
                      (    forth6809.asm):00093                                  ; address (the last byte available before the
                      (    forth6809.asm):00094                                  ; reserved vector table), usable directly in
                      (    forth6809.asm):00095                                  ; comparisons or as a memory operand, unlike
                      (    forth6809.asm):00096                                  ; the previous $10000 definition
     FFF0             (    forth6809.asm):00097         VECTORS  EQU  $FFF0
     FFA9             (    forth6809.asm):00098         INITCODE EQU  $FFA9     ; was $FFA2 - shifted up 7 bytes to reduce the
                      (    forth6809.asm):00099                                  ; overlap with BASECODE's nominal end ($FFB4)
                      (    forth6809.asm):00100                                  ; from 19 bytes to 12 - improved, not resolved.
                      (    forth6809.asm):00101                                  ; CORRECTED: INITCODE's real content is 71
                      (    forth6809.asm):00102                                  ; bytes ($47), confirmed by an actual assembler
                      (    forth6809.asm):00103                                  ; run - not the 78-byte manual estimate relied
                      (    forth6809.asm):00104                                  ; on for several turns, which was wrong by 7
                      (    forth6809.asm):00105                                  ; bytes. At $FFA9, real content now ends at
                      (    forth6809.asm):00106                                  ; $FFEF, exactly one byte below VECTORS - a
                      (    forth6809.asm):00107                                  ; genuine, assembler-confirmed exact fit, zero
                      (    forth6809.asm):00108                                  ; gap, zero overlap. A prior turn claimed this
                      (    forth6809.asm):00109                                  ; shift created a new 7-byte VECTORS overlap;
                      (    forth6809.asm):00110                                  ; that was based on the incorrect 78-byte
                      (    forth6809.asm):00111                                  ; estimate and was wrong - retracted here. The
                      (    forth6809.asm):00112                                  ; BASECODE overlap (12 bytes against its
                      (    forth6809.asm):00113                                  ; nominal budget) is separate and unaffected
                      (    forth6809.asm):00114                                  ; by this correction; not resolved. See the
                      (    forth6809.asm):00115                                  ; open-items checklist.
     E02A             (    forth6809.asm):00116         BASECODE EQU  $E02A     ; was $E007 - shifted up 35 bytes. Two effects:
                      (    forth6809.asm):00117                                  ; (1) opens a new 35-byte GAP between
                      (    forth6809.asm):00118                                  ; BASEDICT's real end ($E006, 1992 bytes) and
                      (    forth6809.asm):00119                                  ; this new start - previously exactly
                      (    forth6809.asm):00120                                  ; contiguous (zero gap). Not itself broken,
                      (    forth6809.asm):00121                                  ; just unused address space where there wasn't
                      (    forth6809.asm):00122                                  ; any before. (2) WORSENS the existing overlap
                      (    forth6809.asm):00123                                  ; with INITCODE: BASECODE's nominal size (8110)
                      (    forth6809.asm):00124                                  ; is unchanged, so its nominal end also shifted
                      (    forth6809.asm):00125                                  ; up 35 bytes, from $FFB4 to $FFD7 - INITCODE
                      (    forth6809.asm):00126                                  ; (currently $FFA9) is now overlapped by 47
                      (    forth6809.asm):00127                                  ; bytes, up from 12. Applied exactly as
                      (    forth6809.asm):00128                                  ; requested; neither effect resolved here. See
                      (    forth6809.asm):00129                                  ; the open-items checklist.
     D83F             (    forth6809.asm):00130         BASEDICT EQU  $D83F     ; was $D85D - shifted down the same 30 bytes as
                      (    forth6809.asm):00131                                  ; BASECODE, preserving the exact, zero-padding
                      (    forth6809.asm):00132                                  ; fit for its real 1973-byte dictionary content
                      (    forth6809.asm):00133                                  ; (SECTION 27) - contiguous with BASECODE's
                      (    forth6809.asm):00134                                  ; start at the time. Since grown to 1992 bytes
                      (    forth6809.asm):00135                                  ; (H_ABORT/H_QUIT/BASELATEST moved in), and
                      (    forth6809.asm):00136                                  ; BASECODE has since moved again too, no longer
                      (    forth6809.asm):00137                                  ; to match - a 35-byte gap now sits between
                      (    forth6809.asm):00138                                  ; them; see BASECODE's own EQU.
     C000             (    forth6809.asm):00139         INOUT    EQU  $C000     ; was $DF00 - moved so INOUT (256 B) sits
                      (    forth6809.asm):00140                                  ; directly below USROMSTRT ($C100), contiguous,
                      (    forth6809.asm):00141                                  ; no gap. This also resolves the INOUT portion
                      (    forth6809.asm):00142                                  ; of the collision flagged when BASEDICT moved
                      (    forth6809.asm):00143                                  ; to $D85D: INOUT no longer overlaps BASEDICT
                      (    forth6809.asm):00144                                  ; ($D85D-$E011), since $C0FF < $D85D. The
                      (    forth6809.asm):00145                                  ; DSTACK and RSTACK portions of that same
                      (    forth6809.asm):00146                                  ; collision were NOT touched by this specific
                      (    forth6809.asm):00147                                  ; change, but were resolved separately when
                      (    forth6809.asm):00148                                  ; those two regions moved (see below). This
                      (    forth6809.asm):00149                                  ; move ALSO overlapped APPCODE at the time
                      (    forth6809.asm):00150                                  ; ($7000-$D7FF then) - since resolved too, when
                      (    forth6809.asm):00151                                  ; APPCODE moved down $2000 (see below).
     C0FF             (    forth6809.asm):00152         INOUTEND EQU  INOUT+$FF
     BFFF             (    forth6809.asm):00153         RSTACK   EQU  $BFFF     ; was $BEFF - occupied range is $BD00-$BFFF
                      (    forth6809.asm):00154                                  ; (768 bytes, unchanged size). RESOLVED: once a
                      (    forth6809.asm):00155                                  ; 512-byte gap sat between this and DSTACK
                      (    forth6809.asm):00156                                  ; below; DSTACK moving up $200 closed it - now
                      (    forth6809.asm):00157                                  ; exactly contiguous, no gap
     BCFF             (    forth6809.asm):00158         DSTACK   EQU  $BCFF     ; was $BAFF - moved up $200. RESOLVED (both):
                      (    forth6809.asm):00159                                  ; occupied range is now $B900-$BCFF, which
                      (    forth6809.asm):00160                                  ; exactly matches CODETOP ($B900) as its true
                      (    forth6809.asm):00161                                  ; bottom - the 512-byte mismatch is gone - and
                      (    forth6809.asm):00162                                  ; is now exactly contiguous with RSTACK's
                      (    forth6809.asm):00163                                  ; bottom ($BD00), closing that gap too
     B900             (    forth6809.asm):00164         CODETOP  EQU  $B900     ; was $B800 - code space ceiling (data stack
                      (    forth6809.asm):00165                                  ; begins here). RESOLVED: this once no longer
                      (    forth6809.asm):00166                                  ; matched DSTACK's true occupied bottom (was
                      (    forth6809.asm):00167                                  ; $B700, a 512-byte mismatch) - now that DSTACK
                      (    forth6809.asm):00168                                  ; moved up $200 to $B900, CODETOP matches it
                      (    forth6809.asm):00169                                  ; exactly again
     7000             (    forth6809.asm):00170         APPCODE  EQU  $7000     ; was $5000 - back to its original address.
                      (    forth6809.asm):00171                                  ; RESOLVED: this once overlapped DSTACK's true
                      (    forth6809.asm):00172                                  ; range by 512 bytes ($B700-$B8FF), a direct
                      (    forth6809.asm):00173                                  ; consequence of the CODETOP/DSTACK mismatch -
                      (    forth6809.asm):00174                                  ; now that DSTACK moved and CODETOP matches it
                      (    forth6809.asm):00175                                  ; again, APPCODE's nominal range (up to
                      (    forth6809.asm):00176                                  ; CODETOP-1) no longer reaches into DSTACK
     2000             (    forth6809.asm):00177         APPDICT  EQU  $2000     ; was $015B - moved up, size unchanged (20133
                      (    forth6809.asm):00178                                  ; bytes, now $2000-$6EA4). REDUCED BUT NOT
                      (    forth6809.asm):00179                                  ; RESOLVED: still overlaps APPVARS below by 347
                      (    forth6809.asm):00180                                  ; bytes ($2000-$215A), though SIBUF/WORDBUF/
                      (    forth6809.asm):00181                                  ; TIBBUF/OUTBUF (swallowed by the previous
                      (    forth6809.asm):00182                                  ; APPDICT address) are now clear. See the
                      (    forth6809.asm):00183                                  ; open-items checklist
     021B             (    forth6809.asm):00184         APPVARS  EQU  $021B     ; grown from 256 to 8000 bytes (end now $215A,
                      (    forth6809.asm):00185                                  ; was $031A), taking the space directly from
                      (    forth6809.asm):00186                                  ; APPDICT above it; start address unchanged.
                      (    forth6809.asm):00187                                  ; That 8000-byte figure describes the original
                      (    forth6809.asm):00188                                  ; intent, not the current actual usable size -
                      (    forth6809.asm):00189                                  ; see APPVARSEND below, which now tracks
                      (    forth6809.asm):00190                                  ; APPDICT's real position instead
     1FFF             (    forth6809.asm):00191         APPVARSEND EQU APPDICT-1 ; was APPVARS+8000 ($215B) - now derives
                      (    forth6809.asm):00192                                  ; directly from wherever APPDICT actually
                      (    forth6809.asm):00193                                  ; starts, currently $1FFF (7653 bytes usable,
                      (    forth6809.asm):00194                                  ; down from the static 8000). Self-correcting:
                      (    forth6809.asm):00195                                  ; this can no longer go stale if APPDICT moves
                      (    forth6809.asm):00196                                  ; again, unlike the previous fixed-size
                      (    forth6809.asm):00197                                  ; definition. VUNUSEDW (below) is unchanged -
                      (    forth6809.asm):00198                                  ; it already computed against APPVARSEND
     01FB             (    forth6809.asm):00199         SIBUF    EQU  $01FB     ; was $0300
     01DA             (    forth6809.asm):00200         WORDBUF  EQU  $01DA     ; was $02D4
     018A             (    forth6809.asm):00201         TIBBUF   EQU  $018A     ; was $0284
     0050             (    forth6809.asm):00202         TIBBUFL  EQU  80
     0106             (    forth6809.asm):00203         SERBUF   EQU  $0106     ; was $0200 - USER0/USER1 removed entirely (see
                      (    forth6809.asm):00204                                  ; below); the 6 buffers (SERBUF's 4-byte index
                      (    forth6809.asm):00205                                  ; block, INBUF, OUTBUF, TIBBUF, WORDBUF, SIBUF)
                      (    forth6809.asm):00206                                  ; now sit contiguously right after MVSCRATCH,
                      (    forth6809.asm):00207                                  ; with no gap - this also closes a pre-existing
                      (    forth6809.asm):00208                                  ; 11-byte gap that used to sit between WORDBUF
                      (    forth6809.asm):00209                                  ; and SIBUF ($02F5-$02FF), unrelated to USER0/
                      (    forth6809.asm):00210                                  ; USER1 but caught while making this region
                      (    forth6809.asm):00211                                  ; genuinely contiguous end to end
     0106             (    forth6809.asm):00212         INHEAD   EQU  SERBUF
     0107             (    forth6809.asm):00213         INTAIL   EQU  SERBUF+1
     0108             (    forth6809.asm):00214         OUTHEAD  EQU  SERBUF+2
     0109             (    forth6809.asm):00215         OUTTAIL  EQU  SERBUF+3
     0040             (    forth6809.asm):00216         INBUFSZ  EQU  64
     0040             (    forth6809.asm):00217         OUTBUFSZ EQU  64
     010A             (    forth6809.asm):00218         INBUF    EQU  SERBUF+4
     014A             (    forth6809.asm):00219         OUTBUF   EQU  SERBUF+4+INBUFSZ
     0000             (    forth6809.asm):00220         GLOBALS  EQU  $0000
                      (    forth6809.asm):00221         
     BD00             (    forth6809.asm):00222         SP0      EQU  DSTACK+1
     C000             (    forth6809.asm):00223         RP0      EQU  RSTACK+1
                      (    forth6809.asm):00224         
                      (    forth6809.asm):00225         ; ------------------------------------------------------------
                      (    forth6809.asm):00226         ; SERIALPOLL - conditional-assembly switch for serial I/O.
                      (    forth6809.asm):00227         ; 1 (default): KEY/KEYQ/EMIT poll ACIASR directly, no interrupts,
                      (    forth6809.asm):00228         ; no ring buffers, no RTS/CTS handshaking - IRQH is a harmless RTI
                      (    forth6809.asm):00229         ; stub, matching the other unused vectors (NMIH/FIRQH/SWI2H/
                      (    forth6809.asm):00230         ; SWI3H). 0: the original interrupt-driven implementation, with
                      (    forth6809.asm):00231         ; INBUF/OUTBUF ring buffers serviced by IRQH and RTS-based flow
                      (    forth6809.asm):00232         ; control via INFILL/RTSCHECKHI/RTSCHECKLO. Uses LWASM's IFEQ/
                      (    forth6809.asm):00233         ; ELSE/ENDC (a numeric-expression test, not IFDEF/IFNDEF, since
                      (    forth6809.asm):00234         ; this is a value to compare, not a symbol's mere presence).
                      (    forth6809.asm):00235         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00236         SERIALPOLL EQU 1
                      (    forth6809.asm):00237         
                      (    forth6809.asm):00238         ; ------------------------------------------------------------
                      (    forth6809.asm):00239         ; ACIA (6850) constants - the chip sits at INOUT+8, not at the
                      (    forth6809.asm):00240         ; base of the I/O block, leaving INOUT+0..INOUT+7 free for other
                      (    forth6809.asm):00241         ; memory-mapped devices sharing this 256-byte region
                      (    forth6809.asm):00242         ; ------------------------------------------------------------
     C008             (    forth6809.asm):00243         ACIA     EQU  INOUT+8
     C008             (    forth6809.asm):00244         ACIACR   EQU  ACIA
     C008             (    forth6809.asm):00245         ACIASR   EQU  ACIA
     C009             (    forth6809.asm):00246         ACIADR   EQU  ACIA+1
     0001             (    forth6809.asm):00247         SR_RDRF  EQU  $01
     0002             (    forth6809.asm):00248         SR_TDRE  EQU  $02
     0080             (    forth6809.asm):00249         SR_IRQ   EQU  $80
     0003             (    forth6809.asm):00250         CR_RESET EQU  $03
     0095             (    forth6809.asm):00251         CR_RXON  EQU  $95
     00B5             (    forth6809.asm):00252         CR_RXTX  EQU  $B5
     0015             (    forth6809.asm):00253         CR_POLL  EQU  $15     ; bit7=0 (RX interrupt disabled), bits6-5=00 (RTS
                      (    forth6809.asm):00254                                ; low, TX interrupt disabled) - CR_RXON ($95) with
                      (    forth6809.asm):00255                                ; only the RX-interrupt-enable bit cleared. Used
                      (    forth6809.asm):00256                                ; only when SERIALPOLL=1; RTS stays permanently
                      (    forth6809.asm):00257                                ; low (asserted), since polling mode has no ring
                      (    forth6809.asm):00258                                ; buffer to overflow and so needs no flow control
     00D5             (    forth6809.asm):00259         CR_RTSHI EQU  $D5     ; bits6-5=10: RTS high, TX int disabled, RX int enabled -
                      (    forth6809.asm):00260                                ; derived from CR_RXON ($95) with bits6-5 changed from
                      (    forth6809.asm):00261                                ; 00 to 10; the ACIA has no combination offering RTS
                      (    forth6809.asm):00262                                ; high AND TX interrupt enabled simultaneously (bits6-5
                      (    forth6809.asm):00263                                ; only has 00/01/10/11, and only 01 enables TX interrupt,
                      (    forth6809.asm):00264                                ; which always ties RTS low) - EMIT/IRQH's TXCHK must
                      (    forth6809.asm):00265                                ; respect this and defer transmission while RTS is high
                      (    forth6809.asm):00266         
     0030             (    forth6809.asm):00267         INHIWATER EQU 48       ; input ring fill level (of 64) at/above which RTS is
                      (    forth6809.asm):00268                                 ; asserted high, telling the remote device to pause
     0010             (    forth6809.asm):00269         INLOWATER EQU 16        ; fill level at/below which RTS is reasserted low;
                      (    forth6809.asm):00270                                  ; deliberately well below INHIWATER (hysteresis) so
                      (    forth6809.asm):00271                                  ; RTS doesn't chatter right at a single threshold
                      (    forth6809.asm):00272         
                      (    forth6809.asm):00273         ; ------------------------------------------------------------
                      (    forth6809.asm):00274         ; Flag / opcode constants
                      (    forth6809.asm):00275         ; ------------------------------------------------------------
     FFFF             (    forth6809.asm):00276         TRUEV    EQU  $FFFF
     0000             (    forth6809.asm):00277         FALSEV   EQU  $0000
     00BD             (    forth6809.asm):00278         OPJSR    EQU  $BD
     0039             (    forth6809.asm):00279         RTSOPC   EQU  $39
                      (    forth6809.asm):00280         
                      (    forth6809.asm):00281         ; ------------------------------------------------------------
                      (    forth6809.asm):00282         ; Control-flow compile-time tags
                      (    forth6809.asm):00283         ; ------------------------------------------------------------
     0001             (    forth6809.asm):00284         TAGFWD   EQU  1
     0002             (    forth6809.asm):00285         TAGBACK  EQU  2
     0003             (    forth6809.asm):00286         TAGDO    EQU  3
     0004             (    forth6809.asm):00287         TAGCASE  EQU  4
     0005             (    forth6809.asm):00288         TAGOF    EQU  5
     0006             (    forth6809.asm):00289         TAGENDOF EQU  6
                      (    forth6809.asm):00290         
                      (    forth6809.asm):00291         ; ============================================================
                      (    forth6809.asm):00292         ; GLOBALS - real layout, applied. Every scratch/state cell
                      (    forth6809.asm):00293         ; referenced across the whole build now has a fixed address
                      (    forth6809.asm):00294         ; in page zero (DP = $00 at reset, set in COLDSTRT), laid out
                      (    forth6809.asm):00295         ; in RMB order below. Total: 256 of 256 bytes used - the page

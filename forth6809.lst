                      (    forth6809.asm):01698         ; TSTQDUPNZ - unit test for ?DUP ( n -- n n | 0 ), nonzero case.
                      (    forth6809.asm):01699         ; Verifies the nonzero value is duplicated, the guard beneath is
                      (    forth6809.asm):01700         ; undisturbed, and exactly one cell was added - same as DUP's
                      (    forth6809.asm):01701         ; own behavior for this case. ?DUP needs two tests, one per
                      (    forth6809.asm):01702         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01703         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01704         ; ------------------------------------------------------------
C18F                  (    forth6809.asm):01705         TSTQDUPNZ: STU   TSTU0
                      (    forth6809.asm):01706         

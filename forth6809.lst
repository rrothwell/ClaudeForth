                      (    forth6809.asm):05113         ; ------------------------------------------------------------
                      (    forth6809.asm):05114         ; Unsigned 16-bit division by shift and subtract. The divisor is not
                      (    forth6809.asm):05115         ; checked for zero.
                      (    forth6809.asm):05116         ; UDIV16
                      (    forth6809.asm):05117         ;    Inputs:
                      (    forth6809.asm):05118         ;        DIVNUM = dividend, DIVDEN = divisor (unsigned)
                      (    forth6809.asm):05119         ;    Outputs:
                      (    forth6809.asm):05120         ;        DIVNUM = quotient, DIVREM = remainder
                      (    forth6809.asm):05121         ;    Registers: RegD changed; DIVCNT used as the loop counter.
                      (    forth6809.asm):05122         ; ------------------------------------------------------------
EDCB 0F52             (    forth6809.asm):05123         UDIV16:     CLR   DIVREM
EDCD 0F53             (    forth6809.asm):05124                     CLR   DIVREM+1
EDCF C610             (    forth6809.asm):05125                     LDB   #16
EDD1 D754             (    forth6809.asm):05126                     STB   DIVCNT
EDD3 084F             (    forth6809.asm):05127         UD16LOOP:   ASL   DIVNUM+1
EDD5 094E             (    forth6809.asm):05128                     ROL   DIVNUM
EDD7 0953             (    forth6809.asm):05129                     ROL   DIVREM+1
EDD9 0952             (    forth6809.asm):05130                     ROL   DIVREM
EDDB DC52             (    forth6809.asm):05131                     LDD   DIVREM
EDDD 9350             (    forth6809.asm):05132                     SUBD  DIVDEN

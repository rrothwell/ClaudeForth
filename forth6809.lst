                      (    forth6809.asm):06245         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):06246         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):06247         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):06248         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):06249         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):06250         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):06251         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):06252         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):06253         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):06254         ; M*/W
                      (    forth6809.asm):06255         ;    Inputs:
                      (    forth6809.asm):06256         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):06257         ;    Outputs:
                      (    forth6809.asm):06258         ;        d2 on the data stack
                      (    forth6809.asm):06259         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):06260         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):06261         ; ------------------------------------------------------------

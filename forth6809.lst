DDF4 2731             (    forth6809.asm):02677                  BEQ   QOK
                      (    forth6809.asm):02678         
DDF6 DCF3             (    forth6809.asm):02679                  LDD   QSAVEDP
DDF8 DD06             (    forth6809.asm):02680                  STD   DPHERE
DDFA DCF5             (    forth6809.asm):02681                  LDD   QSAVECODE
DDFC DD08             (    forth6809.asm):02682                  STD   CODEHERE
DDFE DCF7             (    forth6809.asm):02683                  LDD   QSAVEVAR
DE00 DD0A             (    forth6809.asm):02684                  STD   VARHERE
DE02 DCF9             (    forth6809.asm):02685                  LDD   QSAVELATEST
DE04 DD04             (    forth6809.asm):02686                  STD   LATEST

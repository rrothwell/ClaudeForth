                      (    forth6809.asm):10030         
DEAA                  (    forth6809.asm):10031         H_FALSE:
DEAA 05               (    forth6809.asm):10032                  FCB   $05
DEAB 46414C5345       (    forth6809.asm):10033                  FCC   "FALSE"

                      (    forth6809.asm):03430         ; ------------------------------------------------------------
                      (    forth6809.asm):03431         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03432         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03433         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03434         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03435         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03436         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03437         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03438         ; follow.
                      (    forth6809.asm):03439         ; ------------------------------------------------------------
E4F0                  (    forth6809.asm):03440         KEYW:
                      (    forth6809.asm):03441                     LDA   ACIASR
                      (    forth6809.asm):03442                     BITA  #SR_RDRF
                      (    forth6809.asm):03443                     BEQ   KWAIT
                      (    forth6809.asm):03444                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):03445                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E4F0                  (    forth6809.asm):03446         KWAIT:
E4F0                  (    forth6809.asm):03447         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):03448                     BITA  #SR_RDRF
                      (    forth6809.asm):03449                     BEQ   KSPIN
E4F0                  (    forth6809.asm):03450         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03451                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03452                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03453                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03454                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):03455                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):03456                     BEQ   KGETCH
                      (    forth6809.asm):03457                     BITA  #SR_FE
                      (    forth6809.asm):03458                     BEQ   KXFE
                      (    forth6809.asm):03459                     INC   FECOUNT
E4F0                  (    forth6809.asm):03460         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):03461                     BEQ   KXOVRN
                      (    forth6809.asm):03462                     INC   OVRNCOUNT
E4F0                  (    forth6809.asm):03463         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):03464                     BEQ   KGETCH
                      (    forth6809.asm):03465                     INC   PECOUNT
E4F0                  (    forth6809.asm):03466         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):03467                     TFR   A,B
                      (    forth6809.asm):03468                     CLRA
                      (    forth6809.asm):03469                     PSHU  D                 ; char
                      (    forth6809.asm):03470                     RTS
                      (    forth6809.asm):03471         
                      (    forth6809.asm):03472         ; ------------------------------------------------------------
                      (    forth6809.asm):03473         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03474         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03475         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03476         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03477         ;    Inputs:
                      (    forth6809.asm):03478         ;        none
                      (    forth6809.asm):03479         ;    Outputs:
                      (    forth6809.asm):03480         ;        XON or XOFF transmitted
                      (    forth6809.asm):03481         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03482         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03483         ; ------------------------------------------------------------
E4F0                  (    forth6809.asm):03484         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):03485                     BRA   PUTXCH
E4F0                  (    forth6809.asm):03486         PUTXON:     LDA   #XONCH
E4F0                  (    forth6809.asm):03487         PUTXCH:     PSHS  A
E4F0                  (    forth6809.asm):03488         PXWT:       LDB   ACIASR
                      (    forth6809.asm):03489                     BITB  #SR_TDRE
                      (    forth6809.asm):03490                     BEQ   PXWT
                      (    forth6809.asm):03491                     PULS  A
                      (    forth6809.asm):03492                     STA   ACIADR
                      (    forth6809.asm):03493                     RTS
                      (    forth6809.asm):03494         
                      (    forth6809.asm):03495         ; ------------------------------------------------------------
                      (    forth6809.asm):03496         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03497         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03498         ; ------------------------------------------------------------
E4F0                  (    forth6809.asm):03499         KEYQW:      LDA   ACIASR
                      (    forth6809.asm):03500                     BITA  #SR_RDRF
                      (    forth6809.asm):03501                     BEQ   KQFALSE
                      (    forth6809.asm):03502                     LDD   #TRUEV
                      (    forth6809.asm):03503                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03504                     RTS
E4F0                  (    forth6809.asm):03505         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):03506                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03507                     RTS
                      (    forth6809.asm):03508         
                      (    forth6809.asm):03509         ; ------------------------------------------------------------
                      (    forth6809.asm):03510         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03511         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03512         ; ------------------------------------------------------------
E4F0                  (    forth6809.asm):03513         EMITW:      PULU  D                 ; char
                      (    forth6809.asm):03514                     STB   EMITCH
E4F0                  (    forth6809.asm):03515         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):03516                     BITA  #SR_TDRE
                      (    forth6809.asm):03517                     BEQ   EMITWT
                      (    forth6809.asm):03518                     LDA   EMITCH
                      (    forth6809.asm):03519                     STA   ACIADR
                      (    forth6809.asm):03520                     RTS
                      (    forth6809.asm):03521         
                      (    forth6809.asm):03522                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03523         
                      (    forth6809.asm):03524         ; ------------------------------------------------------------
                      (    forth6809.asm):03525         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03526         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03527         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03528         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03529         ; ------------------------------------------------------------
E4F0 335E             (    forth6809.asm):03530         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E4F2 CC0000           (    forth6809.asm):03531                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E4F5 EDC4             (    forth6809.asm):03532                     STD   ,U
                      (    forth6809.asm):03533         
                      (    forth6809.asm):03534                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03535                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03536                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03537                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03538                                             ; stream this line's characters
                      (    forth6809.asm):03539                     JSR   PUTXON
                      (    forth6809.asm):03540                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03541         
E4F7 BDE4C1           (    forth6809.asm):03542         ALOOP:      JSR   KEYW
E4FA 3706             (    forth6809.asm):03543                     PULU  D
E4FC 1F02             (    forth6809.asm):03544                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03545         
E4FE C10D             (    forth6809.asm):03546                     CMPB  #13
E500 274F             (    forth6809.asm):03547                     BEQ   ADONE
E502 C10A             (    forth6809.asm):03548                     CMPB  #10
E504 27F1             (    forth6809.asm):03549                     BEQ   ALOOP
E506 C108             (    forth6809.asm):03550                     CMPB  #8
E508 2724             (    forth6809.asm):03551                     BEQ   ABKSP
E50A C17F             (    forth6809.asm):03552                     CMPB  #127
E50C 2720             (    forth6809.asm):03553                     BEQ   ABKSP
                      (    forth6809.asm):03554         
E50E ECC4             (    forth6809.asm):03555                     LDD   ,U
E510 10A342           (    forth6809.asm):03556                     CMPD  2,U
E513 27E2             (    forth6809.asm):03557                     BEQ   ALOOP
                      (    forth6809.asm):03558         
E515 AE44             (    forth6809.asm):03559                     LDX   4,U
E517 308B             (    forth6809.asm):03560                     LEAX  D,X
E519 1F20             (    forth6809.asm):03561                     TFR   Y,D
E51B E784             (    forth6809.asm):03562                     STB   ,X
E51D ECC4             (    forth6809.asm):03563                     LDD   ,U
E51F C30001           (    forth6809.asm):03564                     ADDD  #1
E522 EDC4             (    forth6809.asm):03565                     STD   ,U
                      (    forth6809.asm):03566         
E524 1F20             (    forth6809.asm):03567                     TFR   Y,D
E526 4F               (    forth6809.asm):03568                     CLRA
E527 3606             (    forth6809.asm):03569                     PSHU  D
E529 BDE4E8           (    forth6809.asm):03570                     JSR   EMITW
E52C 20C9             (    forth6809.asm):03571                     BRA   ALOOP
                      (    forth6809.asm):03572         
E52E ECC4             (    forth6809.asm):03573         ABKSP:      LDD   ,U
E530 27C5             (    forth6809.asm):03574                     BEQ   ALOOP
E532 830001           (    forth6809.asm):03575                     SUBD  #1
E535 EDC4             (    forth6809.asm):03576                     STD   ,U
E537 CC0008           (    forth6809.asm):03577                     LDD   #8
E53A 3606             (    forth6809.asm):03578                     PSHU  D
E53C BDE4E8           (    forth6809.asm):03579                     JSR   EMITW
E53F CC0020           (    forth6809.asm):03580                     LDD   #32
E542 3606             (    forth6809.asm):03581                     PSHU  D
E544 BDE4E8           (    forth6809.asm):03582                     JSR   EMITW
E547 CC0008           (    forth6809.asm):03583                     LDD   #8
E54A 3606             (    forth6809.asm):03584                     PSHU  D
E54C BDE4E8           (    forth6809.asm):03585                     JSR   EMITW
E54F 20A6             (    forth6809.asm):03586                     BRA   ALOOP
                      (    forth6809.asm):03587         
E551                  (    forth6809.asm):03588         ADONE:
                      (    forth6809.asm):03589                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03590                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03591                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03592                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03593                                             ; with KEY never polled at all
                      (    forth6809.asm):03594                     JSR   PUTXOFF
                      (    forth6809.asm):03595                     ENDC                    ; <<<<<<<<<<
E551 ECC4             (    forth6809.asm):03596                     LDD   ,U
E553 ED44             (    forth6809.asm):03597                     STD   4,U               ; +n2
E555 3344             (    forth6809.asm):03598                     LEAU  4,U
E557 39               (    forth6809.asm):03599                     RTS
                      (    forth6809.asm):03600         
                      (    forth6809.asm):03601         ; ------------------------------------------------------------
                      (    forth6809.asm):03602         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03603         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03604         ; ------------------------------------------------------------
E558 BDE4F0           (    forth6809.asm):03605         EXPECTW:    JSR   ACCEPTW
E55B 3706             (    forth6809.asm):03606                     PULU  D
E55D DD3F             (    forth6809.asm):03607                     STD   SPAN
E55F 39               (    forth6809.asm):03608                     RTS
                      (    forth6809.asm):03609         
                      (    forth6809.asm):03610         ; ------------------------------------------------------------
                      (    forth6809.asm):03611         ; QUERY  ( -- )
                      (    forth6809.asm):03612         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):03613         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03614         ; to 0 and >IN to 0.
                      (    forth6809.asm):03615         ; ------------------------------------------------------------
E560 8E0106           (    forth6809.asm):03616         QUERYW:     LDX   #TIBBUF
E563 3610             (    forth6809.asm):03617                     PSHU  X
E565 CC0050           (    forth6809.asm):03618                     LDD   #TIBBUFL
E568 3606             (    forth6809.asm):03619                     PSHU  D
E56A BDE4F0           (    forth6809.asm):03620                     JSR   ACCEPTW
E56D 3706             (    forth6809.asm):03621                     PULU  D
E56F DD12             (    forth6809.asm):03622                     STD   NTIB
E571 DD3B             (    forth6809.asm):03623                     STD   SRCLEN
E573 CC0106           (    forth6809.asm):03624                     LDD   #TIBBUF
E576 DD39             (    forth6809.asm):03625                     STD   SRCADDR
E578 CC0000           (    forth6809.asm):03626                     LDD   #0
E57B DD3D             (    forth6809.asm):03627                     STD   SRCID
E57D DD10             (    forth6809.asm):03628                     STD   TOIN
E57F 39               (    forth6809.asm):03629                     RTS
                      (    forth6809.asm):03630         
                      (    forth6809.asm):03631         ; ============================================================
                      (    forth6809.asm):03632         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03633         ; ============================================================
                      (    forth6809.asm):03634         ; ------------------------------------------------------------
                      (    forth6809.asm):03635         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03636         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03637         ; one expected.
                      (    forth6809.asm):03638         ; CFERR
                      (    forth6809.asm):03639         ;    Inputs:
                      (    forth6809.asm):03640         ;        none
                      (    forth6809.asm):03641         ;    Outputs:
                      (    forth6809.asm):03642         ;        does not return (THROW -22)
                      (    forth6809.asm):03643         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03644         ; ------------------------------------------------------------
E580 CCFFEA           (    forth6809.asm):03645         CFERR:      LDD   #-22
E583 3606             (    forth6809.asm):03646                     PSHU  D                 ; -22
E585 BDE5B5           (    forth6809.asm):03647                     JSR   THROWW
E588 39               (    forth6809.asm):03648                     RTS
                      (    forth6809.asm):03649         
                      (    forth6809.asm):03650         ; ------------------------------------------------------------
                      (    forth6809.asm):03651         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03652         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03653         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03654         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03655         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03656         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03657         ; ------------------------------------------------------------
E589 3710             (    forth6809.asm):03658         CATCHW:     PULU  X                 ; xt
E58B DC0C             (    forth6809.asm):03659                     LDD   HANDLER
E58D 3406             (    forth6809.asm):03660                     PSHS  D
E58F 3440             (    forth6809.asm):03661                     PSHS  U
                      (    forth6809.asm):03662                     ; Save the input source specification.
                      (    forth6809.asm):03663                     ; See bugfix: CATCHW.1
E591 DC39             (    forth6809.asm):03664                     LDD   SRCADDR
E593 3406             (    forth6809.asm):03665                     PSHS  D
E595 DC3B             (    forth6809.asm):03666                     LDD   SRCLEN
E597 3406             (    forth6809.asm):03667                     PSHS  D
E599 DC3D             (    forth6809.asm):03668                     LDD   SRCID
E59B 3406             (    forth6809.asm):03669                     PSHS  D
E59D DC10             (    forth6809.asm):03670                     LDD   TOIN
E59F 3406             (    forth6809.asm):03671                     PSHS  D
E5A1 1F40             (    forth6809.asm):03672                     TFR   S,D
E5A3 DD0C             (    forth6809.asm):03673                     STD   HANDLER
                      (    forth6809.asm):03674         
E5A5 AD84             (    forth6809.asm):03675                     JSR   ,X
                      (    forth6809.asm):03676         
E5A7 3268             (    forth6809.asm):03677                     LEAS  8,S               ; drop saved input source
E5A9 3262             (    forth6809.asm):03678                     LEAS  2,S               ; saved U
E5AB 3506             (    forth6809.asm):03679                     PULS  D
E5AD DD0C             (    forth6809.asm):03680                     STD   HANDLER
E5AF CC0000           (    forth6809.asm):03681                     LDD   #0
E5B2 3606             (    forth6809.asm):03682                     PSHU  D                 ; 0 = no exception
E5B4 39               (    forth6809.asm):03683                     RTS
                      (    forth6809.asm):03684         
                      (    forth6809.asm):03685         ; ------------------------------------------------------------
                      (    forth6809.asm):03686         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03687         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03688         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03689         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03690         ; ------------------------------------------------------------
E5B5 3706             (    forth6809.asm):03691         THROWW:     PULU  D                 ; n
E5B7 10830000         (    forth6809.asm):03692                     CMPD  #0
E5BB 2725             (    forth6809.asm):03693                     BEQ   THDONE
                      (    forth6809.asm):03694         
E5BD DD0E             (    forth6809.asm):03695                     STD   THROWN
E5BF 9E0C             (    forth6809.asm):03696                     LDX   HANDLER
E5C1 2720             (    forth6809.asm):03697                     BEQ   THUNCAU
                      (    forth6809.asm):03698         
E5C3 1F14             (    forth6809.asm):03699                     TFR   X,S
E5C5 3506             (    forth6809.asm):03700                     PULS  D                 ; restore input source saved by CATCH
E5C7 DD10             (    forth6809.asm):03701                     STD   TOIN
E5C9 3506             (    forth6809.asm):03702                     PULS  D
E5CB DD3D             (    forth6809.asm):03703                     STD   SRCID
E5CD 3506             (    forth6809.asm):03704                     PULS  D
E5CF DD3B             (    forth6809.asm):03705                     STD   SRCLEN
E5D1 3506             (    forth6809.asm):03706                     PULS  D
E5D3 DD39             (    forth6809.asm):03707                     STD   SRCADDR
E5D5 3506             (    forth6809.asm):03708                     PULS  D
E5D7 1F03             (    forth6809.asm):03709                     TFR   D,U
E5D9 3506             (    forth6809.asm):03710                     PULS  D
E5DB DD0C             (    forth6809.asm):03711                     STD   HANDLER
                      (    forth6809.asm):03712         
E5DD DC0E             (    forth6809.asm):03713                     LDD   THROWN
E5DF 3606             (    forth6809.asm):03714                     PSHU  D
E5E1 39               (    forth6809.asm):03715                     RTS
E5E2 39               (    forth6809.asm):03716         THDONE:     RTS
                      (    forth6809.asm):03717         
                      (    forth6809.asm):03718                     ; No CATCH is active: leave n on the stack and ABORT.
E5E3 DC0E             (    forth6809.asm):03719         THUNCAU:    LDD   THROWN
E5E5 3606             (    forth6809.asm):03720                     PSHU  D
E5E7 7EDE43           (    forth6809.asm):03721                     JMP   ABORT
                      (    forth6809.asm):03722         
                      (    forth6809.asm):03723         ; ============================================================
                      (    forth6809.asm):03724         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03725         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03726         ; ============================================================
                      (    forth6809.asm):03727         ; ------------------------------------------------------------
                      (    forth6809.asm):03728         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03729         ; location.
                      (    forth6809.asm):03730         ; PATCH   ( target location -- )
                      (    forth6809.asm):03731         ;    Inputs:
                      (    forth6809.asm):03732         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03733         ;    Outputs:
                      (    forth6809.asm):03734         ;        the cell at location holds target - location
                      (    forth6809.asm):03735         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03736         ; ------------------------------------------------------------
E5EA 3710             (    forth6809.asm):03737         PATCH:      PULU  X                 ; location
E5EC 3706             (    forth6809.asm):03738                     PULU  D                 ; target
E5EE 3410             (    forth6809.asm):03739                     PSHS  X
E5F0 A3E1             (    forth6809.asm):03740                     SUBD  ,S++              ; target - location
E5F2 ED84             (    forth6809.asm):03741                     STD   ,X
E5F4 39               (    forth6809.asm):03742                     RTS
                      (    forth6809.asm):03743         
                      (    forth6809.asm):03744         ; ------------------------------------------------------------
                      (    forth6809.asm):03745         ; IF  ( C: -- orig )
                      (    forth6809.asm):03746         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03747         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
E5F5 CCDEF0           (    forth6809.asm):03749         IFW:        LDD   #ZBRANCH
E5F8 3606             (    forth6809.asm):03750                     PSHU  D
E5FA BDE9F0           (    forth6809.asm):03751                     JSR   CCALL
E5FD CC0000           (    forth6809.asm):03752                     LDD   #0
E600 3606             (    forth6809.asm):03753                     PSHU  D
E602 BDDF7A           (    forth6809.asm):03754                     JSR   CODECOMMA
E605 DC08             (    forth6809.asm):03755                     LDD   CODEHERE
E607 830002           (    forth6809.asm):03756                     SUBD  #2
E60A 3606             (    forth6809.asm):03757                     PSHU  D                 ; orig
E60C CC0001           (    forth6809.asm):03758                     LDD   #TAGFWD
E60F 3606             (    forth6809.asm):03759                     PSHU  D
E611 39               (    forth6809.asm):03760                     RTS
                      (    forth6809.asm):03761         
                      (    forth6809.asm):03762         ; ------------------------------------------------------------
                      (    forth6809.asm):03763         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03764         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):03765         ; operand to jump to the current code address.
                      (    forth6809.asm):03766         ; ------------------------------------------------------------
E612 3706             (    forth6809.asm):03767         THENW:      PULU  D
E614 10830001         (    forth6809.asm):03768                     CMPD  #TAGFWD
E618 2703             (    forth6809.asm):03769                     BEQ   THOK
E61A BDE580           (    forth6809.asm):03770                     JSR   CFERR
E61D 3710             (    forth6809.asm):03771         THOK:       PULU  X                 ; orig
E61F DC08             (    forth6809.asm):03772                     LDD   CODEHERE
E621 3606             (    forth6809.asm):03773                     PSHU  D
E623 3610             (    forth6809.asm):03774                     PSHU  X
E625 BDE5EA           (    forth6809.asm):03775                     JSR   PATCH
E628 39               (    forth6809.asm):03776                     RTS
                      (    forth6809.asm):03777         
                      (    forth6809.asm):03778         ; ------------------------------------------------------------
                      (    forth6809.asm):03779         ; ELSE  ( C: orig1 -- orig2 )
                      (    forth6809.asm):03780         ; Compile BRANCH with a placeholder operand, resolve orig1 to the
                      (    forth6809.asm):03781         ; address just after it, and leave the new operand address and TAGFWD.
                      (    forth6809.asm):03782         ; ------------------------------------------------------------
E629 3706             (    forth6809.asm):03783         ELSEW:      PULU  D

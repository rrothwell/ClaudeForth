                      (    forth6809.asm):04782         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04783         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04784         ; ============================================================
                      (    forth6809.asm):04785         ; ------------------------------------------------------------
                      (    forth6809.asm):04786         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04787         ; location.
                      (    forth6809.asm):04788         ; PATCH   ( target location -- )
                      (    forth6809.asm):04789         ;    Inputs:
                      (    forth6809.asm):04790         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04791         ;    Outputs:
                      (    forth6809.asm):04792         ;        the cell at location holds target - location
                      (    forth6809.asm):04793         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04794         ; ------------------------------------------------------------
DA79 3710             (    forth6809.asm):04795         PATCH:      PULU  X                 ; location
DA7B 3706             (    forth6809.asm):04796                     PULU  D                 ; target
DA7D 3410             (    forth6809.asm):04797                     PSHS  X
DA7F A3E1             (    forth6809.asm):04798                     SUBD  ,S++              ; target - location
DA81 ED84             (    forth6809.asm):04799                     STD   ,X
DA83 39               (    forth6809.asm):04800                     RTS
                      (    forth6809.asm):04801         
                      (    forth6809.asm):04802         ; ------------------------------------------------------------
                      (    forth6809.asm):04803         ; IF  ( C: -- orig )
                      (    forth6809.asm):04804         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04805         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04806         ; ------------------------------------------------------------

                      (    forth6809.asm):07461         
                      (    forth6809.asm):07462         ; ------------------------------------------------------------
                      (    forth6809.asm):07463         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07464         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07465         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07466         ; PARSEQUOTE
                      (    forth6809.asm):07467         ;    Inputs:
                      (    forth6809.asm):07468         ;        none (parses from >IN)
                      (    forth6809.asm):07469         ;    Outputs:
                      (    forth6809.asm):07470         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07471         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07472         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07473         ; ------------------------------------------------------------
E92B CC0022           (    forth6809.asm):07474         PARSEQUOTE: LDD   #34
E92E 3606             (    forth6809.asm):07475                     PSHU  D
E930 BDEB01           (    forth6809.asm):07476                     JSR   PARSEW

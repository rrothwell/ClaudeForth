                      (   unit_tests.asm):12679         ; TSTREPLSUBS1 - unit test for REPLACES and SUBSTITUTE together
                      (   unit_tests.asm):12680         ; (can only be meaningfully tested together - SUBSTITUTE depends
                      (   unit_tests.asm):12681         ; on a prior REPLACES registration). Registers "X"->"Z", then
                      (   unit_tests.asm):12682         ; runs the template "%%A%X%B%Y%" through SUBSTITUTE - covering
                      (   unit_tests.asm):12683         ; three of the four documented cases in one pass: "%%" collapses
                      (   unit_tests.asm):12684         ; to a single '%', "%X%" (a registered name) gets replaced
                      (   unit_tests.asm):12685         ; (count incremented), and "%Y%" (not registered) passes through
                      (   unit_tests.asm):12686         ; unchanged, delimiters included. Expected result ("%AZB%Y%",
                      (   unit_tests.asm):12687         ; count=1) independently simulated in Python against the actual
                      (   unit_tests.asm):12688         ; traced algorithm before writing this test, not hand-derived
                      (   unit_tests.asm):12689         ; and hoped correct - see TSTREPLSUBS2 for the fourth case
                      (   unit_tests.asm):12690         ; (unpaired trailing '%'), tested separately for clearer failure
                      (   unit_tests.asm):12691         ; diagnosis.
                      (   unit_tests.asm):12692         ; ------------------------------------------------------------

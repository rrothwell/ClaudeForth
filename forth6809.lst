                      (    forth6809.asm):08339                    CMPD #6
                      (    forth6809.asm):08340                    BNE  CDFAIL
                      (    forth6809.asm):08341                    PULU D
                      (    forth6809.asm):08342                    CMPD #TSTGUARD
                      (    forth6809.asm):08343                    BNE  CDFAIL
                      (    forth6809.asm):08344         
                      (    forth6809.asm):08345                    LDD  TSTUB4
                      (    forth6809.asm):08346                    SUBD TSTUAF
                      (    forth6809.asm):08347                    CMPD #2

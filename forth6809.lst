E2BA 274D             (    forth6809.asm):03068                     BEQ   EMPTY
E2BC A684             (    forth6809.asm):03069                     LDA   ,X
E2BE A1E4             (    forth6809.asm):03070                     CMPA  ,S
E2C0 2606             (    forth6809.asm):03071                     BNE   STARTW
E2C2 3001             (    forth6809.asm):03072                     LEAX  1,X
E2C4 313F             (    forth6809.asm):03073                     LEAY  -1,Y
E2C6 20EE             (    forth6809.asm):03074                     BRA   SKIPLP
                      (    forth6809.asm):03075         
E2C8 AF61             (    forth6809.asm):03076         STARTW:     STX   1,S
E2CA C600             (    forth6809.asm):03077                     LDB   #0
                      (    forth6809.asm):03078         
E2CC 108C0000         (    forth6809.asm):03079         SCANLP:     CMPY  #0
E2D0 2715             (    forth6809.asm):03080                     BEQ   ENDW
E2D2 A684             (    forth6809.asm):03081                     LDA   ,X
E2D4 A1E4             (    forth6809.asm):03082                     CMPA  ,S
E2D6 270B             (    forth6809.asm):03083                     BEQ   CONSUME
E2D8 C15A             (    forth6809.asm):03084                     CMPB  #WORDMAXCHARS     ; Length limit. See shadow: WORDW.2
E2DA 270B             (    forth6809.asm):03085                     BEQ   ENDW
E2DC 3001             (    forth6809.asm):03086                     LEAX  1,X
E2DE 313F             (    forth6809.asm):03087                     LEAY  -1,Y
E2E0 5C               (    forth6809.asm):03088                     INCB
E2E1 20E9             (    forth6809.asm):03089                     BRA   SCANLP
                      (    forth6809.asm):03090         
E2E3 3001             (    forth6809.asm):03091         CONSUME:    LEAX  1,X
E2E5 313F             (    forth6809.asm):03092                     LEAY  -1,Y

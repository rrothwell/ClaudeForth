DC1B 3002             (    forth6809.asm):05281         QDBUILD:    LEAX  2,X
DC1D CC0000           (    forth6809.asm):05282                     LDD   #0
DC20 3406             (    forth6809.asm):05283                     PSHS  D
DC22 DC16             (    forth6809.asm):05284                     LDD   MSCR2
DC24 3406             (    forth6809.asm):05285                     PSHS  D
DC26 DC14             (    forth6809.asm):05286                     LDD   MSCR
DC28 3406             (    forth6809.asm):05287                     PSHS  D

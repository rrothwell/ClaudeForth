                      (    forth6809.asm):05106         ; Unsigned 16-bit division by shift and subtract. The divisor is not
                      (    forth6809.asm):05107         ; checked for zero.
                      (    forth6809.asm):05108         ; UDIV16
                      (    forth6809.asm):05109         ;    Inputs:
                      (    forth6809.asm):05110         ;        DIVNUM = dividend, DIVDEN = divisor (unsigned)
                      (    forth6809.asm):05111         ;    Outputs:
                      (    forth6809.asm):05112         ;        DIVNUM = quotient, DIVREM = remainder
                      (    forth6809.asm):05113         ;    Registers: RegD changed; DIVCNT used as the loop counter.
                      (    forth6809.asm):05114         ; ------------------------------------------------------------

                      (    forth6809.asm):13955                   BRA  HODONE
C2C5                  (    forth6809.asm):13956         HOFAIL:   LDD  #FALSEV
C2C5                  (    forth6809.asm):13957         HODONE:   LDX  #TSTHSNAME
                      (    forth6809.asm):13958                   PSHU X
                      (    forth6809.asm):13959                   PSHU D
                      (    forth6809.asm):13960                   JSR  TSTREPORT

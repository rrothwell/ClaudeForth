                      (    forth6809.asm):00742         ; ------------------------------------------------------------
C145 BDFC2B           (    forth6809.asm):00743         TSTSTACK:  JSR   CRW
C148 8EC159           (    forth6809.asm):00744                    LDX   #TSTSTACKMSG
C14B 3610             (    forth6809.asm):00745                    PSHU  X
C14D CC0005           (    forth6809.asm):00746                    LDD   #5
C150 3606             (    forth6809.asm):00747                    PSHU  D
C152 BDF60B           (    forth6809.asm):00748                    JSR   TYPE
C155 BDFC2B           (    forth6809.asm):00749                    JSR   CRW
                      (    forth6809.asm):00750         
                      (    forth6809.asm):00751                    IFEQ TSTSELECTOR-0  ; >>>>
                      (    forth6809.asm):00752         

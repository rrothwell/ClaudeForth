                      (    forth6809.asm):02029         
     DD27             (    forth6809.asm):02030         BASELATEST EQU  H_M2   ; the ROM dictionary's true head - referenced by
                      (    forth6809.asm):02031                                   ; COLD to initialize LATEST. Was H_QUIT before
                      (    forth6809.asm):02032                                   ; FIND and the four number words (1/-1/2/-2)
                      (    forth6809.asm):02033                                   ; were chained on after it; before that,
                      (    forth6809.asm):02034                                   ; QUITHDR before the H_QUIT rename; before
                      (    forth6809.asm):02035                                   ; that, undefined entirely - a real bug, not
                      (    forth6809.asm):02036                                   ; a placeholder, found and fixed several turns
                      (    forth6809.asm):02037                                   ; before this one.
                      (    forth6809.asm):02038         
                      (    forth6809.asm):02039         ; Verify no collision with base code.
                      (    forth6809.asm):02040         ; Value should match ORG BASECODE
     DD2E             (    forth6809.asm):02041         BASEDICTEND  EQU   *
     07EB             (    forth6809.asm):02042         BASEDICTSIZE EQU   BASEDICTEND-BASEDICT
                      (    forth6809.asm):02043         
                      (    forth6809.asm):02044         ; ============================================================
                      (    forth6809.asm):02045         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02046         ; ============================================================
                      (    forth6809.asm):02047                     ORG   BASECODE  ; BASECODE is $E02A. This ORG was missing
                      (    forth6809.asm):02048                                     ; entirely - every routine from here through
                      (    forth6809.asm):02049                                     ; SECTION 26 (IRQH, COLD/ABORT/QUIT, and
                      (    forth6809.asm):02050                                     ; every primitive) would otherwise have
                      (    forth6809.asm):02051                                     ; continued growing from wherever SECTION 2's
                      (    forth6809.asm):02052                                     ; WARM message left the location counter,
                      (    forth6809.asm):02053                                     ; inside INIT's 48-byte $FFC0-$FFEF budget,
                      (    forth6809.asm):02054                                     ; overflowing directly into VECTORS ($FFF0)
                      (    forth6809.asm):02055                                     ; instead of landing in BASECODE at all
                      (    forth6809.asm):02056         
                      (    forth6809.asm):02057         ; ------------------------------------------------------------
                      (    forth6809.asm):02058         ; INITSERIAL - initializes the ACIA: master reset, then selects
                      (    forth6809.asm):02059         ; interrupt-driven or polling operation depending on SERIALPOLL.
                      (    forth6809.asm):02060         ; Extracted from COLDSTRT, which now just JSRs here - moved into
                      (    forth6809.asm):02061         ; this section so the ACIA's own init code sits next to the rest
                      (    forth6809.asm):02062         ; of its interrupt/polling logic rather than inline in COLDSTRT.
                      (    forth6809.asm):02063         ; ------------------------------------------------------------
                      (    forth6809.asm):02064         ; ------------------------------------------------------------
                      (    forth6809.asm):02065         ; SERBUFCLR - zeros all four ring-buffer pointers (INHEAD/
                      (    forth6809.asm):02066         ; INTAIL/OUTHEAD/OUTTAIL, the four bytes of SERBUF) plus
                      (    forth6809.asm):02067         ; RTSSTATE, plus (added alongside IRQH's new receiver-error
                      (    forth6809.asm):02068         ; counting) FECOUNT/OVRNCOUNT/PECOUNT, so a cold or warm boot
                      (    forth6809.asm):02069         ; always starts those three counts at zero rather than whatever
                      (    forth6809.asm):02070         ; MAME's/real RAM's arbitrary startup contents happened to hold -
                      (    forth6809.asm):02071         ; same reasoning as the OUTHEAD/OUTTAIL bug fix described below.
                      (    forth6809.asm):02072         ; BUG FIX: the code this replaced (formerly inline in
                      (    forth6809.asm):02073         ; COLDSTRT) only ever cleared INHEAD/INTAIL (2 of SERBUF's own 4
                      (    forth6809.asm):02074         ; bytes) - OUTHEAD/OUTTAIL were never zeroed at all, even on a
                      (    forth6809.asm):02075         ; cold boot, meaning the TX ring buffer could start from
                      (    forth6809.asm):02076         ; whatever arbitrary contents MAME's own RAM happened to hold
                      (    forth6809.asm):02077         ; (MAME does not guarantee zeroed RAM on start), a real,
                      (    forth6809.asm):02078         ; independent, latent risk of exactly the kind of "transmit
                      (    forth6809.asm):02079         ; buffer appears full immediately" spin-wait lockup separately
                      (    forth6809.asm):02080         ; observed and reported. Called from INITSERIAL itself (below),
                      (    forth6809.asm):02081         ; so both COLDSTRT's own existing call and WARM's new one (see
                      (    forth6809.asm):02082         ; WARM's own comment) share this single, complete reset point -
                      (    forth6809.asm):02083         ; not duplicated logic in either place.
                      (    forth6809.asm):02084         ; ------------------------------------------------------------
                      (    forth6809.asm):02085         
DD2E 7F0176           (    forth6809.asm):02086         SERBUFCLR:  CLR  INHEAD
DD31 7F0177           (    forth6809.asm):02087                     CLR  INTAIL
DD34 7F0178           (    forth6809.asm):02088                     CLR  RTSSTATE    ; $00 = RTS Low (Clear)
DD37 7F0179           (    forth6809.asm):02089                     CLR  OUTHEAD
DD3A 7F017A           (    forth6809.asm):02090                     CLR  OUTTAIL
DD3D 7F017B           (    forth6809.asm):02091                     CLR  OUTACTIVITY  ; $00 = Idle
                      (    forth6809.asm):02092         
                      (    forth6809.asm):02093         
DD40 7F017C           (    forth6809.asm):02094                     CLR  FECOUNT
DD43 7F017D           (    forth6809.asm):02095                     CLR  OVRNCOUNT
DD46 7F017E           (    forth6809.asm):02096                     CLR  PECOUNT
DD49 7F017F           (    forth6809.asm):02097                     CLR  POLLREADYCNT
DD4C 39               (    forth6809.asm):02098                     RTS
                      (    forth6809.asm):02099         
DD4D BDDD2E           (    forth6809.asm):02100         INITSERIAL: JSR  SERBUFCLR
DD50 9603             (    forth6809.asm):02101                     LDA   CR_RESET    ; Master Software Reset command to 6850
DD52 B7C008           (    forth6809.asm):02102                     STA   ACIACR 
DD55 12               (    forth6809.asm):02103                     NOP               ; Settling Delay
DD56 12               (    forth6809.asm):02104                     NOP
                      (    forth6809.asm):02105                     
                      (    forth6809.asm):02106                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02107                     LDA   #CR_RXON        ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02108                     ELSE  ; <<<<<>>>>>
DD57 8615             (    forth6809.asm):02109                     LDA   #CR_POLL        ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02110                     ENDC  ; <<<<<<<<<<
DD59 B7C008           (    forth6809.asm):02111                     STA   ACIACR         ; was "STA ACIA" - same fix
DD5C 39               (    forth6809.asm):02112                     RTS
                      (    forth6809.asm):02113         
                      (    forth6809.asm):02114                     IFEQ SERIALPOLL  ; >>>>>>>>>>
                      (    forth6809.asm):02115         ; ------------------------------------------------------------
                      (    forth6809.asm):02116         ; INFILL - ( -- A=fill level, 0-63 ) input ring's current fill
                      (    forth6809.asm):02117         ; level. INBUFSZ is a power of two, and both indices are always
                      (    forth6809.asm):02118         ; kept in 0..INBUFSZ-1, so a plain masked subtraction gives the
                      (    forth6809.asm):02119         ; true mod-64 distance even across the wrap point.
                      (    forth6809.asm):02120         ; ------------------------------------------------------------
DD5D                  (    forth6809.asm):02121         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02122                     SUBA  INTAIL
                      (    forth6809.asm):02123                     ANDA  #INBUFSZ-1
                      (    forth6809.asm):02124                     RTS
                      (    forth6809.asm):02125         ; ------------------------------------------------------------
                      (    forth6809.asm):02126         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):02127         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):02128         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):02129         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):02130         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):02131         ; has no automatic tie to reception; this is ordinary firmware
                      (    forth6809.asm):02132         ; flow control, not a chip feature.
                      (    forth6809.asm):02133         ; ------------------------------------------------------------
DD5D                  (    forth6809.asm):02134         RTSCHECKHI: JSR  INFILL
                      (    forth6809.asm):02135                     CMPA #INHIWATER
                      (    forth6809.asm):02136                     BLO  RTSCHIDONE
                      (    forth6809.asm):02137                     TST  RTSSTATE
                      (    forth6809.asm):02138                     BNE  RTSCHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02139                     LDA  #CR_RTSHI
                      (    forth6809.asm):02140                     STA  ACIACR
                      (    forth6809.asm):02141                     LDA  #1
                      (    forth6809.asm):02142                     STA  RTSSTATE
DD5D                  (    forth6809.asm):02143         RTSCHIDONE: RTS
                      (    forth6809.asm):02144         ; ------------------------------------------------------------
DD5D                  (    forth6809.asm):02145         UPDATE_RTS:
                      (    forth6809.asm):02146                     TST   RTSSTATE
                      (    forth6809.asm):02147                     BNE   SET_RTS_HI_TX_OFF      
                      (    forth6809.asm):02148         
                      (    forth6809.asm):02149                     TST   OUTACTIVITY           ; Is active?
                      (    forth6809.asm):02150                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02151         
                      (    forth6809.asm):02152                                           ; $B5/%1011_0101
                      (    forth6809.asm):02153                     LDA   #CR_RXTX        ; Yes! Accept input & transmit output
                      (    forth6809.asm):02154                     BRA   WRITE_CR        ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02155         
DD5D                  (    forth6809.asm):02156         SET_RTS_LO_TX_OFF:                ; $95/%10010101
                      (    forth6809.asm):02157                     LDA   #CR_RXON        ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02158                     BRA   WRITE_CR        ; Why is OUTACTIVITY not updated here?
                      (    forth6809.asm):02159         
DD5D                  (    forth6809.asm):02160         SET_RTS_HI_TX_OFF:                ; $D5/%1101_0101
                      (    forth6809.asm):02161                     LDA   #CR_RTSHI       ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02162                     CLR   OUTACTIVITY     ; Interrupts are hardware-disabled; clear state
DD5D                  (    forth6809.asm):02163         WRITE_CR:
                      (    forth6809.asm):02164                     STA   ACIACR
                      (    forth6809.asm):02165                     RTS
                      (    forth6809.asm):02166         ; ------------------------------------------------------------
                      (    forth6809.asm):02167         ; CHKHI/CHKLO - replace the old combined CHKWATERLEVEL. That
                      (    forth6809.asm):02168         ; routine always paid for a TST RTSSTATE/BNE to pick a
                      (    forth6809.asm):02169         ; direction (hi vs lo) before checking either watermark - but
                      (    forth6809.asm):02170         ; the direction picked never actually depended on which caller
                      (    forth6809.asm):02171         ; was asking, only on the current RTSSTATE, and each caller
                      (    forth6809.asm):02172         ; only ever moves fill one way: INCHAR (via CHKHI) only ever
                      (    forth6809.asm):02173         ; adds to the ring, so only the hi threshold can ever usefully
                      (    forth6809.asm):02174         ; fire from that side; GETCHAR (via CHKLO) only ever drains it,
                      (    forth6809.asm):02175         ; so only the lo threshold can fire from that side. Whenever
                      (    forth6809.asm):02176         ; the old routing sent a caller into the "wrong" branch for its
                      (    forth6809.asm):02177         ; own direction (e.g. INCHAR landing in CHK_LO while RTSSTATE
                      (    forth6809.asm):02178         ; was REJECT), the comparison was provably always a no-op from
                      (    forth6809.asm):02179         ; that caller - the fill level only ever moves the way that
                      (    forth6809.asm):02180         ; caller pushes it, so the other threshold's condition can't
                      (    forth6809.asm):02181         ; newly become true there. Splitting into two direction-fixed
                      (    forth6809.asm):02182         ; routines removes that dead branch+comparison from both
                      (    forth6809.asm):02183         ; callers, and both take the current fill level pre-computed in
                      (    forth6809.asm):02184         ; RegB rather than reloading INHEAD/INTAIL themselves, so a
                      (    forth6809.asm):02185         ; caller that already has one of the two pointers in a register
                      (    forth6809.asm):02186         ; (see INCHAR) doesn't pay for a redundant reload.
                      (    forth6809.asm):02187         ; ------------------------------------------------------------
DD5D                  (    forth6809.asm):02188         CHKHI:
                      (    forth6809.asm):02189                     CMPB  #INHIWATER      ; Is the buffer near full?
                      (    forth6809.asm):02190                     BLO   CHKHIDONE       ; No! Do nothing.
                      (    forth6809.asm):02191                     TST   RTSSTATE
                      (    forth6809.asm):02192                     BNE   CHKHIDONE       ; already high - nothing to do
                      (    forth6809.asm):02193                     LDA   #INREJECT       ; Yes! De-assert RTS.
                      (    forth6809.asm):02194                     STA   RTSSTATE
                      (    forth6809.asm):02195                     JSR   UPDATE_RTS
DD5D                  (    forth6809.asm):02196         CHKHIDONE:  RTS
                      (    forth6809.asm):02197         
DD5D                  (    forth6809.asm):02198         CHKLO:
                      (    forth6809.asm):02199                     CMPB  #INLOWATER      ; Is the buffer near empty?
                      (    forth6809.asm):02200                     BHS   CHKLODONE       ; No! Do nothing.
                      (    forth6809.asm):02201                     TST   RTSSTATE
                      (    forth6809.asm):02202                     BEQ   CHKLODONE       ; already low - nothing to do
                      (    forth6809.asm):02203                     LDA   #INACCEPT       ; Yes! Assert RTS.
                      (    forth6809.asm):02204                     STA   RTSSTATE
                      (    forth6809.asm):02205                     JSR   UPDATE_RTS
DD5D                  (    forth6809.asm):02206         CHKLODONE:  RTS
                      (    forth6809.asm):02207         ; ------------------------------------------------------------
                      (    forth6809.asm):02208         ; BUG FIX: this used to loop internally (BRA back to the top)
                      (    forth6809.asm):02209         ; until the whole OUTBUF drained or CTS blocked - an unbounded
                      (    forth6809.asm):02210         ; spin of up to ~64 characters (~5.5ms at 115200 baud). In
                      (    forth6809.asm):02211         ; practice only one character was ever observed to be processed
                      (    forth6809.asm):02212         ; per call anyway (TDRE is rarely ready again this soon after
                      (    forth6809.asm):02213         ; sending), so this now makes that explicit: sends at most ONE
                      (    forth6809.asm):02214         ; character per call and returns unconditionally, whatever the
                      (    forth6809.asm):02215         ; reason (buffer empty, CTS-blocked, TDRE not ready yet, or a
                      (    forth6809.asm):02216         ; character actually sent - including the TDRE-not-ready case,
                      (    forth6809.asm):02217         ; which used to spin-wait right here and now instead just
                      (    forth6809.asm):02218         ; returns to try again on the next call). Every caller (KEY,
                      (    forth6809.asm):02219         ; PUTCHAR) already calls this once per character it handles on
                      (    forth6809.asm):02220         ; its own side, so the buffer still drains at essentially the
                      (    forth6809.asm):02221         ; same rate - this removes the unbounded worst case and the
                      (    forth6809.asm):02222         ; TDRE spin-wait, without changing normal-case throughput.

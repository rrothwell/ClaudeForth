                      (    forth6809.asm):01846         ;    Inputs:
                      (    forth6809.asm):01847         ;        none
                      (    forth6809.asm):01848         ;    Outputs:
                      (    forth6809.asm):01849         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):01850         ;    Registers: RegA, RegB and CC changed.

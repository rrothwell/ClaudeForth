F7C3 3706             (    forth6809.asm):06933         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F7C5 DDAB             (    forth6809.asm):06934                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):06935                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):06936                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):06937                                   ; real source length was misread as an
                      (    forth6809.asm):06938                                   ; address, the real source address was never
                      (    forth6809.asm):06939                                   ; popped at all, and the true destination
                      (    forth6809.asm):06940                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):06941                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):06942                                   ; c-addr2 (dest) is on top, popped first.
F7C7 3706             (    forth6809.asm):06943                    PULU D         ; next: u1 (source length)
F7C9 DDA9             (    forth6809.asm):06944                    STD  UESRCLEN
F7CB 3706             (    forth6809.asm):06945                    PULU D         ; next: c-addr1 (source address)
F7CD DDA7             (    forth6809.asm):06946                    STD  UEADDR
F7CF CC0000           (    forth6809.asm):06947                    LDD  #0
F7D2 DDAD             (    forth6809.asm):06948                    STD  UEOUTLEN

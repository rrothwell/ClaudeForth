                      (    forth6809.asm):07292         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):07293         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):07294         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):07295         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):07296         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):07297         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;

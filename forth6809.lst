                      (    forth6809.asm):14992         ; ------------------------------------------------------------
                      (    forth6809.asm):14993         ; Base/Radix Control test harness (glossary section 3.14). All
                      (    forth6809.asm):14994         ; four words are pure state-setting/reading with no I/O
                      (    forth6809.asm):14995         ; involved, so none of this section's tests need the
                      (    forth6809.asm):14996         ; SERIALPOLL-conditional complexity used throughout the printing
                      (    forth6809.asm):14997         ; sections. Combined into one test, given each word's own
                      (    forth6809.asm):14998         ; effect is trivially verified by reading BASE directly - four
                      (    forth6809.asm):14999         ; separate tests would just repeat the same save/set/verify/
                      (    forth6809.asm):15000         ; restore shape four times over. TSTBASAV (added in section
                      (    forth6809.asm):15001         ; 3.13, when the real, pre-COLD BASE=0 bug was found and fixed)
                      (    forth6809.asm):15002         ; is reused here to save/restore the real BASE across this test
                      (    forth6809.asm):15003         ; too, per the same established reasoning.
                      (    forth6809.asm):15004         ; ------------------------------------------------------------
                      (    forth6809.asm):15005         
                      (    forth6809.asm):15006         ; ------------------------------------------------------------
                      (    forth6809.asm):15007         ; TSTBASE - combined unit test for BASE, DECIMAL, HEX, and
                      (    forth6809.asm):15008         ; BINARY. Sets BASE via each of HEX/BINARY/DECIMAL in turn,
                      (    forth6809.asm):15009         ; verifying the correct value lands each time, then calls BASE
                      (    forth6809.asm):15010         ; itself and verifies both that it returns the variable's own
                      (    forth6809.asm):15011         ; address (not its value, per "( -- addr )") and that reading
                      (    forth6809.asm):15012         ; through that address reflects DECIMAL's own, most recent
                      (    forth6809.asm):15013         ; setting (10).
                      (    forth6809.asm):15014         ; ------------------------------------------------------------
C2EB                  (    forth6809.asm):15015         TSTBASE: LDD  BASE
                      (    forth6809.asm):15016                  STD  TSTBASAV
                      (    forth6809.asm):15017         
                      (    forth6809.asm):15018                  STU  TSTU0
                      (    forth6809.asm):15019         
                      (    forth6809.asm):15020                  JSR  HEXW
                      (    forth6809.asm):15021                  LDD  BASE
                      (    forth6809.asm):15022                  CMPD #16
                      (    forth6809.asm):15023                  BNE  BSFAIL
                      (    forth6809.asm):15024         
                      (    forth6809.asm):15025                  JSR  BINARYW
                      (    forth6809.asm):15026                  LDD  BASE
                      (    forth6809.asm):15027                  CMPD #2
                      (    forth6809.asm):15028                  BNE  BSFAIL
                      (    forth6809.asm):15029         
                      (    forth6809.asm):15030                  JSR  DECIMAL
                      (    forth6809.asm):15031                  LDD  BASE
                      (    forth6809.asm):15032                  CMPD #10
                      (    forth6809.asm):15033                  BNE  BSFAIL
                      (    forth6809.asm):15034         
                      (    forth6809.asm):15035                  LDD  #TSTGUARD
                      (    forth6809.asm):15036                  PSHU D
                      (    forth6809.asm):15037                  STU  TSTUB4
                      (    forth6809.asm):15038         
                      (    forth6809.asm):15039                  JSR  BASEW
                      (    forth6809.asm):15040         
                      (    forth6809.asm):15041                  STU  TSTUAF
                      (    forth6809.asm):15042         
                      (    forth6809.asm):15043                  PULU D
                      (    forth6809.asm):15044                  CMPD #BASE
                      (    forth6809.asm):15045                  BNE  BSFAIL
                      (    forth6809.asm):15046         
                      (    forth6809.asm):15047                  TFR  D,X
                      (    forth6809.asm):15048                  LDD  ,X
                      (    forth6809.asm):15049                  CMPD #10
                      (    forth6809.asm):15050                  BNE  BSFAIL
                      (    forth6809.asm):15051         
                      (    forth6809.asm):15052                  PULU D
                      (    forth6809.asm):15053                  CMPD #TSTGUARD
                      (    forth6809.asm):15054                  BNE  BSFAIL
                      (    forth6809.asm):15055         
                      (    forth6809.asm):15056                  LDD  TSTUB4
                      (    forth6809.asm):15057                  SUBD TSTUAF
                      (    forth6809.asm):15058                  CMPD #2
                      (    forth6809.asm):15059                  BNE  BSFAIL
                      (    forth6809.asm):15060         
                      (    forth6809.asm):15061                  LDD  #TRUEV
                      (    forth6809.asm):15062                  BRA  BSDONE
C2EB                  (    forth6809.asm):15063         BSFAIL:  LDD  #FALSEV
C2EB                  (    forth6809.asm):15064         BSDONE:  LDX  #TSTBSNAME
                      (    forth6809.asm):15065                  PSHU X
                      (    forth6809.asm):15066                  PSHU D
                      (    forth6809.asm):15067                  JSR  TSTREPORT
                      (    forth6809.asm):15068         
                      (    forth6809.asm):15069                  LDD  TSTBASAV
                      (    forth6809.asm):15070                  STD  BASE

                      (    forth6809.asm):04001         ; ------------------------------------------------------------
                      (    forth6809.asm):04002         ; PUTXON / PUTXOFF - polling-mode software flow control. Sends
                      (    forth6809.asm):04003         ; XON/XOFF as raw bytes straight to the ACIA, busy-waiting on
                      (    forth6809.asm):04004         ; TDRE exactly like EMIT's own EMITWT, but bypassing the data
                      (    forth6809.asm):04005         ; stack (U) and EMIT/EMITCH entirely - only A/B/S are touched, so
                      (    forth6809.asm):04006         ; either is safe to call from ACCEPT at any point without
                      (    forth6809.asm):04007         ; disturbing whatever's on U. See ACCEPT for where these are
                      (    forth6809.asm):04008         ; called: XON at the start of every line (the host may stream
                      (    forth6809.asm):04009         ; characters continuously while ACCEPT's own tight loop is
                      (    forth6809.asm):04010         ; polling), XOFF the instant a line is complete (CR seen), before
                      (    forth6809.asm):04011         ; handing off to INTERPRET/compilation - which does arbitrary,
                      (    forth6809.asm):04012         ; variable-length work with KEY never polled at all, exactly the
                      (    forth6809.asm):04013         ; window where a host that kept sending would build up a backlog
                      (    forth6809.asm):04014         ; this polling build (with no ring buffer to hold it) has no way
                      (    forth6809.asm):04015         ; to recover from correctly.
                      (    forth6809.asm):04016         ; ------------------------------------------------------------

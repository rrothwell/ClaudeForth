                      (    forth6809.asm):03217         ; Multiply the unsigned double UDHI:UDLO by BASE and add a digit.
                      (    forth6809.asm):03218         ; UDMULADD
                      (    forth6809.asm):03219         ;    Inputs:
                      (    forth6809.asm):03220         ;        UDHI:UDLO = ud
                      (    forth6809.asm):03221         ;        RegB = digit value to add
                      (    forth6809.asm):03222         ;        BASE
                      (    forth6809.asm):03223         ;    Outputs:
                      (    forth6809.asm):03224         ;        UDHI:UDLO = ud * BASE + digit
                      (    forth6809.asm):03225         ;    Registers: RegA, RegB and CC changed; CARRY and MULBASE used as
                      (    forth6809.asm):03226         ;        scratch.

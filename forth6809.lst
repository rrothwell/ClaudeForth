                      (    forth6809.asm):08610         ; ============================================================
                      (    forth6809.asm):08611         ; SECTION 27: FORTH DICTIONARY (ROM base dictionary headers)
                      (    forth6809.asm):08612         ; Every primitive word in the Glossary gets a real header here,
                      (    forth6809.asm):08613         ; chained via LINK, living in BASEDICT ($D83F-$E006, an exact fit
                      (    forth6809.asm):08614         ; for this dictionary's 1992 bytes - was $E000-$E7FF). CFA points
                      (    forth6809.asm):08615         ; directly at each primitive's own code label for every entry -
                      (    forth6809.asm):08616         ; these are all raw code entries, CFA = the label itself,
                      (    forth6809.asm):08617         ; including TRUE and FALSE (added in a later pass, chain's newest
                      (    forth6809.asm):08618         ; entries before H_ABORT/H_QUIT below), which originally used the
                      (    forth6809.asm):08619         ; DODOES-trampoline pattern matching interactive CONSTANT, but are
                      (    forth6809.asm):08620         ; now simple LDD/PSHU/RTS subroutines like everything else here -
                      (    forth6809.asm):08621         ; see TRUEBODY/FALSEBODY, section 26, for the current code and why
                      (    forth6809.asm):08622         ; they no longer need indirection.
                      (    forth6809.asm):08623         ;
                      (    forth6809.asm):08624         ; DOES> is included (H_DOESGT) - added in a follow-up pass after
                      (    forth6809.asm):08625         ; the original 214-entry generation flagged it as missing, then
                      (    forth6809.asm):08626         ; moved again so it sits immediately after CREATE in the chain
                      (    forth6809.asm):08627         ; (H_CREATE -> H_DOESGT -> H_VARIABLE) rather than at the chain's
                      (    forth6809.asm):08628         ; newest end, since the two words are tightly coupled and read
                      (    forth6809.asm):08629         ; better adjacent. SETDOES (the runtime it compiles a call to)
                      (    forth6809.asm):08630         ; lives beside DODOES/DOESRT0; DOESGT is DOES>'s code label,
                      (    forth6809.asm):08631         ; since a literal ">" is not valid in a 6809 assembler label.
                      (    forth6809.asm):08632         ;
                      (    forth6809.asm):08633         ; H_ABORT and H_QUIT (formerly ABORTHDR/QUITHDR, renamed to match
                      (    forth6809.asm):08634         ; this file's H_ naming convention) are hand-built, not produced
                      (    forth6809.asm):08635         ; by the same generation pass as the other 217 entries - see the
                      (    forth6809.asm):08636         ; note where they're defined, at the end of this section, for why
                      (    forth6809.asm):08637         ; HEADER/CREATE couldn't be used directly for these two. They used
                      (    forth6809.asm):08638         ; to live physically apart from the rest of the dictionary, inside
                      (    forth6809.asm):08639         ; BASECODE rather than BASEDICT, despite being header data rather
                      (    forth6809.asm):08640         ; than code - moved here so every header lives in one place and
                      (    forth6809.asm):08641         ; the chain (H_QUIT -> H_ABORT -> (newest entry below) -> ... ->
                      (    forth6809.asm):08642         ; (oldest entry) -> 0) is visible in one block. BASELATEST remains
                      (    forth6809.asm):08643         ; H_QUIT, the chain's true overall head.
                      (    forth6809.asm):08644         ;
                      (    forth6809.asm):08645         ; H_ABORT's LINK field, a placeholder 0 since it was first built,
                      (    forth6809.asm):08646         ; is resolved here: it now points to this chain's newest entry.
                      (    forth6809.asm):08647         ;
                      (    forth6809.asm):08648         ; Names containing a literal double-quote (S", .", ABORT") have
                      (    forth6809.asm):08649         ; that character split into a standalone FCB $22 rather than
                      (    forth6809.asm):08650         ; escaped inside FCC - see emit_name's comment for why.
                      (    forth6809.asm):08651         ; ============================================================

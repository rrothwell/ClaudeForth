                      (    forth6809.asm):04005         ; ------------------------------------------------------------
                      (    forth6809.asm):04006         ; DEFINITIONS  ( -- )
                      (    forth6809.asm):04007         ; Make the first wordlist of the search order the one that receives new
                      (    forth6809.asm):04008         ; definitions. Throws -50 when the search order is empty.
                      (    forth6809.asm):04009         ; ------------------------------------------------------------
D6C3                  (    forth6809.asm):04010         DEFINITIONSW:

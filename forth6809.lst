                      (   unit_tests.asm):06184         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (   unit_tests.asm):06185         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (   unit_tests.asm):06186         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (   unit_tests.asm):06187         ; by summing it via + each iteration - a wrong index sequence
                      (   unit_tests.asm):06188         ; (off-by-one, wrong direction, wrong starting value) would
                      (   unit_tests.asm):06189         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (   unit_tests.asm):06190         ; just "some number of iterations happened."
                      (   unit_tests.asm):06191         ;
                      (   unit_tests.asm):06192         ; The documented limit=index edge case (runs at least once) is
                      (   unit_tests.asm):06193         ; deliberately NOT tested here: traced precisely (simulated the
                      (   unit_tests.asm):06194         ; real DOTEST increment-and-compare-equal logic) and confirmed
                      (   unit_tests.asm):06195         ; it takes a full 65536 iterations to naturally reconverge on
                      (   unit_tests.asm):06196         ; equality, not one - true to the letter of "at least once" but
                      (   unit_tests.asm):06197         ; impractical for a boot-time self-check. Left untested, not
                      (   unit_tests.asm):06198         ; guessed at; noted in the open-items checklist.
                      (   unit_tests.asm):06199         ; ------------------------------------------------------------

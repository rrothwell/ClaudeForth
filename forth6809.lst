                      (    forth6809.asm):01601         ; ------------------------------------------------------------
                      (    forth6809.asm):01602         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01603         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01604         ; INITSERIAL
                      (    forth6809.asm):01605         ;    Inputs:
                      (    forth6809.asm):01606         ;        none
                      (    forth6809.asm):01607         ;    Outputs:
                      (    forth6809.asm):01608         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01609         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01610         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01611         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01612         ; ------------------------------------------------------------
DC0F BDDBF0           (    forth6809.asm):01613         INITSERIAL: JSR   SERBUFCLR
DC12 8603             (    forth6809.asm):01614                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
DC14 B7C008           (    forth6809.asm):01615                     STA   ACIACR
DC17 12               (    forth6809.asm):01616                     NOP                     ; Settling Delay
DC18 12               (    forth6809.asm):01617                     NOP
                      (    forth6809.asm):01618         
                      (    forth6809.asm):01619                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
DC19 8695             (    forth6809.asm):01620                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01621                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):01622                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01623                     ENDC                    ; <<<<<<<<<<
DC1B B7C008           (    forth6809.asm):01624                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DC1E 39               (    forth6809.asm):01625                     RTS
                      (    forth6809.asm):01626         
                      (    forth6809.asm):01627                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01628         ; ------------------------------------------------------------
                      (    forth6809.asm):01629         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01630         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01631         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01632         ; INFILL
                      (    forth6809.asm):01633         ;    Inputs:
                      (    forth6809.asm):01634         ;        none
                      (    forth6809.asm):01635         ;    Outputs:
                      (    forth6809.asm):01636         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01637         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01638         ; ------------------------------------------------------------
DC1F B60176           (    forth6809.asm):01639         INFILL:     LDA   INHEAD
DC22 B00177           (    forth6809.asm):01640                     SUBA  INTAIL
DC25 843F             (    forth6809.asm):01641                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
DC27 39               (    forth6809.asm):01642                     RTS
                      (    forth6809.asm):01643         ; ------------------------------------------------------------
                      (    forth6809.asm):01644         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01645         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01646         ; receive path with interrupts already masked.
                      (    forth6809.asm):01647         ; RTSCHECKHI
                      (    forth6809.asm):01648         ;    Inputs:

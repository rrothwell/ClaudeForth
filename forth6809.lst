                      (    forth6809.asm):02822                    BNE   TZFAIL
                      (    forth6809.asm):02823         
                      (    forth6809.asm):02824                    LDD   TSTUB4
                      (    forth6809.asm):02825                    SUBD  TSTUAF
                      (    forth6809.asm):02826                    CMPD  #0
                      (    forth6809.asm):02827                    BNE   TZFAIL
                      (    forth6809.asm):02828         
                      (    forth6809.asm):02829                    LDD   #TRUEV
                      (    forth6809.asm):02830                    BRA   TZDONE

F87D A680             (    forth6809.asm):13892                    LDA  ,X+
F87F 8125             (    forth6809.asm):13893                    CMPA #'%'
F881 2604             (    forth6809.asm):13894                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):13895                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):13896                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):13897                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):13898                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):13899                                   ; the same string correctly, since this runs
                      (    forth6809.asm):13900                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):13901         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):13902                                   ; every character, '%' or not

D570 20B5             (    forth6809.asm):03524                     BRA   ILOOP
                      (    forth6809.asm):03525         
D572                  (    forth6809.asm):03526         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03527                                             ; ANS's (ud1) stack order directly.
D572 DC00             (    forth6809.asm):03528                     LDD   STATE
D574 27B1             (    forth6809.asm):03529                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03530                                             ; nothing more to do
                      (    forth6809.asm):03531                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03532                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03533                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03534                     ; pop it aside first, freeing UDLO to be compiled first.
D576 3706             (    forth6809.asm):03535                     PULU  D

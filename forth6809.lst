                      (   unit_tests.asm):06861         ; TSTCASE1 - unit test for CASE/OF/ENDOF/ENDCASE, matching
                      (   unit_tests.asm):06862         ; clause. Compiles
                      (   unit_tests.asm):06863         ; "CASE 1 LITERAL OF 111 LITERAL ENDOF
                      (   unit_tests.asm):06864         ;       2 LITERAL OF 222 LITERAL ENDOF ENDCASE"
                      (   unit_tests.asm):06865         ; with selector=2, matching the second clause. Traced by hand:
                      (   unit_tests.asm):06866         ; OF compiles OVER/=/ZBRANCH<placeholder>/DROP - the DROP only
                      (   unit_tests.asm):06867         ; runs on a match, consuming the selector; ENDOF compiles an
                      (   unit_tests.asm):06868         ; unconditional branch past the remaining clauses AND patches
                      (   unit_tests.asm):06869         ; its own OF's placeholder to the next clause's OF; ENDCASE
                      (   unit_tests.asm):06870         ; patches every pending ENDOF branch to the true end and
                      (   unit_tests.asm):06871         ; compiles a final fallback DROP for the no-match case.
                      (   unit_tests.asm):06872         ; ------------------------------------------------------------

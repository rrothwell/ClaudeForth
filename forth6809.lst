                      (    forth6809.asm):04229         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04230         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04231         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04232         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04233         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04234         ;    Inputs:
                      (    forth6809.asm):04235         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04236         ;    Outputs:
                      (    forth6809.asm):04237         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04238         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04239         ;        scratch.
                      (    forth6809.asm):04240         ; ------------------------------------------------------------
E840 3706             (    forth6809.asm):04241         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E842 DD29             (    forth6809.asm):04242                     STD   MSCR              ; MSCR = step
E844 EC66             (    forth6809.asm):04243                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E846 262D             (    forth6809.asm):04244                     BNE   DPTEXIT           ; set: exit
E848 EC62             (    forth6809.asm):04245                     LDD   2,S               ; old index
E84A A364             (    forth6809.asm):04246                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
E84C DD2B             (    forth6809.asm):04247                     STD   MSCR2
E84E EC62             (    forth6809.asm):04248                     LDD   2,S
E850 D329             (    forth6809.asm):04249                     ADDD  MSCR              ; new_index = old_index + step
E852 ED62             (    forth6809.asm):04250                     STD   2,S
E854 A364             (    forth6809.asm):04251                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
E856 DD2D             (    forth6809.asm):04252                     STD   MSCR3
                      (    forth6809.asm):04253                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):04254                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):04255                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
E858 DC29             (    forth6809.asm):04256                     LDD   MSCR              ; reload the step to test its sign
E85A 2B09             (    forth6809.asm):04257                     BMI   DPNEG
E85C DC2D             (    forth6809.asm):04258         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u

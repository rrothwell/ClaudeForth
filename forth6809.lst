                      (    forth6809.asm):03371                    JSR   TSTUMSZ
                      (    forth6809.asm):03372                    JSR   TSTMSTAR
                      (    forth6809.asm):03373                    JSR   TSTFMSM
                      (    forth6809.asm):03374                    JSR   TSTFMSZ
                      (    forth6809.asm):03375                    JSR   TSTSMRM
                      (    forth6809.asm):03376                    JSR   TSTSMRZ
                      (    forth6809.asm):03377                    JSR   TSTDPLUS
                      (    forth6809.asm):03378                    JSR   TSTDMIN2
                      (    forth6809.asm):03379                    JSR   TSTDNEG
                      (    forth6809.asm):03380                    JSR   TSTDABS1

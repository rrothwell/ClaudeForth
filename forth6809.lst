                      (    forth6809.asm):07783         ; DOCSTR
                      (    forth6809.asm):07784         ;    Outputs:
                      (    forth6809.asm):07785         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):07786         ;        the string

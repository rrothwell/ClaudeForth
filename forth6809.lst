                      (    forth6809.asm):05099         ; MOD  ( n1 n2 -- n3 )
                      (    forth6809.asm):05100         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05101         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05102         ; zero.
                      (    forth6809.asm):05103         ; ------------------------------------------------------------

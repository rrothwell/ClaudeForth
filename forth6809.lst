                      (    forth6809.asm):00336         ; ------------------------------------------------------------
                      (    forth6809.asm):00337         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00338         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00339         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00340         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00341         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00342         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00343         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00344         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00345         ;
                      (    forth6809.asm):00346         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00347         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00348         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00349         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00350         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00351         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00352         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00353         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00354         ; ------------------------------------------------------------
                      (    forth6809.asm):00355                     ORG   $0100
0100                  (    forth6809.asm):00356         MVCNT       RMB   2
0102                  (    forth6809.asm):00357         MVDST       RMB   2
0104                  (    forth6809.asm):00358         MVSRC       RMB   2
     0100             (    forth6809.asm):00359         HSLEN       EQU   MVCNT
     0102             (    forth6809.asm):00360         HSADDR      EQU   MVDST
     0104             (    forth6809.asm):00361         MRESULT     EQU   MVSRC
     0104             (    forth6809.asm):00362         FILLCHR     EQU   MVSRC
                      (    forth6809.asm):00363         
                      (    forth6809.asm):00364         ; ------------------------------------------------------------
                      (    forth6809.asm):00365         ; Ring buffers for serial communications.
                      (    forth6809.asm):00366         ; One for input, one for output.
                      (    forth6809.asm):00367         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00368         ; The tricks are not used.
                      (    forth6809.asm):00369         ; ------------------------------------------------------------
                      (    forth6809.asm):00370                     ORG   SERBUFCTL         ; $176.
                      (    forth6809.asm):00371         
0176                  (    forth6809.asm):00372         INHEAD      RMB   1
0177                  (    forth6809.asm):00373         INTAIL      RMB   1
                      (    forth6809.asm):00374         ; Open question moved to shadow: RTSSTATE.1
0178                  (    forth6809.asm):00375         RTSSTATE    RMB   1                 ; $00 = RTS low, $FF = RTS high
                      (    forth6809.asm):00376         
0179                  (    forth6809.asm):00377         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00378         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00379         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00380         
017C                  (    forth6809.asm):00381         FECOUNT     RMB   1                 ; framing errors
017D                  (    forth6809.asm):00382         OVRNCOUNT   RMB   1                 ; overrun count, same as above
017E                  (    forth6809.asm):00383         PECOUNT     RMB   1                 ; parity-error count, same as above
017F                  (    forth6809.asm):00384         POLLREADYCNT
017F                  (    forth6809.asm):00385                     RMB   1                 ; polling build; see shadow POLLREADYCNT.1
                      (    forth6809.asm):00386         
                      (    forth6809.asm):00387                     ORG   SERBUF            ; $180, a 64 byte boundary.
                      (    forth6809.asm):00388         
                      (    forth6809.asm):00389                     ALIGN 64                ; Force 64-byte boundary alignment
0180                  (    forth6809.asm):00390         INBUF       RMB   INBUFSZ           ; Receive circular queue buffer
                      (    forth6809.asm):00391         
                      (    forth6809.asm):00392                     ALIGN 64                ; Force 64-byte boundary alignment
01C0                  (    forth6809.asm):00393         OUTBUF      RMB   OUTBUFSZ          ; Transmit circular queue buffer
                      (    forth6809.asm):00394         

                      (    forth6809.asm):15177                     CMPD #0
                      (    forth6809.asm):15178                     BNE  COFAIL
                      (    forth6809.asm):15179                     PULU D
                      (    forth6809.asm):15180                     CMPD #TSTVAL1
                      (    forth6809.asm):15181                     BNE  COFAIL
                      (    forth6809.asm):15182                     PULU D

                      (    forth6809.asm):07619         ; TSTTHENZ - unit test for THEN, tag-mismatch case. Pushes a
                      (    forth6809.asm):07620         ; wrong value (0, matching none of TAGFWD/TAGBACK/TAGDO/TAGOF)
                      (    forth6809.asm):07621         ; in place of the expected TAGFWD, then calls THEN via CATCH.
                      (    forth6809.asm):07622         ; CFERR (confirmed by reading it directly) throws -22
                      (    forth6809.asm):07623         ; immediately without ever touching CODEHERE - the error path
                      (    forth6809.asm):07624         ; never reaches any compiling code - so this needs no CODEHERE
                      (    forth6809.asm):07625         ; redirect, unlike every other test in this section. Same
                      (    forth6809.asm):07626         ; CATCH-based pattern as the divide-by-zero tests in earlier
                      (    forth6809.asm):07627         ; sections: verify the thrown code and CATCH's own depth-
                      (    forth6809.asm):07628         ; restoration contract, not the unspecified i*x values.
                      (    forth6809.asm):07629         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):07630         TSTTHENZ: STU  TSTU0
                      (    forth6809.asm):07631         
                      (    forth6809.asm):07632                   LDD  #0
                      (    forth6809.asm):07633                   PSHU D
                      (    forth6809.asm):07634                   LDD  #0
                      (    forth6809.asm):07635                   PSHU D
                      (    forth6809.asm):07636                   LDX  #THEN
                      (    forth6809.asm):07637                   PSHU X

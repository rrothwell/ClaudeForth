                      (   unit_tests.asm):01878         ; ------------------------------------------------------------
                      (   unit_tests.asm):01879         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (   unit_tests.asm):01880         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (   unit_tests.asm):01881         ; then retrieves the original via R> (verifying R@ genuinely
                      (   unit_tests.asm):01882         ; left it there undisturbed, not just that R@ itself returned
                      (   unit_tests.asm):01883         ; the right value once) - confirming "non-destructive" for real,
                      (   unit_tests.asm):01884         ; not assumed from the name.
                      (   unit_tests.asm):01885         ; ------------------------------------------------------------
C1BA                  (   unit_tests.asm):01886         TSTRFETCH: STU  TSTU0
                      (   unit_tests.asm):01887         
                      (   unit_tests.asm):01888                    LDD  #TSTGUARD
                      (   unit_tests.asm):01889                    PSHU D
                      (   unit_tests.asm):01890                    LDD  #TSTVAL1
                      (   unit_tests.asm):01891                    PSHU D
                      (   unit_tests.asm):01892                    STU  TSTUB4
                      (   unit_tests.asm):01893         
                      (   unit_tests.asm):01894                    JSR  TOR
                      (   unit_tests.asm):01895                    JSR  RFETCH
                      (   unit_tests.asm):01896                    JSR  FROMR
                      (   unit_tests.asm):01897         
                      (   unit_tests.asm):01898                    STU  TSTUAF
                      (   unit_tests.asm):01899         
                      (   unit_tests.asm):01900                    PULU D
                      (   unit_tests.asm):01901                    CMPD #TSTVAL1
                      (   unit_tests.asm):01902                    BNE  RFFAIL
                      (   unit_tests.asm):01903                    PULU D
                      (   unit_tests.asm):01904                    CMPD #TSTVAL1
                      (   unit_tests.asm):01905                    BNE  RFFAIL
                      (   unit_tests.asm):01906                    PULU D
                      (   unit_tests.asm):01907                    CMPD #TSTGUARD
                      (   unit_tests.asm):01908                    BNE  RFFAIL
                      (   unit_tests.asm):01909         
                      (   unit_tests.asm):01910                    LDD  TSTUB4
                      (   unit_tests.asm):01911                    SUBD TSTUAF
                      (   unit_tests.asm):01912                    CMPD #2
                      (   unit_tests.asm):01913                    BNE  RFFAIL
                      (   unit_tests.asm):01914         
                      (   unit_tests.asm):01915                    LDD  #TRUEV
                      (   unit_tests.asm):01916                    BRA  RFDONE
C1BA                  (   unit_tests.asm):01917         RFFAIL:    LDD  #FALSEV
C1BA                  (   unit_tests.asm):01918         RFDONE:    LDX  #TSTRFETCHNAME
                      (   unit_tests.asm):01919                    PSHU X
                      (   unit_tests.asm):01920                    PSHU D
                      (   unit_tests.asm):01921                    JSR  TSTREPORT
                      (   unit_tests.asm):01922         
                      (   unit_tests.asm):01923                    LDU  TSTU0
                      (   unit_tests.asm):01924                    RTS
                      (   unit_tests.asm):01925         
C1BA                  (   unit_tests.asm):01926         TSTRFETCHNAME: FCB  9
                      (   unit_tests.asm):01927                        FCC  "TSTRFETCH"
                      (   unit_tests.asm):01928         
                      (   unit_tests.asm):01929         ; ------------------------------------------------------------

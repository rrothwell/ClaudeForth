                      (    forth6809.asm):10417                     FCC  "TSTPOSTPONE2"
                      (    forth6809.asm):10418         
                      (    forth6809.asm):10419         ; ------------------------------------------------------------
                      (    forth6809.asm):10420         ; TSTTOBODY - unit test for >BODY. Already used extensively as
                      (    forth6809.asm):10421         ; an internal helper throughout section 3.9's DEFER@/DEFER!/TO/
                      (    forth6809.asm):10422         ; IS tests, but gets its own dedicated test here too.
                      (    forth6809.asm):10423         ;
                      (    forth6809.asm):10424         ; BUG FIX: this test originally assumed TOBODY returns xt+5
                      (    forth6809.asm):10425         ; itself (a pure address computation) - wrong, confirmed via
                      (    forth6809.asm):10426         ; MAME: TOBODY computes xt+5, then DEREFERENCES it ("LDD ,X"),
                      (    forth6809.asm):10427         ; returning the VALUE stored there, not the address itself. This
                      (    forth6809.asm):10428         ; is genuinely correct behavior for this system's own trampoline
                      (    forth6809.asm):10429         ; design, not a bug in TOBODY - reconciled directly against why
                      (    forth6809.asm):10430         ; section 3.9's DEFER@/DEFER!/TO/IS tests, which relied on this
                      (    forth6809.asm):10431         ; same TOBODY and passed on real hardware, never surfaced this:
                      (    forth6809.asm):10432         ; those tests set up real trampolines (via VALUEW/DEFERW) whose
                      (    forth6809.asm):10433         ; own compile-time code stores a genuinely meaningful value at
                      (    forth6809.asm):10434         ; xt+5 (for DEFER, the current target xt; for VALUE, the stored
                      (    forth6809.asm):10435         ; value) - "the body" for this system's own design IS the value
                      (    forth6809.asm):10436         ; at xt+5, not xt+5's own address. This test never initialized
                      (    forth6809.asm):10437         ; TSTCBUF+5 to anything at all, so it was comparing against
                      (    forth6809.asm):10438         ; whatever garbage happened to already be there - now sets a
                      (    forth6809.asm):10439         ; known value there first and verifies TOBODY returns exactly
                      (    forth6809.asm):10440         ; that.
                      (    forth6809.asm):10441         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):10442         TSTTOBODY: LDD  #TSTVAL1
                      (    forth6809.asm):10443                    STD  TSTCBUF+5
                      (    forth6809.asm):10444         
                      (    forth6809.asm):10445                    STU  TSTU0
                      (    forth6809.asm):10446         
                      (    forth6809.asm):10447                    LDD  #TSTGUARD
                      (    forth6809.asm):10448                    PSHU D
                      (    forth6809.asm):10449                    LDD  #TSTCBUF
                      (    forth6809.asm):10450                    PSHU D
                      (    forth6809.asm):10451                    STU  TSTUB4
                      (    forth6809.asm):10452         
                      (    forth6809.asm):10453                    JSR  TOBODY
                      (    forth6809.asm):10454         
                      (    forth6809.asm):10455                    STU  TSTUAF
                      (    forth6809.asm):10456         
                      (    forth6809.asm):10457                    PULU D
                      (    forth6809.asm):10458                    CMPD #TSTVAL1
                      (    forth6809.asm):10459                    BNE  TBFAIL
                      (    forth6809.asm):10460                    PULU D
                      (    forth6809.asm):10461                    CMPD #TSTGUARD
                      (    forth6809.asm):10462                    BNE  TBFAIL
                      (    forth6809.asm):10463         
                      (    forth6809.asm):10464                    LDD  TSTUB4
                      (    forth6809.asm):10465                    SUBD TSTUAF
                      (    forth6809.asm):10466                    CMPD #0
                      (    forth6809.asm):10467                    BNE  TBFAIL
                      (    forth6809.asm):10468         
                      (    forth6809.asm):10469                    LDD  #TRUEV
                      (    forth6809.asm):10470                    BRA  TBDONE
C26F                  (    forth6809.asm):10471         TBFAIL:    LDD  #FALSEV
C26F                  (    forth6809.asm):10472         TBDONE:    LDX  #TSTTBNAME
                      (    forth6809.asm):10473                    PSHU X
                      (    forth6809.asm):10474                    PSHU D
                      (    forth6809.asm):10475                    JSR  TSTREPORT
                      (    forth6809.asm):10476         
                      (    forth6809.asm):10477                    LDU  TSTU0
                      (    forth6809.asm):10478                    RTS
                      (    forth6809.asm):10479         
C26F                  (    forth6809.asm):10480         TSTTBNAME: FCB  9
                      (    forth6809.asm):10481                    FCC  "TSTTOBODY"
                      (    forth6809.asm):10482         
                      (    forth6809.asm):10483         ; ------------------------------------------------------------
                      (    forth6809.asm):10484         ; TSTEXECUTE - unit test for EXECUTE. Executes DUP via its own
                      (    forth6809.asm):10485         ; xt with a known value, confirming it genuinely behaves like
                      (    forth6809.asm):10486         ; DUP - not just that the call returned.
                      (    forth6809.asm):10487         ; ------------------------------------------------------------
C26F                  (    forth6809.asm):10488         TSTEXECUTE: STU  TSTU0
                      (    forth6809.asm):10489         
                      (    forth6809.asm):10490                     LDD  #TSTGUARD
                      (    forth6809.asm):10491                     PSHU D

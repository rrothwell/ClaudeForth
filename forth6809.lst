                      (    forth6809.asm):02951         ; ============================================================
                      (    forth6809.asm):02952         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02953         ; ============================================================
                      (    forth6809.asm):02954         ; ------------------------------------------------------------
                      (    forth6809.asm):02955         ; INTERPRET  ( -- )
                      (    forth6809.asm):02956         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02957         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02958         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02959         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02960         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02961         ; ------------------------------------------------------------
E274                  (    forth6809.asm):02962         INTERPRET:
E274 CC0020           (    forth6809.asm):02963         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1

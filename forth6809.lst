                      (    forth6809.asm):07555         
                      (    forth6809.asm):07556                   LDD  #1
                      (    forth6809.asm):07557                   PSHU D
                      (    forth6809.asm):07558                   JSR  LITERALW
                      (    forth6809.asm):07559                   JSR  OF
                      (    forth6809.asm):07560                   LDD  #111
                      (    forth6809.asm):07561                   PSHU D
                      (    forth6809.asm):07562                   JSR  LITERALW
                      (    forth6809.asm):07563                   JSR  ENDOF
                      (    forth6809.asm):07564         
                      (    forth6809.asm):07565                   LDD  #2
                      (    forth6809.asm):07566                   PSHU D
                      (    forth6809.asm):07567                   JSR  LITERALW
                      (    forth6809.asm):07568                   JSR  OF
                      (    forth6809.asm):07569                   LDD  #222
                      (    forth6809.asm):07570                   PSHU D
                      (    forth6809.asm):07571                   JSR  LITERALW
                      (    forth6809.asm):07572                   JSR  ENDOF
                      (    forth6809.asm):07573         
                      (    forth6809.asm):07574                   JSR  ENDCASE
                      (    forth6809.asm):07575         
                      (    forth6809.asm):07576                   LDD  #OPRTS
                      (    forth6809.asm):07577                   PSHU D
                      (    forth6809.asm):07578                   JSR  CCOMMA
                      (    forth6809.asm):07579         
                      (    forth6809.asm):07580                   LDD  TSTCSAV
                      (    forth6809.asm):07581                   STD  CODEHERE
                      (    forth6809.asm):07582         
                      (    forth6809.asm):07583                   STU  TSTU0
                      (    forth6809.asm):07584         
                      (    forth6809.asm):07585                   LDD  #TSTGUARD
                      (    forth6809.asm):07586                   PSHU D
                      (    forth6809.asm):07587                   LDD  #99
                      (    forth6809.asm):07588                   PSHU D
                      (    forth6809.asm):07589                   STU  TSTUB4
                      (    forth6809.asm):07590         
                      (    forth6809.asm):07591                   JSR  TSTCBUF
                      (    forth6809.asm):07592         
                      (    forth6809.asm):07593                   STU  TSTUAF
                      (    forth6809.asm):07594         
                      (    forth6809.asm):07595                   PULU D
                      (    forth6809.asm):07596                   CMPD #TSTGUARD
                      (    forth6809.asm):07597                   BNE  C2FAIL
                      (    forth6809.asm):07598         
                      (    forth6809.asm):07599                   LDD  TSTUB4
                      (    forth6809.asm):07600                   SUBD TSTUAF
                      (    forth6809.asm):07601                   CMPD #-2
                      (    forth6809.asm):07602                   BNE  C2FAIL
                      (    forth6809.asm):07603         
                      (    forth6809.asm):07604                   LDD  #TRUEV
                      (    forth6809.asm):07605                   BRA  C2DONE
C23C                  (    forth6809.asm):07606         C2FAIL:   LDD  #FALSEV
C23C                  (    forth6809.asm):07607         C2DONE:   LDX  #TSTCASE2NAME
                      (    forth6809.asm):07608                   PSHU X
                      (    forth6809.asm):07609                   PSHU D
                      (    forth6809.asm):07610                   JSR  TSTREPORT
                      (    forth6809.asm):07611         

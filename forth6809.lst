                      (    forth6809.asm):05736                                   ; capping every interpreted S" string at 32
                      (    forth6809.asm):05737                                   ; characters and (worse) shared identically
                      (    forth6809.asm):05738                                   ; by every S" call, so a second S" call before
                      (    forth6809.asm):05739                                   ; the first string was actually used (e.g.
                      (    forth6809.asm):05740                                   ; registering two REPLACES strings, or a
                      (    forth6809.asm):05741                                   ; SUBSTITUTE template argument) silently
                      (    forth6809.asm):05742                                   ; overwrote the first - confirmed via MAME
                      (    forth6809.asm):05743                                   ; testing and traced precisely earlier this
                      (    forth6809.asm):05744                                   ; session. Retired per user's own follow-up
                      (    forth6809.asm):05745                                   ; testing/design decision: rather than give
                      (    forth6809.asm):05746                                   ; REPLACES its own dedicated copy-on-register
                      (    forth6809.asm):05747                                   ; storage, wrap each string in its own colon
                      (    forth6809.asm):05748                                   ; definition for stable storage instead - but
                      (    forth6809.asm):05749                                   ; that still leaves interpreted S" itself
                      (    forth6809.asm):05750                                   ; capped at SIBUF's 32 characters for any
                      (    forth6809.asm):05751                                   ; single string. Now computes PAD's current
                      (    forth6809.asm):05752                                   ; address fresh via PADW (dynamic - depends
                      (    forth6809.asm):05753                                   ; on CODEHERE, per ANS's own transient-region
                      (    forth6809.asm):05754                                   ; semantics) and writes there instead, giving
                      (    forth6809.asm):05755                                   ; interpreted S" access to PAD's full
                      (    forth6809.asm):05756                                   ; PADMINSIZE-character region (84, comfortably
                      (    forth6809.asm):05757                                   ; above the old 32-character SIBUF limit) -
                      (    forth6809.asm):05758                                   ; SIBUF itself is now unused and retired (see
                      (    forth6809.asm):05759                                   ; the GLOBALS layout notes above).

                      (    forth6809.asm):07972         ; TSTCONST - unit test for CONSTANT. Compiles "5 CONSTANT
                      (    forth6809.asm):07973         ; TESTWD" (5 already pushed before CONSTANT runs, matching its
                      (    forth6809.asm):07974         ; own "x name --" signature) into scratch, then executes the
                      (    forth6809.asm):07975         ; result. Verifies it pushes the stored value (5), not its own
                      (    forth6809.asm):07976         ; address - confirmed by tracing CONSTANT's own behavior field:
                      (    forth6809.asm):07977         ; it compiles a raw address to ATSIGN (@) there directly via
                      (    forth6809.asm):07978         ; CODECOMMA, not CREATE's own placeholder mechanism.
                      (    forth6809.asm):07979         ; ------------------------------------------------------------
C25B                  (    forth6809.asm):07980         TSTCONST: LDD  CODEHERE

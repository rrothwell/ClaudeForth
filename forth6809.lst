                      (    forth6809.asm):03239                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03240                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03241                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03242                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03243                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03244                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03245                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03246                   ; high cell.
E5B0 0D22             (    forth6809.asm):03247                   TST   NUMNEG
E5B2 2718             (    forth6809.asm):03248                   BEQ   NQPOS32
E5B4 DC76             (    forth6809.asm):03249                   LDD   UDLO
E5B6 43               (    forth6809.asm):03250                   COMA
E5B7 53               (    forth6809.asm):03251                   COMB
E5B8 C30001           (    forth6809.asm):03252                   ADDD  #1
E5BB DD76             (    forth6809.asm):03253                   STD   UDLO
E5BD 3401             (    forth6809.asm):03254                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03255                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03256                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03257                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03258                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03259                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03260                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03261                                      ; making the high-cell increment run
                      (    forth6809.asm):03262                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03263                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03264                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03265                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03266                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03267                                      ; matching "always increment" rather than
                      (    forth6809.asm):03268                                      ; "increment only on genuine carry".
E5BF DC74             (    forth6809.asm):03269                   LDD   UDHI
E5C1 43               (    forth6809.asm):03270                   COMA
E5C2 53               (    forth6809.asm):03271                   COMB
E5C3 3501             (    forth6809.asm):03272                   PULS  CC          ; restore the TRUE carry
E5C5 2403             (    forth6809.asm):03273                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03274                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03275                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03276                                      ; value was computed in D but never
                      (    forth6809.asm):03277                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03278                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03279                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03280                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03281                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03282                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03283                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03284                                      ; alone would have made this second,
                      (    forth6809.asm):03285                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03286                                      ; only past the "+1", never past the
                      (    forth6809.asm):03287                                      ; store itself - the store always runs,
                      (    forth6809.asm):03288                                      ; either way.

F35F 3710             (    forth6809.asm):06379         CSTOREW:    PULU  X                 ; c-addr
F361 3706             (    forth6809.asm):06380                     PULU  D                 ; char
F363 E784             (    forth6809.asm):06381                     STB   ,X
F365 39               (    forth6809.asm):06382                     RTS

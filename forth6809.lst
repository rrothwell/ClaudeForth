                      (    forth6809.asm):02260                    PULU  D
                      (    forth6809.asm):02261                    CMPD  #TSTVAL3
                      (    forth6809.asm):02262                    BNE   RLFAIL
                      (    forth6809.asm):02263                    PULU  D
                      (    forth6809.asm):02264                    CMPD  #TSTVAL2
                      (    forth6809.asm):02265                    BNE   RLFAIL
                      (    forth6809.asm):02266                    PULU  D
                      (    forth6809.asm):02267                    CMPD  #TSTGUARD
                      (    forth6809.asm):02268                    BNE   RLFAIL
                      (    forth6809.asm):02269         
                      (    forth6809.asm):02270                    LDD   TSTUB4
                      (    forth6809.asm):02271                    SUBD  TSTUAF
                      (    forth6809.asm):02272                    CMPD  #-2
                      (    forth6809.asm):02273                    BNE   RLFAIL
                      (    forth6809.asm):02274         

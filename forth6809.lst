                      (    forth6809.asm):01185                   BNE  SCFAIL
                      (    forth6809.asm):01186         
                      (    forth6809.asm):01187                   LDD  TSTUB4
                      (    forth6809.asm):01188                   SUBD TSTUAF
                      (    forth6809.asm):01189                   CMPD #0
                      (    forth6809.asm):01190                   BNE  SCFAIL
                      (    forth6809.asm):01191         
                      (    forth6809.asm):01192                   LDD  #TRUEV
                      (    forth6809.asm):01193                   BRA  SCDONE
C17F                  (    forth6809.asm):01194         SCFAIL:   LDD  #FALSEV
C17F                  (    forth6809.asm):01195         SCDONE:  LDX  #TSTSPACENAME
                      (    forth6809.asm):01196                   PSHU X
                      (    forth6809.asm):01197                   PSHU D

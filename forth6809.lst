E50C DC62             (    forth6809.asm):03287                     LDD   UDLO
E50E DD4B             (    forth6809.asm):03288                     STD   PRODLO
E510 DC60             (    forth6809.asm):03289                     LDD   UDHI
E512 DD49             (    forth6809.asm):03290                     STD   PRODHI
E514 BDEECD           (    forth6809.asm):03291                     JSR   MNEG32            ; shared negate. See bugfix: NUMBERQ.5
E517 DC4B             (    forth6809.asm):03292                     LDD   PRODLO
E519 DD62             (    forth6809.asm):03293                     STD   UDLO
E51B DC49             (    forth6809.asm):03294                     LDD   PRODHI
E51D DD60             (    forth6809.asm):03295                     STD   UDHI
                      (    forth6809.asm):03296         
E51F                  (    forth6809.asm):03297         NQPOS32:                            ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03298                     ; was '.' - determines which return convention to use
E51F 9E1F             (    forth6809.asm):03299                     LDX   CADDR
E521 E684             (    forth6809.asm):03300                     LDB   ,X
E523 5A               (    forth6809.asm):03301                     DECB
E524 3001             (    forth6809.asm):03302                     LEAX  1,X

DED4 FF43             (    forth6809.asm):05655                  FDB   ONEBODY
                      (    forth6809.asm):05656         
DED6 02               (    forth6809.asm):05657         H_M1:    FCB   2
DED7 2D31             (    forth6809.asm):05658                  FCC   "-1"
DED9 DED0             (    forth6809.asm):05659                  FDB   H_1
DEDB FF49             (    forth6809.asm):05660                  FDB   MONEBODY
                      (    forth6809.asm):05661         

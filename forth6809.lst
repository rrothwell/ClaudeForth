                      (    forth6809.asm):01717         ; TSTQDUPNZ - unit test for ?DUP ( n -- n n | 0 ), nonzero case.
                      (    forth6809.asm):01718         ; Verifies the nonzero value is duplicated, the guard beneath is
                      (    forth6809.asm):01719         ; undisturbed, and exactly one cell was added - same as DUP's
                      (    forth6809.asm):01720         ; own behavior for this case. ?DUP needs two tests, one per
                      (    forth6809.asm):01721         ; condition, since DUP-like and no-op are genuinely different
                      (    forth6809.asm):01722         ; code paths (QDUP branches on the popped value).
                      (    forth6809.asm):01723         ; ------------------------------------------------------------
C19B                  (    forth6809.asm):01724         TSTQDUPNZ: STU   TSTU0
                      (    forth6809.asm):01725         

                      (    forth6809.asm):04380         ; ============================================================
                      (    forth6809.asm):04381         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04382         ; ============================================================
                      (    forth6809.asm):04383                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04384         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04385         
                      (    forth6809.asm):04386         ; ------------------------------------------------------------
                      (    forth6809.asm):04387         ; KEY  ( -- char )
                      (    forth6809.asm):04388         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04389         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04390         ; ------------------------------------------------------------
D8A7                  (    forth6809.asm):04391         KEYACIA:
                      (    forth6809.asm):04392         
D8A7 7D0178           (    forth6809.asm):04393                     TST   RTSSTATE          ; Is throttling?
D8AA 2703             (    forth6809.asm):04394                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04395         
                      (    forth6809.asm):04396                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
D8AC BDCE1E           (    forth6809.asm):04397                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04398                                             ; by transmitting all chars.
                      (    forth6809.asm):04399         
D8AF                  (    forth6809.asm):04400         TRY_READ:
D8AF BDCE8B           (    forth6809.asm):04401                     JSR   GETCHAR           ; Is char available in input buffer.
D8B2 25F3             (    forth6809.asm):04402                     BCS   KEYACIA           ; No? Try again to receive a char,
                      (    forth6809.asm):04403                                             ; while still transmitting!
                      (    forth6809.asm):04404         
D8B4 1F89             (    forth6809.asm):04405                     TFR   A,B               ; Move char result to Reg B (LSB of D)
D8B6 4F               (    forth6809.asm):04406                     CLRA                    ; Clear MSB.
D8B7 3606             (    forth6809.asm):04407                     PSHU  D                 ; char
                      (    forth6809.asm):04408         
D8B9 39               (    forth6809.asm):04409                     RTS
                      (    forth6809.asm):04410         
                      (    forth6809.asm):04411         ; ------------------------------------------------------------
                      (    forth6809.asm):04412         ; KEY?  ( -- flag )
                      (    forth6809.asm):04413         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04414         ; ------------------------------------------------------------
D8BA                  (    forth6809.asm):04415         KEYQACIA:
                      (    forth6809.asm):04416                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04417         
D8BA B60176           (    forth6809.asm):04418                     LDA   INHEAD            ; Characters received?
D8BD B10177           (    forth6809.asm):04419                     CMPA  INTAIL
                      (    forth6809.asm):04420         
                      (    forth6809.asm):04421                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04422         
D8C0 2606             (    forth6809.asm):04423                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04424         
D8C2 CC0000           (    forth6809.asm):04425                     LDD   #FALSEV           ; No! Return false result.
D8C5 3606             (    forth6809.asm):04426                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04427         
D8C7 39               (    forth6809.asm):04428                     RTS
                      (    forth6809.asm):04429         
D8C8                  (    forth6809.asm):04430         KQTRUE:
D8C8 CCFFFF           (    forth6809.asm):04431                     LDD   #TRUEV            ; Yes! Return true result.
D8CB 3606             (    forth6809.asm):04432                     PSHU  D                 ; flag = true
D8CD 39               (    forth6809.asm):04433                     RTS
                      (    forth6809.asm):04434         
                      (    forth6809.asm):04435         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04436         
                      (    forth6809.asm):04437         ; ------------------------------------------------------------
                      (    forth6809.asm):04438         ; EMIT  ( char -- )
                      (    forth6809.asm):04439         ; Transmit char through PUTCHAR (the output ring). When the ring is
                      (    forth6809.asm):04440         ; full EMIT waits for room, so no character is lost however fast the
                      (    forth6809.asm):04441         ; caller produces output. The wait needs the transmit interrupt to be
                      (    forth6809.asm):04442         ; able to run, so EMIT must not be called with interrupts masked, nor
                      (    forth6809.asm):04443         ; from an interrupt handler. See shadow EMITACIA.1.
                      (    forth6809.asm):04444         ; ------------------------------------------------------------
D8CE                  (    forth6809.asm):04445         EMITACIA:
D8CE 3706             (    forth6809.asm):04446                     PULU  D                 ; char
D8D0 3404             (    forth6809.asm):04447                     PSHS  B                 ; keep it while waiting
D8D2 F60179           (    forth6809.asm):04448         EMWAIT:     LDB   OUTHEAD           ; Is there room for one more?
D8D5 5C               (    forth6809.asm):04449                     INCB
D8D6 C43F             (    forth6809.asm):04450                     ANDB  #OUTBUFSZ-1
D8D8 F1017A           (    forth6809.asm):04451                     CMPB  OUTTAIL
D8DB 2610             (    forth6809.asm):04452                     BNE   EMROOM            ; Yes!
D8DD 7D0178           (    forth6809.asm):04453                     TST   RTSSTATE          ; No! Is the transmit interrupt running?
D8E0 27F0             (    forth6809.asm):04454                     BEQ   EMWAIT            ; Yes! It will make room.
D8E2 3401             (    forth6809.asm):04455                     PSHS  CC                ; RTS is high so the transmit interrupt
D8E4 1A50             (    forth6809.asm):04456                     ORCC  #$50              ; is off: send one character by polling,
D8E6 BDCE1E           (    forth6809.asm):04457                     JSR   FLUSHOUTBUFFER    ; as PUTCHAR does.
D8E9 3501             (    forth6809.asm):04458                     PULS  CC
D8EB 20E5             (    forth6809.asm):04459                     BRA   EMWAIT
D8ED 3502             (    forth6809.asm):04460         EMROOM:     PULS  A                 ; char
D8EF BDCE40           (    forth6809.asm):04461                     JSR   PUTCHAR           ; Transmit char.
D8F2 39               (    forth6809.asm):04462                     RTS
                      (    forth6809.asm):04463         
                      (    forth6809.asm):04464                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04465         ; ------------------------------------------------------------
                      (    forth6809.asm):04466         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04467         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04468         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04469         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04470         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04471         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04472         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04473         ; follow.
                      (    forth6809.asm):04474         ; ------------------------------------------------------------
D8F3                  (    forth6809.asm):04475         KEYACIA:
                      (    forth6809.asm):04476                     LDA   ACIASR
                      (    forth6809.asm):04477                     BITA  #SR_RDRF
                      (    forth6809.asm):04478                     BEQ   KWAIT
                      (    forth6809.asm):04479                     INC   POLLREADYCNT      ; character was already queued when we
                      (    forth6809.asm):04480                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D8F3                  (    forth6809.asm):04481         KWAIT:
D8F3                  (    forth6809.asm):04482         KSPIN:      LDA   ACIASR
                      (    forth6809.asm):04483                     BITA  #SR_RDRF
                      (    forth6809.asm):04484                     BEQ   KSPIN
D8F3                  (    forth6809.asm):04485         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04486                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04487                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04488                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04489                                             ; RDRF and the latched error bits together
                      (    forth6809.asm):04490                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):04491                     BEQ   KGETCH
                      (    forth6809.asm):04492                     BITA  #SR_FE
                      (    forth6809.asm):04493                     BEQ   KXFE
                      (    forth6809.asm):04494                     INC   FECOUNT
D8F3                  (    forth6809.asm):04495         KXFE:       BITA  #SR_OVRN
                      (    forth6809.asm):04496                     BEQ   KXOVRN
                      (    forth6809.asm):04497                     INC   OVRNCOUNT
D8F3                  (    forth6809.asm):04498         KXOVRN:     BITA  #SR_PE
                      (    forth6809.asm):04499                     BEQ   KGETCH
                      (    forth6809.asm):04500                     INC   PECOUNT
D8F3                  (    forth6809.asm):04501         KGETCH:     LDA   ACIADR
                      (    forth6809.asm):04502                     TFR   A,B
                      (    forth6809.asm):04503                     CLRA
                      (    forth6809.asm):04504                     PSHU  D                 ; char
                      (    forth6809.asm):04505                     RTS
                      (    forth6809.asm):04506         
                      (    forth6809.asm):04507         ; ------------------------------------------------------------
                      (    forth6809.asm):04508         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04509         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04510         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04511         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04512         ;    Inputs:
                      (    forth6809.asm):04513         ;        none
                      (    forth6809.asm):04514         ;    Outputs:
                      (    forth6809.asm):04515         ;        XON or XOFF transmitted
                      (    forth6809.asm):04516         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04517         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04518         ; ------------------------------------------------------------
D8F3                  (    forth6809.asm):04519         PUTXOFF:    LDA   #XOFFCH
                      (    forth6809.asm):04520                     BRA   PUTXCH
D8F3                  (    forth6809.asm):04521         PUTXON:     LDA   #XONCH
D8F3                  (    forth6809.asm):04522         PUTXCH:     PSHS  A
D8F3                  (    forth6809.asm):04523         PXWT:       LDB   ACIASR
                      (    forth6809.asm):04524                     BITB  #SR_TDRE
                      (    forth6809.asm):04525                     BEQ   PXWT
                      (    forth6809.asm):04526                     PULS  A
                      (    forth6809.asm):04527                     STA   ACIADR
                      (    forth6809.asm):04528                     RTS
                      (    forth6809.asm):04529         
                      (    forth6809.asm):04530         ; ------------------------------------------------------------
                      (    forth6809.asm):04531         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04532         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04533         ; ------------------------------------------------------------
D8F3                  (    forth6809.asm):04534         KEYQACIA:    LDA   ACIASR
                      (    forth6809.asm):04535                     BITA  #SR_RDRF
                      (    forth6809.asm):04536                     BEQ   KQFALSE
                      (    forth6809.asm):04537                     LDD   #TRUEV
                      (    forth6809.asm):04538                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04539                     RTS
D8F3                  (    forth6809.asm):04540         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04541                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04542                     RTS
                      (    forth6809.asm):04543         
                      (    forth6809.asm):04544         ; ------------------------------------------------------------
                      (    forth6809.asm):04545         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04546         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04547         ; ------------------------------------------------------------
D8F3                  (    forth6809.asm):04548         EMITACIA:    PULU  D                 ; char
                      (    forth6809.asm):04549                     STB   EMITCH
D8F3                  (    forth6809.asm):04550         EMITWT:     LDA   ACIASR
                      (    forth6809.asm):04551                     BITA  #SR_TDRE
                      (    forth6809.asm):04552                     BEQ   EMITWT
                      (    forth6809.asm):04553                     LDA   EMITCH
                      (    forth6809.asm):04554                     STA   ACIADR
                      (    forth6809.asm):04555                     RTS
                      (    forth6809.asm):04556         
                      (    forth6809.asm):04557                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04558         
                      (    forth6809.asm):04559         ; ------------------------------------------------------------
                      (    forth6809.asm):04560         ; KEY, KEY? and EMIT go through the vectors KEYV, KEYQV and EMITV
                      (    forth6809.asm):04561         ; (page zero) so character I/O can be redirected. IOVINIT points
                      (    forth6809.asm):04562         ; them back at the ACIA routines; it runs at cold start, warm start
                      (    forth6809.asm):04563         ; and when QUIT handles an error.
                      (    forth6809.asm):04564         ; ------------------------------------------------------------
                      (    forth6809.asm):04565         ; Original direct entry points: shadow IOVEC.1.
D8F3 6E9F0087         (    forth6809.asm):04566         KEYW:       JMP   [KEYV]
D8F7 6E9F0089         (    forth6809.asm):04567         KEYQW:      JMP   [KEYQV]
D8FB 6E9F0085         (    forth6809.asm):04568         EMITW:      JMP   [EMITV]
                      (    forth6809.asm):04569         
                      (    forth6809.asm):04570         ; ------------------------------------------------------------
                      (    forth6809.asm):04571         ; IRQ-CHAIN ( -- addr )   address of the cell holding the next interrupt
                      (    forth6809.asm):04572         ; handler for interrupts that did not come from the ACIA.
                      (    forth6809.asm):04573         ; (EMIT) ( -- addr )  (KEY) ( -- addr )  (KEY?) ( -- addr )
                      (    forth6809.asm):04574         ; addresses of the cells holding the xt used by EMIT, KEY and KEY?.
                      (    forth6809.asm):04575         ; ------------------------------------------------------------
D8FF CC0083           (    forth6809.asm):04576         IRQCHAINW:  LDD   #IRQCHAIN
D902 3606             (    forth6809.asm):04577                     PSHU  D
D904 39               (    forth6809.asm):04578                     RTS
D905 CC0085           (    forth6809.asm):04579         EMITVW:     LDD   #EMITV
D908 3606             (    forth6809.asm):04580                     PSHU  D
D90A 39               (    forth6809.asm):04581                     RTS
D90B CC0087           (    forth6809.asm):04582         KEYVW:      LDD   #KEYV
D90E 3606             (    forth6809.asm):04583                     PSHU  D
D910 39               (    forth6809.asm):04584                     RTS
D911 CC0089           (    forth6809.asm):04585         KEYQVW:     LDD   #KEYQV
D914 3606             (    forth6809.asm):04586                     PSHU  D
D916 39               (    forth6809.asm):04587                     RTS
                      (    forth6809.asm):04588         
D917 CCCEEA           (    forth6809.asm):04589         COLDIO:     LDD   #IRQRTI           ; cold start only: no extra interrupt
D91A DD83             (    forth6809.asm):04590                     STD   IRQCHAIN          ; handlers, then the same as IOVINIT
D91C CCD8CE           (    forth6809.asm):04591         IOVINIT:    LDD   #EMITACIA
D91F DD85             (    forth6809.asm):04592                     STD   EMITV
D921 CCD8A7           (    forth6809.asm):04593                     LDD   #KEYACIA
D924 DD87             (    forth6809.asm):04594                     STD   KEYV
D926 CCD8BA           (    forth6809.asm):04595                     LDD   #KEYQACIA

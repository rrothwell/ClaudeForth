                      (    forth6809.asm):00431         ; ------------------------------------------------------------
                      (    forth6809.asm):00432         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00433         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00434         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00435         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00436         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00437         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00438         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00439         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00440         ;
                      (    forth6809.asm):00441         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00442         ;     FILLCNT  EQU MVCNT   - FILL's remaining-byte count
                      (    forth6809.asm):00443         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00444         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00445         ;     FILLADDR EQU MVDST   - FILL's target address
                      (    forth6809.asm):00446         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00447         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00448         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00449         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00450         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00451         ; ------------------------------------------------------------
                      (    forth6809.asm):00452                  ORG   $0100
0100                  (    forth6809.asm):00453         MVCNT      RMB   2
0102                  (    forth6809.asm):00454         MVDST      RMB   2
0104                  (    forth6809.asm):00455         MVSRC      RMB   2
     0100             (    forth6809.asm):00456         FILLCNT  EQU  MVCNT
     0100             (    forth6809.asm):00457         HSLEN    EQU  MVCNT
     0102             (    forth6809.asm):00458         FILLADDR EQU  MVDST
     0102             (    forth6809.asm):00459         HSADDR   EQU  MVDST
     0104             (    forth6809.asm):00460         MRESULT  EQU  MVSRC
     0104             (    forth6809.asm):00461         FILLCHR  EQU  MVSRC
                      (    forth6809.asm):00462         
                      (    forth6809.asm):00463         ; Provide padding, to ensure the correct ROM & .bin file size (and
                      (    forth6809.asm):00464         ; opcode offsets) for the MAME emulation and flash memory burn.

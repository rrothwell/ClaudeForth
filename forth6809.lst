                      (    forth6809.asm):07890                  LDA   #'W'
                      (    forth6809.asm):07891                  STA   TSTNAMEB+4
                      (    forth6809.asm):07892                  LDA   #'D'
                      (    forth6809.asm):07893                  STA   TSTNAMEB+5
                      (    forth6809.asm):07894         

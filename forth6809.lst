                      (    forth6809.asm):02277                                           ; loop back for more (see header comment).
DD75                  (    forth6809.asm):02278         FLUSHED:
                      (    forth6809.asm):02279                 RTS
                      (    forth6809.asm):02280         ; ------------------------------------------------------------
                      (    forth6809.asm):02281         ; PUTCHAR
                      (    forth6809.asm):02282         ;    Inputs:
                      (    forth6809.asm):02283         ;        RegA = character to insert into transmit buffer.

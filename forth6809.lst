                      (    forth6809.asm):05890         
                      (    forth6809.asm):05891                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):05892                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):05893                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):05894                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):05895                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):05896                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):05897                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):05898                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):05899                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):05900                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):05901                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):05902                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):05903                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):05904                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):05905                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):05906                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):05907                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):05908                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):05909                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):05910         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):05911                    BEQ  UEDONE
F87D A680             (    forth6809.asm):05912                    LDA  ,X+
F87F 8125             (    forth6809.asm):05913                    CMPA #'%'
F881 2604             (    forth6809.asm):05914                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):05915                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):05916                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):05917                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):05918                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):05919                                   ; the same string correctly, since this runs
                      (    forth6809.asm):05920                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):05921         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):05922                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):05923                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):05924                    SUBD #1
F88E DDA9             (    forth6809.asm):05925                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):05926                    BRA  UELOOP
F892 1F20             (    forth6809.asm):05927         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):05928                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):05929                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):05930                                   ; required return values, and separately,
                      (    forth6809.asm):05931                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):05932                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):05933                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):05934                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):05935                                   ; characters. Now computed directly as the
                      (    forth6809.asm):05936                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):05937                                   ; original destination address (UEDST) -
                      (    forth6809.asm):05938                                   ; correct regardless of how many characters
                      (    forth6809.asm):05939                                   ; were doubled, since it's derived from
                      (    forth6809.asm):05940                                   ; where writing actually stopped rather than
                      (    forth6809.asm):05941                                   ; incremented alongside it.
F898 DCAB             (    forth6809.asm):05942                    LDD  UEDST
F89A 3606             (    forth6809.asm):05943                    PSHU D         ; push c-addr2 (destination address)
F89C DCAD             (    forth6809.asm):05944                    LDD  UEOUTLEN
F89E 3606             (    forth6809.asm):05945                    PSHU D         ; push u2 (actual unescaped length)
F8A0 39               (    forth6809.asm):05946                    RTS

                      (    forth6809.asm):05248         ; Division truncates toward zero; the remainder has the sign of the
                      (    forth6809.asm):05249         ; dividend. THROW -10 if the divisor is zero.
                      (    forth6809.asm):05250         ; ------------------------------------------------------------

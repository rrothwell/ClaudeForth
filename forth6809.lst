                      (    forth6809.asm):05596         ; TSTBGU - unit test for BEGIN/UNTIL. Compiles
                      (    forth6809.asm):05597         ; "BEGIN 1+ DUP <lit 5> = UNTIL" into scratch - increments,
                      (    forth6809.asm):05598         ; duplicates, compares to 5, loops back while not equal. Run
                      (    forth6809.asm):05599         ; starting from 0; verified by hand-trace across all 5
                      (    forth6809.asm):05600         ; iterations (0->1->2->3->4->5, exiting exactly on reaching 5,
                      (    forth6809.asm):05601         ; not one iteration early or late) before writing. The patched
                      (    forth6809.asm):05602         ; back-edge offset is negative (-17), the same PATCH routine
                      (    forth6809.asm):05603         ; used for forward references handling both directions
                      (    forth6809.asm):05604         ; correctly based on relative position.
                      (    forth6809.asm):05605         ; ------------------------------------------------------------

D068 3610             (    forth6809.asm):02629                     PSHU  X                 ; c-addr
D06A CC0008           (    forth6809.asm):02630                     LDD   #ERRMSGL
D06D 3606             (    forth6809.asm):02631                     PSHU  D                 ; u
D06F BDEA39           (    forth6809.asm):02632                     JSR   TYPEW
D072 ECE4             (    forth6809.asm):02633                     LDD   ,S
D074 3606             (    forth6809.asm):02634                     PSHU  D                 ; n
D076 BDEF31           (    forth6809.asm):02635                     JSR   DOTW
D079 326A             (    forth6809.asm):02636                     LEAS  10,S              ; drop the frame
D07B 16FF94           (    forth6809.asm):02637                     LBRA  QLOOP
                      (    forth6809.asm):02638         
D07E 326A             (    forth6809.asm):02639         QOK:        LEAS  10,S              ; drop the frame
D080 BDF062           (    forth6809.asm):02640                     JSR   CRW               ; See bugfix: QOK.1
D083 DC00             (    forth6809.asm):02641                     LDD   STATE
D085 1026FF89         (    forth6809.asm):02642                     LBNE  QLOOP
D089 8ED0A8           (    forth6809.asm):02643                     LDX   #OKMSG
D08C 3610             (    forth6809.asm):02644                     PSHU  X                 ; c-addr
D08E CC0004           (    forth6809.asm):02645                     LDD   #OKMSGL
D091 3606             (    forth6809.asm):02646                     PSHU  D                 ; u
D093 BDEA39           (    forth6809.asm):02647                     JSR   TYPEW
D096 16FF79           (    forth6809.asm):02648                     LBRA  QLOOP
                      (    forth6809.asm):02649         
D099 3638303920464F52 (    forth6809.asm):02650         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02651         SIGNONL     EQU   *-SIGNON
D0A8 20206F6B         (    forth6809.asm):02652         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02653         OKMSGL      EQU   *-OKMSG
D0AC 20204552524F5220 (    forth6809.asm):02654         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02655         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02656         
                      (    forth6809.asm):02657         ; ============================================================
                      (    forth6809.asm):02658         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02659         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02660         ; ============================================================
                      (    forth6809.asm):02661         ; ------------------------------------------------------------
                      (    forth6809.asm):02662         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02663         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02664         ; LIT   ( -- x )
                      (    forth6809.asm):02665         ;    Inputs:
                      (    forth6809.asm):02666         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02667         ;    Outputs:
                      (    forth6809.asm):02668         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02669         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02670         ; ------------------------------------------------------------
D0B4 3510             (    forth6809.asm):02671         LIT:        PULS  X
D0B6 EC81             (    forth6809.asm):02672                     LDD   ,X++
D0B8 3606             (    forth6809.asm):02673                     PSHU  D                 ; x
D0BA 3410             (    forth6809.asm):02674                     PSHS  X
D0BC 39               (    forth6809.asm):02675                     RTS
                      (    forth6809.asm):02676         
                      (    forth6809.asm):02677         ; ------------------------------------------------------------
                      (    forth6809.asm):02678         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02679         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02680         ; address.
                      (    forth6809.asm):02681         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02682         ;    Inputs:
                      (    forth6809.asm):02683         ;        flag on the data stack
                      (    forth6809.asm):02684         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02685         ;    Outputs:
                      (    forth6809.asm):02686         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02687         ;        the offset
                      (    forth6809.asm):02688         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02689         ; ------------------------------------------------------------
D0BD 3706             (    forth6809.asm):02690         ZBRANCH:    PULU  D                 ; flag
D0BF 3510             (    forth6809.asm):02691                     PULS  X
D0C1 10830000         (    forth6809.asm):02692                     CMPD  #0
D0C5 2607             (    forth6809.asm):02693                     BNE   ZSKIP
D0C7 EC84             (    forth6809.asm):02694                     LDD   ,X
D0C9 308B             (    forth6809.asm):02695                     LEAX  D,X
D0CB 3410             (    forth6809.asm):02696                     PSHS  X
D0CD 39               (    forth6809.asm):02697                     RTS
D0CE 3002             (    forth6809.asm):02698         ZSKIP:      LEAX  2,X
D0D0 3410             (    forth6809.asm):02699                     PSHS  X
D0D2 39               (    forth6809.asm):02700                     RTS
                      (    forth6809.asm):02701         
                      (    forth6809.asm):02702         ; ------------------------------------------------------------
                      (    forth6809.asm):02703         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02704         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02705         ; BRANCH
                      (    forth6809.asm):02706         ;    Inputs:
                      (    forth6809.asm):02707         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02708         ;    Outputs:
                      (    forth6809.asm):02709         ;        return address set to the branch target
                      (    forth6809.asm):02710         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02711         ; ------------------------------------------------------------
D0D3 3510             (    forth6809.asm):02712         BRANCH:     PULS  X
D0D5 EC84             (    forth6809.asm):02713                     LDD   ,X
D0D7 308B             (    forth6809.asm):02714                     LEAX  D,X
D0D9 3410             (    forth6809.asm):02715                     PSHS  X
D0DB 39               (    forth6809.asm):02716                     RTS
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02720         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02721         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02722         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02723         ;    Inputs:
                      (    forth6809.asm):02724         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02725         ;        trampoline
                      (    forth6809.asm):02726         ;    Outputs:
                      (    forth6809.asm):02727         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02728         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02729         ; ------------------------------------------------------------
D0DC 3510             (    forth6809.asm):02730         DODOES:     PULS  X
D0DE 10AE81           (    forth6809.asm):02731                     LDY   ,X++
D0E1 EC84             (    forth6809.asm):02732                     LDD   ,X
D0E3 3606             (    forth6809.asm):02733                     PSHU  D                 ; pfa
D0E5 6EA4             (    forth6809.asm):02734                     JMP   ,Y
                      (    forth6809.asm):02735         
                      (    forth6809.asm):02736         ; ------------------------------------------------------------
                      (    forth6809.asm):02737         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02738         ; field address on the stack.
                      (    forth6809.asm):02739         ; DOESRT0
                      (    forth6809.asm):02740         ;    Inputs:
                      (    forth6809.asm):02741         ;        none
                      (    forth6809.asm):02742         ;    Outputs:
                      (    forth6809.asm):02743         ;        none
                      (    forth6809.asm):02744         ;    Registers: none.
                      (    forth6809.asm):02745         ; ------------------------------------------------------------
D0E7 39               (    forth6809.asm):02746         DOESRT0:    RTS
                      (    forth6809.asm):02747         
                      (    forth6809.asm):02748         ; ------------------------------------------------------------
                      (    forth6809.asm):02749         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02750         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02751         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02752         ; SETDOES
                      (    forth6809.asm):02753         ;    Inputs:
                      (    forth6809.asm):02754         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02755         ;        BEHAVIOR)
                      (    forth6809.asm):02756         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02757         ;        address
                      (    forth6809.asm):02758         ;    Outputs:
                      (    forth6809.asm):02759         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02760         ;        defining word's caller
                      (    forth6809.asm):02761         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02762         ; ------------------------------------------------------------
D0E8 3510             (    forth6809.asm):02763         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D0EA 1F12             (    forth6809.asm):02764                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02765         
D0EC 9E04             (    forth6809.asm):02766                     LDX   LATEST
D0EE E684             (    forth6809.asm):02767                     LDB   ,X
D0F0 C41F             (    forth6809.asm):02768                     ANDB  #$1F
D0F2 4F               (    forth6809.asm):02769                     CLRA
D0F3 308B             (    forth6809.asm):02770                     LEAX  D,X               ; header + name length
D0F5 EC03             (    forth6809.asm):02771                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D0F7 C30003           (    forth6809.asm):02772                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D0FA 1F01             (    forth6809.asm):02773                     TFR   D,X
                      (    forth6809.asm):02774         
D0FC 10AF84           (    forth6809.asm):02775                     STY   ,X                ; patch it
                      (    forth6809.asm):02776         
D0FF 3510             (    forth6809.asm):02777                     PULS  X                 ; X = the OUTER defining word's own return addr
D101 6E84             (    forth6809.asm):02778                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02779         
                      (    forth6809.asm):02780         ; ------------------------------------------------------------
                      (    forth6809.asm):02781         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02782         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02783         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02784         ;    Inputs:
                      (    forth6809.asm):02785         ;        pfa on the data stack
                      (    forth6809.asm):02786         ;    Outputs:
                      (    forth6809.asm):02787         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02788         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02789         ; ------------------------------------------------------------
D103 3710             (    forth6809.asm):02790         DODEFER:    PULU  X                 ; pfa
D105 EC84             (    forth6809.asm):02791                     LDD   ,X
D107 1F01             (    forth6809.asm):02792                     TFR   D,X
D109 6E84             (    forth6809.asm):02793                     JMP   ,X
                      (    forth6809.asm):02794         
                      (    forth6809.asm):02795         ; ------------------------------------------------------------
                      (    forth6809.asm):02796         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02797         ; DOABORTUNDEF
                      (    forth6809.asm):02798         ;    Inputs:
                      (    forth6809.asm):02799         ;        none
                      (    forth6809.asm):02800         ;    Outputs:
                      (    forth6809.asm):02801         ;        none (does not return)
                      (    forth6809.asm):02802         ;    Registers: RegD changed.
                      (    forth6809.asm):02803         ; ------------------------------------------------------------
D10B                  (    forth6809.asm):02804         DOABORTUNDEF:
D10B CCFFEB           (    forth6809.asm):02805                     LDD   #-21
D10E 3606             (    forth6809.asm):02806                     PSHU  D                 ; throw code (-21)
D110 7EDA44           (    forth6809.asm):02807                     JMP   THROWW
                      (    forth6809.asm):02808         
                      (    forth6809.asm):02809         ; ------------------------------------------------------------
                      (    forth6809.asm):02810         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02811         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02812         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02813         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02814         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02815         ;    Inputs:
                      (    forth6809.asm):02816         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02817         ;    Outputs:
                      (    forth6809.asm):02818         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02819         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02820         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02821         ; ------------------------------------------------------------
D113 3710             (    forth6809.asm):02822         DOMARKER:   PULU  X                 ; pfa
D115 EC84             (    forth6809.asm):02823                     LDD   ,X
D117 DD06             (    forth6809.asm):02824                     STD   DPHERE
D119 EC02             (    forth6809.asm):02825                     LDD   2,X
D11B DD08             (    forth6809.asm):02826                     STD   CODEHERE
D11D EC04             (    forth6809.asm):02827                     LDD   4,X
D11F DD0A             (    forth6809.asm):02828                     STD   VARHERE
D121 EC06             (    forth6809.asm):02829                     LDD   6,X
D123 DD04             (    forth6809.asm):02830                     STD   LATEST
D125 3008             (    forth6809.asm):02831                     LEAX  8,X               ; the saved search-order state follows
D127 108E0045         (    forth6809.asm):02832                     LDY   #SRCHSAVE
D12B C616             (    forth6809.asm):02833                     LDB   #SRCHSAVESZ
D12D A680             (    forth6809.asm):02834         DMCOPY:     LDA   ,X+
D12F A7A0             (    forth6809.asm):02835                     STA   ,Y+
D131 5A               (    forth6809.asm):02836                     DECB
D132 26F9             (    forth6809.asm):02837                     BNE   DMCOPY
D134 DC06             (    forth6809.asm):02838                     LDD   DPHERE
D136 7ED67A           (    forth6809.asm):02839                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02840         
                      (    forth6809.asm):02841         ; ------------------------------------------------------------
                      (    forth6809.asm):02842         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02843         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02844         ; ------------------------------------------------------------
D139 3710             (    forth6809.asm):02845         EXECUTEW:   PULU  X                 ; xt
D13B AD84             (    forth6809.asm):02846                     JSR   ,X
D13D 39               (    forth6809.asm):02847                     RTS
                      (    forth6809.asm):02848         
                      (    forth6809.asm):02849         ; ============================================================
                      (    forth6809.asm):02850         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02851         ; ============================================================
                      (    forth6809.asm):02852         ; ------------------------------------------------------------
                      (    forth6809.asm):02853         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02854         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02855         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02856         ;    Inputs:
                      (    forth6809.asm):02857         ;        RegX = address of the here pointer
                      (    forth6809.asm):02858         ;        x on the data stack
                      (    forth6809.asm):02859         ;    Outputs:
                      (    forth6809.asm):02860         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02861         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02862         ; ------------------------------------------------------------
D13E 3706             (    forth6809.asm):02863         APPENDCELL: PULU  D                 ; x
D140 10AE84           (    forth6809.asm):02864                     LDY   ,X
D143 EDA1             (    forth6809.asm):02865                     STD   ,Y++
D145 10AF84           (    forth6809.asm):02866                     STY   ,X
D148 39               (    forth6809.asm):02867                     RTS
                      (    forth6809.asm):02868         
                      (    forth6809.asm):02869         ; ------------------------------------------------------------
                      (    forth6809.asm):02870         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02871         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02872         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02873         ;    Inputs:
                      (    forth6809.asm):02874         ;        RegX = address of the here pointer
                      (    forth6809.asm):02875         ;        char on the data stack
                      (    forth6809.asm):02876         ;    Outputs:
                      (    forth6809.asm):02877         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02878         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02879         ; ------------------------------------------------------------
D149 3706             (    forth6809.asm):02880         APPENDBYTE: PULU  D                 ; char
D14B 10AE84           (    forth6809.asm):02881                     LDY   ,X
D14E E7A0             (    forth6809.asm):02882                     STB   ,Y+
D150 10AF84           (    forth6809.asm):02883                     STY   ,X
D153 39               (    forth6809.asm):02884                     RTS
                      (    forth6809.asm):02885         
                      (    forth6809.asm):02886         ; ------------------------------------------------------------
                      (    forth6809.asm):02887         ; ,  ( x -- )
                      (    forth6809.asm):02888         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02889         ; ------------------------------------------------------------
D154 8E0008           (    forth6809.asm):02890         COMMAW:     LDX   #CODEHERE
D157 7ED13E           (    forth6809.asm):02891                     JMP   APPENDCELL
                      (    forth6809.asm):02892         
                      (    forth6809.asm):02893         ; ------------------------------------------------------------
                      (    forth6809.asm):02894         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02895         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02896         ; ------------------------------------------------------------
D15A 8E0008           (    forth6809.asm):02897         CODECOMMA:  LDX   #CODEHERE
D15D 7ED13E           (    forth6809.asm):02898                     JMP   APPENDCELL
                      (    forth6809.asm):02899         
                      (    forth6809.asm):02900         ; ------------------------------------------------------------
                      (    forth6809.asm):02901         ; C,  ( char -- )
                      (    forth6809.asm):02902         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02903         ; ------------------------------------------------------------
D160 8E0008           (    forth6809.asm):02904         CCOMMAW:    LDX   #CODEHERE
D163 7ED149           (    forth6809.asm):02905                     JMP   APPENDBYTE
                      (    forth6809.asm):02906         
                      (    forth6809.asm):02907         ; ------------------------------------------------------------
                      (    forth6809.asm):02908         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02909         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02910         ; ------------------------------------------------------------
D166 8E0008           (    forth6809.asm):02911         CCOMMA1:    LDX   #CODEHERE
D169 7ED149           (    forth6809.asm):02912                     JMP   APPENDBYTE
                      (    forth6809.asm):02913         
                      (    forth6809.asm):02914         ; ------------------------------------------------------------
                      (    forth6809.asm):02915         ; V,  ( x -- )
                      (    forth6809.asm):02916         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02917         ; ------------------------------------------------------------
D16C 8E000A           (    forth6809.asm):02918         VCOMMAW:    LDX   #VARHERE
D16F 7ED13E           (    forth6809.asm):02919                     JMP   APPENDCELL
                      (    forth6809.asm):02920         
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
                      (    forth6809.asm):02922         ; VC,  ( char -- )
                      (    forth6809.asm):02923         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02924         ; ------------------------------------------------------------
D172 8E000A           (    forth6809.asm):02925         VCCOMMAW:   LDX   #VARHERE
D175 7ED149           (    forth6809.asm):02926                     JMP   APPENDBYTE
                      (    forth6809.asm):02927         
                      (    forth6809.asm):02928         ; ------------------------------------------------------------
                      (    forth6809.asm):02929         ; ALLOT  ( n -- )
                      (    forth6809.asm):02930         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02931         ; ------------------------------------------------------------
D178 3706             (    forth6809.asm):02932         ALLOTW:     PULU  D                 ; n
D17A 9E08             (    forth6809.asm):02933                     LDX   CODEHERE
D17C 308B             (    forth6809.asm):02934                     LEAX  D,X
D17E 9F08             (    forth6809.asm):02935                     STX   CODEHERE
D180 39               (    forth6809.asm):02936                     RTS
                      (    forth6809.asm):02937         
                      (    forth6809.asm):02938         ; ------------------------------------------------------------
                      (    forth6809.asm):02939         ; VALLOT  ( n -- )
                      (    forth6809.asm):02940         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02941         ; ------------------------------------------------------------
D181 3706             (    forth6809.asm):02942         VALLOTW:    PULU  D                 ; n
D183 9E0A             (    forth6809.asm):02943                     LDX   VARHERE
D185 308B             (    forth6809.asm):02944                     LEAX  D,X
D187 9F0A             (    forth6809.asm):02945                     STX   VARHERE
D189 39               (    forth6809.asm):02946                     RTS
                      (    forth6809.asm):02947         
                      (    forth6809.asm):02948         ; ------------------------------------------------------------
                      (    forth6809.asm):02949         ; HERE  ( -- addr )
                      (    forth6809.asm):02950         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02951         ; ------------------------------------------------------------
D18A DC08             (    forth6809.asm):02952         HEREW:      LDD   CODEHERE
D18C 3606             (    forth6809.asm):02953                     PSHU  D                 ; addr
D18E 39               (    forth6809.asm):02954                     RTS
                      (    forth6809.asm):02955         
                      (    forth6809.asm):02956         ; ------------------------------------------------------------
                      (    forth6809.asm):02957         ; VHERE  ( -- addr )
                      (    forth6809.asm):02958         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02959         ; ------------------------------------------------------------
D18F DC0A             (    forth6809.asm):02960         VHEREW:     LDD   VARHERE
D191 3606             (    forth6809.asm):02961                     PSHU  D                 ; addr
D193 39               (    forth6809.asm):02962                     RTS
                      (    forth6809.asm):02963         
                      (    forth6809.asm):02964         ; ------------------------------------------------------------
                      (    forth6809.asm):02965         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02966         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02967         ; ------------------------------------------------------------
D194 DC08             (    forth6809.asm):02968         PADW:       LDD   CODEHERE
D196 C30080           (    forth6809.asm):02969                     ADDD  #PADOFFSET
D199 3606             (    forth6809.asm):02970                     PSHU  D                 ; c-addr
D19B 39               (    forth6809.asm):02971                     RTS
                      (    forth6809.asm):02972         
                      (    forth6809.asm):02973         ; ------------------------------------------------------------
                      (    forth6809.asm):02974         ; UNUSED  ( -- u )
                      (    forth6809.asm):02975         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02976         ; ------------------------------------------------------------
D19C CCB900           (    forth6809.asm):02977         UNUSEDW:    LDD   #CODETOP
D19F 9308             (    forth6809.asm):02978                     SUBD  CODEHERE
D1A1 3606             (    forth6809.asm):02979                     PSHU  D                 ; u
D1A3 39               (    forth6809.asm):02980                     RTS
                      (    forth6809.asm):02981         
                      (    forth6809.asm):02982         ; ------------------------------------------------------------
                      (    forth6809.asm):02983         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02984         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02985         ; ------------------------------------------------------------
D1A4 CC1FFF           (    forth6809.asm):02986         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D1A7 930A             (    forth6809.asm):02987                     SUBD  VARHERE
D1A9 3606             (    forth6809.asm):02988                     PSHU  D                 ; u
D1AB 39               (    forth6809.asm):02989                     RTS
                      (    forth6809.asm):02990         
                      (    forth6809.asm):02991         ; ============================================================
                      (    forth6809.asm):02992         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02993         ; ============================================================
                      (    forth6809.asm):02994         ; ------------------------------------------------------------
                      (    forth6809.asm):02995         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02996         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02997         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02998         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02999         ; wordlist are updated.
                      (    forth6809.asm):03000         ; HEADER   ( smudge-flag "name" -- )   Throws -16 for an empty name and
                      (    forth6809.asm):03001         ;    -19 for a name of more than 31 characters (the length byte holds the
                      (    forth6809.asm):03002         ;    length in bits 0-4 and the flags in bits 5-7).
                      (    forth6809.asm):03003         ;    Inputs:
                      (    forth6809.asm):03004         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):03005         ;        name parsed from the input stream
                      (    forth6809.asm):03006         ;    Outputs:
                      (    forth6809.asm):03007         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):03008         ;        LATEST = address of the new header
                      (    forth6809.asm):03009         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03010         ; ------------------------------------------------------------
D1AC CC0020           (    forth6809.asm):03011         HEADER:     LDD   #32
D1AF 3606             (    forth6809.asm):03012                     PSHU  D
D1B1 BDD503           (    forth6809.asm):03013                     JSR   WORDW
D1B4 3710             (    forth6809.asm):03014                     PULU  X                 ; c-addr of the name
D1B6 3706             (    forth6809.asm):03015                     PULU  D                 ; smudge flag in B
D1B8 A680             (    forth6809.asm):03016                     LDA   ,X+               ; name length, X = name text
D1BA 2731             (    forth6809.asm):03017                     BEQ   HDZERO            ; no name: throw -16
D1BC 811F             (    forth6809.asm):03018                     CMPA  #31
D1BE 2232             (    forth6809.asm):03019                     BHI   HDLONG            ; over 31 characters: throw -19
D1C0 3402             (    forth6809.asm):03020                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D1C2 5D               (    forth6809.asm):03021                     TSTB
D1C3 2702             (    forth6809.asm):03022                     BEQ   HDNOSM
D1C5 8A40             (    forth6809.asm):03023                     ORA   #$40
D1C7 109E06           (    forth6809.asm):03024         HDNOSM:     LDY   DPHERE
D1CA 3420             (    forth6809.asm):03025                     PSHS  Y                 ; 0,S = address of the new header
D1CC A7A0             (    forth6809.asm):03026                     STA   ,Y+
D1CE E662             (    forth6809.asm):03027                     LDB   2,S               ; length is 1 to 31 here
D1D0 A680             (    forth6809.asm):03028         HDCPY:      LDA   ,X+
D1D2 A7A0             (    forth6809.asm):03029                     STA   ,Y+
D1D4 5A               (    forth6809.asm):03030                     DECB
D1D5 26F9             (    forth6809.asm):03031                     BNE   HDCPY
D1D7 9E47             (    forth6809.asm):03032                     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D1D9 EC84             (    forth6809.asm):03033                     LDD   ,X
D1DB EDA1             (    forth6809.asm):03034                     STD   ,Y++              ; LINK = old head of that wordlist
D1DD DC08             (    forth6809.asm):03035                     LDD   CODEHERE
D1DF EDA1             (    forth6809.asm):03036                     STD   ,Y++
D1E1 109F06           (    forth6809.asm):03037                     STY   DPHERE
D1E4 3506             (    forth6809.asm):03038                     PULS  D
D1E6 DD04             (    forth6809.asm):03039                     STD   LATEST            ; LATEST = newest header of any wordlist
D1E8 ED84             (    forth6809.asm):03040                     STD   ,X                ; and the new head of the CURRENT wordlist
D1EA 3261             (    forth6809.asm):03041                     LEAS  1,S
D1EC 39               (    forth6809.asm):03042                     RTS
D1ED CCFFF0           (    forth6809.asm):03043         HDZERO:     LDD   #-16              ; attempt to use zero-length string as a name
D1F0 2003             (    forth6809.asm):03044                     BRA   HDTHROW
D1F2 CCFFED           (    forth6809.asm):03045         HDLONG:     LDD   #-19              ; definition name too long (flags need bits 5-7)
D1F5 3606             (    forth6809.asm):03046         HDTHROW:    PSHU  D
D1F7 7EDA44           (    forth6809.asm):03047                     JMP   THROWW
                      (    forth6809.asm):03048         
                      (    forth6809.asm):03049         ; ------------------------------------------------------------
                      (    forth6809.asm):03050         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03051         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03052         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03053         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03054         ; SMUDGE   ( -- )
                      (    forth6809.asm):03055         ;    Inputs:
                      (    forth6809.asm):03056         ;        none
                      (    forth6809.asm):03057         ;    Outputs:
                      (    forth6809.asm):03058         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03059         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03060         ; ------------------------------------------------------------
D1FA 9E04             (    forth6809.asm):03061         SMUDGEW:    LDX   LATEST
D1FC A684             (    forth6809.asm):03062                     LDA   ,X
D1FE 8840             (    forth6809.asm):03063                     EORA  #$40
D200 A784             (    forth6809.asm):03064                     STA   ,X
D202 39               (    forth6809.asm):03065                     RTS
                      (    forth6809.asm):03066         
                      (    forth6809.asm):03067         ; ============================================================
                      (    forth6809.asm):03068         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03069         ; ============================================================
                      (    forth6809.asm):03070         ; ------------------------------------------------------------
                      (    forth6809.asm):03071         ; :  ( "name" -- )
                      (    forth6809.asm):03072         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03073         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03074         ; CSP and enter compile state.
                      (    forth6809.asm):03075         ; ------------------------------------------------------------
D203 CCFFFF           (    forth6809.asm):03076         COLONW:     LDD   #TRUEV
D206 3606             (    forth6809.asm):03077                     PSHU  D
D208 BDD1AC           (    forth6809.asm):03078                     JSR   HEADER
D20B DC08             (    forth6809.asm):03079                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D20D DD1F             (    forth6809.asm):03080                     STD   CURXT             ; See bugfix: COLONW.1
D20F 1F30             (    forth6809.asm):03081                     TFR   U,D
D211 DD21             (    forth6809.asm):03082                     STD   CSP
D213 CCFFFF           (    forth6809.asm):03083                     LDD   #-1
D216 DD00             (    forth6809.asm):03084                     STD   STATE
D218 39               (    forth6809.asm):03085                     RTS
                      (    forth6809.asm):03086         
                      (    forth6809.asm):03087         ; ------------------------------------------------------------
                      (    forth6809.asm):03088         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03089         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03090         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03091         ; new word and return to interpret state.
                      (    forth6809.asm):03092         ; ------------------------------------------------------------
D219 CC0039           (    forth6809.asm):03093         SEMIW:      LDD   #RTSOPC
D21C 3606             (    forth6809.asm):03094                     PSHU  D
D21E BDD166           (    forth6809.asm):03095                     JSR   CCOMMA1
D221 1F30             (    forth6809.asm):03096                     TFR   U,D
D223 109321           (    forth6809.asm):03097                     CMPD  CSP
D226 2703             (    forth6809.asm):03098                     BEQ   SEMIOK
D228 BDDA0F           (    forth6809.asm):03099                     JSR   CFERR
D22B 9E04             (    forth6809.asm):03100         SEMIOK:     LDX   LATEST
D22D A684             (    forth6809.asm):03101                     LDA   ,X
D22F 84BF             (    forth6809.asm):03102                     ANDA  #$BF
D231 A784             (    forth6809.asm):03103                     STA   ,X
D233 CC0000           (    forth6809.asm):03104                     LDD   #0
D236 DD00             (    forth6809.asm):03105                     STD   STATE
D238 39               (    forth6809.asm):03106                     RTS
                      (    forth6809.asm):03107         
                      (    forth6809.asm):03108         ; ------------------------------------------------------------
                      (    forth6809.asm):03109         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03110         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03111         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03112         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03113         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03114         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03115         ; ------------------------------------------------------------
D239 DC08             (    forth6809.asm):03116         NONAMEW:    LDD   CODEHERE
D23B 3606             (    forth6809.asm):03117                     PSHU  D                 ; xt
D23D DD1F             (    forth6809.asm):03118                     STD   CURXT             ; See bugfix: NONAMEW.1
D23F 1F30             (    forth6809.asm):03119                     TFR   U,D
D241 DD21             (    forth6809.asm):03120                     STD   CSP
D243 CCFFFF           (    forth6809.asm):03121                     LDD   #-1
D246 DD00             (    forth6809.asm):03122                     STD   STATE
D248 39               (    forth6809.asm):03123                     RTS
                      (    forth6809.asm):03124         
                      (    forth6809.asm):03125         ; ------------------------------------------------------------
                      (    forth6809.asm):03126         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03127         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03128         ; BLDDOES
                      (    forth6809.asm):03129         ;    Inputs:
                      (    forth6809.asm):03130         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03131         ;    Outputs:
                      (    forth6809.asm):03132         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03133         ;    Registers: all changed.
                      (    forth6809.asm):03134         ; BLDSELF
                      (    forth6809.asm):03135         ;    Inputs:
                      (    forth6809.asm):03136         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03137         ;    Outputs:
                      (    forth6809.asm):03138         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03139         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03140         ;    Registers: all changed.
                      (    forth6809.asm):03141         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03142         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03143         ; ------------------------------------------------------------
D249 3406             (    forth6809.asm):03144         BLDDOES:    PSHS  D                 ; behaviour address
D24B CC0000           (    forth6809.asm):03145                     LDD   #0
D24E 3606             (    forth6809.asm):03146                     PSHU  D
D250 BDD1AC           (    forth6809.asm):03147                     JSR   HEADER
D253 CCD0DC           (    forth6809.asm):03148                     LDD   #DODOES
D256 3606             (    forth6809.asm):03149                     PSHU  D
D258 BDDE7F           (    forth6809.asm):03150                     JSR   CCALL
D25B 3506             (    forth6809.asm):03151                     PULS  D
D25D 3606             (    forth6809.asm):03152                     PSHU  D                 ; behaviour address
D25F BDD15A           (    forth6809.asm):03153                     JSR   CODECOMMA
D262 39               (    forth6809.asm):03154                     RTS
                      (    forth6809.asm):03155         
D263 BDD249           (    forth6809.asm):03156         BLDSELF:    JSR   BLDDOES
D266 DC08             (    forth6809.asm):03157                     LDD   CODEHERE          ; PFA = the cell after this one
D268 C30002           (    forth6809.asm):03158                     ADDD  #2                ; See bugfix: CONSTANTW.1
D26B 3606             (    forth6809.asm):03159                     PSHU  D
D26D BDD15A           (    forth6809.asm):03160                     JSR   CODECOMMA
D270 39               (    forth6809.asm):03161                     RTS
                      (    forth6809.asm):03162         
                      (    forth6809.asm):03163         ; ------------------------------------------------------------
                      (    forth6809.asm):03164         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03165         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03166         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03167         ; address in the code area, on the stack.
                      (    forth6809.asm):03168         ; ------------------------------------------------------------
D271 CCD0E7           (    forth6809.asm):03169         CREATEW:    LDD   #DOESRT0
D274 BDD263           (    forth6809.asm):03170                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D277 39               (    forth6809.asm):03171                     RTS
                      (    forth6809.asm):03172         
                      (    forth6809.asm):03173         ; ------------------------------------------------------------
                      (    forth6809.asm):03174         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03175         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03176         ; of the word being defined.
                      (    forth6809.asm):03177         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03178         ; ------------------------------------------------------------
D278 CCD0E8           (    forth6809.asm):03179         DOESGTW:    LDD   #SETDOES
D27B 3606             (    forth6809.asm):03180                     PSHU  D
D27D BDDE7F           (    forth6809.asm):03181                     JSR   CCALL
D280 39               (    forth6809.asm):03182                     RTS
                      (    forth6809.asm):03183         
                      (    forth6809.asm):03184         ; ------------------------------------------------------------
                      (    forth6809.asm):03185         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03186         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03187         ; area, initialised to zero.
                      (    forth6809.asm):03188         ; ------------------------------------------------------------
D281 CC0000           (    forth6809.asm):03189         VARIABLEW:  LDD   #0
D284 3606             (    forth6809.asm):03190                     PSHU  D
D286 BDD1AC           (    forth6809.asm):03191                     JSR   HEADER
D289 CCD0DC           (    forth6809.asm):03192                     LDD   #DODOES
D28C 3606             (    forth6809.asm):03193                     PSHU  D
D28E BDDE7F           (    forth6809.asm):03194                     JSR   CCALL
D291 CCD0E7           (    forth6809.asm):03195                     LDD   #DOESRT0
D294 3606             (    forth6809.asm):03196                     PSHU  D
D296 BDD15A           (    forth6809.asm):03197                     JSR   CODECOMMA
D299 DC0A             (    forth6809.asm):03198                     LDD   VARHERE
D29B 3606             (    forth6809.asm):03199                     PSHU  D
D29D BDD15A           (    forth6809.asm):03200                     JSR   CODECOMMA
D2A0 CC0000           (    forth6809.asm):03201                     LDD   #0
D2A3 9E0A             (    forth6809.asm):03202                     LDX   VARHERE
D2A5 ED81             (    forth6809.asm):03203                     STD   ,X++
D2A7 9F0A             (    forth6809.asm):03204                     STX   VARHERE
D2A9 39               (    forth6809.asm):03205                     RTS
                      (    forth6809.asm):03206         
                      (    forth6809.asm):03207         ; ------------------------------------------------------------
                      (    forth6809.asm):03208         ; @  ( a-addr -- x )
                      (    forth6809.asm):03209         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03210         ; ------------------------------------------------------------
D2AA 3710             (    forth6809.asm):03211         FETCHW:     PULU  X                 ; a-addr
D2AC EC84             (    forth6809.asm):03212                     LDD   ,X
D2AE 3606             (    forth6809.asm):03213                     PSHU  D                 ; x
D2B0 39               (    forth6809.asm):03214                     RTS
                      (    forth6809.asm):03215         
                      (    forth6809.asm):03216         ; ------------------------------------------------------------
                      (    forth6809.asm):03217         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03218         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03219         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03220         ; ------------------------------------------------------------
D2B1 CCD2AA           (    forth6809.asm):03221         CONSTANTW:  LDD   #FETCHW
D2B4 BDD263           (    forth6809.asm):03222                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D2B7 BDD154           (    forth6809.asm):03223                     JSR   COMMAW
D2BA 39               (    forth6809.asm):03224                     RTS
                      (    forth6809.asm):03225         
                      (    forth6809.asm):03226         ; ------------------------------------------------------------
                      (    forth6809.asm):03227         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03228         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03229         ;    Inputs:
                      (    forth6809.asm):03230         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03231         ;    Outputs:
                      (    forth6809.asm):03232         ;        pfa replaced by the value
                      (    forth6809.asm):03233         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03234         ; ------------------------------------------------------------
D2BB 3710             (    forth6809.asm):03235         DOVALUE:    PULU  X                 ; pfa
D2BD EC84             (    forth6809.asm):03236                     LDD   ,X
D2BF 3606             (    forth6809.asm):03237                     PSHU  D                 ; x
D2C1 39               (    forth6809.asm):03238                     RTS
                      (    forth6809.asm):03239         
                      (    forth6809.asm):03240         ; ------------------------------------------------------------
                      (    forth6809.asm):03241         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03242         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03243         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03244         ; ------------------------------------------------------------
D2C2 CCD2BB           (    forth6809.asm):03245         VALUEW:     LDD   #DOVALUE
D2C5 BDD249           (    forth6809.asm):03246                     JSR   BLDDOES
D2C8 DC0A             (    forth6809.asm):03247                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D2CA 3606             (    forth6809.asm):03248                     PSHU  D                 ; See bugfix: VALUEW.1
D2CC BDD15A           (    forth6809.asm):03249                     JSR   CODECOMMA
D2CF BDD16C           (    forth6809.asm):03250                     JSR   VCOMMAW           ; store x in the variable area
D2D2 39               (    forth6809.asm):03251                     RTS
                      (    forth6809.asm):03252         
                      (    forth6809.asm):03253         ; ------------------------------------------------------------
                      (    forth6809.asm):03254         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03255         ; lower address as 2@ expects.
                      (    forth6809.asm):03256         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03257         ; ------------------------------------------------------------
D2D3 7EE840           (    forth6809.asm):03258         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03259         
                      (    forth6809.asm):03260         ; ------------------------------------------------------------
                      (    forth6809.asm):03261         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03262         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03263         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03264         ; ------------------------------------------------------------
D2D6 CCD2D3           (    forth6809.asm):03265         TWOVALUEW:  LDD   #DO2VALUE
D2D9 BDD249           (    forth6809.asm):03266                     JSR   BLDDOES
D2DC DC0A             (    forth6809.asm):03267                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D2DE 3606             (    forth6809.asm):03268                     PSHU  D
D2E0 BDD15A           (    forth6809.asm):03269                     JSR   CODECOMMA
D2E3 BDD16C           (    forth6809.asm):03270                     JSR   VCOMMAW           ; x2 at the lower address
D2E6 BDD16C           (    forth6809.asm):03271                     JSR   VCOMMAW           ; then x1
D2E9 39               (    forth6809.asm):03272                     RTS
                      (    forth6809.asm):03273         
                      (    forth6809.asm):03274         ; ------------------------------------------------------------
                      (    forth6809.asm):03275         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03276         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03277         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03278         ; ------------------------------------------------------------
D2EA CC0020           (    forth6809.asm):03279         TOW:        LDD   #32
D2ED 3606             (    forth6809.asm):03280                     PSHU  D
D2EF BDD503           (    forth6809.asm):03281                     JSR   WORDW
D2F2 BDD5EC           (    forth6809.asm):03282                     JSR   FINDW
D2F5 3706             (    forth6809.asm):03283                     PULU  D
D2F7 10830000         (    forth6809.asm):03284                     CMPD  #0
D2FB 260A             (    forth6809.asm):03285                     BNE   TOFOUND
D2FD 3706             (    forth6809.asm):03286                     PULU  D
D2FF CCFFF3           (    forth6809.asm):03287                     LDD   #-13
D302 3606             (    forth6809.asm):03288                     PSHU  D
D304 BDDA44           (    forth6809.asm):03289                     JSR   THROWW

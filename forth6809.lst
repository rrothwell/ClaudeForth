C425 8EC436           (    forth6809.asm):04834                    LDX   #TSTLOGICMSG
C428 3610             (    forth6809.asm):04835                    PSHU  X
C42A CC0005           (    forth6809.asm):04836                    LDD   #5
C42D 3606             (    forth6809.asm):04837                    PSHU  D

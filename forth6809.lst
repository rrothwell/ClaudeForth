                      (    forth6809.asm):03987         ; ------------------------------------------------------------
                      (    forth6809.asm):03988         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03989         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03990         ; ------------------------------------------------------------

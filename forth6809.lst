                      (    forth6809.asm):02920         
E310                  (    forth6809.asm):02921         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):02922                                             ; ANS's (ud1) stack order directly.
E310 DC00             (    forth6809.asm):02923                     LDD   STATE
E312 27B1             (    forth6809.asm):02924                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):02925                                             ; nothing more to do
                      (    forth6809.asm):02926                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):02927                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):02928                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):02929                     ; pop it aside first, freeing UDLO to be compiled first.
E314 3706             (    forth6809.asm):02930                     PULU  D
E316 DD2C             (    forth6809.asm):02931                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,

                      (    forth6809.asm):04882         ; ------------------------------------------------------------
                      (    forth6809.asm):04883         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):04884         ; Move x from the data stack to the return stack. The return address

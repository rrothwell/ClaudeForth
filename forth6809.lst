F521 1F02             (    forth6809.asm):11586                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):11587                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):11588                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):11589                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):11590                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):11591                                   ; The high byte took on the fill character's
                      (    forth6809.asm):11592                                   ; value instead of the count's real high
                      (    forth6809.asm):11593                                   ; byte, so the count almost never reached
                      (    forth6809.asm):11594                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):11595                                   ; past the requested length. Keeping the
                      (    forth6809.asm):11596                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):11597                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):11598                                   ; fill character into A) and removes the
                      (    forth6809.asm):11599                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):11600                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):11601                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):11602                                   ; MAME debugger.

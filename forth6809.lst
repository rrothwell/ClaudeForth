                      (    forth6809.asm):02280                    CMPD  #TSTVAL3
                      (    forth6809.asm):02281                    BNE   RLFAIL
                      (    forth6809.asm):02282                    PULU  D
                      (    forth6809.asm):02283                    CMPD  #TSTVAL2

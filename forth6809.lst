                      (    forth6809.asm):03383         ; KEY  ( -- char )
                      (    forth6809.asm):03384         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03385         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03386         ; ------------------------------------------------------------

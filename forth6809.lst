                      (    forth6809.asm):01206         ; ------------------------------------------------------------
                      (    forth6809.asm):01207         ; TSTSPACES - unit test for SPACES, normal (n=3) case. Verifies
                      (    forth6809.asm):01208         ; all three queued bytes are genuinely spaces (32), not just
                      (    forth6809.asm):01209         ; that OUTHEAD advanced by the right count.
                      (    forth6809.asm):01210         ; ------------------------------------------------------------
C17F                  (    forth6809.asm):01211         TSTSPACES: STU  TSTU0
                      (    forth6809.asm):01212         
                      (    forth6809.asm):01213                    IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01214                    LDA  OUTHEAD
                      (    forth6809.asm):01215                    STA  TSTOHSAV
                      (    forth6809.asm):01216                    ENDC ; <<<<

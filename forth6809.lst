                      (    forth6809.asm):10794                     STD  CODEHERE
                      (    forth6809.asm):10795                     LDD  #TSTNAMEB
                      (    forth6809.asm):10796                     STD  SRCADDR
                      (    forth6809.asm):10797                     LDD  #3
                      (    forth6809.asm):10798                     STD  SRCLEN
                      (    forth6809.asm):10799                     LDD  #0
                      (    forth6809.asm):10800                     STD  TOIN
                      (    forth6809.asm):10801                     LDD  #-1
                      (    forth6809.asm):10802                     STD  STATE
                      (    forth6809.asm):10803         
                      (    forth6809.asm):10804                     JSR  ABORTQUOTE
                      (    forth6809.asm):10805         
                      (    forth6809.asm):10806                     LDD  #OPRTS
                      (    forth6809.asm):10807                     PSHU D
                      (    forth6809.asm):10808                     JSR  CCOMMA
                      (    forth6809.asm):10809         
                      (    forth6809.asm):10810                     LDD  TSTCSAV
                      (    forth6809.asm):10811                     STD  CODEHERE
                      (    forth6809.asm):10812                     LDD  TSTSASAV
                      (    forth6809.asm):10813                     STD  SRCADDR
                      (    forth6809.asm):10814                     LDD  TSTSLSAV

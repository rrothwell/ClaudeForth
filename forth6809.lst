                      (    forth6809.asm):07809         
FFBD 1CAF             (    forth6809.asm):07810                  ANDCC #$AF       ; Enable IRQ & FIRQ   
                      (    forth6809.asm):07811         
                      (    forth6809.asm):07812                                  ; BUG FIX: confirmed via MAME - COLDSTRT's own
                      (    forth6809.asm):07813                                  ; ORCC #$50 above (masking IRQ+FIRQ during the
                      (    forth6809.asm):07814                                  ; critical early setup: stack pointers, DP,
                      (    forth6809.asm):07815                                  ; GLOBALS, SERBUF) was never paired with a
                      (    forth6809.asm):07816                                  ; matching unmask anywhere on this path - only
                      (    forth6809.asm):07817                                  ; WARM (below) had one, on its own, separate
                      (    forth6809.asm):07818                                  ; entry point. Under SERIALPOLL=1 (the
                      (    forth6809.asm):07819                                  ; longstanding default) this never mattered,
                      (    forth6809.asm):07820                                  ; since IRQH is just an RTI stub and nothing
                      (    forth6809.asm):07821                                  ; on that path ever depends on interrupts
                      (    forth6809.asm):07822                                  ; actually firing. It surfaced only once
                      (    forth6809.asm):07823                                  ; SERIALPOLL=0 (interrupt-driven ACIA I/O) was
                      (    forth6809.asm):07824                                  ; actually selected and tested: with IRQ left
                      (    forth6809.asm):07825                                  ; permanently masked, the ACIA's own interrupt
                      (    forth6809.asm):07826                                  ; (now correctly wired to the CPU - see the
                      (    forth6809.asm):07827                                  ; MAME driver's own irq_handler fix) could
                      (    forth6809.asm):07828                                  ; never actually be serviced, regardless of
                      (    forth6809.asm):07829                                  ; how correctly it reached the CPU pin -
                      (    forth6809.asm):07830                                  ; keystrokes were silently dropped and the
                      (    forth6809.asm):07831                                  ; warm-boot message never got typed out.
                      (    forth6809.asm):07832                                  ; Confirmed directly: manually clearing the I
                      (    forth6809.asm):07833                                  ; bit via the MAME debugger (cc=EF) mid-
                      (    forth6809.asm):07834                                  ; session immediately unblocked both. Placed
                      (    forth6809.asm):07835                                  ; here, right after INITSERIAL returns (the
                      (    forth6809.asm):07836                                  ; ACIA is configured and every piece of ring-
                      (    forth6809.asm):07837                                  ; buffer state IRQH depends on is already
                      (    forth6809.asm):07838                                  ; zeroed by CLRGLOB above), and before
                      (    forth6809.asm):07839                                  ; TSTRUNNER runs, so the unit test framework's
                      (    forth6809.asm):07840                                  ; own interrupt-driven output works correctly
                      (    forth6809.asm):07841                                  ; too, not just the eventual interactive
                      (    forth6809.asm):07842                                  ; session. Matches WARM's own, already-correct
                      (    forth6809.asm):07843                                  ; ANDCC #$AF exactly, for consistency - FIRQ
                      (    forth6809.asm):07844                                  ; is harmless to unmask alongside IRQ, since
                      (    forth6809.asm):07845                                  ; nothing on this system ever drives it
                      (    forth6809.asm):07846                                  ; (FIRQH is an RTI stub, same as the other
                      (    forth6809.asm):07847                                  ; unused vectors).
                      (    forth6809.asm):07848         
                      (    forth6809.asm):07849                  IFNE  UNITTESTS  ; >>>>>>>>>>
                      (    forth6809.asm):07850                  JSR   TSTRUNNER
                      (    forth6809.asm):07851                  ELSE  ; <<<<<>>>>>
FFBF 12               (    forth6809.asm):07852                  NOP             ; BUG FIX (see the historical note above this
FFC0 12               (    forth6809.asm):07853                  NOP             ; call site's own comment, describing the
FFC1 12               (    forth6809.asm):07854                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):07855                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):07856                                  ; excluded the test framework, meaning
                      (    forth6809.asm):07857                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):07858                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):07859                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):07860                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):07861                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):07862                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):07863                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):07864                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):07865                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):07866                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):07867                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):07868         
FFC2 7EDD76           (    forth6809.asm):07869                  JMP   COLD
                      (    forth6809.asm):07870         
FFC5 1A50             (    forth6809.asm):07871         WARM:    ORCC  #$50       ; Disable IRQ & FIRQ
FFC7 4F               (    forth6809.asm):07872                  CLRA
FFC8 1F8B             (    forth6809.asm):07873                  TFR   A,DP
FFCA CEBD00           (    forth6809.asm):07874                  LDU   #SP0
FFCD 10CEC000         (    forth6809.asm):07875                  LDS   #RP0
                      (    forth6809.asm):07876         
FFD1 BDDD59           (    forth6809.asm):07877                  JSR   INITSERIAL       ; BUG FIX: previously WARM never re-ran
                      (    forth6809.asm):07878                                         ; this at all, meaning a warm reboot never
                      (    forth6809.asm):07879                                         ; reset the ring buffer pointers (only
                      (    forth6809.asm):07880                                         ; COLDSTRT's own, separate path did, and
                      (    forth6809.asm):07881                                         ; only partially - see SERBUFCLR's own
                      (    forth6809.asm):07882                                         ; comment) nor re-issued the ACIA's own
                      (    forth6809.asm):07883                                         ; master-reset sequence. If a lockup or
                      (    forth6809.asm):07884                                         ; stuck-overrun condition (observed and
                      (    forth6809.asm):07885                                         ; reported separately) left either side
                      (    forth6809.asm):07886                                         ; in a corrupted state, a warm reboot
                      (    forth6809.asm):07887                                         ; would previously have inherited it
                      (    forth6809.asm):07888                                         ; unchanged rather than genuinely
                      (    forth6809.asm):07889                                         ; recovering. Placed here, matching
                      (    forth6809.asm):07890                                         ; COLDSTRT's own established ordering
                      (    forth6809.asm):07891                                         ; exactly: while IRQ is still masked,
                      (    forth6809.asm):07892                                         ; with the later ANDCC #$AF unmasking
                      (    forth6809.asm):07893                                         ; only once setup is complete.
                      (    forth6809.asm):07894         
FFD4 8EFFE6           (    forth6809.asm):07895                  LDX   #WARMMSG
FFD7 3610             (    forth6809.asm):07896                  PSHU  X
FFD9 CC0006           (    forth6809.asm):07897                  LDD   #WARMMSGL
FFDC 3606             (    forth6809.asm):07898                  PSHU  D
FFDE BDF4CD           (    forth6809.asm):07899                  JSR   TYPE
FFE1 1CAF             (    forth6809.asm):07900                  ANDCC #$AF
FFE3 7EDDAB           (    forth6809.asm):07901                  JMP   ABORT      ; Enable IRQ & FIRQ
                      (    forth6809.asm):07902         
FFE6 20207761726D     (    forth6809.asm):07903         WARMMSG: FCC   "  warm"
     0006             (    forth6809.asm):07904         WARMMSGL EQU   *-WARMMSG
                      (    forth6809.asm):07905         

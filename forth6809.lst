                      (    forth6809.asm):02626         
                      (    forth6809.asm):02627         ; ============================================================
                      (    forth6809.asm):02628         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02629         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02630         ; ============================================================
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02633         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02634         ; LIT   ( -- x )
                      (    forth6809.asm):02635         ;    Inputs:
                      (    forth6809.asm):02636         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02637         ;    Outputs:
                      (    forth6809.asm):02638         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02639         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02640         ; ------------------------------------------------------------
D169 3510             (    forth6809.asm):02641         LIT:        PULS  X
D16B EC81             (    forth6809.asm):02642                     LDD   ,X++
D16D 3606             (    forth6809.asm):02643                     PSHU  D                 ; x
D16F 3410             (    forth6809.asm):02644                     PSHS  X
D171 39               (    forth6809.asm):02645                     RTS
                      (    forth6809.asm):02646         
                      (    forth6809.asm):02647         ; ------------------------------------------------------------
                      (    forth6809.asm):02648         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02649         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02650         ; address.
                      (    forth6809.asm):02651         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02652         ;    Inputs:
                      (    forth6809.asm):02653         ;        flag on the data stack
                      (    forth6809.asm):02654         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02655         ;    Outputs:
                      (    forth6809.asm):02656         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02657         ;        the offset
                      (    forth6809.asm):02658         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
D172 3706             (    forth6809.asm):02660         ZBRANCH:    PULU  D                 ; flag
D174 3510             (    forth6809.asm):02661                     PULS  X
D176 10830000         (    forth6809.asm):02662                     CMPD  #0
D17A 2607             (    forth6809.asm):02663                     BNE   ZSKIP
D17C EC84             (    forth6809.asm):02664                     LDD   ,X
D17E 308B             (    forth6809.asm):02665                     LEAX  D,X
D180 3410             (    forth6809.asm):02666                     PSHS  X
D182 39               (    forth6809.asm):02667                     RTS
D183 3002             (    forth6809.asm):02668         ZSKIP:      LEAX  2,X
D185 3410             (    forth6809.asm):02669                     PSHS  X
D187 39               (    forth6809.asm):02670                     RTS
                      (    forth6809.asm):02671         
                      (    forth6809.asm):02672         ; ------------------------------------------------------------
                      (    forth6809.asm):02673         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02674         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02675         ; BRANCH
                      (    forth6809.asm):02676         ;    Inputs:
                      (    forth6809.asm):02677         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02678         ;    Outputs:
                      (    forth6809.asm):02679         ;        return address set to the branch target
                      (    forth6809.asm):02680         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
D188 3510             (    forth6809.asm):02682         BRANCH:     PULS  X
D18A EC84             (    forth6809.asm):02683                     LDD   ,X
D18C 308B             (    forth6809.asm):02684                     LEAX  D,X
D18E 3410             (    forth6809.asm):02685                     PSHS  X
D190 39               (    forth6809.asm):02686                     RTS
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
                      (    forth6809.asm):02689         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02690         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02691         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02692         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02693         ;    Inputs:
                      (    forth6809.asm):02694         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02695         ;        trampoline
                      (    forth6809.asm):02696         ;    Outputs:
                      (    forth6809.asm):02697         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02698         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
D191 3510             (    forth6809.asm):02700         DODOES:     PULS  X
D193 10AE81           (    forth6809.asm):02701                     LDY   ,X++
D196 EC84             (    forth6809.asm):02702                     LDD   ,X
D198 3606             (    forth6809.asm):02703                     PSHU  D                 ; pfa
D19A 6EA4             (    forth6809.asm):02704                     JMP   ,Y
                      (    forth6809.asm):02705         
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02708         ; field address on the stack.
                      (    forth6809.asm):02709         ; DOESRT0
                      (    forth6809.asm):02710         ;    Inputs:
                      (    forth6809.asm):02711         ;        none
                      (    forth6809.asm):02712         ;    Outputs:
                      (    forth6809.asm):02713         ;        none
                      (    forth6809.asm):02714         ;    Registers: none.
                      (    forth6809.asm):02715         ; ------------------------------------------------------------
D19C 39               (    forth6809.asm):02716         DOESRT0:    RTS
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02720         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02721         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02722         ; SETDOES
                      (    forth6809.asm):02723         ;    Inputs:
                      (    forth6809.asm):02724         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02725         ;        BEHAVIOR)
                      (    forth6809.asm):02726         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02727         ;        address
                      (    forth6809.asm):02728         ;    Outputs:
                      (    forth6809.asm):02729         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02730         ;        defining word's caller
                      (    forth6809.asm):02731         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02732         ; ------------------------------------------------------------
D19D 3510             (    forth6809.asm):02733         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D19F 1F12             (    forth6809.asm):02734                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02735         
D1A1 9E04             (    forth6809.asm):02736                     LDX   LATEST
D1A3 E684             (    forth6809.asm):02737                     LDB   ,X
D1A5 C41F             (    forth6809.asm):02738                     ANDB  #$1F
D1A7 4F               (    forth6809.asm):02739                     CLRA
D1A8 308B             (    forth6809.asm):02740                     LEAX  D,X               ; header + name length
D1AA EC03             (    forth6809.asm):02741                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D1AC C30003           (    forth6809.asm):02742                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D1AF 1F01             (    forth6809.asm):02743                     TFR   D,X
                      (    forth6809.asm):02744         
D1B1 10AF84           (    forth6809.asm):02745                     STY   ,X                ; patch it
                      (    forth6809.asm):02746         
D1B4 3510             (    forth6809.asm):02747                     PULS  X                 ; X = the OUTER defining word's own return addr
D1B6 6E84             (    forth6809.asm):02748                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02752         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02753         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02754         ;    Inputs:
                      (    forth6809.asm):02755         ;        pfa on the data stack
                      (    forth6809.asm):02756         ;    Outputs:
                      (    forth6809.asm):02757         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02758         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02759         ; ------------------------------------------------------------
D1B8 3710             (    forth6809.asm):02760         DODEFER:    PULU  X                 ; pfa
D1BA EC84             (    forth6809.asm):02761                     LDD   ,X
D1BC 1F01             (    forth6809.asm):02762                     TFR   D,X
D1BE 6E84             (    forth6809.asm):02763                     JMP   ,X
                      (    forth6809.asm):02764         
                      (    forth6809.asm):02765         ; ------------------------------------------------------------
                      (    forth6809.asm):02766         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02767         ; DOABORTUNDEF
                      (    forth6809.asm):02768         ;    Inputs:
                      (    forth6809.asm):02769         ;        none
                      (    forth6809.asm):02770         ;    Outputs:
                      (    forth6809.asm):02771         ;        none (does not return)
                      (    forth6809.asm):02772         ;    Registers: RegD changed.
                      (    forth6809.asm):02773         ; ------------------------------------------------------------
D1C0                  (    forth6809.asm):02774         DOABORTUNDEF:
D1C0 CCFFEB           (    forth6809.asm):02775                     LDD   #-21
D1C3 3606             (    forth6809.asm):02776                     PSHU  D                 ; throw code (-21)
D1C5 7EDAAF           (    forth6809.asm):02777                     JMP   THROWW
                      (    forth6809.asm):02778         
                      (    forth6809.asm):02779         ; ------------------------------------------------------------
                      (    forth6809.asm):02780         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02781         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02782         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02783         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02784         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02785         ;    Inputs:
                      (    forth6809.asm):02786         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02787         ;    Outputs:
                      (    forth6809.asm):02788         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02789         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02790         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
D1C8 3710             (    forth6809.asm):02792         DOMARKER:   PULU  X                 ; pfa
D1CA EC84             (    forth6809.asm):02793                     LDD   ,X
D1CC DD06             (    forth6809.asm):02794                     STD   DPHERE
D1CE EC02             (    forth6809.asm):02795                     LDD   2,X
D1D0 DD08             (    forth6809.asm):02796                     STD   CODEHERE
D1D2 EC04             (    forth6809.asm):02797                     LDD   4,X
D1D4 DD0A             (    forth6809.asm):02798                     STD   VARHERE
D1D6 EC06             (    forth6809.asm):02799                     LDD   6,X
D1D8 DD04             (    forth6809.asm):02800                     STD   LATEST
D1DA 3008             (    forth6809.asm):02801                     LEAX  8,X               ; the saved search-order state follows
D1DC 108E0045         (    forth6809.asm):02802                     LDY   #SRCHSAVE
D1E0 C616             (    forth6809.asm):02803                     LDB   #SRCHSAVESZ
D1E2 A680             (    forth6809.asm):02804         DMCOPY:     LDA   ,X+
D1E4 A7A0             (    forth6809.asm):02805                     STA   ,Y+
D1E6 5A               (    forth6809.asm):02806                     DECB
D1E7 26F9             (    forth6809.asm):02807                     BNE   DMCOPY
D1E9 DC06             (    forth6809.asm):02808                     LDD   DPHERE
D1EB 7ED71E           (    forth6809.asm):02809                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02810         
                      (    forth6809.asm):02811         ; ------------------------------------------------------------
                      (    forth6809.asm):02812         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02813         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02814         ; ------------------------------------------------------------
D1EE 3710             (    forth6809.asm):02815         EXECUTEW:   PULU  X                 ; xt
D1F0 AD84             (    forth6809.asm):02816                     JSR   ,X
D1F2 39               (    forth6809.asm):02817                     RTS
                      (    forth6809.asm):02818         
                      (    forth6809.asm):02819         ; ============================================================
                      (    forth6809.asm):02820         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02821         ; ============================================================
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
                      (    forth6809.asm):02823         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02824         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02825         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02826         ;    Inputs:
                      (    forth6809.asm):02827         ;        RegX = address of the here pointer
                      (    forth6809.asm):02828         ;        x on the data stack
                      (    forth6809.asm):02829         ;    Outputs:
                      (    forth6809.asm):02830         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02831         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02832         ; ------------------------------------------------------------
D1F3 3706             (    forth6809.asm):02833         APPENDCELL: PULU  D                 ; x
D1F5 10AE84           (    forth6809.asm):02834                     LDY   ,X
D1F8 EDA1             (    forth6809.asm):02835                     STD   ,Y++
D1FA 10AF84           (    forth6809.asm):02836                     STY   ,X
D1FD 39               (    forth6809.asm):02837                     RTS
                      (    forth6809.asm):02838         
                      (    forth6809.asm):02839         ; ------------------------------------------------------------
                      (    forth6809.asm):02840         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02841         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02842         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02843         ;    Inputs:
                      (    forth6809.asm):02844         ;        RegX = address of the here pointer
                      (    forth6809.asm):02845         ;        char on the data stack
                      (    forth6809.asm):02846         ;    Outputs:
                      (    forth6809.asm):02847         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02848         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02849         ; ------------------------------------------------------------
D1FE 3706             (    forth6809.asm):02850         APPENDBYTE: PULU  D                 ; char
D200 10AE84           (    forth6809.asm):02851                     LDY   ,X
D203 E7A0             (    forth6809.asm):02852                     STB   ,Y+
D205 10AF84           (    forth6809.asm):02853                     STY   ,X
D208 39               (    forth6809.asm):02854                     RTS
                      (    forth6809.asm):02855         
                      (    forth6809.asm):02856         ; ------------------------------------------------------------
                      (    forth6809.asm):02857         ; ,  ( x -- )
                      (    forth6809.asm):02858         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02859         ; ------------------------------------------------------------
D209 8E0008           (    forth6809.asm):02860         COMMAW:     LDX   #CODEHERE
D20C 7ED1F3           (    forth6809.asm):02861                     JMP   APPENDCELL
                      (    forth6809.asm):02862         
                      (    forth6809.asm):02863         ; ------------------------------------------------------------
                      (    forth6809.asm):02864         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02865         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02866         ; ------------------------------------------------------------
D20F 8E0008           (    forth6809.asm):02867         CODECOMMA:  LDX   #CODEHERE
D212 7ED1F3           (    forth6809.asm):02868                     JMP   APPENDCELL
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ------------------------------------------------------------
                      (    forth6809.asm):02871         ; C,  ( char -- )
                      (    forth6809.asm):02872         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02873         ; ------------------------------------------------------------
D215 8E0008           (    forth6809.asm):02874         CCOMMAW:    LDX   #CODEHERE
D218 7ED1FE           (    forth6809.asm):02875                     JMP   APPENDBYTE
                      (    forth6809.asm):02876         
                      (    forth6809.asm):02877         ; ------------------------------------------------------------
                      (    forth6809.asm):02878         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02879         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
D21B 8E0008           (    forth6809.asm):02881         CCOMMA1:    LDX   #CODEHERE
D21E 7ED1FE           (    forth6809.asm):02882                     JMP   APPENDBYTE
                      (    forth6809.asm):02883         
                      (    forth6809.asm):02884         ; ------------------------------------------------------------
                      (    forth6809.asm):02885         ; V,  ( x -- )
                      (    forth6809.asm):02886         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
D221 8E000A           (    forth6809.asm):02888         VCOMMAW:    LDX   #VARHERE
D224 7ED1F3           (    forth6809.asm):02889                     JMP   APPENDCELL
                      (    forth6809.asm):02890         
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
                      (    forth6809.asm):02892         ; VC,  ( char -- )
                      (    forth6809.asm):02893         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
D227 8E000A           (    forth6809.asm):02895         VCCOMMAW:   LDX   #VARHERE
D22A 7ED1FE           (    forth6809.asm):02896                     JMP   APPENDBYTE
                      (    forth6809.asm):02897         
                      (    forth6809.asm):02898         ; ------------------------------------------------------------
                      (    forth6809.asm):02899         ; ALLOT  ( n -- )
                      (    forth6809.asm):02900         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
D22D 3706             (    forth6809.asm):02902         ALLOTW:     PULU  D                 ; n
D22F 9E08             (    forth6809.asm):02903                     LDX   CODEHERE
D231 308B             (    forth6809.asm):02904                     LEAX  D,X
D233 9F08             (    forth6809.asm):02905                     STX   CODEHERE
D235 39               (    forth6809.asm):02906                     RTS
                      (    forth6809.asm):02907         
                      (    forth6809.asm):02908         ; ------------------------------------------------------------
                      (    forth6809.asm):02909         ; VALLOT  ( n -- )
                      (    forth6809.asm):02910         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
D236 3706             (    forth6809.asm):02912         VALLOTW:    PULU  D                 ; n
D238 9E0A             (    forth6809.asm):02913                     LDX   VARHERE
D23A 308B             (    forth6809.asm):02914                     LEAX  D,X
D23C 9F0A             (    forth6809.asm):02915                     STX   VARHERE
D23E 39               (    forth6809.asm):02916                     RTS
                      (    forth6809.asm):02917         
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
                      (    forth6809.asm):02919         ; HERE  ( -- addr )
                      (    forth6809.asm):02920         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
D23F DC08             (    forth6809.asm):02922         HEREW:      LDD   CODEHERE
D241 3606             (    forth6809.asm):02923                     PSHU  D                 ; addr
D243 39               (    forth6809.asm):02924                     RTS
                      (    forth6809.asm):02925         
                      (    forth6809.asm):02926         ; ------------------------------------------------------------
                      (    forth6809.asm):02927         ; VHERE  ( -- addr )
                      (    forth6809.asm):02928         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
D244 DC0A             (    forth6809.asm):02930         VHEREW:     LDD   VARHERE
D246 3606             (    forth6809.asm):02931                     PSHU  D                 ; addr
D248 39               (    forth6809.asm):02932                     RTS
                      (    forth6809.asm):02933         
                      (    forth6809.asm):02934         ; ------------------------------------------------------------
                      (    forth6809.asm):02935         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02936         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02937         ; ------------------------------------------------------------
D249 DC08             (    forth6809.asm):02938         PADW:       LDD   CODEHERE
D24B C30080           (    forth6809.asm):02939                     ADDD  #PADOFFSET
D24E 3606             (    forth6809.asm):02940                     PSHU  D                 ; c-addr
D250 39               (    forth6809.asm):02941                     RTS
                      (    forth6809.asm):02942         
                      (    forth6809.asm):02943         ; ------------------------------------------------------------
                      (    forth6809.asm):02944         ; UNUSED  ( -- u )
                      (    forth6809.asm):02945         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
D251 CCB900           (    forth6809.asm):02947         UNUSEDW:    LDD   #CODETOP
D254 9308             (    forth6809.asm):02948                     SUBD  CODEHERE
D256 3606             (    forth6809.asm):02949                     PSHU  D                 ; u
D258 39               (    forth6809.asm):02950                     RTS
                      (    forth6809.asm):02951         
                      (    forth6809.asm):02952         ; ------------------------------------------------------------
                      (    forth6809.asm):02953         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02954         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02955         ; ------------------------------------------------------------
D259 CC1FFF           (    forth6809.asm):02956         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D25C 930A             (    forth6809.asm):02957                     SUBD  VARHERE
D25E 3606             (    forth6809.asm):02958                     PSHU  D                 ; u
D260 39               (    forth6809.asm):02959                     RTS
                      (    forth6809.asm):02960         
                      (    forth6809.asm):02961         ; ============================================================
                      (    forth6809.asm):02962         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02963         ; ============================================================
                      (    forth6809.asm):02964         ; ------------------------------------------------------------
                      (    forth6809.asm):02965         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02966         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02967         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02968         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02969         ; wordlist are updated.
                      (    forth6809.asm):02970         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02971         ;    Inputs:
                      (    forth6809.asm):02972         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02973         ;        name parsed from the input stream
                      (    forth6809.asm):02974         ;    Outputs:
                      (    forth6809.asm):02975         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02976         ;        LATEST = address of the new header
                      (    forth6809.asm):02977         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02978         ; ------------------------------------------------------------
D261 CC0020           (    forth6809.asm):02979         HEADER:     LDD   #32
D264 3606             (    forth6809.asm):02980                     PSHU  D
D266 BDD5A7           (    forth6809.asm):02981                     JSR   WORDW
D269 3710             (    forth6809.asm):02982                     PULU  X                 ; c-addr of the name
D26B 3706             (    forth6809.asm):02983                     PULU  D                 ; smudge flag in B
D26D A680             (    forth6809.asm):02984                     LDA   ,X+               ; name length, X = name text
D26F 3402             (    forth6809.asm):02985                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D271 5D               (    forth6809.asm):02986                     TSTB
D272 2702             (    forth6809.asm):02987                     BEQ   HDNOSM
D274 8A40             (    forth6809.asm):02988                     ORA   #$40
D276 109E06           (    forth6809.asm):02989         HDNOSM:     LDY   DPHERE
D279 3420             (    forth6809.asm):02990                     PSHS  Y                 ; 0,S = address of the new header
D27B A7A0             (    forth6809.asm):02991                     STA   ,Y+
D27D E662             (    forth6809.asm):02992                     LDB   2,S
D27F 2707             (    forth6809.asm):02993                     BEQ   HDNONM
D281 A680             (    forth6809.asm):02994         HDCPY:      LDA   ,X+
D283 A7A0             (    forth6809.asm):02995                     STA   ,Y+
D285 5A               (    forth6809.asm):02996                     DECB
D286 26F9             (    forth6809.asm):02997                     BNE   HDCPY
D288 9E47             (    forth6809.asm):02998         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D28A EC84             (    forth6809.asm):02999                     LDD   ,X
D28C EDA1             (    forth6809.asm):03000                     STD   ,Y++              ; LINK = old head of that wordlist
D28E DC08             (    forth6809.asm):03001                     LDD   CODEHERE
D290 EDA1             (    forth6809.asm):03002                     STD   ,Y++
D292 109F06           (    forth6809.asm):03003                     STY   DPHERE
D295 3506             (    forth6809.asm):03004                     PULS  D
D297 DD04             (    forth6809.asm):03005                     STD   LATEST            ; LATEST = newest header of any wordlist
D299 ED84             (    forth6809.asm):03006                     STD   ,X                ; and the new head of the CURRENT wordlist
D29B 3261             (    forth6809.asm):03007                     LEAS  1,S
D29D 39               (    forth6809.asm):03008                     RTS
                      (    forth6809.asm):03009         
                      (    forth6809.asm):03010         ; ------------------------------------------------------------
                      (    forth6809.asm):03011         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03012         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03013         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03014         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03015         ; SMUDGE   ( -- )
                      (    forth6809.asm):03016         ;    Inputs:
                      (    forth6809.asm):03017         ;        none
                      (    forth6809.asm):03018         ;    Outputs:
                      (    forth6809.asm):03019         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03020         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03021         ; ------------------------------------------------------------
D29E 9E04             (    forth6809.asm):03022         SMUDGEW:    LDX   LATEST
D2A0 A684             (    forth6809.asm):03023                     LDA   ,X
D2A2 8840             (    forth6809.asm):03024                     EORA  #$40
D2A4 A784             (    forth6809.asm):03025                     STA   ,X
D2A6 39               (    forth6809.asm):03026                     RTS
                      (    forth6809.asm):03027         
                      (    forth6809.asm):03028         ; ============================================================
                      (    forth6809.asm):03029         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03030         ; ============================================================
                      (    forth6809.asm):03031         ; ------------------------------------------------------------
                      (    forth6809.asm):03032         ; :  ( "name" -- )
                      (    forth6809.asm):03033         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03034         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03035         ; CSP and enter compile state.
                      (    forth6809.asm):03036         ; ------------------------------------------------------------
D2A7 CCFFFF           (    forth6809.asm):03037         COLONW:     LDD   #TRUEV
D2AA 3606             (    forth6809.asm):03038                     PSHU  D
D2AC BDD261           (    forth6809.asm):03039                     JSR   HEADER
D2AF DC08             (    forth6809.asm):03040                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D2B1 DD1F             (    forth6809.asm):03041                     STD   CURXT             ; See bugfix: COLONW.1
D2B3 1F30             (    forth6809.asm):03042                     TFR   U,D
D2B5 DD21             (    forth6809.asm):03043                     STD   CSP
D2B7 CCFFFF           (    forth6809.asm):03044                     LDD   #-1
D2BA DD00             (    forth6809.asm):03045                     STD   STATE
D2BC 39               (    forth6809.asm):03046                     RTS
                      (    forth6809.asm):03047         
                      (    forth6809.asm):03048         ; ------------------------------------------------------------
                      (    forth6809.asm):03049         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03050         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03051         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03052         ; new word and return to interpret state.
                      (    forth6809.asm):03053         ; ------------------------------------------------------------
D2BD CC0039           (    forth6809.asm):03054         SEMIW:      LDD   #RTSOPC
D2C0 3606             (    forth6809.asm):03055                     PSHU  D
D2C2 BDD21B           (    forth6809.asm):03056                     JSR   CCOMMA1
D2C5 1F30             (    forth6809.asm):03057                     TFR   U,D
D2C7 109321           (    forth6809.asm):03058                     CMPD  CSP
D2CA 2703             (    forth6809.asm):03059                     BEQ   SEMIOK
D2CC BDDA7A           (    forth6809.asm):03060                     JSR   CFERR
D2CF 9E04             (    forth6809.asm):03061         SEMIOK:     LDX   LATEST
D2D1 A684             (    forth6809.asm):03062                     LDA   ,X
D2D3 84BF             (    forth6809.asm):03063                     ANDA  #$BF
D2D5 A784             (    forth6809.asm):03064                     STA   ,X
D2D7 CC0000           (    forth6809.asm):03065                     LDD   #0
D2DA DD00             (    forth6809.asm):03066                     STD   STATE
D2DC 39               (    forth6809.asm):03067                     RTS
                      (    forth6809.asm):03068         
                      (    forth6809.asm):03069         ; ------------------------------------------------------------
                      (    forth6809.asm):03070         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03071         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03072         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03073         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03074         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03075         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03076         ; ------------------------------------------------------------
D2DD DC08             (    forth6809.asm):03077         NONAMEW:    LDD   CODEHERE
D2DF 3606             (    forth6809.asm):03078                     PSHU  D                 ; xt
D2E1 DD1F             (    forth6809.asm):03079                     STD   CURXT             ; See bugfix: NONAMEW.1
D2E3 1F30             (    forth6809.asm):03080                     TFR   U,D
D2E5 DD21             (    forth6809.asm):03081                     STD   CSP
D2E7 CCFFFF           (    forth6809.asm):03082                     LDD   #-1
D2EA DD00             (    forth6809.asm):03083                     STD   STATE
D2EC 39               (    forth6809.asm):03084                     RTS
                      (    forth6809.asm):03085         
                      (    forth6809.asm):03086         ; ------------------------------------------------------------
                      (    forth6809.asm):03087         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03088         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03089         ; BLDDOES
                      (    forth6809.asm):03090         ;    Inputs:
                      (    forth6809.asm):03091         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03092         ;    Outputs:
                      (    forth6809.asm):03093         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03094         ;    Registers: all changed.
                      (    forth6809.asm):03095         ; BLDSELF
                      (    forth6809.asm):03096         ;    Inputs:
                      (    forth6809.asm):03097         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03098         ;    Outputs:
                      (    forth6809.asm):03099         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03100         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03101         ;    Registers: all changed.
                      (    forth6809.asm):03102         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03103         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03104         ; ------------------------------------------------------------
D2ED 3406             (    forth6809.asm):03105         BLDDOES:    PSHS  D                 ; behaviour address
D2EF CC0000           (    forth6809.asm):03106                     LDD   #0
D2F2 3606             (    forth6809.asm):03107                     PSHU  D
D2F4 BDD261           (    forth6809.asm):03108                     JSR   HEADER
D2F7 CCD191           (    forth6809.asm):03109                     LDD   #DODOES
D2FA 3606             (    forth6809.asm):03110                     PSHU  D
D2FC BDDEEA           (    forth6809.asm):03111                     JSR   CCALL
D2FF 3506             (    forth6809.asm):03112                     PULS  D
D301 3606             (    forth6809.asm):03113                     PSHU  D                 ; behaviour address
D303 BDD20F           (    forth6809.asm):03114                     JSR   CODECOMMA
D306 39               (    forth6809.asm):03115                     RTS
                      (    forth6809.asm):03116         
D307 BDD2ED           (    forth6809.asm):03117         BLDSELF:    JSR   BLDDOES
D30A DC08             (    forth6809.asm):03118                     LDD   CODEHERE          ; PFA = the cell after this one
D30C C30002           (    forth6809.asm):03119                     ADDD  #2                ; See bugfix: CONSTANTW.1
D30F 3606             (    forth6809.asm):03120                     PSHU  D
D311 BDD20F           (    forth6809.asm):03121                     JSR   CODECOMMA
D314 39               (    forth6809.asm):03122                     RTS
                      (    forth6809.asm):03123         
                      (    forth6809.asm):03124         ; ------------------------------------------------------------
                      (    forth6809.asm):03125         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03126         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03127         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03128         ; address in the code area, on the stack.
                      (    forth6809.asm):03129         ; ------------------------------------------------------------
D315 CCD19C           (    forth6809.asm):03130         CREATEW:    LDD   #DOESRT0
D318 BDD307           (    forth6809.asm):03131                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D31B 39               (    forth6809.asm):03132                     RTS
                      (    forth6809.asm):03133         
                      (    forth6809.asm):03134         ; ------------------------------------------------------------
                      (    forth6809.asm):03135         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03136         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03137         ; of the word being defined.
                      (    forth6809.asm):03138         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03139         ; ------------------------------------------------------------
D31C CCD19D           (    forth6809.asm):03140         DOESGTW:    LDD   #SETDOES
D31F 3606             (    forth6809.asm):03141                     PSHU  D
D321 BDDEEA           (    forth6809.asm):03142                     JSR   CCALL
D324 39               (    forth6809.asm):03143                     RTS
                      (    forth6809.asm):03144         
                      (    forth6809.asm):03145         ; ------------------------------------------------------------
                      (    forth6809.asm):03146         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03147         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03148         ; area, initialised to zero.
                      (    forth6809.asm):03149         ; ------------------------------------------------------------
D325 CC0000           (    forth6809.asm):03150         VARIABLEW:  LDD   #0
D328 3606             (    forth6809.asm):03151                     PSHU  D
D32A BDD261           (    forth6809.asm):03152                     JSR   HEADER
D32D CCD191           (    forth6809.asm):03153                     LDD   #DODOES
D330 3606             (    forth6809.asm):03154                     PSHU  D
D332 BDDEEA           (    forth6809.asm):03155                     JSR   CCALL
D335 CCD19C           (    forth6809.asm):03156                     LDD   #DOESRT0
D338 3606             (    forth6809.asm):03157                     PSHU  D
D33A BDD20F           (    forth6809.asm):03158                     JSR   CODECOMMA
D33D DC0A             (    forth6809.asm):03159                     LDD   VARHERE
D33F 3606             (    forth6809.asm):03160                     PSHU  D
D341 BDD20F           (    forth6809.asm):03161                     JSR   CODECOMMA
D344 CC0000           (    forth6809.asm):03162                     LDD   #0
D347 9E0A             (    forth6809.asm):03163                     LDX   VARHERE
D349 ED81             (    forth6809.asm):03164                     STD   ,X++
D34B 9F0A             (    forth6809.asm):03165                     STX   VARHERE
D34D 39               (    forth6809.asm):03166                     RTS
                      (    forth6809.asm):03167         
                      (    forth6809.asm):03168         ; ------------------------------------------------------------
                      (    forth6809.asm):03169         ; @  ( a-addr -- x )
                      (    forth6809.asm):03170         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03171         ; ------------------------------------------------------------
D34E 3710             (    forth6809.asm):03172         FETCHW:     PULU  X                 ; a-addr
D350 EC84             (    forth6809.asm):03173                     LDD   ,X
D352 3606             (    forth6809.asm):03174                     PSHU  D                 ; x
D354 39               (    forth6809.asm):03175                     RTS
                      (    forth6809.asm):03176         
                      (    forth6809.asm):03177         ; ------------------------------------------------------------
                      (    forth6809.asm):03178         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03179         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03180         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03181         ; ------------------------------------------------------------
D355 CCD34E           (    forth6809.asm):03182         CONSTANTW:  LDD   #FETCHW
D358 BDD307           (    forth6809.asm):03183                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D35B BDD209           (    forth6809.asm):03184                     JSR   COMMAW
D35E 39               (    forth6809.asm):03185                     RTS
                      (    forth6809.asm):03186         
                      (    forth6809.asm):03187         ; ------------------------------------------------------------
                      (    forth6809.asm):03188         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03189         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03190         ;    Inputs:
                      (    forth6809.asm):03191         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03192         ;    Outputs:
                      (    forth6809.asm):03193         ;        pfa replaced by the value
                      (    forth6809.asm):03194         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03195         ; ------------------------------------------------------------
D35F 3710             (    forth6809.asm):03196         DOVALUE:    PULU  X                 ; pfa
D361 EC84             (    forth6809.asm):03197                     LDD   ,X
D363 3606             (    forth6809.asm):03198                     PSHU  D                 ; x
D365 39               (    forth6809.asm):03199                     RTS
                      (    forth6809.asm):03200         
                      (    forth6809.asm):03201         ; ------------------------------------------------------------
                      (    forth6809.asm):03202         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03203         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03204         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03205         ; ------------------------------------------------------------
D366 CCD35F           (    forth6809.asm):03206         VALUEW:     LDD   #DOVALUE
D369 BDD2ED           (    forth6809.asm):03207                     JSR   BLDDOES
D36C DC0A             (    forth6809.asm):03208                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D36E 3606             (    forth6809.asm):03209                     PSHU  D                 ; See bugfix: VALUEW.1
D370 BDD20F           (    forth6809.asm):03210                     JSR   CODECOMMA
D373 BDD221           (    forth6809.asm):03211                     JSR   VCOMMAW           ; store x in the variable area
D376 39               (    forth6809.asm):03212                     RTS
                      (    forth6809.asm):03213         
                      (    forth6809.asm):03214         ; ------------------------------------------------------------
                      (    forth6809.asm):03215         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03216         ; lower address as 2@ expects.
                      (    forth6809.asm):03217         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03218         ; ------------------------------------------------------------
D377 7EE8AB           (    forth6809.asm):03219         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03220         
                      (    forth6809.asm):03221         ; ------------------------------------------------------------
                      (    forth6809.asm):03222         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03223         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03224         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03225         ; ------------------------------------------------------------
D37A CCD377           (    forth6809.asm):03226         TWOVALUEW:  LDD   #DO2VALUE
D37D BDD2ED           (    forth6809.asm):03227                     JSR   BLDDOES
D380 DC0A             (    forth6809.asm):03228                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D382 3606             (    forth6809.asm):03229                     PSHU  D
D384 BDD20F           (    forth6809.asm):03230                     JSR   CODECOMMA
D387 BDD221           (    forth6809.asm):03231                     JSR   VCOMMAW           ; x2 at the lower address
D38A BDD221           (    forth6809.asm):03232                     JSR   VCOMMAW           ; then x1
D38D 39               (    forth6809.asm):03233                     RTS
                      (    forth6809.asm):03234         
                      (    forth6809.asm):03235         ; ------------------------------------------------------------
                      (    forth6809.asm):03236         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03237         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03238         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03239         ; ------------------------------------------------------------
D38E CC0020           (    forth6809.asm):03240         TOW:        LDD   #32
D391 3606             (    forth6809.asm):03241                     PSHU  D
D393 BDD5A7           (    forth6809.asm):03242                     JSR   WORDW
D396 BDD690           (    forth6809.asm):03243                     JSR   FINDW
D399 3706             (    forth6809.asm):03244                     PULU  D
D39B 10830000         (    forth6809.asm):03245                     CMPD  #0
D39F 260A             (    forth6809.asm):03246                     BNE   TOFOUND
D3A1 3706             (    forth6809.asm):03247                     PULU  D
D3A3 CCFFF3           (    forth6809.asm):03248                     LDD   #-13
D3A6 3606             (    forth6809.asm):03249                     PSHU  D
D3A8 BDDAAF           (    forth6809.asm):03250                     JSR   THROWW
D3AB AEC4             (    forth6809.asm):03251         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
D3AD EC03             (    forth6809.asm):03252                     LDD   3,X
D3AF 1083D377         (    forth6809.asm):03253                     CMPD  #DO2VALUE
D3B3 271A             (    forth6809.asm):03254                     BEQ   TOTWO
D3B5 BDDFAB           (    forth6809.asm):03255                     JSR   TOBODYW
D3B8 DC00             (    forth6809.asm):03256                     LDD   STATE
D3BA 270C             (    forth6809.asm):03257                     BEQ   TOIMMED
D3BC BDDEF7           (    forth6809.asm):03258                     JSR   LITERALW
D3BF CCE88C           (    forth6809.asm):03259                     LDD   #STOREW
D3C2 3606             (    forth6809.asm):03260                     PSHU  D
D3C4 BDDEEA           (    forth6809.asm):03261                     JSR   CCALL
D3C7 39               (    forth6809.asm):03262                     RTS
D3C8 3710             (    forth6809.asm):03263         TOIMMED:    PULU  X                 ; a-addr of the value cell
D3CA 3706             (    forth6809.asm):03264                     PULU  D                 ; x
D3CC ED84             (    forth6809.asm):03265                     STD   ,X
D3CE 39               (    forth6809.asm):03266                     RTS
D3CF BDDFAB           (    forth6809.asm):03267         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
D3D2 DC00             (    forth6809.asm):03268                     LDD   STATE
D3D4 270C             (    forth6809.asm):03269                     BEQ   TOTWOIMM
D3D6 BDDEF7           (    forth6809.asm):03270                     JSR   LITERALW
D3D9 CCE8B6           (    forth6809.asm):03271                     LDD   #TWOSTOREW
D3DC 3606             (    forth6809.asm):03272                     PSHU  D
D3DE BDDEEA           (    forth6809.asm):03273                     JSR   CCALL
D3E1 39               (    forth6809.asm):03274                     RTS
D3E2 7EE8B6           (    forth6809.asm):03275         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03276         
                      (    forth6809.asm):03277         ; ------------------------------------------------------------
                      (    forth6809.asm):03278         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03279         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03280         ; the variable area, initialised to zero.
                      (    forth6809.asm):03281         ; ------------------------------------------------------------
D3E5                  (    forth6809.asm):03282         TWOVARIABLEW:
D3E5 CC0000           (    forth6809.asm):03283                     LDD   #0
D3E8 3606             (    forth6809.asm):03284                     PSHU  D
D3EA BDD261           (    forth6809.asm):03285                     JSR   HEADER
D3ED CCD191           (    forth6809.asm):03286                     LDD   #DODOES
D3F0 3606             (    forth6809.asm):03287                     PSHU  D
D3F2 BDDEEA           (    forth6809.asm):03288                     JSR   CCALL
D3F5 CCD19C           (    forth6809.asm):03289                     LDD   #DOESRT0
D3F8 3606             (    forth6809.asm):03290                     PSHU  D
D3FA BDD20F           (    forth6809.asm):03291                     JSR   CODECOMMA

                      (    forth6809.asm):05634         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05635         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05636         ; the string.
                      (    forth6809.asm):05637         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05638         ;    Inputs:
                      (    forth6809.asm):05639         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05640         ;        count byte
                      (    forth6809.asm):05641         ;    Outputs:
                      (    forth6809.asm):05642         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05643         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05644         ; ------------------------------------------------------------
DF4C                  (    forth6809.asm):05645         DOABORTQUOTE:
DF4C 3510             (    forth6809.asm):05646                     PULS  X
DF4E E684             (    forth6809.asm):05647                     LDB   ,X
DF50 3001             (    forth6809.asm):05648                     LEAX  1,X               ; X = text, B = length
DF52 4F               (    forth6809.asm):05649                     CLRA
DF53 3720             (    forth6809.asm):05650                     PULU  Y                 ; flag
DF55 108C0000         (    forth6809.asm):05651                     CMPY  #0
DF59 2605             (    forth6809.asm):05652                     BNE   AQTHROW
DF5B 3085             (    forth6809.asm):05653                     LEAX  B,X
DF5D 3410             (    forth6809.asm):05654                     PSHS  X
DF5F 39               (    forth6809.asm):05655                     RTS
DF60 3610             (    forth6809.asm):05656         AQTHROW:    PSHU  X
DF62 3606             (    forth6809.asm):05657                     PSHU  D
DF64 BDEA39           (    forth6809.asm):05658                     JSR   TYPEW
DF67 CCFFFE           (    forth6809.asm):05659                     LDD   #-2               ; -2
DF6A 3606             (    forth6809.asm):05660                     PSHU  D
DF6C 7EDA44           (    forth6809.asm):05661                     JMP   THROWW
                      (    forth6809.asm):05662         
                      (    forth6809.asm):05663         ; ------------------------------------------------------------
                      (    forth6809.asm):05664         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05665         ; Compile DOABORTQUOTE followed by the string up to the closing quote

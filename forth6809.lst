E35B 3001             (    forth6809.asm):03285                     LEAX  1,X
E35D 5A               (    forth6809.asm):03286                     DECB
E35E 2751             (    forth6809.asm):03287                     BEQ   NQBAD
                      (    forth6809.asm):03288         
E360 108E0000         (    forth6809.asm):03289         NQNOSIGN2:  LDY   #0
E364 3620             (    forth6809.asm):03290                     PSHU  Y                 ; ud low
E366 3620             (    forth6809.asm):03291                     PSHU  Y                 ; ud high
E368 3610             (    forth6809.asm):03292                     PSHU  X                 ; c-addr
E36A 4F               (    forth6809.asm):03293                     CLRA

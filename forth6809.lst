DCD8 260D             (    forth6809.asm):05036                     BNE   LOOPDONE
DCDA 3706             (    forth6809.asm):05037                     PULU  D
DCDC 3710             (    forth6809.asm):05038                     PULU  X                 ; ?DO skip operand
DCDE DC08             (    forth6809.asm):05039                     LDD   CODEHERE
DCE0 3606             (    forth6809.asm):05040                     PSHU  D
DCE2 3610             (    forth6809.asm):05041                     PSHU  X
DCE4 BDDAE4           (    forth6809.asm):05042                     JSR   PATCH
DCE7 39               (    forth6809.asm):05043         LOOPDONE:   RTS
                      (    forth6809.asm):05044         
                      (    forth6809.asm):05045         ; ------------------------------------------------------------
                      (    forth6809.asm):05046         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05047         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05048         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05049         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05050         ; DOTEST
                      (    forth6809.asm):05051         ;    Inputs:
                      (    forth6809.asm):05052         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05053         ;        first)
                      (    forth6809.asm):05054         ;    Outputs:
                      (    forth6809.asm):05055         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05056         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05057         ; ------------------------------------------------------------
DCE8 EC66             (    forth6809.asm):05058         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DCEA 2615             (    forth6809.asm):05059                     BNE   DTEXIT            ; set: exit
DCEC EC62             (    forth6809.asm):05060                     LDD   2,S               ; index
DCEE C30001           (    forth6809.asm):05061                     ADDD  #1
DCF1 ED62             (    forth6809.asm):05062                     STD   2,S
DCF3 10A364           (    forth6809.asm):05063                     CMPD  4,S               ; limit
DCF6 2709             (    forth6809.asm):05064                     BEQ   DTEXIT
DCF8 3510             (    forth6809.asm):05065                     PULS  X                 ; X = branch operand address
DCFA EC84             (    forth6809.asm):05066                     LDD   ,X
DCFC 308B             (    forth6809.asm):05067                     LEAX  D,X
DCFE 3410             (    forth6809.asm):05068                     PSHS  X                 ; return to loop start
DD00 39               (    forth6809.asm):05069                     RTS
DD01 3510             (    forth6809.asm):05070         DTEXIT:     PULS  X
DD03 3002             (    forth6809.asm):05071                     LEAX  2,X               ; skip the branch operand
DD05 3266             (    forth6809.asm):05072                     LEAS  6,S               ; discard the loop frame
DD07 3410             (    forth6809.asm):05073                     PSHS  X
DD09 39               (    forth6809.asm):05074                     RTS
                      (    forth6809.asm):05075         
                      (    forth6809.asm):05076         ; ------------------------------------------------------------
                      (    forth6809.asm):05077         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05078         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05079         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05080         ; ------------------------------------------------------------
DD0A 3706             (    forth6809.asm):05081         PLUSLOOPW:  PULU  D
DD0C 10830003         (    forth6809.asm):05082                     CMPD  #TAGDO
DD10 2703             (    forth6809.asm):05083                     BEQ   PLOOPOK
DD12 BDDA7A           (    forth6809.asm):05084                     JSR   CFERR
DD15 3706             (    forth6809.asm):05085         PLOOPOK:    PULU  D                 ; dest
DD17 3606             (    forth6809.asm):05086                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DD19 CCDD49           (    forth6809.asm):05087                     LDD   #DOPLUSTEST
DD1C 3606             (    forth6809.asm):05088                     PSHU  D
DD1E BDDEEA           (    forth6809.asm):05089                     JSR   CCALL
DD21 CC0000           (    forth6809.asm):05090                     LDD   #0
DD24 3606             (    forth6809.asm):05091                     PSHU  D
DD26 BDD20F           (    forth6809.asm):05092                     JSR   CODECOMMA
DD29 DC08             (    forth6809.asm):05093                     LDD   CODEHERE
DD2B 830002           (    forth6809.asm):05094                     SUBD  #2
DD2E 3606             (    forth6809.asm):05095                     PSHU  D                 ; location; the parked dest is beneath
DD30 BDDAE4           (    forth6809.asm):05096                     JSR   PATCH
                      (    forth6809.asm):05097         
DD33 ECC4             (    forth6809.asm):05098                     LDD   ,U
DD35 10830007         (    forth6809.asm):05099                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DD39 260D             (    forth6809.asm):05100                     BNE   PLOOPDONE
DD3B 3706             (    forth6809.asm):05101                     PULU  D
DD3D 3710             (    forth6809.asm):05102                     PULU  X                 ; ?DO skip operand
DD3F DC08             (    forth6809.asm):05103                     LDD   CODEHERE
DD41 3606             (    forth6809.asm):05104                     PSHU  D
DD43 3610             (    forth6809.asm):05105                     PSHU  X
DD45 BDDAE4           (    forth6809.asm):05106                     JSR   PATCH
DD48 39               (    forth6809.asm):05107         PLOOPDONE:  RTS
                      (    forth6809.asm):05108         
                      (    forth6809.asm):05109         ; ------------------------------------------------------------
                      (    forth6809.asm):05110         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05111         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05112         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05113         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05114         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05115         ;    Inputs:
                      (    forth6809.asm):05116         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05117         ;    Outputs:
                      (    forth6809.asm):05118         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05119         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05120         ;        scratch.
                      (    forth6809.asm):05121         ; ------------------------------------------------------------
DD49 3706             (    forth6809.asm):05122         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DD4B DD14             (    forth6809.asm):05123                     STD   MSCR              ; MSCR = step
DD4D EC66             (    forth6809.asm):05124                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DD4F 262D             (    forth6809.asm):05125                     BNE   DPTEXIT           ; set: exit
DD51 EC62             (    forth6809.asm):05126                     LDD   2,S               ; old index
DD53 A364             (    forth6809.asm):05127                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DD55 DD16             (    forth6809.asm):05128                     STD   MSCR2
DD57 EC62             (    forth6809.asm):05129                     LDD   2,S
DD59 D314             (    forth6809.asm):05130                     ADDD  MSCR              ; new_index = old_index + step
DD5B ED62             (    forth6809.asm):05131                     STD   2,S
DD5D A364             (    forth6809.asm):05132                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DD5F DD18             (    forth6809.asm):05133                     STD   MSCR3
                      (    forth6809.asm):05134                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05135                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05136                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DD61 DC14             (    forth6809.asm):05137                     LDD   MSCR              ; reload the step to test its sign
DD63 2B09             (    forth6809.asm):05138                     BMI   DPNEG
DD65 DC18             (    forth6809.asm):05139         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DD67 109316           (    forth6809.asm):05140                     CMPD  MSCR2
DD6A 2512             (    forth6809.asm):05141                     BLO   DPTEXIT
DD6C 2007             (    forth6809.asm):05142                     BRA   DPCONT
DD6E DC18             (    forth6809.asm):05143         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DD70 109316           (    forth6809.asm):05144                     CMPD  MSCR2
DD73 2209             (    forth6809.asm):05145                     BHI   DPTEXIT
DD75 3510             (    forth6809.asm):05146         DPCONT:     PULS  X                 ; X = branch operand address
DD77 EC84             (    forth6809.asm):05147                     LDD   ,X
DD79 308B             (    forth6809.asm):05148                     LEAX  D,X
DD7B 3410             (    forth6809.asm):05149                     PSHS  X
DD7D 39               (    forth6809.asm):05150                     RTS
DD7E 3510             (    forth6809.asm):05151         DPTEXIT:    PULS  X
DD80 3002             (    forth6809.asm):05152                     LEAX  2,X               ; skip the branch operand
DD82 3266             (    forth6809.asm):05153                     LEAS  6,S               ; discard the loop frame
DD84 3410             (    forth6809.asm):05154                     PSHS  X
DD86 39               (    forth6809.asm):05155                     RTS
                      (    forth6809.asm):05156         
                      (    forth6809.asm):05157         ; ------------------------------------------------------------
                      (    forth6809.asm):05158         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05159         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05160         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05161         ; ------------------------------------------------------------
DD87 CCDDAD           (    forth6809.asm):05162         QDOW:       LDD   #QDOSETUP
DD8A 3606             (    forth6809.asm):05163                     PSHU  D
DD8C BDDEEA           (    forth6809.asm):05164                     JSR   CCALL
DD8F CC0000           (    forth6809.asm):05165                     LDD   #0
DD92 3606             (    forth6809.asm):05166                     PSHU  D
DD94 BDD20F           (    forth6809.asm):05167                     JSR   CODECOMMA
DD97 DC08             (    forth6809.asm):05168                     LDD   CODEHERE
DD99 830002           (    forth6809.asm):05169                     SUBD  #2
DD9C 3606             (    forth6809.asm):05170                     PSHU  D                 ; orig
DD9E CC0007           (    forth6809.asm):05171                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DDA1 3606             (    forth6809.asm):05172                     PSHU  D
DDA3 DC08             (    forth6809.asm):05173                     LDD   CODEHERE
DDA5 3606             (    forth6809.asm):05174                     PSHU  D                 ; dest
DDA7 CC0003           (    forth6809.asm):05175                     LDD   #TAGDO
DDAA 3606             (    forth6809.asm):05176                     PSHU  D
DDAC 39               (    forth6809.asm):05177                     RTS
                      (    forth6809.asm):05178         
                      (    forth6809.asm):05179         ; ------------------------------------------------------------
                      (    forth6809.asm):05180         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05181         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05182         ; branch operand.
                      (    forth6809.asm):05183         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05184         ;    Inputs:
                      (    forth6809.asm):05185         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05186         ;    Outputs:
                      (    forth6809.asm):05187         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05188         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05189         ; ------------------------------------------------------------
DDAD 3706             (    forth6809.asm):05190         QDOSETUP:   PULU  D                 ; index
DDAF DD14             (    forth6809.asm):05191                     STD   MSCR
DDB1 3706             (    forth6809.asm):05192                     PULU  D                 ; limit
DDB3 DD16             (    forth6809.asm):05193                     STD   MSCR2
DDB5 3510             (    forth6809.asm):05194                     PULS  X
DDB7 DC16             (    forth6809.asm):05195                     LDD   MSCR2
DDB9 109314           (    forth6809.asm):05196                     CMPD  MSCR
DDBC 2607             (    forth6809.asm):05197                     BNE   QDBUILD
DDBE EC84             (    forth6809.asm):05198                     LDD   ,X
DDC0 308B             (    forth6809.asm):05199                     LEAX  D,X
DDC2 3410             (    forth6809.asm):05200                     PSHS  X
DDC4 39               (    forth6809.asm):05201                     RTS
DDC5 3002             (    forth6809.asm):05202         QDBUILD:    LEAX  2,X
DDC7 CC0000           (    forth6809.asm):05203                     LDD   #0
DDCA 3406             (    forth6809.asm):05204                     PSHS  D
DDCC DC16             (    forth6809.asm):05205                     LDD   MSCR2
DDCE 3406             (    forth6809.asm):05206                     PSHS  D
DDD0 DC14             (    forth6809.asm):05207                     LDD   MSCR
DDD2 3406             (    forth6809.asm):05208                     PSHS  D
DDD4 3410             (    forth6809.asm):05209                     PSHS  X
DDD6 39               (    forth6809.asm):05210                     RTS
                      (    forth6809.asm):05211         
                      (    forth6809.asm):05212         ; ------------------------------------------------------------
                      (    forth6809.asm):05213         ; UNLOOP  ( -- )
                      (    forth6809.asm):05214         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05215         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05216         ; ------------------------------------------------------------
DDD7 3510             (    forth6809.asm):05217         UNLOOPW:    PULS  X
DDD9 3266             (    forth6809.asm):05218                     LEAS  6,S
DDDB 3410             (    forth6809.asm):05219                     PSHS  X
DDDD 39               (    forth6809.asm):05220                     RTS
                      (    forth6809.asm):05221         
                      (    forth6809.asm):05222         ; ------------------------------------------------------------
                      (    forth6809.asm):05223         ; EXIT  ( -- )
                      (    forth6809.asm):05224         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05225         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05226         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05227         ; ------------------------------------------------------------
DDDE 108E0000         (    forth6809.asm):05228         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DDE2 1F31             (    forth6809.asm):05229                     TFR   U,X               ; X = scan pointer
DDE4 9C21             (    forth6809.asm):05230         EXSCAN:     CMPX  CSP
DDE6 270E             (    forth6809.asm):05231                     BEQ   EXSCANDONE
DDE8 EC84             (    forth6809.asm):05232                     LDD   ,X
DDEA 10830003         (    forth6809.asm):05233                     CMPD  #TAGDO
DDEE 2602             (    forth6809.asm):05234                     BNE   EXNOTDO
DDF0 3121             (    forth6809.asm):05235                     LEAY  1,Y
DDF2 3004             (    forth6809.asm):05236         EXNOTDO:    LEAX  4,X
DDF4 20EE             (    forth6809.asm):05237                     BRA   EXSCAN
DDF6                  (    forth6809.asm):05238         EXSCANDONE:
DDF6 3420             (    forth6809.asm):05239                     PSHS  Y                 ; the count survives CCALL on S
DDF8 CCDE08           (    forth6809.asm):05240                     LDD   #EXITUNLOOP
DDFB 3606             (    forth6809.asm):05241                     PSHU  D
DDFD BDDEEA           (    forth6809.asm):05242                     JSR   CCALL
DE00 3506             (    forth6809.asm):05243                     PULS  D
DE02 3606             (    forth6809.asm):05244                     PSHU  D
DE04 BDD20F           (    forth6809.asm):05245                     JSR   CODECOMMA
DE07 39               (    forth6809.asm):05246                     RTS
                      (    forth6809.asm):05247         
                      (    forth6809.asm):05248         ; ------------------------------------------------------------
                      (    forth6809.asm):05249         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05250         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05251         ; EXITUNLOOP
                      (    forth6809.asm):05252         ;    Inputs:
                      (    forth6809.asm):05253         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05254         ;        address
                      (    forth6809.asm):05255         ;    Outputs:
                      (    forth6809.asm):05256         ;        returns to the caller of the definition
                      (    forth6809.asm):05257         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05258         ; ------------------------------------------------------------
DE08 3510             (    forth6809.asm):05259         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DE0A 3520             (    forth6809.asm):05260                     PULS  Y                 ; Y = return address
DE0C 6EA4             (    forth6809.asm):05261                     JMP   ,Y
                      (    forth6809.asm):05262         
                      (    forth6809.asm):05263         ; ------------------------------------------------------------
                      (    forth6809.asm):05264         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05265         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05266         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05267         ; ------------------------------------------------------------
DE0E CC0000           (    forth6809.asm):05268         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
DE11 3606             (    forth6809.asm):05269                     PSHU  D

                      (    forth6809.asm):05677         ; TSTBWR - unit test for BEGIN/WHILE/REPEAT. Compiles
                      (    forth6809.asm):05678         ; "BEGIN DUP <lit 5> < WHILE 1+ REPEAT" - opposite polarity
                      (    forth6809.asm):05679         ; from TSTBGU's UNTIL (continues on true, exits on false,
                      (    forth6809.asm):05680         ; rather than the reverse) - starting from 0, increments while
                      (    forth6809.asm):05681         ; less than 5. Naturally exercises both of WHILE's outcomes in
                      (    forth6809.asm):05682         ; one test: the continue path 5 times, the exit path once.
                      (    forth6809.asm):05683         ; Verified by hand-trace: WHILE's patched forward offset (10)
                      (    forth6809.asm):05684         ; lands exactly at the final RTS; REPEAT's patched back-edge

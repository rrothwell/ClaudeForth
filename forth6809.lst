                      (    forth6809.asm):10878                     CMPD #-2
                      (    forth6809.asm):10879                     BNE  AQ2FAIL
                      (    forth6809.asm):10880         
                      (    forth6809.asm):10881                     LDD  TSTUB4
                      (    forth6809.asm):10882                     SUBD TSTUAF
                      (    forth6809.asm):10883                     CMPD #0
                      (    forth6809.asm):10884                     BNE  AQ2FAIL
                      (    forth6809.asm):10885         
                      (    forth6809.asm):10886                     LDD  #TRUEV
                      (    forth6809.asm):10887                     BRA  AQ2DONE
C278                  (    forth6809.asm):10888         AQ2FAIL:    LDD  #FALSEV
C278                  (    forth6809.asm):10889         AQ2DONE:    LDX  #TSTAQ2NAME
                      (    forth6809.asm):10890                     PSHU X
                      (    forth6809.asm):10891                     PSHU D
                      (    forth6809.asm):10892                     JSR  TSTREPORT
                      (    forth6809.asm):10893         
                      (    forth6809.asm):10894                     LDU  TSTU0

                      (    forth6809.asm):05818         ; TSTRECUR - unit test for RECURSE. Builds a fake dictionary
                      (    forth6809.asm):05819         ; header in scratch (TSTFHDR: LEN/FL=3, name "FOO", a
                      (    forth6809.asm):05820         ; don't-care LINK, and DUP's real address as the CFA), points
                      (    forth6809.asm):05821         ; LATEST at it, then calls RECURSE directly. Verifies RECURSE
                      (    forth6809.asm):05822         ; correctly parses an arbitrary header (LEN/FL's 5-bit length
                      (    forth6809.asm):05823         ; field, skipping name+LINK to reach the CFA) and compiles a
                      (    forth6809.asm):05824         ; correct call to it - tests the actual mechanism (header
                      (    forth6809.asm):05825         ; parsing, CFA extraction, CCALL), not genuine self-recursion,
                      (    forth6809.asm):05826         ; which would need a real in-progress compilation to set up
                      (    forth6809.asm):05827         ; meaningfully. Confirmed by hand-trace: RECURSE's own address
                      (    forth6809.asm):05828         ; arithmetic (+1 past LEN/FL, +namelen past the name, +2 past
                      (    forth6809.asm):05829         ; LINK) lands exactly on TSTFHDR+6, where the CFA is placed.
                      (    forth6809.asm):05830         ; ------------------------------------------------------------
C1F2                  (    forth6809.asm):05831         TSTRECUR: LDD  LATEST
                      (    forth6809.asm):05832                   STD  TSTLSAV
                      (    forth6809.asm):05833                   LDD  CODEHERE
                      (    forth6809.asm):05834                   STD  TSTCSAV
                      (    forth6809.asm):05835         
                      (    forth6809.asm):05836                   LDA  #3
                      (    forth6809.asm):05837                   STA  TSTFHDR

                      (    forth6809.asm):03469         
E59D BDE509           (    forth6809.asm):03470                   JSR   NUMLOOP
                      (    forth6809.asm):03471         
E5A0 DC25             (    forth6809.asm):03472                   LDD   NCNT
E5A2 2641             (    forth6809.asm):03473                   BNE   NQBAD
                      (    forth6809.asm):03474         
                      (    forth6809.asm):03475                   ; BUG FIX (as part of this same change): was "LDD UDLO / TST
                      (    forth6809.asm):03476                   ; NUMNEG / BEQ NQPOS / COMA / COMB / ADDD #1" - negated only
                      (    forth6809.asm):03477                   ; the low 16 bits. Harmless for single-cell numbers (the high
                      (    forth6809.asm):03478                   ; cell was never returned before), but wrong once returning a
                      (    forth6809.asm):03479                   ; genuine 32-bit value for the double case - a negative double
                      (    forth6809.asm):03480                   ; needs the full 32-bit two's-complement negation, with any
                      (    forth6809.asm):03481                   ; carry out of the low-cell increment propagated into the
                      (    forth6809.asm):03482                   ; high cell.
E5A4 0D22             (    forth6809.asm):03483                   TST   NUMNEG
E5A6 2718             (    forth6809.asm):03484                   BEQ   NQPOS32
E5A8 DC76             (    forth6809.asm):03485                   LDD   UDLO
E5AA 43               (    forth6809.asm):03486                   COMA
E5AB 53               (    forth6809.asm):03487                   COMB
E5AC C30001           (    forth6809.asm):03488                   ADDD  #1
E5AF DD76             (    forth6809.asm):03489                   STD   UDLO
E5B1 3401             (    forth6809.asm):03490                   PSHS  CC          ; BUG FIX: save the TRUE carry from the
                      (    forth6809.asm):03491                                      ; addition above, before it gets destroyed.
                      (    forth6809.asm):03492                                      ; COM (used on UDHI just below) unconditionally
                      (    forth6809.asm):03493                                      ; SETS carry=1 on the 6809, regardless of its
                      (    forth6809.asm):03494                                      ; operand - a documented quirk, but one that
                      (    forth6809.asm):03495                                      ; silently overwrote the real carry here
                      (    forth6809.asm):03496                                      ; before the BCC check could ever read it,
                      (    forth6809.asm):03497                                      ; making the high-cell increment run
                      (    forth6809.asm):03498                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03499                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03500                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03501                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03502                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03503                                      ; matching "always increment" rather than
                      (    forth6809.asm):03504                                      ; "increment only on genuine carry".
E5B3 DC74             (    forth6809.asm):03505                   LDD   UDHI
E5B5 43               (    forth6809.asm):03506                   COMA
E5B6 53               (    forth6809.asm):03507                   COMB
E5B7 3501             (    forth6809.asm):03508                   PULS  CC          ; restore the TRUE carry
E5B9 2403             (    forth6809.asm):03509                   BCC   NQSTOREHI   ; BUG FIX: this used to be "BCC NQPOS32",
                      (    forth6809.asm):03510                                      ; branching all the way PAST "STD UDHI"
                      (    forth6809.asm):03511                                      ; when there's no carry - the complemented
                      (    forth6809.asm):03512                                      ; value was computed in D but never
                      (    forth6809.asm):03513                                      ; actually stored back to UDHI in that
                      (    forth6809.asm):03514                                      ; case, leaving it at its stale, pre-
                      (    forth6809.asm):03515                                      ; negation value. Masked by the carry bug
                      (    forth6809.asm):03516                                      ; above in practice (that bug meant carry
                      (    forth6809.asm):03517                                      ; was always seen as set, so this branch
                      (    forth6809.asm):03518                                      ; was never actually taken, and STD UDHI
                      (    forth6809.asm):03519                                      ; always ran) - fixing the carry check
                      (    forth6809.asm):03520                                      ; alone would have made this second,
                      (    forth6809.asm):03521                                      ; previously-latent bug live. Now branches
                      (    forth6809.asm):03522                                      ; only past the "+1", never past the
                      (    forth6809.asm):03523                                      ; store itself - the store always runs,
                      (    forth6809.asm):03524                                      ; either way.
E5BB C30001           (    forth6809.asm):03525                   ADDD  #1
E5BE DD74             (    forth6809.asm):03526         NQSTOREHI: STD  UDHI
                      (    forth6809.asm):03527         
E5C0                  (    forth6809.asm):03528         NQPOS32:  ; re-derive from CADDR whether the ORIGINAL last character
                      (    forth6809.asm):03529                   ; was '.' - determines which return convention to use
E5C0 9E1F             (    forth6809.asm):03530                   LDX   CADDR
E5C2 E684             (    forth6809.asm):03531                   LDB   ,X
E5C4 5A               (    forth6809.asm):03532                   DECB
E5C5 3001             (    forth6809.asm):03533                   LEAX  1,X
E5C7 A685             (    forth6809.asm):03534                   LDA   B,X
E5C9 812E             (    forth6809.asm):03535                   CMPA  #'.'
E5CB 260E             (    forth6809.asm):03536                   BNE   NQSINGLE
                      (    forth6809.asm):03537         
                      (    forth6809.asm):03538                   ; DOUBLE success: push low, high, then a distinct success
                      (    forth6809.asm):03539                   ; code (1, not -1) so TRYNUM can tell single and double
                      (    forth6809.asm):03540                   ; apart without needing a separate flag of its own either
E5CD DC76             (    forth6809.asm):03541                   LDD   UDLO
E5CF 3606             (    forth6809.asm):03542                   PSHU  D
E5D1 DC74             (    forth6809.asm):03543                   LDD   UDHI
E5D3 3606             (    forth6809.asm):03544                   PSHU  D
E5D5 CC0001           (    forth6809.asm):03545                   LDD   #1
E5D8 3606             (    forth6809.asm):03546                   PSHU  D
E5DA 39               (    forth6809.asm):03547                   RTS
                      (    forth6809.asm):03548         
E5DB                  (    forth6809.asm):03549         NQSINGLE: ; SINGLE success - unchanged from the original convention
E5DB DC76             (    forth6809.asm):03550                   LDD   UDLO
E5DD 3606             (    forth6809.asm):03551                   PSHU  D
E5DF CCFFFF           (    forth6809.asm):03552                   LDD   #-1
E5E2 3606             (    forth6809.asm):03553                   PSHU  D
E5E4 39               (    forth6809.asm):03554                   RTS
                      (    forth6809.asm):03555         
E5E5 9E1F             (    forth6809.asm):03556         NQBAD:    LDX   CADDR
E5E7 3610             (    forth6809.asm):03557                   PSHU  X
E5E9 CC0000           (    forth6809.asm):03558                   LDD   #0
E5EC 3606             (    forth6809.asm):03559                   PSHU  D
E5EE 39               (    forth6809.asm):03560                   RTS
                      (    forth6809.asm):03561         

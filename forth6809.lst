                      (    forth6809.asm):03661                                      ; UNCONDITIONALLY instead of only when the
                      (    forth6809.asm):03662                                      ; low-cell addition actually overflowed.
                      (    forth6809.asm):03663                                      ; Confirmed via MAME: "-123." returned high
                      (    forth6809.asm):03664                                      ; cell 0 instead of -1, and "-123456."
                      (    forth6809.asm):03665                                      ; returned -1 instead of -2 - both exactly
                      (    forth6809.asm):03666                                      ; matching "always increment" rather than
                      (    forth6809.asm):03667                                      ; "increment only on genuine carry".

                      (    forth6809.asm):00397         ; GLOBALS - real layout, applied. Every scratch/state cell
                      (    forth6809.asm):00398         ; referenced across the whole build now has a fixed address
                      (    forth6809.asm):00399         ; in page zero (DP = $00 at reset, set in COLDSTRT), laid out
                      (    forth6809.asm):00400         ; in RMB order below. Total: 256 of 256 bytes used - the page
                      (    forth6809.asm):00401         ; is fully packed. (DOESBEH and RTSSTATE were added in later
                      (    forth6809.asm):00402         ; passes, after this comment was first written with 253/256;
                      (    forth6809.asm):00403         ; they used up the last 3 bytes of headroom entirely.)
                      (    forth6809.asm):00404         ;
                      (    forth6809.asm):00405         ; SNEND, which appeared in the original placeholder list
                      (    forth6809.asm):00406         ; (documented under S"/."/SLITERAL/ABORT"'s string runtime),
                      (    forth6809.asm):00407         ; was dropped here: a full pass over every reference confirmed
                      (    forth6809.asm):00408         ; it is never actually read or written anywhere - SCNT/SPTR
                      (    forth6809.asm):00409         ; alone carry that runtime. CSAVE was removed earlier (see the
                      (    forth6809.asm):00410         ; COMMA/CODECOMMA history) and was never part of this layout.
                      (    forth6809.asm):00411         ; ============================================================

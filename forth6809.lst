                      (    forth6809.asm):03516         ; ============================================================
                      (    forth6809.asm):03517         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):03518         ; ============================================================
                      (    forth6809.asm):03519         ; ------------------------------------------------------------
                      (    forth6809.asm):03520         ; INTERPRET  ( -- )
                      (    forth6809.asm):03521         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03522         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03523         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03524         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03525         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03526         ; ------------------------------------------------------------
D413                  (    forth6809.asm):03527         INTERPRET:
D413 CC0020           (    forth6809.asm):03528         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
D416 3606             (    forth6809.asm):03529                     PSHU  D                 ; char
D418 BDD493           (    forth6809.asm):03530                     JSR   WORDW
D41B AEC4             (    forth6809.asm):03531                     LDX   ,U
D41D A684             (    forth6809.asm):03532                     LDA   ,X
D41F 276F             (    forth6809.asm):03533                     BEQ   IDONE
                      (    forth6809.asm):03534         
D421 BDD57C           (    forth6809.asm):03535                     JSR   FINDW
D424 3706             (    forth6809.asm):03536                     PULU  D
D426 5D               (    forth6809.asm):03537                     TSTB
D427 10270011         (    forth6809.asm):03538                     LBEQ  TRYNUM
                      (    forth6809.asm):03539         
D42B 9601             (    forth6809.asm):03540                     LDA   STATE+1
D42D 2708             (    forth6809.asm):03541                     BEQ   DOEXEC
D42F 5D               (    forth6809.asm):03542                     TSTB

                      (    forth6809.asm):10478         
                      (    forth6809.asm):10479                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):10480                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):10481                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):10482                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):10483                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):10484                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):10485                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):10486                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):10487                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):10488                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):10489                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):10490                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):10491                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):10492                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):10493                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):10494                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):10495                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):10496                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):10497                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):10498         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):10499                    BEQ  UEDONE
F87D A680             (    forth6809.asm):10500                    LDA  ,X+
F87F 8125             (    forth6809.asm):10501                    CMPA #'%'
F881 2604             (    forth6809.asm):10502                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):10503                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):10504                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):10505                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):10506                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):10507                                   ; the same string correctly, since this runs
                      (    forth6809.asm):10508                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):10509         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):10510                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):10511                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):10512                    SUBD #1
F88E DDA9             (    forth6809.asm):10513                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):10514                    BRA  UELOOP
F892 1F20             (    forth6809.asm):10515         UEDONE:    TFR  Y,D       ; BUG FIX: was "LDD UEOUTLEN / STD ,U" -
F894 93AB             (    forth6809.asm):10516                    SUBD UEDST     ; overwriting whatever was left on top of
F896 DDAD             (    forth6809.asm):10517                    STD  UEOUTLEN  ; the stack rather than pushing both
                      (    forth6809.asm):10518                                   ; required return values, and separately,
                      (    forth6809.asm):10519                                   ; UEOUTLEN itself was never correctly
                      (    forth6809.asm):10520                                   ; tracked by the old backslash-decoding
                      (    forth6809.asm):10521                                   ; loop's own per-character bookkeeping in a
                      (    forth6809.asm):10522                                   ; way that accounted for doubled '%'
                      (    forth6809.asm):10523                                   ; characters. Now computed directly as the
                      (    forth6809.asm):10524                                   ; final write pointer (Y) minus the
                      (    forth6809.asm):10525                                   ; original destination address (UEDST) -
                      (    forth6809.asm):10526                                   ; correct regardless of how many characters
                      (    forth6809.asm):10527                                   ; were doubled, since it's derived from
                      (    forth6809.asm):10528                                   ; where writing actually stopped rather than
                      (    forth6809.asm):10529                                   ; incremented alongside it.
F898 DCAB             (    forth6809.asm):10530                    LDD  UEDST
F89A 3606             (    forth6809.asm):10531                    PSHU D         ; push c-addr2 (destination address)
F89C DCAD             (    forth6809.asm):10532                    LDD  UEOUTLEN
F89E 3606             (    forth6809.asm):10533                    PSHU D         ; push u2 (actual unescaped length)

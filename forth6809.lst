D704 20F3             (    forth6809.asm):03969                     BRA   SOCHK
D706 3506             (    forth6809.asm):03970         SOCOPY:     PULS  A,B               ; B = n
D708 8E004B           (    forth6809.asm):03971                     LDX   #ORDER
D70B 5D               (    forth6809.asm):03972         SOCP2:      TSTB

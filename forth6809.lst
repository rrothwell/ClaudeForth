DFC3 CCDE72           (    forth6809.asm):02978                  LDD   #DODOES
DFC6 3606             (    forth6809.asm):02979                  PSHU  D
DFC8 BDEA4C           (    forth6809.asm):02980                  JSR   CCALL
DFCB CCDE7D           (    forth6809.asm):02981                  LDD   #DOESRT0
DFCE 3606             (    forth6809.asm):02982                  PSHU  D
DFD0 BDDEE6           (    forth6809.asm):02983                  JSR   CODECOMMA
DFD3 DC08             (    forth6809.asm):02984                  LDD   CODEHERE  ; BUG FIX: same self-referential PFA bug as
DFD5 C30002           (    forth6809.asm):02985                  ADDD  #2        ; CONSTANT/DEFER/2CONSTANT/MARKER (CONSTANT's
DFD8 3606             (    forth6809.asm):02986                  PSHU  D         ; instance confirmed via MAME debugger) -
DFDA BDDEE6           (    forth6809.asm):02987                  JSR   CODECOMMA ; without +2 this pointed at itself instead
                      (    forth6809.asm):02988                                   ; of the value cell that "," appends next.
                      (    forth6809.asm):02989                                   ; Never on the previously-flagged list (only
                      (    forth6809.asm):02990                                   ; DEFER/2CONSTANT/MARKER were), so it went
                      (    forth6809.asm):02991                                   ; unfixed until confirmed by inspection here.
                      (    forth6809.asm):02992                                   ; Confirmed via MAME: ": ENUM CREATE , DOES>
                      (    forth6809.asm):02993                                   ; @ ;" returned the PFA-pointer field's own
                      (    forth6809.asm):02994                                   ; address instead of the value COMMA stored
                      (    forth6809.asm):02995                                   ; one cell further on - exactly "the address
                      (    forth6809.asm):02996                                   ; before the 16-bit constant" instead of the
                      (    forth6809.asm):02997                                   ; address 1 cell further on, matching a
                      (    forth6809.asm):02998                                   ; user-reported MAME trace precisely.

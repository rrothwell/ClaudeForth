                      (    forth6809.asm):07496                   PSHU D
                      (    forth6809.asm):07497                   JSR  LITERALW
                      (    forth6809.asm):07498                   JSR  OF
                      (    forth6809.asm):07499                   LDD  #222
                      (    forth6809.asm):07500                   PSHU D
                      (    forth6809.asm):07501                   JSR  LITERALW
                      (    forth6809.asm):07502                   JSR  ENDOF
                      (    forth6809.asm):07503         
                      (    forth6809.asm):07504                   JSR  ENDCASE
                      (    forth6809.asm):07505         

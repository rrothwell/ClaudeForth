                      (    forth6809.asm):07761         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):07762         ; ============================================================
                      (    forth6809.asm):07763         ; ------------------------------------------------------------
                      (    forth6809.asm):07764         ; TRUE  ( -- flag )
                      (    forth6809.asm):07765         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):07766         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):07767         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):07768         ; ------------------------------------------------------------
FCFA CCFFFF           (    forth6809.asm):07769         TRUEW:      LDD   #$FFFF
FCFD 3606             (    forth6809.asm):07770                     PSHU  D
FCFF 39               (    forth6809.asm):07771                     RTS
                      (    forth6809.asm):07772         
                      (    forth6809.asm):07773         ; ------------------------------------------------------------
                      (    forth6809.asm):07774         ; FALSE  ( -- flag )
                      (    forth6809.asm):07775         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):07776         ; ------------------------------------------------------------
FD00 CC0000           (    forth6809.asm):07777         FALSEW:     LDD   #$0000
FD03 3606             (    forth6809.asm):07778                     PSHU  D
FD05 39               (    forth6809.asm):07779                     RTS
                      (    forth6809.asm):07780         
                      (    forth6809.asm):07781         ; ------------------------------------------------------------
                      (    forth6809.asm):07782         ; 1  ( -- 1 )
                      (    forth6809.asm):07783         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):07784         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):07785         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):07786         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):07787         ; ------------------------------------------------------------
FD06 CC0001           (    forth6809.asm):07788         POSONEW:    LDD   #1
FD09 3606             (    forth6809.asm):07789                     PSHU  D
FD0B 39               (    forth6809.asm):07790                     RTS
                      (    forth6809.asm):07791         
                      (    forth6809.asm):07792         ; ------------------------------------------------------------
                      (    forth6809.asm):07793         ; -1  ( -- -1 )
                      (    forth6809.asm):07794         ; Push the constant -1.
                      (    forth6809.asm):07795         ; ------------------------------------------------------------
FD0C CCFFFF           (    forth6809.asm):07796         NEGONEW:    LDD   #-1
FD0F 3606             (    forth6809.asm):07797                     PSHU  D
FD11 39               (    forth6809.asm):07798                     RTS
                      (    forth6809.asm):07799         
                      (    forth6809.asm):07800         ; ------------------------------------------------------------
                      (    forth6809.asm):07801         ; 2  ( -- 2 )
                      (    forth6809.asm):07802         ; Push the constant 2.
                      (    forth6809.asm):07803         ; ------------------------------------------------------------
FD12 CC0002           (    forth6809.asm):07804         POSTWOW:    LDD   #2
FD15 3606             (    forth6809.asm):07805                     PSHU  D
FD17 39               (    forth6809.asm):07806                     RTS
                      (    forth6809.asm):07807         
                      (    forth6809.asm):07808         ; ------------------------------------------------------------
                      (    forth6809.asm):07809         ; -2  ( -- -2 )
                      (    forth6809.asm):07810         ; Push the constant -2.
                      (    forth6809.asm):07811         ; ------------------------------------------------------------
FD18 CCFFFE           (    forth6809.asm):07812         NEGTWOW:    LDD   #-2
FD1B 3606             (    forth6809.asm):07813                     PSHU  D
FD1D 39               (    forth6809.asm):07814                     RTS
                      (    forth6809.asm):07815         
                      (    forth6809.asm):07816         ; Verify no collision with init code,
                      (    forth6809.asm):07817         ; value should match ORG INITCODE.
     FD1E             (    forth6809.asm):07818         BASECODEEND EQU   *
     205A             (    forth6809.asm):07819         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):07820         
                      (    forth6809.asm):07821         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):07822         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):07823         ; .bin file.
FD1E                  (    forth6809.asm):07824         BASEND:
FD1E FFFFFFFFFFFFFFFF (    forth6809.asm):07825                     FILL  $FF,INITCODE-BASEND

DC96 3410             (    forth6809.asm):04982                     PSHS  X
DC98 39               (    forth6809.asm):04983                     RTS
                      (    forth6809.asm):04984         
                      (    forth6809.asm):04985         ; ------------------------------------------------------------
                      (    forth6809.asm):04986         ; I  ( -- n )
                      (    forth6809.asm):04987         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04988         ; address).
                      (    forth6809.asm):04989         ; ------------------------------------------------------------
DC99 EC62             (    forth6809.asm):04990         IW:         LDD   2,S               ; n. See bugfix: IW.1
DC9B 3606             (    forth6809.asm):04991                     PSHU  D
DC9D 39               (    forth6809.asm):04992                     RTS
                      (    forth6809.asm):04993         
                      (    forth6809.asm):04994         ; ------------------------------------------------------------
                      (    forth6809.asm):04995         ; J  ( -- n )
                      (    forth6809.asm):04996         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04997         ; address and the inner loop frame).
                      (    forth6809.asm):04998         ; ------------------------------------------------------------
DC9E EC68             (    forth6809.asm):04999         JW:         LDD   8,S               ; n. See bugfix: JW.1

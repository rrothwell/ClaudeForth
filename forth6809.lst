                      (    forth6809.asm):09557         
                      (    forth6809.asm):09558         ; ------------------------------------------------------------
                      (    forth6809.asm):09559         ; Compiling-words test harness (glossary section 3.10). Reuses
                      (    forth6809.asm):09560         ; the scratch infrastructure established for sections 3.8/3.9
                      (    forth6809.asm):09561         ; (TSTCBUF/TSTCBUF2 for CODEHERE redirects, TSTFHDR for a fake
                      (    forth6809.asm):09562         ; dictionary header, TSTNAMEB for a fake source name). POSTPONE
                      (    forth6809.asm):09563         ; is this section's own hardest case: a genuine two-level
                      (    forth6809.asm):09564         ; compile-time mechanism (compiling code that, for a normal
                      (    forth6809.asm):09565         ; word, itself compiles a call to that word later, when the
                      (    forth6809.asm):09566         ; current definition eventually runs - not immediately, unlike
                      (    forth6809.asm):09567         ; every other compile-time word tested so far). ABORT" is safely
                      (    forth6809.asm):09568         ; testable for both its true and false flag cases - traced its
                      (    forth6809.asm):09569         ; own runtime behavior directly and confirmed it uses THROW -2
                      (    forth6809.asm):09570         ; internally, not the raw, never-returns ABORT mechanism plain
                      (    forth6809.asm):09571         ; ABORT itself uses (which remains untested, per section 3.1's
                      (    forth6809.asm):09572         ; own reasoning).
                      (    forth6809.asm):09573         ; ------------------------------------------------------------
                      (    forth6809.asm):09574         
                      (    forth6809.asm):09575         ; ------------------------------------------------------------
                      (    forth6809.asm):09576         ; TSTIMMED - unit test for IMMEDIATE. Builds a fake header (LEN/
                      (    forth6809.asm):09577         ; FL=3, no flags), points LATEST at it, calls IMMEDIATE, and
                      (    forth6809.asm):09578         ; verifies the header's own LEN/FL byte now has bit 7 set -
                      (    forth6809.asm):09579         ; confirmed a memory-only operation with no data-stack effect,
                      (    forth6809.asm):09580         ; so the guard check is the whole verification beyond that.
                      (    forth6809.asm):09581         ; ------------------------------------------------------------
C281                  (    forth6809.asm):09582         TSTIMMED: LDD  LATEST
                      (    forth6809.asm):09583                   STD  TSTLSAV

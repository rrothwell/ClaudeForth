                      (    forth6809.asm):12777         ; TSTDOTQUOTE - unit test for .". No STATE check at all in its
                      (    forth6809.asm):12778         ; own code (confirmed by reading it directly - matches "no
                      (    forth6809.asm):12779         ; interpretation semantics, per ANS" without a specific -14
                      (    forth6809.asm):12780         ; throw, unlike [CHAR]/S"), so only the compiling case is
                      (    forth6809.asm):12781         ; tested, matching how it's actually meant to be used. Its own
                      (    forth6809.asm):12782         ; runtime (DOTSTR) calls TYPE internally, which has two entirely
                      (    forth6809.asm):12783         ; different implementations gated by SERIALPOLL (the same real
                      (    forth6809.asm):12784         ; finding from section 3.1) - applying that lesson from the
                      (    forth6809.asm):12785         ; start here rather than re-discovering it: EMITCH works
                      (    forth6809.asm):12786         ; universally for a single-character check, but this outputs
                      (    forth6809.asm):12787         ; multiple characters, so - matching TSTCR's own established
                      (    forth6809.asm):12788         ; fix - the full OUTHEAD/OUTBUF check only applies under
                      (    forth6809.asm):12789         ; SERIALPOLL=0, with a narrower EMITCH-based check (last
                      (    forth6809.asm):12790         ; character only, plus the stack-depth check) for SERIALPOLL=1.
                      (    forth6809.asm):12791         ; ------------------------------------------------------------
C2A8                  (    forth6809.asm):12792         TSTDOTQUOTE: LDD  CODEHERE
                      (    forth6809.asm):12793                      STD  TSTCSAV

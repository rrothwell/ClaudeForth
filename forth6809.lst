                      (    forth6809.asm):04522                     RTS
D946                  (    forth6809.asm):04523         KQFALSE:    LDD   #FALSEV
                      (    forth6809.asm):04524                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04525                     RTS
                      (    forth6809.asm):04526         
                      (    forth6809.asm):04527         ; ------------------------------------------------------------

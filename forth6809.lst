                      (    forth6809.asm):01026         ; TSTCR - unit test for CR. Verifies both queued bytes (13 then
                      (    forth6809.asm):01027         ; 10, CR then LF, matching the documented "CR then LF") land
                      (    forth6809.asm):01028         ; correctly in the output ring buffer, in order.
                      (    forth6809.asm):01029         ; ------------------------------------------------------------
C218 FF021B           (    forth6809.asm):01030         TSTCR:   STU   TSTU0
                      (    forth6809.asm):01031         
                      (    forth6809.asm):01032                  IFEQ SERIALPOLL  ; >>>>
                      (    forth6809.asm):01033                  LDA   OUTHEAD
                      (    forth6809.asm):01034                  STA   TSTOHSAV
                      (    forth6809.asm):01035                  ENDC ; <<<<
                      (    forth6809.asm):01036         
                      (    forth6809.asm):01037         
C21B CC3C7A           (    forth6809.asm):01038                  LDD   #TSTGUARD
C21E 3606             (    forth6809.asm):01039                  PSHU  D
C220 FF021D           (    forth6809.asm):01040                  STU   TSTUB4
                      (    forth6809.asm):01041         
C223 BDFC2B           (    forth6809.asm):01042                  JSR   CRW
                      (    forth6809.asm):01043         
C226 FF021F           (    forth6809.asm):01044                  STU   TSTUAF
                      (    forth6809.asm):01045         
                      (    forth6809.asm):01046                  IFEQ SERIALPOLL  ; >>>> full check: interrupt-driven EMIT
                      (    forth6809.asm):01047                                   ; queues both bytes into OUTBUF, verifiable
                      (    forth6809.asm):01048                                   ; in order
                      (    forth6809.asm):01049                  LDA   TSTOHSAV
                      (    forth6809.asm):01050                  ADDA  #2
                      (    forth6809.asm):01051                  ANDA  #OUTBUFSZ-1
                      (    forth6809.asm):01052                  CMPA  OUTHEAD
                      (    forth6809.asm):01053                  BNE   CRFAIL
                      (    forth6809.asm):01054         
                      (    forth6809.asm):01055                  LDX   #OUTBUF
                      (    forth6809.asm):01056                  LDB   TSTOHSAV
                      (    forth6809.asm):01057                  LDA   B,X
                      (    forth6809.asm):01058                  CMPA  #13
                      (    forth6809.asm):01059                  BNE   CRFAIL
                      (    forth6809.asm):01060                  INCB
                      (    forth6809.asm):01061                  ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01062                  LDA   B,X
                      (    forth6809.asm):01063                  CMPA  #10
                      (    forth6809.asm):01064                  BNE   CRFAIL
                      (    forth6809.asm):01065                  ELSE  ; <<<<>>>> BUG FIX: was unconditionally checking OUTHEAD/
                      (    forth6809.asm):01066                                   ; OUTBUF, assuming the interrupt-driven EMIT.
                      (    forth6809.asm):01067                                   ; Real bug found via MAME: EMIT has two
                      (    forth6809.asm):01068                                   ; entirely different implementations, gated
                      (    forth6809.asm):01069                                   ; the same way as KEY's own two variants - the
                      (    forth6809.asm):01070                                   ; polling one (SERIALPOLL=1, confirmed the
                      (    forth6809.asm):01071                                   ; currently active build) writes directly to
                      (    forth6809.asm):01072                                   ; ACIADR and never touches OUTHEAD/OUTBUF at
                      (    forth6809.asm):01073                                   ; all, so this check always failed despite
                      (    forth6809.asm):01074                                   ; both characters genuinely being transmitted
                      (    forth6809.asm):01075                                   ; (confirmed in the terminal output itself).
                      (    forth6809.asm):01076                                   ; EMITCH only reflects the LAST of the two
                      (    forth6809.asm):01077                                   ; characters CRW emits (10, the LF) by the
                      (    forth6809.asm):01078                                   ; time this runs, since each EMIT call
                      (    forth6809.asm):01079                                   ; overwrites it - checking that plus the
                      (    forth6809.asm):01080                                   ; depth check below is the most this variant
                      (    forth6809.asm):01081                                   ; genuinely allows verifying; a direct
                      (    forth6809.asm):01082                                   ; hardware write has no other inspectable,
                      (    forth6809.asm):01083                                   ; persistent state.
C229 963C             (    forth6809.asm):01084                  LDA   EMITCH
C22B 810A             (    forth6809.asm):01085                  CMPA  #10
C22D 2619             (    forth6809.asm):01086                  BNE   CRFAIL
                      (    forth6809.asm):01087                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):01088         
C22F 3706             (    forth6809.asm):01089                  PULU  D
C231 10833C7A         (    forth6809.asm):01090                  CMPD  #TSTGUARD

                      (    forth6809.asm):05006         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05007         ; ------------------------------------------------------------
DCA3 CCFFFF           (    forth6809.asm):05008         LEAVEW:     LDD   #TRUEV            ; true
DCA6 ED66             (    forth6809.asm):05009                     STD   6,S               ; See bugfix: LEAVEW.1
DCA8 39               (    forth6809.asm):05010                     RTS
                      (    forth6809.asm):05011         
                      (    forth6809.asm):05012         ; ------------------------------------------------------------
                      (    forth6809.asm):05013         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05014         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05015         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05016         ; ------------------------------------------------------------
DCA9 3706             (    forth6809.asm):05017         LOOPW:      PULU  D
DCAB 10830003         (    forth6809.asm):05018                     CMPD  #TAGDO
DCAF 2703             (    forth6809.asm):05019                     BEQ   LOOPOK
DCB1 BDDA7A           (    forth6809.asm):05020                     JSR   CFERR
DCB4 3706             (    forth6809.asm):05021         LOOPOK:     PULU  D                 ; dest
DCB6 3606             (    forth6809.asm):05022                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DCB8 CCDCE8           (    forth6809.asm):05023                     LDD   #DOTEST
DCBB 3606             (    forth6809.asm):05024                     PSHU  D
DCBD BDDEEA           (    forth6809.asm):05025                     JSR   CCALL
DCC0 CC0000           (    forth6809.asm):05026                     LDD   #0
DCC3 3606             (    forth6809.asm):05027                     PSHU  D
DCC5 BDD20F           (    forth6809.asm):05028                     JSR   CODECOMMA
DCC8 DC08             (    forth6809.asm):05029                     LDD   CODEHERE
DCCA 830002           (    forth6809.asm):05030                     SUBD  #2
DCCD 3606             (    forth6809.asm):05031                     PSHU  D                 ; location; the parked dest is beneath
DCCF BDDAE4           (    forth6809.asm):05032                     JSR   PATCH
                      (    forth6809.asm):05033         
DCD2 ECC4             (    forth6809.asm):05034                     LDD   ,U

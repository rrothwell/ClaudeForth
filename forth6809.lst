                      (   unit_tests.asm):07783         ; TSTCRDOES - unit test for CREATE/DOES> together. Compiles the
                      (   unit_tests.asm):07784         ; equivalent of "CREATE TESTWD 5 , DOES> @ 1+" directly (CREATE,
                      (   unit_tests.asm):07785         ; store 5 at the PFA, DOES>'s own compile action, then @ and 1+
                      (   unit_tests.asm):07786         ; compiled as the new behavior, terminated with RTS) - executing
                      (   unit_tests.asm):07787         ; TESTWD should push 6 (5 fetched, then incremented).
                      (   unit_tests.asm):07788         ;
                      (   unit_tests.asm):07789         ; DOES>'s own runtime action (SETDOES) does a documented "double
                      (   unit_tests.asm):07790         ; return": it patches LATEST's behavior field using the return
                      (   unit_tests.asm):07791         ; address ITS OWN "JSR SETDOES" call provides, then pops a
                      (   unit_tests.asm):07792         ; SECOND return address and jumps there - designed for the
                      (   unit_tests.asm):07793         ; normal case where DOES> is reached from inside an enclosing
                      (   unit_tests.asm):07794         ; defining word (like a real ": MAKETEST CREATE ... DOES> ... ;"
                      (   unit_tests.asm):07795         ; would compile), which itself has its own caller. Traced by
                      (   unit_tests.asm):07796         ; hand: calling directly into the compiled "JSR SETDOES"
                      (   unit_tests.asm):07797         ; instruction itself (not through an intermediate wrapper)
                      (   unit_tests.asm):07798         ; naturally supplies exactly the two stack levels SETDOES
                      (   unit_tests.asm):07799         ; expects - its own JSR provides the first (becoming the new
                      (   unit_tests.asm):07800         ; behavior field value), and this test's own call provides the
                      (   unit_tests.asm):07801         ; second (correctly resuming here afterward) - no extra
                      (   unit_tests.asm):07802         ; scaffolding needed, confirmed correct rather than assumed.
                      (   unit_tests.asm):07803         ; ------------------------------------------------------------
C264                  (   unit_tests.asm):07804         TSTCRDOES:  LDD   CODEHERE
                      (   unit_tests.asm):07805                     STD   TSTCSAV
                      (   unit_tests.asm):07806                     LDD   DPHERE
                      (   unit_tests.asm):07807                     STD   TSTDSAV
                      (   unit_tests.asm):07808                     LDD   VARHERE
                      (   unit_tests.asm):07809                     STD   TSTVSAV
                      (   unit_tests.asm):07810                     LDD   SRCADDR
                      (   unit_tests.asm):07811                     STD   TSTSASAV
                      (   unit_tests.asm):07812                     LDD   SRCLEN
                      (   unit_tests.asm):07813                     STD   TSTSLSAV

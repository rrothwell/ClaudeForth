D8C0 E7E4             (    forth6809.asm):04157                     STB   ,S
D8C2 9603             (    forth6809.asm):04158                     LDA   BASE+1
D8C4 A761             (    forth6809.asm):04159                     STA   1,S
D8C6 A647             (    forth6809.asm):04160                     LDA   7,U
D8C8 E661             (    forth6809.asm):04161                     LDB   1,S
D8CA 3D               (    forth6809.asm):04162                     MUL

                      (    forth6809.asm):07815                    JSR   TSTCONST
                      (    forth6809.asm):07816                    JSR   TSTCOLON
                      (    forth6809.asm):07817                    JSR   TSTCRDOES
                      (    forth6809.asm):07818                    JSR   TST2VAR
                      (    forth6809.asm):07819                    JSR   TST2CONST
                      (    forth6809.asm):07820                    JSR   TSTBUFC
                      (    forth6809.asm):07821                    JSR   TSTVALTO
                      (    forth6809.asm):07822                    JSR   TSTDEFER1
                      (    forth6809.asm):07823                    JSR   TSTDEFER2
                      (    forth6809.asm):07824                    JSR   TSTISOF

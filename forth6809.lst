                      (    forth6809.asm):01470         ; TSTDROP - unit test for DROP ( x -- ). Verifies both the
                      (    forth6809.asm):01471         ; stack's contents (the guard beneath the dropped value is left
                      (    forth6809.asm):01472         ; undisturbed, and is now the new top) and the data stack
                      (    forth6809.asm):01473         ; pointer's movement (exactly one cell, 2 bytes, freed - DROP's
                      (    forth6809.asm):01474         ; own net effect, not conflated with the two pushes that set the
                      (    forth6809.asm):01475         ; test up).
                      (    forth6809.asm):01476         ; ------------------------------------------------------------
C100                  (    forth6809.asm):01477         TSTDROP:   STU   TSTU0
                      (    forth6809.asm):01478         

DD58 2719             (    forth6809.asm):01672                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01673         
DD5A B6C008           (    forth6809.asm):01674                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
DD5D 8508             (    forth6809.asm):01675                     BITA  #SR_CTS
DD5F 2612             (    forth6809.asm):01676                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01677         

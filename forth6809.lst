                      (    forth6809.asm):02944         ; ============================================================
                      (    forth6809.asm):02945         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02946         ; ============================================================
                      (    forth6809.asm):02947         ; ------------------------------------------------------------
                      (    forth6809.asm):02948         ; INTERPRET  ( -- )
                      (    forth6809.asm):02949         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02950         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02951         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02952         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02953         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02954         ; ------------------------------------------------------------
E2C7                  (    forth6809.asm):02955         INTERPRET:
E2C7 CC0020           (    forth6809.asm):02956         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1

                      (    forth6809.asm):07802                    JSR   TSTCONST
                      (    forth6809.asm):07803                    JSR   TSTCOLON
                      (    forth6809.asm):07804                    JSR   TSTCRDOES
                      (    forth6809.asm):07805                    JSR   TST2VAR
                      (    forth6809.asm):07806                    JSR   TST2CONST
                      (    forth6809.asm):07807                    JSR   TSTBUFC
                      (    forth6809.asm):07808                    JSR   TSTVALTO

                      (   unit_tests.asm):06767         ; TSTLEAVE - unit test for LEAVE. Compiles
                      (   unit_tests.asm):06768         ; "DO I DUP 3 LITERAL = IF LEAVE THEN + LOOP", limit=10,
                      (   unit_tests.asm):06769         ; start=0 - would normally visit I=0..9, but LEAVE forces exit
                      (   unit_tests.asm):06770         ; once I=3 is reached. LEAVE only sets a flag; the actual exit
                      (   unit_tests.asm):06771         ; happens at the NEXT LOOP check (per its own documented
                      (   unit_tests.asm):06772         ; behavior, "exit at its next LOOP") - confirmed by hand-trace
                      (   unit_tests.asm):06773         ; of DOTEST's own logic (checks the flag first, before its
                      (   unit_tests.asm):06774         ; normal increment/compare). Since + runs before LOOP's check,
                      (   unit_tests.asm):06775         ; I=3 IS accumulated before the loop exits - sum=0+1+2+3=6, not
                      (   unit_tests.asm):06776         ; 0+1+2=3 (which would indicate LEAVE incorrectly took effect
                      (   unit_tests.asm):06777         ; immediately) and not the full 0..9 (which would indicate
                      (   unit_tests.asm):06778         ; LEAVE didn't work at all).
                      (   unit_tests.asm):06779         ; ------------------------------------------------------------

F38C 39               (    forth6809.asm):06223                     RTS
                      (    forth6809.asm):06224         
                      (    forth6809.asm):06225         ; ------------------------------------------------------------
                      (    forth6809.asm):06226         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06227         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06228         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06229         ; PARSEQUOTE
                      (    forth6809.asm):06230         ;    Inputs:
                      (    forth6809.asm):06231         ;        none (parses from >IN)
                      (    forth6809.asm):06232         ;    Outputs:
                      (    forth6809.asm):06233         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06234         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06235         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06236         ; ------------------------------------------------------------
F38D CC0022           (    forth6809.asm):06237         PARSEQUOTE: LDD   #34
F390 3606             (    forth6809.asm):06238                     PSHU  D
F392 BDF459           (    forth6809.asm):06239                     JSR   PARSEW
F395 6DC4             (    forth6809.asm):06240                     TST   ,U                ; high byte of the length
F397 2601             (    forth6809.asm):06241                     BNE   PQLONG
F399 39               (    forth6809.asm):06242                     RTS
F39A CCFFEE           (    forth6809.asm):06243         PQLONG:     LDD   #-18
F39D 3606             (    forth6809.asm):06244                     PSHU  D
F39F 7EE5FE           (    forth6809.asm):06245                     JMP   THROWW
                      (    forth6809.asm):06246         
                      (    forth6809.asm):06247         ; ------------------------------------------------------------
                      (    forth6809.asm):06248         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06249         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06250         ;    Inputs:
                      (    forth6809.asm):06251         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06252         ;        c-addr u on the data stack
                      (    forth6809.asm):06253         ;    Outputs:
                      (    forth6809.asm):06254         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06255         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06256         ; ------------------------------------------------------------
F3A2 3606             (    forth6809.asm):06257         CSTRCOMP:   PSHU  D
F3A4 BDEA39           (    forth6809.asm):06258                     JSR   CCALL
F3A7 3706             (    forth6809.asm):06259                     PULU  D                 ; u
F3A9 3720             (    forth6809.asm):06260                     PULU  Y                 ; c-addr

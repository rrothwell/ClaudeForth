                      (    forth6809.asm):20121         
                      (    forth6809.asm):20122                  IFNE  UNITTESTS  ; >>>>>>>>>>
FFC6 BDC135           (    forth6809.asm):20123                  JSR   TSTRUNNER
                      (    forth6809.asm):20124                  ELSE  ; <<<<<>>>>>
                      (    forth6809.asm):20125                  NOP             ; BUG FIX (see the historical note above this
                      (    forth6809.asm):20126                  NOP             ; call site's own comment, describing the
                      (    forth6809.asm):20127                  NOP             ; original bug): this call site used to emit
                      (    forth6809.asm):20128                                  ; 0 bytes when UNITTESTS' flag meaning
                      (    forth6809.asm):20129                                  ; excluded the test framework, meaning
                      (    forth6809.asm):20130                                  ; COLDSTRT's own size varied by 3 bytes
                      (    forth6809.asm):20131                                  ; depending on UNITTESTS - with INITCODE's
                      (    forth6809.asm):20132                                  ; own position fixed regardless, that risked
                      (    forth6809.asm):20133                                  ; the code overflowing into VECTORS whenever
                      (    forth6809.asm):20134                                  ; UNITTESTS was toggled on. Three NOPs here
                      (    forth6809.asm):20135                                  ; are byte-for-byte the same size as the
                      (    forth6809.asm):20136                                  ; JSR TSTRUNNER they replace, so this block
                      (    forth6809.asm):20137                                  ; now always contributes exactly 3 bytes to
                      (    forth6809.asm):20138                                  ; COLDSTRT either way - COLDSTRT's total size
                      (    forth6809.asm):20139                                  ; no longer depends on UNITTESTS at all.
                      (    forth6809.asm):20140                  ENDC  ; <<<<<<<<<<
                      (    forth6809.asm):20141         

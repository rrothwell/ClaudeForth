                      (    forth6809.asm):03950                    JSR   TSTAND
                      (    forth6809.asm):03951                    JSR   TSTOR
                      (    forth6809.asm):03952                    JSR   TSTXOR
                      (    forth6809.asm):03953                    JSR   TSTINV
                      (    forth6809.asm):03954                    JSR   TSTLSH
                      (    forth6809.asm):03955                    JSR   TSTRSH
                      (    forth6809.asm):03956                    JSR   TSTCELS
                      (    forth6809.asm):03957                    JSR   TSTCELP
                      (    forth6809.asm):03958                    JSR   TSTCHRS
                      (    forth6809.asm):03959                    JSR   TSTCHRP
                      (    forth6809.asm):03960                    JSR   TSTALGD
                      (    forth6809.asm):03961                    JSR   TSTALGN
                      (    forth6809.asm):03962         
                      (    forth6809.asm):03963                    ENDC ; <<<<

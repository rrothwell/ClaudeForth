                      (    forth6809.asm):02664                                   ; session. Confirmed via MAME debugger.
                      (    forth6809.asm):02665         
DDDB BDE5B5           (    forth6809.asm):02666         QLOOP:   JSR   QUERY
                      (    forth6809.asm):02667         
DDDE DC06             (    forth6809.asm):02668                  LDD   DPHERE
DDE0 DDF3             (    forth6809.asm):02669                  STD   QSAVEDP
DDE2 DC08             (    forth6809.asm):02670                  LDD   CODEHERE
DDE4 DDF5             (    forth6809.asm):02671                  STD   QSAVECODE
DDE6 DC0A             (    forth6809.asm):02672                  LDD   VARHERE
DDE8 DDF7             (    forth6809.asm):02673                  STD   QSAVEVAR
DDEA DC04             (    forth6809.asm):02674                  LDD   LATEST
DDEC DDF9             (    forth6809.asm):02675                  STD   QSAVELATEST
                      (    forth6809.asm):02676         

FCD7 272B             (    forth6809.asm):22734                   BEQ  ENV2START  ; CHANGED: was BEQ ENVNOTFOUND - now tries
                      (    forth6809.asm):22735                                     ; the double-cell table (below) before
                      (    forth6809.asm):22736                                     ; giving up entirely. See ENV2START/
                      (    forth6809.asm):22737                                     ; ENV2LOOP for MAX-D/MAX-UD, added this
                      (    forth6809.asm):22738                                     ; turn - both are double-cell values per
                      (    forth6809.asm):22739                                     ; their own ANS data type, which this
                      (    forth6809.asm):22740                                     ; single-cell table's ENVFOUND (pushing
                      (    forth6809.asm):22741                                     ; exactly one value before TRUE) can't
                      (    forth6809.asm):22742                                     ; represent correctly.
FCD9 3410             (    forth6809.asm):22743                   PSHS X          ; BUG FIX: COMPAREW uses X as its own

                      (    forth6809.asm):09105         ; TSTISOF - unit test for IS and ACTION-OF together. Compiles
                      (    forth6809.asm):09106         ; "DEFER TESTWD", interprets "DUP IS TESTWD" directly (IS parses
                      (    forth6809.asm):09107         ; "TESTWD" via WORD+FIND, needing LATEST still pointed at it -
                      (    forth6809.asm):09108         ; not restored until this whole test finishes), executes TESTWD
                      (    forth6809.asm):09109         ; (should now behave like DUP), then interprets "ACTION-OF
                      (    forth6809.asm):09110         ; TESTWD" to fetch the current target by name and confirms it
                      (    forth6809.asm):09111         ; matches DUP's own xt. Explicitly forces STATE=0 before both IS
                      (    forth6809.asm):09112         ; and ACTION-OF, since both are documented to behave differently
                      (    forth6809.asm):09113         ; by STATE, same reasoning as TSTVALTO's own TO test.
                      (    forth6809.asm):09114         ; ------------------------------------------------------------
C255                  (    forth6809.asm):09115         TSTISOF: LDD   CODEHERE
                      (    forth6809.asm):09116                  STD   TSTCSAV
                      (    forth6809.asm):09117                  LDD   DPHERE
                      (    forth6809.asm):09118                  STD   TSTDSAV
                      (    forth6809.asm):09119                  LDD   VARHERE
                      (    forth6809.asm):09120                  STD   TSTVSAV
                      (    forth6809.asm):09121                  LDD   SRCADDR
                      (    forth6809.asm):09122                  STD   TSTSASAV
                      (    forth6809.asm):09123                  LDD   SRCLEN
                      (    forth6809.asm):09124                  STD   TSTSLSAV
                      (    forth6809.asm):09125                  LDD   TOIN
                      (    forth6809.asm):09126                  STD   TSTTISAV
                      (    forth6809.asm):09127                  LDD   STATE
                      (    forth6809.asm):09128                  STD   TSTSTSAV
                      (    forth6809.asm):09129                  LDD   LATEST
                      (    forth6809.asm):09130                  STD   TSTLSAV
                      (    forth6809.asm):09131         
                      (    forth6809.asm):09132                  LDA   #'T'
                      (    forth6809.asm):09133                  STA   TSTNAMEB
                      (    forth6809.asm):09134                  LDA   #'E'
                      (    forth6809.asm):09135                  STA   TSTNAMEB+1
                      (    forth6809.asm):09136                  LDA   #'S'
                      (    forth6809.asm):09137                  STA   TSTNAMEB+2
                      (    forth6809.asm):09138                  LDA   #'T'
                      (    forth6809.asm):09139                  STA   TSTNAMEB+3
                      (    forth6809.asm):09140                  LDA   #'W'
                      (    forth6809.asm):09141                  STA   TSTNAMEB+4
                      (    forth6809.asm):09142                  LDA   #'D'
                      (    forth6809.asm):09143                  STA   TSTNAMEB+5
                      (    forth6809.asm):09144         
                      (    forth6809.asm):09145                  LDD   #TSTCBUF
                      (    forth6809.asm):09146                  STD   CODEHERE
                      (    forth6809.asm):09147                  LDD   #TSTDBUF
                      (    forth6809.asm):09148                  STD   DPHERE
                      (    forth6809.asm):09149                  LDD   #TSTVBUF
                      (    forth6809.asm):09150                  STD   VARHERE
                      (    forth6809.asm):09151                  LDD   #TSTNAMEB
                      (    forth6809.asm):09152                  STD   SRCADDR
                      (    forth6809.asm):09153                  LDD   #6
                      (    forth6809.asm):09154                  STD   SRCLEN
                      (    forth6809.asm):09155                  LDD   #0
                      (    forth6809.asm):09156                  STD   TOIN
                      (    forth6809.asm):09157         
                      (    forth6809.asm):09158                  LDD   CODEHERE
                      (    forth6809.asm):09159                  STD   TSTWCFA
                      (    forth6809.asm):09160         
                      (    forth6809.asm):09161                  JSR   DEFERW
                      (    forth6809.asm):09162         
                      (    forth6809.asm):09163                  LDD   TSTCSAV
                      (    forth6809.asm):09164                  STD   CODEHERE
                      (    forth6809.asm):09165         
                      (    forth6809.asm):09166                  LDA   #'T'
                      (    forth6809.asm):09167                  STA   TSTNAMEB
                      (    forth6809.asm):09168                  LDA   #'E'
                      (    forth6809.asm):09169                  STA   TSTNAMEB+1
                      (    forth6809.asm):09170                  LDA   #'S'
                      (    forth6809.asm):09171                  STA   TSTNAMEB+2
                      (    forth6809.asm):09172                  LDA   #'T'
                      (    forth6809.asm):09173                  STA   TSTNAMEB+3
                      (    forth6809.asm):09174                  LDA   #'W'
                      (    forth6809.asm):09175                  STA   TSTNAMEB+4
                      (    forth6809.asm):09176                  LDA   #'D'
                      (    forth6809.asm):09177                  STA   TSTNAMEB+5
                      (    forth6809.asm):09178                  LDD   #TSTNAMEB
                      (    forth6809.asm):09179                  STD   SRCADDR
                      (    forth6809.asm):09180                  LDD   #6
                      (    forth6809.asm):09181                  STD   SRCLEN
                      (    forth6809.asm):09182                  LDD   #0
                      (    forth6809.asm):09183                  STD   TOIN
                      (    forth6809.asm):09184                  LDD   #0
                      (    forth6809.asm):09185                  STD   STATE
                      (    forth6809.asm):09186         
                      (    forth6809.asm):09187                  LDD   #TSTCBUF2  ; BUG FIX: this redirect was missing entirely
                      (    forth6809.asm):09188                                   ; - WORD writes its parsed-token output
                      (    forth6809.asm):09189                                   ; directly at CODEHERE regardless of STATE
                      (    forth6809.asm):09190                                   ; (see TSTCBUF2's own comment), so without
                      (    forth6809.asm):09191                                   ; this, ISW's own internal name-parse would
                      (    forth6809.asm):09192                                   ; write into the real, unredirected CODEHERE -
                      (    forth6809.asm):09193                                   ; unsafe during boot-time testing, before
                      (    forth6809.asm):09194                                   ; COLD has set it to anything meaningful. Not
                      (    forth6809.asm):09195                                   ; TSTCBUF specifically here (unlike TSTVALTO's
                      (    forth6809.asm):09196                                   ; TO-phase fix), since nothing in this phase
                      (    forth6809.asm):09197                                   ; needs TSTCBUF's own contents preserved yet -
                      (    forth6809.asm):09198                                   ; but using the same dedicated buffer
                      (    forth6809.asm):09199                                   ; throughout keeps every phase's redirect
                      (    forth6809.asm):09200                                   ; consistent and safe regardless of order.
                      (    forth6809.asm):09201                  STD   CODEHERE
                      (    forth6809.asm):09202         
                      (    forth6809.asm):09203                  LDD   #DUP
                      (    forth6809.asm):09204                  PSHU  D
                      (    forth6809.asm):09205                  JSR   ISW
                      (    forth6809.asm):09206         
                      (    forth6809.asm):09207                  STU   TSTU0
                      (    forth6809.asm):09208         
                      (    forth6809.asm):09209                  LDD   #TSTGUARD
                      (    forth6809.asm):09210                  PSHU  D
                      (    forth6809.asm):09211                  LDD   #TSTVAL1
                      (    forth6809.asm):09212                  PSHU  D
                      (    forth6809.asm):09213                  STU   TSTUB4
                      (    forth6809.asm):09214         
                      (    forth6809.asm):09215                  LDX   TSTWCFA
                      (    forth6809.asm):09216                  JSR   ,X
                      (    forth6809.asm):09217         
                      (    forth6809.asm):09218                  STU   TSTUAF
                      (    forth6809.asm):09219         
                      (    forth6809.asm):09220                  PULU  D
                      (    forth6809.asm):09221                  CMPD  #TSTVAL1
                      (    forth6809.asm):09222                  LBNE   ISFAIL  ; was BNE - out of short-branch range, since

                      (    forth6809.asm):02186                    BNE   MXFAIL
                      (    forth6809.asm):02187         
                      (    forth6809.asm):02188                    LDD   TSTUB4
                      (    forth6809.asm):02189                    SUBD  TSTUAF
                      (    forth6809.asm):02190                    CMPD  #0
                      (    forth6809.asm):02191                    BNE   MXFAIL
                      (    forth6809.asm):02192         

                      (    forth6809.asm):02181         ; TSTPICK - unit test for PICK ( xu ... x0 u -- xu ... x0 xu ),
                      (    forth6809.asm):02182         ; using u=2 as a concrete representative case (0 PICK is DUP,
                      (    forth6809.asm):02183         ; 1 PICK is OVER; 2 PICK is the first case distinct from both).
                      (    forth6809.asm):02184         ; Verifies the correct item (the one 2 cells deep after u itself
                      (    forth6809.asm):02185         ; is popped) is copied to the top, everything beneath is
                      (    forth6809.asm):02186         ; undisturbed, and the net stack depth is unchanged (u popped,
                      (    forth6809.asm):02187         ; one copy pushed).

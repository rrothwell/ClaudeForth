                      (    forth6809.asm):12987                     CMPD #TSTGUARD
                      (    forth6809.asm):12988                     BNE  CQFAIL
                      (    forth6809.asm):12989         
                      (    forth6809.asm):12990                     LDD  TSTUB4
                      (    forth6809.asm):12991                     SUBD TSTUAF
                      (    forth6809.asm):12992                     CMPD #0
                      (    forth6809.asm):12993                     BNE  CQFAIL

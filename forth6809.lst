F863 3706             (    forth6809.asm):20193         UNESCAPEW: PULU D        ; BUG FIX: was PULU D/STD UESRCLEN (storing
F865 DDAB             (    forth6809.asm):20194                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):20195                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):20196                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):20197                                   ; real source length was misread as an
                      (    forth6809.asm):20198                                   ; address, the real source address was never
                      (    forth6809.asm):20199                                   ; popped at all, and the true destination
                      (    forth6809.asm):20200                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):20201                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):20202                                   ; c-addr2 (dest) is on top, popped first.
F867 3706             (    forth6809.asm):20203                    PULU D         ; next: u1 (source length)
F869 DDA9             (    forth6809.asm):20204                    STD  UESRCLEN
F86B 3706             (    forth6809.asm):20205                    PULU D         ; next: c-addr1 (source address)
F86D DDA7             (    forth6809.asm):20206                    STD  UEADDR
F86F CC0000           (    forth6809.asm):20207                    LDD  #0
F872 DDAD             (    forth6809.asm):20208                    STD  UEOUTLEN
F874 9EA7             (    forth6809.asm):20209                    LDX  UEADDR
F876 109EAB           (    forth6809.asm):20210                    LDY  UEDST
                      (    forth6809.asm):20211         
                      (    forth6809.asm):20212                    ; ALGORITHM REPLACED (caught by MAME testing after the
                      (    forth6809.asm):20213                    ; argument-order fix above): the entire body below used
                      (    forth6809.asm):20214                    ; to decode backslash escape sequences (\n, \t, \\, \") -
                      (    forth6809.asm):20215                    ; a plausible-looking but entirely wrong reading of what
                      (    forth6809.asm):20216                    ; ANS UNESCAPE does. Confirmed against the actual spec and
                      (    forth6809.asm):20217                    ; its canonical reference implementation (forth-standard.
                      (    forth6809.asm):20218                    ; org/standard/string/UNESCAPE and complang.tuwien.ac.at's
                      (    forth6809.asm):20219                    ; ANS Forth reference text): UNESCAPE has nothing to do
                      (    forth6809.asm):20220                    ; with backslash sequences at all - it replaces every '%'
                      (    forth6809.asm):20221                    ; character with two '%' characters, and nothing else, so
                      (    forth6809.asm):20222                    ; that a literal '%' in text survives an eventual
                      (    forth6809.asm):20223                    ; SUBSTITUTE pass unchanged ("If you pass a string through
                      (    forth6809.asm):20224                    ; UNESCAPE and then SUBSTITUTE, you get the original
                      (    forth6809.asm):20225                    ; string"). Every character that ISN'T '%' passes straight
                      (    forth6809.asm):20226                    ; through, one-for-one. Confirmed via MAME: doubling a
                      (    forth6809.asm):20227                    ; single '%' wasn't happening at all, and the returned
                      (    forth6809.asm):20228                    ; count didn't grow to reflect the added characters -
                      (    forth6809.asm):20229                    ; both are direct, expected consequences of this being the
                      (    forth6809.asm):20230                    ; wrong algorithm entirely, not a smaller bug within it.
F879 DCA9             (    forth6809.asm):20231         UELOOP:    LDD  UESRCLEN
F87B 2715             (    forth6809.asm):20232                    BEQ  UEDONE
F87D A680             (    forth6809.asm):20233                    LDA  ,X+
F87F 8125             (    forth6809.asm):20234                    CMPA #'%'
F881 2604             (    forth6809.asm):20235                    BNE  UENOTPCT
F883 C625             (    forth6809.asm):20236                    LDB  #'%'      ; write the extra '%' first - the character
F885 E7A0             (    forth6809.asm):20237                    STB  ,Y+       ; itself still gets written once more below,
                      (    forth6809.asm):20238                                   ; giving two '%' total for each one in the
                      (    forth6809.asm):20239                                   ; source. Handles multiple '%' characters in
                      (    forth6809.asm):20240                                   ; the same string correctly, since this runs
                      (    forth6809.asm):20241                                   ; independently for each one the loop visits.
F887 A7A0             (    forth6809.asm):20242         UENOTPCT:  STA  ,Y+       ; write the actual character - always, for
                      (    forth6809.asm):20243                                   ; every character, '%' or not
F889 DCA9             (    forth6809.asm):20244                    LDD  UESRCLEN
F88B 830001           (    forth6809.asm):20245                    SUBD #1
F88E DDA9             (    forth6809.asm):20246                    STD  UESRCLEN
F890 20E7             (    forth6809.asm):20247                    BRA  UELOOP

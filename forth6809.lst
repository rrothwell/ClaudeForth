                      (    forth6809.asm):13690         ; TSTNUMOUT - numeric output tests (glossary section 3.13, 14
                      (    forth6809.asm):13691         ; words, 13 tests since #S and #> are combined into one test,
                      (    forth6809.asm):13692         ; matching how they're naturally used together as the tail of
                      (    forth6809.asm):13693         ; the standard pictured-output idiom "<# ... #S #>").
                      (    forth6809.asm):13694         ;
                      (    forth6809.asm):13695         ; The pictured-numeric-output core (<# # #S #> HOLD HOLDS) is
                      (    forth6809.asm):13696         ; pure string-building with no I/O, tested directly. SIGN
                      (    forth6809.asm):13697         ; carries real bug-fix history - a prior bare BPL right after
                      (    forth6809.asm):13698         ; PULU didn't affect condition codes on real 6809 hardware, and
                      (    forth6809.asm):13699         ; the bug was masked for every internal caller by caller-side
                      (    forth6809.asm):13700         ; luck (each ran a flag-setting LDD right before calling SIGN).
                      (    forth6809.asm):13701         ; This section's own SIGN test deliberately poisons the flags
                      (    forth6809.asm):13702         ; with an unrelated CMPX immediately before each direct call,
                      (    forth6809.asm):13703         ; so it exercises the exact previously-broken scenario rather
                      (    forth6809.asm):13704         ; than repeating the same kind of luck that hid the bug.
                      (    forth6809.asm):13705         ;
                      (    forth6809.asm):13706         ; The high-level printing words (./U./.R/U.R/?/D./D.R) all
                      (    forth6809.asm):13707         ; produce real output via TYPE/EMIT internally, so each applies
                      (    forth6809.asm):13708         ; the SERIALPOLL-conditional split established in section 3.1 -
                      (    forth6809.asm):13709         ; full OUTHEAD/OUTBUF verification under SERIALPOLL=0, an
                      (    forth6809.asm):13710         ; EMITCH-based last-character check under SERIALPOLL=1. .R/U.R/
                      (    forth6809.asm):13711         ; D.R specifically test the padding path (a width wider than the
                      (    forth6809.asm):13712         ; actual digits), not just a no-padding sanity case. D./D.R use
                      (    forth6809.asm):13713         ; a genuine double-cell value (-100000, computed and verified
                      (    forth6809.asm):13714         ; independently in Python before writing the tests) to exercise
                      (    forth6809.asm):13715         ; the 32-bit negation path, not a value that happens to fit in
                      (    forth6809.asm):13716         ; one cell.
                      (    forth6809.asm):13717         ;
                      (    forth6809.asm):13718         ; Note: this section's own COMPARE-adjacent naming risk doesn't
                      (    forth6809.asm):13719         ; apply here, but every group wrapper name (TSTNUMOUT) and every
                      (    forth6809.asm):13720         ; internal FAIL/DONE prefix was still checked against the whole
                      (    forth6809.asm):13721         ; file before insertion, per the standard practice that caught
                      (    forth6809.asm):13722         ; the TSTCOMPARE collision in the prior section.
                      (    forth6809.asm):13723         ; ------------------------------------------------------------
C2A8 BDFC2B           (    forth6809.asm):13724         TSTNUMOUT: JSR CRW
C2AB 8EC2E3           (    forth6809.asm):13725                    LDX   #TSTNUMOUTMSG
C2AE 3610             (    forth6809.asm):13726                    PSHU  X
C2B0 CC0006           (    forth6809.asm):13727                    LDD   #6
C2B3 3606             (    forth6809.asm):13728                    PSHU  D
C2B5 BDF60B           (    forth6809.asm):13729                    JSR   TYPE
C2B8 BDFC2B           (    forth6809.asm):13730                    JSR   CRW
                      (    forth6809.asm):13731         
                      (    forth6809.asm):13732                    IFEQ TSTSELECTOR-12  ; >>>>
                      (    forth6809.asm):13733         

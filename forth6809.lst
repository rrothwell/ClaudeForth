                      (    forth6809.asm):00856         ; TSTDROP - unit test for DROP ( x -- ). Verifies both the
                      (    forth6809.asm):00857         ; stack's contents (the guard beneath the dropped value is left
                      (    forth6809.asm):00858         ; undisturbed, and is now the new top) and the data stack
                      (    forth6809.asm):00859         ; pointer's movement (exactly one cell, 2 bytes, freed - DROP's
                      (    forth6809.asm):00860         ; own net effect, not conflated with the two pushes that set the
                      (    forth6809.asm):00861         ; test up).
                      (    forth6809.asm):00862         ; ------------------------------------------------------------
C161                  (    forth6809.asm):00863         TSTDROP:   STU   TSTU0
                      (    forth6809.asm):00864         
                      (    forth6809.asm):00865                    LDD   #TSTGUARD
                      (    forth6809.asm):00866                    PSHU  D
                      (    forth6809.asm):00867                    LDD   #TSTVAL1
                      (    forth6809.asm):00868                    PSHU  D
                      (    forth6809.asm):00869                    STU   TSTUB4
                      (    forth6809.asm):00870         
                      (    forth6809.asm):00871                    JSR   DROP
                      (    forth6809.asm):00872         
                      (    forth6809.asm):00873                    STU   TSTUAF
                      (    forth6809.asm):00874         
                      (    forth6809.asm):00875                    PULU  D
                      (    forth6809.asm):00876                    CMPD  #TSTGUARD
                      (    forth6809.asm):00877                    BNE   DPFAIL
                      (    forth6809.asm):00878         

                      (    forth6809.asm):07823         ; ------------------------------------------------------------
                      (    forth6809.asm):07824         ; Defining-words test harness (glossary section 3.9). Every
                      (    forth6809.asm):07825         ; defining word parses a name from the input source via WORD -
                      (    forth6809.asm):07826         ; unlike anything in section 3.8's control-flow tests - so each
                      (    forth6809.asm):07827         ; test redirects CODEHERE, DPHERE, VARHERE, and SRCADDR/SRCLEN/
                      (    forth6809.asm):07828         ; TOIN together (a fake name text, "TESTWD", reused safely
                      (    forth6809.asm):07829         ; across every test here since each redirect/restore cycle is
                      (    forth6809.asm):07830         ; fully isolated), calls the real defining word directly, saves
                      (    forth6809.asm):07831         ; the newly-defined word's own CFA (= CODEHERE at the moment the
                      (    forth6809.asm):07832         ; defining word was called), restores everything, then executes
                      (    forth6809.asm):07833         ; that CFA directly to verify runtime behavior. Traced by hand:
                      (    forth6809.asm):07834         ; CREATE/VARIABLE/CONSTANT/etc all use HEADER (shared header-
                      (    forth6809.asm):07835         ; building) then compile a fixed 5-byte trampoline (3-byte
                      (    forth6809.asm):07836         ; "JSR DODOES" + a 2-byte "behavior field") before their own
                      (    forth6809.asm):07837         ; PFA - confirmed the behavior field holds a genuine compiled
                      (    forth6809.asm):07838         ; JSR instruction only for CREATE's own bare placeholder
                      (    forth6809.asm):07839         ; (DOESRT0, later patched by DOES>); every other defining word
                      (    forth6809.asm):07840         ; (VARIABLE, CONSTANT, DEFER, MARKER, VALUE) instead compiles a
                      (    forth6809.asm):07841         ; raw 2-byte address there directly (via CODECOMMA, not CCALL) -
                      (    forth6809.asm):07842         ; DODOES reads this field as data either way, which only works
                      (    forth6809.asm):07843         ; correctly for the raw-address form. This is why bare CREATE,
                      (    forth6809.asm):07844         ; executed before any DOES>, isn't tested here - its own
                      (    forth6809.asm):07845         ; placeholder behavior field isn't meant to be read as data,
                      (    forth6809.asm):07846         ; only ever overwritten by DOES> before first use.
                      (    forth6809.asm):07847         ; ------------------------------------------------------------
                      (    forth6809.asm):07848         
                      (    forth6809.asm):07849         ; ------------------------------------------------------------
                      (    forth6809.asm):07850         ; TSTVAR - unit test for VARIABLE. Compiles "VARIABLE TESTWD"
                      (    forth6809.asm):07851         ; into scratch, then executes the result. Verifies it pushes
                      (    forth6809.asm):07852         ; its own PFA address (TSTVBUF, since VARHERE was redirected
                      (    forth6809.asm):07853         ; there) and that the cell there was correctly initialized to
                      (    forth6809.asm):07854         ; zero - VARIABLE's own documented behavior, not assumed.
                      (    forth6809.asm):07855         ; ------------------------------------------------------------
C258                  (    forth6809.asm):07856         TSTVAR:  LDD   CODEHERE
                      (    forth6809.asm):07857                  STD   TSTCSAV
                      (    forth6809.asm):07858                  LDD   DPHERE
                      (    forth6809.asm):07859                  STD   TSTDSAV
                      (    forth6809.asm):07860                  LDD   VARHERE
                      (    forth6809.asm):07861                  STD   TSTVSAV
                      (    forth6809.asm):07862                  LDD   SRCADDR
                      (    forth6809.asm):07863                  STD   TSTSASAV
                      (    forth6809.asm):07864                  LDD   SRCLEN
                      (    forth6809.asm):07865                  STD   TSTSLSAV
                      (    forth6809.asm):07866                  LDD   TOIN
                      (    forth6809.asm):07867                  STD   TSTTISAV
                      (    forth6809.asm):07868                  LDD   LATEST
                      (    forth6809.asm):07869                  STD   TSTLSAV
                      (    forth6809.asm):07870         

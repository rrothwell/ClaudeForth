                      (    forth6809.asm):04334         ; ------------------------------------------------------------
DD4E                  (    forth6809.asm):04335         KEYQW:
                      (    forth6809.asm):04336                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04337         
DD4E B60176           (    forth6809.asm):04338                     LDA   INHEAD            ; Characters received?
DD51 B10177           (    forth6809.asm):04339                     CMPA  INTAIL
                      (    forth6809.asm):04340         
                      (    forth6809.asm):04341                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04342         
DD54 2606             (    forth6809.asm):04343                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04344         
DD56 CC0000           (    forth6809.asm):04345                     LDD   #FALSEV           ; No! Return false result.
DD59 3606             (    forth6809.asm):04346                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04347         
DD5B 39               (    forth6809.asm):04348                     RTS
                      (    forth6809.asm):04349         
DD5C                  (    forth6809.asm):04350         KQTRUE:
DD5C CCFFFF           (    forth6809.asm):04351                     LDD   #TRUEV            ; Yes! Return true result.
DD5F 3606             (    forth6809.asm):04352                     PSHU  D                 ; flag = true
DD61 39               (    forth6809.asm):04353                     RTS
                      (    forth6809.asm):04354         
                      (    forth6809.asm):04355         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04356         
                      (    forth6809.asm):04357         ; ------------------------------------------------------------
                      (    forth6809.asm):04358         ; EMIT  ( char -- )
                      (    forth6809.asm):04359         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04360         ; discarded if the ring is full.
                      (    forth6809.asm):04361         ; ------------------------------------------------------------
DD62                  (    forth6809.asm):04362         EMITW:
DD62 3706             (    forth6809.asm):04363                     PULU  D                 ; char
DD64 1F98             (    forth6809.asm):04364                     TFR   B,A

                      (    forth6809.asm):07261         ; TSTEXIT - unit test for EXIT. Compiles
                      (    forth6809.asm):07262         ; "DO I DUP 3 LITERAL = IF EXIT THEN I + LOOP", limit=10,
                      (    forth6809.asm):07263         ; start=0 - EXIT fires when I=3, discarding the one open DO
                      (    forth6809.asm):07264         ; frame and returning immediately. Sets the real CSP to U's
                      (    forth6809.asm):07265         ; value right before the first control-flow marker is pushed
                      (    forth6809.asm):07266         ; (matching what ":" does at the start of a real definition),
                      (    forth6809.asm):07267         ; since EXIT's own compile-time frame count depends on it -
                      (    forth6809.asm):07268         ; confirmed by hand-trace: at the point EXIT is compiled, U
                      (    forth6809.asm):07269         ; holds IF's own pending (addr,TAGFWD) on top of DO's
                      (    forth6809.asm):07270         ; (addr,TAGDO), and EXIT's scan correctly counts exactly one
                      (    forth6809.asm):07271         ; TAGDO between U and CSP. Unlike TSTLEAVE, EXIT fires
                      (    forth6809.asm):07272         ; immediately when reached - the following + never runs for
                      (    forth6809.asm):07273         ; I=3, so sum=0+1+2=3, not 6.
                      (    forth6809.asm):07274         ; ------------------------------------------------------------

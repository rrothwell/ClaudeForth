                      (    forth6809.asm):05609         ; Push the address of the >IN variable (TOIN).
                      (    forth6809.asm):05610         ; ------------------------------------------------------------
DFF5 CC0010           (    forth6809.asm):05611         TOINW:      LDD   #TOIN
DFF8 3606             (    forth6809.asm):05612                     PSHU  D
DFFA 39               (    forth6809.asm):05613                     RTS
                      (    forth6809.asm):05614         
                      (    forth6809.asm):05615         ; ------------------------------------------------------------
                      (    forth6809.asm):05616         ; SPAN  ( -- a-addr )
                      (    forth6809.asm):05617         ; Push the address of the SPAN variable.
                      (    forth6809.asm):05618         ; ------------------------------------------------------------
DFFB CC003F           (    forth6809.asm):05619         SPANW:      LDD   #SPAN
DFFE 3606             (    forth6809.asm):05620                     PSHU  D
E000 39               (    forth6809.asm):05621                     RTS
                      (    forth6809.asm):05622         
                      (    forth6809.asm):05623         ; ------------------------------------------------------------
                      (    forth6809.asm):05624         ; TIB  ( -- c-addr )
                      (    forth6809.asm):05625         ; Push the address of the terminal input buffer.
                      (    forth6809.asm):05626         ; ------------------------------------------------------------
E001 CC0106           (    forth6809.asm):05627         TIBW:       LDD   #TIBBUF
E004 3606             (    forth6809.asm):05628                     PSHU  D
E006 39               (    forth6809.asm):05629                     RTS
                      (    forth6809.asm):05630         
                      (    forth6809.asm):05631         ; ------------------------------------------------------------
                      (    forth6809.asm):05632         ; #TIB  ( -- a-addr )
                      (    forth6809.asm):05633         ; Push the address of the NTIB variable.
                      (    forth6809.asm):05634         ; ------------------------------------------------------------
E007 CC0012           (    forth6809.asm):05635         NUMTIBW:    LDD   #NTIB
E00A 3606             (    forth6809.asm):05636                     PSHU  D
E00C 39               (    forth6809.asm):05637                     RTS
                      (    forth6809.asm):05638         
                      (    forth6809.asm):05639         ; ============================================================
                      (    forth6809.asm):05640         ; SECTION 14: STACK MANIPULATION (Core + Core Ext + return stack)
                      (    forth6809.asm):05641         ; ============================================================
                      (    forth6809.asm):05642         ; ------------------------------------------------------------
                      (    forth6809.asm):05643         ; DUP  ( x -- x x )
                      (    forth6809.asm):05644         ; Duplicate the top cell.
                      (    forth6809.asm):05645         ; ------------------------------------------------------------
E00D ECC4             (    forth6809.asm):05646         DUPW:       LDD   ,U                ; x
E00F 3606             (    forth6809.asm):05647                     PSHU  D
E011 39               (    forth6809.asm):05648                     RTS
                      (    forth6809.asm):05649         
                      (    forth6809.asm):05650         ; ------------------------------------------------------------
                      (    forth6809.asm):05651         ; DROP  ( x -- )
                      (    forth6809.asm):05652         ; Discard the top cell.
                      (    forth6809.asm):05653         ; ------------------------------------------------------------
E012 3342             (    forth6809.asm):05654         DROPW:      LEAU  2,U               ; x
E014 39               (    forth6809.asm):05655                     RTS
                      (    forth6809.asm):05656         
                      (    forth6809.asm):05657         ; ------------------------------------------------------------
                      (    forth6809.asm):05658         ; SWAP  ( x1 x2 -- x2 x1 )
                      (    forth6809.asm):05659         ; Exchange the top two cells.
                      (    forth6809.asm):05660         ; ------------------------------------------------------------
E015 ECC4             (    forth6809.asm):05661         SWAPW:      LDD   ,U                ; x2
E017 AE42             (    forth6809.asm):05662                     LDX   2,U               ; x1
E019 AFC4             (    forth6809.asm):05663                     STX   ,U
E01B ED42             (    forth6809.asm):05664                     STD   2,U
E01D 39               (    forth6809.asm):05665                     RTS
                      (    forth6809.asm):05666         
                      (    forth6809.asm):05667         ; ------------------------------------------------------------
                      (    forth6809.asm):05668         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05669         ; Copy the second cell to the top.
                      (    forth6809.asm):05670         ; ------------------------------------------------------------
E01E EC42             (    forth6809.asm):05671         OVERW:      LDD   2,U               ; x1
E020 3606             (    forth6809.asm):05672                     PSHU  D
E022 39               (    forth6809.asm):05673                     RTS
                      (    forth6809.asm):05674         
                      (    forth6809.asm):05675         ; ------------------------------------------------------------
                      (    forth6809.asm):05676         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05677         ; Rotate the third cell to the top.
                      (    forth6809.asm):05678         ; ------------------------------------------------------------
E023 ECC4             (    forth6809.asm):05679         ROTW:       LDD   ,U                ; x3
E025 AE42             (    forth6809.asm):05680                     LDX   2,U               ; x2
E027 10AE44           (    forth6809.asm):05681                     LDY   4,U               ; x1
E02A 10AFC4           (    forth6809.asm):05682                     STY   ,U
E02D ED42             (    forth6809.asm):05683                     STD   2,U
E02F AF44             (    forth6809.asm):05684                     STX   4,U
E031 39               (    forth6809.asm):05685                     RTS
                      (    forth6809.asm):05686         
                      (    forth6809.asm):05687         ; ------------------------------------------------------------
                      (    forth6809.asm):05688         ; ?DUP  ( x -- 0 | x x )
                      (    forth6809.asm):05689         ; Duplicate the top cell if it is non-zero.
                      (    forth6809.asm):05690         ; ------------------------------------------------------------
E032 ECC4             (    forth6809.asm):05691         QDUPW:      LDD   ,U                ; x
E034 10830000         (    forth6809.asm):05692                     CMPD  #0
E038 2702             (    forth6809.asm):05693                     BEQ   QDUPDONE
E03A 3606             (    forth6809.asm):05694                     PSHU  D
E03C 39               (    forth6809.asm):05695         QDUPDONE:   RTS
                      (    forth6809.asm):05696         
                      (    forth6809.asm):05697         ; ------------------------------------------------------------
                      (    forth6809.asm):05698         ; DEPTH  ( -- +n )
                      (    forth6809.asm):05699         ; Push the number of cells on the data stack: (SP0 - U) / 2.
                      (    forth6809.asm):05700         ; ------------------------------------------------------------
E03D CCBD00           (    forth6809.asm):05701         DEPTHW:     LDD   #SP0
E040 3440             (    forth6809.asm):05702                     PSHS  U
E042 A3E1             (    forth6809.asm):05703                     SUBD  ,S++
E044 44               (    forth6809.asm):05704                     LSRA
E045 56               (    forth6809.asm):05705                     RORB
E046 3606             (    forth6809.asm):05706                     PSHU  D                 ; +n
E048 39               (    forth6809.asm):05707                     RTS
                      (    forth6809.asm):05708         
                      (    forth6809.asm):05709         ; ------------------------------------------------------------
                      (    forth6809.asm):05710         ; 2DUP  ( x1 x2 -- x1 x2 x1 x2 )
                      (    forth6809.asm):05711         ; Duplicate the top cell pair.
                      (    forth6809.asm):05712         ; ------------------------------------------------------------
E049 EC42             (    forth6809.asm):05713         DDUPW:      LDD   2,U               ; x1
E04B AEC4             (    forth6809.asm):05714                     LDX   ,U                ; x2
E04D 3606             (    forth6809.asm):05715                     PSHU  D
E04F 3610             (    forth6809.asm):05716                     PSHU  X
E051 39               (    forth6809.asm):05717                     RTS
                      (    forth6809.asm):05718         
                      (    forth6809.asm):05719         ; ------------------------------------------------------------
                      (    forth6809.asm):05720         ; 2DROP  ( x1 x2 -- )
                      (    forth6809.asm):05721         ; Discard the top cell pair.
                      (    forth6809.asm):05722         ; ------------------------------------------------------------
E052 3344             (    forth6809.asm):05723         DDROPW:     LEAU  4,U
E054 39               (    forth6809.asm):05724                     RTS
                      (    forth6809.asm):05725         
                      (    forth6809.asm):05726         ; ------------------------------------------------------------
                      (    forth6809.asm):05727         ; 2SWAP  ( x1 x2 x3 x4 -- x3 x4 x1 x2 )
                      (    forth6809.asm):05728         ; Exchange the top two cell pairs.
                      (    forth6809.asm):05729         ; ------------------------------------------------------------
E055 ECC4             (    forth6809.asm):05730         DSWAPW:     LDD   ,U                ; x4
E057 DD14             (    forth6809.asm):05731                     STD   MSCR
E059 EC42             (    forth6809.asm):05732                     LDD   2,U               ; x3
E05B AE44             (    forth6809.asm):05733                     LDX   4,U               ; x2
E05D 10AE46           (    forth6809.asm):05734                     LDY   6,U               ; x1
E060 ED46             (    forth6809.asm):05735                     STD   6,U
E062 AFC4             (    forth6809.asm):05736                     STX   ,U
E064 10AF42           (    forth6809.asm):05737                     STY   2,U
E067 DC14             (    forth6809.asm):05738                     LDD   MSCR
E069 ED44             (    forth6809.asm):05739                     STD   4,U
E06B 39               (    forth6809.asm):05740                     RTS
                      (    forth6809.asm):05741         
                      (    forth6809.asm):05742         ; ------------------------------------------------------------
                      (    forth6809.asm):05743         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05744         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05745         ; ------------------------------------------------------------
E06C EC46             (    forth6809.asm):05746         DOVERW:     LDD   6,U               ; x1
E06E AE44             (    forth6809.asm):05747                     LDX   4,U               ; x2
E070 3606             (    forth6809.asm):05748                     PSHU  D
E072 3610             (    forth6809.asm):05749                     PSHU  X
E074 39               (    forth6809.asm):05750                     RTS
                      (    forth6809.asm):05751         
                      (    forth6809.asm):05752         ; ------------------------------------------------------------
                      (    forth6809.asm):05753         ; NIP  ( x1 x2 -- x2 )
                      (    forth6809.asm):05754         ; Discard the second cell.
                      (    forth6809.asm):05755         ; ------------------------------------------------------------
E075 ECC4             (    forth6809.asm):05756         NIPW:       LDD   ,U                ; x2
E077 ED42             (    forth6809.asm):05757                     STD   2,U
E079 3342             (    forth6809.asm):05758                     LEAU  2,U
E07B 39               (    forth6809.asm):05759                     RTS
                      (    forth6809.asm):05760         
                      (    forth6809.asm):05761         ; ------------------------------------------------------------
                      (    forth6809.asm):05762         ; TUCK  ( x1 x2 -- x2 x1 x2 )
                      (    forth6809.asm):05763         ; Copy the top cell beneath the second cell.
                      (    forth6809.asm):05764         ; ------------------------------------------------------------
E07C ECC4             (    forth6809.asm):05765         TUCKW:      LDD   ,U                ; x2
E07E AE42             (    forth6809.asm):05766                     LDX   2,U               ; x1
E080 3606             (    forth6809.asm):05767                     PSHU  D
E082 AF42             (    forth6809.asm):05768                     STX   2,U
E084 ED44             (    forth6809.asm):05769                     STD   4,U
E086 39               (    forth6809.asm):05770                     RTS
                      (    forth6809.asm):05771         
                      (    forth6809.asm):05772         ; ------------------------------------------------------------
                      (    forth6809.asm):05773         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05774         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05775         ; ------------------------------------------------------------
E087 3706             (    forth6809.asm):05776         PICKW:      PULU  D                 ; u
E089 58               (    forth6809.asm):05777                     LSLB
E08A 49               (    forth6809.asm):05778                     ROLA
E08B ECCB             (    forth6809.asm):05779                     LDD   D,U
E08D 3606             (    forth6809.asm):05780                     PSHU  D
E08F 39               (    forth6809.asm):05781                     RTS
                      (    forth6809.asm):05782         
                      (    forth6809.asm):05783         ; ------------------------------------------------------------
                      (    forth6809.asm):05784         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05785         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05786         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05787         ; the cell being moved.
                      (    forth6809.asm):05788         ; ------------------------------------------------------------
E090 ECC1             (    forth6809.asm):05789         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
E092 2718             (    forth6809.asm):05790                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
E094 1F02             (    forth6809.asm):05791                     TFR   D,Y               ; Y = cells to shift
E096 58               (    forth6809.asm):05792                     LSLB
E097 49               (    forth6809.asm):05793                     ROLA
E098 30CB             (    forth6809.asm):05794                     LEAX  D,U               ; X = xu
E09A EC84             (    forth6809.asm):05795                     LDD   ,X
E09C 3406             (    forth6809.asm):05796                     PSHS  D                 ; xu waits on the return stack
E09E EC1E             (    forth6809.asm):05797         RLOOP:      LDD   -2,X
E0A0 ED84             (    forth6809.asm):05798                     STD   ,X
E0A2 301E             (    forth6809.asm):05799                     LEAX  -2,X
E0A4 313F             (    forth6809.asm):05800                     LEAY  -1,Y
E0A6 26F6             (    forth6809.asm):05801                     BNE   RLOOP
E0A8 3506             (    forth6809.asm):05802                     PULS  D
E0AA EDC4             (    forth6809.asm):05803                     STD   ,U
E0AC 39               (    forth6809.asm):05804         ROLLDONE:   RTS
                      (    forth6809.asm):05805         
                      (    forth6809.asm):05806         ; ------------------------------------------------------------
                      (    forth6809.asm):05807         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05808         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05809         ; while the others move.
                      (    forth6809.asm):05810         ; ------------------------------------------------------------
E0AD AE4A             (    forth6809.asm):05811         DROTW:      LDX   10,U              ; x1
E0AF 10AE48           (    forth6809.asm):05812                     LDY   8,U               ; x2
E0B2 EC46             (    forth6809.asm):05813                     LDD   6,U
E0B4 ED4A             (    forth6809.asm):05814                     STD   10,U
E0B6 EC44             (    forth6809.asm):05815                     LDD   4,U
E0B8 ED48             (    forth6809.asm):05816                     STD   8,U
E0BA EC42             (    forth6809.asm):05817                     LDD   2,U
E0BC ED46             (    forth6809.asm):05818                     STD   6,U
E0BE EC40             (    forth6809.asm):05819                     LDD   0,U
E0C0 ED44             (    forth6809.asm):05820                     STD   4,U
E0C2 10AFC4           (    forth6809.asm):05821                     STY   ,U
E0C5 AF42             (    forth6809.asm):05822                     STX   2,U
E0C7 39               (    forth6809.asm):05823                     RTS
                      (    forth6809.asm):05824         
                      (    forth6809.asm):05825         ; ------------------------------------------------------------
                      (    forth6809.asm):05826         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05827         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05828         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05829         ; the transfer.
                      (    forth6809.asm):05830         ; ------------------------------------------------------------
E0C8 3706             (    forth6809.asm):05831         TORW:       PULU  D                 ; x
E0CA 3510             (    forth6809.asm):05832                     PULS  X
E0CC 3406             (    forth6809.asm):05833                     PSHS  D
E0CE 3410             (    forth6809.asm):05834                     PSHS  X
E0D0 39               (    forth6809.asm):05835                     RTS
                      (    forth6809.asm):05836         
                      (    forth6809.asm):05837         ; ------------------------------------------------------------
                      (    forth6809.asm):05838         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05839         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05840         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05841         ; the transfer.
                      (    forth6809.asm):05842         ; ------------------------------------------------------------
E0D1 3510             (    forth6809.asm):05843         FROMRW:     PULS  X
E0D3 3506             (    forth6809.asm):05844                     PULS  D                 ; x
E0D5 3410             (    forth6809.asm):05845                     PSHS  X
E0D7 3606             (    forth6809.asm):05846                     PSHU  D
E0D9 39               (    forth6809.asm):05847                     RTS
                      (    forth6809.asm):05848         
                      (    forth6809.asm):05849         ; ------------------------------------------------------------
                      (    forth6809.asm):05850         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05851         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05852         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05853         ; back around the transfer.
                      (    forth6809.asm):05854         ; ------------------------------------------------------------
E0DA 3510             (    forth6809.asm):05855         RFETCHW:    PULS  X
E0DC ECE4             (    forth6809.asm):05856                     LDD   ,S                ; x
E0DE 3410             (    forth6809.asm):05857                     PSHS  X
E0E0 3606             (    forth6809.asm):05858                     PSHU  D
E0E2 39               (    forth6809.asm):05859                     RTS
                      (    forth6809.asm):05860         
                      (    forth6809.asm):05861         ; ------------------------------------------------------------
                      (    forth6809.asm):05862         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05863         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05864         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05865         ; put back around the transfer.
                      (    forth6809.asm):05866         ; ------------------------------------------------------------
E0E3 3510             (    forth6809.asm):05867         TWOTORW:    PULS  X                 ; return address
E0E5 3706             (    forth6809.asm):05868                     PULU  D                 ; x2
E0E7 3720             (    forth6809.asm):05869                     PULU  Y                 ; x1
E0E9 3420             (    forth6809.asm):05870                     PSHS  Y
E0EB 3406             (    forth6809.asm):05871                     PSHS  D
E0ED 3410             (    forth6809.asm):05872                     PSHS  X
E0EF 39               (    forth6809.asm):05873                     RTS
                      (    forth6809.asm):05874         
                      (    forth6809.asm):05875         ; ------------------------------------------------------------
                      (    forth6809.asm):05876         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05877         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05878         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05879         ; put back around the transfer.
                      (    forth6809.asm):05880         ; ------------------------------------------------------------
E0F0 3510             (    forth6809.asm):05881         TWOFROMRW:  PULS  X                 ; return address
E0F2 3506             (    forth6809.asm):05882                     PULS  D                 ; x2
E0F4 3520             (    forth6809.asm):05883                     PULS  Y                 ; x1
E0F6 3410             (    forth6809.asm):05884                     PSHS  X
E0F8 3620             (    forth6809.asm):05885                     PSHU  Y
E0FA 3606             (    forth6809.asm):05886                     PSHU  D
E0FC 39               (    forth6809.asm):05887                     RTS
                      (    forth6809.asm):05888         
                      (    forth6809.asm):05889         ; ------------------------------------------------------------
                      (    forth6809.asm):05890         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05891         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05892         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05893         ; and put back around the transfer.
                      (    forth6809.asm):05894         ; ------------------------------------------------------------
E0FD 3510             (    forth6809.asm):05895         TWORFETCHW: PULS  X                 ; return address
E0FF ECE4             (    forth6809.asm):05896                     LDD   ,S                ; x2
E101 10AE62           (    forth6809.asm):05897                     LDY   2,S               ; x1
E104 3410             (    forth6809.asm):05898                     PSHS  X
E106 3620             (    forth6809.asm):05899                     PSHU  Y
E108 3606             (    forth6809.asm):05900                     PSHU  D
E10A 39               (    forth6809.asm):05901                     RTS
                      (    forth6809.asm):05902         
                      (    forth6809.asm):05903         ; ============================================================
                      (    forth6809.asm):05904         ; SECTION 15: ARITHMETIC (single + double + mixed precision)
                      (    forth6809.asm):05905         ; ============================================================
                      (    forth6809.asm):05906         ; ------------------------------------------------------------
                      (    forth6809.asm):05907         ; +  ( n1 n2 -- n3 )
                      (    forth6809.asm):05908         ; Add n2 to n1.
                      (    forth6809.asm):05909         ; ------------------------------------------------------------
E10B 3706             (    forth6809.asm):05910         PLUSW:      PULU  D                 ; n2
E10D E3C4             (    forth6809.asm):05911                     ADDD  ,U
E10F EDC4             (    forth6809.asm):05912                     STD   ,U
E111 39               (    forth6809.asm):05913                     RTS
                      (    forth6809.asm):05914         
                      (    forth6809.asm):05915         ; ------------------------------------------------------------
                      (    forth6809.asm):05916         ; -  ( n1 n2 -- n3 )
                      (    forth6809.asm):05917         ; Subtract n2 from n1.
                      (    forth6809.asm):05918         ; ------------------------------------------------------------
E112 3706             (    forth6809.asm):05919         MINUSW:     PULU  D                 ; n2
E114 DD14             (    forth6809.asm):05920                     STD   MSCR
E116 ECC4             (    forth6809.asm):05921                     LDD   ,U
E118 9314             (    forth6809.asm):05922                     SUBD  MSCR
E11A EDC4             (    forth6809.asm):05923                     STD   ,U
E11C 39               (    forth6809.asm):05924                     RTS
                      (    forth6809.asm):05925         
                      (    forth6809.asm):05926         ; ------------------------------------------------------------
                      (    forth6809.asm):05927         ; NEGATE  ( n1 -- n2 )
                      (    forth6809.asm):05928         ; Two's complement negate.
                      (    forth6809.asm):05929         ; ------------------------------------------------------------
E11D ECC4             (    forth6809.asm):05930         NEGATEW:    LDD   ,U                ; n1
E11F 43               (    forth6809.asm):05931                     COMA
E120 53               (    forth6809.asm):05932                     COMB
E121 C30001           (    forth6809.asm):05933                     ADDD  #1
E124 EDC4             (    forth6809.asm):05934                     STD   ,U
E126 39               (    forth6809.asm):05935                     RTS
                      (    forth6809.asm):05936         
                      (    forth6809.asm):05937         ; ------------------------------------------------------------
                      (    forth6809.asm):05938         ; ABS  ( n -- u )
                      (    forth6809.asm):05939         ; Absolute value.
                      (    forth6809.asm):05940         ; ------------------------------------------------------------
E127 ECC4             (    forth6809.asm):05941         ABSW:       LDD   ,U                ; n
E129 2A07             (    forth6809.asm):05942                     BPL   ABSDONE
E12B 43               (    forth6809.asm):05943                     COMA
E12C 53               (    forth6809.asm):05944                     COMB
E12D C30001           (    forth6809.asm):05945                     ADDD  #1
E130 EDC4             (    forth6809.asm):05946                     STD   ,U
E132 39               (    forth6809.asm):05947         ABSDONE:    RTS
                      (    forth6809.asm):05948         
                      (    forth6809.asm):05949         ; ------------------------------------------------------------
                      (    forth6809.asm):05950         ; MIN  ( n1 n2 -- n3 )
                      (    forth6809.asm):05951         ; The lesser of two signed numbers.
                      (    forth6809.asm):05952         ; ------------------------------------------------------------
E133 3706             (    forth6809.asm):05953         MINW:       PULU  D                 ; n2
E135 10A3C4           (    forth6809.asm):05954                     CMPD  ,U
E138 2D01             (    forth6809.asm):05955                     BLT   MINISN2
E13A 39               (    forth6809.asm):05956                     RTS
E13B EDC4             (    forth6809.asm):05957         MINISN2:    STD   ,U
E13D 39               (    forth6809.asm):05958                     RTS

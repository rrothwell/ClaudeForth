ED73 39               (    forth6809.asm):08535                     RTS
                      (    forth6809.asm):08536         
                      (    forth6809.asm):08537         ; ------------------------------------------------------------
                      (    forth6809.asm):08538         ; HOLD  ( char -- )
                      (    forth6809.asm):08539         ; Add char to the front of the pictured numeric output string.
                      (    forth6809.asm):08540         ; ------------------------------------------------------------

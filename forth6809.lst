                      (    forth6809.asm):01823                    LDD   TSTUB4
                      (    forth6809.asm):01824                    SUBD  TSTUAF
                      (    forth6809.asm):01825                    CMPD  #2
                      (    forth6809.asm):01826                    BNE   DHFAIL
                      (    forth6809.asm):01827         

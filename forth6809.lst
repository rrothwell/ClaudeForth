                      (    forth6809.asm):13506         ; TSTSNAME1 - unit test for SNAME, found case. Searches the
                      (    forth6809.asm):13507         ; real, live dictionary (confirmed via its own code that it
                      (    forth6809.asm):13508         ; walks from the real LATEST, not a redirectable copy - no
                      (    forth6809.asm):13509         ; redirect needed or possible here) for DUP's own xt, verifying
                      (    forth6809.asm):13510         ; the returned name content matches "DUP" exactly, not just a
                      (    forth6809.asm):13511         ; nonzero length.
                      (    forth6809.asm):13512         ; ------------------------------------------------------------
C2AB                  (    forth6809.asm):13513         TSTSNAME1: STU  TSTU0
                      (    forth6809.asm):13514         

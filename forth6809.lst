                      (    forth6809.asm):04175         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04176         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):04177         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):04178         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04179         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):04180         ;    Inputs:
                      (    forth6809.asm):04181         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):04182         ;    Outputs:
                      (    forth6809.asm):04183         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04184         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):04185         ;        scratch.
                      (    forth6809.asm):04186         ; ------------------------------------------------------------
E904 3706             (    forth6809.asm):04187         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
E906 DD29             (    forth6809.asm):04188                     STD   MSCR              ; MSCR = step
E908 EC66             (    forth6809.asm):04189                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
E90A 262D             (    forth6809.asm):04190                     BNE   DPTEXIT           ; set: exit
E90C EC62             (    forth6809.asm):04191                     LDD   2,S               ; old index
E90E A364             (    forth6809.asm):04192                     SUBD  4,S               ; old_u = old_index - limit, mod 65536

                      (    forth6809.asm):02075         
DD3A 01               (    forth6809.asm):02076         H_1:     FCB   1
DD3B 31               (    forth6809.asm):02077                  FCC   "1"
DD3C DD31             (    forth6809.asm):02078                  FDB   H_FIND
DD3E FEE3             (    forth6809.asm):02079                  FDB   ONEBODY
                      (    forth6809.asm):02080         

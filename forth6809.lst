                      (    forth6809.asm):15278         ; ============================================================
                      (    forth6809.asm):15279         ; ------------------------------------------------------------
                      (    forth6809.asm):15280         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):15281         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):15282         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):15283         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):15284         ; - no indirection, no value cell.
                      (    forth6809.asm):15285         ;
                      (    forth6809.asm):15286         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):15287         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):15288         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):15289         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):15290         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):15291         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):15292         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):15293         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):15294         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):15295         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):15296         ; ------------------------------------------------------------

                      (    forth6809.asm):10271                       STA  TSTNAMEB
                      (    forth6809.asm):10272                       LDA  #'O'
                      (    forth6809.asm):10273                       STA  TSTNAMEB+1
                      (    forth6809.asm):10274                       LDA  #'O'
                      (    forth6809.asm):10275                       STA  TSTNAMEB+2
                      (    forth6809.asm):10276         
                      (    forth6809.asm):10277                       LDD  #TSTCBUF
                      (    forth6809.asm):10278                       STD  CODEHERE
                      (    forth6809.asm):10279                       LDD  #TSTFHDR
                      (    forth6809.asm):10280                       STD  LATEST
                      (    forth6809.asm):10281                       LDD  #TSTNAMEB
                      (    forth6809.asm):10282                       STD  SRCADDR
                      (    forth6809.asm):10283                       LDD  #3
                      (    forth6809.asm):10284                       STD  SRCLEN
                      (    forth6809.asm):10285                       LDD  #0
                      (    forth6809.asm):10286                       STD  TOIN
                      (    forth6809.asm):10287                       LDD  #-1
                      (    forth6809.asm):10288                       STD  STATE

                      (    forth6809.asm):05555         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05556         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05557         ; the string.
                      (    forth6809.asm):05558         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05559         ;    Inputs:
                      (    forth6809.asm):05560         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05561         ;        count byte
                      (    forth6809.asm):05562         ;    Outputs:
                      (    forth6809.asm):05563         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05564         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05565         ; ------------------------------------------------------------
DFB7                  (    forth6809.asm):05566         DOABORTQUOTE:
DFB7 3510             (    forth6809.asm):05567                     PULS  X
DFB9 E684             (    forth6809.asm):05568                     LDB   ,X
DFBB 3001             (    forth6809.asm):05569                     LEAX  1,X               ; X = text, B = length
DFBD 4F               (    forth6809.asm):05570                     CLRA
DFBE 3720             (    forth6809.asm):05571                     PULU  Y                 ; flag
DFC0 108C0000         (    forth6809.asm):05572                     CMPY  #0
DFC4 2605             (    forth6809.asm):05573                     BNE   AQTHROW
DFC6 3085             (    forth6809.asm):05574                     LEAX  B,X
DFC8 3410             (    forth6809.asm):05575                     PSHS  X
DFCA 39               (    forth6809.asm):05576                     RTS
DFCB 3610             (    forth6809.asm):05577         AQTHROW:    PSHU  X
DFCD 3606             (    forth6809.asm):05578                     PSHU  D
DFCF BDEAA4           (    forth6809.asm):05579                     JSR   TYPEW
DFD2 CCFFFE           (    forth6809.asm):05580                     LDD   #-2               ; -2
DFD5 3606             (    forth6809.asm):05581                     PSHU  D
DFD7 7EDAAF           (    forth6809.asm):05582                     JMP   THROWW
                      (    forth6809.asm):05583         
                      (    forth6809.asm):05584         ; ------------------------------------------------------------
                      (    forth6809.asm):05585         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05586         ; Compile DOABORTQUOTE followed by the string up to the closing quote
                      (    forth6809.asm):05587         ; as a counted string. THROW -14 if not compiling.

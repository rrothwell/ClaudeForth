                      (    forth6809.asm):02927         ; ============================================================
                      (    forth6809.asm):02928         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):02929         ; ============================================================
                      (    forth6809.asm):02930         ; ------------------------------------------------------------
                      (    forth6809.asm):02931         ; INTERPRET  ( -- )
                      (    forth6809.asm):02932         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):02933         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):02934         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):02935         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):02936         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):02937         ; ------------------------------------------------------------
E2CF                  (    forth6809.asm):02938         INTERPRET:
E2CF CC0020           (    forth6809.asm):02939         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1

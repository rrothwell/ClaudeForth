C1AE                  (    forth6809.asm):02470         TSTTORNAME: FCB  6
                      (    forth6809.asm):02471                     FCC  "TSTTOR"
                      (    forth6809.asm):02472         
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
                      (    forth6809.asm):02474         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02475         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02476         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02477         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02478         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02479         ; not assumed from the name.
                      (    forth6809.asm):02480         ; ------------------------------------------------------------
C1AE                  (    forth6809.asm):02481         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02482         
                      (    forth6809.asm):02483                    LDD  #TSTGUARD
                      (    forth6809.asm):02484                    PSHU D
                      (    forth6809.asm):02485                    LDD  #TSTVAL1
                      (    forth6809.asm):02486                    PSHU D
                      (    forth6809.asm):02487                    STU  TSTUB4
                      (    forth6809.asm):02488         
                      (    forth6809.asm):02489                    JSR  TOR
                      (    forth6809.asm):02490                    JSR  RFETCH
                      (    forth6809.asm):02491                    JSR  FROMR
                      (    forth6809.asm):02492         
                      (    forth6809.asm):02493                    STU  TSTUAF
                      (    forth6809.asm):02494         
                      (    forth6809.asm):02495                    PULU D
                      (    forth6809.asm):02496                    CMPD #TSTVAL1
                      (    forth6809.asm):02497                    BNE  RFFAIL
                      (    forth6809.asm):02498                    PULU D
                      (    forth6809.asm):02499                    CMPD #TSTVAL1
                      (    forth6809.asm):02500                    BNE  RFFAIL
                      (    forth6809.asm):02501                    PULU D
                      (    forth6809.asm):02502                    CMPD #TSTGUARD
                      (    forth6809.asm):02503                    BNE  RFFAIL
                      (    forth6809.asm):02504         
                      (    forth6809.asm):02505                    LDD  TSTUB4
                      (    forth6809.asm):02506                    SUBD TSTUAF
                      (    forth6809.asm):02507                    CMPD #2
                      (    forth6809.asm):02508                    BNE  RFFAIL
                      (    forth6809.asm):02509         
                      (    forth6809.asm):02510                    LDD  #TRUEV
                      (    forth6809.asm):02511                    BRA  RFDONE
C1AE                  (    forth6809.asm):02512         RFFAIL:    LDD  #FALSEV
C1AE                  (    forth6809.asm):02513         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02514                    PSHU X
                      (    forth6809.asm):02515                    PSHU D
                      (    forth6809.asm):02516                    JSR  TSTREPORT
                      (    forth6809.asm):02517         
                      (    forth6809.asm):02518                    LDU  TSTU0
                      (    forth6809.asm):02519                    RTS
                      (    forth6809.asm):02520         
C1AE                  (    forth6809.asm):02521         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02522                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02523         
                      (    forth6809.asm):02524         ; ------------------------------------------------------------
                      (    forth6809.asm):02525         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02526         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02527         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02528         ; verifying the round trip.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
C1AE                  (    forth6809.asm):02530         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02531         
                      (    forth6809.asm):02532                    LDD  #TSTGUARD
                      (    forth6809.asm):02533                    PSHU D
                      (    forth6809.asm):02534                    LDD  #TSTVAL1
                      (    forth6809.asm):02535                    PSHU D
                      (    forth6809.asm):02536                    LDD  #TSTVAL2
                      (    forth6809.asm):02537                    PSHU D
                      (    forth6809.asm):02538                    STU  TSTUB4
                      (    forth6809.asm):02539         
                      (    forth6809.asm):02540                    JSR  TWOTOR
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542                    STU  TSTUMID
                      (    forth6809.asm):02543         
                      (    forth6809.asm):02544                    LDD  TSTUB4
                      (    forth6809.asm):02545                    SUBD TSTUMID
                      (    forth6809.asm):02546                    CMPD #-4
                      (    forth6809.asm):02547                    BNE  T2RFAIL
                      (    forth6809.asm):02548         
                      (    forth6809.asm):02549                    JSR  TWOFROMR
                      (    forth6809.asm):02550         
                      (    forth6809.asm):02551                    STU  TSTUAF
                      (    forth6809.asm):02552         
                      (    forth6809.asm):02553                    PULU D
                      (    forth6809.asm):02554                    CMPD #TSTVAL2
                      (    forth6809.asm):02555                    BNE  T2RFAIL
                      (    forth6809.asm):02556                    PULU D
                      (    forth6809.asm):02557                    CMPD #TSTVAL1
                      (    forth6809.asm):02558                    BNE  T2RFAIL
                      (    forth6809.asm):02559                    PULU D
                      (    forth6809.asm):02560                    CMPD #TSTGUARD
                      (    forth6809.asm):02561                    BNE  T2RFAIL
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563                    LDD  TSTUB4
                      (    forth6809.asm):02564                    SUBD TSTUAF
                      (    forth6809.asm):02565                    CMPD #0
                      (    forth6809.asm):02566                    BNE  T2RFAIL
                      (    forth6809.asm):02567         
                      (    forth6809.asm):02568                    LDD  #TRUEV
                      (    forth6809.asm):02569                    BRA  T2RDONE
C1AE                  (    forth6809.asm):02570         T2RFAIL:   LDD  #FALSEV
C1AE                  (    forth6809.asm):02571         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02572                    PSHU X
                      (    forth6809.asm):02573                    PSHU D
                      (    forth6809.asm):02574                    JSR  TSTREPORT
                      (    forth6809.asm):02575         
                      (    forth6809.asm):02576                    LDU  TSTU0
                      (    forth6809.asm):02577                    RTS
                      (    forth6809.asm):02578         
C1AE                  (    forth6809.asm):02579         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02580                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02581         
                      (    forth6809.asm):02582         ; ------------------------------------------------------------
                      (    forth6809.asm):02583         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02584         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02585         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02586         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02587         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02588         ; ------------------------------------------------------------
C1AE                  (    forth6809.asm):02589         TSTTWORFETCH: STU  TSTU0
                      (    forth6809.asm):02590         
                      (    forth6809.asm):02591                       LDD  #TSTGUARD
                      (    forth6809.asm):02592                       PSHU D
                      (    forth6809.asm):02593                       LDD  #TSTVAL1
                      (    forth6809.asm):02594                       PSHU D
                      (    forth6809.asm):02595                       LDD  #TSTVAL2
                      (    forth6809.asm):02596                       PSHU D
                      (    forth6809.asm):02597                       STU  TSTUB4
                      (    forth6809.asm):02598         
                      (    forth6809.asm):02599                       JSR  TWOTOR
                      (    forth6809.asm):02600                       JSR  TWORFETCH
                      (    forth6809.asm):02601                       JSR  TWOFROMR
                      (    forth6809.asm):02602         
                      (    forth6809.asm):02603                       STU  TSTUAF
                      (    forth6809.asm):02604         
                      (    forth6809.asm):02605                       PULU D
                      (    forth6809.asm):02606                       CMPD #TSTVAL2
                      (    forth6809.asm):02607                       BNE  T2FFAIL
                      (    forth6809.asm):02608                       PULU D
                      (    forth6809.asm):02609                       CMPD #TSTVAL1
                      (    forth6809.asm):02610                       BNE  T2FFAIL
                      (    forth6809.asm):02611                       PULU D
                      (    forth6809.asm):02612                       CMPD #TSTVAL2
                      (    forth6809.asm):02613                       BNE  T2FFAIL
                      (    forth6809.asm):02614                       PULU D
                      (    forth6809.asm):02615                       CMPD #TSTVAL1
                      (    forth6809.asm):02616                       BNE  T2FFAIL
                      (    forth6809.asm):02617                       PULU D
                      (    forth6809.asm):02618                       CMPD #TSTGUARD
                      (    forth6809.asm):02619                       BNE  T2FFAIL
                      (    forth6809.asm):02620         
                      (    forth6809.asm):02621                       LDD  TSTUB4
                      (    forth6809.asm):02622                       SUBD TSTUAF
                      (    forth6809.asm):02623                       CMPD #4
                      (    forth6809.asm):02624                       BNE  T2FFAIL
                      (    forth6809.asm):02625         
                      (    forth6809.asm):02626                       LDD  #TRUEV
                      (    forth6809.asm):02627                       BRA  T2FDONE
C1AE                  (    forth6809.asm):02628         T2FFAIL:       LDD  #FALSEV
C1AE                  (    forth6809.asm):02629         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02630                       PSHU X
                      (    forth6809.asm):02631                       PSHU D
                      (    forth6809.asm):02632                       JSR  TSTREPORT
                      (    forth6809.asm):02633         
                      (    forth6809.asm):02634                       LDU  TSTU0
                      (    forth6809.asm):02635                       RTS
                      (    forth6809.asm):02636         
C1AE                  (    forth6809.asm):02637         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02638                           FCC  "TSTTWORFETCH"
                      (    forth6809.asm):02639         

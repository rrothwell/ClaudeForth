                      (    forth6809.asm):08741                   LBNE  VTFAIL  ; was BNE - out of short-branch range, since
                      (    forth6809.asm):08742                                 ; VTFAIL sits past this test's entire second
                      (    forth6809.asm):08743                                 ; round (the TO reassignment and re-check)
                      (    forth6809.asm):08744                   PULU D
                      (    forth6809.asm):08745                   CMPD #TSTGUARD
                      (    forth6809.asm):08746                   LBNE  VTFAIL  ; was BNE - same reason

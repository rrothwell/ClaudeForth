                      (    forth6809.asm):06617         ; TSTLEAVE - unit test for LEAVE. Compiles
                      (    forth6809.asm):06618         ; "DO I DUP 3 LITERAL = IF LEAVE THEN + LOOP", limit=10,
                      (    forth6809.asm):06619         ; start=0 - would normally visit I=0..9, but LEAVE forces exit
                      (    forth6809.asm):06620         ; once I=3 is reached. LEAVE only sets a flag; the actual exit
                      (    forth6809.asm):06621         ; happens at the NEXT LOOP check (per its own documented
                      (    forth6809.asm):06622         ; behavior, "exit at its next LOOP") - confirmed by hand-trace
                      (    forth6809.asm):06623         ; of DOTEST's own logic (checks the flag first, before its
                      (    forth6809.asm):06624         ; normal increment/compare). Since + runs before LOOP's check,
                      (    forth6809.asm):06625         ; I=3 IS accumulated before the loop exits - sum=0+1+2+3=6, not
                      (    forth6809.asm):06626         ; 0+1+2=3 (which would indicate LEAVE incorrectly took effect
                      (    forth6809.asm):06627         ; immediately) and not the full 0..9 (which would indicate
                      (    forth6809.asm):06628         ; LEAVE didn't work at all).
                      (    forth6809.asm):06629         ; ------------------------------------------------------------

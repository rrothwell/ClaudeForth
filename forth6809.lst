                      (    forth6809.asm):06790         ; TSTDOLP - unit test for DO/LOOP. Compiles "DO I + LOOP",
                      (    forth6809.asm):06791         ; run with limit=5, start-index=0, and a seed accumulator of 0
                      (    forth6809.asm):06792         ; already on the stack. Verifies the full I sequence (0,1,2,3,4)
                      (    forth6809.asm):06793         ; by summing it via + each iteration - a wrong index sequence
                      (    forth6809.asm):06794         ; (off-by-one, wrong direction, wrong starting value) would
                      (    forth6809.asm):06795         ; produce a different sum than the correct 0+1+2+3+4=10, not
                      (    forth6809.asm):06796         ; just "some number of iterations happened."
                      (    forth6809.asm):06797         ;
                      (    forth6809.asm):06798         ; The documented limit=index edge case (runs at least once) is
                      (    forth6809.asm):06799         ; deliberately NOT tested here: traced precisely (simulated the
                      (    forth6809.asm):06800         ; real DOTEST increment-and-compare-equal logic) and confirmed
                      (    forth6809.asm):06801         ; it takes a full 65536 iterations to naturally reconverge on
                      (    forth6809.asm):06802         ; equality, not one - true to the letter of "at least once" but
                      (    forth6809.asm):06803         ; impractical for a boot-time self-check. Left untested, not
                      (    forth6809.asm):06804         ; guessed at; noted in the open-items checklist.

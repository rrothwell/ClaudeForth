                      (    forth6809.asm):07443         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):07444         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):07445         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):07446         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):07447         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):07448         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):07449         ; division.

                      (    forth6809.asm):02970         ; TSTSLASHZ - unit test for SLASH, divide-by-zero case. n2 = 0.
                      (    forth6809.asm):02971         ; Verifies THROW -10 fires (per this system's documented ANS
                      (    forth6809.asm):02972         ; behavior for a zero divisor) and that CATCH's own depth-
                      (    forth6809.asm):02973         ; restoration contract holds (net 0 change across the JSR CATCH,
                      (    forth6809.asm):02974         ; xt's slot effectively replaced by the throw code). Per CATCH's
                      (    forth6809.asm):02975         ; own spec, the i*x arguments' VALUES are explicitly unspecified
                      (    forth6809.asm):02976         ; after a catch, not just untested here - the final, unconditional
                      (    forth6809.asm):02977         ; stack restore discards them without needing to know how many
                      (    forth6809.asm):02978         ; there are.
                      (    forth6809.asm):02979         ; ------------------------------------------------------------

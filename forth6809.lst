C289                  (    forth6809.asm):11158         TSTDFNAME: FCB  14
                      (    forth6809.asm):11159                    FCC  "TST2FETCHSTORE"
                      (    forth6809.asm):11160         
                      (    forth6809.asm):11161         ; ------------------------------------------------------------
                      (    forth6809.asm):11162         ; TSTCODEHERE - combined unit test for , C, ALLOT, and HERE
                      (    forth6809.asm):11163         ; together (glossary section 3.11's own CODEHERE-region words).
                      (    forth6809.asm):11164         ; Redirects CODEHERE to scratch and walks through a sequence:
                      (    forth6809.asm):11165         ; HERE reports the redirected value, COMMA appends a cell (and
                      (    forth6809.asm):11166         ; the written cell is verified directly, not just the advance),
                      (    forth6809.asm):11167         ; C, appends a byte (verified the same way), ALLOT reserves then
                      (    forth6809.asm):11168         ; releases bytes (confirming both directions work, matching
                      (    forth6809.asm):11169         ; "reserve (or release, if negative)"), and a final HERE
                      (    forth6809.asm):11170         ; confirms the cumulative result.
                      (    forth6809.asm):11171         ; ------------------------------------------------------------
C289                  (    forth6809.asm):11172         TSTCODEHERE: LDD  CODEHERE
                      (    forth6809.asm):11173                      STD  TSTCSAV
                      (    forth6809.asm):11174         
                      (    forth6809.asm):11175                      LDD  #TSTCBUF
                      (    forth6809.asm):11176                      STD  CODEHERE
                      (    forth6809.asm):11177         
                      (    forth6809.asm):11178                      STU  TSTU0
                      (    forth6809.asm):11179         
                      (    forth6809.asm):11180                      LDD  #TSTGUARD
                      (    forth6809.asm):11181                      PSHU D
                      (    forth6809.asm):11182                      STU  TSTUB4
                      (    forth6809.asm):11183         
                      (    forth6809.asm):11184                      JSR  HEREW
                      (    forth6809.asm):11185                      PULU D
                      (    forth6809.asm):11186                      CMPD #TSTCBUF
                      (    forth6809.asm):11187                      BNE  CHFAIL
                      (    forth6809.asm):11188         
                      (    forth6809.asm):11189                      LDD  #TSTVAL1
                      (    forth6809.asm):11190                      PSHU D
                      (    forth6809.asm):11191                      JSR  COMMA
                      (    forth6809.asm):11192                      LDD  TSTCBUF
                      (    forth6809.asm):11193                      CMPD #TSTVAL1
                      (    forth6809.asm):11194                      BNE  CHFAIL
                      (    forth6809.asm):11195                      LDD  CODEHERE
                      (    forth6809.asm):11196                      CMPD #TSTCBUF+2
                      (    forth6809.asm):11197                      BNE  CHFAIL
                      (    forth6809.asm):11198         
                      (    forth6809.asm):11199                      LDD  #$56
                      (    forth6809.asm):11200                      PSHU D
                      (    forth6809.asm):11201                      JSR  CCOMMA
                      (    forth6809.asm):11202                      LDA  TSTCBUF+2
                      (    forth6809.asm):11203                      CMPA #$56
                      (    forth6809.asm):11204                      BNE  CHFAIL

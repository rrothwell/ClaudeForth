                      (    forth6809.asm):03347         ; TSTDARITH - mixed & double-precision arithmetic tests (glossary
                      (    forth6809.asm):03348         ; section 3.5). Covers every word in that section. All 14 words
                      (    forth6809.asm):03349         ; traced by hand against their real implementations before any
                      (    forth6809.asm):03350         ; test was written - push/pop order for double-cell values (low
                      (    forth6809.asm):03351         ; cell pushed first, high cell last/on top - confirmed identical
                      (    forth6809.asm):03352         ; across every word here), and which of two operands is which
                      (    forth6809.asm):03353         ; (d1 vs d2, dividend vs divisor) - not assumed from the glossary
                      (    forth6809.asm):03354         ; stack-effect notation alone. FM/MOD (floored) and SM/REM
                      (    forth6809.asm):03355         ; (symmetric) tested against the same negative-dividend case
                      (    forth6809.asm):03356         ; specifically because that's where the two conventions actually
                      (    forth6809.asm):03357         ; diverge - confirmed distinct expected results for each.
                      (    forth6809.asm):03358         ; ------------------------------------------------------------
C358 BDFC2B           (    forth6809.asm):03359         TSTDARITH: JSR   CRW
C35B 8EC36C           (    forth6809.asm):03360                    LDX   #TSTDARITHMSG
C35E 3610             (    forth6809.asm):03361                    PSHU  X
C360 CC000B           (    forth6809.asm):03362                    LDD   #11
C363 3606             (    forth6809.asm):03363                    PSHU  D
C365 BDF60B           (    forth6809.asm):03364                    JSR   TYPE
C368 BDFC2B           (    forth6809.asm):03365                    JSR   CRW
                      (    forth6809.asm):03366         

F88F DDAB             (    forth6809.asm):06376                    STD  UEDST     ; the popped dest-addr into the SOURCE-
                      (    forth6809.asm):06377                                   ; length variable), then LDD ,U (a PEEK, not
                      (    forth6809.asm):06378                                   ; a pop) into BOTH UEADDR and UEDST - so the
                      (    forth6809.asm):06379                                   ; real source length was misread as an
                      (    forth6809.asm):06380                                   ; address, the real source address was never
                      (    forth6809.asm):06381                                   ; popped at all, and the true destination
                      (    forth6809.asm):06382                                   ; address never reached UEDST. Correct
                      (    forth6809.asm):06383                                   ; ANS order is ( c-addr1 u1 c-addr2 -- ):
                      (    forth6809.asm):06384                                   ; c-addr2 (dest) is on top, popped first.
F891 3706             (    forth6809.asm):06385                    PULU D         ; next: u1 (source length)
F893 DDA9             (    forth6809.asm):06386                    STD  UESRCLEN
F895 3706             (    forth6809.asm):06387                    PULU D         ; next: c-addr1 (source address)
F897 DDA7             (    forth6809.asm):06388                    STD  UEADDR
F899 CC0000           (    forth6809.asm):06389                    LDD  #0
F89C DDAD             (    forth6809.asm):06390                    STD  UEOUTLEN

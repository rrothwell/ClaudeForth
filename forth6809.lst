                      (    forth6809.asm):00455         ; ------------------------------------------------------------
                      (    forth6809.asm):00456         ; MVSCRATCH - three cells shared, one at a time, by routine
                      (    forth6809.asm):00457         ; families that never call each other or run concurrently in
                      (    forth6809.asm):00458         ; this single-threaded interpreter: MOVE/CMOVE/CMOVE>, FILL, and
                      (    forth6809.asm):00459         ; HOLDS (plus the single-cell multiply routine). Sharing avoids
                      (    forth6809.asm):00460         ; needing 3x the physical storage for what is provably the same
                      (    forth6809.asm):00461         ; scratch need at different times; the tradeoff is that these
                      (    forth6809.asm):00462         ; three cells use ordinary extended addressing (3-byte LDD/STD),
                      (    forth6809.asm):00463         ; not direct-page (2-byte), since page zero has no room left.
                      (    forth6809.asm):00464         ;
                      (    forth6809.asm):00465         ;   MVCNT    - MOVE/CMOVE's remaining-byte count
                      (    forth6809.asm):00466         ;     FILLCNT  EQU MVCNT   - FILL's remaining-byte count
                      (    forth6809.asm):00467         ;     HSLEN    EQU MVCNT   - HOLDS's remaining-char count
                      (    forth6809.asm):00468         ;   MVDST    - MOVE/CMOVE's destination address
                      (    forth6809.asm):00469         ;     FILLADDR EQU MVDST   - FILL's target address
                      (    forth6809.asm):00470         ;     HSADDR   EQU MVDST   - HOLDS's source address
                      (    forth6809.asm):00471         ;   MVSRC    - MOVE/CMOVE's source address
                      (    forth6809.asm):00472         ;     MRESULT  EQU MVSRC   - single-cell multiply's 16-bit result
                      (    forth6809.asm):00473         ;     FILLCHR  EQU MVSRC   - FILL's fill character (1 byte, uses
                      (    forth6809.asm):00474         ;                            MVSRC's first byte only)
                      (    forth6809.asm):00475         ; ------------------------------------------------------------

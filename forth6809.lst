                      (    forth6809.asm):03223                    PULU  D
                      (    forth6809.asm):03224                    CMPD  #-10
                      (    forth6809.asm):03225                    BNE   TZFAIL
                      (    forth6809.asm):03226         
                      (    forth6809.asm):03227                    LDD   TSTUB4
                      (    forth6809.asm):03228                    SUBD  TSTUAF
                      (    forth6809.asm):03229                    CMPD  #0
                      (    forth6809.asm):03230                    BNE   TZFAIL
                      (    forth6809.asm):03231         

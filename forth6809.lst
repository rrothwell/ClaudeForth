F521 1F02             (    forth6809.asm):19826                  TFR   D,Y        ; BUG FIX: was STD FILLCNT/LDD FILLCNT each
                      (    forth6809.asm):19827                                   ; iteration - and inside the loop, LDA
                      (    forth6809.asm):19828                                   ; FILLCHR (needed for the fill byte) clobbers
                      (    forth6809.asm):19829                                   ; A, which is D's high byte, corrupting the
                      (    forth6809.asm):19830                                   ; count that SUBD #1 then decremented from.
                      (    forth6809.asm):19831                                   ; The high byte took on the fill character's
                      (    forth6809.asm):19832                                   ; value instead of the count's real high
                      (    forth6809.asm):19833                                   ; byte, so the count almost never reached
                      (    forth6809.asm):19834                                   ; zero at the intended point - FILL ran far
                      (    forth6809.asm):19835                                   ; past the requested length. Keeping the
                      (    forth6809.asm):19836                                   ; count in Y instead removes the conflict
                      (    forth6809.asm):19837                                   ; entirely (Y is untouched by loading the
                      (    forth6809.asm):19838                                   ; fill character into A) and removes the
                      (    forth6809.asm):19839                                   ; per-iteration memory round-trip - also
                      (    forth6809.asm):19840                                   ; addresses the redundant scratch usage
                      (    forth6809.asm):19841                                   ; flagged alongside this bug. Confirmed via
                      (    forth6809.asm):19842                                   ; MAME debugger.

                      (    forth6809.asm):03542                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):03543                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):03544                                   ; J's own JSR pushes one more cell on top,

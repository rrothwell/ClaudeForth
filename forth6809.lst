                      (    forth6809.asm):07045         ; ------------------------------------------------------------
                      (    forth6809.asm):07046         ; Divide the unsigned double on the data stack (high cell at 0,U, low
                      (    forth6809.asm):07047         ; cell at 2,U) by BASE (restoring division, 32 iterations). Only the
                      (    forth6809.asm):07048         ; low byte of BASE is used.
                      (    forth6809.asm):07049         ; UDDIGIT
                      (    forth6809.asm):07050         ;    Inputs:
                      (    forth6809.asm):07051         ;        ud on the data stack
                      (    forth6809.asm):07052         ;    Outputs:
                      (    forth6809.asm):07053         ;        ud replaced by the quotient; RegA = remainder
                      (    forth6809.asm):07054         ;    Registers: RegA and RegB changed (RegB is the loop counter).
                      (    forth6809.asm):07055         ; ------------------------------------------------------------
F883 4F               (    forth6809.asm):07056         UDDIGIT:    CLRA                    ; A = remainder
F884 C620             (    forth6809.asm):07057                     LDB   #32
F886 6843             (    forth6809.asm):07058         UDDLOOP:    ASL   3,U

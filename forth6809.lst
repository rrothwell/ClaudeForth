E48D E684             (    forth6809.asm):03176                     LDB   ,X
E48F 276D             (    forth6809.asm):03177                     BEQ   NQBAD
E491 3001             (    forth6809.asm):03178                     LEAX  1,X
                      (    forth6809.asm):03179         
                      (    forth6809.asm):03180                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):03181                     ; digit count. See shadow: NUMBERQ.1

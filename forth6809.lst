                      (    forth6809.asm):02379         ; ------------------------------------------------------------
                      (    forth6809.asm):02380         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02381         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02382         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02383         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02384         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02385         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02386         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02387         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02388         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02389         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02390         ;
                      (    forth6809.asm):02391         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02392         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02393         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02394         ; right value once.
                      (    forth6809.asm):02395         ; ------------------------------------------------------------
C19B BDFC2B           (    forth6809.asm):02396         TSTRETSTACK: JSR CRW
C19E 8EC1AF           (    forth6809.asm):02397                    LDX   #TSTRETMSG
C1A1 3610             (    forth6809.asm):02398                    PSHU  X
C1A3 CC0008           (    forth6809.asm):02399                    LDD   #8
C1A6 3606             (    forth6809.asm):02400                    PSHU  D
C1A8 BDF60B           (    forth6809.asm):02401                    JSR   TYPE
C1AB BDFC2B           (    forth6809.asm):02402                    JSR   CRW
                      (    forth6809.asm):02403         
                      (    forth6809.asm):02404                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02405         
                      (    forth6809.asm):02406                    JSR   TSTTOR
                      (    forth6809.asm):02407                    JSR   TSTRFETCH
                      (    forth6809.asm):02408                    JSR   TSTTWOTOR
                      (    forth6809.asm):02409                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02410         
                      (    forth6809.asm):02411                    ENDC ; <<<<
                      (    forth6809.asm):02412         
C1AE 39               (    forth6809.asm):02413                    RTS
                      (    forth6809.asm):02414         
C1AF 526574537461636B (    forth6809.asm):02415         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02416         
                      (    forth6809.asm):02417                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02418         
                      (    forth6809.asm):02419         ; ------------------------------------------------------------
                      (    forth6809.asm):02420         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02421         ; every other test group in this file, these words operate
                      (    forth6809.asm):02422         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02423         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02424         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02425         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02426         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02427         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02428         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02429         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02430         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02431         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02432         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02433         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02434         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02435         ; ------------------------------------------------------------
                      (    forth6809.asm):02436         
                      (    forth6809.asm):02437         ; ------------------------------------------------------------
                      (    forth6809.asm):02438         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02439         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02440         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02441         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02442         ; value would never actually have left.
                      (    forth6809.asm):02443         ; ------------------------------------------------------------
C1B7                  (    forth6809.asm):02444         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02445         
                      (    forth6809.asm):02446                  LDD   #TSTGUARD
                      (    forth6809.asm):02447                  PSHU  D
                      (    forth6809.asm):02448                  LDD   #TSTVAL1
                      (    forth6809.asm):02449                  PSHU  D
                      (    forth6809.asm):02450                  STU   TSTUB4
                      (    forth6809.asm):02451         
                      (    forth6809.asm):02452                  JSR   TOR
                      (    forth6809.asm):02453         
                      (    forth6809.asm):02454                  STU   TSTUMID
                      (    forth6809.asm):02455         
                      (    forth6809.asm):02456                  LDD   TSTUB4
                      (    forth6809.asm):02457                  SUBD  TSTUMID
                      (    forth6809.asm):02458                  CMPD  #-2
                      (    forth6809.asm):02459                  BNE   TRFAIL
                      (    forth6809.asm):02460         
                      (    forth6809.asm):02461                  JSR   FROMR
                      (    forth6809.asm):02462         
                      (    forth6809.asm):02463                  STU   TSTUAF
                      (    forth6809.asm):02464         
                      (    forth6809.asm):02465                  PULU  D
                      (    forth6809.asm):02466                  CMPD  #TSTVAL1
                      (    forth6809.asm):02467                  BNE   TRFAIL
                      (    forth6809.asm):02468                  PULU  D
                      (    forth6809.asm):02469                  CMPD  #TSTGUARD
                      (    forth6809.asm):02470                  BNE   TRFAIL
                      (    forth6809.asm):02471         
                      (    forth6809.asm):02472                  LDD   TSTUB4
                      (    forth6809.asm):02473                  SUBD  TSTUAF
                      (    forth6809.asm):02474                  CMPD  #0
                      (    forth6809.asm):02475                  BNE   TRFAIL
                      (    forth6809.asm):02476         
                      (    forth6809.asm):02477                  LDD   #TRUEV
                      (    forth6809.asm):02478                  BRA   TRDONE
C1B7                  (    forth6809.asm):02479         TRFAIL:  LDD   #FALSEV
C1B7                  (    forth6809.asm):02480         TRDONE:  LDX   #TSTTORNAME
                      (    forth6809.asm):02481                  PSHU  X
                      (    forth6809.asm):02482                  PSHU  D
                      (    forth6809.asm):02483                  JSR   TSTREPORT
                      (    forth6809.asm):02484         
                      (    forth6809.asm):02485                  LDU   TSTU0
                      (    forth6809.asm):02486                  RTS
                      (    forth6809.asm):02487         
C1B7                  (    forth6809.asm):02488         TSTTORNAME: FCB  6
                      (    forth6809.asm):02489                     FCC  "TSTTOR"
                      (    forth6809.asm):02490         
                      (    forth6809.asm):02491         ; ------------------------------------------------------------
                      (    forth6809.asm):02492         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02493         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02494         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02495         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02496         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02497         ; not assumed from the name.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
C1B7                  (    forth6809.asm):02499         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02500         
                      (    forth6809.asm):02501                    LDD  #TSTGUARD
                      (    forth6809.asm):02502                    PSHU D
                      (    forth6809.asm):02503                    LDD  #TSTVAL1
                      (    forth6809.asm):02504                    PSHU D
                      (    forth6809.asm):02505                    STU  TSTUB4
                      (    forth6809.asm):02506         
                      (    forth6809.asm):02507                    JSR  TOR
                      (    forth6809.asm):02508                    JSR  RFETCH
                      (    forth6809.asm):02509                    JSR  FROMR
                      (    forth6809.asm):02510         
                      (    forth6809.asm):02511                    STU  TSTUAF
                      (    forth6809.asm):02512         
                      (    forth6809.asm):02513                    PULU D
                      (    forth6809.asm):02514                    CMPD #TSTVAL1
                      (    forth6809.asm):02515                    BNE  RFFAIL
                      (    forth6809.asm):02516                    PULU D
                      (    forth6809.asm):02517                    CMPD #TSTVAL1
                      (    forth6809.asm):02518                    BNE  RFFAIL
                      (    forth6809.asm):02519                    PULU D
                      (    forth6809.asm):02520                    CMPD #TSTGUARD
                      (    forth6809.asm):02521                    BNE  RFFAIL
                      (    forth6809.asm):02522         
                      (    forth6809.asm):02523                    LDD  TSTUB4
                      (    forth6809.asm):02524                    SUBD TSTUAF
                      (    forth6809.asm):02525                    CMPD #2
                      (    forth6809.asm):02526                    BNE  RFFAIL
                      (    forth6809.asm):02527         
                      (    forth6809.asm):02528                    LDD  #TRUEV
                      (    forth6809.asm):02529                    BRA  RFDONE
C1B7                  (    forth6809.asm):02530         RFFAIL:    LDD  #FALSEV
C1B7                  (    forth6809.asm):02531         RFDONE:    LDX  #TSTRFETCHNAME
                      (    forth6809.asm):02532                    PSHU X
                      (    forth6809.asm):02533                    PSHU D
                      (    forth6809.asm):02534                    JSR  TSTREPORT
                      (    forth6809.asm):02535         
                      (    forth6809.asm):02536                    LDU  TSTU0
                      (    forth6809.asm):02537                    RTS
                      (    forth6809.asm):02538         
C1B7                  (    forth6809.asm):02539         TSTRFETCHNAME: FCB  9
                      (    forth6809.asm):02540                        FCC  "TSTRFETCH"
                      (    forth6809.asm):02541         
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
                      (    forth6809.asm):02543         ; TSTTWOTOR - unit test for 2>R and 2R> together. Same
                      (    forth6809.asm):02544         ; intermediate-check reasoning as TSTTOR, applied to the pair -
                      (    forth6809.asm):02545         ; confirms both cells genuinely left the data stack before
                      (    forth6809.asm):02546         ; verifying the round trip.
                      (    forth6809.asm):02547         ; ------------------------------------------------------------
C1B7                  (    forth6809.asm):02548         TSTTWOTOR: STU  TSTU0
                      (    forth6809.asm):02549         
                      (    forth6809.asm):02550                    LDD  #TSTGUARD
                      (    forth6809.asm):02551                    PSHU D
                      (    forth6809.asm):02552                    LDD  #TSTVAL1
                      (    forth6809.asm):02553                    PSHU D
                      (    forth6809.asm):02554                    LDD  #TSTVAL2
                      (    forth6809.asm):02555                    PSHU D
                      (    forth6809.asm):02556                    STU  TSTUB4
                      (    forth6809.asm):02557         
                      (    forth6809.asm):02558                    JSR  TWOTOR
                      (    forth6809.asm):02559         
                      (    forth6809.asm):02560                    STU  TSTUMID
                      (    forth6809.asm):02561         
                      (    forth6809.asm):02562                    LDD  TSTUB4
                      (    forth6809.asm):02563                    SUBD TSTUMID
                      (    forth6809.asm):02564                    CMPD #-4
                      (    forth6809.asm):02565                    BNE  T2RFAIL
                      (    forth6809.asm):02566         
                      (    forth6809.asm):02567                    JSR  TWOFROMR
                      (    forth6809.asm):02568         
                      (    forth6809.asm):02569                    STU  TSTUAF
                      (    forth6809.asm):02570         
                      (    forth6809.asm):02571                    PULU D
                      (    forth6809.asm):02572                    CMPD #TSTVAL2
                      (    forth6809.asm):02573                    BNE  T2RFAIL
                      (    forth6809.asm):02574                    PULU D
                      (    forth6809.asm):02575                    CMPD #TSTVAL1
                      (    forth6809.asm):02576                    BNE  T2RFAIL
                      (    forth6809.asm):02577                    PULU D
                      (    forth6809.asm):02578                    CMPD #TSTGUARD
                      (    forth6809.asm):02579                    BNE  T2RFAIL
                      (    forth6809.asm):02580         
                      (    forth6809.asm):02581                    LDD  TSTUB4
                      (    forth6809.asm):02582                    SUBD TSTUAF
                      (    forth6809.asm):02583                    CMPD #0
                      (    forth6809.asm):02584                    BNE  T2RFAIL
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586                    LDD  #TRUEV
                      (    forth6809.asm):02587                    BRA  T2RDONE
C1B7                  (    forth6809.asm):02588         T2RFAIL:   LDD  #FALSEV
C1B7                  (    forth6809.asm):02589         T2RDONE:   LDX  #TSTTWOTORNAME
                      (    forth6809.asm):02590                    PSHU X
                      (    forth6809.asm):02591                    PSHU D
                      (    forth6809.asm):02592                    JSR  TSTREPORT
                      (    forth6809.asm):02593         
                      (    forth6809.asm):02594                    LDU  TSTU0
                      (    forth6809.asm):02595                    RTS
                      (    forth6809.asm):02596         
C1B7                  (    forth6809.asm):02597         TSTTWOTORNAME: FCB  9
                      (    forth6809.asm):02598                        FCC  "TSTTWOTOR"
                      (    forth6809.asm):02599         
                      (    forth6809.asm):02600         ; ------------------------------------------------------------
                      (    forth6809.asm):02601         ; TSTTWORFETCH - unit test for 2R@. Same reasoning as
                      (    forth6809.asm):02602         ; TSTRFETCH, applied to the pair: moves x1,x2 to the return
                      (    forth6809.asm):02603         ; stack via 2>R, peeks via 2R@ (verifying both cells, correctly
                      (    forth6809.asm):02604         ; ordered), then retrieves the originals via 2R> (verifying 2R@
                      (    forth6809.asm):02605         ; genuinely left them there undisturbed).
                      (    forth6809.asm):02606         ; ------------------------------------------------------------
C1B7                  (    forth6809.asm):02607         TSTTWORFETCH: STU  TSTU0
                      (    forth6809.asm):02608         
                      (    forth6809.asm):02609                       LDD  #TSTGUARD
                      (    forth6809.asm):02610                       PSHU D
                      (    forth6809.asm):02611                       LDD  #TSTVAL1
                      (    forth6809.asm):02612                       PSHU D
                      (    forth6809.asm):02613                       LDD  #TSTVAL2
                      (    forth6809.asm):02614                       PSHU D
                      (    forth6809.asm):02615                       STU  TSTUB4
                      (    forth6809.asm):02616         
                      (    forth6809.asm):02617                       JSR  TWOTOR
                      (    forth6809.asm):02618                       JSR  TWORFETCH
                      (    forth6809.asm):02619                       JSR  TWOFROMR
                      (    forth6809.asm):02620         
                      (    forth6809.asm):02621                       STU  TSTUAF
                      (    forth6809.asm):02622         
                      (    forth6809.asm):02623                       PULU D
                      (    forth6809.asm):02624                       CMPD #TSTVAL2
                      (    forth6809.asm):02625                       BNE  T2FFAIL
                      (    forth6809.asm):02626                       PULU D
                      (    forth6809.asm):02627                       CMPD #TSTVAL1
                      (    forth6809.asm):02628                       BNE  T2FFAIL
                      (    forth6809.asm):02629                       PULU D
                      (    forth6809.asm):02630                       CMPD #TSTVAL2
                      (    forth6809.asm):02631                       BNE  T2FFAIL
                      (    forth6809.asm):02632                       PULU D
                      (    forth6809.asm):02633                       CMPD #TSTVAL1
                      (    forth6809.asm):02634                       BNE  T2FFAIL
                      (    forth6809.asm):02635                       PULU D
                      (    forth6809.asm):02636                       CMPD #TSTGUARD
                      (    forth6809.asm):02637                       BNE  T2FFAIL
                      (    forth6809.asm):02638         
                      (    forth6809.asm):02639                       LDD  TSTUB4
                      (    forth6809.asm):02640                       SUBD TSTUAF
                      (    forth6809.asm):02641                       CMPD #4
                      (    forth6809.asm):02642                       BNE  T2FFAIL
                      (    forth6809.asm):02643         
                      (    forth6809.asm):02644                       LDD  #TRUEV
                      (    forth6809.asm):02645                       BRA  T2FDONE
C1B7                  (    forth6809.asm):02646         T2FFAIL:       LDD  #FALSEV
C1B7                  (    forth6809.asm):02647         T2FDONE:       LDX  #TSTTWORFETCHNAME
                      (    forth6809.asm):02648                       PSHU X
                      (    forth6809.asm):02649                       PSHU D
                      (    forth6809.asm):02650                       JSR  TSTREPORT
                      (    forth6809.asm):02651         
                      (    forth6809.asm):02652                       LDU  TSTU0
                      (    forth6809.asm):02653                       RTS
                      (    forth6809.asm):02654         
C1B7                  (    forth6809.asm):02655         TSTTWORFETCHNAME: FCB  12
                      (    forth6809.asm):02656                           FCC  "TSTTWORFETCH"
                      (    forth6809.asm):02657         
                      (    forth6809.asm):02658                    ENDC ; <<<<

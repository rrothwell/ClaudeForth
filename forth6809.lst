                      (    forth6809.asm):03023         ; ------------------------------------------------------------
                      (    forth6809.asm):03024         ; WORD  ( char "<chars>ccc<char>" -- c-addr )
                      (    forth6809.asm):03025         ; Skip leading delimiters, then parse text up to the next char from
                      (    forth6809.asm):03026         ; the input source. The text is stored as a counted string at
                      (    forth6809.asm):03027         ; CODEHERE, which is not advanced. An exhausted input gives a zero
                      (    forth6809.asm):03028         ; count. Its scratch lives in an S frame; see shadow WORDW.7.
                      (    forth6809.asm):03029         ; ------------------------------------------------------------
E1F0 3706             (    forth6809.asm):03030         WORDW:      PULU  D                 ; char
E1F2 327D             (    forth6809.asm):03031                     LEAS  -3,S              ; frame (5k): 0,S = delimiter,
E1F4 E7E4             (    forth6809.asm):03032                     STB   ,S                ; 1,S = start of the text
E1F6 DC10             (    forth6809.asm):03033                     LDD   TOIN
E1F8 9E39             (    forth6809.asm):03034                     LDX   SRCADDR
E1FA 308B             (    forth6809.asm):03035                     LEAX  D,X

E853 3606             (    forth6809.asm):04208                     PSHU  D
E855 DC08             (    forth6809.asm):04209                     LDD   CODEHERE
E857 3606             (    forth6809.asm):04210                     PSHU  D                 ; dest
E859 CC0003           (    forth6809.asm):04211                     LDD   #TAGDO
E85C 3606             (    forth6809.asm):04212                     PSHU  D

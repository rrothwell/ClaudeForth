C26F                  (    forth6809.asm):10605         SL1FAIL:      LDD  #FALSEV
C26F                  (    forth6809.asm):10606         SL1DONE:      LDX  #TSTSL1NAME
                      (    forth6809.asm):10607                       PSHU X

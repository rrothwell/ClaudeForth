E8FE 39               (    forth6809.asm):03638                  RTS              ; on the limit (what's really at 4,S unshifted)
                      (    forth6809.asm):03639                                   ; instead of the index. The pair served no
                      (    forth6809.asm):03640                                   ; purpose (nothing needed offset 0 for anything
                      (    forth6809.asm):03641                                   ; here) - removed, so 2,S directly and
                      (    forth6809.asm):03642                                   ; correctly targets the index DOSETUP pushed
                      (    forth6809.asm):03643                                   ; there. Confirmed via MAME debugger: "I"
                      (    forth6809.asm):03644                                   ; returned the loop limit on every iteration.
                      (    forth6809.asm):03645         
E8FF EC68             (    forth6809.asm):03646         JWORD:   LDD   8,S        ; CORRECTION: an earlier turn changed this to
E901 3606             (    forth6809.asm):03647                  PSHU  D          ; 10,S, which was itself wrong - it assumed
E903 39               (    forth6809.asm):03648                  RTS              ; DOSETUP's own JSR-pushed return address
                      (    forth6809.asm):03649                                   ; persists on S once each DOSETUP finishes.
                      (    forth6809.asm):03650                                   ; It doesn't: DOSETUP's own RTS pops and
                      (    forth6809.asm):03651                                   ; consumes it to jump into the loop body, so
                      (    forth6809.asm):03652                                   ; it never actually sits on S for J to count
                      (    forth6809.asm):03653                                   ; past. Re-traced by counting every real
                      (    forth6809.asm):03654                                   ; push/pop across a nested DO: after the
                      (    forth6809.asm):03655                                   ; inner DOSETUP finishes, S is [inner-index@0]
                      (    forth6809.asm):03656                                   ; [inner-limit@2][inner-leave@4][outer-
                      (    forth6809.asm):03657                                   ; index@6][outer-limit@8][outer-leave@10] -
                      (    forth6809.asm):03658                                   ; J's own JSR pushes one more cell on top,
                      (    forth6809.asm):03659                                   ; landing outer-index at 8, not 10. Offset 10
                      (    forth6809.asm):03660                                   ; read the outer loop's limit instead - a
                      (    forth6809.asm):03661                                   ; fixed value every iteration, exactly
                      (    forth6809.asm):03662                                   ; matching the observed bug (J stuck at the
                      (    forth6809.asm):03663                                   ; limit, never progressing). Confirmed via a
                      (    forth6809.asm):03664                                   ; real MULT-TABLE test on MAME.

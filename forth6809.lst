                      (    forth6809.asm):04103         ; Multiply the unsigned double ud on the data stack by BASE and add a
                      (    forth6809.asm):04104         ; digit. (5m: the accumulator lives on the data stack, in the frame of
                      (    forth6809.asm):04105         ; >NUMBER, so no page-zero cells are needed.)
                      (    forth6809.asm):04106         ; UDMULADD
                      (    forth6809.asm):04107         ;    Inputs:
                      (    forth6809.asm):04108         ;        ud at 4,U (high cell) and 6,U (low cell), as in the >NUMBER
                      (    forth6809.asm):04109         ;        frame ( ud c-addr u )
                      (    forth6809.asm):04110         ;        RegB = digit value to add
                      (    forth6809.asm):04111         ;        BASE
                      (    forth6809.asm):04112         ;    Outputs:
                      (    forth6809.asm):04113         ;        ud = ud * BASE + digit
                      (    forth6809.asm):04114         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04115         ; ------------------------------------------------------------
DC3E 327E             (    forth6809.asm):04116         UDMULADD:   LEAS  -2,S              ; 0,S = carry, 1,S = BASE multiplier
DC40 E7E4             (    forth6809.asm):04117                     STB   ,S
DC42 9603             (    forth6809.asm):04118                     LDA   BASE+1
DC44 A761             (    forth6809.asm):04119                     STA   1,S
DC46 A647             (    forth6809.asm):04120                     LDA   7,U
DC48 E661             (    forth6809.asm):04121                     LDB   1,S
DC4A 3D               (    forth6809.asm):04122                     MUL
DC4B EBE4             (    forth6809.asm):04123                     ADDB  ,S
DC4D 2401             (    forth6809.asm):04124                     BCC   UM0
DC4F 4C               (    forth6809.asm):04125                     INCA
DC50 E747             (    forth6809.asm):04126         UM0:        STB   7,U
DC52 A7E4             (    forth6809.asm):04127                     STA   ,S
DC54 A646             (    forth6809.asm):04128                     LDA   6,U
DC56 E661             (    forth6809.asm):04129                     LDB   1,S
DC58 3D               (    forth6809.asm):04130                     MUL
DC59 EBE4             (    forth6809.asm):04131                     ADDB  ,S
DC5B 2401             (    forth6809.asm):04132                     BCC   UM1
DC5D 4C               (    forth6809.asm):04133                     INCA
DC5E E746             (    forth6809.asm):04134         UM1:        STB   6,U
DC60 A7E4             (    forth6809.asm):04135                     STA   ,S
DC62 A645             (    forth6809.asm):04136                     LDA   5,U
DC64 E661             (    forth6809.asm):04137                     LDB   1,S
DC66 3D               (    forth6809.asm):04138                     MUL
DC67 EBE4             (    forth6809.asm):04139                     ADDB  ,S
DC69 2401             (    forth6809.asm):04140                     BCC   UM2
DC6B 4C               (    forth6809.asm):04141                     INCA
DC6C E745             (    forth6809.asm):04142         UM2:        STB   5,U
DC6E A7E4             (    forth6809.asm):04143                     STA   ,S
DC70 A644             (    forth6809.asm):04144                     LDA   4,U
DC72 E661             (    forth6809.asm):04145                     LDB   1,S
DC74 3D               (    forth6809.asm):04146                     MUL
DC75 EBE4             (    forth6809.asm):04147                     ADDB  ,S
DC77 2401             (    forth6809.asm):04148                     BCC   UM3
DC79 4C               (    forth6809.asm):04149                     INCA
DC7A E744             (    forth6809.asm):04150         UM3:        STB   4,U

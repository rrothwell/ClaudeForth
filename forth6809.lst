                      (    forth6809.asm):02327         
                      (    forth6809.asm):02328         ; ------------------------------------------------------------
                      (    forth6809.asm):02329         ; TSTRETSTACK - return-stack tests (glossary section 3.3, 6
                      (    forth6809.asm):02330         ; words, 4 tests since >R/R> and 2>R/2R> are each combined into
                      (    forth6809.asm):02331         ; one round-trip test, matching how they can only be meaningfully
                      (    forth6809.asm):02332         ; tested together - the "must be balanced within the same
                      (    forth6809.asm):02333         ; definition" constraint each word's own glossary entry
                      (    forth6809.asm):02334         ; documents). Every >R/2>R in these tests is balanced by a
                      (    forth6809.asm):02335         ; matching R>/2R> before this group's own RTS - these words
                      (    forth6809.asm):02336         ; operate directly on the return stack, the same stack holding
                      (    forth6809.asm):02337         ; real subroutine return addresses, so leaving one unbalanced
                      (    forth6809.asm):02338         ; would corrupt the path back to whatever called this test.
                      (    forth6809.asm):02339         ;
                      (    forth6809.asm):02340         ; R@/2R@ tests specifically verify "non-destructive" for real:
                      (    forth6809.asm):02341         ; peek, then retrieve the original afterward and confirm it's
                      (    forth6809.asm):02342         ; still correct - not just that the peek itself returned the
                      (    forth6809.asm):02343         ; right value once.
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
C18C BDFC2B           (    forth6809.asm):02345         TSTRETSTACK: JSR CRW
C18F 8EC1A0           (    forth6809.asm):02346                    LDX   #TSTRETMSG
C192 3610             (    forth6809.asm):02347                    PSHU  X
C194 CC0008           (    forth6809.asm):02348                    LDD   #8
C197 3606             (    forth6809.asm):02349                    PSHU  D
C199 BDF60B           (    forth6809.asm):02350                    JSR   TYPE
C19C BDFC2B           (    forth6809.asm):02351                    JSR   CRW
                      (    forth6809.asm):02352         
                      (    forth6809.asm):02353                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02354         
                      (    forth6809.asm):02355                    JSR   TSTTOR
                      (    forth6809.asm):02356                    JSR   TSTRFETCH
                      (    forth6809.asm):02357                    JSR   TSTTWOTOR
                      (    forth6809.asm):02358                    JSR   TSTTWORFETCH
                      (    forth6809.asm):02359         
                      (    forth6809.asm):02360                    ENDC ; <<<<
                      (    forth6809.asm):02361         
C19F 39               (    forth6809.asm):02362                    RTS
                      (    forth6809.asm):02363         
C1A0 526574537461636B (    forth6809.asm):02364         TSTRETMSG: FCC "RetStack"
                      (    forth6809.asm):02365         
                      (    forth6809.asm):02366                    IFEQ TSTSELECTOR-2  ; >>>>
                      (    forth6809.asm):02367         
                      (    forth6809.asm):02368         ; ------------------------------------------------------------
                      (    forth6809.asm):02369         ; Return-stack test harness (glossary section 3.3). Unlike
                      (    forth6809.asm):02370         ; every other test group in this file, these words operate
                      (    forth6809.asm):02371         ; directly on the return stack (S) - the same stack holding
                      (    forth6809.asm):02372         ; real subroutine return addresses, including this very test
                      (    forth6809.asm):02373         ; subroutine's own. Every >R/2>R is balanced by a matching
                      (    forth6809.asm):02374         ; R>/2R> within the same test body, before this test's own
                      (    forth6809.asm):02375         ; RTS - leaving one unbalanced would corrupt the return address
                      (    forth6809.asm):02376         ; needed to get back to TSTRUNNER (or whatever called it).
                      (    forth6809.asm):02377         ; Traced each word's own PULS/PSHS juggling by hand first to
                      (    forth6809.asm):02378         ; confirm this: >R/R>/2>R/2R> all temporarily lift the caller's
                      (    forth6809.asm):02379         ; own return address off S, do the actual move, then restore it
                      (    forth6809.asm):02380         ; on top - so the moved value ends up correctly nested one level
                      (    forth6809.asm):02381         ; inside the current subroutine's own return-stack frame,
                      (    forth6809.asm):02382         ; retrievable by a later R>/2R> in the same body, and cleanly
                      (    forth6809.asm):02383         ; gone by the time this test's own RTS runs.
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         
                      (    forth6809.asm):02386         ; ------------------------------------------------------------
                      (    forth6809.asm):02387         ; TSTTOR - unit test for >R and R> together. Includes an
                      (    forth6809.asm):02388         ; intermediate check (right after >R, before R>) confirming the
                      (    forth6809.asm):02389         ; value genuinely left the data stack - a pure round-trip check
                      (    forth6809.asm):02390         ; could pass even if both words were broken no-ops, since the
                      (    forth6809.asm):02391         ; value would never actually have left.
                      (    forth6809.asm):02392         ; ------------------------------------------------------------
C1A8                  (    forth6809.asm):02393         TSTTOR:  STU   TSTU0
                      (    forth6809.asm):02394         
                      (    forth6809.asm):02395                  LDD   #TSTGUARD
                      (    forth6809.asm):02396                  PSHU  D
                      (    forth6809.asm):02397                  LDD   #TSTVAL1
                      (    forth6809.asm):02398                  PSHU  D
                      (    forth6809.asm):02399                  STU   TSTUB4
                      (    forth6809.asm):02400         
                      (    forth6809.asm):02401                  JSR   TOR
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403                  STU   TSTUMID
                      (    forth6809.asm):02404         
                      (    forth6809.asm):02405                  LDD   TSTUB4
                      (    forth6809.asm):02406                  SUBD  TSTUMID
                      (    forth6809.asm):02407                  CMPD  #-2
                      (    forth6809.asm):02408                  BNE   TRFAIL
                      (    forth6809.asm):02409         
                      (    forth6809.asm):02410                  JSR   FROMR
                      (    forth6809.asm):02411         
                      (    forth6809.asm):02412                  STU   TSTUAF
                      (    forth6809.asm):02413         
                      (    forth6809.asm):02414                  PULU  D
                      (    forth6809.asm):02415                  CMPD  #TSTVAL1
                      (    forth6809.asm):02416                  BNE   TRFAIL
                      (    forth6809.asm):02417                  PULU  D
                      (    forth6809.asm):02418                  CMPD  #TSTGUARD
                      (    forth6809.asm):02419                  BNE   TRFAIL
                      (    forth6809.asm):02420         
                      (    forth6809.asm):02421                  LDD   TSTUB4
                      (    forth6809.asm):02422                  SUBD  TSTUAF
                      (    forth6809.asm):02423                  CMPD  #0
                      (    forth6809.asm):02424                  BNE   TRFAIL
                      (    forth6809.asm):02425         
                      (    forth6809.asm):02426                  LDD   #TRUEV
                      (    forth6809.asm):02427                  BRA   TRDONE
C1A8                  (    forth6809.asm):02428         TRFAIL:  LDD   #FALSEV
C1A8                  (    forth6809.asm):02429         TRDONE:  LDX   #TSTTORNAME
                      (    forth6809.asm):02430                  PSHU  X
                      (    forth6809.asm):02431                  PSHU  D
                      (    forth6809.asm):02432                  JSR   TSTREPORT
                      (    forth6809.asm):02433         
                      (    forth6809.asm):02434                  LDU   TSTU0
                      (    forth6809.asm):02435                  RTS
                      (    forth6809.asm):02436         
C1A8                  (    forth6809.asm):02437         TSTTORNAME: FCB  6
                      (    forth6809.asm):02438                     FCC  "TSTTOR"
                      (    forth6809.asm):02439         
                      (    forth6809.asm):02440         ; ------------------------------------------------------------
                      (    forth6809.asm):02441         ; TSTRFETCH - unit test for R@. Moves a value to the return
                      (    forth6809.asm):02442         ; stack via >R, peeks it via R@ (verifying the copy matches),
                      (    forth6809.asm):02443         ; then retrieves the original via R> (verifying R@ genuinely
                      (    forth6809.asm):02444         ; left it there undisturbed, not just that R@ itself returned
                      (    forth6809.asm):02445         ; the right value once) - confirming "non-destructive" for real,
                      (    forth6809.asm):02446         ; not assumed from the name.
                      (    forth6809.asm):02447         ; ------------------------------------------------------------
C1A8                  (    forth6809.asm):02448         TSTRFETCH: STU  TSTU0
                      (    forth6809.asm):02449         
                      (    forth6809.asm):02450                    LDD  #TSTGUARD
                      (    forth6809.asm):02451                    PSHU D
                      (    forth6809.asm):02452                    LDD  #TSTVAL1
                      (    forth6809.asm):02453                    PSHU D
                      (    forth6809.asm):02454                    STU  TSTUB4

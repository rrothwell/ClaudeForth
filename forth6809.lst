                      (    forth6809.asm):02266         ; output happens to be queued, since the ACIA has no control
                      (    forth6809.asm):02267         ; byte combination offering RTS-high with TX-interrupt-enabled
                      (    forth6809.asm):02268         ; simultaneously (see CR_RTSHI's comment).
                      (    forth6809.asm):02269         ; ------------------------------------------------------------

                      (    forth6809.asm):03958         ; DO  ( C: -- dest )
                      (    forth6809.asm):03959         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):03960         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):03961         ; ------------------------------------------------------------
E6B4 CCE6C6           (    forth6809.asm):03962         DOW:        LDD   #DOSETUP
E6B7 3606             (    forth6809.asm):03963                     PSHU  D
E6B9 BDE931           (    forth6809.asm):03964                     JSR   CCALL
E6BC DC08             (    forth6809.asm):03965                     LDD   CODEHERE
E6BE 3606             (    forth6809.asm):03966                     PSHU  D                 ; dest
E6C0 CC0003           (    forth6809.asm):03967                     LDD   #TAGDO
E6C3 3606             (    forth6809.asm):03968                     PSHU  D
E6C5 39               (    forth6809.asm):03969                     RTS
                      (    forth6809.asm):03970         
                      (    forth6809.asm):03971         ; ------------------------------------------------------------
                      (    forth6809.asm):03972         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):03973         ; return address.
                      (    forth6809.asm):03974         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):03975         ;    Inputs:
                      (    forth6809.asm):03976         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):03977         ;    Outputs:
                      (    forth6809.asm):03978         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):03979         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):03980         ; ------------------------------------------------------------
E6C6 3706             (    forth6809.asm):03981         DOSETUP:    PULU  D                 ; index
E6C8 DD14             (    forth6809.asm):03982                     STD   MSCR
E6CA 3706             (    forth6809.asm):03983                     PULU  D                 ; limit
E6CC DD16             (    forth6809.asm):03984                     STD   MSCR2
E6CE 3510             (    forth6809.asm):03985                     PULS  X
E6D0 CC0000           (    forth6809.asm):03986                     LDD   #0
E6D3 3406             (    forth6809.asm):03987                     PSHS  D
E6D5 DC16             (    forth6809.asm):03988                     LDD   MSCR2
E6D7 3406             (    forth6809.asm):03989                     PSHS  D
E6D9 DC14             (    forth6809.asm):03990                     LDD   MSCR
E6DB 3406             (    forth6809.asm):03991                     PSHS  D
E6DD 3410             (    forth6809.asm):03992                     PSHS  X
E6DF 39               (    forth6809.asm):03993                     RTS
                      (    forth6809.asm):03994         
                      (    forth6809.asm):03995         ; ------------------------------------------------------------
                      (    forth6809.asm):03996         ; I  ( -- n )
                      (    forth6809.asm):03997         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):03998         ; address).
                      (    forth6809.asm):03999         ; ------------------------------------------------------------
E6E0 EC62             (    forth6809.asm):04000         IW:         LDD   2,S               ; n. See bugfix: IW.1
E6E2 3606             (    forth6809.asm):04001                     PSHU  D
E6E4 39               (    forth6809.asm):04002                     RTS
                      (    forth6809.asm):04003         
                      (    forth6809.asm):04004         ; ------------------------------------------------------------
                      (    forth6809.asm):04005         ; J  ( -- n )
                      (    forth6809.asm):04006         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04007         ; address and the inner loop frame).
                      (    forth6809.asm):04008         ; ------------------------------------------------------------
E6E5 EC68             (    forth6809.asm):04009         JW:         LDD   8,S               ; n. See bugfix: JW.1
E6E7 3606             (    forth6809.asm):04010                     PSHU  D
E6E9 39               (    forth6809.asm):04011                     RTS
                      (    forth6809.asm):04012         
                      (    forth6809.asm):04013         ; ------------------------------------------------------------
                      (    forth6809.asm):04014         ; LEAVE  ( -- )
                      (    forth6809.asm):04015         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):04016         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):04017         ; ------------------------------------------------------------
E6EA CCFFFF           (    forth6809.asm):04018         LEAVEW:     LDD   #TRUEV            ; true
E6ED ED66             (    forth6809.asm):04019                     STD   6,S               ; See bugfix: LEAVEW.1
E6EF 39               (    forth6809.asm):04020                     RTS
                      (    forth6809.asm):04021         
                      (    forth6809.asm):04022         ; ------------------------------------------------------------
                      (    forth6809.asm):04023         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):04024         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):04025         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04026         ; ------------------------------------------------------------
E6F0 3706             (    forth6809.asm):04027         LOOPW:      PULU  D
E6F2 10830003         (    forth6809.asm):04028                     CMPD  #TAGDO
E6F6 2703             (    forth6809.asm):04029                     BEQ   LOOPOK
E6F8 BDE4C1           (    forth6809.asm):04030                     JSR   CFERR
E6FB 3706             (    forth6809.asm):04031         LOOPOK:     PULU  D                 ; dest
E6FD 3606             (    forth6809.asm):04032                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
E6FF CCE72F           (    forth6809.asm):04033                     LDD   #DOTEST
E702 3606             (    forth6809.asm):04034                     PSHU  D
E704 BDE931           (    forth6809.asm):04035                     JSR   CCALL
E707 CC0000           (    forth6809.asm):04036                     LDD   #0
E70A 3606             (    forth6809.asm):04037                     PSHU  D
E70C BDDE76           (    forth6809.asm):04038                     JSR   CODECOMMA
E70F DC08             (    forth6809.asm):04039                     LDD   CODEHERE
E711 830002           (    forth6809.asm):04040                     SUBD  #2
E714 3606             (    forth6809.asm):04041                     PSHU  D                 ; location; the parked dest is beneath
E716 BDE52B           (    forth6809.asm):04042                     JSR   PATCH
                      (    forth6809.asm):04043         
E719 ECC4             (    forth6809.asm):04044                     LDD   ,U
E71B 10830007         (    forth6809.asm):04045                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
E71F 260D             (    forth6809.asm):04046                     BNE   LOOPDONE
E721 3706             (    forth6809.asm):04047                     PULU  D
E723 3710             (    forth6809.asm):04048                     PULU  X                 ; ?DO skip operand
E725 DC08             (    forth6809.asm):04049                     LDD   CODEHERE
E727 3606             (    forth6809.asm):04050                     PSHU  D
E729 3610             (    forth6809.asm):04051                     PSHU  X
E72B BDE52B           (    forth6809.asm):04052                     JSR   PATCH
E72E 39               (    forth6809.asm):04053         LOOPDONE:   RTS
                      (    forth6809.asm):04054         
                      (    forth6809.asm):04055         ; ------------------------------------------------------------
                      (    forth6809.asm):04056         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04057         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04058         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04059         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04060         ; DOTEST
                      (    forth6809.asm):04061         ;    Inputs:
                      (    forth6809.asm):04062         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04063         ;        first)
                      (    forth6809.asm):04064         ;    Outputs:
                      (    forth6809.asm):04065         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04066         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04067         ; ------------------------------------------------------------
E72F EC66             (    forth6809.asm):04068         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E731 2615             (    forth6809.asm):04069                     BNE   DTEXIT            ; set: exit
E733 EC62             (    forth6809.asm):04070                     LDD   2,S               ; index
E735 C30001           (    forth6809.asm):04071                     ADDD  #1
E738 ED62             (    forth6809.asm):04072                     STD   2,S
E73A 10A364           (    forth6809.asm):04073                     CMPD  4,S               ; limit
E73D 2709             (    forth6809.asm):04074                     BEQ   DTEXIT
E73F 3510             (    forth6809.asm):04075                     PULS  X                 ; X = branch operand address
E741 EC84             (    forth6809.asm):04076                     LDD   ,X
E743 308B             (    forth6809.asm):04077                     LEAX  D,X
E745 3410             (    forth6809.asm):04078                     PSHS  X                 ; return to loop start
E747 39               (    forth6809.asm):04079                     RTS
E748 3510             (    forth6809.asm):04080         DTEXIT:     PULS  X
E74A 3002             (    forth6809.asm):04081                     LEAX  2,X               ; skip the branch operand
E74C 3266             (    forth6809.asm):04082                     LEAS  6,S               ; discard the loop frame
E74E 3410             (    forth6809.asm):04083                     PSHS  X
E750 39               (    forth6809.asm):04084                     RTS
                      (    forth6809.asm):04085         
                      (    forth6809.asm):04086         ; ------------------------------------------------------------
                      (    forth6809.asm):04087         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):04088         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):04089         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):04090         ; ------------------------------------------------------------
E751 3706             (    forth6809.asm):04091         PLUSLOOPW:  PULU  D
E753 10830003         (    forth6809.asm):04092                     CMPD  #TAGDO
E757 2703             (    forth6809.asm):04093                     BEQ   PLOOPOK
E759 BDE4C1           (    forth6809.asm):04094                     JSR   CFERR
E75C 3706             (    forth6809.asm):04095         PLOOPOK:    PULU  D                 ; dest
E75E 3606             (    forth6809.asm):04096                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
E760 CCE790           (    forth6809.asm):04097                     LDD   #DOPLUSTEST
E763 3606             (    forth6809.asm):04098                     PSHU  D
E765 BDE931           (    forth6809.asm):04099                     JSR   CCALL
E768 CC0000           (    forth6809.asm):04100                     LDD   #0
E76B 3606             (    forth6809.asm):04101                     PSHU  D
E76D BDDE76           (    forth6809.asm):04102                     JSR   CODECOMMA
E770 DC08             (    forth6809.asm):04103                     LDD   CODEHERE
E772 830002           (    forth6809.asm):04104                     SUBD  #2
E775 3606             (    forth6809.asm):04105                     PSHU  D                 ; location; the parked dest is beneath

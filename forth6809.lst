E49C 2760             (    forth6809.asm):03188                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):03189         
E49E 6F62             (    forth6809.asm):03190         NQNOSIGN:   CLR   2,S
E4A0 A684             (    forth6809.asm):03191                     LDA   ,X

                      (    forth6809.asm):06242                  PSHU  D
                      (    forth6809.asm):06243                  JSR   CCOMMA
                      (    forth6809.asm):06244         
                      (    forth6809.asm):06245                  LDD   TSTCSAV
                      (    forth6809.asm):06246                  STD   CODEHERE
                      (    forth6809.asm):06247         
                      (    forth6809.asm):06248                  STU   TSTU0
                      (    forth6809.asm):06249         
                      (    forth6809.asm):06250                  LDD   #TSTGUARD
                      (    forth6809.asm):06251                  PSHU  D
                      (    forth6809.asm):06252                  LDD   #TRUEV
                      (    forth6809.asm):06253                  PSHU  D
                      (    forth6809.asm):06254                  STU   TSTUB4
                      (    forth6809.asm):06255         

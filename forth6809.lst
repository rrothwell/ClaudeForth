                      (    forth6809.asm):01845         ; H_ABORT and H_QUIT are hand-built, not produced by the same
                      (    forth6809.asm):01846         ; generation pass as the 217 entries above - ABORT and QUIT need
                      (    forth6809.asm):01847         ; to be findable at the prompt, but HEADER/CREATE couldn't be used
                      (    forth6809.asm):01848         ; directly for these two (see the source conversation this file
                      (    forth6809.asm):01849         ; was derived from for why). Moved here from their own separate
                      (    forth6809.asm):01850         ; section so every header in this ROM lives in one contiguous
                      (    forth6809.asm):01851         ; block, with the chain visible end to end: H_M2 -> H_2 -> H_M1 ->
                      (    forth6809.asm):01852         ; H_1 -> H_FIND -> H_QUIT -> H_ABORT -> H_FALSE (the newest of the
                      (    forth6809.asm):01853         ; 217 generated entries) -> ... -> H_KEY -> 0. H_M2 is now the true
                      (    forth6809.asm):01854         ; head (see BASELATEST below) - H_FIND and the four number words
                      (    forth6809.asm):01855         ; were chained on after H_QUIT in a later turn.
DFB4 05               (    forth6809.asm):01856         H_ABORT: FCB   5
DFB5 41424F5254       (    forth6809.asm):01857                  FCC   "ABORT"
DFBA DFAA             (    forth6809.asm):01858                  FDB   H_FALSE        ; resolved - was placeholder 0, then H_DUMPW,
                      (    forth6809.asm):01859                                        ; then H_DOESGT, then H_DUMPW again once
                      (    forth6809.asm):01860                                        ; DOES> moved out of the chain's newest slot;
                      (    forth6809.asm):01861                                        ; now H_FALSE, the chain's newest entry
DFBC E037             (    forth6809.asm):01862                  FDB   ABORT
                      (    forth6809.asm):01863         

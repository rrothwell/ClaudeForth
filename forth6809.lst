                      (    forth6809.asm):02019         ; ============================================================
                      (    forth6809.asm):02020         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02021         ; ============================================================
                      (    forth6809.asm):02022         ; ------------------------------------------------------------
                      (    forth6809.asm):02023         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02024         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02025         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02026         ; COLD
                      (    forth6809.asm):02027         ;    Inputs:
                      (    forth6809.asm):02028         ;        none (entered at reset)
                      (    forth6809.asm):02029         ;    Outputs:
                      (    forth6809.asm):02030         ;        none (does not return)
                      (    forth6809.asm):02031         ;    Registers: all changed.
                      (    forth6809.asm):02032         ; ------------------------------------------------------------
DDB0 CC0240           (    forth6809.asm):02033         COLD:       LDD   #APPVARS

                      (    forth6809.asm):03957         ;    Outputs:
                      (    forth6809.asm):03958         ;        ORDER(0) = WID; ORDEND at least ORDER+2
                      (    forth6809.asm):03959         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03960         ; ------------------------------------------------------------
DB76 9F4B             (    forth6809.asm):03961         SETTOP:     STX   ORDER
DB78 DC49             (    forth6809.asm):03962                     LDD   ORDEND

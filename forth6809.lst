                      (    forth6809.asm):05173         ; ------------------------------------------------------------
                      (    forth6809.asm):05174         ; MOD  ( n1 n2 -- n3 )
                      (    forth6809.asm):05175         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):05176         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):05177         ; zero.
                      (    forth6809.asm):05178         ; ------------------------------------------------------------

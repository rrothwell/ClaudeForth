                      (    forth6809.asm):02694                    JSR   TSTMIN1
                      (    forth6809.asm):02695                    JSR   TSTMIN2
                      (    forth6809.asm):02696                    JSR   TSTMAX1
                      (    forth6809.asm):02697                    JSR   TSTMAX2
                      (    forth6809.asm):02698                    JSR   TSTONEP
                      (    forth6809.asm):02699                    JSR   TSTONEM
                      (    forth6809.asm):02700                    JSR   TSTTWOP
                      (    forth6809.asm):02701                    JSR   TSTTWOS
                      (    forth6809.asm):02702                    JSR   TSTTWOD1
                      (    forth6809.asm):02703                    JSR   TSTTWOD2

                      (    forth6809.asm):06108         ; ============================================================
                      (    forth6809.asm):06109         ; SECTION 26: TRUE / FALSE. This section used to also hold
                      (    forth6809.asm):06110         ; ABORT/QUIT's hand-built dictionary headers (ABORTHDR/QUITHDR) -
                      (    forth6809.asm):06111         ; moved into BASEDICT and renamed to H_ABORT/H_QUIT (see the end
                      (    forth6809.asm):06112         ; of SECTION 27) so every header in this ROM lives in one
                      (    forth6809.asm):06113         ; contiguous block, rather than header data sitting apart from
                      (    forth6809.asm):06114         ; the rest of the dictionary inside BASECODE.
                      (    forth6809.asm):06115         ; ============================================================
                      (    forth6809.asm):06116         ; ------------------------------------------------------------
                      (    forth6809.asm):06117         ; TRUE / FALSE - simple subroutines, not the CONSTANT/DODOES
                      (    forth6809.asm):06118         ; pattern these used before (JSR DODOES + FDB ATSIGN + a value
                      (    forth6809.asm):06119         ; cell, matching what interactive CONSTANT compiles). Each is now
                      (    forth6809.asm):06120         ; a direct LDD/PSHU/RTS, like every other ordinary ROM word's CFA
                      (    forth6809.asm):06121         ; - no indirection, no value cell.
                      (    forth6809.asm):06122         ;
                      (    forth6809.asm):06123         ; RESOLVED: the previous version of this code deliberately inverted
                      (    forth6809.asm):06124         ; TRUE/FALSE's values from the system's own convention, per an
                      (    forth6809.asm):06125         ; earlier explicit request - FALSE pushed $FFFF and TRUE pushed
                      (    forth6809.asm):06126         ; $0000, disagreeing with TRUEV/FALSEV ($FFFF/$0000) and every
                      (    forth6809.asm):06127         ; comparison operator (=, <, >, and the rest), which all still
                      (    forth6809.asm):06128         ; returned TRUEV for a true result and FALSEV for false. Restored
                      (    forth6809.asm):06129         ; to the standard convention now: TRUE pushes $FFFF, FALSE pushes
                      (    forth6809.asm):06130         ; $0000, matching TRUEV/FALSEV and every comparison operator again.
                      (    forth6809.asm):06131         ; Each is a direct LDD/PSHU/RTS, like every other ordinary ROM
                      (    forth6809.asm):06132         ; word's CFA - no indirection, no value cell, no DODOES trampoline.
                      (    forth6809.asm):06133         ; ------------------------------------------------------------
FF05 CCFFFF           (    forth6809.asm):06134         TRUEBODY:  LDD   #$FFFF
FF08 3606             (    forth6809.asm):06135                    PSHU  D
FF0A 39               (    forth6809.asm):06136                    RTS
                      (    forth6809.asm):06137         
FF0B CC0000           (    forth6809.asm):06138         FALSEBODY: LDD   #$0000
FF0E 3606             (    forth6809.asm):06139                    PSHU  D
FF10 39               (    forth6809.asm):06140                    RTS
                      (    forth6809.asm):06141         
                      (    forth6809.asm):06142         ; ------------------------------------------------------------
                      (    forth6809.asm):06143         ; 1 / -1 / 2 / -2 - simple immediate-value words, same pattern as
                      (    forth6809.asm):06144         ; TRUE/FALSE above: direct LDD/PSHU/RTS, no indirection, no value
                      (    forth6809.asm):06145         ; cell. Headers are H_1/H_M1/H_2/H_M2 (SECTION 27, chained after
                      (    forth6809.asm):06146         ; H_FIND) - "1"/"-1"/"2"/"-2" aren't valid 6809 assembler labels.
                      (    forth6809.asm):06147         ; ------------------------------------------------------------
FF11 CC0001           (    forth6809.asm):06148         ONEBODY:   LDD   #1
FF14 3606             (    forth6809.asm):06149                    PSHU  D
FF16 39               (    forth6809.asm):06150                    RTS
                      (    forth6809.asm):06151         
FF17 CCFFFF           (    forth6809.asm):06152         MONEBODY:  LDD   #-1
FF1A 3606             (    forth6809.asm):06153                    PSHU  D
FF1C 39               (    forth6809.asm):06154                    RTS
                      (    forth6809.asm):06155         
FF1D CC0002           (    forth6809.asm):06156         TWOBODY:   LDD   #2
FF20 3606             (    forth6809.asm):06157                    PSHU  D
FF22 39               (    forth6809.asm):06158                    RTS
                      (    forth6809.asm):06159         
FF23 CCFFFE           (    forth6809.asm):06160         MTWOBODY:  LDD   #-2
FF26 3606             (    forth6809.asm):06161                    PSHU  D
FF28 39               (    forth6809.asm):06162                    RTS
                      (    forth6809.asm):06163         
                      (    forth6809.asm):06164         ; Verify no collision with init code,
                      (    forth6809.asm):06165         ; value should match ORG INITCODE.
     FF29             (    forth6809.asm):06166         BASECODEEND  EQU   *
     1EFF             (    forth6809.asm):06167         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):06168         
                      (    forth6809.asm):06169         ; Prevent the assembler from extinguishing the gap between the
                      (    forth6809.asm):06170         ; BASECODE block and the INITCODE block when it generates the
                      (    forth6809.asm):06171         ; .bin file.
FF29                  (    forth6809.asm):06172         BASEND:
FF29 FFFFFFFFFFFFFFFF (    forth6809.asm):06173                  FILL $FF,INITCODE-BASEND

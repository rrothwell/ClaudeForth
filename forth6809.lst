                      (    forth6809.asm):07541         ; TSTCASE2 - unit test for CASE/OF/ENDOF/ENDCASE, no-match
                      (    forth6809.asm):07542         ; case. Same compiled snippet as TSTCASE1, run with a selector
                      (    forth6809.asm):07543         ; (99) matching neither clause - should fall through both OF
                      (    forth6809.asm):07544         ; checks (selector preserved across each non-match, per the
                      (    forth6809.asm):07545         ; documented "( x n -- | x )" effect) and reach ENDCASE's own
                      (    forth6809.asm):07546         ; fallback DROP, consuming the selector with nothing pushed in
                      (    forth6809.asm):07547         ; its place.
                      (    forth6809.asm):07548         ; ------------------------------------------------------------
C23C                  (    forth6809.asm):07549         TSTCASE2: LDD  CODEHERE
                      (    forth6809.asm):07550                   STD  TSTCSAV
                      (    forth6809.asm):07551                   LDD  #TSTCBUF
                      (    forth6809.asm):07552                   STD  CODEHERE
                      (    forth6809.asm):07553         

                      (    forth6809.asm):16836                  SUBA  INTAIL
                      (    forth6809.asm):16837                  ANDA  #INBUFSZ-1
                      (    forth6809.asm):16838                  RTS
                      (    forth6809.asm):16839         
                      (    forth6809.asm):16840         ; ------------------------------------------------------------
                      (    forth6809.asm):16841         ; RTSCHECKHI - called from IRQH's own RX path (interrupts
                      (    forth6809.asm):16842         ; already masked by hardware during ISR execution, so no
                      (    forth6809.asm):16843         ; explicit masking needed here). If the input ring has reached
                      (    forth6809.asm):16844         ; INHIWATER and RTS is not already asserted high, assert it -
                      (    forth6809.asm):16845         ; telling the remote device to pause sending. Per the 6850, RTS
                      (    forth6809.asm):16846         ; has no automatic tie to reception; this is ordinary firmware

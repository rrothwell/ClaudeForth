                      (    forth6809.asm):06993         ; COMPARE  ( c-addr1 u1 c-addr2 u2 -- n )
                      (    forth6809.asm):06994         ; Compare two strings byte by byte. n is -1, 0 or 1 as the first
                      (    forth6809.asm):06995         ; string is less than, equal to or greater than the second; if one is
                      (    forth6809.asm):06996         ; a prefix of the other, the shorter is less.

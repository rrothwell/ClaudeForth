                      (    forth6809.asm):02310                    PSHU  D
                      (    forth6809.asm):02311                    LDD   #TSTVAL1
                      (    forth6809.asm):02312                    PSHU  D
                      (    forth6809.asm):02313                    LDD   #TSTVAL2
                      (    forth6809.asm):02314                    PSHU  D
                      (    forth6809.asm):02315                    LDD   #TSTVAL3
                      (    forth6809.asm):02316                    PSHU  D
                      (    forth6809.asm):02317                    LDD   #TSTVAL4
                      (    forth6809.asm):02318                    PSHU  D
                      (    forth6809.asm):02319                    LDD   #TSTVAL5
                      (    forth6809.asm):02320                    PSHU  D
                      (    forth6809.asm):02321                    LDD   #TSTVAL6
                      (    forth6809.asm):02322                    PSHU  D
                      (    forth6809.asm):02323                    STU   TSTUB4
                      (    forth6809.asm):02324         

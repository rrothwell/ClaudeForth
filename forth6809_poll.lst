EA10 EDC4             (    forth6809.asm):05458                     STD   ,U
EA12 39               (    forth6809.asm):05459         ROLLDONE:   RTS
                      (    forth6809.asm):05460         
                      (    forth6809.asm):05461         ; ------------------------------------------------------------
                      (    forth6809.asm):05462         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05463         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05464         ; while the others move.
                      (    forth6809.asm):05465         ; ------------------------------------------------------------
EA13 AE4A             (    forth6809.asm):05466         DROTW:      LDX   10,U              ; x1
EA15 10AE48           (    forth6809.asm):05467                     LDY   8,U               ; x2
EA18 EC46             (    forth6809.asm):05468                     LDD   6,U
EA1A ED4A             (    forth6809.asm):05469                     STD   10,U
EA1C EC44             (    forth6809.asm):05470                     LDD   4,U
EA1E ED48             (    forth6809.asm):05471                     STD   8,U

                      (    forth6809.asm):11073         
FFCF BDD7BA           (    forth6809.asm):11074                     JSR   IOVINIT           ; EMIT, KEY, KEY? use the ACIA
FFD2 BDCDAF           (    forth6809.asm):11075                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):11076         
FFD5 8EFFE7           (    forth6809.asm):11077                     LDX   #WARMMSG
FFD8 3610             (    forth6809.asm):11078                     PSHU  X
FFDA CC0006           (    forth6809.asm):11079                     LDD   #WARMMSGL
FFDD 3606             (    forth6809.asm):11080                     PSHU  D

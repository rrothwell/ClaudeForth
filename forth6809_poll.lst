                      (    forth6809.asm):05920         
                      (    forth6809.asm):05921         ; ------------------------------------------------------------
                      (    forth6809.asm):05922         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05923         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05924         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05925         ; the transfer.
                      (    forth6809.asm):05926         ; ------------------------------------------------------------
DEAE 3706             (    forth6809.asm):05927         TORW:       PULU  D                 ; x
DEB0 3510             (    forth6809.asm):05928                     PULS  X
DEB2 3406             (    forth6809.asm):05929                     PSHS  D
DEB4 3410             (    forth6809.asm):05930                     PSHS  X
DEB6 39               (    forth6809.asm):05931                     RTS
                      (    forth6809.asm):05932         
                      (    forth6809.asm):05933         ; ------------------------------------------------------------
                      (    forth6809.asm):05934         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05935         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05936         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05937         ; the transfer.
                      (    forth6809.asm):05938         ; ------------------------------------------------------------
DEB7 3510             (    forth6809.asm):05939         FROMRW:     PULS  X
DEB9 3506             (    forth6809.asm):05940                     PULS  D                 ; x

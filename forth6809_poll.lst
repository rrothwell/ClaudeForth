                      (    forth6809.asm):04706         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04707         ; ============================================================
                      (    forth6809.asm):04708         ; ------------------------------------------------------------
                      (    forth6809.asm):04709         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04710         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04711         ; one expected.
                      (    forth6809.asm):04712         ; CFERR
                      (    forth6809.asm):04713         ;    Inputs:
                      (    forth6809.asm):04714         ;        none
                      (    forth6809.asm):04715         ;    Outputs:
                      (    forth6809.asm):04716         ;        does not return (THROW -22)
                      (    forth6809.asm):04717         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04718         ; ------------------------------------------------------------
D8D0 CCFFEA           (    forth6809.asm):04719         CFERR:      LDD   #-22
D8D3 3606             (    forth6809.asm):04720                     PSHU  D                 ; -22
D8D5 BDD905           (    forth6809.asm):04721                     JSR   THROWW
D8D8 39               (    forth6809.asm):04722                     RTS
                      (    forth6809.asm):04723         
                      (    forth6809.asm):04724         ; ------------------------------------------------------------
                      (    forth6809.asm):04725         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04726         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04727         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04728         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04729         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04730         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04731         ; ------------------------------------------------------------
D8D9 3710             (    forth6809.asm):04732         CATCHW:     PULU  X                 ; xt
D8DB DC0C             (    forth6809.asm):04733                     LDD   HANDLER
D8DD 3406             (    forth6809.asm):04734                     PSHS  D
D8DF 3440             (    forth6809.asm):04735                     PSHS  U
                      (    forth6809.asm):04736                     ; Save the input source specification.
                      (    forth6809.asm):04737                     ; See bugfix: CATCHW.1
D8E1 DC39             (    forth6809.asm):04738                     LDD   SRCADDR
D8E3 3406             (    forth6809.asm):04739                     PSHS  D
D8E5 DC3B             (    forth6809.asm):04740                     LDD   SRCLEN
D8E7 3406             (    forth6809.asm):04741                     PSHS  D
D8E9 DC3D             (    forth6809.asm):04742                     LDD   SRCID

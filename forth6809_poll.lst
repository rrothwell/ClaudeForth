                      (    forth6809.asm):04302         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):04303         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):04304         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):04305         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):04306         ; DOTEST
                      (    forth6809.asm):04307         ;    Inputs:
                      (    forth6809.asm):04308         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):04309         ;        first)
                      (    forth6809.asm):04310         ;    Outputs:
                      (    forth6809.asm):04311         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):04312         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04313         ; ------------------------------------------------------------
E65B EC66             (    forth6809.asm):04314         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
E65D 2615             (    forth6809.asm):04315                     BNE   DTEXIT            ; set: exit
E65F EC62             (    forth6809.asm):04316                     LDD   2,S               ; index

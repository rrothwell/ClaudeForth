DA3A 3040             (    forth6809.asm):04969                     LEAX  0,U               ; scan from top of control stack
DA3C 9F16             (    forth6809.asm):04970                     STX   MSCR2             ; MSCR2 = base of scan region
DA3E 9F1A             (    forth6809.asm):04971                     STX   MSCR4             ; MSCR4 = scan pointer
DA40 DC1A             (    forth6809.asm):04972         RPSCAN:     LDD   MSCR4
DA42 109321           (    forth6809.asm):04973                     CMPD  CSP
DA45 2603             (    forth6809.asm):04974                     BNE   RPSCANOK
DA47 BDD8D0           (    forth6809.asm):04975                     JSR   CFERR             ; no matching BEGIN
DA4A 9E1A             (    forth6809.asm):04976         RPSCANOK:   LDX   MSCR4
DA4C EC84             (    forth6809.asm):04977                     LDD   ,X
DA4E 10830002         (    forth6809.asm):04978                     CMPD  #TAGBACK
DA52 2712             (    forth6809.asm):04979                     BEQ   RPFOUND
DA54 10830001         (    forth6809.asm):04980                     CMPD  #TAGFWD
DA58 2703             (    forth6809.asm):04981                     BEQ   RPSKIP
DA5A BDD8D0           (    forth6809.asm):04982                     JSR   CFERR             ; anything else is a genuine mismatch
DA5D DC1A             (    forth6809.asm):04983         RPSKIP:     LDD   MSCR4
DA5F C30004           (    forth6809.asm):04984                     ADDD  #4
DA62 DD1A             (    forth6809.asm):04985                     STD   MSCR4
DA64 20DA             (    forth6809.asm):04986                     BRA   RPSCAN
DA66 9E1A             (    forth6809.asm):04987         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
DA68 EC02             (    forth6809.asm):04988                     LDD   2,X               ; dest = BEGIN's address
DA6A 3406             (    forth6809.asm):04989                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04990         
                      (    forth6809.asm):04991                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04992                     ; bytes, highest word first.
DA6C DC1A             (    forth6809.asm):04993                     LDD   MSCR4
DA6E 9316             (    forth6809.asm):04994                     SUBD  MSCR2
DA70 DD18             (    forth6809.asm):04995                     STD   MSCR3             ; MSCR3 = bytes to shift
DA72 2715             (    forth6809.asm):04996                     BEQ   RPSHIFTDONE
DA74 DC18             (    forth6809.asm):04997         RPSHIFT:    LDD   MSCR3
DA76 830002           (    forth6809.asm):04998                     SUBD  #2
DA79 DD18             (    forth6809.asm):04999                     STD   MSCR3
DA7B 9E16             (    forth6809.asm):05000                     LDX   MSCR2
DA7D 308B             (    forth6809.asm):05001                     LEAX  D,X               ; X = MSCR2 + this pass's offset
DA7F EC84             (    forth6809.asm):05002                     LDD   ,X
DA81 3004             (    forth6809.asm):05003                     LEAX  4,X
DA83 ED84             (    forth6809.asm):05004                     STD   ,X                ; copy one word 4 bytes higher
DA85 DC18             (    forth6809.asm):05005                     LDD   MSCR3
DA87 26EB             (    forth6809.asm):05006                     BNE   RPSHIFT
DA89                  (    forth6809.asm):05007         RPSHIFTDONE:
DA89 9E16             (    forth6809.asm):05008                     LDX   MSCR2
DA8B 3004             (    forth6809.asm):05009                     LEAX  4,X
DA8D 1F13             (    forth6809.asm):05010                     TFR   X,U               ; U now excludes BEGIN frame
                      (    forth6809.asm):05011         
DA8F CCCF4F           (    forth6809.asm):05012                     LDD   #BRANCH
DA92 3606             (    forth6809.asm):05013                     PSHU  D
DA94 BDDD40           (    forth6809.asm):05014                     JSR   CCALL
DA97 CC0000           (    forth6809.asm):05015                     LDD   #0
DA9A 3606             (    forth6809.asm):05016                     PSHU  D
DA9C BDCFD6           (    forth6809.asm):05017                     JSR   CODECOMMA
DA9F EC60             (    forth6809.asm):05018                     LDD   0,S               ; target = BEGIN's address
DAA1 3606             (    forth6809.asm):05019                     PSHU  D
DAA3 DC08             (    forth6809.asm):05020                     LDD   CODEHERE
DAA5 830002           (    forth6809.asm):05021                     SUBD  #2                ; location = the operand just compiled
DAA8 3606             (    forth6809.asm):05022                     PSHU  D
DAAA BDD93A           (    forth6809.asm):05023                     JSR   PATCH
DAAD DC08             (    forth6809.asm):05024                     LDD   CODEHERE
DAAF 3606             (    forth6809.asm):05025                     PSHU  D
DAB1 EC62             (    forth6809.asm):05026                     LDD   2,S               ; orig
DAB3 3606             (    forth6809.asm):05027                     PSHU  D
DAB5 BDD93A           (    forth6809.asm):05028                     JSR   PATCH
DAB8 3264             (    forth6809.asm):05029                     LEAS  4,S               ; drop the frame
DABA 39               (    forth6809.asm):05030                     RTS
                      (    forth6809.asm):05031         
                      (    forth6809.asm):05032         ; ------------------------------------------------------------
                      (    forth6809.asm):05033         ; RECURSE  ( -- )
                      (    forth6809.asm):05034         ; Compile a call to the word being defined (named or :NONAME), using
                      (    forth6809.asm):05035         ; the xt held in CURXT.
                      (    forth6809.asm):05036         ; ------------------------------------------------------------
DABB DC1F             (    forth6809.asm):05037         RECURSEW:   LDD   CURXT             ; xt of word being compiled
DABD 3606             (    forth6809.asm):05038                     PSHU  D                 ; See bugfix: RECURSEW.1
DABF BDDD40           (    forth6809.asm):05039                     JSR   CCALL
DAC2 39               (    forth6809.asm):05040                     RTS
                      (    forth6809.asm):05041         
                      (    forth6809.asm):05042         ; ------------------------------------------------------------
                      (    forth6809.asm):05043         ; DO  ( C: -- dest )
                      (    forth6809.asm):05044         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):05045         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):05046         ; ------------------------------------------------------------
DAC3 CCDAD5           (    forth6809.asm):05047         DOW:        LDD   #DOSETUP
DAC6 3606             (    forth6809.asm):05048                     PSHU  D
DAC8 BDDD40           (    forth6809.asm):05049                     JSR   CCALL
DACB DC08             (    forth6809.asm):05050                     LDD   CODEHERE
DACD 3606             (    forth6809.asm):05051                     PSHU  D                 ; dest
DACF CC0003           (    forth6809.asm):05052                     LDD   #TAGDO
DAD2 3606             (    forth6809.asm):05053                     PSHU  D
DAD4 39               (    forth6809.asm):05054                     RTS
                      (    forth6809.asm):05055         
                      (    forth6809.asm):05056         ; ------------------------------------------------------------
                      (    forth6809.asm):05057         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):05058         ; return address.
                      (    forth6809.asm):05059         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):05060         ;    Inputs:
                      (    forth6809.asm):05061         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05062         ;    Outputs:
                      (    forth6809.asm):05063         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):05064         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05065         ; ------------------------------------------------------------
DAD5 3706             (    forth6809.asm):05066         DOSETUP:    PULU  D                 ; index
DAD7 DD14             (    forth6809.asm):05067                     STD   MSCR
DAD9 3706             (    forth6809.asm):05068                     PULU  D                 ; limit
DADB DD16             (    forth6809.asm):05069                     STD   MSCR2
DADD 3510             (    forth6809.asm):05070                     PULS  X
DADF CC0000           (    forth6809.asm):05071                     LDD   #0
DAE2 3406             (    forth6809.asm):05072                     PSHS  D
DAE4 DC16             (    forth6809.asm):05073                     LDD   MSCR2
DAE6 3406             (    forth6809.asm):05074                     PSHS  D
DAE8 DC14             (    forth6809.asm):05075                     LDD   MSCR
DAEA 3406             (    forth6809.asm):05076                     PSHS  D
DAEC 3410             (    forth6809.asm):05077                     PSHS  X
DAEE 39               (    forth6809.asm):05078                     RTS
                      (    forth6809.asm):05079         
                      (    forth6809.asm):05080         ; ------------------------------------------------------------
                      (    forth6809.asm):05081         ; I  ( -- n )
                      (    forth6809.asm):05082         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):05083         ; address).
                      (    forth6809.asm):05084         ; ------------------------------------------------------------
DAEF EC62             (    forth6809.asm):05085         IW:         LDD   2,S               ; n. See bugfix: IW.1
DAF1 3606             (    forth6809.asm):05086                     PSHU  D
DAF3 39               (    forth6809.asm):05087                     RTS
                      (    forth6809.asm):05088         
                      (    forth6809.asm):05089         ; ------------------------------------------------------------
                      (    forth6809.asm):05090         ; J  ( -- n )
                      (    forth6809.asm):05091         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05092         ; address and the inner loop frame).
                      (    forth6809.asm):05093         ; ------------------------------------------------------------
DAF4 EC68             (    forth6809.asm):05094         JW:         LDD   8,S               ; n. See bugfix: JW.1
DAF6 3606             (    forth6809.asm):05095                     PSHU  D
DAF8 39               (    forth6809.asm):05096                     RTS
                      (    forth6809.asm):05097         
                      (    forth6809.asm):05098         ; ------------------------------------------------------------
                      (    forth6809.asm):05099         ; LEAVE  ( -- )
                      (    forth6809.asm):05100         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05101         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05102         ; ------------------------------------------------------------
DAF9 CCFFFF           (    forth6809.asm):05103         LEAVEW:     LDD   #TRUEV            ; true
DAFC ED66             (    forth6809.asm):05104                     STD   6,S               ; See bugfix: LEAVEW.1
DAFE 39               (    forth6809.asm):05105                     RTS
                      (    forth6809.asm):05106         
                      (    forth6809.asm):05107         ; ------------------------------------------------------------
                      (    forth6809.asm):05108         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05109         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05110         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05111         ; ------------------------------------------------------------
DAFF 3706             (    forth6809.asm):05112         LOOPW:      PULU  D
DB01 10830003         (    forth6809.asm):05113                     CMPD  #TAGDO
DB05 2703             (    forth6809.asm):05114                     BEQ   LOOPOK
DB07 BDD8D0           (    forth6809.asm):05115                     JSR   CFERR
DB0A 3706             (    forth6809.asm):05116         LOOPOK:     PULU  D                 ; dest
DB0C 3606             (    forth6809.asm):05117                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DB0E CCDB3E           (    forth6809.asm):05118                     LDD   #DOTEST
DB11 3606             (    forth6809.asm):05119                     PSHU  D
DB13 BDDD40           (    forth6809.asm):05120                     JSR   CCALL
DB16 CC0000           (    forth6809.asm):05121                     LDD   #0
DB19 3606             (    forth6809.asm):05122                     PSHU  D
DB1B BDCFD6           (    forth6809.asm):05123                     JSR   CODECOMMA
DB1E DC08             (    forth6809.asm):05124                     LDD   CODEHERE
DB20 830002           (    forth6809.asm):05125                     SUBD  #2
DB23 3606             (    forth6809.asm):05126                     PSHU  D                 ; location; the parked dest is beneath
DB25 BDD93A           (    forth6809.asm):05127                     JSR   PATCH
                      (    forth6809.asm):05128         
DB28 ECC4             (    forth6809.asm):05129                     LDD   ,U
DB2A 10830007         (    forth6809.asm):05130                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DB2E 260D             (    forth6809.asm):05131                     BNE   LOOPDONE
DB30 3706             (    forth6809.asm):05132                     PULU  D
DB32 3710             (    forth6809.asm):05133                     PULU  X                 ; ?DO skip operand
DB34 DC08             (    forth6809.asm):05134                     LDD   CODEHERE
DB36 3606             (    forth6809.asm):05135                     PSHU  D
DB38 3610             (    forth6809.asm):05136                     PSHU  X
DB3A BDD93A           (    forth6809.asm):05137                     JSR   PATCH
DB3D 39               (    forth6809.asm):05138         LOOPDONE:   RTS
                      (    forth6809.asm):05139         
                      (    forth6809.asm):05140         ; ------------------------------------------------------------
                      (    forth6809.asm):05141         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05142         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05143         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05144         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05145         ; DOTEST
                      (    forth6809.asm):05146         ;    Inputs:
                      (    forth6809.asm):05147         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05148         ;        first)
                      (    forth6809.asm):05149         ;    Outputs:
                      (    forth6809.asm):05150         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05151         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05152         ; ------------------------------------------------------------
DB3E EC66             (    forth6809.asm):05153         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DB40 2615             (    forth6809.asm):05154                     BNE   DTEXIT            ; set: exit
DB42 EC62             (    forth6809.asm):05155                     LDD   2,S               ; index
DB44 C30001           (    forth6809.asm):05156                     ADDD  #1
DB47 ED62             (    forth6809.asm):05157                     STD   2,S
DB49 10A364           (    forth6809.asm):05158                     CMPD  4,S               ; limit
DB4C 2709             (    forth6809.asm):05159                     BEQ   DTEXIT
DB4E 3510             (    forth6809.asm):05160                     PULS  X                 ; X = branch operand address
DB50 EC84             (    forth6809.asm):05161                     LDD   ,X
DB52 308B             (    forth6809.asm):05162                     LEAX  D,X
DB54 3410             (    forth6809.asm):05163                     PSHS  X                 ; return to loop start
DB56 39               (    forth6809.asm):05164                     RTS
DB57 3510             (    forth6809.asm):05165         DTEXIT:     PULS  X
DB59 3002             (    forth6809.asm):05166                     LEAX  2,X               ; skip the branch operand
DB5B 3266             (    forth6809.asm):05167                     LEAS  6,S               ; discard the loop frame
DB5D 3410             (    forth6809.asm):05168                     PSHS  X
DB5F 39               (    forth6809.asm):05169                     RTS
                      (    forth6809.asm):05170         
                      (    forth6809.asm):05171         ; ------------------------------------------------------------
                      (    forth6809.asm):05172         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05173         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05174         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05175         ; ------------------------------------------------------------
DB60 3706             (    forth6809.asm):05176         PLUSLOOPW:  PULU  D
DB62 10830003         (    forth6809.asm):05177                     CMPD  #TAGDO
DB66 2703             (    forth6809.asm):05178                     BEQ   PLOOPOK
DB68 BDD8D0           (    forth6809.asm):05179                     JSR   CFERR
DB6B 3706             (    forth6809.asm):05180         PLOOPOK:    PULU  D                 ; dest
DB6D 3606             (    forth6809.asm):05181                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DB6F CCDB9F           (    forth6809.asm):05182                     LDD   #DOPLUSTEST
DB72 3606             (    forth6809.asm):05183                     PSHU  D
DB74 BDDD40           (    forth6809.asm):05184                     JSR   CCALL
DB77 CC0000           (    forth6809.asm):05185                     LDD   #0
DB7A 3606             (    forth6809.asm):05186                     PSHU  D
DB7C BDCFD6           (    forth6809.asm):05187                     JSR   CODECOMMA
DB7F DC08             (    forth6809.asm):05188                     LDD   CODEHERE
DB81 830002           (    forth6809.asm):05189                     SUBD  #2
DB84 3606             (    forth6809.asm):05190                     PSHU  D                 ; location; the parked dest is beneath
DB86 BDD93A           (    forth6809.asm):05191                     JSR   PATCH
                      (    forth6809.asm):05192         
DB89 ECC4             (    forth6809.asm):05193                     LDD   ,U
DB8B 10830007         (    forth6809.asm):05194                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DB8F 260D             (    forth6809.asm):05195                     BNE   PLOOPDONE
DB91 3706             (    forth6809.asm):05196                     PULU  D
DB93 3710             (    forth6809.asm):05197                     PULU  X                 ; ?DO skip operand
DB95 DC08             (    forth6809.asm):05198                     LDD   CODEHERE
DB97 3606             (    forth6809.asm):05199                     PSHU  D
DB99 3610             (    forth6809.asm):05200                     PSHU  X
DB9B BDD93A           (    forth6809.asm):05201                     JSR   PATCH
DB9E 39               (    forth6809.asm):05202         PLOOPDONE:  RTS
                      (    forth6809.asm):05203         
                      (    forth6809.asm):05204         ; ------------------------------------------------------------
                      (    forth6809.asm):05205         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05206         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05207         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05208         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05209         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05210         ;    Inputs:
                      (    forth6809.asm):05211         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05212         ;    Outputs:
                      (    forth6809.asm):05213         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05214         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05215         ;        scratch.
                      (    forth6809.asm):05216         ; ------------------------------------------------------------
DB9F 3706             (    forth6809.asm):05217         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DBA1 DD14             (    forth6809.asm):05218                     STD   MSCR              ; MSCR = step
DBA3 EC66             (    forth6809.asm):05219                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DBA5 262D             (    forth6809.asm):05220                     BNE   DPTEXIT           ; set: exit
DBA7 EC62             (    forth6809.asm):05221                     LDD   2,S               ; old index
DBA9 A364             (    forth6809.asm):05222                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DBAB DD16             (    forth6809.asm):05223                     STD   MSCR2
DBAD EC62             (    forth6809.asm):05224                     LDD   2,S
DBAF D314             (    forth6809.asm):05225                     ADDD  MSCR              ; new_index = old_index + step
DBB1 ED62             (    forth6809.asm):05226                     STD   2,S
DBB3 A364             (    forth6809.asm):05227                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DBB5 DD18             (    forth6809.asm):05228                     STD   MSCR3
                      (    forth6809.asm):05229                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05230                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05231                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DBB7 DC14             (    forth6809.asm):05232                     LDD   MSCR              ; reload the step to test its sign
DBB9 2B09             (    forth6809.asm):05233                     BMI   DPNEG
DBBB DC18             (    forth6809.asm):05234         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DBBD 109316           (    forth6809.asm):05235                     CMPD  MSCR2
DBC0 2512             (    forth6809.asm):05236                     BLO   DPTEXIT
DBC2 2007             (    forth6809.asm):05237                     BRA   DPCONT
DBC4 DC18             (    forth6809.asm):05238         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DBC6 109316           (    forth6809.asm):05239                     CMPD  MSCR2
DBC9 2209             (    forth6809.asm):05240                     BHI   DPTEXIT
DBCB 3510             (    forth6809.asm):05241         DPCONT:     PULS  X                 ; X = branch operand address
DBCD EC84             (    forth6809.asm):05242                     LDD   ,X
DBCF 308B             (    forth6809.asm):05243                     LEAX  D,X
DBD1 3410             (    forth6809.asm):05244                     PSHS  X
DBD3 39               (    forth6809.asm):05245                     RTS
DBD4 3510             (    forth6809.asm):05246         DPTEXIT:    PULS  X
DBD6 3002             (    forth6809.asm):05247                     LEAX  2,X               ; skip the branch operand
DBD8 3266             (    forth6809.asm):05248                     LEAS  6,S               ; discard the loop frame
DBDA 3410             (    forth6809.asm):05249                     PSHS  X
DBDC 39               (    forth6809.asm):05250                     RTS
                      (    forth6809.asm):05251         
                      (    forth6809.asm):05252         ; ------------------------------------------------------------
                      (    forth6809.asm):05253         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05254         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05255         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05256         ; ------------------------------------------------------------
DBDD CCDC03           (    forth6809.asm):05257         QDOW:       LDD   #QDOSETUP
DBE0 3606             (    forth6809.asm):05258                     PSHU  D
DBE2 BDDD40           (    forth6809.asm):05259                     JSR   CCALL
DBE5 CC0000           (    forth6809.asm):05260                     LDD   #0
DBE8 3606             (    forth6809.asm):05261                     PSHU  D
DBEA BDCFD6           (    forth6809.asm):05262                     JSR   CODECOMMA
DBED DC08             (    forth6809.asm):05263                     LDD   CODEHERE
DBEF 830002           (    forth6809.asm):05264                     SUBD  #2
DBF2 3606             (    forth6809.asm):05265                     PSHU  D                 ; orig
DBF4 CC0007           (    forth6809.asm):05266                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DBF7 3606             (    forth6809.asm):05267                     PSHU  D
DBF9 DC08             (    forth6809.asm):05268                     LDD   CODEHERE
DBFB 3606             (    forth6809.asm):05269                     PSHU  D                 ; dest
DBFD CC0003           (    forth6809.asm):05270                     LDD   #TAGDO
DC00 3606             (    forth6809.asm):05271                     PSHU  D
DC02 39               (    forth6809.asm):05272                     RTS
                      (    forth6809.asm):05273         
                      (    forth6809.asm):05274         ; ------------------------------------------------------------
                      (    forth6809.asm):05275         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05276         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05277         ; branch operand.
                      (    forth6809.asm):05278         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05279         ;    Inputs:
                      (    forth6809.asm):05280         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05281         ;    Outputs:
                      (    forth6809.asm):05282         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05283         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05284         ; ------------------------------------------------------------
DC03 3706             (    forth6809.asm):05285         QDOSETUP:   PULU  D                 ; index

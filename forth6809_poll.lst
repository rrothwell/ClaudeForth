                      (    forth6809.asm):03477         ; ------------------------------------------------------------
                      (    forth6809.asm):03478         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03479         ; ROOT, for a name.
                      (    forth6809.asm):03480         ; SRCHORD

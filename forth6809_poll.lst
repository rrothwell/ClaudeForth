                      (    forth6809.asm):03635         ; ------------------------------------------------------------
                      (    forth6809.asm):03636         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03637         ; ROOT, for a name.
                      (    forth6809.asm):03638         ; SRCHORD
                      (    forth6809.asm):03639         ;    Inputs:
                      (    forth6809.asm):03640         ;        RegY = address of the name text
                      (    forth6809.asm):03641         ;        RegB = name length
                      (    forth6809.asm):03642         ;    Outputs:
                      (    forth6809.asm):03643         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03644         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03645         ; ------------------------------------------------------------
D852 3424             (    forth6809.asm):03646         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D854 8E004B           (    forth6809.asm):03647                     LDX   #ORDER
D857 3410             (    forth6809.asm):03648                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D859 AEE4             (    forth6809.asm):03649         SOLOOP:     LDX   ,S
D85B 9C49             (    forth6809.asm):03650                     CMPX  ORDEND
D85D 2415             (    forth6809.asm):03651                     BHS   SOROOT

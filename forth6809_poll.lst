                      (    forth6809.asm):04665         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04666         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04667         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that

                      (    forth6809.asm):08981         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):08982         ; ============================================================
                      (    forth6809.asm):08983         ; ------------------------------------------------------------
                      (    forth6809.asm):08984         ; TRUE  ( -- flag )
                      (    forth6809.asm):08985         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08986         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08987         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08988         ; ------------------------------------------------------------
FE3E CCFFFF           (    forth6809.asm):08989         TRUEW:      LDD   #$FFFF
FE41 3606             (    forth6809.asm):08990                     PSHU  D
FE43 39               (    forth6809.asm):08991                     RTS
                      (    forth6809.asm):08992         
                      (    forth6809.asm):08993         ; ------------------------------------------------------------
                      (    forth6809.asm):08994         ; FALSE  ( -- flag )
                      (    forth6809.asm):08995         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08996         ; ------------------------------------------------------------
FE44 CC0000           (    forth6809.asm):08997         FALSEW:     LDD   #$0000
FE47 3606             (    forth6809.asm):08998                     PSHU  D
FE49 39               (    forth6809.asm):08999                     RTS
                      (    forth6809.asm):09000         
                      (    forth6809.asm):09001         ; ------------------------------------------------------------
                      (    forth6809.asm):09002         ; 1  ( -- 1 )
                      (    forth6809.asm):09003         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):09004         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):09005         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):09006         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):09007         ; ------------------------------------------------------------
FE4A CC0001           (    forth6809.asm):09008         POSONEW:    LDD   #1
FE4D 3606             (    forth6809.asm):09009                     PSHU  D
FE4F 39               (    forth6809.asm):09010                     RTS
                      (    forth6809.asm):09011         
                      (    forth6809.asm):09012         ; ------------------------------------------------------------
                      (    forth6809.asm):09013         ; -1  ( -- -1 )
                      (    forth6809.asm):09014         ; Push the constant -1.
                      (    forth6809.asm):09015         ; ------------------------------------------------------------
FE50 CCFFFF           (    forth6809.asm):09016         NEGONEW:    LDD   #-1
FE53 3606             (    forth6809.asm):09017                     PSHU  D
FE55 39               (    forth6809.asm):09018                     RTS
                      (    forth6809.asm):09019         
                      (    forth6809.asm):09020         ; ------------------------------------------------------------
                      (    forth6809.asm):09021         ; 2  ( -- 2 )
                      (    forth6809.asm):09022         ; Push the constant 2.
                      (    forth6809.asm):09023         ; ------------------------------------------------------------
FE56 CC0002           (    forth6809.asm):09024         POSTWOW:    LDD   #2
FE59 3606             (    forth6809.asm):09025                     PSHU  D
FE5B 39               (    forth6809.asm):09026                     RTS
                      (    forth6809.asm):09027         
                      (    forth6809.asm):09028         ; ------------------------------------------------------------
                      (    forth6809.asm):09029         ; -2  ( -- -2 )
                      (    forth6809.asm):09030         ; Push the constant -2.
                      (    forth6809.asm):09031         ; ------------------------------------------------------------
FE5C CCFFFE           (    forth6809.asm):09032         NEGTWOW:    LDD   #-2
FE5F 3606             (    forth6809.asm):09033                     PSHU  D
FE61 39               (    forth6809.asm):09034                     RTS
                      (    forth6809.asm):09035         

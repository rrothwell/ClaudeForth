EA90 4F               (    forth6809.asm):07962                     CLRA
EA91 308B             (    forth6809.asm):07963                     LEAX  D,X               ; X = header + length
EA93 10AC03           (    forth6809.asm):07964                     CMPY  3,X               ; CFA field follows the name and link
EA96 2704             (    forth6809.asm):07965                     BEQ   SNFOUND
EA98 AE01             (    forth6809.asm):07966                     LDX   1,X               ; LINK field
EA9A 20EB             (    forth6809.asm):07967                     BRA   SNLOOP

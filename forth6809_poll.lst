E0F5 DD49             (    forth6809.asm):03624                     STD   ORDEND
E0F7 39               (    forth6809.asm):03625                     RTS
                      (    forth6809.asm):03626         
                      (    forth6809.asm):03627         ; ------------------------------------------------------------
                      (    forth6809.asm):03628         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03629         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03630         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03631         ; PRUNE
                      (    forth6809.asm):03632         ;    Inputs:
                      (    forth6809.asm):03633         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03634         ;    Outputs:
                      (    forth6809.asm):03635         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03636         ;        into ROM
                      (    forth6809.asm):03637         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03638         ; ------------------------------------------------------------
E0F8 3406             (    forth6809.asm):03639         PRUNE:      PSHS  D                 ; 0,S = mark
E0FA 8E005B           (    forth6809.asm):03640                     LDX   #WLHEADS
E0FD 9C45             (    forth6809.asm):03641         PRLOOP:     CMPX  WLEND
E0FF 2421             (    forth6809.asm):03642                     BHS   PRNDONE
E101 10AE84           (    forth6809.asm):03643                     LDY   ,X                ; newest header of this wordlist
E104 108CC000         (    forth6809.asm):03644         PRWALK:     CMPY  #ROMSTRT
E108 2413             (    forth6809.asm):03645                     BHS   PRSTORE           ; ROM header: keep
E10A 10ACE4           (    forth6809.asm):03646                     CMPY  ,S
E10D 250E             (    forth6809.asm):03647                     BLO   PRSTORE           ; below the mark (or empty): keep
E10F E6A4             (    forth6809.asm):03648                     LDB   ,Y
E111 C41F             (    forth6809.asm):03649                     ANDB  #$1F
E113 4F               (    forth6809.asm):03650                     CLRA
E114 3121             (    forth6809.asm):03651                     LEAY  1,Y
E116 31AB             (    forth6809.asm):03652                     LEAY  D,Y
E118 10AEA4           (    forth6809.asm):03653                     LDY   ,Y                ; follow the LINK
E11B 20E7             (    forth6809.asm):03654                     BRA   PRWALK
E11D 10AF81           (    forth6809.asm):03655         PRSTORE:    STY   ,X++
E120 20DB             (    forth6809.asm):03656                     BRA   PRLOOP
E122 3262             (    forth6809.asm):03657         PRNDONE:     LEAS  2,S
E124 39               (    forth6809.asm):03658                     RTS

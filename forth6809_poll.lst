                      (    forth6809.asm):05564         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05565         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05566         ; the string.
                      (    forth6809.asm):05567         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05568         ;    Inputs:
                      (    forth6809.asm):05569         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05570         ;        count byte
                      (    forth6809.asm):05571         ;    Outputs:
                      (    forth6809.asm):05572         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05573         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05574         ; ------------------------------------------------------------
DE49                  (    forth6809.asm):05575         DOABORTQUOTE:
DE49 3510             (    forth6809.asm):05576                     PULS  X
DE4B E684             (    forth6809.asm):05577                     LDB   ,X
DE4D 3001             (    forth6809.asm):05578                     LEAX  1,X               ; X = text, B = length
DE4F 4F               (    forth6809.asm):05579                     CLRA
DE50 3720             (    forth6809.asm):05580                     PULU  Y                 ; flag
DE52 108C0000         (    forth6809.asm):05581                     CMPY  #0

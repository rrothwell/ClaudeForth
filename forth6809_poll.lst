                      (    forth6809.asm):05343         ; ------------------------------------------------------------
                      (    forth6809.asm):05344         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05345         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05346         ; EXITUNLOOP
                      (    forth6809.asm):05347         ;    Inputs:
                      (    forth6809.asm):05348         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05349         ;        address
                      (    forth6809.asm):05350         ;    Outputs:
                      (    forth6809.asm):05351         ;        returns to the caller of the definition
                      (    forth6809.asm):05352         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05353         ; ------------------------------------------------------------

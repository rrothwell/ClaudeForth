E9E8 AF42             (    forth6809.asm):05423                     STX   2,U
E9EA ED44             (    forth6809.asm):05424                     STD   4,U
E9EC 39               (    forth6809.asm):05425                     RTS
                      (    forth6809.asm):05426         
                      (    forth6809.asm):05427         ; ------------------------------------------------------------
                      (    forth6809.asm):05428         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05429         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05430         ; ------------------------------------------------------------
E9ED 3706             (    forth6809.asm):05431         PICKW:      PULU  D                 ; u
E9EF 58               (    forth6809.asm):05432                     LSLB
E9F0 49               (    forth6809.asm):05433                     ROLA
E9F1 ECCB             (    forth6809.asm):05434                     LDD   D,U
E9F3 3606             (    forth6809.asm):05435                     PSHU  D
E9F5 39               (    forth6809.asm):05436                     RTS
                      (    forth6809.asm):05437         
                      (    forth6809.asm):05438         ; ------------------------------------------------------------
                      (    forth6809.asm):05439         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05440         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05441         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05442         ; the cell being moved.
                      (    forth6809.asm):05443         ; ------------------------------------------------------------
E9F6 ECC1             (    forth6809.asm):05444         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
E9F8 2718             (    forth6809.asm):05445                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
E9FA 1F02             (    forth6809.asm):05446                     TFR   D,Y               ; Y = cells to shift
E9FC 58               (    forth6809.asm):05447                     LSLB
E9FD 49               (    forth6809.asm):05448                     ROLA
E9FE 30CB             (    forth6809.asm):05449                     LEAX  D,U               ; X = xu
EA00 EC84             (    forth6809.asm):05450                     LDD   ,X
EA02 3406             (    forth6809.asm):05451                     PSHS  D                 ; xu waits on the return stack
EA04 EC1E             (    forth6809.asm):05452         RLOOP:      LDD   -2,X
EA06 ED84             (    forth6809.asm):05453                     STD   ,X
EA08 301E             (    forth6809.asm):05454                     LEAX  -2,X

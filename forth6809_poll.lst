                      (    forth6809.asm):03926         ; DEFINITIONS  ( -- )
                      (    forth6809.asm):03927         ; Make the first wordlist of the search order the one that receives new
                      (    forth6809.asm):03928         ; definitions. Throws -50 when the search order is empty.

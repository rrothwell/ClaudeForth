                      (    forth6809.asm):01788         ; ============================================================
                      (    forth6809.asm):01789         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):01790         ; ============================================================
                      (    forth6809.asm):01791                     ORG   BASECODE          ; See bugfix: BASECODE.1
                      (    forth6809.asm):01792         
                      (    forth6809.asm):01793         ; ------------------------------------------------------------
                      (    forth6809.asm):01794         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):01795         ; receiver-error counters to zero.
                      (    forth6809.asm):01796         ; SERBUFCLR
                      (    forth6809.asm):01797         ;    Inputs:
                      (    forth6809.asm):01798         ;        none
                      (    forth6809.asm):01799         ;    Outputs:
                      (    forth6809.asm):01800         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):01801         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):01802         ;    Registers: only CC changed.
                      (    forth6809.asm):01803         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):01804         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):01805         ; ------------------------------------------------------------
                      (    forth6809.asm):01806         
DBF0 7F0176           (    forth6809.asm):01807         SERBUFCLR:  CLR   INHEAD
DBF3 7F0177           (    forth6809.asm):01808                     CLR   INTAIL
DBF6 7F0178           (    forth6809.asm):01809                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
DBF9 7F0179           (    forth6809.asm):01810                     CLR   OUTHEAD
DBFC 7F017A           (    forth6809.asm):01811                     CLR   OUTTAIL
DBFF 7F017B           (    forth6809.asm):01812                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):01813         
                      (    forth6809.asm):01814         
DC02 7F017C           (    forth6809.asm):01815                     CLR   FECOUNT
DC05 7F017D           (    forth6809.asm):01816                     CLR   OVRNCOUNT
DC08 7F017E           (    forth6809.asm):01817                     CLR   PECOUNT
DC0B 7F017F           (    forth6809.asm):01818                     CLR   POLLREADYCNT
DC0E 39               (    forth6809.asm):01819                     RTS
                      (    forth6809.asm):01820         
                      (    forth6809.asm):01821         ; ------------------------------------------------------------
                      (    forth6809.asm):01822         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):01823         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):01824         ; INITSERIAL
                      (    forth6809.asm):01825         ;    Inputs:
                      (    forth6809.asm):01826         ;        none
                      (    forth6809.asm):01827         ;    Outputs:
                      (    forth6809.asm):01828         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01829         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01830         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01831         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01832         ; ------------------------------------------------------------
DC0F BDDBF0           (    forth6809.asm):01833         INITSERIAL: JSR   SERBUFCLR
DC12 8603             (    forth6809.asm):01834                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
DC14 B7C008           (    forth6809.asm):01835                     STA   ACIACR
DC17 12               (    forth6809.asm):01836                     NOP                     ; Settling Delay
DC18 12               (    forth6809.asm):01837                     NOP
                      (    forth6809.asm):01838         
                      (    forth6809.asm):01839                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01840                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):01841                     ELSE                    ; <<<<<>>>>>
DC19 8615             (    forth6809.asm):01842                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):01843                     ENDC                    ; <<<<<<<<<<
DC1B B7C008           (    forth6809.asm):01844                     STA   ACIACR            ; See bugfix: INITSERIAL.1
DC1E 39               (    forth6809.asm):01845                     RTS
                      (    forth6809.asm):01846         
                      (    forth6809.asm):01847                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01848         ; ------------------------------------------------------------
                      (    forth6809.asm):01849         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01850         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01851         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01852         ; INFILL
                      (    forth6809.asm):01853         ;    Inputs:
                      (    forth6809.asm):01854         ;        none
                      (    forth6809.asm):01855         ;    Outputs:
                      (    forth6809.asm):01856         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01857         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01858         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):01859         INFILL:     LDA   INHEAD
                      (    forth6809.asm):01860                     SUBA  INTAIL
                      (    forth6809.asm):01861                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):01862                     RTS
                      (    forth6809.asm):01863         ; ------------------------------------------------------------
                      (    forth6809.asm):01864         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01865         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01866         ; receive path with interrupts already masked.
                      (    forth6809.asm):01867         ; RTSCHECKHI
                      (    forth6809.asm):01868         ;    Inputs:
                      (    forth6809.asm):01869         ;        none
                      (    forth6809.asm):01870         ;    Outputs:
                      (    forth6809.asm):01871         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01872         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01873         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):01874         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):01875                     CMPA  #INHIWATER
                      (    forth6809.asm):01876                     BLO   RTSCHIDONE
                      (    forth6809.asm):01877                     TST   RTSSTATE
                      (    forth6809.asm):01878                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):01879                     LDA   #CR_RTSHI
                      (    forth6809.asm):01880                     STA   ACIACR
                      (    forth6809.asm):01881                     LDA   #1
                      (    forth6809.asm):01882                     STA   RTSSTATE
DC1F                  (    forth6809.asm):01883         RTSCHIDONE: RTS
                      (    forth6809.asm):01884         ; ------------------------------------------------------------
                      (    forth6809.asm):01885         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01886         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01887         ; enables it only while output is pending.
                      (    forth6809.asm):01888         ; UPDATE_RTS
                      (    forth6809.asm):01889         ;    Inputs:
                      (    forth6809.asm):01890         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01891         ;    Outputs:
                      (    forth6809.asm):01892         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01893         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01894         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):01895         UPDATE_RTS:
                      (    forth6809.asm):01896                     TST   RTSSTATE
                      (    forth6809.asm):01897                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01898         
                      (    forth6809.asm):01899                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):01900                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01901         
                      (    forth6809.asm):01902                                             ; $B5/%1011_0101
                      (    forth6809.asm):01903                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):01904                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01905         
DC1F                  (    forth6809.asm):01906         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):01907                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):01908                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01909         
DC1F                  (    forth6809.asm):01910         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):01911                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):01912                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DC1F                  (    forth6809.asm):01913         WRITE_CR:
                      (    forth6809.asm):01914                     STA   ACIACR
                      (    forth6809.asm):01915                     RTS
                      (    forth6809.asm):01916         ; ------------------------------------------------------------
                      (    forth6809.asm):01917         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01918         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01919         ; Called after a character is added to the ring.
                      (    forth6809.asm):01920         ; CHKHI
                      (    forth6809.asm):01921         ;    Inputs:
                      (    forth6809.asm):01922         ;        RegB = input ring fill level
                      (    forth6809.asm):01923         ;    Outputs:
                      (    forth6809.asm):01924         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01925         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01926         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01927         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):01928         CHKHI:
                      (    forth6809.asm):01929                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):01930                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):01931                     TST   RTSSTATE
                      (    forth6809.asm):01932                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):01933                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):01934                     STA   RTSSTATE
                      (    forth6809.asm):01935                     JSR   UPDATE_RTS
DC1F                  (    forth6809.asm):01936         CHKHIDONE:  RTS
                      (    forth6809.asm):01937         
                      (    forth6809.asm):01938         ; ------------------------------------------------------------
                      (    forth6809.asm):01939         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):01940         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):01941         ; Called after a character is removed from the ring.
                      (    forth6809.asm):01942         ; CHKLO
                      (    forth6809.asm):01943         ;    Inputs:
                      (    forth6809.asm):01944         ;        RegB = input ring fill level
                      (    forth6809.asm):01945         ;    Outputs:
                      (    forth6809.asm):01946         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):01947         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01948         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):01949         CHKLO:
                      (    forth6809.asm):01950                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):01951                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):01952                     TST   RTSSTATE
                      (    forth6809.asm):01953                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):01954                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):01955                     STA   RTSSTATE
                      (    forth6809.asm):01956                     JSR   UPDATE_RTS
DC1F                  (    forth6809.asm):01957         CHKLODONE:  RTS
                      (    forth6809.asm):01958         ; ------------------------------------------------------------
                      (    forth6809.asm):01959         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):01960         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):01961         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):01962         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):01963         ; FLUSHOUTBUFFER
                      (    forth6809.asm):01964         ;    Inputs:
                      (    forth6809.asm):01965         ;        none
                      (    forth6809.asm):01966         ;    Outputs:
                      (    forth6809.asm):01967         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):01968         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):01969         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):01970         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):01971         FLUSHOUTBUFFER:
                      (    forth6809.asm):01972                     LDB   OUTTAIL
                      (    forth6809.asm):01973                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):01974                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01975         
                      (    forth6809.asm):01976                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):01977                     BITA  #SR_CTS
                      (    forth6809.asm):01978                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):01979         
                      (    forth6809.asm):01980                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):01981                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):01982                                             ; than spin-wait here.
                      (    forth6809.asm):01983         
                      (    forth6809.asm):01984                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):01985                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):01986                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):01987         
                      (    forth6809.asm):01988                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):01989                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):01990                     STB   OUTTAIL
                      (    forth6809.asm):01991                                             ; One character sent - return rather than
                      (    forth6809.asm):01992                                             ; loop back for more (see header comment).
DC1F                  (    forth6809.asm):01993         FLUSHED:
                      (    forth6809.asm):01994                     RTS
                      (    forth6809.asm):01995         ; ------------------------------------------------------------
                      (    forth6809.asm):01996         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):01997         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):01998         ; PUTCHAR
                      (    forth6809.asm):01999         ;    Inputs:
                      (    forth6809.asm):02000         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02001         ;    Outputs:
                      (    forth6809.asm):02002         ;        none
                      (    forth6809.asm):02003         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02004         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):02005         PUTCHAR:
                      (    forth6809.asm):02006                     PSHS  CC,X
                      (    forth6809.asm):02007                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02008         
                      (    forth6809.asm):02009                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02010                     INCB
                      (    forth6809.asm):02011                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02012                     CMPB  OUTTAIL
                      (    forth6809.asm):02013                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02014         
                      (    forth6809.asm):02015                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02016                     LDB   OUTHEAD
                      (    forth6809.asm):02017                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02018         
                      (    forth6809.asm):02019                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02020                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02021                     STB   OUTHEAD
                      (    forth6809.asm):02022         
                      (    forth6809.asm):02023                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02024                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02025         
                      (    forth6809.asm):02026                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02027                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02028                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02029                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02030                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02031                                             ; expects the critical section active
                      (    forth6809.asm):02032         
                      (    forth6809.asm):02033                     BRA   PUT_EXIT
                      (    forth6809.asm):02034         
                      (    forth6809.asm):02035         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02036         ; priming the pump by transmitting a character.
DC1F                  (    forth6809.asm):02037         CHK_INT_PATH:
                      (    forth6809.asm):02038                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02039                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02040         
                      (    forth6809.asm):02041                                             ; No! Restart.
                      (    forth6809.asm):02042                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02043                     LDB   OUTTAIL
                      (    forth6809.asm):02044                     LDA   B,X
                      (    forth6809.asm):02045                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02046         
                      (    forth6809.asm):02047                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02048                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02049                     STB   OUTTAIL
                      (    forth6809.asm):02050         
                      (    forth6809.asm):02051                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02052                     STA   OUTACTIVITY
                      (    forth6809.asm):02053                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02054         
DC1F                  (    forth6809.asm):02055         PUT_EXIT:
                      (    forth6809.asm):02056                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02057                                             ; by restoring the CC.
                      (    forth6809.asm):02058         ; ------------------------------------------------------------
                      (    forth6809.asm):02059         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02060         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02061         ; GETCHAR
                      (    forth6809.asm):02062         ;    Inputs:
                      (    forth6809.asm):02063         ;        none
                      (    forth6809.asm):02064         ;    Outputs:
                      (    forth6809.asm):02065         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02066         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02067         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02068         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):02069         GETCHAR:
                      (    forth6809.asm):02070                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02071                     CMPB  INHEAD
                      (    forth6809.asm):02072                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02073         
                      (    forth6809.asm):02074                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02075                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02076         
                      (    forth6809.asm):02077                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02078                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02079                     STB   INTAIL
                      (    forth6809.asm):02080         
                      (    forth6809.asm):02081                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02082                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02083                     ORCC  #$10
                      (    forth6809.asm):02084                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02085                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02086                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02087                                             ; there's no already-loaded value here
                      (    forth6809.asm):02088                                             ; worth reusing.
                      (    forth6809.asm):02089                     JSR   CHKLO
                      (    forth6809.asm):02090                     ANDCC #$EF
                      (    forth6809.asm):02091         
                      (    forth6809.asm):02092                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02093                     RTS
                      (    forth6809.asm):02094         
DC1F                  (    forth6809.asm):02095         GET_NO_CHAR:
                      (    forth6809.asm):02096                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02097                     RTS
                      (    forth6809.asm):02098         ; ------------------------------------------------------------
                      (    forth6809.asm):02099         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02100         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02101         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02102         ; RTSCHECKLO
                      (    forth6809.asm):02103         ;    Inputs:
                      (    forth6809.asm):02104         ;        none
                      (    forth6809.asm):02105         ;    Outputs:
                      (    forth6809.asm):02106         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02107         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02108         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):02110         RTSCHECKLO:
                      (    forth6809.asm):02111                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02112         
                      (    forth6809.asm):02113                     JSR   INFILL
                      (    forth6809.asm):02114                     CMPA  #INLOWATER
                      (    forth6809.asm):02115                     BHI   RTSCLODONE
                      (    forth6809.asm):02116                     TST   RTSSTATE
                      (    forth6809.asm):02117                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02118         
                      (    forth6809.asm):02119         
                      (    forth6809.asm):02120                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02121         
                      (    forth6809.asm):02122                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02123                     CMPB  OUTHEAD
                      (    forth6809.asm):02124                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02125         
                      (    forth6809.asm):02126                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02127                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02128                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02129         
DC1F                  (    forth6809.asm):02130         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02131                     STA   ACIACR
                      (    forth6809.asm):02132         
DC1F                  (    forth6809.asm):02133         RTSCLOUNMASK:
                      (    forth6809.asm):02134                     ANDCC #$EF
                      (    forth6809.asm):02135         
DC1F                  (    forth6809.asm):02136         RTSCLODONE: RTS
                      (    forth6809.asm):02137         
                      (    forth6809.asm):02138         ; ------------------------------------------------------------
                      (    forth6809.asm):02139         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02140         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02141         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02142         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02143         ; IRQH
                      (    forth6809.asm):02144         ;    Inputs:
                      (    forth6809.asm):02145         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02146         ;    Outputs:
                      (    forth6809.asm):02147         ;        none (returns with RTI)
                      (    forth6809.asm):02148         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02149         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02150         ; ------------------------------------------------------------
DC1F                  (    forth6809.asm):02151         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02152         
                      (    forth6809.asm):02153                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02154                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02155                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02156                     BNE   INCHAR
                      (    forth6809.asm):02157                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02158                     BNE   OUTCHAR
                      (    forth6809.asm):02159                                             ; Ignore all other interrupts such as DCD change.
DC1F                  (    forth6809.asm):02160         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02161                                             ; & restores state.
                      (    forth6809.asm):02162         
DC1F                  (    forth6809.asm):02163         INCHAR:
                      (    forth6809.asm):02164                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02165                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02166                                             ; Any receiver error flagged?
                      (    forth6809.asm):02167                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02168         
                      (    forth6809.asm):02169                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02170                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02171                     INC   FECOUNT           ; more than one bit can be set at once.
DC1F                  (    forth6809.asm):02172         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02173                     BEQ   INXOVRN
                      (    forth6809.asm):02174                     INC   OVRNCOUNT
DC1F                  (    forth6809.asm):02175         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02176                     BEQ   INXPE
                      (    forth6809.asm):02177                     INC   PECOUNT
DC1F                  (    forth6809.asm):02178         INXPE:      RTI
                      (    forth6809.asm):02179         
DC1F                  (    forth6809.asm):02180         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02181                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02182                     LDB   INHEAD
                      (    forth6809.asm):02183                     STA   B,X
                      (    forth6809.asm):02184                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02185                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02186                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02187                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02188                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02189                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02190                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02191                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02192                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02193                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02194                     JSR   CHKHI             ; Protect the in buffer from overflow.
DC1F                  (    forth6809.asm):02195         IRQDONE1:   RTI
                      (    forth6809.asm):02196         
                      (    forth6809.asm):02197                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02198         
DC1F                  (    forth6809.asm):02199         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02200                     CMPB  OUTHEAD
                      (    forth6809.asm):02201                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02202         
                      (    forth6809.asm):02203                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02204                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02205                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02206         
                      (    forth6809.asm):02207                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02208                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02209                     STB   OUTTAIL
DC1F                  (    forth6809.asm):02210         IRQDONE2    RTI
                      (    forth6809.asm):02211         
DC1F                  (    forth6809.asm):02212         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02213                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02214                     CLR   OUTACTIVITY
                      (    forth6809.asm):02215                     JSR   UPDATE_RTS
DC1F                  (    forth6809.asm):02216         IRQDONE3    RTI
                      (    forth6809.asm):02217         
                      (    forth6809.asm):02218                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02219         
DC1F 3B               (    forth6809.asm):02220         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02221                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02222                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02223                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02224                                             ; the other unused vectors below
                      (    forth6809.asm):02225                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02226         
                      (    forth6809.asm):02227         ; ------------------------------------------------------------
                      (    forth6809.asm):02228         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02229         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02230         ; ------------------------------------------------------------
DC20 3B               (    forth6809.asm):02231         SWI3H:      RTI
DC21 3B               (    forth6809.asm):02232         SWI2H:      RTI
DC22 3B               (    forth6809.asm):02233         FIRQH:      RTI
DC23 3B               (    forth6809.asm):02234         NMIH:       RTI                     ; unused now that NMI -> WARM
DC24 CCFF9D           (    forth6809.asm):02235         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
DC27 3606             (    forth6809.asm):02236                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
DC29 7EE422           (    forth6809.asm):02237                     JMP   THROWW
                      (    forth6809.asm):02238         
                      (    forth6809.asm):02239         ; ============================================================
                      (    forth6809.asm):02240         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02241         ; ============================================================
                      (    forth6809.asm):02242         ; ------------------------------------------------------------
                      (    forth6809.asm):02243         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02244         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02245         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02246         ; COLD
                      (    forth6809.asm):02247         ;    Inputs:
                      (    forth6809.asm):02248         ;        none (entered at reset)
                      (    forth6809.asm):02249         ;    Outputs:
                      (    forth6809.asm):02250         ;        none (does not return)
                      (    forth6809.asm):02251         ;    Registers: all changed.
                      (    forth6809.asm):02252         ; ------------------------------------------------------------
DC2C CC0240           (    forth6809.asm):02253         COLD:       LDD   #APPVARS
DC2F DD0A             (    forth6809.asm):02254                     STD   VARHERE
DC31 CC7000           (    forth6809.asm):02255                     LDD   #APPCODE

                      (    forth6809.asm):05643         ; DUP  ( x -- x x )
                      (    forth6809.asm):05644         ; Duplicate the top cell.
                      (    forth6809.asm):05645         ; ------------------------------------------------------------
DECE ECC4             (    forth6809.asm):05646         DUPW:       LDD   ,U                ; x
DED0 3606             (    forth6809.asm):05647                     PSHU  D
DED2 39               (    forth6809.asm):05648                     RTS
                      (    forth6809.asm):05649         
                      (    forth6809.asm):05650         ; ------------------------------------------------------------
                      (    forth6809.asm):05651         ; DROP  ( x -- )

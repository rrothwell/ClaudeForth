                      (    forth6809.asm):06702         ; ------------------------------------------------------------
F298 CC0000           (    forth6809.asm):06703         ERASEW:     LDD   #0
F29B 3606             (    forth6809.asm):06704                     PSHU  D
F29D 7EF282           (    forth6809.asm):06705                     JMP   FILLW
                      (    forth6809.asm):06706         
                      (    forth6809.asm):06707         ; ------------------------------------------------------------
                      (    forth6809.asm):06708         ; BLANK  ( c-addr u -- )
                      (    forth6809.asm):06709         ; Store a space in each of u bytes starting at c-addr.
                      (    forth6809.asm):06710         ; ------------------------------------------------------------
F2A0 CC0020           (    forth6809.asm):06711         BLANKW:     LDD   #32
F2A3 3606             (    forth6809.asm):06712                     PSHU  D
F2A5 7EF282           (    forth6809.asm):06713                     JMP   FILLW
                      (    forth6809.asm):06714         
                      (    forth6809.asm):06715         ; ============================================================
                      (    forth6809.asm):06716         ; SECTION 19: STRING WORDS
                      (    forth6809.asm):06717         ; ============================================================
                      (    forth6809.asm):06718         ; ------------------------------------------------------------
                      (    forth6809.asm):06719         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):06720         ; address and length and skip over it.
                      (    forth6809.asm):06721         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):06722         ;    Inputs:
                      (    forth6809.asm):06723         ;        return address on S points at the count byte
                      (    forth6809.asm):06724         ;    Outputs:
                      (    forth6809.asm):06725         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):06726         ;        string
                      (    forth6809.asm):06727         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):06728         ; ------------------------------------------------------------
F2A8 3510             (    forth6809.asm):06729         DOSTR:      PULS  X
F2AA E684             (    forth6809.asm):06730                     LDB   ,X
F2AC 3001             (    forth6809.asm):06731                     LEAX  1,X
F2AE 3610             (    forth6809.asm):06732                     PSHU  X
F2B0 4F               (    forth6809.asm):06733                     CLRA
F2B1 3606             (    forth6809.asm):06734                     PSHU  D
F2B3 3085             (    forth6809.asm):06735                     LEAX  B,X
F2B5 3410             (    forth6809.asm):06736                     PSHS  X
F2B7 39               (    forth6809.asm):06737                     RTS
                      (    forth6809.asm):06738         
                      (    forth6809.asm):06739         ; ------------------------------------------------------------
                      (    forth6809.asm):06740         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):06741         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):06742         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):06743         ; PARSEQUOTE
                      (    forth6809.asm):06744         ;    Inputs:
                      (    forth6809.asm):06745         ;        none (parses from >IN)
                      (    forth6809.asm):06746         ;    Outputs:
                      (    forth6809.asm):06747         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):06748         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):06749         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06750         ; ------------------------------------------------------------
F2B8 CC0022           (    forth6809.asm):06751         PARSEQUOTE: LDD   #34
F2BB 3606             (    forth6809.asm):06752                     PSHU  D
F2BD BDF48E           (    forth6809.asm):06753                     JSR   PARSEW
F2C0 6DC4             (    forth6809.asm):06754                     TST   ,U                ; high byte of the length
F2C2 2601             (    forth6809.asm):06755                     BNE   PQLONG
F2C4 39               (    forth6809.asm):06756                     RTS
F2C5 CCFFEE           (    forth6809.asm):06757         PQLONG:     LDD   #-18
F2C8 3606             (    forth6809.asm):06758                     PSHU  D
F2CA 7EE422           (    forth6809.asm):06759                     JMP   THROWW
                      (    forth6809.asm):06760         
                      (    forth6809.asm):06761         ; ------------------------------------------------------------
                      (    forth6809.asm):06762         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):06763         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):06764         ;    Inputs:
                      (    forth6809.asm):06765         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):06766         ;        c-addr u on the data stack
                      (    forth6809.asm):06767         ;    Outputs:
                      (    forth6809.asm):06768         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):06769         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):06770         ; ------------------------------------------------------------
F2CD 3606             (    forth6809.asm):06771         CSTRCOMP:   PSHU  D
F2CF BDE85D           (    forth6809.asm):06772                     JSR   CCALL
F2D2 3706             (    forth6809.asm):06773                     PULU  D                 ; u
F2D4 3720             (    forth6809.asm):06774                     PULU  Y                 ; c-addr
F2D6 9E08             (    forth6809.asm):06775                     LDX   CODEHERE
F2D8 E780             (    forth6809.asm):06776                     STB   ,X+
F2DA 5D               (    forth6809.asm):06777                     TSTB
F2DB 2707             (    forth6809.asm):06778                     BEQ   CSEND
F2DD A6A0             (    forth6809.asm):06779         CSCPY:      LDA   ,Y+
F2DF A780             (    forth6809.asm):06780                     STA   ,X+
F2E1 5A               (    forth6809.asm):06781                     DECB
F2E2 26F9             (    forth6809.asm):06782                     BNE   CSCPY
F2E4 9F08             (    forth6809.asm):06783         CSEND:      STX   CODEHERE
F2E6 39               (    forth6809.asm):06784                     RTS
                      (    forth6809.asm):06785         
                      (    forth6809.asm):06786         ; ------------------------------------------------------------
                      (    forth6809.asm):06787         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06788         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):06789         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):06790         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):06791         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):06792         ; ------------------------------------------------------------
F2E7 BDF2B8           (    forth6809.asm):06793         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
F2EA DC00             (    forth6809.asm):06794         SQSTATE:    LDD   STATE
F2EC 2706             (    forth6809.asm):06795                     BEQ   SQINTERP
F2EE CCF2A8           (    forth6809.asm):06796                     LDD   #DOSTR
F2F1 7EF2CD           (    forth6809.asm):06797                     JMP   CSTRCOMP
                      (    forth6809.asm):06798         
                      (    forth6809.asm):06799                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):06800                     ; SQUOTEW.2.
F2F4                  (    forth6809.asm):06801         SQINTERP:
F2F4 BDDDDC           (    forth6809.asm):06802                     JSR   PADW
F2F7 3710             (    forth6809.asm):06803                     PULU  X                 ; PAD
F2F9 3706             (    forth6809.asm):06804                     PULU  D                 ; u
F2FB 3720             (    forth6809.asm):06805                     PULU  Y                 ; c-addr
F2FD 3610             (    forth6809.asm):06806                     PSHU  X                 ; result c-addr
F2FF 3606             (    forth6809.asm):06807                     PSHU  D                 ; result u
F301 5D               (    forth6809.asm):06808                     TSTB
F302 2707             (    forth6809.asm):06809                     BEQ   SQIEND
F304 A6A0             (    forth6809.asm):06810         SQICPY:     LDA   ,Y+
F306 A780             (    forth6809.asm):06811                     STA   ,X+
F308 5A               (    forth6809.asm):06812                     DECB
F309 26F9             (    forth6809.asm):06813                     BNE   SQICPY
F30B 39               (    forth6809.asm):06814         SQIEND:     RTS
                      (    forth6809.asm):06815         
                      (    forth6809.asm):06816         ; ------------------------------------------------------------
                      (    forth6809.asm):06817         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):06818         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):06819         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):06820         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):06821         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):06822         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):06823         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):06824         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):06825         ; A result over 255 characters throws -18.
                      (    forth6809.asm):06826         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):06827         ; ------------------------------------------------------------
F30C BDDDDC           (    forth6809.asm):06828         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F30F ECC4             (    forth6809.asm):06829                     LDD   ,U
F311 3406             (    forth6809.asm):06830                     PSHS  D                 ; output pointer
F313 3406             (    forth6809.asm):06831                     PSHS  D                 ; output start
F315 DC39             (    forth6809.asm):06832                     LDD   SRCADDR
F317 D33B             (    forth6809.asm):06833                     ADDD  SRCLEN
F319 3406             (    forth6809.asm):06834                     PSHS  D                 ; input end
F31B DC39             (    forth6809.asm):06835                     LDD   SRCADDR
F31D D310             (    forth6809.asm):06836                     ADDD  TOIN
F31F 1F02             (    forth6809.asm):06837                     TFR   D,Y               ; input pointer
F321 10AC60           (    forth6809.asm):06838         SQEL:       CMPY  0,S
F324 247E             (    forth6809.asm):06839                     BHS   SQEND
F326 A6A0             (    forth6809.asm):06840                     LDA   ,Y+
F328 8122             (    forth6809.asm):06841                     CMPA  #34
F32A 2778             (    forth6809.asm):06842                     BEQ   SQEND
F32C 815C             (    forth6809.asm):06843                     CMPA  #92
F32E 261C             (    forth6809.asm):06844                     BNE   SQEPUT
F330 10AC60           (    forth6809.asm):06845                     CMPY  0,S
F333 246F             (    forth6809.asm):06846                     BHS   SQEND
F335 A6A0             (    forth6809.asm):06847                     LDA   ,Y+               ; the escaped character
F337 8178             (    forth6809.asm):06848                     CMPA  #'x'
F339 2727             (    forth6809.asm):06849                     BEQ   SQEHEX
F33B 816D             (    forth6809.asm):06850                     CMPA  #'m'
F33D 2715             (    forth6809.asm):06851                     BEQ   SQEM
F33F 8EF3C0           (    forth6809.asm):06852                     LDX   #SQETAB
F342 6D84             (    forth6809.asm):06853         SQEFND:     TST   ,X
F344 2706             (    forth6809.asm):06854                     BEQ   SQEPUT            ; not in the table: stands for itself
F346 A181             (    forth6809.asm):06855                     CMPA  ,X++
F348 26F8             (    forth6809.asm):06856                     BNE   SQEFND
F34A A61F             (    forth6809.asm):06857                     LDA   -1,X
F34C AE64             (    forth6809.asm):06858         SQEPUT:     LDX   4,S
F34E A780             (    forth6809.asm):06859                     STA   ,X+
F350 AF64             (    forth6809.asm):06860                     STX   4,S
F352 20CD             (    forth6809.asm):06861                     BRA   SQEL
F354 AE64             (    forth6809.asm):06862         SQEM:       LDX   4,S
F356 860D             (    forth6809.asm):06863                     LDA   #13
F358 A780             (    forth6809.asm):06864                     STA   ,X+
F35A 860A             (    forth6809.asm):06865                     LDA   #10
F35C A780             (    forth6809.asm):06866                     STA   ,X+
F35E AF64             (    forth6809.asm):06867                     STX   4,S
F360 20BF             (    forth6809.asm):06868                     BRA   SQEL
F362 8D1A             (    forth6809.asm):06869         SQEHEX:     BSR   SQEHD             ; first digit
F364 25BB             (    forth6809.asm):06870                     BCS   SQEL              ; none: nothing is added
F366 3121             (    forth6809.asm):06871                     LEAY  1,Y
F368 1F89             (    forth6809.asm):06872                     TFR   A,B
F36A 8D12             (    forth6809.asm):06873                     BSR   SQEHD             ; second digit
F36C 2404             (    forth6809.asm):06874                     BCC   SQEH2
F36E 1F98             (    forth6809.asm):06875                     TFR   B,A               ; one digit only
F370 20DA             (    forth6809.asm):06876                     BRA   SQEPUT
F372 3121             (    forth6809.asm):06877         SQEH2:      LEAY  1,Y
F374 58               (    forth6809.asm):06878                     ASLB
F375 58               (    forth6809.asm):06879                     ASLB
F376 58               (    forth6809.asm):06880                     ASLB
F377 58               (    forth6809.asm):06881                     ASLB
F378 3404             (    forth6809.asm):06882                     PSHS  B
F37A ABE0             (    forth6809.asm):06883                     ADDA  ,S+
F37C 20CE             (    forth6809.asm):06884                     BRA   SQEPUT
                      (    forth6809.asm):06885         ; Hex digit at ,Y: value in A, carry clear; carry set if not a digit
                      (    forth6809.asm):06886         ; or the input is exhausted. Y is not advanced. RegB is preserved.
F37E 10AC62           (    forth6809.asm):06887         SQEHD:      CMPY  2,S               ; input end (one return address down)
F381 241E             (    forth6809.asm):06888                     BHS   SQEHNO

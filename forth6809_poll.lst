                      (    forth6809.asm):04599         ; ------------------------------------------------------------
                      (    forth6809.asm):04600         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04601         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04602         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04603         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04604         ; ------------------------------------------------------------
D7CA 335E             (    forth6809.asm):04605         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
D7CC CC0000           (    forth6809.asm):04606                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5

DD2C ED81             (    forth6809.asm):02966                     STD   ,X++
DD2E 9F0A             (    forth6809.asm):02967                     STX   VARHERE
DD30 39               (    forth6809.asm):02968                     RTS
                      (    forth6809.asm):02969         
                      (    forth6809.asm):02970         ; ------------------------------------------------------------
                      (    forth6809.asm):02971         ; @  ( a-addr -- x )
                      (    forth6809.asm):02972         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):02973         ; ------------------------------------------------------------
DD31 3710             (    forth6809.asm):02974         FETCHW:     PULU  X                 ; a-addr
DD33 EC84             (    forth6809.asm):02975                     LDD   ,X
DD35 3606             (    forth6809.asm):02976                     PSHU  D                 ; x
DD37 39               (    forth6809.asm):02977                     RTS
                      (    forth6809.asm):02978         
                      (    forth6809.asm):02979         ; ------------------------------------------------------------
                      (    forth6809.asm):02980         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):02981         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):02982         ; after the trampoline and fetched with @.
                      (    forth6809.asm):02983         ; ------------------------------------------------------------
DD38 CCDD31           (    forth6809.asm):02984         CONSTANTW:  LDD   #FETCHW
DD3B BDDCEA           (    forth6809.asm):02985                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DD3E BDDBF5           (    forth6809.asm):02986                     JSR   COMMAW
DD41 39               (    forth6809.asm):02987                     RTS
                      (    forth6809.asm):02988         
                      (    forth6809.asm):02989         ; ------------------------------------------------------------
                      (    forth6809.asm):02990         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):02991         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):02992         ;    Inputs:
                      (    forth6809.asm):02993         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):02994         ;    Outputs:
                      (    forth6809.asm):02995         ;        pfa replaced by the value
                      (    forth6809.asm):02996         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02997         ; ------------------------------------------------------------
DD42 3710             (    forth6809.asm):02998         DOVALUE:    PULU  X                 ; pfa
DD44 EC84             (    forth6809.asm):02999                     LDD   ,X
DD46 3606             (    forth6809.asm):03000                     PSHU  D                 ; x
DD48 39               (    forth6809.asm):03001                     RTS
                      (    forth6809.asm):03002         
                      (    forth6809.asm):03003         ; ------------------------------------------------------------
                      (    forth6809.asm):03004         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03005         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03006         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03007         ; ------------------------------------------------------------
DD49 CCDD42           (    forth6809.asm):03008         VALUEW:     LDD   #DOVALUE
DD4C BDDCD0           (    forth6809.asm):03009                     JSR   BLDDOES
DD4F DC0A             (    forth6809.asm):03010                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DD51 3606             (    forth6809.asm):03011                     PSHU  D                 ; See bugfix: VALUEW.1
DD53 BDDBFB           (    forth6809.asm):03012                     JSR   CODECOMMA
DD56 BDDC0D           (    forth6809.asm):03013                     JSR   VCOMMAW           ; store x in the variable area
DD59 39               (    forth6809.asm):03014                     RTS
                      (    forth6809.asm):03015         
                      (    forth6809.asm):03016         ; ------------------------------------------------------------
                      (    forth6809.asm):03017         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03018         ; lower address as 2@ expects.
                      (    forth6809.asm):03019         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03020         ; ------------------------------------------------------------
DD5A 7EF211           (    forth6809.asm):03021         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03022         
                      (    forth6809.asm):03023         ; ------------------------------------------------------------
                      (    forth6809.asm):03024         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03025         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03026         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03027         ; ------------------------------------------------------------
DD5D CCDD5A           (    forth6809.asm):03028         TWOVALUEW:  LDD   #DO2VALUE
DD60 BDDCD0           (    forth6809.asm):03029                     JSR   BLDDOES
DD63 DC0A             (    forth6809.asm):03030                     LDD   VARHERE           ; PFA = VARHERE (writable space)
DD65 3606             (    forth6809.asm):03031                     PSHU  D
DD67 BDDBFB           (    forth6809.asm):03032                     JSR   CODECOMMA
DD6A BDDC0D           (    forth6809.asm):03033                     JSR   VCOMMAW           ; x2 at the lower address
DD6D BDDC0D           (    forth6809.asm):03034                     JSR   VCOMMAW           ; then x1
DD70 39               (    forth6809.asm):03035                     RTS
                      (    forth6809.asm):03036         
                      (    forth6809.asm):03037         ; ------------------------------------------------------------
                      (    forth6809.asm):03038         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03039         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03040         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03041         ; ------------------------------------------------------------
DD71 CC0020           (    forth6809.asm):03042         TOW:        LDD   #32
DD74 3606             (    forth6809.asm):03043                     PSHU  D
DD76 BDDF8A           (    forth6809.asm):03044                     JSR   WORDW

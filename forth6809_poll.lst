CE8F DC00             (    forth6809.asm):02642                     LDD   STATE
CE91 1026FF89         (    forth6809.asm):02643                     LBNE  QLOOP
CE95 8ECEB4           (    forth6809.asm):02644                     LDX   #OKMSG

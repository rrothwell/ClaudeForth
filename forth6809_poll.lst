DC00 DC08             (    forth6809.asm):05103                     LDD   CODEHERE
DC02 3606             (    forth6809.asm):05104                     PSHU  D
DC04 3610             (    forth6809.asm):05105                     PSHU  X
DC06 BDD9A5           (    forth6809.asm):05106                     JSR   PATCH
DC09 39               (    forth6809.asm):05107         PLOOPDONE:  RTS
                      (    forth6809.asm):05108         
                      (    forth6809.asm):05109         ; ------------------------------------------------------------
                      (    forth6809.asm):05110         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05111         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05112         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05113         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05114         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05115         ;    Inputs:
                      (    forth6809.asm):05116         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05117         ;    Outputs:
                      (    forth6809.asm):05118         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05119         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05120         ;        scratch.
                      (    forth6809.asm):05121         ; ------------------------------------------------------------
DC0A 3706             (    forth6809.asm):05122         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DC0C DD14             (    forth6809.asm):05123                     STD   MSCR              ; MSCR = step
DC0E EC66             (    forth6809.asm):05124                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DC10 262D             (    forth6809.asm):05125                     BNE   DPTEXIT           ; set: exit
DC12 EC62             (    forth6809.asm):05126                     LDD   2,S               ; old index
DC14 A364             (    forth6809.asm):05127                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DC16 DD16             (    forth6809.asm):05128                     STD   MSCR2
DC18 EC62             (    forth6809.asm):05129                     LDD   2,S
DC1A D314             (    forth6809.asm):05130                     ADDD  MSCR              ; new_index = old_index + step
DC1C ED62             (    forth6809.asm):05131                     STD   2,S
DC1E A364             (    forth6809.asm):05132                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DC20 DD18             (    forth6809.asm):05133                     STD   MSCR3
                      (    forth6809.asm):05134                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05135                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05136                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DC22 DC14             (    forth6809.asm):05137                     LDD   MSCR              ; reload the step to test its sign
DC24 2B09             (    forth6809.asm):05138                     BMI   DPNEG
DC26 DC18             (    forth6809.asm):05139         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DC28 109316           (    forth6809.asm):05140                     CMPD  MSCR2
DC2B 2512             (    forth6809.asm):05141                     BLO   DPTEXIT
DC2D 2007             (    forth6809.asm):05142                     BRA   DPCONT
DC2F DC18             (    forth6809.asm):05143         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DC31 109316           (    forth6809.asm):05144                     CMPD  MSCR2
DC34 2209             (    forth6809.asm):05145                     BHI   DPTEXIT
DC36 3510             (    forth6809.asm):05146         DPCONT:     PULS  X                 ; X = branch operand address
DC38 EC84             (    forth6809.asm):05147                     LDD   ,X
DC3A 308B             (    forth6809.asm):05148                     LEAX  D,X
DC3C 3410             (    forth6809.asm):05149                     PSHS  X
DC3E 39               (    forth6809.asm):05150                     RTS
DC3F 3510             (    forth6809.asm):05151         DPTEXIT:    PULS  X
DC41 3002             (    forth6809.asm):05152                     LEAX  2,X               ; skip the branch operand
DC43 3266             (    forth6809.asm):05153                     LEAS  6,S               ; discard the loop frame
DC45 3410             (    forth6809.asm):05154                     PSHS  X
DC47 39               (    forth6809.asm):05155                     RTS
                      (    forth6809.asm):05156         
                      (    forth6809.asm):05157         ; ------------------------------------------------------------
                      (    forth6809.asm):05158         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05159         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05160         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05161         ; ------------------------------------------------------------
DC48 CCDC6E           (    forth6809.asm):05162         QDOW:       LDD   #QDOSETUP
DC4B 3606             (    forth6809.asm):05163                     PSHU  D
DC4D BDDDAB           (    forth6809.asm):05164                     JSR   CCALL
DC50 CC0000           (    forth6809.asm):05165                     LDD   #0
DC53 3606             (    forth6809.asm):05166                     PSHU  D
DC55 BDD08B           (    forth6809.asm):05167                     JSR   CODECOMMA
DC58 DC08             (    forth6809.asm):05168                     LDD   CODEHERE
DC5A 830002           (    forth6809.asm):05169                     SUBD  #2
DC5D 3606             (    forth6809.asm):05170                     PSHU  D                 ; orig
DC5F CC0007           (    forth6809.asm):05171                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DC62 3606             (    forth6809.asm):05172                     PSHU  D
DC64 DC08             (    forth6809.asm):05173                     LDD   CODEHERE
DC66 3606             (    forth6809.asm):05174                     PSHU  D                 ; dest
DC68 CC0003           (    forth6809.asm):05175                     LDD   #TAGDO
DC6B 3606             (    forth6809.asm):05176                     PSHU  D
DC6D 39               (    forth6809.asm):05177                     RTS
                      (    forth6809.asm):05178         
                      (    forth6809.asm):05179         ; ------------------------------------------------------------
                      (    forth6809.asm):05180         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05181         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05182         ; branch operand.
                      (    forth6809.asm):05183         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05184         ;    Inputs:
                      (    forth6809.asm):05185         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05186         ;    Outputs:
                      (    forth6809.asm):05187         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05188         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05189         ; ------------------------------------------------------------
DC6E 3706             (    forth6809.asm):05190         QDOSETUP:   PULU  D                 ; index
DC70 DD14             (    forth6809.asm):05191                     STD   MSCR
DC72 3706             (    forth6809.asm):05192                     PULU  D                 ; limit
DC74 DD16             (    forth6809.asm):05193                     STD   MSCR2
DC76 3510             (    forth6809.asm):05194                     PULS  X
DC78 DC16             (    forth6809.asm):05195                     LDD   MSCR2

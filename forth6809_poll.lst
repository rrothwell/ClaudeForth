E97A 39               (    forth6809.asm):05310                     RTS
                      (    forth6809.asm):05311         
                      (    forth6809.asm):05312         ; ------------------------------------------------------------
                      (    forth6809.asm):05313         ; SWAP  ( x1 x2 -- x2 x1 )

D63C A646             (    forth6809.asm):04208                     LDA   6,U
D63E E661             (    forth6809.asm):04209                     LDB   1,S
D640 3D               (    forth6809.asm):04210                     MUL
D641 EBE4             (    forth6809.asm):04211                     ADDB  ,S
D643 2401             (    forth6809.asm):04212                     BCC   UM1
D645 4C               (    forth6809.asm):04213                     INCA

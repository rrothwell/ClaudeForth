                      (    forth6809.asm):03181         ; Store xt as the action of the named deferred word. When compiling,
                      (    forth6809.asm):03182         ; compile code to do so at run time. Error -13 if the name is not
                      (    forth6809.asm):03183         ; found.
                      (    forth6809.asm):03184         ; ------------------------------------------------------------
DE56 CC0020           (    forth6809.asm):03185         ISW:        LDD   #32

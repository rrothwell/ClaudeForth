                      (    forth6809.asm):04703         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04704         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04705         ; ============================================================
                      (    forth6809.asm):04706         ; ------------------------------------------------------------
                      (    forth6809.asm):04707         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04708         ; location.
                      (    forth6809.asm):04709         ; PATCH   ( target location -- )
                      (    forth6809.asm):04710         ;    Inputs:
                      (    forth6809.asm):04711         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04712         ;    Outputs:
                      (    forth6809.asm):04713         ;        the cell at location holds target - location
                      (    forth6809.asm):04714         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04715         ; ------------------------------------------------------------
D9A5 3710             (    forth6809.asm):04716         PATCH:      PULU  X                 ; location
D9A7 3706             (    forth6809.asm):04717                     PULU  D                 ; target
D9A9 3410             (    forth6809.asm):04718                     PSHS  X
D9AB A3E1             (    forth6809.asm):04719                     SUBD  ,S++              ; target - location
D9AD ED84             (    forth6809.asm):04720                     STD   ,X
D9AF 39               (    forth6809.asm):04721                     RTS
                      (    forth6809.asm):04722         
                      (    forth6809.asm):04723         ; ------------------------------------------------------------
                      (    forth6809.asm):04724         ; IF  ( C: -- orig )
                      (    forth6809.asm):04725         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04726         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04727         ; ------------------------------------------------------------
D9B0 CCCFEE           (    forth6809.asm):04728         IFW:        LDD   #ZBRANCH
D9B3 3606             (    forth6809.asm):04729                     PSHU  D
D9B5 BDDDAB           (    forth6809.asm):04730                     JSR   CCALL
D9B8 CC0000           (    forth6809.asm):04731                     LDD   #0
D9BB 3606             (    forth6809.asm):04732                     PSHU  D

                      (    forth6809.asm):04859         ; ------------------------------------------------------------
                      (    forth6809.asm):04860         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04861         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04862         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04863         ; frames is found by scanning, and removed from beneath them.

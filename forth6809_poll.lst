D66B AE42             (    forth6809.asm):04251                     LDX   2,U
D66D A684             (    forth6809.asm):04252                     LDA   ,X
D66F 8130             (    forth6809.asm):04253                     CMPA  #'0'
D671 252C             (    forth6809.asm):04254                     BLO   NLDONE
D673 8139             (    forth6809.asm):04255                     CMPA  #'9'

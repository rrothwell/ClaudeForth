                      (    forth6809.asm):05037         ; ------------------------------------------------------------
DA4B DC1F             (    forth6809.asm):05038         RECURSEW:   LDD   CURXT             ; xt of word being compiled
DA4D 3606             (    forth6809.asm):05039                     PSHU  D                 ; See bugfix: RECURSEW.1
DA4F BDDCD0           (    forth6809.asm):05040                     JSR   CCALL
DA52 39               (    forth6809.asm):05041                     RTS
                      (    forth6809.asm):05042         
                      (    forth6809.asm):05043         ; ------------------------------------------------------------
                      (    forth6809.asm):05044         ; DO  ( C: -- dest )
                      (    forth6809.asm):05045         ; Compile a call to DOSETUP and leave the loop start address and TAGDO
                      (    forth6809.asm):05046         ; on the control-flow stack for LOOP or +LOOP.
                      (    forth6809.asm):05047         ; ------------------------------------------------------------
DA53 CCDA65           (    forth6809.asm):05048         DOW:        LDD   #DOSETUP
DA56 3606             (    forth6809.asm):05049                     PSHU  D
DA58 BDDCD0           (    forth6809.asm):05050                     JSR   CCALL
DA5B DC08             (    forth6809.asm):05051                     LDD   CODEHERE
DA5D 3606             (    forth6809.asm):05052                     PSHU  D                 ; dest
DA5F CC0003           (    forth6809.asm):05053                     LDD   #TAGDO
DA62 3606             (    forth6809.asm):05054                     PSHU  D
DA64 39               (    forth6809.asm):05055                     RTS
                      (    forth6809.asm):05056         
                      (    forth6809.asm):05057         ; ------------------------------------------------------------
                      (    forth6809.asm):05058         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):05059         ; return address.
                      (    forth6809.asm):05060         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):05061         ;    Inputs:
                      (    forth6809.asm):05062         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05063         ;    Outputs:
                      (    forth6809.asm):05064         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):05065         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05066         ; ------------------------------------------------------------
DA65 3706             (    forth6809.asm):05067         DOSETUP:    PULU  D                 ; index
DA67 DD14             (    forth6809.asm):05068                     STD   MSCR
DA69 3706             (    forth6809.asm):05069                     PULU  D                 ; limit
DA6B DD16             (    forth6809.asm):05070                     STD   MSCR2
DA6D 3510             (    forth6809.asm):05071                     PULS  X
DA6F CC0000           (    forth6809.asm):05072                     LDD   #0
DA72 3406             (    forth6809.asm):05073                     PSHS  D
DA74 DC16             (    forth6809.asm):05074                     LDD   MSCR2
DA76 3406             (    forth6809.asm):05075                     PSHS  D
DA78 DC14             (    forth6809.asm):05076                     LDD   MSCR
DA7A 3406             (    forth6809.asm):05077                     PSHS  D
DA7C 3410             (    forth6809.asm):05078                     PSHS  X
DA7E 39               (    forth6809.asm):05079                     RTS
                      (    forth6809.asm):05080         
                      (    forth6809.asm):05081         ; ------------------------------------------------------------
                      (    forth6809.asm):05082         ; I  ( -- n )
                      (    forth6809.asm):05083         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):05084         ; address).
                      (    forth6809.asm):05085         ; ------------------------------------------------------------
DA7F EC62             (    forth6809.asm):05086         IW:         LDD   2,S               ; n. See bugfix: IW.1
DA81 3606             (    forth6809.asm):05087                     PSHU  D
DA83 39               (    forth6809.asm):05088                     RTS
                      (    forth6809.asm):05089         
                      (    forth6809.asm):05090         ; ------------------------------------------------------------
                      (    forth6809.asm):05091         ; J  ( -- n )
                      (    forth6809.asm):05092         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05093         ; address and the inner loop frame).
                      (    forth6809.asm):05094         ; ------------------------------------------------------------
DA84 EC68             (    forth6809.asm):05095         JW:         LDD   8,S               ; n. See bugfix: JW.1
DA86 3606             (    forth6809.asm):05096                     PSHU  D
DA88 39               (    forth6809.asm):05097                     RTS
                      (    forth6809.asm):05098         
                      (    forth6809.asm):05099         ; ------------------------------------------------------------
                      (    forth6809.asm):05100         ; LEAVE  ( -- )
                      (    forth6809.asm):05101         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05102         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05103         ; ------------------------------------------------------------
DA89 CCFFFF           (    forth6809.asm):05104         LEAVEW:     LDD   #TRUEV            ; true
DA8C ED66             (    forth6809.asm):05105                     STD   6,S               ; See bugfix: LEAVEW.1
DA8E 39               (    forth6809.asm):05106                     RTS
                      (    forth6809.asm):05107         
                      (    forth6809.asm):05108         ; ------------------------------------------------------------
                      (    forth6809.asm):05109         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05110         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05111         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05112         ; ------------------------------------------------------------
DA8F 3706             (    forth6809.asm):05113         LOOPW:      PULU  D
DA91 10830003         (    forth6809.asm):05114                     CMPD  #TAGDO
DA95 2703             (    forth6809.asm):05115                     BEQ   LOOPOK
DA97 BDD860           (    forth6809.asm):05116                     JSR   CFERR
DA9A 3706             (    forth6809.asm):05117         LOOPOK:     PULU  D                 ; dest
DA9C 3606             (    forth6809.asm):05118                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DA9E CCDACE           (    forth6809.asm):05119                     LDD   #DOTEST
DAA1 3606             (    forth6809.asm):05120                     PSHU  D
DAA3 BDDCD0           (    forth6809.asm):05121                     JSR   CCALL
DAA6 CC0000           (    forth6809.asm):05122                     LDD   #0
DAA9 3606             (    forth6809.asm):05123                     PSHU  D
DAAB BDCF66           (    forth6809.asm):05124                     JSR   CODECOMMA
DAAE DC08             (    forth6809.asm):05125                     LDD   CODEHERE
DAB0 830002           (    forth6809.asm):05126                     SUBD  #2
DAB3 3606             (    forth6809.asm):05127                     PSHU  D                 ; location; the parked dest is beneath
DAB5 BDD8CA           (    forth6809.asm):05128                     JSR   PATCH
                      (    forth6809.asm):05129         
DAB8 ECC4             (    forth6809.asm):05130                     LDD   ,U
DABA 10830007         (    forth6809.asm):05131                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DABE 260D             (    forth6809.asm):05132                     BNE   LOOPDONE
DAC0 3706             (    forth6809.asm):05133                     PULU  D
DAC2 3710             (    forth6809.asm):05134                     PULU  X                 ; ?DO skip operand
DAC4 DC08             (    forth6809.asm):05135                     LDD   CODEHERE
DAC6 3606             (    forth6809.asm):05136                     PSHU  D
DAC8 3610             (    forth6809.asm):05137                     PSHU  X
DACA BDD8CA           (    forth6809.asm):05138                     JSR   PATCH
DACD 39               (    forth6809.asm):05139         LOOPDONE:   RTS
                      (    forth6809.asm):05140         
                      (    forth6809.asm):05141         ; ------------------------------------------------------------
                      (    forth6809.asm):05142         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05143         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05144         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05145         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05146         ; DOTEST
                      (    forth6809.asm):05147         ;    Inputs:
                      (    forth6809.asm):05148         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05149         ;        first)
                      (    forth6809.asm):05150         ;    Outputs:
                      (    forth6809.asm):05151         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05152         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05153         ; ------------------------------------------------------------
DACE EC66             (    forth6809.asm):05154         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DAD0 2615             (    forth6809.asm):05155                     BNE   DTEXIT            ; set: exit
DAD2 EC62             (    forth6809.asm):05156                     LDD   2,S               ; index
DAD4 C30001           (    forth6809.asm):05157                     ADDD  #1
DAD7 ED62             (    forth6809.asm):05158                     STD   2,S
DAD9 10A364           (    forth6809.asm):05159                     CMPD  4,S               ; limit
DADC 2709             (    forth6809.asm):05160                     BEQ   DTEXIT
DADE 3510             (    forth6809.asm):05161                     PULS  X                 ; X = branch operand address
DAE0 EC84             (    forth6809.asm):05162                     LDD   ,X
DAE2 308B             (    forth6809.asm):05163                     LEAX  D,X
DAE4 3410             (    forth6809.asm):05164                     PSHS  X                 ; return to loop start
DAE6 39               (    forth6809.asm):05165                     RTS
DAE7 3510             (    forth6809.asm):05166         DTEXIT:     PULS  X
DAE9 3002             (    forth6809.asm):05167                     LEAX  2,X               ; skip the branch operand
DAEB 3266             (    forth6809.asm):05168                     LEAS  6,S               ; discard the loop frame
DAED 3410             (    forth6809.asm):05169                     PSHS  X
DAEF 39               (    forth6809.asm):05170                     RTS
                      (    forth6809.asm):05171         
                      (    forth6809.asm):05172         ; ------------------------------------------------------------
                      (    forth6809.asm):05173         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05174         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05175         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05176         ; ------------------------------------------------------------
DAF0 3706             (    forth6809.asm):05177         PLUSLOOPW:  PULU  D
DAF2 10830003         (    forth6809.asm):05178                     CMPD  #TAGDO
DAF6 2703             (    forth6809.asm):05179                     BEQ   PLOOPOK
DAF8 BDD860           (    forth6809.asm):05180                     JSR   CFERR
DAFB 3706             (    forth6809.asm):05181         PLOOPOK:    PULU  D                 ; dest
DAFD 3606             (    forth6809.asm):05182                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DAFF CCDB2F           (    forth6809.asm):05183                     LDD   #DOPLUSTEST
DB02 3606             (    forth6809.asm):05184                     PSHU  D
DB04 BDDCD0           (    forth6809.asm):05185                     JSR   CCALL
DB07 CC0000           (    forth6809.asm):05186                     LDD   #0
DB0A 3606             (    forth6809.asm):05187                     PSHU  D
DB0C BDCF66           (    forth6809.asm):05188                     JSR   CODECOMMA
DB0F DC08             (    forth6809.asm):05189                     LDD   CODEHERE
DB11 830002           (    forth6809.asm):05190                     SUBD  #2
DB14 3606             (    forth6809.asm):05191                     PSHU  D                 ; location; the parked dest is beneath
DB16 BDD8CA           (    forth6809.asm):05192                     JSR   PATCH
                      (    forth6809.asm):05193         
DB19 ECC4             (    forth6809.asm):05194                     LDD   ,U
DB1B 10830007         (    forth6809.asm):05195                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DB1F 260D             (    forth6809.asm):05196                     BNE   PLOOPDONE
DB21 3706             (    forth6809.asm):05197                     PULU  D
DB23 3710             (    forth6809.asm):05198                     PULU  X                 ; ?DO skip operand
DB25 DC08             (    forth6809.asm):05199                     LDD   CODEHERE
DB27 3606             (    forth6809.asm):05200                     PSHU  D
DB29 3610             (    forth6809.asm):05201                     PSHU  X
DB2B BDD8CA           (    forth6809.asm):05202                     JSR   PATCH
DB2E 39               (    forth6809.asm):05203         PLOOPDONE:  RTS
                      (    forth6809.asm):05204         
                      (    forth6809.asm):05205         ; ------------------------------------------------------------
                      (    forth6809.asm):05206         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05207         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05208         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05209         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05210         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05211         ;    Inputs:
                      (    forth6809.asm):05212         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05213         ;    Outputs:
                      (    forth6809.asm):05214         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05215         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05216         ;        scratch.
                      (    forth6809.asm):05217         ; ------------------------------------------------------------
DB2F 3706             (    forth6809.asm):05218         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DB31 DD14             (    forth6809.asm):05219                     STD   MSCR              ; MSCR = step
DB33 EC66             (    forth6809.asm):05220                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DB35 262D             (    forth6809.asm):05221                     BNE   DPTEXIT           ; set: exit
DB37 EC62             (    forth6809.asm):05222                     LDD   2,S               ; old index
DB39 A364             (    forth6809.asm):05223                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DB3B DD16             (    forth6809.asm):05224                     STD   MSCR2
DB3D EC62             (    forth6809.asm):05225                     LDD   2,S
DB3F D314             (    forth6809.asm):05226                     ADDD  MSCR              ; new_index = old_index + step
DB41 ED62             (    forth6809.asm):05227                     STD   2,S
DB43 A364             (    forth6809.asm):05228                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DB45 DD18             (    forth6809.asm):05229                     STD   MSCR3
                      (    forth6809.asm):05230                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05231                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05232                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DB47 DC14             (    forth6809.asm):05233                     LDD   MSCR              ; reload the step to test its sign
DB49 2B09             (    forth6809.asm):05234                     BMI   DPNEG
DB4B DC18             (    forth6809.asm):05235         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DB4D 109316           (    forth6809.asm):05236                     CMPD  MSCR2
DB50 2512             (    forth6809.asm):05237                     BLO   DPTEXIT
DB52 2007             (    forth6809.asm):05238                     BRA   DPCONT
DB54 DC18             (    forth6809.asm):05239         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DB56 109316           (    forth6809.asm):05240                     CMPD  MSCR2
DB59 2209             (    forth6809.asm):05241                     BHI   DPTEXIT
DB5B 3510             (    forth6809.asm):05242         DPCONT:     PULS  X                 ; X = branch operand address
DB5D EC84             (    forth6809.asm):05243                     LDD   ,X
DB5F 308B             (    forth6809.asm):05244                     LEAX  D,X
DB61 3410             (    forth6809.asm):05245                     PSHS  X
DB63 39               (    forth6809.asm):05246                     RTS
DB64 3510             (    forth6809.asm):05247         DPTEXIT:    PULS  X
DB66 3002             (    forth6809.asm):05248                     LEAX  2,X               ; skip the branch operand
DB68 3266             (    forth6809.asm):05249                     LEAS  6,S               ; discard the loop frame
DB6A 3410             (    forth6809.asm):05250                     PSHS  X
DB6C 39               (    forth6809.asm):05251                     RTS
                      (    forth6809.asm):05252         
                      (    forth6809.asm):05253         ; ------------------------------------------------------------
                      (    forth6809.asm):05254         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05255         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05256         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05257         ; ------------------------------------------------------------
DB6D CCDB93           (    forth6809.asm):05258         QDOW:       LDD   #QDOSETUP
DB70 3606             (    forth6809.asm):05259                     PSHU  D
DB72 BDDCD0           (    forth6809.asm):05260                     JSR   CCALL
DB75 CC0000           (    forth6809.asm):05261                     LDD   #0
DB78 3606             (    forth6809.asm):05262                     PSHU  D
DB7A BDCF66           (    forth6809.asm):05263                     JSR   CODECOMMA
DB7D DC08             (    forth6809.asm):05264                     LDD   CODEHERE
DB7F 830002           (    forth6809.asm):05265                     SUBD  #2
DB82 3606             (    forth6809.asm):05266                     PSHU  D                 ; orig
DB84 CC0007           (    forth6809.asm):05267                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DB87 3606             (    forth6809.asm):05268                     PSHU  D
DB89 DC08             (    forth6809.asm):05269                     LDD   CODEHERE
DB8B 3606             (    forth6809.asm):05270                     PSHU  D                 ; dest
DB8D CC0003           (    forth6809.asm):05271                     LDD   #TAGDO
DB90 3606             (    forth6809.asm):05272                     PSHU  D
DB92 39               (    forth6809.asm):05273                     RTS
                      (    forth6809.asm):05274         
                      (    forth6809.asm):05275         ; ------------------------------------------------------------
                      (    forth6809.asm):05276         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05277         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05278         ; branch operand.
                      (    forth6809.asm):05279         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05280         ;    Inputs:
                      (    forth6809.asm):05281         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05282         ;    Outputs:
                      (    forth6809.asm):05283         ;        loop skipped, or loop frame on S and operand skipped

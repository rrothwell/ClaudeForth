                      (    forth6809.asm):05157         ; ------------------------------------------------------------
                      (    forth6809.asm):05158         ; [COMPILE]  ( "name" -- )
                      (    forth6809.asm):05159         ; Compile a call to the next name, whether or not it is immediate.

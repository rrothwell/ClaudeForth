                      (    forth6809.asm):05867         
                      (    forth6809.asm):05868         ; ------------------------------------------------------------
                      (    forth6809.asm):05869         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05870         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05871         ; ------------------------------------------------------------
DE6D 3706             (    forth6809.asm):05872         PICKW:      PULU  D                 ; u
DE6F 58               (    forth6809.asm):05873                     LSLB

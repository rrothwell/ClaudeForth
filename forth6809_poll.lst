                      (    forth6809.asm):04970         ; ------------------------------------------------------------
                      (    forth6809.asm):04971         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04972         ; return address.
                      (    forth6809.asm):04973         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04974         ;    Inputs:
                      (    forth6809.asm):04975         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04976         ;    Outputs:
                      (    forth6809.asm):04977         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04978         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04979         ; ------------------------------------------------------------
DB11 3706             (    forth6809.asm):04980         DOSETUP:    PULU  D                 ; index
DB13 DD14             (    forth6809.asm):04981                     STD   MSCR
DB15 3706             (    forth6809.asm):04982                     PULU  D                 ; limit
DB17 DD16             (    forth6809.asm):04983                     STD   MSCR2
DB19 3510             (    forth6809.asm):04984                     PULS  X
DB1B CC0000           (    forth6809.asm):04985                     LDD   #0
DB1E 3406             (    forth6809.asm):04986                     PSHS  D
DB20 DC16             (    forth6809.asm):04987                     LDD   MSCR2
DB22 3406             (    forth6809.asm):04988                     PSHS  D
DB24 DC14             (    forth6809.asm):04989                     LDD   MSCR
DB26 3406             (    forth6809.asm):04990                     PSHS  D
DB28 3410             (    forth6809.asm):04991                     PSHS  X
DB2A 39               (    forth6809.asm):04992                     RTS
                      (    forth6809.asm):04993         
                      (    forth6809.asm):04994         ; ------------------------------------------------------------
                      (    forth6809.asm):04995         ; I  ( -- n )
                      (    forth6809.asm):04996         ; Push the index of the innermost loop (2,S, beyond the return
                      (    forth6809.asm):04997         ; address).
                      (    forth6809.asm):04998         ; ------------------------------------------------------------
DB2B EC62             (    forth6809.asm):04999         IW:         LDD   2,S               ; n. See bugfix: IW.1
DB2D 3606             (    forth6809.asm):05000                     PSHU  D
DB2F 39               (    forth6809.asm):05001                     RTS
                      (    forth6809.asm):05002         
                      (    forth6809.asm):05003         ; ------------------------------------------------------------
                      (    forth6809.asm):05004         ; J  ( -- n )
                      (    forth6809.asm):05005         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):05006         ; address and the inner loop frame).
                      (    forth6809.asm):05007         ; ------------------------------------------------------------
DB30 EC68             (    forth6809.asm):05008         JW:         LDD   8,S               ; n. See bugfix: JW.1
DB32 3606             (    forth6809.asm):05009                     PSHU  D
DB34 39               (    forth6809.asm):05010                     RTS
                      (    forth6809.asm):05011         
                      (    forth6809.asm):05012         ; ------------------------------------------------------------
                      (    forth6809.asm):05013         ; LEAVE  ( -- )
                      (    forth6809.asm):05014         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05015         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05016         ; ------------------------------------------------------------
DB35 CCFFFF           (    forth6809.asm):05017         LEAVEW:     LDD   #TRUEV            ; true
DB38 ED66             (    forth6809.asm):05018                     STD   6,S               ; See bugfix: LEAVEW.1
DB3A 39               (    forth6809.asm):05019                     RTS
                      (    forth6809.asm):05020         
                      (    forth6809.asm):05021         ; ------------------------------------------------------------
                      (    forth6809.asm):05022         ; LOOP  ( C: dest -- )
                      (    forth6809.asm):05023         ; Compile a call to DOTEST followed by a displacement back to dest.
                      (    forth6809.asm):05024         ; For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05025         ; ------------------------------------------------------------
DB3B 3706             (    forth6809.asm):05026         LOOPW:      PULU  D
DB3D 10830003         (    forth6809.asm):05027                     CMPD  #TAGDO
DB41 2703             (    forth6809.asm):05028                     BEQ   LOOPOK
DB43 BDD90C           (    forth6809.asm):05029                     JSR   CFERR
DB46 3706             (    forth6809.asm):05030         LOOPOK:     PULU  D                 ; dest
DB48 3606             (    forth6809.asm):05031                     PSHU  D                 ; park dest. See bugfix: LOOPW.1
DB4A CCDB7A           (    forth6809.asm):05032                     LDD   #DOTEST
DB4D 3606             (    forth6809.asm):05033                     PSHU  D
DB4F BDDD7C           (    forth6809.asm):05034                     JSR   CCALL
DB52 CC0000           (    forth6809.asm):05035                     LDD   #0
DB55 3606             (    forth6809.asm):05036                     PSHU  D
DB57 BDD04B           (    forth6809.asm):05037                     JSR   CODECOMMA
DB5A DC08             (    forth6809.asm):05038                     LDD   CODEHERE
DB5C 830002           (    forth6809.asm):05039                     SUBD  #2
DB5F 3606             (    forth6809.asm):05040                     PSHU  D                 ; location; the parked dest is beneath
DB61 BDD976           (    forth6809.asm):05041                     JSR   PATCH
                      (    forth6809.asm):05042         
DB64 ECC4             (    forth6809.asm):05043                     LDD   ,U
DB66 10830007         (    forth6809.asm):05044                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: LOOPW.2
DB6A 260D             (    forth6809.asm):05045                     BNE   LOOPDONE
DB6C 3706             (    forth6809.asm):05046                     PULU  D
DB6E 3710             (    forth6809.asm):05047                     PULU  X                 ; ?DO skip operand
DB70 DC08             (    forth6809.asm):05048                     LDD   CODEHERE
DB72 3606             (    forth6809.asm):05049                     PSHU  D
DB74 3610             (    forth6809.asm):05050                     PSHU  X
DB76 BDD976           (    forth6809.asm):05051                     JSR   PATCH
DB79 39               (    forth6809.asm):05052         LOOPDONE:   RTS
                      (    forth6809.asm):05053         
                      (    forth6809.asm):05054         ; ------------------------------------------------------------
                      (    forth6809.asm):05055         ; Run-time end of LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05056         ; the back-branch operand. Add 1 to the index. If the leave flag is
                      (    forth6809.asm):05057         ; set or the index has reached the limit, discard the loop frame and
                      (    forth6809.asm):05058         ; skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05059         ; DOTEST
                      (    forth6809.asm):05060         ;    Inputs:
                      (    forth6809.asm):05061         ;        S holds return address, index, limit and leave flag (top
                      (    forth6809.asm):05062         ;        first)
                      (    forth6809.asm):05063         ;    Outputs:
                      (    forth6809.asm):05064         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05065         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):05066         ; ------------------------------------------------------------
DB7A EC66             (    forth6809.asm):05067         DOTEST:     LDD   6,S               ; leave flag. See bugfix: DOTEST.1
DB7C 2615             (    forth6809.asm):05068                     BNE   DTEXIT            ; set: exit
DB7E EC62             (    forth6809.asm):05069                     LDD   2,S               ; index
DB80 C30001           (    forth6809.asm):05070                     ADDD  #1
DB83 ED62             (    forth6809.asm):05071                     STD   2,S
DB85 10A364           (    forth6809.asm):05072                     CMPD  4,S               ; limit
DB88 2709             (    forth6809.asm):05073                     BEQ   DTEXIT
DB8A 3510             (    forth6809.asm):05074                     PULS  X                 ; X = branch operand address
DB8C EC84             (    forth6809.asm):05075                     LDD   ,X
DB8E 308B             (    forth6809.asm):05076                     LEAX  D,X
DB90 3410             (    forth6809.asm):05077                     PSHS  X                 ; return to loop start
DB92 39               (    forth6809.asm):05078                     RTS
DB93 3510             (    forth6809.asm):05079         DTEXIT:     PULS  X
DB95 3002             (    forth6809.asm):05080                     LEAX  2,X               ; skip the branch operand
DB97 3266             (    forth6809.asm):05081                     LEAS  6,S               ; discard the loop frame
DB99 3410             (    forth6809.asm):05082                     PSHS  X
DB9B 39               (    forth6809.asm):05083                     RTS
                      (    forth6809.asm):05084         
                      (    forth6809.asm):05085         ; ------------------------------------------------------------
                      (    forth6809.asm):05086         ; +LOOP  ( C: dest -- )
                      (    forth6809.asm):05087         ; Compile a call to DOPLUSTEST followed by a displacement back to
                      (    forth6809.asm):05088         ; dest. For a ?DO loop, also resolve its skip branch to the loop exit.
                      (    forth6809.asm):05089         ; ------------------------------------------------------------
DB9C 3706             (    forth6809.asm):05090         PLUSLOOPW:  PULU  D
DB9E 10830003         (    forth6809.asm):05091                     CMPD  #TAGDO
DBA2 2703             (    forth6809.asm):05092                     BEQ   PLOOPOK
DBA4 BDD90C           (    forth6809.asm):05093                     JSR   CFERR
DBA7 3706             (    forth6809.asm):05094         PLOOPOK:    PULU  D                 ; dest
DBA9 3606             (    forth6809.asm):05095                     PSHU  D                 ; park dest. See bugfix: PLUSLOOPW.1
DBAB CCDBDB           (    forth6809.asm):05096                     LDD   #DOPLUSTEST
DBAE 3606             (    forth6809.asm):05097                     PSHU  D
DBB0 BDDD7C           (    forth6809.asm):05098                     JSR   CCALL
DBB3 CC0000           (    forth6809.asm):05099                     LDD   #0
DBB6 3606             (    forth6809.asm):05100                     PSHU  D
DBB8 BDD04B           (    forth6809.asm):05101                     JSR   CODECOMMA
DBBB DC08             (    forth6809.asm):05102                     LDD   CODEHERE
DBBD 830002           (    forth6809.asm):05103                     SUBD  #2
DBC0 3606             (    forth6809.asm):05104                     PSHU  D                 ; location; the parked dest is beneath
DBC2 BDD976           (    forth6809.asm):05105                     JSR   PATCH
                      (    forth6809.asm):05106         
DBC5 ECC4             (    forth6809.asm):05107                     LDD   ,U
DBC7 10830007         (    forth6809.asm):05108                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DBCB 260D             (    forth6809.asm):05109                     BNE   PLOOPDONE
DBCD 3706             (    forth6809.asm):05110                     PULU  D
DBCF 3710             (    forth6809.asm):05111                     PULU  X                 ; ?DO skip operand
DBD1 DC08             (    forth6809.asm):05112                     LDD   CODEHERE
DBD3 3606             (    forth6809.asm):05113                     PSHU  D
DBD5 3610             (    forth6809.asm):05114                     PSHU  X
DBD7 BDD976           (    forth6809.asm):05115                     JSR   PATCH
DBDA 39               (    forth6809.asm):05116         PLOOPDONE:  RTS
                      (    forth6809.asm):05117         
                      (    forth6809.asm):05118         ; ------------------------------------------------------------
                      (    forth6809.asm):05119         ; Run-time end of +LOOP. Called by JSR; the return address points at
                      (    forth6809.asm):05120         ; the back-branch operand. Add the step to the index. If the leave
                      (    forth6809.asm):05121         ; flag is set or the index crossed the limit, discard the loop frame
                      (    forth6809.asm):05122         ; and skip the operand; otherwise branch back to the loop start.
                      (    forth6809.asm):05123         ; DOPLUSTEST   ( n -- )
                      (    forth6809.asm):05124         ;    Inputs:
                      (    forth6809.asm):05125         ;        step n on the data stack; S as for DOTEST
                      (    forth6809.asm):05126         ;    Outputs:
                      (    forth6809.asm):05127         ;        branch taken, or loop frame removed and operand skipped
                      (    forth6809.asm):05128         ;    Registers: RegD and RegX changed; MSCR, MSCR2 and MSCR3 used as
                      (    forth6809.asm):05129         ;        scratch.
                      (    forth6809.asm):05130         ; ------------------------------------------------------------
DBDB 3706             (    forth6809.asm):05131         DOPLUSTEST: PULU  D                 ; n = step. See bugfix: DOPLUSTEST.1
DBDD DD14             (    forth6809.asm):05132                     STD   MSCR              ; MSCR = step
DBDF EC66             (    forth6809.asm):05133                     LDD   6,S               ; leave flag. See bugfix: DOPLUSTEST.2
DBE1 262D             (    forth6809.asm):05134                     BNE   DPTEXIT           ; set: exit
DBE3 EC62             (    forth6809.asm):05135                     LDD   2,S               ; old index
DBE5 A364             (    forth6809.asm):05136                     SUBD  4,S               ; old_u = old_index - limit, mod 65536
DBE7 DD16             (    forth6809.asm):05137                     STD   MSCR2
DBE9 EC62             (    forth6809.asm):05138                     LDD   2,S
DBEB D314             (    forth6809.asm):05139                     ADDD  MSCR              ; new_index = old_index + step
DBED ED62             (    forth6809.asm):05140                     STD   2,S
DBEF A364             (    forth6809.asm):05141                     SUBD  4,S               ; new_u = new_index - limit, mod 65536
DBF1 DD18             (    forth6809.asm):05142                     STD   MSCR3
                      (    forth6809.asm):05143                     ; Crossing test on the unsigned distances old_u and new_u: with a
                      (    forth6809.asm):05144                     ; positive step the limit was crossed if new_u < old_u, with a
                      (    forth6809.asm):05145                     ; negative step if new_u > old_u. See bugfix: DOPLUSTEST.3
DBF3 DC14             (    forth6809.asm):05146                     LDD   MSCR              ; reload the step to test its sign
DBF5 2B09             (    forth6809.asm):05147                     BMI   DPNEG
DBF7 DC18             (    forth6809.asm):05148         DPPOS:      LDD   MSCR3             ; step > 0: crossed if new_u < old_u
DBF9 109316           (    forth6809.asm):05149                     CMPD  MSCR2
DBFC 2512             (    forth6809.asm):05150                     BLO   DPTEXIT
DBFE 2007             (    forth6809.asm):05151                     BRA   DPCONT
DC00 DC18             (    forth6809.asm):05152         DPNEG:      LDD   MSCR3             ; step < 0: crossed if new_u > old_u
DC02 109316           (    forth6809.asm):05153                     CMPD  MSCR2
DC05 2209             (    forth6809.asm):05154                     BHI   DPTEXIT
DC07 3510             (    forth6809.asm):05155         DPCONT:     PULS  X                 ; X = branch operand address
DC09 EC84             (    forth6809.asm):05156                     LDD   ,X
DC0B 308B             (    forth6809.asm):05157                     LEAX  D,X
DC0D 3410             (    forth6809.asm):05158                     PSHS  X
DC0F 39               (    forth6809.asm):05159                     RTS
DC10 3510             (    forth6809.asm):05160         DPTEXIT:    PULS  X
DC12 3002             (    forth6809.asm):05161                     LEAX  2,X               ; skip the branch operand
DC14 3266             (    forth6809.asm):05162                     LEAS  6,S               ; discard the loop frame
DC16 3410             (    forth6809.asm):05163                     PSHS  X
DC18 39               (    forth6809.asm):05164                     RTS
                      (    forth6809.asm):05165         
                      (    forth6809.asm):05166         ; ------------------------------------------------------------
                      (    forth6809.asm):05167         ; ?DO  ( C: -- orig dest )
                      (    forth6809.asm):05168         ; Compile a call to QDOSETUP with a placeholder skip operand. Leave
                      (    forth6809.asm):05169         ; orig (the skip operand address) and TAGQDO, then dest and TAGDO.
                      (    forth6809.asm):05170         ; ------------------------------------------------------------
DC19 CCDC3F           (    forth6809.asm):05171         QDOW:       LDD   #QDOSETUP
DC1C 3606             (    forth6809.asm):05172                     PSHU  D
DC1E BDDD7C           (    forth6809.asm):05173                     JSR   CCALL
DC21 CC0000           (    forth6809.asm):05174                     LDD   #0
DC24 3606             (    forth6809.asm):05175                     PSHU  D
DC26 BDD04B           (    forth6809.asm):05176                     JSR   CODECOMMA
DC29 DC08             (    forth6809.asm):05177                     LDD   CODEHERE
DC2B 830002           (    forth6809.asm):05178                     SUBD  #2
DC2E 3606             (    forth6809.asm):05179                     PSHU  D                 ; orig
DC30 CC0007           (    forth6809.asm):05180                     LDD   #TAGQDO           ; See bugfix: QDOW.1
DC33 3606             (    forth6809.asm):05181                     PSHU  D
DC35 DC08             (    forth6809.asm):05182                     LDD   CODEHERE
DC37 3606             (    forth6809.asm):05183                     PSHU  D                 ; dest
DC39 CC0003           (    forth6809.asm):05184                     LDD   #TAGDO
DC3C 3606             (    forth6809.asm):05185                     PSHU  D
DC3E 39               (    forth6809.asm):05186                     RTS
                      (    forth6809.asm):05187         
                      (    forth6809.asm):05188         ; ------------------------------------------------------------
                      (    forth6809.asm):05189         ; Run-time start of ?DO. If index equals limit, branch over the whole
                      (    forth6809.asm):05190         ; loop; otherwise build the loop frame as DOSETUP does and skip the
                      (    forth6809.asm):05191         ; branch operand.
                      (    forth6809.asm):05192         ; QDOSETUP   ( limit index -- )
                      (    forth6809.asm):05193         ;    Inputs:
                      (    forth6809.asm):05194         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):05195         ;    Outputs:
                      (    forth6809.asm):05196         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):05197         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):05198         ; ------------------------------------------------------------
DC3F 3706             (    forth6809.asm):05199         QDOSETUP:   PULU  D                 ; index
DC41 DD14             (    forth6809.asm):05200                     STD   MSCR
DC43 3706             (    forth6809.asm):05201                     PULU  D                 ; limit
DC45 DD16             (    forth6809.asm):05202                     STD   MSCR2
DC47 3510             (    forth6809.asm):05203                     PULS  X
DC49 DC16             (    forth6809.asm):05204                     LDD   MSCR2
DC4B 109314           (    forth6809.asm):05205                     CMPD  MSCR
DC4E 2607             (    forth6809.asm):05206                     BNE   QDBUILD
DC50 EC84             (    forth6809.asm):05207                     LDD   ,X
DC52 308B             (    forth6809.asm):05208                     LEAX  D,X
DC54 3410             (    forth6809.asm):05209                     PSHS  X
DC56 39               (    forth6809.asm):05210                     RTS
DC57 3002             (    forth6809.asm):05211         QDBUILD:    LEAX  2,X
DC59 CC0000           (    forth6809.asm):05212                     LDD   #0
DC5C 3406             (    forth6809.asm):05213                     PSHS  D
DC5E DC16             (    forth6809.asm):05214                     LDD   MSCR2
DC60 3406             (    forth6809.asm):05215                     PSHS  D
DC62 DC14             (    forth6809.asm):05216                     LDD   MSCR
DC64 3406             (    forth6809.asm):05217                     PSHS  D
DC66 3410             (    forth6809.asm):05218                     PSHS  X
DC68 39               (    forth6809.asm):05219                     RTS
                      (    forth6809.asm):05220         
                      (    forth6809.asm):05221         ; ------------------------------------------------------------
                      (    forth6809.asm):05222         ; UNLOOP  ( -- )
                      (    forth6809.asm):05223         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05224         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05225         ; ------------------------------------------------------------
DC69 3510             (    forth6809.asm):05226         UNLOOPW:    PULS  X
DC6B 3266             (    forth6809.asm):05227                     LEAS  6,S
DC6D 3410             (    forth6809.asm):05228                     PSHS  X
DC6F 39               (    forth6809.asm):05229                     RTS
                      (    forth6809.asm):05230         
                      (    forth6809.asm):05231         ; ------------------------------------------------------------
                      (    forth6809.asm):05232         ; EXIT  ( -- )
                      (    forth6809.asm):05233         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05234         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05235         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05236         ; ------------------------------------------------------------
DC70 108E0000         (    forth6809.asm):05237         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DC74 1F31             (    forth6809.asm):05238                     TFR   U,X               ; X = scan pointer
DC76 9C21             (    forth6809.asm):05239         EXSCAN:     CMPX  CSP
DC78 270E             (    forth6809.asm):05240                     BEQ   EXSCANDONE
DC7A EC84             (    forth6809.asm):05241                     LDD   ,X
DC7C 10830003         (    forth6809.asm):05242                     CMPD  #TAGDO
DC80 2602             (    forth6809.asm):05243                     BNE   EXNOTDO
DC82 3121             (    forth6809.asm):05244                     LEAY  1,Y
DC84 3004             (    forth6809.asm):05245         EXNOTDO:    LEAX  4,X
DC86 20EE             (    forth6809.asm):05246                     BRA   EXSCAN
DC88                  (    forth6809.asm):05247         EXSCANDONE:
DC88 3420             (    forth6809.asm):05248                     PSHS  Y                 ; the count survives CCALL on S
DC8A CCDC9A           (    forth6809.asm):05249                     LDD   #EXITUNLOOP
DC8D 3606             (    forth6809.asm):05250                     PSHU  D
DC8F BDDD7C           (    forth6809.asm):05251                     JSR   CCALL
DC92 3506             (    forth6809.asm):05252                     PULS  D
DC94 3606             (    forth6809.asm):05253                     PSHU  D
DC96 BDD04B           (    forth6809.asm):05254                     JSR   CODECOMMA
DC99 39               (    forth6809.asm):05255                     RTS
                      (    forth6809.asm):05256         
                      (    forth6809.asm):05257         ; ------------------------------------------------------------
                      (    forth6809.asm):05258         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05259         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05260         ; EXITUNLOOP
                      (    forth6809.asm):05261         ;    Inputs:
                      (    forth6809.asm):05262         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05263         ;        address
                      (    forth6809.asm):05264         ;    Outputs:
                      (    forth6809.asm):05265         ;        returns to the caller of the definition
                      (    forth6809.asm):05266         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05267         ; ------------------------------------------------------------
DC9A 3510             (    forth6809.asm):05268         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DC9C 3520             (    forth6809.asm):05269                     PULS  Y                 ; Y = return address
DC9E 6EA4             (    forth6809.asm):05270                     JMP   ,Y
                      (    forth6809.asm):05271         
                      (    forth6809.asm):05272         ; ------------------------------------------------------------
                      (    forth6809.asm):05273         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05274         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05275         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05276         ; ------------------------------------------------------------
DCA0 CC0000           (    forth6809.asm):05277         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
DCA3 3606             (    forth6809.asm):05278                     PSHU  D
DCA5 CC0004           (    forth6809.asm):05279                     LDD   #TAGCASE
DCA8 3606             (    forth6809.asm):05280                     PSHU  D
DCAA 39               (    forth6809.asm):05281                     RTS
                      (    forth6809.asm):05282         
                      (    forth6809.asm):05283         ; ------------------------------------------------------------
                      (    forth6809.asm):05284         ; OF  ( C: -- orig )
                      (    forth6809.asm):05285         ; Compile OVER = ZBRANCH <operand> DROP. Leave orig (the operand
                      (    forth6809.asm):05286         ; address) and TAGOF.
                      (    forth6809.asm):05287         ; ------------------------------------------------------------
DCAB CCDEB0           (    forth6809.asm):05288         OFW:        LDD   #OVERW
DCAE 3606             (    forth6809.asm):05289                     PSHU  D

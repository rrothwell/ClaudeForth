                      (    forth6809.asm):03685         ; ------------------------------------------------------------
                      (    forth6809.asm):03686         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03687         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03688         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03689         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03690         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03691         ; ------------------------------------------------------------
D88C 10AEC4           (    forth6809.asm):03692         FINDW:      LDY   ,U                ; counted string
D88F E6A0             (    forth6809.asm):03693                     LDB   ,Y+
D891 8DBF             (    forth6809.asm):03694                     BSR   SRCHORD
D893 8C0000           (    forth6809.asm):03695                     CMPX  #0
D896 2712             (    forth6809.asm):03696                     BEQ   NOTFOUND
D898 8DE6             (    forth6809.asm):03697                     BSR   HDRXT
D89A AFC4             (    forth6809.asm):03698                     STX   ,U                ; xt replaces c-addr
D89C 4D               (    forth6809.asm):03699                     TSTA
D89D 2A05             (    forth6809.asm):03700                     BPL   FISNORM
D89F CC0001           (    forth6809.asm):03701                     LDD   #1
D8A2 2003             (    forth6809.asm):03702                     BRA   FPUSH
D8A4 CCFFFF           (    forth6809.asm):03703         FISNORM:    LDD   #-1
D8A7 3606             (    forth6809.asm):03704         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D8A9 39               (    forth6809.asm):03705                     RTS
                      (    forth6809.asm):03706         
D8AA CC0000           (    forth6809.asm):03707         NOTFOUND:   LDD   #0
D8AD 3606             (    forth6809.asm):03708                     PSHU  D                 ; 0 = not found, c-addr still beneath
D8AF 39               (    forth6809.asm):03709                     RTS
                      (    forth6809.asm):03710         
                      (    forth6809.asm):03711         ; ------------------------------------------------------------
                      (    forth6809.asm):03712         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03713         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03714         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03715         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03716         ; ------------------------------------------------------------
D8B0 3710             (    forth6809.asm):03717         SEARCHWLW:  PULU  X                 ; wid
D8B2 8D2D             (    forth6809.asm):03718                     BSR   WIDCHK
D8B4 AE84             (    forth6809.asm):03719                     LDX   ,X                ; newest header of the wordlist
D8B6 3706             (    forth6809.asm):03720                     PULU  D                 ; u
D8B8 3720             (    forth6809.asm):03721                     PULU  Y                 ; c-addr
D8BA 4D               (    forth6809.asm):03722                     TSTA
D8BB 261E             (    forth6809.asm):03723                     BNE   SWNOT             ; longer than any name
D8BD C11F             (    forth6809.asm):03724                     CMPB  #31
D8BF 221A             (    forth6809.asm):03725                     BHI   SWNOT
D8C1 BDD815           (    forth6809.asm):03726                     JSR   FDSEARCH
D8C4 8C0000           (    forth6809.asm):03727                     CMPX  #0
D8C7 2712             (    forth6809.asm):03728                     BEQ   SWNOT
D8C9 8DB5             (    forth6809.asm):03729                     BSR   HDRXT
D8CB 3610             (    forth6809.asm):03730                     PSHU  X                 ; xt
D8CD 4D               (    forth6809.asm):03731                     TSTA
D8CE 2A05             (    forth6809.asm):03732                     BPL   SWNORM
D8D0 CC0001           (    forth6809.asm):03733                     LDD   #1
D8D3 2003             (    forth6809.asm):03734                     BRA   SWPUSH
D8D5 CCFFFF           (    forth6809.asm):03735         SWNORM:     LDD   #-1
D8D8 3606             (    forth6809.asm):03736         SWPUSH:     PSHU  D
D8DA 39               (    forth6809.asm):03737                     RTS
D8DB CC0000           (    forth6809.asm):03738         SWNOT:      LDD   #0
D8DE 3606             (    forth6809.asm):03739                     PSHU  D

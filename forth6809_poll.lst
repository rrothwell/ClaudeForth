                      (    forth6809.asm):09256         ; ------------------------------------------------------------
                      (    forth6809.asm):09257         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09258         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09259         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09260         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09261         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09262         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09263         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09264         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09265         ; available the skip ends.
                      (    forth6809.asm):09266         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09267         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09268         ; ------------------------------------------------------------

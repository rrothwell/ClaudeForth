                      (    forth6809.asm):03186         ; ============================================================
                      (    forth6809.asm):03187         ; SECTION 9: OUTER INTERPRETER (INTERPRET / WORD / FIND / NUMBER?)
                      (    forth6809.asm):03188         ; ============================================================
                      (    forth6809.asm):03189         ; ------------------------------------------------------------
                      (    forth6809.asm):03190         ; INTERPRET  ( -- )
                      (    forth6809.asm):03191         ; Interpret the rest of the input source: parse each word and look it
                      (    forth6809.asm):03192         ; up. A found word is executed, or compiled when STATE is compile and
                      (    forth6809.asm):03193         ; it is not immediate. Anything else is converted as a single or
                      (    forth6809.asm):03194         ; double number (compiled as literals when compiling). An unknown word
                      (    forth6809.asm):03195         ; is typed and THROW -13 is raised.
                      (    forth6809.asm):03196         ; ------------------------------------------------------------
E09C                  (    forth6809.asm):03197         INTERPRET:
E09C CC0020           (    forth6809.asm):03198         ILOOP:      LDD   #32               ; Delimiter: space. See bugfix: INTERPRET.1
E09F 3606             (    forth6809.asm):03199                     PSHU  D                 ; char
E0A1 BDE11C           (    forth6809.asm):03200                     JSR   WORDW
E0A4 AEC4             (    forth6809.asm):03201                     LDX   ,U
E0A6 A684             (    forth6809.asm):03202                     LDA   ,X
E0A8 276F             (    forth6809.asm):03203                     BEQ   IDONE
                      (    forth6809.asm):03204         
E0AA BDE18E           (    forth6809.asm):03205                     JSR   FINDW
E0AD 3706             (    forth6809.asm):03206                     PULU  D
E0AF 5D               (    forth6809.asm):03207                     TSTB
E0B0 10270011         (    forth6809.asm):03208                     LBEQ  TRYNUM
                      (    forth6809.asm):03209         
E0B4 9601             (    forth6809.asm):03210                     LDA   STATE+1
E0B6 2708             (    forth6809.asm):03211                     BEQ   DOEXEC
E0B8 5D               (    forth6809.asm):03212                     TSTB
E0B9 2A05             (    forth6809.asm):03213                     BPL   DOEXEC
E0BB BDE85D           (    forth6809.asm):03214                     JSR   CCALL
E0BE 20DC             (    forth6809.asm):03215                     BRA   ILOOP
                      (    forth6809.asm):03216         
E0C0 BDDD81           (    forth6809.asm):03217         DOEXEC:     JSR   EXECUTEW
E0C3 20D7             (    forth6809.asm):03218                     BRA   ILOOP
                      (    forth6809.asm):03219         
E0C5 BDE266           (    forth6809.asm):03220         TRYNUM:     JSR   NUMBERQ
E0C8 3706             (    forth6809.asm):03221                     PULU  D
E0CA 10830000         (    forth6809.asm):03222                     CMPD  #0                ; flag (PULU does not set CC)
E0CE 273B             (    forth6809.asm):03223                     BEQ   BADWORD
                      (    forth6809.asm):03224         
E0D0 10830001         (    forth6809.asm):03225                     CMPD  #1                ; 1 = double-number result
E0D4 2711             (    forth6809.asm):03226                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03227         
E0D6 DC00             (    forth6809.asm):03228                     LDD   STATE
E0D8 27C2             (    forth6809.asm):03229                     BEQ   ILOOP
E0DA CCDD0F           (    forth6809.asm):03230                     LDD   #LIT
E0DD 3606             (    forth6809.asm):03231                     PSHU  D
E0DF BDE85D           (    forth6809.asm):03232                     JSR   CCALL
E0E2 BDDDA2           (    forth6809.asm):03233                     JSR   CODECOMMA
E0E5 20B5             (    forth6809.asm):03234                     BRA   ILOOP
                      (    forth6809.asm):03235         
E0E7                  (    forth6809.asm):03236         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03237                                             ; ANS's (ud1) stack order directly.
E0E7 DC00             (    forth6809.asm):03238                     LDD   STATE
E0E9 27B1             (    forth6809.asm):03239                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03240                                             ; nothing more to do
                      (    forth6809.asm):03241                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03242                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03243                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03244                     ; pop it aside first, freeing UDLO to be compiled first.
E0EB 3706             (    forth6809.asm):03245                     PULU  D
E0ED DD1A             (    forth6809.asm):03246                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03247                                             ; untouched by CCALL/CODECOMMA
E0EF CCDD0F           (    forth6809.asm):03248                     LDD   #LIT
E0F2 3606             (    forth6809.asm):03249                     PSHU  D
E0F4 BDE85D           (    forth6809.asm):03250                     JSR   CCALL

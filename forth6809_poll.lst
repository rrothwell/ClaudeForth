D5F4 3606             (    forth6809.asm):03899                     PSHU  D
D5F6 20F5             (    forth6809.asm):03900                     BRA   GOLOOP
D5F8 DC49             (    forth6809.asm):03901         GODONE:     LDD   ORDEND
D5FA 83004B           (    forth6809.asm):03902                     SUBD  #ORDER
D5FD 44               (    forth6809.asm):03903                     LSRA
D5FE 56               (    forth6809.asm):03904                     RORB
D5FF 3606             (    forth6809.asm):03905                     PSHU  D                 ; n
D601 39               (    forth6809.asm):03906                     RTS
                      (    forth6809.asm):03907         
                      (    forth6809.asm):03908         ; ------------------------------------------------------------
                      (    forth6809.asm):03909         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03910         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03911         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03912         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03913         ; ------------------------------------------------------------
D602 3706             (    forth6809.asm):03914         SETORDERW:  PULU  D                 ; n
D604 1083FFFF         (    forth6809.asm):03915                     CMPD  #-1
D608 275D             (    forth6809.asm):03916                     BEQ   ONLYW             ; the minimum order
D60A 4D               (    forth6809.asm):03917         SO1:        TSTA
D60B 2B31             (    forth6809.asm):03918                     BMI   SOUNDER
D60D 262A             (    forth6809.asm):03919                     BNE   SOOVER
D60F C108             (    forth6809.asm):03920                     CMPB  #WLMAX
D611 2226             (    forth6809.asm):03921                     BHI   SOOVER
D613 3404             (    forth6809.asm):03922                     PSHS  B                 ; 1,S = n
D615 3404             (    forth6809.asm):03923                     PSHS  B                 ; 0,S = count down
D617 1F32             (    forth6809.asm):03924                     TFR   U,Y
D619 6DE4             (    forth6809.asm):03925         SOCHK:      TST   ,S
D61B 2709             (    forth6809.asm):03926                     BEQ   SOCOPY

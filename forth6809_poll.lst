D2B6 20D7             (    forth6809.asm):03548                     BRA   ILOOP
                      (    forth6809.asm):03549         
D2B8 BDD6A0           (    forth6809.asm):03550         TRYNUM:     JSR   NUMBERQ
D2BB 3706             (    forth6809.asm):03551                     PULU  D
D2BD 10830000         (    forth6809.asm):03552                     CMPD  #0                ; flag (PULU does not set CC)
D2C1 273B             (    forth6809.asm):03553                     BEQ   BADWORD
                      (    forth6809.asm):03554         
D2C3 10830001         (    forth6809.asm):03555                     CMPD  #1                ; 1 = double-number result
D2C7 2711             (    forth6809.asm):03556                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03557         
D2C9 DC00             (    forth6809.asm):03558                     LDD   STATE
D2CB 27C2             (    forth6809.asm):03559                     BEQ   ILOOP
D2CD CCCEC0           (    forth6809.asm):03560                     LDD   #LIT
D2D0 3606             (    forth6809.asm):03561                     PSHU  D
D2D2 BDDCD0           (    forth6809.asm):03562                     JSR   CCALL
D2D5 BDCF66           (    forth6809.asm):03563                     JSR   CODECOMMA
D2D8 20B5             (    forth6809.asm):03564                     BRA   ILOOP
                      (    forth6809.asm):03565         
D2DA                  (    forth6809.asm):03566         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03567                                             ; ANS's (ud1) stack order directly.
D2DA DC00             (    forth6809.asm):03568                     LDD   STATE
D2DC 27B1             (    forth6809.asm):03569                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03570                                             ; nothing more to do
                      (    forth6809.asm):03571                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03572                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03573                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03574                     ; pop it aside first, freeing UDLO to be compiled first.
D2DE 3706             (    forth6809.asm):03575                     PULU  D
D2E0 DD1A             (    forth6809.asm):03576                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03577                                             ; untouched by CCALL/CODECOMMA
D2E2 CCCEC0           (    forth6809.asm):03578                     LDD   #LIT
D2E5 3606             (    forth6809.asm):03579                     PSHU  D
D2E7 BDDCD0           (    forth6809.asm):03580                     JSR   CCALL
D2EA BDCF66           (    forth6809.asm):03581                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
D2ED CCCEC0           (    forth6809.asm):03582                     LDD   #LIT
D2F0 3606             (    forth6809.asm):03583                     PSHU  D
D2F2 BDDCD0           (    forth6809.asm):03584                     JSR   CCALL
D2F5 DC1A             (    forth6809.asm):03585                     LDD   MSCR4

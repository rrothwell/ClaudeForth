                      (    forth6809.asm):06936         ; CONVERT  ( ud1 c-addr1 -- ud2 c-addr2 )
                      (    forth6809.asm):06937         ; Obsolescent. Convert the digits after c-addr1 using >NUMBER with no
                      (    forth6809.asm):06938         ; length limit; c-addr2 is the first character that is not a digit.
                      (    forth6809.asm):06939         ; ------------------------------------------------------------
F3D7 ECC4             (    forth6809.asm):06940         CONVERTW:   LDD   ,U
F3D9 C30001           (    forth6809.asm):06941                     ADDD  #1
F3DC EDC4             (    forth6809.asm):06942                     STD   ,U                ; skip the character at c-addr1
F3DE CCFFFF           (    forth6809.asm):06943                     LDD   #$FFFF

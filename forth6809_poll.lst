DA5F                  (    forth6809.asm):02002         CHKHIDONE:  RTS
                      (    forth6809.asm):02003         
                      (    forth6809.asm):02004         ; ------------------------------------------------------------
                      (    forth6809.asm):02005         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02006         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02007         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02008         ; CHKLO
                      (    forth6809.asm):02009         ;    Inputs:
                      (    forth6809.asm):02010         ;        RegB = input ring fill level
                      (    forth6809.asm):02011         ;    Outputs:
                      (    forth6809.asm):02012         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02013         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02014         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):02015         CHKLO:
                      (    forth6809.asm):02016                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02017                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02018                     TST   RTSSTATE
                      (    forth6809.asm):02019                     BEQ   CHKLODONE         ; already low - nothing to do

D7F2 D71E             (    forth6809.asm):04548                     STB   EMITCH
D7F4 B6C008           (    forth6809.asm):04549         EMITWT:     LDA   ACIASR
D7F7 8502             (    forth6809.asm):04550                     BITA  #SR_TDRE
D7F9 27F9             (    forth6809.asm):04551                     BEQ   EMITWT
D7FB 961E             (    forth6809.asm):04552                     LDA   EMITCH

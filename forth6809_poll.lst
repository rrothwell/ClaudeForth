D198 9F0A             (    forth6809.asm):03174                     STX   VARHERE
D19A 39               (    forth6809.asm):03175                     RTS
                      (    forth6809.asm):03176         
                      (    forth6809.asm):03177         ; ------------------------------------------------------------
                      (    forth6809.asm):03178         ; @  ( a-addr -- x )
                      (    forth6809.asm):03179         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03180         ; ------------------------------------------------------------
D19B 3710             (    forth6809.asm):03181         FETCHW:     PULU  X                 ; a-addr
D19D EC84             (    forth6809.asm):03182                     LDD   ,X
D19F 3606             (    forth6809.asm):03183                     PSHU  D                 ; x
D1A1 39               (    forth6809.asm):03184                     RTS
                      (    forth6809.asm):03185         
                      (    forth6809.asm):03186         ; ------------------------------------------------------------
                      (    forth6809.asm):03187         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03188         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03189         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03190         ; ------------------------------------------------------------
D1A2 CCD19B           (    forth6809.asm):03191         CONSTANTW:  LDD   #FETCHW
D1A5 BDD154           (    forth6809.asm):03192                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D1A8 BDD045           (    forth6809.asm):03193                     JSR   COMMAW
D1AB 39               (    forth6809.asm):03194                     RTS
                      (    forth6809.asm):03195         
                      (    forth6809.asm):03196         ; ------------------------------------------------------------
                      (    forth6809.asm):03197         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03198         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03199         ;    Inputs:
                      (    forth6809.asm):03200         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03201         ;    Outputs:
                      (    forth6809.asm):03202         ;        pfa replaced by the value
                      (    forth6809.asm):03203         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03204         ; ------------------------------------------------------------
D1AC 3710             (    forth6809.asm):03205         DOVALUE:    PULU  X                 ; pfa
D1AE EC84             (    forth6809.asm):03206                     LDD   ,X
D1B0 3606             (    forth6809.asm):03207                     PSHU  D                 ; x
D1B2 39               (    forth6809.asm):03208                     RTS
                      (    forth6809.asm):03209         
                      (    forth6809.asm):03210         ; ------------------------------------------------------------
                      (    forth6809.asm):03211         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03212         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03213         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03214         ; ------------------------------------------------------------
D1B3 CCD1AC           (    forth6809.asm):03215         VALUEW:     LDD   #DOVALUE
D1B6 BDD13A           (    forth6809.asm):03216                     JSR   BLDDOES
D1B9 DC0A             (    forth6809.asm):03217                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D1BB 3606             (    forth6809.asm):03218                     PSHU  D                 ; See bugfix: VALUEW.1
D1BD BDD04B           (    forth6809.asm):03219                     JSR   CODECOMMA
D1C0 BDD05D           (    forth6809.asm):03220                     JSR   VCOMMAW           ; store x in the variable area
D1C3 39               (    forth6809.asm):03221                     RTS
                      (    forth6809.asm):03222         
                      (    forth6809.asm):03223         ; ------------------------------------------------------------
                      (    forth6809.asm):03224         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03225         ; lower address as 2@ expects.
                      (    forth6809.asm):03226         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03227         ; ------------------------------------------------------------
D1C4 7EE73D           (    forth6809.asm):03228         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03229         
                      (    forth6809.asm):03230         ; ------------------------------------------------------------
                      (    forth6809.asm):03231         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03232         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03233         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03234         ; ------------------------------------------------------------
D1C7 CCD1C4           (    forth6809.asm):03235         TWOVALUEW:  LDD   #DO2VALUE
D1CA BDD13A           (    forth6809.asm):03236                     JSR   BLDDOES
D1CD DC0A             (    forth6809.asm):03237                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D1CF 3606             (    forth6809.asm):03238                     PSHU  D
D1D1 BDD04B           (    forth6809.asm):03239                     JSR   CODECOMMA
D1D4 BDD05D           (    forth6809.asm):03240                     JSR   VCOMMAW           ; x2 at the lower address
D1D7 BDD05D           (    forth6809.asm):03241                     JSR   VCOMMAW           ; then x1
D1DA 39               (    forth6809.asm):03242                     RTS
                      (    forth6809.asm):03243         
                      (    forth6809.asm):03244         ; ------------------------------------------------------------
                      (    forth6809.asm):03245         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03246         ; Store x in the named VALUE. When compiling, instead compile code to

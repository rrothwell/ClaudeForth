                      (    forth6809.asm):04234         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):04235         ; to 0 and >IN to 0.
                      (    forth6809.asm):04236         ; ------------------------------------------------------------

DF16 ECC4             (    forth6809.asm):05730         DSWAPW:     LDD   ,U                ; x4
DF18 DD14             (    forth6809.asm):05731                     STD   MSCR
DF1A EC42             (    forth6809.asm):05732                     LDD   2,U               ; x3
DF1C AE44             (    forth6809.asm):05733                     LDX   4,U               ; x2
DF1E 10AE46           (    forth6809.asm):05734                     LDY   6,U               ; x1
DF21 ED46             (    forth6809.asm):05735                     STD   6,U
DF23 AFC4             (    forth6809.asm):05736                     STX   ,U
DF25 10AF42           (    forth6809.asm):05737                     STY   2,U

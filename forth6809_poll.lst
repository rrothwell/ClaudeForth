                      (    forth6809.asm):05308         ; UNLOOP  ( -- )
                      (    forth6809.asm):05309         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05310         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05311         ; ------------------------------------------------------------

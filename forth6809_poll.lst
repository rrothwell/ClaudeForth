                      (    forth6809.asm):00336         
0179                  (    forth6809.asm):00337         OUTHEAD     RMB   1
017A                  (    forth6809.asm):00338         OUTTAIL     RMB   1
017B                  (    forth6809.asm):00339         OUTACTIVITY RMB   1                 ; $00 = Idle, $FF = Busy (tx_active)
                      (    forth6809.asm):00340         
017C                  (    forth6809.asm):00341         FECOUNT     RMB   1                 ; framing errors
017D                  (    forth6809.asm):00342         OVRNCOUNT   RMB   1                 ; overrun count, same as above

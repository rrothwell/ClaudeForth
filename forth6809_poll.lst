EDD1 39               (    forth6809.asm):08635                     RTS
                      (    forth6809.asm):08636         
                      (    forth6809.asm):08637         ; ------------------------------------------------------------
                      (    forth6809.asm):08638         ; SIGN  ( n -- )
                      (    forth6809.asm):08639         ; If n is negative, add a minus sign to the pictured numeric output
                      (    forth6809.asm):08640         ; string.
                      (    forth6809.asm):08641         ; ------------------------------------------------------------

                      (    forth6809.asm):08173         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08174         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08175         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08176         ; the value and true; otherwise return false. WORDLISTS is
                      (    forth6809.asm):08177         ; deliberately absent because the Search-Order word set is not
                      (    forth6809.asm):08178         ; implemented. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08179         ; division.
                      (    forth6809.asm):08180         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08181         ; ------------------------------------------------------------
FB02 3706             (    forth6809.asm):08182         ENVQW:      PULU  D                 ; u
FB04 3406             (    forth6809.asm):08183                     PSHS  D                 ; frame: 2,S = u, 0,S = c-addr (5k)
FB06 3706             (    forth6809.asm):08184                     PULU  D                 ; c-addr
FB08 3406             (    forth6809.asm):08185                     PSHS  D
FB0A 8EFBA3           (    forth6809.asm):08186                     LDX   #ENVTABLE

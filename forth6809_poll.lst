                      (    forth6809.asm):05471         ; ------------------------------------------------------------
                      (    forth6809.asm):05472         ; [  ( -- )
                      (    forth6809.asm):05473         ; Enter interpretation state: STATE = 0.
                      (    forth6809.asm):05474         ; ------------------------------------------------------------
DD13 CC0000           (    forth6809.asm):05475         LBRACKETW:  LDD   #0
DD16 DD00             (    forth6809.asm):05476                     STD   STATE
DD18 39               (    forth6809.asm):05477                     RTS
                      (    forth6809.asm):05478         

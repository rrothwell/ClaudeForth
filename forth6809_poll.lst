                      (    forth6809.asm):01912         
                      (    forth6809.asm):01913                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):01914         ; ------------------------------------------------------------
                      (    forth6809.asm):01915         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):01916         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):01917         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):01918         ; INFILL
                      (    forth6809.asm):01919         ;    Inputs:
                      (    forth6809.asm):01920         ;        none
                      (    forth6809.asm):01921         ;    Outputs:
                      (    forth6809.asm):01922         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):01923         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01924         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):01925         INFILL:     LDA   INHEAD
                      (    forth6809.asm):01926                     SUBA  INTAIL
                      (    forth6809.asm):01927                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):01928                     RTS
                      (    forth6809.asm):01929         ; ------------------------------------------------------------
                      (    forth6809.asm):01930         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):01931         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):01932         ; receive path with interrupts already masked.
                      (    forth6809.asm):01933         ; RTSCHECKHI
                      (    forth6809.asm):01934         ;    Inputs:
                      (    forth6809.asm):01935         ;        none
                      (    forth6809.asm):01936         ;    Outputs:
                      (    forth6809.asm):01937         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):01938         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01939         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):01940         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):01941                     CMPA  #INHIWATER
                      (    forth6809.asm):01942                     BLO   RTSCHIDONE
                      (    forth6809.asm):01943                     TST   RTSSTATE
                      (    forth6809.asm):01944                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):01945                     LDA   #CR_RTSHI
                      (    forth6809.asm):01946                     STA   ACIACR
                      (    forth6809.asm):01947                     LDA   #1
                      (    forth6809.asm):01948                     STA   RTSSTATE
DA5F                  (    forth6809.asm):01949         RTSCHIDONE: RTS
                      (    forth6809.asm):01950         ; ------------------------------------------------------------
                      (    forth6809.asm):01951         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):01952         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):01953         ; enables it only while output is pending.
                      (    forth6809.asm):01954         ; UPDATE_RTS
                      (    forth6809.asm):01955         ;    Inputs:
                      (    forth6809.asm):01956         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):01957         ;    Outputs:
                      (    forth6809.asm):01958         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):01959         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01960         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):01961         UPDATE_RTS:
                      (    forth6809.asm):01962                     TST   RTSSTATE
                      (    forth6809.asm):01963                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):01964         
                      (    forth6809.asm):01965                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):01966                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):01967         
                      (    forth6809.asm):01968                                             ; $B5/%1011_0101
                      (    forth6809.asm):01969                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):01970                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):01971         
DA5F                  (    forth6809.asm):01972         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):01973                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):01974                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):01975         
DA5F                  (    forth6809.asm):01976         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):01977                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):01978                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
DA5F                  (    forth6809.asm):01979         WRITE_CR:
                      (    forth6809.asm):01980                     STA   ACIACR
                      (    forth6809.asm):01981                     RTS
                      (    forth6809.asm):01982         ; ------------------------------------------------------------
                      (    forth6809.asm):01983         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):01984         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):01985         ; Called after a character is added to the ring.
                      (    forth6809.asm):01986         ; CHKHI
                      (    forth6809.asm):01987         ;    Inputs:
                      (    forth6809.asm):01988         ;        RegB = input ring fill level
                      (    forth6809.asm):01989         ;    Outputs:
                      (    forth6809.asm):01990         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):01991         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01992         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):01993         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):01994         CHKHI:
                      (    forth6809.asm):01995                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):01996                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):01997                     TST   RTSSTATE
                      (    forth6809.asm):01998                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):01999                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02000                     STA   RTSSTATE

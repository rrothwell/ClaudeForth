DD4A 9F08             (    forth6809.asm):05526                     STX   CODEHERE
DD4C 39               (    forth6809.asm):05527                     RTS
                      (    forth6809.asm):05528         
                      (    forth6809.asm):05529         ; ------------------------------------------------------------
                      (    forth6809.asm):05530         ; LITERAL  ( x -- )
                      (    forth6809.asm):05531         ; Compile LIT followed by x, so that x is pushed when the definition
                      (    forth6809.asm):05532         ; runs.
                      (    forth6809.asm):05533         ; ------------------------------------------------------------
DD4D CCCF30           (    forth6809.asm):05534         LITERALW:   LDD   #LIT

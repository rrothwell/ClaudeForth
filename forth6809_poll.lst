                      (    forth6809.asm):05743         ; 2OVER  ( x1 x2 x3 x4 -- x1 x2 x3 x4 x1 x2 )
                      (    forth6809.asm):05744         ; Copy the second cell pair to the top.
                      (    forth6809.asm):05745         ; ------------------------------------------------------------
DF2D EC46             (    forth6809.asm):05746         DOVERW:     LDD   6,U               ; x1
DF2F AE44             (    forth6809.asm):05747                     LDX   4,U               ; x2
DF31 3606             (    forth6809.asm):05748                     PSHU  D
DF33 3610             (    forth6809.asm):05749                     PSHU  X
DF35 39               (    forth6809.asm):05750                     RTS
                      (    forth6809.asm):05751         
                      (    forth6809.asm):05752         ; ------------------------------------------------------------
                      (    forth6809.asm):05753         ; NIP  ( x1 x2 -- x2 )

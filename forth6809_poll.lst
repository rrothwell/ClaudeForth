                      (    forth6809.asm):06638         ; CMOVE  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06639         ; Copy u bytes from c-addr1 to c-addr2, starting at the low addresses.
                      (    forth6809.asm):06640         ; ------------------------------------------------------------
F246 ECC4             (    forth6809.asm):06641         CMOVEW:     LDD   ,U                ; u. Parameters stay on the data stack,
F248 2713             (    forth6809.asm):06642                     BEQ   CMDONE            ; addressed relative to U: u at 0, c-addr2
F24A AE44             (    forth6809.asm):06643                     LDX   4,U               ; at 2, c-addr1 at 4. See shadow CMOVEW.2
F24C 308B             (    forth6809.asm):06644                     LEAX  D,X               ; end address = c-addr1 + u
F24E AFC4             (    forth6809.asm):06645                     STX   ,U                ; keep it in u's old slot as the loop limit
F250 AE44             (    forth6809.asm):06646                     LDX   4,U               ; X = source
F252 10AE42           (    forth6809.asm):06647                     LDY   2,U               ; Y = destination
F255 A680             (    forth6809.asm):06648         CMVLOOP:    LDA   ,X+
F257 A7A0             (    forth6809.asm):06649                     STA   ,Y+
F259 ACC4             (    forth6809.asm):06650                     CMPX  ,U                ; reached the end address?
F25B 26F8             (    forth6809.asm):06651                     BNE   CMVLOOP
F25D 3346             (    forth6809.asm):06652         CMDONE:     LEAU  6,U               ; drop the three parameters
F25F 39               (    forth6809.asm):06653                     RTS
                      (    forth6809.asm):06654         
                      (    forth6809.asm):06655         ; ------------------------------------------------------------
                      (    forth6809.asm):06656         ; CMOVE>  ( c-addr1 c-addr2 u -- )
                      (    forth6809.asm):06657         ; Copy u bytes from c-addr1 to c-addr2, starting at the high
                      (    forth6809.asm):06658         ; addresses.
                      (    forth6809.asm):06659         ; ------------------------------------------------------------
F260 ECC4             (    forth6809.asm):06660         CMOVEGTW:   LDD   ,U                ; u. Parameters stay on the data stack:
F262 2711             (    forth6809.asm):06661                     BEQ   CGDONE            ; u at 0, c-addr2 at 2, c-addr1 at 4
F264 AE44             (    forth6809.asm):06662                     LDX   4,U
F266 308B             (    forth6809.asm):06663                     LEAX  D,X               ; X = one past the end of the source
F268 10AE42           (    forth6809.asm):06664                     LDY   2,U
F26B 31AB             (    forth6809.asm):06665                     LEAY  D,Y               ; Y = one past the end of the destination
F26D A682             (    forth6809.asm):06666         CGLOOP:     LDA   ,-X
F26F A7A2             (    forth6809.asm):06667                     STA   ,-Y
F271 AC44             (    forth6809.asm):06668                     CMPX  4,U               ; back at the start of the source?
F273 26F8             (    forth6809.asm):06669                     BNE   CGLOOP
F275 3346             (    forth6809.asm):06670         CGDONE:     LEAU  6,U               ; drop the three parameters
F277 39               (    forth6809.asm):06671                     RTS
                      (    forth6809.asm):06672         
                      (    forth6809.asm):06673         ; ------------------------------------------------------------
                      (    forth6809.asm):06674         ; MOVE  ( addr1 addr2 u -- )

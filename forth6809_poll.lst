                      (    forth6809.asm):07689         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07690         ; ------------------------------------------------------------
E8EE 3510             (    forth6809.asm):07691         DOTSTR:     PULS  X
E8F0 E684             (    forth6809.asm):07692                     LDB   ,X

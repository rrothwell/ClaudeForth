                      (    forth6809.asm):07537         ; ------------------------------------------------------------
                      (    forth6809.asm):07538         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):07539         ; address and length and skip over it.
                      (    forth6809.asm):07540         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):07541         ;    Inputs:
                      (    forth6809.asm):07542         ;        return address on S points at the count byte
                      (    forth6809.asm):07543         ;    Outputs:
                      (    forth6809.asm):07544         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):07545         ;        string
                      (    forth6809.asm):07546         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07547         ; ------------------------------------------------------------
E701 3510             (    forth6809.asm):07548         DOSTR:      PULS  X
E703 E684             (    forth6809.asm):07549                     LDB   ,X
E705 3001             (    forth6809.asm):07550                     LEAX  1,X
E707 3610             (    forth6809.asm):07551                     PSHU  X
E709 4F               (    forth6809.asm):07552                     CLRA
E70A 3606             (    forth6809.asm):07553                     PSHU  D
E70C 3085             (    forth6809.asm):07554                     LEAX  B,X
E70E 3410             (    forth6809.asm):07555                     PSHS  X
E710 39               (    forth6809.asm):07556                     RTS
                      (    forth6809.asm):07557         
                      (    forth6809.asm):07558         ; ------------------------------------------------------------
                      (    forth6809.asm):07559         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07560         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07561         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07562         ; PARSEQUOTE
                      (    forth6809.asm):07563         ;    Inputs:
                      (    forth6809.asm):07564         ;        none (parses from >IN)
                      (    forth6809.asm):07565         ;    Outputs:
                      (    forth6809.asm):07566         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07567         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07568         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07569         ; ------------------------------------------------------------
E711 CC0022           (    forth6809.asm):07570         PARSEQUOTE: LDD   #34
E714 3606             (    forth6809.asm):07571                     PSHU  D
E716 BDE8E7           (    forth6809.asm):07572                     JSR   PARSEW
E719 6DC4             (    forth6809.asm):07573                     TST   ,U                ; high byte of the length
E71B 2601             (    forth6809.asm):07574                     BNE   PQLONG
E71D 39               (    forth6809.asm):07575                     RTS
E71E CCFFEE           (    forth6809.asm):07576         PQLONG:     LDD   #-18
E721 3606             (    forth6809.asm):07577                     PSHU  D
E723 7ED895           (    forth6809.asm):07578                     JMP   THROWW
                      (    forth6809.asm):07579         
                      (    forth6809.asm):07580         ; ------------------------------------------------------------
                      (    forth6809.asm):07581         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07582         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07583         ;    Inputs:
                      (    forth6809.asm):07584         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07585         ;        c-addr u on the data stack
                      (    forth6809.asm):07586         ;    Outputs:
                      (    forth6809.asm):07587         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07588         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07589         ; ------------------------------------------------------------
E726 3606             (    forth6809.asm):07590         CSTRCOMP:   PSHU  D
E728 BDDCD0           (    forth6809.asm):07591                     JSR   CCALL
E72B 3706             (    forth6809.asm):07592                     PULU  D                 ; u
E72D 3720             (    forth6809.asm):07593                     PULU  Y                 ; c-addr
E72F 9E08             (    forth6809.asm):07594                     LDX   CODEHERE
E731 E780             (    forth6809.asm):07595                     STB   ,X+
E733 5D               (    forth6809.asm):07596                     TSTB
E734 2707             (    forth6809.asm):07597                     BEQ   CSEND
E736 A6A0             (    forth6809.asm):07598         CSCPY:      LDA   ,Y+
E738 A780             (    forth6809.asm):07599                     STA   ,X+
E73A 5A               (    forth6809.asm):07600                     DECB
E73B 26F9             (    forth6809.asm):07601                     BNE   CSCPY
E73D 9F08             (    forth6809.asm):07602         CSEND:      STX   CODEHERE
E73F 39               (    forth6809.asm):07603                     RTS
                      (    forth6809.asm):07604         
                      (    forth6809.asm):07605         ; ------------------------------------------------------------
                      (    forth6809.asm):07606         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07607         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07608         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07609         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07610         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07611         ; ------------------------------------------------------------
E740 BDE711           (    forth6809.asm):07612         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
E743 DC00             (    forth6809.asm):07613         SQSTATE:    LDD   STATE
E745 2706             (    forth6809.asm):07614                     BEQ   SQINTERP
E747 CCE701           (    forth6809.asm):07615                     LDD   #DOSTR
E74A 7EE726           (    forth6809.asm):07616                     JMP   CSTRCOMP
                      (    forth6809.asm):07617         
                      (    forth6809.asm):07618                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):07619                     ; SQUOTEW.2.
E74D                  (    forth6809.asm):07620         SQINTERP:
E74D BDCFA0           (    forth6809.asm):07621                     JSR   PADW
E750 3710             (    forth6809.asm):07622                     PULU  X                 ; PAD
E752 3706             (    forth6809.asm):07623                     PULU  D                 ; u
E754 3720             (    forth6809.asm):07624                     PULU  Y                 ; c-addr
E756 3610             (    forth6809.asm):07625                     PSHU  X                 ; result c-addr
E758 3606             (    forth6809.asm):07626                     PSHU  D                 ; result u
E75A 5D               (    forth6809.asm):07627                     TSTB
E75B 2707             (    forth6809.asm):07628                     BEQ   SQIEND
E75D A6A0             (    forth6809.asm):07629         SQICPY:     LDA   ,Y+
E75F A780             (    forth6809.asm):07630                     STA   ,X+
E761 5A               (    forth6809.asm):07631                     DECB
E762 26F9             (    forth6809.asm):07632                     BNE   SQICPY
E764 39               (    forth6809.asm):07633         SQIEND:     RTS
                      (    forth6809.asm):07634         
                      (    forth6809.asm):07635         ; ------------------------------------------------------------
                      (    forth6809.asm):07636         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07637         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07638         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07639         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07640         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07641         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07642         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07643         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07644         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07645         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07646         ; ------------------------------------------------------------

E849 2706             (    forth6809.asm):07586                     BEQ   SQEPUT            ; not in the table: stands for itself
E84B A181             (    forth6809.asm):07587                     CMPA  ,X++
E84D 26F8             (    forth6809.asm):07588                     BNE   SQEFND
E84F A61F             (    forth6809.asm):07589                     LDA   -1,X
E851 AE64             (    forth6809.asm):07590         SQEPUT:     LDX   4,S
E853 A780             (    forth6809.asm):07591                     STA   ,X+
E855 AF64             (    forth6809.asm):07592                     STX   4,S
E857 20CD             (    forth6809.asm):07593                     BRA   SQEL
E859 AE64             (    forth6809.asm):07594         SQEM:       LDX   4,S
E85B 860D             (    forth6809.asm):07595                     LDA   #13
E85D A780             (    forth6809.asm):07596                     STA   ,X+
E85F 860A             (    forth6809.asm):07597                     LDA   #10
E861 A780             (    forth6809.asm):07598                     STA   ,X+
E863 AF64             (    forth6809.asm):07599                     STX   4,S
E865 20BF             (    forth6809.asm):07600                     BRA   SQEL
E867 8D1A             (    forth6809.asm):07601         SQEHEX:     BSR   SQEHD             ; first digit
E869 25BB             (    forth6809.asm):07602                     BCS   SQEL              ; none: nothing is added

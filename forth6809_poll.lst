                      (    forth6809.asm):03850         ; ------------------------------------------------------------
                      (    forth6809.asm):03851         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03852         ; Return the search order: wid1 is searched first. ROOT is not part of

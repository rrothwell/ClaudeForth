                      (    forth6809.asm):00325         ; Ring buffers for serial communications.
                      (    forth6809.asm):00326         ; One for input, one for output.
                      (    forth6809.asm):00327         ; The 64 byte alignment is supposed to allow some speed tricks.
                      (    forth6809.asm):00328         ; The tricks are not used.
                      (    forth6809.asm):00329         ; ------------------------------------------------------------

                      (    forth6809.asm):05650         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05651         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05652         ; the string.
                      (    forth6809.asm):05653         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05654         ;    Inputs:
                      (    forth6809.asm):05655         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05656         ;        count byte
                      (    forth6809.asm):05657         ;    Outputs:
                      (    forth6809.asm):05658         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05659         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05660         ; ------------------------------------------------------------
DE0D                  (    forth6809.asm):05661         DOABORTQUOTE:
DE0D 3510             (    forth6809.asm):05662                     PULS  X
DE0F E684             (    forth6809.asm):05663                     LDB   ,X
DE11 3001             (    forth6809.asm):05664                     LEAX  1,X               ; X = text, B = length
DE13 4F               (    forth6809.asm):05665                     CLRA
DE14 3720             (    forth6809.asm):05666                     PULU  Y                 ; flag
DE16 108C0000         (    forth6809.asm):05667                     CMPY  #0
DE1A 2605             (    forth6809.asm):05668                     BNE   AQTHROW
DE1C 3085             (    forth6809.asm):05669                     LEAX  B,X
DE1E 3410             (    forth6809.asm):05670                     PSHS  X
DE20 39               (    forth6809.asm):05671                     RTS
DE21 3610             (    forth6809.asm):05672         AQTHROW:    PSHU  X
DE23 3606             (    forth6809.asm):05673                     PSHU  D
DE25 BDE8FA           (    forth6809.asm):05674                     JSR   TYPEW
DE28 CCFFFE           (    forth6809.asm):05675                     LDD   #-2               ; -2
DE2B 3606             (    forth6809.asm):05676                     PSHU  D
DE2D 7ED905           (    forth6809.asm):05677                     JMP   THROWW
                      (    forth6809.asm):05678         
                      (    forth6809.asm):05679         ; ------------------------------------------------------------
                      (    forth6809.asm):05680         ; ABORT"  ( "ccc<quote>" -- )
                      (    forth6809.asm):05681         ; Compile DOABORTQUOTE followed by the string up to the closing quote

                      (    forth6809.asm):04580         ; ------------------------------------------------------------
                      (    forth6809.asm):04581         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):04582         ; Read a line as ACCEPT does and store the count in SPAN.

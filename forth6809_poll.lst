                      (    forth6809.asm):09312         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09313         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09314         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09315         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09316         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09317         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09318         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09319         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09320         ; available the skip ends.
                      (    forth6809.asm):09321         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09322         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09323         ; ------------------------------------------------------------
F330 3706             (    forth6809.asm):09324         BRIFW:      PULU  D
F332 10830000         (    forth6809.asm):09325                     CMPD  #0
F336 266D             (    forth6809.asm):09326                     BNE   BRTHENW           ; true: nothing to skip
F338 CC0001           (    forth6809.asm):09327         BRELSEW:    LDD   #1
F33B 3406             (    forth6809.asm):09328                     PSHS  D                 ; level
F33D BDE9D9           (    forth6809.asm):09329         BRNEXT:     JSR   PARSENAMEW

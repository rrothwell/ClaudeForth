                      (    forth6809.asm):03683         
                      (    forth6809.asm):03684         ; ------------------------------------------------------------
                      (    forth6809.asm):03685         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03686         ; ROOT, for a name.
                      (    forth6809.asm):03687         ; SRCHORD
                      (    forth6809.asm):03688         ;    Inputs:
                      (    forth6809.asm):03689         ;        RegY = address of the name text
                      (    forth6809.asm):03690         ;        RegB = name length
                      (    forth6809.asm):03691         ;    Outputs:
                      (    forth6809.asm):03692         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03693         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03694         ; ------------------------------------------------------------
D4A3 3424             (    forth6809.asm):03695         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D4A5 8E004B           (    forth6809.asm):03696                     LDX   #ORDER
D4A8 3410             (    forth6809.asm):03697                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D4AA AEE4             (    forth6809.asm):03698         SOLOOP:     LDX   ,S
D4AC 9C49             (    forth6809.asm):03699                     CMPX  ORDEND
D4AE 2415             (    forth6809.asm):03700                     BHS   SOROOT
D4B0 10AE81           (    forth6809.asm):03701                     LDY   ,X++              ; WID
D4B3 AFE4             (    forth6809.asm):03702                     STX   ,S
D4B5 AEA4             (    forth6809.asm):03703                     LDX   ,Y                ; newest header of that wordlist
D4B7 10AE63           (    forth6809.asm):03704                     LDY   3,S
D4BA E662             (    forth6809.asm):03705                     LDB   2,S
D4BC 8DA8             (    forth6809.asm):03706                     BSR   FDSEARCH
D4BE 8C0000           (    forth6809.asm):03707                     CMPX  #0
D4C1 27E7             (    forth6809.asm):03708                     BEQ   SOLOOP
D4C3 2009             (    forth6809.asm):03709                     BRA   SORDONE
D4C5 9E5D             (    forth6809.asm):03710         SOROOT:     LDX   WLHEADS+2         ; ROOT
D4C7 10AE63           (    forth6809.asm):03711                     LDY   3,S
D4CA E662             (    forth6809.asm):03712                     LDB   2,S
D4CC 8D98             (    forth6809.asm):03713                     BSR   FDSEARCH
D4CE 3265             (    forth6809.asm):03714         SORDONE:    LEAS  5,S
D4D0 39               (    forth6809.asm):03715                     RTS
                      (    forth6809.asm):03716         
                      (    forth6809.asm):03717         ; ------------------------------------------------------------
                      (    forth6809.asm):03718         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03719         ; HDRXT
                      (    forth6809.asm):03720         ;    Inputs:
                      (    forth6809.asm):03721         ;        RegX = header
                      (    forth6809.asm):03722         ;    Outputs:
                      (    forth6809.asm):03723         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03724         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
D4D1 A684             (    forth6809.asm):03726         HDRXT:      LDA   ,X
D4D3 1F89             (    forth6809.asm):03727                     TFR   A,B
D4D5 C41F             (    forth6809.asm):03728                     ANDB  #$1F
D4D7 3001             (    forth6809.asm):03729                     LEAX  1,X
D4D9 3A               (    forth6809.asm):03730                     ABX
D4DA AE02             (    forth6809.asm):03731                     LDX   2,X               ; CFA field
D4DC 39               (    forth6809.asm):03732                     RTS
                      (    forth6809.asm):03733         
                      (    forth6809.asm):03734         ; ------------------------------------------------------------
                      (    forth6809.asm):03735         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03736         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03737         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03738         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03739         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03740         ; ------------------------------------------------------------
D4DD 10AEC4           (    forth6809.asm):03741         FINDW:      LDY   ,U                ; counted string
D4E0 E6A0             (    forth6809.asm):03742                     LDB   ,Y+
D4E2 8DBF             (    forth6809.asm):03743                     BSR   SRCHORD
D4E4 8C0000           (    forth6809.asm):03744                     CMPX  #0
D4E7 2712             (    forth6809.asm):03745                     BEQ   NOTFOUND
D4E9 8DE6             (    forth6809.asm):03746                     BSR   HDRXT
D4EB AFC4             (    forth6809.asm):03747                     STX   ,U                ; xt replaces c-addr
D4ED 4D               (    forth6809.asm):03748                     TSTA
D4EE 2A05             (    forth6809.asm):03749                     BPL   FISNORM
D4F0 CC0001           (    forth6809.asm):03750                     LDD   #1
D4F3 2003             (    forth6809.asm):03751                     BRA   FPUSH
D4F5 CCFFFF           (    forth6809.asm):03752         FISNORM:    LDD   #-1
D4F8 3606             (    forth6809.asm):03753         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D4FA 39               (    forth6809.asm):03754                     RTS
                      (    forth6809.asm):03755         
D4FB CC0000           (    forth6809.asm):03756         NOTFOUND:   LDD   #0
D4FE 3606             (    forth6809.asm):03757                     PSHU  D                 ; 0 = not found, c-addr still beneath
D500 39               (    forth6809.asm):03758                     RTS
                      (    forth6809.asm):03759         
                      (    forth6809.asm):03760         ; ------------------------------------------------------------
                      (    forth6809.asm):03761         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03762         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03763         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03764         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
D501 3710             (    forth6809.asm):03766         SEARCHWLW:  PULU  X                 ; wid
D503 8D2D             (    forth6809.asm):03767                     BSR   WIDCHK
D505 AE84             (    forth6809.asm):03768                     LDX   ,X                ; newest header of the wordlist
D507 3706             (    forth6809.asm):03769                     PULU  D                 ; u
D509 3720             (    forth6809.asm):03770                     PULU  Y                 ; c-addr
D50B 4D               (    forth6809.asm):03771                     TSTA
D50C 261E             (    forth6809.asm):03772                     BNE   SWNOT             ; longer than any name
D50E C11F             (    forth6809.asm):03773                     CMPB  #31
D510 221A             (    forth6809.asm):03774                     BHI   SWNOT
D512 BDD466           (    forth6809.asm):03775                     JSR   FDSEARCH
D515 8C0000           (    forth6809.asm):03776                     CMPX  #0
D518 2712             (    forth6809.asm):03777                     BEQ   SWNOT
D51A 8DB5             (    forth6809.asm):03778                     BSR   HDRXT
D51C 3610             (    forth6809.asm):03779                     PSHU  X                 ; xt
D51E 4D               (    forth6809.asm):03780                     TSTA
D51F 2A05             (    forth6809.asm):03781                     BPL   SWNORM
D521 CC0001           (    forth6809.asm):03782                     LDD   #1
D524 2003             (    forth6809.asm):03783                     BRA   SWPUSH
D526 CCFFFF           (    forth6809.asm):03784         SWNORM:     LDD   #-1
D529 3606             (    forth6809.asm):03785         SWPUSH:     PSHU  D
D52B 39               (    forth6809.asm):03786                     RTS
D52C CC0000           (    forth6809.asm):03787         SWNOT:      LDD   #0
D52F 3606             (    forth6809.asm):03788                     PSHU  D
D531 39               (    forth6809.asm):03789                     RTS
                      (    forth6809.asm):03790         
                      (    forth6809.asm):03791         ; ------------------------------------------------------------
                      (    forth6809.asm):03792         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03793         ; WIDCHK
                      (    forth6809.asm):03794         ;    Inputs:
                      (    forth6809.asm):03795         ;        RegX = candidate WID
                      (    forth6809.asm):03796         ;    Outputs:
                      (    forth6809.asm):03797         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03798         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03799         ; ------------------------------------------------------------
D532 1F10             (    forth6809.asm):03800         WIDCHK:     TFR   X,D
D534 83005B           (    forth6809.asm):03801                     SUBD  #WLHEADS
D537 2509             (    forth6809.asm):03802                     BCS   WIDBAD
D539 C501             (    forth6809.asm):03803                     BITB  #1
D53B 2605             (    forth6809.asm):03804                     BNE   WIDBAD
D53D 9C45             (    forth6809.asm):03805                     CMPX  WLEND
D53F 2401             (    forth6809.asm):03806                     BHS   WIDBAD
D541 39               (    forth6809.asm):03807                     RTS
D542 CCFFF5           (    forth6809.asm):03808         WIDBAD:     LDD   #-11
D545 3606             (    forth6809.asm):03809                     PSHU  D
D547 7ED941           (    forth6809.asm):03810                     JMP   THROWW
                      (    forth6809.asm):03811         
                      (    forth6809.asm):03812         ; ------------------------------------------------------------
                      (    forth6809.asm):03813         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03814         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03815         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03816         ; WLINIT
                      (    forth6809.asm):03817         ;    Inputs:
                      (    forth6809.asm):03818         ;        none
                      (    forth6809.asm):03819         ;    Outputs:
                      (    forth6809.asm):03820         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03821         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03822         ; ------------------------------------------------------------
D54A CCCE7A           (    forth6809.asm):03823         WLINIT:     LDD   #BASELATEST
D54D DD5B             (    forth6809.asm):03824                     STD   WLHEADS
D54F CCC579           (    forth6809.asm):03825                     LDD   #BASEROOTLATEST
D552 DD5D             (    forth6809.asm):03826                     STD   WLHEADS+2
D554 CCC579           (    forth6809.asm):03827                     LDD   #H_FORTH
D557 DD6F             (    forth6809.asm):03828                     STD   WLNAMES
D559 CCC570           (    forth6809.asm):03829                     LDD   #H_ROOT
D55C DD71             (    forth6809.asm):03830                     STD   WLNAMES+2
D55E CC005F           (    forth6809.asm):03831                     LDD   #WLHEADS+4
D561 DD45             (    forth6809.asm):03832                     STD   WLEND
D563 CC005B           (    forth6809.asm):03833                     LDD   #WLHEADS
D566 DD47             (    forth6809.asm):03834                     STD   CURRENT
D568 7ED638           (    forth6809.asm):03835                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03836         
                      (    forth6809.asm):03837         ; ------------------------------------------------------------
                      (    forth6809.asm):03838         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03839         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03840         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03841         ; PRUNE
                      (    forth6809.asm):03842         ;    Inputs:
                      (    forth6809.asm):03843         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03844         ;    Outputs:
                      (    forth6809.asm):03845         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03846         ;        into ROM
                      (    forth6809.asm):03847         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03848         ; ------------------------------------------------------------
D56B 3406             (    forth6809.asm):03849         PRUNE:      PSHS  D                 ; 0,S = mark
D56D 8E005B           (    forth6809.asm):03850                     LDX   #WLHEADS
D570 9C45             (    forth6809.asm):03851         PRLOOP:     CMPX  WLEND
D572 2421             (    forth6809.asm):03852                     BHS   PRNDONE
D574 10AE84           (    forth6809.asm):03853                     LDY   ,X                ; newest header of this wordlist
D577 108CC000         (    forth6809.asm):03854         PRWALK:     CMPY  #ROMSTRT
D57B 2413             (    forth6809.asm):03855                     BHS   PRSTORE           ; ROM header: keep
D57D 10ACE4           (    forth6809.asm):03856                     CMPY  ,S
D580 250E             (    forth6809.asm):03857                     BLO   PRSTORE           ; below the mark (or empty): keep
D582 E6A4             (    forth6809.asm):03858                     LDB   ,Y
D584 C41F             (    forth6809.asm):03859                     ANDB  #$1F
D586 4F               (    forth6809.asm):03860                     CLRA
D587 3121             (    forth6809.asm):03861                     LEAY  1,Y
D589 31AB             (    forth6809.asm):03862                     LEAY  D,Y
D58B 10AEA4           (    forth6809.asm):03863                     LDY   ,Y                ; follow the LINK
D58E 20E7             (    forth6809.asm):03864                     BRA   PRWALK
D590 10AF81           (    forth6809.asm):03865         PRSTORE:    STY   ,X++
D593 20DB             (    forth6809.asm):03866                     BRA   PRLOOP
D595 3262             (    forth6809.asm):03867         PRNDONE:     LEAS  2,S
D597 39               (    forth6809.asm):03868                     RTS
                      (    forth6809.asm):03869         
                      (    forth6809.asm):03870         ; ============================================================
                      (    forth6809.asm):03871         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03872         ; ============================================================
                      (    forth6809.asm):03873         ; ------------------------------------------------------------
                      (    forth6809.asm):03874         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03875         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03876         ; ------------------------------------------------------------
D598 9E45             (    forth6809.asm):03877         WORDLISTW:  LDX   WLEND
D59A 8C006F           (    forth6809.asm):03878                     CMPX  #WLHEADS+2*WLCELLS
D59D 240F             (    forth6809.asm):03879                     BHS   WLFULL
D59F CC0000           (    forth6809.asm):03880                     LDD   #0
D5A2 ED84             (    forth6809.asm):03881                     STD   ,X
D5A4 ED8814           (    forth6809.asm):03882                     STD   WLNOFF,X
D5A7 3610             (    forth6809.asm):03883                     PSHU  X
D5A9 3002             (    forth6809.asm):03884                     LEAX  2,X
D5AB 9F45             (    forth6809.asm):03885                     STX   WLEND
D5AD 39               (    forth6809.asm):03886                     RTS
D5AE CCFFF8           (    forth6809.asm):03887         WLFULL:     LDD   #-8
D5B1 3606             (    forth6809.asm):03888                     PSHU  D
D5B3 7ED941           (    forth6809.asm):03889                     JMP   THROWW
                      (    forth6809.asm):03890         
                      (    forth6809.asm):03891         ; ------------------------------------------------------------
                      (    forth6809.asm):03892         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03893         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03894         ; ------------------------------------------------------------
D5B6 CC005B           (    forth6809.asm):03895         FORTHWLW:   LDD   #WLHEADS
D5B9 3606             (    forth6809.asm):03896                     PSHU  D
D5BB 39               (    forth6809.asm):03897                     RTS
                      (    forth6809.asm):03898         
                      (    forth6809.asm):03899         ; ------------------------------------------------------------
                      (    forth6809.asm):03900         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03901         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03902         ; it, as it is always searched last.
                      (    forth6809.asm):03903         ; ------------------------------------------------------------
D5BC 9E49             (    forth6809.asm):03904         GETORDERW:  LDX   ORDEND
D5BE 8C004B           (    forth6809.asm):03905         GOLOOP:     CMPX  #ORDER
D5C1 2306             (    forth6809.asm):03906                     BLS   GODONE
D5C3 EC83             (    forth6809.asm):03907                     LDD   ,--X
D5C5 3606             (    forth6809.asm):03908                     PSHU  D
D5C7 20F5             (    forth6809.asm):03909                     BRA   GOLOOP
D5C9 DC49             (    forth6809.asm):03910         GODONE:     LDD   ORDEND
D5CB 83004B           (    forth6809.asm):03911                     SUBD  #ORDER
D5CE 44               (    forth6809.asm):03912                     LSRA
D5CF 56               (    forth6809.asm):03913                     RORB
D5D0 3606             (    forth6809.asm):03914                     PSHU  D                 ; n
D5D2 39               (    forth6809.asm):03915                     RTS
                      (    forth6809.asm):03916         
                      (    forth6809.asm):03917         ; ------------------------------------------------------------
                      (    forth6809.asm):03918         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03919         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03920         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03921         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03922         ; ------------------------------------------------------------
D5D3 3706             (    forth6809.asm):03923         SETORDERW:  PULU  D                 ; n
D5D5 1083FFFF         (    forth6809.asm):03924                     CMPD  #-1
D5D9 275D             (    forth6809.asm):03925                     BEQ   ONLYW             ; the minimum order
D5DB 4D               (    forth6809.asm):03926         SO1:        TSTA
D5DC 2B31             (    forth6809.asm):03927                     BMI   SOUNDER
D5DE 262A             (    forth6809.asm):03928                     BNE   SOOVER
D5E0 C108             (    forth6809.asm):03929                     CMPB  #WLMAX
D5E2 2226             (    forth6809.asm):03930                     BHI   SOOVER
D5E4 3404             (    forth6809.asm):03931                     PSHS  B                 ; 1,S = n
D5E6 3404             (    forth6809.asm):03932                     PSHS  B                 ; 0,S = count down
D5E8 1F32             (    forth6809.asm):03933                     TFR   U,Y
D5EA 6DE4             (    forth6809.asm):03934         SOCHK:      TST   ,S
D5EC 2709             (    forth6809.asm):03935                     BEQ   SOCOPY
D5EE AEA1             (    forth6809.asm):03936                     LDX   ,Y++
D5F0 BDD532           (    forth6809.asm):03937                     JSR   WIDCHK            ; keeps Y
D5F3 6AE4             (    forth6809.asm):03938                     DEC   ,S
D5F5 20F3             (    forth6809.asm):03939                     BRA   SOCHK
D5F7 3506             (    forth6809.asm):03940         SOCOPY:     PULS  A,B               ; B = n
D5F9 8E004B           (    forth6809.asm):03941                     LDX   #ORDER
D5FC 5D               (    forth6809.asm):03942         SOCP2:      TSTB
D5FD 2708             (    forth6809.asm):03943                     BEQ   SOCPEND
D5FF 3720             (    forth6809.asm):03944                     PULU  Y
D601 10AF81           (    forth6809.asm):03945                     STY   ,X++
D604 5A               (    forth6809.asm):03946                     DECB
D605 20F5             (    forth6809.asm):03947                     BRA   SOCP2
D607 9F49             (    forth6809.asm):03948         SOCPEND:    STX   ORDEND
D609 39               (    forth6809.asm):03949                     RTS
D60A CCFFCF           (    forth6809.asm):03950         SOOVER:     LDD   #-49
D60D 2003             (    forth6809.asm):03951                     BRA   SOTHROW
D60F CCFFCE           (    forth6809.asm):03952         SOUNDER:    LDD   #-50
D612 3606             (    forth6809.asm):03953         SOTHROW:    PSHU  D
D614 7ED941           (    forth6809.asm):03954                     JMP   THROWW
                      (    forth6809.asm):03955         
                      (    forth6809.asm):03956         ; ------------------------------------------------------------
                      (    forth6809.asm):03957         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03958         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03959         ; ------------------------------------------------------------
D617 DC47             (    forth6809.asm):03960         GETCURW:    LDD   CURRENT
D619 3606             (    forth6809.asm):03961                     PSHU  D
D61B 39               (    forth6809.asm):03962                     RTS
                      (    forth6809.asm):03963         
                      (    forth6809.asm):03964         ; ------------------------------------------------------------
                      (    forth6809.asm):03965         ; SET-CURRENT  ( wid -- )
                      (    forth6809.asm):03966         ; Make wid the wordlist that receives new definitions. Throws -11 for
                      (    forth6809.asm):03967         ; an invalid wid.
                      (    forth6809.asm):03968         ; ------------------------------------------------------------
D61C 3710             (    forth6809.asm):03969         SETCURW:    PULU  X

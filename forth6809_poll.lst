                      (    forth6809.asm):02051                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02052                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02053         
                      (    forth6809.asm):02054                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02055                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02056                     STB   OUTTAIL

D1C7 9F0A             (    forth6809.asm):03165                     STX   VARHERE
D1C9 39               (    forth6809.asm):03166                     RTS
                      (    forth6809.asm):03167         
                      (    forth6809.asm):03168         ; ------------------------------------------------------------
                      (    forth6809.asm):03169         ; @  ( a-addr -- x )
                      (    forth6809.asm):03170         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03171         ; ------------------------------------------------------------
D1CA 3710             (    forth6809.asm):03172         FETCHW:     PULU  X                 ; a-addr
D1CC EC84             (    forth6809.asm):03173                     LDD   ,X
D1CE 3606             (    forth6809.asm):03174                     PSHU  D                 ; x
D1D0 39               (    forth6809.asm):03175                     RTS
                      (    forth6809.asm):03176         
                      (    forth6809.asm):03177         ; ------------------------------------------------------------
                      (    forth6809.asm):03178         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03179         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03180         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03181         ; ------------------------------------------------------------
D1D1 CCD1CA           (    forth6809.asm):03182         CONSTANTW:  LDD   #FETCHW
D1D4 BDD183           (    forth6809.asm):03183                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D1D7 BDD085           (    forth6809.asm):03184                     JSR   COMMAW
D1DA 39               (    forth6809.asm):03185                     RTS
                      (    forth6809.asm):03186         
                      (    forth6809.asm):03187         ; ------------------------------------------------------------
                      (    forth6809.asm):03188         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03189         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03190         ;    Inputs:
                      (    forth6809.asm):03191         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03192         ;    Outputs:
                      (    forth6809.asm):03193         ;        pfa replaced by the value
                      (    forth6809.asm):03194         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03195         ; ------------------------------------------------------------
D1DB 3710             (    forth6809.asm):03196         DOVALUE:    PULU  X                 ; pfa
D1DD EC84             (    forth6809.asm):03197                     LDD   ,X
D1DF 3606             (    forth6809.asm):03198                     PSHU  D                 ; x
D1E1 39               (    forth6809.asm):03199                     RTS
                      (    forth6809.asm):03200         
                      (    forth6809.asm):03201         ; ------------------------------------------------------------
                      (    forth6809.asm):03202         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03203         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03204         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03205         ; ------------------------------------------------------------
D1E2 CCD1DB           (    forth6809.asm):03206         VALUEW:     LDD   #DOVALUE
D1E5 BDD169           (    forth6809.asm):03207                     JSR   BLDDOES
D1E8 DC0A             (    forth6809.asm):03208                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D1EA 3606             (    forth6809.asm):03209                     PSHU  D                 ; See bugfix: VALUEW.1
D1EC BDD08B           (    forth6809.asm):03210                     JSR   CODECOMMA
D1EF BDD09D           (    forth6809.asm):03211                     JSR   VCOMMAW           ; store x in the variable area
D1F2 39               (    forth6809.asm):03212                     RTS
                      (    forth6809.asm):03213         
                      (    forth6809.asm):03214         ; ------------------------------------------------------------

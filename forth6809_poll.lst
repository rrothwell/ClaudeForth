                      (    forth6809.asm):05052         ; ------------------------------------------------------------
                      (    forth6809.asm):05053         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05054         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the

EB27 10AEC4           (    forth6809.asm):08201                     LDY   ,U                ; c-addr2 at 0, u1 at 2. See bugfix:
                      (    forth6809.asm):08202                                             ; UNESCAPEW.1 (still applies) and
                      (    forth6809.asm):08203                                             ; shadow UNESCAPEW.5
                      (    forth6809.asm):08204         
                      (    forth6809.asm):08205                     ; Double every %; copy all other characters unchanged.

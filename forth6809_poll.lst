CE6B 16FFB0           (    forth6809.asm):02626                     LBRA  QLOOP
                      (    forth6809.asm):02627         
CE6E BDEEB3           (    forth6809.asm):02628         QSHOWERR:   JSR   CRW
CE71 8ECEB8           (    forth6809.asm):02629                     LDX   #ERRMSG
CE74 3610             (    forth6809.asm):02630                     PSHU  X                 ; c-addr
CE76 CC0008           (    forth6809.asm):02631                     LDD   #ERRMSGL
CE79 3606             (    forth6809.asm):02632                     PSHU  D                 ; u
CE7B BDE88A           (    forth6809.asm):02633                     JSR   TYPEW
CE7E ECE4             (    forth6809.asm):02634                     LDD   ,S
CE80 3606             (    forth6809.asm):02635                     PSHU  D                 ; n
CE82 BDED82           (    forth6809.asm):02636                     JSR   DOTW
CE85 326A             (    forth6809.asm):02637                     LEAS  10,S              ; drop the frame
CE87 16FF94           (    forth6809.asm):02638                     LBRA  QLOOP
                      (    forth6809.asm):02639         

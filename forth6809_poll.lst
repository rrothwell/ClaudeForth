                      (    forth6809.asm):02000         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):02001         ; receiver-error counters to zero.
                      (    forth6809.asm):02002         ; SERBUFCLR
                      (    forth6809.asm):02003         ;    Inputs:
                      (    forth6809.asm):02004         ;        none
                      (    forth6809.asm):02005         ;    Outputs:
                      (    forth6809.asm):02006         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02007         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02008         ;    Registers: only CC changed.
                      (    forth6809.asm):02009         ; Original comment: shadow SERBUFCLR.0.

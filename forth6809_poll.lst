                      (    forth6809.asm):07548         ; ------------------------------------------------------------
                      (    forth6809.asm):07549         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07550         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07551         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07552         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07553         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07554         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07555         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07556         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07557         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07558         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07559         ; ------------------------------------------------------------
E811 BDD085           (    forth6809.asm):07560         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
E814 ECC4             (    forth6809.asm):07561                     LDD   ,U
E816 3406             (    forth6809.asm):07562                     PSHS  D                 ; output pointer
E818 3406             (    forth6809.asm):07563                     PSHS  D                 ; output start
E81A DC39             (    forth6809.asm):07564                     LDD   SRCADDR
E81C D33B             (    forth6809.asm):07565                     ADDD  SRCLEN
E81E 3406             (    forth6809.asm):07566                     PSHS  D                 ; input end
E820 DC39             (    forth6809.asm):07567                     LDD   SRCADDR
E822 D310             (    forth6809.asm):07568                     ADDD  TOIN
E824 1F02             (    forth6809.asm):07569                     TFR   D,Y               ; input pointer
E826 10AC60           (    forth6809.asm):07570         SQEL:       CMPY  0,S
E829 247E             (    forth6809.asm):07571                     BHS   SQEND
E82B A6A0             (    forth6809.asm):07572                     LDA   ,Y+
E82D 8122             (    forth6809.asm):07573                     CMPA  #34
E82F 2778             (    forth6809.asm):07574                     BEQ   SQEND
E831 815C             (    forth6809.asm):07575                     CMPA  #92
E833 261C             (    forth6809.asm):07576                     BNE   SQEPUT
E835 10AC60           (    forth6809.asm):07577                     CMPY  0,S
E838 246F             (    forth6809.asm):07578                     BHS   SQEND

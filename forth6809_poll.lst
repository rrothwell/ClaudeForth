                      (    forth6809.asm):03836         ; ------------------------------------------------------------
                      (    forth6809.asm):03837         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):03838         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):03839         ; ------------------------------------------------------------
E3C5 BDE357           (    forth6809.asm):03840         EXPECTW:    JSR   ACCEPTW
E3C8 3706             (    forth6809.asm):03841                     PULU  D

                      (    forth6809.asm):04610         ; ============================================================
                      (    forth6809.asm):04611         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04612         ; ============================================================
                      (    forth6809.asm):04613         ; ------------------------------------------------------------
                      (    forth6809.asm):04614         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04615         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04616         ; one expected.
                      (    forth6809.asm):04617         ; CFERR
                      (    forth6809.asm):04618         ;    Inputs:
                      (    forth6809.asm):04619         ;        none
                      (    forth6809.asm):04620         ;    Outputs:
                      (    forth6809.asm):04621         ;        does not return (THROW -22)
                      (    forth6809.asm):04622         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04623         ; ------------------------------------------------------------
D93B CCFFEA           (    forth6809.asm):04624         CFERR:      LDD   #-22
D93E 3606             (    forth6809.asm):04625                     PSHU  D                 ; -22
D940 BDD970           (    forth6809.asm):04626                     JSR   THROWW
D943 39               (    forth6809.asm):04627                     RTS
                      (    forth6809.asm):04628         
                      (    forth6809.asm):04629         ; ------------------------------------------------------------
                      (    forth6809.asm):04630         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04631         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04632         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04633         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04634         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04635         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04636         ; ------------------------------------------------------------
D944 3710             (    forth6809.asm):04637         CATCHW:     PULU  X                 ; xt
D946 DC0C             (    forth6809.asm):04638                     LDD   HANDLER
D948 3406             (    forth6809.asm):04639                     PSHS  D
D94A 3440             (    forth6809.asm):04640                     PSHS  U
                      (    forth6809.asm):04641                     ; Save the input source specification.
                      (    forth6809.asm):04642                     ; See bugfix: CATCHW.1
D94C DC39             (    forth6809.asm):04643                     LDD   SRCADDR
D94E 3406             (    forth6809.asm):04644                     PSHS  D
D950 DC3B             (    forth6809.asm):04645                     LDD   SRCLEN

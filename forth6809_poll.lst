                      (    forth6809.asm):02187         
                      (    forth6809.asm):02188                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02189                     CMPB  OUTHEAD
                      (    forth6809.asm):02190                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02191         
                      (    forth6809.asm):02192                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02193                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02194                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02195         

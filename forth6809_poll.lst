                      (    forth6809.asm):05016         ; ------------------------------------------------------------
DB6A 3706             (    forth6809.asm):05017         LOOPW:      PULU  D
DB6C 10830003         (    forth6809.asm):05018                     CMPD  #TAGDO
DB70 2703             (    forth6809.asm):05019                     BEQ   LOOPOK
DB72 BDD93B           (    forth6809.asm):05020                     JSR   CFERR
DB75 3706             (    forth6809.asm):05021         LOOPOK:     PULU  D                 ; dest
DB77 3606             (    forth6809.asm):05022                     PSHU  D                 ; park dest. See bugfix: LOOPW.1

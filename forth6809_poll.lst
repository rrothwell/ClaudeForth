DAA1 3710             (    forth6809.asm):04869         RPOK1:      PULU  X                 ; orig
DAA3 3410             (    forth6809.asm):04870                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04871         
                      (    forth6809.asm):04872                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04873                     ; See bugfix: REPEATW.1
DAA5 3040             (    forth6809.asm):04874                     LEAX  0,U               ; scan from top of control stack
DAA7 9F16             (    forth6809.asm):04875                     STX   MSCR2             ; MSCR2 = base of scan region

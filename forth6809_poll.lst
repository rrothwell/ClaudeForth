                      (    forth6809.asm):06676         ; overlapping regions are handled correctly.
                      (    forth6809.asm):06677         ; ------------------------------------------------------------
F278 EC42             (    forth6809.asm):06678         MOVEW:      LDD   2,U               ; addr2
F27A 10A344           (    forth6809.asm):06679                     CMPD  4,U               ; addr1

                      (    forth6809.asm):03528         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03529         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03530         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03531         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03532         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.

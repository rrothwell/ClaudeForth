DCED DC08             (    forth6809.asm):02920                     LDD   CODEHERE          ; PFA = the cell after this one
DCEF C30002           (    forth6809.asm):02921                     ADDD  #2                ; See bugfix: CONSTANTW.1
DCF2 3606             (    forth6809.asm):02922                     PSHU  D
DCF4 BDDBFB           (    forth6809.asm):02923                     JSR   CODECOMMA
DCF7 39               (    forth6809.asm):02924                     RTS
                      (    forth6809.asm):02925         
                      (    forth6809.asm):02926         ; ------------------------------------------------------------
                      (    forth6809.asm):02927         ; CREATE  ( "name" -- )
                      (    forth6809.asm):02928         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):02929         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):02930         ; address in the code area, on the stack.
                      (    forth6809.asm):02931         ; ------------------------------------------------------------
DCF8 CCDB88           (    forth6809.asm):02932         CREATEW:    LDD   #DOESRT0
DCFB BDDCEA           (    forth6809.asm):02933                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
DCFE 39               (    forth6809.asm):02934                     RTS
                      (    forth6809.asm):02935         
                      (    forth6809.asm):02936         ; ------------------------------------------------------------
                      (    forth6809.asm):02937         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):02938         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):02939         ; of the word being defined.
                      (    forth6809.asm):02940         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):02941         ; ------------------------------------------------------------
DCFF CCDB89           (    forth6809.asm):02942         DOESGTW:    LDD   #SETDOES
DD02 3606             (    forth6809.asm):02943                     PSHU  D
DD04 BDE83E           (    forth6809.asm):02944                     JSR   CCALL
DD07 39               (    forth6809.asm):02945                     RTS
                      (    forth6809.asm):02946         
                      (    forth6809.asm):02947         ; ------------------------------------------------------------
                      (    forth6809.asm):02948         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):02949         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):02950         ; area, initialised to zero.
                      (    forth6809.asm):02951         ; ------------------------------------------------------------
DD08 CC0000           (    forth6809.asm):02952         VARIABLEW:  LDD   #0
DD0B 3606             (    forth6809.asm):02953                     PSHU  D
DD0D BDDC4D           (    forth6809.asm):02954                     JSR   HEADER
DD10 CCDB7D           (    forth6809.asm):02955                     LDD   #DODOES
DD13 3606             (    forth6809.asm):02956                     PSHU  D
DD15 BDE83E           (    forth6809.asm):02957                     JSR   CCALL
DD18 CCDB88           (    forth6809.asm):02958                     LDD   #DOESRT0
DD1B 3606             (    forth6809.asm):02959                     PSHU  D
DD1D BDDBFB           (    forth6809.asm):02960                     JSR   CODECOMMA
DD20 DC0A             (    forth6809.asm):02961                     LDD   VARHERE
DD22 3606             (    forth6809.asm):02962                     PSHU  D
DD24 BDDBFB           (    forth6809.asm):02963                     JSR   CODECOMMA
DD27 CC0000           (    forth6809.asm):02964                     LDD   #0

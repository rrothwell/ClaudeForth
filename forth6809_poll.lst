E2CB 49               (    forth6809.asm):05738                     ROLA
E2CC ECCB             (    forth6809.asm):05739                     LDD   D,U
E2CE 3606             (    forth6809.asm):05740                     PSHU  D
E2D0 39               (    forth6809.asm):05741                     RTS
                      (    forth6809.asm):05742         
                      (    forth6809.asm):05743         ; ------------------------------------------------------------
                      (    forth6809.asm):05744         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05745         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05746         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05747         ; the cell being moved.
                      (    forth6809.asm):05748         ; ------------------------------------------------------------

E57B 308B             (    forth6809.asm):04548                     LEAX  D,X               ; X = MSCR2 + this pass's offset
E57D EC84             (    forth6809.asm):04549                     LDD   ,X
E57F 3004             (    forth6809.asm):04550                     LEAX  4,X
E581 ED84             (    forth6809.asm):04551                     STD   ,X                ; copy one word 4 bytes higher
E583 DC18             (    forth6809.asm):04552                     LDD   MSCR3
E585 26EB             (    forth6809.asm):04553                     BNE   RPSHIFT
E587                  (    forth6809.asm):04554         RPSHIFTDONE:

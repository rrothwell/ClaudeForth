D4E2 AFE4             (    forth6809.asm):03693                     STX   ,S
D4E4 AEA4             (    forth6809.asm):03694                     LDX   ,Y                ; newest header of that wordlist
D4E6 10AE63           (    forth6809.asm):03695                     LDY   3,S
D4E9 E662             (    forth6809.asm):03696                     LDB   2,S
D4EB 8DA8             (    forth6809.asm):03697                     BSR   FDSEARCH
D4ED 8C0000           (    forth6809.asm):03698                     CMPX  #0
D4F0 27E7             (    forth6809.asm):03699                     BEQ   SOLOOP
D4F2 2009             (    forth6809.asm):03700                     BRA   SORDONE

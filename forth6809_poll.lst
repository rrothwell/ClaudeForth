DF69 3506             (    forth6809.asm):05802                     PULS  D
DF6B EDC4             (    forth6809.asm):05803                     STD   ,U
DF6D 39               (    forth6809.asm):05804         ROLLDONE:   RTS
                      (    forth6809.asm):05805         
                      (    forth6809.asm):05806         ; ------------------------------------------------------------
                      (    forth6809.asm):05807         ; 2ROT  ( x1 x2 x3 x4 x5 x6 -- x3 x4 x5 x6 x1 x2 )
                      (    forth6809.asm):05808         ; Rotate the third cell pair to the top. X and Y hold the pair
                      (    forth6809.asm):05809         ; while the others move.
                      (    forth6809.asm):05810         ; ------------------------------------------------------------
DF6E AE4A             (    forth6809.asm):05811         DROTW:      LDX   10,U              ; x1

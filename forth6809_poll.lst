                      (    forth6809.asm):05903         ; ============================================================
                      (    forth6809.asm):05904         ; SECTION 15: ARITHMETIC (single + double + mixed precision)
                      (    forth6809.asm):05905         ; ============================================================
                      (    forth6809.asm):05906         ; ------------------------------------------------------------
                      (    forth6809.asm):05907         ; +  ( n1 n2 -- n3 )
                      (    forth6809.asm):05908         ; Add n2 to n1.
                      (    forth6809.asm):05909         ; ------------------------------------------------------------
DFCC 3706             (    forth6809.asm):05910         PLUSW:      PULU  D                 ; n2
DFCE E3C4             (    forth6809.asm):05911                     ADDD  ,U
DFD0 EDC4             (    forth6809.asm):05912                     STD   ,U

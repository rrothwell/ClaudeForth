                      (    forth6809.asm):07540         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07541         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07542         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07543         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07544         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07545         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07546         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07547         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07548         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07549         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07550         ; ------------------------------------------------------------
E840 BDD0C5           (    forth6809.asm):07551         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
E843 ECC4             (    forth6809.asm):07552                     LDD   ,U
E845 3406             (    forth6809.asm):07553                     PSHS  D                 ; output pointer
E847 3406             (    forth6809.asm):07554                     PSHS  D                 ; output start
E849 DC39             (    forth6809.asm):07555                     LDD   SRCADDR
E84B D33B             (    forth6809.asm):07556                     ADDD  SRCLEN
E84D 3406             (    forth6809.asm):07557                     PSHS  D                 ; input end
E84F DC39             (    forth6809.asm):07558                     LDD   SRCADDR
E851 D310             (    forth6809.asm):07559                     ADDD  TOIN
E853 1F02             (    forth6809.asm):07560                     TFR   D,Y               ; input pointer

                      (    forth6809.asm):07441         ; ------------------------------------------------------------
                      (    forth6809.asm):07442         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):07443         ; address and length and skip over it.
                      (    forth6809.asm):07444         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):07445         ;    Inputs:
                      (    forth6809.asm):07446         ;        return address on S points at the count byte
                      (    forth6809.asm):07447         ;    Outputs:
                      (    forth6809.asm):07448         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):07449         ;        string

                      (    forth6809.asm):04382         
                      (    forth6809.asm):04383         ; ------------------------------------------------------------
                      (    forth6809.asm):04384         ; THEN  ( C: orig -- )
                      (    forth6809.asm):04385         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04386         ; operand to jump to the current code address.
                      (    forth6809.asm):04387         ; ------------------------------------------------------------
E460 3706             (    forth6809.asm):04388         THENW:      PULU  D
E462 10830001         (    forth6809.asm):04389                     CMPD  #TAGFWD

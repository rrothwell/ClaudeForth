F30E 10830004         (    forth6809.asm):09420                     CMPD  #4
F312 2734             (    forth6809.asm):09421                     BEQ   BR4
F314 10830006         (    forth6809.asm):09422                     CMPD  #6
F318 26E7             (    forth6809.asm):09423                     BNE   BRNEXT
F31A C606             (    forth6809.asm):09424                     LDB   #6
F31C 108EF378         (    forth6809.asm):09425                     LDY   #BRSELSE

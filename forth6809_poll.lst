                      (    forth6809.asm):04217         ; ------------------------------------------------------------
                      (    forth6809.asm):04218         ; Run-time start of DO and ?DO: build the loop frame on S, beneath the
                      (    forth6809.asm):04219         ; return address.
                      (    forth6809.asm):04220         ; DOSETUP   ( limit index -- )
                      (    forth6809.asm):04221         ;    Inputs:
                      (    forth6809.asm):04222         ;        limit and index on the data stack (index on top)
                      (    forth6809.asm):04223         ;    Outputs:
                      (    forth6809.asm):04224         ;        S holds index, limit and a zero leave flag (top first)
                      (    forth6809.asm):04225         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04226         ; ------------------------------------------------------------
E5F2 3706             (    forth6809.asm):04227         DOSETUP:    PULU  D                 ; index
E5F4 DD14             (    forth6809.asm):04228                     STD   MSCR

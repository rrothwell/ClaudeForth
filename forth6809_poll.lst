                      (    forth6809.asm):02074         
                      (    forth6809.asm):02075                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02076                     INCB
                      (    forth6809.asm):02077                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02078                     CMPB  OUTTAIL
                      (    forth6809.asm):02079                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02080         
                      (    forth6809.asm):02081                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02082                     LDB   OUTHEAD
                      (    forth6809.asm):02083                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02084         
                      (    forth6809.asm):02085                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02086                     ANDB  #OUTBUFSZ-1

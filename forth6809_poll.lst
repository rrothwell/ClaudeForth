                      (    forth6809.asm):03576         
D439 108C0000         (    forth6809.asm):03577         SKIPLP:     CMPY  #0
D43D 274D             (    forth6809.asm):03578                     BEQ   EMPTY
D43F A684             (    forth6809.asm):03579                     LDA   ,X
D441 A1E4             (    forth6809.asm):03580                     CMPA  ,S
D443 2606             (    forth6809.asm):03581                     BNE   STARTW
D445 3001             (    forth6809.asm):03582                     LEAX  1,X
D447 313F             (    forth6809.asm):03583                     LEAY  -1,Y
D449 20EE             (    forth6809.asm):03584                     BRA   SKIPLP
                      (    forth6809.asm):03585         
D44B AF61             (    forth6809.asm):03586         STARTW:     STX   1,S
D44D C600             (    forth6809.asm):03587                     LDB   #0
                      (    forth6809.asm):03588         
D44F 108C0000         (    forth6809.asm):03589         SCANLP:     CMPY  #0
D453 2715             (    forth6809.asm):03590                     BEQ   ENDW
D455 A684             (    forth6809.asm):03591                     LDA   ,X
D457 A1E4             (    forth6809.asm):03592                     CMPA  ,S
D459 270B             (    forth6809.asm):03593                     BEQ   CONSUME

                      (    forth6809.asm):07536         ; ------------------------------------------------------------
                      (    forth6809.asm):07537         ; Run-time part of S". The counted string follows the call: push its
                      (    forth6809.asm):07538         ; address and length and skip over it.
                      (    forth6809.asm):07539         ; DOSTR   ( -- c-addr u )
                      (    forth6809.asm):07540         ;    Inputs:
                      (    forth6809.asm):07541         ;        return address on S points at the count byte
                      (    forth6809.asm):07542         ;    Outputs:
                      (    forth6809.asm):07543         ;        c-addr and u on the data stack; execution resumes after the
                      (    forth6809.asm):07544         ;        string
                      (    forth6809.asm):07545         ;    Registers: RegB, RegD and RegX changed.
                      (    forth6809.asm):07546         ; ------------------------------------------------------------
E771 3510             (    forth6809.asm):07547         DOSTR:      PULS  X
E773 E684             (    forth6809.asm):07548                     LDB   ,X
E775 3001             (    forth6809.asm):07549                     LEAX  1,X
E777 3610             (    forth6809.asm):07550                     PSHU  X
E779 4F               (    forth6809.asm):07551                     CLRA
E77A 3606             (    forth6809.asm):07552                     PSHU  D
E77C 3085             (    forth6809.asm):07553                     LEAX  B,X
E77E 3410             (    forth6809.asm):07554                     PSHS  X
E780 39               (    forth6809.asm):07555                     RTS
                      (    forth6809.asm):07556         
                      (    forth6809.asm):07557         ; ------------------------------------------------------------
                      (    forth6809.asm):07558         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07559         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07560         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07561         ; PARSEQUOTE
                      (    forth6809.asm):07562         ;    Inputs:
                      (    forth6809.asm):07563         ;        none (parses from >IN)
                      (    forth6809.asm):07564         ;    Outputs:
                      (    forth6809.asm):07565         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07566         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07567         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07568         ; ------------------------------------------------------------
E781 CC0022           (    forth6809.asm):07569         PARSEQUOTE: LDD   #34
E784 3606             (    forth6809.asm):07570                     PSHU  D
E786 BDE957           (    forth6809.asm):07571                     JSR   PARSEW
E789 6DC4             (    forth6809.asm):07572                     TST   ,U                ; high byte of the length
E78B 2601             (    forth6809.asm):07573                     BNE   PQLONG
E78D 39               (    forth6809.asm):07574                     RTS
E78E CCFFEE           (    forth6809.asm):07575         PQLONG:     LDD   #-18
E791 3606             (    forth6809.asm):07576                     PSHU  D
E793 7ED905           (    forth6809.asm):07577                     JMP   THROWW
                      (    forth6809.asm):07578         
                      (    forth6809.asm):07579         ; ------------------------------------------------------------
                      (    forth6809.asm):07580         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07581         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07582         ;    Inputs:
                      (    forth6809.asm):07583         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07584         ;        c-addr u on the data stack
                      (    forth6809.asm):07585         ;    Outputs:
                      (    forth6809.asm):07586         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07587         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07588         ; ------------------------------------------------------------
E796 3606             (    forth6809.asm):07589         CSTRCOMP:   PSHU  D
E798 BDDD40           (    forth6809.asm):07590                     JSR   CCALL
E79B 3706             (    forth6809.asm):07591                     PULU  D                 ; u
E79D 3720             (    forth6809.asm):07592                     PULU  Y                 ; c-addr
E79F 9E08             (    forth6809.asm):07593                     LDX   CODEHERE
E7A1 E780             (    forth6809.asm):07594                     STB   ,X+
E7A3 5D               (    forth6809.asm):07595                     TSTB
E7A4 2707             (    forth6809.asm):07596                     BEQ   CSEND
E7A6 A6A0             (    forth6809.asm):07597         CSCPY:      LDA   ,Y+
E7A8 A780             (    forth6809.asm):07598                     STA   ,X+
E7AA 5A               (    forth6809.asm):07599                     DECB
E7AB 26F9             (    forth6809.asm):07600                     BNE   CSCPY
E7AD 9F08             (    forth6809.asm):07601         CSEND:      STX   CODEHERE
E7AF 39               (    forth6809.asm):07602                     RTS
                      (    forth6809.asm):07603         
                      (    forth6809.asm):07604         ; ------------------------------------------------------------
                      (    forth6809.asm):07605         ; S"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07606         ; Parse up to the closing quote (PARSEQUOTE). When compiling, compile
                      (    forth6809.asm):07607         ; DOSTR followed by the counted string. When interpreting, copy the
                      (    forth6809.asm):07608         ; string to PAD and return its address and length. An empty string is
                      (    forth6809.asm):07609         ; valid. See shadow SQUOTEW.3.
                      (    forth6809.asm):07610         ; ------------------------------------------------------------
E7B0 BDE781           (    forth6809.asm):07611         SQUOTEW:    JSR   PARSEQUOTE        ; See bugfix: SQUOTEW.3
E7B3 DC00             (    forth6809.asm):07612         SQSTATE:    LDD   STATE
E7B5 2706             (    forth6809.asm):07613                     BEQ   SQINTERP
E7B7 CCE771           (    forth6809.asm):07614                     LDD   #DOSTR
E7BA 7EE796           (    forth6809.asm):07615                     JMP   CSTRCOMP
                      (    forth6809.asm):07616         
                      (    forth6809.asm):07617                     ; Interpreting: copy the string to PAD. Original comment: shadow
                      (    forth6809.asm):07618                     ; SQUOTEW.2.
E7BD                  (    forth6809.asm):07619         SQINTERP:
E7BD BDD010           (    forth6809.asm):07620                     JSR   PADW
E7C0 3710             (    forth6809.asm):07621                     PULU  X                 ; PAD
E7C2 3706             (    forth6809.asm):07622                     PULU  D                 ; u
E7C4 3720             (    forth6809.asm):07623                     PULU  Y                 ; c-addr
E7C6 3610             (    forth6809.asm):07624                     PSHU  X                 ; result c-addr
E7C8 3606             (    forth6809.asm):07625                     PSHU  D                 ; result u
E7CA 5D               (    forth6809.asm):07626                     TSTB
E7CB 2707             (    forth6809.asm):07627                     BEQ   SQIEND
E7CD A6A0             (    forth6809.asm):07628         SQICPY:     LDA   ,Y+
E7CF A780             (    forth6809.asm):07629                     STA   ,X+
E7D1 5A               (    forth6809.asm):07630                     DECB
E7D2 26F9             (    forth6809.asm):07631                     BNE   SQICPY
E7D4 39               (    forth6809.asm):07632         SQIEND:     RTS
                      (    forth6809.asm):07633         
                      (    forth6809.asm):07634         ; ------------------------------------------------------------
                      (    forth6809.asm):07635         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07636         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07637         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07638         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07639         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07640         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07641         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07642         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07643         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07644         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07645         ; ------------------------------------------------------------
E7D5 BDD010           (    forth6809.asm):07646         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
E7D8 ECC4             (    forth6809.asm):07647                     LDD   ,U
E7DA 3406             (    forth6809.asm):07648                     PSHS  D                 ; output pointer

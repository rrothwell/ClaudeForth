DF86 AF42             (    forth6809.asm):05822                     STX   2,U
DF88 39               (    forth6809.asm):05823                     RTS
                      (    forth6809.asm):05824         
                      (    forth6809.asm):05825         ; ------------------------------------------------------------
                      (    forth6809.asm):05826         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05827         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05828         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05829         ; the transfer.
                      (    forth6809.asm):05830         ; ------------------------------------------------------------
DF89 3706             (    forth6809.asm):05831         TORW:       PULU  D                 ; x
DF8B 3510             (    forth6809.asm):05832                     PULS  X
DF8D 3406             (    forth6809.asm):05833                     PSHS  D
DF8F 3410             (    forth6809.asm):05834                     PSHS  X
DF91 39               (    forth6809.asm):05835                     RTS
                      (    forth6809.asm):05836         
                      (    forth6809.asm):05837         ; ------------------------------------------------------------
                      (    forth6809.asm):05838         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05839         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05840         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05841         ; the transfer.
                      (    forth6809.asm):05842         ; ------------------------------------------------------------
DF92 3510             (    forth6809.asm):05843         FROMRW:     PULS  X
DF94 3506             (    forth6809.asm):05844                     PULS  D                 ; x
DF96 3410             (    forth6809.asm):05845                     PSHS  X
DF98 3606             (    forth6809.asm):05846                     PSHU  D
DF9A 39               (    forth6809.asm):05847                     RTS
                      (    forth6809.asm):05848         
                      (    forth6809.asm):05849         ; ------------------------------------------------------------
                      (    forth6809.asm):05850         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05851         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05852         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05853         ; back around the transfer.
                      (    forth6809.asm):05854         ; ------------------------------------------------------------
DF9B 3510             (    forth6809.asm):05855         RFETCHW:    PULS  X

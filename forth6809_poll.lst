                      (    forth6809.asm):09296         ; ------------------------------------------------------------
                      (    forth6809.asm):09297         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):09298         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):09299         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):09300         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):09301         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):09302         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):09303         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):09304         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):09305         ; available the skip ends.
                      (    forth6809.asm):09306         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):09307         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):09308         ; ------------------------------------------------------------

E8EB 10830000         (    forth6809.asm):05175                     CMPD  #0
E8EF 260A             (    forth6809.asm):05176                     BNE   XCFOUND
E8F1 3706             (    forth6809.asm):05177                     PULU  D
E8F3 CCFFF3           (    forth6809.asm):05178                     LDD   #-13
E8F6 3606             (    forth6809.asm):05179                     PSHU  D
E8F8 BDE403           (    forth6809.asm):05180                     JSR   THROWW

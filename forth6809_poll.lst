                      (    forth6809.asm):04489                                             ; RDRF and the latched error bits together
D736 8570             (    forth6809.asm):04490                     BITA  #SR_FE+SR_OVRN+SR_PE
D738 2715             (    forth6809.asm):04491                     BEQ   KGETCH
D73A 8510             (    forth6809.asm):04492                     BITA  #SR_FE
D73C 2703             (    forth6809.asm):04493                     BEQ   KXFE
D73E 7C017C           (    forth6809.asm):04494                     INC   FECOUNT
D741 8520             (    forth6809.asm):04495         KXFE:       BITA  #SR_OVRN
D743 2703             (    forth6809.asm):04496                     BEQ   KXOVRN
D745 7C017D           (    forth6809.asm):04497                     INC   OVRNCOUNT
D748 8540             (    forth6809.asm):04498         KXOVRN:     BITA  #SR_PE
D74A 2703             (    forth6809.asm):04499                     BEQ   KGETCH
D74C 7C017E           (    forth6809.asm):04500                     INC   PECOUNT
D74F B6C009           (    forth6809.asm):04501         KGETCH:     LDA   ACIADR

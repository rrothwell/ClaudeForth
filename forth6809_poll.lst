                      (    forth6809.asm):05097         
DBF4 ECC4             (    forth6809.asm):05098                     LDD   ,U
DBF6 10830007         (    forth6809.asm):05099                     CMPD  #TAGQDO           ; ?DO frame? See bugfix: PLUSLOOPW.2
DBFA 260D             (    forth6809.asm):05100                     BNE   PLOOPDONE
DBFC 3706             (    forth6809.asm):05101                     PULU  D

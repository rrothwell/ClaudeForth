                      (    forth6809.asm):06246         ; ------------------------------------------------------------
                      (    forth6809.asm):06247         ; MOD  ( n1 n2 -- n3 )
                      (    forth6809.asm):06248         ; Remainder of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):06249         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):06250         ; zero.
                      (    forth6809.asm):06251         ; ------------------------------------------------------------

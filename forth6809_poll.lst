                      (    forth6809.asm):07664         ; DOCSTR
                      (    forth6809.asm):07665         ;    Outputs:
                      (    forth6809.asm):07666         ;        ( -- c-addr ) the count byte address; execution resumes after
                      (    forth6809.asm):07667         ;        the string

F2CB 26C4             (    forth6809.asm):09438                     BNE   BRNEXT
F2CD ECE4             (    forth6809.asm):09439                     LDD   ,S                ; [THEN]: one level less
F2CF 830001           (    forth6809.asm):09440                     SUBD  #1
F2D2 EDE4             (    forth6809.asm):09441                     STD   ,S
F2D4 2721             (    forth6809.asm):09442                     BEQ   BRDONE
F2D6 20B9             (    forth6809.asm):09443                     BRA   BRNEXT
F2D8 C604             (    forth6809.asm):09444         BR4:        LDB   #4
F2DA 108EF304         (    forth6809.asm):09445                     LDY   #BRSIF
F2DE BDF2FA           (    forth6809.asm):09446                     JSR   BRCMP
F2E1 26AE             (    forth6809.asm):09447                     BNE   BRNEXT
F2E3 ECE4             (    forth6809.asm):09448                     LDD   ,S                ; [IF]: one level more
F2E5 C30001           (    forth6809.asm):09449                     ADDD  #1

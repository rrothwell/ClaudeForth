                      (    forth6809.asm):02034         ; ============================================================
                      (    forth6809.asm):02035         ; SECTION 3: ACIA INTERRUPT HANDLER
                      (    forth6809.asm):02036         ; ============================================================
                      (    forth6809.asm):02037                     ORG   BASECODE          ; See bugfix: BASECODE.1
                      (    forth6809.asm):02038         
                      (    forth6809.asm):02039         ; ------------------------------------------------------------
                      (    forth6809.asm):02040         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):02041         ; receiver-error counters to zero.
                      (    forth6809.asm):02042         ; SERBUFCLR
                      (    forth6809.asm):02043         ;    Inputs:
                      (    forth6809.asm):02044         ;        none
                      (    forth6809.asm):02045         ;    Outputs:
                      (    forth6809.asm):02046         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02047         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02048         ;    Registers: only CC changed.
                      (    forth6809.asm):02049         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):02050         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):02051         ; ------------------------------------------------------------
                      (    forth6809.asm):02052         
CEC0 7F0176           (    forth6809.asm):02053         SERBUFCLR:  CLR   INHEAD
CEC3 7F0177           (    forth6809.asm):02054                     CLR   INTAIL
CEC6 7F0178           (    forth6809.asm):02055                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
CEC9 7F0179           (    forth6809.asm):02056                     CLR   OUTHEAD
CECC 7F017A           (    forth6809.asm):02057                     CLR   OUTTAIL
CECF 7F017B           (    forth6809.asm):02058                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):02059         
                      (    forth6809.asm):02060         
CED2 7F017C           (    forth6809.asm):02061                     CLR   FECOUNT
CED5 7F017D           (    forth6809.asm):02062                     CLR   OVRNCOUNT
CED8 7F017E           (    forth6809.asm):02063                     CLR   PECOUNT
CEDB 7F017F           (    forth6809.asm):02064                     CLR   POLLREADYCNT
CEDE 39               (    forth6809.asm):02065                     RTS
                      (    forth6809.asm):02066         
                      (    forth6809.asm):02067         ; ------------------------------------------------------------
                      (    forth6809.asm):02068         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):02069         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):02070         ; INITSERIAL
                      (    forth6809.asm):02071         ;    Inputs:
                      (    forth6809.asm):02072         ;        none
                      (    forth6809.asm):02073         ;    Outputs:
                      (    forth6809.asm):02074         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):02075         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02076         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):02077         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):02078         ; ------------------------------------------------------------
CEDF BDCEC0           (    forth6809.asm):02079         INITSERIAL: JSR   SERBUFCLR
CEE2 8603             (    forth6809.asm):02080                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
CEE4 B7C008           (    forth6809.asm):02081                     STA   ACIACR
CEE7 12               (    forth6809.asm):02082                     NOP                     ; Settling Delay
CEE8 12               (    forth6809.asm):02083                     NOP
                      (    forth6809.asm):02084         
                      (    forth6809.asm):02085                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02086                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02087                     ELSE                    ; <<<<<>>>>>
CEE9 8615             (    forth6809.asm):02088                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02089                     ENDC                    ; <<<<<<<<<<
CEEB B7C008           (    forth6809.asm):02090                     STA   ACIACR            ; See bugfix: INITSERIAL.1
CEEE 39               (    forth6809.asm):02091                     RTS
                      (    forth6809.asm):02092         
                      (    forth6809.asm):02093                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02094         ; ------------------------------------------------------------
                      (    forth6809.asm):02095         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02096         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02097         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02098         ; INFILL
                      (    forth6809.asm):02099         ;    Inputs:
                      (    forth6809.asm):02100         ;        none
                      (    forth6809.asm):02101         ;    Outputs:
                      (    forth6809.asm):02102         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02103         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02104         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02105         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02106                     SUBA  INTAIL
                      (    forth6809.asm):02107                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):02108                     RTS
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
                      (    forth6809.asm):02110         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02111         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02112         ; receive path with interrupts already masked.
                      (    forth6809.asm):02113         ; RTSCHECKHI
                      (    forth6809.asm):02114         ;    Inputs:
                      (    forth6809.asm):02115         ;        none
                      (    forth6809.asm):02116         ;    Outputs:
                      (    forth6809.asm):02117         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02118         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02119         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02120         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):02121                     CMPA  #INHIWATER
                      (    forth6809.asm):02122                     BLO   RTSCHIDONE
                      (    forth6809.asm):02123                     TST   RTSSTATE
                      (    forth6809.asm):02124                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):02125                     LDA   #CR_RTSHI
                      (    forth6809.asm):02126                     STA   ACIACR
                      (    forth6809.asm):02127                     LDA   #1
                      (    forth6809.asm):02128                     STA   RTSSTATE
CEEF                  (    forth6809.asm):02129         RTSCHIDONE: RTS
                      (    forth6809.asm):02130         ; ------------------------------------------------------------
                      (    forth6809.asm):02131         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02132         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02133         ; enables it only while output is pending.
                      (    forth6809.asm):02134         ; UPDATE_RTS
                      (    forth6809.asm):02135         ;    Inputs:
                      (    forth6809.asm):02136         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02137         ;    Outputs:
                      (    forth6809.asm):02138         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02139         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02140         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02141         UPDATE_RTS:
                      (    forth6809.asm):02142                     TST   RTSSTATE
                      (    forth6809.asm):02143                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02144         
                      (    forth6809.asm):02145                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02146                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02147         
                      (    forth6809.asm):02148                                             ; $B5/%1011_0101
                      (    forth6809.asm):02149                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02150                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02151         
CEEF                  (    forth6809.asm):02152         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02153                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02154                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02155         
CEEF                  (    forth6809.asm):02156         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02157                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02158                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CEEF                  (    forth6809.asm):02159         WRITE_CR:
                      (    forth6809.asm):02160                     STA   ACIACR
                      (    forth6809.asm):02161                     RTS
                      (    forth6809.asm):02162         ; ------------------------------------------------------------
                      (    forth6809.asm):02163         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02164         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02165         ; Called after a character is added to the ring.
                      (    forth6809.asm):02166         ; CHKHI
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        RegB = input ring fill level
                      (    forth6809.asm):02169         ;    Outputs:
                      (    forth6809.asm):02170         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02171         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02172         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02173         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02174         CHKHI:
                      (    forth6809.asm):02175                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02176                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02177                     TST   RTSSTATE
                      (    forth6809.asm):02178                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02179                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02180                     STA   RTSSTATE
                      (    forth6809.asm):02181                     JSR   UPDATE_RTS
CEEF                  (    forth6809.asm):02182         CHKHIDONE:  RTS
                      (    forth6809.asm):02183         
                      (    forth6809.asm):02184         ; ------------------------------------------------------------
                      (    forth6809.asm):02185         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02186         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02187         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02188         ; CHKLO
                      (    forth6809.asm):02189         ;    Inputs:
                      (    forth6809.asm):02190         ;        RegB = input ring fill level
                      (    forth6809.asm):02191         ;    Outputs:
                      (    forth6809.asm):02192         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02193         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02195         CHKLO:
                      (    forth6809.asm):02196                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02197                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02198                     TST   RTSSTATE
                      (    forth6809.asm):02199                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02200                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02201                     STA   RTSSTATE
                      (    forth6809.asm):02202                     JSR   UPDATE_RTS
CEEF                  (    forth6809.asm):02203         CHKLODONE:  RTS
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02206         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02207         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02208         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02209         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        none
                      (    forth6809.asm):02212         ;    Outputs:
                      (    forth6809.asm):02213         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02214         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02215         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02216         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02217         FLUSHOUTBUFFER:
                      (    forth6809.asm):02218                     LDB   OUTTAIL
                      (    forth6809.asm):02219                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02220                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02221         
                      (    forth6809.asm):02222                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02223                     BITA  #SR_CTS
                      (    forth6809.asm):02224                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02225         
                      (    forth6809.asm):02226                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02227                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02228                                             ; than spin-wait here.
                      (    forth6809.asm):02229         
                      (    forth6809.asm):02230                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02231                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02232                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02233         
                      (    forth6809.asm):02234                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02235                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02236                     STB   OUTTAIL
                      (    forth6809.asm):02237                                             ; One character sent - return rather than
                      (    forth6809.asm):02238                                             ; loop back for more (see header comment).
CEEF                  (    forth6809.asm):02239         FLUSHED:
                      (    forth6809.asm):02240                     RTS
                      (    forth6809.asm):02241         ; ------------------------------------------------------------
                      (    forth6809.asm):02242         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02243         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02244         ; PUTCHAR
                      (    forth6809.asm):02245         ;    Inputs:
                      (    forth6809.asm):02246         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02247         ;    Outputs:
                      (    forth6809.asm):02248         ;        none
                      (    forth6809.asm):02249         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02251         PUTCHAR:
                      (    forth6809.asm):02252                     PSHS  CC,X
                      (    forth6809.asm):02253                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02254         
                      (    forth6809.asm):02255                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02256                     INCB
                      (    forth6809.asm):02257                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02258                     CMPB  OUTTAIL
                      (    forth6809.asm):02259                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02260         
                      (    forth6809.asm):02261                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02262                     LDB   OUTHEAD
                      (    forth6809.asm):02263                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02264         
                      (    forth6809.asm):02265                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02266                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02267                     STB   OUTHEAD
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02270                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02271         
                      (    forth6809.asm):02272                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02273                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02274                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02275                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02276                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02277                                             ; expects the critical section active
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279                     BRA   PUT_EXIT
                      (    forth6809.asm):02280         
                      (    forth6809.asm):02281         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02282         ; priming the pump by transmitting a character.
CEEF                  (    forth6809.asm):02283         CHK_INT_PATH:
                      (    forth6809.asm):02284                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02285                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287                                             ; No! Restart.
                      (    forth6809.asm):02288                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02289                     LDB   OUTTAIL
                      (    forth6809.asm):02290                     LDA   B,X
                      (    forth6809.asm):02291                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02292         
                      (    forth6809.asm):02293                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02294                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02295                     STB   OUTTAIL
                      (    forth6809.asm):02296         
                      (    forth6809.asm):02297                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02298                     STA   OUTACTIVITY
                      (    forth6809.asm):02299                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02300         
CEEF                  (    forth6809.asm):02301         PUT_EXIT:
                      (    forth6809.asm):02302                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02303                                             ; by restoring the CC.
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
                      (    forth6809.asm):02305         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02306         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02307         ; GETCHAR
                      (    forth6809.asm):02308         ;    Inputs:
                      (    forth6809.asm):02309         ;        none
                      (    forth6809.asm):02310         ;    Outputs:
                      (    forth6809.asm):02311         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02312         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02313         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02314         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02315         GETCHAR:
                      (    forth6809.asm):02316                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02317                     CMPB  INHEAD
                      (    forth6809.asm):02318                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02319         
                      (    forth6809.asm):02320                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02321                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02322         
                      (    forth6809.asm):02323                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02324                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02325                     STB   INTAIL
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02328                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02329                     ORCC  #$10
                      (    forth6809.asm):02330                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02331                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02332                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02333                                             ; there's no already-loaded value here
                      (    forth6809.asm):02334                                             ; worth reusing.
                      (    forth6809.asm):02335                     JSR   CHKLO
                      (    forth6809.asm):02336                     ANDCC #$EF
                      (    forth6809.asm):02337         
                      (    forth6809.asm):02338                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02339                     RTS
                      (    forth6809.asm):02340         
CEEF                  (    forth6809.asm):02341         GET_NO_CHAR:
                      (    forth6809.asm):02342                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02343                     RTS
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02346         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02347         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02348         ; RTSCHECKLO
                      (    forth6809.asm):02349         ;    Inputs:
                      (    forth6809.asm):02350         ;        none
                      (    forth6809.asm):02351         ;    Outputs:
                      (    forth6809.asm):02352         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02353         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02354         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02355         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02356         RTSCHECKLO:
                      (    forth6809.asm):02357                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02358         
                      (    forth6809.asm):02359                     JSR   INFILL
                      (    forth6809.asm):02360                     CMPA  #INLOWATER
                      (    forth6809.asm):02361                     BHI   RTSCLODONE
                      (    forth6809.asm):02362                     TST   RTSSTATE
                      (    forth6809.asm):02363                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         
                      (    forth6809.asm):02366                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02367         
                      (    forth6809.asm):02368                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02369                     CMPB  OUTHEAD
                      (    forth6809.asm):02370                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02371         
                      (    forth6809.asm):02372                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02373                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02374                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02375         
CEEF                  (    forth6809.asm):02376         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02377                     STA   ACIACR
                      (    forth6809.asm):02378         
CEEF                  (    forth6809.asm):02379         RTSCLOUNMASK:
                      (    forth6809.asm):02380                     ANDCC #$EF
                      (    forth6809.asm):02381         
CEEF                  (    forth6809.asm):02382         RTSCLODONE: RTS
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02386         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02387         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02388         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02389         ; IRQH
                      (    forth6809.asm):02390         ;    Inputs:
                      (    forth6809.asm):02391         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02392         ;    Outputs:
                      (    forth6809.asm):02393         ;        none (returns with RTI)
                      (    forth6809.asm):02394         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02395         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
CEEF                  (    forth6809.asm):02397         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02400                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02401                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02402                     BNE   INCHAR
                      (    forth6809.asm):02403                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02404                     BNE   OUTCHAR
                      (    forth6809.asm):02405                                             ; Ignore all other interrupts such as DCD change.
CEEF                  (    forth6809.asm):02406         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02407                                             ; & restores state.
                      (    forth6809.asm):02408         
CEEF                  (    forth6809.asm):02409         INCHAR:
                      (    forth6809.asm):02410                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02411                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02412                                             ; Any receiver error flagged?
                      (    forth6809.asm):02413                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02414         
                      (    forth6809.asm):02415                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02416                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02417                     INC   FECOUNT           ; more than one bit can be set at once.
CEEF                  (    forth6809.asm):02418         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02419                     BEQ   INXOVRN
                      (    forth6809.asm):02420                     INC   OVRNCOUNT
CEEF                  (    forth6809.asm):02421         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02422                     BEQ   INXPE
                      (    forth6809.asm):02423                     INC   PECOUNT
CEEF                  (    forth6809.asm):02424         INXPE:      RTI
                      (    forth6809.asm):02425         
CEEF                  (    forth6809.asm):02426         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02427                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02428                     LDB   INHEAD
                      (    forth6809.asm):02429                     STA   B,X
                      (    forth6809.asm):02430                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02431                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02432                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02433                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02434                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02435                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02436                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02437                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02438                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02439                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02440                     JSR   CHKHI             ; Protect the in buffer from overflow.
CEEF                  (    forth6809.asm):02441         IRQDONE1:   RTI
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02444         
CEEF                  (    forth6809.asm):02445         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02446                     CMPB  OUTHEAD
                      (    forth6809.asm):02447                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02448         
                      (    forth6809.asm):02449                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02450                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02451                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02452         
                      (    forth6809.asm):02453                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02454                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02455                     STB   OUTTAIL
CEEF                  (    forth6809.asm):02456         IRQDONE2    RTI
                      (    forth6809.asm):02457         
CEEF                  (    forth6809.asm):02458         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02459                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02460                     CLR   OUTACTIVITY
                      (    forth6809.asm):02461                     JSR   UPDATE_RTS
CEEF                  (    forth6809.asm):02462         IRQDONE3    RTI
                      (    forth6809.asm):02463         
                      (    forth6809.asm):02464                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02465         
CEEF 3B               (    forth6809.asm):02466         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02467                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02468                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02469                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02470                                             ; the other unused vectors below
                      (    forth6809.asm):02471                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02472         
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
                      (    forth6809.asm):02474         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02475         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02476         ; ------------------------------------------------------------
CEF0 3B               (    forth6809.asm):02477         SWI3H:      RTI
CEF1 3B               (    forth6809.asm):02478         SWI2H:      RTI
CEF2 3B               (    forth6809.asm):02479         FIRQH:      RTI
CEF3 3B               (    forth6809.asm):02480         NMIH:       RTI                     ; unused now that NMI -> WARM
CEF4 CCFF9D           (    forth6809.asm):02481         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
CEF7 3606             (    forth6809.asm):02482                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
CEF9 7ED970           (    forth6809.asm):02483                     JMP   THROWW
                      (    forth6809.asm):02484         
                      (    forth6809.asm):02485         ; ============================================================
                      (    forth6809.asm):02486         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02487         ; ============================================================
                      (    forth6809.asm):02488         ; ------------------------------------------------------------
                      (    forth6809.asm):02489         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02490         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02491         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02492         ; COLD
                      (    forth6809.asm):02493         ;    Inputs:
                      (    forth6809.asm):02494         ;        none (entered at reset)
                      (    forth6809.asm):02495         ;    Outputs:
                      (    forth6809.asm):02496         ;        none (does not return)
                      (    forth6809.asm):02497         ;    Registers: all changed.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
CEFC CC0240           (    forth6809.asm):02499         COLD:       LDD   #APPVARS
CEFF DD0A             (    forth6809.asm):02500                     STD   VARHERE
CF01 CC7000           (    forth6809.asm):02501                     LDD   #APPCODE
CF04 DD08             (    forth6809.asm):02502                     STD   CODEHERE
CF06 CC2000           (    forth6809.asm):02503                     LDD   #APPDICT
CF09 DD06             (    forth6809.asm):02504                     STD   DPHERE
CF0B CCCEBA           (    forth6809.asm):02505                     LDD   #BASELATEST
CF0E DD04             (    forth6809.asm):02506                     STD   LATEST
CF10 BDD579           (    forth6809.asm):02507                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02508         
CF13 CC000A           (    forth6809.asm):02509                     LDD   #10
CF16 DD02             (    forth6809.asm):02510                     STD   BASE
                      (    forth6809.asm):02511         
CF18 CC0106           (    forth6809.asm):02512                     LDD   #TIBBUF
CF1B DD39             (    forth6809.asm):02513                     STD   SRCADDR
CF1D CC0000           (    forth6809.asm):02514                     LDD   #0
CF20 DD3B             (    forth6809.asm):02515                     STD   SRCLEN
CF22 DD3D             (    forth6809.asm):02516                     STD   SRCID
                      (    forth6809.asm):02517         
CF24 8ECFCA           (    forth6809.asm):02518                     LDX   #SIGNON
CF27 3610             (    forth6809.asm):02519                     PSHU  X                 ; c-addr
CF29 CC000F           (    forth6809.asm):02520                     LDD   #SIGNONL
CF2C 3606             (    forth6809.asm):02521                     PSHU  D                 ; u

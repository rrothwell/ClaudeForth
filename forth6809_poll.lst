                      (    forth6809.asm):03920         ; ------------------------------------------------------------
                      (    forth6809.asm):03921         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):03922         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):03923         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):03924         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):03925         ; ------------------------------------------------------------
E422 3706             (    forth6809.asm):03926         THROWW:     PULU  D                 ; n
E424 10830000         (    forth6809.asm):03927                     CMPD  #0
E428 2725             (    forth6809.asm):03928                     BEQ   THDONE
                      (    forth6809.asm):03929         
E42A DD0E             (    forth6809.asm):03930                     STD   THROWN
E42C 9E0C             (    forth6809.asm):03931                     LDX   HANDLER
E42E 2720             (    forth6809.asm):03932                     BEQ   THUNCAU
                      (    forth6809.asm):03933         
E430 1F14             (    forth6809.asm):03934                     TFR   X,S
E432 3506             (    forth6809.asm):03935                     PULS  D                 ; restore input source saved by CATCH
E434 DD10             (    forth6809.asm):03936                     STD   TOIN
E436 3506             (    forth6809.asm):03937                     PULS  D
E438 DD3D             (    forth6809.asm):03938                     STD   SRCID
E43A 3506             (    forth6809.asm):03939                     PULS  D
E43C DD3B             (    forth6809.asm):03940                     STD   SRCLEN
E43E 3506             (    forth6809.asm):03941                     PULS  D
E440 DD39             (    forth6809.asm):03942                     STD   SRCADDR
E442 3506             (    forth6809.asm):03943                     PULS  D
E444 1F03             (    forth6809.asm):03944                     TFR   D,U
E446 3506             (    forth6809.asm):03945                     PULS  D
E448 DD0C             (    forth6809.asm):03946                     STD   HANDLER
                      (    forth6809.asm):03947         
E44A DC0E             (    forth6809.asm):03948                     LDD   THROWN
E44C 3606             (    forth6809.asm):03949                     PSHU  D
E44E 39               (    forth6809.asm):03950                     RTS
E44F 39               (    forth6809.asm):03951         THDONE:     RTS
                      (    forth6809.asm):03952         

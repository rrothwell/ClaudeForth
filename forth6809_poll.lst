                      (    forth6809.asm):05212         ; ------------------------------------------------------------
                      (    forth6809.asm):05213         ; UNLOOP  ( -- )
                      (    forth6809.asm):05214         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05215         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05216         ; ------------------------------------------------------------
DC98 3510             (    forth6809.asm):05217         UNLOOPW:    PULS  X
DC9A 3266             (    forth6809.asm):05218                     LEAS  6,S
DC9C 3410             (    forth6809.asm):05219                     PSHS  X
DC9E 39               (    forth6809.asm):05220                     RTS
                      (    forth6809.asm):05221         
                      (    forth6809.asm):05222         ; ------------------------------------------------------------
                      (    forth6809.asm):05223         ; EXIT  ( -- )
                      (    forth6809.asm):05224         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05225         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05226         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05227         ; ------------------------------------------------------------
DC9F 108E0000         (    forth6809.asm):05228         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DCA3 1F31             (    forth6809.asm):05229                     TFR   U,X               ; X = scan pointer
DCA5 9C21             (    forth6809.asm):05230         EXSCAN:     CMPX  CSP
DCA7 270E             (    forth6809.asm):05231                     BEQ   EXSCANDONE
DCA9 EC84             (    forth6809.asm):05232                     LDD   ,X
DCAB 10830003         (    forth6809.asm):05233                     CMPD  #TAGDO
DCAF 2602             (    forth6809.asm):05234                     BNE   EXNOTDO
DCB1 3121             (    forth6809.asm):05235                     LEAY  1,Y
DCB3 3004             (    forth6809.asm):05236         EXNOTDO:    LEAX  4,X
DCB5 20EE             (    forth6809.asm):05237                     BRA   EXSCAN
DCB7                  (    forth6809.asm):05238         EXSCANDONE:
DCB7 3420             (    forth6809.asm):05239                     PSHS  Y                 ; the count survives CCALL on S
DCB9 CCDCC9           (    forth6809.asm):05240                     LDD   #EXITUNLOOP
DCBC 3606             (    forth6809.asm):05241                     PSHU  D
DCBE BDDDAB           (    forth6809.asm):05242                     JSR   CCALL
DCC1 3506             (    forth6809.asm):05243                     PULS  D
DCC3 3606             (    forth6809.asm):05244                     PSHU  D
DCC5 BDD08B           (    forth6809.asm):05245                     JSR   CODECOMMA
DCC8 39               (    forth6809.asm):05246                     RTS
                      (    forth6809.asm):05247         
                      (    forth6809.asm):05248         ; ------------------------------------------------------------
                      (    forth6809.asm):05249         ; Run-time part of EXIT: drop the address of the inline count, then
                      (    forth6809.asm):05250         ; return from the definition. Loop frames are not discarded.
                      (    forth6809.asm):05251         ; EXITUNLOOP
                      (    forth6809.asm):05252         ;    Inputs:
                      (    forth6809.asm):05253         ;        S holds the address of the inline count, then the return
                      (    forth6809.asm):05254         ;        address
                      (    forth6809.asm):05255         ;    Outputs:
                      (    forth6809.asm):05256         ;        returns to the caller of the definition
                      (    forth6809.asm):05257         ;    Registers: RegX and RegY changed.
                      (    forth6809.asm):05258         ; ------------------------------------------------------------
DCC9 3510             (    forth6809.asm):05259         EXITUNLOOP: PULS  X                 ; See bugfix: EXITUNLOOP.1
DCCB 3520             (    forth6809.asm):05260                     PULS  Y                 ; Y = return address
DCCD 6EA4             (    forth6809.asm):05261                     JMP   ,Y
                      (    forth6809.asm):05262         

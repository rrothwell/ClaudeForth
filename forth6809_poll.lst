DF41 3606             (    forth6809.asm):05767                     PSHU  D
DF43 AF42             (    forth6809.asm):05768                     STX   2,U
DF45 ED44             (    forth6809.asm):05769                     STD   4,U
DF47 39               (    forth6809.asm):05770                     RTS
                      (    forth6809.asm):05771         
                      (    forth6809.asm):05772         ; ------------------------------------------------------------
                      (    forth6809.asm):05773         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05774         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05775         ; ------------------------------------------------------------
DF48 3706             (    forth6809.asm):05776         PICKW:      PULU  D                 ; u
DF4A 58               (    forth6809.asm):05777                     LSLB
DF4B 49               (    forth6809.asm):05778                     ROLA
DF4C ECCB             (    forth6809.asm):05779                     LDD   D,U
DF4E 3606             (    forth6809.asm):05780                     PSHU  D
DF50 39               (    forth6809.asm):05781                     RTS
                      (    forth6809.asm):05782         
                      (    forth6809.asm):05783         ; ------------------------------------------------------------
                      (    forth6809.asm):05784         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05785         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05786         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05787         ; the cell being moved.
                      (    forth6809.asm):05788         ; ------------------------------------------------------------
DF51 ECC1             (    forth6809.asm):05789         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
DF53 2718             (    forth6809.asm):05790                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
DF55 1F02             (    forth6809.asm):05791                     TFR   D,Y               ; Y = cells to shift
DF57 58               (    forth6809.asm):05792                     LSLB
DF58 49               (    forth6809.asm):05793                     ROLA

                      (    forth6809.asm):08691         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):08692         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):08693         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):08694         ; WARM
                      (    forth6809.asm):08695         ;    Inputs:
                      (    forth6809.asm):08696         ;        NMI
                      (    forth6809.asm):08697         ;    Outputs:
                      (    forth6809.asm):08698         ;        does not return
                      (    forth6809.asm):08699         ;    Registers: all registers initialised.
                      (    forth6809.asm):08700         ; ------------------------------------------------------------

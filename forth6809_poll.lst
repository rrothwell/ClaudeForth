DCE2 CCE4F9           (    forth6809.asm):05282                     LDD   #EQUALW
DCE5 3606             (    forth6809.asm):05283                     PSHU  D
DCE7 BDDDAB           (    forth6809.asm):05284                     JSR   CCALL
DCEA CCCFEE           (    forth6809.asm):05285                     LDD   #ZBRANCH
DCED 3606             (    forth6809.asm):05286                     PSHU  D

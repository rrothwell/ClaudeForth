                      (    forth6809.asm):05264         ; CASE  ( C: -- case-sys )
                      (    forth6809.asm):05265         ; Start a CASE structure. Leave a filler cell and TAGCASE, a 4-byte
                      (    forth6809.asm):05266         ; frame like those of DO and OF, which the EXIT scan relies on.
                      (    forth6809.asm):05267         ; ------------------------------------------------------------
DCCF CC0000           (    forth6809.asm):05268         CASEW:      LDD   #0                ; filler. See bugfix: CASEW.1
DCD2 3606             (    forth6809.asm):05269                     PSHU  D

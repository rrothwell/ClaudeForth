                      (    forth6809.asm):08578         ; SECTION 26: CONSTANT-VALUE WORDS (TRUE, FALSE, 1, -1, 2, -2)
                      (    forth6809.asm):08579         ; ============================================================
                      (    forth6809.asm):08580         ; ------------------------------------------------------------
                      (    forth6809.asm):08581         ; TRUE  ( -- flag )
                      (    forth6809.asm):08582         ; Push true ($FFFF), the value of TRUEV. A direct LDD/PSHU/RTS: no
                      (    forth6809.asm):08583         ; DODOES trampoline and no value cell.
                      (    forth6809.asm):08584         ; Original comment: shadow TRUEW.0.
                      (    forth6809.asm):08585         ; ------------------------------------------------------------
FE2F CCFFFF           (    forth6809.asm):08586         TRUEW:      LDD   #$FFFF
FE32 3606             (    forth6809.asm):08587                     PSHU  D
FE34 39               (    forth6809.asm):08588                     RTS
                      (    forth6809.asm):08589         
                      (    forth6809.asm):08590         ; ------------------------------------------------------------
                      (    forth6809.asm):08591         ; FALSE  ( -- flag )
                      (    forth6809.asm):08592         ; Push false ($0000), the value of FALSEV.
                      (    forth6809.asm):08593         ; ------------------------------------------------------------
FE35 CC0000           (    forth6809.asm):08594         FALSEW:     LDD   #$0000
FE38 3606             (    forth6809.asm):08595                     PSHU  D
FE3A 39               (    forth6809.asm):08596                     RTS
                      (    forth6809.asm):08597         
                      (    forth6809.asm):08598         ; ------------------------------------------------------------
                      (    forth6809.asm):08599         ; 1  ( -- 1 )
                      (    forth6809.asm):08600         ; Push the constant 1. The words -1, 2 and -2 below work the same way.
                      (    forth6809.asm):08601         ; Their headers are H_POSONE, H_NEGONE, H_POSTWO and H_NEGTWO (Section
                      (    forth6809.asm):08602         ; 27), since "1" and "-1" are not valid assembler labels.
                      (    forth6809.asm):08603         ; Original comment: shadow POSONEW.0.
                      (    forth6809.asm):08604         ; ------------------------------------------------------------
FE3B CC0001           (    forth6809.asm):08605         POSONEW:    LDD   #1
FE3E 3606             (    forth6809.asm):08606                     PSHU  D
FE40 39               (    forth6809.asm):08607                     RTS
                      (    forth6809.asm):08608         
                      (    forth6809.asm):08609         ; ------------------------------------------------------------
                      (    forth6809.asm):08610         ; -1  ( -- -1 )
                      (    forth6809.asm):08611         ; Push the constant -1.
                      (    forth6809.asm):08612         ; ------------------------------------------------------------
FE41 CCFFFF           (    forth6809.asm):08613         NEGONEW:    LDD   #-1
FE44 3606             (    forth6809.asm):08614                     PSHU  D
FE46 39               (    forth6809.asm):08615                     RTS
                      (    forth6809.asm):08616         
                      (    forth6809.asm):08617         ; ------------------------------------------------------------
                      (    forth6809.asm):08618         ; 2  ( -- 2 )
                      (    forth6809.asm):08619         ; Push the constant 2.
                      (    forth6809.asm):08620         ; ------------------------------------------------------------
FE47 CC0002           (    forth6809.asm):08621         POSTWOW:    LDD   #2
FE4A 3606             (    forth6809.asm):08622                     PSHU  D
FE4C 39               (    forth6809.asm):08623                     RTS
                      (    forth6809.asm):08624         
                      (    forth6809.asm):08625         ; ------------------------------------------------------------
                      (    forth6809.asm):08626         ; -2  ( -- -2 )
                      (    forth6809.asm):08627         ; Push the constant -2.
                      (    forth6809.asm):08628         ; ------------------------------------------------------------
FE4D CCFFFE           (    forth6809.asm):08629         NEGTWOW:    LDD   #-2
FE50 3606             (    forth6809.asm):08630                     PSHU  D
FE52 39               (    forth6809.asm):08631                     RTS
                      (    forth6809.asm):08632         
                      (    forth6809.asm):08633         ; Verify no collision with init code,
                      (    forth6809.asm):08634         ; value should match ORG INITCODE.
     FE53             (    forth6809.asm):08635         BASECODEEND EQU   *
     2263             (    forth6809.asm):08636         BASECODESIZE EQU   BASECODEEND-BASECODE
                      (    forth6809.asm):08637         
                      (    forth6809.asm):08638         ; Prevent the assembler from extinguishing the gap between the

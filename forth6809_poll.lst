                      (    forth6809.asm):05577         ; ------------------------------------------------------------
                      (    forth6809.asm):05578         ; POSTPONE  ( "name" -- )
                      (    forth6809.asm):05579         ; If the name is immediate, compile a call to it now. Otherwise
                      (    forth6809.asm):05580         ; compile its xt as a literal followed by a call to COMPILE, so that

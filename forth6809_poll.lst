                      (    forth6809.asm):07147         ; ------------------------------------------------------------
                      (    forth6809.asm):07148         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07149         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07150         ;    Inputs:
                      (    forth6809.asm):07151         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07152         ;        c-addr u on the data stack
                      (    forth6809.asm):07153         ;    Outputs:
                      (    forth6809.asm):07154         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07155         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07156         ; ------------------------------------------------------------
F2AE 3606             (    forth6809.asm):07157         CSTRCOMP:   PSHU  D

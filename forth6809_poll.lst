                      (    forth6809.asm):05651         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05652         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05653         ; the string.
                      (    forth6809.asm):05654         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05655         ;    Inputs:
                      (    forth6809.asm):05656         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05657         ;        count byte
                      (    forth6809.asm):05658         ;    Outputs:
                      (    forth6809.asm):05659         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05660         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05661         ; ------------------------------------------------------------
DD9D                  (    forth6809.asm):05662         DOABORTQUOTE:
DD9D 3510             (    forth6809.asm):05663                     PULS  X
DD9F E684             (    forth6809.asm):05664                     LDB   ,X

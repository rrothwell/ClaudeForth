E8D9 3606             (    forth6809.asm):05168                     PSHU  D
E8DB BDE403           (    forth6809.asm):05169                     JSR   THROWW
E8DE CC0020           (    forth6809.asm):05170         XCSTOK:     LDD   #32
E8E1 3606             (    forth6809.asm):05171                     PSHU  D

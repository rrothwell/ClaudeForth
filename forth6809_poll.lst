EDC0 6C43             (    forth6809.asm):08620                     INC   3,U
EDC2 5A               (    forth6809.asm):08621         UDNEXT:     DECB
EDC3 26EC             (    forth6809.asm):08622                     BNE   UDDLOOP
EDC5 39               (    forth6809.asm):08623                     RTS
                      (    forth6809.asm):08624         
                      (    forth6809.asm):08625         ; ------------------------------------------------------------
                      (    forth6809.asm):08626         ; #S  ( ud -- 0 0 )
                      (    forth6809.asm):08627         ; Convert digits with # until the quotient is zero (at least one digit
                      (    forth6809.asm):08628         ; is produced).
                      (    forth6809.asm):08629         ; ------------------------------------------------------------
EDC6 BDED99           (    forth6809.asm):08630         NUMSW:      JSR   NUMW

                      (    forth6809.asm):07202         ; ------------------------------------------------------------
                      (    forth6809.asm):07203         ; S\"  ( "ccc<quote>" -- c-addr u )
                      (    forth6809.asm):07204         ; As S", but the text may contain escape sequences introduced by a
                      (    forth6809.asm):07205         ; backslash, and a backslash-quote does not end the string. The
                      (    forth6809.asm):07206         ; translated text is built at PAD and then handled exactly like S" text
                      (    forth6809.asm):07207         ; (SQSTATE). The escapes are: \a 7, \b 8, \e 27, \f 12, \l 10, \m the
                      (    forth6809.asm):07208         ; pair 13 10, \n 10, \q 34, \r 13, \t 9, \v 11, \z 0, \" 34, \\ 92 and
                      (    forth6809.asm):07209         ; \xhh (one or two hex digits). Any other character after a backslash
                      (    forth6809.asm):07210         ; stands for itself. An unterminated string ends at the end of the line.
                      (    forth6809.asm):07211         ; A result over 255 characters throws -18.
                      (    forth6809.asm):07212         ; Frame on S: 0,S input end, 2,S output start, 4,S output pointer.
                      (    forth6809.asm):07213         ; ------------------------------------------------------------
F2ED BDDC35           (    forth6809.asm):07214         SQUOTEESCW: JSR   PADW              ; leaves PAD on the data stack
F2F0 ECC4             (    forth6809.asm):07215                     LDD   ,U
F2F2 3406             (    forth6809.asm):07216                     PSHS  D                 ; output pointer
F2F4 3406             (    forth6809.asm):07217                     PSHS  D                 ; output start
F2F6 DC39             (    forth6809.asm):07218                     LDD   SRCADDR
F2F8 D33B             (    forth6809.asm):07219                     ADDD  SRCLEN
F2FA 3406             (    forth6809.asm):07220                     PSHS  D                 ; input end
F2FC DC39             (    forth6809.asm):07221                     LDD   SRCADDR
F2FE D310             (    forth6809.asm):07222                     ADDD  TOIN
F300 1F02             (    forth6809.asm):07223                     TFR   D,Y               ; input pointer
F302 10AC60           (    forth6809.asm):07224         SQEL:       CMPY  0,S
F305 247E             (    forth6809.asm):07225                     BHS   SQEND
F307 A6A0             (    forth6809.asm):07226                     LDA   ,Y+
F309 8122             (    forth6809.asm):07227                     CMPA  #34
F30B 2778             (    forth6809.asm):07228                     BEQ   SQEND
F30D 815C             (    forth6809.asm):07229                     CMPA  #92
F30F 261C             (    forth6809.asm):07230                     BNE   SQEPUT
F311 10AC60           (    forth6809.asm):07231                     CMPY  0,S
F314 246F             (    forth6809.asm):07232                     BHS   SQEND
F316 A6A0             (    forth6809.asm):07233                     LDA   ,Y+               ; the escaped character
F318 8178             (    forth6809.asm):07234                     CMPA  #'x'

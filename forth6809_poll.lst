EA42 ED42             (    forth6809.asm):07920         CMMINSET:   STD   2,U               ; the c-addr2 slot is free now: use it as
EA44 EC42             (    forth6809.asm):07921         CMPLOOP:    LDD   2,U               ; the remaining count
EA46 2711             (    forth6809.asm):07922                     BEQ   CMTIEBREAK
EA48 A680             (    forth6809.asm):07923                     LDA   ,X+
EA4A A1A0             (    forth6809.asm):07924                     CMPA  ,Y+
EA4C 2519             (    forth6809.asm):07925                     BLO   CMLT
EA4E 221C             (    forth6809.asm):07926                     BHI   CMGT
EA50 EC42             (    forth6809.asm):07927                     LDD   2,U
EA52 830001           (    forth6809.asm):07928                     SUBD  #1
EA55 ED42             (    forth6809.asm):07929                     STD   2,U
EA57 20EB             (    forth6809.asm):07930                     BRA   CMPLOOP
EA59 EC44             (    forth6809.asm):07931         CMTIEBREAK: LDD   4,U
EA5B 10A3C4           (    forth6809.asm):07932                     CMPD  ,U
EA5E 2507             (    forth6809.asm):07933                     BLO   CMLT
EA60 220A             (    forth6809.asm):07934                     BHI   CMGT
EA62 CC0000           (    forth6809.asm):07935                     LDD   #0

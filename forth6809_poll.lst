                      (    forth6809.asm):05105         
                      (    forth6809.asm):05106         ; ------------------------------------------------------------
                      (    forth6809.asm):05107         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05108         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05109         ; of this call is on top of S, so it is lifted off and put back around

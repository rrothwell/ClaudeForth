                      (    forth6809.asm):07291         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):07292         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):07293         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):07294         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):07295         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):07296         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):07297         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):07298         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):07299         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):07300         ; M*/W
                      (    forth6809.asm):07301         ;    Inputs:
                      (    forth6809.asm):07302         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):07303         ;    Outputs:
                      (    forth6809.asm):07304         ;        d2 on the data stack
                      (    forth6809.asm):07305         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):07306         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):07307         ; ------------------------------------------------------------

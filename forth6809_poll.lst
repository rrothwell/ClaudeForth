DF38 ED42             (    forth6809.asm):05757                     STD   2,U
DF3A 3342             (    forth6809.asm):05758                     LEAU  2,U
DF3C 39               (    forth6809.asm):05759                     RTS
                      (    forth6809.asm):05760         
                      (    forth6809.asm):05761         ; ------------------------------------------------------------
                      (    forth6809.asm):05762         ; TUCK  ( x1 x2 -- x2 x1 x2 )

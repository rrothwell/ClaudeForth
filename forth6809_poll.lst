CE08 2008             (    forth6809.asm):02553                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02554         
                      (    forth6809.asm):02555         ; ------------------------------------------------------------
                      (    forth6809.asm):02556         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02557         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02558         ; ------------------------------------------------------------
CE0A CCFFFF           (    forth6809.asm):02559         ABORTW:     LDD   #-1
CE0D 3606             (    forth6809.asm):02560                     PSHU  D                 ; throw code (-1)
CE0F 7ED895           (    forth6809.asm):02561                     JMP   THROWW
                      (    forth6809.asm):02562         
                      (    forth6809.asm):02563         ; ------------------------------------------------------------
                      (    forth6809.asm):02564         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02565         ; ABORT
                      (    forth6809.asm):02566         ;    Inputs:
                      (    forth6809.asm):02567         ;        none
                      (    forth6809.asm):02568         ;    Outputs:
                      (    forth6809.asm):02569         ;        none (does not return)
                      (    forth6809.asm):02570         ;    Registers: RegU changed.
                      (    forth6809.asm):02571         ; ------------------------------------------------------------
CE12 CEBD00           (    forth6809.asm):02572         ABORT:      LDU   #SP0
                      (    forth6809.asm):02573                     ; falls through into QUIT
                      (    forth6809.asm):02574         
                      (    forth6809.asm):02575         ; ------------------------------------------------------------
                      (    forth6809.asm):02576         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02577         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02578         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02579         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02580         ; ------------------------------------------------------------
CE15 10CEC000         (    forth6809.asm):02581         QUITW:      LDS   #RP0
CE19 CC0000           (    forth6809.asm):02582                     LDD   #0
CE1C DD00             (    forth6809.asm):02583                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02584         
CE1E BDD840           (    forth6809.asm):02585         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02586         
CE21 DC06             (    forth6809.asm):02587                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
CE23 3406             (    forth6809.asm):02588                     PSHS  D                 ; and THROW restore S, so the frame is
CE25 DC08             (    forth6809.asm):02589                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
CE27 3406             (    forth6809.asm):02590                     PSHS  D                 ; See shadow QLOOP.2
CE29 DC0A             (    forth6809.asm):02591                     LDD   VARHERE
CE2B 3406             (    forth6809.asm):02592                     PSHS  D
CE2D DC04             (    forth6809.asm):02593                     LDD   LATEST
CE2F 3406             (    forth6809.asm):02594                     PSHS  D
                      (    forth6809.asm):02595         
CE31 CCD28F           (    forth6809.asm):02596                     LDD   #INTERPRET
CE34 3606             (    forth6809.asm):02597                     PSHU  D                 ; xt
CE36 BDD869           (    forth6809.asm):02598                     JSR   CATCHW
CE39 3706             (    forth6809.asm):02599                     PULU  D                 ; throw code (0 = no error)
CE3B 3406             (    forth6809.asm):02600                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
CE3D 10830000         (    forth6809.asm):02601                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
CE41 2747             (    forth6809.asm):02602                     BEQ   QOK
                      (    forth6809.asm):02603         
CE43 EC68             (    forth6809.asm):02604                     LDD   8,S
CE45 DD06             (    forth6809.asm):02605                     STD   DPHERE
CE47 BDD486           (    forth6809.asm):02606                     JSR   PRUNE             ; unlink headers newer than DPHERE
CE4A EC66             (    forth6809.asm):02607                     LDD   6,S
CE4C DD08             (    forth6809.asm):02608                     STD   CODEHERE
CE4E EC64             (    forth6809.asm):02609                     LDD   4,S
CE50 DD0A             (    forth6809.asm):02610                     STD   VARHERE
CE52 EC62             (    forth6809.asm):02611                     LDD   2,S
CE54 DD04             (    forth6809.asm):02612                     STD   LATEST
CE56 CEBD00           (    forth6809.asm):02613                     LDU   #SP0
                      (    forth6809.asm):02614         
                      (    forth6809.asm):02615                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02616                     ; See bugfix: QLOOP.1
CE59 CC0000           (    forth6809.asm):02617                     LDD   #0
CE5C DD00             (    forth6809.asm):02618                     STD   STATE
                      (    forth6809.asm):02619         
CE5E BDD7BA           (    forth6809.asm):02620                     JSR   IOVINIT           ; Undo any EMIT/KEY redirection so the
                      (    forth6809.asm):02621                                             ; error message reaches the terminal
CE61 ECE4             (    forth6809.asm):02622                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
CE63 1083FFFF         (    forth6809.asm):02623                     CMPD  #-1
CE67 2605             (    forth6809.asm):02624                     BNE   QSHOWERR

                      (    forth6809.asm):09096         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):09097         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):09098         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):09099         ; WARM
                      (    forth6809.asm):09100         ;    Inputs:
                      (    forth6809.asm):09101         ;        NMI
                      (    forth6809.asm):09102         ;    Outputs:
                      (    forth6809.asm):09103         ;        does not return
                      (    forth6809.asm):09104         ;    Registers: all registers initialised.
                      (    forth6809.asm):09105         ; ------------------------------------------------------------
FFC8 1A50             (    forth6809.asm):09106         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFCA 4F               (    forth6809.asm):09107                     CLRA
FFCB 1F8B             (    forth6809.asm):09108                     TFR   A,DP
FFCD CEBD00           (    forth6809.asm):09109                     LDU   #SP0

D46D A684             (    forth6809.asm):03655                     LDA   ,X
D46F 8540             (    forth6809.asm):03656                     BITA  #$40
D471 2620             (    forth6809.asm):03657                     BNE   FDNEXT            ; smudged
D473 841F             (    forth6809.asm):03658                     ANDA  #$1F
D475 A1E4             (    forth6809.asm):03659                     CMPA  ,S
D477 261A             (    forth6809.asm):03660                     BNE   FDNEXT
D479 3410             (    forth6809.asm):03661                     PSHS  X                 ; header, kept across the compare
D47B 3001             (    forth6809.asm):03662                     LEAX  1,X
D47D 10AE63           (    forth6809.asm):03663                     LDY   3,S               ; name text
D480 E662             (    forth6809.asm):03664                     LDB   2,S               ; length
D482 2709             (    forth6809.asm):03665                     BEQ   FDHIT

                      (    forth6809.asm):03958         ; ============================================================
                      (    forth6809.asm):03959         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):03960         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):03961         ; ============================================================
                      (    forth6809.asm):03962         ; ------------------------------------------------------------
                      (    forth6809.asm):03963         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):03964         ; location.
                      (    forth6809.asm):03965         ; PATCH   ( target location -- )
                      (    forth6809.asm):03966         ;    Inputs:
                      (    forth6809.asm):03967         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):03968         ;    Outputs:
                      (    forth6809.asm):03969         ;        the cell at location holds target - location
                      (    forth6809.asm):03970         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):03971         ; ------------------------------------------------------------
E457 3710             (    forth6809.asm):03972         PATCH:      PULU  X                 ; location
E459 3706             (    forth6809.asm):03973                     PULU  D                 ; target
E45B 3410             (    forth6809.asm):03974                     PSHS  X
E45D A3E1             (    forth6809.asm):03975                     SUBD  ,S++              ; target - location
E45F ED84             (    forth6809.asm):03976                     STD   ,X
E461 39               (    forth6809.asm):03977                     RTS
                      (    forth6809.asm):03978         
                      (    forth6809.asm):03979         ; ------------------------------------------------------------
                      (    forth6809.asm):03980         ; IF  ( C: -- orig )
                      (    forth6809.asm):03981         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):03982         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):03983         ; ------------------------------------------------------------
E462 CCDD18           (    forth6809.asm):03984         IFW:        LDD   #ZBRANCH
E465 3606             (    forth6809.asm):03985                     PSHU  D
E467 BDE85D           (    forth6809.asm):03986                     JSR   CCALL
E46A CC0000           (    forth6809.asm):03987                     LDD   #0
E46D 3606             (    forth6809.asm):03988                     PSHU  D
E46F BDDDA2           (    forth6809.asm):03989                     JSR   CODECOMMA
E472 DC08             (    forth6809.asm):03990                     LDD   CODEHERE
E474 830002           (    forth6809.asm):03991                     SUBD  #2
E477 3606             (    forth6809.asm):03992                     PSHU  D                 ; orig
E479 CC0001           (    forth6809.asm):03993                     LDD   #TAGFWD
E47C 3606             (    forth6809.asm):03994                     PSHU  D
E47E 39               (    forth6809.asm):03995                     RTS
                      (    forth6809.asm):03996         
                      (    forth6809.asm):03997         ; ------------------------------------------------------------
                      (    forth6809.asm):03998         ; THEN  ( C: orig -- )
                      (    forth6809.asm):03999         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04000         ; operand to jump to the current code address.
                      (    forth6809.asm):04001         ; ------------------------------------------------------------
E47F 3706             (    forth6809.asm):04002         THENW:      PULU  D
E481 10830001         (    forth6809.asm):04003                     CMPD  #TAGFWD
E485 2703             (    forth6809.asm):04004                     BEQ   THOK
E487 BDE3ED           (    forth6809.asm):04005                     JSR   CFERR

                      (    forth6809.asm):07292         ; M*/  ( d1 n1 +n2 -- d2 )
                      (    forth6809.asm):07293         ; Multiply d1 by n1 into a 48-bit intermediate product and divide it
                      (    forth6809.asm):07294         ; by n2. The quotient is truncated toward zero (like */ and symmetric
                      (    forth6809.asm):07295         ; division in this system) and its low 32 bits are returned. THROW -10
                      (    forth6809.asm):07296         ; if n2 is zero. Method: take the magnitudes; form |d1.lo|*|n1| and
                      (    forth6809.asm):07297         ; |d1.hi|*|n1| with UMUL32 and add them into three words P2:P1:P0;
                      (    forth6809.asm):07298         ; then divide P2, then R:P1, then R:P0 by |n2| with UDIV32, each a
                      (    forth6809.asm):07299         ; 32/16 division whose quotient fits in 16 bits. The sign is applied
                      (    forth6809.asm):07300         ; to the 32-bit result at the end. See shadow M*/W.1.
                      (    forth6809.asm):07301         ; M*/W
                      (    forth6809.asm):07302         ;    Inputs:
                      (    forth6809.asm):07303         ;        d1 n1 n2 on the data stack (n2 on top)
                      (    forth6809.asm):07304         ;    Outputs:
                      (    forth6809.asm):07305         ;        d2 on the data stack
                      (    forth6809.asm):07306         ;    Registers: RegD, RegX changed; PRODHI/PRODLO, DIVDEN, DIVREM,
                      (    forth6809.asm):07307         ;        MAHI-MBLO used. S frame: 0,S sign, 1,S P0, 3,S P1, 5,S P2.
                      (    forth6809.asm):07308         ; ------------------------------------------------------------
E5BA                  (    forth6809.asm):07309         MSTARSLASHW:
E5BA ECC4             (    forth6809.asm):07310                     LDD   ,U
E5BC 2608             (    forth6809.asm):07311                     BNE   MSLOK
E5BE CCFFF6           (    forth6809.asm):07312                     LDD   #-10              ; -10, division by zero
E5C1 3606             (    forth6809.asm):07313                     PSHU  D
E5C3 BDD895           (    forth6809.asm):07314                     JSR   THROWW
E5C6 3279             (    forth6809.asm):07315         MSLOK:      LEAS  -7,S
E5C8 6FE4             (    forth6809.asm):07316                     CLR   ,S                ; sign of the result
E5CA ECC4             (    forth6809.asm):07317                     LDD   ,U                ; |n2|
E5CC 2A09             (    forth6809.asm):07318                     BPL   MSLN1
E5CE 63E4             (    forth6809.asm):07319                     COM   ,S
E5D0 43               (    forth6809.asm):07320                     COMA
E5D1 53               (    forth6809.asm):07321                     COMB
E5D2 C30001           (    forth6809.asm):07322                     ADDD  #1
E5D5 EDC4             (    forth6809.asm):07323                     STD   ,U
E5D7 EC42             (    forth6809.asm):07324         MSLN1:      LDD   2,U               ; |n1|
E5D9 2A09             (    forth6809.asm):07325                     BPL   MSLD1

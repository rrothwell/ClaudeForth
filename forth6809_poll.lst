                      (    forth6809.asm):03947         ; ------------------------------------------------------------
                      (    forth6809.asm):03948         ; GET-CURRENT  ( -- wid )
                      (    forth6809.asm):03949         ; Return the WID of the wordlist that receives new definitions.
                      (    forth6809.asm):03950         ; ------------------------------------------------------------
D646 DC47             (    forth6809.asm):03951         GETCURW:    LDD   CURRENT

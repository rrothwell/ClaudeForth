                      (    forth6809.asm):05184         ; ------------------------------------------------------------
                      (    forth6809.asm):05185         ; >BODY  ( xt -- a-addr )
                      (    forth6809.asm):05186         ; Return the data-field address of a CREATEd word: the cell at xt+5 of
                      (    forth6809.asm):05187         ; its JSR DODOES trampoline.
                      (    forth6809.asm):05188         ; ------------------------------------------------------------
E8FF 3706             (    forth6809.asm):05189         TOBODYW:    PULU  D                 ; xt
E901 C30005           (    forth6809.asm):05190                     ADDD  #5

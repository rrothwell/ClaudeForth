                      (    forth6809.asm):05309         ; UNLOOP  ( -- )
                      (    forth6809.asm):05310         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):05311         ; return address, so that a following I or J sees the enclosing loop.
                      (    forth6809.asm):05312         ; ------------------------------------------------------------
DBBD 3510             (    forth6809.asm):05313         UNLOOPW:    PULS  X

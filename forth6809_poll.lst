                      (    forth6809.asm):04501         ; ------------------------------------------------------------
                      (    forth6809.asm):04502         ; REPEAT  ( C: orig dest -- )
                      (    forth6809.asm):04503         ; Compile BRANCH back to the BEGIN address and resolve the WHILE
                      (    forth6809.asm):04504         ; branch to just after it. A BEGIN frame beneath further open WHILE
                      (    forth6809.asm):04505         ; frames is found by scanning, and removed from beneath them.

E664 ED62             (    forth6809.asm):04318                     STD   2,S
E666 10A364           (    forth6809.asm):04319                     CMPD  4,S               ; limit
E669 2709             (    forth6809.asm):04320                     BEQ   DTEXIT
E66B 3510             (    forth6809.asm):04321                     PULS  X                 ; X = branch operand address
E66D EC84             (    forth6809.asm):04322                     LDD   ,X
E66F 308B             (    forth6809.asm):04323                     LEAX  D,X
E671 3410             (    forth6809.asm):04324                     PSHS  X                 ; return to loop start
E673 39               (    forth6809.asm):04325                     RTS
E674 3510             (    forth6809.asm):04326         DTEXIT:     PULS  X
E676 3002             (    forth6809.asm):04327                     LEAX  2,X               ; skip the branch operand
E678 3266             (    forth6809.asm):04328                     LEAS  6,S               ; discard the loop frame
E67A 3410             (    forth6809.asm):04329                     PSHS  X
E67C 39               (    forth6809.asm):04330                     RTS

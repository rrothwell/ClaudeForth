                      (    forth6809.asm):04302         ; ============================================================
                      (    forth6809.asm):04303                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04304         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04305         
                      (    forth6809.asm):04306         ; ------------------------------------------------------------
                      (    forth6809.asm):04307         ; KEY  ( -- char )
                      (    forth6809.asm):04308         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04309         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04310         ; ------------------------------------------------------------
DBB7                  (    forth6809.asm):04311         KEYW:
                      (    forth6809.asm):04312         
                      (    forth6809.asm):04313                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04314                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04315         
                      (    forth6809.asm):04316                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04317                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04318                                             ; by transmitting all chars.
                      (    forth6809.asm):04319         
DBB7                  (    forth6809.asm):04320         TRY_READ:
                      (    forth6809.asm):04321                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04322                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04323                                             ; while still transmitting!
                      (    forth6809.asm):04324         
                      (    forth6809.asm):04325                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04326                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04327                     PSHU  D                 ; char
                      (    forth6809.asm):04328         
                      (    forth6809.asm):04329                     RTS
                      (    forth6809.asm):04330         
                      (    forth6809.asm):04331         ; ------------------------------------------------------------
                      (    forth6809.asm):04332         ; KEY?  ( -- flag )
                      (    forth6809.asm):04333         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04334         ; ------------------------------------------------------------
DBB7                  (    forth6809.asm):04335         KEYQW:
                      (    forth6809.asm):04336                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04337         
                      (    forth6809.asm):04338                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04339                     CMPA  INTAIL
                      (    forth6809.asm):04340         
                      (    forth6809.asm):04341                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04342         
                      (    forth6809.asm):04343                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04344         
                      (    forth6809.asm):04345                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04346                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04347         
                      (    forth6809.asm):04348                     RTS
                      (    forth6809.asm):04349         
DBB7                  (    forth6809.asm):04350         KQTRUE:
                      (    forth6809.asm):04351                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04352                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04353                     RTS
                      (    forth6809.asm):04354         
                      (    forth6809.asm):04355         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04356         
                      (    forth6809.asm):04357         ; ------------------------------------------------------------
                      (    forth6809.asm):04358         ; EMIT  ( char -- )
                      (    forth6809.asm):04359         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04360         ; discarded if the ring is full.
                      (    forth6809.asm):04361         ; ------------------------------------------------------------
DBB7                  (    forth6809.asm):04362         EMITW:
                      (    forth6809.asm):04363                     PULU  D                 ; char
                      (    forth6809.asm):04364                     TFR   B,A
                      (    forth6809.asm):04365                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04366                     RTS
                      (    forth6809.asm):04367         
                      (    forth6809.asm):04368                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04369         ; ------------------------------------------------------------
                      (    forth6809.asm):04370         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04371         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04372         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04373         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04374         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04375         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04376         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04377         ; follow.
                      (    forth6809.asm):04378         ; ------------------------------------------------------------
DBB7                  (    forth6809.asm):04379         KEYW:
DBB7 B6C008           (    forth6809.asm):04380                     LDA   ACIASR
DBBA 8501             (    forth6809.asm):04381                     BITA  #SR_RDRF
DBBC 2705             (    forth6809.asm):04382                     BEQ   KWAIT
DBBE 7C017F           (    forth6809.asm):04383                     INC   POLLREADYCNT      ; character was already queued when we
DBC1 2007             (    forth6809.asm):04384                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
DBC3                  (    forth6809.asm):04385         KWAIT:
DBC3 B6C008           (    forth6809.asm):04386         KSPIN:      LDA   ACIASR
DBC6 8501             (    forth6809.asm):04387                     BITA  #SR_RDRF
DBC8 27F9             (    forth6809.asm):04388                     BEQ   KSPIN
DBCA                  (    forth6809.asm):04389         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04390                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04391                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04392                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04393                                             ; RDRF and the latched error bits together
DBCA 8570             (    forth6809.asm):04394                     BITA  #SR_FE+SR_OVRN+SR_PE
DBCC 2715             (    forth6809.asm):04395                     BEQ   KGETCH
DBCE 8510             (    forth6809.asm):04396                     BITA  #SR_FE
DBD0 2703             (    forth6809.asm):04397                     BEQ   KXFE
DBD2 7C017C           (    forth6809.asm):04398                     INC   FECOUNT
DBD5 8520             (    forth6809.asm):04399         KXFE:       BITA  #SR_OVRN
DBD7 2703             (    forth6809.asm):04400                     BEQ   KXOVRN
DBD9 7C017D           (    forth6809.asm):04401                     INC   OVRNCOUNT
DBDC 8540             (    forth6809.asm):04402         KXOVRN:     BITA  #SR_PE
DBDE 2703             (    forth6809.asm):04403                     BEQ   KGETCH

                      (    forth6809.asm):03261         
                      (    forth6809.asm):03262         ; ------------------------------------------------------------
                      (    forth6809.asm):03263         ; 2CONSTANT  ( x1 x2 "name" -- )
                      (    forth6809.asm):03264         ; Build a word that returns x1 x2. The pair is stored in the code area
                      (    forth6809.asm):03265         ; with x2 at the lower address, as 2@ and 2! expect.
                      (    forth6809.asm):03266         ; ------------------------------------------------------------

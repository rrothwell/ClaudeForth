                      (    forth6809.asm):03675         ; ------------------------------------------------------------
                      (    forth6809.asm):03676         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03677         ; ROOT, for a name.
                      (    forth6809.asm):03678         ; SRCHORD
                      (    forth6809.asm):03679         ;    Inputs:
                      (    forth6809.asm):03680         ;        RegY = address of the name text
                      (    forth6809.asm):03681         ;        RegB = name length
                      (    forth6809.asm):03682         ;    Outputs:
                      (    forth6809.asm):03683         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03684         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03685         ; ------------------------------------------------------------
D4D2 3424             (    forth6809.asm):03686         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D4D4 8E004B           (    forth6809.asm):03687                     LDX   #ORDER
D4D7 3410             (    forth6809.asm):03688                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D4D9 AEE4             (    forth6809.asm):03689         SOLOOP:     LDX   ,S
D4DB 9C49             (    forth6809.asm):03690                     CMPX  ORDEND
D4DD 2415             (    forth6809.asm):03691                     BHS   SOROOT

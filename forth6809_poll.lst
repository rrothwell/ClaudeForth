E7B6 3606             (    forth6809.asm):07466                     PSHU  D
E7B8 3085             (    forth6809.asm):07467                     LEAX  B,X
E7BA 3410             (    forth6809.asm):07468                     PSHS  X
E7BC 39               (    forth6809.asm):07469                     RTS
                      (    forth6809.asm):07470         
                      (    forth6809.asm):07471         ; ------------------------------------------------------------
                      (    forth6809.asm):07472         ; Parse the text up to the next double quote for S", ." and ABORT".
                      (    forth6809.asm):07473         ; WORD cannot be used: it skips leading delimiters, so an empty string
                      (    forth6809.asm):07474         ; (S" ") ran on to the next quote in the source. PARSE does not skip.
                      (    forth6809.asm):07475         ; PARSEQUOTE
                      (    forth6809.asm):07476         ;    Inputs:
                      (    forth6809.asm):07477         ;        none (parses from >IN)
                      (    forth6809.asm):07478         ;    Outputs:
                      (    forth6809.asm):07479         ;        c-addr u on the data stack: the text in the input buffer.
                      (    forth6809.asm):07480         ;        THROW -18 if the text is longer than 255 characters.
                      (    forth6809.asm):07481         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07482         ; ------------------------------------------------------------
E7BD CC0022           (    forth6809.asm):07483         PARSEQUOTE: LDD   #34
E7C0 3606             (    forth6809.asm):07484                     PSHU  D
E7C2 BDE993           (    forth6809.asm):07485                     JSR   PARSEW
E7C5 6DC4             (    forth6809.asm):07486                     TST   ,U                ; high byte of the length
E7C7 2601             (    forth6809.asm):07487                     BNE   PQLONG
E7C9 39               (    forth6809.asm):07488                     RTS
E7CA CCFFEE           (    forth6809.asm):07489         PQLONG:     LDD   #-18
E7CD 3606             (    forth6809.asm):07490                     PSHU  D
E7CF 7ED941           (    forth6809.asm):07491                     JMP   THROWW
                      (    forth6809.asm):07492         
                      (    forth6809.asm):07493         ; ------------------------------------------------------------
                      (    forth6809.asm):07494         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07495         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07496         ;    Inputs:
                      (    forth6809.asm):07497         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07498         ;        c-addr u on the data stack
                      (    forth6809.asm):07499         ;    Outputs:
                      (    forth6809.asm):07500         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07501         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07502         ; ------------------------------------------------------------
E7D2 3606             (    forth6809.asm):07503         CSTRCOMP:   PSHU  D
E7D4 BDDD7C           (    forth6809.asm):07504                     JSR   CCALL
E7D7 3706             (    forth6809.asm):07505                     PULU  D                 ; u
E7D9 3720             (    forth6809.asm):07506                     PULU  Y                 ; c-addr
E7DB 9E08             (    forth6809.asm):07507                     LDX   CODEHERE
E7DD E780             (    forth6809.asm):07508                     STB   ,X+
E7DF 5D               (    forth6809.asm):07509                     TSTB
E7E0 2707             (    forth6809.asm):07510                     BEQ   CSEND
E7E2 A6A0             (    forth6809.asm):07511         CSCPY:      LDA   ,Y+
E7E4 A780             (    forth6809.asm):07512                     STA   ,X+
E7E6 5A               (    forth6809.asm):07513                     DECB
E7E7 26F9             (    forth6809.asm):07514                     BNE   CSCPY

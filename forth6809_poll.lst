                      (    forth6809.asm):04344         ; ============================================================
                      (    forth6809.asm):04345         ; SECTION 12: CONTROL FLOW (IF/THEN/ELSE, BEGIN family,
                      (    forth6809.asm):04346         ; DO/LOOP/+LOOP/I/J/LEAVE/UNLOOP/?DO, EXIT, CASE family)
                      (    forth6809.asm):04347         ; ============================================================
                      (    forth6809.asm):04348         ; ------------------------------------------------------------
                      (    forth6809.asm):04349         ; Store a branch displacement: the cell at location receives target -
                      (    forth6809.asm):04350         ; location.
                      (    forth6809.asm):04351         ; PATCH   ( target location -- )
                      (    forth6809.asm):04352         ;    Inputs:
                      (    forth6809.asm):04353         ;        target and location on the data stack (location on top)
                      (    forth6809.asm):04354         ;    Outputs:
                      (    forth6809.asm):04355         ;        the cell at location holds target - location
                      (    forth6809.asm):04356         ;    Registers: RegD and RegX changed.
                      (    forth6809.asm):04357         ; ------------------------------------------------------------
E438 3710             (    forth6809.asm):04358         PATCH:      PULU  X                 ; location
E43A 3706             (    forth6809.asm):04359                     PULU  D                 ; target
E43C 3410             (    forth6809.asm):04360                     PSHS  X
E43E A3E1             (    forth6809.asm):04361                     SUBD  ,S++              ; target - location
E440 ED84             (    forth6809.asm):04362                     STD   ,X
E442 39               (    forth6809.asm):04363                     RTS
                      (    forth6809.asm):04364         
                      (    forth6809.asm):04365         ; ------------------------------------------------------------
                      (    forth6809.asm):04366         ; IF  ( C: -- orig )
                      (    forth6809.asm):04367         ; Compile ZBRANCH with a placeholder operand. Leave the operand
                      (    forth6809.asm):04368         ; address and TAGFWD on the control-flow stack for ELSE or THEN.
                      (    forth6809.asm):04369         ; ------------------------------------------------------------

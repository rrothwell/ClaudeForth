DEDC ED42             (    forth6809.asm):05664                     STD   2,U
DEDE 39               (    forth6809.asm):05665                     RTS
                      (    forth6809.asm):05666         
                      (    forth6809.asm):05667         ; ------------------------------------------------------------
                      (    forth6809.asm):05668         ; OVER  ( x1 x2 -- x1 x2 x1 )
                      (    forth6809.asm):05669         ; Copy the second cell to the top.
                      (    forth6809.asm):05670         ; ------------------------------------------------------------
DEDF EC42             (    forth6809.asm):05671         OVERW:      LDD   2,U               ; x1
DEE1 3606             (    forth6809.asm):05672                     PSHU  D
DEE3 39               (    forth6809.asm):05673                     RTS
                      (    forth6809.asm):05674         
                      (    forth6809.asm):05675         ; ------------------------------------------------------------
                      (    forth6809.asm):05676         ; ROT  ( x1 x2 x3 -- x2 x3 x1 )
                      (    forth6809.asm):05677         ; Rotate the third cell to the top.
                      (    forth6809.asm):05678         ; ------------------------------------------------------------
DEE4 ECC4             (    forth6809.asm):05679         ROTW:       LDD   ,U                ; x3
DEE6 AE42             (    forth6809.asm):05680                     LDX   2,U               ; x2
DEE8 10AE44           (    forth6809.asm):05681                     LDY   4,U               ; x1
DEEB 10AFC4           (    forth6809.asm):05682                     STY   ,U

D592 CC005B           (    forth6809.asm):03824                     LDD   #WLHEADS
D595 DD47             (    forth6809.asm):03825                     STD   CURRENT
D597 7ED667           (    forth6809.asm):03826                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03827         
                      (    forth6809.asm):03828         ; ------------------------------------------------------------
                      (    forth6809.asm):03829         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03830         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03831         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03832         ; PRUNE
                      (    forth6809.asm):03833         ;    Inputs:
                      (    forth6809.asm):03834         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03835         ;    Outputs:
                      (    forth6809.asm):03836         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03837         ;        into ROM
                      (    forth6809.asm):03838         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03839         ; ------------------------------------------------------------
D59A 3406             (    forth6809.asm):03840         PRUNE:      PSHS  D                 ; 0,S = mark
D59C 8E005B           (    forth6809.asm):03841                     LDX   #WLHEADS
D59F 9C45             (    forth6809.asm):03842         PRLOOP:     CMPX  WLEND
D5A1 2421             (    forth6809.asm):03843                     BHS   PRNDONE
D5A3 10AE84           (    forth6809.asm):03844                     LDY   ,X                ; newest header of this wordlist
D5A6 108CC000         (    forth6809.asm):03845         PRWALK:     CMPY  #ROMSTRT
D5AA 2413             (    forth6809.asm):03846                     BHS   PRSTORE           ; ROM header: keep
D5AC 10ACE4           (    forth6809.asm):03847                     CMPY  ,S
D5AF 250E             (    forth6809.asm):03848                     BLO   PRSTORE           ; below the mark (or empty): keep
D5B1 E6A4             (    forth6809.asm):03849                     LDB   ,Y
D5B3 C41F             (    forth6809.asm):03850                     ANDB  #$1F
D5B5 4F               (    forth6809.asm):03851                     CLRA
D5B6 3121             (    forth6809.asm):03852                     LEAY  1,Y
D5B8 31AB             (    forth6809.asm):03853                     LEAY  D,Y
D5BA 10AEA4           (    forth6809.asm):03854                     LDY   ,Y                ; follow the LINK
D5BD 20E7             (    forth6809.asm):03855                     BRA   PRWALK
D5BF 10AF81           (    forth6809.asm):03856         PRSTORE:    STY   ,X++
D5C2 20DB             (    forth6809.asm):03857                     BRA   PRLOOP
D5C4 3262             (    forth6809.asm):03858         PRNDONE:     LEAS  2,S
D5C6 39               (    forth6809.asm):03859                     RTS

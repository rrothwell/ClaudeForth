                      (    forth6809.asm):05323         ; ------------------------------------------------------------
DBC4 108E0000         (    forth6809.asm):05324         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DBC8 1F31             (    forth6809.asm):05325                     TFR   U,X               ; X = scan pointer
DBCA 9C21             (    forth6809.asm):05326         EXSCAN:     CMPX  CSP
DBCC 270E             (    forth6809.asm):05327                     BEQ   EXSCANDONE
DBCE EC84             (    forth6809.asm):05328                     LDD   ,X
DBD0 10830003         (    forth6809.asm):05329                     CMPD  #TAGDO
DBD4 2602             (    forth6809.asm):05330                     BNE   EXNOTDO
DBD6 3121             (    forth6809.asm):05331                     LEAY  1,Y
DBD8 3004             (    forth6809.asm):05332         EXNOTDO:    LEAX  4,X
DBDA 20EE             (    forth6809.asm):05333                     BRA   EXSCAN
DBDC                  (    forth6809.asm):05334         EXSCANDONE:
DBDC 3420             (    forth6809.asm):05335                     PSHS  Y                 ; the count survives CCALL on S
DBDE CCDBEE           (    forth6809.asm):05336                     LDD   #EXITUNLOOP

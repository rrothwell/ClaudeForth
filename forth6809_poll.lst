                      (    forth6809.asm):08229         ; Register the substitution text c-addr1 u1 for the name c-addr2 u2.
                      (    forth6809.asm):08230         ; Only one registration is kept (a single slot); a new call replaces
                      (    forth6809.asm):08231         ; the previous one. The strings are not copied.

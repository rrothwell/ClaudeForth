D3E4 3606             (    forth6809.asm):03521                     PSHU  D
D3E6 BDDDAB           (    forth6809.asm):03522                     JSR   CCALL
D3E9 BDD08B           (    forth6809.asm):03523                     JSR   CODECOMMA
D3EC 20B5             (    forth6809.asm):03524                     BRA   ILOOP
                      (    forth6809.asm):03525         
D3EE                  (    forth6809.asm):03526         TNDOUBLE:                           ; U currently holds [UDLO(bottom), UDHI(top)], matching
                      (    forth6809.asm):03527                                             ; ANS's (ud1) stack order directly.
D3EE DC00             (    forth6809.asm):03528                     LDD   STATE
D3F0 27B1             (    forth6809.asm):03529                     BEQ   ILOOP             ; interpreting: already correctly placed,
                      (    forth6809.asm):03530                                             ; nothing more to do
                      (    forth6809.asm):03531                     ; compiling: need two literals compiled in the order they
                      (    forth6809.asm):03532                     ; must execute at runtime - low first (lands deep), high
                      (    forth6809.asm):03533                     ; second (lands on top). UDHI is currently on top of U, so
                      (    forth6809.asm):03534                     ; pop it aside first, freeing UDLO to be compiled first.
D3F2 3706             (    forth6809.asm):03535                     PULU  D
D3F4 DD1A             (    forth6809.asm):03536                     STD   MSCR4             ; stash UDHI - confirmed safe scratch,
                      (    forth6809.asm):03537                                             ; untouched by CCALL/CODECOMMA
D3F6 CCCFE5           (    forth6809.asm):03538                     LDD   #LIT
D3F9 3606             (    forth6809.asm):03539                     PSHU  D
D3FB BDDDAB           (    forth6809.asm):03540                     JSR   CCALL
D3FE BDD08B           (    forth6809.asm):03541                     JSR   CODECOMMA         ; compiles UDLO (still on U underneath)
D401 CCCFE5           (    forth6809.asm):03542                     LDD   #LIT
D404 3606             (    forth6809.asm):03543                     PSHU  D
D406 BDDDAB           (    forth6809.asm):03544                     JSR   CCALL
D409 DC1A             (    forth6809.asm):03545                     LDD   MSCR4
D40B 3606             (    forth6809.asm):03546                     PSHU  D

                      (    forth6809.asm):03224         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03225         ; ------------------------------------------------------------
D1F6 CCD1F3           (    forth6809.asm):03226         TWOVALUEW:  LDD   #DO2VALUE
D1F9 BDD169           (    forth6809.asm):03227                     JSR   BLDDOES

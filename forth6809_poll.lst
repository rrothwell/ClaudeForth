D9C7 CC0001           (    forth6809.asm):04737                     LDD   #TAGFWD
D9CA 3606             (    forth6809.asm):04738                     PSHU  D
D9CC 39               (    forth6809.asm):04739                     RTS
                      (    forth6809.asm):04740         
                      (    forth6809.asm):04741         ; ------------------------------------------------------------
                      (    forth6809.asm):04742         ; THEN  ( C: orig -- )
                      (    forth6809.asm):04743         ; Resolve the forward branch left by IF, ELSE or WHILE: patch its
                      (    forth6809.asm):04744         ; operand to jump to the current code address.
                      (    forth6809.asm):04745         ; ------------------------------------------------------------

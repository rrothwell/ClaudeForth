DEF4 EC1E             (    forth6809.asm):05892         RLOOP:      LDD   -2,X
DEF6 ED84             (    forth6809.asm):05893                     STD   ,X
DEF8 301E             (    forth6809.asm):05894                     LEAX  -2,X

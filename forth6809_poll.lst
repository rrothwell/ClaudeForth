                      (    forth6809.asm):03804         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03805         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03806         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03807         ; WLINIT
                      (    forth6809.asm):03808         ;    Inputs:
                      (    forth6809.asm):03809         ;        none
                      (    forth6809.asm):03810         ;    Outputs:
                      (    forth6809.asm):03811         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03812         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03813         ; ------------------------------------------------------------
D579 CCCEBA           (    forth6809.asm):03814         WLINIT:     LDD   #BASELATEST
D57C DD5B             (    forth6809.asm):03815                     STD   WLHEADS
D57E CCC5B9           (    forth6809.asm):03816                     LDD   #BASEROOTLATEST
D581 DD5D             (    forth6809.asm):03817                     STD   WLHEADS+2

                      (    forth6809.asm):08906         ; ------------------------------------------------------------
                      (    forth6809.asm):08907         ; [IF]  ( flag -- )     [ELSE]  ( -- )     [THEN]  ( -- )
                      (    forth6809.asm):08908         ; Programming-Tools conditional compilation. All three are
                      (    forth6809.asm):08909         ; immediate, so they work while interpreting and while compiling.
                      (    forth6809.asm):08910         ; [IF] with a true flag does nothing. With a false flag, and for
                      (    forth6809.asm):08911         ; [ELSE], the input is skipped word by word, counting nested
                      (    forth6809.asm):08912         ; [IF]s, up to the matching [ELSE] or [THEN]. The three names are
                      (    forth6809.asm):08913         ; matched exactly, as the dictionary matches every name. If the line
                      (    forth6809.asm):08914         ; runs out, the next line is read with REFILL; if no more input is
                      (    forth6809.asm):08915         ; available the skip ends.
                      (    forth6809.asm):08916         ; [THEN] is a marker and does nothing when it is executed.
                      (    forth6809.asm):08917         ; The nesting level is kept at 0,S.
                      (    forth6809.asm):08918         ; ------------------------------------------------------------
FDAE 3706             (    forth6809.asm):08919         BRIFW:      PULU  D
FDB0 10830000         (    forth6809.asm):08920                     CMPD  #0
FDB4 266D             (    forth6809.asm):08921                     BNE   BRTHENW           ; true: nothing to skip
FDB6 CC0001           (    forth6809.asm):08922         BRELSEW:    LDD   #1
FDB9 3406             (    forth6809.asm):08923                     PSHS  D                 ; level
FDBB BDF4B5           (    forth6809.asm):08924         BRNEXT:     JSR   PARSENAMEW
FDBE 3706             (    forth6809.asm):08925                     PULU  D                 ; length
FDC0 3710             (    forth6809.asm):08926                     PULU  X                 ; address
FDC2 10830000         (    forth6809.asm):08927                     CMPD  #0
FDC6 274E             (    forth6809.asm):08928                     BEQ   BRREFILL
FDC8 10830004         (    forth6809.asm):08929                     CMPD  #4
FDCC 2734             (    forth6809.asm):08930                     BEQ   BR4
FDCE 10830006         (    forth6809.asm):08931                     CMPD  #6
FDD2 26E7             (    forth6809.asm):08932                     BNE   BRNEXT
FDD4 C606             (    forth6809.asm):08933                     LDB   #6
FDD6 108EFE32         (    forth6809.asm):08934                     LDY   #BRSELSE
FDDA 3410             (    forth6809.asm):08935                     PSHS  X
FDDC BDFE24           (    forth6809.asm):08936                     JSR   BRCMP
FDDF 3510             (    forth6809.asm):08937                     PULS  X
FDE1 2609             (    forth6809.asm):08938                     BNE   BR6B
FDE3 ECE4             (    forth6809.asm):08939                     LDD   ,S                ; [ELSE]: ends the skip at level 1
FDE5 830001           (    forth6809.asm):08940                     SUBD  #1
FDE8 2737             (    forth6809.asm):08941                     BEQ   BRDONE
FDEA 20CF             (    forth6809.asm):08942                     BRA   BRNEXT
FDEC C606             (    forth6809.asm):08943         BR6B:       LDB   #6
FDEE 108EFE38         (    forth6809.asm):08944                     LDY   #BRSTHEN
FDF2 BDFE24           (    forth6809.asm):08945                     JSR   BRCMP
FDF5 26C4             (    forth6809.asm):08946                     BNE   BRNEXT
FDF7 ECE4             (    forth6809.asm):08947                     LDD   ,S                ; [THEN]: one level less
FDF9 830001           (    forth6809.asm):08948                     SUBD  #1
FDFC EDE4             (    forth6809.asm):08949                     STD   ,S
FDFE 2721             (    forth6809.asm):08950                     BEQ   BRDONE
FE00 20B9             (    forth6809.asm):08951                     BRA   BRNEXT
FE02 C604             (    forth6809.asm):08952         BR4:        LDB   #4
FE04 108EFE2E         (    forth6809.asm):08953                     LDY   #BRSIF
FE08 BDFE24           (    forth6809.asm):08954                     JSR   BRCMP
FE0B 26AE             (    forth6809.asm):08955                     BNE   BRNEXT
FE0D ECE4             (    forth6809.asm):08956                     LDD   ,S                ; [IF]: one level more
FE0F C30001           (    forth6809.asm):08957                     ADDD  #1
FE12 EDE4             (    forth6809.asm):08958                     STD   ,S
FE14 20A5             (    forth6809.asm):08959                     BRA   BRNEXT
FE16 BDFAAD           (    forth6809.asm):08960         BRREFILL:   JSR   REFILLW
FE19 3706             (    forth6809.asm):08961                     PULU  D
FE1B 10830000         (    forth6809.asm):08962                     CMPD  #0
FE1F 269A             (    forth6809.asm):08963                     BNE   BRNEXT
FE21 3262             (    forth6809.asm):08964         BRDONE:     LEAS  2,S
FE23 39               (    forth6809.asm):08965         BRTHENW:    RTS
                      (    forth6809.asm):08966         
                      (    forth6809.asm):08967         ; Compare B characters at X with the pattern at Y. Case matters, as it
                      (    forth6809.asm):08968         ; does for every name in this system. Z is set if equal.
FE24 A680             (    forth6809.asm):08969         BRCMP:      LDA   ,X+
FE26 A1A0             (    forth6809.asm):08970                     CMPA  ,Y+
FE28 2603             (    forth6809.asm):08971                     BNE   BRCX
FE2A 5A               (    forth6809.asm):08972                     DECB
FE2B 26F7             (    forth6809.asm):08973                     BNE   BRCMP
FE2D 39               (    forth6809.asm):08974         BRCX:       RTS
                      (    forth6809.asm):08975         
FE2E 5B49465D         (    forth6809.asm):08976         BRSIF:      FCC   "[IF]"
FE32 5B454C53455D     (    forth6809.asm):08977         BRSELSE:    FCC   "[ELSE]"
FE38 5B5448454E5D     (    forth6809.asm):08978         BRSTHEN:    FCC   "[THEN]"

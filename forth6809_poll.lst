E062 CCE879           (    forth6809.asm):05242                     LDD   #EQUALW
E065 3606             (    forth6809.asm):05243                     PSHU  D
E067 BDE12B           (    forth6809.asm):05244                     JSR   CCALL
E06A CCD36E           (    forth6809.asm):05245                     LDD   #ZBRANCH
E06D 3606             (    forth6809.asm):05246                     PSHU  D
E06F BDE12B           (    forth6809.asm):05247                     JSR   CCALL
E072 CC0000           (    forth6809.asm):05248                     LDD   #0
E075 3606             (    forth6809.asm):05249                     PSHU  D
E077 BDD40B           (    forth6809.asm):05250                     JSR   CODECOMMA
E07A DC08             (    forth6809.asm):05251                     LDD   CODEHERE
E07C 830002           (    forth6809.asm):05252                     SUBD  #2
E07F 3606             (    forth6809.asm):05253                     PSHU  D                 ; orig
E081 CCE253           (    forth6809.asm):05254                     LDD   #DROPW
E084 3606             (    forth6809.asm):05255                     PSHU  D
E086 BDE12B           (    forth6809.asm):05256                     JSR   CCALL
E089 CC0005           (    forth6809.asm):05257                     LDD   #TAGOF
E08C 3606             (    forth6809.asm):05258                     PSHU  D
E08E 39               (    forth6809.asm):05259                     RTS
                      (    forth6809.asm):05260         
                      (    forth6809.asm):05261         ; ------------------------------------------------------------
                      (    forth6809.asm):05262         ; ENDOF  ( C: orig1 -- orig2 )
                      (    forth6809.asm):05263         ; Compile BRANCH with a placeholder operand, resolve orig1 to just
                      (    forth6809.asm):05264         ; after it, and leave the new operand address and TAGENDOF.
                      (    forth6809.asm):05265         ; ------------------------------------------------------------
E08F 3706             (    forth6809.asm):05266         ENDOFW:     PULU  D
E091 10830005         (    forth6809.asm):05267                     CMPD  #TAGOF
E095 2703             (    forth6809.asm):05268                     BEQ   EOFOK
E097 BDDCBB           (    forth6809.asm):05269                     JSR   CFERR
E09A 3706             (    forth6809.asm):05270         EOFOK:      PULU  D                 ; orig1
E09C 3406             (    forth6809.asm):05271                     PSHS  D                 ; See bugfix: ENDOFW.1 (5k: kept on S)
E09E CCD384           (    forth6809.asm):05272                     LDD   #BRANCH
E0A1 3606             (    forth6809.asm):05273                     PSHU  D

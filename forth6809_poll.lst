E9DD ED42             (    forth6809.asm):05412                     STD   2,U
E9DF 3342             (    forth6809.asm):05413                     LEAU  2,U
E9E1 39               (    forth6809.asm):05414                     RTS
                      (    forth6809.asm):05415         
                      (    forth6809.asm):05416         ; ------------------------------------------------------------
                      (    forth6809.asm):05417         ; TUCK  ( x1 x2 -- x2 x1 x2 )
                      (    forth6809.asm):05418         ; Copy the top cell beneath the second cell.
                      (    forth6809.asm):05419         ; ------------------------------------------------------------
E9E2 ECC4             (    forth6809.asm):05420         TUCKW:      LDD   ,U                ; x2

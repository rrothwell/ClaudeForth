                      (    forth6809.asm):04235         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04236         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04237         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04238         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04239         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04240         ; NUMLOOP
                      (    forth6809.asm):04241         ;    Inputs:
                      (    forth6809.asm):04242         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04243         ;    Outputs:
                      (    forth6809.asm):04244         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04245         ;        the count remaining
                      (    forth6809.asm):04246         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04247         ; ------------------------------------------------------------
D667                  (    forth6809.asm):04248         TONUMBERW:
D667 ECC4             (    forth6809.asm):04249         NUMLOOP:    LDD   ,U

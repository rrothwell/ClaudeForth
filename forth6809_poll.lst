E2E6 3606             (    forth6809.asm):03593                     PSHU  D
E2E8 39               (    forth6809.asm):03594                     RTS
                      (    forth6809.asm):03595         
                      (    forth6809.asm):03596         ; ============================================================
                      (    forth6809.asm):03597         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03598         ; ============================================================
                      (    forth6809.asm):03599                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03600         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03601         
                      (    forth6809.asm):03602         ; ------------------------------------------------------------
                      (    forth6809.asm):03603         ; KEY  ( -- char )
                      (    forth6809.asm):03604         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03605         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03606         ; ------------------------------------------------------------
E2E9                  (    forth6809.asm):03607         KEYW:
                      (    forth6809.asm):03608         
                      (    forth6809.asm):03609                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03610                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03611         
                      (    forth6809.asm):03612                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):03613                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):03614                                             ; by transmitting all chars.
                      (    forth6809.asm):03615         
E2E9                  (    forth6809.asm):03616         TRY_READ:
                      (    forth6809.asm):03617                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):03618                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):03619                                             ; while still transmitting!
                      (    forth6809.asm):03620         
                      (    forth6809.asm):03621                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):03622                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):03623                     PSHU  D                 ; char
                      (    forth6809.asm):03624         
                      (    forth6809.asm):03625                     RTS
                      (    forth6809.asm):03626         
                      (    forth6809.asm):03627         ; ------------------------------------------------------------
                      (    forth6809.asm):03628         ; KEY?  ( -- flag )
                      (    forth6809.asm):03629         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):03630         ; ------------------------------------------------------------
E2E9                  (    forth6809.asm):03631         KEYQW:
                      (    forth6809.asm):03632                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):03633         
                      (    forth6809.asm):03634                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):03635                     CMPA  INTAIL
                      (    forth6809.asm):03636         
                      (    forth6809.asm):03637                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):03638         
                      (    forth6809.asm):03639                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):03640         
                      (    forth6809.asm):03641                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):03642                     PSHU  D                 ; flag = false
                      (    forth6809.asm):03643         
                      (    forth6809.asm):03644                     RTS
                      (    forth6809.asm):03645         
E2E9                  (    forth6809.asm):03646         KQTRUE:
                      (    forth6809.asm):03647                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):03648                     PSHU  D                 ; flag = true
                      (    forth6809.asm):03649                     RTS
                      (    forth6809.asm):03650         
                      (    forth6809.asm):03651         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):03652         
                      (    forth6809.asm):03653         ; ------------------------------------------------------------
                      (    forth6809.asm):03654         ; EMIT  ( char -- )
                      (    forth6809.asm):03655         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):03656         ; discarded if the ring is full.
                      (    forth6809.asm):03657         ; ------------------------------------------------------------
E2E9                  (    forth6809.asm):03658         EMITW:
                      (    forth6809.asm):03659                     PULU  D                 ; char
                      (    forth6809.asm):03660                     TFR   B,A
                      (    forth6809.asm):03661                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):03662                     RTS
                      (    forth6809.asm):03663         
                      (    forth6809.asm):03664                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):03665         ; ------------------------------------------------------------
                      (    forth6809.asm):03666         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):03667         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):03668         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):03669         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):03670         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):03671         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):03672         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):03673         ; follow.
                      (    forth6809.asm):03674         ; ------------------------------------------------------------
E2E9                  (    forth6809.asm):03675         KEYW:
E2E9 B6C008           (    forth6809.asm):03676                     LDA   ACIASR
E2EC 8501             (    forth6809.asm):03677                     BITA  #SR_RDRF
E2EE 2705             (    forth6809.asm):03678                     BEQ   KWAIT
E2F0 7C017F           (    forth6809.asm):03679                     INC   POLLREADYCNT      ; character was already queued when we
E2F3 2007             (    forth6809.asm):03680                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E2F5                  (    forth6809.asm):03681         KWAIT:
E2F5 B6C008           (    forth6809.asm):03682         KSPIN:      LDA   ACIASR
E2F8 8501             (    forth6809.asm):03683                     BITA  #SR_RDRF
E2FA 27F9             (    forth6809.asm):03684                     BEQ   KSPIN
E2FC                  (    forth6809.asm):03685         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):03686                                             ; when RDRF first went true - check the
                      (    forth6809.asm):03687                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):03688                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):03689                                             ; RDRF and the latched error bits together
E2FC 8570             (    forth6809.asm):03690                     BITA  #SR_FE+SR_OVRN+SR_PE
E2FE 2715             (    forth6809.asm):03691                     BEQ   KGETCH
E300 8510             (    forth6809.asm):03692                     BITA  #SR_FE
E302 2703             (    forth6809.asm):03693                     BEQ   KXFE
E304 7C017C           (    forth6809.asm):03694                     INC   FECOUNT
E307 8520             (    forth6809.asm):03695         KXFE:       BITA  #SR_OVRN
E309 2703             (    forth6809.asm):03696                     BEQ   KXOVRN
E30B 7C017D           (    forth6809.asm):03697                     INC   OVRNCOUNT
E30E 8540             (    forth6809.asm):03698         KXOVRN:     BITA  #SR_PE
E310 2703             (    forth6809.asm):03699                     BEQ   KGETCH
E312 7C017E           (    forth6809.asm):03700                     INC   PECOUNT
E315 B6C009           (    forth6809.asm):03701         KGETCH:     LDA   ACIADR
E318 1F89             (    forth6809.asm):03702                     TFR   A,B
E31A 4F               (    forth6809.asm):03703                     CLRA
E31B 3606             (    forth6809.asm):03704                     PSHU  D                 ; char
E31D 39               (    forth6809.asm):03705                     RTS
                      (    forth6809.asm):03706         
                      (    forth6809.asm):03707         ; ------------------------------------------------------------
                      (    forth6809.asm):03708         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):03709         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):03710         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):03711         ; PUTXON / PUTXOFF
                      (    forth6809.asm):03712         ;    Inputs:
                      (    forth6809.asm):03713         ;        none
                      (    forth6809.asm):03714         ;    Outputs:
                      (    forth6809.asm):03715         ;        XON or XOFF transmitted
                      (    forth6809.asm):03716         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):03717         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):03718         ; ------------------------------------------------------------
E31E 8613             (    forth6809.asm):03719         PUTXOFF:    LDA   #XOFFCH
E320 2002             (    forth6809.asm):03720                     BRA   PUTXCH
E322 8611             (    forth6809.asm):03721         PUTXON:     LDA   #XONCH
E324 3402             (    forth6809.asm):03722         PUTXCH:     PSHS  A
E326 F6C008           (    forth6809.asm):03723         PXWT:       LDB   ACIASR
E329 C502             (    forth6809.asm):03724                     BITB  #SR_TDRE
E32B 27F9             (    forth6809.asm):03725                     BEQ   PXWT
E32D 3502             (    forth6809.asm):03726                     PULS  A
E32F B7C009           (    forth6809.asm):03727                     STA   ACIADR
E332 39               (    forth6809.asm):03728                     RTS
                      (    forth6809.asm):03729         
                      (    forth6809.asm):03730         ; ------------------------------------------------------------
                      (    forth6809.asm):03731         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):03732         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):03733         ; ------------------------------------------------------------
E333 B6C008           (    forth6809.asm):03734         KEYQW:      LDA   ACIASR
E336 8501             (    forth6809.asm):03735                     BITA  #SR_RDRF
E338 2706             (    forth6809.asm):03736                     BEQ   KQFALSE
E33A CCFFFF           (    forth6809.asm):03737                     LDD   #TRUEV
E33D 3606             (    forth6809.asm):03738                     PSHU  D                 ; flag = true
E33F 39               (    forth6809.asm):03739                     RTS
E340 CC0000           (    forth6809.asm):03740         KQFALSE:    LDD   #FALSEV
E343 3606             (    forth6809.asm):03741                     PSHU  D                 ; flag = false
E345 39               (    forth6809.asm):03742                     RTS
                      (    forth6809.asm):03743         
                      (    forth6809.asm):03744         ; ------------------------------------------------------------
                      (    forth6809.asm):03745         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):03746         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):03747         ; ------------------------------------------------------------
E346 3706             (    forth6809.asm):03748         EMITW:      PULU  D                 ; char
E348 D71E             (    forth6809.asm):03749                     STB   EMITCH
E34A B6C008           (    forth6809.asm):03750         EMITWT:     LDA   ACIASR
E34D 8502             (    forth6809.asm):03751                     BITA  #SR_TDRE
E34F 27F9             (    forth6809.asm):03752                     BEQ   EMITWT
E351 961E             (    forth6809.asm):03753                     LDA   EMITCH
E353 B7C009           (    forth6809.asm):03754                     STA   ACIADR
E356 39               (    forth6809.asm):03755                     RTS
                      (    forth6809.asm):03756         
                      (    forth6809.asm):03757                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03758         
                      (    forth6809.asm):03759         ; ------------------------------------------------------------
                      (    forth6809.asm):03760         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):03761         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):03762         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):03763         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):03764         ; ------------------------------------------------------------
E357 335E             (    forth6809.asm):03765         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
E359 CC0000           (    forth6809.asm):03766                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
E35C EDC4             (    forth6809.asm):03767                     STD   ,U
                      (    forth6809.asm):03768         
                      (    forth6809.asm):03769                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):03770                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):03771                                             ; covers this, nothing extra needed
                      (    forth6809.asm):03772                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):03773                                             ; stream this line's characters
E35E BDE322           (    forth6809.asm):03774                     JSR   PUTXON
                      (    forth6809.asm):03775                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):03776         
E361 BDE2E9           (    forth6809.asm):03777         ALOOP:      JSR   KEYW
E364 3706             (    forth6809.asm):03778                     PULU  D
E366 1F02             (    forth6809.asm):03779                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):03780         
E368 C10D             (    forth6809.asm):03781                     CMPB  #13
E36A 274F             (    forth6809.asm):03782                     BEQ   ADONE
E36C C10A             (    forth6809.asm):03783                     CMPB  #10
E36E 27F1             (    forth6809.asm):03784                     BEQ   ALOOP
E370 C108             (    forth6809.asm):03785                     CMPB  #8
E372 2724             (    forth6809.asm):03786                     BEQ   ABKSP
E374 C17F             (    forth6809.asm):03787                     CMPB  #127
E376 2720             (    forth6809.asm):03788                     BEQ   ABKSP
                      (    forth6809.asm):03789         
E378 ECC4             (    forth6809.asm):03790                     LDD   ,U
E37A 10A342           (    forth6809.asm):03791                     CMPD  2,U
E37D 27E2             (    forth6809.asm):03792                     BEQ   ALOOP
                      (    forth6809.asm):03793         
E37F AE44             (    forth6809.asm):03794                     LDX   4,U
E381 308B             (    forth6809.asm):03795                     LEAX  D,X
E383 1F20             (    forth6809.asm):03796                     TFR   Y,D
E385 E784             (    forth6809.asm):03797                     STB   ,X
E387 ECC4             (    forth6809.asm):03798                     LDD   ,U
E389 C30001           (    forth6809.asm):03799                     ADDD  #1
E38C EDC4             (    forth6809.asm):03800                     STD   ,U
                      (    forth6809.asm):03801         
E38E 1F20             (    forth6809.asm):03802                     TFR   Y,D
E390 4F               (    forth6809.asm):03803                     CLRA
E391 3606             (    forth6809.asm):03804                     PSHU  D
E393 BDE346           (    forth6809.asm):03805                     JSR   EMITW
E396 20C9             (    forth6809.asm):03806                     BRA   ALOOP
                      (    forth6809.asm):03807         
E398 ECC4             (    forth6809.asm):03808         ABKSP:      LDD   ,U
E39A 27C5             (    forth6809.asm):03809                     BEQ   ALOOP
E39C 830001           (    forth6809.asm):03810                     SUBD  #1
E39F EDC4             (    forth6809.asm):03811                     STD   ,U
E3A1 CC0008           (    forth6809.asm):03812                     LDD   #8
E3A4 3606             (    forth6809.asm):03813                     PSHU  D
E3A6 BDE346           (    forth6809.asm):03814                     JSR   EMITW
E3A9 CC0020           (    forth6809.asm):03815                     LDD   #32
E3AC 3606             (    forth6809.asm):03816                     PSHU  D
E3AE BDE346           (    forth6809.asm):03817                     JSR   EMITW
E3B1 CC0008           (    forth6809.asm):03818                     LDD   #8
E3B4 3606             (    forth6809.asm):03819                     PSHU  D
E3B6 BDE346           (    forth6809.asm):03820                     JSR   EMITW
E3B9 20A6             (    forth6809.asm):03821                     BRA   ALOOP
                      (    forth6809.asm):03822         
E3BB                  (    forth6809.asm):03823         ADONE:
                      (    forth6809.asm):03824                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):03825                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):03826                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):03827                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):03828                                             ; with KEY never polled at all
E3BB BDE31E           (    forth6809.asm):03829                     JSR   PUTXOFF
                      (    forth6809.asm):03830                     ENDC                    ; <<<<<<<<<<
E3BE ECC4             (    forth6809.asm):03831                     LDD   ,U

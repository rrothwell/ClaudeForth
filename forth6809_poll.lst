                      (    forth6809.asm):05556         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05557         ; ------------------------------------------------------------
DD68 DC00             (    forth6809.asm):05558         BRACKTICKW: LDD   STATE
DD6A 2608             (    forth6809.asm):05559                     BNE   BTSTOK
DD6C CCFFF2           (    forth6809.asm):05560                     LDD   #-14              ; -14

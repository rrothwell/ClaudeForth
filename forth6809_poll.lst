                      (    forth6809.asm):02123                                             ; by restoring the CC.
                      (    forth6809.asm):02124         ; ------------------------------------------------------------
                      (    forth6809.asm):02125         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02126         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02127         ; GETCHAR

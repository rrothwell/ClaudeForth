                      (    forth6809.asm):04340         ; ============================================================
                      (    forth6809.asm):04341         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04342         ; ============================================================
                      (    forth6809.asm):04343                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04344         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04345         
                      (    forth6809.asm):04346         ; ------------------------------------------------------------
                      (    forth6809.asm):04347         ; KEY  ( -- char )
                      (    forth6809.asm):04348         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04349         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04350         ; ------------------------------------------------------------
D837                  (    forth6809.asm):04351         KEYW:
                      (    forth6809.asm):04352         
                      (    forth6809.asm):04353                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04354                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04355         
                      (    forth6809.asm):04356                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04357                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04358                                             ; by transmitting all chars.
                      (    forth6809.asm):04359         
D837                  (    forth6809.asm):04360         TRY_READ:
                      (    forth6809.asm):04361                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04362                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04363                                             ; while still transmitting!
                      (    forth6809.asm):04364         
                      (    forth6809.asm):04365                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04366                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04367                     PSHU  D                 ; char
                      (    forth6809.asm):04368         
                      (    forth6809.asm):04369                     RTS
                      (    forth6809.asm):04370         
                      (    forth6809.asm):04371         ; ------------------------------------------------------------
                      (    forth6809.asm):04372         ; KEY?  ( -- flag )
                      (    forth6809.asm):04373         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04374         ; ------------------------------------------------------------
D837                  (    forth6809.asm):04375         KEYQW:
                      (    forth6809.asm):04376                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04377         
                      (    forth6809.asm):04378                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04379                     CMPA  INTAIL
                      (    forth6809.asm):04380         
                      (    forth6809.asm):04381                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04382         
                      (    forth6809.asm):04383                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04384         
                      (    forth6809.asm):04385                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04386                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04387         
                      (    forth6809.asm):04388                     RTS
                      (    forth6809.asm):04389         
D837                  (    forth6809.asm):04390         KQTRUE:
                      (    forth6809.asm):04391                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04392                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04393                     RTS
                      (    forth6809.asm):04394         
                      (    forth6809.asm):04395         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04396         
                      (    forth6809.asm):04397         ; ------------------------------------------------------------
                      (    forth6809.asm):04398         ; EMIT  ( char -- )
                      (    forth6809.asm):04399         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04400         ; discarded if the ring is full.
                      (    forth6809.asm):04401         ; ------------------------------------------------------------
D837                  (    forth6809.asm):04402         EMITW:
                      (    forth6809.asm):04403                     PULU  D                 ; char
                      (    forth6809.asm):04404                     TFR   B,A
                      (    forth6809.asm):04405                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04406                     RTS
                      (    forth6809.asm):04407         
                      (    forth6809.asm):04408                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04409         ; ------------------------------------------------------------
                      (    forth6809.asm):04410         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04411         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04412         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04413         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04414         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04415         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04416         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04417         ; follow.
                      (    forth6809.asm):04418         ; ------------------------------------------------------------
D837                  (    forth6809.asm):04419         KEYW:
D837 B6C008           (    forth6809.asm):04420                     LDA   ACIASR
D83A 8501             (    forth6809.asm):04421                     BITA  #SR_RDRF
D83C 2705             (    forth6809.asm):04422                     BEQ   KWAIT
D83E 7C017F           (    forth6809.asm):04423                     INC   POLLREADYCNT      ; character was already queued when we
D841 2007             (    forth6809.asm):04424                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D843                  (    forth6809.asm):04425         KWAIT:
D843 B6C008           (    forth6809.asm):04426         KSPIN:      LDA   ACIASR
D846 8501             (    forth6809.asm):04427                     BITA  #SR_RDRF
D848 27F9             (    forth6809.asm):04428                     BEQ   KSPIN
D84A                  (    forth6809.asm):04429         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04430                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04431                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04432                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04433                                             ; RDRF and the latched error bits together
D84A 8570             (    forth6809.asm):04434                     BITA  #SR_FE+SR_OVRN+SR_PE
D84C 2715             (    forth6809.asm):04435                     BEQ   KGETCH
D84E 8510             (    forth6809.asm):04436                     BITA  #SR_FE
D850 2703             (    forth6809.asm):04437                     BEQ   KXFE
D852 7C017C           (    forth6809.asm):04438                     INC   FECOUNT
D855 8520             (    forth6809.asm):04439         KXFE:       BITA  #SR_OVRN
D857 2703             (    forth6809.asm):04440                     BEQ   KXOVRN
D859 7C017D           (    forth6809.asm):04441                     INC   OVRNCOUNT
D85C 8540             (    forth6809.asm):04442         KXOVRN:     BITA  #SR_PE
D85E 2703             (    forth6809.asm):04443                     BEQ   KGETCH
D860 7C017E           (    forth6809.asm):04444                     INC   PECOUNT
D863 B6C009           (    forth6809.asm):04445         KGETCH:     LDA   ACIADR
D866 1F89             (    forth6809.asm):04446                     TFR   A,B
D868 4F               (    forth6809.asm):04447                     CLRA
D869 3606             (    forth6809.asm):04448                     PSHU  D                 ; char
D86B 39               (    forth6809.asm):04449                     RTS
                      (    forth6809.asm):04450         
                      (    forth6809.asm):04451         ; ------------------------------------------------------------
                      (    forth6809.asm):04452         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04453         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04454         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04455         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04456         ;    Inputs:
                      (    forth6809.asm):04457         ;        none
                      (    forth6809.asm):04458         ;    Outputs:
                      (    forth6809.asm):04459         ;        XON or XOFF transmitted
                      (    forth6809.asm):04460         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04461         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04462         ; ------------------------------------------------------------
D86C 8613             (    forth6809.asm):04463         PUTXOFF:    LDA   #XOFFCH
D86E 2002             (    forth6809.asm):04464                     BRA   PUTXCH
D870 8611             (    forth6809.asm):04465         PUTXON:     LDA   #XONCH
D872 3402             (    forth6809.asm):04466         PUTXCH:     PSHS  A
D874 F6C008           (    forth6809.asm):04467         PXWT:       LDB   ACIASR
D877 C502             (    forth6809.asm):04468                     BITB  #SR_TDRE
D879 27F9             (    forth6809.asm):04469                     BEQ   PXWT

D73D A644             (    forth6809.asm):04193                     LDA   4,U
D73F E661             (    forth6809.asm):04194                     LDB   1,S
D741 3D               (    forth6809.asm):04195                     MUL
D742 EBE4             (    forth6809.asm):04196                     ADDB  ,S
D744 2401             (    forth6809.asm):04197                     BCC   UM3
D746 4C               (    forth6809.asm):04198                     INCA
D747 E744             (    forth6809.asm):04199         UM3:        STB   4,U
D749 3262             (    forth6809.asm):04200                     LEAS  2,S
D74B 39               (    forth6809.asm):04201                     RTS
                      (    forth6809.asm):04202         
                      (    forth6809.asm):04203         ; ------------------------------------------------------------
                      (    forth6809.asm):04204         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04205         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04206         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04207         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04208         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04209         ; NUMLOOP
                      (    forth6809.asm):04210         ;    Inputs:
                      (    forth6809.asm):04211         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04212         ;    Outputs:
                      (    forth6809.asm):04213         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04214         ;        the count remaining
                      (    forth6809.asm):04215         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04216         ; ------------------------------------------------------------
D74C                  (    forth6809.asm):04217         TONUMBERW:
D74C ECC4             (    forth6809.asm):04218         NUMLOOP:    LDD   ,U
D74E 2734             (    forth6809.asm):04219                     BEQ   NLDONE
D750 AE42             (    forth6809.asm):04220                     LDX   2,U
D752 A684             (    forth6809.asm):04221                     LDA   ,X
D754 8130             (    forth6809.asm):04222                     CMPA  #'0'
D756 252C             (    forth6809.asm):04223                     BLO   NLDONE
D758 8139             (    forth6809.asm):04224                     CMPA  #'9'
D75A 2204             (    forth6809.asm):04225                     BHI   NLALPHA
D75C 8030             (    forth6809.asm):04226                     SUBA  #'0'
D75E 200C             (    forth6809.asm):04227                     BRA   NLGOT
D760 84DF             (    forth6809.asm):04228         NLALPHA:    ANDA  #$DF
D762 8141             (    forth6809.asm):04229                     CMPA  #'A'
D764 251E             (    forth6809.asm):04230                     BLO   NLDONE
D766 815A             (    forth6809.asm):04231                     CMPA  #'Z'
D768 221A             (    forth6809.asm):04232                     BHI   NLDONE
D76A 8037             (    forth6809.asm):04233                     SUBA  #'A'-10
D76C 9103             (    forth6809.asm):04234         NLGOT:      CMPA  BASE+1
D76E 2414             (    forth6809.asm):04235                     BHS   NLDONE
D770 1F89             (    forth6809.asm):04236                     TFR   A,B
D772 BDD70B           (    forth6809.asm):04237                     JSR   UDMULADD
D775 AE42             (    forth6809.asm):04238                     LDX   2,U
D777 3001             (    forth6809.asm):04239                     LEAX  1,X
D779 AF42             (    forth6809.asm):04240                     STX   2,U
D77B ECC4             (    forth6809.asm):04241                     LDD   ,U
D77D 830001           (    forth6809.asm):04242                     SUBD  #1
D780 EDC4             (    forth6809.asm):04243                     STD   ,U
D782 20C8             (    forth6809.asm):04244                     BRA   NUMLOOP
D784 39               (    forth6809.asm):04245         NLDONE:     RTS
                      (    forth6809.asm):04246         
                      (    forth6809.asm):04247         ; ------------------------------------------------------------
                      (    forth6809.asm):04248         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04249         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04250         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04251         ;    Inputs:
                      (    forth6809.asm):04252         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04253         ;    Outputs:
                      (    forth6809.asm):04254         ;        single number: n and -1
                      (    forth6809.asm):04255         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04256         ;        not a number: c-addr and 0
                      (    forth6809.asm):04257         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04258         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04259         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04260         ; NUMBERQ.6.
                      (    forth6809.asm):04261         ; ------------------------------------------------------------
D785 3710             (    forth6809.asm):04262         NUMBERQ:    PULU  X                 ; c-addr
D787 327D             (    forth6809.asm):04263                     LEAS  -3,S
D789 AFE4             (    forth6809.asm):04264                     STX   ,S
D78B E684             (    forth6809.asm):04265                     LDB   ,X
D78D 276D             (    forth6809.asm):04266                     BEQ   NQBAD
D78F 3001             (    forth6809.asm):04267                     LEAX  1,X
                      (    forth6809.asm):04268         
                      (    forth6809.asm):04269                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04270                     ; digit count. See shadow: NUMBERQ.1
D791 5A               (    forth6809.asm):04271                     DECB
D792 A685             (    forth6809.asm):04272                     LDA   B,X
D794 5C               (    forth6809.asm):04273                     INCB
D795 812E             (    forth6809.asm):04274                     CMPA  #'.'
D797 2603             (    forth6809.asm):04275                     BNE   NQNOSIGN
D799 5A               (    forth6809.asm):04276                     DECB
D79A 2760             (    forth6809.asm):04277                     BEQ   NQBAD             ; lone "." with nothing before it
                      (    forth6809.asm):04278         
D79C 6F62             (    forth6809.asm):04279         NQNOSIGN:   CLR   2,S
D79E A684             (    forth6809.asm):04280                     LDA   ,X
D7A0 812D             (    forth6809.asm):04281                     CMPA  #'-'
D7A2 2607             (    forth6809.asm):04282                     BNE   NQNOSIGN2
D7A4 6362             (    forth6809.asm):04283                     COM   2,S
D7A6 3001             (    forth6809.asm):04284                     LEAX  1,X
D7A8 5A               (    forth6809.asm):04285                     DECB
D7A9 2751             (    forth6809.asm):04286                     BEQ   NQBAD
                      (    forth6809.asm):04287         
D7AB 108E0000         (    forth6809.asm):04288         NQNOSIGN2:  LDY   #0
D7AF 3620             (    forth6809.asm):04289                     PSHU  Y                 ; ud low
D7B1 3620             (    forth6809.asm):04290                     PSHU  Y                 ; ud high
D7B3 3610             (    forth6809.asm):04291                     PSHU  X                 ; c-addr
D7B5 4F               (    forth6809.asm):04292                     CLRA
D7B6 3606             (    forth6809.asm):04293                     PSHU  D                 ; u
                      (    forth6809.asm):04294         
D7B8 BDD74C           (    forth6809.asm):04295                     JSR   NUMLOOP
                      (    forth6809.asm):04296         
D7BB ECC4             (    forth6809.asm):04297                     LDD   ,U
D7BD 263B             (    forth6809.asm):04298                     BNE   NQBADF            ; unconverted characters remain
D7BF 3344             (    forth6809.asm):04299                     LEAU  4,U               ; drop u and c-addr: ud remains
                      (    forth6809.asm):04300         
                      (    forth6809.asm):04301                     ; Negate the full 32-bit value. See bugfix: NUMBERQ.2
D7C1 6D62             (    forth6809.asm):04302                     TST   2,S

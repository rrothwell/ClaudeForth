                      (    forth6809.asm):03553         ; ------------------------------------------------------------
                      (    forth6809.asm):03554         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03555         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03556         ; not found, else its xt and 1 if the word is immediate or -1 if not.

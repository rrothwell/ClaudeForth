                      (    forth6809.asm):05197         ; SLITERAL  ( c-addr u -- )
                      (    forth6809.asm):05198         ; Compile DOSTR followed by a count byte and a copy of the string.
                      (    forth6809.asm):05199         ; THROW -14 if not compiling.
                      (    forth6809.asm):05200         ; ------------------------------------------------------------
E90B DC00             (    forth6809.asm):05201         SLITERALW:  LDD   STATE
E90D 2608             (    forth6809.asm):05202                     BNE   SLSTOK
E90F CCFFF2           (    forth6809.asm):05203                     LDD   #-14
E912 3606             (    forth6809.asm):05204                     PSHU  D
E914 BDE403           (    forth6809.asm):05205                     JSR   THROWW
E917 CCF289           (    forth6809.asm):05206         SLSTOK:     LDD   #DOSTR
E91A 7EF2AE           (    forth6809.asm):05207                     JMP   CSTRCOMP          ; compile DOSTR and the counted string
                      (    forth6809.asm):05208         
                      (    forth6809.asm):05209         ; ------------------------------------------------------------
                      (    forth6809.asm):05210         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05211         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05212         ; the string.
                      (    forth6809.asm):05213         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05214         ;    Inputs:
                      (    forth6809.asm):05215         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05216         ;        count byte
                      (    forth6809.asm):05217         ;    Outputs:
                      (    forth6809.asm):05218         ;        execution continues after the string, or THROW -2

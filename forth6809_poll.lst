                      (    forth6809.asm):05610         ; ------------------------------------------------------------
                      (    forth6809.asm):05611         ; [COMPILE]  ( "name" -- )
                      (    forth6809.asm):05612         ; Compile a call to the next name, whether or not it is immediate.
                      (    forth6809.asm):05613         ; Obsolescent: POSTPONE is the general replacement. THROW -14 if not
                      (    forth6809.asm):05614         ; compiling, -13 if the name is not found.
                      (    forth6809.asm):05615         ; Original comment: shadow BRACKCOMPILEW.0.
                      (    forth6809.asm):05616         ; ------------------------------------------------------------
DDD4                  (    forth6809.asm):05617         BRACKCOMPILEW:
DDD4 DC00             (    forth6809.asm):05618                     LDD   STATE
DDD6 2608             (    forth6809.asm):05619                     BNE   XCSTOK

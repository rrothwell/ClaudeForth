F293 26FA             (    forth6809.asm):06695                     BNE   FILLOOP
F295 3346             (    forth6809.asm):06696         FDONE:      LEAU  6,U               ; drop the three parameters
F297 39               (    forth6809.asm):06697                     RTS
                      (    forth6809.asm):06698         
                      (    forth6809.asm):06699         ; ------------------------------------------------------------
                      (    forth6809.asm):06700         ; ERASE  ( c-addr u -- )

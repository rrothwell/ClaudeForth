                      (    forth6809.asm):09528         ; SECTION 28: DISASSEMBLER AND DECOMPILER (DASM, DIS, SEE)
                      (    forth6809.asm):09529         ; ============================================================
                      (    forth6809.asm):09530         ; Optional: DISASM adds DASM and DIS, DECOMP adds SEE (which needs
                      (    forth6809.asm):09531         ; DISASM). Design notes: see shadow DISASM.1 and DECOMP.1.
                      (    forth6809.asm):09532                     IFNE  DISASM
                      (    forth6809.asm):09533         ; ------------------------------------------------------------
                      (    forth6809.asm):09534         ; DISASM: 6809 disassembler (hexadecimal, lwasm style).
                      (    forth6809.asm):09535         ;
                      (    forth6809.asm):09536         ; DASM  ( addr -- addr' )   Send one instruction as text, for example
                      (    forth6809.asm):09537         ;       LDA #$A5  or  LDX <$7B  or  STA $0A,X  or  BRA $4010, and return
                      (    forth6809.asm):09538         ;       the address of the next instruction. Branch and PC-relative
                      (    forth6809.asm):09539         ;       operands show the absolute target address. A byte that is not
                      (    forth6809.asm):09540         ;       a legal instruction shows as FCB $xx and is one byte long.
                      (    forth6809.asm):09541         ; DIS   ( addr u -- )       List the instructions that start in
                      (    forth6809.asm):09542         ;       addr .. addr+u-1, one per line: address, bytes, text.
                      (    forth6809.asm):09543         ;
                      (    forth6809.asm):09544         ; The decoder is table driven: the name pool and the tables follow the
                      (    forth6809.asm):09545         ; code. Every character goes out through DCH, which is silenced while
                      (    forth6809.asm):09546         ; DISMUTE is non-zero so that DIS can measure an instruction first.
                      (    forth6809.asm):09547         ; ------------------------------------------------------------

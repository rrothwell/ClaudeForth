E89A 3606             (    forth6809.asm):05134                     PSHU  D
E89C BDE403           (    forth6809.asm):05135                     JSR   THROWW
E89F CC0020           (    forth6809.asm):05136         PPSTOK:     LDD   #32
E8A2 3606             (    forth6809.asm):05137                     PSHU  D
E8A4 BDDF8A           (    forth6809.asm):05138                     JSR   WORDW
E8A7 BDE074           (    forth6809.asm):05139                     JSR   FINDW
E8AA 3706             (    forth6809.asm):05140                     PULU  D
E8AC 10830000         (    forth6809.asm):05141                     CMPD  #0
E8B0 260A             (    forth6809.asm):05142                     BNE   PPFOUND
E8B2 3706             (    forth6809.asm):05143                     PULU  D
E8B4 CCFFF3           (    forth6809.asm):05144                     LDD   #-13              ; -13
E8B7 3606             (    forth6809.asm):05145                     PSHU  D
E8B9 BDE403           (    forth6809.asm):05146                     JSR   THROWW
E8BC 10830001         (    forth6809.asm):05147         PPFOUND:    CMPD  #1                ; 1 = immediate
E8C0 270C             (    forth6809.asm):05148                     BEQ   PPIMM
E8C2 BDE84B           (    forth6809.asm):05149                     JSR   LITERALW
E8C5 CCE83B           (    forth6809.asm):05150                     LDD   #COMPILECOMMAW
E8C8 3606             (    forth6809.asm):05151                     PSHU  D

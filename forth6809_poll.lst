                      (    forth6809.asm):03982         ; ============================================================
                      (    forth6809.asm):03983         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):03984         ; ============================================================
                      (    forth6809.asm):03985                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):03986         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):03987         
                      (    forth6809.asm):03988         ; ------------------------------------------------------------
                      (    forth6809.asm):03989         ; KEY  ( -- char )
                      (    forth6809.asm):03990         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):03991         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):03992         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):03993         KEYW:
                      (    forth6809.asm):03994         
                      (    forth6809.asm):03995                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):03996                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):03997         
                      (    forth6809.asm):03998                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):03999                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04000                                             ; by transmitting all chars.
                      (    forth6809.asm):04001         
E2CA                  (    forth6809.asm):04002         TRY_READ:
                      (    forth6809.asm):04003                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04004                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04005                                             ; while still transmitting!
                      (    forth6809.asm):04006         
                      (    forth6809.asm):04007                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04008                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04009                     PSHU  D                 ; char
                      (    forth6809.asm):04010         
                      (    forth6809.asm):04011                     RTS
                      (    forth6809.asm):04012         
                      (    forth6809.asm):04013         ; ------------------------------------------------------------
                      (    forth6809.asm):04014         ; KEY?  ( -- flag )
                      (    forth6809.asm):04015         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04016         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04017         KEYQW:
                      (    forth6809.asm):04018                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04019         
                      (    forth6809.asm):04020                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04021                     CMPA  INTAIL
                      (    forth6809.asm):04022         
                      (    forth6809.asm):04023                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04024         
                      (    forth6809.asm):04025                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04026         
                      (    forth6809.asm):04027                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04028                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04029         
                      (    forth6809.asm):04030                     RTS
                      (    forth6809.asm):04031         
E2CA                  (    forth6809.asm):04032         KQTRUE:
                      (    forth6809.asm):04033                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04034                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04035                     RTS
                      (    forth6809.asm):04036         
                      (    forth6809.asm):04037         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04038         
                      (    forth6809.asm):04039         ; ------------------------------------------------------------
                      (    forth6809.asm):04040         ; EMIT  ( char -- )
                      (    forth6809.asm):04041         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04042         ; discarded if the ring is full.
                      (    forth6809.asm):04043         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04044         EMITW:
                      (    forth6809.asm):04045                     PULU  D                 ; char
                      (    forth6809.asm):04046                     TFR   B,A
                      (    forth6809.asm):04047                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04048                     RTS
                      (    forth6809.asm):04049         
                      (    forth6809.asm):04050                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04051         ; ------------------------------------------------------------
                      (    forth6809.asm):04052         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04053         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04054         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04055         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04056         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04057         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04058         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04059         ; follow.
                      (    forth6809.asm):04060         ; ------------------------------------------------------------
E2CA                  (    forth6809.asm):04061         KEYW:
E2CA B6C008           (    forth6809.asm):04062                     LDA   ACIASR
E2CD 8501             (    forth6809.asm):04063                     BITA  #SR_RDRF
E2CF 2705             (    forth6809.asm):04064                     BEQ   KWAIT
E2D1 7C017F           (    forth6809.asm):04065                     INC   POLLREADYCNT      ; character was already queued when we
E2D4 2007             (    forth6809.asm):04066                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
E2D6                  (    forth6809.asm):04067         KWAIT:
E2D6 B6C008           (    forth6809.asm):04068         KSPIN:      LDA   ACIASR
E2D9 8501             (    forth6809.asm):04069                     BITA  #SR_RDRF
E2DB 27F9             (    forth6809.asm):04070                     BEQ   KSPIN
E2DD                  (    forth6809.asm):04071         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04072                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04073                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04074                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04075                                             ; RDRF and the latched error bits together
E2DD 8570             (    forth6809.asm):04076                     BITA  #SR_FE+SR_OVRN+SR_PE
E2DF 2715             (    forth6809.asm):04077                     BEQ   KGETCH
E2E1 8510             (    forth6809.asm):04078                     BITA  #SR_FE
E2E3 2703             (    forth6809.asm):04079                     BEQ   KXFE
E2E5 7C017C           (    forth6809.asm):04080                     INC   FECOUNT
E2E8 8520             (    forth6809.asm):04081         KXFE:       BITA  #SR_OVRN
E2EA 2703             (    forth6809.asm):04082                     BEQ   KXOVRN
E2EC 7C017D           (    forth6809.asm):04083                     INC   OVRNCOUNT
E2EF 8540             (    forth6809.asm):04084         KXOVRN:     BITA  #SR_PE
E2F1 2703             (    forth6809.asm):04085                     BEQ   KGETCH
E2F3 7C017E           (    forth6809.asm):04086                     INC   PECOUNT
E2F6 B6C009           (    forth6809.asm):04087         KGETCH:     LDA   ACIADR
E2F9 1F89             (    forth6809.asm):04088                     TFR   A,B
E2FB 4F               (    forth6809.asm):04089                     CLRA
E2FC 3606             (    forth6809.asm):04090                     PSHU  D                 ; char
E2FE 39               (    forth6809.asm):04091                     RTS
                      (    forth6809.asm):04092         
                      (    forth6809.asm):04093         ; ------------------------------------------------------------
                      (    forth6809.asm):04094         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04095         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04096         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04097         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04098         ;    Inputs:
                      (    forth6809.asm):04099         ;        none
                      (    forth6809.asm):04100         ;    Outputs:
                      (    forth6809.asm):04101         ;        XON or XOFF transmitted
                      (    forth6809.asm):04102         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04103         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04104         ; ------------------------------------------------------------
E2FF 8613             (    forth6809.asm):04105         PUTXOFF:    LDA   #XOFFCH
E301 2002             (    forth6809.asm):04106                     BRA   PUTXCH
E303 8611             (    forth6809.asm):04107         PUTXON:     LDA   #XONCH
E305 3402             (    forth6809.asm):04108         PUTXCH:     PSHS  A
E307 F6C008           (    forth6809.asm):04109         PXWT:       LDB   ACIASR
E30A C502             (    forth6809.asm):04110                     BITB  #SR_TDRE
E30C 27F9             (    forth6809.asm):04111                     BEQ   PXWT

                      (    forth6809.asm):07485         ; Compile a call to a run-time word followed by a counted string.
                      (    forth6809.asm):07486         ; CSTRCOMP   ( c-addr u -- )
                      (    forth6809.asm):07487         ;    Inputs:
                      (    forth6809.asm):07488         ;        RegD = xt of the run-time word (DOSTR, DOTSTR, DOABORTQUOTE)
                      (    forth6809.asm):07489         ;        c-addr u on the data stack
                      (    forth6809.asm):07490         ;    Outputs:
                      (    forth6809.asm):07491         ;        JSR xt, the count byte and the text compiled at CODEHERE
                      (    forth6809.asm):07492         ;    Registers: RegA, RegB, RegX, RegY changed.
                      (    forth6809.asm):07493         ; ------------------------------------------------------------
E801 3606             (    forth6809.asm):07494         CSTRCOMP:   PSHU  D

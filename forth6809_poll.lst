D7ED 3606             (    forth6809.asm):04540                     PSHU  D                 ; flag = false
D7EF 39               (    forth6809.asm):04541                     RTS
                      (    forth6809.asm):04542         
                      (    forth6809.asm):04543         ; ------------------------------------------------------------
                      (    forth6809.asm):04544         ; EMIT  ( char -- )  [polling build]

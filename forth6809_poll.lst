                      (    forth6809.asm):08943         ; ------------------------------------------------------------
                      (    forth6809.asm):08944         ; ENVIRONMENT?  ( c-addr u -- false | i*x true )
                      (    forth6809.asm):08945         ; Look up the attribute name c-addr u first in ENVTABLE (single-cell
                      (    forth6809.asm):08946         ; values), then in ENVTABLE2 (double-cell values). If found, return
                      (    forth6809.asm):08947         ; the value and true; otherwise return false. WORDLISTS is 8, the
                      (    forth6809.asm):08948         ; number of wordlists that can exist. FLOORED is false because /, MOD and /MOD use symmetric
                      (    forth6809.asm):08949         ; division.
                      (    forth6809.asm):08950         ; Original comment: shadow ENVQW.0.
                      (    forth6809.asm):08951         ; ------------------------------------------------------------
F063 3706             (    forth6809.asm):08952         ENVQW:      PULU  D                 ; u
F065 3406             (    forth6809.asm):08953                     PSHS  D                 ; frame: 2,S = u, 0,S = c-addr (5k)
F067 3706             (    forth6809.asm):08954                     PULU  D                 ; c-addr
F069 3406             (    forth6809.asm):08955                     PSHS  D
F06B 8EF104           (    forth6809.asm):08956                     LDX   #ENVTABLE
F06E EC84             (    forth6809.asm):08957         ENVLOOP:    LDD   ,X
F070 10830000         (    forth6809.asm):08958                     CMPD  #0
F074 272D             (    forth6809.asm):08959                     BEQ   ENV2START         ; end of table: try ENVTABLE2
F076 3410             (    forth6809.asm):08960                     PSHS  X                 ; See bugfix: ENVQW.2 (frame now +2)
F078 3606             (    forth6809.asm):08961                     PSHU  D
F07A EC02             (    forth6809.asm):08962                     LDD   2,X
F07C 3606             (    forth6809.asm):08963                     PSHU  D
F07E EC62             (    forth6809.asm):08964                     LDD   2,S               ; c-addr
F080 3606             (    forth6809.asm):08965                     PSHU  D

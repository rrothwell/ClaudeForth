D22F 7EE748           (    forth6809.asm):03284         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03285         
                      (    forth6809.asm):03286         ; ------------------------------------------------------------
                      (    forth6809.asm):03287         ; 2VARIABLE  ( "name" -- )

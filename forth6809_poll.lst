                      (    forth6809.asm):05957         ; ------------------------------------------------------------
                      (    forth6809.asm):05958         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05959         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05960         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05961         ; put back around the transfer.
                      (    forth6809.asm):05962         ; ------------------------------------------------------------
DEC9 3510             (    forth6809.asm):05963         TWOTORW:    PULS  X                 ; return address

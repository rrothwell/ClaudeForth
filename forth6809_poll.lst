                      (    forth6809.asm):04570         ; ============================================================
                      (    forth6809.asm):04571         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04572         ; ============================================================
                      (    forth6809.asm):04573         ; ------------------------------------------------------------
                      (    forth6809.asm):04574         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04575         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04576         ; one expected.
                      (    forth6809.asm):04577         ; CFERR
                      (    forth6809.asm):04578         ;    Inputs:
                      (    forth6809.asm):04579         ;        none
                      (    forth6809.asm):04580         ;    Outputs:
                      (    forth6809.asm):04581         ;        does not return (THROW -22)
                      (    forth6809.asm):04582         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04583         ; ------------------------------------------------------------
DCBB CCFFEA           (    forth6809.asm):04584         CFERR:      LDD   #-22
DCBE 3606             (    forth6809.asm):04585                     PSHU  D                 ; -22
DCC0 BDDCF0           (    forth6809.asm):04586                     JSR   THROWW
DCC3 39               (    forth6809.asm):04587                     RTS
                      (    forth6809.asm):04588         
                      (    forth6809.asm):04589         ; ------------------------------------------------------------
                      (    forth6809.asm):04590         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04591         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04592         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04593         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04594         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04595         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04596         ; ------------------------------------------------------------
DCC4 3710             (    forth6809.asm):04597         CATCHW:     PULU  X                 ; xt
DCC6 DC0C             (    forth6809.asm):04598                     LDD   HANDLER
DCC8 3406             (    forth6809.asm):04599                     PSHS  D
DCCA 3440             (    forth6809.asm):04600                     PSHS  U
                      (    forth6809.asm):04601                     ; Save the input source specification.
                      (    forth6809.asm):04602                     ; See bugfix: CATCHW.1
DCCC DC39             (    forth6809.asm):04603                     LDD   SRCADDR
DCCE 3406             (    forth6809.asm):04604                     PSHS  D
DCD0 DC3B             (    forth6809.asm):04605                     LDD   SRCLEN
DCD2 3406             (    forth6809.asm):04606                     PSHS  D
DCD4 DC3D             (    forth6809.asm):04607                     LDD   SRCID
DCD6 3406             (    forth6809.asm):04608                     PSHS  D
DCD8 DC10             (    forth6809.asm):04609                     LDD   TOIN
DCDA 3406             (    forth6809.asm):04610                     PSHS  D
DCDC 1F40             (    forth6809.asm):04611                     TFR   S,D
DCDE DD0C             (    forth6809.asm):04612                     STD   HANDLER
                      (    forth6809.asm):04613         
DCE0 AD84             (    forth6809.asm):04614                     JSR   ,X
                      (    forth6809.asm):04615         
DCE2 3268             (    forth6809.asm):04616                     LEAS  8,S               ; drop saved input source
DCE4 3262             (    forth6809.asm):04617                     LEAS  2,S               ; saved U
DCE6 3506             (    forth6809.asm):04618                     PULS  D
DCE8 DD0C             (    forth6809.asm):04619                     STD   HANDLER
DCEA CC0000           (    forth6809.asm):04620                     LDD   #0
DCED 3606             (    forth6809.asm):04621                     PSHU  D                 ; 0 = no exception
DCEF 39               (    forth6809.asm):04622                     RTS
                      (    forth6809.asm):04623         
                      (    forth6809.asm):04624         ; ------------------------------------------------------------
                      (    forth6809.asm):04625         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04626         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04627         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04628         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04629         ; ------------------------------------------------------------

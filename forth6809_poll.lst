                      (    forth6809.asm):02064         ; ------------------------------------------------------------
                      (    forth6809.asm):02065         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):02066         ; receiver-error counters to zero.
                      (    forth6809.asm):02067         ; SERBUFCLR
                      (    forth6809.asm):02068         ;    Inputs:
                      (    forth6809.asm):02069         ;        none
                      (    forth6809.asm):02070         ;    Outputs:
                      (    forth6809.asm):02071         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02072         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02073         ;    Registers: only CC changed.
                      (    forth6809.asm):02074         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):02075         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):02076         ; ------------------------------------------------------------
                      (    forth6809.asm):02077         
CD90 7F0176           (    forth6809.asm):02078         SERBUFCLR:  CLR   INHEAD
CD93 7F0177           (    forth6809.asm):02079                     CLR   INTAIL
CD96 7F0178           (    forth6809.asm):02080                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
CD99 7F0179           (    forth6809.asm):02081                     CLR   OUTHEAD
CD9C 7F017A           (    forth6809.asm):02082                     CLR   OUTTAIL
CD9F 7F017B           (    forth6809.asm):02083                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):02084         
                      (    forth6809.asm):02085         
CDA2 7F017C           (    forth6809.asm):02086                     CLR   FECOUNT
CDA5 7F017D           (    forth6809.asm):02087                     CLR   OVRNCOUNT
CDA8 7F017E           (    forth6809.asm):02088                     CLR   PECOUNT
CDAB 7F017F           (    forth6809.asm):02089                     CLR   POLLREADYCNT
CDAE 39               (    forth6809.asm):02090                     RTS
                      (    forth6809.asm):02091         
                      (    forth6809.asm):02092         ; ------------------------------------------------------------
                      (    forth6809.asm):02093         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):02094         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):02095         ; INITSERIAL
                      (    forth6809.asm):02096         ;    Inputs:
                      (    forth6809.asm):02097         ;        none
                      (    forth6809.asm):02098         ;    Outputs:
                      (    forth6809.asm):02099         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):02100         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02101         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):02102         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):02103         ; ------------------------------------------------------------
CDAF BDCD90           (    forth6809.asm):02104         INITSERIAL: JSR   SERBUFCLR
CDB2 8603             (    forth6809.asm):02105                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
CDB4 B7C008           (    forth6809.asm):02106                     STA   ACIACR
CDB7 12               (    forth6809.asm):02107                     NOP                     ; Settling Delay
CDB8 12               (    forth6809.asm):02108                     NOP
                      (    forth6809.asm):02109         
                      (    forth6809.asm):02110                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02111                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02112                     ELSE                    ; <<<<<>>>>>
CDB9 8615             (    forth6809.asm):02113                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02114                     ENDC                    ; <<<<<<<<<<
CDBB B7C008           (    forth6809.asm):02115                     STA   ACIACR            ; See bugfix: INITSERIAL.1
CDBE 39               (    forth6809.asm):02116                     RTS
                      (    forth6809.asm):02117         
                      (    forth6809.asm):02118                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02119         ; ------------------------------------------------------------
                      (    forth6809.asm):02120         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02121         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02122         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02123         ; INFILL
                      (    forth6809.asm):02124         ;    Inputs:
                      (    forth6809.asm):02125         ;        none
                      (    forth6809.asm):02126         ;    Outputs:
                      (    forth6809.asm):02127         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02128         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02129         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02130         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02131                     SUBA  INTAIL
                      (    forth6809.asm):02132                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):02133                     RTS
                      (    forth6809.asm):02134         ; ------------------------------------------------------------
                      (    forth6809.asm):02135         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02136         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02137         ; receive path with interrupts already masked.
                      (    forth6809.asm):02138         ; RTSCHECKHI
                      (    forth6809.asm):02139         ;    Inputs:
                      (    forth6809.asm):02140         ;        none
                      (    forth6809.asm):02141         ;    Outputs:
                      (    forth6809.asm):02142         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02143         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02144         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02145         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):02146                     CMPA  #INHIWATER
                      (    forth6809.asm):02147                     BLO   RTSCHIDONE
                      (    forth6809.asm):02148                     TST   RTSSTATE
                      (    forth6809.asm):02149                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):02150                     LDA   #CR_RTSHI
                      (    forth6809.asm):02151                     STA   ACIACR
                      (    forth6809.asm):02152                     LDA   #1
                      (    forth6809.asm):02153                     STA   RTSSTATE
CDBF                  (    forth6809.asm):02154         RTSCHIDONE: RTS
                      (    forth6809.asm):02155         ; ------------------------------------------------------------
                      (    forth6809.asm):02156         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02157         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02158         ; enables it only while output is pending.
                      (    forth6809.asm):02159         ; UPDATE_RTS
                      (    forth6809.asm):02160         ;    Inputs:
                      (    forth6809.asm):02161         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02162         ;    Outputs:
                      (    forth6809.asm):02163         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02164         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02165         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02166         UPDATE_RTS:
                      (    forth6809.asm):02167                     TST   RTSSTATE
                      (    forth6809.asm):02168                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02169         
                      (    forth6809.asm):02170                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02171                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02172         
                      (    forth6809.asm):02173                                             ; $B5/%1011_0101
                      (    forth6809.asm):02174                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02175                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02176         
CDBF                  (    forth6809.asm):02177         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02178                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02179                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02180         
CDBF                  (    forth6809.asm):02181         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02182                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02183                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CDBF                  (    forth6809.asm):02184         WRITE_CR:
                      (    forth6809.asm):02185                     STA   ACIACR
                      (    forth6809.asm):02186                     RTS
                      (    forth6809.asm):02187         ; ------------------------------------------------------------
                      (    forth6809.asm):02188         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02189         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02190         ; Called after a character is added to the ring.
                      (    forth6809.asm):02191         ; CHKHI
                      (    forth6809.asm):02192         ;    Inputs:
                      (    forth6809.asm):02193         ;        RegB = input ring fill level
                      (    forth6809.asm):02194         ;    Outputs:
                      (    forth6809.asm):02195         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02196         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02197         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02198         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02199         CHKHI:
                      (    forth6809.asm):02200                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02201                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02202                     TST   RTSSTATE
                      (    forth6809.asm):02203                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02204                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02205                     STA   RTSSTATE
                      (    forth6809.asm):02206                     JSR   UPDATE_RTS
CDBF                  (    forth6809.asm):02207         CHKHIDONE:  RTS
                      (    forth6809.asm):02208         
                      (    forth6809.asm):02209         ; ------------------------------------------------------------
                      (    forth6809.asm):02210         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02211         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02212         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02213         ; CHKLO
                      (    forth6809.asm):02214         ;    Inputs:
                      (    forth6809.asm):02215         ;        RegB = input ring fill level
                      (    forth6809.asm):02216         ;    Outputs:
                      (    forth6809.asm):02217         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02218         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02219         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02220         CHKLO:
                      (    forth6809.asm):02221                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02222                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02223                     TST   RTSSTATE
                      (    forth6809.asm):02224                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02225                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02226                     STA   RTSSTATE
                      (    forth6809.asm):02227                     JSR   UPDATE_RTS
CDBF                  (    forth6809.asm):02228         CHKLODONE:  RTS
                      (    forth6809.asm):02229         ; ------------------------------------------------------------
                      (    forth6809.asm):02230         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02231         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02232         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02233         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02234         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02235         ;    Inputs:
                      (    forth6809.asm):02236         ;        none
                      (    forth6809.asm):02237         ;    Outputs:
                      (    forth6809.asm):02238         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02239         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02240         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02241         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02242         FLUSHOUTBUFFER:
                      (    forth6809.asm):02243                     LDB   OUTTAIL
                      (    forth6809.asm):02244                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02245                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02246         
                      (    forth6809.asm):02247                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02248                     BITA  #SR_CTS
                      (    forth6809.asm):02249                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02250         
                      (    forth6809.asm):02251                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02252                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02253                                             ; than spin-wait here.
                      (    forth6809.asm):02254         
                      (    forth6809.asm):02255                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02256                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02257                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02258         
                      (    forth6809.asm):02259                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02260                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02261                     STB   OUTTAIL
                      (    forth6809.asm):02262                                             ; One character sent - return rather than
                      (    forth6809.asm):02263                                             ; loop back for more (see header comment).
CDBF                  (    forth6809.asm):02264         FLUSHED:
                      (    forth6809.asm):02265                     RTS
                      (    forth6809.asm):02266         ; ------------------------------------------------------------
                      (    forth6809.asm):02267         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02268         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02269         ; PUTCHAR
                      (    forth6809.asm):02270         ;    Inputs:
                      (    forth6809.asm):02271         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02272         ;    Outputs:
                      (    forth6809.asm):02273         ;        none
                      (    forth6809.asm):02274         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02275         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02276         PUTCHAR:
                      (    forth6809.asm):02277                     PSHS  CC,X
                      (    forth6809.asm):02278                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02279         
                      (    forth6809.asm):02280                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02281                     INCB
                      (    forth6809.asm):02282                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02283                     CMPB  OUTTAIL
                      (    forth6809.asm):02284                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02285         
                      (    forth6809.asm):02286                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02287                     LDB   OUTHEAD
                      (    forth6809.asm):02288                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02289         
                      (    forth6809.asm):02290                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02291                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02292                     STB   OUTHEAD
                      (    forth6809.asm):02293         
                      (    forth6809.asm):02294                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02295                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02296         
                      (    forth6809.asm):02297                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02298                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02299                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02300                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02301                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02302                                             ; expects the critical section active
                      (    forth6809.asm):02303         
                      (    forth6809.asm):02304                     BRA   PUT_EXIT
                      (    forth6809.asm):02305         
                      (    forth6809.asm):02306         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02307         ; priming the pump by transmitting a character.
CDBF                  (    forth6809.asm):02308         CHK_INT_PATH:
                      (    forth6809.asm):02309                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02310                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02311         
                      (    forth6809.asm):02312                                             ; No! Restart.
                      (    forth6809.asm):02313                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02314                     LDB   OUTTAIL
                      (    forth6809.asm):02315                     LDA   B,X
                      (    forth6809.asm):02316                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02317         
                      (    forth6809.asm):02318                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02319                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02320                     STB   OUTTAIL
                      (    forth6809.asm):02321         
                      (    forth6809.asm):02322                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02323                     STA   OUTACTIVITY
                      (    forth6809.asm):02324                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02325         
CDBF                  (    forth6809.asm):02326         PUT_EXIT:
                      (    forth6809.asm):02327                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02328                                             ; by restoring the CC.
                      (    forth6809.asm):02329         ; ------------------------------------------------------------
                      (    forth6809.asm):02330         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02331         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02332         ; GETCHAR
                      (    forth6809.asm):02333         ;    Inputs:
                      (    forth6809.asm):02334         ;        none
                      (    forth6809.asm):02335         ;    Outputs:
                      (    forth6809.asm):02336         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02337         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02338         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02339         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02340         GETCHAR:
                      (    forth6809.asm):02341                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02342                     CMPB  INHEAD
                      (    forth6809.asm):02343                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02344         
                      (    forth6809.asm):02345                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02346                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02347         
                      (    forth6809.asm):02348                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02349                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02350                     STB   INTAIL
                      (    forth6809.asm):02351         
                      (    forth6809.asm):02352                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02353                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02354                     ORCC  #$10
                      (    forth6809.asm):02355                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02356                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02357                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02358                                             ; there's no already-loaded value here
                      (    forth6809.asm):02359                                             ; worth reusing.
                      (    forth6809.asm):02360                     JSR   CHKLO
                      (    forth6809.asm):02361                     ANDCC #$EF
                      (    forth6809.asm):02362         
                      (    forth6809.asm):02363                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02364                     RTS
                      (    forth6809.asm):02365         
CDBF                  (    forth6809.asm):02366         GET_NO_CHAR:
                      (    forth6809.asm):02367                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02368                     RTS
                      (    forth6809.asm):02369         ; ------------------------------------------------------------
                      (    forth6809.asm):02370         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02371         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02372         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02373         ; RTSCHECKLO
                      (    forth6809.asm):02374         ;    Inputs:
                      (    forth6809.asm):02375         ;        none
                      (    forth6809.asm):02376         ;    Outputs:
                      (    forth6809.asm):02377         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02378         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02379         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02380         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02381         RTSCHECKLO:
                      (    forth6809.asm):02382                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384                     JSR   INFILL
                      (    forth6809.asm):02385                     CMPA  #INLOWATER
                      (    forth6809.asm):02386                     BHI   RTSCLODONE
                      (    forth6809.asm):02387                     TST   RTSSTATE
                      (    forth6809.asm):02388                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02389         
                      (    forth6809.asm):02390         
                      (    forth6809.asm):02391                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02392         
                      (    forth6809.asm):02393                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02394                     CMPB  OUTHEAD
                      (    forth6809.asm):02395                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02396         
                      (    forth6809.asm):02397                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02398                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02399                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02400         
CDBF                  (    forth6809.asm):02401         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02402                     STA   ACIACR
                      (    forth6809.asm):02403         
CDBF                  (    forth6809.asm):02404         RTSCLOUNMASK:
                      (    forth6809.asm):02405                     ANDCC #$EF
                      (    forth6809.asm):02406         
CDBF                  (    forth6809.asm):02407         RTSCLODONE: RTS
                      (    forth6809.asm):02408         
                      (    forth6809.asm):02409         ; ------------------------------------------------------------
                      (    forth6809.asm):02410         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02411         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02412         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02413         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02414         ; IRQH
                      (    forth6809.asm):02415         ;    Inputs:
                      (    forth6809.asm):02416         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02417         ;    Outputs:
                      (    forth6809.asm):02418         ;        none (returns with RTI)
                      (    forth6809.asm):02419         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02420         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02421         ; ------------------------------------------------------------
CDBF                  (    forth6809.asm):02422         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02425                     BEQ   IRQCHN            ; No! Pass it down the chain.
                      (    forth6809.asm):02426                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02427                     BNE   INCHAR
                      (    forth6809.asm):02428                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02429                     BNE   OUTCHAR
                      (    forth6809.asm):02430                                             ; Ignore all other interrupts such as DCD change.
CDBF                  (    forth6809.asm):02431         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02432                                             ; & restores state.
CDBF                  (    forth6809.asm):02433         IRQRTI      EQU   IRQDONE0          ; IRQCHAIN initially points here
CDBF                  (    forth6809.asm):02434         IRQCHN:     JMP   [IRQCHAIN]        ; not the ACIA: next handler in the chain.
                      (    forth6809.asm):02435                                             ; See shadow IRQH.1
                      (    forth6809.asm):02436         
CDBF                  (    forth6809.asm):02437         INCHAR:
                      (    forth6809.asm):02438                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02439                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02440                                             ; Any receiver error flagged?
                      (    forth6809.asm):02441                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02444                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02445                     INC   FECOUNT           ; more than one bit can be set at once.
CDBF                  (    forth6809.asm):02446         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02447                     BEQ   INXOVRN
                      (    forth6809.asm):02448                     INC   OVRNCOUNT
CDBF                  (    forth6809.asm):02449         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02450                     BEQ   INXPE
                      (    forth6809.asm):02451                     INC   PECOUNT
CDBF                  (    forth6809.asm):02452         INXPE:      RTI
                      (    forth6809.asm):02453         
CDBF                  (    forth6809.asm):02454         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02455                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02456                     LDB   INHEAD
                      (    forth6809.asm):02457                     STA   B,X
                      (    forth6809.asm):02458                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02459                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02460                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02461                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02462                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02463                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02464                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02465                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02466                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02467                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02468                     JSR   CHKHI             ; Protect the in buffer from overflow.
CDBF                  (    forth6809.asm):02469         IRQDONE1:   RTI
                      (    forth6809.asm):02470         
                      (    forth6809.asm):02471                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02472         
CDBF                  (    forth6809.asm):02473         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02474                     CMPB  OUTHEAD
                      (    forth6809.asm):02475                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02476         
                      (    forth6809.asm):02477                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02478                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02479                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02480         
                      (    forth6809.asm):02481                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02482                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02483                     STB   OUTTAIL
CDBF                  (    forth6809.asm):02484         IRQDONE2    RTI
                      (    forth6809.asm):02485         
CDBF                  (    forth6809.asm):02486         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02487                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02488                     CLR   OUTACTIVITY
                      (    forth6809.asm):02489                     JSR   UPDATE_RTS
CDBF                  (    forth6809.asm):02490         IRQDONE3    RTI
                      (    forth6809.asm):02491         
                      (    forth6809.asm):02492                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02493         
CDBF 6E9F0083         (    forth6809.asm):02494         IRQH:       JMP   [IRQCHAIN]        ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02495                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02496                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02497                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02498                                             ; the other unused vectors below
CDC3 3B               (    forth6809.asm):02499         IRQRTI:     RTI                     ; IRQCHAIN initially points here
                      (    forth6809.asm):02500                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02501         
                      (    forth6809.asm):02502         ; ------------------------------------------------------------
                      (    forth6809.asm):02503         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02504         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02505         ; ------------------------------------------------------------
CDC4 3B               (    forth6809.asm):02506         SWI3H:      RTI
CDC5 3B               (    forth6809.asm):02507         SWI2H:      RTI
CDC6 3B               (    forth6809.asm):02508         FIRQH:      RTI
CDC7 3B               (    forth6809.asm):02509         NMIH:       RTI                     ; unused now that NMI -> WARM
CDC8 CCFF9D           (    forth6809.asm):02510         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
CDCB 3606             (    forth6809.asm):02511                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
CDCD 7ED895           (    forth6809.asm):02512                     JMP   THROWW
                      (    forth6809.asm):02513         
                      (    forth6809.asm):02514         ; ============================================================
                      (    forth6809.asm):02515         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02516         ; ============================================================
                      (    forth6809.asm):02517         ; ------------------------------------------------------------
                      (    forth6809.asm):02518         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02519         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02520         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02521         ; COLD
                      (    forth6809.asm):02522         ;    Inputs:
                      (    forth6809.asm):02523         ;        none (entered at reset)
                      (    forth6809.asm):02524         ;    Outputs:
                      (    forth6809.asm):02525         ;        none (does not return)
                      (    forth6809.asm):02526         ;    Registers: all changed.
                      (    forth6809.asm):02527         ; ------------------------------------------------------------
CDD0 CC0240           (    forth6809.asm):02528         COLD:       LDD   #APPVARS
CDD3 DD0A             (    forth6809.asm):02529                     STD   VARHERE
CDD5 CC7000           (    forth6809.asm):02530                     LDD   #APPCODE
CDD8 DD08             (    forth6809.asm):02531                     STD   CODEHERE
CDDA CC2000           (    forth6809.asm):02532                     LDD   #APPDICT
CDDD DD06             (    forth6809.asm):02533                     STD   DPHERE
CDDF CCCD8A           (    forth6809.asm):02534                     LDD   #BASELATEST
CDE2 DD04             (    forth6809.asm):02535                     STD   LATEST
CDE4 BDD465           (    forth6809.asm):02536                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02537         
CDE7 CC000A           (    forth6809.asm):02538                     LDD   #10
CDEA DD02             (    forth6809.asm):02539                     STD   BASE
                      (    forth6809.asm):02540         
CDEC CC0106           (    forth6809.asm):02541                     LDD   #TIBBUF
CDEF DD39             (    forth6809.asm):02542                     STD   SRCADDR
CDF1 CC0000           (    forth6809.asm):02543                     LDD   #0
CDF4 DD3B             (    forth6809.asm):02544                     STD   SRCLEN
CDF6 DD3D             (    forth6809.asm):02545                     STD   SRCID
                      (    forth6809.asm):02546         
CDF8 8ECEA5           (    forth6809.asm):02547                     LDX   #SIGNON
CDFB 3610             (    forth6809.asm):02548                     PSHU  X                 ; c-addr
CDFD CC000F           (    forth6809.asm):02549                     LDD   #SIGNONL
CE00 3606             (    forth6809.asm):02550                     PSHU  D                 ; u

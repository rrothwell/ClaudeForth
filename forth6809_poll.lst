D921 2421             (    forth6809.asm):03803                     BHS   PRNDONE
D923 10AE84           (    forth6809.asm):03804                     LDY   ,X                ; newest header of this wordlist
D926 108CC000         (    forth6809.asm):03805         PRWALK:     CMPY  #ROMSTRT
D92A 2413             (    forth6809.asm):03806                     BHS   PRSTORE           ; ROM header: keep
D92C 10ACE4           (    forth6809.asm):03807                     CMPY  ,S
D92F 250E             (    forth6809.asm):03808                     BLO   PRSTORE           ; below the mark (or empty): keep
D931 E6A4             (    forth6809.asm):03809                     LDB   ,Y
D933 C41F             (    forth6809.asm):03810                     ANDB  #$1F
D935 4F               (    forth6809.asm):03811                     CLRA
D936 3121             (    forth6809.asm):03812                     LEAY  1,Y
D938 31AB             (    forth6809.asm):03813                     LEAY  D,Y
D93A 10AEA4           (    forth6809.asm):03814                     LDY   ,Y                ; follow the LINK
D93D 20E7             (    forth6809.asm):03815                     BRA   PRWALK
D93F 10AF81           (    forth6809.asm):03816         PRSTORE:    STY   ,X++
D942 20DB             (    forth6809.asm):03817                     BRA   PRLOOP
D944 3262             (    forth6809.asm):03818         PRNDONE:     LEAS  2,S

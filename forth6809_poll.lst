                      (    forth6809.asm):05557         ; Common part of */ and */MOD: form the 32-bit product n1 * n2, then
                      (    forth6809.asm):05558         ; divide it by n3. The quotient is negated if an odd number of the
                      (    forth6809.asm):05559         ; three is negative, the remainder if the product is negative. THROW
                      (    forth6809.asm):05560         ; -10 if n3 is zero.
                      (    forth6809.asm):05561         ; STARSLASHCOMMON   ( n1 n2 n3 -- )
                      (    forth6809.asm):05562         ;    Inputs:
                      (    forth6809.asm):05563         ;        n1, n2 and n3 on the data stack (n3 on top)
                      (    forth6809.asm):05564         ;    Outputs:
                      (    forth6809.asm):05565         ;        PRODLO = quotient, DIVREM = remainder (data stack popped)
                      (    forth6809.asm):05566         ;    Registers: RegA, RegB and RegD changed; many scratch cells used.
                      (    forth6809.asm):05567         ; ------------------------------------------------------------

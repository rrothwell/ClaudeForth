                      (    forth6809.asm):04349         ; ============================================================
                      (    forth6809.asm):04350         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04351         ; ============================================================
                      (    forth6809.asm):04352                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04353         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04354         
                      (    forth6809.asm):04355         ; ------------------------------------------------------------
                      (    forth6809.asm):04356         ; KEY  ( -- char )
                      (    forth6809.asm):04357         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04358         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04359         ; ------------------------------------------------------------
D808                  (    forth6809.asm):04360         KEYW:
                      (    forth6809.asm):04361         
                      (    forth6809.asm):04362                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04363                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04364         
                      (    forth6809.asm):04365                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04366                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04367                                             ; by transmitting all chars.
                      (    forth6809.asm):04368         
D808                  (    forth6809.asm):04369         TRY_READ:
                      (    forth6809.asm):04370                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04371                     BCS   KEYW              ; No? Try again to receive a char,
                      (    forth6809.asm):04372                                             ; while still transmitting!
                      (    forth6809.asm):04373         
                      (    forth6809.asm):04374                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04375                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04376                     PSHU  D                 ; char
                      (    forth6809.asm):04377         
                      (    forth6809.asm):04378                     RTS
                      (    forth6809.asm):04379         
                      (    forth6809.asm):04380         ; ------------------------------------------------------------
                      (    forth6809.asm):04381         ; KEY?  ( -- flag )
                      (    forth6809.asm):04382         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04383         ; ------------------------------------------------------------
D808                  (    forth6809.asm):04384         KEYQW:
                      (    forth6809.asm):04385                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04386         
                      (    forth6809.asm):04387                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04388                     CMPA  INTAIL
                      (    forth6809.asm):04389         
                      (    forth6809.asm):04390                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04391         
                      (    forth6809.asm):04392                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04393         
                      (    forth6809.asm):04394                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04395                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04396         
                      (    forth6809.asm):04397                     RTS
                      (    forth6809.asm):04398         
D808                  (    forth6809.asm):04399         KQTRUE:
                      (    forth6809.asm):04400                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04401                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04402                     RTS
                      (    forth6809.asm):04403         
                      (    forth6809.asm):04404         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04405         
                      (    forth6809.asm):04406         ; ------------------------------------------------------------
                      (    forth6809.asm):04407         ; EMIT  ( char -- )
                      (    forth6809.asm):04408         ; Transmit char through PUTCHAR (the output ring). The character is
                      (    forth6809.asm):04409         ; discarded if the ring is full.
                      (    forth6809.asm):04410         ; ------------------------------------------------------------
D808                  (    forth6809.asm):04411         EMITW:
                      (    forth6809.asm):04412                     PULU  D                 ; char
                      (    forth6809.asm):04413                     TFR   B,A
                      (    forth6809.asm):04414                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04415                     RTS
                      (    forth6809.asm):04416         
                      (    forth6809.asm):04417                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04418         ; ------------------------------------------------------------
                      (    forth6809.asm):04419         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04420         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04421         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04422         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04423         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04424         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04425         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04426         ; follow.
                      (    forth6809.asm):04427         ; ------------------------------------------------------------
D808                  (    forth6809.asm):04428         KEYW:
D808 B6C008           (    forth6809.asm):04429                     LDA   ACIASR
D80B 8501             (    forth6809.asm):04430                     BITA  #SR_RDRF
D80D 2705             (    forth6809.asm):04431                     BEQ   KWAIT
D80F 7C017F           (    forth6809.asm):04432                     INC   POLLREADYCNT      ; character was already queued when we
D812 2007             (    forth6809.asm):04433                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D814                  (    forth6809.asm):04434         KWAIT:
D814 B6C008           (    forth6809.asm):04435         KSPIN:      LDA   ACIASR
D817 8501             (    forth6809.asm):04436                     BITA  #SR_RDRF
D819 27F9             (    forth6809.asm):04437                     BEQ   KSPIN
D81B                  (    forth6809.asm):04438         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04439                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04440                                             ; error bits from THIS copy, not a fresh
                      (    forth6809.asm):04441                                             ; read, since reading ACIADR below clears
                      (    forth6809.asm):04442                                             ; RDRF and the latched error bits together
D81B 8570             (    forth6809.asm):04443                     BITA  #SR_FE+SR_OVRN+SR_PE
D81D 2715             (    forth6809.asm):04444                     BEQ   KGETCH
D81F 8510             (    forth6809.asm):04445                     BITA  #SR_FE
D821 2703             (    forth6809.asm):04446                     BEQ   KXFE
D823 7C017C           (    forth6809.asm):04447                     INC   FECOUNT
D826 8520             (    forth6809.asm):04448         KXFE:       BITA  #SR_OVRN
D828 2703             (    forth6809.asm):04449                     BEQ   KXOVRN
D82A 7C017D           (    forth6809.asm):04450                     INC   OVRNCOUNT
D82D 8540             (    forth6809.asm):04451         KXOVRN:     BITA  #SR_PE
D82F 2703             (    forth6809.asm):04452                     BEQ   KGETCH
D831 7C017E           (    forth6809.asm):04453                     INC   PECOUNT
D834 B6C009           (    forth6809.asm):04454         KGETCH:     LDA   ACIADR
D837 1F89             (    forth6809.asm):04455                     TFR   A,B
D839 4F               (    forth6809.asm):04456                     CLRA
D83A 3606             (    forth6809.asm):04457                     PSHU  D                 ; char
D83C 39               (    forth6809.asm):04458                     RTS
                      (    forth6809.asm):04459         
                      (    forth6809.asm):04460         ; ------------------------------------------------------------
                      (    forth6809.asm):04461         ; Send the software flow-control character XOFF (PUTXOFF) or XON
                      (    forth6809.asm):04462         ; (PUTXON) straight to the ACIA, waiting for TDRE. The data stack is
                      (    forth6809.asm):04463         ; not touched, so ACCEPT can call these at any point.
                      (    forth6809.asm):04464         ; PUTXON / PUTXOFF
                      (    forth6809.asm):04465         ;    Inputs:
                      (    forth6809.asm):04466         ;        none
                      (    forth6809.asm):04467         ;    Outputs:
                      (    forth6809.asm):04468         ;        XON or XOFF transmitted
                      (    forth6809.asm):04469         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):04470         ; Original comment: shadow PUTXON.0.
                      (    forth6809.asm):04471         ; ------------------------------------------------------------
D83D 8613             (    forth6809.asm):04472         PUTXOFF:    LDA   #XOFFCH
D83F 2002             (    forth6809.asm):04473                     BRA   PUTXCH
D841 8611             (    forth6809.asm):04474         PUTXON:     LDA   #XONCH
D843 3402             (    forth6809.asm):04475         PUTXCH:     PSHS  A
D845 F6C008           (    forth6809.asm):04476         PXWT:       LDB   ACIASR
D848 C502             (    forth6809.asm):04477                     BITB  #SR_TDRE
D84A 27F9             (    forth6809.asm):04478                     BEQ   PXWT
D84C 3502             (    forth6809.asm):04479                     PULS  A
D84E B7C009           (    forth6809.asm):04480                     STA   ACIADR
D851 39               (    forth6809.asm):04481                     RTS
                      (    forth6809.asm):04482         
                      (    forth6809.asm):04483         ; ------------------------------------------------------------
                      (    forth6809.asm):04484         ; KEY?  ( -- flag )  [polling build]
                      (    forth6809.asm):04485         ; Return true if the ACIA has a received character (RDRF set).
                      (    forth6809.asm):04486         ; ------------------------------------------------------------
D852 B6C008           (    forth6809.asm):04487         KEYQW:      LDA   ACIASR
D855 8501             (    forth6809.asm):04488                     BITA  #SR_RDRF
D857 2706             (    forth6809.asm):04489                     BEQ   KQFALSE
D859 CCFFFF           (    forth6809.asm):04490                     LDD   #TRUEV
D85C 3606             (    forth6809.asm):04491                     PSHU  D                 ; flag = true
D85E 39               (    forth6809.asm):04492                     RTS
D85F CC0000           (    forth6809.asm):04493         KQFALSE:    LDD   #FALSEV
D862 3606             (    forth6809.asm):04494                     PSHU  D                 ; flag = false
D864 39               (    forth6809.asm):04495                     RTS
                      (    forth6809.asm):04496         
                      (    forth6809.asm):04497         ; ------------------------------------------------------------
                      (    forth6809.asm):04498         ; EMIT  ( char -- )  [polling build]
                      (    forth6809.asm):04499         ; Wait for TDRE, then transmit char directly.
                      (    forth6809.asm):04500         ; ------------------------------------------------------------
D865 3706             (    forth6809.asm):04501         EMITW:      PULU  D                 ; char
D867 D71E             (    forth6809.asm):04502                     STB   EMITCH
D869 B6C008           (    forth6809.asm):04503         EMITWT:     LDA   ACIASR
D86C 8502             (    forth6809.asm):04504                     BITA  #SR_TDRE
D86E 27F9             (    forth6809.asm):04505                     BEQ   EMITWT
D870 961E             (    forth6809.asm):04506                     LDA   EMITCH
D872 B7C009           (    forth6809.asm):04507                     STA   ACIADR
D875 39               (    forth6809.asm):04508                     RTS
                      (    forth6809.asm):04509         
                      (    forth6809.asm):04510                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04511         
                      (    forth6809.asm):04512         ; ------------------------------------------------------------
                      (    forth6809.asm):04513         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04514         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04515         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04516         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04517         ; ------------------------------------------------------------
D876 335E             (    forth6809.asm):04518         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
D878 CC0000           (    forth6809.asm):04519                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
D87B EDC4             (    forth6809.asm):04520                     STD   ,U
                      (    forth6809.asm):04521         
                      (    forth6809.asm):04522                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04523                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04524                                             ; covers this, nothing extra needed
                      (    forth6809.asm):04525                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):04526                                             ; stream this line's characters
D87D BDD841           (    forth6809.asm):04527                     JSR   PUTXON
                      (    forth6809.asm):04528                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):04529         
D880 BDD808           (    forth6809.asm):04530         ALOOP:      JSR   KEYW
D883 3706             (    forth6809.asm):04531                     PULU  D
D885 1F02             (    forth6809.asm):04532                     TFR   D,Y               ; Y = the character
                      (    forth6809.asm):04533         
D887 C10D             (    forth6809.asm):04534                     CMPB  #13
D889 274F             (    forth6809.asm):04535                     BEQ   ADONE
D88B C10A             (    forth6809.asm):04536                     CMPB  #10
D88D 27F1             (    forth6809.asm):04537                     BEQ   ALOOP
D88F C108             (    forth6809.asm):04538                     CMPB  #8
D891 2724             (    forth6809.asm):04539                     BEQ   ABKSP
D893 C17F             (    forth6809.asm):04540                     CMPB  #127
D895 2720             (    forth6809.asm):04541                     BEQ   ABKSP
                      (    forth6809.asm):04542         
D897 ECC4             (    forth6809.asm):04543                     LDD   ,U
D899 10A342           (    forth6809.asm):04544                     CMPD  2,U
D89C 27E2             (    forth6809.asm):04545                     BEQ   ALOOP
                      (    forth6809.asm):04546         
D89E AE44             (    forth6809.asm):04547                     LDX   4,U
D8A0 308B             (    forth6809.asm):04548                     LEAX  D,X
D8A2 1F20             (    forth6809.asm):04549                     TFR   Y,D
D8A4 E784             (    forth6809.asm):04550                     STB   ,X
D8A6 ECC4             (    forth6809.asm):04551                     LDD   ,U
D8A8 C30001           (    forth6809.asm):04552                     ADDD  #1
D8AB EDC4             (    forth6809.asm):04553                     STD   ,U
                      (    forth6809.asm):04554         
D8AD 1F20             (    forth6809.asm):04555                     TFR   Y,D
D8AF 4F               (    forth6809.asm):04556                     CLRA
D8B0 3606             (    forth6809.asm):04557                     PSHU  D
D8B2 BDD865           (    forth6809.asm):04558                     JSR   EMITW
D8B5 20C9             (    forth6809.asm):04559                     BRA   ALOOP
                      (    forth6809.asm):04560         
D8B7 ECC4             (    forth6809.asm):04561         ABKSP:      LDD   ,U
D8B9 27C5             (    forth6809.asm):04562                     BEQ   ALOOP
D8BB 830001           (    forth6809.asm):04563                     SUBD  #1
D8BE EDC4             (    forth6809.asm):04564                     STD   ,U
D8C0 CC0008           (    forth6809.asm):04565                     LDD   #8
D8C3 3606             (    forth6809.asm):04566                     PSHU  D
D8C5 BDD865           (    forth6809.asm):04567                     JSR   EMITW
D8C8 CC0020           (    forth6809.asm):04568                     LDD   #32
D8CB 3606             (    forth6809.asm):04569                     PSHU  D
D8CD BDD865           (    forth6809.asm):04570                     JSR   EMITW
D8D0 CC0008           (    forth6809.asm):04571                     LDD   #8
D8D3 3606             (    forth6809.asm):04572                     PSHU  D
D8D5 BDD865           (    forth6809.asm):04573                     JSR   EMITW
D8D8 20A6             (    forth6809.asm):04574                     BRA   ALOOP
                      (    forth6809.asm):04575         
D8DA                  (    forth6809.asm):04576         ADONE:
                      (    forth6809.asm):04577                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: nothing
                      (    forth6809.asm):04578                                             ; extra needed, see ACCEPT's entry above
                      (    forth6809.asm):04579                     ELSE                    ; <<<<<>>>>>  polling build: the line is complete - tell
                      (    forth6809.asm):04580                                             ; the host to pause before INTERPRET runs
                      (    forth6809.asm):04581                                             ; with KEY never polled at all
D8DA BDD83D           (    forth6809.asm):04582                     JSR   PUTXOFF
                      (    forth6809.asm):04583                     ENDC                    ; <<<<<<<<<<
D8DD ECC4             (    forth6809.asm):04584                     LDD   ,U
D8DF ED44             (    forth6809.asm):04585                     STD   4,U               ; +n2
D8E1 3344             (    forth6809.asm):04586                     LEAU  4,U
D8E3 39               (    forth6809.asm):04587                     RTS
                      (    forth6809.asm):04588         
                      (    forth6809.asm):04589         ; ------------------------------------------------------------
                      (    forth6809.asm):04590         ; EXPECT  ( c-addr +n -- )
                      (    forth6809.asm):04591         ; Read a line as ACCEPT does and store the count in SPAN.
                      (    forth6809.asm):04592         ; ------------------------------------------------------------
D8E4 BDD876           (    forth6809.asm):04593         EXPECTW:    JSR   ACCEPTW
D8E7 3706             (    forth6809.asm):04594                     PULU  D
D8E9 DD3F             (    forth6809.asm):04595                     STD   SPAN
D8EB 39               (    forth6809.asm):04596                     RTS
                      (    forth6809.asm):04597         
                      (    forth6809.asm):04598         ; ------------------------------------------------------------
                      (    forth6809.asm):04599         ; QUERY  ( -- )
                      (    forth6809.asm):04600         ; Read a line into the terminal input buffer and make it the input
                      (    forth6809.asm):04601         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):04602         ; to 0 and >IN to 0.
                      (    forth6809.asm):04603         ; ------------------------------------------------------------
D8EC 8E0106           (    forth6809.asm):04604         QUERYW:     LDX   #TIBBUF
D8EF 3610             (    forth6809.asm):04605                     PSHU  X
D8F1 CC0050           (    forth6809.asm):04606                     LDD   #TIBBUFL
D8F4 3606             (    forth6809.asm):04607                     PSHU  D
D8F6 BDD876           (    forth6809.asm):04608                     JSR   ACCEPTW
D8F9 3706             (    forth6809.asm):04609                     PULU  D
D8FB DD12             (    forth6809.asm):04610                     STD   NTIB
D8FD DD3B             (    forth6809.asm):04611                     STD   SRCLEN
D8FF CC0106           (    forth6809.asm):04612                     LDD   #TIBBUF
D902 DD39             (    forth6809.asm):04613                     STD   SRCADDR
D904 CC0000           (    forth6809.asm):04614                     LDD   #0
D907 DD3D             (    forth6809.asm):04615                     STD   SRCID
D909 DD10             (    forth6809.asm):04616                     STD   TOIN
D90B 39               (    forth6809.asm):04617                     RTS
                      (    forth6809.asm):04618         
                      (    forth6809.asm):04619         ; ============================================================
                      (    forth6809.asm):04620         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04621         ; ============================================================
                      (    forth6809.asm):04622         ; ------------------------------------------------------------
                      (    forth6809.asm):04623         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04624         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04625         ; one expected.
                      (    forth6809.asm):04626         ; CFERR
                      (    forth6809.asm):04627         ;    Inputs:
                      (    forth6809.asm):04628         ;        none
                      (    forth6809.asm):04629         ;    Outputs:
                      (    forth6809.asm):04630         ;        does not return (THROW -22)
                      (    forth6809.asm):04631         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04632         ; ------------------------------------------------------------
D90C CCFFEA           (    forth6809.asm):04633         CFERR:      LDD   #-22
D90F 3606             (    forth6809.asm):04634                     PSHU  D                 ; -22
D911 BDD941           (    forth6809.asm):04635                     JSR   THROWW
D914 39               (    forth6809.asm):04636                     RTS
                      (    forth6809.asm):04637         
                      (    forth6809.asm):04638         ; ------------------------------------------------------------
                      (    forth6809.asm):04639         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04640         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04641         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04642         ; THROW unwinds to this frame and CATCH returns n.

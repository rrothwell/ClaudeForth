                      (    forth6809.asm):07945         ; SNAME  ( xt -- c-addr u | 0 0 )
                      (    forth6809.asm):07946         ; Find the name of the word whose xt is given by searching every
                      (    forth6809.asm):07947         ; wordlist. Return the name or two zeros if not found.
                      (    forth6809.asm):07948         ; ------------------------------------------------------------
EA74 3720             (    forth6809.asm):07949         SNAMEW:     PULU  Y                 ; xt (5k: Y = target, X = header, no scratch)
EA76 8E005B           (    forth6809.asm):07950                     LDX   #WLHEADS
EA79 3410             (    forth6809.asm):07951                     PSHS  X                 ; 0,S = next wordlist cell
EA7B AEE4             (    forth6809.asm):07952         SNWL:       LDX   ,S
EA7D 9C45             (    forth6809.asm):07953                     CMPX  WLEND
EA7F 242D             (    forth6809.asm):07954                     BHS   SNNOTFOUND
EA81 3002             (    forth6809.asm):07955                     LEAX  2,X
EA83 AFE4             (    forth6809.asm):07956                     STX   ,S
EA85 AE1E             (    forth6809.asm):07957                     LDX   -2,X              ; newest header of this wordlist
EA87 8C0000           (    forth6809.asm):07958         SNLOOP:     CMPX  #0
EA8A 27EF             (    forth6809.asm):07959                     BEQ   SNWL
EA8C E684             (    forth6809.asm):07960                     LDB   ,X

                      (    forth6809.asm):03577                     ; distinct success code (1, not -1) so TRYNUM can tell
                      (    forth6809.asm):03578                     ; single and double apart
E2CD CC0001           (    forth6809.asm):03579                     LDD   #1
E2D0 3606             (    forth6809.asm):03580                     PSHU  D
E2D2 39               (    forth6809.asm):03581                     RTS
                      (    forth6809.asm):03582         
E2D3 3342             (    forth6809.asm):03583         NQSINGLE:   LEAU  2,U               ; SINGLE success: drop the high cell
E2D5 CCFFFF           (    forth6809.asm):03584                     LDD   #-1
E2D8 3606             (    forth6809.asm):03585                     PSHU  D
E2DA 39               (    forth6809.asm):03586                     RTS
                      (    forth6809.asm):03587         
E2DB 3348             (    forth6809.asm):03588         NQBADF:     LEAU  8,U               ; drop the frame
E2DD AEE4             (    forth6809.asm):03589         NQBAD:      LDX   ,S

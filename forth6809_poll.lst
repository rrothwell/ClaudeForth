                      (    forth6809.asm):05555         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):05556         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):05557         ; the string.
                      (    forth6809.asm):05558         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):05559         ;    Inputs:
                      (    forth6809.asm):05560         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):05561         ;        count byte
                      (    forth6809.asm):05562         ;    Outputs:
                      (    forth6809.asm):05563         ;        execution continues after the string, or THROW -2
                      (    forth6809.asm):05564         ;    Registers: RegA, RegB, RegD, RegX, RegY changed.
                      (    forth6809.asm):05565         ; ------------------------------------------------------------
DE78                  (    forth6809.asm):05566         DOABORTQUOTE:
DE78 3510             (    forth6809.asm):05567                     PULS  X
DE7A E684             (    forth6809.asm):05568                     LDB   ,X
DE7C 3001             (    forth6809.asm):05569                     LEAX  1,X               ; X = text, B = length
DE7E 4F               (    forth6809.asm):05570                     CLRA
DE7F 3720             (    forth6809.asm):05571                     PULU  Y                 ; flag
DE81 108C0000         (    forth6809.asm):05572                     CMPY  #0
DE85 2605             (    forth6809.asm):05573                     BNE   AQTHROW
DE87 3085             (    forth6809.asm):05574                     LEAX  B,X
DE89 3410             (    forth6809.asm):05575                     PSHS  X
DE8B 39               (    forth6809.asm):05576                     RTS
DE8C 3610             (    forth6809.asm):05577         AQTHROW:    PSHU  X
DE8E 3606             (    forth6809.asm):05578                     PSHU  D
DE90 BDE965           (    forth6809.asm):05579                     JSR   TYPEW
DE93 CCFFFE           (    forth6809.asm):05580                     LDD   #-2               ; -2
DE96 3606             (    forth6809.asm):05581                     PSHU  D
DE98 7ED970           (    forth6809.asm):05582                     JMP   THROWW
                      (    forth6809.asm):05583         

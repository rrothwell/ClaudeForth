D0D9 ED84             (    forth6809.asm):03010                     STD   ,X                ; and the new head of the CURRENT wordlist
D0DB 3261             (    forth6809.asm):03011                     LEAS  1,S
D0DD 39               (    forth6809.asm):03012                     RTS
D0DE CCFFF0           (    forth6809.asm):03013         HDZERO:     LDD   #-16              ; attempt to use zero-length string as a name
D0E1 2003             (    forth6809.asm):03014                     BRA   HDTHROW
D0E3 CCFFED           (    forth6809.asm):03015         HDLONG:     LDD   #-19              ; definition name too long (flags need bits 5-7)
D0E6 3606             (    forth6809.asm):03016         HDTHROW:    PSHU  D
D0E8 7ED941           (    forth6809.asm):03017                     JMP   THROWW
                      (    forth6809.asm):03018         
                      (    forth6809.asm):03019         ; ------------------------------------------------------------
                      (    forth6809.asm):03020         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03021         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03022         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03023         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03024         ; SMUDGE   ( -- )
                      (    forth6809.asm):03025         ;    Inputs:
                      (    forth6809.asm):03026         ;        none
                      (    forth6809.asm):03027         ;    Outputs:
                      (    forth6809.asm):03028         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03029         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03030         ; ------------------------------------------------------------
D0EB 9E04             (    forth6809.asm):03031         SMUDGEW:    LDX   LATEST
D0ED A684             (    forth6809.asm):03032                     LDA   ,X
D0EF 8840             (    forth6809.asm):03033                     EORA  #$40
D0F1 A784             (    forth6809.asm):03034                     STA   ,X
D0F3 39               (    forth6809.asm):03035                     RTS
                      (    forth6809.asm):03036         
                      (    forth6809.asm):03037         ; ============================================================
                      (    forth6809.asm):03038         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03039         ; ============================================================
                      (    forth6809.asm):03040         ; ------------------------------------------------------------
                      (    forth6809.asm):03041         ; :  ( "name" -- )
                      (    forth6809.asm):03042         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03043         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03044         ; CSP and enter compile state.
                      (    forth6809.asm):03045         ; ------------------------------------------------------------
D0F4 CCFFFF           (    forth6809.asm):03046         COLONW:     LDD   #TRUEV
D0F7 3606             (    forth6809.asm):03047                     PSHU  D
D0F9 BDD09D           (    forth6809.asm):03048                     JSR   HEADER
D0FC DC08             (    forth6809.asm):03049                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D0FE DD1F             (    forth6809.asm):03050                     STD   CURXT             ; See bugfix: COLONW.1
D100 1F30             (    forth6809.asm):03051                     TFR   U,D
D102 DD21             (    forth6809.asm):03052                     STD   CSP
D104 CCFFFF           (    forth6809.asm):03053                     LDD   #-1
D107 DD00             (    forth6809.asm):03054                     STD   STATE
D109 39               (    forth6809.asm):03055                     RTS
                      (    forth6809.asm):03056         
                      (    forth6809.asm):03057         ; ------------------------------------------------------------
                      (    forth6809.asm):03058         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03059         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03060         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03061         ; new word and return to interpret state.
                      (    forth6809.asm):03062         ; ------------------------------------------------------------
D10A CC0039           (    forth6809.asm):03063         SEMIW:      LDD   #RTSOPC
D10D 3606             (    forth6809.asm):03064                     PSHU  D
D10F BDD057           (    forth6809.asm):03065                     JSR   CCOMMA1
D112 1F30             (    forth6809.asm):03066                     TFR   U,D
D114 109321           (    forth6809.asm):03067                     CMPD  CSP
D117 2703             (    forth6809.asm):03068                     BEQ   SEMIOK
D119 BDD90C           (    forth6809.asm):03069                     JSR   CFERR
D11C 9E04             (    forth6809.asm):03070         SEMIOK:     LDX   LATEST
D11E A684             (    forth6809.asm):03071                     LDA   ,X
D120 84BF             (    forth6809.asm):03072                     ANDA  #$BF
D122 A784             (    forth6809.asm):03073                     STA   ,X
D124 CC0000           (    forth6809.asm):03074                     LDD   #0
D127 DD00             (    forth6809.asm):03075                     STD   STATE
D129 39               (    forth6809.asm):03076                     RTS
                      (    forth6809.asm):03077         
                      (    forth6809.asm):03078         ; ------------------------------------------------------------
                      (    forth6809.asm):03079         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03080         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03081         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03082         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03083         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03084         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03085         ; ------------------------------------------------------------
D12A DC08             (    forth6809.asm):03086         NONAMEW:    LDD   CODEHERE
D12C 3606             (    forth6809.asm):03087                     PSHU  D                 ; xt
D12E DD1F             (    forth6809.asm):03088                     STD   CURXT             ; See bugfix: NONAMEW.1
D130 1F30             (    forth6809.asm):03089                     TFR   U,D
D132 DD21             (    forth6809.asm):03090                     STD   CSP
D134 CCFFFF           (    forth6809.asm):03091                     LDD   #-1
D137 DD00             (    forth6809.asm):03092                     STD   STATE
D139 39               (    forth6809.asm):03093                     RTS
                      (    forth6809.asm):03094         
                      (    forth6809.asm):03095         ; ------------------------------------------------------------
                      (    forth6809.asm):03096         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03097         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03098         ; BLDDOES
                      (    forth6809.asm):03099         ;    Inputs:
                      (    forth6809.asm):03100         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03101         ;    Outputs:
                      (    forth6809.asm):03102         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03103         ;    Registers: all changed.
                      (    forth6809.asm):03104         ; BLDSELF
                      (    forth6809.asm):03105         ;    Inputs:
                      (    forth6809.asm):03106         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03107         ;    Outputs:
                      (    forth6809.asm):03108         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03109         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03110         ;    Registers: all changed.
                      (    forth6809.asm):03111         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03112         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03113         ; ------------------------------------------------------------
D13A 3406             (    forth6809.asm):03114         BLDDOES:    PSHS  D                 ; behaviour address
D13C CC0000           (    forth6809.asm):03115                     LDD   #0
D13F 3606             (    forth6809.asm):03116                     PSHU  D
D141 BDD09D           (    forth6809.asm):03117                     JSR   HEADER
D144 CCCFCD           (    forth6809.asm):03118                     LDD   #DODOES
D147 3606             (    forth6809.asm):03119                     PSHU  D
D149 BDDD7C           (    forth6809.asm):03120                     JSR   CCALL
D14C 3506             (    forth6809.asm):03121                     PULS  D
D14E 3606             (    forth6809.asm):03122                     PSHU  D                 ; behaviour address
D150 BDD04B           (    forth6809.asm):03123                     JSR   CODECOMMA
D153 39               (    forth6809.asm):03124                     RTS
                      (    forth6809.asm):03125         
D154 BDD13A           (    forth6809.asm):03126         BLDSELF:    JSR   BLDDOES
D157 DC08             (    forth6809.asm):03127                     LDD   CODEHERE          ; PFA = the cell after this one
D159 C30002           (    forth6809.asm):03128                     ADDD  #2                ; See bugfix: CONSTANTW.1
D15C 3606             (    forth6809.asm):03129                     PSHU  D
D15E BDD04B           (    forth6809.asm):03130                     JSR   CODECOMMA
D161 39               (    forth6809.asm):03131                     RTS
                      (    forth6809.asm):03132         
                      (    forth6809.asm):03133         ; ------------------------------------------------------------
                      (    forth6809.asm):03134         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03135         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03136         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03137         ; address in the code area, on the stack.
                      (    forth6809.asm):03138         ; ------------------------------------------------------------
D162 CCCFD8           (    forth6809.asm):03139         CREATEW:    LDD   #DOESRT0
D165 BDD154           (    forth6809.asm):03140                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D168 39               (    forth6809.asm):03141                     RTS
                      (    forth6809.asm):03142         
                      (    forth6809.asm):03143         ; ------------------------------------------------------------
                      (    forth6809.asm):03144         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03145         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03146         ; of the word being defined.
                      (    forth6809.asm):03147         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03148         ; ------------------------------------------------------------
D169 CCCFD9           (    forth6809.asm):03149         DOESGTW:    LDD   #SETDOES
D16C 3606             (    forth6809.asm):03150                     PSHU  D
D16E BDDD7C           (    forth6809.asm):03151                     JSR   CCALL
D171 39               (    forth6809.asm):03152                     RTS
                      (    forth6809.asm):03153         
                      (    forth6809.asm):03154         ; ------------------------------------------------------------
                      (    forth6809.asm):03155         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03156         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03157         ; area, initialised to zero.
                      (    forth6809.asm):03158         ; ------------------------------------------------------------
D172 CC0000           (    forth6809.asm):03159         VARIABLEW:  LDD   #0
D175 3606             (    forth6809.asm):03160                     PSHU  D
D177 BDD09D           (    forth6809.asm):03161                     JSR   HEADER
D17A CCCFCD           (    forth6809.asm):03162                     LDD   #DODOES
D17D 3606             (    forth6809.asm):03163                     PSHU  D
D17F BDDD7C           (    forth6809.asm):03164                     JSR   CCALL
D182 CCCFD8           (    forth6809.asm):03165                     LDD   #DOESRT0
D185 3606             (    forth6809.asm):03166                     PSHU  D
D187 BDD04B           (    forth6809.asm):03167                     JSR   CODECOMMA
D18A DC0A             (    forth6809.asm):03168                     LDD   VARHERE
D18C 3606             (    forth6809.asm):03169                     PSHU  D
D18E BDD04B           (    forth6809.asm):03170                     JSR   CODECOMMA

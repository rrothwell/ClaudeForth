CF34 2008             (    forth6809.asm):02524                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02525         
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
                      (    forth6809.asm):02527         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02528         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
CF36 CCFFFF           (    forth6809.asm):02530         ABORTW:     LDD   #-1
CF39 3606             (    forth6809.asm):02531                     PSHU  D                 ; throw code (-1)
CF3B 7ED970           (    forth6809.asm):02532                     JMP   THROWW
                      (    forth6809.asm):02533         
                      (    forth6809.asm):02534         ; ------------------------------------------------------------
                      (    forth6809.asm):02535         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02536         ; ABORT
                      (    forth6809.asm):02537         ;    Inputs:
                      (    forth6809.asm):02538         ;        none
                      (    forth6809.asm):02539         ;    Outputs:
                      (    forth6809.asm):02540         ;        none (does not return)
                      (    forth6809.asm):02541         ;    Registers: RegU changed.
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
CF3E CEBD00           (    forth6809.asm):02543         ABORT:      LDU   #SP0
                      (    forth6809.asm):02544                     ; falls through into QUIT
                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546         ; ------------------------------------------------------------
                      (    forth6809.asm):02547         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02548         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02549         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02550         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02551         ; ------------------------------------------------------------
CF41 10CEC000         (    forth6809.asm):02552         QUITW:      LDS   #RP0
CF45 CC0000           (    forth6809.asm):02553                     LDD   #0
CF48 DD00             (    forth6809.asm):02554                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02555         
CF4A BDD91B           (    forth6809.asm):02556         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02557         
CF4D DC06             (    forth6809.asm):02558                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
CF4F 3406             (    forth6809.asm):02559                     PSHS  D                 ; and THROW restore S, so the frame is
CF51 DC08             (    forth6809.asm):02560                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
CF53 3406             (    forth6809.asm):02561                     PSHS  D                 ; See shadow QLOOP.2
CF55 DC0A             (    forth6809.asm):02562                     LDD   VARHERE
CF57 3406             (    forth6809.asm):02563                     PSHS  D
CF59 DC04             (    forth6809.asm):02564                     LDD   LATEST
CF5B 3406             (    forth6809.asm):02565                     PSHS  D
                      (    forth6809.asm):02566         
CF5D CCD3A3           (    forth6809.asm):02567                     LDD   #INTERPRET
CF60 3606             (    forth6809.asm):02568                     PSHU  D                 ; xt
CF62 BDD944           (    forth6809.asm):02569                     JSR   CATCHW
CF65 3706             (    forth6809.asm):02570                     PULU  D                 ; throw code (0 = no error)
CF67 3406             (    forth6809.asm):02571                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
CF69 10830000         (    forth6809.asm):02572                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
CF6D 2743             (    forth6809.asm):02573                     BEQ   QOK
                      (    forth6809.asm):02574         
CF6F EC68             (    forth6809.asm):02575                     LDD   8,S
CF71 DD06             (    forth6809.asm):02576                     STD   DPHERE
CF73 BDD59A           (    forth6809.asm):02577                     JSR   PRUNE             ; unlink headers newer than DPHERE
CF76 EC66             (    forth6809.asm):02578                     LDD   6,S
CF78 DD08             (    forth6809.asm):02579                     STD   CODEHERE
CF7A EC64             (    forth6809.asm):02580                     LDD   4,S
CF7C DD0A             (    forth6809.asm):02581                     STD   VARHERE
CF7E EC62             (    forth6809.asm):02582                     LDD   2,S
CF80 DD04             (    forth6809.asm):02583                     STD   LATEST
CF82 CEBD00           (    forth6809.asm):02584                     LDU   #SP0
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02587                     ; See bugfix: QLOOP.1
CF85 CC0000           (    forth6809.asm):02588                     LDD   #0
CF88 DD00             (    forth6809.asm):02589                     STD   STATE
                      (    forth6809.asm):02590         
CF8A ECE4             (    forth6809.asm):02591                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
CF8C 1083FFFF         (    forth6809.asm):02592                     CMPD  #-1
CF90 2605             (    forth6809.asm):02593                     BNE   QSHOWERR

EA22 ED46             (    forth6809.asm):05473                     STD   6,U
EA24 EC40             (    forth6809.asm):05474                     LDD   0,U
EA26 ED44             (    forth6809.asm):05475                     STD   4,U
EA28 10AFC4           (    forth6809.asm):05476                     STY   ,U
EA2B AF42             (    forth6809.asm):05477                     STX   2,U
EA2D 39               (    forth6809.asm):05478                     RTS
                      (    forth6809.asm):05479         
                      (    forth6809.asm):05480         ; ------------------------------------------------------------
                      (    forth6809.asm):05481         ; >R  ( x -- )  ( R: -- x )
                      (    forth6809.asm):05482         ; Move x from the data stack to the return stack. The return address
                      (    forth6809.asm):05483         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05484         ; the transfer.
                      (    forth6809.asm):05485         ; ------------------------------------------------------------
EA2E 3706             (    forth6809.asm):05486         TORW:       PULU  D                 ; x
EA30 3510             (    forth6809.asm):05487                     PULS  X
EA32 3406             (    forth6809.asm):05488                     PSHS  D
EA34 3410             (    forth6809.asm):05489                     PSHS  X
EA36 39               (    forth6809.asm):05490                     RTS
                      (    forth6809.asm):05491         
                      (    forth6809.asm):05492         ; ------------------------------------------------------------
                      (    forth6809.asm):05493         ; R>  ( -- x )  ( R: x -- )
                      (    forth6809.asm):05494         ; Move x from the return stack to the data stack. The return address
                      (    forth6809.asm):05495         ; of this call is on top of S, so it is lifted off and put back around
                      (    forth6809.asm):05496         ; the transfer.
                      (    forth6809.asm):05497         ; ------------------------------------------------------------
EA37 3510             (    forth6809.asm):05498         FROMRW:     PULS  X
EA39 3506             (    forth6809.asm):05499                     PULS  D                 ; x
EA3B 3410             (    forth6809.asm):05500                     PSHS  X
EA3D 3606             (    forth6809.asm):05501                     PSHU  D
EA3F 39               (    forth6809.asm):05502                     RTS
                      (    forth6809.asm):05503         
                      (    forth6809.asm):05504         ; ------------------------------------------------------------
                      (    forth6809.asm):05505         ; R@  ( -- x )  ( R: x -- x )
                      (    forth6809.asm):05506         ; Copy the top of the return stack to the data stack. The return
                      (    forth6809.asm):05507         ; address of this call is on top of S, so it is lifted off and put
                      (    forth6809.asm):05508         ; back around the transfer.
                      (    forth6809.asm):05509         ; ------------------------------------------------------------
EA40 3510             (    forth6809.asm):05510         RFETCHW:    PULS  X
EA42 ECE4             (    forth6809.asm):05511                     LDD   ,S                ; x
EA44 3410             (    forth6809.asm):05512                     PSHS  X
EA46 3606             (    forth6809.asm):05513                     PSHU  D
EA48 39               (    forth6809.asm):05514                     RTS
                      (    forth6809.asm):05515         
                      (    forth6809.asm):05516         ; ------------------------------------------------------------
                      (    forth6809.asm):05517         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05518         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05519         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05520         ; put back around the transfer.
                      (    forth6809.asm):05521         ; ------------------------------------------------------------
EA49 3510             (    forth6809.asm):05522         TWOTORW:    PULS  X                 ; return address
EA4B 3706             (    forth6809.asm):05523                     PULU  D                 ; x2
EA4D 3720             (    forth6809.asm):05524                     PULU  Y                 ; x1
EA4F 3420             (    forth6809.asm):05525                     PSHS  Y
EA51 3406             (    forth6809.asm):05526                     PSHS  D
EA53 3410             (    forth6809.asm):05527                     PSHS  X
EA55 39               (    forth6809.asm):05528                     RTS
                      (    forth6809.asm):05529         
                      (    forth6809.asm):05530         ; ------------------------------------------------------------
                      (    forth6809.asm):05531         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05532         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05533         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05534         ; put back around the transfer.
                      (    forth6809.asm):05535         ; ------------------------------------------------------------
EA56 3510             (    forth6809.asm):05536         TWOFROMRW:  PULS  X                 ; return address
EA58 3506             (    forth6809.asm):05537                     PULS  D                 ; x2
EA5A 3520             (    forth6809.asm):05538                     PULS  Y                 ; x1
EA5C 3410             (    forth6809.asm):05539                     PSHS  X
EA5E 3620             (    forth6809.asm):05540                     PSHU  Y
EA60 3606             (    forth6809.asm):05541                     PSHU  D
EA62 39               (    forth6809.asm):05542                     RTS
                      (    forth6809.asm):05543         
                      (    forth6809.asm):05544         ; ------------------------------------------------------------
                      (    forth6809.asm):05545         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05546         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05547         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05548         ; and put back around the transfer.
                      (    forth6809.asm):05549         ; ------------------------------------------------------------
EA63 3510             (    forth6809.asm):05550         TWORFETCHW: PULS  X                 ; return address
EA65 ECE4             (    forth6809.asm):05551                     LDD   ,S                ; x2
EA67 10AE62           (    forth6809.asm):05552                     LDY   2,S               ; x1
EA6A 3410             (    forth6809.asm):05553                     PSHS  X
EA6C 3620             (    forth6809.asm):05554                     PSHU  Y
EA6E 3606             (    forth6809.asm):05555                     PSHU  D
EA70 39               (    forth6809.asm):05556                     RTS
                      (    forth6809.asm):05557         
                      (    forth6809.asm):05558         ; ============================================================
                      (    forth6809.asm):05559         ; SECTION 15: ARITHMETIC (single + double + mixed precision)
                      (    forth6809.asm):05560         ; ============================================================
                      (    forth6809.asm):05561         ; ------------------------------------------------------------
                      (    forth6809.asm):05562         ; +  ( n1 n2 -- n3 )
                      (    forth6809.asm):05563         ; Add n2 to n1.

                      (    forth6809.asm):02039         ; ------------------------------------------------------------
                      (    forth6809.asm):02040         ; Reset the serial ring buffers, flow-control state and
                      (    forth6809.asm):02041         ; receiver-error counters to zero.
                      (    forth6809.asm):02042         ; SERBUFCLR
                      (    forth6809.asm):02043         ;    Inputs:
                      (    forth6809.asm):02044         ;        none
                      (    forth6809.asm):02045         ;    Outputs:
                      (    forth6809.asm):02046         ;        INHEAD, INTAIL, OUTHEAD, OUTTAIL, RTSSTATE, OUTACTIVITY,
                      (    forth6809.asm):02047         ;        FECOUNT, OVRNCOUNT, PECOUNT and POLLREADYCNT all cleared
                      (    forth6809.asm):02048         ;    Registers: only CC changed.
                      (    forth6809.asm):02049         ; Original comment: shadow SERBUFCLR.0.
                      (    forth6809.asm):02050         ; See bugfix: SERBUFCLR.1.
                      (    forth6809.asm):02051         ; ------------------------------------------------------------
                      (    forth6809.asm):02052         
CE80 7F0176           (    forth6809.asm):02053         SERBUFCLR:  CLR   INHEAD
CE83 7F0177           (    forth6809.asm):02054                     CLR   INTAIL
CE86 7F0178           (    forth6809.asm):02055                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
CE89 7F0179           (    forth6809.asm):02056                     CLR   OUTHEAD
CE8C 7F017A           (    forth6809.asm):02057                     CLR   OUTTAIL
CE8F 7F017B           (    forth6809.asm):02058                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):02059         
                      (    forth6809.asm):02060         
CE92 7F017C           (    forth6809.asm):02061                     CLR   FECOUNT
CE95 7F017D           (    forth6809.asm):02062                     CLR   OVRNCOUNT
CE98 7F017E           (    forth6809.asm):02063                     CLR   PECOUNT
CE9B 7F017F           (    forth6809.asm):02064                     CLR   POLLREADYCNT
CE9E 39               (    forth6809.asm):02065                     RTS
                      (    forth6809.asm):02066         
                      (    forth6809.asm):02067         ; ------------------------------------------------------------
                      (    forth6809.asm):02068         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):02069         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):02070         ; INITSERIAL
                      (    forth6809.asm):02071         ;    Inputs:
                      (    forth6809.asm):02072         ;        none
                      (    forth6809.asm):02073         ;    Outputs:
                      (    forth6809.asm):02074         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):02075         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02076         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):02077         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):02078         ; ------------------------------------------------------------
CE9F BDCE80           (    forth6809.asm):02079         INITSERIAL: JSR   SERBUFCLR
CEA2 8603             (    forth6809.asm):02080                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
CEA4 B7C008           (    forth6809.asm):02081                     STA   ACIACR
CEA7 12               (    forth6809.asm):02082                     NOP                     ; Settling Delay
CEA8 12               (    forth6809.asm):02083                     NOP
                      (    forth6809.asm):02084         
                      (    forth6809.asm):02085                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02086                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02087                     ELSE                    ; <<<<<>>>>>
CEA9 8615             (    forth6809.asm):02088                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02089                     ENDC                    ; <<<<<<<<<<
CEAB B7C008           (    forth6809.asm):02090                     STA   ACIACR            ; See bugfix: INITSERIAL.1
CEAE 39               (    forth6809.asm):02091                     RTS
                      (    forth6809.asm):02092         
                      (    forth6809.asm):02093                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02094         ; ------------------------------------------------------------
                      (    forth6809.asm):02095         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02096         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02097         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02098         ; INFILL
                      (    forth6809.asm):02099         ;    Inputs:
                      (    forth6809.asm):02100         ;        none
                      (    forth6809.asm):02101         ;    Outputs:
                      (    forth6809.asm):02102         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02103         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02104         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02105         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02106                     SUBA  INTAIL
                      (    forth6809.asm):02107                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):02108                     RTS
                      (    forth6809.asm):02109         ; ------------------------------------------------------------
                      (    forth6809.asm):02110         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02111         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02112         ; receive path with interrupts already masked.
                      (    forth6809.asm):02113         ; RTSCHECKHI
                      (    forth6809.asm):02114         ;    Inputs:
                      (    forth6809.asm):02115         ;        none
                      (    forth6809.asm):02116         ;    Outputs:
                      (    forth6809.asm):02117         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02118         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02119         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02120         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):02121                     CMPA  #INHIWATER
                      (    forth6809.asm):02122                     BLO   RTSCHIDONE
                      (    forth6809.asm):02123                     TST   RTSSTATE
                      (    forth6809.asm):02124                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):02125                     LDA   #CR_RTSHI
                      (    forth6809.asm):02126                     STA   ACIACR
                      (    forth6809.asm):02127                     LDA   #1
                      (    forth6809.asm):02128                     STA   RTSSTATE
CEAF                  (    forth6809.asm):02129         RTSCHIDONE: RTS
                      (    forth6809.asm):02130         ; ------------------------------------------------------------
                      (    forth6809.asm):02131         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02132         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02133         ; enables it only while output is pending.
                      (    forth6809.asm):02134         ; UPDATE_RTS
                      (    forth6809.asm):02135         ;    Inputs:
                      (    forth6809.asm):02136         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02137         ;    Outputs:
                      (    forth6809.asm):02138         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02139         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02140         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02141         UPDATE_RTS:
                      (    forth6809.asm):02142                     TST   RTSSTATE
                      (    forth6809.asm):02143                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02144         
                      (    forth6809.asm):02145                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02146                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02147         
                      (    forth6809.asm):02148                                             ; $B5/%1011_0101
                      (    forth6809.asm):02149                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02150                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02151         
CEAF                  (    forth6809.asm):02152         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02153                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02154                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02155         
CEAF                  (    forth6809.asm):02156         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02157                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02158                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
CEAF                  (    forth6809.asm):02159         WRITE_CR:
                      (    forth6809.asm):02160                     STA   ACIACR
                      (    forth6809.asm):02161                     RTS
                      (    forth6809.asm):02162         ; ------------------------------------------------------------
                      (    forth6809.asm):02163         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02164         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02165         ; Called after a character is added to the ring.
                      (    forth6809.asm):02166         ; CHKHI
                      (    forth6809.asm):02167         ;    Inputs:
                      (    forth6809.asm):02168         ;        RegB = input ring fill level
                      (    forth6809.asm):02169         ;    Outputs:
                      (    forth6809.asm):02170         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02171         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02172         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02173         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02174         CHKHI:
                      (    forth6809.asm):02175                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02176                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02177                     TST   RTSSTATE
                      (    forth6809.asm):02178                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02179                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02180                     STA   RTSSTATE
                      (    forth6809.asm):02181                     JSR   UPDATE_RTS
CEAF                  (    forth6809.asm):02182         CHKHIDONE:  RTS
                      (    forth6809.asm):02183         
                      (    forth6809.asm):02184         ; ------------------------------------------------------------
                      (    forth6809.asm):02185         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02186         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02187         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02188         ; CHKLO
                      (    forth6809.asm):02189         ;    Inputs:
                      (    forth6809.asm):02190         ;        RegB = input ring fill level
                      (    forth6809.asm):02191         ;    Outputs:
                      (    forth6809.asm):02192         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02193         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02194         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02195         CHKLO:
                      (    forth6809.asm):02196                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02197                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02198                     TST   RTSSTATE
                      (    forth6809.asm):02199                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02200                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02201                     STA   RTSSTATE
                      (    forth6809.asm):02202                     JSR   UPDATE_RTS
CEAF                  (    forth6809.asm):02203         CHKLODONE:  RTS
                      (    forth6809.asm):02204         ; ------------------------------------------------------------
                      (    forth6809.asm):02205         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02206         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02207         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02208         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02209         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02210         ;    Inputs:
                      (    forth6809.asm):02211         ;        none
                      (    forth6809.asm):02212         ;    Outputs:
                      (    forth6809.asm):02213         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02214         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02215         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02216         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02217         FLUSHOUTBUFFER:
                      (    forth6809.asm):02218                     LDB   OUTTAIL
                      (    forth6809.asm):02219                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02220                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02221         
                      (    forth6809.asm):02222                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02223                     BITA  #SR_CTS
                      (    forth6809.asm):02224                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02225         
                      (    forth6809.asm):02226                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02227                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02228                                             ; than spin-wait here.
                      (    forth6809.asm):02229         
                      (    forth6809.asm):02230                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02231                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02232                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02233         
                      (    forth6809.asm):02234                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02235                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02236                     STB   OUTTAIL
                      (    forth6809.asm):02237                                             ; One character sent - return rather than
                      (    forth6809.asm):02238                                             ; loop back for more (see header comment).
CEAF                  (    forth6809.asm):02239         FLUSHED:
                      (    forth6809.asm):02240                     RTS
                      (    forth6809.asm):02241         ; ------------------------------------------------------------
                      (    forth6809.asm):02242         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02243         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02244         ; PUTCHAR
                      (    forth6809.asm):02245         ;    Inputs:
                      (    forth6809.asm):02246         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02247         ;    Outputs:
                      (    forth6809.asm):02248         ;        none
                      (    forth6809.asm):02249         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02250         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02251         PUTCHAR:
                      (    forth6809.asm):02252                     PSHS  CC,X
                      (    forth6809.asm):02253                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02254         
                      (    forth6809.asm):02255                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02256                     INCB
                      (    forth6809.asm):02257                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02258                     CMPB  OUTTAIL
                      (    forth6809.asm):02259                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02260         
                      (    forth6809.asm):02261                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02262                     LDB   OUTHEAD
                      (    forth6809.asm):02263                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02264         
                      (    forth6809.asm):02265                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02266                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02267                     STB   OUTHEAD
                      (    forth6809.asm):02268         
                      (    forth6809.asm):02269                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02270                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02271         
                      (    forth6809.asm):02272                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02273                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02274                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02275                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02276                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02277                                             ; expects the critical section active
                      (    forth6809.asm):02278         
                      (    forth6809.asm):02279                     BRA   PUT_EXIT
                      (    forth6809.asm):02280         
                      (    forth6809.asm):02281         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02282         ; priming the pump by transmitting a character.
CEAF                  (    forth6809.asm):02283         CHK_INT_PATH:
                      (    forth6809.asm):02284                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02285                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287                                             ; No! Restart.
                      (    forth6809.asm):02288                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02289                     LDB   OUTTAIL
                      (    forth6809.asm):02290                     LDA   B,X
                      (    forth6809.asm):02291                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02292         
                      (    forth6809.asm):02293                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02294                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02295                     STB   OUTTAIL
                      (    forth6809.asm):02296         
                      (    forth6809.asm):02297                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02298                     STA   OUTACTIVITY
                      (    forth6809.asm):02299                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02300         
CEAF                  (    forth6809.asm):02301         PUT_EXIT:
                      (    forth6809.asm):02302                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02303                                             ; by restoring the CC.
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
                      (    forth6809.asm):02305         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02306         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02307         ; GETCHAR
                      (    forth6809.asm):02308         ;    Inputs:
                      (    forth6809.asm):02309         ;        none
                      (    forth6809.asm):02310         ;    Outputs:
                      (    forth6809.asm):02311         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02312         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02313         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02314         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02315         GETCHAR:
                      (    forth6809.asm):02316                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02317                     CMPB  INHEAD
                      (    forth6809.asm):02318                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02319         
                      (    forth6809.asm):02320                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02321                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02322         
                      (    forth6809.asm):02323                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02324                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02325                     STB   INTAIL
                      (    forth6809.asm):02326         
                      (    forth6809.asm):02327                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02328                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02329                     ORCC  #$10
                      (    forth6809.asm):02330                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02331                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02332                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02333                                             ; there's no already-loaded value here
                      (    forth6809.asm):02334                                             ; worth reusing.
                      (    forth6809.asm):02335                     JSR   CHKLO
                      (    forth6809.asm):02336                     ANDCC #$EF
                      (    forth6809.asm):02337         
                      (    forth6809.asm):02338                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02339                     RTS
                      (    forth6809.asm):02340         
CEAF                  (    forth6809.asm):02341         GET_NO_CHAR:
                      (    forth6809.asm):02342                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02343                     RTS
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02346         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02347         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02348         ; RTSCHECKLO
                      (    forth6809.asm):02349         ;    Inputs:
                      (    forth6809.asm):02350         ;        none
                      (    forth6809.asm):02351         ;    Outputs:
                      (    forth6809.asm):02352         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02353         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02354         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02355         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02356         RTSCHECKLO:
                      (    forth6809.asm):02357                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02358         
                      (    forth6809.asm):02359                     JSR   INFILL
                      (    forth6809.asm):02360                     CMPA  #INLOWATER
                      (    forth6809.asm):02361                     BHI   RTSCLODONE
                      (    forth6809.asm):02362                     TST   RTSSTATE
                      (    forth6809.asm):02363                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02364         
                      (    forth6809.asm):02365         
                      (    forth6809.asm):02366                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02367         
                      (    forth6809.asm):02368                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02369                     CMPB  OUTHEAD
                      (    forth6809.asm):02370                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02371         
                      (    forth6809.asm):02372                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02373                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02374                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02375         
CEAF                  (    forth6809.asm):02376         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02377                     STA   ACIACR
                      (    forth6809.asm):02378         
CEAF                  (    forth6809.asm):02379         RTSCLOUNMASK:
                      (    forth6809.asm):02380                     ANDCC #$EF
                      (    forth6809.asm):02381         
CEAF                  (    forth6809.asm):02382         RTSCLODONE: RTS
                      (    forth6809.asm):02383         
                      (    forth6809.asm):02384         ; ------------------------------------------------------------
                      (    forth6809.asm):02385         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02386         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02387         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02388         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02389         ; IRQH
                      (    forth6809.asm):02390         ;    Inputs:
                      (    forth6809.asm):02391         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02392         ;    Outputs:
                      (    forth6809.asm):02393         ;        none (returns with RTI)
                      (    forth6809.asm):02394         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02395         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02396         ; ------------------------------------------------------------
CEAF                  (    forth6809.asm):02397         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02398         
                      (    forth6809.asm):02399                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02400                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02401                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02402                     BNE   INCHAR
                      (    forth6809.asm):02403                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02404                     BNE   OUTCHAR
                      (    forth6809.asm):02405                                             ; Ignore all other interrupts such as DCD change.
CEAF                  (    forth6809.asm):02406         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02407                                             ; & restores state.
                      (    forth6809.asm):02408         
CEAF                  (    forth6809.asm):02409         INCHAR:
                      (    forth6809.asm):02410                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02411                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02412                                             ; Any receiver error flagged?
                      (    forth6809.asm):02413                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02414         
                      (    forth6809.asm):02415                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02416                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02417                     INC   FECOUNT           ; more than one bit can be set at once.
CEAF                  (    forth6809.asm):02418         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02419                     BEQ   INXOVRN
                      (    forth6809.asm):02420                     INC   OVRNCOUNT
CEAF                  (    forth6809.asm):02421         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02422                     BEQ   INXPE
                      (    forth6809.asm):02423                     INC   PECOUNT
CEAF                  (    forth6809.asm):02424         INXPE:      RTI
                      (    forth6809.asm):02425         
CEAF                  (    forth6809.asm):02426         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02427                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02428                     LDB   INHEAD
                      (    forth6809.asm):02429                     STA   B,X
                      (    forth6809.asm):02430                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02431                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02432                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02433                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02434                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02435                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02436                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02437                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02438                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02439                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02440                     JSR   CHKHI             ; Protect the in buffer from overflow.
CEAF                  (    forth6809.asm):02441         IRQDONE1:   RTI
                      (    forth6809.asm):02442         
                      (    forth6809.asm):02443                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02444         
CEAF                  (    forth6809.asm):02445         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02446                     CMPB  OUTHEAD
                      (    forth6809.asm):02447                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02448         
                      (    forth6809.asm):02449                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02450                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02451                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02452         
                      (    forth6809.asm):02453                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02454                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02455                     STB   OUTTAIL
CEAF                  (    forth6809.asm):02456         IRQDONE2    RTI
                      (    forth6809.asm):02457         
CEAF                  (    forth6809.asm):02458         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02459                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02460                     CLR   OUTACTIVITY
                      (    forth6809.asm):02461                     JSR   UPDATE_RTS
CEAF                  (    forth6809.asm):02462         IRQDONE3    RTI
                      (    forth6809.asm):02463         
                      (    forth6809.asm):02464                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02465         
CEAF 3B               (    forth6809.asm):02466         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02467                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02468                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02469                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02470                                             ; the other unused vectors below
                      (    forth6809.asm):02471                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02472         
                      (    forth6809.asm):02473         ; ------------------------------------------------------------
                      (    forth6809.asm):02474         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02475         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02476         ; ------------------------------------------------------------
CEB0 3B               (    forth6809.asm):02477         SWI3H:      RTI
CEB1 3B               (    forth6809.asm):02478         SWI2H:      RTI
CEB2 3B               (    forth6809.asm):02479         FIRQH:      RTI
CEB3 3B               (    forth6809.asm):02480         NMIH:       RTI                     ; unused now that NMI -> WARM
CEB4 CCFF9D           (    forth6809.asm):02481         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
CEB7 3606             (    forth6809.asm):02482                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
CEB9 7ED941           (    forth6809.asm):02483                     JMP   THROWW
                      (    forth6809.asm):02484         
                      (    forth6809.asm):02485         ; ============================================================
                      (    forth6809.asm):02486         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02487         ; ============================================================
                      (    forth6809.asm):02488         ; ------------------------------------------------------------
                      (    forth6809.asm):02489         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02490         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02491         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02492         ; COLD
                      (    forth6809.asm):02493         ;    Inputs:
                      (    forth6809.asm):02494         ;        none (entered at reset)
                      (    forth6809.asm):02495         ;    Outputs:
                      (    forth6809.asm):02496         ;        none (does not return)
                      (    forth6809.asm):02497         ;    Registers: all changed.
                      (    forth6809.asm):02498         ; ------------------------------------------------------------
CEBC CC0240           (    forth6809.asm):02499         COLD:       LDD   #APPVARS
CEBF DD0A             (    forth6809.asm):02500                     STD   VARHERE
CEC1 CC7000           (    forth6809.asm):02501                     LDD   #APPCODE
CEC4 DD08             (    forth6809.asm):02502                     STD   CODEHERE
CEC6 CC2000           (    forth6809.asm):02503                     LDD   #APPDICT
CEC9 DD06             (    forth6809.asm):02504                     STD   DPHERE
CECB CCCE7A           (    forth6809.asm):02505                     LDD   #BASELATEST
CECE DD04             (    forth6809.asm):02506                     STD   LATEST
CED0 BDD54A           (    forth6809.asm):02507                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02508         
CED3 CC000A           (    forth6809.asm):02509                     LDD   #10
CED6 DD02             (    forth6809.asm):02510                     STD   BASE
                      (    forth6809.asm):02511         
CED8 CC0106           (    forth6809.asm):02512                     LDD   #TIBBUF
CEDB DD39             (    forth6809.asm):02513                     STD   SRCADDR
CEDD CC0000           (    forth6809.asm):02514                     LDD   #0
CEE0 DD3B             (    forth6809.asm):02515                     STD   SRCLEN
CEE2 DD3D             (    forth6809.asm):02516                     STD   SRCID
                      (    forth6809.asm):02517         
CEE4 8ECF8A           (    forth6809.asm):02518                     LDX   #SIGNON
CEE7 3610             (    forth6809.asm):02519                     PSHU  X                 ; c-addr
CEE9 CC000F           (    forth6809.asm):02520                     LDD   #SIGNONL
CEEC 3606             (    forth6809.asm):02521                     PSHU  D                 ; u
CEEE BDE936           (    forth6809.asm):02522                     JSR   TYPEW
CEF1 BDEF5F           (    forth6809.asm):02523                     JSR   CRW
CEF4 2008             (    forth6809.asm):02524                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02525         
                      (    forth6809.asm):02526         ; ------------------------------------------------------------
                      (    forth6809.asm):02527         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02528         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02529         ; ------------------------------------------------------------
CEF6 CCFFFF           (    forth6809.asm):02530         ABORTW:     LDD   #-1
CEF9 3606             (    forth6809.asm):02531                     PSHU  D                 ; throw code (-1)
CEFB 7ED941           (    forth6809.asm):02532                     JMP   THROWW
                      (    forth6809.asm):02533         
                      (    forth6809.asm):02534         ; ------------------------------------------------------------
                      (    forth6809.asm):02535         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02536         ; ABORT
                      (    forth6809.asm):02537         ;    Inputs:
                      (    forth6809.asm):02538         ;        none
                      (    forth6809.asm):02539         ;    Outputs:
                      (    forth6809.asm):02540         ;        none (does not return)
                      (    forth6809.asm):02541         ;    Registers: RegU changed.
                      (    forth6809.asm):02542         ; ------------------------------------------------------------
CEFE CEBD00           (    forth6809.asm):02543         ABORT:      LDU   #SP0
                      (    forth6809.asm):02544                     ; falls through into QUIT
                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546         ; ------------------------------------------------------------
                      (    forth6809.asm):02547         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02548         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02549         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02550         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02551         ; ------------------------------------------------------------
CF01 10CEC000         (    forth6809.asm):02552         QUITW:      LDS   #RP0
CF05 CC0000           (    forth6809.asm):02553                     LDD   #0
CF08 DD00             (    forth6809.asm):02554                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02555         
CF0A BDD8EC           (    forth6809.asm):02556         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02557         
CF0D DC06             (    forth6809.asm):02558                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
CF0F 3406             (    forth6809.asm):02559                     PSHS  D                 ; and THROW restore S, so the frame is
CF11 DC08             (    forth6809.asm):02560                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
CF13 3406             (    forth6809.asm):02561                     PSHS  D                 ; See shadow QLOOP.2
CF15 DC0A             (    forth6809.asm):02562                     LDD   VARHERE
CF17 3406             (    forth6809.asm):02563                     PSHS  D
CF19 DC04             (    forth6809.asm):02564                     LDD   LATEST
CF1B 3406             (    forth6809.asm):02565                     PSHS  D
                      (    forth6809.asm):02566         
CF1D CCD374           (    forth6809.asm):02567                     LDD   #INTERPRET
CF20 3606             (    forth6809.asm):02568                     PSHU  D                 ; xt
CF22 BDD915           (    forth6809.asm):02569                     JSR   CATCHW
CF25 3706             (    forth6809.asm):02570                     PULU  D                 ; throw code (0 = no error)
CF27 3406             (    forth6809.asm):02571                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
CF29 10830000         (    forth6809.asm):02572                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
CF2D 2743             (    forth6809.asm):02573                     BEQ   QOK
                      (    forth6809.asm):02574         
CF2F EC68             (    forth6809.asm):02575                     LDD   8,S
CF31 DD06             (    forth6809.asm):02576                     STD   DPHERE
CF33 BDD56B           (    forth6809.asm):02577                     JSR   PRUNE             ; unlink headers newer than DPHERE
CF36 EC66             (    forth6809.asm):02578                     LDD   6,S
CF38 DD08             (    forth6809.asm):02579                     STD   CODEHERE
CF3A EC64             (    forth6809.asm):02580                     LDD   4,S
CF3C DD0A             (    forth6809.asm):02581                     STD   VARHERE
CF3E EC62             (    forth6809.asm):02582                     LDD   2,S
CF40 DD04             (    forth6809.asm):02583                     STD   LATEST
CF42 CEBD00           (    forth6809.asm):02584                     LDU   #SP0
                      (    forth6809.asm):02585         
                      (    forth6809.asm):02586                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02587                     ; See bugfix: QLOOP.1
CF45 CC0000           (    forth6809.asm):02588                     LDD   #0
CF48 DD00             (    forth6809.asm):02589                     STD   STATE
                      (    forth6809.asm):02590         
CF4A ECE4             (    forth6809.asm):02591                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
CF4C 1083FFFF         (    forth6809.asm):02592                     CMPD  #-1
CF50 2605             (    forth6809.asm):02593                     BNE   QSHOWERR
CF52 326A             (    forth6809.asm):02594                     LEAS  10,S              ; drop the frame
CF54 16FFB3           (    forth6809.asm):02595                     LBRA  QLOOP
                      (    forth6809.asm):02596         
CF57 BDEF5F           (    forth6809.asm):02597         QSHOWERR:   JSR   CRW
CF5A 8ECF9D           (    forth6809.asm):02598                     LDX   #ERRMSG
CF5D 3610             (    forth6809.asm):02599                     PSHU  X                 ; c-addr
CF5F CC0008           (    forth6809.asm):02600                     LDD   #ERRMSGL
CF62 3606             (    forth6809.asm):02601                     PSHU  D                 ; u
CF64 BDE936           (    forth6809.asm):02602                     JSR   TYPEW
CF67 ECE4             (    forth6809.asm):02603                     LDD   ,S
CF69 3606             (    forth6809.asm):02604                     PSHU  D                 ; n
CF6B BDEE2E           (    forth6809.asm):02605                     JSR   DOTW
CF6E 326A             (    forth6809.asm):02606                     LEAS  10,S              ; drop the frame
CF70 2098             (    forth6809.asm):02607                     BRA   QLOOP
                      (    forth6809.asm):02608         
CF72 326A             (    forth6809.asm):02609         QOK:        LEAS  10,S              ; drop the frame
CF74 BDEF5F           (    forth6809.asm):02610                     JSR   CRW               ; See bugfix: QOK.1
CF77 DC00             (    forth6809.asm):02611                     LDD   STATE
CF79 268F             (    forth6809.asm):02612                     BNE   QLOOP
CF7B 8ECF99           (    forth6809.asm):02613                     LDX   #OKMSG
CF7E 3610             (    forth6809.asm):02614                     PSHU  X                 ; c-addr
CF80 CC0004           (    forth6809.asm):02615                     LDD   #OKMSGL
CF83 3606             (    forth6809.asm):02616                     PSHU  D                 ; u
CF85 BDE936           (    forth6809.asm):02617                     JSR   TYPEW
CF88 2080             (    forth6809.asm):02618                     BRA   QLOOP
                      (    forth6809.asm):02619         
CF8A 3638303920464F52 (    forth6809.asm):02620         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02621         SIGNONL     EQU   *-SIGNON
CF99 20206F6B         (    forth6809.asm):02622         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02623         OKMSGL      EQU   *-OKMSG
CF9D 20204552524F5220 (    forth6809.asm):02624         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02625         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02626         
                      (    forth6809.asm):02627         ; ============================================================
                      (    forth6809.asm):02628         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02629         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02630         ; ============================================================
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02633         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02634         ; LIT   ( -- x )
                      (    forth6809.asm):02635         ;    Inputs:
                      (    forth6809.asm):02636         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02637         ;    Outputs:
                      (    forth6809.asm):02638         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02639         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02640         ; ------------------------------------------------------------
CFA5 3510             (    forth6809.asm):02641         LIT:        PULS  X
CFA7 EC81             (    forth6809.asm):02642                     LDD   ,X++
CFA9 3606             (    forth6809.asm):02643                     PSHU  D                 ; x
CFAB 3410             (    forth6809.asm):02644                     PSHS  X
CFAD 39               (    forth6809.asm):02645                     RTS
                      (    forth6809.asm):02646         
                      (    forth6809.asm):02647         ; ------------------------------------------------------------
                      (    forth6809.asm):02648         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02649         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02650         ; address.
                      (    forth6809.asm):02651         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02652         ;    Inputs:
                      (    forth6809.asm):02653         ;        flag on the data stack
                      (    forth6809.asm):02654         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02655         ;    Outputs:
                      (    forth6809.asm):02656         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02657         ;        the offset
                      (    forth6809.asm):02658         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
CFAE 3706             (    forth6809.asm):02660         ZBRANCH:    PULU  D                 ; flag
CFB0 3510             (    forth6809.asm):02661                     PULS  X
CFB2 10830000         (    forth6809.asm):02662                     CMPD  #0
CFB6 2607             (    forth6809.asm):02663                     BNE   ZSKIP
CFB8 EC84             (    forth6809.asm):02664                     LDD   ,X
CFBA 308B             (    forth6809.asm):02665                     LEAX  D,X
CFBC 3410             (    forth6809.asm):02666                     PSHS  X
CFBE 39               (    forth6809.asm):02667                     RTS
CFBF 3002             (    forth6809.asm):02668         ZSKIP:      LEAX  2,X
CFC1 3410             (    forth6809.asm):02669                     PSHS  X
CFC3 39               (    forth6809.asm):02670                     RTS
                      (    forth6809.asm):02671         
                      (    forth6809.asm):02672         ; ------------------------------------------------------------
                      (    forth6809.asm):02673         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02674         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02675         ; BRANCH
                      (    forth6809.asm):02676         ;    Inputs:
                      (    forth6809.asm):02677         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02678         ;    Outputs:
                      (    forth6809.asm):02679         ;        return address set to the branch target
                      (    forth6809.asm):02680         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
CFC4 3510             (    forth6809.asm):02682         BRANCH:     PULS  X
CFC6 EC84             (    forth6809.asm):02683                     LDD   ,X
CFC8 308B             (    forth6809.asm):02684                     LEAX  D,X
CFCA 3410             (    forth6809.asm):02685                     PSHS  X
CFCC 39               (    forth6809.asm):02686                     RTS
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
                      (    forth6809.asm):02689         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02690         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02691         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02692         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02693         ;    Inputs:
                      (    forth6809.asm):02694         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02695         ;        trampoline
                      (    forth6809.asm):02696         ;    Outputs:
                      (    forth6809.asm):02697         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02698         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
CFCD 3510             (    forth6809.asm):02700         DODOES:     PULS  X
CFCF 10AE81           (    forth6809.asm):02701                     LDY   ,X++
CFD2 EC84             (    forth6809.asm):02702                     LDD   ,X
CFD4 3606             (    forth6809.asm):02703                     PSHU  D                 ; pfa
CFD6 6EA4             (    forth6809.asm):02704                     JMP   ,Y
                      (    forth6809.asm):02705         
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02708         ; field address on the stack.
                      (    forth6809.asm):02709         ; DOESRT0
                      (    forth6809.asm):02710         ;    Inputs:
                      (    forth6809.asm):02711         ;        none
                      (    forth6809.asm):02712         ;    Outputs:
                      (    forth6809.asm):02713         ;        none
                      (    forth6809.asm):02714         ;    Registers: none.
                      (    forth6809.asm):02715         ; ------------------------------------------------------------
CFD8 39               (    forth6809.asm):02716         DOESRT0:    RTS
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02720         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02721         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02722         ; SETDOES
                      (    forth6809.asm):02723         ;    Inputs:
                      (    forth6809.asm):02724         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02725         ;        BEHAVIOR)
                      (    forth6809.asm):02726         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02727         ;        address
                      (    forth6809.asm):02728         ;    Outputs:
                      (    forth6809.asm):02729         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02730         ;        defining word's caller
                      (    forth6809.asm):02731         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02732         ; ------------------------------------------------------------
CFD9 3510             (    forth6809.asm):02733         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
CFDB 1F12             (    forth6809.asm):02734                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02735         
CFDD 9E04             (    forth6809.asm):02736                     LDX   LATEST
CFDF E684             (    forth6809.asm):02737                     LDB   ,X
CFE1 C41F             (    forth6809.asm):02738                     ANDB  #$1F
CFE3 4F               (    forth6809.asm):02739                     CLRA
CFE4 308B             (    forth6809.asm):02740                     LEAX  D,X               ; header + name length
CFE6 EC03             (    forth6809.asm):02741                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
CFE8 C30003           (    forth6809.asm):02742                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
CFEB 1F01             (    forth6809.asm):02743                     TFR   D,X
                      (    forth6809.asm):02744         
CFED 10AF84           (    forth6809.asm):02745                     STY   ,X                ; patch it
                      (    forth6809.asm):02746         
CFF0 3510             (    forth6809.asm):02747                     PULS  X                 ; X = the OUTER defining word's own return addr
CFF2 6E84             (    forth6809.asm):02748                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02752         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02753         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02754         ;    Inputs:
                      (    forth6809.asm):02755         ;        pfa on the data stack
                      (    forth6809.asm):02756         ;    Outputs:
                      (    forth6809.asm):02757         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02758         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02759         ; ------------------------------------------------------------
CFF4 3710             (    forth6809.asm):02760         DODEFER:    PULU  X                 ; pfa
CFF6 EC84             (    forth6809.asm):02761                     LDD   ,X
CFF8 1F01             (    forth6809.asm):02762                     TFR   D,X
CFFA 6E84             (    forth6809.asm):02763                     JMP   ,X
                      (    forth6809.asm):02764         
                      (    forth6809.asm):02765         ; ------------------------------------------------------------
                      (    forth6809.asm):02766         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02767         ; DOABORTUNDEF
                      (    forth6809.asm):02768         ;    Inputs:
                      (    forth6809.asm):02769         ;        none
                      (    forth6809.asm):02770         ;    Outputs:
                      (    forth6809.asm):02771         ;        none (does not return)
                      (    forth6809.asm):02772         ;    Registers: RegD changed.
                      (    forth6809.asm):02773         ; ------------------------------------------------------------
CFFC                  (    forth6809.asm):02774         DOABORTUNDEF:
CFFC CCFFEB           (    forth6809.asm):02775                     LDD   #-21
CFFF 3606             (    forth6809.asm):02776                     PSHU  D                 ; throw code (-21)
D001 7ED941           (    forth6809.asm):02777                     JMP   THROWW
                      (    forth6809.asm):02778         
                      (    forth6809.asm):02779         ; ------------------------------------------------------------
                      (    forth6809.asm):02780         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02781         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02782         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02783         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02784         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02785         ;    Inputs:
                      (    forth6809.asm):02786         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02787         ;    Outputs:
                      (    forth6809.asm):02788         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02789         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02790         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
D004 3710             (    forth6809.asm):02792         DOMARKER:   PULU  X                 ; pfa
D006 EC84             (    forth6809.asm):02793                     LDD   ,X
D008 DD06             (    forth6809.asm):02794                     STD   DPHERE
D00A EC02             (    forth6809.asm):02795                     LDD   2,X
D00C DD08             (    forth6809.asm):02796                     STD   CODEHERE
D00E EC04             (    forth6809.asm):02797                     LDD   4,X
D010 DD0A             (    forth6809.asm):02798                     STD   VARHERE
D012 EC06             (    forth6809.asm):02799                     LDD   6,X
D014 DD04             (    forth6809.asm):02800                     STD   LATEST
D016 3008             (    forth6809.asm):02801                     LEAX  8,X               ; the saved search-order state follows
D018 108E0045         (    forth6809.asm):02802                     LDY   #SRCHSAVE
D01C C616             (    forth6809.asm):02803                     LDB   #SRCHSAVESZ
D01E A680             (    forth6809.asm):02804         DMCOPY:     LDA   ,X+
D020 A7A0             (    forth6809.asm):02805                     STA   ,Y+
D022 5A               (    forth6809.asm):02806                     DECB
D023 26F9             (    forth6809.asm):02807                     BNE   DMCOPY
D025 DC06             (    forth6809.asm):02808                     LDD   DPHERE
D027 7ED56B           (    forth6809.asm):02809                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02810         
                      (    forth6809.asm):02811         ; ------------------------------------------------------------
                      (    forth6809.asm):02812         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02813         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02814         ; ------------------------------------------------------------
D02A 3710             (    forth6809.asm):02815         EXECUTEW:   PULU  X                 ; xt
D02C AD84             (    forth6809.asm):02816                     JSR   ,X
D02E 39               (    forth6809.asm):02817                     RTS
                      (    forth6809.asm):02818         
                      (    forth6809.asm):02819         ; ============================================================
                      (    forth6809.asm):02820         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02821         ; ============================================================
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
                      (    forth6809.asm):02823         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02824         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02825         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02826         ;    Inputs:
                      (    forth6809.asm):02827         ;        RegX = address of the here pointer
                      (    forth6809.asm):02828         ;        x on the data stack
                      (    forth6809.asm):02829         ;    Outputs:
                      (    forth6809.asm):02830         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02831         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02832         ; ------------------------------------------------------------
D02F 3706             (    forth6809.asm):02833         APPENDCELL: PULU  D                 ; x
D031 10AE84           (    forth6809.asm):02834                     LDY   ,X
D034 EDA1             (    forth6809.asm):02835                     STD   ,Y++
D036 10AF84           (    forth6809.asm):02836                     STY   ,X
D039 39               (    forth6809.asm):02837                     RTS
                      (    forth6809.asm):02838         
                      (    forth6809.asm):02839         ; ------------------------------------------------------------
                      (    forth6809.asm):02840         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02841         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02842         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02843         ;    Inputs:
                      (    forth6809.asm):02844         ;        RegX = address of the here pointer
                      (    forth6809.asm):02845         ;        char on the data stack
                      (    forth6809.asm):02846         ;    Outputs:
                      (    forth6809.asm):02847         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02848         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02849         ; ------------------------------------------------------------
D03A 3706             (    forth6809.asm):02850         APPENDBYTE: PULU  D                 ; char
D03C 10AE84           (    forth6809.asm):02851                     LDY   ,X
D03F E7A0             (    forth6809.asm):02852                     STB   ,Y+
D041 10AF84           (    forth6809.asm):02853                     STY   ,X
D044 39               (    forth6809.asm):02854                     RTS
                      (    forth6809.asm):02855         
                      (    forth6809.asm):02856         ; ------------------------------------------------------------
                      (    forth6809.asm):02857         ; ,  ( x -- )
                      (    forth6809.asm):02858         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02859         ; ------------------------------------------------------------
D045 8E0008           (    forth6809.asm):02860         COMMAW:     LDX   #CODEHERE
D048 7ED02F           (    forth6809.asm):02861                     JMP   APPENDCELL
                      (    forth6809.asm):02862         
                      (    forth6809.asm):02863         ; ------------------------------------------------------------
                      (    forth6809.asm):02864         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02865         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02866         ; ------------------------------------------------------------
D04B 8E0008           (    forth6809.asm):02867         CODECOMMA:  LDX   #CODEHERE
D04E 7ED02F           (    forth6809.asm):02868                     JMP   APPENDCELL
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ------------------------------------------------------------
                      (    forth6809.asm):02871         ; C,  ( char -- )
                      (    forth6809.asm):02872         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02873         ; ------------------------------------------------------------
D051 8E0008           (    forth6809.asm):02874         CCOMMAW:    LDX   #CODEHERE
D054 7ED03A           (    forth6809.asm):02875                     JMP   APPENDBYTE
                      (    forth6809.asm):02876         
                      (    forth6809.asm):02877         ; ------------------------------------------------------------
                      (    forth6809.asm):02878         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02879         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
D057 8E0008           (    forth6809.asm):02881         CCOMMA1:    LDX   #CODEHERE
D05A 7ED03A           (    forth6809.asm):02882                     JMP   APPENDBYTE
                      (    forth6809.asm):02883         
                      (    forth6809.asm):02884         ; ------------------------------------------------------------
                      (    forth6809.asm):02885         ; V,  ( x -- )
                      (    forth6809.asm):02886         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
D05D 8E000A           (    forth6809.asm):02888         VCOMMAW:    LDX   #VARHERE
D060 7ED02F           (    forth6809.asm):02889                     JMP   APPENDCELL
                      (    forth6809.asm):02890         
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
                      (    forth6809.asm):02892         ; VC,  ( char -- )
                      (    forth6809.asm):02893         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
D063 8E000A           (    forth6809.asm):02895         VCCOMMAW:   LDX   #VARHERE
D066 7ED03A           (    forth6809.asm):02896                     JMP   APPENDBYTE
                      (    forth6809.asm):02897         
                      (    forth6809.asm):02898         ; ------------------------------------------------------------
                      (    forth6809.asm):02899         ; ALLOT  ( n -- )
                      (    forth6809.asm):02900         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
D069 3706             (    forth6809.asm):02902         ALLOTW:     PULU  D                 ; n
D06B 9E08             (    forth6809.asm):02903                     LDX   CODEHERE
D06D 308B             (    forth6809.asm):02904                     LEAX  D,X
D06F 9F08             (    forth6809.asm):02905                     STX   CODEHERE
D071 39               (    forth6809.asm):02906                     RTS
                      (    forth6809.asm):02907         
                      (    forth6809.asm):02908         ; ------------------------------------------------------------
                      (    forth6809.asm):02909         ; VALLOT  ( n -- )
                      (    forth6809.asm):02910         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
D072 3706             (    forth6809.asm):02912         VALLOTW:    PULU  D                 ; n
D074 9E0A             (    forth6809.asm):02913                     LDX   VARHERE
D076 308B             (    forth6809.asm):02914                     LEAX  D,X
D078 9F0A             (    forth6809.asm):02915                     STX   VARHERE
D07A 39               (    forth6809.asm):02916                     RTS
                      (    forth6809.asm):02917         
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
                      (    forth6809.asm):02919         ; HERE  ( -- addr )
                      (    forth6809.asm):02920         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
D07B DC08             (    forth6809.asm):02922         HEREW:      LDD   CODEHERE
D07D 3606             (    forth6809.asm):02923                     PSHU  D                 ; addr
D07F 39               (    forth6809.asm):02924                     RTS
                      (    forth6809.asm):02925         
                      (    forth6809.asm):02926         ; ------------------------------------------------------------
                      (    forth6809.asm):02927         ; VHERE  ( -- addr )
                      (    forth6809.asm):02928         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
D080 DC0A             (    forth6809.asm):02930         VHEREW:     LDD   VARHERE
D082 3606             (    forth6809.asm):02931                     PSHU  D                 ; addr
D084 39               (    forth6809.asm):02932                     RTS
                      (    forth6809.asm):02933         
                      (    forth6809.asm):02934         ; ------------------------------------------------------------
                      (    forth6809.asm):02935         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02936         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02937         ; ------------------------------------------------------------
D085 DC08             (    forth6809.asm):02938         PADW:       LDD   CODEHERE
D087 C30080           (    forth6809.asm):02939                     ADDD  #PADOFFSET
D08A 3606             (    forth6809.asm):02940                     PSHU  D                 ; c-addr
D08C 39               (    forth6809.asm):02941                     RTS
                      (    forth6809.asm):02942         
                      (    forth6809.asm):02943         ; ------------------------------------------------------------
                      (    forth6809.asm):02944         ; UNUSED  ( -- u )
                      (    forth6809.asm):02945         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
D08D CCB900           (    forth6809.asm):02947         UNUSEDW:    LDD   #CODETOP
D090 9308             (    forth6809.asm):02948                     SUBD  CODEHERE
D092 3606             (    forth6809.asm):02949                     PSHU  D                 ; u
D094 39               (    forth6809.asm):02950                     RTS
                      (    forth6809.asm):02951         
                      (    forth6809.asm):02952         ; ------------------------------------------------------------
                      (    forth6809.asm):02953         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02954         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02955         ; ------------------------------------------------------------
D095 CC1FFF           (    forth6809.asm):02956         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D098 930A             (    forth6809.asm):02957                     SUBD  VARHERE
D09A 3606             (    forth6809.asm):02958                     PSHU  D                 ; u
D09C 39               (    forth6809.asm):02959                     RTS
                      (    forth6809.asm):02960         
                      (    forth6809.asm):02961         ; ============================================================
                      (    forth6809.asm):02962         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02963         ; ============================================================
                      (    forth6809.asm):02964         ; ------------------------------------------------------------
                      (    forth6809.asm):02965         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02966         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02967         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02968         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02969         ; wordlist are updated.
                      (    forth6809.asm):02970         ; HEADER   ( smudge-flag "name" -- )   Throws -16 for an empty name and
                      (    forth6809.asm):02971         ;    -19 for a name of more than 31 characters (the length byte holds the
                      (    forth6809.asm):02972         ;    length in bits 0-4 and the flags in bits 5-7).
                      (    forth6809.asm):02973         ;    Inputs:
                      (    forth6809.asm):02974         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02975         ;        name parsed from the input stream
                      (    forth6809.asm):02976         ;    Outputs:
                      (    forth6809.asm):02977         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02978         ;        LATEST = address of the new header
                      (    forth6809.asm):02979         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02980         ; ------------------------------------------------------------
D09D CC0020           (    forth6809.asm):02981         HEADER:     LDD   #32
D0A0 3606             (    forth6809.asm):02982                     PSHU  D
D0A2 BDD3F4           (    forth6809.asm):02983                     JSR   WORDW
D0A5 3710             (    forth6809.asm):02984                     PULU  X                 ; c-addr of the name
D0A7 3706             (    forth6809.asm):02985                     PULU  D                 ; smudge flag in B
D0A9 A680             (    forth6809.asm):02986                     LDA   ,X+               ; name length, X = name text
D0AB 2731             (    forth6809.asm):02987                     BEQ   HDZERO            ; no name: throw -16
D0AD 811F             (    forth6809.asm):02988                     CMPA  #31
D0AF 2232             (    forth6809.asm):02989                     BHI   HDLONG            ; over 31 characters: throw -19
D0B1 3402             (    forth6809.asm):02990                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D0B3 5D               (    forth6809.asm):02991                     TSTB
D0B4 2702             (    forth6809.asm):02992                     BEQ   HDNOSM
D0B6 8A40             (    forth6809.asm):02993                     ORA   #$40
D0B8 109E06           (    forth6809.asm):02994         HDNOSM:     LDY   DPHERE
D0BB 3420             (    forth6809.asm):02995                     PSHS  Y                 ; 0,S = address of the new header
D0BD A7A0             (    forth6809.asm):02996                     STA   ,Y+
D0BF E662             (    forth6809.asm):02997                     LDB   2,S               ; length is 1 to 31 here
D0C1 A680             (    forth6809.asm):02998         HDCPY:      LDA   ,X+
D0C3 A7A0             (    forth6809.asm):02999                     STA   ,Y+
D0C5 5A               (    forth6809.asm):03000                     DECB
D0C6 26F9             (    forth6809.asm):03001                     BNE   HDCPY
D0C8 9E47             (    forth6809.asm):03002                     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D0CA EC84             (    forth6809.asm):03003                     LDD   ,X
D0CC EDA1             (    forth6809.asm):03004                     STD   ,Y++              ; LINK = old head of that wordlist
D0CE DC08             (    forth6809.asm):03005                     LDD   CODEHERE
D0D0 EDA1             (    forth6809.asm):03006                     STD   ,Y++

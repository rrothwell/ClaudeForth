DB11 8141             (    forth6809.asm):04180                     CMPA  #'A'
DB13 251E             (    forth6809.asm):04181                     BLO   NLDONE
DB15 815A             (    forth6809.asm):04182                     CMPA  #'Z'
DB17 221A             (    forth6809.asm):04183                     BHI   NLDONE
DB19 8037             (    forth6809.asm):04184                     SUBA  #'A'-10
DB1B 9103             (    forth6809.asm):04185         NLGOT:      CMPA  BASE+1
DB1D 2414             (    forth6809.asm):04186                     BHS   NLDONE

                      (    forth6809.asm):03670         ; ------------------------------------------------------------
                      (    forth6809.asm):03671         ; Search one chain of headers for a name, ignoring smudged entries.
                      (    forth6809.asm):03672         ; Case matters. A zero-length name matches a zero-length header.
                      (    forth6809.asm):03673         ; The Search-Order design is in shadow SEARCHORDER.1.
                      (    forth6809.asm):03674         ; FDSEARCH
                      (    forth6809.asm):03675         ;    Inputs:
                      (    forth6809.asm):03676         ;        RegX = first header of the chain (0 = empty chain)
                      (    forth6809.asm):03677         ;        RegY = address of the name text
                      (    forth6809.asm):03678         ;        RegB = name length
                      (    forth6809.asm):03679         ;    Outputs:
                      (    forth6809.asm):03680         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03681         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03682         ; ------------------------------------------------------------
D381 3424             (    forth6809.asm):03683         FDSEARCH:   PSHS  Y,B               ; 0,S = length, 1,S = name text
D383 8C0000           (    forth6809.asm):03684         FDLOOP:     CMPX  #0
D386 2733             (    forth6809.asm):03685                     BEQ   FDRET
D388 A684             (    forth6809.asm):03686                     LDA   ,X
D38A 8540             (    forth6809.asm):03687                     BITA  #$40
D38C 2620             (    forth6809.asm):03688                     BNE   FDNEXT            ; smudged
D38E 841F             (    forth6809.asm):03689                     ANDA  #$1F
D390 A1E4             (    forth6809.asm):03690                     CMPA  ,S
D392 261A             (    forth6809.asm):03691                     BNE   FDNEXT
D394 3410             (    forth6809.asm):03692                     PSHS  X                 ; header, kept across the compare
D396 3001             (    forth6809.asm):03693                     LEAX  1,X
D398 10AE63           (    forth6809.asm):03694                     LDY   3,S               ; name text
D39B E662             (    forth6809.asm):03695                     LDB   2,S               ; length
D39D 2709             (    forth6809.asm):03696                     BEQ   FDHIT
D39F A680             (    forth6809.asm):03697         FDCMP:      LDA   ,X+
D3A1 A1A0             (    forth6809.asm):03698                     CMPA  ,Y+
D3A3 2607             (    forth6809.asm):03699                     BNE   FDMISS
D3A5 5A               (    forth6809.asm):03700                     DECB
D3A6 26F7             (    forth6809.asm):03701                     BNE   FDCMP
D3A8 3510             (    forth6809.asm):03702         FDHIT:      PULS  X                 ; header
D3AA 200F             (    forth6809.asm):03703                     BRA   FDRET
D3AC 3510             (    forth6809.asm):03704         FDMISS:     PULS  X
D3AE E684             (    forth6809.asm):03705         FDNEXT:     LDB   ,X
D3B0 C41F             (    forth6809.asm):03706                     ANDB  #$1F
D3B2 4F               (    forth6809.asm):03707                     CLRA
D3B3 3001             (    forth6809.asm):03708                     LEAX  1,X
D3B5 308B             (    forth6809.asm):03709                     LEAX  D,X
D3B7 AE84             (    forth6809.asm):03710                     LDX   ,X                ; LINK field
D3B9 20C8             (    forth6809.asm):03711                     BRA   FDLOOP
D3BB 3263             (    forth6809.asm):03712         FDRET:      LEAS  3,S
D3BD 39               (    forth6809.asm):03713                     RTS
                      (    forth6809.asm):03714         
                      (    forth6809.asm):03715         ; ------------------------------------------------------------
                      (    forth6809.asm):03716         ; Search every wordlist of the search order, first to last, and then
                      (    forth6809.asm):03717         ; ROOT, for a name.
                      (    forth6809.asm):03718         ; SRCHORD
                      (    forth6809.asm):03719         ;    Inputs:
                      (    forth6809.asm):03720         ;        RegY = address of the name text
                      (    forth6809.asm):03721         ;        RegB = name length
                      (    forth6809.asm):03722         ;    Outputs:
                      (    forth6809.asm):03723         ;        RegX = the matching header, or 0 if there is none
                      (    forth6809.asm):03724         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03725         ; ------------------------------------------------------------
D3BE 3424             (    forth6809.asm):03726         SRCHORD:    PSHS  Y,B               ; 0,S = length, 1,S = name text
D3C0 8E004B           (    forth6809.asm):03727                     LDX   #ORDER
D3C3 3410             (    forth6809.asm):03728                     PSHS  X                 ; 0,S = next ORDER cell (length is now 2,S)
D3C5 AEE4             (    forth6809.asm):03729         SOLOOP:     LDX   ,S
D3C7 9C49             (    forth6809.asm):03730                     CMPX  ORDEND
D3C9 2415             (    forth6809.asm):03731                     BHS   SOROOT
D3CB 10AE81           (    forth6809.asm):03732                     LDY   ,X++              ; WID
D3CE AFE4             (    forth6809.asm):03733                     STX   ,S
D3D0 AEA4             (    forth6809.asm):03734                     LDX   ,Y                ; newest header of that wordlist
D3D2 10AE63           (    forth6809.asm):03735                     LDY   3,S
D3D5 E662             (    forth6809.asm):03736                     LDB   2,S
D3D7 8DA8             (    forth6809.asm):03737                     BSR   FDSEARCH
D3D9 8C0000           (    forth6809.asm):03738                     CMPX  #0
D3DC 27E7             (    forth6809.asm):03739                     BEQ   SOLOOP
D3DE 2009             (    forth6809.asm):03740                     BRA   SORDONE
D3E0 9E5D             (    forth6809.asm):03741         SOROOT:     LDX   WLHEADS+2         ; ROOT
D3E2 10AE63           (    forth6809.asm):03742                     LDY   3,S
D3E5 E662             (    forth6809.asm):03743                     LDB   2,S
D3E7 8D98             (    forth6809.asm):03744                     BSR   FDSEARCH
D3E9 3265             (    forth6809.asm):03745         SORDONE:    LEAS  5,S
D3EB 39               (    forth6809.asm):03746                     RTS
                      (    forth6809.asm):03747         
                      (    forth6809.asm):03748         ; ------------------------------------------------------------
                      (    forth6809.asm):03749         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03750         ; HDRXT
                      (    forth6809.asm):03751         ;    Inputs:
                      (    forth6809.asm):03752         ;        RegX = header
                      (    forth6809.asm):03753         ;    Outputs:
                      (    forth6809.asm):03754         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03755         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03756         ; ------------------------------------------------------------
D3EC A684             (    forth6809.asm):03757         HDRXT:      LDA   ,X
D3EE 1F89             (    forth6809.asm):03758                     TFR   A,B
D3F0 C41F             (    forth6809.asm):03759                     ANDB  #$1F
D3F2 3001             (    forth6809.asm):03760                     LEAX  1,X
D3F4 3A               (    forth6809.asm):03761                     ABX
D3F5 AE02             (    forth6809.asm):03762                     LDX   2,X               ; CFA field
D3F7 39               (    forth6809.asm):03763                     RTS
                      (    forth6809.asm):03764         
                      (    forth6809.asm):03765         ; ------------------------------------------------------------
                      (    forth6809.asm):03766         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03767         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03768         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03769         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03770         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03771         ; ------------------------------------------------------------
D3F8 10AEC4           (    forth6809.asm):03772         FINDW:      LDY   ,U                ; counted string
D3FB E6A0             (    forth6809.asm):03773                     LDB   ,Y+
D3FD 8DBF             (    forth6809.asm):03774                     BSR   SRCHORD
D3FF 8C0000           (    forth6809.asm):03775                     CMPX  #0
D402 2712             (    forth6809.asm):03776                     BEQ   NOTFOUND
D404 8DE6             (    forth6809.asm):03777                     BSR   HDRXT
D406 AFC4             (    forth6809.asm):03778                     STX   ,U                ; xt replaces c-addr
D408 4D               (    forth6809.asm):03779                     TSTA
D409 2A05             (    forth6809.asm):03780                     BPL   FISNORM
D40B CC0001           (    forth6809.asm):03781                     LDD   #1
D40E 2003             (    forth6809.asm):03782                     BRA   FPUSH
D410 CCFFFF           (    forth6809.asm):03783         FISNORM:    LDD   #-1
D413 3606             (    forth6809.asm):03784         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D415 39               (    forth6809.asm):03785                     RTS
                      (    forth6809.asm):03786         
D416 CC0000           (    forth6809.asm):03787         NOTFOUND:   LDD   #0
D419 3606             (    forth6809.asm):03788                     PSHU  D                 ; 0 = not found, c-addr still beneath
D41B 39               (    forth6809.asm):03789                     RTS
                      (    forth6809.asm):03790         
                      (    forth6809.asm):03791         ; ------------------------------------------------------------
                      (    forth6809.asm):03792         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03793         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03794         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03795         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03796         ; ------------------------------------------------------------
D41C 3710             (    forth6809.asm):03797         SEARCHWLW:  PULU  X                 ; wid
D41E 8D2D             (    forth6809.asm):03798                     BSR   WIDCHK
D420 AE84             (    forth6809.asm):03799                     LDX   ,X                ; newest header of the wordlist
D422 3706             (    forth6809.asm):03800                     PULU  D                 ; u
D424 3720             (    forth6809.asm):03801                     PULU  Y                 ; c-addr
D426 4D               (    forth6809.asm):03802                     TSTA
D427 261E             (    forth6809.asm):03803                     BNE   SWNOT             ; longer than any name
D429 C11F             (    forth6809.asm):03804                     CMPB  #31
D42B 221A             (    forth6809.asm):03805                     BHI   SWNOT
D42D BDD381           (    forth6809.asm):03806                     JSR   FDSEARCH
D430 8C0000           (    forth6809.asm):03807                     CMPX  #0
D433 2712             (    forth6809.asm):03808                     BEQ   SWNOT
D435 8DB5             (    forth6809.asm):03809                     BSR   HDRXT
D437 3610             (    forth6809.asm):03810                     PSHU  X                 ; xt
D439 4D               (    forth6809.asm):03811                     TSTA
D43A 2A05             (    forth6809.asm):03812                     BPL   SWNORM
D43C CC0001           (    forth6809.asm):03813                     LDD   #1
D43F 2003             (    forth6809.asm):03814                     BRA   SWPUSH
D441 CCFFFF           (    forth6809.asm):03815         SWNORM:     LDD   #-1
D444 3606             (    forth6809.asm):03816         SWPUSH:     PSHU  D
D446 39               (    forth6809.asm):03817                     RTS
D447 CC0000           (    forth6809.asm):03818         SWNOT:      LDD   #0
D44A 3606             (    forth6809.asm):03819                     PSHU  D
D44C 39               (    forth6809.asm):03820                     RTS
                      (    forth6809.asm):03821         
                      (    forth6809.asm):03822         ; ------------------------------------------------------------
                      (    forth6809.asm):03823         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03824         ; WIDCHK
                      (    forth6809.asm):03825         ;    Inputs:
                      (    forth6809.asm):03826         ;        RegX = candidate WID
                      (    forth6809.asm):03827         ;    Outputs:
                      (    forth6809.asm):03828         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03829         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03830         ; ------------------------------------------------------------
D44D 1F10             (    forth6809.asm):03831         WIDCHK:     TFR   X,D
D44F 83005B           (    forth6809.asm):03832                     SUBD  #WLHEADS
D452 2509             (    forth6809.asm):03833                     BCS   WIDBAD
D454 C501             (    forth6809.asm):03834                     BITB  #1
D456 2605             (    forth6809.asm):03835                     BNE   WIDBAD
D458 9C45             (    forth6809.asm):03836                     CMPX  WLEND
D45A 2401             (    forth6809.asm):03837                     BHS   WIDBAD
D45C 39               (    forth6809.asm):03838                     RTS
D45D CCFFF5           (    forth6809.asm):03839         WIDBAD:     LDD   #-11
D460 3606             (    forth6809.asm):03840                     PSHU  D
D462 7ED895           (    forth6809.asm):03841                     JMP   THROWW
                      (    forth6809.asm):03842         
                      (    forth6809.asm):03843         ; ------------------------------------------------------------
                      (    forth6809.asm):03844         ; Set the Search-Order state to its initial value: two wordlists
                      (    forth6809.asm):03845         ; (FORTH, holding the ROM dictionary, and ROOT), the search order
                      (    forth6809.asm):03846         ; FORTH, and CURRENT = FORTH.
                      (    forth6809.asm):03847         ; WLINIT
                      (    forth6809.asm):03848         ;    Inputs:
                      (    forth6809.asm):03849         ;        none
                      (    forth6809.asm):03850         ;    Outputs:
                      (    forth6809.asm):03851         ;        WLHEADS, WLNAMES (FORTH, ROOT), WLEND, CURRENT, ORDER, ORDEND set
                      (    forth6809.asm):03852         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03853         ; ------------------------------------------------------------
D465 CCCD8A           (    forth6809.asm):03854         WLINIT:     LDD   #BASELATEST
D468 DD5B             (    forth6809.asm):03855                     STD   WLHEADS
D46A CCC45B           (    forth6809.asm):03856                     LDD   #BASEROOTLATEST
D46D DD5D             (    forth6809.asm):03857                     STD   WLHEADS+2
D46F CCC45B           (    forth6809.asm):03858                     LDD   #H_FORTH
D472 DD6F             (    forth6809.asm):03859                     STD   WLNAMES
D474 CCC452           (    forth6809.asm):03860                     LDD   #H_ROOT
D477 DD71             (    forth6809.asm):03861                     STD   WLNAMES+2
D479 CC005F           (    forth6809.asm):03862                     LDD   #WLHEADS+4
D47C DD45             (    forth6809.asm):03863                     STD   WLEND
D47E CC005B           (    forth6809.asm):03864                     LDD   #WLHEADS
D481 DD47             (    forth6809.asm):03865                     STD   CURRENT
D483 7ED553           (    forth6809.asm):03866                     JMP   ONLYW             ; the order is FORTH only
                      (    forth6809.asm):03867         
                      (    forth6809.asm):03868         ; ------------------------------------------------------------
                      (    forth6809.asm):03869         ; Remove from every wordlist the RAM headers that are at or above a
                      (    forth6809.asm):03870         ; mark. Headers are allocated upwards from DPHERE, so these are the
                      (    forth6809.asm):03871         ; newest ones of each chain. ROM headers are never touched.
                      (    forth6809.asm):03872         ; PRUNE
                      (    forth6809.asm):03873         ;    Inputs:
                      (    forth6809.asm):03874         ;        RegD = mark (a DPHERE value)
                      (    forth6809.asm):03875         ;    Outputs:
                      (    forth6809.asm):03876         ;        the head of every wordlist in use points below the mark or
                      (    forth6809.asm):03877         ;        into ROM
                      (    forth6809.asm):03878         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):03879         ; ------------------------------------------------------------
D486 3406             (    forth6809.asm):03880         PRUNE:      PSHS  D                 ; 0,S = mark
D488 8E005B           (    forth6809.asm):03881                     LDX   #WLHEADS
D48B 9C45             (    forth6809.asm):03882         PRLOOP:     CMPX  WLEND
D48D 2421             (    forth6809.asm):03883                     BHS   PRNDONE
D48F 10AE84           (    forth6809.asm):03884                     LDY   ,X                ; newest header of this wordlist
D492 108CC000         (    forth6809.asm):03885         PRWALK:     CMPY  #ROMSTRT
D496 2413             (    forth6809.asm):03886                     BHS   PRSTORE           ; ROM header: keep
D498 10ACE4           (    forth6809.asm):03887                     CMPY  ,S
D49B 250E             (    forth6809.asm):03888                     BLO   PRSTORE           ; below the mark (or empty): keep
D49D E6A4             (    forth6809.asm):03889                     LDB   ,Y
D49F C41F             (    forth6809.asm):03890                     ANDB  #$1F
D4A1 4F               (    forth6809.asm):03891                     CLRA
D4A2 3121             (    forth6809.asm):03892                     LEAY  1,Y
D4A4 31AB             (    forth6809.asm):03893                     LEAY  D,Y
D4A6 10AEA4           (    forth6809.asm):03894                     LDY   ,Y                ; follow the LINK
D4A9 20E7             (    forth6809.asm):03895                     BRA   PRWALK
D4AB 10AF81           (    forth6809.asm):03896         PRSTORE:    STY   ,X++
D4AE 20DB             (    forth6809.asm):03897                     BRA   PRLOOP
D4B0 3262             (    forth6809.asm):03898         PRNDONE:     LEAS  2,S
D4B2 39               (    forth6809.asm):03899                     RTS
                      (    forth6809.asm):03900         
                      (    forth6809.asm):03901         ; ============================================================
                      (    forth6809.asm):03902         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03903         ; ============================================================
                      (    forth6809.asm):03904         ; ------------------------------------------------------------
                      (    forth6809.asm):03905         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03906         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03907         ; ------------------------------------------------------------
D4B3 9E45             (    forth6809.asm):03908         WORDLISTW:  LDX   WLEND
D4B5 8C006F           (    forth6809.asm):03909                     CMPX  #WLHEADS+2*WLCELLS
D4B8 240F             (    forth6809.asm):03910                     BHS   WLFULL
D4BA CC0000           (    forth6809.asm):03911                     LDD   #0
D4BD ED84             (    forth6809.asm):03912                     STD   ,X
D4BF ED8814           (    forth6809.asm):03913                     STD   WLNOFF,X
D4C2 3610             (    forth6809.asm):03914                     PSHU  X
D4C4 3002             (    forth6809.asm):03915                     LEAX  2,X
D4C6 9F45             (    forth6809.asm):03916                     STX   WLEND
D4C8 39               (    forth6809.asm):03917                     RTS
D4C9 CCFFF8           (    forth6809.asm):03918         WLFULL:     LDD   #-8
D4CC 3606             (    forth6809.asm):03919                     PSHU  D
D4CE 7ED895           (    forth6809.asm):03920                     JMP   THROWW
                      (    forth6809.asm):03921         
                      (    forth6809.asm):03922         ; ------------------------------------------------------------
                      (    forth6809.asm):03923         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03924         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03925         ; ------------------------------------------------------------
D4D1 CC005B           (    forth6809.asm):03926         FORTHWLW:   LDD   #WLHEADS
D4D4 3606             (    forth6809.asm):03927                     PSHU  D
D4D6 39               (    forth6809.asm):03928                     RTS
                      (    forth6809.asm):03929         
                      (    forth6809.asm):03930         ; ------------------------------------------------------------
                      (    forth6809.asm):03931         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03932         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03933         ; it, as it is always searched last.
                      (    forth6809.asm):03934         ; ------------------------------------------------------------
D4D7 9E49             (    forth6809.asm):03935         GETORDERW:  LDX   ORDEND
D4D9 8C004B           (    forth6809.asm):03936         GOLOOP:     CMPX  #ORDER
D4DC 2306             (    forth6809.asm):03937                     BLS   GODONE
D4DE EC83             (    forth6809.asm):03938                     LDD   ,--X
D4E0 3606             (    forth6809.asm):03939                     PSHU  D
D4E2 20F5             (    forth6809.asm):03940                     BRA   GOLOOP
D4E4 DC49             (    forth6809.asm):03941         GODONE:     LDD   ORDEND
D4E6 83004B           (    forth6809.asm):03942                     SUBD  #ORDER
D4E9 44               (    forth6809.asm):03943                     LSRA
D4EA 56               (    forth6809.asm):03944                     RORB
D4EB 3606             (    forth6809.asm):03945                     PSHU  D                 ; n
D4ED 39               (    forth6809.asm):03946                     RTS
                      (    forth6809.asm):03947         
                      (    forth6809.asm):03948         ; ------------------------------------------------------------
                      (    forth6809.asm):03949         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03950         ; Set the search order. n = -1 selects the minimum order (FORTH only).
                      (    forth6809.asm):03951         ; n = 0 empties it (ROOT can still be searched). Throws -49 when n is
                      (    forth6809.asm):03952         ; more than 8, -50 when n is less than -1 and -11 for an invalid wid.
                      (    forth6809.asm):03953         ; ------------------------------------------------------------
D4EE 3706             (    forth6809.asm):03954         SETORDERW:  PULU  D                 ; n
D4F0 1083FFFF         (    forth6809.asm):03955                     CMPD  #-1
D4F4 275D             (    forth6809.asm):03956                     BEQ   ONLYW             ; the minimum order
D4F6 4D               (    forth6809.asm):03957         SO1:        TSTA
D4F7 2B31             (    forth6809.asm):03958                     BMI   SOUNDER
D4F9 262A             (    forth6809.asm):03959                     BNE   SOOVER
D4FB C108             (    forth6809.asm):03960                     CMPB  #WLMAX
D4FD 2226             (    forth6809.asm):03961                     BHI   SOOVER
D4FF 3404             (    forth6809.asm):03962                     PSHS  B                 ; 1,S = n
D501 3404             (    forth6809.asm):03963                     PSHS  B                 ; 0,S = count down
D503 1F32             (    forth6809.asm):03964                     TFR   U,Y
D505 6DE4             (    forth6809.asm):03965         SOCHK:      TST   ,S

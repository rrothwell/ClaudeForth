                      (    forth6809.asm):06236         ; /  ( n1 n2 -- n3 )
                      (    forth6809.asm):06237         ; Quotient of n1 divided by n2. Division truncates toward zero; the
                      (    forth6809.asm):06238         ; remainder has the sign of the dividend. THROW -10 if the divisor is
                      (    forth6809.asm):06239         ; zero.
                      (    forth6809.asm):06240         ; ------------------------------------------------------------

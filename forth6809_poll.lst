                      (    forth6809.asm):05318         ; EXIT  ( -- )
                      (    forth6809.asm):05319         ; Compile a call to EXITUNLOOP followed by a count of the DO frames
                      (    forth6809.asm):05320         ; found on the control-flow stack. The count is not used at run time.
                      (    forth6809.asm):05321         ; A loop must be left with UNLOOP before EXIT.
                      (    forth6809.asm):05322         ; ------------------------------------------------------------
DC34 108E0000         (    forth6809.asm):05323         EXITW:      LDY   #0                ; Y = count of DO frames (5k: no scratch)
DC38 1F31             (    forth6809.asm):05324                     TFR   U,X               ; X = scan pointer
DC3A 9C21             (    forth6809.asm):05325         EXSCAN:     CMPX  CSP
DC3C 270E             (    forth6809.asm):05326                     BEQ   EXSCANDONE
DC3E EC84             (    forth6809.asm):05327                     LDD   ,X
DC40 10830003         (    forth6809.asm):05328                     CMPD  #TAGDO
DC44 2602             (    forth6809.asm):05329                     BNE   EXNOTDO
DC46 3121             (    forth6809.asm):05330                     LEAY  1,Y
DC48 3004             (    forth6809.asm):05331         EXNOTDO:    LEAX  4,X
DC4A 20EE             (    forth6809.asm):05332                     BRA   EXSCAN
DC4C                  (    forth6809.asm):05333         EXSCANDONE:
DC4C 3420             (    forth6809.asm):05334                     PSHS  Y                 ; the count survives CCALL on S
DC4E CCDC5E           (    forth6809.asm):05335                     LDD   #EXITUNLOOP

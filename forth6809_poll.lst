                      (    forth6809.asm):04442         ;    Outputs:
                      (    forth6809.asm):04443         ;        loop skipped, or loop frame on S and operand skipped
                      (    forth6809.asm):04444         ;    Registers: RegD and RegX changed; MSCR and MSCR2 used as scratch.
                      (    forth6809.asm):04445         ; ------------------------------------------------------------
E720 3706             (    forth6809.asm):04446         QDOSETUP:   PULU  D                 ; index
E722 DD14             (    forth6809.asm):04447                     STD   MSCR

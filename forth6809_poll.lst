                      (    forth6809.asm):02011         ; ------------------------------------------------------------
                      (    forth6809.asm):02012         
D240 7F0176           (    forth6809.asm):02013         SERBUFCLR:  CLR   INHEAD
D243 7F0177           (    forth6809.asm):02014                     CLR   INTAIL
D246 7F0178           (    forth6809.asm):02015                     CLR   RTSSTATE          ; $00 = RTS Low (Clear)
D249 7F0179           (    forth6809.asm):02016                     CLR   OUTHEAD
D24C 7F017A           (    forth6809.asm):02017                     CLR   OUTTAIL
D24F 7F017B           (    forth6809.asm):02018                     CLR   OUTACTIVITY       ; $00 = Idle
                      (    forth6809.asm):02019         
                      (    forth6809.asm):02020         
D252 7F017C           (    forth6809.asm):02021                     CLR   FECOUNT
D255 7F017D           (    forth6809.asm):02022                     CLR   OVRNCOUNT
D258 7F017E           (    forth6809.asm):02023                     CLR   PECOUNT
D25B 7F017F           (    forth6809.asm):02024                     CLR   POLLREADYCNT
D25E 39               (    forth6809.asm):02025                     RTS
                      (    forth6809.asm):02026         
                      (    forth6809.asm):02027         ; ------------------------------------------------------------
                      (    forth6809.asm):02028         ; Initialise the ACIA (6850): master reset, then select
                      (    forth6809.asm):02029         ; interrupt-driven or polling operation per SERIALPOLL.
                      (    forth6809.asm):02030         ; INITSERIAL
                      (    forth6809.asm):02031         ;    Inputs:
                      (    forth6809.asm):02032         ;        none
                      (    forth6809.asm):02033         ;    Outputs:
                      (    forth6809.asm):02034         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):02035         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02036         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):02037         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):02038         ; ------------------------------------------------------------
D25F BDD240           (    forth6809.asm):02039         INITSERIAL: JSR   SERBUFCLR
D262 8603             (    forth6809.asm):02040                     LDA   #CR_RESET         ; Master Software Reset. See bugfix: INITSERIAL.2
D264 B7C008           (    forth6809.asm):02041                     STA   ACIACR
D267 12               (    forth6809.asm):02042                     NOP                     ; Settling Delay
D268 12               (    forth6809.asm):02043                     NOP
                      (    forth6809.asm):02044         
                      (    forth6809.asm):02045                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02046                     LDA   #CR_RXON          ; interrupt-driven mode: RX interrupt on
                      (    forth6809.asm):02047                     ELSE                    ; <<<<<>>>>>
D269 8615             (    forth6809.asm):02048                     LDA   #CR_POLL          ; polling mode: no interrupts, RTS held low
                      (    forth6809.asm):02049                     ENDC                    ; <<<<<<<<<<
D26B B7C008           (    forth6809.asm):02050                     STA   ACIACR            ; See bugfix: INITSERIAL.1
D26E 39               (    forth6809.asm):02051                     RTS
                      (    forth6809.asm):02052         
                      (    forth6809.asm):02053                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):02054         ; ------------------------------------------------------------
                      (    forth6809.asm):02055         ; Return the input ring buffer fill level (0 to INBUFSZ-1).
                      (    forth6809.asm):02056         ; INBUFSZ is a power of two and both indices stay in range, so a
                      (    forth6809.asm):02057         ; masked subtraction gives the true distance across the wrap.
                      (    forth6809.asm):02058         ; INFILL
                      (    forth6809.asm):02059         ;    Inputs:
                      (    forth6809.asm):02060         ;        none
                      (    forth6809.asm):02061         ;    Outputs:
                      (    forth6809.asm):02062         ;        RegA = (INHEAD - INTAIL) mod INBUFSZ
                      (    forth6809.asm):02063         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02064         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02065         INFILL:     LDA   INHEAD
                      (    forth6809.asm):02066                     SUBA  INTAIL
                      (    forth6809.asm):02067                     ANDA  #INBUFSZ-1        ; Output: RegA = fill level
                      (    forth6809.asm):02068                     RTS
                      (    forth6809.asm):02069         ; ------------------------------------------------------------
                      (    forth6809.asm):02070         ; Assert RTS high (ask the sender to pause) if the input ring has
                      (    forth6809.asm):02071         ; reached INHIWATER and RTS is not already high. Called from the
                      (    forth6809.asm):02072         ; receive path with interrupts already masked.
                      (    forth6809.asm):02073         ; RTSCHECKHI
                      (    forth6809.asm):02074         ;    Inputs:
                      (    forth6809.asm):02075         ;        none
                      (    forth6809.asm):02076         ;    Outputs:
                      (    forth6809.asm):02077         ;        RTSSTATE = 1 and ACIACR = CR_RTSHI if the threshold was reached
                      (    forth6809.asm):02078         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02079         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02080         RTSCHECKHI: JSR   INFILL
                      (    forth6809.asm):02081                     CMPA  #INHIWATER
                      (    forth6809.asm):02082                     BLO   RTSCHIDONE
                      (    forth6809.asm):02083                     TST   RTSSTATE
                      (    forth6809.asm):02084                     BNE   RTSCHIDONE        ; already high - nothing to do
                      (    forth6809.asm):02085                     LDA   #CR_RTSHI
                      (    forth6809.asm):02086                     STA   ACIACR
                      (    forth6809.asm):02087                     LDA   #1
                      (    forth6809.asm):02088                     STA   RTSSTATE
D26F                  (    forth6809.asm):02089         RTSCHIDONE: RTS
                      (    forth6809.asm):02090         ; ------------------------------------------------------------
                      (    forth6809.asm):02091         ; Write the ACIA control byte for the current RTSSTATE and
                      (    forth6809.asm):02092         ; OUTACTIVITY: RTS high disables the Tx interrupt; RTS low
                      (    forth6809.asm):02093         ; enables it only while output is pending.
                      (    forth6809.asm):02094         ; UPDATE_RTS
                      (    forth6809.asm):02095         ;    Inputs:
                      (    forth6809.asm):02096         ;        RTSSTATE, OUTACTIVITY
                      (    forth6809.asm):02097         ;    Outputs:
                      (    forth6809.asm):02098         ;        ACIACR written (OUTACTIVITY cleared when RTS is high)
                      (    forth6809.asm):02099         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02100         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02101         UPDATE_RTS:
                      (    forth6809.asm):02102                     TST   RTSSTATE
                      (    forth6809.asm):02103                     BNE   SET_RTS_HI_TX_OFF
                      (    forth6809.asm):02104         
                      (    forth6809.asm):02105                     TST   OUTACTIVITY       ; Is active?
                      (    forth6809.asm):02106                     BEQ   SET_RTS_LO_TX_OFF ; No! Disable Transmit interrupt.
                      (    forth6809.asm):02107         
                      (    forth6809.asm):02108                                             ; $B5/%1011_0101
                      (    forth6809.asm):02109                     LDA   #CR_RXTX          ; Yes! Accept input & transmit output
                      (    forth6809.asm):02110                     BRA   WRITE_CR          ; RTS = Low, Tx Interrupt = Enabled
                      (    forth6809.asm):02111         
D26F                  (    forth6809.asm):02112         SET_RTS_LO_TX_OFF:                  ; $95/%10010101
                      (    forth6809.asm):02113                     LDA   #CR_RXON          ; RTS = Low, Tx Interrupt = Disabled
                      (    forth6809.asm):02114                     BRA   WRITE_CR          ; Open question moved to shadow: UPDATE_RTS.1
                      (    forth6809.asm):02115         
D26F                  (    forth6809.asm):02116         SET_RTS_HI_TX_OFF:                  ; $D5/%1101_0101
                      (    forth6809.asm):02117                     LDA   #CR_RTSHI         ; RTS = High, Tx Interrupt = Disabled
                      (    forth6809.asm):02118                     CLR   OUTACTIVITY       ; Interrupts are hardware-disabled; clear state
D26F                  (    forth6809.asm):02119         WRITE_CR:
                      (    forth6809.asm):02120                     STA   ACIACR
                      (    forth6809.asm):02121                     RTS
                      (    forth6809.asm):02122         ; ------------------------------------------------------------
                      (    forth6809.asm):02123         ; If the input ring is near full and RTS is not already high,
                      (    forth6809.asm):02124         ; set RTSSTATE to INREJECT and update the ACIA to drop RTS.
                      (    forth6809.asm):02125         ; Called after a character is added to the ring.
                      (    forth6809.asm):02126         ; CHKHI
                      (    forth6809.asm):02127         ;    Inputs:
                      (    forth6809.asm):02128         ;        RegB = input ring fill level
                      (    forth6809.asm):02129         ;    Outputs:
                      (    forth6809.asm):02130         ;        RTSSTATE and ACIACR updated if the high-water mark was reached
                      (    forth6809.asm):02131         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02132         ; Original comment: shadow CHKHI.0.
                      (    forth6809.asm):02133         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02134         CHKHI:
                      (    forth6809.asm):02135                     CMPB  #INHIWATER        ; RegB = fill level. Near full?
                      (    forth6809.asm):02136                     BLO   CHKHIDONE         ; No! Do nothing.
                      (    forth6809.asm):02137                     TST   RTSSTATE
                      (    forth6809.asm):02138                     BNE   CHKHIDONE         ; already high - nothing to do
                      (    forth6809.asm):02139                     LDA   #INREJECT         ; Yes! De-assert RTS.
                      (    forth6809.asm):02140                     STA   RTSSTATE
                      (    forth6809.asm):02141                     JSR   UPDATE_RTS
D26F                  (    forth6809.asm):02142         CHKHIDONE:  RTS
                      (    forth6809.asm):02143         
                      (    forth6809.asm):02144         ; ------------------------------------------------------------
                      (    forth6809.asm):02145         ; If the input ring is near empty and RTS is high, set
                      (    forth6809.asm):02146         ; RTSSTATE to INACCEPT and update the ACIA to raise RTS.
                      (    forth6809.asm):02147         ; Called after a character is removed from the ring.
                      (    forth6809.asm):02148         ; CHKLO
                      (    forth6809.asm):02149         ;    Inputs:
                      (    forth6809.asm):02150         ;        RegB = input ring fill level
                      (    forth6809.asm):02151         ;    Outputs:
                      (    forth6809.asm):02152         ;        RTSSTATE and ACIACR updated if the low-water mark was reached
                      (    forth6809.asm):02153         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):02154         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02155         CHKLO:
                      (    forth6809.asm):02156                     CMPB  #INLOWATER        ; RegB = fill level. Near empty?
                      (    forth6809.asm):02157                     BHS   CHKLODONE         ; No! Do nothing.
                      (    forth6809.asm):02158                     TST   RTSSTATE
                      (    forth6809.asm):02159                     BEQ   CHKLODONE         ; already low - nothing to do
                      (    forth6809.asm):02160                     LDA   #INACCEPT         ; Yes! Assert RTS.
                      (    forth6809.asm):02161                     STA   RTSSTATE
                      (    forth6809.asm):02162                     JSR   UPDATE_RTS
D26F                  (    forth6809.asm):02163         CHKLODONE:  RTS
                      (    forth6809.asm):02164         ; ------------------------------------------------------------
                      (    forth6809.asm):02165         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02166         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02167         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02168         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02169         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02170         ;    Inputs:
                      (    forth6809.asm):02171         ;        none
                      (    forth6809.asm):02172         ;    Outputs:
                      (    forth6809.asm):02173         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02174         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02175         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02176         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02177         FLUSHOUTBUFFER:
                      (    forth6809.asm):02178                     LDB   OUTTAIL
                      (    forth6809.asm):02179                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02180                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02181         
                      (    forth6809.asm):02182                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02183                     BITA  #SR_CTS
                      (    forth6809.asm):02184                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02185         
                      (    forth6809.asm):02186                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02187                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02188                                             ; than spin-wait here.
                      (    forth6809.asm):02189         
                      (    forth6809.asm):02190                     LDX   #OUTBUF           ; The out buffer is occupied.
                      (    forth6809.asm):02191                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02192                     STA   ACIADR            ; Transmit character.
                      (    forth6809.asm):02193         
                      (    forth6809.asm):02194                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02195                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02196                     STB   OUTTAIL
                      (    forth6809.asm):02197                                             ; One character sent - return rather than
                      (    forth6809.asm):02198                                             ; loop back for more (see header comment).
D26F                  (    forth6809.asm):02199         FLUSHED:
                      (    forth6809.asm):02200                     RTS
                      (    forth6809.asm):02201         ; ------------------------------------------------------------
                      (    forth6809.asm):02202         ; Queue a character for transmission. The character is discarded
                      (    forth6809.asm):02203         ; if the output ring is full. Runs as a critical section.
                      (    forth6809.asm):02204         ; PUTCHAR
                      (    forth6809.asm):02205         ;    Inputs:
                      (    forth6809.asm):02206         ;        RegA = character to insert into transmit buffer
                      (    forth6809.asm):02207         ;    Outputs:
                      (    forth6809.asm):02208         ;        none
                      (    forth6809.asm):02209         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02210         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02211         PUTCHAR:
                      (    forth6809.asm):02212                     PSHS  CC,X
                      (    forth6809.asm):02213                     ORCC  #$50              ; Enter Critical Section. Disable IRQ & FIRQ
                      (    forth6809.asm):02214         
                      (    forth6809.asm):02215                     LDB   OUTHEAD           ; Is buffer full?
                      (    forth6809.asm):02216                     INCB
                      (    forth6809.asm):02217                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02218                     CMPB  OUTTAIL
                      (    forth6809.asm):02219                     BEQ   PUT_EXIT          ; Yes! Exit discarding character.
                      (    forth6809.asm):02220         
                      (    forth6809.asm):02221                     LDX   #OUTBUF           ; Put character into character slot.
                      (    forth6809.asm):02222                     LDB   OUTHEAD
                      (    forth6809.asm):02223                     STA   B,X               ; Input: RegA = character
                      (    forth6809.asm):02224         
                      (    forth6809.asm):02225                     INCB                    ; Update tail pointer to next character slot.
                      (    forth6809.asm):02226                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02227                     STB   OUTHEAD
                      (    forth6809.asm):02228         
                      (    forth6809.asm):02229                     TST   RTSSTATE          ; Is RTS currently low (chars still being accepted)?
                      (    forth6809.asm):02230                     BEQ   CHK_INT_PATH      ; Yes! Interrupt-driven TX is still available.
                      (    forth6809.asm):02231         
                      (    forth6809.asm):02232                     ; RTS is high so the Tx interrupt is off: drain by polling,
                      (    forth6809.asm):02233                     ; with IRQ and FIRQ unmasked meanwhile. See bugfix: PUTCHAR.1
                      (    forth6809.asm):02234                     ANDCC #$AF              ; unmask IRQ+FIRQ for the flush only
                      (    forth6809.asm):02235                     JSR   FLUSHOUTBUFFER    ; Fallback to transmit by polling.
                      (    forth6809.asm):02236                     ORCC  #$50              ; re-mask - PUT_EXIT below still
                      (    forth6809.asm):02237                                             ; expects the critical section active
                      (    forth6809.asm):02238         
                      (    forth6809.asm):02239                     BRA   PUT_EXIT
                      (    forth6809.asm):02240         
                      (    forth6809.asm):02241         ; Re-start the interrupt driven character pump,
                      (    forth6809.asm):02242         ; priming the pump by transmitting a character.
D26F                  (    forth6809.asm):02243         CHK_INT_PATH:
                      (    forth6809.asm):02244                     TST   OUTACTIVITY       ; Is the interrupt handler transmitting?
                      (    forth6809.asm):02245                     BNE   PUT_EXIT          ; Yes! Exit, no action required.
                      (    forth6809.asm):02246         
                      (    forth6809.asm):02247                                             ; No! Restart.
                      (    forth6809.asm):02248                     LDX   #OUTBUF           ; Pull character from the out buffer.
                      (    forth6809.asm):02249                     LDB   OUTTAIL
                      (    forth6809.asm):02250                     LDA   B,X
                      (    forth6809.asm):02251                     STA   ACIADR            ; Load the char for transmission.
                      (    forth6809.asm):02252         
                      (    forth6809.asm):02253                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02254                     ANDB  #OUTBUFSZ-1       ; to point to the next character.
                      (    forth6809.asm):02255                     STB   OUTTAIL
                      (    forth6809.asm):02256         
                      (    forth6809.asm):02257                     LDA   #OUTBUSY          ; Flag restart of transmit interrupt handler.
                      (    forth6809.asm):02258                     STA   OUTACTIVITY
                      (    forth6809.asm):02259                     JSR   UPDATE_RTS        ; Turn on the Tx interrupt.
                      (    forth6809.asm):02260         
D26F                  (    forth6809.asm):02261         PUT_EXIT:
                      (    forth6809.asm):02262                     PULS  CC,X,PC           ; Leaving the critical section,
                      (    forth6809.asm):02263                                             ; by restoring the CC.
                      (    forth6809.asm):02264         ; ------------------------------------------------------------
                      (    forth6809.asm):02265         ; Fetch the next character from the input ring, if any, and let
                      (    forth6809.asm):02266         ; the flow-control check re-assert RTS when the ring has drained.
                      (    forth6809.asm):02267         ; GETCHAR
                      (    forth6809.asm):02268         ;    Inputs:
                      (    forth6809.asm):02269         ;        none
                      (    forth6809.asm):02270         ;    Outputs:
                      (    forth6809.asm):02271         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02272         ;        Carry clear = character returned, set = ring empty
                      (    forth6809.asm):02273         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02274         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02275         GETCHAR:
                      (    forth6809.asm):02276                     LDB   INTAIL            ; Is the out buffer populated?
                      (    forth6809.asm):02277                     CMPB  INHEAD
                      (    forth6809.asm):02278                     BEQ   GET_NO_CHAR       ; No! Exit.
                      (    forth6809.asm):02279         
                      (    forth6809.asm):02280                     LDX   #INBUF            ; Pull character from the out buffer.
                      (    forth6809.asm):02281                     LDA   B,X               ; Output: RegA = character
                      (    forth6809.asm):02282         
                      (    forth6809.asm):02283                     INCB                    ; Update the tail pointer
                      (    forth6809.asm):02284                     ANDB  #INBUFSZ-1        ; to point to the next character.
                      (    forth6809.asm):02285                     STB   INTAIL
                      (    forth6809.asm):02286         
                      (    forth6809.asm):02287                     ; Mask IRQ so the flow-control check cannot race the
                      (    forth6809.asm):02288                     ; receive interrupt. See bugfix: GETCHAR.1
                      (    forth6809.asm):02289                     ORCC  #$10
                      (    forth6809.asm):02290                     LDB   INHEAD            ; Calculate current fill level fresh -
                      (    forth6809.asm):02291                     SUBB  INTAIL            ; both pointers may have moved since
                      (    forth6809.asm):02292                     ANDB  #INBUFSZ-1        ; the ISR last ran, so (unlike INCHAR)
                      (    forth6809.asm):02293                                             ; there's no already-loaded value here
                      (    forth6809.asm):02294                                             ; worth reusing.
                      (    forth6809.asm):02295                     JSR   CHKLO
                      (    forth6809.asm):02296                     ANDCC #$EF
                      (    forth6809.asm):02297         
                      (    forth6809.asm):02298                     ANDCC #$FE              ; Carry flag %0 = valid character
                      (    forth6809.asm):02299                     RTS
                      (    forth6809.asm):02300         
D26F                  (    forth6809.asm):02301         GET_NO_CHAR:
                      (    forth6809.asm):02302                     ORCC  #$01              ; Carry flag %1 = no valid character.
                      (    forth6809.asm):02303                     RTS
                      (    forth6809.asm):02304         ; ------------------------------------------------------------
                      (    forth6809.asm):02305         ; Raise RTS (accept input again) once the input ring has drained
                      (    forth6809.asm):02306         ; to INLOWATER or below, re-enabling the Tx interrupt if output is
                      (    forth6809.asm):02307         ; pending. Called from mainline code, so IRQ is masked while it runs.
                      (    forth6809.asm):02308         ; RTSCHECKLO
                      (    forth6809.asm):02309         ;    Inputs:
                      (    forth6809.asm):02310         ;        none
                      (    forth6809.asm):02311         ;    Outputs:
                      (    forth6809.asm):02312         ;        RTSSTATE = 0 and ACIACR rewritten if RTS was high and the ring is low
                      (    forth6809.asm):02313         ;    Registers: RegA, RegB and CC changed.
                      (    forth6809.asm):02314         ; Original comment: shadow RTSCHECKLO.0.
                      (    forth6809.asm):02315         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02316         RTSCHECKLO:
                      (    forth6809.asm):02317                     ORCC  #$10              ; mask IRQ for the critical section
                      (    forth6809.asm):02318         
                      (    forth6809.asm):02319                     JSR   INFILL
                      (    forth6809.asm):02320                     CMPA  #INLOWATER
                      (    forth6809.asm):02321                     BHI   RTSCLODONE
                      (    forth6809.asm):02322                     TST   RTSSTATE
                      (    forth6809.asm):02323                     BEQ   RTSCLODONE        ; already low - nothing to do
                      (    forth6809.asm):02324         
                      (    forth6809.asm):02325         
                      (    forth6809.asm):02326                     CLR   RTSSTATE          ; Set flag asserting acceptance of chars
                      (    forth6809.asm):02327         
                      (    forth6809.asm):02328                     LDB   OUTTAIL           ; Check if chars are available.
                      (    forth6809.asm):02329                     CMPB  OUTHEAD
                      (    forth6809.asm):02330                     BEQ   RTSCLONOTX        ; No! Just configure the ACIA to accept chars.
                      (    forth6809.asm):02331         
                      (    forth6809.asm):02332                     LDA   #CR_RXTX          ; Yes! Configure the ACIA to accept chars.
                      (    forth6809.asm):02333                     STA   ACIACR            ; & to generate transmit slot available interrupts.
                      (    forth6809.asm):02334                     BRA   RTSCLOUNMASK
                      (    forth6809.asm):02335         
D26F                  (    forth6809.asm):02336         RTSCLONOTX: LDA   #CR_RXON          ; Configure the ACIA to accept chars.
                      (    forth6809.asm):02337                     STA   ACIACR
                      (    forth6809.asm):02338         
D26F                  (    forth6809.asm):02339         RTSCLOUNMASK:
                      (    forth6809.asm):02340                     ANDCC #$EF
                      (    forth6809.asm):02341         
D26F                  (    forth6809.asm):02342         RTSCLODONE: RTS
                      (    forth6809.asm):02343         
                      (    forth6809.asm):02344         ; ------------------------------------------------------------
                      (    forth6809.asm):02345         ; ACIA (6850) interrupt handler (SERIALPOLL=0). Services received
                      (    forth6809.asm):02346         ; characters (into the input ring, counting framing, overrun and
                      (    forth6809.asm):02347         ; parity errors) and transmit-ready (from the output ring), with a
                      (    forth6809.asm):02348         ; single exit point. IRQ is hardware-masked while it runs.
                      (    forth6809.asm):02349         ; IRQH
                      (    forth6809.asm):02350         ;    Inputs:
                      (    forth6809.asm):02351         ;        none (hardware interrupt entry)
                      (    forth6809.asm):02352         ;    Outputs:
                      (    forth6809.asm):02353         ;        none (returns with RTI)
                      (    forth6809.asm):02354         ;    Registers: all registers are saved and restored by the interrupt.
                      (    forth6809.asm):02355         ; Original comment: shadow IRQH.0.
                      (    forth6809.asm):02356         ; ------------------------------------------------------------
D26F                  (    forth6809.asm):02357         IRQH:       LDA   ACIASR            ; Get the status.
                      (    forth6809.asm):02358         
                      (    forth6809.asm):02359                     BITA  #SR_IRQ           ; Is the ACIA the interrupt source?
                      (    forth6809.asm):02360                     BEQ   IRQDONE0          ; No! Just exit.
                      (    forth6809.asm):02361                     BITA  #SR_RDRF          ; Is an incoming character available?
                      (    forth6809.asm):02362                     BNE   INCHAR
                      (    forth6809.asm):02363                     BITA  #SR_TDRE          ; Is the slot for an outgoing character available?
                      (    forth6809.asm):02364                     BNE   OUTCHAR
                      (    forth6809.asm):02365                                             ; Ignore all other interrupts such as DCD change.
D26F                  (    forth6809.asm):02366         IRQDONE0:   RTI                     ; Single point of exit - re-enables interrupts
                      (    forth6809.asm):02367                                             ; & restores state.
                      (    forth6809.asm):02368         
D26F                  (    forth6809.asm):02369         INCHAR:
                      (    forth6809.asm):02370                     LDB   ACIADR            ; Get the char & clear RDRF & error flags.
                      (    forth6809.asm):02371                     BITA  #SR_FE+SR_OVRN+SR_PE
                      (    forth6809.asm):02372                                             ; Any receiver error flagged?
                      (    forth6809.asm):02373                     BEQ   INOK              ; No! - character is good, keep it.
                      (    forth6809.asm):02374         
                      (    forth6809.asm):02375                     BITA  #SR_FE            ; Yes! char is corrupted, discard it.
                      (    forth6809.asm):02376                     BEQ   INXFE             ; Tally each flagged error independently -
                      (    forth6809.asm):02377                     INC   FECOUNT           ; more than one bit can be set at once.
D26F                  (    forth6809.asm):02378         INXFE:      BITA  #SR_OVRN
                      (    forth6809.asm):02379                     BEQ   INXOVRN
                      (    forth6809.asm):02380                     INC   OVRNCOUNT
D26F                  (    forth6809.asm):02381         INXOVRN:    BITA  #SR_PE
                      (    forth6809.asm):02382                     BEQ   INXPE
                      (    forth6809.asm):02383                     INC   PECOUNT
D26F                  (    forth6809.asm):02384         INXPE:      RTI
                      (    forth6809.asm):02385         
D26F                  (    forth6809.asm):02386         INOK:       TFR   B,A               ; Transfer good character from the receiver.
                      (    forth6809.asm):02387                     LDX   #INBUF            ; Store it in the empty in buffer slot.
                      (    forth6809.asm):02388                     LDB   INHEAD
                      (    forth6809.asm):02389                     STA   B,X
                      (    forth6809.asm):02390                     INCB                    ; Figure out the new head,
                      (    forth6809.asm):02391                     ANDB  #INBUFSZ-1        ; pointing to the next the empty in buffer slot.
                      (    forth6809.asm):02392                     CMPB  INTAIL            ; Would the new head slot meet the tail?
                      (    forth6809.asm):02393                     BEQ   IRQDONE1          ; Don't allow it - buffer full, drop the character.
                      (    forth6809.asm):02394                     STB   INHEAD            ; New head pointer is OK so store it.
                      (    forth6809.asm):02395                     ; Commented-out code moved to shadow: INCHAR.2
                      (    forth6809.asm):02396                     ; Reuse RegB (the new head) for the fill level.
                      (    forth6809.asm):02397                     ; See shadow: INCHAR.1
                      (    forth6809.asm):02398                     SUBB  INTAIL            ; RegB: new head - tail = current fill level.
                      (    forth6809.asm):02399                     ANDB  #INBUFSZ-1
                      (    forth6809.asm):02400                     JSR   CHKHI             ; Protect the in buffer from overflow.
D26F                  (    forth6809.asm):02401         IRQDONE1:   RTI
                      (    forth6809.asm):02402         
                      (    forth6809.asm):02403                     ; Commented-out code moved to shadow: OUTCHAR.1
                      (    forth6809.asm):02404         
D26F                  (    forth6809.asm):02405         OUTCHAR:    LDB   OUTTAIL           ; Is the out buffer empty?
                      (    forth6809.asm):02406                     CMPB  OUTHEAD
                      (    forth6809.asm):02407                     BEQ   TXOFF             ; Yes! Stop transmitting.
                      (    forth6809.asm):02408         
                      (    forth6809.asm):02409                     LDX   #OUTBUF           ; No! The out buffer is occupied.
                      (    forth6809.asm):02410                     LDA   B,X               ; Get the character from the out buffer.
                      (    forth6809.asm):02411                     STA   ACIADR            ; Transmit the char.
                      (    forth6809.asm):02412         
                      (    forth6809.asm):02413                     INCB                    ; Update the tail pointer pointing to the next char.
                      (    forth6809.asm):02414                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):02415                     STB   OUTTAIL
D26F                  (    forth6809.asm):02416         IRQDONE2    RTI
                      (    forth6809.asm):02417         
D26F                  (    forth6809.asm):02418         TXOFF:                              ; The output ring is empty.
                      (    forth6809.asm):02419                     ; Commented-out code moved to shadow: TXOFF.1
                      (    forth6809.asm):02420                     CLR   OUTACTIVITY
                      (    forth6809.asm):02421                     JSR   UPDATE_RTS
D26F                  (    forth6809.asm):02422         IRQDONE3    RTI
                      (    forth6809.asm):02423         
                      (    forth6809.asm):02424                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):02425         
D26F 3B               (    forth6809.asm):02426         IRQH:       RTI                     ; polling mode (SERIALPOLL=1) - ACIA
                      (    forth6809.asm):02427                                             ; interrupts are never enabled (see
                      (    forth6809.asm):02428                                             ; COLDSTRT's CR_POLL init), so this should
                      (    forth6809.asm):02429                                             ; never fire; kept as a safe stub matching
                      (    forth6809.asm):02430                                             ; the other unused vectors below
                      (    forth6809.asm):02431                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):02432         
                      (    forth6809.asm):02433         ; ------------------------------------------------------------
                      (    forth6809.asm):02434         ; Unused interrupt handlers: return immediately. SWIH instead
                      (    forth6809.asm):02435         ; pushes the throw code -99 and jumps to THROW.
                      (    forth6809.asm):02436         ; ------------------------------------------------------------
D270 3B               (    forth6809.asm):02437         SWI3H:      RTI
D271 3B               (    forth6809.asm):02438         SWI2H:      RTI
D272 3B               (    forth6809.asm):02439         FIRQH:      RTI
D273 3B               (    forth6809.asm):02440         NMIH:       RTI                     ; unused now that NMI -> WARM
D274 CCFF9D           (    forth6809.asm):02441         SWIH:       LDD   #-99              ; placeholder hardware-trap code; push and
D277 3606             (    forth6809.asm):02442                     PSHU  D                 ; JMP THROW, per the CATCH/THROW turn
D279 7EDCF0           (    forth6809.asm):02443                     JMP   THROWW
                      (    forth6809.asm):02444         
                      (    forth6809.asm):02445         ; ============================================================
                      (    forth6809.asm):02446         ; SECTION 4: COLD / ABORT / QUIT  (with CATCH-wrapped INTERPRET)
                      (    forth6809.asm):02447         ; ============================================================
                      (    forth6809.asm):02448         ; ------------------------------------------------------------
                      (    forth6809.asm):02449         ; Cold start: set the dictionary, code and variable pointers to
                      (    forth6809.asm):02450         ; their application areas, BASE to 10 and the input source to the
                      (    forth6809.asm):02451         ; terminal buffer, print the sign-on banner, then enter ABORT.
                      (    forth6809.asm):02452         ; COLD
                      (    forth6809.asm):02453         ;    Inputs:
                      (    forth6809.asm):02454         ;        none (entered at reset)
                      (    forth6809.asm):02455         ;    Outputs:
                      (    forth6809.asm):02456         ;        none (does not return)
                      (    forth6809.asm):02457         ;    Registers: all changed.
                      (    forth6809.asm):02458         ; ------------------------------------------------------------
D27C CC0240           (    forth6809.asm):02459         COLD:       LDD   #APPVARS
D27F DD0A             (    forth6809.asm):02460                     STD   VARHERE
D281 CC7000           (    forth6809.asm):02461                     LDD   #APPCODE
D284 DD08             (    forth6809.asm):02462                     STD   CODEHERE
D286 CC2000           (    forth6809.asm):02463                     LDD   #APPDICT
D289 DD06             (    forth6809.asm):02464                     STD   DPHERE
D28B CCD23A           (    forth6809.asm):02465                     LDD   #BASELATEST
D28E DD04             (    forth6809.asm):02466                     STD   LATEST
D290 BDD8F9           (    forth6809.asm):02467                     JSR   WLINIT            ; FORTH wordlist, search order and CURRENT
                      (    forth6809.asm):02468         
D293 CC000A           (    forth6809.asm):02469                     LDD   #10
D296 DD02             (    forth6809.asm):02470                     STD   BASE
                      (    forth6809.asm):02471         
D298 CC0106           (    forth6809.asm):02472                     LDD   #TIBBUF
D29B DD39             (    forth6809.asm):02473                     STD   SRCADDR
D29D CC0000           (    forth6809.asm):02474                     LDD   #0
D2A0 DD3B             (    forth6809.asm):02475                     STD   SRCLEN
D2A2 DD3D             (    forth6809.asm):02476                     STD   SRCID
                      (    forth6809.asm):02477         
D2A4 8ED34A           (    forth6809.asm):02478                     LDX   #SIGNON
D2A7 3610             (    forth6809.asm):02479                     PSHU  X                 ; c-addr
D2A9 CC000F           (    forth6809.asm):02480                     LDD   #SIGNONL
D2AC 3606             (    forth6809.asm):02481                     PSHU  D                 ; u
D2AE BDECE5           (    forth6809.asm):02482                     JSR   TYPEW
D2B1 BDF30E           (    forth6809.asm):02483                     JSR   CRW
D2B4 2008             (    forth6809.asm):02484                     BRA   ABORT             ; Go to ABORT, skipping the ABORTW word.
                      (    forth6809.asm):02485         
                      (    forth6809.asm):02486         ; ------------------------------------------------------------
                      (    forth6809.asm):02487         ; ABORT  ( i*x -- ) ( R: j*x -- )
                      (    forth6809.asm):02488         ; Throw -1. With no CATCH frame, THROW falls into the ABORT reset below.
                      (    forth6809.asm):02489         ; ------------------------------------------------------------
D2B6 CCFFFF           (    forth6809.asm):02490         ABORTW:     LDD   #-1
D2B9 3606             (    forth6809.asm):02491                     PSHU  D                 ; throw code (-1)
D2BB 7EDCF0           (    forth6809.asm):02492                     JMP   THROWW
                      (    forth6809.asm):02493         
                      (    forth6809.asm):02494         ; ------------------------------------------------------------
                      (    forth6809.asm):02495         ; Reset the data stack to its base, then fall through into QUITW.
                      (    forth6809.asm):02496         ; ABORT
                      (    forth6809.asm):02497         ;    Inputs:
                      (    forth6809.asm):02498         ;        none
                      (    forth6809.asm):02499         ;    Outputs:
                      (    forth6809.asm):02500         ;        none (does not return)
                      (    forth6809.asm):02501         ;    Registers: RegU changed.
                      (    forth6809.asm):02502         ; ------------------------------------------------------------
D2BE CEBD00           (    forth6809.asm):02503         ABORT:      LDU   #SP0
                      (    forth6809.asm):02504                     ; falls through into QUIT
                      (    forth6809.asm):02505         
                      (    forth6809.asm):02506         ; ------------------------------------------------------------
                      (    forth6809.asm):02507         ; QUIT  ( -- ) ( R: i*x -- )
                      (    forth6809.asm):02508         ; Empty the return stack, set interpretation state, then loop reading
                      (    forth6809.asm):02509         ; a line and interpreting it under CATCH. Errors are reported as
                      (    forth6809.asm):02510         ; "ERROR n"; -1 (ABORT) is silent. Never returns.
                      (    forth6809.asm):02511         ; ------------------------------------------------------------
D2C1 10CEC000         (    forth6809.asm):02512         QUITW:      LDS   #RP0
D2C5 CC0000           (    forth6809.asm):02513                     LDD   #0
D2C8 DD00             (    forth6809.asm):02514                     STD   STATE             ; See bugfix: QUITW.1
                      (    forth6809.asm):02515         
D2CA BDDC9B           (    forth6809.asm):02516         QLOOP:      JSR   QUERYW
                      (    forth6809.asm):02517         
D2CD DC06             (    forth6809.asm):02518                     LDD   DPHERE            ; Checkpoint on the return stack. CATCH
D2CF 3406             (    forth6809.asm):02519                     PSHS  D                 ; and THROW restore S, so the frame is
D2D1 DC08             (    forth6809.asm):02520                     LDD   CODEHERE          ; intact whichever way INTERPRET ends.
D2D3 3406             (    forth6809.asm):02521                     PSHS  D                 ; See shadow QLOOP.2
D2D5 DC0A             (    forth6809.asm):02522                     LDD   VARHERE
D2D7 3406             (    forth6809.asm):02523                     PSHS  D
D2D9 DC04             (    forth6809.asm):02524                     LDD   LATEST
D2DB 3406             (    forth6809.asm):02525                     PSHS  D
                      (    forth6809.asm):02526         
D2DD CCD723           (    forth6809.asm):02527                     LDD   #INTERPRET
D2E0 3606             (    forth6809.asm):02528                     PSHU  D                 ; xt
D2E2 BDDCC4           (    forth6809.asm):02529                     JSR   CATCHW
D2E5 3706             (    forth6809.asm):02530                     PULU  D                 ; throw code (0 = no error)
D2E7 3406             (    forth6809.asm):02531                     PSHS  D                 ; frame: 0,S code  2,S LATEST  4,S VARHERE
D2E9 10830000         (    forth6809.asm):02532                     CMPD  #0                ;        6,S CODEHERE  8,S DPHERE
D2ED 2743             (    forth6809.asm):02533                     BEQ   QOK
                      (    forth6809.asm):02534         
D2EF EC68             (    forth6809.asm):02535                     LDD   8,S
D2F1 DD06             (    forth6809.asm):02536                     STD   DPHERE
D2F3 BDD91A           (    forth6809.asm):02537                     JSR   PRUNE             ; unlink headers newer than DPHERE
D2F6 EC66             (    forth6809.asm):02538                     LDD   6,S
D2F8 DD08             (    forth6809.asm):02539                     STD   CODEHERE
D2FA EC64             (    forth6809.asm):02540                     LDD   4,S
D2FC DD0A             (    forth6809.asm):02541                     STD   VARHERE
D2FE EC62             (    forth6809.asm):02542                     LDD   2,S
D300 DD04             (    forth6809.asm):02543                     STD   LATEST
D302 CEBD00           (    forth6809.asm):02544                     LDU   #SP0
                      (    forth6809.asm):02545         
                      (    forth6809.asm):02546                     ; Return to interpretation state after a caught error.
                      (    forth6809.asm):02547                     ; See bugfix: QLOOP.1
D305 CC0000           (    forth6809.asm):02548                     LDD   #0
D308 DD00             (    forth6809.asm):02549                     STD   STATE
                      (    forth6809.asm):02550         
D30A ECE4             (    forth6809.asm):02551                     LDD   ,S                ; -1 is ABORT: reset silently, no "ERROR -1"
D30C 1083FFFF         (    forth6809.asm):02552                     CMPD  #-1
D310 2605             (    forth6809.asm):02553                     BNE   QSHOWERR
D312 326A             (    forth6809.asm):02554                     LEAS  10,S              ; drop the frame
D314 16FFB3           (    forth6809.asm):02555                     LBRA  QLOOP
                      (    forth6809.asm):02556         
D317 BDF30E           (    forth6809.asm):02557         QSHOWERR:   JSR   CRW
D31A 8ED35D           (    forth6809.asm):02558                     LDX   #ERRMSG
D31D 3610             (    forth6809.asm):02559                     PSHU  X                 ; c-addr
D31F CC0008           (    forth6809.asm):02560                     LDD   #ERRMSGL
D322 3606             (    forth6809.asm):02561                     PSHU  D                 ; u
D324 BDECE5           (    forth6809.asm):02562                     JSR   TYPEW
D327 ECE4             (    forth6809.asm):02563                     LDD   ,S
D329 3606             (    forth6809.asm):02564                     PSHU  D                 ; n
D32B BDF1DD           (    forth6809.asm):02565                     JSR   DOTW
D32E 326A             (    forth6809.asm):02566                     LEAS  10,S              ; drop the frame
D330 2098             (    forth6809.asm):02567                     BRA   QLOOP
                      (    forth6809.asm):02568         
D332 326A             (    forth6809.asm):02569         QOK:        LEAS  10,S              ; drop the frame
D334 BDF30E           (    forth6809.asm):02570                     JSR   CRW               ; See bugfix: QOK.1
D337 DC00             (    forth6809.asm):02571                     LDD   STATE
D339 268F             (    forth6809.asm):02572                     BNE   QLOOP
D33B 8ED359           (    forth6809.asm):02573                     LDX   #OKMSG
D33E 3610             (    forth6809.asm):02574                     PSHU  X                 ; c-addr
D340 CC0004           (    forth6809.asm):02575                     LDD   #OKMSGL
D343 3606             (    forth6809.asm):02576                     PSHU  D                 ; u
D345 BDECE5           (    forth6809.asm):02577                     JSR   TYPEW
D348 2080             (    forth6809.asm):02578                     BRA   QLOOP
                      (    forth6809.asm):02579         
D34A 3638303920464F52 (    forth6809.asm):02580         SIGNON:     FCC   "6809 FORTH v1.0"
     54482076312E30
     000F             (    forth6809.asm):02581         SIGNONL     EQU   *-SIGNON
D359 20206F6B         (    forth6809.asm):02582         OKMSG:      FCC   "  ok"
     0004             (    forth6809.asm):02583         OKMSGL      EQU   *-OKMSG
D35D 20204552524F5220 (    forth6809.asm):02584         ERRMSG:     FCC   "  ERROR "
     0008             (    forth6809.asm):02585         ERRMSGL     EQU   *-ERRMSG
                      (    forth6809.asm):02586         
                      (    forth6809.asm):02587         ; ============================================================
                      (    forth6809.asm):02588         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02589         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02590         ; ============================================================
                      (    forth6809.asm):02591         ; ------------------------------------------------------------
                      (    forth6809.asm):02592         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02593         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02594         ; LIT   ( -- x )
                      (    forth6809.asm):02595         ;    Inputs:
                      (    forth6809.asm):02596         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02597         ;    Outputs:
                      (    forth6809.asm):02598         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02599         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02600         ; ------------------------------------------------------------
D365 3510             (    forth6809.asm):02601         LIT:        PULS  X
D367 EC81             (    forth6809.asm):02602                     LDD   ,X++
D369 3606             (    forth6809.asm):02603                     PSHU  D                 ; x
D36B 3410             (    forth6809.asm):02604                     PSHS  X
D36D 39               (    forth6809.asm):02605                     RTS
                      (    forth6809.asm):02606         
                      (    forth6809.asm):02607         ; ------------------------------------------------------------
                      (    forth6809.asm):02608         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02609         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02610         ; address.
                      (    forth6809.asm):02611         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02612         ;    Inputs:
                      (    forth6809.asm):02613         ;        flag on the data stack
                      (    forth6809.asm):02614         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02615         ;    Outputs:
                      (    forth6809.asm):02616         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02617         ;        the offset
                      (    forth6809.asm):02618         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02619         ; ------------------------------------------------------------
D36E 3706             (    forth6809.asm):02620         ZBRANCH:    PULU  D                 ; flag
D370 3510             (    forth6809.asm):02621                     PULS  X
D372 10830000         (    forth6809.asm):02622                     CMPD  #0
D376 2607             (    forth6809.asm):02623                     BNE   ZSKIP
D378 EC84             (    forth6809.asm):02624                     LDD   ,X
D37A 308B             (    forth6809.asm):02625                     LEAX  D,X
D37C 3410             (    forth6809.asm):02626                     PSHS  X
D37E 39               (    forth6809.asm):02627                     RTS
D37F 3002             (    forth6809.asm):02628         ZSKIP:      LEAX  2,X
D381 3410             (    forth6809.asm):02629                     PSHS  X
D383 39               (    forth6809.asm):02630                     RTS
                      (    forth6809.asm):02631         
                      (    forth6809.asm):02632         ; ------------------------------------------------------------
                      (    forth6809.asm):02633         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02634         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02635         ; BRANCH
                      (    forth6809.asm):02636         ;    Inputs:
                      (    forth6809.asm):02637         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02638         ;    Outputs:
                      (    forth6809.asm):02639         ;        return address set to the branch target
                      (    forth6809.asm):02640         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02641         ; ------------------------------------------------------------
D384 3510             (    forth6809.asm):02642         BRANCH:     PULS  X
D386 EC84             (    forth6809.asm):02643                     LDD   ,X
D388 308B             (    forth6809.asm):02644                     LEAX  D,X
D38A 3410             (    forth6809.asm):02645                     PSHS  X
D38C 39               (    forth6809.asm):02646                     RTS
                      (    forth6809.asm):02647         
                      (    forth6809.asm):02648         ; ------------------------------------------------------------
                      (    forth6809.asm):02649         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02650         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02651         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02652         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02653         ;    Inputs:
                      (    forth6809.asm):02654         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02655         ;        trampoline
                      (    forth6809.asm):02656         ;    Outputs:
                      (    forth6809.asm):02657         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02658         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
D38D 3510             (    forth6809.asm):02660         DODOES:     PULS  X
D38F 10AE81           (    forth6809.asm):02661                     LDY   ,X++
D392 EC84             (    forth6809.asm):02662                     LDD   ,X
D394 3606             (    forth6809.asm):02663                     PSHU  D                 ; pfa
D396 6EA4             (    forth6809.asm):02664                     JMP   ,Y
                      (    forth6809.asm):02665         
                      (    forth6809.asm):02666         ; ------------------------------------------------------------
                      (    forth6809.asm):02667         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02668         ; field address on the stack.
                      (    forth6809.asm):02669         ; DOESRT0
                      (    forth6809.asm):02670         ;    Inputs:
                      (    forth6809.asm):02671         ;        none
                      (    forth6809.asm):02672         ;    Outputs:
                      (    forth6809.asm):02673         ;        none
                      (    forth6809.asm):02674         ;    Registers: none.
                      (    forth6809.asm):02675         ; ------------------------------------------------------------
D398 39               (    forth6809.asm):02676         DOESRT0:    RTS
                      (    forth6809.asm):02677         
                      (    forth6809.asm):02678         ; ------------------------------------------------------------
                      (    forth6809.asm):02679         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02680         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02681         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02682         ; SETDOES
                      (    forth6809.asm):02683         ;    Inputs:
                      (    forth6809.asm):02684         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02685         ;        BEHAVIOR)
                      (    forth6809.asm):02686         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02687         ;        address
                      (    forth6809.asm):02688         ;    Outputs:
                      (    forth6809.asm):02689         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02690         ;        defining word's caller
                      (    forth6809.asm):02691         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02692         ; ------------------------------------------------------------
D399 3510             (    forth6809.asm):02693         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D39B 1F12             (    forth6809.asm):02694                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02695         
D39D 9E04             (    forth6809.asm):02696                     LDX   LATEST
D39F E684             (    forth6809.asm):02697                     LDB   ,X
D3A1 C41F             (    forth6809.asm):02698                     ANDB  #$1F
D3A3 4F               (    forth6809.asm):02699                     CLRA
D3A4 308B             (    forth6809.asm):02700                     LEAX  D,X               ; header + name length
D3A6 EC03             (    forth6809.asm):02701                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D3A8 C30003           (    forth6809.asm):02702                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D3AB 1F01             (    forth6809.asm):02703                     TFR   D,X
                      (    forth6809.asm):02704         
D3AD 10AF84           (    forth6809.asm):02705                     STY   ,X                ; patch it
                      (    forth6809.asm):02706         
D3B0 3510             (    forth6809.asm):02707                     PULS  X                 ; X = the OUTER defining word's own return addr
D3B2 6E84             (    forth6809.asm):02708                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02709         
                      (    forth6809.asm):02710         ; ------------------------------------------------------------
                      (    forth6809.asm):02711         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02712         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02713         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02714         ;    Inputs:
                      (    forth6809.asm):02715         ;        pfa on the data stack
                      (    forth6809.asm):02716         ;    Outputs:
                      (    forth6809.asm):02717         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02718         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
D3B4 3710             (    forth6809.asm):02720         DODEFER:    PULU  X                 ; pfa
D3B6 EC84             (    forth6809.asm):02721                     LDD   ,X
D3B8 1F01             (    forth6809.asm):02722                     TFR   D,X
D3BA 6E84             (    forth6809.asm):02723                     JMP   ,X
                      (    forth6809.asm):02724         
                      (    forth6809.asm):02725         ; ------------------------------------------------------------
                      (    forth6809.asm):02726         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02727         ; DOABORTUNDEF
                      (    forth6809.asm):02728         ;    Inputs:
                      (    forth6809.asm):02729         ;        none
                      (    forth6809.asm):02730         ;    Outputs:
                      (    forth6809.asm):02731         ;        none (does not return)
                      (    forth6809.asm):02732         ;    Registers: RegD changed.
                      (    forth6809.asm):02733         ; ------------------------------------------------------------
D3BC                  (    forth6809.asm):02734         DOABORTUNDEF:
D3BC CCFFEB           (    forth6809.asm):02735                     LDD   #-21
D3BF 3606             (    forth6809.asm):02736                     PSHU  D                 ; throw code (-21)
D3C1 7EDCF0           (    forth6809.asm):02737                     JMP   THROWW
                      (    forth6809.asm):02738         
                      (    forth6809.asm):02739         ; ------------------------------------------------------------
                      (    forth6809.asm):02740         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02741         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02742         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02743         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02744         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02745         ;    Inputs:
                      (    forth6809.asm):02746         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02747         ;    Outputs:
                      (    forth6809.asm):02748         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02749         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02750         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02751         ; ------------------------------------------------------------
D3C4 3710             (    forth6809.asm):02752         DOMARKER:   PULU  X                 ; pfa
D3C6 EC84             (    forth6809.asm):02753                     LDD   ,X
D3C8 DD06             (    forth6809.asm):02754                     STD   DPHERE
D3CA EC02             (    forth6809.asm):02755                     LDD   2,X
D3CC DD08             (    forth6809.asm):02756                     STD   CODEHERE
D3CE EC04             (    forth6809.asm):02757                     LDD   4,X
D3D0 DD0A             (    forth6809.asm):02758                     STD   VARHERE
D3D2 EC06             (    forth6809.asm):02759                     LDD   6,X
D3D4 DD04             (    forth6809.asm):02760                     STD   LATEST
D3D6 3008             (    forth6809.asm):02761                     LEAX  8,X               ; the saved search-order state follows
D3D8 108E0045         (    forth6809.asm):02762                     LDY   #SRCHSAVE
D3DC C616             (    forth6809.asm):02763                     LDB   #SRCHSAVESZ
D3DE A680             (    forth6809.asm):02764         DMCOPY:     LDA   ,X+
D3E0 A7A0             (    forth6809.asm):02765                     STA   ,Y+
D3E2 5A               (    forth6809.asm):02766                     DECB
D3E3 26F9             (    forth6809.asm):02767                     BNE   DMCOPY
D3E5 DC06             (    forth6809.asm):02768                     LDD   DPHERE
D3E7 7ED91A           (    forth6809.asm):02769                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02770         
                      (    forth6809.asm):02771         ; ------------------------------------------------------------
                      (    forth6809.asm):02772         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02773         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02774         ; ------------------------------------------------------------
D3EA 3710             (    forth6809.asm):02775         EXECUTEW:   PULU  X                 ; xt
D3EC AD84             (    forth6809.asm):02776                     JSR   ,X
D3EE 39               (    forth6809.asm):02777                     RTS
                      (    forth6809.asm):02778         
                      (    forth6809.asm):02779         ; ============================================================
                      (    forth6809.asm):02780         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02781         ; ============================================================
                      (    forth6809.asm):02782         ; ------------------------------------------------------------
                      (    forth6809.asm):02783         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02784         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02785         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02786         ;    Inputs:
                      (    forth6809.asm):02787         ;        RegX = address of the here pointer
                      (    forth6809.asm):02788         ;        x on the data stack
                      (    forth6809.asm):02789         ;    Outputs:
                      (    forth6809.asm):02790         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02791         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02792         ; ------------------------------------------------------------
D3EF 3706             (    forth6809.asm):02793         APPENDCELL: PULU  D                 ; x
D3F1 10AE84           (    forth6809.asm):02794                     LDY   ,X
D3F4 EDA1             (    forth6809.asm):02795                     STD   ,Y++
D3F6 10AF84           (    forth6809.asm):02796                     STY   ,X
D3F9 39               (    forth6809.asm):02797                     RTS
                      (    forth6809.asm):02798         
                      (    forth6809.asm):02799         ; ------------------------------------------------------------
                      (    forth6809.asm):02800         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02801         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02802         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02803         ;    Inputs:
                      (    forth6809.asm):02804         ;        RegX = address of the here pointer
                      (    forth6809.asm):02805         ;        char on the data stack
                      (    forth6809.asm):02806         ;    Outputs:
                      (    forth6809.asm):02807         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02808         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02809         ; ------------------------------------------------------------
D3FA 3706             (    forth6809.asm):02810         APPENDBYTE: PULU  D                 ; char
D3FC 10AE84           (    forth6809.asm):02811                     LDY   ,X
D3FF E7A0             (    forth6809.asm):02812                     STB   ,Y+
D401 10AF84           (    forth6809.asm):02813                     STY   ,X
D404 39               (    forth6809.asm):02814                     RTS
                      (    forth6809.asm):02815         
                      (    forth6809.asm):02816         ; ------------------------------------------------------------
                      (    forth6809.asm):02817         ; ,  ( x -- )
                      (    forth6809.asm):02818         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02819         ; ------------------------------------------------------------
D405 8E0008           (    forth6809.asm):02820         COMMAW:     LDX   #CODEHERE
D408 7ED3EF           (    forth6809.asm):02821                     JMP   APPENDCELL
                      (    forth6809.asm):02822         
                      (    forth6809.asm):02823         ; ------------------------------------------------------------
                      (    forth6809.asm):02824         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02825         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02826         ; ------------------------------------------------------------
D40B 8E0008           (    forth6809.asm):02827         CODECOMMA:  LDX   #CODEHERE
D40E 7ED3EF           (    forth6809.asm):02828                     JMP   APPENDCELL
                      (    forth6809.asm):02829         
                      (    forth6809.asm):02830         ; ------------------------------------------------------------
                      (    forth6809.asm):02831         ; C,  ( char -- )
                      (    forth6809.asm):02832         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02833         ; ------------------------------------------------------------
D411 8E0008           (    forth6809.asm):02834         CCOMMAW:    LDX   #CODEHERE
D414 7ED3FA           (    forth6809.asm):02835                     JMP   APPENDBYTE
                      (    forth6809.asm):02836         
                      (    forth6809.asm):02837         ; ------------------------------------------------------------
                      (    forth6809.asm):02838         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02839         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02840         ; ------------------------------------------------------------
D417 8E0008           (    forth6809.asm):02841         CCOMMA1:    LDX   #CODEHERE
D41A 7ED3FA           (    forth6809.asm):02842                     JMP   APPENDBYTE
                      (    forth6809.asm):02843         
                      (    forth6809.asm):02844         ; ------------------------------------------------------------
                      (    forth6809.asm):02845         ; V,  ( x -- )
                      (    forth6809.asm):02846         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02847         ; ------------------------------------------------------------
D41D 8E000A           (    forth6809.asm):02848         VCOMMAW:    LDX   #VARHERE
D420 7ED3EF           (    forth6809.asm):02849                     JMP   APPENDCELL
                      (    forth6809.asm):02850         
                      (    forth6809.asm):02851         ; ------------------------------------------------------------
                      (    forth6809.asm):02852         ; VC,  ( char -- )
                      (    forth6809.asm):02853         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02854         ; ------------------------------------------------------------
D423 8E000A           (    forth6809.asm):02855         VCCOMMAW:   LDX   #VARHERE
D426 7ED3FA           (    forth6809.asm):02856                     JMP   APPENDBYTE
                      (    forth6809.asm):02857         
                      (    forth6809.asm):02858         ; ------------------------------------------------------------
                      (    forth6809.asm):02859         ; ALLOT  ( n -- )
                      (    forth6809.asm):02860         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02861         ; ------------------------------------------------------------
D429 3706             (    forth6809.asm):02862         ALLOTW:     PULU  D                 ; n
D42B 9E08             (    forth6809.asm):02863                     LDX   CODEHERE
D42D 308B             (    forth6809.asm):02864                     LEAX  D,X
D42F 9F08             (    forth6809.asm):02865                     STX   CODEHERE
D431 39               (    forth6809.asm):02866                     RTS
                      (    forth6809.asm):02867         
                      (    forth6809.asm):02868         ; ------------------------------------------------------------
                      (    forth6809.asm):02869         ; VALLOT  ( n -- )
                      (    forth6809.asm):02870         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02871         ; ------------------------------------------------------------
D432 3706             (    forth6809.asm):02872         VALLOTW:    PULU  D                 ; n
D434 9E0A             (    forth6809.asm):02873                     LDX   VARHERE
D436 308B             (    forth6809.asm):02874                     LEAX  D,X
D438 9F0A             (    forth6809.asm):02875                     STX   VARHERE
D43A 39               (    forth6809.asm):02876                     RTS
                      (    forth6809.asm):02877         
                      (    forth6809.asm):02878         ; ------------------------------------------------------------
                      (    forth6809.asm):02879         ; HERE  ( -- addr )
                      (    forth6809.asm):02880         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02881         ; ------------------------------------------------------------
D43B DC08             (    forth6809.asm):02882         HEREW:      LDD   CODEHERE
D43D 3606             (    forth6809.asm):02883                     PSHU  D                 ; addr
D43F 39               (    forth6809.asm):02884                     RTS
                      (    forth6809.asm):02885         
                      (    forth6809.asm):02886         ; ------------------------------------------------------------
                      (    forth6809.asm):02887         ; VHERE  ( -- addr )
                      (    forth6809.asm):02888         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02889         ; ------------------------------------------------------------
D440 DC0A             (    forth6809.asm):02890         VHEREW:     LDD   VARHERE
D442 3606             (    forth6809.asm):02891                     PSHU  D                 ; addr
D444 39               (    forth6809.asm):02892                     RTS
                      (    forth6809.asm):02893         
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
                      (    forth6809.asm):02895         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02896         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02897         ; ------------------------------------------------------------
D445 DC08             (    forth6809.asm):02898         PADW:       LDD   CODEHERE
D447 C30080           (    forth6809.asm):02899                     ADDD  #PADOFFSET
D44A 3606             (    forth6809.asm):02900                     PSHU  D                 ; c-addr
D44C 39               (    forth6809.asm):02901                     RTS
                      (    forth6809.asm):02902         
                      (    forth6809.asm):02903         ; ------------------------------------------------------------
                      (    forth6809.asm):02904         ; UNUSED  ( -- u )
                      (    forth6809.asm):02905         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02906         ; ------------------------------------------------------------
D44D CCB900           (    forth6809.asm):02907         UNUSEDW:    LDD   #CODETOP
D450 9308             (    forth6809.asm):02908                     SUBD  CODEHERE
D452 3606             (    forth6809.asm):02909                     PSHU  D                 ; u
D454 39               (    forth6809.asm):02910                     RTS
                      (    forth6809.asm):02911         
                      (    forth6809.asm):02912         ; ------------------------------------------------------------
                      (    forth6809.asm):02913         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02914         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02915         ; ------------------------------------------------------------
D455 CC1FFF           (    forth6809.asm):02916         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D458 930A             (    forth6809.asm):02917                     SUBD  VARHERE
D45A 3606             (    forth6809.asm):02918                     PSHU  D                 ; u
D45C 39               (    forth6809.asm):02919                     RTS
                      (    forth6809.asm):02920         
                      (    forth6809.asm):02921         ; ============================================================
                      (    forth6809.asm):02922         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02923         ; ============================================================
                      (    forth6809.asm):02924         ; ------------------------------------------------------------
                      (    forth6809.asm):02925         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02926         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02927         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02928         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02929         ; wordlist are updated.
                      (    forth6809.asm):02930         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02931         ;    Inputs:
                      (    forth6809.asm):02932         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02933         ;        name parsed from the input stream
                      (    forth6809.asm):02934         ;    Outputs:
                      (    forth6809.asm):02935         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02936         ;        LATEST = address of the new header
                      (    forth6809.asm):02937         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02938         ; ------------------------------------------------------------
D45D CC0020           (    forth6809.asm):02939         HEADER:     LDD   #32
D460 3606             (    forth6809.asm):02940                     PSHU  D
D462 BDD7A3           (    forth6809.asm):02941                     JSR   WORDW
D465 3710             (    forth6809.asm):02942                     PULU  X                 ; c-addr of the name
D467 3706             (    forth6809.asm):02943                     PULU  D                 ; smudge flag in B
D469 A680             (    forth6809.asm):02944                     LDA   ,X+               ; name length, X = name text
D46B 3402             (    forth6809.asm):02945                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D46D 5D               (    forth6809.asm):02946                     TSTB
D46E 2702             (    forth6809.asm):02947                     BEQ   HDNOSM
D470 8A40             (    forth6809.asm):02948                     ORA   #$40
D472 109E06           (    forth6809.asm):02949         HDNOSM:     LDY   DPHERE
D475 3420             (    forth6809.asm):02950                     PSHS  Y                 ; 0,S = address of the new header
D477 A7A0             (    forth6809.asm):02951                     STA   ,Y+
D479 E662             (    forth6809.asm):02952                     LDB   2,S
D47B 2707             (    forth6809.asm):02953                     BEQ   HDNONM
D47D A680             (    forth6809.asm):02954         HDCPY:      LDA   ,X+
D47F A7A0             (    forth6809.asm):02955                     STA   ,Y+
D481 5A               (    forth6809.asm):02956                     DECB
D482 26F9             (    forth6809.asm):02957                     BNE   HDCPY
D484 9E47             (    forth6809.asm):02958         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D486 EC84             (    forth6809.asm):02959                     LDD   ,X
D488 EDA1             (    forth6809.asm):02960                     STD   ,Y++              ; LINK = old head of that wordlist
D48A DC08             (    forth6809.asm):02961                     LDD   CODEHERE
D48C EDA1             (    forth6809.asm):02962                     STD   ,Y++
D48E 109F06           (    forth6809.asm):02963                     STY   DPHERE
D491 3506             (    forth6809.asm):02964                     PULS  D
D493 DD04             (    forth6809.asm):02965                     STD   LATEST            ; LATEST = newest header of any wordlist
D495 ED84             (    forth6809.asm):02966                     STD   ,X                ; and the new head of the CURRENT wordlist
D497 3261             (    forth6809.asm):02967                     LEAS  1,S
D499 39               (    forth6809.asm):02968                     RTS
                      (    forth6809.asm):02969         
                      (    forth6809.asm):02970         ; ------------------------------------------------------------
                      (    forth6809.asm):02971         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):02972         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):02973         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):02974         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):02975         ; SMUDGE   ( -- )
                      (    forth6809.asm):02976         ;    Inputs:
                      (    forth6809.asm):02977         ;        none
                      (    forth6809.asm):02978         ;    Outputs:
                      (    forth6809.asm):02979         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):02980         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):02981         ; ------------------------------------------------------------
D49A 9E04             (    forth6809.asm):02982         SMUDGEW:    LDX   LATEST
D49C A684             (    forth6809.asm):02983                     LDA   ,X
D49E 8840             (    forth6809.asm):02984                     EORA  #$40
D4A0 A784             (    forth6809.asm):02985                     STA   ,X
D4A2 39               (    forth6809.asm):02986                     RTS
                      (    forth6809.asm):02987         
                      (    forth6809.asm):02988         ; ============================================================
                      (    forth6809.asm):02989         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):02990         ; ============================================================
                      (    forth6809.asm):02991         ; ------------------------------------------------------------
                      (    forth6809.asm):02992         ; :  ( "name" -- )
                      (    forth6809.asm):02993         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):02994         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):02995         ; CSP and enter compile state.
                      (    forth6809.asm):02996         ; ------------------------------------------------------------
D4A3 CCFFFF           (    forth6809.asm):02997         COLONW:     LDD   #TRUEV
D4A6 3606             (    forth6809.asm):02998                     PSHU  D
D4A8 BDD45D           (    forth6809.asm):02999                     JSR   HEADER
D4AB DC08             (    forth6809.asm):03000                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D4AD DD1F             (    forth6809.asm):03001                     STD   CURXT             ; See bugfix: COLONW.1
D4AF 1F30             (    forth6809.asm):03002                     TFR   U,D
D4B1 DD21             (    forth6809.asm):03003                     STD   CSP
D4B3 CCFFFF           (    forth6809.asm):03004                     LDD   #-1
D4B6 DD00             (    forth6809.asm):03005                     STD   STATE
D4B8 39               (    forth6809.asm):03006                     RTS
                      (    forth6809.asm):03007         
                      (    forth6809.asm):03008         ; ------------------------------------------------------------
                      (    forth6809.asm):03009         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03010         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03011         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03012         ; new word and return to interpret state.
                      (    forth6809.asm):03013         ; ------------------------------------------------------------
D4B9 CC0039           (    forth6809.asm):03014         SEMIW:      LDD   #RTSOPC
D4BC 3606             (    forth6809.asm):03015                     PSHU  D
D4BE BDD417           (    forth6809.asm):03016                     JSR   CCOMMA1
D4C1 1F30             (    forth6809.asm):03017                     TFR   U,D
D4C3 109321           (    forth6809.asm):03018                     CMPD  CSP
D4C6 2703             (    forth6809.asm):03019                     BEQ   SEMIOK
D4C8 BDDCBB           (    forth6809.asm):03020                     JSR   CFERR
D4CB 9E04             (    forth6809.asm):03021         SEMIOK:     LDX   LATEST
D4CD A684             (    forth6809.asm):03022                     LDA   ,X
D4CF 84BF             (    forth6809.asm):03023                     ANDA  #$BF
D4D1 A784             (    forth6809.asm):03024                     STA   ,X
D4D3 CC0000           (    forth6809.asm):03025                     LDD   #0
D4D6 DD00             (    forth6809.asm):03026                     STD   STATE
D4D8 39               (    forth6809.asm):03027                     RTS
                      (    forth6809.asm):03028         
                      (    forth6809.asm):03029         ; ------------------------------------------------------------
                      (    forth6809.asm):03030         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03031         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03032         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03033         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03034         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03035         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03036         ; ------------------------------------------------------------
D4D9 DC08             (    forth6809.asm):03037         NONAMEW:    LDD   CODEHERE
D4DB 3606             (    forth6809.asm):03038                     PSHU  D                 ; xt
D4DD DD1F             (    forth6809.asm):03039                     STD   CURXT             ; See bugfix: NONAMEW.1
D4DF 1F30             (    forth6809.asm):03040                     TFR   U,D
D4E1 DD21             (    forth6809.asm):03041                     STD   CSP
D4E3 CCFFFF           (    forth6809.asm):03042                     LDD   #-1
D4E6 DD00             (    forth6809.asm):03043                     STD   STATE
D4E8 39               (    forth6809.asm):03044                     RTS
                      (    forth6809.asm):03045         
                      (    forth6809.asm):03046         ; ------------------------------------------------------------
                      (    forth6809.asm):03047         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03048         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03049         ; BLDDOES
                      (    forth6809.asm):03050         ;    Inputs:
                      (    forth6809.asm):03051         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03052         ;    Outputs:
                      (    forth6809.asm):03053         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03054         ;    Registers: all changed.
                      (    forth6809.asm):03055         ; BLDSELF
                      (    forth6809.asm):03056         ;    Inputs:
                      (    forth6809.asm):03057         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03058         ;    Outputs:
                      (    forth6809.asm):03059         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03060         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03061         ;    Registers: all changed.
                      (    forth6809.asm):03062         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03063         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03064         ; ------------------------------------------------------------
D4E9 3406             (    forth6809.asm):03065         BLDDOES:    PSHS  D                 ; behaviour address
D4EB CC0000           (    forth6809.asm):03066                     LDD   #0
D4EE 3606             (    forth6809.asm):03067                     PSHU  D
D4F0 BDD45D           (    forth6809.asm):03068                     JSR   HEADER
D4F3 CCD38D           (    forth6809.asm):03069                     LDD   #DODOES
D4F6 3606             (    forth6809.asm):03070                     PSHU  D
D4F8 BDE12B           (    forth6809.asm):03071                     JSR   CCALL
D4FB 3506             (    forth6809.asm):03072                     PULS  D
D4FD 3606             (    forth6809.asm):03073                     PSHU  D                 ; behaviour address
D4FF BDD40B           (    forth6809.asm):03074                     JSR   CODECOMMA
D502 39               (    forth6809.asm):03075                     RTS
                      (    forth6809.asm):03076         
D503 BDD4E9           (    forth6809.asm):03077         BLDSELF:    JSR   BLDDOES
D506 DC08             (    forth6809.asm):03078                     LDD   CODEHERE          ; PFA = the cell after this one
D508 C30002           (    forth6809.asm):03079                     ADDD  #2                ; See bugfix: CONSTANTW.1
D50B 3606             (    forth6809.asm):03080                     PSHU  D
D50D BDD40B           (    forth6809.asm):03081                     JSR   CODECOMMA
D510 39               (    forth6809.asm):03082                     RTS
                      (    forth6809.asm):03083         
                      (    forth6809.asm):03084         ; ------------------------------------------------------------
                      (    forth6809.asm):03085         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03086         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03087         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03088         ; address in the code area, on the stack.
                      (    forth6809.asm):03089         ; ------------------------------------------------------------
D511 CCD398           (    forth6809.asm):03090         CREATEW:    LDD   #DOESRT0
D514 BDD503           (    forth6809.asm):03091                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D517 39               (    forth6809.asm):03092                     RTS
                      (    forth6809.asm):03093         
                      (    forth6809.asm):03094         ; ------------------------------------------------------------
                      (    forth6809.asm):03095         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03096         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03097         ; of the word being defined.
                      (    forth6809.asm):03098         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03099         ; ------------------------------------------------------------
D518 CCD399           (    forth6809.asm):03100         DOESGTW:    LDD   #SETDOES
D51B 3606             (    forth6809.asm):03101                     PSHU  D
D51D BDE12B           (    forth6809.asm):03102                     JSR   CCALL
D520 39               (    forth6809.asm):03103                     RTS
                      (    forth6809.asm):03104         
                      (    forth6809.asm):03105         ; ------------------------------------------------------------
                      (    forth6809.asm):03106         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03107         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03108         ; area, initialised to zero.
                      (    forth6809.asm):03109         ; ------------------------------------------------------------
D521 CC0000           (    forth6809.asm):03110         VARIABLEW:  LDD   #0
D524 3606             (    forth6809.asm):03111                     PSHU  D
D526 BDD45D           (    forth6809.asm):03112                     JSR   HEADER
D529 CCD38D           (    forth6809.asm):03113                     LDD   #DODOES
D52C 3606             (    forth6809.asm):03114                     PSHU  D
D52E BDE12B           (    forth6809.asm):03115                     JSR   CCALL
D531 CCD398           (    forth6809.asm):03116                     LDD   #DOESRT0
D534 3606             (    forth6809.asm):03117                     PSHU  D
D536 BDD40B           (    forth6809.asm):03118                     JSR   CODECOMMA
D539 DC0A             (    forth6809.asm):03119                     LDD   VARHERE
D53B 3606             (    forth6809.asm):03120                     PSHU  D
D53D BDD40B           (    forth6809.asm):03121                     JSR   CODECOMMA
D540 CC0000           (    forth6809.asm):03122                     LDD   #0
D543 9E0A             (    forth6809.asm):03123                     LDX   VARHERE
D545 ED81             (    forth6809.asm):03124                     STD   ,X++
D547 9F0A             (    forth6809.asm):03125                     STX   VARHERE
D549 39               (    forth6809.asm):03126                     RTS
                      (    forth6809.asm):03127         
                      (    forth6809.asm):03128         ; ------------------------------------------------------------
                      (    forth6809.asm):03129         ; @  ( a-addr -- x )
                      (    forth6809.asm):03130         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03131         ; ------------------------------------------------------------
D54A 3710             (    forth6809.asm):03132         FETCHW:     PULU  X                 ; a-addr
D54C EC84             (    forth6809.asm):03133                     LDD   ,X
D54E 3606             (    forth6809.asm):03134                     PSHU  D                 ; x
D550 39               (    forth6809.asm):03135                     RTS
                      (    forth6809.asm):03136         
                      (    forth6809.asm):03137         ; ------------------------------------------------------------
                      (    forth6809.asm):03138         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03139         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03140         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03141         ; ------------------------------------------------------------
D551 CCD54A           (    forth6809.asm):03142         CONSTANTW:  LDD   #FETCHW
D554 BDD503           (    forth6809.asm):03143                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D557 BDD405           (    forth6809.asm):03144                     JSR   COMMAW
D55A 39               (    forth6809.asm):03145                     RTS
                      (    forth6809.asm):03146         
                      (    forth6809.asm):03147         ; ------------------------------------------------------------
                      (    forth6809.asm):03148         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03149         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03150         ;    Inputs:
                      (    forth6809.asm):03151         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03152         ;    Outputs:
                      (    forth6809.asm):03153         ;        pfa replaced by the value
                      (    forth6809.asm):03154         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03155         ; ------------------------------------------------------------
D55B 3710             (    forth6809.asm):03156         DOVALUE:    PULU  X                 ; pfa
D55D EC84             (    forth6809.asm):03157                     LDD   ,X
D55F 3606             (    forth6809.asm):03158                     PSHU  D                 ; x
D561 39               (    forth6809.asm):03159                     RTS
                      (    forth6809.asm):03160         
                      (    forth6809.asm):03161         ; ------------------------------------------------------------
                      (    forth6809.asm):03162         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03163         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03164         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03165         ; ------------------------------------------------------------
D562 CCD55B           (    forth6809.asm):03166         VALUEW:     LDD   #DOVALUE
D565 BDD4E9           (    forth6809.asm):03167                     JSR   BLDDOES
D568 DC0A             (    forth6809.asm):03168                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D56A 3606             (    forth6809.asm):03169                     PSHU  D                 ; See bugfix: VALUEW.1
D56C BDD40B           (    forth6809.asm):03170                     JSR   CODECOMMA
D56F BDD41D           (    forth6809.asm):03171                     JSR   VCOMMAW           ; store x in the variable area
D572 39               (    forth6809.asm):03172                     RTS
                      (    forth6809.asm):03173         
                      (    forth6809.asm):03174         ; ------------------------------------------------------------
                      (    forth6809.asm):03175         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03176         ; lower address as 2@ expects.
                      (    forth6809.asm):03177         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03178         ; ------------------------------------------------------------
D573 7EEAEC           (    forth6809.asm):03179         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03180         
                      (    forth6809.asm):03181         ; ------------------------------------------------------------
                      (    forth6809.asm):03182         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03183         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03184         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03185         ; ------------------------------------------------------------
D576 CCD573           (    forth6809.asm):03186         TWOVALUEW:  LDD   #DO2VALUE
D579 BDD4E9           (    forth6809.asm):03187                     JSR   BLDDOES
D57C DC0A             (    forth6809.asm):03188                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D57E 3606             (    forth6809.asm):03189                     PSHU  D
D580 BDD40B           (    forth6809.asm):03190                     JSR   CODECOMMA
D583 BDD41D           (    forth6809.asm):03191                     JSR   VCOMMAW           ; x2 at the lower address
D586 BDD41D           (    forth6809.asm):03192                     JSR   VCOMMAW           ; then x1
D589 39               (    forth6809.asm):03193                     RTS
                      (    forth6809.asm):03194         
                      (    forth6809.asm):03195         ; ------------------------------------------------------------
                      (    forth6809.asm):03196         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03197         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03198         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03199         ; ------------------------------------------------------------
D58A CC0020           (    forth6809.asm):03200         TOW:        LDD   #32
D58D 3606             (    forth6809.asm):03201                     PSHU  D
D58F BDD7A3           (    forth6809.asm):03202                     JSR   WORDW
D592 BDD88C           (    forth6809.asm):03203                     JSR   FINDW
D595 3706             (    forth6809.asm):03204                     PULU  D
D597 10830000         (    forth6809.asm):03205                     CMPD  #0
D59B 260A             (    forth6809.asm):03206                     BNE   TOFOUND
D59D 3706             (    forth6809.asm):03207                     PULU  D
D59F CCFFF3           (    forth6809.asm):03208                     LDD   #-13
D5A2 3606             (    forth6809.asm):03209                     PSHU  D
D5A4 BDDCF0           (    forth6809.asm):03210                     JSR   THROWW
D5A7 AEC4             (    forth6809.asm):03211         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
D5A9 EC03             (    forth6809.asm):03212                     LDD   3,X
D5AB 1083D573         (    forth6809.asm):03213                     CMPD  #DO2VALUE
D5AF 271A             (    forth6809.asm):03214                     BEQ   TOTWO
D5B1 BDE1EC           (    forth6809.asm):03215                     JSR   TOBODYW
D5B4 DC00             (    forth6809.asm):03216                     LDD   STATE
D5B6 270C             (    forth6809.asm):03217                     BEQ   TOIMMED
D5B8 BDE138           (    forth6809.asm):03218                     JSR   LITERALW
D5BB CCEACD           (    forth6809.asm):03219                     LDD   #STOREW
D5BE 3606             (    forth6809.asm):03220                     PSHU  D
D5C0 BDE12B           (    forth6809.asm):03221                     JSR   CCALL
D5C3 39               (    forth6809.asm):03222                     RTS
D5C4 3710             (    forth6809.asm):03223         TOIMMED:    PULU  X                 ; a-addr of the value cell
D5C6 3706             (    forth6809.asm):03224                     PULU  D                 ; x
D5C8 ED84             (    forth6809.asm):03225                     STD   ,X
D5CA 39               (    forth6809.asm):03226                     RTS
D5CB BDE1EC           (    forth6809.asm):03227         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
D5CE DC00             (    forth6809.asm):03228                     LDD   STATE
D5D0 270C             (    forth6809.asm):03229                     BEQ   TOTWOIMM
D5D2 BDE138           (    forth6809.asm):03230                     JSR   LITERALW
D5D5 CCEAF7           (    forth6809.asm):03231                     LDD   #TWOSTOREW
D5D8 3606             (    forth6809.asm):03232                     PSHU  D
D5DA BDE12B           (    forth6809.asm):03233                     JSR   CCALL
D5DD 39               (    forth6809.asm):03234                     RTS
D5DE 7EEAF7           (    forth6809.asm):03235         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03236         
                      (    forth6809.asm):03237         ; ------------------------------------------------------------
                      (    forth6809.asm):03238         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03239         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03240         ; the variable area, initialised to zero.
                      (    forth6809.asm):03241         ; ------------------------------------------------------------
D5E1                  (    forth6809.asm):03242         TWOVARIABLEW:
D5E1 CC0000           (    forth6809.asm):03243                     LDD   #0
D5E4 3606             (    forth6809.asm):03244                     PSHU  D
D5E6 BDD45D           (    forth6809.asm):03245                     JSR   HEADER

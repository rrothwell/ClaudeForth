                      (    forth6809.asm):01890         ; INITSERIAL
                      (    forth6809.asm):01891         ;    Inputs:
                      (    forth6809.asm):01892         ;        none
                      (    forth6809.asm):01893         ;    Outputs:
                      (    forth6809.asm):01894         ;        ring buffers cleared (SERBUFCLR); ACIACR set to the run mode
                      (    forth6809.asm):01895         ;    Registers: RegA and CC changed.
                      (    forth6809.asm):01896         ; Original comment: shadow INITSERIAL.0.
                      (    forth6809.asm):01897         ; See bugfix: INITSERIAL.1.
                      (    forth6809.asm):01898         ; ------------------------------------------------------------

                      (    forth6809.asm):04155         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04156         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04157         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04158         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04159         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04160         ; NUMLOOP
                      (    forth6809.asm):04161         ;    Inputs:
                      (    forth6809.asm):04162         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04163         ;    Outputs:
                      (    forth6809.asm):04164         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04165         ;        the count remaining
                      (    forth6809.asm):04166         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04167         ; ------------------------------------------------------------
DAFB                  (    forth6809.asm):04168         TONUMBERW:
DAFB ECC4             (    forth6809.asm):04169         NUMLOOP:    LDD   ,U

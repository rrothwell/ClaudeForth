D622 6AE4             (    forth6809.asm):03929                     DEC   ,S
D624 20F3             (    forth6809.asm):03930                     BRA   SOCHK
D626 3506             (    forth6809.asm):03931         SOCOPY:     PULS  A,B               ; B = n
D628 8E004B           (    forth6809.asm):03932                     LDX   #ORDER
D62B 5D               (    forth6809.asm):03933         SOCP2:      TSTB
D62C 2708             (    forth6809.asm):03934                     BEQ   SOCPEND
D62E 3720             (    forth6809.asm):03935                     PULU  Y
D630 10AF81           (    forth6809.asm):03936                     STY   ,X++
D633 5A               (    forth6809.asm):03937                     DECB
D634 20F5             (    forth6809.asm):03938                     BRA   SOCP2
D636 9F49             (    forth6809.asm):03939         SOCPEND:    STX   ORDEND

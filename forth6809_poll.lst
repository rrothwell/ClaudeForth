D9A8 8E004B           (    forth6809.asm):03892                     LDX   #ORDER
D9AB 5D               (    forth6809.asm):03893         SOCP2:      TSTB
D9AC 2708             (    forth6809.asm):03894                     BEQ   SOCPEND
D9AE 3720             (    forth6809.asm):03895                     PULU  Y
D9B0 10AF81           (    forth6809.asm):03896                     STY   ,X++
D9B3 5A               (    forth6809.asm):03897                     DECB

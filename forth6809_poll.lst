DE21 3710             (    forth6809.asm):04829         RPOK1:      PULU  X                 ; orig
DE23 3410             (    forth6809.asm):04830                     PSHS  X                 ; 2,S = orig (5k: S-frame)
                      (    forth6809.asm):04831         
                      (    forth6809.asm):04832                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04833                     ; See bugfix: REPEATW.1
DE25 3040             (    forth6809.asm):04834                     LEAX  0,U               ; scan from top of control stack
DE27 9F16             (    forth6809.asm):04835                     STX   MSCR2             ; MSCR2 = base of scan region
DE29 9F1A             (    forth6809.asm):04836                     STX   MSCR4             ; MSCR4 = scan pointer
DE2B DC1A             (    forth6809.asm):04837         RPSCAN:     LDD   MSCR4
DE2D 109321           (    forth6809.asm):04838                     CMPD  CSP
DE30 2603             (    forth6809.asm):04839                     BNE   RPSCANOK

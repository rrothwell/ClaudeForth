E9C6 ED46             (    forth6809.asm):05390                     STD   6,U
E9C8 AFC4             (    forth6809.asm):05391                     STX   ,U
E9CA 10AF42           (    forth6809.asm):05392                     STY   2,U
E9CD DC14             (    forth6809.asm):05393                     LDD   MSCR
E9CF ED44             (    forth6809.asm):05394                     STD   4,U

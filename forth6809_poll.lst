                      (    forth6809.asm):03706         ; ------------------------------------------------------------
                      (    forth6809.asm):03707         ; SET-ORDER  ( widn ... wid1 n -- )
                      (    forth6809.asm):03708         ; Set the search order. n = -1 selects the minimum order (FORTH only).

                      (    forth6809.asm):03848         ; source: set NTIB and SRCLEN to its length, SRCADDR to TIBBUF, SRCID
                      (    forth6809.asm):03849         ; to 0 and >IN to 0.
                      (    forth6809.asm):03850         ; ------------------------------------------------------------
E3CD 8E0106           (    forth6809.asm):03851         QUERYW:     LDX   #TIBBUF
E3D0 3610             (    forth6809.asm):03852                     PSHU  X
E3D2 CC0050           (    forth6809.asm):03853                     LDD   #TIBBUFL
E3D5 3606             (    forth6809.asm):03854                     PSHU  D
E3D7 BDE357           (    forth6809.asm):03855                     JSR   ACCEPTW
E3DA 3706             (    forth6809.asm):03856                     PULU  D
E3DC DD12             (    forth6809.asm):03857                     STD   NTIB
E3DE DD3B             (    forth6809.asm):03858                     STD   SRCLEN
E3E0 CC0106           (    forth6809.asm):03859                     LDD   #TIBBUF
E3E3 DD39             (    forth6809.asm):03860                     STD   SRCADDR
E3E5 CC0000           (    forth6809.asm):03861                     LDD   #0
E3E8 DD3D             (    forth6809.asm):03862                     STD   SRCID
E3EA DD10             (    forth6809.asm):03863                     STD   TOIN
E3EC 39               (    forth6809.asm):03864                     RTS
                      (    forth6809.asm):03865         
                      (    forth6809.asm):03866         ; ============================================================
                      (    forth6809.asm):03867         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):03868         ; ============================================================
                      (    forth6809.asm):03869         ; ------------------------------------------------------------
                      (    forth6809.asm):03870         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):03871         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):03872         ; one expected.
                      (    forth6809.asm):03873         ; CFERR
                      (    forth6809.asm):03874         ;    Inputs:
                      (    forth6809.asm):03875         ;        none
                      (    forth6809.asm):03876         ;    Outputs:
                      (    forth6809.asm):03877         ;        does not return (THROW -22)
                      (    forth6809.asm):03878         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):03879         ; ------------------------------------------------------------
E3ED CCFFEA           (    forth6809.asm):03880         CFERR:      LDD   #-22
E3F0 3606             (    forth6809.asm):03881                     PSHU  D                 ; -22
E3F2 BDE422           (    forth6809.asm):03882                     JSR   THROWW
E3F5 39               (    forth6809.asm):03883                     RTS
                      (    forth6809.asm):03884         
                      (    forth6809.asm):03885         ; ------------------------------------------------------------
                      (    forth6809.asm):03886         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):03887         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):03888         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):03889         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):03890         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):03891         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):03892         ; ------------------------------------------------------------
E3F6 3710             (    forth6809.asm):03893         CATCHW:     PULU  X                 ; xt
E3F8 DC0C             (    forth6809.asm):03894                     LDD   HANDLER
E3FA 3406             (    forth6809.asm):03895                     PSHS  D
E3FC 3440             (    forth6809.asm):03896                     PSHS  U
                      (    forth6809.asm):03897                     ; Save the input source specification.
                      (    forth6809.asm):03898                     ; See bugfix: CATCHW.1
E3FE DC39             (    forth6809.asm):03899                     LDD   SRCADDR
E400 3406             (    forth6809.asm):03900                     PSHS  D
E402 DC3B             (    forth6809.asm):03901                     LDD   SRCLEN
E404 3406             (    forth6809.asm):03902                     PSHS  D
E406 DC3D             (    forth6809.asm):03903                     LDD   SRCID
E408 3406             (    forth6809.asm):03904                     PSHS  D
E40A DC10             (    forth6809.asm):03905                     LDD   TOIN
E40C 3406             (    forth6809.asm):03906                     PSHS  D
E40E 1F40             (    forth6809.asm):03907                     TFR   S,D
E410 DD0C             (    forth6809.asm):03908                     STD   HANDLER
                      (    forth6809.asm):03909         
E412 AD84             (    forth6809.asm):03910                     JSR   ,X
                      (    forth6809.asm):03911         
E414 3268             (    forth6809.asm):03912                     LEAS  8,S               ; drop saved input source
E416 3262             (    forth6809.asm):03913                     LEAS  2,S               ; saved U

                      (    forth6809.asm):10827         ; ------------------------------------------------------------
                      (    forth6809.asm):10828         ; Cold start, entered from the reset vector: mask interrupts, set up
                      (    forth6809.asm):10829         ; the stacks and the direct page, clear GLOBALS, initialise the ACIA,
                      (    forth6809.asm):10830         ; unmask interrupts, run the unit tests if they are built in, then
                      (    forth6809.asm):10831         ; enter COLD.
                      (    forth6809.asm):10832         ; COLDSTRT
                      (    forth6809.asm):10833         ;    Inputs:
                      (    forth6809.asm):10834         ;        hardware reset
                      (    forth6809.asm):10835         ;    Outputs:
                      (    forth6809.asm):10836         ;        does not return
                      (    forth6809.asm):10837         ;    Registers: all registers initialised.
                      (    forth6809.asm):10838         ; ------------------------------------------------------------
FFA4                  (    forth6809.asm):10839         COLDSTRT:
FFA4 1A50             (    forth6809.asm):10840                     ORCC  #$50              ; Disable IRQ & FIRQ
FFA6 10CEC000         (    forth6809.asm):10841                     LDS   #RSTACK+1
FFAA CEBD00           (    forth6809.asm):10842                     LDU   #DSTACK+1
FFAD 4F               (    forth6809.asm):10843                     CLRA
FFAE 1F8B             (    forth6809.asm):10844                     TFR   A,DP
                      (    forth6809.asm):10845         
FFB0 8E0000           (    forth6809.asm):10846                     LDX   #GLOBALS
FFB3 C600             (    forth6809.asm):10847                     LDB   #0
FFB5 6F80             (    forth6809.asm):10848         CLRGLOB:    CLR   ,X+
FFB7 5A               (    forth6809.asm):10849                     DECB
FFB8 26FB             (    forth6809.asm):10850                     BNE   CLRGLOB
                      (    forth6809.asm):10851         
FFBA BDD579           (    forth6809.asm):10852                     JSR   WLINIT            ; FIND must work for the unit tests too
                      (    forth6809.asm):10853         
FFBD BDCEDF           (    forth6809.asm):10854                     JSR   INITSERIAL
                      (    forth6809.asm):10855         
FFC0 1CAF             (    forth6809.asm):10856                     ANDCC #$AF              ; Enable IRQ & FIRQ
                      (    forth6809.asm):10857         
                      (    forth6809.asm):10858                     ; IRQ and FIRQ are unmasked above. See bugfix: COLDSTRT.1
                      (    forth6809.asm):10859         
                      (    forth6809.asm):10860                     IFNE  UNITTESTS         ; >>>>>>>>>>
                      (    forth6809.asm):10861                     JSR   TSTRUNNER
                      (    forth6809.asm):10862                     ELSE                    ; <<<<<>>>>>
FFC2 12               (    forth6809.asm):10863                     NOP                     ; same size as JSR TSTRUNNER
FFC3 12               (    forth6809.asm):10864                     NOP                     ; See bugfix: COLDSTRT.2
FFC4 12               (    forth6809.asm):10865                     NOP
                      (    forth6809.asm):10866                     ENDC                    ; <<<<<<<<<<
                      (    forth6809.asm):10867         
FFC5 7ECEFC           (    forth6809.asm):10868                     JMP   COLD
                      (    forth6809.asm):10869         
                      (    forth6809.asm):10870         ; ------------------------------------------------------------
                      (    forth6809.asm):10871         ; Warm start, entered from the NMI vector: mask interrupts, reset the
                      (    forth6809.asm):10872         ; stacks and direct page, re-initialise the ACIA, print the warm-start
                      (    forth6809.asm):10873         ; message, unmask interrupts and ABORT. GLOBALS is not cleared.
                      (    forth6809.asm):10874         ; WARM
                      (    forth6809.asm):10875         ;    Inputs:
                      (    forth6809.asm):10876         ;        NMI
                      (    forth6809.asm):10877         ;    Outputs:
                      (    forth6809.asm):10878         ;        does not return
                      (    forth6809.asm):10879         ;    Registers: all registers initialised.
                      (    forth6809.asm):10880         ; ------------------------------------------------------------
FFC8 1A50             (    forth6809.asm):10881         WARM:       ORCC  #$50              ; Disable IRQ & FIRQ
FFCA 4F               (    forth6809.asm):10882                     CLRA
FFCB 1F8B             (    forth6809.asm):10883                     TFR   A,DP
FFCD CEBD00           (    forth6809.asm):10884                     LDU   #SP0
FFD0 10CEC000         (    forth6809.asm):10885                     LDS   #RP0
                      (    forth6809.asm):10886         
FFD4 BDCEDF           (    forth6809.asm):10887                     JSR   INITSERIAL        ; See bugfix: WARM.1
                      (    forth6809.asm):10888         
FFD7 8EFFE9           (    forth6809.asm):10889                     LDX   #WARMMSG
FFDA 3610             (    forth6809.asm):10890                     PSHU  X
FFDC CC0006           (    forth6809.asm):10891                     LDD   #WARMMSGL
FFDF 3606             (    forth6809.asm):10892                     PSHU  D
FFE1 BDE965           (    forth6809.asm):10893                     JSR   TYPEW
FFE4 1CAF             (    forth6809.asm):10894                     ANDCC #$AF              ; Enable IRQ & FIRQ
FFE6 7ECF3E           (    forth6809.asm):10895                     JMP   ABORT             ; restart the interpreter
                      (    forth6809.asm):10896         
FFE9 20207761726D     (    forth6809.asm):10897         WARMMSG:    FCC   "  warm"
     0006             (    forth6809.asm):10898         WARMMSGL    EQU   *-WARMMSG
                      (    forth6809.asm):10899         

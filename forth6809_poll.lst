DB7D 53               (    forth6809.asm):04261                     COMB
DB7E C30001           (    forth6809.asm):04262                     ADDD  #1
DB81 ED42             (    forth6809.asm):04263                     STD   2,U
DB83 2407             (    forth6809.asm):04264                     BCC   NQPOS32
DB85 ECC4             (    forth6809.asm):04265                     LDD   ,U
DB87 C30001           (    forth6809.asm):04266                     ADDD  #1

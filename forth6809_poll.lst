                      (    forth6809.asm):04967         
                      (    forth6809.asm):04968                     ; Find the BEGIN frame, scanning past any open TAGFWD frames.
                      (    forth6809.asm):04969                     ; See bugfix: REPEATW.1
D9CA 3040             (    forth6809.asm):04970                     LEAX  0,U               ; scan from top of control stack
D9CC 9F16             (    forth6809.asm):04971                     STX   MSCR2             ; MSCR2 = base of scan region
D9CE 9F1A             (    forth6809.asm):04972                     STX   MSCR4             ; MSCR4 = scan pointer
D9D0 DC1A             (    forth6809.asm):04973         RPSCAN:     LDD   MSCR4
D9D2 109321           (    forth6809.asm):04974                     CMPD  CSP
D9D5 2603             (    forth6809.asm):04975                     BNE   RPSCANOK
D9D7 BDD860           (    forth6809.asm):04976                     JSR   CFERR             ; no matching BEGIN
D9DA 9E1A             (    forth6809.asm):04977         RPSCANOK:   LDX   MSCR4
D9DC EC84             (    forth6809.asm):04978                     LDD   ,X
D9DE 10830002         (    forth6809.asm):04979                     CMPD  #TAGBACK
D9E2 2712             (    forth6809.asm):04980                     BEQ   RPFOUND
D9E4 10830001         (    forth6809.asm):04981                     CMPD  #TAGFWD
D9E8 2703             (    forth6809.asm):04982                     BEQ   RPSKIP
D9EA BDD860           (    forth6809.asm):04983                     JSR   CFERR             ; anything else is a genuine mismatch
D9ED DC1A             (    forth6809.asm):04984         RPSKIP:     LDD   MSCR4
D9EF C30004           (    forth6809.asm):04985                     ADDD  #4
D9F2 DD1A             (    forth6809.asm):04986                     STD   MSCR4
D9F4 20DA             (    forth6809.asm):04987                     BRA   RPSCAN
D9F6 9E1A             (    forth6809.asm):04988         RPFOUND:    LDX   MSCR4             ; X = found BEGIN frame
D9F8 EC02             (    forth6809.asm):04989                     LDD   2,X               ; dest = BEGIN's address
D9FA 3406             (    forth6809.asm):04990                     PSHS  D                 ; 0,S = dest
                      (    forth6809.asm):04991         
                      (    forth6809.asm):04992                     ; Close the gap: move the frames above the BEGIN frame down 4
                      (    forth6809.asm):04993                     ; bytes, highest word first.
D9FC DC1A             (    forth6809.asm):04994                     LDD   MSCR4

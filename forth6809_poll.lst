E5FC CC0000           (    forth6809.asm):04232                     LDD   #0
E5FF 3406             (    forth6809.asm):04233                     PSHS  D
E601 DC16             (    forth6809.asm):04234                     LDD   MSCR2
E603 3406             (    forth6809.asm):04235                     PSHS  D
E605 DC14             (    forth6809.asm):04236                     LDD   MSCR
E607 3406             (    forth6809.asm):04237                     PSHS  D
E609 3410             (    forth6809.asm):04238                     PSHS  X
E60B 39               (    forth6809.asm):04239                     RTS
                      (    forth6809.asm):04240         
                      (    forth6809.asm):04241         ; ------------------------------------------------------------
                      (    forth6809.asm):04242         ; I  ( -- n )

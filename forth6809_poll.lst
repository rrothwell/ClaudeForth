DB5C 3606             (    forth6809.asm):04991                     PSHU  D
DB5E 39               (    forth6809.asm):04992                     RTS
                      (    forth6809.asm):04993         
                      (    forth6809.asm):04994         ; ------------------------------------------------------------
                      (    forth6809.asm):04995         ; J  ( -- n )
                      (    forth6809.asm):04996         ; Push the index of the next outer loop (8,S, beyond the return
                      (    forth6809.asm):04997         ; address and the inner loop frame).
                      (    forth6809.asm):04998         ; ------------------------------------------------------------
DB5F EC68             (    forth6809.asm):04999         JW:         LDD   8,S               ; n. See bugfix: JW.1
DB61 3606             (    forth6809.asm):05000                     PSHU  D
DB63 39               (    forth6809.asm):05001                     RTS
                      (    forth6809.asm):05002         
                      (    forth6809.asm):05003         ; ------------------------------------------------------------
                      (    forth6809.asm):05004         ; LEAVE  ( -- )
                      (    forth6809.asm):05005         ; Set the leave flag in the innermost loop frame. The loop exits at
                      (    forth6809.asm):05006         ; its next LOOP or +LOOP test.
                      (    forth6809.asm):05007         ; ------------------------------------------------------------
DB64 CCFFFF           (    forth6809.asm):05008         LEAVEW:     LDD   #TRUEV            ; true

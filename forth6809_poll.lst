                      (    forth6809.asm):02627         ; ============================================================
                      (    forth6809.asm):02628         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02629         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02630         ; ============================================================
                      (    forth6809.asm):02631         ; ------------------------------------------------------------
                      (    forth6809.asm):02632         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02633         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02634         ; LIT   ( -- x )
                      (    forth6809.asm):02635         ;    Inputs:
                      (    forth6809.asm):02636         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02637         ;    Outputs:
                      (    forth6809.asm):02638         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02639         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02640         ; ------------------------------------------------------------
CFE5 3510             (    forth6809.asm):02641         LIT:        PULS  X
CFE7 EC81             (    forth6809.asm):02642                     LDD   ,X++
CFE9 3606             (    forth6809.asm):02643                     PSHU  D                 ; x
CFEB 3410             (    forth6809.asm):02644                     PSHS  X
CFED 39               (    forth6809.asm):02645                     RTS
                      (    forth6809.asm):02646         
                      (    forth6809.asm):02647         ; ------------------------------------------------------------
                      (    forth6809.asm):02648         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02649         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02650         ; address.
                      (    forth6809.asm):02651         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02652         ;    Inputs:
                      (    forth6809.asm):02653         ;        flag on the data stack
                      (    forth6809.asm):02654         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02655         ;    Outputs:
                      (    forth6809.asm):02656         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02657         ;        the offset
                      (    forth6809.asm):02658         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02659         ; ------------------------------------------------------------
CFEE 3706             (    forth6809.asm):02660         ZBRANCH:    PULU  D                 ; flag
CFF0 3510             (    forth6809.asm):02661                     PULS  X
CFF2 10830000         (    forth6809.asm):02662                     CMPD  #0
CFF6 2607             (    forth6809.asm):02663                     BNE   ZSKIP
CFF8 EC84             (    forth6809.asm):02664                     LDD   ,X
CFFA 308B             (    forth6809.asm):02665                     LEAX  D,X
CFFC 3410             (    forth6809.asm):02666                     PSHS  X
CFFE 39               (    forth6809.asm):02667                     RTS
CFFF 3002             (    forth6809.asm):02668         ZSKIP:      LEAX  2,X
D001 3410             (    forth6809.asm):02669                     PSHS  X
D003 39               (    forth6809.asm):02670                     RTS
                      (    forth6809.asm):02671         
                      (    forth6809.asm):02672         ; ------------------------------------------------------------
                      (    forth6809.asm):02673         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02674         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02675         ; BRANCH
                      (    forth6809.asm):02676         ;    Inputs:
                      (    forth6809.asm):02677         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02678         ;    Outputs:
                      (    forth6809.asm):02679         ;        return address set to the branch target
                      (    forth6809.asm):02680         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02681         ; ------------------------------------------------------------
D004 3510             (    forth6809.asm):02682         BRANCH:     PULS  X
D006 EC84             (    forth6809.asm):02683                     LDD   ,X
D008 308B             (    forth6809.asm):02684                     LEAX  D,X
D00A 3410             (    forth6809.asm):02685                     PSHS  X
D00C 39               (    forth6809.asm):02686                     RTS
                      (    forth6809.asm):02687         
                      (    forth6809.asm):02688         ; ------------------------------------------------------------
                      (    forth6809.asm):02689         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02690         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02691         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02692         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02693         ;    Inputs:
                      (    forth6809.asm):02694         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02695         ;        trampoline
                      (    forth6809.asm):02696         ;    Outputs:
                      (    forth6809.asm):02697         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02698         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02699         ; ------------------------------------------------------------
D00D 3510             (    forth6809.asm):02700         DODOES:     PULS  X
D00F 10AE81           (    forth6809.asm):02701                     LDY   ,X++
D012 EC84             (    forth6809.asm):02702                     LDD   ,X
D014 3606             (    forth6809.asm):02703                     PSHU  D                 ; pfa
D016 6EA4             (    forth6809.asm):02704                     JMP   ,Y
                      (    forth6809.asm):02705         
                      (    forth6809.asm):02706         ; ------------------------------------------------------------
                      (    forth6809.asm):02707         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02708         ; field address on the stack.
                      (    forth6809.asm):02709         ; DOESRT0
                      (    forth6809.asm):02710         ;    Inputs:
                      (    forth6809.asm):02711         ;        none
                      (    forth6809.asm):02712         ;    Outputs:
                      (    forth6809.asm):02713         ;        none
                      (    forth6809.asm):02714         ;    Registers: none.
                      (    forth6809.asm):02715         ; ------------------------------------------------------------
D018 39               (    forth6809.asm):02716         DOESRT0:    RTS
                      (    forth6809.asm):02717         
                      (    forth6809.asm):02718         ; ------------------------------------------------------------
                      (    forth6809.asm):02719         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02720         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02721         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02722         ; SETDOES
                      (    forth6809.asm):02723         ;    Inputs:
                      (    forth6809.asm):02724         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02725         ;        BEHAVIOR)
                      (    forth6809.asm):02726         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02727         ;        address
                      (    forth6809.asm):02728         ;    Outputs:
                      (    forth6809.asm):02729         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02730         ;        defining word's caller
                      (    forth6809.asm):02731         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02732         ; ------------------------------------------------------------
D019 3510             (    forth6809.asm):02733         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
D01B 1F12             (    forth6809.asm):02734                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02735         
D01D 9E04             (    forth6809.asm):02736                     LDX   LATEST
D01F E684             (    forth6809.asm):02737                     LDB   ,X
D021 C41F             (    forth6809.asm):02738                     ANDB  #$1F
D023 4F               (    forth6809.asm):02739                     CLRA
D024 308B             (    forth6809.asm):02740                     LEAX  D,X               ; header + name length
D026 EC03             (    forth6809.asm):02741                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
D028 C30003           (    forth6809.asm):02742                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
D02B 1F01             (    forth6809.asm):02743                     TFR   D,X
                      (    forth6809.asm):02744         
D02D 10AF84           (    forth6809.asm):02745                     STY   ,X                ; patch it
                      (    forth6809.asm):02746         
D030 3510             (    forth6809.asm):02747                     PULS  X                 ; X = the OUTER defining word's own return addr
D032 6E84             (    forth6809.asm):02748                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02749         
                      (    forth6809.asm):02750         ; ------------------------------------------------------------
                      (    forth6809.asm):02751         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02752         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02753         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02754         ;    Inputs:
                      (    forth6809.asm):02755         ;        pfa on the data stack
                      (    forth6809.asm):02756         ;    Outputs:
                      (    forth6809.asm):02757         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02758         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02759         ; ------------------------------------------------------------
D034 3710             (    forth6809.asm):02760         DODEFER:    PULU  X                 ; pfa
D036 EC84             (    forth6809.asm):02761                     LDD   ,X
D038 1F01             (    forth6809.asm):02762                     TFR   D,X
D03A 6E84             (    forth6809.asm):02763                     JMP   ,X
                      (    forth6809.asm):02764         
                      (    forth6809.asm):02765         ; ------------------------------------------------------------
                      (    forth6809.asm):02766         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02767         ; DOABORTUNDEF
                      (    forth6809.asm):02768         ;    Inputs:
                      (    forth6809.asm):02769         ;        none
                      (    forth6809.asm):02770         ;    Outputs:
                      (    forth6809.asm):02771         ;        none (does not return)
                      (    forth6809.asm):02772         ;    Registers: RegD changed.
                      (    forth6809.asm):02773         ; ------------------------------------------------------------
D03C                  (    forth6809.asm):02774         DOABORTUNDEF:
D03C CCFFEB           (    forth6809.asm):02775                     LDD   #-21
D03F 3606             (    forth6809.asm):02776                     PSHU  D                 ; throw code (-21)
D041 7ED970           (    forth6809.asm):02777                     JMP   THROWW
                      (    forth6809.asm):02778         
                      (    forth6809.asm):02779         ; ------------------------------------------------------------
                      (    forth6809.asm):02780         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02781         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02782         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02783         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02784         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02785         ;    Inputs:
                      (    forth6809.asm):02786         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02787         ;    Outputs:
                      (    forth6809.asm):02788         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02789         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02790         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02791         ; ------------------------------------------------------------
D044 3710             (    forth6809.asm):02792         DOMARKER:   PULU  X                 ; pfa
D046 EC84             (    forth6809.asm):02793                     LDD   ,X
D048 DD06             (    forth6809.asm):02794                     STD   DPHERE
D04A EC02             (    forth6809.asm):02795                     LDD   2,X
D04C DD08             (    forth6809.asm):02796                     STD   CODEHERE
D04E EC04             (    forth6809.asm):02797                     LDD   4,X
D050 DD0A             (    forth6809.asm):02798                     STD   VARHERE
D052 EC06             (    forth6809.asm):02799                     LDD   6,X
D054 DD04             (    forth6809.asm):02800                     STD   LATEST
D056 3008             (    forth6809.asm):02801                     LEAX  8,X               ; the saved search-order state follows
D058 108E0045         (    forth6809.asm):02802                     LDY   #SRCHSAVE
D05C C616             (    forth6809.asm):02803                     LDB   #SRCHSAVESZ
D05E A680             (    forth6809.asm):02804         DMCOPY:     LDA   ,X+
D060 A7A0             (    forth6809.asm):02805                     STA   ,Y+
D062 5A               (    forth6809.asm):02806                     DECB
D063 26F9             (    forth6809.asm):02807                     BNE   DMCOPY
D065 DC06             (    forth6809.asm):02808                     LDD   DPHERE
D067 7ED59A           (    forth6809.asm):02809                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02810         
                      (    forth6809.asm):02811         ; ------------------------------------------------------------
                      (    forth6809.asm):02812         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02813         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02814         ; ------------------------------------------------------------
D06A 3710             (    forth6809.asm):02815         EXECUTEW:   PULU  X                 ; xt
D06C AD84             (    forth6809.asm):02816                     JSR   ,X
D06E 39               (    forth6809.asm):02817                     RTS
                      (    forth6809.asm):02818         
                      (    forth6809.asm):02819         ; ============================================================
                      (    forth6809.asm):02820         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02821         ; ============================================================
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
                      (    forth6809.asm):02823         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02824         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02825         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02826         ;    Inputs:
                      (    forth6809.asm):02827         ;        RegX = address of the here pointer
                      (    forth6809.asm):02828         ;        x on the data stack
                      (    forth6809.asm):02829         ;    Outputs:
                      (    forth6809.asm):02830         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02831         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02832         ; ------------------------------------------------------------
D06F 3706             (    forth6809.asm):02833         APPENDCELL: PULU  D                 ; x
D071 10AE84           (    forth6809.asm):02834                     LDY   ,X
D074 EDA1             (    forth6809.asm):02835                     STD   ,Y++
D076 10AF84           (    forth6809.asm):02836                     STY   ,X
D079 39               (    forth6809.asm):02837                     RTS
                      (    forth6809.asm):02838         
                      (    forth6809.asm):02839         ; ------------------------------------------------------------
                      (    forth6809.asm):02840         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02841         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02842         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02843         ;    Inputs:
                      (    forth6809.asm):02844         ;        RegX = address of the here pointer
                      (    forth6809.asm):02845         ;        char on the data stack
                      (    forth6809.asm):02846         ;    Outputs:
                      (    forth6809.asm):02847         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02848         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02849         ; ------------------------------------------------------------
D07A 3706             (    forth6809.asm):02850         APPENDBYTE: PULU  D                 ; char
D07C 10AE84           (    forth6809.asm):02851                     LDY   ,X
D07F E7A0             (    forth6809.asm):02852                     STB   ,Y+
D081 10AF84           (    forth6809.asm):02853                     STY   ,X
D084 39               (    forth6809.asm):02854                     RTS
                      (    forth6809.asm):02855         
                      (    forth6809.asm):02856         ; ------------------------------------------------------------
                      (    forth6809.asm):02857         ; ,  ( x -- )
                      (    forth6809.asm):02858         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02859         ; ------------------------------------------------------------
D085 8E0008           (    forth6809.asm):02860         COMMAW:     LDX   #CODEHERE
D088 7ED06F           (    forth6809.asm):02861                     JMP   APPENDCELL
                      (    forth6809.asm):02862         
                      (    forth6809.asm):02863         ; ------------------------------------------------------------
                      (    forth6809.asm):02864         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02865         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02866         ; ------------------------------------------------------------
D08B 8E0008           (    forth6809.asm):02867         CODECOMMA:  LDX   #CODEHERE
D08E 7ED06F           (    forth6809.asm):02868                     JMP   APPENDCELL
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ------------------------------------------------------------
                      (    forth6809.asm):02871         ; C,  ( char -- )
                      (    forth6809.asm):02872         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02873         ; ------------------------------------------------------------
D091 8E0008           (    forth6809.asm):02874         CCOMMAW:    LDX   #CODEHERE
D094 7ED07A           (    forth6809.asm):02875                     JMP   APPENDBYTE
                      (    forth6809.asm):02876         
                      (    forth6809.asm):02877         ; ------------------------------------------------------------
                      (    forth6809.asm):02878         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02879         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
D097 8E0008           (    forth6809.asm):02881         CCOMMA1:    LDX   #CODEHERE
D09A 7ED07A           (    forth6809.asm):02882                     JMP   APPENDBYTE
                      (    forth6809.asm):02883         
                      (    forth6809.asm):02884         ; ------------------------------------------------------------
                      (    forth6809.asm):02885         ; V,  ( x -- )
                      (    forth6809.asm):02886         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
D09D 8E000A           (    forth6809.asm):02888         VCOMMAW:    LDX   #VARHERE
D0A0 7ED06F           (    forth6809.asm):02889                     JMP   APPENDCELL
                      (    forth6809.asm):02890         
                      (    forth6809.asm):02891         ; ------------------------------------------------------------
                      (    forth6809.asm):02892         ; VC,  ( char -- )
                      (    forth6809.asm):02893         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
D0A3 8E000A           (    forth6809.asm):02895         VCCOMMAW:   LDX   #VARHERE
D0A6 7ED07A           (    forth6809.asm):02896                     JMP   APPENDBYTE
                      (    forth6809.asm):02897         
                      (    forth6809.asm):02898         ; ------------------------------------------------------------
                      (    forth6809.asm):02899         ; ALLOT  ( n -- )
                      (    forth6809.asm):02900         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
D0A9 3706             (    forth6809.asm):02902         ALLOTW:     PULU  D                 ; n
D0AB 9E08             (    forth6809.asm):02903                     LDX   CODEHERE
D0AD 308B             (    forth6809.asm):02904                     LEAX  D,X
D0AF 9F08             (    forth6809.asm):02905                     STX   CODEHERE
D0B1 39               (    forth6809.asm):02906                     RTS
                      (    forth6809.asm):02907         
                      (    forth6809.asm):02908         ; ------------------------------------------------------------
                      (    forth6809.asm):02909         ; VALLOT  ( n -- )
                      (    forth6809.asm):02910         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
D0B2 3706             (    forth6809.asm):02912         VALLOTW:    PULU  D                 ; n
D0B4 9E0A             (    forth6809.asm):02913                     LDX   VARHERE
D0B6 308B             (    forth6809.asm):02914                     LEAX  D,X
D0B8 9F0A             (    forth6809.asm):02915                     STX   VARHERE
D0BA 39               (    forth6809.asm):02916                     RTS
                      (    forth6809.asm):02917         
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
                      (    forth6809.asm):02919         ; HERE  ( -- addr )
                      (    forth6809.asm):02920         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02921         ; ------------------------------------------------------------
D0BB DC08             (    forth6809.asm):02922         HEREW:      LDD   CODEHERE
D0BD 3606             (    forth6809.asm):02923                     PSHU  D                 ; addr
D0BF 39               (    forth6809.asm):02924                     RTS
                      (    forth6809.asm):02925         
                      (    forth6809.asm):02926         ; ------------------------------------------------------------
                      (    forth6809.asm):02927         ; VHERE  ( -- addr )
                      (    forth6809.asm):02928         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
D0C0 DC0A             (    forth6809.asm):02930         VHEREW:     LDD   VARHERE
D0C2 3606             (    forth6809.asm):02931                     PSHU  D                 ; addr
D0C4 39               (    forth6809.asm):02932                     RTS
                      (    forth6809.asm):02933         
                      (    forth6809.asm):02934         ; ------------------------------------------------------------
                      (    forth6809.asm):02935         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02936         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02937         ; ------------------------------------------------------------
D0C5 DC08             (    forth6809.asm):02938         PADW:       LDD   CODEHERE
D0C7 C30080           (    forth6809.asm):02939                     ADDD  #PADOFFSET
D0CA 3606             (    forth6809.asm):02940                     PSHU  D                 ; c-addr
D0CC 39               (    forth6809.asm):02941                     RTS
                      (    forth6809.asm):02942         
                      (    forth6809.asm):02943         ; ------------------------------------------------------------
                      (    forth6809.asm):02944         ; UNUSED  ( -- u )
                      (    forth6809.asm):02945         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02946         ; ------------------------------------------------------------
D0CD CCB900           (    forth6809.asm):02947         UNUSEDW:    LDD   #CODETOP
D0D0 9308             (    forth6809.asm):02948                     SUBD  CODEHERE
D0D2 3606             (    forth6809.asm):02949                     PSHU  D                 ; u
D0D4 39               (    forth6809.asm):02950                     RTS
                      (    forth6809.asm):02951         
                      (    forth6809.asm):02952         ; ------------------------------------------------------------
                      (    forth6809.asm):02953         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02954         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02955         ; ------------------------------------------------------------
D0D5 CC1FFF           (    forth6809.asm):02956         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
D0D8 930A             (    forth6809.asm):02957                     SUBD  VARHERE
D0DA 3606             (    forth6809.asm):02958                     PSHU  D                 ; u
D0DC 39               (    forth6809.asm):02959                     RTS
                      (    forth6809.asm):02960         
                      (    forth6809.asm):02961         ; ============================================================
                      (    forth6809.asm):02962         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02963         ; ============================================================
                      (    forth6809.asm):02964         ; ------------------------------------------------------------
                      (    forth6809.asm):02965         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02966         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02967         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02968         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):02969         ; wordlist are updated.
                      (    forth6809.asm):02970         ; HEADER   ( smudge-flag "name" -- )
                      (    forth6809.asm):02971         ;    Inputs:
                      (    forth6809.asm):02972         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):02973         ;        name parsed from the input stream
                      (    forth6809.asm):02974         ;    Outputs:
                      (    forth6809.asm):02975         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):02976         ;        LATEST = address of the new header
                      (    forth6809.asm):02977         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02978         ; ------------------------------------------------------------
D0DD CC0020           (    forth6809.asm):02979         HEADER:     LDD   #32
D0E0 3606             (    forth6809.asm):02980                     PSHU  D
D0E2 BDD423           (    forth6809.asm):02981                     JSR   WORDW
D0E5 3710             (    forth6809.asm):02982                     PULU  X                 ; c-addr of the name
D0E7 3706             (    forth6809.asm):02983                     PULU  D                 ; smudge flag in B
D0E9 A680             (    forth6809.asm):02984                     LDA   ,X+               ; name length, X = name text
D0EB 3402             (    forth6809.asm):02985                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
D0ED 5D               (    forth6809.asm):02986                     TSTB
D0EE 2702             (    forth6809.asm):02987                     BEQ   HDNOSM
D0F0 8A40             (    forth6809.asm):02988                     ORA   #$40
D0F2 109E06           (    forth6809.asm):02989         HDNOSM:     LDY   DPHERE
D0F5 3420             (    forth6809.asm):02990                     PSHS  Y                 ; 0,S = address of the new header
D0F7 A7A0             (    forth6809.asm):02991                     STA   ,Y+
D0F9 E662             (    forth6809.asm):02992                     LDB   2,S
D0FB 2707             (    forth6809.asm):02993                     BEQ   HDNONM
D0FD A680             (    forth6809.asm):02994         HDCPY:      LDA   ,X+
D0FF A7A0             (    forth6809.asm):02995                     STA   ,Y+
D101 5A               (    forth6809.asm):02996                     DECB
D102 26F9             (    forth6809.asm):02997                     BNE   HDCPY
D104 9E47             (    forth6809.asm):02998         HDNONM:     LDX   CURRENT           ; X = WID of the wordlist receiving the word
D106 EC84             (    forth6809.asm):02999                     LDD   ,X
D108 EDA1             (    forth6809.asm):03000                     STD   ,Y++              ; LINK = old head of that wordlist
D10A DC08             (    forth6809.asm):03001                     LDD   CODEHERE
D10C EDA1             (    forth6809.asm):03002                     STD   ,Y++
D10E 109F06           (    forth6809.asm):03003                     STY   DPHERE
D111 3506             (    forth6809.asm):03004                     PULS  D
D113 DD04             (    forth6809.asm):03005                     STD   LATEST            ; LATEST = newest header of any wordlist
D115 ED84             (    forth6809.asm):03006                     STD   ,X                ; and the new head of the CURRENT wordlist
D117 3261             (    forth6809.asm):03007                     LEAS  1,S
D119 39               (    forth6809.asm):03008                     RTS
                      (    forth6809.asm):03009         
                      (    forth6809.asm):03010         ; ------------------------------------------------------------
                      (    forth6809.asm):03011         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03012         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03013         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03014         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03015         ; SMUDGE   ( -- )
                      (    forth6809.asm):03016         ;    Inputs:
                      (    forth6809.asm):03017         ;        none
                      (    forth6809.asm):03018         ;    Outputs:
                      (    forth6809.asm):03019         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03020         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03021         ; ------------------------------------------------------------
D11A 9E04             (    forth6809.asm):03022         SMUDGEW:    LDX   LATEST
D11C A684             (    forth6809.asm):03023                     LDA   ,X
D11E 8840             (    forth6809.asm):03024                     EORA  #$40
D120 A784             (    forth6809.asm):03025                     STA   ,X
D122 39               (    forth6809.asm):03026                     RTS
                      (    forth6809.asm):03027         
                      (    forth6809.asm):03028         ; ============================================================
                      (    forth6809.asm):03029         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03030         ; ============================================================
                      (    forth6809.asm):03031         ; ------------------------------------------------------------
                      (    forth6809.asm):03032         ; :  ( "name" -- )
                      (    forth6809.asm):03033         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03034         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03035         ; CSP and enter compile state.
                      (    forth6809.asm):03036         ; ------------------------------------------------------------
D123 CCFFFF           (    forth6809.asm):03037         COLONW:     LDD   #TRUEV
D126 3606             (    forth6809.asm):03038                     PSHU  D
D128 BDD0DD           (    forth6809.asm):03039                     JSR   HEADER
D12B DC08             (    forth6809.asm):03040                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D12D DD1F             (    forth6809.asm):03041                     STD   CURXT             ; See bugfix: COLONW.1
D12F 1F30             (    forth6809.asm):03042                     TFR   U,D
D131 DD21             (    forth6809.asm):03043                     STD   CSP
D133 CCFFFF           (    forth6809.asm):03044                     LDD   #-1
D136 DD00             (    forth6809.asm):03045                     STD   STATE
D138 39               (    forth6809.asm):03046                     RTS
                      (    forth6809.asm):03047         
                      (    forth6809.asm):03048         ; ------------------------------------------------------------
                      (    forth6809.asm):03049         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03050         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03051         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03052         ; new word and return to interpret state.
                      (    forth6809.asm):03053         ; ------------------------------------------------------------
D139 CC0039           (    forth6809.asm):03054         SEMIW:      LDD   #RTSOPC
D13C 3606             (    forth6809.asm):03055                     PSHU  D
D13E BDD097           (    forth6809.asm):03056                     JSR   CCOMMA1
D141 1F30             (    forth6809.asm):03057                     TFR   U,D
D143 109321           (    forth6809.asm):03058                     CMPD  CSP
D146 2703             (    forth6809.asm):03059                     BEQ   SEMIOK
D148 BDD93B           (    forth6809.asm):03060                     JSR   CFERR
D14B 9E04             (    forth6809.asm):03061         SEMIOK:     LDX   LATEST
D14D A684             (    forth6809.asm):03062                     LDA   ,X
D14F 84BF             (    forth6809.asm):03063                     ANDA  #$BF
D151 A784             (    forth6809.asm):03064                     STA   ,X
D153 CC0000           (    forth6809.asm):03065                     LDD   #0
D156 DD00             (    forth6809.asm):03066                     STD   STATE
D158 39               (    forth6809.asm):03067                     RTS
                      (    forth6809.asm):03068         
                      (    forth6809.asm):03069         ; ------------------------------------------------------------
                      (    forth6809.asm):03070         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03071         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03072         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03073         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03074         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03075         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03076         ; ------------------------------------------------------------
D159 DC08             (    forth6809.asm):03077         NONAMEW:    LDD   CODEHERE
D15B 3606             (    forth6809.asm):03078                     PSHU  D                 ; xt
D15D DD1F             (    forth6809.asm):03079                     STD   CURXT             ; See bugfix: NONAMEW.1
D15F 1F30             (    forth6809.asm):03080                     TFR   U,D
D161 DD21             (    forth6809.asm):03081                     STD   CSP
D163 CCFFFF           (    forth6809.asm):03082                     LDD   #-1
D166 DD00             (    forth6809.asm):03083                     STD   STATE
D168 39               (    forth6809.asm):03084                     RTS
                      (    forth6809.asm):03085         
                      (    forth6809.asm):03086         ; ------------------------------------------------------------
                      (    forth6809.asm):03087         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03088         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03089         ; BLDDOES
                      (    forth6809.asm):03090         ;    Inputs:
                      (    forth6809.asm):03091         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03092         ;    Outputs:
                      (    forth6809.asm):03093         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03094         ;    Registers: all changed.
                      (    forth6809.asm):03095         ; BLDSELF
                      (    forth6809.asm):03096         ;    Inputs:
                      (    forth6809.asm):03097         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03098         ;    Outputs:
                      (    forth6809.asm):03099         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03100         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03101         ;    Registers: all changed.
                      (    forth6809.asm):03102         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03103         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03104         ; ------------------------------------------------------------
D169 3406             (    forth6809.asm):03105         BLDDOES:    PSHS  D                 ; behaviour address
D16B CC0000           (    forth6809.asm):03106                     LDD   #0
D16E 3606             (    forth6809.asm):03107                     PSHU  D
D170 BDD0DD           (    forth6809.asm):03108                     JSR   HEADER
D173 CCD00D           (    forth6809.asm):03109                     LDD   #DODOES
D176 3606             (    forth6809.asm):03110                     PSHU  D
D178 BDDDAB           (    forth6809.asm):03111                     JSR   CCALL
D17B 3506             (    forth6809.asm):03112                     PULS  D
D17D 3606             (    forth6809.asm):03113                     PSHU  D                 ; behaviour address
D17F BDD08B           (    forth6809.asm):03114                     JSR   CODECOMMA
D182 39               (    forth6809.asm):03115                     RTS
                      (    forth6809.asm):03116         
D183 BDD169           (    forth6809.asm):03117         BLDSELF:    JSR   BLDDOES
D186 DC08             (    forth6809.asm):03118                     LDD   CODEHERE          ; PFA = the cell after this one
D188 C30002           (    forth6809.asm):03119                     ADDD  #2                ; See bugfix: CONSTANTW.1
D18B 3606             (    forth6809.asm):03120                     PSHU  D
D18D BDD08B           (    forth6809.asm):03121                     JSR   CODECOMMA
D190 39               (    forth6809.asm):03122                     RTS
                      (    forth6809.asm):03123         
                      (    forth6809.asm):03124         ; ------------------------------------------------------------
                      (    forth6809.asm):03125         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03126         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03127         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03128         ; address in the code area, on the stack.
                      (    forth6809.asm):03129         ; ------------------------------------------------------------
D191 CCD018           (    forth6809.asm):03130         CREATEW:    LDD   #DOESRT0
D194 BDD183           (    forth6809.asm):03131                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D197 39               (    forth6809.asm):03132                     RTS
                      (    forth6809.asm):03133         
                      (    forth6809.asm):03134         ; ------------------------------------------------------------
                      (    forth6809.asm):03135         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03136         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03137         ; of the word being defined.
                      (    forth6809.asm):03138         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03139         ; ------------------------------------------------------------
D198 CCD019           (    forth6809.asm):03140         DOESGTW:    LDD   #SETDOES
D19B 3606             (    forth6809.asm):03141                     PSHU  D
D19D BDDDAB           (    forth6809.asm):03142                     JSR   CCALL
D1A0 39               (    forth6809.asm):03143                     RTS
                      (    forth6809.asm):03144         
                      (    forth6809.asm):03145         ; ------------------------------------------------------------
                      (    forth6809.asm):03146         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03147         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03148         ; area, initialised to zero.
                      (    forth6809.asm):03149         ; ------------------------------------------------------------
D1A1 CC0000           (    forth6809.asm):03150         VARIABLEW:  LDD   #0
D1A4 3606             (    forth6809.asm):03151                     PSHU  D
D1A6 BDD0DD           (    forth6809.asm):03152                     JSR   HEADER
D1A9 CCD00D           (    forth6809.asm):03153                     LDD   #DODOES
D1AC 3606             (    forth6809.asm):03154                     PSHU  D
D1AE BDDDAB           (    forth6809.asm):03155                     JSR   CCALL
D1B1 CCD018           (    forth6809.asm):03156                     LDD   #DOESRT0
D1B4 3606             (    forth6809.asm):03157                     PSHU  D
D1B6 BDD08B           (    forth6809.asm):03158                     JSR   CODECOMMA
D1B9 DC0A             (    forth6809.asm):03159                     LDD   VARHERE
D1BB 3606             (    forth6809.asm):03160                     PSHU  D
D1BD BDD08B           (    forth6809.asm):03161                     JSR   CODECOMMA

D67D 8141             (    forth6809.asm):04260                     CMPA  #'A'
D67F 251E             (    forth6809.asm):04261                     BLO   NLDONE
D681 815A             (    forth6809.asm):04262                     CMPA  #'Z'
D683 221A             (    forth6809.asm):04263                     BHI   NLDONE
D685 8037             (    forth6809.asm):04264                     SUBA  #'A'-10
D687 9103             (    forth6809.asm):04265         NLGOT:      CMPA  BASE+1
D689 2414             (    forth6809.asm):04266                     BHS   NLDONE
D68B 1F89             (    forth6809.asm):04267                     TFR   A,B
D68D BDD626           (    forth6809.asm):04268                     JSR   UDMULADD

                      (    forth6809.asm):05866         
                      (    forth6809.asm):05867         ; ------------------------------------------------------------
                      (    forth6809.asm):05868         ; PICK  ( xu ... x0 u -- xu ... x0 xu )
                      (    forth6809.asm):05869         ; Copy the cell u deep (0 PICK is DUP) to the top.
                      (    forth6809.asm):05870         ; ------------------------------------------------------------
DEDD 3706             (    forth6809.asm):05871         PICKW:      PULU  D                 ; u
DEDF 58               (    forth6809.asm):05872                     LSLB
DEE0 49               (    forth6809.asm):05873                     ROLA
DEE1 ECCB             (    forth6809.asm):05874                     LDD   D,U
DEE3 3606             (    forth6809.asm):05875                     PSHU  D
DEE5 39               (    forth6809.asm):05876                     RTS
                      (    forth6809.asm):05877         
                      (    forth6809.asm):05878         ; ------------------------------------------------------------
                      (    forth6809.asm):05879         ; ROLL  ( xu xu-1 ... x0 u -- xu-1 ... x0 xu )
                      (    forth6809.asm):05880         ; Move the cell u deep (0 ROLL does nothing) to the top, shifting the
                      (    forth6809.asm):05881         ; cells above it down one place. RDST holds the byte offset and RVAL
                      (    forth6809.asm):05882         ; the cell being moved.
                      (    forth6809.asm):05883         ; ------------------------------------------------------------
DEE6 ECC1             (    forth6809.asm):05884         ROLLW:      LDD   ,U++              ; u (LDD sets CC; PULU would not). See
DEE8 2718             (    forth6809.asm):05885                     BEQ   ROLLDONE          ; bugfix: ROLLW.1
DEEA 1F02             (    forth6809.asm):05886                     TFR   D,Y               ; Y = cells to shift
DEEC 58               (    forth6809.asm):05887                     LSLB
DEED 49               (    forth6809.asm):05888                     ROLA
DEEE 30CB             (    forth6809.asm):05889                     LEAX  D,U               ; X = xu
DEF0 EC84             (    forth6809.asm):05890                     LDD   ,X

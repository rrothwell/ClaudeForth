                      (    forth6809.asm):04194         ; ------------------------------------------------------------
                      (    forth6809.asm):04195         ; >NUMBER  ( ud1 c-addr1 u1 -- ud2 c-addr2 u2 )
                      (    forth6809.asm):04196         ; Convert the string into ud1, in BASE, stopping at the first
                      (    forth6809.asm):04197         ; unconvertible character. Returns the accumulated ud2 and the
                      (    forth6809.asm):04198         ; remaining string. The conversion works in place on the three
                      (    forth6809.asm):04199         ; parameters (NUMLOOP), which are also the frame NUMBERQ builds.
                      (    forth6809.asm):04200         ; NUMLOOP
                      (    forth6809.asm):04201         ;    Inputs:
                      (    forth6809.asm):04202         ;        ( ud c-addr u ) on the data stack
                      (    forth6809.asm):04203         ;    Outputs:
                      (    forth6809.asm):04204         ;        ud accumulated; c-addr u = first unconverted character and
                      (    forth6809.asm):04205         ;        the count remaining
                      (    forth6809.asm):04206         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):04207         ; ------------------------------------------------------------
D77B                  (    forth6809.asm):04208         TONUMBERW:
D77B ECC4             (    forth6809.asm):04209         NUMLOOP:    LDD   ,U
D77D 2734             (    forth6809.asm):04210                     BEQ   NLDONE
D77F AE42             (    forth6809.asm):04211                     LDX   2,U
D781 A684             (    forth6809.asm):04212                     LDA   ,X
D783 8130             (    forth6809.asm):04213                     CMPA  #'0'
D785 252C             (    forth6809.asm):04214                     BLO   NLDONE
D787 8139             (    forth6809.asm):04215                     CMPA  #'9'
D789 2204             (    forth6809.asm):04216                     BHI   NLALPHA

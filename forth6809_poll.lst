D566 2509             (    forth6809.asm):03793                     BCS   WIDBAD
D568 C501             (    forth6809.asm):03794                     BITB  #1
D56A 2605             (    forth6809.asm):03795                     BNE   WIDBAD
D56C 9C45             (    forth6809.asm):03796                     CMPX  WLEND
D56E 2401             (    forth6809.asm):03797                     BHS   WIDBAD
D570 39               (    forth6809.asm):03798                     RTS
D571 CCFFF5           (    forth6809.asm):03799         WIDBAD:     LDD   #-11
D574 3606             (    forth6809.asm):03800                     PSHU  D
D576 7ED970           (    forth6809.asm):03801                     JMP   THROWW

                      (    forth6809.asm):04277         
                      (    forth6809.asm):04278         ; ------------------------------------------------------------
                      (    forth6809.asm):04279         ; Convert a counted string to a number in BASE. A leading "-" negates
                      (    forth6809.asm):04280         ; it; a trailing "." makes it a double-cell number.
                      (    forth6809.asm):04281         ; NUMBERQ   ( c-addr -- n -1 | ud 1 | c-addr 0 )
                      (    forth6809.asm):04282         ;    Inputs:
                      (    forth6809.asm):04283         ;        c-addr of the counted string on the data stack
                      (    forth6809.asm):04284         ;    Outputs:
                      (    forth6809.asm):04285         ;        single number: n and -1
                      (    forth6809.asm):04286         ;        double number: ud (low cell below high cell) and 1
                      (    forth6809.asm):04287         ;        not a number: c-addr and 0
                      (    forth6809.asm):04288         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):04289         ; The original c-addr and the negate flag live in an S frame (0,S and
                      (    forth6809.asm):04290         ; 2,S); the count is kept in RegB. See shadow NUMBERQ.1 and
                      (    forth6809.asm):04291         ; NUMBERQ.6.
                      (    forth6809.asm):04292         ; ------------------------------------------------------------
D6A0 3710             (    forth6809.asm):04293         NUMBERQ:    PULU  X                 ; c-addr
D6A2 327D             (    forth6809.asm):04294                     LEAS  -3,S
D6A4 AFE4             (    forth6809.asm):04295                     STX   ,S
D6A6 E684             (    forth6809.asm):04296                     LDB   ,X
D6A8 276D             (    forth6809.asm):04297                     BEQ   NQBAD
D6AA 3001             (    forth6809.asm):04298                     LEAX  1,X
                      (    forth6809.asm):04299         
                      (    forth6809.asm):04300                     ; A trailing "." means a double number: leave it out of the
                      (    forth6809.asm):04301                     ; digit count. See shadow: NUMBERQ.1

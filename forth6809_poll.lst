                      (    forth6809.asm):03616         
D325 108C0000         (    forth6809.asm):03617         SKIPLP:     CMPY  #0
D329 274D             (    forth6809.asm):03618                     BEQ   EMPTY
D32B A684             (    forth6809.asm):03619                     LDA   ,X

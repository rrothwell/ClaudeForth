                      (    forth6809.asm):03239         ; ------------------------------------------------------------
                      (    forth6809.asm):03240         ; MARKER  ( "name" -- )
                      (    forth6809.asm):03241         ; Save DPHERE, CODEHERE, VARHERE, LATEST and the search order state in

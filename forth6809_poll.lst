CF94 16FFB3           (    forth6809.asm):02595                     LBRA  QLOOP
                      (    forth6809.asm):02596         
CF97 BDEF8E           (    forth6809.asm):02597         QSHOWERR:   JSR   CRW
CF9A 8ECFDD           (    forth6809.asm):02598                     LDX   #ERRMSG
CF9D 3610             (    forth6809.asm):02599                     PSHU  X                 ; c-addr
CF9F CC0008           (    forth6809.asm):02600                     LDD   #ERRMSGL
CFA2 3606             (    forth6809.asm):02601                     PSHU  D                 ; u
CFA4 BDE965           (    forth6809.asm):02602                     JSR   TYPEW
CFA7 ECE4             (    forth6809.asm):02603                     LDD   ,S
CFA9 3606             (    forth6809.asm):02604                     PSHU  D                 ; n
CFAB BDEE5D           (    forth6809.asm):02605                     JSR   DOTW
CFAE 326A             (    forth6809.asm):02606                     LEAS  10,S              ; drop the frame
CFB0 2098             (    forth6809.asm):02607                     BRA   QLOOP
                      (    forth6809.asm):02608         
CFB2 326A             (    forth6809.asm):02609         QOK:        LEAS  10,S              ; drop the frame
CFB4 BDEF8E           (    forth6809.asm):02610                     JSR   CRW               ; See bugfix: QOK.1
CFB7 DC00             (    forth6809.asm):02611                     LDD   STATE
CFB9 268F             (    forth6809.asm):02612                     BNE   QLOOP
CFBB 8ECFD9           (    forth6809.asm):02613                     LDX   #OKMSG
CFBE 3610             (    forth6809.asm):02614                     PSHU  X                 ; c-addr

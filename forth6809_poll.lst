                      (    forth6809.asm):04503         ; ------------------------------------------------------------
                      (    forth6809.asm):04504         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04505         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04506         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04507         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04508         ; ------------------------------------------------------------
D8A5 335E             (    forth6809.asm):04509         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
D8A7 CC0000           (    forth6809.asm):04510                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
D8AA EDC4             (    forth6809.asm):04511                     STD   ,U
                      (    forth6809.asm):04512         
                      (    forth6809.asm):04513                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04514                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04515                                             ; covers this, nothing extra needed

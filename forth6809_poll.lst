D468 313F             (    forth6809.asm):03602                     LEAY  -1,Y
D46A 3404             (    forth6809.asm):03603         ENDW:       PSHS  B                 ; Save the count. See bugfix: WORDW.3
D46C 1F10             (    forth6809.asm):03604                     TFR   X,D

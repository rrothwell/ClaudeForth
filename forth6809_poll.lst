D48A 5A               (    forth6809.asm):03669                     DECB
D48B 26F7             (    forth6809.asm):03670                     BNE   FDCMP
D48D 3510             (    forth6809.asm):03671         FDHIT:      PULS  X                 ; header
D48F 200F             (    forth6809.asm):03672                     BRA   FDRET
D491 3510             (    forth6809.asm):03673         FDMISS:     PULS  X
D493 E684             (    forth6809.asm):03674         FDNEXT:     LDB   ,X
D495 C41F             (    forth6809.asm):03675                     ANDB  #$1F
D497 4F               (    forth6809.asm):03676                     CLRA
D498 3001             (    forth6809.asm):03677                     LEAX  1,X
D49A 308B             (    forth6809.asm):03678                     LEAX  D,X
D49C AE84             (    forth6809.asm):03679                     LDX   ,X                ; LINK field
D49E 20C8             (    forth6809.asm):03680                     BRA   FDLOOP

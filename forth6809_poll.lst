DAB5 9E1A             (    forth6809.asm):04881         RPSCANOK:   LDX   MSCR4
DAB7 EC84             (    forth6809.asm):04882                     LDD   ,X
DAB9 10830002         (    forth6809.asm):04883                     CMPD  #TAGBACK
DABD 2712             (    forth6809.asm):04884                     BEQ   RPFOUND
DABF 10830001         (    forth6809.asm):04885                     CMPD  #TAGFWD
DAC3 2703             (    forth6809.asm):04886                     BEQ   RPSKIP

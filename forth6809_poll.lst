                      (    forth6809.asm):03782         ; ------------------------------------------------------------
                      (    forth6809.asm):03783         ; Throw -11 unless RegX is the address of a wordlist cell in use.
                      (    forth6809.asm):03784         ; WIDCHK
                      (    forth6809.asm):03785         ;    Inputs:
                      (    forth6809.asm):03786         ;        RegX = candidate WID
                      (    forth6809.asm):03787         ;    Outputs:
                      (    forth6809.asm):03788         ;        none if valid (RegX and RegY unchanged); THROW -11 if not
                      (    forth6809.asm):03789         ;    Registers: RegD and CC changed.
                      (    forth6809.asm):03790         ; ------------------------------------------------------------
D561 1F10             (    forth6809.asm):03791         WIDCHK:     TFR   X,D

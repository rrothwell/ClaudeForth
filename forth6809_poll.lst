                      (    forth6809.asm):04252         ; ============================================================
                      (    forth6809.asm):04253         ; SECTION 11: EXCEPTIONS (CFERR, CATCH, THROW)
                      (    forth6809.asm):04254         ; ============================================================
                      (    forth6809.asm):04255         ; ------------------------------------------------------------
                      (    forth6809.asm):04256         ; Report a control-structure mismatch: throw -22. Called by the
                      (    forth6809.asm):04257         ; control-flow words when the tag on the control-flow stack is not the
                      (    forth6809.asm):04258         ; one expected.
                      (    forth6809.asm):04259         ; CFERR
                      (    forth6809.asm):04260         ;    Inputs:
                      (    forth6809.asm):04261         ;        none
                      (    forth6809.asm):04262         ;    Outputs:
                      (    forth6809.asm):04263         ;        does not return (THROW -22)
                      (    forth6809.asm):04264         ;    Registers: RegD changed; THROW decides the rest.
                      (    forth6809.asm):04265         ; ------------------------------------------------------------
E3CE CCFFEA           (    forth6809.asm):04266         CFERR:      LDD   #-22
E3D1 3606             (    forth6809.asm):04267                     PSHU  D                 ; -22
E3D3 BDE403           (    forth6809.asm):04268                     JSR   THROWW
E3D6 39               (    forth6809.asm):04269                     RTS
                      (    forth6809.asm):04270         
                      (    forth6809.asm):04271         ; ------------------------------------------------------------
                      (    forth6809.asm):04272         ; CATCH  ( i*x xt -- j*x 0 | i*x n )
                      (    forth6809.asm):04273         ; Execute xt with an exception frame in place. On normal return push
                      (    forth6809.asm):04274         ; 0. If xt (or anything it calls) executes THROW with a non-zero n,
                      (    forth6809.asm):04275         ; THROW unwinds to this frame and CATCH returns n.
                      (    forth6809.asm):04276         ; Frame on S, top first: >IN, SRCID, SRCLEN, SRCADDR, saved U,
                      (    forth6809.asm):04277         ; previous HANDLER. HANDLER points at the >IN cell.
                      (    forth6809.asm):04278         ; ------------------------------------------------------------
E3D7 3710             (    forth6809.asm):04279         CATCHW:     PULU  X                 ; xt
E3D9 DC0C             (    forth6809.asm):04280                     LDD   HANDLER
E3DB 3406             (    forth6809.asm):04281                     PSHS  D
E3DD 3440             (    forth6809.asm):04282                     PSHS  U
                      (    forth6809.asm):04283                     ; Save the input source specification.
                      (    forth6809.asm):04284                     ; See bugfix: CATCHW.1
E3DF DC39             (    forth6809.asm):04285                     LDD   SRCADDR
E3E1 3406             (    forth6809.asm):04286                     PSHS  D
E3E3 DC3B             (    forth6809.asm):04287                     LDD   SRCLEN
E3E5 3406             (    forth6809.asm):04288                     PSHS  D
E3E7 DC3D             (    forth6809.asm):04289                     LDD   SRCID
E3E9 3406             (    forth6809.asm):04290                     PSHS  D
E3EB DC10             (    forth6809.asm):04291                     LDD   TOIN
E3ED 3406             (    forth6809.asm):04292                     PSHS  D
E3EF 1F40             (    forth6809.asm):04293                     TFR   S,D
E3F1 DD0C             (    forth6809.asm):04294                     STD   HANDLER
                      (    forth6809.asm):04295         
E3F3 AD84             (    forth6809.asm):04296                     JSR   ,X
                      (    forth6809.asm):04297         
E3F5 3268             (    forth6809.asm):04298                     LEAS  8,S               ; drop saved input source
E3F7 3262             (    forth6809.asm):04299                     LEAS  2,S               ; saved U
E3F9 3506             (    forth6809.asm):04300                     PULS  D
E3FB DD0C             (    forth6809.asm):04301                     STD   HANDLER
E3FD CC0000           (    forth6809.asm):04302                     LDD   #0
E400 3606             (    forth6809.asm):04303                     PSHU  D                 ; 0 = no exception
E402 39               (    forth6809.asm):04304                     RTS
                      (    forth6809.asm):04305         
                      (    forth6809.asm):04306         ; ------------------------------------------------------------
                      (    forth6809.asm):04307         ; THROW  ( k*x n -- k*x | i*x n )
                      (    forth6809.asm):04308         ; If n is zero, do nothing. Otherwise restore the state saved by the
                      (    forth6809.asm):04309         ; most recent CATCH (S, U, input source, >IN, HANDLER) and make that
                      (    forth6809.asm):04310         ; CATCH return n. With no CATCH active, push n and ABORT.
                      (    forth6809.asm):04311         ; ------------------------------------------------------------
E403 3706             (    forth6809.asm):04312         THROWW:     PULU  D                 ; n
E405 10830000         (    forth6809.asm):04313                     CMPD  #0
E409 2725             (    forth6809.asm):04314                     BEQ   THDONE
                      (    forth6809.asm):04315         
E40B DD0E             (    forth6809.asm):04316                     STD   THROWN
E40D 9E0C             (    forth6809.asm):04317                     LDX   HANDLER
E40F 2720             (    forth6809.asm):04318                     BEQ   THUNCAU
                      (    forth6809.asm):04319         
E411 1F14             (    forth6809.asm):04320                     TFR   X,S
E413 3506             (    forth6809.asm):04321                     PULS  D                 ; restore input source saved by CATCH
E415 DD10             (    forth6809.asm):04322                     STD   TOIN
E417 3506             (    forth6809.asm):04323                     PULS  D
E419 DD3D             (    forth6809.asm):04324                     STD   SRCID
E41B 3506             (    forth6809.asm):04325                     PULS  D
E41D DD3B             (    forth6809.asm):04326                     STD   SRCLEN
E41F 3506             (    forth6809.asm):04327                     PULS  D
E421 DD39             (    forth6809.asm):04328                     STD   SRCADDR
E423 3506             (    forth6809.asm):04329                     PULS  D
E425 1F03             (    forth6809.asm):04330                     TFR   D,U
E427 3506             (    forth6809.asm):04331                     PULS  D
E429 DD0C             (    forth6809.asm):04332                     STD   HANDLER
                      (    forth6809.asm):04333         
E42B DC0E             (    forth6809.asm):04334                     LDD   THROWN
E42D 3606             (    forth6809.asm):04335                     PSHU  D
E42F 39               (    forth6809.asm):04336                     RTS
E430 39               (    forth6809.asm):04337         THDONE:     RTS
                      (    forth6809.asm):04338         

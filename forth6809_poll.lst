                      (    forth6809.asm):03725         ; ------------------------------------------------------------
                      (    forth6809.asm):03726         ; FIND  ( c-addr -- c-addr 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03727         ; Look up the counted string in the search order, then in ROOT, ignoring
                      (    forth6809.asm):03728         ; smudged entries. Returns the xt and 1 if the word is immediate, or
                      (    forth6809.asm):03729         ; -1 if not. If not found, returns c-addr and 0.
                      (    forth6809.asm):03730         ; Holds no scratch cells; see shadow FINDW.1 and SEARCHORDER.1.
                      (    forth6809.asm):03731         ; ------------------------------------------------------------
D50C 10AEC4           (    forth6809.asm):03732         FINDW:      LDY   ,U                ; counted string
D50F E6A0             (    forth6809.asm):03733                     LDB   ,Y+
D511 8DBF             (    forth6809.asm):03734                     BSR   SRCHORD
D513 8C0000           (    forth6809.asm):03735                     CMPX  #0
D516 2712             (    forth6809.asm):03736                     BEQ   NOTFOUND
D518 8DE6             (    forth6809.asm):03737                     BSR   HDRXT
D51A AFC4             (    forth6809.asm):03738                     STX   ,U                ; xt replaces c-addr
D51C 4D               (    forth6809.asm):03739                     TSTA
D51D 2A05             (    forth6809.asm):03740                     BPL   FISNORM
D51F CC0001           (    forth6809.asm):03741                     LDD   #1
D522 2003             (    forth6809.asm):03742                     BRA   FPUSH
D524 CCFFFF           (    forth6809.asm):03743         FISNORM:    LDD   #-1
D527 3606             (    forth6809.asm):03744         FPUSH:      PSHU  D                 ; 1 = immediate, -1 = normal
D529 39               (    forth6809.asm):03745                     RTS
                      (    forth6809.asm):03746         
D52A CC0000           (    forth6809.asm):03747         NOTFOUND:   LDD   #0
D52D 3606             (    forth6809.asm):03748                     PSHU  D                 ; 0 = not found, c-addr still beneath
D52F 39               (    forth6809.asm):03749                     RTS
                      (    forth6809.asm):03750         
                      (    forth6809.asm):03751         ; ------------------------------------------------------------
                      (    forth6809.asm):03752         ; SEARCH-WORDLIST  ( c-addr u wid -- 0 | xt 1 | xt -1 )
                      (    forth6809.asm):03753         ; Search the one wordlist wid for the name c-addr u. Returns 0 if it is
                      (    forth6809.asm):03754         ; not found, else its xt and 1 if the word is immediate or -1 if not.
                      (    forth6809.asm):03755         ; Throws -11 for an invalid wid.
                      (    forth6809.asm):03756         ; ------------------------------------------------------------
D530 3710             (    forth6809.asm):03757         SEARCHWLW:  PULU  X                 ; wid
D532 8D2D             (    forth6809.asm):03758                     BSR   WIDCHK
D534 AE84             (    forth6809.asm):03759                     LDX   ,X                ; newest header of the wordlist
D536 3706             (    forth6809.asm):03760                     PULU  D                 ; u
D538 3720             (    forth6809.asm):03761                     PULU  Y                 ; c-addr
D53A 4D               (    forth6809.asm):03762                     TSTA
D53B 261E             (    forth6809.asm):03763                     BNE   SWNOT             ; longer than any name
D53D C11F             (    forth6809.asm):03764                     CMPB  #31
D53F 221A             (    forth6809.asm):03765                     BHI   SWNOT
D541 BDD495           (    forth6809.asm):03766                     JSR   FDSEARCH
D544 8C0000           (    forth6809.asm):03767                     CMPX  #0
D547 2712             (    forth6809.asm):03768                     BEQ   SWNOT
D549 8DB5             (    forth6809.asm):03769                     BSR   HDRXT
D54B 3610             (    forth6809.asm):03770                     PSHU  X                 ; xt
D54D 4D               (    forth6809.asm):03771                     TSTA
D54E 2A05             (    forth6809.asm):03772                     BPL   SWNORM
D550 CC0001           (    forth6809.asm):03773                     LDD   #1
D553 2003             (    forth6809.asm):03774                     BRA   SWPUSH
D555 CCFFFF           (    forth6809.asm):03775         SWNORM:     LDD   #-1
D558 3606             (    forth6809.asm):03776         SWPUSH:     PSHU  D
D55A 39               (    forth6809.asm):03777                     RTS
D55B CC0000           (    forth6809.asm):03778         SWNOT:      LDD   #0
D55E 3606             (    forth6809.asm):03779                     PSHU  D
D560 39               (    forth6809.asm):03780                     RTS

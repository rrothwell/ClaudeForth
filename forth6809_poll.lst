                      (    forth6809.asm):04558         ; ------------------------------------------------------------
                      (    forth6809.asm):04559         ; KEY, KEY? and EMIT go through the vectors KEYV, KEYQV and EMITV
                      (    forth6809.asm):04560         ; (page zero) so character I/O can be redirected. IOVINIT points
                      (    forth6809.asm):04561         ; them back at the ACIA routines; it runs at cold start, warm start
                      (    forth6809.asm):04562         ; and when QUIT handles an error.
                      (    forth6809.asm):04563         ; ------------------------------------------------------------
                      (    forth6809.asm):04564         ; Original direct entry points: shadow IOVEC.1.
D801 6E9F0087         (    forth6809.asm):04565         KEYW:       JMP   [KEYV]
D805 6E9F0089         (    forth6809.asm):04566         KEYQW:      JMP   [KEYQV]
D809 6E9F0085         (    forth6809.asm):04567         EMITW:      JMP   [EMITV]
                      (    forth6809.asm):04568         
                      (    forth6809.asm):04569         ; ------------------------------------------------------------
                      (    forth6809.asm):04570         ; IRQ-CHAIN ( -- addr )   address of the cell holding the next interrupt
                      (    forth6809.asm):04571         ; handler for interrupts that did not come from the ACIA.
                      (    forth6809.asm):04572         ; (EMIT) ( -- addr )  (KEY) ( -- addr )  (KEY?) ( -- addr )
                      (    forth6809.asm):04573         ; addresses of the cells holding the xt used by EMIT, KEY and KEY?.
                      (    forth6809.asm):04574         ; ------------------------------------------------------------
D80D CC0083           (    forth6809.asm):04575         IRQCHAINW:  LDD   #IRQCHAIN
D810 3606             (    forth6809.asm):04576                     PSHU  D
D812 39               (    forth6809.asm):04577                     RTS
D813 CC0085           (    forth6809.asm):04578         EMITVW:     LDD   #EMITV
D816 3606             (    forth6809.asm):04579                     PSHU  D
D818 39               (    forth6809.asm):04580                     RTS
D819 CC0087           (    forth6809.asm):04581         KEYVW:      LDD   #KEYV
D81C 3606             (    forth6809.asm):04582                     PSHU  D
D81E 39               (    forth6809.asm):04583                     RTS
D81F CC0089           (    forth6809.asm):04584         KEYQVW:     LDD   #KEYQV
D822 3606             (    forth6809.asm):04585                     PSHU  D
D824 39               (    forth6809.asm):04586                     RTS
                      (    forth6809.asm):04587         
D825 CCCE33           (    forth6809.asm):04588         COLDIO:     LDD   #IRQRTI           ; cold start only: no extra interrupt
D828 DD83             (    forth6809.asm):04589                     STD   IRQCHAIN          ; handlers, then the same as IOVINIT
D82A CCD7F0           (    forth6809.asm):04590         IOVINIT:    LDD   #EMITACIA
D82D DD85             (    forth6809.asm):04591                     STD   EMITV
D82F CCD793           (    forth6809.asm):04592                     LDD   #KEYACIA
D832 DD87             (    forth6809.asm):04593                     STD   KEYV
D834 CCD7DD           (    forth6809.asm):04594                     LDD   #KEYQACIA
D837 DD89             (    forth6809.asm):04595                     STD   KEYQV
D839 39               (    forth6809.asm):04596                     RTS
                      (    forth6809.asm):04597         
                      (    forth6809.asm):04598         ; ------------------------------------------------------------
                      (    forth6809.asm):04599         ; ACCEPT  ( c-addr +n1 -- +n2 )
                      (    forth6809.asm):04600         ; Read a line of up to +n1 characters into the buffer at c-addr,
                      (    forth6809.asm):04601         ; echoing as it goes. Backspace and DEL erase the last character; LF
                      (    forth6809.asm):04602         ; is ignored; CR ends the line. Returns the count +n2.
                      (    forth6809.asm):04603         ; ------------------------------------------------------------
D83A 335E             (    forth6809.asm):04604         ACCEPTW:    LEAU  -2,U              ; local count at 0,U; then +n1 at 2,U and
D83C CC0000           (    forth6809.asm):04605                     LDD   #0                ; c-addr at 4,U. See shadow ACCEPTW.5
D83F EDC4             (    forth6809.asm):04606                     STD   ,U
                      (    forth6809.asm):04607         
                      (    forth6809.asm):04608                     IFEQ  SERIALPOLL        ; >>>>>>>>>>  interrupt-driven build: real
                      (    forth6809.asm):04609                                             ; RTS/CTS hardware flow control already
                      (    forth6809.asm):04610                                             ; covers this, nothing extra needed
                      (    forth6809.asm):04611                     ELSE                    ; <<<<<>>>>>  polling build: tell the host it's safe to
                      (    forth6809.asm):04612                                             ; stream this line's characters

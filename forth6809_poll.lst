                      (    forth6809.asm):02658         ; ============================================================
                      (    forth6809.asm):02659         ; SECTION 5: INNER-INTERPRETER SUPPORT (LIT, ZBRANCH, BRANCH,
                      (    forth6809.asm):02660         ; DODOES, DODEFER, EXECUTE)
                      (    forth6809.asm):02661         ; ============================================================
                      (    forth6809.asm):02662         ; ------------------------------------------------------------
                      (    forth6809.asm):02663         ; Run-time for a literal: fetch the inline cell that follows the
                      (    forth6809.asm):02664         ; calling JSR, push it, and advance the return address past it.
                      (    forth6809.asm):02665         ; LIT   ( -- x )
                      (    forth6809.asm):02666         ;    Inputs:
                      (    forth6809.asm):02667         ;        return stack top = address of the inline 16-bit literal
                      (    forth6809.asm):02668         ;    Outputs:
                      (    forth6809.asm):02669         ;        x pushed on the data stack; return address advanced by 2
                      (    forth6809.asm):02670         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02671         ; ------------------------------------------------------------
CEC0 3510             (    forth6809.asm):02672         LIT:        PULS  X
CEC2 EC81             (    forth6809.asm):02673                     LDD   ,X++
CEC4 3606             (    forth6809.asm):02674                     PSHU  D                 ; x
CEC6 3410             (    forth6809.asm):02675                     PSHS  X
CEC8 39               (    forth6809.asm):02676                     RTS
                      (    forth6809.asm):02677         
                      (    forth6809.asm):02678         ; ------------------------------------------------------------
                      (    forth6809.asm):02679         ; Run-time for a conditional branch: take the inline offset if the
                      (    forth6809.asm):02680         ; flag is false, otherwise skip it. The offset is relative to its own
                      (    forth6809.asm):02681         ; address.
                      (    forth6809.asm):02682         ; ZBRANCH   ( flag -- )
                      (    forth6809.asm):02683         ;    Inputs:
                      (    forth6809.asm):02684         ;        flag on the data stack
                      (    forth6809.asm):02685         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02686         ;    Outputs:
                      (    forth6809.asm):02687         ;        flag removed; return address set to the branch target or past
                      (    forth6809.asm):02688         ;        the offset
                      (    forth6809.asm):02689         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02690         ; ------------------------------------------------------------
CEC9 3706             (    forth6809.asm):02691         ZBRANCH:    PULU  D                 ; flag
CECB 3510             (    forth6809.asm):02692                     PULS  X
CECD 10830000         (    forth6809.asm):02693                     CMPD  #0
CED1 2607             (    forth6809.asm):02694                     BNE   ZSKIP
CED3 EC84             (    forth6809.asm):02695                     LDD   ,X
CED5 308B             (    forth6809.asm):02696                     LEAX  D,X
CED7 3410             (    forth6809.asm):02697                     PSHS  X
CED9 39               (    forth6809.asm):02698                     RTS
CEDA 3002             (    forth6809.asm):02699         ZSKIP:      LEAX  2,X
CEDC 3410             (    forth6809.asm):02700                     PSHS  X
CEDE 39               (    forth6809.asm):02701                     RTS
                      (    forth6809.asm):02702         
                      (    forth6809.asm):02703         ; ------------------------------------------------------------
                      (    forth6809.asm):02704         ; Run-time for an unconditional branch: add the inline offset
                      (    forth6809.asm):02705         ; (relative to its own address) to the return address.
                      (    forth6809.asm):02706         ; BRANCH
                      (    forth6809.asm):02707         ;    Inputs:
                      (    forth6809.asm):02708         ;        return stack top = address of the inline 16-bit offset
                      (    forth6809.asm):02709         ;    Outputs:
                      (    forth6809.asm):02710         ;        return address set to the branch target
                      (    forth6809.asm):02711         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02712         ; ------------------------------------------------------------
CEDF 3510             (    forth6809.asm):02713         BRANCH:     PULS  X
CEE1 EC84             (    forth6809.asm):02714                     LDD   ,X
CEE3 308B             (    forth6809.asm):02715                     LEAX  D,X
CEE5 3410             (    forth6809.asm):02716                     PSHS  X
CEE7 39               (    forth6809.asm):02717                     RTS
                      (    forth6809.asm):02718         
                      (    forth6809.asm):02719         ; ------------------------------------------------------------
                      (    forth6809.asm):02720         ; Run-time entry of a CREATEd or DOES>-defined word. Its code is a
                      (    forth6809.asm):02721         ; trampoline: JSR DODOES, a BEHAVIOR address, then the data-field
                      (    forth6809.asm):02722         ; address. Pushes the data-field address and jumps to BEHAVIOR.
                      (    forth6809.asm):02723         ; DODOES   ( -- pfa )
                      (    forth6809.asm):02724         ;    Inputs:
                      (    forth6809.asm):02725         ;        return stack top = address of the BEHAVIOR cell in the
                      (    forth6809.asm):02726         ;        trampoline
                      (    forth6809.asm):02727         ;    Outputs:
                      (    forth6809.asm):02728         ;        pfa pushed on the data stack; control passes to BEHAVIOR
                      (    forth6809.asm):02729         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02730         ; ------------------------------------------------------------
CEE8 3510             (    forth6809.asm):02731         DODOES:     PULS  X
CEEA 10AE81           (    forth6809.asm):02732                     LDY   ,X++
CEED EC84             (    forth6809.asm):02733                     LDD   ,X
CEEF 3606             (    forth6809.asm):02734                     PSHU  D                 ; pfa
CEF1 6EA4             (    forth6809.asm):02735                     JMP   ,Y
                      (    forth6809.asm):02736         
                      (    forth6809.asm):02737         ; ------------------------------------------------------------
                      (    forth6809.asm):02738         ; Default BEHAVIOR for a CREATEd word: do nothing, leaving the data-
                      (    forth6809.asm):02739         ; field address on the stack.
                      (    forth6809.asm):02740         ; DOESRT0
                      (    forth6809.asm):02741         ;    Inputs:
                      (    forth6809.asm):02742         ;        none
                      (    forth6809.asm):02743         ;    Outputs:
                      (    forth6809.asm):02744         ;        none
                      (    forth6809.asm):02745         ;    Registers: none.
                      (    forth6809.asm):02746         ; ------------------------------------------------------------
CEF3 39               (    forth6809.asm):02747         DOESRT0:    RTS
                      (    forth6809.asm):02748         
                      (    forth6809.asm):02749         ; ------------------------------------------------------------
                      (    forth6809.asm):02750         ; Run-time for DOES>: patch the BEHAVIOR cell of the most recent
                      (    forth6809.asm):02751         ; definition with the code that follows the calling JSR, then return
                      (    forth6809.asm):02752         ; two levels up, skipping the rest of the defining word.
                      (    forth6809.asm):02753         ; SETDOES
                      (    forth6809.asm):02754         ;    Inputs:
                      (    forth6809.asm):02755         ;        return stack top = address after "JSR SETDOES" (the new
                      (    forth6809.asm):02756         ;        BEHAVIOR)
                      (    forth6809.asm):02757         ;        next on the return stack = the defining word's own return
                      (    forth6809.asm):02758         ;        address
                      (    forth6809.asm):02759         ;    Outputs:
                      (    forth6809.asm):02760         ;        BEHAVIOR cell of LATEST patched; control returns to the
                      (    forth6809.asm):02761         ;        defining word's caller
                      (    forth6809.asm):02762         ;    Registers: RegD, RegX, RegY and CC changed.
                      (    forth6809.asm):02763         ; ------------------------------------------------------------
CEF4 3510             (    forth6809.asm):02764         SETDOES:    PULS  X                 ; X = addr right after "JSR SETDOES" - new BEHAVIOR
CEF6 1F12             (    forth6809.asm):02765                     TFR   X,Y               ; Y = new BEHAVIOR, kept across the walk
                      (    forth6809.asm):02766         
CEF8 9E04             (    forth6809.asm):02767                     LDX   LATEST
CEFA E684             (    forth6809.asm):02768                     LDB   ,X
CEFC C41F             (    forth6809.asm):02769                     ANDB  #$1F
CEFE 4F               (    forth6809.asm):02770                     CLRA
CEFF 308B             (    forth6809.asm):02771                     LEAX  D,X               ; header + name length
CF01 EC03             (    forth6809.asm):02772                     LDD   3,X               ; D = CFA (trampoline address), past name and LINK
CF03 C30003           (    forth6809.asm):02773                     ADDD  #3                ; +3 -> BEHAVIOR field (past JSR DODOES)
CF06 1F01             (    forth6809.asm):02774                     TFR   D,X
                      (    forth6809.asm):02775         
CF08 10AF84           (    forth6809.asm):02776                     STY   ,X                ; patch it
                      (    forth6809.asm):02777         
CF0B 3510             (    forth6809.asm):02778                     PULS  X                 ; X = the OUTER defining word's own return addr
CF0D 6E84             (    forth6809.asm):02779                     JMP   ,X                ; jump there directly - "double RTS"
                      (    forth6809.asm):02780         
                      (    forth6809.asm):02781         ; ------------------------------------------------------------
                      (    forth6809.asm):02782         ; BEHAVIOR of a DEFERred word: execute the xt stored in its data
                      (    forth6809.asm):02783         ; field. Tail-calls the xt, so it returns to the original caller.
                      (    forth6809.asm):02784         ; DODEFER   ( pfa -- )
                      (    forth6809.asm):02785         ;    Inputs:
                      (    forth6809.asm):02786         ;        pfa on the data stack
                      (    forth6809.asm):02787         ;    Outputs:
                      (    forth6809.asm):02788         ;        pfa removed; the stored xt is executed
                      (    forth6809.asm):02789         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):02790         ; ------------------------------------------------------------
CF0F 3710             (    forth6809.asm):02791         DODEFER:    PULU  X                 ; pfa
CF11 EC84             (    forth6809.asm):02792                     LDD   ,X
CF13 1F01             (    forth6809.asm):02793                     TFR   D,X
CF15 6E84             (    forth6809.asm):02794                     JMP   ,X
                      (    forth6809.asm):02795         
                      (    forth6809.asm):02796         ; ------------------------------------------------------------
                      (    forth6809.asm):02797         ; Initial xt of a DEFER: throws -21 until IS stores a real xt.
                      (    forth6809.asm):02798         ; DOABORTUNDEF
                      (    forth6809.asm):02799         ;    Inputs:
                      (    forth6809.asm):02800         ;        none
                      (    forth6809.asm):02801         ;    Outputs:
                      (    forth6809.asm):02802         ;        none (does not return)
                      (    forth6809.asm):02803         ;    Registers: RegD changed.
                      (    forth6809.asm):02804         ; ------------------------------------------------------------
CF17                  (    forth6809.asm):02805         DOABORTUNDEF:
CF17 CCFFEB           (    forth6809.asm):02806                     LDD   #-21
CF1A 3606             (    forth6809.asm):02807                     PSHU  D                 ; throw code (-21)
CF1C 7ED895           (    forth6809.asm):02808                     JMP   THROWW
                      (    forth6809.asm):02809         
                      (    forth6809.asm):02810         ; ------------------------------------------------------------
                      (    forth6809.asm):02811         ; BEHAVIOR of a MARKER word: restore the dictionary, code and variable
                      (    forth6809.asm):02812         ; pointers and LATEST from the four cells saved when it was defined,
                      (    forth6809.asm):02813         ; then the search order state (SRCHSAVESZ bytes after them), then
                      (    forth6809.asm):02814         ; unlink every RAM header newer than DPHERE from every wordlist.
                      (    forth6809.asm):02815         ; DOMARKER   ( pfa -- )
                      (    forth6809.asm):02816         ;    Inputs:
                      (    forth6809.asm):02817         ;        pfa on the data stack (the saved cells)
                      (    forth6809.asm):02818         ;    Outputs:
                      (    forth6809.asm):02819         ;        pfa removed; DPHERE, CODEHERE, VARHERE, LATEST, WLEND, CURRENT
                      (    forth6809.asm):02820         ;        and the search order restored; wordlists pruned
                      (    forth6809.asm):02821         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):02822         ; ------------------------------------------------------------
CF1F 3710             (    forth6809.asm):02823         DOMARKER:   PULU  X                 ; pfa
CF21 EC84             (    forth6809.asm):02824                     LDD   ,X
CF23 DD06             (    forth6809.asm):02825                     STD   DPHERE
CF25 EC02             (    forth6809.asm):02826                     LDD   2,X
CF27 DD08             (    forth6809.asm):02827                     STD   CODEHERE
CF29 EC04             (    forth6809.asm):02828                     LDD   4,X
CF2B DD0A             (    forth6809.asm):02829                     STD   VARHERE
CF2D EC06             (    forth6809.asm):02830                     LDD   6,X
CF2F DD04             (    forth6809.asm):02831                     STD   LATEST
CF31 3008             (    forth6809.asm):02832                     LEAX  8,X               ; the saved search-order state follows
CF33 108E0045         (    forth6809.asm):02833                     LDY   #SRCHSAVE
CF37 C616             (    forth6809.asm):02834                     LDB   #SRCHSAVESZ
CF39 A680             (    forth6809.asm):02835         DMCOPY:     LDA   ,X+
CF3B A7A0             (    forth6809.asm):02836                     STA   ,Y+
CF3D 5A               (    forth6809.asm):02837                     DECB
CF3E 26F9             (    forth6809.asm):02838                     BNE   DMCOPY
CF40 DC06             (    forth6809.asm):02839                     LDD   DPHERE
CF42 7ED486           (    forth6809.asm):02840                     JMP   PRUNE             ; unlink headers newer than DPHERE
                      (    forth6809.asm):02841         
                      (    forth6809.asm):02842         ; ------------------------------------------------------------
                      (    forth6809.asm):02843         ; EXECUTE  ( i*x xt -- j*x )
                      (    forth6809.asm):02844         ; Execute the word whose execution token is xt.
                      (    forth6809.asm):02845         ; ------------------------------------------------------------
CF45 3710             (    forth6809.asm):02846         EXECUTEW:   PULU  X                 ; xt
CF47 AD84             (    forth6809.asm):02847                     JSR   ,X
CF49 39               (    forth6809.asm):02848                     RTS
                      (    forth6809.asm):02849         
                      (    forth6809.asm):02850         ; ============================================================
                      (    forth6809.asm):02851         ; SECTION 6: COMMA FAMILY (factored via APPENDCELL/APPENDBYTE)
                      (    forth6809.asm):02852         ; ============================================================
                      (    forth6809.asm):02853         ; ------------------------------------------------------------
                      (    forth6809.asm):02854         ; Append a 16-bit cell to the area whose "here" pointer is at RegX
                      (    forth6809.asm):02855         ; (CODEHERE or VARHERE), and advance that pointer by 2.
                      (    forth6809.asm):02856         ; APPENDCELL   ( x -- )
                      (    forth6809.asm):02857         ;    Inputs:
                      (    forth6809.asm):02858         ;        RegX = address of the here pointer
                      (    forth6809.asm):02859         ;        x on the data stack
                      (    forth6809.asm):02860         ;    Outputs:
                      (    forth6809.asm):02861         ;        x stored at the old here value; pointer advanced by 2
                      (    forth6809.asm):02862         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02863         ; ------------------------------------------------------------
CF4A 3706             (    forth6809.asm):02864         APPENDCELL: PULU  D                 ; x
CF4C 10AE84           (    forth6809.asm):02865                     LDY   ,X
CF4F EDA1             (    forth6809.asm):02866                     STD   ,Y++
CF51 10AF84           (    forth6809.asm):02867                     STY   ,X
CF54 39               (    forth6809.asm):02868                     RTS
                      (    forth6809.asm):02869         
                      (    forth6809.asm):02870         ; ------------------------------------------------------------
                      (    forth6809.asm):02871         ; Append the low byte of the top cell to the area whose "here" pointer
                      (    forth6809.asm):02872         ; is at RegX (CODEHERE or VARHERE), and advance that pointer by 1.
                      (    forth6809.asm):02873         ; APPENDBYTE   ( char -- )
                      (    forth6809.asm):02874         ;    Inputs:
                      (    forth6809.asm):02875         ;        RegX = address of the here pointer
                      (    forth6809.asm):02876         ;        char on the data stack
                      (    forth6809.asm):02877         ;    Outputs:
                      (    forth6809.asm):02878         ;        char stored at the old here value; pointer advanced by 1
                      (    forth6809.asm):02879         ;    Registers: RegD, RegY and CC changed.
                      (    forth6809.asm):02880         ; ------------------------------------------------------------
CF55 3706             (    forth6809.asm):02881         APPENDBYTE: PULU  D                 ; char
CF57 10AE84           (    forth6809.asm):02882                     LDY   ,X
CF5A E7A0             (    forth6809.asm):02883                     STB   ,Y+
CF5C 10AF84           (    forth6809.asm):02884                     STY   ,X
CF5F 39               (    forth6809.asm):02885                     RTS
                      (    forth6809.asm):02886         
                      (    forth6809.asm):02887         ; ------------------------------------------------------------
                      (    forth6809.asm):02888         ; ,  ( x -- )
                      (    forth6809.asm):02889         ; Append x to the code/data area (CODEHERE).
                      (    forth6809.asm):02890         ; ------------------------------------------------------------
CF60 8E0008           (    forth6809.asm):02891         COMMAW:     LDX   #CODEHERE
CF63 7ECF4A           (    forth6809.asm):02892                     JMP   APPENDCELL
                      (    forth6809.asm):02893         
                      (    forth6809.asm):02894         ; ------------------------------------------------------------
                      (    forth6809.asm):02895         ; CODECOMMA  ( x -- )
                      (    forth6809.asm):02896         ; Internal name for ",": append x at CODEHERE.
                      (    forth6809.asm):02897         ; ------------------------------------------------------------
CF66 8E0008           (    forth6809.asm):02898         CODECOMMA:  LDX   #CODEHERE
CF69 7ECF4A           (    forth6809.asm):02899                     JMP   APPENDCELL
                      (    forth6809.asm):02900         
                      (    forth6809.asm):02901         ; ------------------------------------------------------------
                      (    forth6809.asm):02902         ; C,  ( char -- )
                      (    forth6809.asm):02903         ; Append char to the code/data area (CODEHERE).
                      (    forth6809.asm):02904         ; ------------------------------------------------------------
CF6C 8E0008           (    forth6809.asm):02905         CCOMMAW:    LDX   #CODEHERE
CF6F 7ECF55           (    forth6809.asm):02906                     JMP   APPENDBYTE
                      (    forth6809.asm):02907         
                      (    forth6809.asm):02908         ; ------------------------------------------------------------
                      (    forth6809.asm):02909         ; CCOMMA1  ( char -- )
                      (    forth6809.asm):02910         ; Internal name for "C,": append char at CODEHERE.
                      (    forth6809.asm):02911         ; ------------------------------------------------------------
CF72 8E0008           (    forth6809.asm):02912         CCOMMA1:    LDX   #CODEHERE
CF75 7ECF55           (    forth6809.asm):02913                     JMP   APPENDBYTE
                      (    forth6809.asm):02914         
                      (    forth6809.asm):02915         ; ------------------------------------------------------------
                      (    forth6809.asm):02916         ; V,  ( x -- )
                      (    forth6809.asm):02917         ; Append x to the variable area (VARHERE).
                      (    forth6809.asm):02918         ; ------------------------------------------------------------
CF78 8E000A           (    forth6809.asm):02919         VCOMMAW:    LDX   #VARHERE
CF7B 7ECF4A           (    forth6809.asm):02920                     JMP   APPENDCELL
                      (    forth6809.asm):02921         
                      (    forth6809.asm):02922         ; ------------------------------------------------------------
                      (    forth6809.asm):02923         ; VC,  ( char -- )
                      (    forth6809.asm):02924         ; Append char to the variable area (VARHERE).
                      (    forth6809.asm):02925         ; ------------------------------------------------------------
CF7E 8E000A           (    forth6809.asm):02926         VCCOMMAW:   LDX   #VARHERE
CF81 7ECF55           (    forth6809.asm):02927                     JMP   APPENDBYTE
                      (    forth6809.asm):02928         
                      (    forth6809.asm):02929         ; ------------------------------------------------------------
                      (    forth6809.asm):02930         ; ALLOT  ( n -- )
                      (    forth6809.asm):02931         ; Reserve n bytes in the code/data area by advancing CODEHERE.
                      (    forth6809.asm):02932         ; ------------------------------------------------------------
CF84 3706             (    forth6809.asm):02933         ALLOTW:     PULU  D                 ; n
CF86 9E08             (    forth6809.asm):02934                     LDX   CODEHERE
CF88 308B             (    forth6809.asm):02935                     LEAX  D,X
CF8A 9F08             (    forth6809.asm):02936                     STX   CODEHERE
CF8C 39               (    forth6809.asm):02937                     RTS
                      (    forth6809.asm):02938         
                      (    forth6809.asm):02939         ; ------------------------------------------------------------
                      (    forth6809.asm):02940         ; VALLOT  ( n -- )
                      (    forth6809.asm):02941         ; Reserve n bytes in the variable area by advancing VARHERE.
                      (    forth6809.asm):02942         ; ------------------------------------------------------------
CF8D 3706             (    forth6809.asm):02943         VALLOTW:    PULU  D                 ; n
CF8F 9E0A             (    forth6809.asm):02944                     LDX   VARHERE
CF91 308B             (    forth6809.asm):02945                     LEAX  D,X
CF93 9F0A             (    forth6809.asm):02946                     STX   VARHERE
CF95 39               (    forth6809.asm):02947                     RTS
                      (    forth6809.asm):02948         
                      (    forth6809.asm):02949         ; ------------------------------------------------------------
                      (    forth6809.asm):02950         ; HERE  ( -- addr )
                      (    forth6809.asm):02951         ; Return the next free address in the code/data area (CODEHERE).
                      (    forth6809.asm):02952         ; ------------------------------------------------------------
CF96 DC08             (    forth6809.asm):02953         HEREW:      LDD   CODEHERE
CF98 3606             (    forth6809.asm):02954                     PSHU  D                 ; addr
CF9A 39               (    forth6809.asm):02955                     RTS
                      (    forth6809.asm):02956         
                      (    forth6809.asm):02957         ; ------------------------------------------------------------
                      (    forth6809.asm):02958         ; VHERE  ( -- addr )
                      (    forth6809.asm):02959         ; Return the next free address in the variable area (VARHERE).
                      (    forth6809.asm):02960         ; ------------------------------------------------------------
CF9B DC0A             (    forth6809.asm):02961         VHEREW:     LDD   VARHERE
CF9D 3606             (    forth6809.asm):02962                     PSHU  D                 ; addr
CF9F 39               (    forth6809.asm):02963                     RTS
                      (    forth6809.asm):02964         
                      (    forth6809.asm):02965         ; ------------------------------------------------------------
                      (    forth6809.asm):02966         ; PAD  ( -- c-addr )
                      (    forth6809.asm):02967         ; Return the scratch buffer address, PADOFFSET bytes above CODEHERE.
                      (    forth6809.asm):02968         ; ------------------------------------------------------------
CFA0 DC08             (    forth6809.asm):02969         PADW:       LDD   CODEHERE
CFA2 C30080           (    forth6809.asm):02970                     ADDD  #PADOFFSET
CFA5 3606             (    forth6809.asm):02971                     PSHU  D                 ; c-addr
CFA7 39               (    forth6809.asm):02972                     RTS
                      (    forth6809.asm):02973         
                      (    forth6809.asm):02974         ; ------------------------------------------------------------
                      (    forth6809.asm):02975         ; UNUSED  ( -- u )
                      (    forth6809.asm):02976         ; Return the number of free bytes remaining in the code/data area.
                      (    forth6809.asm):02977         ; ------------------------------------------------------------
CFA8 CCB900           (    forth6809.asm):02978         UNUSEDW:    LDD   #CODETOP
CFAB 9308             (    forth6809.asm):02979                     SUBD  CODEHERE
CFAD 3606             (    forth6809.asm):02980                     PSHU  D                 ; u
CFAF 39               (    forth6809.asm):02981                     RTS
                      (    forth6809.asm):02982         
                      (    forth6809.asm):02983         ; ------------------------------------------------------------
                      (    forth6809.asm):02984         ; VUNUSED  ( -- u )
                      (    forth6809.asm):02985         ; Return the number of free bytes remaining in the variable area.
                      (    forth6809.asm):02986         ; ------------------------------------------------------------
CFB0 CC1FFF           (    forth6809.asm):02987         VUNUSEDW:   LDD   #APPVARSEND       ; See bugfix: VUNUSEDW.1
CFB3 930A             (    forth6809.asm):02988                     SUBD  VARHERE
CFB5 3606             (    forth6809.asm):02989                     PSHU  D                 ; u
CFB7 39               (    forth6809.asm):02990                     RTS
                      (    forth6809.asm):02991         
                      (    forth6809.asm):02992         ; ============================================================
                      (    forth6809.asm):02993         ; SECTION 7: HEADER (factored from :/CREATE/VARIABLE)
                      (    forth6809.asm):02994         ; ============================================================
                      (    forth6809.asm):02995         ; ------------------------------------------------------------
                      (    forth6809.asm):02996         ; Build a dictionary header for the next name in the input: parse the
                      (    forth6809.asm):02997         ; name, then lay down the length byte (with the smudge bit set if
                      (    forth6809.asm):02998         ; requested), the name, the link to the previous header and the code
                      (    forth6809.asm):02999         ; field address (CODEHERE). LATEST, DPHERE and the head of the CURRENT
                      (    forth6809.asm):03000         ; wordlist are updated.
                      (    forth6809.asm):03001         ; HEADER   ( smudge-flag "name" -- )   Throws -16 for an empty name and
                      (    forth6809.asm):03002         ;    -19 for a name of more than 31 characters (the length byte holds the
                      (    forth6809.asm):03003         ;    length in bits 0-4 and the flags in bits 5-7).
                      (    forth6809.asm):03004         ;    Inputs:
                      (    forth6809.asm):03005         ;        smudge-flag on the data stack (non-zero hides the new word)
                      (    forth6809.asm):03006         ;        name parsed from the input stream
                      (    forth6809.asm):03007         ;    Outputs:
                      (    forth6809.asm):03008         ;        header built at DPHERE, linked into the CURRENT wordlist;
                      (    forth6809.asm):03009         ;        LATEST = address of the new header
                      (    forth6809.asm):03010         ;    Registers: RegA, RegB, RegX, RegY and CC changed.
                      (    forth6809.asm):03011         ; ------------------------------------------------------------
CFB8 CC0020           (    forth6809.asm):03012         HEADER:     LDD   #32
CFBB 3606             (    forth6809.asm):03013                     PSHU  D
CFBD BDD30F           (    forth6809.asm):03014                     JSR   WORDW
CFC0 3710             (    forth6809.asm):03015                     PULU  X                 ; c-addr of the name
CFC2 3706             (    forth6809.asm):03016                     PULU  D                 ; smudge flag in B
CFC4 A680             (    forth6809.asm):03017                     LDA   ,X+               ; name length, X = name text
CFC6 2731             (    forth6809.asm):03018                     BEQ   HDZERO            ; no name: throw -16
CFC8 811F             (    forth6809.asm):03019                     CMPA  #31
CFCA 2232             (    forth6809.asm):03020                     BHI   HDLONG            ; over 31 characters: throw -19
CFCC 3402             (    forth6809.asm):03021                     PSHS  A                 ; 2,S = length (5k: S-frame, no scratch)
CFCE 5D               (    forth6809.asm):03022                     TSTB
CFCF 2702             (    forth6809.asm):03023                     BEQ   HDNOSM
CFD1 8A40             (    forth6809.asm):03024                     ORA   #$40
CFD3 109E06           (    forth6809.asm):03025         HDNOSM:     LDY   DPHERE
CFD6 3420             (    forth6809.asm):03026                     PSHS  Y                 ; 0,S = address of the new header
CFD8 A7A0             (    forth6809.asm):03027                     STA   ,Y+
CFDA E662             (    forth6809.asm):03028                     LDB   2,S               ; length is 1 to 31 here
CFDC A680             (    forth6809.asm):03029         HDCPY:      LDA   ,X+
CFDE A7A0             (    forth6809.asm):03030                     STA   ,Y+
CFE0 5A               (    forth6809.asm):03031                     DECB
CFE1 26F9             (    forth6809.asm):03032                     BNE   HDCPY
CFE3 9E47             (    forth6809.asm):03033                     LDX   CURRENT           ; X = WID of the wordlist receiving the word
CFE5 EC84             (    forth6809.asm):03034                     LDD   ,X
CFE7 EDA1             (    forth6809.asm):03035                     STD   ,Y++              ; LINK = old head of that wordlist
CFE9 DC08             (    forth6809.asm):03036                     LDD   CODEHERE
CFEB EDA1             (    forth6809.asm):03037                     STD   ,Y++
CFED 109F06           (    forth6809.asm):03038                     STY   DPHERE
CFF0 3506             (    forth6809.asm):03039                     PULS  D
CFF2 DD04             (    forth6809.asm):03040                     STD   LATEST            ; LATEST = newest header of any wordlist
CFF4 ED84             (    forth6809.asm):03041                     STD   ,X                ; and the new head of the CURRENT wordlist
CFF6 3261             (    forth6809.asm):03042                     LEAS  1,S
CFF8 39               (    forth6809.asm):03043                     RTS
CFF9 CCFFF0           (    forth6809.asm):03044         HDZERO:     LDD   #-16              ; attempt to use zero-length string as a name
CFFC 2003             (    forth6809.asm):03045                     BRA   HDTHROW
CFFE CCFFED           (    forth6809.asm):03046         HDLONG:     LDD   #-19              ; definition name too long (flags need bits 5-7)
D001 3606             (    forth6809.asm):03047         HDTHROW:    PSHU  D
D003 7ED895           (    forth6809.asm):03048                     JMP   THROWW
                      (    forth6809.asm):03049         
                      (    forth6809.asm):03050         ; ------------------------------------------------------------
                      (    forth6809.asm):03051         ; Toggle the smudge bit (bit 6 of the length|flags byte) of the newest
                      (    forth6809.asm):03052         ; header, the one LATEST names. A smudged word is hidden from FIND, so
                      (    forth6809.asm):03053         ; HEADER with a true flag, then SMUDGE once the word is complete,
                      (    forth6809.asm):03054         ; brackets the definition of a word such as CODE ... END-CODE.
                      (    forth6809.asm):03055         ; SMUDGE   ( -- )
                      (    forth6809.asm):03056         ;    Inputs:
                      (    forth6809.asm):03057         ;        none
                      (    forth6809.asm):03058         ;    Outputs:
                      (    forth6809.asm):03059         ;        bit 6 of the length|flags byte at LATEST inverted
                      (    forth6809.asm):03060         ;    Registers: RegA, RegX and CC changed.
                      (    forth6809.asm):03061         ; ------------------------------------------------------------
D006 9E04             (    forth6809.asm):03062         SMUDGEW:    LDX   LATEST
D008 A684             (    forth6809.asm):03063                     LDA   ,X
D00A 8840             (    forth6809.asm):03064                     EORA  #$40
D00C A784             (    forth6809.asm):03065                     STA   ,X
D00E 39               (    forth6809.asm):03066                     RTS
                      (    forth6809.asm):03067         
                      (    forth6809.asm):03068         ; ============================================================
                      (    forth6809.asm):03069         ; SECTION 8: DEFINING WORDS
                      (    forth6809.asm):03070         ; ============================================================
                      (    forth6809.asm):03071         ; ------------------------------------------------------------
                      (    forth6809.asm):03072         ; :  ( "name" -- )
                      (    forth6809.asm):03073         ; Start a colon definition: parse the name, build a smudged header,
                      (    forth6809.asm):03074         ; record the new xt in CURXT, note the control-flow stack position in
                      (    forth6809.asm):03075         ; CSP and enter compile state.
                      (    forth6809.asm):03076         ; ------------------------------------------------------------
D00F CCFFFF           (    forth6809.asm):03077         COLONW:     LDD   #TRUEV
D012 3606             (    forth6809.asm):03078                     PSHU  D
D014 BDCFB8           (    forth6809.asm):03079                     JSR   HEADER
D017 DC08             (    forth6809.asm):03080                     LDD   CODEHERE          ; Record this word's xt for RECURSE.
D019 DD1F             (    forth6809.asm):03081                     STD   CURXT             ; See bugfix: COLONW.1
D01B 1F30             (    forth6809.asm):03082                     TFR   U,D
D01D DD21             (    forth6809.asm):03083                     STD   CSP
D01F CCFFFF           (    forth6809.asm):03084                     LDD   #-1
D022 DD00             (    forth6809.asm):03085                     STD   STATE
D024 39               (    forth6809.asm):03086                     RTS
                      (    forth6809.asm):03087         
                      (    forth6809.asm):03088         ; ------------------------------------------------------------
                      (    forth6809.asm):03089         ; ;  ( -- )  IMMEDIATE
                      (    forth6809.asm):03090         ; End a colon definition: compile RTS, check that the control-flow
                      (    forth6809.asm):03091         ; stack is balanced (error -22 if not), clear the smudge bit of the
                      (    forth6809.asm):03092         ; new word and return to interpret state.
                      (    forth6809.asm):03093         ; ------------------------------------------------------------
D025 CC0039           (    forth6809.asm):03094         SEMIW:      LDD   #RTSOPC
D028 3606             (    forth6809.asm):03095                     PSHU  D
D02A BDCF72           (    forth6809.asm):03096                     JSR   CCOMMA1
D02D 1F30             (    forth6809.asm):03097                     TFR   U,D
D02F 109321           (    forth6809.asm):03098                     CMPD  CSP
D032 2703             (    forth6809.asm):03099                     BEQ   SEMIOK
D034 BDD860           (    forth6809.asm):03100                     JSR   CFERR
D037 9E04             (    forth6809.asm):03101         SEMIOK:     LDX   LATEST
D039 A684             (    forth6809.asm):03102                     LDA   ,X
D03B 84BF             (    forth6809.asm):03103                     ANDA  #$BF
D03D A784             (    forth6809.asm):03104                     STA   ,X
D03F CC0000           (    forth6809.asm):03105                     LDD   #0
D042 DD00             (    forth6809.asm):03106                     STD   STATE
D044 39               (    forth6809.asm):03107                     RTS
                      (    forth6809.asm):03108         
                      (    forth6809.asm):03109         ; ------------------------------------------------------------
                      (    forth6809.asm):03110         ; :NONAME  ( -- xt )
                      (    forth6809.asm):03111         ; Start an anonymous definition: no header is built and LATEST is left
                      (    forth6809.asm):03112         ; alone, so the word can never be found. Leaves the xt (the current
                      (    forth6809.asm):03113         ; CODEHERE) on the stack, records it in CURXT, notes the control-flow
                      (    forth6809.asm):03114         ; stack position in CSP and enters compile state.
                      (    forth6809.asm):03115         ; Original comment: shadow NONAMEW.0.
                      (    forth6809.asm):03116         ; ------------------------------------------------------------
D045 DC08             (    forth6809.asm):03117         NONAMEW:    LDD   CODEHERE
D047 3606             (    forth6809.asm):03118                     PSHU  D                 ; xt
D049 DD1F             (    forth6809.asm):03119                     STD   CURXT             ; See bugfix: NONAMEW.1
D04B 1F30             (    forth6809.asm):03120                     TFR   U,D
D04D DD21             (    forth6809.asm):03121                     STD   CSP
D04F CCFFFF           (    forth6809.asm):03122                     LDD   #-1
D052 DD00             (    forth6809.asm):03123                     STD   STATE
D054 39               (    forth6809.asm):03124                     RTS
                      (    forth6809.asm):03125         
                      (    forth6809.asm):03126         ; ------------------------------------------------------------
                      (    forth6809.asm):03127         ; Common start of every DODOES-style defining word: build a header
                      (    forth6809.asm):03128         ; and compile the DODOES trampoline followed by the behaviour address.
                      (    forth6809.asm):03129         ; BLDDOES
                      (    forth6809.asm):03130         ;    Inputs:
                      (    forth6809.asm):03131         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03132         ;    Outputs:
                      (    forth6809.asm):03133         ;        header built, trampoline and behaviour cell compiled
                      (    forth6809.asm):03134         ;    Registers: all changed.
                      (    forth6809.asm):03135         ; BLDSELF
                      (    forth6809.asm):03136         ;    Inputs:
                      (    forth6809.asm):03137         ;        RegD = address of the behaviour routine
                      (    forth6809.asm):03138         ;    Outputs:
                      (    forth6809.asm):03139         ;        as BLDDOES, then the PFA cell compiled pointing at the
                      (    forth6809.asm):03140         ;        cell that follows it (the word's own data field)
                      (    forth6809.asm):03141         ;    Registers: all changed.
                      (    forth6809.asm):03142         ; Used by CREATE, CONSTANT, 2CONSTANT, DEFER and MARKER (BLDSELF)
                      (    forth6809.asm):03143         ; and by VALUE (BLDDOES, which supplies its own PFA).
                      (    forth6809.asm):03144         ; ------------------------------------------------------------
D055 3406             (    forth6809.asm):03145         BLDDOES:    PSHS  D                 ; behaviour address
D057 CC0000           (    forth6809.asm):03146                     LDD   #0
D05A 3606             (    forth6809.asm):03147                     PSHU  D
D05C BDCFB8           (    forth6809.asm):03148                     JSR   HEADER
D05F CCCEE8           (    forth6809.asm):03149                     LDD   #DODOES
D062 3606             (    forth6809.asm):03150                     PSHU  D
D064 BDDCD0           (    forth6809.asm):03151                     JSR   CCALL
D067 3506             (    forth6809.asm):03152                     PULS  D
D069 3606             (    forth6809.asm):03153                     PSHU  D                 ; behaviour address
D06B BDCF66           (    forth6809.asm):03154                     JSR   CODECOMMA
D06E 39               (    forth6809.asm):03155                     RTS
                      (    forth6809.asm):03156         
D06F BDD055           (    forth6809.asm):03157         BLDSELF:    JSR   BLDDOES
D072 DC08             (    forth6809.asm):03158                     LDD   CODEHERE          ; PFA = the cell after this one
D074 C30002           (    forth6809.asm):03159                     ADDD  #2                ; See bugfix: CONSTANTW.1
D077 3606             (    forth6809.asm):03160                     PSHU  D
D079 BDCF66           (    forth6809.asm):03161                     JSR   CODECOMMA
D07C 39               (    forth6809.asm):03162                     RTS
                      (    forth6809.asm):03163         
                      (    forth6809.asm):03164         ; ------------------------------------------------------------
                      (    forth6809.asm):03165         ; CREATE  ( "name" -- )
                      (    forth6809.asm):03166         ; Build a header whose code is a DODOES trampoline. The default
                      (    forth6809.asm):03167         ; behaviour (DOESRT0) leaves the data-field address, the next free
                      (    forth6809.asm):03168         ; address in the code area, on the stack.
                      (    forth6809.asm):03169         ; ------------------------------------------------------------
D07D CCCEF3           (    forth6809.asm):03170         CREATEW:    LDD   #DOESRT0
D080 BDD06F           (    forth6809.asm):03171                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D083 39               (    forth6809.asm):03172                     RTS
                      (    forth6809.asm):03173         
                      (    forth6809.asm):03174         ; ------------------------------------------------------------
                      (    forth6809.asm):03175         ; DOES>  ( -- )  IMMEDIATE, compile-only
                      (    forth6809.asm):03176         ; Compile a call to SETDOES, which at run time patches the behaviour
                      (    forth6809.asm):03177         ; of the word being defined.
                      (    forth6809.asm):03178         ; Original comment: shadow DOESGTW.0.
                      (    forth6809.asm):03179         ; ------------------------------------------------------------
D084 CCCEF4           (    forth6809.asm):03180         DOESGTW:    LDD   #SETDOES
D087 3606             (    forth6809.asm):03181                     PSHU  D
D089 BDDCD0           (    forth6809.asm):03182                     JSR   CCALL
D08C 39               (    forth6809.asm):03183                     RTS
                      (    forth6809.asm):03184         
                      (    forth6809.asm):03185         ; ------------------------------------------------------------
                      (    forth6809.asm):03186         ; VARIABLE  ( "name" -- )
                      (    forth6809.asm):03187         ; Build a word that returns the address of a new cell in the variable
                      (    forth6809.asm):03188         ; area, initialised to zero.
                      (    forth6809.asm):03189         ; ------------------------------------------------------------
D08D CC0000           (    forth6809.asm):03190         VARIABLEW:  LDD   #0
D090 3606             (    forth6809.asm):03191                     PSHU  D
D092 BDCFB8           (    forth6809.asm):03192                     JSR   HEADER
D095 CCCEE8           (    forth6809.asm):03193                     LDD   #DODOES
D098 3606             (    forth6809.asm):03194                     PSHU  D
D09A BDDCD0           (    forth6809.asm):03195                     JSR   CCALL
D09D CCCEF3           (    forth6809.asm):03196                     LDD   #DOESRT0
D0A0 3606             (    forth6809.asm):03197                     PSHU  D
D0A2 BDCF66           (    forth6809.asm):03198                     JSR   CODECOMMA
D0A5 DC0A             (    forth6809.asm):03199                     LDD   VARHERE
D0A7 3606             (    forth6809.asm):03200                     PSHU  D
D0A9 BDCF66           (    forth6809.asm):03201                     JSR   CODECOMMA
D0AC CC0000           (    forth6809.asm):03202                     LDD   #0
D0AF 9E0A             (    forth6809.asm):03203                     LDX   VARHERE
D0B1 ED81             (    forth6809.asm):03204                     STD   ,X++
D0B3 9F0A             (    forth6809.asm):03205                     STX   VARHERE
D0B5 39               (    forth6809.asm):03206                     RTS
                      (    forth6809.asm):03207         
                      (    forth6809.asm):03208         ; ------------------------------------------------------------
                      (    forth6809.asm):03209         ; @  ( a-addr -- x )
                      (    forth6809.asm):03210         ; Fetch the cell at a-addr. Also the behaviour of CONSTANT words.
                      (    forth6809.asm):03211         ; ------------------------------------------------------------
D0B6 3710             (    forth6809.asm):03212         FETCHW:     PULU  X                 ; a-addr
D0B8 EC84             (    forth6809.asm):03213                     LDD   ,X
D0BA 3606             (    forth6809.asm):03214                     PSHU  D                 ; x
D0BC 39               (    forth6809.asm):03215                     RTS
                      (    forth6809.asm):03216         
                      (    forth6809.asm):03217         ; ------------------------------------------------------------
                      (    forth6809.asm):03218         ; CONSTANT  ( x "name" -- )
                      (    forth6809.asm):03219         ; Build a word that returns x. The value is stored in the code area
                      (    forth6809.asm):03220         ; after the trampoline and fetched with @.
                      (    forth6809.asm):03221         ; ------------------------------------------------------------
D0BD CCD0B6           (    forth6809.asm):03222         CONSTANTW:  LDD   #FETCHW
D0C0 BDD06F           (    forth6809.asm):03223                     JSR   BLDSELF           ; See bugfix: BLDSELF.1
D0C3 BDCF60           (    forth6809.asm):03224                     JSR   COMMAW
D0C6 39               (    forth6809.asm):03225                     RTS
                      (    forth6809.asm):03226         
                      (    forth6809.asm):03227         ; ------------------------------------------------------------
                      (    forth6809.asm):03228         ; Behaviour of a VALUE word: fetch the value cell.
                      (    forth6809.asm):03229         ; DOVALUE   ( pfa -- x )
                      (    forth6809.asm):03230         ;    Inputs:
                      (    forth6809.asm):03231         ;        pfa on the data stack (address of the value cell)
                      (    forth6809.asm):03232         ;    Outputs:
                      (    forth6809.asm):03233         ;        pfa replaced by the value
                      (    forth6809.asm):03234         ;    Registers: RegD, RegX and CC changed.
                      (    forth6809.asm):03235         ; ------------------------------------------------------------
D0C7 3710             (    forth6809.asm):03236         DOVALUE:    PULU  X                 ; pfa
D0C9 EC84             (    forth6809.asm):03237                     LDD   ,X
D0CB 3606             (    forth6809.asm):03238                     PSHU  D                 ; x
D0CD 39               (    forth6809.asm):03239                     RTS
                      (    forth6809.asm):03240         
                      (    forth6809.asm):03241         ; ------------------------------------------------------------
                      (    forth6809.asm):03242         ; VALUE  ( x "name" -- )
                      (    forth6809.asm):03243         ; Build a word that returns x, which can be changed with TO. The value
                      (    forth6809.asm):03244         ; cell is kept in the variable area so that it is writable.
                      (    forth6809.asm):03245         ; ------------------------------------------------------------
D0CE CCD0C7           (    forth6809.asm):03246         VALUEW:     LDD   #DOVALUE
D0D1 BDD055           (    forth6809.asm):03247                     JSR   BLDDOES
D0D4 DC0A             (    forth6809.asm):03248                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D0D6 3606             (    forth6809.asm):03249                     PSHU  D                 ; See bugfix: VALUEW.1
D0D8 BDCF66           (    forth6809.asm):03250                     JSR   CODECOMMA
D0DB BDCF78           (    forth6809.asm):03251                     JSR   VCOMMAW           ; store x in the variable area
D0DE 39               (    forth6809.asm):03252                     RTS
                      (    forth6809.asm):03253         
                      (    forth6809.asm):03254         ; ------------------------------------------------------------
                      (    forth6809.asm):03255         ; Behaviour of a 2VALUE word: fetch the two-cell value, x2 at the
                      (    forth6809.asm):03256         ; lower address as 2@ expects.
                      (    forth6809.asm):03257         ; DO2VALUE   ( pfa -- x1 x2 )
                      (    forth6809.asm):03258         ; ------------------------------------------------------------
D0DF 7EE691           (    forth6809.asm):03259         DO2VALUE:   JMP   TWOFETCHW
                      (    forth6809.asm):03260         
                      (    forth6809.asm):03261         ; ------------------------------------------------------------
                      (    forth6809.asm):03262         ; 2VALUE  ( x1 x2 "name" -- )
                      (    forth6809.asm):03263         ; Build a word that returns x1 x2, which can be changed with TO. The
                      (    forth6809.asm):03264         ; two cells are kept in the variable area so that they are writable.
                      (    forth6809.asm):03265         ; ------------------------------------------------------------
D0E2 CCD0DF           (    forth6809.asm):03266         TWOVALUEW:  LDD   #DO2VALUE
D0E5 BDD055           (    forth6809.asm):03267                     JSR   BLDDOES
D0E8 DC0A             (    forth6809.asm):03268                     LDD   VARHERE           ; PFA = VARHERE (writable space)
D0EA 3606             (    forth6809.asm):03269                     PSHU  D
D0EC BDCF66           (    forth6809.asm):03270                     JSR   CODECOMMA
D0EF BDCF78           (    forth6809.asm):03271                     JSR   VCOMMAW           ; x2 at the lower address
D0F2 BDCF78           (    forth6809.asm):03272                     JSR   VCOMMAW           ; then x1
D0F5 39               (    forth6809.asm):03273                     RTS
                      (    forth6809.asm):03274         
                      (    forth6809.asm):03275         ; ------------------------------------------------------------
                      (    forth6809.asm):03276         ; TO  ( x "name" -- )  IMMEDIATE
                      (    forth6809.asm):03277         ; Store x in the named VALUE. When compiling, instead compile code to
                      (    forth6809.asm):03278         ; store a run-time x in it. Error -13 if the name is not found.
                      (    forth6809.asm):03279         ; ------------------------------------------------------------
D0F6 CC0020           (    forth6809.asm):03280         TOW:        LDD   #32
D0F9 3606             (    forth6809.asm):03281                     PSHU  D
D0FB BDD30F           (    forth6809.asm):03282                     JSR   WORDW
D0FE BDD3F8           (    forth6809.asm):03283                     JSR   FINDW
D101 3706             (    forth6809.asm):03284                     PULU  D
D103 10830000         (    forth6809.asm):03285                     CMPD  #0
D107 260A             (    forth6809.asm):03286                     BNE   TOFOUND
D109 3706             (    forth6809.asm):03287                     PULU  D
D10B CCFFF3           (    forth6809.asm):03288                     LDD   #-13
D10E 3606             (    forth6809.asm):03289                     PSHU  D
D110 BDD895           (    forth6809.asm):03290                     JSR   THROWW
D113 AEC4             (    forth6809.asm):03291         TOFOUND:    LDX   ,U                ; xt: is it a 2VALUE? (behaviour cell at xt+3)
D115 EC03             (    forth6809.asm):03292                     LDD   3,X
D117 1083D0DF         (    forth6809.asm):03293                     CMPD  #DO2VALUE
D11B 271A             (    forth6809.asm):03294                     BEQ   TOTWO
D11D BDDD91           (    forth6809.asm):03295                     JSR   TOBODYW
D120 DC00             (    forth6809.asm):03296                     LDD   STATE
D122 270C             (    forth6809.asm):03297                     BEQ   TOIMMED
D124 BDDCDD           (    forth6809.asm):03298                     JSR   LITERALW
D127 CCE672           (    forth6809.asm):03299                     LDD   #STOREW
D12A 3606             (    forth6809.asm):03300                     PSHU  D
D12C BDDCD0           (    forth6809.asm):03301                     JSR   CCALL
D12F 39               (    forth6809.asm):03302                     RTS
D130 3710             (    forth6809.asm):03303         TOIMMED:    PULU  X                 ; a-addr of the value cell
D132 3706             (    forth6809.asm):03304                     PULU  D                 ; x
D134 ED84             (    forth6809.asm):03305                     STD   ,X
D136 39               (    forth6809.asm):03306                     RTS
D137 BDDD91           (    forth6809.asm):03307         TOTWO:      JSR   TOBODYW           ; 2VALUE: store x1 x2 with 2!
D13A DC00             (    forth6809.asm):03308                     LDD   STATE
D13C 270C             (    forth6809.asm):03309                     BEQ   TOTWOIMM
D13E BDDCDD           (    forth6809.asm):03310                     JSR   LITERALW
D141 CCE69C           (    forth6809.asm):03311                     LDD   #TWOSTOREW
D144 3606             (    forth6809.asm):03312                     PSHU  D
D146 BDDCD0           (    forth6809.asm):03313                     JSR   CCALL
D149 39               (    forth6809.asm):03314                     RTS
D14A 7EE69C           (    forth6809.asm):03315         TOTWOIMM:   JMP   TWOSTOREW
                      (    forth6809.asm):03316         
                      (    forth6809.asm):03317         ; ------------------------------------------------------------
                      (    forth6809.asm):03318         ; 2VARIABLE  ( "name" -- )
                      (    forth6809.asm):03319         ; Build a word that returns the address of a new two-cell variable in
                      (    forth6809.asm):03320         ; the variable area, initialised to zero.
                      (    forth6809.asm):03321         ; ------------------------------------------------------------
D14D                  (    forth6809.asm):03322         TWOVARIABLEW:

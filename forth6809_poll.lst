DF9F 3410             (    forth6809.asm):05857                     PSHS  X
DFA1 3606             (    forth6809.asm):05858                     PSHU  D
DFA3 39               (    forth6809.asm):05859                     RTS
                      (    forth6809.asm):05860         
                      (    forth6809.asm):05861         ; ------------------------------------------------------------
                      (    forth6809.asm):05862         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05863         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05864         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05865         ; put back around the transfer.
                      (    forth6809.asm):05866         ; ------------------------------------------------------------
DFA4 3510             (    forth6809.asm):05867         TWOTORW:    PULS  X                 ; return address
DFA6 3706             (    forth6809.asm):05868                     PULU  D                 ; x2
DFA8 3720             (    forth6809.asm):05869                     PULU  Y                 ; x1
DFAA 3420             (    forth6809.asm):05870                     PSHS  Y
DFAC 3406             (    forth6809.asm):05871                     PSHS  D
DFAE 3410             (    forth6809.asm):05872                     PSHS  X
DFB0 39               (    forth6809.asm):05873                     RTS
                      (    forth6809.asm):05874         
                      (    forth6809.asm):05875         ; ------------------------------------------------------------
                      (    forth6809.asm):05876         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05877         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05878         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05879         ; put back around the transfer.
                      (    forth6809.asm):05880         ; ------------------------------------------------------------
DFB1 3510             (    forth6809.asm):05881         TWOFROMRW:  PULS  X                 ; return address
DFB3 3506             (    forth6809.asm):05882                     PULS  D                 ; x2
DFB5 3520             (    forth6809.asm):05883                     PULS  Y                 ; x1
DFB7 3410             (    forth6809.asm):05884                     PSHS  X
DFB9 3620             (    forth6809.asm):05885                     PSHU  Y
DFBB 3606             (    forth6809.asm):05886                     PSHU  D
DFBD 39               (    forth6809.asm):05887                     RTS
                      (    forth6809.asm):05888         
                      (    forth6809.asm):05889         ; ------------------------------------------------------------
                      (    forth6809.asm):05890         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05891         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05892         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05893         ; and put back around the transfer.
                      (    forth6809.asm):05894         ; ------------------------------------------------------------
DFBE 3510             (    forth6809.asm):05895         TWORFETCHW: PULS  X                 ; return address
DFC0 ECE4             (    forth6809.asm):05896                     LDD   ,S                ; x2
DFC2 10AE62           (    forth6809.asm):05897                     LDY   2,S               ; x1
DFC5 3410             (    forth6809.asm):05898                     PSHS  X
DFC7 3620             (    forth6809.asm):05899                     PSHU  Y
DFC9 3606             (    forth6809.asm):05900                     PSHU  D
DFCB 39               (    forth6809.asm):05901                     RTS

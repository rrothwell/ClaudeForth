                      (    forth6809.asm):04469         ; UNLOOP  ( -- )
                      (    forth6809.asm):04470         ; Discard the loop frame (index, limit, leave flag) beneath UNLOOP's
                      (    forth6809.asm):04471         ; return address, so that a following I or J sees the enclosing loop.

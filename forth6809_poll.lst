E31F 3410             (    forth6809.asm):05817                     PSHS  X
E321 3606             (    forth6809.asm):05818                     PSHU  D
E323 39               (    forth6809.asm):05819                     RTS
                      (    forth6809.asm):05820         
                      (    forth6809.asm):05821         ; ------------------------------------------------------------
                      (    forth6809.asm):05822         ; 2>R  ( x1 x2 -- )  ( R: -- x1 x2 )
                      (    forth6809.asm):05823         ; Move a cell pair to the return stack. R2A and R2B are scratch. The
                      (    forth6809.asm):05824         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05825         ; put back around the transfer.
                      (    forth6809.asm):05826         ; ------------------------------------------------------------
E324 3510             (    forth6809.asm):05827         TWOTORW:    PULS  X                 ; return address
E326 3706             (    forth6809.asm):05828                     PULU  D                 ; x2
E328 3720             (    forth6809.asm):05829                     PULU  Y                 ; x1
E32A 3420             (    forth6809.asm):05830                     PSHS  Y
E32C 3406             (    forth6809.asm):05831                     PSHS  D
E32E 3410             (    forth6809.asm):05832                     PSHS  X
E330 39               (    forth6809.asm):05833                     RTS
                      (    forth6809.asm):05834         
                      (    forth6809.asm):05835         ; ------------------------------------------------------------
                      (    forth6809.asm):05836         ; 2R>  ( -- x1 x2 )  ( R: x1 x2 -- )
                      (    forth6809.asm):05837         ; Move a cell pair from the return stack. The
                      (    forth6809.asm):05838         ; return address of this call is on top of S, so it is lifted off and
                      (    forth6809.asm):05839         ; put back around the transfer.
                      (    forth6809.asm):05840         ; ------------------------------------------------------------
E331 3510             (    forth6809.asm):05841         TWOFROMRW:  PULS  X                 ; return address
E333 3506             (    forth6809.asm):05842                     PULS  D                 ; x2
E335 3520             (    forth6809.asm):05843                     PULS  Y                 ; x1
E337 3410             (    forth6809.asm):05844                     PSHS  X
E339 3620             (    forth6809.asm):05845                     PSHU  Y
E33B 3606             (    forth6809.asm):05846                     PSHU  D
E33D 39               (    forth6809.asm):05847                     RTS
                      (    forth6809.asm):05848         
                      (    forth6809.asm):05849         ; ------------------------------------------------------------
                      (    forth6809.asm):05850         ; 2R@  ( -- x1 x2 )  ( R: x1 x2 -- x1 x2 )
                      (    forth6809.asm):05851         ; Copy the top cell pair of the return stack.
                      (    forth6809.asm):05852         ; The return address of this call is on top of S, so it is lifted off
                      (    forth6809.asm):05853         ; and put back around the transfer.
                      (    forth6809.asm):05854         ; ------------------------------------------------------------
E33E 3510             (    forth6809.asm):05855         TWORFETCHW: PULS  X                 ; return address
E340 ECE4             (    forth6809.asm):05856                     LDD   ,S                ; x2

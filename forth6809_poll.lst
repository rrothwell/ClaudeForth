D3D5 273B             (    forth6809.asm):03513                     BEQ   BADWORD
                      (    forth6809.asm):03514         
D3D7 10830001         (    forth6809.asm):03515                     CMPD  #1                ; 1 = double-number result
D3DB 2711             (    forth6809.asm):03516                     BEQ   TNDOUBLE          ; See shadow: INTERPRET.3
                      (    forth6809.asm):03517         
D3DD DC00             (    forth6809.asm):03518                     LDD   STATE
D3DF 27C2             (    forth6809.asm):03519                     BEQ   ILOOP

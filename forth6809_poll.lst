                      (    forth6809.asm):08584         ; #  ( ud1 -- ud2 )
                      (    forth6809.asm):08585         ; Divide ud1 by BASE, add the remainder as a digit to the pictured
                      (    forth6809.asm):08586         ; numeric output string, and leave the quotient ud2.
                      (    forth6809.asm):08587         ; ------------------------------------------------------------

                      (    forth6809.asm):03862         ; SECTION 9A: SEARCH-ORDER WORD SET
                      (    forth6809.asm):03863         ; ============================================================
                      (    forth6809.asm):03864         ; ------------------------------------------------------------
                      (    forth6809.asm):03865         ; WORDLIST  ( -- wid )
                      (    forth6809.asm):03866         ; Create a new, empty wordlist. Throws -8 when all WLCELLS are in use.
                      (    forth6809.asm):03867         ; ------------------------------------------------------------
D5C7 9E45             (    forth6809.asm):03868         WORDLISTW:  LDX   WLEND
D5C9 8C006F           (    forth6809.asm):03869                     CMPX  #WLHEADS+2*WLCELLS
D5CC 240F             (    forth6809.asm):03870                     BHS   WLFULL
D5CE CC0000           (    forth6809.asm):03871                     LDD   #0
D5D1 ED84             (    forth6809.asm):03872                     STD   ,X
D5D3 ED8814           (    forth6809.asm):03873                     STD   WLNOFF,X
D5D6 3610             (    forth6809.asm):03874                     PSHU  X
D5D8 3002             (    forth6809.asm):03875                     LEAX  2,X
D5DA 9F45             (    forth6809.asm):03876                     STX   WLEND
D5DC 39               (    forth6809.asm):03877                     RTS
D5DD CCFFF8           (    forth6809.asm):03878         WLFULL:     LDD   #-8
D5E0 3606             (    forth6809.asm):03879                     PSHU  D
D5E2 7ED970           (    forth6809.asm):03880                     JMP   THROWW
                      (    forth6809.asm):03881         
                      (    forth6809.asm):03882         ; ------------------------------------------------------------
                      (    forth6809.asm):03883         ; FORTH-WORDLIST  ( -- wid )
                      (    forth6809.asm):03884         ; Push the WID of the wordlist holding the standard words.
                      (    forth6809.asm):03885         ; ------------------------------------------------------------
D5E5 CC005B           (    forth6809.asm):03886         FORTHWLW:   LDD   #WLHEADS
D5E8 3606             (    forth6809.asm):03887                     PSHU  D
D5EA 39               (    forth6809.asm):03888                     RTS
                      (    forth6809.asm):03889         
                      (    forth6809.asm):03890         ; ------------------------------------------------------------
                      (    forth6809.asm):03891         ; GET-ORDER  ( -- widn ... wid1 n )
                      (    forth6809.asm):03892         ; Return the search order: wid1 is searched first. ROOT is not part of
                      (    forth6809.asm):03893         ; it, as it is always searched last.

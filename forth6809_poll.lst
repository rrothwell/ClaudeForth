                      (    forth6809.asm):03709         ; Split a header into its xt and its immediate flag.
                      (    forth6809.asm):03710         ; HDRXT
                      (    forth6809.asm):03711         ;    Inputs:
                      (    forth6809.asm):03712         ;        RegX = header
                      (    forth6809.asm):03713         ;    Outputs:
                      (    forth6809.asm):03714         ;        RegX = xt (the CFA field), RegA = length|flags byte
                      (    forth6809.asm):03715         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):03716         ; ------------------------------------------------------------
D500 A684             (    forth6809.asm):03717         HDRXT:      LDA   ,X
D502 1F89             (    forth6809.asm):03718                     TFR   A,B
D504 C41F             (    forth6809.asm):03719                     ANDB  #$1F
D506 3001             (    forth6809.asm):03720                     LEAX  1,X
D508 3A               (    forth6809.asm):03721                     ABX
D509 AE02             (    forth6809.asm):03722                     LDX   2,X               ; CFA field
D50B 39               (    forth6809.asm):03723                     RTS

                      (    forth6809.asm):02129         ;        none
                      (    forth6809.asm):02130         ;    Outputs:
                      (    forth6809.asm):02131         ;        RegA = next character from the receive buffer
                      (    forth6809.asm):02132         ;        Carry clear = character returned, set = ring empty

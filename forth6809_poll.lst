                      (    forth6809.asm):02022                     JSR   UPDATE_RTS
DA5F                  (    forth6809.asm):02023         CHKLODONE:  RTS
                      (    forth6809.asm):02024         ; ------------------------------------------------------------
                      (    forth6809.asm):02025         ; Send at most one character from the output ring to the ACIA
                      (    forth6809.asm):02026         ; by polling, then return. Nothing is sent if the ring is empty,
                      (    forth6809.asm):02027         ; the remote receiver is blocking (CTS) or the transmitter is not
                      (    forth6809.asm):02028         ; ready; the caller simply tries again on its next call.
                      (    forth6809.asm):02029         ; FLUSHOUTBUFFER
                      (    forth6809.asm):02030         ;    Inputs:
                      (    forth6809.asm):02031         ;        none
                      (    forth6809.asm):02032         ;    Outputs:
                      (    forth6809.asm):02033         ;        one character sent and OUTTAIL advanced, or no change
                      (    forth6809.asm):02034         ;    Registers: RegA, RegB, RegX and CC changed.
                      (    forth6809.asm):02035         ; See bugfix: FLUSHOUTBUFFER.1.
                      (    forth6809.asm):02036         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):02037         FLUSHOUTBUFFER:
                      (    forth6809.asm):02038                     LDB   OUTTAIL
                      (    forth6809.asm):02039                     CMPB  OUTHEAD           ; Is transmit buffer empty?
                      (    forth6809.asm):02040                     BEQ   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02041         
                      (    forth6809.asm):02042                     LDA   ACIASR            ; Is transmission blocked by remote receiver?
                      (    forth6809.asm):02043                     BITA  #SR_CTS
                      (    forth6809.asm):02044                     BNE   FLUSHED           ; Yes! Exit.
                      (    forth6809.asm):02045         
                      (    forth6809.asm):02046                     BITA  #SR_TDRE          ; Is transmit register empty?
                      (    forth6809.asm):02047                     BEQ   FLUSHED           ; No! Exit - try again next call rather
                      (    forth6809.asm):02048                                             ; than spin-wait here.
                      (    forth6809.asm):02049         

                      (    forth6809.asm):04381         ; SECTION 10: QUERY / ACCEPT / EXPECT / KEY / KEY? / EMIT
                      (    forth6809.asm):04382         ; ============================================================
                      (    forth6809.asm):04383                     IFEQ  SERIALPOLL        ; >>>>>>>>>>
                      (    forth6809.asm):04384         ; Unused alternative to KEY removed; see shadow X_KEY.1.
                      (    forth6809.asm):04385         
                      (    forth6809.asm):04386         ; ------------------------------------------------------------
                      (    forth6809.asm):04387         ; KEY  ( -- char )
                      (    forth6809.asm):04388         ; Wait for the next received character and return it. While waiting,
                      (    forth6809.asm):04389         ; drain the output ring by polling if RTS is high.
                      (    forth6809.asm):04390         ; ------------------------------------------------------------
D723                  (    forth6809.asm):04391         KEYACIA:
                      (    forth6809.asm):04392         
                      (    forth6809.asm):04393                     TST   RTSSTATE          ; Is throttling?
                      (    forth6809.asm):04394                     BEQ   TRY_READ          ; No! Retrieve character from input buffer.
                      (    forth6809.asm):04395         
                      (    forth6809.asm):04396                     ; IRQ stays unmasked during the flush. See bugfix: KEYW.1
                      (    forth6809.asm):04397                     JSR   FLUSHOUTBUFFER    ; Drain the output buffer,
                      (    forth6809.asm):04398                                             ; by transmitting all chars.
                      (    forth6809.asm):04399         
D723                  (    forth6809.asm):04400         TRY_READ:
                      (    forth6809.asm):04401                     JSR   GETCHAR           ; Is char available in input buffer.
                      (    forth6809.asm):04402                     BCS   KEYACIA           ; No? Try again to receive a char,
                      (    forth6809.asm):04403                                             ; while still transmitting!
                      (    forth6809.asm):04404         
                      (    forth6809.asm):04405                     TFR   A,B               ; Move char result to Reg B (LSB of D)
                      (    forth6809.asm):04406                     CLRA                    ; Clear MSB.
                      (    forth6809.asm):04407                     PSHU  D                 ; char
                      (    forth6809.asm):04408         
                      (    forth6809.asm):04409                     RTS
                      (    forth6809.asm):04410         
                      (    forth6809.asm):04411         ; ------------------------------------------------------------
                      (    forth6809.asm):04412         ; KEY?  ( -- flag )
                      (    forth6809.asm):04413         ; Return true if a received character is waiting in the input ring.
                      (    forth6809.asm):04414         ; ------------------------------------------------------------
D723                  (    forth6809.asm):04415         KEYQACIA:
                      (    forth6809.asm):04416                     ; Commented-out code moved to shadow: KEYQW.1
                      (    forth6809.asm):04417         
                      (    forth6809.asm):04418                     LDA   INHEAD            ; Characters received?
                      (    forth6809.asm):04419                     CMPA  INTAIL
                      (    forth6809.asm):04420         
                      (    forth6809.asm):04421                     ; Commented-out code moved to shadow: KEYQW.2
                      (    forth6809.asm):04422         
                      (    forth6809.asm):04423                     BNE   KQTRUE            ; Yes!
                      (    forth6809.asm):04424         
                      (    forth6809.asm):04425                     LDD   #FALSEV           ; No! Return false result.
                      (    forth6809.asm):04426                     PSHU  D                 ; flag = false
                      (    forth6809.asm):04427         
                      (    forth6809.asm):04428                     RTS
                      (    forth6809.asm):04429         
D723                  (    forth6809.asm):04430         KQTRUE:
                      (    forth6809.asm):04431                     LDD   #TRUEV            ; Yes! Return true result.
                      (    forth6809.asm):04432                     PSHU  D                 ; flag = true
                      (    forth6809.asm):04433                     RTS
                      (    forth6809.asm):04434         
                      (    forth6809.asm):04435         ; Unused alternative to EMIT removed; see shadow X_EMIT.1.
                      (    forth6809.asm):04436         
                      (    forth6809.asm):04437         ; ------------------------------------------------------------
                      (    forth6809.asm):04438         ; EMIT  ( char -- )
                      (    forth6809.asm):04439         ; Transmit char through PUTCHAR (the output ring). When the ring is
                      (    forth6809.asm):04440         ; full EMIT waits for room, so no character is lost however fast the
                      (    forth6809.asm):04441         ; caller produces output. The wait needs the transmit interrupt to be
                      (    forth6809.asm):04442         ; able to run, so EMIT must not be called with interrupts masked, nor
                      (    forth6809.asm):04443         ; from an interrupt handler. See shadow EMITACIA.1.
                      (    forth6809.asm):04444         ; ------------------------------------------------------------
D723                  (    forth6809.asm):04445         EMITACIA:
                      (    forth6809.asm):04446                     PULU  D                 ; char
                      (    forth6809.asm):04447                     PSHS  B                 ; keep it while waiting
D723                  (    forth6809.asm):04448         EMWAIT:     LDB   OUTHEAD           ; Is there room for one more?
                      (    forth6809.asm):04449                     INCB
                      (    forth6809.asm):04450                     ANDB  #OUTBUFSZ-1
                      (    forth6809.asm):04451                     CMPB  OUTTAIL
                      (    forth6809.asm):04452                     BNE   EMROOM            ; Yes!
                      (    forth6809.asm):04453                     TST   RTSSTATE          ; No! Is the transmit interrupt running?
                      (    forth6809.asm):04454                     BEQ   EMWAIT            ; Yes! It will make room.
                      (    forth6809.asm):04455                     PSHS  CC                ; RTS is high so the transmit interrupt
                      (    forth6809.asm):04456                     ORCC  #$50              ; is off: send one character by polling,
                      (    forth6809.asm):04457                     JSR   FLUSHOUTBUFFER    ; as PUTCHAR does.
                      (    forth6809.asm):04458                     PULS  CC
                      (    forth6809.asm):04459                     BRA   EMWAIT
D723                  (    forth6809.asm):04460         EMROOM:     PULS  A                 ; char
                      (    forth6809.asm):04461                     JSR   PUTCHAR           ; Transmit char.
                      (    forth6809.asm):04462                     RTS
                      (    forth6809.asm):04463         
                      (    forth6809.asm):04464                     ELSE                    ; <<<<<>>>>>
                      (    forth6809.asm):04465         ; ------------------------------------------------------------
                      (    forth6809.asm):04466         ; KEY  ( -- char )  [polling build, SERIALPOLL=1]
                      (    forth6809.asm):04467         ; Wait for RDRF and return the received character. There are no ring
                      (    forth6809.asm):04468         ; buffers, interrupts or hardware handshaking in this build; ACCEPT
                      (    forth6809.asm):04469         ; uses software XON/XOFF instead. Framing, overrun and parity errors
                      (    forth6809.asm):04470         ; are counted in FECOUNT, OVRNCOUNT and PECOUNT, and POLLREADYCNT
                      (    forth6809.asm):04471         ; counts characters already waiting when KEY was called.
                      (    forth6809.asm):04472         ; Original comment: shadow KEYW.2. KEY?, EMIT, PUTXON and PUTXOFF
                      (    forth6809.asm):04473         ; follow.
                      (    forth6809.asm):04474         ; ------------------------------------------------------------
D723                  (    forth6809.asm):04475         KEYACIA:
D723 B6C008           (    forth6809.asm):04476                     LDA   ACIASR
D726 8501             (    forth6809.asm):04477                     BITA  #SR_RDRF
D728 2705             (    forth6809.asm):04478                     BEQ   KWAIT
D72A 7C017F           (    forth6809.asm):04479                     INC   POLLREADYCNT      ; character was already queued when we
D72D 2007             (    forth6809.asm):04480                     BRA   KGOTSTAT          ; came back to poll - didn't need to wait
D72F                  (    forth6809.asm):04481         KWAIT:
D72F B6C008           (    forth6809.asm):04482         KSPIN:      LDA   ACIASR
D732 8501             (    forth6809.asm):04483                     BITA  #SR_RDRF
D734 27F9             (    forth6809.asm):04484                     BEQ   KSPIN
D736                  (    forth6809.asm):04485         KGOTSTAT:                           ; A holds the status byte exactly as it was
                      (    forth6809.asm):04486                                             ; when RDRF first went true - check the
                      (    forth6809.asm):04487                                             ; error bits from THIS copy, not a fresh

F234 3606             (    forth6809.asm):06621                     PSHU  D
F236 EC84             (    forth6809.asm):06622                     LDD   ,X
F238 3606             (    forth6809.asm):06623                     PSHU  D
F23A 39               (    forth6809.asm):06624                     RTS
                      (    forth6809.asm):06625         
                      (    forth6809.asm):06626         ; ------------------------------------------------------------
                      (    forth6809.asm):06627         ; 2!  ( x1 x2 a-addr -- )

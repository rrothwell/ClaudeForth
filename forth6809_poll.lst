                      (    forth6809.asm):02067         ;    Outputs:
                      (    forth6809.asm):02068         ;        none
                      (    forth6809.asm):02069         ;    Registers: RegA and RegB changed; RegX and CC preserved.
                      (    forth6809.asm):02070         ; ------------------------------------------------------------
DA5F                  (    forth6809.asm):02071         PUTCHAR:
                      (    forth6809.asm):02072                     PSHS  CC,X

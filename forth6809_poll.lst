                      (    forth6809.asm):04824         ; Run-time part of ABORT". The counted string follows the call. If
                      (    forth6809.asm):04825         ; flag is non-zero, TYPE the string and THROW -2; otherwise skip over
                      (    forth6809.asm):04826         ; the string.
                      (    forth6809.asm):04827         ; DOABORTQUOTE   ( flag -- )
                      (    forth6809.asm):04828         ;    Inputs:
                      (    forth6809.asm):04829         ;        flag on the data stack; return address on S points at the
                      (    forth6809.asm):04830         ;        count byte
